							14297.56
						],
						"pointId": 12758
					}
				]
			},
			"dialogs": [
				{
					"id": 752130601,
					"content": "Привет. Твой напиток.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "О! Так вы доставщики! А я-то думаю, где мой напиток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Ако"
				},
				{
					"id": 752130608,
					"content": "И кто виноват? В заказе указано «Доставить на пляж человеку в синих штанах», а ты зарылся в песок. Полдня эти синие штаны искали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752130609,
					"content": "Да ты нам должен двойную стоимость доставки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752130610,
					"content": "А, виноват. Я совсем про это забыл. Надо было положить штаны сбоку на песок, чтобы вам было проще меня искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Ако"
				},
				{
					"id": 752130611,
					"content": "А зачем ты зарылся в песок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Из интереса. Я слышал, что на отдыхе многие так делают, вот и решил попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Ако"
				},
				{
					"id": 752130613,
					"content": "Поза у тебя какая-то странная. Как будто морковку в землю воткнули.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 752130614,
					"content": "А? А в чём проблема?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Ако"
				},
				{
					"id": 752130615,
					"content": "Об тебя легко споткнуться. И сам пострадаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Понятно. Я подумаю над этим. О, и вот ваша двойная оплата. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ако"
				}
			]
		},
