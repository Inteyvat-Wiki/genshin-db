				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Бэй Доу",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010901,
					"content": "Восхитительно! Твой бой заслуживает похвалы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010902
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010902,
					"content": "#Я боялся, что ты проиграешь бой, ведь ты не {F#привыкла}{M#привык} к подобным турнирам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010903
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010903,
					"content": "#Но ты быстро адаптировал{F#ась}{M#ся} и одолел{F#а} своего соперника. Это бесценный навык.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010904,
						20010905
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010904,
					"content": "Проницательно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				},
				{
					"id": 20010906,
					"content": "На самом деле, я больше полагался на слух, чем на зрение: земля под твоими ногами, твоё дыхание... Но в этом нет ничего примечательного, капитан Бэй Доу заметила больше меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010907
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010907,
					"content": "Ха-ха-ха, но в отличие от него я полагалась лишь на свой опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010908
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010908,
					"content": "Для тебя это всё, должно быть, в новинку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010909,
						20010910
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010909,
					"content": "Это точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010911,
					"content": "Мы хотели узнать, кто же будет нашим соперником в финале. Считаешь, он сильнее того, что был в полуфинале?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010912
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010912,
					"content": "Не обязательно. Дошедшие до финала участники не всегда «сильнее», но зачастую в их технике и стиле боя бывает что-то особенное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010913
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010913,
					"content": "А что касается твоего соперника: он полагается на скорость и знает свои сильные стороны. Очевидно, что он прошёл через множество битв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010914
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010914,
					"content": "Что с тобой? Боишься плохо рассчитать силы и проиграть в финале?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010915,
						20010916
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010915,
					"content": "Просто хочу подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010917,
					"content": "В таком случае я хочу кое-что тебе предложить. Давай отойдём в более тихое место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010918
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010918,
					"content": "Я до сих пор не представился. В землях Инадзумы я был странствующим самураем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010919
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010919,
					"content": "Мы так и подумали, когда в первый раз увидели тебя. Но, если честно, по твоим речам не скажешь, что ты любитель размахивать мечом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010920
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010920,
					"content": "Я обучался владению как мечом, так и словом. Неужели это плохо: продолжать учиться на дороге странствий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010921
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010921,
					"content": "Не собираюсь хвастаться своим мастерством, но я встречал множество достойных воинов с разных уголков света. И я кое-что знаю о навыках твоего будущего соперника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010922
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010922,
					"content": "Для победы над ним тебе вполне хватит своих талантов и пары моих советов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010923
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010923,
					"content": "Ну-ка погоди. Тебе не кажется, что это слегка нарушает правила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010924
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010924,
					"content": "Сбор информации является неотъемлемой частью подготовки к любой дуэли. Нужно знать своего врага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010925
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010925,
					"content": "#На пути из Мондштадта {NICKNAME} победил{F#а} во множестве сражений. А это требует немного большего, чем слепую храбрость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010926
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010926,
					"content": "Вот именно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010927
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010927,
					"content": "Постой, а откуда ты знаешь? Мы ведь не говорили, что были в Мондштадте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010928
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010928,
					"content": "Хе-хе, думаете, вы не оставили следов на своём пути странствий? В ответ ваш путь оставил свой след на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010929
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010929,
					"content": "Однако этот след не может рассказать всё, и меня терзает любопытство. Я хотел бы задать столько вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010930
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010930,
					"content": "Следуйте за мной. Вам нужно отдохнуть после сражения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010916,
					"content": "Мы должны добраться до Инадзумы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010910,
					"content": "#Рад{F#а}, что скоро всё закончится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010905,
					"content": "Ты очень наблюдателен.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				}
			]
		},
		{
			"id": 200111,
			"completionStepIds": [
				200111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200111",
							"2"
						],
						"stepId": 200111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011101,
					"content": "Теперь, когда мы оказались наедине, позволь мне сразу перейти к делу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011102
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011102,
					"content": "Ты умеешь владеть элементами. Не одним, а несколькими. Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011103,
						20011104
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011103,
					"content": "Так ты уже знаешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "Паймон сразу поняла, что ты на что-то намекаешь. Всё это время ты знал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011106,
					"content": "Да. Если бы другие участники прослышали о твоих элементальных способностях, то это, скажем так, вызвало бы некоторое недопонимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011107,
					"content": "Если не ошибаюсь, ты тоже берёшь во внимание этот факт. Ведь ты сдерживаешься от использования элементов в пылу сражения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011108,
					"content": "Да, но как ты догадался?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "Хе-хе, когда я говорю о том, что слышу или вижу в тебе, это вовсе не поэтический символизм. Я использую эти слова в самом их прямом смысле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011110,
					"content": "Я с малых лет понимаю природу. Я слышу дыхание ветра и шёпот листьев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011111,
					"content": "И я слышу подобные вещи внутри тебя, вот и всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011112,
					"content": "Звучит бредово, но Паймон почему-то тебе верит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011113,
					"content": "Мои скромные навыки ничтожны в сравнении с твоими невероятными способностями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011114,
					"content": "Человек, не обладающий Глазом Бога, способен контролировать силу элементов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011115,
					"content": "И твой причудливый аромат напоминает какое-то таинственное существо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011116,
					"content": "Эй, хватит оценивать нас по запаху!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011117,
					"content": "#Не мог{F#ла} бы ты поделиться со мной знанием о том, как обуздать силу сразу двух элементов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011118,
					"content": "#Боюсь, я сам{F#а} этого не знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "Хмм... Исключительный случай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011121,
					"content": "А могу ли я осмелиться спросить, как именно у тебя получается направлять элементальную энергию? Не только в обычной жизни, но и в пылу сражения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011122,
					"content": "Всё благодаря наставлениям Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "#Хе-хе, я ничего не делала. Просто сказала {F#ей}{M#ему}, что первое на ум пришло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011125,
					"content": "#Наше путешествие было долгим и интересным. И каким-то образом {F#она сама}{M#он сам} потихоньку во всём разобрал{F#ась}{M#ся}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011126,
					"content": "Честно говоря, Паймон и сама не понимает, как всё это устроено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011127,
					"content": "Может быть, в таких непостижимых вещах и содержится сущность богов и Глаз Бога, которыми они одаривают людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011128,
					"content": "Тем не менее я всё же хочу удостоиться чести посмотреть на твои навыки владения элементами со стороны. Может быть, это сможет навести меня на нужные мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011129,
					"content": "Конечно же, я тоже поделюсь с тобой своими знаниями. Чтобы сделать этот обмен честным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011130,
					"content": "Справедливо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "#Ну что ж, давай проверим, на что ты способ{F#на}{M#ен}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011131,
					"content": "Наконец-то, настоящая битва.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "Всё благодаря дружбе с Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "#Я всего лишь прикоснул{F#ась}{M#ся} к статуе семи Архонтов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "Понятно, почему ты не мог сказать это прямо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
		{
			"id": 200113,
			"completionStepIds": [
				200113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200113",
							"2"
						],
						"stepId": 200113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011301,
					"content": "Хм, твои боевые навыки и правда безупречны. Твоему сопернику не поможет его проворность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011302
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011302,
					"content": "Он научился контролировать своё дыхание и равновесие, что позволило ему выполнять невероятные движения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011303
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011303,
					"content": "В сражении он всецело полагается на элемент неожиданности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011304
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011304,
					"content": "Держи в уме его способность замечать слабые места, и тогда его атаки не представят для тебя никакой угрозы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011305
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011305,
					"content": "Спасибо. Я отнесусь серьёзнее к бою.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011306
					]
				},
				{
					"id": 20011306,
					"content": "Перестань. Это я должен благодарить тебя за возможность стать свидетелем использования элементов вопреки всем известным законам природы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011307
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011307,
					"content": "Всё-таки мир полон загадок, и необъяснимое подстерегает на каждом шагу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011308
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011308,
					"content": "Ты так интересуешься Глазом Бога... У тебя ведь есть свой. Зачем ты стремишься понять связь между Глазами Бога и элементами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011309,
					"content": "Я хочу знать, какое значение имеют Глаза Бога для самих богов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011310
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011310,
					"content": "И что определяет выбор бога наделить им смертного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011311
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011311,
					"content": "Боюсь, вы тоже не сможете дать ответы на эти вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011312
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011312,
					"content": "За предоставленную мне честь быть свидетелем таинств мира я готов ответить на любые ваши вопросы об Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011313
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011313,
					"content": "Я хочу знать ответы на твои вопросы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011314
					]
				},
				{
					"id": 20011314,
					"content": "Значит, тебе тоже интересно? Ха-ха, тогда давай я тебе кое-что расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011315
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011315,
					"content": "Прибыв в Инадзуму, ты быстро узнаешь, что там действует указ об охоте на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011316
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011316,
					"content": "Глаз Бога - это дар богов. Теперь у принявших этот дар людей без объяснений их конфискуют, зачастую не гнушаясь и убийствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011317
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011317,
					"content": "Если каждый из семи Архонтов даровал Глаза Бога смертным, то значит ли это, что у Электро Архонта появились сомнения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011318
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011318,
					"content": "Электро Глаз Бога не появлялось уже очень давно. Это отражает отношение сёгуна Райдэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011319
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011319,
					"content": "Она больше похожа на деспота, чем на Архонта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011320,
					"content": "Насколько я знаю, она преследует «вечность». Она будет неустанно исполнять свою волю, не обращая внимания на чувства и мысли других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011321
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011321,
					"content": "«Контракты» Ли Юэ приносят пользу всем жителям Ли Юэ. А какую пользу приносит «вечность» людям Инадзумы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011322
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011322,
					"content": "...Само собой, у находящихся под замком Инадзумы людей дела идут худо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011323
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011323,
					"content": "#Очень похоже на поведение той богини, с которой ты столкнул{F#ась}{M#ся} в начале своего путешествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011324,
					"content": "О? Так вы уже сталкивались с Электро Архонтом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011325,
						20011326
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011325,
					"content": "Это не точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				},
				{
					"id": 20011327,
					"content": "Течение времени может изменить нас, но не сёгуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011328
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011328,
					"content": "Она всегда будет там же, где и была.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011329
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011329,
					"content": "Когда-нибудь я тоже захочу узнать от неё ответ на вопрос «вечности».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011330
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011330,
					"content": "Ну всё, ваш финальный бой скоро начнётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011331
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011331,
					"content": "Ой, точно! Мы так заболтались об Инадзуме, что Паймон совсем забыла про турнир.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20011332,
					"content": "Если у вас нет других дел, мы можем вернуться вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011333,
						20011335
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011333,
					"content": "Конечно, пойдём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011334
					]
				},
				{
					"id": 20011334,
					"content": "Хорошо. Не терпится увидеть, кому же удастся получить Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011335,
					"content": "Я тебя догоню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011336
					]
				},
				{
					"id": 20011336,
					"content": "Хорошо. Только не опоздай к началу боя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20011326,
					"content": "Это было очень давно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				}
			]
		},
