	"talks": [
		{
			"id": 200103,
			"completionStepIds": [
				200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200103",
							"2"
						],
						"stepId": 200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бэй Доу",
					"Каэдэхара Кадзуха",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "Ха-ха-ха, не зря я выбрала тебя в качестве своего фаворита!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010302,
					"content": "#Кадзуха, ты ведь тоже заметил? {F#Она}{M#Он} даже не {F#вспотела}{M#вспотел}. Это потрясающе, чистая победа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010303,
					"content": "#Впечатляет. Однако я также заметил, как наш фаворит {F#сдерживала}{M#сдерживал} себя, словно оберегая соперника от ненужных травм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010304,
					"content": "#Я прошла через множество битв, больших и малых, и в этом бою я ощутила {F#её}{M#его} истинную силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010305,
					"content": "#Давай же! Мы все знаем, насколько у тебя подвешен язык. Не хочешь сказать пару слов в честь {F#нашей будущей чемпионки}{M#нашего будущего чемпиона}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010306,
					"content": "Безусловно! Дайте секундочку, я попытаюсь получше сформулировать хвалебную речь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010307,
					"content": "#...Ты {F#сражалась}{M#сражался} хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010308,
					"content": "И это всё? После такого боя твоего внутреннего поэта не удосужилась посетить муза? Ладно, я не буду тебя смущать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010309,
					"content": "#Знаешь, многие участники подходили ко мне удивлённые тем, что в турнире принимает участие {F#героиня}{M#герой} Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010310,
					"content": "...После тебя нахлынула целая прорва новых участников, среди которых оказалось много по-настоящему достойных бойцов. Мне кажется, все они хотят испытать свои силы против тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010311,
					"content": "#Даже не {F#подозревала}{M#подозревал} о своей популярности...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "Ха-ха, все видят в тебе цель, которую нужно победить. Я решила, что буду делать так же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010314,
					"content": "С одной стороны, мы не хотим тратить твоё время и силы на соперников, которые явно слабее тебя. С другой стороны, ты ведь наверняка тоже хочешь сразиться с кем-то, кто больше подходит тебе по уровню?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010315,
					"content": "Поэтому я сразу ставлю тебя против полуфиналистов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010316,
					"content": "Что? Но ведь мы только начали отборочный тур... Что у вас за система такая, где можно перескочить сразу в полуфинал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010317,
					"content": "Если капитан Бэй Доу так решила, то её уже не переубедить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010318,
					"content": "Да и судя по вашим навыкам, вы бы всё равно спокойно дошли до полуфинала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010319,
					"content": "Если честно, Паймон с вами согласна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010320,
					"content": "Ладно, я останусь понаблюдать за турниром. Если вдруг появятся достойные соперники для тебя, я хочу знать о них всё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010321,
					"content": "Вот мы и здесь, народ! Сегодня нас ждёт настоящее зрелище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010322,
					"content": "Хе-хе, похоже, капитан возлагает большие надежды на этот турнир. Я давно не видел её в таком настроении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010323,
					"content": "Твой соперник совершил немало побед, чтобы добраться до полуфинала. Должно быть, он закалённый воин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010324,
					"content": "Может, его сила и не сравнится с твоей, но всё же не стоит относиться к нему легкомысленно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010325,
					"content": "Не буду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "#Отлично. Покажи мне, {F#готова}{M#готов} ли ты прорваться через шторм, что ждёт нас впереди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 20010328,
					"content": "Ну всё, хватит болтать. Болельщики заждались. Найди девушку, которая тебя регистрировала. Она проводит тебя на арену.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бэй Доу"
				},
				{
					"id": 20010326,
					"content": "#Я не {F#забыла}{M#забыл}, зачем я здесь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "Не понимаю, чего все суетятся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
		{
			"id": 200106,
			"completionStepIds": [
				200106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200106",
							"2"
						],
						"stepId": 200106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жун Ши",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "Я весь вспотел. Хорошее ощущение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010602,
					"content": "Признаю, меня одолел достойный соперник. Мне нужно больше тренироваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010603,
					"content": "Ты тоже неплохо сражался.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "Да! Паймон уже начала немного волноваться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010606,
					"content": "Ты бы точно был самым сильным, если бы у тебя был Глаз Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010607,
					"content": "Я мечтал получить Глаз Бога в детстве. Мне говорили, что для этого нужно быть самым сильным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010608,
					"content": "Но он у меня так и не появился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010609,
					"content": "В итоге я потерял интерес и стал полагаться только на своё тело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010610,
					"content": "Бывало, я побеждал в боях с обладателями Глаза Бога. Эта сила была дана им богами. И я этому не завидую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010611,
					"content": "Чего? Значит, ты записался на турнир не для того, чтобы выиграть свободный Глаз Бога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010612,
					"content": "Нет. Я только хотел сразиться с другими бойцами и увидеть, кто сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010613,
					"content": "О своих ошибках и слабостях можно узнать только из поражений. Поэтому я рад исходом сегодняшнего поединка. Мне не часто приходится испытывать поражение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010614,
					"content": "Ничего себе... Очень сильная речь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010615,
					"content": "Если будет желание, приходи снова сразиться со мной. В следующий раз я буду сильнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010616,
					"content": "И я тоже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "Кстати... А ты знаешь, кто ещё прошёл в финал? Неужели кто-то сильнее тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20010618,
					"content": "Не знаю, насколько он сильный, но говорят, что он необычайно быстр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010619,
					"content": "Поэтому не теряйте бдительности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жун Ши"
				},
				{
					"id": 20010604,
					"content": "Мне кажется, ты мог бы стать чемпионом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				}
			]
		},
		{
			"id": 200109,
			"completionStepIds": [
				200109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
