				{
					"id": 230060301,
					"content": "#Путешественн{F#ица}{M#ик}, ты хочешь о чём-то спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060302,
					"content": "Расскажи мне о докторе Закарии...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Доктор Закария - прекрасный специалист и верный последователь Дендро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060304,
					"content": "Он всегда лечит больных не жалея себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060305,
					"content": "Доктор Закария также мечтает, чтобы благословения Дендро Архонта принесли пользу как можно большему количеству людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060306,
					"content": "Ваше лечение основывается на благословениях Дендро Архонта?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Если быть точнее, то лечение болезни - это милость Дендро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060308,
					"content": "Дендро Архонт защищает нас, а также помогает нам в лечении больных и в выращивании целебных трав...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060309,
					"content": "Благодаря милости Дендро Архонта, все болезни обходят нас стороной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гольшан"
				}
			]
		},
