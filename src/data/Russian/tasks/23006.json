			"trigger": {
				"objectNames": [
					"Гольшан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "И как же сейчас найти кого-либо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "З-здравствуйте, путешественники! Вам нужен врач?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060104,
					"content": "Да нет, мы просто проходили мимо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "Ха-ха, неужели по мне видно? Эх, я на самом деле очень переживаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060107,
					"content": "Почему-то в последнее время всё больше и больше людей приходят в Бимарстан для лечения. Поэтому почти все наши люди ухаживают за больными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060108,
					"content": "Но доктор Закария настаивает, чтобы я каким-то образом вычистила окрестности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060109,
					"content": "Он сказал, что нужно поддерживать как душевную чистоту, так и чистоту в больнице и за её пределами, чтобы Дендро Архонт продолжила благословлять нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060110,
					"content": "Увы, я не могу найти кого-либо и не смею просить о помощи больных с лёгкими симптомами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060111,
					"content": "Лучше предоставьте это мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "Ты хочешь помочь нам? Большое спасибо! Тебя будет ждать награда, хоть и не очень большая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060123,
					"content": "Да хранит тебя Дендро Архонт от всех недугов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060113,
					"content": "А нельзя ли нанять кого-либо на помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "Здесь мало здоровых, поэтому никто не может помочь. Наши средства также ограничены, поэтому мы не можем нанять много людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060115,
					"content": "Обычно мы дежурим по очереди, но сейчас так много работы, что ни у кого нет времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060116,
					"content": "#Путешественни{F#ца}{M#к}, может, выручишь нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060117,
					"content": "Тебя будет ждать награда, хоть и не очень большая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060118,
					"content": "Что за болезнь здесь свирепствует?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "У пациентов наблюдаются лёгкие симптомы, такие как головная боль и так далее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060120,
					"content": "Доктор Закария всё время твердит, что эта болезнь не опасна, но его никто не слушает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060121,
					"content": "Мне кажется, все боятся не самой болезни, а всей этой ситуации, связанной с болезнью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060122,
					"content": "#Тогда поручаю тебе вычистить близлежащие окрестности. Спасибо, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Гольшан"
				},
				{
					"id": 230060105,
					"content": "Мы просто увидели твой печальный вид...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
