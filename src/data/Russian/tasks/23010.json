					"Джафар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100801,
					"content": "Друг, я вижу, ты очень спешишь. Что тебя тревожит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100802,
					"content": "Много всего...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "Ох... Твоё лицо выглядит уставшим, но ты явно куда-то торопишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100804,
					"content": "Скорее всего, тебе не даёт покоя какая-то неотложная задача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100809,
					"content": "Надеюсь, ты согласишься немного задержаться, сесть со мной за стол и насладиться вкусной едой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100810,
					"content": "Люди постоянно куда-то спешат, крутятся, как белка в колесе... Но недаром говорят, что даже самая бурная река временами затихает, превращаясь в безмятежный ручеёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100811,
					"content": "Как бы много ни было хлопот, всегда нужно оставлять себе пару минут на отдых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100812,
					"content": "Дай-ка подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100813,
					"content": "Позволь мне угостить тебя шаурмой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100814,
					"content": "Я не возьму с тебя ни одной моры, только принеси мне кусок сырого мяса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100815,
					"content": "Неважно, как ты его добудешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100816,
					"content": "И помни, тебе нужно всего лишь принести мне кусок мяса, а не ключ от всех дверей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100805,
					"content": "Да нет, всё нормально.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "О, это замечательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100807,
					"content": "Но я вижу, что ты страшно торопишься, очевидно, какое-то важное дело не терпит промедления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100808,
					"content": "Я ничего не знаю о твоих делах, но у меня есть одно предложение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Джафар"
				}
			]
		},
