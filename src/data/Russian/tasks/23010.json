					"Джафар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "Друг, я вижу, ты очень спешишь. Что тебя тревожит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100102,
					"content": "Много всего...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "Ох... Твоё лицо выглядит уставшим, но ты явно куда-то торопишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100104,
					"content": "Скорее всего, тебе не даёт покоя какая-то неотложная задача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100109,
					"content": "Надеюсь, ты согласишься немного задержаться, сесть со мной за стол и насладиться вкусной едой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100110,
					"content": "Люди постоянно куда-то спешат, крутятся, как белка в колесе... Но недаром говорят, что даже самая бурная река временами затихает, превращаясь в безмятежный ручеёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100111,
					"content": "Как бы много ни было хлопот, всегда нужно оставлять себе пару минут на отдых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100112,
					"content": "Дай-ка подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100113,
					"content": "Позволь мне угостить тебя тарелочкой мятно-фасолевого супа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100114,
					"content": "Я не возьму с тебя ни одной моры, только веточку мяты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100115,
					"content": "#Да, когда станешь искать мяту, не будь слишком придирчив{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100116,
					"content": "Помни, ты ищешь простую мяту, а не новые приключения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100105,
					"content": "Да нет, всё нормально.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "О, это замечательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100107,
					"content": "Но я вижу, что ты страшно торопишься, очевидно, какое-то важное дело не терпит промедления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100108,
					"content": "Я ничего не знаю о твоих делах, но у меня есть одно предложение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Джафар"
				}
			]
		},
