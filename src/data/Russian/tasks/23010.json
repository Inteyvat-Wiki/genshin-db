			"dialogs": [
				{
					"id": 230100301,
					"content": "Отличная мята. Подожди немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100302,
					"content": "Джафар достаёт остальные ингредиенты и начинает готовить...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "#Это мятно-фасолевый суп из мяты, которую ты добыл{F#а}. Угощайся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100304,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "Не благодари. Просто наслаждайся вкусом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100306,
					"content": "Когда на столе вкусная еда, все проблемы и трудности, которые обычно не дают мне покоя, уходят на второй план...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100307,
					"content": "И мысли текут безмятежным ручейком по тихому руслу... Так я обычно и расслабляюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "Джафар"
				},
				{
					"id": 230100308,
					"content": "Ну что, не откажи себе в удовольствии попробовать это прекрасное блюдо. Надеюсь, оно и тебе поможет расслабиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джафар"
				}
			]
		},
