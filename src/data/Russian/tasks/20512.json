				"points": []
			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "Следующий ингредиент ещё необычнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120102,
					"content": "Как поживает Анна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "О, привет. Ты не поверишь, но Анна говорит, что ей намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120104,
					"content": "Возможно, снадобье целителя действует? Что-то я на этот счёт сомневаюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120105,
					"content": "Как бы то ни было, нужно продолжать следовать рецепту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120106,
					"content": "#Следующий ингредиент рецепта... Хм. Ты не мог{F#ла} бы принести мне концентрированную слизь Гидро слайма?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120107,
					"content": "Вполне себе обычный ингредиент.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "Да ну? Наоборот, очень странный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120109,
					"content": "Слизь эту хоть легко найти. Я тут поспрашивал, и мне сказали, что концентрированную слизь можно добыть, убив крупного слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120110,
					"content": "А ещё Джек сказал, что большой слайм появится, если убивать маленьких.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120111,
					"content": "Боец из меня неважный, поэтому дело за тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120112,
					"content": "Выглядит съедобно, не переживай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "#Откуда ты знаешь? Ты её пробовал{F#а}? Эй, скажи что-нибудь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120114,
					"content": "Достаточно, не будем об этом. Я тут поспрашивал, и мне сказали, что концентрированную слизь можно добыть, убив крупного слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120115,
					"content": "А ещё Джек сказал, что большой слайм появится, если убивать маленьких.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120116,
					"content": "Боец из меня неважный, поэтому дело за тобой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120117,
					"content": "Нет проблем. Я знаю, где они водятся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "О, замечательно. Похоже, ты хорошо знаешь, как обращаться со слаймами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120119,
					"content": "#Спасибо, что согласил{F#ась}{M#ся} помочь. Чтобы добыть концентрированную слизь, убей большого слайма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120120,
					"content": "А ещё Джек сказал, что большой слайм появится, если убивать маленьких.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120121,
					"content": "Тогда удачи тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
		{
