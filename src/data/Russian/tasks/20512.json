			"dialogs": [
				{
					"id": 205120301,
					"content": "#Ты уже наш{F#ла}{M#ёл} слизь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120302
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "Какая же она... густая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120304,
					"content": "Неужели этой гадостью можно лечить? Сперва я испробую её на себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120305,
					"content": "Если со мной вдруг что случится, отведи Анну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120306,
					"content": "...к сестре Грейс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120307,
					"content": "И скажи Анне, что я отбыл в дальние края на поиски работы. Таково моё последнее желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120308,
					"content": "Что ты, только страху на себя навёл.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "Но это снадобье и правда страшное! Вот, возьми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120310,
					"content": "И не забудь о том, что я сказал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		}
	]
