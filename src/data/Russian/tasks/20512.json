			"dialogs": [
				{
					"id": 205120201,
					"content": "#Ты уже наш{F#ла}{M#ёл} слизь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120202
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 205120202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120203
					]
				},
				{
					"id": 205120203,
					"content": "Ну да, речь всё-таки идёт о серьёзном сражении. Ты сначала подготовься как следует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Энтони"
				}
			]
		},
