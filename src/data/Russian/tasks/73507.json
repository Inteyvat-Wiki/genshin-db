			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хания",
					"Бальфур"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#Золотой метеор {NICKNAME} и Серебряный спутник Паймон, давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070102,
					"content": "Вы, как всегда, в хорошем расположении духа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070103,
					"content": "Ты тоже выглядишь вполне бодро.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "Ха-ха-ха... Хания! И Бальфур!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070105,
					"content": "Не думала, что мы снова встретимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070114,
					"content": "Ладно, ближе к делу. Что вы здесь делаете? Если Паймон правильно помнит, здесь можно купить цветочный агар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070115,
					"content": "#О великие {F#героини}{M#герои}! Одни только ваши голоса придают мне уверенности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070116,
					"content": "Приступаю к докладу о результатах нашей работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070117,
					"content": "Ранее вы заявили, что Турнир укротителей «Кубок лотоса нилотпала» должен быть приостановлен до тех пор, пока Академия не улучшит жемчужину мудрости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070118,
					"content": "Полагаю, вы до сих пор ждёте уведомления по этому вопросу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070119,
					"content": "Да, именно так! Лайла, Сайно или уполномоченные исследователи должны сообщить нам о развитии ситуации, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070120,
					"content": "Паймон, ты же плохо разбираешься в технологических процессах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Ну, так оно и есть. Мы вряд ли смогли бы помочь. Скорее, наоборот, помешали бы им...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070123,
					"content": "Ах, как вы скрупулёзны и терпеливы. Я буквально переполняюсь восторгом, когда вспоминаю грандиозные сцены предыдущего турнира...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070124,
					"content": "Поэтому недавно я попытался разузнать подробности у некоторых сотрудников Академии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070125,
					"content": "В настоящее время усовершенствования жемчужины мудрости проходят теоретическую проверку. Поэтому производство будет начато ещё не скоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070126,
					"content": "Однако дебаты вокруг первого турнира с каждым днём ослабевают и пусть медленно, но забываются. Мы не можем допустить, чтобы влияние предыдущего события было сведено на нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070127,
					"content": "Поэтому я объединился с Ханией, чтобы организовать тематическое событие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070128,
					"content": "Тематическое событие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "Так вот для чего нужны эти фигуры в форме плесенников!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070130,
					"content": "Именно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070131,
					"content": "В рамках организации следующего турнира господин Бальфур искал спонсоров и даже отправился в Ли Юэ, чтобы научиться продвижению мероприятий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070132,
					"content": "В процессе обучения он познакомился с одной игрой под названием «Театр Механикус».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070133,
					"content": "Впоследствии он купил права франчайзинга на эту игру в Сумеру. Пригласил меня в качестве консультанта. Мы создали совершенно новую версию игры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070134,
					"content": "Игра называется Грибомеханикус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070135,
					"content": "Грибомеханикус?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070136,
					"content": "Дай-ка угадаю... Итак, мы будем командовать различными плесенниками, чтобы сразиться с какими-нибудь механизмами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070137,
					"content": "Ха-ха! Ты и вправду проницательна, Серебряный спутник. Сразу всё поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070138,
					"content": "Я считаю, что игра достаточно проста для понимания и распространения, а также обладает большим потенциалом, который стоит того, чтобы его раскрыли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070139,
					"content": "Если мы сможем успешно продвигать её как дополнение к Турниру укротителей, то его запомнят надолго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070140,
					"content": "Таким образом, следующий турнир привлечёт больше зрителей и участников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070141,
					"content": "Разумеется, это возможно только с вашего разрешения. За вами последнее слово в вопросе организации турнира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070142,
					"content": "Думаю, стоит попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Ну, {NICKNAME} и Паймон на самом деле не так уж много знают о том, как вести дела, но Паймон считает, что ты думаешь в правильном направлении, Бальфур!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070145,
					"content": "Вы с Ханией работали над этой игрой не покладая рук, и Паймон верит в вас. Так что дерзайте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070146,
					"content": "Мы сами ещё не играли в неё, но Паймон уверена, что игра многим понравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070147,
					"content": "Замечательно! Поскольку вы согласны, я могу начать рекламировать Грибомеханикус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070148,
					"content": "В данный момент игра находится на стадии тестирования, поэтому нам необходимо пригласить желающих протестировать её и собрать отзывы, чтобы провести дальнейшие улучшения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070149,
					"content": "#Я не сомневаюсь, что именно ты внесёшь лучшие предложения, ведь ты, Золотой метеор, наверняка не раз участвовал{F#а} во всевозможных играх по всему Тейвату!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070150,
					"content": "#Хе-хе, давай сделаем это, {NICKNAME}! Ведь это одна из твоих самых сильных сторон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070151,
					"content": "Почему возникает ощущение, что ты мной командуешь, Паймон?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Хания, у Паймон есть вопрос к тебе в связи с игрой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070154,
					"content": "Ты хочешь спросить о Бам-бам-шапочке и других?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070155,
					"content": "Именно так! Паймон скучает по друзьям-плесенникам. Как они поживают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070156,
					"content": "Не волнуйся. У них всё отлично, они живут счастливо и беззаботно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070157,
					"content": "Кручезверь и Громовёрт сейчас в моей <color=#00E1FFFF>временной резиденции в северной части Порт-Ормоса</color>. Одна из бывших участниц турнира заботится о них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070158,
					"content": "Бам-бам-шапочка и Огнерадость где-то поблизости. Если хочешь, Серебряный спутник, можешь пойти поиграть с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070159,
					"content": "#Поблизости, говоришь! {NICKNAME}, Паймон пойдёт поищет Бам-бам-шапочку, пока ты будешь тестировать игру, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070160,
					"content": "Иди-иди!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Тогда не будем терять времени. Золотой метеор, тестовая версия Грибомеханикуса ждёт тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070161,
					"content": "Я присоединюсь к тебе чуть позже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "Так и есть! Золотой метеор вперёд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Ты приложил много усилий!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Я плохо разбираюсь в технологических процессах и не могу ничего предложить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "Кто вы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#{NICKNAME}, ты чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070108,
					"content": "Помнишь, мы участвовали в Турнире укротителей «Кубок лотоса нилотпала»? Как же здорово мы тогда повеселились с друзьями-плесенниками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070109,
					"content": "Тогда-то мы и подружились с Ханией, а Бальфур был во главе рабочей группы на предыдущем событии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070110,
					"content": "Бам-бам-шапочку и Кручезверя ты тоже не помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070111,
					"content": "#А! Вспомнил{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "Нельзя так пугать! Паймон уже хотела мчаться за доктором!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070112,
					"content": "#Я же просто пошутил{F#а}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				}
			]
		},
		{
			"id": 7350703,
			"completionStepIds": [
				7350703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
