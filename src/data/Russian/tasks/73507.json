						735070507
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 735070507,
					"content": "Как обстоят дела с тестированием Грибомеханикуса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070508,
						735070509
					],
					"speakerTitle": "Паймон"
				},
				{
