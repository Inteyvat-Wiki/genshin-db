			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Бальфур",
					"Хания"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "Как всё прошло, Золотой метеор? Расскажи о своих первых впечатлениях от игрового процесса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070302,
					"content": "#Судя по выражению твоего лица, я полагаю, что ты пока не сделал{F#а} выводы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070303,
					"content": "#Я попробовал{F#а} пройти только один раунд.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Это правда. Довольно сложно судить о достоинствах и недостатках Грибомеханикуса на основании одного только этого тестового контента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070306,
					"content": "Не расстраивайся. Мы с Ханией пробудем здесь некоторое время и каждый день будем предлагать тебе по одному новому уровню Грибомеханикуса. Всего уровней семь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070307,
					"content": "Приходи, когда будет время, и ты получишь возможность протестировать все уровни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070308,
					"content": "Хотя именно ты осуществляешь общий надзор в этих вопросах, игру мы с Ханией разработали по собственной инициативе. Наверняка в твои планы не входит тратить на неё время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070309,
					"content": "В связи с этим мы готовы оплатить твой труд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070310,
					"content": "Ха-ха, от этого я не откажусь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "#Ха-ха, ты очень {F#прямолинейна}{M#прямолинеен}! Мне нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Бальфур"
				},
				{
					"id": 735070313,
					"content": "Я запросила права на проживание для двух плесенников, так что они будут находиться в Порт-Ормосе во время тестирования Грибомеханикуса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070314,
					"content": "А Серебряный спутник сможет подольше поиграть с Бам-бам-шапочкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070315,
					"content": "Главное, чтобы Паймон была счастлива!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Хе-хе, тебе стоит сходить вместе с Паймон, Бам-бам-шапочка скучает по тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070318,
					"content": "Возьми, можешь покормить Бам-бам-шапочку и Огнерадость. Это их любимое лакомство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хания"
				},
				{
					"id": 735070316,
					"content": "Мне тоже не терпится!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "Ты возместишь эти расходы за счёт следующего турнира!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "Потребуется провести дополнительное тестирование.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				}
			]
