	"talks": [
		{
			"id": 1100102,
			"completionStepIds": [
				1100102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100102",
							"2"
						],
						"stepId": 1100102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Драфф"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010201,
					"content": "Ты, должно быть, Сян Лин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010202
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010202,
					"content": "Прошу прощения! Это всё моя вина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010203
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010203,
					"content": "Я знаю, что ты натворила. Раз уж ты пришла сама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010204
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010204,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010205,
						110010206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110010205,
					"content": "Насилием проблему не решить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				},
				{
					"id": 110010207,
					"content": "Помоги мне рекламировать наши мясные продукты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010208
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010208,
					"content": "Э... Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010209
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010209,
					"content": "Позволь мне объясниться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010210
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010210,
					"content": "У Спрингвейла первоклассная репутация мясного поставщика, но сейчас наши продукты известны только в Мондштадте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010211
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010211,
					"content": "Когда я узнал, что маэстро Сян Лин в городе, то сразу же послал за тобой Аллана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010212
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010212,
					"content": "Маэстро?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110010213,
					"content": "Ты разве не в курсе? У Сян Лин лучший ресторан классической кухни в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010214
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010214,
					"content": "Шедевры Сян Лин покорили сердца всех жителей города и не перестают удивлять путешественников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010215
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010215,
					"content": "Ох, не надо перехваливать меня. Я готовлю простую и вкусную еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010216
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010216,
					"content": "Первоклассный шеф-повар готовит первоклассные блюда... Из первоклассного спрингвейлского мяса. Весь Тейват узнает об этом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010217
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010217,
					"content": "Хм... Ммм... Надо подумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010218
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010218,
					"content": "Для меня самое главное - это готовить вкусную еду. Я никогда не ограничивала себя конкретным набором ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010219
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010219,
					"content": "Я знаю, что ты часто используешь мясо кабана. Не понимаю, в чём проблема?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010220
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010220,
					"content": "Проблема в... Как бы выразиться... Что ты думаешь о слаймовом желе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010221
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010221,
					"content": "Ммм... Как насчёт чего-нибудь более обычного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010222
					],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010222,
					"content": "Для меня не существует обычной еды. При правильной технике из всего на свете можно приготовить вкусное блюдо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010223
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010223,
					"content": "Я не готова загонять своё творчество в рамки определённого списка продуктов. Так ничего дельного не приготовишь, поверь мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010224,
						110010225
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010224,
					"content": "Атмосфера накаляется...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010226,
					"content": "Эх... Раз ты так смотришь на вещи, то нам не по пути. Жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Драфф"
				},
				{
					"id": 110010225,
					"content": "Знаменитые шеф-повара обычно очень вспыльчивы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010206,
					"content": "Если хочешь драки, я могу тебе её устроить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				}
			]
		},
		{
			"id": 1100104,
			"completionStepIds": [
				1100104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100104",
							"2"
						],
						"stepId": 1100104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сян Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010401,
					"content": "Привет! Не возражаешь, если я попробую это ароматное блюдо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010402
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010402,
					"content": "Простите, но у нас всё забронировано на несколько дней вперёд. Я могу записать вас на следующую неделю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010403
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010403,
					"content": "Ого! Должно быть, это нереально вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110010404,
					"content": "Странно. Мне казалось, что известные повара не стоят в очередях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010405
					]
				},
				{
					"id": 110010405,
					"content": "Зачем Драффу нужна помощь Сян Лин, когда в Спрингвейле уже есть свой повар-суперзвезда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110010406,
					"content": "Может, он и думает, что мондштадтские рестораны в подмётки не годятся Ли Юэ, кулинарной столице континента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010407
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010407,
					"content": "Но я так не считаю! Моя еда ничуть не хуже!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010408
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010408,
					"content": "Хм. В таком случае покажи, на что ты способна. Может быть, я смогу дать тебе несколько советов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010409
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010409,
					"content": "Меня больше не интересуют отзывы простых обывателей. Мне интересно только мнение настоящих профессионалов. Погоди, ты же... ты Сян Лин?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010410
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010410,
					"content": "Да, это я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010411
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010411,
					"content": "Та самая Сян Лин? Ты точно разбираешься в кулинарии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010412
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010412,
					"content": "У меня остался отличный кусок мяса. Подскажи, как мне его приготовить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010413
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010413,
					"content": "Это зависит от того, насколько он жирный. Этот кусок я бы пожарила на гриле. Морская соль, заоблачный перчик и цветок цинсинь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010414
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010414,
					"content": "Цветок цинсинь? Но топлёный жир усилит его вкус в десять раз! Он же перекроет все остальные вкусы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010415
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010415,
					"content": "Конечно! Поэтому из цветка цинсинь мы сделаем гарнир. Я бы никогда не стала использовать его для маринада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010416
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010416,
					"content": "Это проверенный рецепт. Если правильное количество времени подержать лепестки цветка цинсинь в масле правильной температуры, то уйдёт вся лишняя горечь, и ты получишь идеальную хрустящую закуску.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010417
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010417,
					"content": "Заоблачный перчик растёт в высокогорных районах. Низкая влажность и большой перепад температур делают его особенно жгучим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010418
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010418,
					"content": "Лепестки впитают жгучесть перчика, мясные соки и морскую соль, и оставят лёгкое цветочное послевкусие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010419
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010419,
					"content": "Ну это совсем перебор! Зачем же так усложнять гарнир?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010420
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010420,
					"content": "Мясо должно быть простым и понятным! Зачем нужны лепестки, если есть стейк?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010421
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010421,
					"content": "Воу-воу-воу! Полегче!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010422,
						110010423
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110010422,
					"content": "Они даже не слышат друг друга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				},
				{
					"id": 110010424,
					"content": "Хм. Есть только один способ выяснить, кто из нас прав!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010425
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010425,
					"content": "Кулинарный поединок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010426
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010426,
					"content": "Идёт! Если ты проиграешь, то это докажет, что Драфф ошибался на твой счёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010427
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010427,
					"content": "Ладно! Но если победа будет за мной, то охотники Спрингвейла должны будут согласиться на мои условия. Я буду готовить свои блюда из вашего мяса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010428
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010428,
					"content": "А если проиграешь, то моё блюдо появится в меню ресторана «Народный выбор»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010429
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010429,
					"content": "С подписью: «Специальное блюдо, которое подарил нашему ресторану щедрый шеф-повар Брук из Спрингвейла, эксперт по мясу»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010430
					],
					"speakerTitle": "Брук"
				},
				{
					"id": 110010430,
					"content": "Идёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010431
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010431,
					"content": "Я отправляюсь за продуктами! Увидимся в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010432
					],
					"speakerTitle": "Сян Лин"
				},
				{
					"id": 110010432,
