			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "Итак, что теперь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170202,
					"content": "Мы сфотографируем тебя. Мы всё сделаем сами, а ты просто встань вон там и прими позу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120170203,
					"content": "Словом, фотографии запечатлевают мгновения, поэтому из них получаются отличные сувениры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120170204,
					"content": "А что означает «принять позу»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170205,
					"content": "На фотографиях запечатлевается картинка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "Ясно. Иными словами, я должна сделать какой-нибудь приятный глазу жест?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170207,
					"content": "От этой мысли мне становится как-то неловко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170208,
					"content": "Какую позу мне принять? Подскажите. Чтобы красиво, но и без крайностей. Я ничего в этом не смыслю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170209,
					"content": "Элегантную и благородную.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "Хорошо... попробую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170215,
					"content": "Пойдёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "Ладно, приступим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170219,
					"content": "Выберем хороший угол, чтобы увековечить это мгновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120170216,
					"content": "Попробуй что-нибудь другое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "Хорошо, решай ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170211,
					"content": "Солидную и грозную.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "На меня это не похоже. Так пойдёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Эи"
				},
				{
					"id": 120170213,
					"content": "Расслабленную и непринуждённую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "Непринуждённую... Как насчёт этого? Чувствуется вполне естественно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Эи"
				}
			]
		},
		{
