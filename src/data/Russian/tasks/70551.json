						"rawParams": [
							"7055106",
							"2"
						],
						"stepId": 7055106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмилия"
				],
				"points": [
					{
						"sceneId": 51206,
						"position": [
							2192.554,
							230.089,
							-777.292
						],
						"pointId": 1
					},
					{
						"sceneId": 51206,
						"position": [
							2195.024,
							230.219,
							-779.316
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "Госпожа Эмилия, прошу вас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "За твоими движениями так приятно наблюдать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510203,
					"content": "Хм... Это местная версия «Сумерек Люмидус»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510204,
					"content": "В яблочко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "Вкус мягкий и деликатный, разделённый на уровни, в сочетании с лёгким мондштадтским ароматом получился вполне приятный напиток. Нет ни одного ингредиента, который мог бы привнести дисгармонию...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510207,
					"content": "#Но на самом деле тебе ни к чему быть {F#такой осторожной}{M#таким осторожным}. Я готова к вкусовым сочетаниям, которые выходят за рамки привычного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510208,
					"content": "Значит, этот напиток показался тебе слишком традиционным?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "У тебя получился отличный напиток, но, конечно, было бы просто идеально, если бы тебе удалось приготовить что-то более «глубокое»: коктейль, отражающий твоё личное видение Мондштадта, способный углубить моё впечатление об этом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510211,
					"content": "Нам некуда спешить. Можем пока побеседовать. Вдруг наш разговор подарит тебе вдохновение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510212,
					"content": "Ты сейчас купила эти цветы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "Это одна из наград за управление цветочным магазином. Важный парфюмерный ингредиент, который помог мне выполнить поручение от таверны «Кошкин хвост»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510214,
					"content": "Много лет назад я исследовала цветок сесилии из Мондштадта. В некоторых сферах аромат сесилии стал синонимом самого Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510215,
					"content": "Однако на этот раз ситуация была необычная: некоторые кошки не слишком привыкли к запаху цветов сесилии, поэтому нужно было учитывать их вкусы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510216,
					"content": "И какие растения ты взяла для составления аромата?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "Ветряной астрой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510219,
					"content": "Разные части ветряной астры я измельчила в порошок для извлечения эссенции, а после смешала ароматы лепестков и листьев. В результате получился аромат, сладостью напоминающий медовое вино, но при этом в нём слышны свежие ноты стеблей и листьев ветряной астры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510220,
					"content": "Я опробовала аромат в таверне «Кошкин хвост», и кошкам он понравился. Посетители также отметили, что новый аромат создаёт уютную атмосферу и одновременно освежает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510221,
					"content": "Я всегда радуюсь, когда получается извлечь превосходный аромат из самых обычных ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510222,
					"content": "Погода сегодня отличная...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "(Значит, вот каково это - начинать разговор с банальной темы...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "Да! Я недавно заметила, как мимо проплыла целая вереница кучевых облаков, похожих на мягкую пряжу... Воздух не слишком влажный, ветер умеренный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510225,
					"content": "В таких условиях обоняние у человека обостряется... но не чрезмерно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510226,
					"content": "При правильном сочетании ароматы естественным образом сливаются со средой, оставляя особенно яркие впечатления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510227,
					"content": "#Я не знал{F#а}, что погода влияет на восприятие запахов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "Думаю, смешивание коктейлей чем-то напоминает парфюмерное дело: сначала выбираешь базу нужной крепости, затем начинаешь сочетать в напитке разные вкусы в разных пропорциях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510230,
					"content": "Если всё сделать правильно, ингредиенты будут работать как единое целое, создавая чудесную симфонию для вкусовых рецепторов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510231,
					"content": "Кажется, я понимаю. Главное - гармония вкусов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "Да, верно! Я сейчас поняла, что на самом деле не очень люблю, когда вкус делится на уровни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510234,
					"content": "Что ты обычно пьёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "Обычно... после работы друзья из Палаты Жардинаж иногда приглашают меня выпить. Чаще всего я заказываю фруктовый чай, чтобы после встречи быстро вернуть себе рабочий настрой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510236,
					"content": "Если на следующий день выходной и мои друзья находятся в приподнятом настроении, я могу позволить себе небольшой бокал игристого фруктового вина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510237,
					"content": "Офицер по имени Туренна часто угощала меня выдержанным вином Корте из бочки. Но с тех пор, как она перевелась в Особый патруль, я его больше не пила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510238,
					"content": "Значит, иногда ты позволяешь себе алкоголь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "В науке спирт широко используется в качестве растворителя. Я давно привыкла к его запаху.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510241,
					"content": "И потом, лёгкое опьянение меняет мой внутренний настрой, а настрой влияет на создание ароматов... Независимо от того, каким получается результат, это всегда новый опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510242,
					"content": "Так что я не против лёгких напитков. Главное, чтобы алкоголя действительно было немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510243,
					"content": "Как идёт твоя работа над новым ароматом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "Спасибо, всё хорошо. Правда, поездка в Мондштадт обернулась некоторыми... неожиданными испытаниями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510245,
					"content": "Приехав сюда, я проштудировала классический труд «Введение в ароматические вещества и органы чувств человека», чтобы определить самые перспективные местные ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510246,
					"content": "К моему удивлению, пробный аромат на основе валяшки оказался для таверны слишком сладким. Посетители начали клевать носом, а барменша с симпатичными ушками уснула прямо за стойкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510247,
					"content": "#Не думал{F#а}, что валяшка оказывает такой эффект...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "Скажем так: всё хорошо в меру. Разумное ограничение сладкого идёт на пользу и телу, и уму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510250,
					"content": "В повседневной жизни я тоже нечасто ем сладости и стараюсь убирать из меню ягоды и фрукты с чрезмерно высоким содержанием сахара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510251,
					"content": "В итоге я исключила из парфюмерной композиции валяшку и взяла вместо неё ветряную астру. Должна сказать, это принесло определённые результаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510252,
					"content": "Я знаю, как улучшить твой коктейль. Подожди минутку, мне надо скорректировать рецепт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "Хм? Мы едва успели переброситься парой фраз, а ты уже знаешь решение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510254,
					"content": "Наверное, у тебя настоящий талант к созданию коктейлей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510248,
					"content": "Похоже, аромат из валяшки нам не подходит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "#Я думал{F#а}, алкоголь будет слишком большой нагрузкой на твои рецепторы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "Ты любишь, когда вкусы сливаются в единое целое...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "Впервые слышу... Как интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "Каким цветком заменила сесилию?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "Тебе хочется чего-то более необычного?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "Ты сразу угадала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
		{
