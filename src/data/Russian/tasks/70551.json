					}
				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#Добрый день, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510102,
					"content": "...Не думала, что в Мондштадте мне посчастливится увидеть тебя в амплуа бармена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510103,
					"content": "Ты приехала сюда в путешествие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "И то и другое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510106,
					"content": "Одна госпожа, называющая себя ведьмой, пригласила меня заняться её небольшим цветочным магазином. Кроме того, таверна «Кошкин хвост» обратилась ко мне с поручением создать для них новый аромат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510107,
					"content": "И лучшей наградой за такой насыщенный день будет коктейль, который ты приготовишь для меня своими руками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510108,
					"content": "Тогда я постараюсь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "Я доверяю твоему выбору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "Эмилия"
				},
				{
					"id": 705510111,
					"content": "(Эмилия более чувствительна к ароматам, чем большинство людей. Если ароматы будут плохо сочетаться между собой, она наверняка это заметит?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(Иными словами, секрет в том, чтобы выбрать ингредиенты, чьи ароматы не вступают в конфликт, а затем добавить в коктейль ноту фонтейнского колорита.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(Тогда для начала приготовим улучшенную мондштадтскую версию «Сумерек Люмидус».)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "Я приготовлю тебе особый коктейль-сюрприз!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "Ты приехала сюда по работе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
