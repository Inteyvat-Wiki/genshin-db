						"rawParams": [
							"7103713",
							"3"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи Цюн",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "Чем могу быть полезна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411202,
					"content": "Расскажи о картах...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "О картах? Тут и говорить не о чем... Я работала картографом в шахтах до того, как вступила в Гильдию искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411204,
					"content": "Конечно, я не была официальным картографом, сидящим в кабинете... Мне до идеала ещё далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411234,
					"content": "Однажды они поручили мне составить план местности в деревне Цяоин... А после всей этой работы они отменили проект строительства. По их словам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411205,
					"content": "Они поручают помощникам исследовать место, чтобы собрать информацию, а потом уже сами приступают к рисованию карты... Но такие, как я, не могут себе этого позволить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411206,
					"content": "Будучи сродни шахтёрам, я давно привыкла ориентироваться в опасных подземных ходах. Работа требует этого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411207,
					"content": "И... после изменений нижние уровни Разлома были довольно... нестабильными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411208,
					"content": "Нестабильными? Это опасно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710411209,
					"content": "Ну, геологическая структура постоянно меняется. То, что сегодня является подъездной дорогой, к следующему месяцу может стать каменной стеной... Почти как... Не знаю, как описать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411210,
					"content": "Словно Разлом меняется по собственной прихоти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411211,
					"content": "Ох... Неужели всё так ужасно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710411212,
					"content": "Расскажи о карьере искателя приключений...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "Ха-ха, карьера? Громко сказано. Я всего лишь новичок... Только в начале пути, мне до тебя ещё далеко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411214,
					"content": "Хоть я и выполнила несколько поручений для Гильдии искателей приключений, я всё ещё неопытна. Не исследовала ни одного места самостоятельно. И вряд ли о моих деяниях рассказывают истории...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411215,
					"content": "Поэтому я подумала, что здесь, в Разломе, я могла бы оставить свой след, чтобы будущие поколения помнили меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411216,
					"content": "Как однажды сказала великая искательница приключений Алиса, Разлом может быть моим Рубиконом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411217,
					"content": "Что? Рубикон? Это что-то на хиличурлском?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "Паймон никогда о таком не слышала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710411219,
					"content": "Ну... Я и сама не совсем разбираюсь... Алиса - великая искательница приключений, путешествующая по всему миру. Возможно, она и здесь когда-то побывала?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411220,
					"content": "Рубикон? Звучит впечатляюще.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "Эй, да ты сама не знаешь, что это такое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710411222,
					"content": "Ха-ха, в любом случае спасибо за то, что пытаешься поддержать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411223,
					"content": "Расскажи о Клитофо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "Он... он человек, которому я не могу доверять. На поверхности мы уже много раз сталкивались с Похитителями сокровищ. Они всегда замышляют недоброе. Я знаю это!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411225,
					"content": "Не верь ни одному его слову. «Начну новую жизнь»... «Вернулся на путь добродетели»... Да как же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411226,
					"content": "Говорят красивые слова, а в это время наверняка уже запустили свои грязные руки в твои карманы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411227
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411227,
					"content": "Если им поверить, боюсь, даже Властелин Камня не сможет защитить твой кошелёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411228
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411228,
					"content": "Я, конечно, не отношусь к ним предвзято... Я просто хочу напомнить об осторожности. Похитителям сокровищ не стоит доверять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411229
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411229,
					"content": "И всё же, мне кажется, ты предвзято относишься.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411230
					]
				},
				{
					"id": 710411230,
					"content": "Возможно... у тебя больше знаний и опыта, чем у меня, поэтому ты снисходительнее к Похитителям сокровищ. Но я всегда настороже с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411231
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411231,
					"content": "И буду настороже, пока этот парень не докажет, что он не связан со своими «бывшими» дружками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710411232,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411233
					]
				},
				{
					"id": 710411233,
					"content": "До свидания!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Цюн"
				}
			]
		}
	]
}