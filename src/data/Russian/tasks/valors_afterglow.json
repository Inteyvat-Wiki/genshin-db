			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжи Цюн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "Пожалуйста, прими это в знак благодарности за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710360302,
					"content": "Спасибо большое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "Хм... Сейчас в Разломе почти не осталось геологических аномалий. Значит, мне нужно будет внести лишь небольшие изменения в мои карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710360304,
					"content": "Благодаря тебе наша работа стала намного легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710360305,
					"content": "Я не буду больше тебя задерживать. Теперь ты можешь спокойно отдохнуть или продолжить исследования!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "Чжи Цюн"
				},
				{
					"id": 710360306,
					"content": "Хм... Пока ещё рано собирать маячки. Рассчитываю на твою помощь позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Цюн"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
