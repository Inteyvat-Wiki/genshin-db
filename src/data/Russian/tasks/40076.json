			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона",
					"Каэдэхара Кадзуха",
					"Фишль",
					"Оз",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "Ничего себе! Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400760902,
					"content": "Опять мондштадтский дом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400760903,
					"content": "П-почему мы у меня дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400760904,
					"content": "У тебя дома? Это твой дом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400760905,
					"content": "Ох... Такого я не ожидал. Я, слышал, что Мегистус живёт скромно, но это жилище...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400760906,
					"content": "Посмотрите на этикетки книжек на полу. «Единственный экземпляр. Всего 990000 моры...» Что-о-о?! Так дорого?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400760907,
					"content": "Здесь тоже целая гора дорогущих книг!.. Так вот она какая, комната астролога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400760908,
					"content": "Чрезвычайно изысканная планировка... Недешёвое, должно быть, место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400760909,
					"content": "Оказывается, Мона та ещё богачка...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Так я и не нищая. У меня просто иногда с собой нет наличных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400760912,
					"content": "Да ну? А я столько раз тебя угощала. Я даже позвала тебя к себе домой поужинать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400760913,
					"content": "Миледи, выбирайте выражения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400760914,
					"content": "Кхм-кхм! Тебе была оказана великая честь быть приглашённой в Нирвану ночи и поклониться их высочествам королю и королеве по приглашению принцессы. Как могла ты запамятовать о столь великом событии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400760915,
					"content": "Точно, то жаркое и мясная нарезка, что приготовила твоя мама, были просто восхитительны. Я бы не прочь отведать их ещё раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400760916,
					"content": "Мегистус, сейчас не время обсуждать такие вещи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400760917,
					"content": "Это кухня Мондштадта? Я тоже хочу попробовать! Говорят, Мондштадт славится своими лакомствами, особенно мясными блюдами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400760918,
					"content": "Хм-хм, так уж и быть, великая честь будет оказана и вам. Вам дозволено явиться с принцессой к королю и королеве на ужин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400760919,
					"content": "#Правда? {NICKNAME}, давай мы тоже пойдём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400760920,
					"content": "Знаете, я и сам давно не гостил у друзей. Не посмею отказываться от такого предложения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400760921,
					"content": "Хм, наверное, нужно приготовить подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400760922,
					"content": "Они очень гостеприимные и добрые люди, их не волнуют такого рода вещи. Будет славно, если вы просто придёте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400760923,
					"content": "Советую обязательно попробовать мясную нарезку. Говорят, это фирменное блюдо её семьи. Просто объедение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400760924,
					"content": "Думаю, сперва нам стоит сосредоточиться на стоящей перед нами задаче, не так ли? С того момента, как мы сюда попали, меня всё беспокоит это украшение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400760925,
					"content": "О, точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				},
				{
					"id": 400760910,
					"content": "#...Я и не {F#подозревала}{M#подозревал}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона",
					"Синь Янь",
					"Фишль",
					"Каэдэхара Кадзуха",
					"Оз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "Мы вернулись сюда. Значит... мы окончательно покинули мир грёз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400761302,
					"content": "Странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761303,
					"content": "В моем мире грёз не было никаких подсказок, связанных с Фатуи и устройством. Может, это вовсе и не имеет к ним отношения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761304,
					"content": "Или же эти миры грёз - это не процессы, а уже результаты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761305,
					"content": "Хм? О чём это ты?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400761306,
					"content": "Иными словами, всё, что мы видели, - это не подсказки, ведущие к разгадке, а попросту прямые последствия происходящего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761307,
					"content": "Кто-то что-то сделал, поэтому эти миры грёз и появились. Но они - пассивные творения, и не могут дать нам сколь-нибудь полезных сведений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761308,
					"content": "Иными словами, эти миры только связаны с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400761309,
					"content": "Чистая материализация нас самих... Хм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400761310,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761311,
					"content": "Предлагаю вернуться к началу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761312,
					"content": "#В первый день на острове мы с {NICKNAME} проверяли лагерь Фатуи. Там мы нашли странное устройство, а Фатуи рядом с ним были явно не в своём уме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761313,
					"content": "Так и есть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "Исследователь, который говорил с нами, утверждал, что это всего лишь промышленное изобретение Фатуи, и ручался даже, что оно нас не потревожит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761315,
					"content": "Точно! Тот толстяк в шляпе был словно во сне и всё нёс какую-то чепуху.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400761316,
					"content": "Я тут подумал... Может ли быть так, что «безумие» и «миры грёз» - два отдельных результата работы этого устройства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761317,
					"content": "Если да, то всё связано с тем повреждённым устройством. Но то, как оно воздействует на разных людей, должно быть, связано с ними самими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761318,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761319,
					"content": "Сон действительно сложно отличить от галлюцинаций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761320,
					"content": "То есть, устройство подействовало на нас иначе потому, что мы отличаемся от Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761321,
					"content": "Да. Основываясь на наблюдениях, предполагаю, главная разница в том, что... У нас более твёрдая воля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761322,
					"content": "Хм, звучит разумно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400761323,
					"content": "Люди с сильной волей не впадают в безумие, а просто видят галлюцинации. Ну а более слабые не могут поддерживать стабильный мир грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400761324,
					"content": "Значит, нам нужно немедленно вернуться в лагерь Фатуи и уничтожить то устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400761325,
					"content": "Нет. Нужно не уничтожить, а починить его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400761326,
					"content": "Миледи имеет в виду, что сие необдуманное действие может привести к серьёзным последствиям. Лучше сперва попытаться отремонтировать данное устройство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400761327,
					"content": "Угу, осторожность лишней не бывает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761328,
					"content": "Если моя догадка верна, то устройство оказывает воздействие на мозг. Нам следует быть крайне осторожными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761329,
					"content": "Ну, тогда вперёд! Поторопимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фишль",
					"Оз",
					"Мона",
					"Каэдэхара Кадзуха",
					"Синь Янь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "Какой великолепный вид.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400761502,
					"content": "Госпожа Мегистус, это надёжнейшее доказательство вашего гения. Вы действительно величайший маг за всю историю Нирваны Ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400761503,
					"content": "Благодарю, хоть и история Нирваны Ночи не такая уж долгая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761504,
					"content": "Бриллиантовая россыпь звёзд и жемчужина-луна... Никогда я ещё не видел столь прекрасного ночного неба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400761505,
					"content": "Красотища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400761506,
					"content": "Судя по этому миру грёз, душа Моны наверняка таит в себе целый океан звёзд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Синь Янь"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761508,
					"content": "Что такое, Мона?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "Я подумала, что это именно то, к чему мы все стремимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761510,
					"content": "Это звёздное небо необычайно красиво. Даже красивее того, что я вижу во время гадания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761511,
					"content": "Каждая звёздочка здесь находится на своём месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761512,
					"content": "...Это определённо мой мир грёз. И только здесь можно увидеть такое чудо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761513,
					"content": "Чудо? Почему чудо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400761514,
					"content": "Звёздное небо Тейвата поистине удивительно. Ответы на все вопросы этого мира скрываются в нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761515,
					"content": "«Когда вернётся мой пропавший сын?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761516,
					"content": "«Тот человек любит меня или нет?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761517,
					"content": "«Оправлюсь ли я от болезни?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761518,
					"content": "Всё это отражено в траекториях звёзд судьбы. Но в мире так много людей, и иногда их звёзды отклоняются от своего пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761519,
					"content": "Если твоя звезда судьбы движется по своему пути, значит, тебя ожидает здоровье, благополучие и спокойствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761520,
					"content": "Если же она сходит с него, в жизни происходят перемены к худшему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761521,
					"content": "Именно поэтому звёздное небо, по которому мы гадаем, никогда не бывает таким идеальным. Нередко звёзды теряются, а иногда и падают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761522,
					"content": "...Как бы мне хотелось, чтобы все были счастливы, а их звёзды оставались на своём пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761523,
					"content": "Вот поэтому, говоря правду, я всегда стараюсь дать человеку совет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761524,
					"content": "Конечно, я знаю, что это бесполезно. Все человеческие судьбы показаны на звёздном небе, а я всего лишь одна из них. Изменить что-либо невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761525,
					"content": "Но несмотря на законы астрологии и горькую правду, я всё равно питаю несбыточные надежды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761526,
					"content": "Люди должны жить в соответствии с действительностью, но... можете назвать меня самонадеянной - я продолжаю верить в чудеса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761527,
					"content": "В этом огромном море светил есть звёзды каждого из нас: твоя, моя, всех...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761528,
					"content": "Какова вероятность того, что звёзды сойдутся вместе? А может, эти случайные встречи и вовсе чудеса судьбы? ...Я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761529,
					"content": "Но на звёздном небе Тейвата для нас всегда найдётся место. И если астрология абсолютно рациональная наука, то судьба... изменчива, жестока и романтична.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761531,
					"content": "Мона, ты, кажется, глубоко задумалась...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "Удалось ли тебе найти ответ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "...Мне кажется, я знаю, что скрыто в этих звёздах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400761534,
					"content": "«Настало время взять судьбу в свои руки».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
