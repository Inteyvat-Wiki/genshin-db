	"talks": [
		{
			"id": 7268301,
			"completionStepIds": [
				7268302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268302",
							"2"
						],
						"stepId": 7268302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Асагири"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "Кхм, нет... Это всё равно никуда не годится... Так не пойдёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830102,
					"content": "Любая задержка, и я пропущу следующий срок сдачи... Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830103,
					"content": "Привет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "А?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830106,
					"content": "Прошу прощения! Я обязательно сдам сегодня же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830107,
					"content": "Ой! Постой, мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726830108,
					"content": "Госпожа Морико, прошу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830109,
					"content": "А? Это не госпожа Морико. Слава Архонтам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830110,
					"content": "Кто такая госпожа Морико?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "Госпожа Морико - мой выпускающий редактор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830112,
					"content": "Меня зовут Асагири. В каком-то роде я внештатный иллюстратор. А госпожа Морико... выпускающий редактор, отвечающий за мою работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830113,
					"content": "Иллюстратор? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726830114,
					"content": "Предполагаю, что вы читали лёгкие романы издательского дома Яэ, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830115,
					"content": "Вы заметили, что в лёгких романах обычно несколько страниц заняты исключительно картинками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830116,
					"content": "Такие картинки и зовутся иллюстрациями, а те, кто их рисует, - иллюстраторами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830117,
					"content": "Чтобы показать важную сцену или внешность главного героя, некоторые писатели просят художников нарисовать им иллюстрацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830118,
					"content": "Иллюстрации не только делают чтение интереснее, но и обогащают роман.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830119,
					"content": "Теперь Паймон понимает. Создавать лёгкие романы непросто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726830120,
					"content": "Я могу порекомендовать парочку! Например... Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830121,
					"content": "Ты в порядке?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "Да. Я никогда не отличалась здоровьем. Со всей этой полуночной работой и пропусками приёма пищи это неудивительно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830123,
					"content": "Кхе-кхе... В итоге здоровье начало меня подводить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830124,
					"content": "Если ты нездорова, то почему продолжаешь рисовать здесь? Ты не можешь заняться этим дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726830125,
					"content": "Здесь я набираюсь вдохновения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830126,
					"content": "Муза недавно покинула меня. Я уже пропустила сроки сдачи нескольких иллюстраций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830127,
					"content": "Госпожа Морико несколько раз переносила срок. Если я снова не успею, то она будет в ярости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830128,
					"content": "Я подумала, что, возможно, прогулка поможет вернуть мою музу, вот и вышла на свежий воздух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830129,
					"content": "Но в итоге... Ха-ха... Как видите, не понадобилось много времени, чтобы я оказалась в таком жалком состоянии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830130,
					"content": "Эх, лучше было бы оставить заявку в Гильдии искателей приключений, чтобы кто-нибудь с фотокамерой помог мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830131,
					"content": "А? Кстати, о фотокамере...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726830132,
					"content": "У меня она есть...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "Правда?! У тебя есть фотокамера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830135,
					"content": "М-мне нужно, чтобы искатель приключений сделал с помощью неё фотографии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830136,
					"content": "Я слышала о многих прекрасных местах. Например, о высокой снежной горе близ Мондштадта, или месте в Ли Юэ, где много колонн...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830137,
					"content": "И ещё! Есть место под названием Заоблачный предел. Говорят, там живут адепты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830138,
					"content": "Обитель адептов... Одна мысль об этом вызывает у меня трепет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830139,
					"content": "Но, к сожалению, здоровье не позволяет мне самой отправиться туда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830140,
					"content": "Однако если бы вы запечатлели эти пейзажи на фотокамеру, я... Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830141,
					"content": "Ой! Не надо так волноваться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726830142,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "Правда?! Потрясающе! У меня в списке множество мест. Секунду, сейчас найду его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830145,
					"content": "И не волнуйся насчёт денег. У меня есть сбережения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830146,
					"content": "Да где же моя тетрадь? Куда пропала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Асагири"
				},
				{
					"id": 726830143,
					"content": "Я справлюсь с этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "Но зачем она тебе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "Прошу прощения...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}