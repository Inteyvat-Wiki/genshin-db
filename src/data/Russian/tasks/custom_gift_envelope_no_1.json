			"dialogs": [
				{
					"id": 715330301,
					"content": "#Ух ты, какой красивый! Такое аккуратное исполнение, и ты всё так быстро {F#сделала}{M#сделал}... У меня нет слов!",
					"roleType": "TALK_ROLE_NPC",
