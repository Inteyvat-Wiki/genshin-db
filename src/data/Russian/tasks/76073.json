				"points": []
			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "У Кати и правда золотые руки... Новокитежград ещё подождёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034016,
					"content": "Неточка, и снова здравствуй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "Ой, ты хочешь сразиться? Сейчас не самое подходящее время. Если уж так хочется сразиться, давай договоримся о времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034018,
					"content": "Я бы хотела ещё спокойно погулять, да и Нашгород толком не успела посмотреть. Давай отложим поединок на потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034002,
					"content": "Расскажи о Новокитежграде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "Когда жила там, часто грустила, а теперь, уехав, даже скучаю. Я впервые вдали от дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034004,
					"content": "Думала, что в других городах, как и в Новокитежграде, много альвов. Их немало даже в Снежнограде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034005,
					"content": "Но в Нод-Крае я не встретила ни одного. Даже Паймон сказала, что она не из их числа. Может, им тут климат не нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034013,
					"content": "Здесь хотя бы не бывает снежных бурь, и на природе тоже можно обойтись без печки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034014,
					"content": "А ещё я видела, как в Нод-Крае пили вино из Новокитежграда. Я знала, что он славится вином и шахтами, но увидеть это тут было приятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Неточка"
				},
				{
					"id": 760034011,
					"content": "Ну что ж... До встречи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "Желаю нам всем удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Неточка"
				}
			]
		},
