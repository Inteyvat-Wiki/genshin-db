			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нантак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "Ну как? Судя по выражению лица, улов у тебя неплох! Дай-ка посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610602,
					"content": "О, это новый вид рыб! Неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610603,
					"content": "#Ты почти переплюнул{F#а} меня в мои лучшие годы, ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610604,
					"content": "Ты тоже можешь поймать рыбу голыми руками?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "Кхм... Похоже, что эти обычные рыбёшки для тебя раз плюнуть. Надо дать тебе что-нибудь посложнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610606,
					"content": "Ты, наверное, не знаешь, но даже в пределах одного вида отдельные особи могут сильно отличаться друг от друга в зависимости от среды обитания и питания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610607,
					"content": "Хотя они и выглядят одинаково, но некоторые особи могут быть особенно активными и энергичными, и они часто выпрыгивают из воды. Очень впечатляет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610608,
					"content": "Эти экземпляры гораздо выше ценятся как с коммерческой, так и с декоративной точки зрения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610609
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610609,
					"content": "Многие любители покупают их за большие деньги и разводят в аквариуме в декоративных целях. Поэтому их и называют декоративной рыбой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610610
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610610,
					"content": "Значит, кроме Паймон-консервы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610611
					]
				},
				{
					"id": 706610611,
					"content": "...бывает ещё и декоративная Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610612
					]
				},
				{
					"id": 706610612,
					"content": "Вот уж нет! Откуда может взяться столько видов Паймон?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706610613,
					"content": "#Вот именно! Похоже, что ты всё понял{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610614
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610614,
					"content": "Последнее время декоративная рыба очень активна в водах рядом с горами Буревестника. Я отмечу тебе на карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610615
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610615,
					"content": "Пойдём посмотрим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нантак"
				}
			]
