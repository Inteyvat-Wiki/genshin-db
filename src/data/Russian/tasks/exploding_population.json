		},
		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нантак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Это здесь! Видишь рыбок в воде? Так красиво...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610402,
					"content": "Я всё для тебя приготовил: удочка, наживка, рецепт для приготовления наживки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610403,
					"content": "Сначала насади наживку на крючок, потом прицелься туда, где собирается рыба... и закинь удочку! А потом смирно сиди и жди, пока рыба клюнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610404,
					"content": "Говорят, что новичкам везёт. Я тогда поймал здоровенного полуметрового окуня! Давай, попробуй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610405,
					"content": "Надеюсь, я поймаю ещё одну Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Эй! Зачем тебе новая Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706610407,
					"content": "Паймон? Очень странное имя. Это рыба какая-то?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610408,
					"content": "#Это волшебная рыбина, которую я поймал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Эй! Паймон теперь из живой консервы превратилась в волшебную рыбину?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706610410,
					"content": "Вот как! Не думал, что ты, оказывается, уже опытный рыбак!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Нантак"
				},
				{
					"id": 706610411,
					"content": "Ну тогда мне ещё больше не терпится увидеть, что ты поймаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нантак"
				}
			]
		},
