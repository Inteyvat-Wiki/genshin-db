			},
			"dialogs": [
				{
					"id": 400660301,
					"content": "Ух ты, новое пространство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400660302,
					"content": "Всё как в прошлый раз. С нами нет только господина Кадзухи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400660303,
					"content": "Ну, ничего, мы справимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синь Янь"
				}
			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кагэхару",
					"Каэдэхара Кадзуха"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "Ну вот и всё. Кадзуха, ты как раз вовремя. Как тебе эта вещица?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660602,
					"content": "Очень искусная работа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400660603,
					"content": "Хе-хе, за основу я взял горный пейзаж из книги. Знаешь, в этом мире есть страны, где горы достигают облаков. Если бы только у меня был шанс увидеть их своими глазами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660604,
					"content": "Вы ведь можете отправиться в путь в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400660605,
					"content": "Если бы это было возможным. Сейчас я являюсь главой клана, и хотя клан Каэдэхара утратил былое величие, но обязанностей от этого не стало меньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660606,
					"content": "С другой стороны... Продолжать путь наших предков, жертвовать всем ради угасающего клана... Стоит ли оно того?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660607,
					"content": "Отец, я не понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400660608,
					"content": "Кадзуха, я надеюсь, ты запомнишь одну вещь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660609,
					"content": "Семейные узы важны, но не позволяй им связать тебя по рукам и ногам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660610,
					"content": "Клан существует лишь благодаря тем людям, что в него входят. Если мы несчастны, то как мы можем сделать счастливыми своих близких?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660611,
					"content": "Прошлое очень сильно влияет на клан. Но оно не должно превращаться в тяжкую ношу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660612,
					"content": "Если однажды тебе надоест эта скучная жизнь, брось всё и отправляйся в путешествие, посмотри мир. Не позволяй жизни лишить тебя свободы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400660613,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
							"2"
						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Каэдэхара Кадзуха",
					"Каэдэхара Кагэхару"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "Я ничего не понимаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661102,
					"content": "Кадзуха, ты забыл наш уговор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661103,
					"content": "Вы действительно хотите всё бросить? Но... пускай сейчас нам приходится нелегко, но ведь я всегда рядом. Неужели я не смогу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661104,
					"content": "Вы в моём возрасте уже помогали дедушке. Это я разочаровал вас своей беспомощностью или же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661105,
					"content": "Кадзуха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661106,
					"content": "Ох, теперь ты винишь во всём себя. Я никудышный отец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661107,
					"content": "Клан Каэдэхара расплачивается за ошибки прошлого, начиная с поколения твоего прадеда. И по сей день мы так и не смогли полностью оправиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661108,
					"content": "Хоть мы и мастера клинка, но тебе не обязательно посвящать свою жизнь семейному делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661109,
					"content": "Если раненый зверь хочет выбраться из капкана, то ему придётся преодолеть боль и отгрызть себе зажатую лапу. Да, это потеря, но оставаться в капкане куда опасней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661110,
					"content": "На этом закончим, Кадзуха. Будучи главой семьи, я не смог возродить клан и дать тебе достойную жизнь. Я благодарен тебе за то, что ты никогда не упрекал меня за это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661111,
					"content": "Страдания нескольких поколений... С этим пора покончить. И жить дальше без этой ноши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661112,
					"content": "Не волнуйся, я возьму на себя вину за утраченное фамильное ремесло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "Каэдэхара Кагэхару"
				},
				{
					"id": 400661113,
					"content": "Отец, не надо... Вы не должны брать на себя такое бремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661114,
					"content": "А если для него придёт время, я разделю его с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661115,
					"content": "Нам нужно просто подождать. Рано или поздно дела клана Каэдэхара будут переданы мне, и тогда я разберусь с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
		{
