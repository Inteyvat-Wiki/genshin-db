					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661701,
					"content": "Так и думала, что ты опять тут заперт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400661702,
					"content": "Ха-ха, это уже можно считать закономерностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661703,
					"content": "Мы снова оказались в лабиринте, но в этот раз кое-что изменилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400661704,
					"content": "Вы рассказываете о том, что видели...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "Обстановка стала более скудной, а атмосфера - гнетущей. Логично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661706,
					"content": "Должно быть, вы видели дом Каэдахара в пору упадка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661707,
					"content": "Мы и похожую на тебя тень там видели, но только ты был сам на себя не похож.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400661708,
					"content": "Всё верно, я подтверждаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 400661709,
					"content": "В отличие от стоящего перед нами господина Кадзухи, та тень казалась растерянной и обременённой тяжёлой судьбой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 400661710,
					"content": "Да, его и впрямь словно придавило нелёгкой ношей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 400661711,
					"content": "Это лишь потому, что я стал старше и мудрее. Вам же, увы, пришлось лицезреть мою куда менее зрелую прежнюю сущность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661712,
					"content": "После отплытия из Инадзумы мне пришлось немало поскитаться по свету. Но это был не худший опыт, и он многому меня научил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661713,
					"content": "Хотелось бы и мне встретиться с прежней версией себя. Я уверен, что, увидев меня, он бы осознал:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "Каэдэхара Кадзуха"
				},
				{
					"id": 400661714,
					"content": "Жизнь - долгое странствие, и мне предстоит дальний путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Каэдэхара Кадзуха"
				}
			]
		},
