					},
					{
						"sceneId": 3,
						"position": [
							2098.119,
							200.186,
							9563.697
						],
						"pointId": 14265
					}
				]
			},
			"dialogs": [
				{
					"id": 761170201,
					"content": "Пфф, неудачник. У парня нет ни моры за душой, даже украсть нечего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Калев"
				},
				{
					"id": 761170202,
					"content": "Эй, Калев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170203,
					"content": "Кто... О, Ягода, редкая гостья. Что привело тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Калев"
				},
				{
					"id": 761170204,
					"content": "Расслабься, ничего особенного. Ходят слухи, что несколько дней назад ты украл что-то у человека по имени Иханти. Это правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170205,
					"content": "Вот, возьми мору и отдай украденное. Сегодня я добрая, будем считать, что я это у вас купила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170206,
					"content": "О, смотрите-ка, какие мы цивилизованные. Наверное, так и должно быть, когда за твоей спиной стоит Нефер, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Калев"
				},
				{
					"id": 761170207,
					"content": "И что ты сделаешь, если я откажусь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Калев"
				},
				{
					"id": 761170208,
					"content": "Калев, прошу, не мог бы ты и твои глупые дружки хоть раз вести себя как нормальные люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170209,
					"content": "Только не говори, что ты проделала такой долгий путь, чтобы «купить вещь» у вора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Калев"
				},
				{
					"id": 761170210,
					"content": "Неужели ты думаешь, что я сейчас всё брошу и принесу тебе всё на блюдечке с голубой каёмочкой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Калев"
				},
				{
					"id": 761170211,
					"content": "Такое чувство, что переговоры провалились...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761170212,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170213,
					"content": "Это моя вина, Калев. Не стоило подражать манерам босса Неф в общении с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170214,
					"content": "Вы, недоумки, понимаете только грубую силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170215,
					"content": "#{NICKNAME}, давай вместе разберёмся с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170216,
					"content": "Смотришь на нас свысока? Братья, вперёд! Пора поставить эту малявку на место. Взять их!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Калев"
				}
			]
		},
		{
			"id": 7611703,
			"completionStepIds": [
