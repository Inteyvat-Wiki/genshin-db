			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Иханти"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2018.583,
							206.964,
							9782.118
						],
						"pointId": 14266
					},
					{
						"sceneId": 3,
						"position": [
							2020.458,
							206.988,
							9783.119
						],
						"pointId": 14267
					},
					{
						"sceneId": 3,
						"position": [
							2019.785,
							206.972,
							9781.799
						],
						"pointId": 14268
					},
					{
						"sceneId": 3,
						"position": [
							2018.43,
							206.961,
							9782.82
						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "Ох... Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170402,
					"content": "Кто здесь? У меня нет моры... Хотите забрать мою жизнь - забирайте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170403,
					"content": "Иханти, я принесла твои вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170404,
					"content": "...Ягода? Это ты? Я слышу твой голос, но мои глаза плохо видят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170405,
					"content": "Это я, Иханти, я стою прямо перед тобой. Почему ты не пришёл ко мне, когда заболел? Выглядишь ужасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170406,
					"content": "Даже умирающая бродячая собака не осмелится войти в роскошный город... Ведь она достаточно натерпелась от кнута богачей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170407,
					"content": "Я не такой человек, и... босс тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170408,
					"content": "Тем более нельзя. Если бы люди узнали, что ты из тех, кто всегда готов помочь, они бы каждый день стучали в твою дверь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170409,
					"content": "Никто не посмеет так нагло вести себя с боссом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170410,
					"content": "Но ты всегда тайком делаешь добро, а потом те, кому ты помогла, вонзают тебе нож в спину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170411,
					"content": "Я многому научилась у босса. Больше никто не сможет причинить мне вреда. Никогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170412,
					"content": "...Ах, ты не можешь удержаться и не заботиться о других людях, верно, Ягода?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170413,
					"content": "...Это моё личное дело. Тебя не касается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170414,
					"content": "Хе-хе, возможно, именно поэтому босс так ценит тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170415,
					"content": "Возможно, именно поэтому я до сих пор жива.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170416,
					"content": "Ха-ха-ха... Кхе... Кхе-кхе! Верно, Ягода, верно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170417,
					"content": "...Ладно, Иханти, говори прямо, что я могу для тебя сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170418,
					"content": "Ты всё такая же. Неужели не боишься, что я вдруг потребую с тебя моры? Или устрою тебе ловушку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170419,
					"content": "Ты не сделаешь этого, мы очень давно знаем друг друга...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170420,
					"content": "Неужели этого достаточно, чтобы завоевать твоё доверие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170421,
					"content": "Посмотри на себя. Как ты можешь мне угрожать в таком состоянии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170422,
					"content": "Ха! Вот мы и добрались до правды. Спасать ядовитую змею, которая едва может открыть пасть, вполне безопасно, учитывая все обстоятельства...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170423,
					"content": "Сделай одолжение - сверни рисунок из сумки и положи его мне в карман. У меня нет сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170424,
					"content": "Я нарисовал его вместе с женой и дочерью. И он мне дороже всего на свете.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170425,
					"content": "Всё остальное больше не имеет значения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170426,
					"content": "Хех, прежний ты умер бы со смеху, услышав это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170427,
					"content": "Ха... Что же стало с теми вещами, которые я когда-то ценил превыше всего? Они не смогли спасти ни мою жену, ни меня самого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170428,
					"content": "Возможно, такова судьба вора. Всё, что мы крадём, в конечном итоге будет украдено у нас, и мы снова останемся ни с чем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170429,
					"content": "Тот кулон, который я использовал, чтобы разместить поручение, - моё последнее имущество... Ха-ха... хотя его нельзя назвать «моим».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170430,
					"content": "Это было первое украшение, которое ты украл. Ты много раз рассказывал мне об этом: о том, как ты это сделал, и о выражении лица того богача, когда он обнаружил пропажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170431,
					"content": "Да, теперь он твой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170432,
					"content": "Кому принадлежало украшение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170433,
					"content": "Некоему Холомову из Снежной. Он жил в Нод-Крае, но сейчас, наверное, уже вернулся в Снежную. Только не говори, что ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170434,
					"content": "Я завязала с воровством и не буду присваивать украденное. Это украшение нужно вернуть владельцу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170435,
					"content": "Ха-ха... Ха-ха-ха-ха!.. Ты и правда... дурочка, Ягода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170436,
					"content": "Босс был прав... Воры вроде тебя никогда не смогут разбогатеть... Кхе-кхе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170437,
					"content": "Кхе-кхе... кхе... кхе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170438,
					"content": "Ладно, хватит болтать. Пойду найду тебе врача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170439,
					"content": "Не надо. Позволь мне уйти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170440,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170441,
					"content": "Ягода, ты знаешь правила, установленные боссом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170442,
					"content": "...«Ищущий покоя заслуживает покоя».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170443,
					"content": "Ты знаешь, о чём я говорю, поэтому оставь меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170445,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170446,
					"content": "Я рад, что именно ты, Ягода, пришла мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170447,
					"content": "К сожалению, у меня нет сокровищ, чтобы отблагодарить тебя. Но, если хочешь, можешь взять эту куклу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170448,
					"content": "Но... Я же просила тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170449,
					"content": "Не волнуйся, я сделал её сам. Те, что ты сделала, давно исчезли - я сжёг их все до последней, как ты и просила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170450,
					"content": "Неплохо, да? Особенно для того, кто почти ослеп...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170451,
					"content": "Возьми её, Ягода. Считай это моим последним подарком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170452,
					"content": "Я проведаю тебя позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761170453,
					"content": "Иди. Прощай, Ягода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "Иханти"
				},
				{
					"id": 761170454,
					"content": "Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иханти"
				}
			]
		},
