						"stepId": 2103701,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цю Эр",
					"Чжи Жо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Чжи Жо, ска... скажи, он специально? Он... не хочет быть рядом со мной? Хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 210370402,
					"content": "Цю Эр, вы столько времени провели вместе. Разве может он не понимать твоих чувств?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Чжи Жо"
				},
				{
					"id": 210370403,
					"content": "Если он решил уехать из Ли Юэ, значит на то есть причины. Почему бы тебе не отправиться вместе с ним?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Чжи Жо"
				},
				{
					"id": 210370404,
					"content": "Я не хочу уезжать из Ли Юэ и всё тут! Разве нам здесь плохо? Школа Гухуа... Зачем ему сдалась эта школа Гухуа?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 210370405,
					"content": "Почему же ты ему не сказала об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Чжи Жо"
				},
				{
					"id": 210370406,
					"content": "Я... я... я... Сунь Юй так загорелся этой идеей возрождения школы Гухуа... Если я ему это скажу, он меня возненавидит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 210370407,
					"content": "Ах, Цю Эр...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Жо"
				}
			]
		},
