			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "Спасибо, этого достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210370302,
					"content": "Ты что-то совсем пригорюнился.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "А? Ничего, ничего. Ха-ха-ха... Прости, я не хочу тревожить тебя этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210370304,
					"content": "Просто мне очень непросто уезжать из Ли Юэ, ведь я прожил здесь так долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210370305,
					"content": "Когда вы уезжаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Мы отправимся в путь, как только будут готовы припасы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210370307,
					"content": "Кстати, со мной поедет искательница приключений, с которой мы были в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210370308,
					"content": "Когда искательница приключений услышала, что я собираюсь в Фонтейн, то очень воодушевилась и решила ехать со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210370309,
					"content": "Торговец очень обрадовался, что его будет защищать настоящая искательница приключений... А мне, по правде говоря, сложно с таким общительным человеком. Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 210370310,
					"content": "Не думал, что однажды покину родину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				}
			]
		},
		{
			"id": 2103704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
