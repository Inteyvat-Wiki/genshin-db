				"points": []
			},
			"dialogs": [
				{
					"id": 736940101,
					"content": "Гм, почему все выглядят такими уставшими?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940102
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940102,
					"content": "Здесь проходит какое-то мероприятие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940103
					]
				},
				{
					"id": 736940103,
					"content": "#Ты ведь... путешественни{F#ца}{M#к}, да? Ха-ха-ха, я много о тебе слышал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940104
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940104,
					"content": "Да, даршан Вахумана проводит мини-игру по археологии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940105
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940105,
					"content": "Многие учёные нашего даршана изучают историю, поэтому в процессе исследований им нередко приходится отправляться на археологические раскопки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940106
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940106,
					"content": "Ох, не переживай. Мы не будем никого отправлять на настоящие раскопки. Мы только сымитируем археологическую деятельность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940107
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940107,
					"content": "Мы заранее закопали несколько копий реликвий вокруг города Сумеру... Мы временно будем называть место их нахождения областью раскопок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940108
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940108,
					"content": "Задача участников мероприятия - раскопать спрятанные внутри области раскопок копии реликвий, найдя их с помощью специального археологического детектора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940109
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940109,
					"content": "Спасибо студентам других даршанов за помощь в создании набора контейнеров и археологических детекторов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940110
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940110,
					"content": "#Путешественни{F#ца}{M#к}, ну как? Хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940111,
						736940112
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940111,
					"content": "Звучит не так сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				},
				{
					"id": 736940113,
					"content": "Ха-ха-ха, хорошо! Вот тебе детектор, не потеряй. А я отмечу область раскопок в <color=#00E1FFFF>археологическом справочнике</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940114
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940114,
					"content": "#Готово. Желаю увлекательных раскопок, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940115
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940115,
					"content": "Когда найдёшь все копии реликвий, приходи ко мне за подарком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940116
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940116,
					"content": "Во время поиска образцов следуй за археологическим детектором. Для удобства мы классифицировали образцы по элементам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940117
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940117,
					"content": "Правда... изначально эти детекторы использовались для обнаружения элементов, поэтому и после модификации, которая была проведена впопыхах, могут быть подвержены влиянию каких-то элементов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940118
					],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940118,
					"content": "Одним словом, главное - выкопать все копии реликвий, чтобы получить от нас подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Данех"
				},
				{
					"id": 736940112,
					"content": "Почему бы не попробовать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				}
			]
		}
	]
}