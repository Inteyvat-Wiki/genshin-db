			"trigger": {
				"objectNames": [
					"Сюй Дун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700101,
					"content": "Мы не можем сюда спуститься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "#Путешественни{F#ца}{M#к}, вот мы и снова встретились! Сейчас мы пытаемся понять, как... нырнуть в воду перед нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700104,
					"content": "Мы хотим собрать немного свежих морских водорослей, чтобы приготовить блюдо, известное как «онигири».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700105,
					"content": "А на берегу нельзя их собрать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "Можно, но морские водоросли там не такие свежие. И если готовишь из них блюдо, каждый раз теряется какой-то оттенок вкуса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700109,
					"content": "Мы расспросили местных жителей, и они подтвердили, что самые качественные морские водоросли растут там, внизу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700110,
					"content": "Но когда мы пришли сюда сегодня, то обнаружили, что этот участок затопило море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700111,
					"content": "А что ещё хуже, никто из нас не умеет нырять, так что остаётся только сидеть здесь и смотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700112,
					"content": "Может, рядом найдутся какие-нибудь подходящие механизмы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "Вон там есть один...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721700114,
					"content": "Но он опять застрял в том барьере, и мы не можем войти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700115,
					"content": "Ах... Мы будем дальше думать, как нам быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700116,
					"content": "#И всё же, путешественни{F#ца}{M#к}, скажи нам, если знаешь, как можно решить эту задачу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700117,
					"content": "#Разумеется, было бы лучше, если бы ты просто прин{F#есла}{M#ёс} нам эти морские водоросли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700118,
					"content": "Господин Сюй Дун?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721700119,
					"content": "*Кашляет* Я хотел сказать, что если ты принесёшь нам морские водоросли, то получишь щедрую награду! А вдобавок, в качестве дополнительного стимула, большое пиршество - онигири!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700120,
					"content": "Как можно назвать онигири «большим пиршеством»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721700121,
					"content": "Ой, перестань, просто нужно приготовить побольше... *кашляет* Ну ладно, ладно. Может, лучше подумаем, что нам делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700107,
					"content": "А разве обязательно нырять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "Морские водоросли на берегу не такие свежие. Если готовишь блюдо из них, каждый раз теряется какой-то оттенок вкуса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
