			"dialogs": [
				{
					"id": 721700201,
					"content": "#Путешественни{F#ца}{M#к}, ты {F#собрала}{M#собрал} водоросли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700202
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700202,
					"content": "О, спасибо, этого достаточно. Спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700203,
					"content": "Что ж, пора приготовить блюдо, которое называется... онигири, так? Я слышал, что рецепт этот довольно простой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700204,
					"content": "Хорошо, подожди, пока я приготовлю блюдо. Это займёт какое-то время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
		{
			"id": 7217003,
			"completionStepIds": [
				7217004
