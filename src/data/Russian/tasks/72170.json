			"dialogs": [
				{
					"id": 721700301,
					"content": "Морские водоросли... Рыба... Рис...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700302
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700302,
					"content": "Вот как это делается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700303,
					"content": "Н-да, вот так! Я представляю вам всем онигири!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700304,
					"content": "Это... просто и со вкусом. Что ж, возьму этот кусочек. Больший мне не одолеть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721700305,
					"content": "Итак, скажу, что вкус приятный! Я возьму этот кусочек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721700306,
					"content": "#А это порция для тебя, путешественни{F#ца}{M#к}. И, конечно же, вот описание рецепта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700307,
					"content": "Эти онигири, возможно, и самое простое блюдо в мире, но чтобы сделать их как полагается, нужен особый подход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700308,
					"content": "Ладно, пора и самому попробовать. За работой я здорово проголодался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700309,
					"content": "Эй, Парвана, ты же говорила, что не осилишь?! Оставь и мне немного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				}
			]
		},
