			"trigger": {
				"objectNames": [
					"Сюй Дун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700701,
					"content": "Похоже, этот участок затапливало и раньше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700702
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700702,
					"content": "Следы от воды не оставляют сомнений. Это место затопило не так давно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721700703,
					"content": "Но почему это вода внезапно отступила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "Джули"
				},
				{
					"id": 721700704,
					"content": "Кхм, здесь так мокро. Я промочу ноги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700705
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721700705,
					"content": "А, забудь. Давай поскорее соберём морские водоросли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700706,
					"content": "Чем это вы здесь занимаетесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "#А? Нет, вы только посмотрите! Путешественни{F#ца}{M#к}, мы снова встретились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700708,
					"content": "Мы как раз спустились, чтобы собрать свежих морских водорослей и приготовить блюдо, называемое «онигири». Ходить там слишком трудно, и ноги промокли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700709,
					"content": "#Но не будем об этом. Путешественни{F#ца}{M#к}, ты не помог{F#ла} бы нам собрать морских водорослей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700710,
					"content": "Эта местность не так давно была затоплена, и хотя вода отступила, неизвестно, вдруг она внезапно хлынет обратно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700711,
					"content": "Думаю, нам следует поскорее собрать морские водоросли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700712,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "#Спасибо, путешественни{M#к}{F#ца}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700714,
					"content": "Когда соберёшь водоросли, пожалуйста, принеси их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700715,
					"content": "А на берегу почему нельзя собрать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "Можно, но морские водоросли там не такие свежие. И если готовишь из них блюдо, каждый раз теряется какой-то нюанс вкуса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700717,
					"content": "#Качество морских водорослей здесь наверняка гораздо выше. Но в любом случае, путешественни{F#ца}{M#к}, нам понадобится твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700718,
					"content": "Когда соберёшь водоросли, пожалуйста, принеси их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Дун"
				}
			]
		}
	]
