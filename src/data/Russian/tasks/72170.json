			"dialogs": [
				{
					"id": 721700401,
					"content": "Нам что, и правда нужно найти способ, как туда нырнуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700402
					],
					"speakerTitle": "Сюй Дун"
				},
				{
					"id": 721700402,
					"content": "Может, перейдём на новое место? Неужели нужно собирать морские водоросли именно здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700403
					],
					"speakerTitle": "Парвана"
				},
				{
					"id": 721700403,
					"content": "Почему этот механизм снова оказался внутри барьера?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джули"
				}
			]
		},
