				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "Я вернулся. Ну как, нашли что-нибудь интересное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440142,
					"content": "Лишь кучу непонятных вещей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "Ничего, это мои алхимические принадлежности. В обычной жизни от них пользы мало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440146,
					"content": "Ну, скорее продолжим исследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440101,
					"content": "Миры могут между собой разительно отличаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440102,
					"content": "Взять, к примеру, Тейват. Обладатели Глаза Бога способны использовать силы стихий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440103,
					"content": "Но также могут существовать миры, где элементальной силой обладает только один, или где она доступна каждому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440104,
					"content": "#Отложим пока элементы в сторону... Скажи, {NICKNAME}, обладаешь ли ты другими уникальными способностями, которых в этом мире не существует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440105,
					"content": "Кажется, для ответа на этот вопрос нам понадобится методология, применённая в прошлый раз. То есть пора провести эксперимент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440106,
					"content": "Опять бить слаймов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "Нет-нет-нет, на этот раз делать почти ничего не понадобится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440109,
					"content": "Видишь эту колонну? Попробуй сломать её силой воли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440110,
					"content": "Прости, у меня ничего не выходит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "#Ты точно старал{F#ась}{M#ся} изо всех сил? Хм... Ничего страшного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440112,
					"content": "Ты что, разочарован? Но такое как бы невозможно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440116,
					"content": "Кстати! Приходило ли тебе в голову использовать элементальную силу на еде? То есть не готовить с её помощью, а наполнять ею ингредиенты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440117,
					"content": "Интересно, как изменится вкус и текстура. Может даже возникнуть... дупликация...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440118,
					"content": "У алхимиков крайне развито воображение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "Ха-ха, если интересоваться вещами, до которых другим нет дела, можно открыть много чего удивительного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440121,
					"content": "Почему бы тебе не приготовить солнечную рыбу? Я как раз закончил писать рецепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440151,
					"content": "Жареная рыба? Паймон думала, мы займёмся чем-нибудь необычным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440122,
					"content": "Это важное блюдо моего рациона отлично подходит не только для трапезы, но и для экспериментов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440123,
					"content": "Паймон уверена, что просто ты проголодался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440124,
					"content": "Но если будет вкусно, то Паймон не против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440125,
					"content": "Хорошо, мне всё понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "Да, да! Вот что значит настоящий друг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440128,
					"content": "Тогда приступай. Я с нетерпением буду ждать результатов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440130,
					"content": "А если вдруг что-то останется, то Тимей доест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440131,
					"content": "Пока Паймон рядом, таких проблем возникнуть не должно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440126,
					"content": "Я оставлю тебе немного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "Может, ты просто проголодался?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "Попробуй ты, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "Ни ты, ни Паймон на такое не способны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440115,
					"content": "#Ты точно старал{F#ась}{M#ся} изо всех сил? Хм... Ничего страшного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440107,
					"content": "Опять пить зелья?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "Тут такой беспорядок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "Бардак, согласен. Я хотел бы прибраться, да всё время уходит на эксперименты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Альбедо"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "Невероятно, вам удалось их найти! Тысяча благодарностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440321,
					"content": "Найти эти предметы и отыскать меня в горах вам помогло... чувство стихий, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440322,
					"content": "Да! Его можно назвать суперсилой, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440323,
					"content": "К сожалению, хоть и навык этот редкий, но в Тейвате он существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440324,
					"content": "Моему исследованию могут помочь лишь силы, которые этому миру неведомы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440325,
					"content": "То есть... Опять неудача...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440326,
					"content": "Не унывай, этого стоило ожидать. А ещё удалось вернуть потерянные сосуды. Я бы сказал, что эксперимент удался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440301,
					"content": "Ваше предположение о том, что на них были следы энергии стихии, похвально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440302,
					"content": "Ну, ладно. Ранее мы изучали тебя, как представителя другого мира. Теперь же мы изучим тебя, как одного из нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440303,
					"content": "#Готов{F#а} быть с тобой до конца.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "Разница между людьми заключается в умственных и физических способностях. Начнём, пожалуй, с физических.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440306,
					"content": "Скажи, тебе отсюда видно, что сейчас делает Сахароза?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440307,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "#А увидел{F#а} бы, если забрал{F#ась}{M#ся} на ту скалу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440309,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "#А если бы разбил{F#а} скалу перед тобой на куски, смог{F#ла} бы увидеть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440311,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "Раз так, то мне придётся снизить свои ожидания. Более глубокого понимания мы достигнем, если поставим опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440314,
					"content": "Неподалёку есть одно место, отлично подходящее для физических испытаний. Прошу за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440312,
					"content": "Похоже, ты всё ещё пытаешься обнаружить суперспособности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "Как бы мне незаметно уйти...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
				1104416
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104416",
							"2"
						],
						"stepId": 1104416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Хм, весьма посредственная реализация замечательного блюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440502,
					"content": "Эффект дупликации, которого я так ждал, не проявился. По крайней мере, мы выяснили, что в твоём мире из-за еды трудностей не меньше, чем в нашем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440503,
					"content": "Если только... твои уникальные способности не сдерживаются законами этого мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440504,
					"content": "Мы просто не знаем, как наполнять еду силой стихии. С солью и перцем как-то попроще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440505,
					"content": "Не беда. Во всяком случае, мы не дали хорошей еде пропасть. Не расстраивайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440506,
					"content": "А вот и твоя порция. Приятного аппетита! Если хочешь, я могу её тебе завернуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440507,
					"content": "Спасибки! Паймон рада, что ты не забыл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440508,
					"content": "Теперь Паймон будет тебя обожать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "Я заметил, что вы с ней хорошие друзья. Во время эксперимента она не спускала с тебя глаз и очень за тебя переживала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440511,
					"content": "Вряд ли бы она смогла что-то сделать, пойди что-нибудь не так, но всё же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440512,
					"content": "Эй! А ещё миг назад ты казался Паймон таким славным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440513,
					"content": "Но у тебя есть вкусные рецепты, так что Паймон тебя прощает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440514,
					"content": "И да, мы хорошие друзья. У тебя ведь тоже есть друзья? Или ученики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440515,
					"content": "Хм... Разумеется. Судьба не обделила и меня. Ну, довольно. Приступим к следующему эксперименту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440516,
					"content": "Здесь столько разных алхимических принадлежностей, и поддерживать среди них порядок - та ещё головная боль. Из-за недавнего инцидента кое-какие из них я потерял.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440517,
					"content": "Большую часть я уже нашёл, но ещё недостаёт двух сосудов - с экстрактом кристальной бабочки Анемо и порошком Электро гипостазиса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440518,
					"content": "Паймон только поела, а ты снова отправляешь нас на поиски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440519,
					"content": "Не найдёте - не страшно, я всё равно собирался приготовить новые. Если бы вы их нашли, это избавило бы меня от лишних хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440520,
					"content": "Будь у тебя суперспособность, как ночное зрение или чувствительность к вибрациям, искать потерянные вещи было бы проще простого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440521,
					"content": "Они должны быть там, где вы только что ходили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 110440522,
					"content": "Ну... Мы поищем тогда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440523,
					"content": "На этих предметах должна быть энергия элементов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Точно! Можно воспользоваться чувством стихий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110440509,
					"content": "Мало кто так хорошо обращается с Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		},
