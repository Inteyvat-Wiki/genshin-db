			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Феликс Йог"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140301,
					"content": "Почётный рыцарь, с возвращением! Как обстоят дела с поиском деталей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140302,
					"content": "Это они?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051404",
							"2"
						],
						"stepId": 7051404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Феликс Йог"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "Они! Они! Отлично! Мои детали! О, Архонты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140402,
					"content": "Раз все детали собраны, осталось только соединить их вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140403,
					"content": "Почётный рыцарь, если тебе интересно, можешь попробовать собрать «Вечно движущуюся механическую картину».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140404,
					"content": "Поверь мне, это чрезвычайно увлекательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Феликс Йог"
				}
			]
		},
		{
			"id": 7051405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
