			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Феликс Йог",
					"Свен"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "Мондштадт вполне заслуженно славится своим радушием... что там, он превосходит все мои ожидания! Даже местные хиличурлы такие бодрые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140102,
					"content": "Как бы там ни было... господин Йог, пожалуйста, больше не уходите один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 705140103,
					"content": "Что? А что же тогда делать с моим механизмом?.. Мне всё ещё не хватает... эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140104,
					"content": "...одной, двух, трёх... восемнадцати... девятнадцати деталей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140105,
					"content": "Искатели приключений уже согласились помочь вам. Просто подождите в городе, не подвергая себя опасности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 705140106,
					"content": "Но без этих механизмов... моё... моё вдохновение, понимаешь? Что делать, если ко мне придёт вдохновение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140107,
					"content": "Вдохновение - оно мимолётно, как... как отрыжка после бокала хорошей выпивки, или как пламя свечи на ветру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140108,
					"content": "О, это отличная метафора, надо бы записать. Ксавье обязательно её оценит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140109,
					"content": "Я... А ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 705140110,
					"content": "Ах, почётный рыцарь... Отлично! Почётный рыцарь, прошу, скорее подойди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 705140111,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Позволь представить тебе уроженца Кур-де-Фонтейна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 705140114,
					"content": "Праздного мечтателя! Так мы себя называем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140115,
					"content": "Господин Йог, это почётный рыцарь Мондштадта...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 705140116,
					"content": "Ага! Йог, Феликс Йог! Позволь выразить тебе своё почтение, почётный рыцарь! Я столько всего слышал о твоих деяниях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140117,
					"content": "Ты знаешь меня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "Конечно-конечно! Конечно, я знаю тебя. Кто тебя не знает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140119,
					"content": "Твои подвиги во время битвы с Двалином в Мондштадте были на первых полосах «Паровой птицы» по меньшей мере недели три!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140120,
					"content": "Ха-ха-ха, если бы те репортёры узнали, что я разговариваю с тобой, они бы позеленели от зависти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140121,
					"content": "Что такое «Паровая птица»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "Ты не знаешь?.. «Паровая птица» - известнейшее издание Кур-де-Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140123,
					"content": "#И только ты, в своё время, обеспечил{F#а} им рекордный объём продаж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140125,
					"content": "Я что, знаменитость?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "#Ну конечно, ведь ты когда-то обеспечил{F#а} им рекордный объём продаж.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140127,
					"content": "Сенсации, большие выпуски, интервью со специалистами и лучшие иллюстрации! Ха! Благодаря тебе они заработали бешеные деньги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140128,
					"content": "#Хм, путешественни{F#ца}{M#к}, господин Йог, вы пока поговорите, а я... я пойду займусь другими делами. Позвольте оставить вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 705140129,
					"content": "Свен очень быстро уходит...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Ладно. Кажется, у Ордо Фавониус, как и у меня, всегда полно работы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140131,
					"content": "Так что привело тебя в Мондштадт?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "Я? По правде сказать, я хочу обойти весь Тейват.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140133,
					"content": "А цель моего путешествия - продавать эти Динамические ядра, которые я изготавливаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140134,
					"content": "Если коротко, то Динамическое ядро представляет собой заводной механизм. Нужно периодически заводить его, и ядро ещё долго будет давать энергию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140135,
					"content": "Чтобы продемонстрировать все возможности этого механизма, я специально спроектировал игрушку, которая работает на энергии Динамического ядра. Я назвал её «Вечно движущаяся картина».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140136,
					"content": "Гм... Жаль только, что, несмотря на всё моё желание, я не могу продемонстрировать тебе этот механизм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140137,
					"content": "Он оказался настолько хорош, что даже монстры стали жертвами его чар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140138,
					"content": "Прямо сейчас злобные монстры разбирают мой механизм на бессчётное множество деталей и любуются своей работой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140139,
					"content": "Я уже попросил Гильдию искателей приключений о помощи, но от них до сих пор нет никаких вестей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140140,
					"content": "#Почётный рыцарь, если тебя это хоть капельку интересует, не {F#могла}{M#мог} бы ты мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140141,
					"content": "Поверь, мой механизм... и вознаграждение ни в коем случае тебя не разочаруют!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140142,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "#Отлично! Ты точно {M#такой}{F#такая}, как о тебе писали в газетах: {M#могущественный}{F#могущественная} искатель{F#ница} приключений с благородным сердцем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140144,
					"content": "Как жаль, что мы сейчас не в Кур-де-Фонтейне! Я бы тут же привёл к тебе журналистов из «Паровой птицы» для эксклюзивного интервью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140145,
					"content": "Твоё обаяние снова бы сразило всех наповал, и они с радостью оставили бы для тебя первую полосу ещё на три недели, предложив гонорар!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140124,
					"content": "Сенсации, большие выпуски, интервью со специалистами и лучшие иллюстрации! Ха! Благодаря тебе они заработали бешеные деньги!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Феликс Йог"
				},
				{
					"id": 705140112,
					"content": "Что-то случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
			"id": 7051403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7051403"
