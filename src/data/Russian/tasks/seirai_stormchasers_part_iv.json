				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "Гроза... стихла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580102,
					"content": "Видимо, печати всех четырёх камней наложены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580103,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "Это ты! Как у тебя получилось туда забраться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580105,
					"content": "#Тайсукэ сказал, что ты {F#прошла}{M#прошёл} через какую-то дверь и потом исчез{F#ла}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580106,
					"content": "Да что с этой дверью такое? Как странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580107,
					"content": "Что же всё-таки произошло там, наверху?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580108,
					"content": "Мы с Эйко услышали сверху грохот, похожий на раскаты грома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580109,
					"content": "Но ведь гроза должна была утихнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580110,
					"content": "Тут такое дело...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "Платформа, которая собирается из парящих в воздухе камней...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580112,
					"content": "Хм... Должен признать, что никогда не слышал о подобном естественном феномене на Сэйрае...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580113,
					"content": "...Какой же это естественный феномен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580114,
					"content": "Как ни крути, это совершенно неестественный... феномен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580115,
					"content": "Точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "Но каким бы ни был этот феномен, гроза над Сэйраем стихла. Мы выполнили поручение Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580118,
					"content": "И вот ещё, мы нашли странное перо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "Перо... Тайсукэ, взгляни-ка на него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580120,
					"content": "Позволь мне посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580121,
					"content": "Прошу прощения, я не могу определить происхождение этого пера.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580122,
					"content": "На вид и на ощупь не похоже ни на одну известную мне птицу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580123,
					"content": "Если исходить из размеров, то птица, оставившая его, должна быть такой же большой, как та каменная платформа в небе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580124,
					"content": "Это перо так важно? Если ты хочешь выяснить его историю, почему бы тебе не вывесить поручение в Гильдии? Кто знает, может, найдутся какие-то подсказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580125,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "#Что ж, в таком случае ещё раз спасибо за помощь, искатель{F#ница} приключений. Мы с Тайсукэ вернёмся в гильдию и возьмёмся за отчёты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580128,
					"content": "А, точно. Это для тебя. Тут, конечно, немного... Но всё же тебе положено хоть какое-то вознаграждение за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580129,
					"content": "Тайсукэ, собирайся. Мы возвращаемся в Гильдию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580130,
					"content": "М-м-м, Эйко... Давай быстренько заглянем в святилище и повидаемся с госпожой Нэко, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580131,
					"content": "Тайсукэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580132,
					"content": "Слушай, но ведь это говорящая кошка! Говорящая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "Тайсукэ"
				},
				{
					"id": 721580133,
					"content": "Ох, парень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эйко"
				},
				{
					"id": 721580126,
					"content": "#Я еще хочу подумать сам{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "Верно замечено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}