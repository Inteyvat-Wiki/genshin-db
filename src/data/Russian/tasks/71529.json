			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мгновенное убийство без всяких экивоков"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-352.046,
							200.421,
							-699.884
						],
						"pointId": 7030
					}
				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "Это невозможно... Как ты это сделала?! Моя... моя репутация подорвана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716665002,
					"content": "Для меня было честью сражаться с вами, добрый господин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "Мгновенное убийство без всяких экивоков"
				},
				{
					"id": 716665003,
					"content": "Что за... Какая учтивая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716665004,
					"content": "Ха-ха! Ну что, ты тут во всю проигрываешь, пока нас нет, Пас{RUBY#[S]«Король жучиных боёв»}тушонок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716665005,
					"content": "Я так не считаю. Если Король жучиных боёв не готов сдаться, значит, он ещё не проиграл мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "Мгновенное убийство без всяких экивоков"
				},
				{
					"id": 716665006,
					"content": "В бою, как и в жизни, вполне нормально время от времени сталкиваться с неудачами. Но неудача превращается в поражение только в том случае, если вы принимаете решение прекратить борьбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "Мгновенное убийство без всяких экивоков"
				},
				{
					"id": 716665007,
					"content": "Отлично сказано! Да! Я пока не собираюсь признавать поражение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716665008,
					"content": "И всё же постоянные оправдания ни к чему не приведут. Не тратьте энергию на пустые разговоры, лучше упорно сражайтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "Мгновенное убийство без всяких экивоков"
				},
				{
					"id": 716665009,
					"content": "Уф, уделала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716665010,
					"content": "Король óни, эта противница тебе пока не подходит. Послушайся моего совета: отправь в бой своего генерала, а сам наблюдай за ходом поединка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716665011,
					"content": "Смотреть на то, как сражаются другие, тоже важная часть обучения воина. Некоторые навыки приобретаются на практике. Другие - через наблюдение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Гранд-мастер Ханакадо"
				},
				{
					"id": 716665012,
					"content": "Хорошо сказано, гранд-мастер! Ты очень вовремя, дружище! Правая рука короля óни, даю тебе возможность сразиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 716665013,
					"content": "#Наконец настал твой черёд! Продемонстрируй свои умения, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716665014,
					"content": "Хе-хе! Легкотня!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Значит, мне предстоит встретиться лицом к лицу с {F#легендарной искательницей}{M#легендарным искателем} приключений? Полагаю, мне лучше глядеть в оба...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мгновенное убийство без всяких экивоков"
				},
				{
					"id": 716665015,
					"content": "О-о-о! Как страшно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
		{
			"id": 7166651,
