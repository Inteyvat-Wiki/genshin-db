			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мисс Лань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "Бесполезно... Абсолютно бесполезно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "#Тебе совсем нечем заняться, не так ли? Ты либо слишком хорош{F#а}, либо слишком слаб{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100104,
					"content": "Хотя я не сомневаюсь в твоих способностях. У тебя получилось справиться с предыдущими поручениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100105,
					"content": "Если тебе нечем заняться, то ты можешь помочь мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100106,
					"content": "На этот раз всё намного серьёзнее. Тебе предстоит сразиться с Руинным охотником. Справишься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100107,
					"content": "Считай сделано.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "#А ты уверен{F#а} в своих силах. Мой брат тоже был таким. Может быть, однажды у тебя получится достичь его величия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100113,
					"content": "Вот и всё. После эпичной победы над руинным охотником в долине Гуйли возвращайся за наградой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100114,
					"content": "Не забудь поискать меч или что-то, связанное с мечом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100115,
					"content": "#Если ничего не найдёшь, просто возвращайся сам{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100116,
					"content": "Желаю тебе удачи! Надеюсь, твои поиски увенчаются успехом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100108,
					"content": "Дай угадаю. Мне стоит поискать меч, да?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Конечно. Если у тебя получится победить Руинного охотника, посмотри, пожалуйста, нет ли вокруг меча или чего-то подобного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100111,
					"content": "#Предупреждаю тебя, что руинные охотники - серьёзные соперники. В поединке с ними будь внимател{F#ьна}{M#ен} и осторож{F#на}{M#ен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100112,
					"content": "Будет здорово, если у тебя получится найти меч. Но это необязательно. Ты получишь награду за победу над Руинным охотником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
