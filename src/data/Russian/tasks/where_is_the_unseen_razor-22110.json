			"dialogs": [
				{
					"id": 221100201,
					"content": "Руинный охотник повержен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100202,
					"content": "Пока ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Не спеши. К битве с Руинным охотником нужно хорошенько подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				}
			]
		},
		{
			"id": 2211003,
			"completionStepIds": [
				2211003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
