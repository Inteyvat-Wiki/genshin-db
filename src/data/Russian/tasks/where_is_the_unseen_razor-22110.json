			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мисс Лань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100301,
					"content": "#Уже справил{F#ась}{M#ся} с Руинным охотником?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Тебе удалось справиться с Руинным охотником! У меня больше не осталось сомнений в твоих способностях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100304,
					"content": "Меч до сих пор не нашёлся? Прости, что так настойчиво тебя об этом спрашиваю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100305,
					"content": "#Неважно. Ты выполнил{F#а} все мои поручения. Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100306,
					"content": "«Скрытый клинок», где же ты скрываешься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100307,
					"content": "Рано или поздно ты его найдёшь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "Ты хочешь меня успокоить? Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100310,
					"content": "Рано или поздно я найду этот меч, куда бы поиски ни привели меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100311,
					"content": "Я планирую расширить зону поиска, поэтому в будущем мне ещё может понадобится твоя помощь. Разумеется, все твои труды будут щедро вознаграждены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100316,
					"content": "Вот твоя награда. Мне нужно идти. Поручения сами себя не выполнят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100317,
					"content": "«Скрытый клинок»... Когда-нибудь я тебя найду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100308,
					"content": "Твои поручения были слабо связаны с мечом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "Потому что поручения, напрямую связанные с мечом, уже закончились. К сожалению, всё это было напрасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100313,
					"content": "Мой брат никогда бы добровольно не расстался со своим мечом. Произошло что-то очень опасное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100314,
					"content": "Поэтому я начала выполнять другие поручения. Самые опасные. Я думала, что они приведут меня к «Скрытому клинку»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Мисс Лань"
				},
				{
					"id": 221100315,
					"content": "Но оказалось, что опасных поручений слишком много. Поэтому я решила попросить тебя о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Мисс Лань"
				}
			]
		}
	]
}