							3506.606,
							283.052,
							4560.857
						],
						"pointId": 340100455
					}
				]
			},
			"dialogs": [
				{
					"id": 140160801,
					"content": "Хватит терять время. Босс не может столько ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160802
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160802,
					"content": "Выступаем завтра же. Распоряжайся этой информацией как хочешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160803
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160803,
					"content": "И твоя удочка не сработала автоматически, потому что там не хватило одной детали. Выходит, мы были в одинаковых условиях?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160804
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160804,
					"content": "Ну, если говорить только о количестве недостающих деталей, то да... *зевает* Ох, всё. У Паймон глаза слипаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160805,
					"content": "Ха-ха! Скорее спать! Я отлично провела время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160806
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160806,
					"content": "До завтра, Навия.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160807
					]
				},
				{
					"id": 140160807,
					"content": "До завтра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160808
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160808,
					"content": "Как дела, выспались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160809
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160809,
					"content": "Паймон приснился танец с морскими звёздами... Так что у Паймон была звёздная ночь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160810,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160811
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160811,
					"content": "Где ты этого понабралась?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160812
					]
				},
				{
					"id": 140160812,
					"content": "Ха-ха, не думал, что ты такая забавная.",
					"roleType": "TALK_ROLE_NPC",
