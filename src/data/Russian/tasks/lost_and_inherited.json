				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Навия"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3819.22,
							440.097,
							4334.889
						],
						"pointId": 340100401
					},
					{
						"sceneId": 3,
						"position": [
							3819.281,
							440,
							4337.039
						],
						"pointId": 340100402
					},
					{
						"sceneId": 3,
						"position": [
							3818.551,
							440.109,
							4335.818
						],
						"pointId": 340100403
					}
				]
			},
			"dialogs": [
				{
					"id": 140160701,
					"content": "Какая же это рыбалка? Удочка автоматическая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160702,
					"content": "Да, а что такого? Многие рыбаки в Пуассоне рыбачат на такие удочки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160703
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160703,
					"content": "Но ведь так теряется вся суть рыбалки... Ну, сначала ты не сводишь глаз с поплавка, а потом азартно тащишь рыбу из воды, когда клюёт. Понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160704,
					"content": "#Ну, это всего лишь один из подходов. А ты что думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160705,
						140160707
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160705,
					"content": "Самому рыбачить интереснее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160706
					]
				},
				{
					"id": 140160707,
					"content": "Автоматическая рыбалка экономит силы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160708
					]
				},
				{
					"id": 140160706,
					"content": "Тогда в другой раз будем ловить простыми удочками. Получится соревнование по рыбалке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160708,
					"content": "Ха-ха, я согласна. Я просто радуюсь улову, и неважно, что у меня за удочка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160709,
					"content": "Если честно, Паймон больше удивляет твоя бодрость. В такой час Паймон трудно удержаться, чтобы не закрыть глаза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160710,
					"content": "Наверное, это наследственность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160711
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160711,
					"content": "И всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160712,
					"content": "Ха-ха, если я начну объяснять, ты ещё больше заклюёшь носом. Знаешь, я просто думала, скольким я обязана Спина-ди-Росула. И матери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160713
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160713,
					"content": "Матери?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160714
					]
				},
				{
					"id": 140160714,
					"content": "Отец всегда возлагал на меня несбыточные ожидания. Но чем сильнее он старался сделать из меня второго Калласа, тем меньше мне хотелось ему подчиняться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160715
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160715,
					"content": "Моя мать была совсем другой. Говорили, она хотела только одного: чтобы я росла счастливой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160716
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160716,
					"content": "Все члены Спина-ди-Росула уважали её желание. И что бы я ни вытворяла, когда была ребёнком, они всегда мне потакали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160717
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160717,
					"content": "Представляете? Всякий раз, когда отец хотел отругать меня за какой-нибудь проступок, все члены Спина-ди-Росула, в том числе Мелус и Сильвер, молча стояли и слушали его назидания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160718
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160718,
					"content": "Как бы ни бранился папа, все остальные молчали. Постепенно он понял, что ругать меня по пустякам бессмысленно, и перестал делать это так часто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160719
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160719,
					"content": "Паймон бы и в голову не пришло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160720,
					"content": "Да, и сейчас, повзрослев, я понимаю, какими все они были добрыми и терпеливыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160721
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160721,
					"content": "Ребёнком я была уверена, что могу вытворять любые шалости, потому что в конце мне всегда помогут замести следы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160722
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160722,
					"content": "Но однажды Мелус вернулся домой раненым. Он не сказал, что случилось, но я поняла, что это из-за меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160723
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160723,
					"content": "Тогда я осознала, что за ошибки всегда приходится платить. И если ты по-настоящему заботишься о людях, которые тебя окружают, то постараешься не допускать ошибок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160724
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160724,
					"content": "Потому что когда приходит пора расплачиваться за промахи, дорогие тебе люди не задумываясь выступят вперёд и примут удар на себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160725,
						140160726
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160725,
					"content": "Навия...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160726,
					"content": "Ты ещё не оправилась от потери...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160727,
					"content": "Простите, не надо было мне заводить этот разговор. Не хочу сегодня говорить о грустном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160728
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160728,
					"content": "Я просто хотела сказать, что тёплая атмосфера в Спина-ди-Росула - плод усилий моей матери, а не отца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160729
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160729,
					"content": "Для меня это единственный способ почувствовать её любовь, и мне хочется сохранить это тепло и передать его дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160730
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160730,
					"content": "Поэтому ты отпустила сегодня тех людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160731
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160731,
					"content": "Да, а может быть, я просто решила не повторять прошлых ошибок. Не хочу делать поспешных выводов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160732
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160732,
					"content": "#{NICKNAME}, смотри! У тебя клюёт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160733
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160733,
					"content": "А почему удочка сама не наматывает леску?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160734
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160734,
					"content": "Наверное, я неправильно установила механизм. Я впервые собирала такую удочку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160735
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160735,
					"content": "Не дайте ей уйти! Хватайте её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160736
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160736,
					"content": "Что, и Паймон должна её хватать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160737
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160737,
					"content": "Спустя некоторое время вы вместе вытаскиваете из воды огромную рыбу.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						140160738
					]
				},
				{
					"id": 140160740,
					"content": "Ты... ты что, забыла повесить крючок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1401608,
