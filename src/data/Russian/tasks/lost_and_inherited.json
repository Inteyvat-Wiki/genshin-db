				{
					"id": 140160201,
					"content": "Хм. Мы знали, что с вами будет непросто сладить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160202
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160202,
					"content": "Какие грубияны. Похоже, придётся преподать им урок хороших манер.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160203
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160203,
					"content": "Вперёд, ребята. Пора с ними разделаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мартинат"
