			"dialogs": [
				{
					"id": 140160401,
					"content": "Отвечай, кто вы такие? Почему вы следили за нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160402
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160402,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160403
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160403,
					"content": "Не думай, что отделаешься от нас молчанием!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160404,
						140160405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160404,
					"content": "Трезво оцени обстановку. И не надейся, что сможешь сбежать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				},
				{
					"id": 140160406,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160407
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160407,
					"content": "Босс, как вы? Не ранены?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160408
					],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160408,
					"content": "Такому противнику не под силу нас даже поцарапать, не то что ранить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160409
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160409,
					"content": "Ладно, хватит строить из себя героя, говори. Не то попадёшь в Палату Жардинаж, там с тобой разговаривать будут иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160410
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160410,
					"content": "Мы... хотели отомстить Спина-ди-Росула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160411
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160411,
					"content": "Но вы нас заметили, и мы оказались слабее, так что... сдаёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160412
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160412,
					"content": "Отомстить? Так вы... люди Ромёфа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160413
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160413,
					"content": "Значит, тебе знакомо это имя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160414
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160414,
					"content": "Если так, ты должна понимать, откуда взялась наша ненависть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160415
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160415,
					"content": "Остынь немного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160416
					]
				},
				{
					"id": 140160416,
					"content": "Да. У вас нет ни малейших шансов на победу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160417
					],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160417,
					"content": "Пф...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160418
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160418,
					"content": "Мы немного выпили, увидели на улице Навию, обозлились, решили проследить за вами и дождаться удобного случая, чтобы испортить вам день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160419
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160419,
					"content": "Но вышло наоборот, наш день оказался испорчен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160420
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160420,
					"content": "Ты лжёшь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160421
					]
				},
				{
					"id": 140160421,
					"content": "А?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160422,
						140160423
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160422,
					"content": "Вы следовали за нами всю дорогу до города.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160424,
					"content": "Какая проницательность. Ну и что? Мы ничего вам не сделали. Да и не могли ничего вам сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160425
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160425,
					"content": "Просто увидели вас, разозлились, вино ударило в голову.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160426
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160426,
					"content": "Послушай, Каллас давно мёртв. Что бы ни случилось в прошлом, я надеюсь начать историю Спина-ди-Росула с чистого листа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160427
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160427,
					"content": "Сейчас я действующая глава Спина-ди-Росула. Если ваш босс хочет со мной поговорить, я буду только рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160428
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160428,
					"content": "Чтобы подтвердить свои намерения, я не буду выдвигать против вас никаких обвинений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160429
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160429,
					"content": "...Я понял, спасибо. Я передам твои слова боссу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160430
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160430,
					"content": "Но если впредь вы попытаетесь выкинуть или даже замыслить нечто подобное, вам не поздоровится. Ясно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160431
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160431,
					"content": "Ясно, всё ясно. Эй, идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160432
					],
					"speakerTitle": "Мартинат"
				},
				{
					"id": 140160432,
					"content": "Ох, ты уверена, что их можно отпустить, Навия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160433,
					"content": "Не хочу множить старые обиды, доставшиеся мне от отца. И потом, я не думаю, что он был полностью прав насчёт аквабусов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160434
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160434,
					"content": "Если Ромёф согласится, я буду рада сесть за стол переговоров. Нельзя упускать возможность начать всё с начала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160435
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160435,
					"content": "Поддерживаю босса. Отвечать насилием на насилие - примитивная практика, которой не место в нынешней Спина-ди-Росула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160436
					],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160436,
					"content": "Да, и Колтер говорил, что они сейчас сидят на мели. Значит, у них пока недостаточно ресурсов, чтобы бросить нам вызов. Лучшее время для переговоров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160437
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160437,
					"content": "Но я всё равно думаю, что нам не стоит сбрасывать со счетов Ромёфа и его подручных. Если он не обратит внимания на наши слова...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160438
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160438,
					"content": "Тогда противостояние рано или поздно выльется в открытую битву.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160439
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160439,
					"content": "Да, его люди явно не большие поклонники Спина-ди-Росула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160440
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160440,
					"content": "Надеюсь, до битвы не дойдёт... Хоть старая ссора и развела нас на много лет, раньше мы все были частью большой семьи Спина-ди-Росула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160441
					],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160441,
					"content": "Да, я с тобой согласна. Ладно, этот вопрос мы уладили, пока о Ромёфе можно не беспокоиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160442
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160442,
					"content": "Уже поздно. Давайте заночуем во Флёв Сандр? А в Пуассон вернёмся завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160443
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160443,
					"content": "Я попрошу кого-нибудь написать Флорану письмо и сообщить о случившемся, чтобы он усилил охрану вокруг Пуассона и принял меры против разных подозрительных личностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160444
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160444,
					"content": "Опять ночуем во Флёв Сандр? Там даже подушки пахнут водорослями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160445
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160445,
					"content": "Ничего не поделаешь, Флёв Сандр стоит на воде, и туда почти не проникает солнечный свет. Но Пуассон мало чем отличается от Флёв Сандр, так что я давно привыкла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160446
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160446,
					"content": "Зато вечером мы сможем посидеть в ресторанчике, выпить, поужинать жареной рыбой! И послушать, как местные поют морские песни. Что думаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160447
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160447,
					"content": "Мм, ладно, уговорила! Идём, Паймон тоже хочет спеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160423,
					"content": "Вы всё продумали заранее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160405,
					"content": "У нас везде есть свои люди.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				}
			]
		},
