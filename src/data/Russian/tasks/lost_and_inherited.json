			"dialogs": [
				{
					"id": 140160101,
					"content": "Людивин, вот и я! Как идут дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160102
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160102,
					"content": "Если бы не демуазель Спина-ди-Росула, мой магазинчик давно бы закрылся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160103
					],
					"speakerTitle": "Людивин"
				},
				{
					"id": 140160103,
					"content": "Ха-ха, все знают, сколько у тебя разных знакомств и как искусна ты в ведении дел, так что напрасно жалуешься. И не забывай, она теперь наш босс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160104
					],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160104,
					"content": "Да, простите, «демуазель» - это я по привычке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160105
					],
					"speakerTitle": "Людивин"
				},
				{
					"id": 140160105,
					"content": "Вы пришли за униформой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160106
					],
					"speakerTitle": "Людивин"
				},
				{
					"id": 140160106,
					"content": "Да, в прошлый приезд я совсем про неё забыла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160107
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160107,
					"content": "Не ожидала, что демуазель лично придёт забирать заказ, ведь можно было послать за униформой кого-нибудь из подручных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160108
					],
					"speakerTitle": "Людивин"
				},
				{
					"id": 140160108,
					"content": "Навия серьёзно относится даже к мелочам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160109,
					"content": "Дело не в этом, просто мне захотелось развеяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160110
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160110,
					"content": "Новое путешествие лучше любых лекарств врачует душевные раны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160111
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160111,
					"content": "Да, босс права. Чем сидеть и тосковать в одиночестве, лучше отправиться в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160112
					],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160112,
					"content": "Минутку, сейчас я всё принесу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160113
					],
					"speakerTitle": "Людивин"
				},
				{
					"id": 140160113,
					"content": "Кстати, а почему Адель вообще вздумалось присоединиться к Спина-ди-Росула?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160114,
					"content": "Ха-ха, она не назвала конкретных причин, только сказала, что я ей очень понравилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160115
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160115,
					"content": "После тех событий она стала держаться веселее. Наверное, дело в том, что теперь она точно знает: её отец вовсе не был плохим человеком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160116
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160116,
					"content": "Она говорит, что всегда боялась моего отца и думала, будто все члены Спина-ди-Росула такие же страшные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160117
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160117,
					"content": "Но нынешняя Спина-ди-Росула совсем другая. Адель набралась смелости поговорить со мной и увидела, что я могу её понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160118
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160118,
					"content": "У вас за плечами похожий опыт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160119
					]
				},
				{
					"id": 140160119,
					"content": "Да, наверное. Пытаясь выяснить правду, заодно я помогла и ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160120
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160120,
					"content": "И она сказала, что хочет помогать людям, как я. А не сидеть на месте и ждать, когда ей протянут руку помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160121
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160121,
					"content": "Судя по всему, она будет достойным членом Спина-ди-Росула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160122
					],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160122,
					"content": "Я согласна. Но для начала нам нужно создать условия для её здорового развития. Потом Адель вырастет и примет окончательное решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160123
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160123,
					"content": "(Значит, мне не послышалось...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160124
					]
				},
				{
					"id": 140160124,
					"content": "#Что такое, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160125,
						140160126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160125,
					"content": "Идите за мной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				},
				{
					"id": 140160127,
					"content": "Что? Какой хвост? Паймон уже летит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140160128,
					"content": "Я с вами! Колтер, захвати униформу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160129
					],
					"speakerTitle": "Навия"
				},
				{
					"id": 140160129,
					"content": "Да, хорошо, конечно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Колтер"
				},
				{
					"id": 140160126,
					"content": "За нами хвост.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				}
			]
		},
