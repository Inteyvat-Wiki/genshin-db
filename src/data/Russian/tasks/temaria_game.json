						],
						"stepId": 7217601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Малыш Кудзирай",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "Привет! У меня для тебя есть хорошая вещь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760102,
					"content": "Спасибо, но я пас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Как жаль, в таком юном возрасте, а уже вынужден заниматься тёмными делишками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760104,
					"content": "Это не то, о чём вы подумали! Я собирался спросить, не хотите ли вы сыграть со мной в игру под названием тэмари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760105,
					"content": "Тэмари?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760106,
					"content": "#Это просто. Я спрячу тэмари где-нибудь рядом. Если путешестве{F#ница}{M#ник} сумеет найти его, пока звучит песня тэмари - то победит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760107,
					"content": "Так это и есть игра в тэмари?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "Что? Замечательная искательница приключений Большая Сестра меня научила. А ещё она сказала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760109,
					"content": "«Кудзирай, запомни, ты должен говорить: \"Если выиграете, получите хорошую вещь\"».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760110,
					"content": "Итак, если выиграете, получите хорошую вещь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760111,
					"content": "#Хорошую вещь! {NICKNAME}, Паймон думает, что нужно всегда играть с детьми, когда они просят об этом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760112,
					"content": "Но я всё ещё думаю, что в тэмари играют не так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Возможно, это просто местные правила. Не будем обращать внимание на такие мелочи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760114,
					"content": "Так ты малыш Кудзирай, да? Мы с тобой сыграем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760116,
					"content": "Эй, было бы здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760115,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217602",
							"2"
						],
						"stepId": 7217602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Кудзирай",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Э, а для вас не слишком сложно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760203,
					"content": "Это потому, что Паймон пока только разминается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760204,
					"content": "Хотите попробовать ещё раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760205,
					"content": "#Конечно! {NICKNAME}, надо показать малышу Кудзираю, как мы умеем играть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760206,
					"content": "Ещё один разок!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Ура! Цель игры состоит в том, чтобы за отведённое время найти тэмари!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Кудзирай"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Кудзирай",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "Замечательно играете! Вы сразу его нашли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760703,
					"content": "#Хо-хо, {NICKNAME} - опытн{F#ая}{M#ый} путешественни{F#ца}{M#к}, повидавш{F#ая}{M#ий} много стран.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760704,
					"content": "Ух ты! Так вы и в Мондштадте бывали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760705,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Здорово! От Большой Сестры я слышал, что в Мондштадте есть много красивых мест, таких как логово Ужаса Бури с супер-пупер высокими башнями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760707,
					"content": "Логово Ужаса Бури.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Да, интересно, что выше: та башня или Тэнсюкаку всемогущего сёгуна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760710,
					"content": "Малыш Кудзирай, почему ты гуляешь один в глуши?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760711,
					"content": "Потому что когда сестра ловила рыбу, она думала, что я распугаю рыбу, так что отпустила меня поиграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760712,
					"content": "Как-то я встретил Большую Сестру, которая была искательницей приключений. Она увидела, что мне скучно, подарила мне много тэмари и сказала «искать жадных путешественников, чтобы с ними сыграть».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760713,
					"content": "Жадных путешественников...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "Мы не жадные! Мы обеспокоенные! Мы переживаем, что малыш Кудзирай скучает, играя сам с собой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760715,
					"content": "#Точно! Я думаю, что {NICKNAME} очень приветлив{F#а}. Я так рад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760716,
					"content": "Один в глуши...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Ты ребёнок и гуляешь в глуши один. Неужели ты не боишься попасть в переделку? И у тебя даже нет с собой «хорошей вещи».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760718,
					"content": "Вы и правда очень добры. Не беспокойтесь, та искательница приключений Большая Сестра меня всему научила. С помощью маленького трюка я могу превратить тэмари в бомбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760719,
					"content": "Ой, но это же так опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760720,
					"content": "Вовсе нет! Я взорвал уже много злодеев, всяких там хиличурлов и слаймов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760721,
					"content": "А ты опасный персонаж!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760722,
					"content": "О да! Если хотите поиграть в тэмари с другими своими приятелями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760723,
					"content": "Я оставлю тэмари здесь! Вот правила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760724,
					"content": "Когда прячете тэмари, вы должны успеть это сделать, пока звучит песенка тэмари. Человек, который ищет мячик, тоже должен уложиться во время песни. Всё справедливо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760725,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "Страшно подумать, что на самом деле мы играем с бомбами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760727,
					"content": "Не бойтесь! Искательница приключений Большая Сестра научила меня: «На бомбах подрываются только злодеи. Наверное».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760728,
					"content": "«Наверное?!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721760729,
					"content": "Я пойду поиграю где-нибудь в другом месте. Пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Кудзирай"
				},
				{
					"id": 721760708,
					"content": "Неужели?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}