			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сакау"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "В последнее время туман над морем становится всё гуще. Это беспокоит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760404,
					"content": "Неужели легенда правдива?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760405,
					"content": "Что за легенда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "Эм... Это зависит от того, какую легенду ты хочешь услышать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760407,
					"content": "У истории о плавучем острове и огромном фрагменте граффити есть две версии: одна больше похожа на сказку, а другая - на легенду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760402,
					"content": "#Что бы ты хотел{F#а} послушать, {M#воин}{F#воительница} из далёких земель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760408,
					"content": "Расскажи сказку...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Хм, в историях всегда есть романтический поворот... Происхождение граффити на туманном плавучем острове - часть «Истории о Койллор и Укуку».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760403,
					"content": "Говорят, что девушка по имени Койллор оставила на пляже огромное граффити, чтобы связаться со своим Отцом-Солнцем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760410,
					"content": "Её Отец-Солнце увидел граффити с неба и забрал её с земли... В общем, вот и вся история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760417,
					"content": "Говорят, что этот тревожный туман был наслан жителям поверхности Отцом-Солнцем в наказание за то, что они украли силу его дочери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760415,
					"content": "Будь то легенда или сказка, этот туман всегда был плохим знаком с тех самых пор, как поднялся из моря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760416,
					"content": "#Герой издалека... Это место наверняка таит в себе опасность, так что будь {F#осторожна}{M#осторожен} и не подходи слишком близко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760411,
					"content": "Расскажи легенду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Говорят, давным-давно жил-был злой маг, который под видом Вайоб очаровывал героев племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760413,
					"content": "Позже герои племени использовали этот огромный фрагмент граффити, чтобы запечатать в нём злого мага...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Сакау"
				},
				{
					"id": 750760414,
					"content": "Считается, что причина, по которой поверхность океана выглядит именно так, - это предзнаменование того, что злой маг разрушит печать и выберется на свободу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Сакау"
				}
			]
		},
