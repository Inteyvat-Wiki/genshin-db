			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "Наконец-то... герой издалека, если бы не твоя помощь, нас бы давно одолел чёрный враг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Ослабленное воплощение Вайоб"
				},
				{
					"id": 750761202,
					"content": "...Давным-давно люди этого племени были очарованы обликом чёрного врага, и многие ночные души оказались в Бездне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Ослабленное воплощение Вайоб"
				},
				{
					"id": 750761203,
					"content": "В том месте, где находится печать, даже сила воплощения ночи постепенно ослабевает... Эта печать оторвана от внешнего мира, как и источник веры племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Ослабленное воплощение Вайоб"
				},
				{
					"id": 750761204,
					"content": "Её необходимо снять, чтобы получить хоть малейший шанс на борьбу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Ослабленное воплощение Вайоб"
				},
				{
					"id": 750761205,
					"content": "Спасибо тебе, герой издалека... Ночные души теперь могут найти дорогу обратно в дом заоблачных снов, избежав скверны, охватившей земли Владыки Ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Ослабленное воплощение Вайоб"
				},
				{
					"id": 750761206,
					"content": "Наконец-то можно вернуться в тишину ночи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ослабленное воплощение Вайоб"
				}
			]
		}
	]
