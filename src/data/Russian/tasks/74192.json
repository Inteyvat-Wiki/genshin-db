			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Канотила"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "Я узрела: пламя на троне погасло, а пепел вновь обратился в деревья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920102,
					"content": "Вслед за тобой распускаются цветы, и тебе по силам изменить будущее, которое иначе неизбежно сулило упадок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920103,
					"content": "Канотила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Это же {M#братец}{F#сестрица} {NICKNAME}! Откуда ты здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920105,
					"content": "Ах, точно! Золотая бабочка вернулась, нужно сходить посмотреть! Пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канотила"
				}
			]
		},
		{
			"id": 7419202,
			"completionStepIds": [
				7419202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
