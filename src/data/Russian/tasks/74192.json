						],
						"pointId": 7387
					}
				]
			},
			"dialogs": [
				{
					"id": 741920201,
					"content": "У-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920202,
					"content": "Канотила...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#{M#Братец}{F#Сестрица}... Кто ты? Мне казалось, что кроме меня сюда никто не может попасть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920204,
					"content": "Откуда ты знаешь моё имя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920205,
					"content": "Мы знакомы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "Не ври! Наверняка ты ничем не отличаешься от тех монстров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920207,
					"content": "(Соврать) Меня прислала Селин.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "Вот оно что... плохой из меня ребёнок, раз заставляю её так волноваться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920209,
					"content": "#Меня зовут {NICKNAME}, разве ты не помнишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#{M#Братец}{F#Сестрица} {NICKNAME}, припоминаю... Ты огромное чудище, которое может за один укус проглотить весь мир, но при этом очень доброе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920211,
					"content": "Как грубо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "Прошу прощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920214,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "Несколько человек медленно растаяли и превратились в монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920216,
					"content": "А-а-а, жуть какая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920213,
					"content": "Ну, спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
		{
			"id": 7419203,
			"completionStepIds": [
				7419203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
