			"dialogs": [
				{
					"id": 741920401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920402
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920402,
					"content": "Канотила?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "#Ты наконец вернул{M#ся}{F#ась}! Ох, я так переживала. Думала, вдруг ты не вернёшься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920404,
					"content": "После твоего ухода мне оставалось только ждать. Это было так долго. Пришлось просить помощи у других мелюзин, но никто не знал, что делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920405,
					"content": "#(...Похоже, что и я здесь уже достаточно задержал{M#ся}{F#ась}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "Мне нужно идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#{NICKNAME}, но куда же ты?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920408,
					"content": "Не волнуйся. Я вернусь, как только найду тебя, Канотила.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "Подожди меня ещё немного, хорошо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "Хоть я и знаю, что говорить тебе это бесполезно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "Просто поверь мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Канотила"
				},
				{
					"id": 741920412,
					"content": "Не переживай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				}
			]
		}
	]
