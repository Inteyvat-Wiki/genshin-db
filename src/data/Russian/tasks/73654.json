			"dialogs": [
				{
					"id": 736540107,
					"content": "Хм... В какой лавке продаются персики зайтун? Что-то я запамятовал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736540101
					],
					"speakerTitle": "Песэн"
				},
				{
					"id": 736540101,
					"content": "Расскажи о персиках зайтун...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736540102
					]
				},
				{
					"id": 736540102,
					"content": "#Да-да, моя жена хочет приготовить из них ужин. Если бы ты смог{F#ла} достать нам десять штучек, нам хватило бы на несколько дней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736540103
					],
					"speakerTitle": "Песэн"
				},
				{
					"id": 736540103,
					"content": "#Ну как, наш{F#ла}{M#ёл} 10 персиков зайтун?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736540106,
						736540104
					],
					"speakerTitle": "Песэн"
				},
				{
					"id": 736540106,
					"content": "Вот, держи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736540104,
					"content": "Ещё нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736540105
					]
				},
				{
					"id": 736540105,
					"content": "Мне нужно именно десять, меньше никак, а то жена по шапке настучит. Я подожду. Как закончишь, возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Песэн"
				}
			]
		},
