			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цуюко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#Добро пожаловать, {NICKNAME}. Я чем-то могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 721490202,
					"content": "О твоём поручении...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "У нас есть четыре жемчужины духа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721490204,
					"content": "Правда? Я знала, что на вас можно положиться! Большое спасибо! Теперь остался лишь один шаг, чтобы открыть последнюю печать «Сердца».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 721490205,
					"content": "Не могли бы вы пройти со мной? Надеюсь, вы не против.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 721490206,
					"content": "#Раз уж мы здесь, то пару шагов пройтись нам несложно! Да ведь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721490207,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "Тогда не будем терять время. Отправляемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 721490208,
					"content": "Я не против.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
			"id": 7214903,
