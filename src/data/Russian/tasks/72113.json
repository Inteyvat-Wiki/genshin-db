			"dialogs": [
				{
					"id": 721130201,
					"content": "Дай посмотреть Паймон, дай посмотреть Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130202,
					"content": "Ура! Как всё будет благополучно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130203,
					"content": "Кажется, сегодня у Паймон удачный день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130204,
					"content": "У тебя?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "Точно! Твоя удача - моя удача! И наоборот: удача Паймон - твоя удача.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130206,
					"content": "Когда Паймон хорошо питается, это удача. Поэтому - ради нашей удачи - дай-ка Паймон чего-нибудь вкусненького.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
