					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130701,
					"content": "Ну, Госпожа Гэндо всё та же... Уф, ладно, давай посмотрим, что там на палочке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130702,
					"content": "Что? Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130703,
					"content": "Паймон всё поняла. Это плохой парень, которого нужно победить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130704,
					"content": "Ага-ага! Получается, госпожа Гэндо - шпионка. И она использует этот метод для коммуникации и ликвидации тех, кто может навредить Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130705,
					"content": "Как шумно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721130706,
					"content": "Ой! П-простите! Пожалуйста, не отправляйте за нами Сюмацубан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130707,
					"content": "Немедленно уходите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721130708,
					"content": "Мы пойдём тогда! Отправимся к месту на картине и посмотрим, сможем ли мы найти цель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
