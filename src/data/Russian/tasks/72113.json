			"dialogs": [
				{
					"id": 721130801,
					"content": "Что? А куда подевалась госпожа Гэндо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130802,
					"content": "Меня это немного беспокоит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130803
					]
				},
				{
					"id": 721130803,
					"content": "Да, что если она не вернётся? Как Паймон узнает, удачный у неё день или нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130804,
					"content": "Что? Тут есть листок. Дай-ка Паймон взглянуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130805,
					"content": "Нам не стоит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130806
					]
				},
				{
					"id": 721130806,
					"content": "Это неважно! Вдруг там зацепка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130807,
					"content": "Что? Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130808,
					"content": "Кажется, мы должны посетить это место и получить дальнейшие инструкции?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130809,
					"content": "Давай поскорее узнаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
