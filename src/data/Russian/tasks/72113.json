			"dialogs": [
				{
					"id": 721130401,
					"content": "Дай посмотреть Паймон, дай посмотреть Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130402,
					"content": "Э-э, мне это не нравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130403,
					"content": "Я помню, что нужно делать! Там говорилось... привязать листок со зловещим предсказанием к стойке гадальных листков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130404,
					"content": "А потом нужно как следует накормить Паймон. Это позволит обернуть неудачу удачей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130405,
					"content": "Точно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Ну а как же! Ты что, ставишь под сомнение мудрость древних?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721130407,
					"content": "Мудрость древних невероятна! Как бы то ни было, давай сначала найдём стойку гадальных листков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
