					"Гэндо Ринго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "Кто вы такие и что вам нужно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131002,
					"content": "Это мы хотели спросить! Госпожа Гэндо, зачем ты на нас набросилась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131003,
					"content": "Как грубо. Отвечайте на вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131004,
					"content": "#Меня зовут {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "Я знаю ваши имена. Говорите правду. Откуда вы узнали кодовую фразу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131006,
					"content": "П-паймон сказала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "Подожди, что ты говоришь?! Просто расскажи госпоже Гэндо о том, что произошло! Разве ты не видишь, как угрожающе она на нас смотрит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131010,
					"content": "Понятно. Значит, вы случайно наткнулись на эти записи. В таком случае Момока, должно быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131011,
					"content": "Кто такая Момока?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "Это она хозяйка записей и моя коллега. К сожалению, она больше не сможет служить Инадзуме. Какая жалость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131013,
					"content": "Уверена, у вас ко мне много вопросов. Думаю, я смогу ответить на некоторые из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131014,
					"content": "Мы с Момокой - ниндзя Сюмацубан. Наша миссия - избавить Инадзуму от внешних угроз, а эти полоски бумаги - один из способов, которым мы сообщаем о наших заданиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131015,
					"content": "Из-за этого мы претерпели немало обид, пережили множество опасностей. Например, от этих странных и опасных чужеземцев, проникших в нашу страну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131016,
					"content": "Мондштадтцев.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "Что значит Мондштадтцев?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131020,
					"content": "Тот, кто знает пароль, один из нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131021,
					"content": "Но пароль у каждого свой. Очевидно, Момока рискнула и оставила свой пароль, чтобы уведомить нас о ситуации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131022,
					"content": "Она пыталась выманить врага, который захотел бы использовать шифр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131023,
					"content": "Значит...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "Значит, ты сразу всё поняла, госпожа Гэндо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131025,
					"content": "Конечно. Поэтому мне просто необходимо было прояснить ситуацию. Что странно, я всё равно не смогла разобраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131026,
					"content": "Будь вы шпионами из Снежной, зачем вам было честно выполнять задания? И не докладывать о них Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131027,
					"content": "...Таким образом, я верю вашей истории с покинутым лагерем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131028,
					"content": "Из ваших действий понятно, что вы подобрали шифр из любопытства, но вы не враги Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131029,
					"content": "Да, мы обелили свои имена, но Паймон всё равно злится! Мы столько времени бесплатно делали работу за госпожу Гэндо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131030,
					"content": "...Но это ведь были не вы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "Хм, вы уже всё поняли. Те задания вам давала фальшивая Гэндо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131032,
					"content": "Но как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131033,
					"content": "Когда я следила за вами, на меня напали шпионы Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131034,
					"content": "Я кое-что смыслю в искусстве ниндзя, поэтому я одурачила их, притворившись мёртвой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131035,
					"content": "Вскоре они отправили своего человека притворяться мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131036,
					"content": "#А я всё {F#думала}{M#думал}, что же с ней такое...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "А? Значит, та добрая госпожа Гэндо тоже фальшивка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131039,
					"content": "«Добрая», да? Хм, полагаю, её все любят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131040,
					"content": "В общем, они наверняка предположили, что вы члены Сюмацубан и попытались использовать вас, чтобы проникнуть в наши ряды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131041,
					"content": "Это стало для меня хорошей возможностью. Пока самозванца не было на месте, я воспользовалась своими методами и привела вас сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131042,
					"content": "А теперь слушайте внимательно. Я даю вам выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131043,
					"content": "Работайте на нас извне. Они не знают, что я жива, поэтому у нас преимущество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131044,
					"content": "А если я откажусь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "Можешь попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131046,
					"content": "#Как бы то ни было, {NICKNAME}, Фатуи наши враги тоже! Почему бы нам не поработать вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721131049,
					"content": "Правильный выбор. Все припасы этого убежища в вашем распоряжении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131050,
					"content": "Ну, если что случится, я с вами свяжусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131051,
					"content": "Надеюсь, наше сотрудничество будет плодотворным. Пока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131047,
					"content": "В этом есть смысл.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "Неудивительно, что она знала о гадальных палочках.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "Точно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Гэндо Ринго"
				},
				{
					"id": 721131008,
					"content": "Давайте, я расскажу. Дело было так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "Мы нашли покинутый лагерь на холме...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}