			"dialogs": [
				{
					"id": 50220801,
					"content": "Доброе утро! Тебе что, снились кошмары?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 50220802,
					"content": "#Ты всю ночь {F#вертелась}{M#вертелся} на кровати, вот Паймон и решила, что тебе плохо спалось. Наверное, волнуешься перед решающим сражением?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 50220803,
					"content": "(Значит, это был сон? Я почти ничего не помню.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "#(Всё, что я видел{F#а} во сне, будто окутано пеленой. А когда пытаюсь напрячь память, начинает болеть голова...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "#{NICKNAME}, пора взбодриться! Сегодня мы встречаемся с Мавуикой!",
