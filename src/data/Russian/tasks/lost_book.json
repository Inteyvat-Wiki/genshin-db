			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лиза"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "Он что, живёт в <color=#00E1FFFF>пещере</color>? Почему в Мондштадте все такие странные?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010702,
					"content": "Прошу тебя, не делай столь резких обобщений касательно жителей Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010703,
					"content": "Похоже, что тут замешан кто-то недобрый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010704,
					"content": "Хиличурлы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "Вряд ли хиличурлы стали бы похищать книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010706,
					"content": "Они с их помощью смогут разве что костёр разжечь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010712,
					"content": "Больше похоже на работу <color=#00E1FFFF>ордена Бездны</color>. У них неплохо получается оставаться незамеченными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010713,
					"content": "К тому же вход запечатан элементальными силами. Почерк магов Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010714,
					"content": "Запечатан? Как же нам снять эту печать? Наверное, будет очень тяжело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010715,
					"content": "Не переживай. Если ты думаешь, что меня способна остановить жалкая печать, то подумай ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010716,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010717,
					"content": "Вот и всё. Пойдём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010718,
					"content": "Ого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010719,
					"content": "Вот так выглядит Лиза за работой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010707,
					"content": "Орден Бездны?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "Ты читаешь мои мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010709,
					"content": "Гильдия искателей приключений?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "Хм. Их могла бы привлечь эта пещера...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010711,
					"content": "Но они не берут чужие вещи. По крайней мере у живых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Лиза"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лиза"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "<color=#00E1FFFF>«Снежная принцесса и шесть карликов»</color>! Я запомнила название! Мы же ищем эту книгу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010802,
					"content": "Да, это она. Хорошо, что с ней всё в порядке. Иначе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010803,
					"content": "Иначе что? Неужели у тебя есть ещё более жёсткие наказания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010804,
					"content": "Хе-хе. Возможно, я угостила бы его одним из своих зелий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010805,
					"content": "Ойк!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010806,
					"content": "Как я уже говорила, эта книга не из запретного отдела библиотеки. Любой житель Мондштадта мог бы взять её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010807,
					"content": "В ней нет никаких элементальных аномалий, кроме меток, которые я сама поставила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010808,
					"content": "Действительно, выглядит как самая обычная книга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010809,
					"content": "Зачем она понадобилась ордену Бездны...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "(Так загадочно. Мне очень интересно.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "На этом работа библиотекаря здесь закончена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010812,
					"content": "Если тебя так заинтересовала эта книга, можешь взять её почитать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010813,
					"content": "А... А когда её надо будет вернуть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "Ты же не будешь наказывать милашку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "Читай сколько хочешь. Я запишу тебя как хранителя книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010816,
					"content": "Такой чести могут быть удостоены только лучшие из лучших!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010817,
					"content": "Лучшие из лучших? Почему-то мне кажется, что это просто способ переложить решение загадки на твои плечи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101010818,
					"content": "Прошу прощения, вы находите мою работу неудовлетворительной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010819,
					"content": "Никак нет!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010820
					]
				},
				{
					"id": 101010820,
					"content": "#Я буду особенно осторож{M#е}н{F#а} с этой книгой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010821
					]
				},
				{
					"id": 101010821,
					"content": "Хорошо. С тобой приятно работать. Я хотела бы такого помощника, как ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010822
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010822,
					"content": "Но хватит на сегодня работы. Я возвращаюсь домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010823
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101010823,
					"content": "Не забудь зарегистрироваться в библиотеке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				}
			]
		},
		{
