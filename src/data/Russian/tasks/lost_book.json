				"points": []
			},
			"dialogs": [
				{
					"id": 101011001,
					"content": "А вот и вы, милашки! Все бумаги готовы. Теперь вы хранители этой книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011002
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011002,
					"content": "Спасибо, Лиза!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101011003,
					"content": "Но мне кажется, что мы о чём-то забыли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011004,
						101011005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101011004,
					"content": "«Путеводитель по Тейвату»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011007
					]
				},
				{
					"id": 101011007,
					"content": "Смотри! Вон там на полке стоит <color=#00E1FFFF>«Путеводитель по Тейвату»</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011008
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101011008,
					"content": "Так много экземпляров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011009
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101011009,
					"content": "Ха-ха-ха! <color=#00E1FFFF>«Путеводитель по Тейвату»</color> - периодическое издание. Это не часть собрания библиотеки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011010
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011010,
					"content": "А?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101011011,
					"content": "Можешь взять одно из изданий. Это твоя награда за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011012
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011012,
					"content": "Когда ты рядом, работа кажется чуть менее скучной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011013
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011013,
					"content": "«Путеводитель по Тейвату» оказался лишь предлогом, чтобы мы помогли тебе с работой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011014
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101011014,
					"content": "Я не ожидала, что нам придётся отправиться за город... Тем более, забираться в подземелье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011015
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011015,
					"content": "В качестве компенсации можете взять эти сувениры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011016
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011016,
					"content": "Ух ты! Лиза специально для нас подготовила подарки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011017
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101011017,
					"content": "Вообще-то я приготовила их для нашей следующей прогулки. Но я уверена, мы сможем придумать что-нибудь поинтереснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011018
					],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011018,
					"content": "*Зевает*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиза"
				},
				{
					"id": 101011005,
					"content": "Награда!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011006
					]
				},
				{
					"id": 101011006,
					"content": "#А ты так{M#ой}{F#ая} ненасытн{M#ый}{F#ая}, милашка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011007
					],
					"speakerTitle": "Лиза"
				}
			]
