			"dialogs": [
				{
					"id": 762260201,
					"content": "А? Это же Маалаус! Паймон не ожидала, что мы встретимся на Луне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260202,
					"content": "Тебя привела сюда Коломбина? Она говорила, что устроит выставку твоих картин на Луне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260203,
					"content": "Кстати, о выставке... А где твои картины?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260204,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 762260205,
					"content": "Что случилось? Неужели... картины пропали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260206,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 762260207,
					"content": "Как такое может быть? Это же Луна! Не могли же их украсть?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260208,
					"content": "Давай сначала поможем Маалаус найти картины. Может, они где-то поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
