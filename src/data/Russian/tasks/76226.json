			"dialogs": [
				{
					"id": 762260101,
					"content": "Маалаус, смотри скорее, мы нашли все твои картины!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 762260103,
					"content": "Хе-хе, не стоит благодарности! Мы тоже приложили руку к созданию этих картин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260104,
					"content": "С каких пор ты понимаешь, что говорит Маалаус, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "Ой, да ладно. Паймон столько раз была с тобой в Чертоге серебряной Луны! Ничего удивительного, что Паймон понимает Маалаус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260106,
					"content": "Тогда что Маалаус говорит о том, как пропали картины?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "Эм... ну... Паймон сейчас переведёт... Маалаус говорит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260108,
					"content": "Возможно, их украли другие куухенки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260109,
					"content": "Хм... А может, это были те удивительные транспортные штуки на Луне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260110,
					"content": "Хмм... А может, это Коломбина украла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260111,
					"content": "Это точно невозможно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "А? Ну да... Неужели Паймон неправильно поняла?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260113,
					"content": "Ты перебираешь варианты наобум.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "Кхе-кхе... изучать иностранный язык не так-то просто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762260115,
					"content": "Паймон нужен хороший учитель. Когда будет возможность, Паймон попросит Коломбину как следует обучить Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
