				{
					"id": 700230101,
					"content": "Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230102
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700230102,
					"content": "Mimi ika yaya nye! Mimi tomo, mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230103
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700230103,
					"content": "Mani. Mi muhe mani. Unu du mani! Hahahahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230104
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700230104,
					"content": "Он рассказал мне шутку на хиличурлском языке и насмешил сам себя. У них очень низкий интеллект. Выглядит жалко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700230105,
					"content": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230106
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700230106,
					"content": "Ему нужно... Эм... Нужно проверить в моём разговорнике!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Элла Маск"
				}
			]
		},
