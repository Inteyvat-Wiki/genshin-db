					"nextDialogs": [
						700230301
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700230301,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230302
