	"talks": [
		{
			"id": 1101001,
			"completionStepIds": [
				1101001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101001",
							"2"
						],
						"stepId": 1101001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дай Пай"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "#Будь начеку, путешественни{M#к}{F#ца}. Сейчас не время наслаждаться видами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100102,
					"content": "О, а почему? Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100103,
					"content": "Ага. Согласно многочисленным сообщениям очевидцев, в окрестностях присутствует Страж руин, что для него необычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100104,
					"content": "Сержант послал людей расследовать, откуда он взялся. Оказалось, что Страж без видимых причин внезапно вышел из руин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100105,
					"content": "Может, его кто-то или что-то пробудило?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100106,
					"content": "Этого мы ещё не знаем. На данный момент у нас слишком мало сведений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100107,
					"content": "Более того, эти руины особенно мрачные и жуткие. Часто из них доносятся странные звуки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100108,
					"content": "Без разрешения штаба исследовать их мы не можем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100109,
					"content": "Лучше проявлять осторожность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "Самым разумным будет усилить патрули для того, чтобы уберечь невинных граждан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100114,
					"content": "Да, для обычных людей Страж руин представляет большую опасность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100115,
					"content": "Могу ли я чем-нибудь помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Эм... Я ценю ваши добрые намерения, но не думаю, что стоит подвергать вас такому риску...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100117,
					"content": "#{NICKNAME} - отличный воин. Тебе не о чем беспокоиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100118,
					"content": "Ничего, я могу за себя постоять.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100122,
					"content": "Ну, раз такое дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100123,
					"content": "Я видел следы Стража руин <color=#00E1FFFF>на склоне</color>, но был слишком занят, оповещая прохожих об опасности, поэтому сам исследовать совершенно не мог...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100124,
					"content": "Следы, значит, хм? Любопытненько! Предоставь это нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100125,
					"content": "#Пока Миллелиты на страже города, у зла нет шансов! От лица Миллелитов выражаю тебе почтение, путешественн{F#ица}{M#ик}. Встретимся, когда я закончу патрулирование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100120,
					"content": "Не сочти за грубость, но я легко уделаю десяток таких, как ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "Ха-ха, уверенности тебе не занимать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100110,
					"content": "М-да, эффективность Миллелитов как всегда на нуле.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "Хм? Что ты такое говоришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100112,
					"content": "Эй, ты говоришь совсем как Дилюк, когда он критикует орден!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тевкр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "Эй, смотрите! Какой огромный, какой мощный!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100202,
					"content": "Что за странный наряд у этого паренька...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100203,
					"content": "Я ещё никогда не подходил к нему так близко! А вы таких видели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100204,
					"content": "Да. Это Страж руин, энергия которого на нуле.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "А вот и нет, а вот и нет! Это мой Одноглазик, а не какой-то там Страж руин!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100208,
					"content": "Одноглазик? Как мило... Погоди. Кому вообще может прийти в голову их так называть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100209,
					"content": "Моему брату! Он у меня лучший продавец игрушек. Продавать такие игрушки - его работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100210,
					"content": "Сейчас он работает в Исследовательском институте игрушек. Там-то Одноглазик и родился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100211,
					"content": "#{F#Сестрёнка}{M#Братец}, тебе ведь тоже нравятся игрушки? Вижу, рядом с тобой летает одна из последних моделей? Ещё и разговаривает! Класс!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100212,
					"content": "Паймон и Страж руин совсем не игрушки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "Именно так! Паймон не игрушка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100216,
					"content": "Благодарю вас за труды. Удалось ли обнаружить зацеп... Что? Ребёнок? В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100217,
					"content": "Как бы это сказать... Мы нашли его случайно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100218,
					"content": "Так не пойдёт, дружочек. Рядом бродит машина-убийца, здесь слишком опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100219,
					"content": "«Машина-убийца»? Похожая на эту, да, дяденька?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100220,
					"content": "Верно. И на эту тоже. Если она придёт в движение, нам не поздоровится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100221,
					"content": "Не надо так, Одноглазик - никакая вам не машина-убийца! Он хороший!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100222,
					"content": "Одно... чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100223,
					"content": "#{F#Сестрёнка}{M#Братец}, давай с этим дяденькой говорить не будем. Только плохой скажет такое об Одноглазике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100224,
					"content": "Малыш, я же всего лишь пытаюсь помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100225,
					"content": "Не стоит, он тебя не слушает.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Эх, я никогда не ладил с детьми...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100228,
					"content": "Тогда ты возвращайся к службе, а мы позаботимся о мальчике!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100229,
					"content": "Ладно, раз по-другому никак... Я продолжу патрулирование, а вы отведите его в безопасное место. Тут слишком опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Дай Пай"
				},
				{
					"id": 110100230,
					"content": "Ха! Одноглазик прогнал ещё одного плохиша!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100231,
					"content": "Как тебя зовут, малыш?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "Я Тевкр! Я приехал в Ли Юэ из далёкой Снежной, чтобы найти брата. Но я совсем один, и не знаю, где он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100234,
					"content": "Ого, ты преодолел огромный путь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100235,
					"content": "Ах, да. Теперь я должен... Вот, держи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100236,
					"content": "Хм? Что это? С виду тяжёлое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100237,
					"content": "Да это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100238,
					"content": "Сколько моры!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "Брат велел мне взять это с собой. Брат сказал: «Отдай это хорошим людям, и они позаботятся о тебе».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100241,
					"content": "Да, в предусмотрительности ему не откажешь... И как это тебе удалось добраться до Ли Юэ, не имея ничего, кроме мешочка моры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100242,
					"content": "Твоя семья, должно быть, очень богата. Неужели на продаже игрушек можно сделать состояние?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100243,
					"content": "Я принимаю!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#Ух ты, правда?! Спасибо тебе, добр{F#ая сестрёнка}{M#ый братец}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100246,
					"content": "А теперь поклянёмся на мизинцах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100247,
					"content": "«Клянись, клянись, клянись, и клятвы ты держись. Ну а если кто соврёт, то попадёт на лёд. А тот лёд холодный, замерзай, негодный!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100248,
					"content": "Эта, казалось бы, детская считалочка хорошо передаёт суровые нравы людей Снежной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100249,
					"content": "Раз уж такое дело, придётся нам некоторое время побыть няньками... Но где же всё-таки нам искать его брата?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100250,
					"content": "Там, где поддерживаются тесные связи со Снежной...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Тесные связи со Снежной, говоришь? Паймон придумала! Пойдём поспрашиваем в <color=#00E1FFFF>Банке северного королевства</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100254,
					"content": "Отлично! Я наконец увижу брата!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100252,
					"content": "В <color=#00E1FFFF>Банке северного королевства?</color>",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "Точно. В путь! На месте разберёмся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100244,
					"content": "Я принимаю! (И верну сразу же, когда найдём брата...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "Много, много моры!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "Где твои родители?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Давай я всё улажу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Ага. Ограниченная партия. Завидуешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "Эй! Хватит, Паймон вам не вещь какая-нибудь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100206,
					"content": "Будь осторожен. Они злые ребята.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "А то! Одноглазик с ума сойти как силён! От него ни один мерзавец не уйдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Тевкр"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
							"2"
						],
						"stepId": 1101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайльд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "Вряд ли это будет уместным, господин Предвестник. Разве можно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Екатерина"
				},
				{
					"id": 110100302,
					"content": "Что ты, всего лишь разок, ничего страшного!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100303,
					"content": "А он что тут делает?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100304,
					"content": "Братик, братик!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100305,
					"content": "Знакомый голос... О боги, это ведь Тевкр!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100306,
					"content": "Ха-ха-ха, вот так сюрприз! Я думал, что увижу тебя, только когда вернусь домой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100307,
					"content": "Как там Тоня и Антон? У них всё хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100308,
					"content": "Дома все соскучились по тебе! Тоня молится за тебя каждый вечер...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100309,
					"content": "...Погоди-ка, Тевкр. Почему ты здесь, в Ли Юэ? Почему мне ничего об этом не известно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100310,
					"content": "Ну, я... Я увидел один корабль, и мне показалось, что на нём продают игрушки, и я подумал, что ты на борту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100311,
					"content": "А когда я сошёл на берег, то просто шёл и шёл... А потом я встретил Одноглазика!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100312,
					"content": "Одноглазик прогнал одного негодяя, а потом вот эти ребята помогли мне найти тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100313,
					"content": "Значит, Тевкр зайцем доплыл до Ли Юэ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "А ещё он... братик Чайльда?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100316,
					"content": "Паймон теперь со спокойной душой может принять деньги Тевкра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100317,
					"content": "То, что ты сделал, Тевкр, очень опасно. Я рад тебя видеть, правда. Но ты должен пообещать брату, что больше таких фокусов выкидывать не будешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100318,
					"content": "Хорошо, обещаю. Только не злись, братец, пожалуйста...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100319,
					"content": "Я не злюсь, что ты... Просто переживаю за тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100320,
					"content": "Кто знает, что могло случиться, не встреть ты этих славных ребят. Тевкр, ты хоть отблагодарил их как следует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100321,
					"content": "Угу! Я всегда очень вежлив!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100322,
					"content": "Неужели ты нас заметил, «братец Чайльд»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100323,
					"content": "Ха-ха-ха, прошу прощения. Семья важнее всего. Надеюсь, вы сможете меня понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100324,
					"content": "Да, между нами были некоторые разногласия, но... Если на мелкие склоки закрыть глаза, то мы отлично друг с другом ладим, разве не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100325,
					"content": "Ты говоришь это из вежливости?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Хе-хе, мы в этой игре всего лишь пешки. А что до исхода партии и последствий... Так пусть с этим разбираются игроки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100328,
					"content": "Для меня же истинный интерес представляет результат наших с вами маленьких схваток.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100329,
					"content": "Ты что, опять напрашиваешься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100330,
					"content": "Ха! Не забывайте, что я, Тарталья, с каждой секундой становлюсь сильнее. В следующий раз вы так легко не отделаетесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100331,
					"content": "Я тоже на месте не стою, знаешь ли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Эй, эй, вы прямо сейчас подраться хотите, что ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100334,
					"content": "Ха-ха-ха... Давайте позже. Не показывать же младшему брату дурной пример.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100335,
					"content": "Зачем вам драться, братец? Вы что, враги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100336,
					"content": "#Вовсе нет, что ты! {NICKNAME}, позволь мне официально поблагодарить тебя за то, что сопроводил{F#а} моего брата. Мне крайне важна его безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100337,
					"content": "Я буду следить за каждым твоим шагом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "К слову... Паймон кое-что вспомнила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100340,
					"content": "Тевкр говорил, что брат его продаёт игрушки. Но разве ты не один из Предвес...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100341,
					"content": "Кхе-кхе! Ох... Вы об этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100342,
					"content": "Тсс! Я ему так сказал потому, что должен подавать братику пример. А что может быть круче для ребёнка, если не работа, связанная с игрушками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100343,
					"content": "А ещё я не хочу впутывать свою семью в дела Фатуи... Или, другими словами, тёмную сторону Снежной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100344,
					"content": "Старшие уже знают, что я служу Царице, но Тевкр ещё маленький, и я для него...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100345,
					"content": "Кхм-кхм. Я всё ещё лучший внештатный продавец игрушек, и временно закреплён за филиалом Исследовательского института игрушек Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100346,
					"content": "Именно, именно! Мой брат самый крутой! Он - лучший друг Одноглазика!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100347,
					"content": "Прошу вас, пока Тевкр здесь, подыграйте мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100348,
					"content": "Ах, да. Екатерина, с просроченным платежом я разберусь сию же минуту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100349,
					"content": "Что, сливаешься, когда запахло жареным?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100350,
					"content": "Но господин Чайльд, разве будет уместно просить вас собирать долги?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Екатерина"
				},
				{
					"id": 110100351,
					"content": "Проиграл - плати, ведь так? А если проиграл пари агенту, так ещё можно и немного размяться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100352,
					"content": "Ты уходишь продавать игрушки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100353,
					"content": "#Точно! Хотел бы я побыть с тобой ещё, но служба есть служба. Уверен, {NICKNAME} будет рад{F#а} составить тебе компанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100354,
					"content": "И после всего мы должны нянчиться с твоим братом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110100355,
					"content": "#Угу! Вы мне очень нравитесь! А ещё {NICKNAME} на мизинцах обещал{F#а} обо мне заботиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110100356,
					"content": "Похоже, Тевкр сильно к тебе привязался. Ну а клятву на мизинцах тем более нарушать нельзя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100357,
					"content": "(Да они сговорились против меня...) ...Да, конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "Я ваш должник. Вот, деньги на развлечения. Вы уж поводите Тевкра по Ли Юэ, пусть он хорошо проведёт время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100360,
					"content": "Если я вам вдруг сильно понадоблюсь, приходите <color=#00E1FFFF>к озеру Цинсю</color>. До встречи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110100358,
					"content": "Я сделаю это ради Тевкра...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "Забота о благе семьи - это я понять могу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100332,
					"content": "В любое время к твоим услугам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100326,
					"content": "Каков наглец...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100315,
					"content": "Тевкр - братик Чайльда?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100316
					]
				}
			]
		},
