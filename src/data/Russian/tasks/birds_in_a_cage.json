					},
					{
						"sceneId": 3,
						"position": [
							3596.539,
							506.535,
							4627.84
						],
						"pointId": 340100600
					},
					{
						"sceneId": 3,
						"position": [
							3593.536,
							506.535,
							4624.393
						],
						"pointId": 340100601
					}
				]
			},
			"dialogs": [
				{
					"id": 140250301,
					"content": "У нас есть ещё немного времени до назначенной встречи, можем занять его приятной беседой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250302
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250302,
					"content": "Очень рада, что вам удалось поладить с моими детьми. Для здорового развития детям необходима хорошая компания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250303
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250303,
					"content": "Ты ведь ничего им не сделаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250304,
					"content": "Думаю, ты имеешь в виду Лини, Линетт и Фремине...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250305
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250305,
					"content": "Хотя есть ещё Фильоль и Нантёйль... Да, много их стало в последнее время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250306
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250306,
					"content": "Ничего. Я одинаково отношусь ко всем предателям, у меня нет любимчиков. Всех их ждёт одна участь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250307
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250307,
					"content": "Т-ты что, собираешься их убить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250308,
					"content": "А вы умоляете этого не делать? Мне очень жаль, но правила Дома очага едины для всех. Каждый должен отвечать за свои поступки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250309
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250309,
					"content": "Но... неужели тебе совсем нет до них дела? Они очень тебя уважают! Называют «Отцом»! Должны же у тебя быть к ним хоть какие-то чувства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250310,
					"content": "Организация, в которой чувства ставятся выше правил, обречена на скорую гибель. И Дом очага не исключение. Тем более наш Дом известен своими строгими правилами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250311
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250311,
					"content": "Единственное, чем я могу вас утешить: вы наши гости, поэтому вас наказание не коснётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250312
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250312,
					"content": "Неужели ничего нельзя сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250313
					]
				},
				{
					"id": 140250313,
					"content": "Возможно, Лини, Линетт и Фремине останутся живы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250314
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250314,
					"content": "А вот Фильоль, Нантёйль и Клерви... С такими предателями мне говорить не о чем. Они знают столько секретов, что не уйдут из Дома очага живыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250315
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250315,
					"content": "Но это... это очень жестоко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250316,
					"content": "Как вы обеспокоены... Что же, из уважения к гостям я могу ещё некоторое время делать вид, будто ничего не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250317
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250317,
					"content": "Если за это время Лини удастся избавиться от Клерви, я не стану их наказывать, ведь доказательств преступления не останется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250318
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250318,
					"content": "Но, если попытка не увенчается успехом и я поймаю детей с поличным, наказание будет суровым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250319,
						140250320
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250319,
					"content": "Договорились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				},
				{
					"id": 140250321,
					"content": "Конечно. Да, это ваше... Держите и больше не теряйте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250322
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250322,
					"content": "Чтобы выдрессировать такую птицу, нужно много времени. Будет жалко, если она погибнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250323
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250323,
					"content": "Подожди, откуда у тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250324,
					"content": "Довольно. У меня больше нет времени на светские разговоры. Пора переходить к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250325
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250325,
					"content": "Я назначила вам встречу здесь, потому что у меня дела во Дворце Мермония. К вам они не имеют отношения, но будет лучше, если вы пойдёте со мной. Чтобы у вас не было соблазна побежать и рассказать обо всём Лини.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250326
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250326,
					"content": "Пора идти. Успеем точно к назначенному времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250320,
					"content": "Ты должна сдержать своё слово!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				}
			]
		},
		{
			"id": 1402504,
