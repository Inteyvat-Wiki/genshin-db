						],
						"pointId": 83
					},
					{
						"sceneId": 1083,
						"position": [
							-38.566,
							0.351,
							-16.329
						],
						"pointId": 84
					},
					{
						"sceneId": 1083,
						"position": [
							-35.909,
							0.334,
							-18.022
						],
						"pointId": 85
					},
					{
						"sceneId": 1083,
						"position": [
							-35.757,
							0.351,
							-14.567
						],
						"pointId": 86
					}
				]
			},
			"dialogs": [
				{
					"id": 140250401,
					"content": "Давно не виделись, месье Нёвиллет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250402
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250402,
					"content": "Надо сказать, я не ожидала, что мой запрос на встречу удовлетворят так быстро. Эффективности работы Дворца Мермония можно только позавидовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250403
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250403,
					"content": "Разумеется, дипломату такого уровня должен быть оказан подобающий приём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250404
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250404,
					"content": "Хотя, будем говорить прямо, я не думал, что мы ещё однажды встретимся после того, как вы заполучили Сердце Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250405
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250405,
					"content": "#...Я вижу, вы пришли с {F#путешественницей}{M#путешественником} и Паймон. Могу я узнать цель вашего визита?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250406
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250406,
					"content": "Скоро мне придётся уехать из Фонтейна. Перед отъездом я хотела бы уладить одно дело, которое не даёт мне покоя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250407
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250407,
					"content": "Думаю, объяснения займут слишком много времени. Поэтому я решила изложить все подробности на бумаге. Прошу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250408
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250408,
					"content": "Слуга передаёт документ Нёвиллету, затем грациозно подносит чашку к губам и делает глоток.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140250409
					]
				},
				{
					"id": 140250409,
					"content": "Я уяснил суть просьбы. Не сочтите за грубость, но я не понимаю, зачем вам это нужно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250410
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250410,
					"content": "Я слышала, любимое занятие месье Нёвиллета - пробовать воду. Позвольте мне использовать воду в качестве аналогии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250411
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250411,
					"content": "Семья похожа на большое озеро, в него впадает множество рек и ручьёв, и само оно тоже питает множество рек и ручьёв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250412
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250412,
					"content": "Как человек, пристально наблюдающий за озером, я надеюсь, что каждая река, которую оно питает, рано или поздно достигнет океана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250413
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250413,
					"content": "Однако я понимаю, что объективно это невозможно. Подавляющее большинство рек пересохнет на пути к океану, вода уйдёт под землю, и от них останутся лишь пустынные русла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250414
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250414,
					"content": "Но я верю, что свою ценность имеют и те реки, которым не суждено добраться до океана. Просто у их воды иное предназначение... Она может быть призвана орошать поля по берегам реки или радовать дегустатора, оказавшись в его стакане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250415
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250415,
					"content": "#Ты хоть что-нибудь понял{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250416,
						140250417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250416,
					"content": "Не очень...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				},
				{
					"id": 140250418,
					"content": "На словах всё выглядит очень красиво. Но позвольте напомнить, что немногие готовы пить из стакана с мутной водой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250419
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250419,
					"content": "С водой, которая некогда была мутной. Не беспокойтесь, я отфильтрую песок и грязь, она снова станет чистой и прозрачной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250420
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250421
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250421,
					"content": "Вы упомянули, что предлагаете сделку. Давайте обсудим подробности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250422
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250422,
					"content": "Если месье Нёвиллет примет моё предложение, я постепенно выведу свои силы из Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250423
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250423,
					"content": "И не буду проводить на территории Фонтейна «особые операции» без крайней на то необходимости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250424
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250424,
					"content": "Значит ли это, что на моём столе больше не появится дел вроде убийства Дюфрейна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250425
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250425,
					"content": "Дюфрейна? Наверное, вы имеете в виду того лицемера, который присваивал мору, пожертвованную на благотворительность? Очень сожалею о его смерти, но никаких доказательств у вас нет, так что я и представить не могу, каким образом Дом очага причастен к его убийству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250426
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250426,
					"content": "Конечно, если месье Нёвиллет согласится на моё предложение, мы постараемся принять меры, чтобы подобных инцидентов стало меньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250427
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250427,
					"content": "Вы весьма тщательно выбираете слова. Хорошо, я принимаю ваше предложение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250428
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140250428,
					"content": "Спасибо за великодушие, месье Нёвиллет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250429
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250429,
					"content": "Соглашение достигнуто, нам пора идти. Мне передали с нарочным две бутылки родниковой воды из Снежной. Надеюсь узнать мнение месье Нёвиллета... возможно, во время нашей следующей встречи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250430
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250430,
					"content": "Обязательно. И помните о своём обещании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250431
					],
