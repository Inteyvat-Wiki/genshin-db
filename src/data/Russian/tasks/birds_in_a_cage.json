					{
						"sceneId": 3,
						"position": [
							3613.748,
							509.044,
							4621.797
						],
						"pointId": 340100649
					}
				]
			},
			"dialogs": [
				{
					"id": 140250501,
					"content": "Эм, ты можешь объяснить, о чём вы разговаривали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250502,
					"content": "Ты говорила про озеро, про разные реки... Это какой-то новый проект ирригации?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250503,
					"content": "Тебе так интересно? По-моему, сейчас есть куда более насущные вопросы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250504
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250504,
					"content": "Эх... Лини... Хоть бы всё прошло хорошо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250505,
					"content": "Паймон знает! Когда у тебя такое лицо, ты скоро что-то придумаешь! Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250506,
					"content": "(Слуга выглядит беззаботной, но она не шутила, сказав, что предатели Дома очага должны поплатиться жизнью. Она всерьёз настроена наказать своих детей.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250507
					]
				},
				{
					"id": 140250507,
					"content": "(Как её остановить? Нет, сначала нужно подумать о другом.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250508
					]
				},
				{
					"id": 140250508,
					"content": "(Во время разговора у Дворца Мермония она назвала имя Клерви. Значит ли это, что Слуга давно её выследила? И заранее знала, что будут делать Лини, Линетт и Фремине...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250509
					]
				},
				{
					"id": 140250509,
					"content": "А-а-а!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250510
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250510,
					"content": "Ох... Больно. Ты в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250511
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250511,
					"content": "Извини, я виноват. Думаю только о своих газетах, не смотрю на дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250512,
						140250513
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250512,
					"content": "Извини.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				},
				{
					"id": 140250514,
					"content": "Позволь мне загладить свою вину. Вот, возьми газету. Бесплатно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250515
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250515,
					"content": "(Почему-то он выглядит знакомо...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250516
					]
				},
				{
					"id": 140250516,
					"content": "Перестань, нам ничего не надо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250517,
					"content": "Нет, возьмите. У меня их ещё много. А что не продам до завтра, всё равно придётся выбросить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250518
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250518,
					"content": "Правда, это я виноват! Хотелось принести домой побольше моры, вот я и взял в продажу целую кипу газет. А покупателей сегодня немного, газеты у меня остались нераспроданными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250519
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250519,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250520
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250520,
					"content": "#Ничего особенного! Я случайно толкнул {F#вашу подругу}{M#вашего друга}. На самом деле мне уже пора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250521
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250521,
					"content": "Подожди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250522
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250522,
					"content": "Эм... Конечно, я могу и морой заплатить, но только... у меня с собой ничего нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250523
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250523,
					"content": "Я возьму три газеты. Вот, держи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250524
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250524,
					"content": "О, спасибо! Спасибо за покупку! Да благословят вас Архонты и подарят большое богатство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250525
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250525,
					"content": "Если бы мне каждый день встречались такие щедрые покупатели... Ха-ха... Завтра не буду брать столько газет. Скоро свадьба, вот я и гоняюсь за морой очертя голову. Так нельзя. Ладно, мне пора. Пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250526
					],
					"speakerTitle": "Хоррер"
				},
				{
					"id": 140250526,
					"content": "Что ж, мои дела улажены, пора возвращаться в Пуассон. Поедем на лодке, у нас теперь и газеты есть, чтобы скоротать время в дороге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250527
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250527,
					"content": "А может... немного прогуляемся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250528
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250528,
					"content": "Паймон только сейчас поняла, что страшно хочет есть! Нельзя возвращаться в Пуассон, не подкрепившись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250529,
					"content": "(Паймон явно ищет предлог, чтобы задержаться в городе. Времени прошло мало, вряд ли у Лини что-то получилось. Как же поступить...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250530
					]
				},
				{
					"id": 140250530,
					"content": "Похоже, вы до сих пор пребываете в иллюзиях, что отсрочка нашего возвращения что-то изменит. Простите, что разрушаю иллюзию, но ваши усилия бессмысленны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250531
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250531,
					"content": "Но я могу дать Лини ещё немного времени. При одном условии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250532
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250532,
					"content": "И, если вы согласитесь принять моё условие, я даже расскажу вам, кто такая Клерви и какое отношение я к ней имею. Вам ведь это очень интересно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250533
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250533,
					"content": "Подожди, откуда такая щедрость? Ты ведь не станешь заставлять нас творить всякие злодейства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250534
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250534,
					"content": "Не переоценивайте себя. У вас нет таланта к злодействам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250535
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250535,
					"content": "Но что тогда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250536
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250536,
					"content": "Самое главное в переговорах - чтобы обе стороны оказались в выигрыше. Одними требованиями и угрозами мало чего добьёшься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250537
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250537,
					"content": "Что у тебя за условие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250538
					]
				},
				{
					"id": 140250538,
					"content": "Отлично. Моё условие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250539
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250539,
					"content": "Когда придёт время, сделайте тот выбор, который сочтёте наиболее подходящим, чтобы помочь Дому очага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250540
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250540,
					"content": "Ну ладно, вроде ничего ужасного... Но что значит «когда придёт время»? Это когда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250541
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 140250541,
					"content": "Решать вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250542
					],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250542,
					"content": "Мы принимаем твоё условие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "Тогда по рукам. Идите за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арлекино"
				},
				{
					"id": 140250513,
					"content": "Мне тоже стоило быть внимательнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
		},
		{
