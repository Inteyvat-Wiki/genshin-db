			"dialogs": [
				{
					"id": 140250801,
					"content": "Куда отправимся сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250802
					],
					"speakerTitle": "Линетт"
				},
				{
					"id": 140250802,
					"content": "Давай попробуем отвести её куда-нибудь подальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лини"
				}
			]
		},
		{
			"id": 1402510,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1402505",
							"2"
						],
						"stepId": 1402505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нёвиллет"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140251001,
					"content": "Я уже говорил, что легко вступаю в резонанс с эмоциями людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251002
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140251002,
					"content": "Но за те несколько встреч, что у нас были, я не смог уловить ни одного чувства этой Предвестницы. Её сердце похоже на спокойное озеро: кто знает, какая тьма таится в его глубинах, но по глади озера не пробегает даже рябь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251003
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140251003,
					"content": "Не знаю, была она такой всегда или невероятная сила воли позволяет ей идеально владеть своими эмоциями. Но то и другое означает, что она очень опасный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251004
					],
					"speakerTitle": "Нёвиллет"
				},
				{
					"id": 140251004,
					"content": "Я не буду допытываться, почему вы оказались на её стороне. Какими бы ни были причины, советую вам быть осторожнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нёвиллет"
				}
			]
		}
	]
}