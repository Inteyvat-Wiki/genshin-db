				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Инь Син"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510101,
					"content": "Привет. Я Инь Син, судовой врач Южного Креста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510102
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510102,
					"content": "Когда у моряков возникают проблемы со здоровьем, они приходят ко мне. Я борюсь со всем: от морской болезни и простуды до ампутаций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510103
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510103,
					"content": "Я хочу узнать о лечении травм и болезней на море.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510104
					]
				},
				{
					"id": 190510104,
					"content": "Это по распоряжению капитана? Сейчас расскажу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510105
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510105,
					"content": "Сперва позволь спросить. Как ты думаешь, какая самая большая опасность, грозящая всем новым членам экипажа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510106,
						190510107,
						190510108
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510106,
					"content": "Морская болезнь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510109,
					"content": "Это, безусловно, может быть проблемой на море, но это не самая большая опасность. Самое опасное для новичка - недооценивать опасности, поджидающие в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510110
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510110,
					"content": "Многие неопытные моряки считают себя молодыми, боеспособными и не заботятся о безопасности. Они думают, что поскольку они достаточно выносливы, чтобы заботиться о себе на суше, им будет хорошо и на море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510111
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510111,
					"content": "Такие всегда попадают в лазарет. Каждый должен знать, что быть моряком, особенно в дальнем плавании, - тяжёлая работа в неблагоприятных условиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510112
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510112,
					"content": "Нам приходится сталкиваться с недоеданием, когда не хватает припасов, всевозможными травмами и болезнями из-за суровой погоды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510113
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510113,
					"content": "...и даже c психологическими проблемами, которые могут возникнуть из-за изоляции и отсутствия развлечений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510114
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510114,
					"content": "Более того, отсутствие лекарств и возможности проведения каких-то лечебных процедур в море может привести к тому, что даже незначительные проблемы со здоровьем становятся серьезными или даже смертельными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510115
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510115,
					"content": "И тогда врач назначает ампутацию...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510116
					]
				},
				{
					"id": 190510116,
					"content": "Ха-ха, думаешь, что я шучу, да? Это неудивительно. Большинство новичков думают так же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510117
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510117,
					"content": "Но, надеюсь, теперь ты понимаешь, что с некоторыми дополнительными предосторожностями можно избежать многих проблем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510118
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510118,
					"content": "Поразмысли пока над тем, что я рассказала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510119,
					"content": "Хочешь ещё о чём-то узнать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510120,
						190510129,
						190510137
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510120,
					"content": "А что думает об этом Бэй Доу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510121
					]
				},
				{
					"id": 190510121,
					"content": "Капитан Бэй Доу? Пожалуй, никто не заботится о безопасности команды больше, чем она.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510122
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510122,
					"content": "Хотя я всего лишь врач, Бэй Доу наделила меня полномочиями отправлять с корабля любых новичков, которых я не считаю подходящими для службы, до тех пор, пока они не будут готовы вернуться с правильным отношением к нашей работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510123
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510123,
					"content": "Каждый раз, когда мы готовим запасы перед путешествием, медицине уделяется первостепенное значение. Мне даже разрешено выбирать поставщиков вне зависимости от цены. У нас выделен крупный бюджет на медицинские расходы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510124
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510124,
					"content": "Знаешь, как это называет наш счетовод Скупердяйка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510125
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510125,
					"content": "Значительный финансовый риск. Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510126
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510126,
					"content": "Но Бэй Доу осознаёт, как важно здоровье команды. Вот почему она всё равно разрешает мне свободно распоряжаться средствами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510127
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510127,
					"content": "Она полностью доверяет мне и считает, что я могу решить эти проблемы... Конечно, я доказала, что так и есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510128
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510128,
					"content": "Вот что она об этом думает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510129,
					"content": "Что происходит с членами экипажа, которым ампутировали конечности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510130
					]
				},
				{
					"id": 190510130,
					"content": "Хм? Беспокоишься о них? Неудивительно, что капитан Бэй Доу относится к тебе по-особенному. Похоже, в тебе есть не только сила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510131
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510131,
					"content": "Если тебе удастся убедить Скупердяя показать бухгалтерские книги, то увидишь, что там есть постоянная фиксированная статья расходов «Выплаты на период выздоровления и поддержка в связи с потерей трудоспособности для пострадавших членов экипажа».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510132
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510132,
					"content": "Независимо от доходов флота, те, кто сражался вместе с нами, обязательно каждый год получают выплаты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510133
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510133,
					"content": "Некоторые из тех, кто вернулся на сушу, основали малый бизнес, в то время как другие решили отправиться в путешествие по миру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510134
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510134,
					"content": "Деньги предназначены для того, чтобы они могли свободно жить своей жизнью. Возможно, они на суше даже в лучших условиях, чем мы, ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510135
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510135,
					"content": "Тем не менее мы не можем делать вид, будто деньги решили проблему. Эти травмы остаются на всю жизнь, и она уже никогда не будет прежней, понимаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510136
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510136,
					"content": "Но, по крайней мере, приятно знать, что пока капитан Бэй Доу возглавляет Южный Крест, никто не будет забыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510137,
					"content": "#Спасибо, я всё понял{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510138
					]
				},
				{
					"id": 190510138,
					"content": "Хорошо. Ну тогда всё. Следи за здоровьем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инь Син"
				},
				{
					"id": 190510107,
					"content": "Простуда?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510108,
					"content": "Потеря конечности?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				}
			]
		},
		{
			"id": 1905102,
			"completionStepIds": [
				1905102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905102",
							"2"
						],
						"stepId": 1905102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуэй Син"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510201,
					"content": "#О, {NICKNAME}, прости, пожалуйста...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510202
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510202,
					"content": "Мы так хотели убедить тебя присоединиться к флоту, что немного переборщили... Хорошо, что капитан вмешалась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510203
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510203,
					"content": "Всё нормально. Расскажи мне о картографии, пожалуйста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510204
					]
				},
				{
					"id": 190510204,
					"content": "#О! Что ж, в таком случае ты {M#обратился}{F#обратилась} по адресу. Я самый талантливый навигатор в гавани Ли Юэ, и это не пустые слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510205
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510205,
					"content": "Я начну с того, что расскажу о некоторых необходимых навыках чтения карт для начинающих моряков. Не стесняйся задавать вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510206
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510206,
					"content": "Например, сперва поговорим о том, на что смотреть, когда перед тобой сложные морские навигационные карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510207
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510207,
					"content": "Во-первых, сразу обрати внимание на обозначенные береговые линии, острова или рифы, рельеф морского дна, гидрологические элементы и другие объекты, которые могут представлять опасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510208
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510208,
					"content": "Удерживая всё это в голове, ты сможешь ответить на основной вопрос: «Могу ли я проложить безопасный курс через эту область?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510209
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510209,
					"content": "Визуально навигационные карты отличаются от карт суши. Большинство карт не имеет фиксированного масштаба, то есть может быть сложно определить точное расстояние между двумя точками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510210
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510210,
					"content": "К самым продвинутым морским картам прилагается дополнительная карта, на которой нанесены разноцветные линии для обозначения расстояний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510211
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510211,
					"content": "Стоит упомянуть, что поскольку я тут навигатор, то Южный Крест использует только продвинутые навигационные карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510212
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510212,
					"content": "Некоторые картографы отмечают на своих картах другие ориентиры, как правило, с помощью собственных специальных символов. Если они не оставляют никаких сопроводительных примечаний, то такие элементы может быть очень трудно интерпретировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510213
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510213,
					"content": "Например, если карта досталась от предыдущего навигатора?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510214
					]
				},
				{
					"id": 190510214,
					"content": "Ха-ха, не только в этом случае. Порой мы случайно находим потрёпанные и порванные карты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510215
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510215,
					"content": "Если честно, даже для меня это может быть непросто. Некоторые из этих карт очень старые, и на них есть символы, которые мне незнакомы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510216
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510216,
					"content": "Но если мы их не расшифруем, то наверняка упустим многие тайны моря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510217
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510217,
					"content": "К счастью, у нас хороший капитан. Ей удалось найти несколько старинных книг по семиотике, которые я могу использовать для изучения карт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510218
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510218,
					"content": "Я не думаю, что кто-то, кроме нашего капитана, в силах найти такое. Старые карты и древние книги по семиотике - это не то, что продаётся на любом рынке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510219
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510219,
					"content": "Ой, случайно отклонились от темы, хе-хе. Мы обсудили основные принципы чтения карт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510220,
					"content": "Хочешь ещё о чём-то спросить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510221,
						190510236
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510221,
					"content": "А ты умеешь составлять морские карты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510222
					]
				},
				{
					"id": 190510222,
					"content": "Составлять? Это намного сложнее. Если честно, у меня есть лишь некоторые знания в этой области.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510223
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510223,
					"content": "Карты, которыми мы сейчас пользуемся, - это просто отредактированные версии тех, что оставил предыдущий навигатор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510224
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510224,
					"content": "Так что мой опыт картографирования в основном ограничивался корректировкой наших карт, чтобы отразить изменения, происходящие в море.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510225
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510225,
					"content": "Думаю, о картографии ты можешь спросить капитана Бэй Доу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510226
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510226,
					"content": "Однажды флот по ошибке вошёл на неизведанную территорию. Вскоре мы развернулись и вернулись тем же путём, которым шли до этого, опасаясь возможных опасностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510227
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510227,
					"content": "Но капитану Бэй Доу удалось нарисовать простую карту местности, через которую мы проплыли, на случай, если вдруг мы снова окажемся там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510228
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510228,
					"content": "Невероятно, правда? Здорово, что наш капитан и карты составлять умеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510229
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510229,
					"content": "Тогда зачем ей ты?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510230
					]
				},
				{
					"id": 190510230,
					"content": "Затем что у меня есть талант, и она не хочет, чтобы он пропал зря. Хе-хе. У неё такое отношение ко всей команде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510231
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510231,
					"content": "У меня изначально тоже возник такой вопрос. Ведь во многих флотах капитан сам выполняет роль навигатора. Я не могла понять в то время, что ею движет, поэтому спросила прямо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510232
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510232,
					"content": "Она улыбнулась и посоветовала мне хорошенько подумать, сказав, что даже Властелин Камня никогда не сражается в одиночку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510233
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510233,
					"content": "Она хочет, чтобы все на борту хорошо выполняли свою работу, чтобы Южный Крест не зависел от неё одной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510234
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510234,
					"content": "Таким образом, если когда-нибудь наступит день, когда она уйдёт с флота, мы сможем плыть дальше без неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510235
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510235,
					"content": "Капитан Бэй Доу может казаться отчуждённой и иногда даже легкомысленной, но правда в том, что она очень внимательна ко всем на борту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "Хуэй Син"
				},
				{
					"id": 190510236,
					"content": "Теперь я знаю всё, что меня интересовало. Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510237
					]
				},
				{
					"id": 190510237,
					"content": "Всегда пожалуйста. Друг капитана Бэй Доу - мой друг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуэй Син"
				}
			]
		},
		{
			"id": 1905103,
			"completionStepIds": [
				1905103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905103",
							"2"
						],
						"stepId": 1905103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сюй Люши"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510301,
					"content": "#Привет, путешественни{F#ца}{M#к}. Хочешь изучить морскую метеорологию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510302
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510302,
					"content": "Погоди, откуда ты это знаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510303
					]
				},
				{
					"id": 190510303,
					"content": "Ха-ха, в моей работе без зоркости и проницательности никуда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510304
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510304,
					"content": "Я видел, как капитан показывала тебе тренировку новичков, а затем у тебя было обучение у Инь Син и Хуэй Син.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510305
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510305,
					"content": "Значит, она хочет показать тебе, какова жизнь члена экипажа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510306,
						190510307
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510306,
					"content": "У тебя настоящий талант к работе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				},
				{
					"id": 190510308,
					"content": "Хе-хе! Хорошо, приступим. Сначала я расскажу об основах метеорологии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510309
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510309,
					"content": "Морская метеорология в основном означает наблюдение за погодой, а также за другими океаническими явлениями, такими как морской туман, штормовые нагоны, водяные смерчи и так далее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510310
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510310,
					"content": "Всё это потенциальные угрозы для безопасного судоходства. К счастью, какая бы погода ни ждала нас в будущем, всегда есть какой-то знак, сообщающий об этом заранее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510311
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510311,
					"content": "Возьмём, к примеру, водяные смерчи. Это воронкообразный вихрь воздуха и воды, образующийся над поверхностью большого водоёма. Они могут затягивать большие корабли и наносить огромный урон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510312
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510312,
					"content": "Но если ты знаешь, что водяные смерчи могут образовываться только при высокой температуре, повышенной влажности и сильной облачности, тогда тебя не застать врасплох.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510313
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510313,
					"content": "А также ты будешь начеку, если знаешь, что наличие ветров, дующих в противоположных направлениях со значительной разницей в скорости, является прямым предвестником образования водяных смерчей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510314
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510314,
					"content": "И самое главное, если замечаешь небольшую белую воронку в облаках, то следует немедленно уведомить экипаж, чтобы они обошли это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510315
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510315,
					"content": "Это признак смерча. Я с гордостью могу сказать, что за эти годы я ни разу не пропустил этих примет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510316,
						190510324
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510316,
					"content": "У тебя, должно быть, отличное зрение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510317
					]
				},
				{
					"id": 190510317,
					"content": "Что ж, я хорошо понимаю море, но не так хорошо, как капитан, разбираюсь в людях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510318
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510318,
					"content": "Знаешь небольшую рыбацкую деревню рядом с постоялым двором «Ваншу»? Говорят, что капитан в детстве работала там, рыбача вместе со взрослыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510319
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510319,
					"content": "Позже она отправилась в гавань в поисках лучших заработков. Хех, умение выжить в такой среде в детском возрасте является убедительным доказательством способностей капитана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510320
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510320,
					"content": "Если бы не она, мне бы не удалось попасть на эту работу. Она вселила в меня уверенность и сказала, что я справлюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510321
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510321,
					"content": "Возможно, ты не знаешь, но вне Южного Креста меня в основном знают из-за скандала в ресторане «Три чашки в порту»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510322
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510322,
					"content": "Кто бы мог подумать, что моряк-новичок, упавший пьяным в море и ставший посмешищем для своих теперь уже бывших товарищей по команде, впоследствии сможет стать дозорным Южного Креста? Но это правда, как бы ни была она невероятна, ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510323
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510323,
					"content": "Это доказывает, что одних навыков недостаточно. Нужно, чтобы встретился такой человек, как капитан, который хорошо разбирается в людях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510332,
					"content": "Спасибо за уделённое время. Думаю, теперь я знаю всё, что нужно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510333
					]
				},
				{
					"id": 190510333,
					"content": "Обращайся в любое время, если возникнут вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510324,
					"content": "Похоже, у тебя большой опыт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510325
					]
				},
				{
					"id": 190510325,
					"content": "Честно говоря, почти всему, что знаю, меня научила капитан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510326
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510326,
					"content": "Всё о метеорологии, что мы только что обсудили... Она настоящий эксперт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510327
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510327,
					"content": "Знаешь небольшую рыбацкую деревню рядом с гостиницей Ваншу? Говорят, что капитан в детстве работала там, ловя рыбу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510328
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510328,
					"content": "Позже она отправилась в гавань в поисках лучших заработков. Она выросла в такой среде, поэтому неудивительно, что знает о море всё, что только можно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510329
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510329,
					"content": "Когда я впервые попал на борт, каждый день меня одолевали сомнения в выборе профессии, не пустая ли это трата времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510330
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510330,
					"content": "Но по мере обучения и получения опыта я наконец понял, почему Южный Крест такой замечательный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510331
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510331,
					"content": "В конце концов, не каждым флотом руководит Владычица Морей. Мне повезло, что я часть команды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "Сюй Люши"
				},
				{
					"id": 190510307,
					"content": "Похоже, Бэй Доу нашла подходящего человека для этой работы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				}
			]
		},
