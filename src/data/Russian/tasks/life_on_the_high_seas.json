	"talks": [
		{
			"id": 1905101,
			"completionStepIds": [
				1905101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
