				]
			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Так... правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540302,
					"content": "Нужно подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540303,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540304,
					"content": "Луны... Луны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540305,
					"content": "Может, вот так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540306,
					"content": "Похоже, в этом раунде я выиграла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540307,
					"content": "Мои три Луны соединились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540308,
					"content": "Да, победа за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540309,
					"content": "Луны растут и убывают в бесконечном цикле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540310,
					"content": "Похоже, наши с тобой Луны не хотят затмеваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540311,
					"content": "Мы приближаемся к ничьей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540312,
					"content": "Оказывается, ты тщательно всё взвешиваешь, прежде чем принять решение. Не торопись, время есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540313,
					"content": "#Ты забыл{F#а}, как размещать Луны на ночном небе? Помочь тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540314,
					"content": "Тебе не нравится эта игра? Хм... Мне она кажется довольно забавной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540315,
					"content": "Мм? Ты на меня глазеешь? Я чувствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540316,
					"content": "Ты глазеешь... Правда о Лунах написана на моём лице?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540317,
					"content": "Доска там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540318,
					"content": "Хм, твои Луны сошлись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540319,
					"content": "Ночное небо принадлежит тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540320,
					"content": "Ах... Я... где-то промахнулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540321,
					"content": "Вы приятно проводите время за игрой...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Спасибо, мне очень понравилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540323,
					"content": "Если хочешь... приходи в любое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 760540324,
					"content": "Считай это доказательством того, что мы дали друг другу обещание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		}
	]
}