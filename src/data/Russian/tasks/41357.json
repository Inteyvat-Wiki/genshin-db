			"dialogs": [
				{
					"id": 413570602,
					"content": "#Ого, я ещё не видел, чтобы кто-то сложил картинку так быстро! Ты очень, очень хорош{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570603
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413570603,
					"content": "Рассмотри узор, который у тебя получился. Все ведущие к сокровищам подсказки ты найдёшь в нём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
