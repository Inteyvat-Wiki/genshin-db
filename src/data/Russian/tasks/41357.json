			},
			"dialogs": [
				{
					"id": 413570301,
					"content": "Ну как идёт поиск сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413570302,
					"content": "#Я уже их все наш{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "Все до единого? Выходит, у тебя талант к поиску сокровищ. Многие даже повернуть фонари не могут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Малыш Цянь"
				},
				{
					"id": 413570304,
					"content": "#Раз уж ты отыскал{F#а} все сокровища, то вот твоя награда. Весёлого Праздника морских фонарей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Цянь"
				}
			]
		},
