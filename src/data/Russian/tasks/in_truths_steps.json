					"Бахар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "#Доброго дня, {M#путешественник}{F#путешественница}. Поучаствуешь в Празднике мудрости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960102,
					"content": "Хочешь присоединиться к мероприятию, которое организует Хараватат?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960103,
					"content": "Насколько я помню, Хараватат изучает...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "«Языки», если говорить в общем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960105,
					"content": "Именно это мы исследуем здесь, в Хараватате.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960106,
					"content": "Ну что? Думаете, это не подходит для создания радостной и непринуждённой атмосферы праздника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960107,
					"content": "Многие из моих коллег по даршану тоже так думают. Все веселятся от души, так что, конечно, мы не будем портить настроение, загадывая всем загадки. Верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960108,
					"content": "Размышлять над загадками далеко не всем интересно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960109,
					"content": "После долгих... дружеских обсуждений мы остановились на мини-игре «В поисках правды».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960110,
					"content": "Не требуется ничего особенного. Только спокойный ум и ясные мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960111,
					"content": "Когда начнётся игра, я расскажу историю. Может показаться, что эта история не имеет ни нормального начала, ни конца, а некоторые её части могут противоречить здравому смыслу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960112,
					"content": "Задавай вопросы. Я буду отвечать. Возможны только три типа ответов: <color=#00E1FFFF>«Да»</color>, <color=#00E1FFFF>«Нет» </color>, <color=#00E1FFFF>«Не имеет отношения к истории»</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960113,
					"content": "Задавай вопросы, чтобы узнать правду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960114,
					"content": "Не переживай. Выяснить правильную историю не так уж сложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960115,
					"content": "Так что? Если интересно, мы можем начать прямо сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960116,
					"content": "Давай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "Отлично! Слушай внимательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бахар"
				},
				{
					"id": 736960118,
					"content": "Мне пока некогда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "Ничего страшного. Я буду здесь. Возвращайся, когда захочешь попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бахар"
				}
			]
		}
	]
}