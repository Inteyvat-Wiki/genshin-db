			"dialogs": [
				{
					"id": 401460801,
					"content": "Со временем ваш бизнес станет ещё больше. А это значит, что на горизонте появятся новые возможности...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401460802
					]
				},
				{
					"id": 401460802,
					"content": "Смотри, у нас гости из чужих краёв. Давай поздороваемся!",
					"roleType": "TALK_ROLE_NPC",
