							205.371,
							-1146.257
						],
						"pointId": 300300749
					},
					{
						"sceneId": 3,
						"position": [
							2506.894,
							205.371,
							-1146.261
						],
						"pointId": 300300750
					}
				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "Здравствуйте! Моё имя Атефа, я странствующая негоциантка из Сумеру. Рада с вами познакомиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460102,
					"content": "Ничего себе, какой долгий путь ты проделала! Похоже, слава о нашем магазине разошлась по всему Тейвату!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401460103,
					"content": "Всё благодаря тебе, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "Хе-хе! Паймон настоящий гений продаж! Продаст даже снег зимой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401460106,
					"content": "Ха-ха, это точно! Торговцы и негоцианты узнают всё первыми, и многие из нас уже слышали о магазине алхимических зелий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460107,
					"content": "Но большинство торговцев не рискуют заниматься столь необычным товаром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460108,
					"content": "А я считаю, что торговец не должен упускать возможности заработать. Иначе большой моры ему не видать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460109,
					"content": "Пусть обычные люди пока мало что знают об алхимических зельях, но если поработать над продвижением, вам откроется огромный рынок. И тогда мора сама потечёт в руки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460110,
					"content": "Разогнав спрос, вы сможете увеличить цены хоть в десять раз... Хе-хе, с такой прибылью и до конца года не придётся работать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460111,
					"content": "В десять раз! Ты серьёзно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401460112,
					"content": "Ха-ха, если спрос на продукт высокий, люди заплатят любую цену. Можно назвать это своеобразным соглашением между покупателем и продавцом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460113,
					"content": "Твои рассуждения напомнили Паймон о другой негоциантке, помешанной на море...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401460114,
					"content": "Подожди, ты ведь из Сумеру? Наверное, вы знакомы. Ты знаешь Дори?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401460115,
					"content": "Дори? Ты о госпоже Сангема-бай, известнейшей негоциантке Сумеру? Вы её знаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460116,
					"content": "Она моя подруга.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "Ничего себе! Госпожа Сангема-бай мой кумир! Всегда восхищалась её деловым чутьём и преданностью море!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460119,
					"content": "Однажды мне даже довелось побывать в Алькасар-сарае. Настоящий дворец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460120,
					"content": "Я надеюсь когда-нибудь стать такой же, как госпожа Сангема-бай. Чтобы моры было больше, чем я могу сосчитать, ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460121,
					"content": "Так, мы её теряем... Как нам теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401460122,
					"content": "Пусть у тебя всё получится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "Огромное спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460126,
					"content": "К делу. Кажется, я говорила о том, что вместе мы могли бы заработать много моры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460127,
					"content": "Предложение у меня простое. Вы готовите зелья, а я забираю у вас новые партии на продажу. Так ваши зелья разойдутся по всему Тейвату!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460128,
					"content": "Если вам интересно моё предложение, можем обсудить подробности. Например, какие зелья войдут в первую партию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460129,
					"content": "Проверить запрос на зелья...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "Чутьё подсказывает, что сейчас рынку нужны следующие зелья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460131,
					"content": "Поговорим об этом позже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "Гм, ладно. Но не упустите свой шанс! Железо надо ковать, пока горячо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460124,
					"content": "Давай поговорим о деле.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "Кхм... Да, что-то я отвлеклась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Атефа"
				},
				{
					"id": 401460117,
					"content": "Встречались с ней пару раз.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Наши усилия окупились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
