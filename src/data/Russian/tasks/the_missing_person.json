					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи",
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "#Если и {F#эта путешественница}{M#этот путешественник} окажется занят{F#а}, что же мы будем делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361402,
					"content": "Это уже твои проблемы, кто просил тебя браться за такое скверное дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361403,
					"content": "Ну ты и везунчик! Смотри, твой спаситель явился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361404,
					"content": "#Правда? Путешественни{F#ца}{M#к}, как хорошо, что ты здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361405,
					"content": "#Не беспокойся, я вполне {F#свободна}{M#свободен}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "Как говорится, нет отбоя от бездельников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361407,
					"content": "Госпожа Санго!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361408,
					"content": "Если кто тут и бездельничает, то только вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361409,
					"content": "Вот и нет, у меня очень много дел. Стою здесь... Целый день стою и стою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361410,
					"content": "Если госпоже Санго не хочется браться за это поручение, она могла бы найти более убедительную отговорку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361411,
					"content": "Не хочется браться за это поручение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Да-да, поэтому я и обратился к тебе. Позволь мне всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361413,
					"content": "Недавно пропал один важный сотрудник комиссии Тэнрё. Его нигде не могут найти, на связь он не выходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361414,
					"content": "В силу разных причин комиссия Тэнрё не может развернуть масштабные поиски. Чтобы не предавать это дело огласке, его поручили нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361415,
					"content": "Этого человека зовут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361416,
					"content": "Это Кудзё Сара, генерал Кудзё пропала без вести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361417,
					"content": "Если бы генерал Кудзё в самом деле пропала без вести, комиссия перевернула бы Инадзуму вверх дном и уж точно не стала бы поручать поиски нашему скромному агентству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361418,
					"content": "#Путешественни{F#ца}{M#к}, не слушай госпожу Санго. На самом деле пропал Сиканоин Хэйдзо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361419,
					"content": "Хэйдзо - специальный детектив комиссии Тэнрё. Хотя он обычный досин, но человек весьма способный, и в комиссии на хорошем счету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361420,
					"content": "Неужели? Даже способнее меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361421,
					"content": "Госпожа Санго, если не хотите помогать, не надо. Но хотя бы не мешайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361422,
					"content": "#Извини, путешественни{F#ца}{M#к}, я взялся за это поручение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361423,
					"content": "#Но ты сам{F#а} видишь настрой госпожи Санго. Ей не хочется ввязываться в это дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361424,
					"content": "Слишком скромное вознаграждение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "Нет, мимо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361427,
					"content": "Если тебе интересна причина, я скажу. Просто я не хочу иметь никакого отношения к этому пройдохе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361428,
					"content": "Если какая новость и обрадует меня больше, чем «Сиканоин пропал», так это «Сиканоин пропал, и его ищут уже сотню лет».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361429,
					"content": "Гм... В общем, отношения между госпожой Санго и господином Хэйдзо несколько натянутые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361430,
					"content": "Понимаю... Профессиональная ревность.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "Кхм... Ты ошибаешься, всё несколько серьёзней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361432,
					"content": "Госпожа Санго считает, что господин Хэйдзо - камень преткновения на её пути к Храму истины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361433,
					"content": "Скорее надоедливый пёс!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361434,
					"content": "М-да... Характер у господина Хэйдзо и правда несколько... Гм... своеобразный? Но он совершенно точно хороший человек, он многому меня научил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361435,
					"content": "#Поэтому я не могу оставаться в стороне, пусть даже госпожа Санго против. По крайней мере, в моих силах передать это поручение надёжному человеку, например, путешественни{F#це}{M#ку}, чьи умения неисчерпаемы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361436,
					"content": "Всё ясно, я наёмная сила.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "Нет, нет! Само собой, всё вознаграждение от комиссии Тэнрё я передам тебе. Кроме того, добавлю немного и от себя лично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361439,
					"content": "Очень надеюсь, что ты согласишься взяться за это поручение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361440,
					"content": "Если господину Хэйдзо действительно угрожает опасность, уверен, ты сможешь ему помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361441,
					"content": "Вы с ним хорошо знакомы?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "На самом деле, мы всегда отлично ладили, но Санго настаивает, чтобы я держался подальше, и не хочет, чтобы кто-то узнал о нашей дружбе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361443,
					"content": "Поэтому я всегда говорю, что с господином Сиканоином едва ли знаком, и если бы не сегодняшнее происшествие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361444,
					"content": "Впрочем, об этом в другой раз. Ты поможешь мне найти его?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361449,
					"content": "Понятно, отправлюсь туда прямо сейчас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Да, кажется, теперь ты всё знаешь. Это поручение от комиссии. Если отыщешь господина Хэйдзо, отправляйся сразу в комиссию Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361445,
					"content": "Конечно, но мне нужно больше подробностей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "Отлично! Мы узнали, что незадолго до исчезновения господин Хэйдзо много интересовался островом Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361447,
					"content": "Во время войны у него было какое-то задание на Ватацуми. И после войны он постоянно туда наведывался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361448,
					"content": "Я слышал, у тебя много друзей в Сангономии. Думаю, можно начать поиски оттуда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361437,
					"content": "Всё ясно, поручениями торгуешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "Слишком мало зацепок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
