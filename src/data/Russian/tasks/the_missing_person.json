			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "#Путешественни{F#ца}{M#к}, поскорее отправляйся в дорогу. Надеюсь, господину Хэйдзо ничего не угрожает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361502,
					"content": "Расскажи мне ещё немного об этом Сиканоине Хэйдзо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "О господине Хэйдзо? Это человек удивительной энергии! Разговорчивый, весёлый, полный сил - никогда не видел его в подавленном настроении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361504,
					"content": "Санго часто повторяет, что он похож на надоедливую муху - наверное, это потому, что он безошибочно чует каждое треснувшее яйцо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361505,
					"content": "Если так, господин Хэйдзо - не просто муха, а самая первоклассная муха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361506,
					"content": "Даже если зажать ему нос, закрыть глаза, заткнуть уши, он всё равно отыщет трещину на скорлупе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361507,
					"content": "Это непостижимо, его как будто ведёт шестое чувство! Что это? Интуиция? Помощь Архонтов? Или что-то ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361508,
					"content": "Интересное сравнение, но в следующий раз постарайся обойтись без таких описаний.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "Эх, Санго всегда говорит, что я не умею формулировать мысли. Видимо, она права...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 190361510,
					"content": "Сравнения у тебя никуда не годятся, но продолжай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "Кхе-кхе... Поговорим в другой раз... Санго смотрит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				}
			]
		},
		{
			"id": 1903616,
