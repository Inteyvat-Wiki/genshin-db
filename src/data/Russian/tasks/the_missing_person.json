			"dialogs": [
				{
					"id": 190361901,
					"content": "#Ты? Ты ведь отправил{F#ась}{M#ся} на поиски этого пройдохи Сиканоина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361902
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361902,
					"content": "Расследование? Пф, зачем я буду расследовать это дурацкое дело? Просто я засиделась в городе, решила немного прогуляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361903
					],
					"speakerTitle": "Санго"
				},
				{
					"id": 190361903,
					"content": "Ладно, не отвлекаю! Иди, занимайся своими делами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
