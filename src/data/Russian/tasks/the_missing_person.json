				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "А, значит... вы командир Рыбы-меча II! Меня зовут Сибата, я охраняю это место. Чем могу вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 190361702,
					"content": "Я хочу навести справки об одном человеке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Вы рассказываете Сибате о поручении.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Тот самый сыщик? Я его знаю. Стало быть, его зовут Сиканоин Хэйдзо? Одно время он часто сюда наведывался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 190361705,
					"content": "Однажды госпожа Сангономия даже послала меня проследить за ним - опасалась, что он представляет угрозу. Но он был больше похож на обычного любителя загородных прогулок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Сибата"
				},
				{
					"id": 190361706,
					"content": "Надо подумать... Кажется, его недавно видели к востоку от Сангономии. Можете отправиться туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сибата"
				}
			]
		},
