				"points": []
			},
			"dialogs": [
				{
					"id": 4520101,
					"content": "#О, малышка Паймон и {NICKNAME}! Что я могу для вас сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520102,
					"content": "Приветики, Эмбер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520103,
					"content": "Эмбер, я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "Эмбер, ты знаешь чудаковатого мальчика со стаей волков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520105,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520106,
					"content": "Тот, который дружит с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520107,
					"content": "О чём ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520108,
					"content": "Странно. Он сказал, что будет ждать вас там же, где и раньше. Ты точно не помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520109,
					"content": "Я точно не помню. Малышка Паймон, ты случайно не ела магические грибы мацутакэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520110,
					"content": "Я не имею ни малейшего понятия, о чём ты говоришь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520111,
					"content": "Грибы... напомни, какого они цвета?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520112,
					"content": "Фиолетовые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520113,
					"content": "Кажется, ела пару дней назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520114,
					"content": "Но это не важно! Это была не галлюцинация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520115,
					"content": "Чудик, который живёт с волками. Ты точно его не знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520116,
					"content": "Клянусь, я не знаю, о чём ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520117,
					"content": "Но я веду одно дело, связанное с волками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520118,
					"content": "Раньше волки не покидали пределы Вольфендома. Но в последнее время они стали смелее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520119,
					"content": "Недавно они атаковали караван недалеко от Ущелья Пьяницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520120,
					"content": "Если у тебя есть время, поможешь мне с расследованием?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520121,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "Здорово! Я знала, что на тебя можно положиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520122,
					"content": "Давай займёмся этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "Привет, Эмбер! Как поживаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "Хм... Похоже, тебе особенно нечем заняться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520126,
					"content": "Обычно после этой фразы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520127,
					"content": "У меня очень много дел. Скауты никогда не отдыхают! Хочешь помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520129,
					"content": "Как и ожидалось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520130,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "Волки атакуют караваны у Ущелья Пьяницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520133,
					"content": "Волки очень опасны, но они живут по своим правилам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520134,
					"content": "Мондштадтские волки обычно не выходят за пределы Вольфендома или гор Светлой короны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520135,
					"content": "Я слышала, что в этих местах властвуют законы дикой природы. Люди редко там бывают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520136,
					"content": "Всё верно. Для волков очень необычно охотиться в районе Ущелья пьяницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520137,
					"content": "К слову, ты знаешь странного парня из Вольфендома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520138,
					"content": "Не знаю. О ком ты говоришь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520139,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520140,
					"content": "Красная девушка. Разве это не ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520141,
					"content": "Красная девушка? О чём ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520142,
					"content": "Я направляюсь к Ущелью Пьяницы прямо сейчас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520143,
					"content": "Ты со мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520131,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
		{
