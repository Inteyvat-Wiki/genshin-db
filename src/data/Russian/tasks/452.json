				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520201,
					"content": "Смотри! Там что-то происходит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520202,
					"content": "Это не волки... Оказывается, хиличурлы грабили караваны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520203,
					"content": "Хм. Неудивительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520204,
					"content": "Хватит болтать. Давай поможем им!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		},
		{
			"id": 45203,
			"completionStepIds": [
				45205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45205",
							"2"
						],
						"stepId": 45205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Зигфрия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "С... спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 4520302,
					"content": "Это было несложно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 4520303,
					"content": "Хиличурлы воспользовались паникой, вызванной атаками волков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520304,
					"content": "Да, они в последнее время расхрабрились. Но как по мне, волки ведут себя ещё хуже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 4520305,
					"content": "Они... напали на Спрингвейл этим утром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 4520306,
					"content": "Спрингвейл? Это безумие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520307,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 4520308,
					"content": "Я думала, что успею проехать по дороге после атаки волков. Никак не ожидала наткнуться на хиличурлов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "Зигфрия"
				},
				{
					"id": 4520309,
					"content": "Отправляемся в Спрингвейл как можно скорей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520310,
					"content": "Твоя телега в порядке? Ты сможешь добраться до города?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 4520311,
					"content": "Всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Зигфрия"
				}
			]
		},
