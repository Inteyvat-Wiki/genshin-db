			"dialogs": [
				{
					"id": 221130201,
					"content": "#Ты прин{F#есла}{M#ёс} доски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130202
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221130202,
					"content": "Ещё нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "Поторопись, пожалуйста. Я хочу поскорее починить эту лестницу. У меня ещё много других дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
