				"points": []
			},
			"dialogs": [
				{
					"id": 221130501,
					"content": "Готово! Теперь лестница в порядке. По-моему, выглядит неплохо. Что скажешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221130502,
					"content": "Надеюсь, что она достаточно прочная, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221130503,
					"content": "Вот твоя награда. Ещё раз большое спасибо за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221130504,
					"content": "Заглядывай к нам, когда будет время, выпьешь чаю, отведаешь вкусной кухни. Наш шеф-повар неплохо готовит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		}
