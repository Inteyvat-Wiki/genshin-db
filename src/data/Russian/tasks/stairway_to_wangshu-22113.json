			"dialogs": [
				{
					"id": 221130301,
					"content": "#Ты прин{F#есла}{M#ёс} доски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221130302,
					"content": "Да. Вот они.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Отлично! От этих монстров одни только проблемы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Хуай Ань"
				},
				{
					"id": 221130304,
					"content": "Этого хватит, спасибо! Пора браться за работу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хуай Ань"
				}
			]
		},
		{
			"id": 2211305,
			"completionStepIds": [
