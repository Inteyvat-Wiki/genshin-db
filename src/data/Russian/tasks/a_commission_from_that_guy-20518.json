				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "#Ты так быстро справил{F#ась}{M#ся}? Впечатляет. Теперь понятно, почему ты тому господину так нравишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180202,
					"content": "Где деньги?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "А ты всё-таки бука. Награда твоя здесь. Но ты и меня пойми, я человек подневольный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180204,
					"content": "Я ценю твою доброту.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "Взаимно. Вот, забери награду. И ещё... С тобой приятно работать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хоффман"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Ну и прячьтесь себе, Похитители сокровищ! На глаза мне не попадайтесь, не то... Да куда же вы все подевались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 205180302,
					"content": "Я знаю, где они прячутся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Вы? Откуда у вас... Кто сделал такие подробные отметки на вашей карте? Вэл? Вот это поворот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 205180304,
					"content": "Это очень далёко от места, которое мы обнаружили ранее. Чего добиваются эти Похитители сокровищ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 205180305,
					"content": "Пожалуйста, позволь мне их переписать... Готово. Я отправлю людей проверить эти места. Если там и правда окажутся Похитители сокровищ, мы отправимся туда и перебьём их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 205180306,
					"content": "Ещё раз благодарю тебя за твой подвиг во имя Мондштадта! На этот раз ни один Похититель сокровищ не уйдёт от нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "#Ты так быстро справил{F#ась}{M#ся}? Впечатляет. Теперь понятно, почему тот господин предпочитает доверять дела именно тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180402,
					"content": "Теперь этим занимаются рыцари Ордо Фавониус.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "Эй, разве я не говорила, что если они возьмутся за это дело, то от них могут быть неприятности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180404,
					"content": "А ты умеешь перекладывать свою работу на других. К счастью, тот господин учёл и такой ход событий, поэтому у меня готов запасной план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180405,
					"content": "Об остальном не беспокойся. Эх, а сейчас мне нужно пойти и кое-что уладить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180406,
					"content": "Но, по словам того господина, твои действия могут привести к любопытным последствиям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180407,
					"content": "В конце концов, было бы слишком очевидным, если бы о передвижениях Похитителей сокровищ донесла я. А господину тому иметь дело непосредственно с рыцарями не с руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180408,
					"content": "Это тебе. Пожалуйста, прими эту, как выразился тот господин, небольшую награду за перемену течения ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051802",
							"2"
						],
						"stepId": 2051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051803",
							"2"
						],
						"stepId": 2051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вэл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "#Всё ещё готовишься? Ладно. Выдвигайся, как только будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180502,
					"content": "Кто всё-таки этот господин такой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "Сказать я тебе этого не могу, как ты меня ни расспрашивай. Таковы реалии нашей работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180504,
					"content": "Если даже мы какие-либо из сведений и раскрываем, так только потому, что это нужно нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180505,
					"content": "Вот, пораскинь мозгами: что из сказанного мною ранее подходит под эту категорию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180506,
					"content": "Какова ваша цель?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
					"content": "Цель... Чего добивается тот господин, я разгадать не смогла. Но наверняка он тоже желает защитить Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180508
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180508,
					"content": "Скажем так... В столь важных делах он согласно своему увлечению действовать не станет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180509
					],
					"speakerTitle": "Вэл"
				},
				{
					"id": 205180509,
					"content": "Так, стоп. Мне и задумываться о таком не стоит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вэл"
				}
			]
		},
