			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чивень"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1439.465,
							64.598,
							8237.596
						],
						"pointId": 350100078
					}
				]
			},
			"dialogs": [
				{
					"id": 150120701,
					"content": "Почему она больше не делает «старые имена»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120702
					]
				},
				{
					"id": 150120702,
					"content": "...Из-за дочери. Бедная Нечка тяжело болела, и Тласоли почти бросила всё ради того, чтобы заботиться о ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120703
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120703,
					"content": "Когда болезнь Нечки достигла своего пика, Тласоли была подобна факелу, брошенному в болото: он горел ярко и отчаянно, даже когда грязь подступала всё ближе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120704
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120704,
					"content": "Но всё обошлось! Благодаря лекарству доктора и покровительству Вайоб, Нечка снова ожила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120705
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120705,
					"content": "С тех пор Нечке становится всё лучше. Ей ещё нездоровится, она сидит дома и мало двигается, но ей уже хватает сил, чтобы писать письма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120706
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120706,
					"content": "Я слышала, что она часто пишет Шилонен. Она даже мечтает стать ремесленницей, которая может выковать древние имена, как её мать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120707
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120707,
					"content": "Через несколько дней Нечка отмечает свой день рождения. Тласоли попросила меня помочь ей найти чистый вулканический кристалл в подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120708,
						150120709
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120708,
					"content": "Поэтому ты пришла сюда, чтобы добыть руду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				},
				{
					"id": 150120710,
					"content": "Это действительно важная руда. С такой красивой вещью Нечка быстро выздоровеет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120711
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150120711,
					"content": "Спасибо за добрые слова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120712
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120712,
					"content": "Нам пора возвращаться, иначе Имиш будет очень волноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120713
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120713,
					"content": "Да, если хочешь, мы сможем навестить Тласоли вместе завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120714
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120714,
					"content": "Благодаря твоей помощи бандиты не смогли забрать этот кристалл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120715
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120715,
					"content": "#Ты защитил{F#а} этот важный кристалл, и теперь заслуживаешь подарка взамен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120716
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120716,
					"content": "Надеюсь, это обрадует Нечку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120717
					]
				},
				{
					"id": 150120717,
					"content": "Да. Если быть в хорошем настроении, то и от болезни вылечишься быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120718
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150120718,
					"content": "Конечно, а ещё... Мы были бы счастливы получить от тебя какой-нибудь подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150120719,
					"content": "Ха-ха-ха, не переживайте. Вам понравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120720
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120720,
					"content": "А вот что это будет... Узнаете завтра, когда Тласоли наконец расскажет вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120709,
					"content": "Неудивительно, что ты не хочешь выкидывать этот кристалл.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				}
			]
		},
