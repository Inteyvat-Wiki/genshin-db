			"dialogs": [
				{
					"id": 150120401,
					"content": "Ну, они точно были решительными, принимая решение о том, чтобы сбежать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150120402,
					"content": "Это называется «ситуационная проницательность».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Фух... Спасибо. Если бы не ваша помощь, меня бы сбросили вниз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120405,
					"content": "#Спасена {M#проходившим мимо путешественником}{F#проходившей мимо путешественницей}... Сегодня удача на моей стороне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120406,
					"content": "Простите, забыла представиться. Меня зовут Чивень. Я обычный ювелир, обычно неудачливый, за исключением сегодняшнего дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120407,
					"content": "Нас прислала Имиш.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Эта девочка... Эх, я снова заставила её поволноваться. Я не думала, что буду отсутствовать дольше двух дней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120409,
					"content": "Но обнаружился новый пласт вулканических кристаллов недалеко от Теневой иглы... Особой чистоты и в значительном количестве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120410,
					"content": "Я нашла много прекрасных кристаллов и уже собралась идти обратно, но флогистон внутри кристаллов привлёк монстров...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150120403,
					"content": "У славы есть свои плюсы, я думаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
