			"dialogs": [
				{
					"id": 150120101,
					"content": "Ещё не вернулась... Неужели с мастером Чивень что-то произошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120102,
					"content": "Почему ребёнок плачет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150120103,
					"content": "#{NICKNAME}, давай посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150120104,
					"content": "Что случилось, малышка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "Да... Мастер Чивень... она...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120106,
					"content": "О-она сказала, что пойдёт туда и соберёт вулканические кристаллы... Но она до сих пор не вернулась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120107,
					"content": "Я рассказала стражникам, но они говорят, что сейчас не хватает людей. Кроме того, там очень опасно, там живут монстры и плохие дяди...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120108,
					"content": "Они должны подготовиться, прежде чем отправляться на поиски... Но к тому времени будет уже слишком поздно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120109,
					"content": "Не переживай, мы разберёмся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "Ты поможешь? Замечательно! Я отмечу на карте места, где стражники уже были.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120112,
					"content": "Они сказали, что мастер Чивень может быть здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120113,
					"content": "Возможно, её вынудили пойти к Теневой игле. Если это так... Тогда... *всхлипывает*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120114,
					"content": "#Прошу, {NICKNAME}, помоги спасти мастера Чивень!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Имиш"
				},
				{
					"id": 150120110,
					"content": "Нам снова придётся побыть героями.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
