			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726680101,
					"content": "Как здорово. Получается, что желания всех, кто охотился на Лунного левиафана, исполнились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680102,
					"content": "Как так?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Ну смотри, Цзя Вэй ведь нашёл богатую жену?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680104,
					"content": "А Нантак стал известным автором, благодаря книге, разоблачающей Лунного левиафана. Хотя он и ошибся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680105,
					"content": "Кудзирай Момидзи стала самым известным рыбаком в Инадзуме, а сегодня даже сделала то, что не удалось её отцу - поймала Лунного левиафана!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680106,
					"content": "Поэтому Паймон думает, что твоё желание тоже обязательно исполнится! Хи-хи-хи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680107,
					"content": "Паймон, а ты что загадала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Не скажу! Не скажу! Если сказать, то не исполнится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680109,
					"content": "Вряд ли Лунный левиафан такой мелочный.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Хм... Ладно! Слушай внимательно, Паймон скажет один раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680111,
					"content": "Желание Паймон - чтобы исполнилось твоё желание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 726680112,
					"content": "Слишком тихо! Что ты сказала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Пф! Паймон не станет повторять! Паймон пойдёт купит конфеток... Ла-ла-ла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}