					{
						"sceneId": 48000,
						"position": [
							43.884,
							0.49,
							41.953
						],
						"pointId": 11
					}
				]
			},
			"dialogs": [
				{
					"id": 706800101,
					"content": "Проходите, гости дорогие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800102
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800102,
					"content": "У меня для вас хорошие новости! Это заняло немного дольше, чем планировалось, но... новая сцена уже готова!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800103
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800103,
					"content": "Тот, кто устроит грандиозное представление - получит ключ, открывающий дверь в нарисованный мир...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800104
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800104,
					"content": "Постой-ка минутку! Кроме книги сказок, есть ещё нарисованный мир?! Тут всё так странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706800105,
					"content": "Понимаю. В книге сказок мне встретилась такая фраза: «Фокусник, раскрывающий свои секреты зрителям, лишает их сюрприза».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800106
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800106,
					"content": "Так что растерянность - самое подходящее чувство! О магии госпожи мага, как и о любви, не нужно задумываться, её нужно чувствовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800107
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800107,
					"content": "Хотя в твоих словах есть смысл... Но, опять же, в чём разница между предыдущей сценой и сценой в нарисованном мире?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706800108,
					"content": "Нарисованный мир - это мир с множеством правил. Новая сцена станет хорошей проверкой дружбы и доверия. Это частая тема для историй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800109
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800109,
					"content": "А тот, кто выдержит проверку, получит небольшое благословение от госпожи мага...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800110
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800110,
					"content": "Ого! Как насчёт какого-нибудь заклинания на удачу? Например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800111,
						706800112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706800111,
					"content": "Не стоит загадывать необдуманные желания...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				},
				{
					"id": 706800113,
					"content": "Гм... Паймон согласна, лучше обойтись без необдуманных желаний...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 706800114,
					"content": "Не переживайте! Краски уже легли на холст, и небольшое благословение госпожи мага больше не является секретом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800115
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800115,
					"content": "Если вы готовы, можете сами взглянуть на сцену нарисованного мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800116
					],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800116,
					"content": "Это как в сказке перед началом нового приключения: «Насвистывая весёлую мелодию, оставьте все заботы позади, и пусть храбрость исходит из сердца».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Волчонок"
				},
				{
					"id": 706800112,
					"content": "Вряд ли. Кроме того...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				}
			]
		}
	]
}