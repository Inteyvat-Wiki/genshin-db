	"talks": [
		{
			"id": 1201401,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201401",
							"2"
						],
						"stepId": 1201401,
						"stateName": "QUEST_STATE_UNFINISHED"
