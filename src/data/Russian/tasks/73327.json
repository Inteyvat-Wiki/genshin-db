				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джехт"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}?! Это ты... это ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270102,
					"content": "И Паймон! Не ожидала вас здесь увидеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270103,
					"content": "Джехт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733270104,
					"content": "Ха-ха, потише, не то рыбу распугаете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270105,
					"content": "Бип-бип!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733270106,
					"content": "Рыбачите? А почему без удочки?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733270107,
					"content": "Бип...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733270108,
					"content": "#Бенбен, не говори глупостей! Ладно... {NICKNAME}, давай поговорим о чём-нибудь другом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270109,
					"content": "Где твоя удочка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "Ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270111,
					"content": "Сломалась... хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270112,
					"content": "Увы... Я не ожидала, что рыбалка и охота - такие разные занятия... так тяжело, так тяжело! У меня просто нет терпения сидеть здесь часами и ждать рыбу... Да мне проще войти в реку и самой руками поймать её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270113,
					"content": "Не поймали рыбку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733270114,
					"content": "Хм, конечно, поймали. Здоровая рыбина, длиннее тебя... гм, как ты да ещё пол-Бенбена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270115,
					"content": "Бип-бип! Бип-бип!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733270116,
					"content": "Уже пожарила и всё съела. Прости, нечем тебя угостить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270117,
					"content": "Бип-бип?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733270118,
					"content": "Ну и Бенбен тоже съел, только тебе ничего не осталось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270119,
					"content": "Не верится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733270120,
					"content": "Ха-ха-ха-ха! Не веришь - твои проблемы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270125,
					"content": "Как у тебя дела?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "Эм? Всё в порядке, не волнуйся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270127,
					"content": "Я уже не первый раз путешествую в одиночку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270128,
					"content": "Бип-бип! Бип-бип!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733270129,
					"content": "Ха-ха-ха, не волнуйся! Конечно, ты ещё со мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270130,
					"content": "После инцидента с Танитом племена пустыни больше меня не привечают... Я больше не под защитой племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270131,
					"content": "Впоследствии... Хотя Рукх-шах из Бригады тридцати был готов принять меня, но... в городе мне не по себе, и он напоминает мне о маме... кхм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270132,
					"content": "Так что я покинула город Сумеру, думая... надо отправиться в другое королевство, полюбоваться незнакомыми пейзажами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270133,
					"content": "Так что я села на торговый корабль и неожиданно для самой себя оказалась здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270134,
					"content": "А потом... Ха-ха, не о чем говорить! Телохранители везде нужны, тем более в таком большом городе, через который постоянно проходят караваны! Так что у меня всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270135,
					"content": "Хе-хе, вот так... Повсюду чувствую себя как дома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270136,
					"content": "Я и Бенбен прямо как ты и Паймон, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270137,
					"content": "Хм, Бенбен не может сравниться с Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733270138,
					"content": "Бип-бип!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Бенбен"
				},
				{
					"id": 733270139,
					"content": "#Ха-ха-ха, хорошо, хорошо... {NICKNAME}, я больше не буду вас задерживать. Сперва я хотела пригласить вас вместе пообедать, но правила охранного предприятия... увы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270140,
					"content": "Кхе-кхе! Ну, не будем о грустном! Крепко обнимаю и желаю вам безопасного путешествия!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270141,
					"content": "#{M# Не забывай, наши пути ещё пересекутся!}{F#... Помни, что я говорила тебе о Таните. Когда ты устанешь и захочешь отдохнуть... Может, мы ещё встретимся.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270121,
					"content": "Не верится, что мы тебя здесь встретили.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Хм... И я не ожидала встретить вас здесь. Очень рада.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Джехт"
				},
				{
					"id": 733270123,
					"content": "Ммм, мы же не помешали твоей рыбалке-поймалке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733270124,
					"content": "Хватит, Паймон! Следи за своим языком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Джехт"
				}
			]
		},
		{
