				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нин Гуан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Я собрала вас всех сегодня, чтобы сделать важное объявление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090102,
					"content": "Некоторые из вас наверняка слышали, что я намереваюсь восстановить Нефритовый дворец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090103,
					"content": "Восстановить Нефритовый дворец? Это непростая задача...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Хун Фэй"
				},
				{
					"id": 110090104,
					"content": "Значит, слухи были правдивы. Вот почему цены на строительные материалы так сильно выросли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Чан Гуй"
				},
				{
					"id": 110090105,
					"content": "Нефритовый дворец имеет особое значение для Нин Гуан. Если бы я мог воспользоваться этой возможностью...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Чжи Чэн"
				},
				{
					"id": 110090106,
					"content": "Госпожа Нин Гуан, чем мы можем быть полезны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Хун Фэй"
				},
				{
					"id": 110090107,
					"content": "С тех пор как эта новость начала распространяться, всего за несколько дней многие высказали желание присоединиться к проекту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090108,
					"content": "В настоящее время у меня для вас есть несколько поручений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090109,
					"content": "Мы выбрали место для строительства и подготовили необходимые материалы. Осталось найти три ключевых компонента.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090110,
					"content": "Плаустрит зари, Ядро чудес и Талисман Адептов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090111,
					"content": "Эм... прошу прощения, госпожа Нин Гуан, но два других компонента помимо плаустрита мне неизвестны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Чан Гуй"
				},
				{
					"id": 110090112,
					"content": "Лишь достаточно крупные куски плаустрита могут называться плаустритом зари. Именно этот камень и позволит Нефритовому дворцу подняться в небо. Ядро чудес - основной компонент механизма дворца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090113,
					"content": "Талисманы Адептов же служат для объединения механизмов с искусствами Адептов и в равной степени незаменимы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090114,
					"content": "Хотя все три компонента весьма редки, я убеждена, что с вашими связями и возможностями их обнаружение - это лишь вопрос времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090115,
					"content": "Я отношусь к поговорке «Время - деньги» серьёзнее, чем кто бы то ни было. Эффективность решает всё. Я дам хорошую цену за эти материалы. Кроме того, первые три человека, которые их соберут, получат возможность задать мне вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090116,
					"content": "Я отвечу на любой вопрос. Уверена, что подобное вознаграждение всем придётся по душе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090117,
					"content": "Эти компоненты трудно найти, но было бы неплохо узнать планы Ли Юэ на следующий год...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Чан Гуй"
				},
				{
					"id": 110090118,
					"content": "Это выгодная сделка. Тот, кто сумеет получить информацию из первых рук от госпожи Нин Гуан, будет иметь неоспоримое преимущество на рынке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Чжи Чэн"
				},
				{
					"id": 110090119,
					"content": "Какое совпадение! Не так давно до меня дошли слухи о плаустрите. Прошу прощения, мне нужно идти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Хун Фэй"
				},
				{
					"id": 110090120,
					"content": "Проклятье... Нам тоже следует поторопиться. Нельзя позволить никому опередить нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Чан Гуй"
				},
				{
					"id": 110090121,
					"content": "Восстановление Нефритового дворца - очень важное дело. Давай поучаствуем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090122,
					"content": "Итак, вы слышали моё объявление? Что скажете? Вас оно заинтересовало?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090123,
					"content": "Правда можно будет задать любой вопрос?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Я отвечу на любой вопрос, если знаю ответ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090125,
					"content": "#(Может быть, я могу спросить о {F#брате}{M#сестре}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Правда? Ох, тогда Паймон спросит, как госпожа Нин Гуан разбогатела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090127,
					"content": "И у нас всегда будет достаточно моры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090128,
					"content": "Ха-ха, разумеется. Однако объём предоставленной информации будет напрямую зависеть от ваших успехов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090129,
					"content": "Для восстановления Нефритового дворца требуется много места, поэтому работы будут проходить в заброшенной шахте за пределами Золотой палаты. Все материалы должны быть доставлены туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090130,
					"content": "У меня есть другие обязательства, и я не могу сопроводить вас на объект. Свяжитесь с моим секретарём, когда прибудете на место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090131,
					"content": "Поторопитесь. Не позволяйте другим опередить вас и воспользоваться этой уникальной возможностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Нин Гуан"
				},
				{
					"id": 110090132,
					"content": "Госпожа Нин Гуан - очень занятой человек. Пойдём скорее, не будем ей мешать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090133,
					"content": "#Нам больше нечего делать на террасе Юйцзин. Пойдём отсюда. А? {NICKNAME}, смотри, там происходит что-то подозрительное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090134,
					"content": "Госпожа, вас отличает элегантный стиль и глубина личности. У вас есть всё необходимое, чтобы возглавить восстановление Нефритового дворца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090135,
					"content": "У нас есть информация о материалах. Давайте найдём более тихое место, чтобы поговорить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090136,
					"content": "Мне не нужна ваша информация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090137,
					"content": "Постойте, куда же вы? Не уходите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090138,
					"content": "Чего стоишь? Давай, быстрее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090139,
					"content": "Д-да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Храбрый Цян"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Шэнь Хэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Ха-ха, на этот раз вам некуда бежать, госпожа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090202,
					"content": "Не волнуйтесь, мы вовсе не плохие люди. Просто желаем обменять ценную информацию на немного моры. Никто не останется внакладе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090203,
					"content": "Босс, у меня плохое предчувствие. От неё исходит какая-то странная аура, а ещё эти белые волосы... С ней явно что-то не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Храбрый Цян"
				},
				{
					"id": 110090204,
					"content": "И что? У неё точно водятся деньжата. Если мы её упустим, то как мы оплатим свои игорные долги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090205,
					"content": "Повторяю, мне не нужна ваша информация.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090206,
					"content": "Говорю это в последний раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090207,
					"content": "Уф... Госпожа, вы же не маленькая. Мне же не нужно вам всё объяснять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090208,
					"content": "Вопрос не в том, нужна вам информация или нет. Вопрос в том, чтобы быть хорошей девочкой и отдать нам мору. Тогда никто не пострадает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090209,
					"content": "Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090210,
					"content": "Молчать! Я знаю, что у вас есть мора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090211,
					"content": "Вы заказали целый стол блюд в «Глазурном павильоне», но попробовали лишь некоторые из них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090212,
					"content": "Дальше вы посетили шатёр «Синьюэ», ресторан «Народный выбор» и снова едва притронулись к еде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090213,
					"content": "У бедных девушек не бывает таких экстравагантных привычек. А если вы богаты, что плохого в том, чтобы поделиться морой с нами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090214,
					"content": "Хоть наставница и приказала мне не делать этого в Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090215,
					"content": "Это не имеет значения. Может быть... это судьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090216,
					"content": "Босс, что-то тут не так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Храбрый Цян"
				},
				{
					"id": 110090217,
					"content": "Чего испугался? Мы не нарушаем закон, продавая информацию. Если она посмеет нам что-нибудь сделать, мы отсудим у неё целое состояние!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090218,
					"content": "Вот они!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Опять вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Чжэн"
				},
				{
					"id": 110090221,
					"content": "Миллелиты? Откуда они тут взялись? Это твоих рук дело? Я тебе покажу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090222,
					"content": "Молчать! Как ты смеешь угрожать людям? Ты пойдёшь с нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Чжэн"
				},
				{
					"id": 110090223,
					"content": "Господин, не гневайтесь. Позвольте мне всё объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Лю Шрам"
				},
				{
					"id": 110090224,
					"content": "Миллелиты увели преступников, которые обступили беловолосую девушку.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090226,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "...Шэнь Хэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090229,
					"content": "Шэнь Хэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090230,
					"content": "Меня зовут Шэнь Хэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090231,
					"content": "#Понятно! Значит тебя зовут Шэнь Хэ. Паймон зовут... Паймон, а это {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090232,
					"content": "Я слышала о вас. Спасибо, что помогли мне избавиться от этих бандитов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090233,
					"content": "Однако я могла бы обойтись и без вашей помощи. По моим расчётам, достаточно было трижды ударить их головой о землю, чтобы они сдались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090234,
					"content": "Ай! Так нельзя! Это слишком жестоко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090235,
					"content": "Это же гавань Ли Юэ. Тут есть законы против такого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090236,
					"content": "Законы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090237,
					"content": "Ты никогда не слышала о законах?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "Никогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090239,
					"content": "Серьёзно? А как же ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090241,
					"content": "Что это за звук?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "Это мой живот урчит от голода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090243,
					"content": "Даже не верится, что ты так спокойно об этом сказала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090244,
					"content": "Паймон только что от них услышала, что ты обошла все рестораны, заказала кучу еды и попробовала только по кусочку от каждого блюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090245,
					"content": "Ничего удивительного, что ты не наелась! Что бы ты хотела поесть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090246,
					"content": "Цветок цинсинь, глазурная лилия, стеклянные колокольчики... я обычно ем их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090247,
					"content": "Это лекарственные травы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Лекарственные?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090249,
					"content": "Кажется, она не понимает... Придумала! Пойдём в хижину «Бубу» и накормим Шэнь Хэ. Она как раз недалеко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090250,
					"content": "Чтобы работать, нужно есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090227,
					"content": "Не волнуйся, теперь всё в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Они ведут дела при помощи грубой силы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Травник Гуй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Вы пришли за лекарствами? У вас есть рецепт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 110090302,
					"content": "Цветок цинсинь, глазурная лилия, стеклянные колокольчики. По четверти килограмма каждого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090303,
					"content": "Какой интересный рецепт. Звучит так, как будто вы хотите пообедать этими травами... Вот, это всё, что у нас есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Травник Гуй"
				},
				{
					"id": 110090304,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090305,
					"content": "Она действительно ест травы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090306,
					"content": "Пока все с изумлением наблюдали за происходящим, Шэнь Хэ доела травы.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Я наелась. Благодарю тебя за угощение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090308,
					"content": "Какие они на вкус?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Невкусные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090311,
					"content": "У них приятный аромат, но если съесть очень много, то вкус становится горьким, кислым и вяжущим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090312,
					"content": "Тогда почему ты предпочитаешь есть травы, а не ресторанную еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090313,
					"content": "Если бы у Паймон было много денег, она бы ходила в лучшие рестораны, заказывала много вкусной еды и съедала всё за один присест!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090314,
					"content": "Потому что я не уверена, что останусь здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090315,
					"content": "Человеческая еда вкусная, но если я вернусь в горы, то воспоминания о её вкусе будут мешать моему обучению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090316,
					"content": "Поэтому лучше просто попробовать немного, чтобы понять вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090317,
					"content": "#Вернуться в горы... {NICKNAME}, она точно Адепт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090318,
					"content": "Не будем пока обо мне. Какие ваши дальнейшие планы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090319,
					"content": "Точно! Паймон чуть не забыла. Мы здесь, чтобы принять участие в состязании по восстановлению Нефритового дворца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090320,
					"content": "Если мы будем медлить, то не сможем закончить то, что должны сделать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090321,
					"content": "Понятно. Я слышала об этом состязании, когда проходила мимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090322,
					"content": "Хе-хе... Если мы победим, то сможем задать Нин Гуан любой вопрос!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090323,
					"content": "Ты тоже принимаешь участие в состязании?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090324,
					"content": "Я пришла ради восстановления Нефритового дворца, но я не думала об участии в состязании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090325,
					"content": "Вы мне очень помогли, поэтому я хотела бы помочь. Не волнуйтесь, я не жду ничего взамен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090326,
					"content": "Нам как-то неловко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090327,
					"content": "Но помощь Адепта была бы очень кстати...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090328,
					"content": "Тогда в путь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Не будем терять времени. У меня есть план действий на ближайшее будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090331,
					"content": "Паймон не сомневается, что у Шэнь Хэ есть отличный план!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090332,
					"content": "Не уверена, насколько он отличный, но он определённо эффективный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090333,
					"content": "Всего лишь устранив всех, кто опережает нас, мы станем первыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090334,
					"content": "Нет, нет, нет, так не пойдёт. Нельзя так делать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090335,
					"content": "Нельзя? Но я слышала, что конкуренция - это, по сути, конфликт и единоборство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Шэнь Хэ"
				},
				{
					"id": 110090336,
					"content": "Мы честно и справедливо займём первое место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090337,
					"content": "Плаустрит зари, Ядро чудес и Талисман Адептов... Пойдём по списку. Итак, первым идёт плаустрит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090338,
					"content": "Я услышал спор снаружи и вышел посмотреть, в чём дело, а это, оказывается, вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 110090339,
					"content": "Бай Чжу! Что вы здесь делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090340,
					"content": "Госпожа Нин Гуан заказала большую партию ранозаживляющих лекарств, но у меня в аптеке недостаточно ингредиентов. Поэтому я лично приехал сюда, чтобы подготовить всё необходимое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 110090341,
					"content": "Зачем госпоже Нин Гуан столько ранозаживляющих лекарств?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090342,
					"content": "Понятия не имею! Я слышал, что она хочет восстановить Нефритовый дворец. Может быть, это для рабочих на случай, если они поранятся. Как бы то ни было, это её личное дело, поэтому я не вправе задавать слишком много вопросов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 110090343,
					"content": "Она также одолжила Ци Ци, поэтому мне не хватает рук в хижине «Бубу». Не хотите немного поработать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 110090344,
					"content": "Мы бы с радостью, но у нас очень много дел. Господин Бай Чжу, вы славитесь своими обширными знаниями. Вы случайно не слышали о плаустрите зари?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090345,
					"content": "Он нужен для восстановления Нефритового дворца? Я припоминаю, что он упоминается в «Семи горных трактатах». Там говорится, что после активации плаустрит зари возносится к облакам, и что встречается он крайне редко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 110090346,
					"content": "В древних текстах говорится, что весь плаустрит зари был добыт ранее и сейчас находится в чьей-то собственности. Полагаю, торговая гильдия «Фэйюнь» сможет прояснить этот вопрос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 110090347,
					"content": "Вот как? Тогда нам нужно идти в торговую гильдию «Фэйюнь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090348,
					"content": "Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110090349,
					"content": "Не за что, и удачи. Если вам что-нибудь понадобится, вы найдёте меня в хижине «Бубу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бай Чжу"
				},
				{
					"id": 110090329,
					"content": "Добро пожаловать в команду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "Они правда вкусные?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
