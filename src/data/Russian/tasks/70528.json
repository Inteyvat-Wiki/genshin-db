			"dialogs": [
				{
					"id": 705280401,
					"content": "Ох, сможет ли Гильдия справиться с таким объёмом работы?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280402,
					"content": "#{NICKNAME}! Извини, я задумался о делах Гильдии и не заметил тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280403,
					"content": "#Ты прибыл{F#а} в Мондштадт на Праздник ветряных цветов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280404,
					"content": "Ты как раз вовремя! Гильдия только что придумала небольшую забаву. Все повеселятся и гарантированно получат награды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280405,
					"content": "Ну что, я заинтересовал тебя? Хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280406,
					"content": "Позволь рассказать об этой игре. Создатель называет её «Цветочные шахматы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280407,
					"content": "Он сказал, что его вдохновили распустившиеся лепестки, гонимые ветром...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280408,
					"content": "Игра призвана отразить... романтику погони за лепестками цветов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280409,
					"content": "Д-довольно интересно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Ну, автор игры - бард, поэтому у него... это, как его... воображение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280412,
					"content": "По сути, во время игры в эту разновидность шахмат нужно собрать как можно больше шаров анемонии на шахматной доске.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280413,
					"content": "В процессе участникам предстоит преодолевать различные препятствия, а инструменты будут помогать в этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280414,
					"content": "Он даже написал целое руководство по этому событию, с которым ты сможешь ознакомиться позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280415,
					"content": "Если тебе любопытно, можешь принять участие. Все участники гарантированно получат призы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Плауэн"
				},
				{
					"id": 705280410,
					"content": "Д-довольно сложно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
