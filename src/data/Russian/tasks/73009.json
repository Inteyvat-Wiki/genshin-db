					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араджа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091101,
					"content": "Расскажи мне об Араньяке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#Её здесь {F#оставил}{M#оставила} нара Варуна. {F#Он}{M#Она} тоже {F#золотой}{M#золотая} нара. {F#Такой}{M#Такая} же {F#добрый}{M#добрая}, {F#смелый}{M#смелая} и {F#беспристрастный}{M#беспристрастная}, как и ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091103,
					"content": "#Аранары, что ещё помнят те времена, очень скучают по {F#нему}{M#ней} и обожают истории о {F#нём}{M#ней}. Но я верю, что теперь, когда здесь {F#появилась}{M#появился} нара {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араджа"
				}
			]
		},
		{
			"id": 7300912,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
