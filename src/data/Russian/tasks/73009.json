			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араджа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "Спасибо за помощь в подготовке к Празднику Утсава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091302,
					"content": "Жаль, что я не смог присоединиться к вашим приключениям, как Арама и другие, и не смог оказать никакой помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091303,
					"content": "И все же, если вы когда-нибудь устанете от приключений, приходите в Ванарану. В этом сне вам всегда рады.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араджа"
				}
			]
		},
