			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Араджа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091201,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091202
					]
				},
				{
					"id": 730091202,
					"content": "Да. Мне так не терпится отпраздновать вместе с вами Праздник Утсава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араджа"
				}
			]
		},
		{
			"id": 7300913,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
