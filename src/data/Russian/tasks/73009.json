				"points": []
			},
			"dialogs": [
				{
					"id": 730091401,
					"content": "Расскажи о Маране...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091402
					]
				},
				{
					"id": 730091402,
					"content": "Это очень давняя история...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091403
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091403,
					"content": "Давным-давно аранары ходили по земле, дружили с нарами и всеми живыми существами. Мараны тогда ещё не было в лесу. Но однажды, много лун назад, случилась страшная катастрофа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091404
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091404,
					"content": "Многие вернулись в сарву, и на земле начала свирепствовать Марана. После того как лес вернулся к жизни, аранары спрятали настоящую Ванарану в сновидения, чтобы защититься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091405
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091405,
					"content": "Лес не знал смерти, пока однажды деревья не осознали, что земля заполнена увядшими цветами и мёртвыми животными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091406
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091406,
					"content": "В тот же день и земля вспомнила о тёмной ядовитой крови, которой она напиталась или собиралась напитаться. А реки подумали об алом мире, который остался после того, как солнце спустилось на землю и иссушило всю воду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091407
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091407,
					"content": "Они поняли, что всё неизбежно умрёт. Тогда-то и появилась Марана. Это и есть имя смерти. Всякий, кто о ней знает, погибнет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091408
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091408,
					"content": "Марана подталкивает все сущее к смерти. Эти огромные, тёмные, сгорбленные фигуры - воплощения, которые она выбрала для себя, вестники погибели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091409
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091409,
					"content": "Конечно, в моих историях у Мараны много воплощений. Иногда это звери, иногда птицы, иногда нары, а иногда болезни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091410
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091410,
					"content": "Но это всего лишь истории, а не мои воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араджа"
				}
			]
		},
