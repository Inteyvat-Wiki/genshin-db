						730090202,
						730090203
					],
					"speakerTitle": "Рана"
				},
				{
					"id": 730090202,
					"content": "(Нужно как можно скорее помочь Ране...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730090203,
					"content": "(Давай тихонько уйдём.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
