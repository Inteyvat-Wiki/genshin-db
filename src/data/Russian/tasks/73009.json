					"Араджа"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091001,
					"content": "Расскажи мне о фрукте васома.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "Это плоды, наполненные силой. Они растут, черпая воспоминания и сны этого мира. А чтобы эти плоды выросли, требуется помощь аранар и нар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "Араджа"
				},
				{
					"id": 730091003,
					"content": "Чтобы выросла биджа, нужно подпитать васомой Древо Ашваттха. Это такое огромное дерево, которое посадила сама Руккхадевата. Именно от него и произошли аранары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Араджа"
				}
			]
		},
		{
			"id": 7300911,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
