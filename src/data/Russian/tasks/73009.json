				"points": []
			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Арана о ней позаботится. Она самый дорогой друг Араны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730090102,
					"content": "#Нара {NICKNAME}, отправляйся в Ванарану и пропой Песню великого сновидения. Затем попроси их подготовить биджу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Арана"
				},
				{
					"id": 730090103,
					"content": "Я не понимаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Как облака знают, что нужно орошать землю дождём. Как дожди знают, что нужно проникнуть глубоко в почву. Как семена знают, что нужно вырасти в большие деревья и дать крупные плоды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арана"
				},
				{
					"id": 730090104,
					"content": "#П-понял{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Нара {NICKNAME} не понимает. Ничего. Когда придёт время, нара {NICKNAME} будет знать, что нужно делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Арана"
				}
			]
		},
		{
			"id": 7300902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
