					"Фан Цзюй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100701,
					"content": "Судя по твоему невозмутимому лицу, ты хочешь представить свои фотографии на конкурс? Можешь передать их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100702
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100702,
					"content": "Очень хорошо. Тебе, должно быть, пришлось долго ждать, чтобы запечатлеть такие особенные моменты на снимке. Отличная работа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фан Цзюй"
				}
			]
		},
		{
			"id": 7111008,
			"completionStepIds": [
				7111008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
