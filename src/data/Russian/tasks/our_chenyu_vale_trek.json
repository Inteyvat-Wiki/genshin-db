						"sceneId": 3,
						"position": [
							1482.11,
							290.491,
							1725.491
						],
						"pointId": 310100245
					}
				]
			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "Стойте! Не подходите! Вы... вы хорошие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101302,
					"content": "Эй, мы же тебя только что спасли! Ты ударился головой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711101303,
					"content": "Ах, ты права... Простите. В этот раз мне очень не повезло с конкурсом «Путешествие по Чэньюй», и у меня до сих пор кружится голова. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101304,
					"content": "Ты тоже участвуешь в конкурсе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "И вы тоже? Какое совпадение! Но я обычный турист... и не могу противостоять хиличурлам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101306,
					"content": "Уф, по пути я наткнулся на хиличурлов, и они меня схватили. С каких пор они берут плату за проход? Так не должно быть! Мне повезло, что я встретил вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101307,
					"content": "Похоже, сегодня не твой день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711101308,
					"content": "И не только сегодня! Вчера мне тоже не повезло. Я купил очень дорогую фотокамеру у торговца из Фонтейна. Потом я сделал несколько снимков, и она сломалась. Я пошёл обратно к продавцу, но его и след простыл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101309,
					"content": "Поистине беспринципный торговец... Береги кошелёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101310,
					"content": "Ах да, мы отвлеклись. Если вы тоже участвуете в «Путешествии по Чэньюй», то наверняка прибыли сюда, чтобы сфотографировать гору Сюаньлянь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101311,
					"content": "В качестве благодарности я отмечу на вашей карте лучшие точки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101312
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101312,
					"content": "Смотрите, вы можете увидеть её прямо отсюда, вот она!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101313
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101313,
					"content": "А как же ты? Разве ты не участвуешь в конкурсе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711101314,
					"content": "Здесь очень опасно. В путеводителе указано ещё одно место - пойду поснимаю там. Я бы хотел увидеть Чаепитие Адепта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101315
					],
					"speakerTitle": "Акаи"
				},
				{
					"id": 711101315,
					"content": "В общем, до свидания. Надеюсь, наше знакомство принесёт мне удачу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Акаи"
				}
			]
		},
