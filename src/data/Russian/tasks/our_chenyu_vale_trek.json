			"dialogs": [
				{
					"id": 711101001,
					"content": "Приветствую!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101002,
					"content": "Видите эти снимки? Всего в конкурсе «Путешествие по Чэньюй» в этом году было отобрано восемь работ, и половина из них - ваши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101003,
					"content": "Мои поздравления!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101004,
					"content": "Ого! Здорово, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711101005,
					"content": "#{NICKNAME}! Я же говорила, что результат - четыре четверти! Паймон считает всё лучше и лучше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711101006,
					"content": "Это четыре восьмых.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Хе-хе, как и я вчера, судьи восхищались двумя другими снимками, которые вы сделали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101009,
					"content": "Поэтому, пожалуйста, возьмите этот лимитированный памятный альбом с фотографиями «Путешествие по Чэньюй». В нём собраны все выбранные работы. Вы это заслужили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101010,
					"content": "Так это и есть приз-сюрприз? Выглядит мило!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711101011,
					"content": "Позвольте мне также вручить вам немного моры! Ещё раз спасибо за поддержку, на этот раз от меня лично.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101012,
					"content": "Дело в том, что это мой дом. И вы запечатлели его красоту на все времена в снимках, которые наверняка позволят многим людям почувствовать красоту здешних мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101013,
					"content": "Спасибо вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711101007,
					"content": "Ух ты! Паймон, ты так хорошо считаешь!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
		},
