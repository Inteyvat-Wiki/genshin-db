					}
				]
			},
			"dialogs": [
				{
					"id": 711100801,
					"content": "О... Эти фотоснимки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100802,
					"content": "Что не так? Они недостаточно хороши?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711100803,
					"content": "Ха-ха-ха, наоборот... В последнее время мне попадалось много хороших снимков, но таких, как эти, я ещё не видела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100805,
					"content": "Например, этот снимок деревни Цяоин. Пеликаны придают мирной деревне движение, а на контрасте - неподвижность. Уникальная композиционная идея!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100806,
					"content": "Я уверена, что вы выйдете в финал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100807,
					"content": "Ого! Паймон не ожидала, что ты так высоко нас оценишь. Ты засмущала Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711100808,
					"content": "Это ведь не ты делала снимок. С чего тебе смущаться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "Паймон чувствует себя неловко вместо тебя! Паймон знает о твоей скромности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711100811,
					"content": "Вернёмся к теме. Жюри закончит работу завтра утром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100812,
					"content": "Завтра с восьми утра до шести вечера избранные снимки будут выставлены на улице для широкой публики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100813,
					"content": "Благодарим вас за поддержку конкурса пейзажной фотографии «Путешествие по Чэньюй». Пожалуйста, не забудьте прийти завтра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Фан Цзюй"
				},
				{
					"id": 711100814,
					"content": "Обязательно! Мы ведь не хотим пропустить приз-сюрприз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 711100810,
					"content": "Теперь и мне немного неловко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
