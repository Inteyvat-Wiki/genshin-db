			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Янь Фэй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "Ой, что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280402,
					"content": "Почему... мы вернулись?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280403,
					"content": "Разве мы здесь уже были?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280404,
					"content": "Да, мы отсюда начали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280405,
					"content": "Но мы не могли ошибиться. Мы шли на выход и назад не сворачивали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280406,
					"content": "Да, так и было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280407,
					"content": "#Путешественни{F#ца}{M#к}, ты тоже думаешь, что мы шли правильно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280408,
					"content": "Да, мы не сбивались с пути.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "Странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280410,
					"content": "В Инадзуме ходит история о том, как одного торговца ночью обманули бакэ-дануки, и он до самого рассвета кружил на одном месте, не в силах найти выход...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280411,
					"content": "Да-да, Паймон тоже о таком слышала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280412,
					"content": "Значит, все об этом знают, так? Потому что я уверен, что с нами сейчас так и происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280413,
					"content": "Но ничего, у меня есть помощник, способный изгнать всю нечисть. Позову-ка я его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280414,
					"content": "Ничего себе! У óни есть друг, изгоняющий нечисть. Вот это я понимаю, отсутствие предубеждений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280415,
					"content": "Невежество - это сильная сторона босса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280416,
					"content": "Давай, Уси, схвати этого духа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280417,
					"content": "Му!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10280418,
					"content": "Это наш внештатный боец банды Аратаки Уси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280419,
					"content": "Муу-муу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10280420,
					"content": "Это Уси с вами здоровается. Можете звать его «Уси» или «Крепыш». Он отличный следопыт и сможет вывести нас отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280421,
					"content": "Оказывается, в бандах бывают внештатные бойцы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280422,
					"content": "Непохоже, что это может сработать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280423,
					"content": "Кто знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280424,
					"content": "Уси! Иди! Покажи нам дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280425,
					"content": "Му!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10280426,
					"content": "Уси осматривается вокруг в поисках тайного выхода...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "Муу-муу-муу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10280428,
					"content": "А? Что?! Не может быть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280429,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280430,
					"content": "Уси говорит, что он всё обыскал, но выхода нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280431,
					"content": "Но если мы смогли войти, значит должен быть и выход. Я пойду осмотрюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280432,
					"content": "Вы заметили? Мы думали, что мы упали сверху и тогда наверху ещё был выход... А теперь и он исчез.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280433,
					"content": "Необъяснимо, как по мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280434,
					"content": "Кажется, некоторые конструкции не так просты, как мы думаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280435,
					"content": "Я всё осмотрю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280436,
					"content": "Ни щёлочки... Может быть, мы неправильно запомнили? Может быть, мы вообще не здесь упали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280437,
					"content": "Эй, да ты боишься?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280438,
					"content": "Н-нет, Паймон очень смелая!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280439,
					"content": "Му...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10280440,
					"content": "Уси тоже думает, что ты боишься. Но это ничего. Не бойся признать, что... боишься. У тебя ведь есть мы, и мы тебя защитим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280441,
					"content": "Я с тобой, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#Не нужно сидеть на месте, поищем дорогу ещё раз. Синобу, ты иди с благодетельницей. {NICKNAME} и Паймон, я буду с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280443,
					"content": "Хорошо, будьте осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280444,
					"content": "Какая ещё благодетельница, зови меня просто Янь Фэй. А не зря господин Аратаки - босс банды, он умеет руководить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280445,
					"content": "Ну что ты, я просто Итто. Раз уж мы команда, мы должны заботиться друг о друге. Паймон, если тебе снова станет страшно, я прикрою тебе глаза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280446,
					"content": "Вы разделяетесь и изучаете местность, но ничего не находите...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280448,
					"content": "И правда нет выхода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280449,
					"content": "Му!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "Уси"
				},
				{
					"id": 10280450,
					"content": "Что-то не так с этим местом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280451,
					"content": "Босс, ну что у вас там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280452,
					"content": "Ничего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "Но я могу поклясться, что только что видел тень... Уф, только бы не эта нечисть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280454,
					"content": "Может, это прозвучит неуместно, но Паймон хочет спросить: Итто, ты же óни. То есть ты же сам что-то вроде нечисти, разве не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280455,
					"content": "Да нет же! Я говорю о тех светящихся, которых вроде видишь, а вроде нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280456,
					"content": "Что? Итто, ты боишься призраков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280457,
					"content": "Ой, босс, тебя раскусили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280458,
					"content": "Я? Нет! И хватит болтать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "Аратаки Итто"
				},
				{
					"id": 10280459,
					"content": "Хи-хи, глядя на тебя, Паймон вдруг перестала бояться. Эй, Пастушонок, если боишься, то Паймон прикроет тебе глаза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280460,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280461,
					"content": "Кажется, мне стоит заняться чем-нибудь другим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280462,
					"content": "(Хм? Синобу отошла, чтобы взять несколько камней, затем достала из кармана веточки и фиалковые дыни... Что?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "Щепотку соли... и немного перца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280464,
					"content": "Скажи, ты жаришь фиалковые дыни?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "Да, фиалковые дыни очень вкусные. Скоро попробуешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280466,
					"content": "Ладно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "Есть сладкие и солёные. Тебе какую?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280468,
					"content": "Любую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "Ну тогда попробуй все. Нам сейчас нужно сохранять присутствие духа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280470,
					"content": "Если я правильно понимаю, то здесь кроется какой-то секрет, о котором мы с боссом не должны знать. Но не переживай, я отвлеку босса, а ты сможешь всё обсудить с остальными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280471,
					"content": "Ого! Тут что-то жарится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280472,
					"content": "Янь Фэй, попробуешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280473,
					"content": "Я не голодна, ешьте сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280474,
					"content": "Кстати, Синобу, мы так давно не виделись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280475,
					"content": "Точно. Последний раз я видела тебя в Ли Юэ, когда ты заменяла преподавателя на занятиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280476,
					"content": "Заменяла... Ах, да, вспомнила, это было зимой, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280477,
					"content": "Да. Все сказали, что ты очень интересно преподаёшь и как бы это сказать... Ты настоящая наставница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280478,
					"content": "Ага, мне понравилось преподавать право!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280479,
					"content": "Кто же знал, что однажды я попаду с ученицей в передрягу. Это судьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280480,
					"content": "Янь Фэй ещё и преподаёт... Ух ты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "Она так остроумно и увлекательно рассказывает, её все студенты полюбили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280482,
					"content": "Ха-ха-ха! Ты мне льстишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280483,
					"content": "Так вы все здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280484,
					"content": "Е Лань, мы разделились, но никто не нашёл выход. А что у тебя? Есть результаты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280485,
					"content": "Нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280486,
					"content": "Мне не хочется об этом говорить, но вы приготовьтесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280487,
					"content": "Если мы не сможем найти выход, то застрянем тут надолго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280488,
					"content": "Мне тоже так кажется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "Янь Фэй"
				},
				{
					"id": 10280489,
					"content": "Ясно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280490,
					"content": "Хм, подземное пространство со входом, но без выхода... это просто не имеет никакого смысла. Я что-нибудь придумаю, просто дайте мне немного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280491,
					"content": "Если увидите что-то похожее на выход, то будьте осторожны при его исследовании.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "Е Лань"
				},
				{
					"id": 10280492,
					"content": "(Кстати, Сяо тоже здесь. Он говорил, что в случае чего можно позвать его по имени.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "(Хм, это может помочь.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "#Эй, что за серьёзный вид? Что ты задумал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280495,
					"content": "Ты помнишь, что Сяо тоже здесь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "Да! Сяо! Хочешь попросить его о помощи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280497,
					"content": "Я думаю, можно попробовать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "Да, давай попробуем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280499,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "Сяо, ты меня слышишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280502,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "Сяо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "Не отвечает... А Паймон думала, что он хоть откуда может прибежать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280505,
					"content": "Значит, даже Сяо не чувствует, что мы здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 10280506,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "(Что же это значит? Что это за место такое?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
