					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "Куки Синобу"
				},
				{
					"id": 10280803,
					"content": "Эй, хватит строгости наводить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
