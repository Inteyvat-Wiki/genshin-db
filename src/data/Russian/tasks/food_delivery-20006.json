			},
			"dialogs": [
				{
					"id": 200060101,
					"content": "Заказ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060102,
					"content": "#Добро пожаловать в ресторан «Хороший охотник»! Привет, путешественн{F#ица}{M#ик}. Ты как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060103,
					"content": "#Прости, наверное, ты проголодал{F#а}с{F#ь}{M#я}, но я хочу попросить тебя о помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060104,
					"content": "Орлиан из Спрингвейла заказала <color=#00E1FFFF>медовое мясо с морковкой</color>, но, говорят, что Спрингвейл заполонили слаймы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060105,
					"content": "Я боюсь ехать одна... Не могли бы вы помочь мне доставить эти товары <color=#00E1FFFF>Орлиан из Спрингвейл</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060106,
					"content": "Хорошо, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Не волнуйтесь! По возвращении вас будет ждать роскошный ужин, будьте уверены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060109,
					"content": "Я рассчитываю на вас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060107,
					"content": "Мы просто пришли поесть. Умираем с голоду!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "Как только вы вернётесь, я позабочусь о том, чтобы вам накрыли стол в «Хорошем охотнике». Я в долгу не останусь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
				}
			]
		},
