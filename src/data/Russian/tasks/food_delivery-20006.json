				{
					"id": 200060401,
					"content": "Плата за еду",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060402
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060402,
					"content": "#Ты уже вернул{F#ась}{M#ся}? Всё прошло успешно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060403,
					"content": "Вот плата за еду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "Так, что тут у нас... Да, всё верно. Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "Сара"
				},
				{
					"id": 200060405,
					"content": "Эта <color=#00E1FFFF>запеканка с овощами, ветчиной и крабом</color> за счёт заведения. Горячая, только что из печи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сара"
