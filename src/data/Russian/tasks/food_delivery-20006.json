					"Бойкая Орлиан"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "Спасибо тебе! Будь прокляты эти дурацкие слаймы..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "Бойкая Орлиан"
				},
				{
					"id": 200060202,
					"content": "Не будь я такая голодная, я бы сама проучила этих негодников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Бойкая Орлиан"
				},
				{
					"id": 200060203,
					"content": "Ваш заказ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Ммм... Пахнет морковкой с мясом... Если бы я не была так голодна, то сама разделалась бы с этими слаймами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Бойкая Орлиан"
				},
				{
					"id": 200060205,
					"content": "Ладно, ничего страшного. Вот плата за еду, передай её Саре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бойкая Орлиан"
				}
			]
		},
