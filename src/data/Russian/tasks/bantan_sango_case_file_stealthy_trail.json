			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "Вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320102,
					"content": "Нашлись какие-нибудь зацепки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "Да, благодаря Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320104,
					"content": "С помощью её «дедукции» мы смогли обнаружить несколько мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320105,
					"content": "Похоже, что один из лагерей сейчас охраняется нашим Шляпоклыком. Там лучше соблюдать предельную осторожность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320106,
					"content": "Шляпоклыком? Прозвище в стиле Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "Эй! Паймон придумала бы что-нибудь получше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320108,
					"content": "М-м, я бы назвала его Ножепсом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320109,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320110,
					"content": "Я разместил в окрестностях такие же устройства, как в прошлый раз. Надеюсь, они будут столь же эффективны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320111,
					"content": "Эй! Не смейте игнорировать Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320112,
					"content": "В остальном полагаюсь на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320113,
					"content": "Ещё какие-нибудь вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320114,
					"content": "Насколько надёжны эти сведения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "Абсолютно надёжны. Я сам ходил на разведку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320116,
					"content": "Почему ты не идешь с нами в этот раз, Рюдзи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320117,
					"content": "Я бы пошёл, если бы не другое задание, которое я должен выполнить для Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320118,
					"content": "В общем, у неё есть идеи насчёт того, откуда мог взяться наш Шляпоклык, и она поручила мне в этом разобраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320119,
					"content": "Ножепёс.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320120,
					"content": "Шляпоклык.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320121,
					"content": "Шляпоклыконожепёс.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "Нет, это плохо звучит вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320123,
					"content": "Да что это вообще за прозвище?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320125,
					"content": "Ладно, давайте будем называть его, как раньше - «Чёрная тень».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320126,
					"content": "Как бы там ни было, животных я поручаю вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320124,
					"content": "Не ругайтесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "Большое спасибо. Хм... Это ещё не всё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320302,
					"content": "Что, там много животных пропало?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320303,
					"content": "Увы, да. Судя по количеству заявлений, мы нашли где-то половину животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320304,
					"content": "К сожалению, у нас снова нет зацепок. Хорошо ещё, что животных гораздо легче искать, чем неодушевленные предметы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320305,
					"content": "Недавно одна влиятельная семья как раз обратилась к нам по поводу украденной вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320306,
					"content": "С момента кражи прошло слишком много времени, и если бы не умозаключения Санго, мы бы ничего не смогли найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320307,
					"content": "Можешь рассказать подробнее?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "Ух-ты-тух-ты! Как интересно, давай, мы хотим послушать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320309,
					"content": "Не думал, что вы так интересуетесь нашей работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320310,
					"content": "По правде говоря, мы довольно быстро вышли на нашего подозреваемого. Проблема была в том, что мы не могли найти у него дома никаких улик, равно как и других зацепок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320311,
					"content": "Позже я совершенно случайно узнал, что накануне наш подозреваемый продал немного травы наку. Я побывал у покупателя, осмотрел товар и обнаружил, что трава действительно ещё свежая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320312,
					"content": "Услышав это, Санго велела мне отправиться к подножию горы Ёго, чтобы поискать пропажу там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320313,
					"content": "Что? Причём здесь гора Ёго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320314,
					"content": "«Наш подозреваемый живет на острове Наруками. Хотя траву наку можно найти по всей Инадзуме, чтобы отправиться за ней на другие острова, нужна лодка. А лодки мы не нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320315,
					"content": "Кроме того, комиссия Тэнрё очень трепетно относится к использованию лодок из-за указа Сакоку. Если бы наш подозреваемый планировал совершить преступление, он не стал бы раскрываться перед Комиссией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320316,
					"content": "Таким образом, другие острова можно исключить», - вот что сказала Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320317,
					"content": "Но ведь вокруг Великого храма Наруками есть трава наку? Почему вы проверили только подножие горы Ёго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320318,
					"content": "Санго и об этом подумала: «Трава наку растёт возле Великого храма Наруками, но там всегда есть жрицы, да и верующие часто посещают это место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320319,
					"content": "Если бы там произошло что-то необычное, об этом все быстро узнали бы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320320,
					"content": "Ничего себе! Теперь Паймон понимает, почему Санго - мозг команды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320321,
					"content": "В предгорьях мы нашли кучу недавно раскопанной земли. Наш подозреваемый закопал там украденное и намеревался продать его после смены погоды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320322,
					"content": "Но он подумал, что может навлечь на себя подозрения, если уйдёт с тяжёлым грузом и вернётся с пустыми руками. Поэтому он собрал по дороге траву наку для продажи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320323,
					"content": "Ха-ха, и в итоге из-за травы-то его и поймали!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400320324,
					"content": "Точно. Так что я уверен, что и в этом деле зацепки точно ещё есть. Мы просто пока их не нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320327,
					"content": "Я считаю, что мы отлично сработались. В конце концов, я силён в исполнении поручений, а не в тайных операциях или сражениях. Так что я очень рад, что могу передать эту часть задач тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320328,
					"content": "Не хочешь устроиться на работу в агентство Бантан Санго?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320329,
					"content": "Санго может показаться немного... необычной в общении, и она говорит странные вещи вроде «интуиция - обуза для мудрости», но в душе она хороший человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320330,
					"content": "Нет, спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "А жаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320333,
					"content": "Хотя, может, оно и к лучшему. Если бы у Санго был кто-то вроде тебя, я бы остался без работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320334,
					"content": "Я продолжу заниматься расследованием. Если у вас есть другие дела, спокойно займитесь ими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320335
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320335,
					"content": "Встретимся в агентстве, когда придёт время. Ещё раз спасибо за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400320331,
					"content": "Спасибо, но нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320325,
					"content": "Будем надеяться, что и в этот раз всё пройдет хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320326
					]
				},
				{
					"id": 400320326,
					"content": "Да, люди, потерявшие своих питомцев, наверное, сейчас в настоящей панике.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Паймон"
				}
			]
