			"dialogs": [
				{
					"id": 716540201,
					"content": "Ого... А тут больше места, чем в чайнике мадам Пин. Даже огромный дом стоит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716540202,
					"content": "А почему вокруг ничего нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716540203,
					"content": "Паймон, наколи камни и построй дом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "Камни не так-то легко расколоть. Тебе проще, у тебя вон какой меч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716540207,
					"content": "Но всё же, почему здесь нет ничего, кроме этого дома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716540208,
					"content": "Постой, что это там такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 716540205,
					"content": "Паймон, иди выкопай яму и живи пока в ней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "Почему Паймон должна копать яму, если есть дом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Паймон"
				}
			]
		}
