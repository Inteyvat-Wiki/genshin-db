				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "#Твоё мастерство выше всяких похвал. Ты {F#бесспорная победительница}{M#бесспорный победитель}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Акацуки Дзаэмон Дзюдзо"
				},
				{
					"id": 736880102,
					"content": "Для меня было честью сражаться с тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Дамы и господа! В результате волнующего поединка победителем состязания по фехтованию на мечах «Воинский дух» становится... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Рэйна"
				},
				{
					"id": 736880104,
					"content": "#Завтра пройдёт финальный показательный бой... {NICKNAME} и госпожа Камисато сразятся с посланником всемогущего сёгуна, гуманоидом-мечником магу кэнго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Рэйна"
				},
				{
					"id": 736880105,
					"content": "Этот бой нельзя пропустить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Рэйна"
				},
				{
					"id": 736880106,
					"content": "#{NICKNAME}, это был самый захватывающий бой из всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880107,
					"content": "#Поздравляю, {NICKNAME}. Твой титул чемпиона вполне заслужен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 736880108,
					"content": "Паймон и подумать не могла, что завтра вашим противником будет магу кэнго... Его имя похоже на имя того опасного парня с острова Ясиори. Паймон уверена, это будет непростой бой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880109,
					"content": "Не волнуйся, Паймон. Посланник сёгуна силён, но в бою не запрещается использовать Глаз Бога. Из нас получится славная команда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880110,
					"content": "Мы сможем отслеживать его движения, и возможность нанести ответный удар не заставит себя ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880111,
					"content": "Твоя уверенность успокоила Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880112,
					"content": "Я не могу гарантировать, что мы победим, но мы должны постараться изо всех сил. Хотя бы для того, чтобы порадовать публику незабываемым шоу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880113,
					"content": "Мы непременно победим, Аяка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "Я вижу, вам уже не терпится продемонстрировать свои способности, но лучше поберечь силы и хорошенько отдохнуть сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 736880116,
					"content": "А ещё мы увидим новый наряд Аяки завтра утром. Аяка в платье из Фонтейна... О, Паймон ждёт не дождётся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880117,
					"content": "Ах, это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880118,
					"content": "Я тоже жду с нетерпением.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "#Ох, {NICKNAME}, и ты туда же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880121,
					"content": "Хе-хе, госпожа Аяка, исполните их желание. Я бы тоже с удовольствием пришла, но у меня завтра дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 736880122,
					"content": "Договорились. Завтра утром я буду ждать вас в имении Камисато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880120,
					"content": "Хочешь, я зайду за тобой завтра утром?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Это, без всяких сомнений, будет захватывающий бой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хиротацу",
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Приветствую!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880202,
					"content": "Уфф... Это Хиротацу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880203,
					"content": "#Несколько дней назад {NICKNAME} победил{F#а} тебя и выиграл{F#а} состязание. Что тебе надо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880204,
					"content": "#Не волнуйтесь, я не собираюсь создавать проблемы. Я просто хотел извиниться. {NICKNAME}, я честно проиграл тебе несколько дней назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880205,
					"content": "Твоё мастерство владения мечом безукоризненно. Каждый удар был точным, но не агрессивным, что говорит о зрелости личности. Я прошу прощения за то, что неправильно оценил тебя и оскорбил своими словами и действиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880206,
					"content": "#Всё в порядке. Я не принял{F#а} это близко к сердцу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Вы пришли за госпожой Камисато? Она наряжается и скоро выйдет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880209,
					"content": "#{NICKNAME}, пока госпожа не пришла, у меня есть небольшая смелая просьба, которую, я надеюсь, ты сможешь выполнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880210,
					"content": "Я слушаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "Госпожа ни словом с нами не обмолвилась о предстоящем бое, но она каждый вечер выделяет несколько часов, чтобы попрактиковаться в фехтовании, несмотря на занятость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880212,
					"content": "Госпожа всегда была прилежной и добросовестной. Это всего лишь показательный бой. Независимо от исхода я верю, что она приложит все усилия для победы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880213,
					"content": "Я, конечно, верю в неё, но... Я надеюсь, что ты поддержишь госпожу на арене и обеспечишь её безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880214,
					"content": "Не волнуйся. Обязательно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "#{NICKNAME}, я вверяю госпожу тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880217,
					"content": "Это, наверное, Аяка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880218,
					"content": "Вау!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880219,
					"content": "В чём дело? Почему вы молчите? Что-то не так с нарядом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880220,
					"content": "Вовсе нет! Аяка, ты выглядишь потрясающе... Ты светишься красотой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880221,
					"content": "Этот наряд тебе очень к лицу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "Да, да! Ты похожа на энергичную молодую леди, только что сошедшую с корабля, прибывшего из Фонтейна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880223,
					"content": "Вы так думаете? Я беспокоилась, не будет ли наряд слишком легкомысленным... Я не была уверена, что этот стиль подойдёт мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880224,
					"content": "Вы меня успокоили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880229,
					"content": "Хе-хе, Паймон не терпится посмотреть на лица зрителей, когда все увидят Аяку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880230,
					"content": "#Спасибо за комплимент, Паймон. {NICKNAME}, пойдём на арену, если мы готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880231,
					"content": "#Госпожа, {NICKNAME}, желаю вам удачи в показательном бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хиротацу"
				},
				{
					"id": 736880225,
					"content": "Это прекрасный наряд, и он отлично смотрится на тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Только посмотрите! На нём даже герб клана Камисато вышит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880227,
					"content": "Да, несколько дней назад Онодэра отдал распоряжение вышить герб. Я слышала, что это было сделано на основе пожеланий, которые зрители написали в бланках для голосования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880228,
					"content": "Наряд прекрасно сидит по фигуре и даёт большую свободу движений, чем я ожидала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880207,
					"content": "Мне понравился наш поединок.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368804",
							"2"
						],
						"stepId": 7368804,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"0",
							"73688"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "#Смотрите, госпожа Камисато и {NICKNAME} здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Юу"
				},
				{
					"id": 736880302,
					"content": "Я видела рисунки того наряда, но на госпоже он выглядит совершенно иначе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Сае"
				},
				{
					"id": 736880303,
					"content": "Не зря я взял места в первом ряду. Оно того стоило! С нетерпением жду начала состязания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Мацумэ"
				},
				{
					"id": 736880304,
					"content": "Аяка стала центром внимания с самого момента своего появления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880305,
					"content": "Дамы и господа, минуточку внимания. Показательный бой «Воинского духа» скоро начнётся. Пожалуйста, пройдите на свои места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Рэйна"
				},
				{
					"id": 736880306,
					"content": "#Госпожа Камисато, {NICKNAME}, следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Рэйна"
				},
				{
					"id": 736880307,
					"content": "#{NICKNAME}, готов{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880308,
					"content": "Да, пойдём.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Давай сделаем всё от нас зависящее. Я с готовностью жду возможности сражаться рядом с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880310,
					"content": "Мне нужно подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "#Не волнуйся, время ещё есть. Выйдем на арену, когда будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камисато Аяка"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Камисато Аяка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#{NICKNAME}, Аяка, мы тут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880402,
					"content": "Это был удивительный поединок. Я не очень хорошо разбираюсь в фехтовании, но даже на меня подействовала напряжённая атмосфера, царящая на арене. Моё сердце до сих пор колотится как бешеное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 736880403,
					"content": "Приёмы противника снова и снова удивляли Паймон, но, похоже, для вас они не были неожиданностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880404,
					"content": "#{NICKNAME}, госпожа Камисато, поздравляю с победой в показательном бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 736880405,
					"content": "Это же Сара! Ты тоже пришла посмотреть на состязание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880406,
					"content": "Всемогущий сёгун приказала мне проследить за состязанием. Вы продемонстрировали выдающееся мастерство владения мечом и слаженность действий. Вы не только показали зрителям красоту владения мечом, но и научили меня кое-чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 736880407,
					"content": "Вы нам льстите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880408,
					"content": "Вы вложили немало сил в подготовку к этому состязанию. Сегодняшний день знаменует собой прекрасное завершение события «Воинский дух». Всемогущий сёгун оценила ваши усилия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 736880409,
					"content": "Я должна вернуться в Тэнсюкаку и доложить всемогущему сёгуну о показательном бое. Прошу извинить меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 736880411,
					"content": "К слову, вы сейчас заняты? Если нет, то почему бы нам не отпраздновать победу в ресторане «Призрачная беседка»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 736880412,
					"content": "Отличная идея! Мы были настолько заняты состязанием, что давно не ели вкусняшек. Пойдёмте скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880413,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880414,
					"content": "Что такое, Аяка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Пустяки, просто начал сказываться эффект от победы. Кудзё Сара сказала, что этот бой её многому научил, как и меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880416,
					"content": "#Зрители, возможно, не заметили, но было множество моментов, в которых я была на волоске. Если бы ты не отвлекал{F#а} атаки противника на себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880417,
					"content": "Я бы не победила без тебя. Как я и предполагала, моё мастерство фехтования значительно уступает твоему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880418,
					"content": "Аяка, ты мне тоже много раз помогала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Правда? Мне вдруг захотелось сразиться с тобой разок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880421,
					"content": "По правде говоря, я мечтала о возможности поединка с тобой с тех пор, как мы впервые встретились. Это желание частично исполнилось сегодня в показательном бою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880422,
					"content": "В следующий раз мы обязательно проведём несколько раундов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Конечно. Но... до тех пор, не забывай беречь свой меч. Если однажды мне удастся его украсть, твоя жизнь тоже окажется в моих руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880424,
					"content": "Хе-хе... Я всегда хотела сказать что-то подобное. Мои слова прозвучали странно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880425,
					"content": "Фраза в стиле госпожи Орит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "Эй, в чём дело? О чём вы там болтаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880428,
					"content": "Мы как раз говорили о поединке, который должен определить, кто из нас лучший фехтовальщик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880429,
					"content": "Вау, Аяка буквально помешана на фехтовании. Разве вы не друзья? Зачем вам поединок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880430,
					"content": "Именно потому, что мы друзья. Мы должны постоянно общаться и учиться друг у друга.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880431,
					"content": "Хм, в этом есть определённый смысл.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880432,
					"content": "#{NICKNAME}, сохранишь мои слова в тайне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880433,
					"content": "А? Что ты говоришь, Аяка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 736880434,
					"content": "Ничего, пойдёмте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 736880426,
					"content": "Как мило.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Ты слишком скромна, Аяка.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
