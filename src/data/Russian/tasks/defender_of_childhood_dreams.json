						110120707
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120707,
					"content": "Не будь эти Одноглазики такими большими, я бы взял их домой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120708
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120708,
					"content": "Ой, а где брат? Куда это он ушёл?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120709
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120709,
					"content": "Разве вы не играете в прятки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120710,
					"content": "А, точно! Я так обрадовался, что совсем забыл об игре!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120711
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120711,
					"content": "#Давай поищем его вместе, {F#сестрёнка}{M#братец}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120703,
					"content": "Одноглазик лучше всех!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120704
					]
				}
			]
		},
		{
			"id": 1101208,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101212",
							"2"
						],
						"stepId": 1101212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайльд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120801,
					"content": "Братик... Один дядя мне сказал, что Одноглазик на самом деле машина-убийца...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120802
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120802,
					"content": "Чепуха, быть такого не может. Да и мал ты ещё для таких разговоров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120803,
					"content": "Угу. Я сразу понял, что тот дядя - обманщик. Одноглазик бьёт только плохих и защищает мир, и он - моя самая любимая игрушка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120804,
					"content": "Правильно. Тебя никто не обидит, пока Одноглазик рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120805,
					"content": "Хи-хи, это правда. Ну, я пошёл играть с Одноглазиком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120806,
					"content": "Эй, Тевкр, погоди...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120807,
					"content": "Дверь! Дверь закрылась! Как бы с Тевкром ничего не случилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120808,
					"content": "Тут есть другой путь. Скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				}
			]
		},
		{
			"id": 1101209,
			"completionStepIds": [
				1101213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101213",
							"2"
						],
						"stepId": 1101213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тевкр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120901,
					"content": "О, дверь открылась! Это ты сделал, братик?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120902
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120902,
					"content": "Да. Но ты подожди немного. Мне нужно убедиться, что здесь безопасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120903
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120903,
					"content": "Ай-яй... Может, не стоит его так баловать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				}
			]
		},
		{
			"id": 1101210,
			"completionStepIds": [
				1101203,
				1101214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101214",
							"2"
						],
						"stepId": 1101214,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тевкр"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121001,
					"content": "Фух... Наконец-то мы снова вместе. Ты не ранен, Тевкр?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121002,
					"content": "Ранен? Нисколечко. Здесь очень весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110121003,
					"content": "Тебе, может, и весело, а мы перепугались до смерти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110121004,
					"content": "А тут у нас... Какой большой зал! В нём Одноглазик принимает гостей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110121005,
					"content": "Именно. Здесь помещаются все его друзья. Может, сыграем в прятки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121006,
					"content": "А? Прямо сейчас? Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110121007,
					"content": "Но я приготовил для тебя... сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121008,
					"content": "Сюрприз! Какой сюрприз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110121009,
					"content": "Подожди немного, скоро ты сможешь его поискать. А пока закрой глаза, отвернись и посчитай до шестидесяти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121010,
					"content": "Хорошо... Шестьдесят - это очень долго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тевкр"
				}
			]
		},
		{
			"id": 1101211,
			"completionStepIds": [
				1101215
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101215",
							"2"
						],
						"stepId": 1101215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайльд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121101,
					"content": "Эй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121102,
					"content": "Чайльд? Так ты всё время был здесь. Чего это ты прячешься? Мог бы и выйти попрощаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110121103,
					"content": "Мгновенья прощания особенные. Сейчас я очень слаб, и мне не хочется, чтобы Тевкр, уплывая домой, запомнил меня таким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121104,
					"content": "Но всё же мне жаль, что я не смог попрощаться с ним лично...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121105,
					"content": "Я должен был сопроводить его домой сам. У меня, конечно, для этого есть подчинённые, но всё равно мне как-то неспокойно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121106,
					"content": "Тебе не кажется, что ты Тевкра разбаловал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110121107,
					"content": "Ха-ха... Не знаю почему, но мне было куда спокойнее, когда он ходил с вами. А ведь совсем недавно мы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121108,
					"content": "Ах, точно, я чуть не забыл вас отблагодарить. Не знаю, что без вас бы делал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121109,
					"content": "О, всё-таки совесть у тебя ещё осталась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110121110,
					"content": "Ещё кое-что. Давайте не забывать о нашем с вами уговоре. При случае мы должны сразиться ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121111,
					"content": "В этот раз на кону будет стоять моя честь Предвестника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121112,
					"content": "Буду с нетерпением ждать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "Ты сперва подлечись как следует. А когда проиграешь, не вздумай нам плакаться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110121115,
					"content": "Ха-ха-ха... Кто бы в следующий раз ни победил, я приглашаю вас к себе домой в гости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121116,
					"content": "Познакомлю вас с Тоней и Антоном. Они отличные ребята, скажу я вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121117,
					"content": "По рукам. Тем более, что мы уже пообещали Тевкру!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110121118,
					"content": "Ха-ха... Представляю, как Тевкр будет рад вас видеть. На том и порешим. Я буду с нетерпением ждать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121119,
					"content": "Ждать того дня, когда мы с вами, друзья, встретимся в Снежной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110121113,
					"content": "Тебе не победить меня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
	]
}