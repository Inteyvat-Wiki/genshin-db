					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайльд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Мы на месте. Перед вами Исследовательский институт игрушек Ли Юэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120102,
					"content": "Пришли, пришли! Я уже слышу, как внутри работают механизмы. Очуметь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120103,
					"content": "Что это за место? Откуда ты о нём узнал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120104,
					"content": "Насколько я понимаю, это один из исследовательских центров Дотторе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120105,
					"content": "Дотторе - один из Предвестников Фатуи. Он обожает ковыряться во всяком старье, такое у него хобби. Эти руины он модифицировал под свои цели изучения стражей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120106,
					"content": "Что? Выходит, стражи руин - это изобретения Фатуи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120107,
					"content": "Нет. Они куда более тесно связаны с Бездной, поэтому, строго говоря, они наши враги... Мы всего лишь их изучаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120108,
					"content": "Ну а почему стражи начали покидать это место... Может, Дотторе просто наигрался и утратил к этому месту интерес?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120109,
					"content": "Ну вот, ещё один Предвестник с дурным характером!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120110,
					"content": "Зато теперь понятно, почему ты со спокойным сердцем привёл сюда Тевкра. Кажется, у тебя всё схвачено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120111,
					"content": "Ну, я бы не сказал, что всё... Я не имею ни малейшего представления, что там внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120112,
					"content": "З-значит, безопасность брата тебя не беспокоит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120113,
					"content": "Ничего подобного. Я готов справиться с любой угрозой, какой бы она ни была. Так поступил бы любой старший брат, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120114,
					"content": "Даже Тевкр понимает, за что стоит сражаться. Эта же причина укоренилась в моей душе много лет назад...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120115,
					"content": "Братик, о чём вы там говорите? Давайте поскорее войдём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120116,
					"content": "Ха-ха, хорошо. За мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайльд"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "Я рад, что вы нашли меня первыми... Активировать Форму духа с ранениями стоило мне куда больших сил, чем я предполагал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120202,
					"content": "Не знаю, что бы я делал, найди меня Тевкр в таком жалком виде...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120203,
					"content": "А ты не боишься, что я прикончу тебя прямо на этом месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "#Ха-ха! Помнится мне, что у тебя тоже есть {F#брат}{M#сестра}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120205,
					"content": "Я пришёл к выводу, что ты не станешь убивать меня на глазах у младшего брата.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120206,
					"content": "Паймон поверить не может, что ты мог зайти так далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120208,
					"content": "Я ведь уже говорил... что никогда не откажусь потренироваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120209,
					"content": "Именно потому я, Тарталья, всегда становлюсь только сильнее. Ха-ха-ха...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120210,
					"content": "К тому же детские мечты разбить легко. Если их оставить без внимания, они сами распадутся на крохотные осколки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120211,
					"content": "Поэтому кто-то должен их защитить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120212,
					"content": "Дал слово - сдержи его. Совершил ошибку - попроси прощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120213,
					"content": "А если подарил кому-то мечту - береги её до последнего...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120214,
					"content": "Ведь для этого и есть семья, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Это тебе случайно ничего не напоминает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120217,
					"content": "Кхе-кхе... Ух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120218,
					"content": "Так, прекрати строить из себя крутого, и скорее пошли к врачу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120219,
					"content": "Дельное предложение, но сначала... У меня есть кое-что для Тевкра. Пожалуйста, передайте ему это от моего имени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120220,
					"content": "Что это? Это же фигурка Одноглазика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120221,
					"content": "Она самая. Давным-давно я заказал её у кузнеца и собирался подарить Тевкру по возвращении в Снежную. Но похоже, что сейчас такой сувенир будет куда более уместным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120222,
					"content": "Ух ты... Если подумать, то семье Чайльда повезло, что он у них есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120223,
					"content": "Ещё кое-что. Мне придётся уйти не попрощавшись. Пожалуйста, придумайте для Тевкра какое-нибудь объяснение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120224,
					"content": "Вы ведь поможете мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120225,
					"content": "«Клянись, клянись, клянись, и клятвы ты держись...»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
					"content": "Ха-ха-ха... «А тот лёд холодный, замерзай, негодный...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120228
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120228,
					"content": "Эта считалочка пробудила столько воспоминаний... Тебя Тевкр научил, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120229
					],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120229,
					"content": "Иди с миром.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120230
					]
				},
				{
					"id": 110120230,
					"content": "...Хорошо. Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайльд"
				},
				{
					"id": 110120226,
					"content": "«А если кто соврёт, то попадёт на лёд».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120207,
					"content": "Скажи, оно того стоило?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120208
					]
				}
			]
		},
		{
			"id": 1101203,
			"completionStepIds": [
				1101208,
				1101220
