				"points": []
			},
			"dialogs": [
				{
					"id": 110120401,
					"content": "#Госпо{F#жа}{M#дин} {NICKNAME}, юный господин Тевкр. Я ждал вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120402
					],
					"speakerTitle": "Андрей"
				},
				{
					"id": 110120402,
					"content": "Вас прислал Чайльд?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120403,
					"content": "Да. Господин Чайльд велел организовать юному господину Тевкру поездку домой. Прошу за мной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120404
					],
					"speakerTitle": "Андрей"
				},
				{
					"id": 110120404,
					"content": "Кто ты? Мой брат говорит, что нельзя никуда ходить с незнакомцами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120405
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120405,
					"content": "Но ты ведь всё это время был с нами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120406,
					"content": "Потому что я уже давно о вас знаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120407
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120407,
					"content": "Чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120408,
					"content": "В одном письме домой брат писал о вас. Тоня мне его прочитала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120409
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120409,
					"content": "Я вас сразу узнал, как только увидел, но... Тогда я забыл, как тебя зовут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120410
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120410,
					"content": "Какой необычный поворот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120411,
						110120413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120411,
					"content": "Мне было приятно познакомиться с тобой, Тевкр.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120412
					]
				},
				{
					"id": 110120412,
					"content": "Хе-хе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120415,
					"content": "Юный господин, корабль в Снежную скоро причалит. Нам следует подготовиться к отплытию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120416
					],
					"speakerTitle": "Андрей"
				},
				{
					"id": 110120416,
					"content": "Ой, так быстро...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120417
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120417,
					"content": "#Тогда... До свидания, {F#сестрёнка}{M#братец}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120418
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120418,
					"content": "Я буду ждать вас в гости. Вы обязательно-преобязательно должны когда-нибудь приехать в Снежную!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120419,
						110120421
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120419,
					"content": "Договорились!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120420
					]
				},
				{
					"id": 110120420,
					"content": "Поклянёмся на мизинцах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120423,
					"content": "«Клянись, клянись, клянись, и клятвы ты держись. Ну а если кто соврёт, то попадёт на лёд. А тот лёд холодный, замерзай, негодный!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120424,
					"content": "Хе-хе... Вот и договорились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120425
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120425,
					"content": "Попутного ветра, Тевкр! Пока-пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 110120421,
					"content": "Ну, если ты хочешь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120422
					]
				},
				{
					"id": 110120422,
					"content": "Конечно! Поклянёмся на мизинцах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Тевкр"
				},
				{
					"id": 110120413,
					"content": "Твой брат ничего плохого обо мне не говорил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120414
					]
				},
				{
					"id": 110120414,
					"content": "Нет. Он даже написал, что если мог бы, то ушёл с работы и вместе с тобой бродил в поисках приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Тевкр"
				}
			]
		},
