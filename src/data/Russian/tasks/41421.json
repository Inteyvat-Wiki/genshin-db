	"talks": [
		{
			"id": 4142101,
			"completionStepIds": [
				4142101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
