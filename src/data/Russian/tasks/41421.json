			"dialogs": [
				{
					"id": 414210801,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210802,
					"content": "Она говорит... что-то странное. Эндора не понимает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210803,
					"content": "Ручьи... Хм? Не понимаю. Спросила, нет ответа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210804,
					"content": "Тебе стоит развивать словарный запас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "У неё, наверное, есть причина перед нами не появляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210806,
					"content": "Не понимаю... Мы, духи вод, любим сливаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210807,
					"content": "Она... одна. Ей одиноко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210808,
					"content": "Может, это потому, что другие существа не могут с вами сливаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210809,
					"content": "Хм? Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210810,
					"content": "Потому что мы задохнёмся и утонем в ваших телах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210811,
					"content": "Вам поистине одиноко. Мы любим всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210812,
					"content": "Ах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210813,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210814,
					"content": "Взгляд Родии у Каменных врат! Маленькие создания воды. Это её разведчики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210815,
					"content": "Водяные создания? Как-то раз мы видели здесь создания чистых вод, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210816,
					"content": "Кажется, видели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Могучие воды... превращаются в животных. Очень опасных. Но слияние с ними... научит многому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210819,
					"content": "Отведите меня туда. Родия не в себе. Родия... делает воду горькой. Эндора научится говорить. Она всё ей объяснит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210820,
					"content": "Ты хочешь сказать, что можешь помочь нам?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Да, да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}, стоит попробовать. Других зацепок у нас всё равно нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210817,
					"content": "#Да? Я ничего не заметил{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
