				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "#Здравствуй, путешественни{F#ца}{M#к}! Давно не виделись. Как поживаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 414210102,
					"content": "Что, опять произошло что-то странное, Катерина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210103,
					"content": "По сравнению с прошлыми, это происшествие не такое уж и странное. Но тем не менее досадное оно потому, что влияет на экономику Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 414210104,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "Недавно вода в источнике у винокурни «Рассвет» без видимой причины стала горькой. Если так будет и дальше, винная индустрия города через несколько лет потерпит крах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 414210107,
					"content": "Подробнее ты можешь узнать у Коннора, работника винокурни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 414210105,
					"content": "Экономику Мондштадта?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Коннор"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "Вас прислала Гильдия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414210202,
					"content": "Именно так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210203,
					"content": "Какое облегчение. Что же касается проблемы... Вы всё поймёте куда лучше, если сами снимете пробу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414210204,
					"content": "В этой бутылке вода, взятая из источника совсем недавно. Она прошла все ступени очистки и абсолютно безопасна. Можете спокойно её попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414210205,
					"content": "И Паймон, и Паймон! Паймон тоже хочет попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210206,
					"content": "(Сделать глоток...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "Фе! Тьфу-тьфу-тьфу! Какая горькая...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210208,
					"content": "Традиционными методами очистки от горечи избавиться не удаётся, и дело вовсе не в составе воды. За этим наверняка стоит элементальная магия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414210209,
					"content": "Для производства вина такая вода совершенно не годится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414210210,
					"content": "Рыбе, должно быть, тоже худо пришлось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210211,
					"content": "Рыба в водоёме всплыла брюхом кверху. Мы попробовали эту рыбу приготовить, но мясо её оказалось таким же горьким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "Коннор"
				},
				{
					"id": 414210212,
					"content": "Паймон и подумать не могла о таком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210213,
					"content": "В общем, если вы спросите меня о зацепках, то я скажу, что нужно осмотреть территорию к северу. Хотелось бы знать, не случилось ли того же с рекой Бишуй и водами деревни Цинцэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Коннор"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142105",
							"2"
						],
						"stepId": 4142105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "Ой, смотри, что-то выпало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210502,
					"content": "Эндора... Воды нет...Только смерть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210503,
					"content": "Эндора - это твоё имя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210504,
					"content": "Горечь... это враг. Она убьёт... Эндору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210505,
					"content": "Что же делать? Как тебя спасти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210506,
					"content": "Туда, где воды сладки... Нужно к... родникам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210507,
					"content": "Эндора... живёт в воде. Без воды... Эндора лишится пристанища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210508,
					"content": "Как нам донести это существо до родника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210509,
					"content": "У нас с собой есть бутылка воды.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "Да, но она горькая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210511,
					"content": "Эндора... стерпит. Но... недолго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210512,
					"content": "Тогда нужно поспешить! Скорее, отправляемся к чистым родникам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210513,
					"content": "И всё же интересно, как Эндоре удалось забраться так далеко на спине Гидро слайма. Она чем-то похожа на нас, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4142106,
			"completionStepIds": [
				4142106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142106",
							"2"
						],
						"stepId": 4142106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "Здесь вода... сладкая. Эндора нашла... подобных себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210602,
					"content": "Эндора... и ей подобные... делают воду сладкой. Горечь... деяния Родии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210603,
					"content": "К слову, в Спрингвейле ведь ходят предания о родниковой фее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210604,
					"content": "Нам надо бы сходить к роднику и заменить горькую воду в бутылке на нормальную.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Старина Финч"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "...Кто вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414210702,
					"content": "А-а-а! Эндора, не стоит вот так вот выпрыгивать самой по себе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210703,
					"content": "Я Эндора. Фея чистых родников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210704,
					"content": "Точно. Этот дедушка - один из тех, кто искренне верит в существование родниковой феи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 414210705,
					"content": "...Хм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414210706,
					"content": "Вы с ней как две капли воды, но ты куда меньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414210707,
					"content": "Эндора... ещё маленькая! Эндора... учится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210708,
					"content": "Твоё появление всё-таки доказывает, что та встреча мне не привиделась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414210709,
					"content": "Она ещё здесь. Имя... неизвестно. Она не отвечает Эндоре.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210710,
					"content": "Эндора... хочет с ней поговорить. Эндора может ей передать. Что ты скажешь ей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210711,
					"content": "То есть она всегда была рядом? И ты можешь передать ей моё послание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414210712,
					"content": "Да, да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "Эндора"
				},
				{
					"id": 414210713,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414210714,
					"content": "Я так стар. Я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "Старина Финч"
				},
				{
					"id": 414210715,
					"content": "Передай ей от меня привет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Старина Финч"
				}
			]
		},
		{
