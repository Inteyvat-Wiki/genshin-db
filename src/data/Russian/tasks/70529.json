			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лиз"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705290201,
					"content": "Приветствую! Добро пожаловать на Праздник ветряных цветов. Вы как раз вовремя - мы подготовили игру под названием «Песнь ветров».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290202
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290202,
					"content": "В этой игре вы сможете сыграть несколько прекрасных мелодий, прямо как мондштадтские барды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290203,
						705290204
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290203,
					"content": "Как я могу состязаться с бардами?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				},
				{
					"id": 705290205,
					"content": "Не волнуйтесь! Эта игра... прошла тестирование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290206
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290206,
					"content": "Даже человек с нулевыми знаниями о музыкальных инструментах сможет сыграть что-то, что... э-э, не будет звучать совсем уж плохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290207
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290207,
					"content": "Пожалуйста, верьте мне. Верьте в рыцарей Ордо Фавониус!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290208
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290208,
					"content": "Если вы будете стараться не отставать от темпа и ритма, вы сможете с лёгкостью сыграть мелодию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290209
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290209,
					"content": "Думайте о ветре вокруг вас и прекрасной мелодии, которую хотите сыграть, и все тревоги рассеются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290210
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290210,
					"content": "В таком случае, полагаю, барды весьма беззаботны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290211
					]
				},
				{
					"id": 705290211,
					"content": "Ха-ха-ха, я бы не сказала! Как минимум, они беспокоятся о том, смогут ли их песни тронуть людей настолько, чтобы они выложили немного моры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290212
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290212,
					"content": "Что касается вас... Просто играйте в своё удовольствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290213
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290213,
					"content": "Кхе... Забудьте о том, что я только что сказала! Вам понятна суть игры? Не стесняйтесь, если хотите попробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290214
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290214,
					"content": "Вы можете сыграть представленные мелодии на своих инструментах. Если у вас нет инструментов, мы можем одолжить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290215
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290215,
					"content": "Не хочу хвастаться, но у нас их довольно много, и каждый разительно отличается от остальных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290216
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290216,
					"content": "Какой инструмент вы хотите использовать первым?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290217,
						705290218,
						705290219
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290217,
					"content": "Лиру ветров.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290220,
					"content": "Значит, таков ваш выбор?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290221
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290221,
					"content": "Я должна упомянуть ещё кое-что. Пожалуйста, подождите минутку, мне нужно свериться с записями...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290222
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290222,
					"content": "Хм... Так что... О да! Чтобы каждый участник мог играть красивые мелодии, мы предусмотрели этап настройки инструментов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290223
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290223,
					"content": "Проще говоря, мы поможем вам настроить инструмент так, чтобы он приобрёл наилучшее звучание. Не волнуйтесь, это просто. Сначала нужно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290224
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290224,
					"content": "Всё готово! Ваш инструмент настроен, а музыкальные партитуры готовы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290225
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290225,
					"content": "Вы можете начать в любое время. Если хотите, разумеется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиз"
				},
				{
					"id": 705290218,
					"content": "Цветочную цитру.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290219,
					"content": "Праздничный барабан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290204,
					"content": "А у меня точно получится?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				}
			]
		}
	]
}