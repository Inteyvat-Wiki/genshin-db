			"dialogs": [
				{
					"id": 221161801,
					"content": "#Ну что? Наш{F#ла}{M#ёл} для меня подходящую историю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161802
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161802,
					"content": "Вот мои заметки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161803
					]
				},
				{
					"id": 221161803,
					"content": "Превосходно! Но всё-таки чего не хватает. В конце концов, это просто дети... Возможно, через несколько лет у ребят случится настоящая романтическая история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161804
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161804,
					"content": "Однако я оставлю эти записки. Я подумаю, как развить романтическую линию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161805
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161805,
					"content": "Спасибо тебе за материалы. Вот твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
