			"dialogs": [
				{
					"id": 221160101,
					"content": "Как же мне начать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160102,
					"content": "Что ты собрался делать на этот раз?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "А, это снова ты. Я пишу роман... Вернее, пытаюсь писать. Никак не могу придумать достойное начало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160104,
					"content": "Сколько времени уже потратил, но пока ничего в голову не приходит... Когда же я напишу хоть что-нибудь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160105,
					"content": "#Ты же путешественни{F#ца}{M#к}, верно? Ну, расскажи мне, путешественни{F#ца}{M#к}, что самое главное в хорошей истории?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
