				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чан Девятый"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Эпичные битвы и реки крови!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Эпичные битвы... Реки крови... Неплохая идея. Надо подумать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160303,
					"content": "Деревня Цинцэ не очень вдохновляет писать про эпичные битвы и реки крови, если честно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160304,
					"content": "Мне нужно отправиться куда-то подальше! Куда-то, где много искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160305,
					"content": "Они постоянно ищут какие-нибудь сокровища и сражаются с монстрами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160306,
					"content": "Я как раз знаю местечко, где полно монстров. И не простых монстров, а достаточно серьёзных монстров! Да-да! Пойду туда и дождусь настоящего искателя приключений! Тогда мы станем свидетелями настоящей кровопролитной битвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160307,
					"content": "А потом... А потом у меня будет всё, что нужно! Ха-ха! Мы отправляемся без промедления! Поспеши!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
