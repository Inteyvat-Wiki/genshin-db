			"dialogs": [
				{
					"id": 221160201,
					"content": "Чтобы она была написана с душой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160202
					]
				},
				{
					"id": 221160202,
					"content": "Эй! Я задал серьёзный вопрос! Ты издеваешься надо мной?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
		{
