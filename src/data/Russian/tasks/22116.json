			"dialogs": [
				{
					"id": 221160801,
					"content": "К слову... Ты знаешь Сы Сы? Её можно встретить в порту, она ждёт моряка по имени Чао Си.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160802,
					"content": "Похоже, что она ждёт его каждый день... Наверняка у этих двоих есть интересная история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221160803,
					"content": "Предлагаю тебе провести расследование. Если найдёшь какие-нибудь интересные истории - дай мне знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
