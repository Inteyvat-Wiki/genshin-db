			"dialogs": [
				{
					"id": 221161001,
					"content": "Привет, Ци Мин! Сегодня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161002
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221161002,
					"content": "Сегодня я не смогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161003
					],
					"speakerTitle": "Ци Мин"
				},
				{
					"id": 221161003,
					"content": "Но я ещё даже ничего не предложил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161004
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221161004,
					"content": "И не нужно. Я прекрасно знаю, что ты хотел предложить. И сегодня я не смогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161005
					],
					"speakerTitle": "Ци Мин"
				},
				{
					"id": 221161005,
					"content": "Ладно... А когда ты сможешь, Ци Мин?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161006
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221161006,
					"content": "Когда-нибудь настанет день, когда я смогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161007
					],
					"speakerTitle": "Ци Мин"
				},
				{
					"id": 221161007,
					"content": "Ох, Ци Мин... Какой уклончивый ответ! Ци Мин, прошу, послушай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161008
					],
					"speakerTitle": "Чжи Хуа"
				},
				{
					"id": 221161008,
					"content": "Спасибо. Следующий!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161009
					],
					"speakerTitle": "Ци Мин"
				},
				{
					"id": 221161009,
					"content": "В смысле «следующий»?! Но я ещё не закончил! К тебе даже не стоит очередь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжи Хуа"
				}
			]
