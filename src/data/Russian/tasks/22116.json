				"objectNames": [
					"Малыш Мэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221161201,
					"content": "Лулу, на этот раз Фэй должен быть капитаном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 221161202,
					"content": "Хорошо! Почему я каждый раз - обычный матрос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 221161203,
					"content": "Играть веселее, когда капитан - Мэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 221161204,
					"content": "Это нечестно, Лулу. Я думаю, что Фэй играет очень хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 221161205,
					"content": "У всех хорошо получается играть только свою роль. Ты хороший капитан, я буду богатым купцом, а Фэй - матросом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 221161206,
					"content": "А эта игра будет самая весёлая! Что думаешь, Фэй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 221161207,
					"content": "Лулу, ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 221161208,
					"content": "Ладно, Лулу... Если ты так думаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 221161209,
					"content": "Фэй! Мы уже об этом говорили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 221161210,
					"content": "Ладно... Я не против, если Лулу так нравится. Давайте играть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 221161211,
					"content": "Капитан-шмапитан. Кому какая разница?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 221161212,
					"content": "Эх вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Мэн"
				}
			]
		},
