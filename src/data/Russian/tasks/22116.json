						221161702
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161702,
					"content": "Вот мои заметки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161703
					]
				},
				{
					"id": 221161703,
					"content": "Замечательно! Что-то не так с этим парнем Чао Си... Хотя... С ними обоими что-то не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161704
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161704,
					"content": "Можно ли назвать эту историю романтичной? Ну, не знаю... Однако для завязки сюжета эта история подойдёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161705
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161705,
					"content": "Спасибо тебе. Вот твоя награда. Пора приниматься за работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161706
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161706,
					"content": "Хм... Я думаю, что это подойдёт для моего романа. Но если что-то такое произойдёт в настоящей жизни... Без вмешательства Миллелитов не обойдётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161707
					],
					"speakerTitle": "Чан Девятый"
				},
				{
					"id": 221161707,
					"content": "Эта пара стоит на краю катастрофы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чан Девятый"
				}
			]
		},
