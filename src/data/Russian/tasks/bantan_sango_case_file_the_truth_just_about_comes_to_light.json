			"dialogs": [
				{
					"id": 400335101,
					"content": "Я продолжу расследование истории Чёрной тени. А ты займись животными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				}
			]
		},
		{
			"id": 4003352,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
