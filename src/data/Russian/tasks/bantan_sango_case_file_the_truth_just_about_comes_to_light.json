						],
						"stepId": 4003301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "О, вы как раз вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330102,
					"content": "Я только что закончил разведку в парочке подозрительных мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330103,
					"content": "Один из этих лагерей охраняется Шляпо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330104,
					"content": "Кхм-кхм, то есть Чёрной тенью. Если у вас нет других вопросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330105,
					"content": "А что со вчерашним расследованием?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "К текущему моменту у меня нет никакой информации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330107,
					"content": "Что? Но Санго же отправила тебя на разведку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400330108,
					"content": "Да, это так, но... Как бы вам объяснить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330109,
					"content": "Возьмём, например, «перезрелые фиалковые дыни» и «грязные отпечатки рук на двери». Для меня между ними нет ничего общего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330110,
					"content": "А Санго находит взаимосвязи между такими зацепками и с их помощью легко раскрывает сложные загадки, словно коробочку «ёсэгидзайку».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330111,
					"content": "«Перезрелые фиалковые дыни» и «грязные отпечатки рук на двери»... и как они связаны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400330112,
					"content": "Это была просто аналогия. Следуя её указаниям, я исследовал несколько мест на острове Ясиори и в лесу Тиндзю, а потом доложил ей обо всём, что видел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330113,
					"content": "А вот какие выводы она сделала - известно только ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330114,
					"content": "Честно говоря, только Сиканоин способен поспевать за ходом её мыслей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330115,
					"content": "Сиканоин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "Он из комиссии Тэнрё. Нам посчастливилось познакомиться с ним во время одного из прошлых расследований.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330117,
					"content": "Он довольно... своеобразный персонаж. Вы поймёте, что я имею в виду, если когда-нибудь встретите его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330118,
					"content": "Что ж, животных я поручаю тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330119,
					"content": "Паймон никак не может перестать думать о тех перезрелых фиалковых дынях...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003303",
							"2"
						],
						"stepId": 4003303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Рюдзи"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "Ах. Замечательно! Теперь все должны быть на месте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330302,
					"content": "Что? Почему кого-то по-прежнему не хватает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330303,
					"content": "О-о-о... Почему же это Паймон кажется, что всё опять затягивается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400330304,
					"content": "Это правда, что иногда для расследования нужно много терпения. Если пойти по неправильному пути, то в итоге можно вообще ничего не найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330305,
					"content": "Мы нашли уже много животных, так что, по крайней мере, движемся в правильном направлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330306,
					"content": "Возможно, мы просто пропустили несколько подсказок по пути или не проверили какое-то место, потому сейчас и зашли в тупик. Я думаю, что это временно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330307,
					"content": "Паймон поняла! Ты хочешь сказать, что сейчас нам не хватает немного чего-то этакого... в духе бум шака-лака!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400330308,
					"content": "М-м, да, что-то вроде этого. Но я бы сказал, что с бум шака-лакой у нас всё не так уж плохо - благодаря вам двоим, мы добились значительного прогресса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330309,
					"content": "(Он... действительно на одной волне с Паймон.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "Хи-хи, ты так здорово рассуждаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400330312,
					"content": "Ты мне льстишь. Это просто опыт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330313,
					"content": "Чем глубже зарыта истина, тем она ценнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330314,
					"content": "Жаль только, что на данный момент у нас нет никакой дополнительной информации. Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330315,
					"content": "Думаю, я просто расскажу Санго о том, чего мы добились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330316,
					"content": "Она наверняка сможет взглянуть на ситуацию под таким углом, который нам и в голову не приходил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330317,
					"content": "Давай так и сделаем! Паймон уверена, что ты отлично придумал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400330318,
					"content": "Тогда решено. Давайте встретимся в обычном месте, как только появятся новые подсказки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330319,
					"content": "Если в это время я буду занят, вы можете обратиться напрямую к Санго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Рюдзи"
				},
				{
					"id": 400330310,
					"content": "(Такое ощущение, что он уже довольно хорошо понимает Паймон...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
		{
			"id": 4003351,
