							"4003307",
							"2"
						],
						"stepId": 4003307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Санго"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400335201,
					"content": "Переживать не о чем, у меня уже появились кое-какие догадки. Рюдзи продолжит расследование дела Чёрной тени, а вы сосредоточьтесь на спасении животных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Санго"
				}
			]
		}
	]
