				"points": []
			},
			"dialogs": [
				{
					"id": 706570101,
					"content": "Здравствуйте! Я Лиз, рыцарь Ордо Фавониус. Вы наверняка слышали, что в Мондштадте проводятся всевозможные события по случаю Праздника ветряных цветов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570102,
					"content": "#Да, я кое-что слышал{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "Я отвечаю за то, чтобы все гости Мондштадта смогли по полной насладиться праздником!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570105,
					"content": "Из-за того что некоторые мероприятия проходят за городскими стенами, кто-то должен рассказывать гостям о всех доступных развлечениях. Было бы обидно, если кто-то пропустил бы замечательные игры, которые мы приготовили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570106,
					"content": "Сейчас рекомендую тебе принять участие в увлекательной игре «Прямо в яблочко»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570107,
					"content": "Правила игры просты! Порази как можно больше мишеней на скорость, чтобы заработать очки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570108,
					"content": "Звучит интересно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "Не переживай. Давай я отмечу место проведение игры на твоей карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570111,
					"content": "Чем больше очков ты наберёшь, тем ценнее будут награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570112,
					"content": "Интересно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "Не за что, обязательно попробуй! Если хочешь узнать о других интересных событиях - обращайся ко мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570115,
					"content": "Желаю тебе хорошо провести время!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лиз"
				},
				{
					"id": 706570113,
					"content": "Спасибо за объяснения!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "Звучит сложно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "Впервые слышу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				}
