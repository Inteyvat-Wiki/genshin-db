			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME} и Паймон! Я тут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080102,
					"content": "Муалани, ты уже здесь! Ага, и чудаки тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080103,
					"content": "Доброе утро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "Карья"
				},
				{
					"id": 150080104,
					"content": "Доброе утро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080105,
					"content": "Когда выдвигаемся в путь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "Вирамдра"
				},
				{
					"id": 150080106,
					"content": "Ха-ха, ты совсем как ребёнок! Не можешь дождаться начала путешествия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080107,
					"content": "Я хочу как можно скорее приступить к делу... Сама понимаешь, мы не на прогулку собираемся. И я надеюсь, мы будем относиться друг к другу несколько более профессионально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "Вирамдра"
				},
				{
					"id": 150080108,
					"content": "Не беспокойся, я профессионал своего дела. Кхм... Хорошо, наша экспедиция к таинственному объявляется открытой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080109,
					"content": "Ура!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080110,
					"content": "Первым делом спрошу: все видят эту статую?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080111,
					"content": "Ага! Это какая-то подсказка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080112,
					"content": "Нет, не подсказка. Это памятник первому вождю Народа Родников, который вернулся из экспедиции на таинственный остров и основал наше племя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080113,
					"content": "Перед отправлением мы должны прикоснуться к памятнику и попросить благословения у предков. Тогда экспедиция пройдёт благополучно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080114,
					"content": "...Твоё заявление имеет под собой теоретические основания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "Вирамдра"
				},
				{
					"id": 150080115,
					"content": "Теоретические основания? Нет, но мой учитель говорил, что без этого нельзя отправляться в экспедицию на таинственный остров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "Вирамдра"
				},
				{
					"id": 150080117,
					"content": "Отлично! Ты не стал спорить со мной о том, что не входит в область твоих знаний. Черта настоящего профессионала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080118,
					"content": "Конечно, но поскольку эта практика не имеет под собой теоретических оснований, я не смогу включить её в свою научную работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "Вирамдра"
				},
				{
					"id": 150080119,
					"content": "Все сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080120,
					"content": "Приветствую тебя, мой предок. Твоя наследница встанет на путь, которым ты однажды прошёл, дабы засвидетельствовать твои подвиги. Мы уходим под твоим бдительным оком и вернёмся под твоей защитой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080121,
					"content": "Такое ощущение, будто у нас впереди великое приключение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080122,
					"content": "Теперь приготовьтесь. Нам нужно найти первую подсказку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муалани"
				}
			]
		},
