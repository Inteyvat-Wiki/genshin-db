			"dialogs": [
				{
					"id": 150080401,
					"content": "Есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080402,
					"content": "Что это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080403,
					"content": "Это ключ, который откроет нам путь через стаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080404,
					"content": "У кохолазавров отличное обоняние, поэтому, даже если мы постараемся не шуметь и передвигаться ползком, они всё равно нас заметят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080405,
					"content": "А это растение поможет нам решить проблему! Потому что оно пахнет совсем как кохолазавры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080406,
					"content": "Мы вотрём сок растения в кожу и обманем обоняние кохолазавров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080407,
					"content": "Мы должны им натереться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080408,
					"content": "Не бойтесь! Это очень полезно для кожи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "Муалани"
				},
				{
					"id": 150080409,
					"content": "Муалани выжимает сок растения и покрывает вас ароматной маскировкой.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "Ой... Кожа теперь мокрая и скользкая. Но правда пахнет кохолазавром!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150080411,
					"content": "Отлично! Теперь давайте попробуем ещё раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Муалани"
				}
			]
		},
