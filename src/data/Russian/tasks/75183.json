					],
					"speakerTitle": "Ма'ча",
					"speakerSubtitle": "Эксперт по тренировкам Удела Благодатных Земель"
				},
				{
					"id": 751830102,
					"content": "#Я {F#готова}{M#готов}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Эксперт по тренировкам Удела Благодатных Земель"
				},
				{
					"id": 751830103,
					"content": "Мне нужно ещё немного времени, чтобы подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Эксперт по тренировкам Удела Благодатных Земель"
				},
				{
					"id": 751830106,
					"content": "Почему ты дрожишь? Это от простуды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751830107
					],
					"speakerSubtitle": "Эксперт по тренировкам Удела Благодатных Земель"
				},
				{
					"id": 751830107,
					"content": "Простуда? Нет, нет, что ты. Я дрожу от восторга, потому что восхищён вашим «накалом»! Давай, попробуй побить мой рекорд. Получи титул главного силача Удела Благодатных Земель!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ма'ча",
					"speakerSubtitle": "Эксперт по тренировкам Удела Благодатных Земель"
				}
			]
