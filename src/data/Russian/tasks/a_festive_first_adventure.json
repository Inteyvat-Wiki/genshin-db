					"Тянь Тянь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "Вот и финиш. А ты отлично летаешь... Ну, как тебе трасса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380302,
					"content": "Она ощущается очень по-праздничному!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Хе-хе, ну конечно! Я ведь сама их там расположила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380305,
					"content": "Предлагаю проследовать к следующей трассе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380303,
					"content": "Небесные фонари очень красивые...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
