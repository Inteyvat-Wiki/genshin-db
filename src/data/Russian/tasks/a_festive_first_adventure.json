			},
			"dialogs": [
				{
					"id": 413380201,
					"content": "Здесь начало трассы. Видишь? Все фонари уже на своих местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380202,
					"content": "#Так. Начинай, когда будешь готов{F#а}. Собирай фонари по пути к финишу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				}
			]
		},
		{
			"id": 4133803,
			"completionStepIds": [
