				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тянь Тянь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "Хм... Почему никто не пришёл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380102,
					"content": "Что стряслось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "#Путешественни{F#ца}{M#к}! Прошу, выслушай меня... Сейчас Праздник морских фонарей, и Гильдия решила им воспользоваться, чтобы заполучить новобранцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380104,
					"content": "Я слышала, что Малыш Цянь придумал игру, которая называется... чего-то там с чем-то там. А я плестись в хвосте не хочу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380105,
					"content": "Поэтому я тут тоже придумала одно событие. Называется оно... «Моё первое приключение»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380106,
					"content": "Короче говоря, я хочу с помощью небесных фонарей сделать воздушную трассу для планеров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380107,
					"content": "Чтобы желающие принять участие могли бы просто расправить свои планеры и лететь, следуя небесным фонарям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380108,
					"content": "И они бы не только испытали азарт приключения, но и увидели прекрасные виды Ли Юэ с высоты птичьего полёта рядом с небесными фонарями! Звучит классно, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380109,
					"content": "Я собиралась сделать две трассы, но Миллелиты потребовали, чтобы я сначала нашла кого-нибудь, кто оценил бы их безопасность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380110,
					"content": "У тебя богатый опыт приключений, не так ли? Поможешь оценить трассы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380111,
					"content": "Разумеется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "Спасибо тебе! Тогда отправляемся на гору Тяньхэн. Первая трасса начинается именно там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				}
			]
		},
		{
			"id": 4133802,
			"completionStepIds": [],
