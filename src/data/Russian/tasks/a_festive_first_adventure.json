			"dialogs": [
				{
					"id": 413380401,
					"content": "Вторая трасса начинается здесь. Все фонари тоже уже на месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380402
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380402,
					"content": "Начинай по готовности. Всё то же самое: лети к финишу и собирай фонарики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				}
			]
		},
