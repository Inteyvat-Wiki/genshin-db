				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380501,
					"content": "#Ну что ж, ты прош{F#ла}{M#ёл} обе трассы. Как они тебе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380502,
					"content": "Они очень неплохие.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "Вот и отлично. Теперь я могу доложить об этом Миллелитам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380504,
					"content": "Уверена, после такого захватывающего события вступить в Гильдию искателей приключений захотят больше народу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "Тянь Тянь"
				},
				{
					"id": 413380505,
					"content": "Кстати, вот твоя оплата за оценку трасс. Пожалуйста, прими её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тянь Тянь"
				}
			]
		},
