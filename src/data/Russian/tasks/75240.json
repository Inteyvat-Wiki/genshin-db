					"Науатлали"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "Друзья, добро пожаловать на Кубок героев Айяра! Я ведущая сегодняшнего турнира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Науатлали"
				},
				{
					"id": 752400102,
					"content": "Сегодня последний день турнира. Если ты хочешь победить, тебе нужно одолеть трёх лучших воинов подряд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Науатлали"
				},
				{
					"id": 752400107,
					"content": "Что такое Кубок героев Айяра?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "Это битва во славу Айяра! Побеждай соперника кулаками, оружием или любыми другими способами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Науатлали"
				},
				{
					"id": 752400109,
					"content": "А Айяр - это вообще что? Или кто?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "Друг мой, здесь задавать вопросы имеют право только чемпионы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Науатлали"
				},
				{
					"id": 752400111,
					"content": "#Поднимайся на арену! Посмотрим, {F#достойна}{M#достоин} ли ты подобной чести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Науатлали"
				}
			]
		},
