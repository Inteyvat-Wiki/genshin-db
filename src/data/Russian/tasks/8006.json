			"dialogs": [
				{
					"id": 80060801,
					"content": "Ух! Вестник Бездны, за которым ты так долго охотился, наконец-то уничтожен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060802,
					"content": "Нет времени на пустую болтовню. Устройство ордена Бездны активируется прямо сейчас, ещё не поздно его уничтожить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060803
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060803,
					"content": "Да! Давайте пойдём и посмотрим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
