				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80060501,
					"content": "Откуда взялся цветок так глубоко под землёй?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060502,
					"content": "Может, это дань памяти почившим хиличурлам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060503,
						80060504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060503,
					"content": "Я знаю, что это за цветок...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "Теперь и Паймон он кажется знакомым...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060506,
					"content": "Это интейват, национальный цветок Каэнри'ах. Он цвёл когда-то во всех уголках этой страны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060507,
					"content": "Его цветение длится всего две недели. Но если сорвать и унести цветок из Каэнри'ах, лепестки перестают расти и затвердевают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060508,
					"content": "Только после возвращения цветка на родную почву лепестки снова становятся мягкими и в конце концов превращаются в пыль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060509,
					"content": "Вот почему интейват символизирует «странника вдали от дома» и означает «тепло родины».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060510,
					"content": "#{M#Такой цветок сестра носит в волосах.}{F#Такой цветок я ношу в волосах с тех пор, как очнулась.}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "Ой! Получается, если этот цветок здесь, его принесли из...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060512,
					"content": "Ваше высочество, вы наконец-то согласились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80060513,
					"content": "Сосредоточившись на противостоянии небесному порядку, мы пренебрегли своей первоначальной миссией: возрождением родины.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "Мне следовало проявить больше решительности.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "Устройство почти готово. Ждём ваших указаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80060516,
					"content": "Какие у нас шансы?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "Теоретически... возможно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80060518,
					"content": "Неважно. Даже если шанс составляет лишь один процент...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "...мы и так давно в Бездне.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "Для них лучше вернуться в круговорот рождения и смерти, чем жить, утратив достоинство.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "Они не должны продолжать нести груз своих так называемых «грехов».",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "Это благословение для ордена, что вы приняли такое решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "Вестник Бездны"
				},
				{
					"id": 80060523,
					"content": "#{F#Итэр}{M#Люмин}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "#Что ты видел{F#а}? Можешь рассказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060525,
					"content": "#Да, ты долгое время был{F#а} в оцепенении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060526,
					"content": "Вы рассказываете Дайнслейфу о том, что только что видели...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "Хм. Говорят, что между близнецами существует особая связь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060528,
					"content": "Похоже, они пытаются снять проклятие с помощью какого-то устройства. Возможно, с помощью того предмета, который мы с вами видели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060529,
					"content": "#{M#Она}{F#Он} {M#упоминала}{F#упоминал} о возрождении родины, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060530,
					"content": "Верно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "Неудивительно. Само упрямство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060533,
					"content": "Судя по всему, орден планирует использовать это место, чтобы снять проклятие с хиличурлов и вернуть им их прежний вид... Они станут основой для возрождения Каэнри'ах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060534,
					"content": "В конце концов, не может быть «нации» без «народа».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060535,
					"content": "Что думаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "Пф-ф, верх глупости. У них нет шансов на успех. Ни одного шанса из ста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060538,
					"content": "Я уже говорил вам, что никто не знает это проклятие лучше меня, я прожил с ним пятьсот лет... Спасения нет. Проклятие необратимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060539,
					"content": "Попытка насильно развеять его не принесёт ничего, кроме новых страданий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060540,
					"content": "Поэтому не стоит зря мечтать. Лучше повторять себе снова и снова: это уже не люди.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060541,
					"content": "Ложные надежды и лишние эмоции ведут лишь к одному - падению... К тому, чтобы, подобно им, погрязнуть в лицемерии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060542,
					"content": "Лучше приберечь силы для чего-то более достойного спасения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060543,
					"content": "#Почему я {M#должен}{F#должна} тебе верить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060545,
					"content": "#Ха-ха... Конечно, я всего лишь тот, кого ты {M#нанял}{F#наняла} для задания, а вот {M#она твоя сестра}{F#он твой брат}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060546,
					"content": "#Ты можешь встать на {M#её сторону}{F#его сторону}, пойдя на поводу у чувств. Не проблема.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060547,
					"content": "Твой выбор, каким бы он ни был, не заставит меня передумать. Я избрал свой путь - остановить Бездну. Если мы не можем достигнуть согласия, можем тогда на этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060548,
					"content": "Поверю тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "Но это не значит, что я полностью тебе доверяю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "Вот как.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060552,
					"content": "Один шанс на спасение из ста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "Никто не вправе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "Не говоря уже о том, что эти хиличурлы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "Похоже, я не зря задал тебе те три вопроса при первой встрече. У тебя есть своё видение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060559,
					"content": "#Раз ты {M#поделился}{F#поделилась} тем, что у тебя на душе, я тоже выскажу, что думаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060560,
					"content": "Сейчас меня волнует не столько, как остановить Бездну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060561,
					"content": "...сколько то, как не позволить ордену Бездны попрать последнюю волю Хальфдана и моих других соотечественников. Я должен положить этому конец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060562,
					"content": "Понимаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "Орден Бездны может появиться в любой момент. Идём дальше и будь начеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				},
				{
					"id": 80060563,
					"content": "Предлагаю объединить усилия.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "...уже выбрали себе последнее пристанище.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "...делать такой выбор за других существ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "Девяносто девять процентов вероятности мучительной смерти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#Это означает только то, что я не одобряю методы {M#моей сестры}{F#моего брата}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "У них есть шанс?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "#{M#Говорила}{F#Говорил}, что это {M#её}{F#его} миссия.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "#Я {M#видел}{F#видела} такие цветы раньше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		},
		{
			"id": 800606,
			"completionStepIds": [
				800606
