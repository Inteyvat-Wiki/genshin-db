			},
			"dialogs": [
				{
					"id": 80060401,
					"content": "Примитивный лагерь хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060402,
					"content": "Эти хиличурлы выглядят совсем ослабевшими... А кто-то как будто уже не дышит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060403,
					"content": "Хальфдан хотел, чтобы мы это увидели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 80060404,
					"content": "Так это или нет, но здесь стоит всё как следует изучить. Осмотрите всё вокруг и не упустите ни одной детали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дайнслейф"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
				800609,
				800610,
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800605",
							"2"
						],
						"stepId": 800605,
