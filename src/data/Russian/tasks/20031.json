			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "Давно не виделись, восходящая звезда Гильдии искателей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310102,
					"content": "Как проходят твои приключения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310103,
					"content": "Отлично.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "Славно. Так держать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310107,
					"content": "Похоже, что у тебя уже достаточно опыта. Настала пора рассказать тебе, как устроена Гильдия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310108,
					"content": "Каждый день мы получаем запросы о помощи со всего континента и раздаём эти <color=#00E1FFFF>поручения</color> нашим искателям приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310109,
					"content": "Плата за выполненные поручения - это основной доход членов Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310110,
					"content": "А какие бывают поручения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200310111,
					"content": "Самые разнообразные! От доставки посылок до уничтожения монстров. Некоторые крайне простые, а некоторые могут заставить попотеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310112,
					"content": "Но лучше один раз попробовать, чем сто раз услышать! Начни с чего-нибудь попроще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310113,
					"content": "Вот доступные поручения на сегодня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310114,
					"content": "Доложи мне о выполненных поручениях, и я выдам тебе щедрую награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310115,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "Отлично! Я знала, что на тебя можно рассчитывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310119,
					"content": "#С нетерпением буду ждать твоего возвращения, {NICKNAME}! К звёздам и к безднам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310117,
					"content": "Насколько щедрую?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "Не переживай, скоро узнаешь. Уверена, что награда тебя не разочарует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310105,
					"content": "Тяжеловато.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "Поначалу всегда тяжело. Не забывай хорошенько готовиться к каждому приключению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Катерина"
				}
			]
		},
