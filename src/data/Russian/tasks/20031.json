			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#Мне доложили о твоей работе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310402,
					"content": "#Говорят, что ты выполнил{F#а} <color=#00E1FFFF>поручение</color> Гильдии. Заказчик просил выразить тебе свою благодарность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310403,
					"content": "Какое поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310404,
					"content": "#Ты помог{F#ла} человеку, встретившемуся у тебя на пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310405,
					"content": "Почти все, кто нуждается в помощи, оставляли заявку в Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310408,
					"content": "Позволь мне объяснить тебе, как устроена Гильдия искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310409,
					"content": "Каждый день мы получаем запросы о помощи со всего континента и раздаём эти поручения нашим искателям приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310410,
					"content": "Плата за выполненные поручения - это основной доход членов Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310411,
					"content": "Кстати, у Гильдии есть для тебя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310406,
					"content": "Всегда нужно помогать людям в беде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310407,
					"content": "Именно это и делает тебя восходящей звездой Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Катерина"
				}
			]
		},
