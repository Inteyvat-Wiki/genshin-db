			"dialogs": [
				{
					"id": 200310201,
					"content": "#Отличная работа, {NICKNAME}! Для первого раза очень даже неплохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310202,
					"content": "Заказчики лично просили тебя отблагодарить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310203,
					"content": "Награда ждёт тебя, как и было обещано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				}
