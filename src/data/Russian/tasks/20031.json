				"points": []
			},
			"dialogs": [
				{
					"id": 200310301,
					"content": "Мы с удовольствием примем эту награду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 200310302,
					"content": "Славно. Это знак признания Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310303,
					"content": "Мы получаем множество заказов каждый день, а свободных искателей приключений вечно не хватает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310304,
					"content": "Если будешь выполнять достаточное количество поручений каждый день, то получишь от меня дополнительную награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310305,
					"content": "Ты можешь отслеживать количество выполненных поручений с помощью лицензии искателя приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310306,
					"content": "Но учти, что ты можешь забрать награды только за поручения, выполненные в тот же день. Количество наград ограничено, так что не забывай заходить за ними вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310307,
					"content": "Понятно. Спасибо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "#Не стоит благодарности. Ты {F#заслужила}{M#заслужил} эту награду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310312,
					"content": "Ежедневные поручения также можно выполнять в группах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310313,
					"content": "Мы приветствуем активное сотрудничество между искателями приключений! К звёздам и к безднам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310309,
					"content": "Всего одна награда в день?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "Прости, но это всё, что Гильдия может себе позволить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 200310311,
					"content": "Мы работаем над тем, чтобы искатели приключений получали более достойные награды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Катерина"
				}
			]
		},
