							"2"
						],
						"stepId": 4020402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дарвиш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402040201,
					"content": "Ну как? Хотите узнать правила игры «Записи о сражениях соратников»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040202
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040202,
					"content": "Да, начинаем!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040203
					]
				},
				{
					"id": 402040203,
					"content": "Давайте я открою обучающую карту и игровую доску...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дарвиш"
				}
			]
		}
	]
}