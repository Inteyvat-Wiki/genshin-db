	"talks": [
		{
			"id": 4020401,
			"completionStepIds": [
				4020401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4020401",
							"2"
						],
						"stepId": 4020401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фадаве",
					"Аташье",
					"Дарвиш"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402040101,
					"content": "Аташье! Я изо всех сил стараюсь сохранять спокойствие, но эти отчёты, которые ты постоянно приносишь, бесполезны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040102
					],
					"speakerTitle": "Фадаве"
				},
				{
					"id": 402040102,
					"content": "Только посмотри, что ты пишешь! «Возможно», «вероятно», «приблизительно»... Как прикажешь строить на этом математическую модель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040103
					],
					"speakerTitle": "Фадаве"
				},
				{
					"id": 402040103,
					"content": "Э-э-э... У меня недостаточно времени! Не говоря уже о том, что я из Кшахревара! Откуда мне вообще знать, как измерять влияние на живые организмы? В-возьмём плесенников, к примеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040104
					],
					"speakerTitle": "Аташье"
				},
				{
					"id": 402040104,
					"content": "Что мне вообще делать с плесенниками? Сунуть руку ему в пасть, чтобы он укусил, а я записал что-то вроде: «Хмм, а это неожиданно сильный укус»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040105
					],
					"speakerTitle": "Аташье"
				},
				{
					"id": 402040105,
					"content": "Дарвиш, ты же из Амурты! Поддержи меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040106
					],
					"speakerTitle": "Аташье"
				},
				{
					"id": 402040106,
					"content": "Ха-ха, если хочешь знать моё мнение, ты плохо изучил основы биологии. Все знают, что у плесенников нет никаких пастей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040107
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040107,
					"content": "Ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040108
					],
					"speakerTitle": "Фадаве"
				},
				{
					"id": 402040108,
					"content": "Но, Фадаве, сейчас нам не нужна слишком точная модель. На этот раз мы выполняем исследование не для чопорных старых учёных из Академии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040109
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040109,
					"content": "Цель этого небольшого проекта - дать знания детям. Он должен быть увлекательным, так что если использовать немного воображения, это пойдёт только на пользу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040110
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040110,
					"content": "Ну, если ты так говоришь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040111
					],
					"speakerTitle": "Фадаве"
				},
				{
					"id": 402040111,
					"content": "Фадаве, ты относишься к Дарвишу совсем иначе, чем ко мне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040112
					],
					"speakerTitle": "Аташье"
				},
				{
					"id": 402040112,
					"content": "Хорошо, хорошо, не нужно спорить. Я почти закончил всё, над чем работал, и я проверил выводы Аташье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040113
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040113,
					"content": "Кроме того, данные можно будет корректировать после испытания. В этом и заключается весь смысл испытания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040114
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040114,
					"content": "А-ах, это наш Дарвиш... Всегда разумный и организованный! В отличие от кое-кого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040115
					],
					"speakerTitle": "Фадаве"
				},
				{
					"id": 402040115,
					"content": "Да, конечно... Я не буду спрашивать, кто этот «кое-кто».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040116
					],
					"speakerTitle": "Аташье"
				},
				{
					"id": 402040116,
					"content": "Ладно, перестаньте. Нам осталось сделать последние приготовления!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040117
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040117,
					"content": "К-как скажешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040118
					],
					"speakerTitle": "Фадаве"
				},
				{
					"id": 402040118,
					"content": "Я схожу и проверю, высохла ли краска...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040119
					],
					"speakerTitle": "Аташье"
				},
				{
					"id": 402040119,
					"content": "Кстати, об испытании... Вы случайно не хотите мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040120
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040120,
					"content": "Вы стоите здесь и смотрите на нас уже целую вечность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040121
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040121,
					"content": "А? Мы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040122,
					"content": "Да-да, хотите принять участие? Вы сможете съесть целую гору свежих фруктов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040123,
						402040125
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040123,
					"content": "Надо пробовать новые сорта фруктов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040124
					]
				},
				{
					"id": 402040124,
					"content": "Нет... Дай-ка подумать, как лучше объяснить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040130,
					"content": "Сначала я задам вам вопрос... Кто победит в бою: скользкий растягивающийся Пиро плесенник или тигр ришболанд?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040131,
						402040134,
						402040137
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040131,
					"content": "Скользкий растягивающийся Пиро плесенник...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040132
					]
				},
				{
					"id": 402040132,
					"content": "Правда? А я думаю, что тигр ришболанд выглядит более боевым... У него такие когти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040133,
					"content": "Какой странный вопрос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040140,
					"content": "И ещё... Кто сильнее - парящий Анемо плесенник или Анемо слайм? Кто сильнее: Пустынники или заврианы-воины из Натлана? Или Кайраги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040141
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040141,
					"content": "Именно такие вопросы всегда задают дети, когда мы пытаемся их учить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040142
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040142,
					"content": "Малыши обожают спрашивать подобное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040143,
					"content": "Ха-ха, но любопытство детей необходимо для процесса обучения. Они «хотят знать»... вот почему мы этим занимаемся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040144
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040144,
					"content": "«Записи о сражениях соратников» созданы в подражание настоящим военным играм! Позвольте детям смоделировать создание своего отряда искателей приключений, а затем сразиться с врагом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040145
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040145,
					"content": "Аташье как раз занимается изучением влияния диеты и окружающей среды на разных существ. А Фадаве помогает моделировать «симуляцию развития».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040146
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040146,
					"content": "Симуляция развития?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040147
					]
				},
				{
					"id": 402040147,
					"content": "Ну, в конце концов, вы же не можете позволить своим детям общаться с настоящими плесенниками или Пустынниками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040148
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040148,
					"content": "Если будет время, приходите взглянуть, хе-хе. Участвуя в испытании, вы приносите пользу проекту и одновременно получаете ценный академический опыт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040149
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040149,
					"content": "#Ого, звучит отлично... Да, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040150
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040150,
					"content": "Паймон, мудрая собирательница знаний!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040151
					]
				},
				{
					"id": 402040151,
					"content": "Не надо Паймон недооценивать! Паймон умная и станет ещё умнее! Давай примем участие в исследовании!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040152
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040152,
					"content": "#Тогда добро пожаловать на испытание, {NICKNAME}! Ха-ха, и, конечно же, будущий великий мудрец Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040153
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040153,
					"content": "Когда захотите попробовать, дайте знать. Мне ещё нужно объяснить вам правила «симуляции развития».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040134,
					"content": "Конечно же, тигр ришболанд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040135
					]
				},
				{
					"id": 402040135,
					"content": "Ага! Паймон тоже думает, что тигр ришболанд сильнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040136,
					"content": "Какой странный вопрос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040137,
					"content": "Победит скользкий тигр ришболанд!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040138
					]
				},
				{
					"id": 402040138,
					"content": "Что за «скользкий тигр ришболанд»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040139,
					"content": "Хм, кто задаёт такие странные вопросы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040125,
					"content": "Да нет, нам просто интересно смотреть, как люди спорят...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040126
					]
				},
				{
					"id": 402040126,
					"content": "#Ты что говоришь! Звучит так, будто мы с тобой {F#две чудачки}{M#два чудака}, проходившие мимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040127,
					"content": "Давай сначала послушаем, что он хочет проверить, а потом решим. А раз речь зашла о свежих фруктах... Паймон не прочь узнать, что они изучают...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 402040128,
					"content": "О, маленькая белая дама такая любопытная. Наверняка в путешествиях удача благоволит тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040129
					],
					"speakerTitle": "Дарвиш"
				},
				{
					"id": 402040129,
					"content": "Позвольте мне объяснить... С чего бы начать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "Дарвиш"
				}
			]
		},
		{
			"id": 4020402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
