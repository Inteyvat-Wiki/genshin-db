				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "Так вот как живут богачи Инадзумы? Паймон ожидала что-то более... роскошное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030402,
					"content": "Сложно переплюнуть Нефритовый дворец.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "Добро пожаловать в резиденцию Камисато. Госпожа вас уже давно ожидает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030405,
					"content": "Это та Сирасаги Химэгими, о которой ты постоянно говоришь? Где же она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030406,
					"content": "Кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030407,
					"content": "А... За ширмой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030408,
					"content": "Ха-ха, как старшая дочь комиссии Ясиро, госпожа Камисато обычно принимает гостей именно так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030409,
					"content": "Можно сказать, что это древняя традиция комиссии Ясиро. Надеюсь на ваше понимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030410,
					"content": "Можно понять.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "Логично, всё-таки она такая важная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030413,
					"content": "Прошу прощения, что после долгого и утомительного путешествия вам приходится терпеть такой неподобающий приём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030414,
					"content": "С величайшим нетерпением ждала я вашего прибытия, и рассказы Томы дают мне уверенность, что у вас есть сила переломить ситуацию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030415,
					"content": "Ныне в Инадзуме именем Охоты на Глаза Бога бесцеремонно попирают желания народа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030416,
					"content": "Хотя служит комиссия Ясиро сёгуну, по долгу службы мы ближе всего к народу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030417,
					"content": "Источник власти комиссии - доверие народа. Закрыть глаза на эту ситуацию - значит быть безучастным к собственной судьбе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030418,
					"content": "#Путешественни{F#ца}{M#к}, одолжи нам свою силу, и мы сможем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030419,
					"content": "Я просто хочу встретиться с сёгуном Райдэн.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "А...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030422,
					"content": "Госпожа, я говорил... Так не получится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030423,
					"content": "Мне пора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "Нет, пожалуйста... Подожди! Пожалуйста... Не уходи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030425,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030426,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "Я представлю тебя сёгуну Райдэн, но при одном условии... Выполни три моих небольших желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030428,
					"content": "Что за желания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030429,
					"content": "Они касаются трёх людей, которые лишились своих Глаз Бога... Возможно, встретившись с ними, ты поймёшь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030430,
					"content": "Воин, защищающий деревню, бывший самурай, который участвовал в Охоте на Глаза Бога, и мечник, некогда мечтавший стать лучшим в мире...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030431,
					"content": "Верно. Пожалуйста, постарайтесь помочь им. Я буду ждать вас здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030432,
					"content": "#Я {M#согласен}{F#согласна}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "Хе-хе... Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "Камисато Аяка"
				},
				{
					"id": 20030435,
					"content": "#Удачи, {M#приятель}{F#подруга}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030433,
					"content": "Столько хлопот...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "Я не собираюсь участвовать в восстании.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "(Даже немного обидно...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030403,
					"content": "Сложно переплюнуть винокурню «Рассвет».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				}
