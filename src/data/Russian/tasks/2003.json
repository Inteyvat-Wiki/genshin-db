			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Тома"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "Вот мы и пришли. А где Тома?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030102,
					"content": "Эх, что-то Паймон его не видит. Неужели он забыл своё обещание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030103,
					"content": "Кто забыл обещание? Это я уже подумал, что вы забыли про меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030104,
					"content": "Что?! Это с нами пёс говорит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030105,
					"content": "Ха-ха-ха, не надо так удивляться. Вы меня, я так понимаю, первый раз в этой форме увидели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030106,
					"content": "Ты... собака?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "А... Вы с таким раньше в Ли Юэ не встречались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030109,
					"content": "Ах вот оно что. Ну теперь Паймон всё поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030110,
					"content": "Что-то тут не так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "Ха-ха-ха... Ладно-ладно, больше так шутить не буду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030113,
					"content": "Эй! Сейчас напросишься на обидное прозвище!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030114,
					"content": "И на Рито, и в чайном доме... У меня было свободное время, ведь я вас так долго ждал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030115,
					"content": "Вот и придумал для вас такой особый приём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030116,
					"content": "Но всё же я должен попросить прощения за разные «испытания», которым я вас подверг. Это было необходимо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030117,
					"content": "Мне нужно было определить, приводить ли вас к Камисато и хватит ли у вас смелости вместе с нами предстать перед молнией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030118,
					"content": "Не думай, что стал вдруг серьёзным и Паймон тебя сразу простит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030119,
					"content": "Ха-ха... Я перестарался, да? Прошу прощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030120,
					"content": "Так что насчёт наших «испытаний»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "Ты с самого начала считаешь себя выше некоторых «правил», так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030123,
					"content": "Потому что твоя воля непоколебима и непреклонна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030124,
					"content": "У нас был такой друг давно... но после удара молнии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030125,
					"content": "Ты про того друга Кадзухи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "А, так вы тоже слышали о нём. Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030128,
					"content": "Похоже, его сияние всё не угасает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030129,
					"content": "То есть мы сможем встретиться с Сирасаги Химэгими?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "Да, конечно. Я отведу вас в резиденцию Камисато, где находится комиссия Ясиро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030131,
					"content": "Но сначала мне хотелось бы, чтобы вы со мной кое-куда сходили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030132,
					"content": "А? Куда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030133,
					"content": "Я хочу, чтобы вы сходили со мной к статуе всевидящего божества. Она ещё строится, но её уже видно с любой точки острова Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030126,
					"content": "Который погиб в дворцовой дуэли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "Предстать перед молнией?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "Это же просто собака...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "А куда человеческий Тома делся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тома"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "Здесь довольно мрачно... Сюда, наверное, мало кто ходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030202,
					"content": "Ой, Паймон кажется или эти штуки в статуе - это всё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030203,
					"content": "Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030204,
					"content": "Глаза Бога! То есть все отобранные во время Охоты Глаза Бога вставляют в эту статую?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030206,
					"content": "Почему сёгун объявила Охоту на Глаза Бога?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "То есть вы уже слышали об Охоте на Глаза Бога.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030207,
					"content": "Я расскажу, но сначала хочу напомнить, что Мондштадт - город свободы, Ли Юэ - город контрактов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030208,
					"content": "А Инадзума... страна вечности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030209,
					"content": "Сёгун Райдэн не только высший правитель Инадзумы, но и её божество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030210,
					"content": "Эта «вечность» - её неизменная и непоколебимая воля править Инадзумой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030211,
					"content": "Поэтому она опирается на Трикомиссию, чтобы управлять страной, и указ Сакоку, чтобы ограничить передвижение людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030212,
					"content": "Сёгун хочет, чтобы Инадзума оставалась в покое, чтобы поток времени свободно обтекал её, не задевая. И так вечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030213,
					"content": "Похоже, что у каждого бога свои взгляды...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030214,
					"content": "Конечно, это всего лишь моё мнение. А что касается причин недавнего указа об Охоте на Глаза Бога...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030215,
					"content": "Возможно, сёгун считает, что Глаза Бога могут дать народу силу к переменам, а в её «вечности» нет места подобным «неровностям».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030216,
					"content": "Какими бы ни были причины, сёгун Райдэн поручила комиссии Тэнрё конфисковать все Глаза Бога в стране и вставить их в статую...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030217,
					"content": "Теперь статую всевидящего божества можно считать символом вечности Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030218,
					"content": "Но тогда получается, что сёгун Райдэн довольно эгоистичная?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030219,
					"content": "Ха-ха, никто кроме вас, чужеземцев, не осмелился бы так прямо критиковать сёгуна Райдэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030220,
					"content": "Но... я соглашусь. Охоты на Глаза Бога быть не должно, и госпожа Камисато с самого начала решительно борется с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030223,
					"content": "Что это был за звук?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#А? {NICKNAME}, что с тобой? Такое выражение лица...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030222,
					"content": "А? Какой звук? Я ничего не слышал... Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030225,
					"content": "#Я как будто услышал{F#а}... желания людей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "#Да, ты {M#коснулся}{F#коснулась} статуи, а потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20030226,
					"content": "«Желания»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030227,
					"content": "Хм... Это подтверждает одну из версий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030228,
					"content": "Вы слышали? Когда желания человека достигают определённой силы, он может получить благословение Архонтов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030229,
					"content": "Так и появляются Глаза Бога... Можно сказать, что они - символ желаний человека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030230,
					"content": "#Если то, что ты сказал{F#а}, - правда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030232,
					"content": "То есть Глаз Бога означает не силу, а желание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "...то желания этих людей даже сильнее, чем я думал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030233,
					"content": "Ладно, дорогие гости, нас ждёт следующая остановка в нашем туре по острову Наруками - резиденция Камисато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "Тома"
				},
				{
					"id": 20030234,
					"content": "Наконец-то!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
