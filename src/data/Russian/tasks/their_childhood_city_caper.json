			"dialogs": [
				{
					"id": 240051201,
					"content": "Прости, что приходится тебя беспокоить. Я о них позабочусь. Нельзя, чтобы они так убегали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051202
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240051202,
					"content": "Если я стану критиком для «Паровой птицы», то смогу зарабатывать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240051203,
					"content": "Но господин Делерю сказал, что нельзя становиться критиком только ради моры. Иначе жизнь пойдёт по кривой дорожке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051204
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240051204,
					"content": "Но мне так нужна мора... Что же делать?.. Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орель"
				}
			]
		}
