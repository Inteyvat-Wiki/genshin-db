					"Лави"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Ну давай же, братец, сюда! Кажется, этот большой дом мы ещё не видели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240050102,
					"content": "Не спеши, Верут, а то снова упадёшь. И ты тоже, Лави. Твой папа говорит, что у тебя слабое здоровье и ты легко можешь простудиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050103,
					"content": "Ох, твой братец - такой зануда! Прямо как моя мама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050104,
					"content": "Точно-точно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240050105,
					"content": "Опять вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050106,
					"content": "Снова встретились.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#Привет, {M#братец}{F#сестрица}! В этот раз мы не в прятки играем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050109,
					"content": "Вернее сказать, совсем ни во что не играем. И госпожа Нур нас отчитала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050110,
					"content": "Когда она занята работой, то такая строгая. Всех отчитывает. А я ведь её печеньем угощала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050111,
					"content": "Впрочем, нам прятки и так надоели. Я хотела угостить Верута и Ореля чем-нибудь вкусненьким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050112,
					"content": "#{M#Братец}{F#Сестрица}, хочешь с нами... ммм... как это называется?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050113,
					"content": "Прогуляться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050114,
					"content": "Да, прогуляться! Пойдём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050115,
					"content": "Отправимся к площади. Хочу посмотреть на фонтан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240050116,
					"content": "Хорошо, веди нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Хорошо! Сначала... Пойдём на площадь. Там такой красивый фонтан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050117,
					"content": "Тогда мы идём за тобой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "Что делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
			"id": 2400502,
			"completionStepIds": [
				2400502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
