							3517.42,
							451.24,
							4655.845
						],
						"pointId": 340100216
					}
				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Это и есть «Паровая птица»? Выглядит простенько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050302,
					"content": "Да, самое обычное место.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "Ух ты, здесь и правда есть механическая птица!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240050305,
					"content": "Ага! Мы с папой здесь часто покупаем газеты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050306,
					"content": "Он обожает «Паровую птицу». Он может её читать целый день без остановки. Иногда он даже вырезает кусочки газеты и складывает в специальную книгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050307,
					"content": "Папа называет эту книгу сборником своих критических заметок, и иногда зачитывает их нам с мамой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050308,
					"content": "Нам не очень нравится. Мы обычно отвечаем «ага» и «ничего себе», но папа не замечает, ему такое чтение нравится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050309,
					"content": "Что он понимает под «критическими заметками»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Говоря по-простому, это личное мнение, которое человек высказывает по какому-либо вопросу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050311,
					"content": "Отец Лави, господин Делерю, - учёный из Исследовательского института Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050320,
					"content": "В то же время он является критиком, и его статьи публикуются в «Паровой птице».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050312,
					"content": "И он обожает свои критические заметки... обо всём, что угодно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050313,
					"content": "Бывает, ему придёт в голову какая-то мысль прямо посреди разговора, и он тут же бежит в свою комнату, чтобы записать в черновик. В такие моменты он может даже обед пропустить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050314,
					"content": "Неужели можно заработать мору на своём мнении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240050315,
					"content": "Разумеется, это не сделает тебя хорошим критиком. Нужно следовать некоторым принципам. Только тогда твою работу признают остальные...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050316,
					"content": "#Хм... Верут, {M#братец}{F#сестрица}, вы проголодались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050317,
					"content": "Господин Луи говорил, что у него в продаже появился картофель во фритюре под пузыринным соусом. Давайте попробуем! Я угощаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Лави"
				},
				{
					"id": 240050318,
					"content": "Ой, конечно! Хватит болтать! Идём, братец!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Верут"
				},
				{
					"id": 240050319,
					"content": "Ох уж эти двое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Орель"
				},
				{
					"id": 240050303,
					"content": "Ничего особенного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
