			"dialogs": [
				{
					"id": 760220101,
					"content": "Не дёргайся, а не то хуже будет... Давай сюда свою мору!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220102
					],
					"speakerTitle": "Разгневанный самурай"
				},
				{
					"id": 760220102,
					"content": "Спасите! Помогите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220103
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220103,
					"content": "Надо ему помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
