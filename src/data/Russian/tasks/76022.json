							2256.6,
							200.1,
							9292.6
						],
						"pointId": 12128
					},
					{
						"sceneId": 3,
						"position": [
							2257.2,
							199.6,
							9300.5
						],
						"pointId": 13301
					}
				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "Эй, громила! Что ты делаешь? А ну, прекрати!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760220202,
					"content": "#Мора... Ох, нет! Это ты убил{F#а} Мурасаки... Умри!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Разгневанный самурай"
				},
				{
					"id": 760220203,
					"content": "#А-а-а! {NICKNAME}, берегись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7602203,
			"completionStepIds": [
				7602203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7602203",
							"2"
						],
						"stepId": 7602203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Пеко"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "#Ой-ой-ой! Благодарю вас, мои {F#спасительницы}{M#спасители}! Я странствующий торговец Пеко. Будет время, загляните ко мне - сделаю хорошую скидочку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220302,
					"content": "Ну и денёк! А ещё на свою беду на эту «легендарную личность» нарвался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220303,
					"content": "Легендарную? Он что, знаменит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760220304,
					"content": "Угу, своей дурной репутацией. Другие торговцы меня предупреждали... Они тогда так перепугались, что больше не ходили этой дорогой. А я им не поверил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220305,
					"content": "Да ты настоящий смельчак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760220306,
					"content": "Я же странствующий торговец, всякое успел повидать. Да и когда мы собираемся все вместе и травим байки, то частенько любим приукрасить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220307,
					"content": "Ой, я отвлёкся! В общем, его зовут Гонпати. Говорят, он что-то натворил в Инадзуме и сбежал в наши глухие края. Ах да, с ним ещё была его подружка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220308,
					"content": "Так значит, та Мурасаки, о которой он говорил...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#Точно! Только что во время боя с {F#путешественницей}{M#путешественником} чудак твердил это имя. Очень странно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760220310,
					"content": "Тем, кто ступил на кривую дорожку, нелегко с неё свернуть и начать всё сначала даже на новом месте. Без честного ремесла путь один - обратно к прежним ошибкам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220311,
					"content": "Если бы он был один, то ещё ладно - его дело. Но когда ходишь по лезвию ножа, легко нажить себе врагов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220312,
					"content": "Из-за этого, увы, и погибла его любимая... Собственно, с тех пор он совсем выжил из ума!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220313,
					"content": "Эх... Конечно, этот здоровяк совершал гнусное - отбирал у людей мору, но когда подумаешь, как он дошёл до жизни такой, его даже становится немного жалко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760220314,
					"content": "Так что, Паймон, никогда и ни за что не гонись за морой...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "Эй! Дело вовсе не в этом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 760220318,
					"content": "Ладно, не буду вас задерживать. Прошу, примите этот подарок в знак благодарности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Пеко"
				},
				{
					"id": 760220316,
					"content": "Паймон, если тебя однажды ограбят...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Хи-хи! Ну, у Паймон же есть ты! {NICKNAME} стоит на страже моры Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}