					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "Наверное, та светящаяся штука и есть ядро хаоса, о котором мы слышали от Джазари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270302,
					"content": "Оно под ветвями и лозами, но, кажется, из этой штуки что-то вытекает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270303,
					"content": "Арарикан чувствует, какая эта штука грязная. От неё лес болеет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270304,
					"content": "Ох, кажется, маги Бездны что-то тут замышляют. А это не может быть чем-то хорошим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270305,
					"content": "Джазари говорил о том, что печать ядра была уничтожена. Наверняка это проделки магов Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270306,
					"content": "В общем, пусть Арарикан подождёт снаружи, а мы тут разберёмся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
				7302714
