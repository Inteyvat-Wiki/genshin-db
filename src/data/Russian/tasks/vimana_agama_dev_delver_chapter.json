				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270201,
					"content": "Ой, Арарикан, а что ты тут делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270202,
					"content": "Арарикан закончил высаживать цветок и ждёт вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270203,
					"content": "Но что-то отвалилось от Великой железной горы и чуть не упало на Арарикана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270204,
					"content": "Ой, извини, Арарикан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270205,
					"content": "Паймон не за что извиняться. С Арариканом всё в порядке. Арарикан быстро бегает, поэтому на него ничего не упало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270206,
					"content": "Мы рады, что ты в порядке",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "Кажется, рука, которая отвалилась от робота, пробила вход в руины. Ну, хоть что-то.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270208,
					"content": "Давайте спустимся и посмотрим. Вдруг там нас ждёт что-то страшное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270209,
					"content": "Арарикан идёт с вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арарикан"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302705",
							"2"
						],
						"stepId": 7302705,
