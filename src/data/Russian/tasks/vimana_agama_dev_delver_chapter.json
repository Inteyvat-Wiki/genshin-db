			"dialogs": [
				{
					"id": 730270401,
					"content": "Уф, мы почти закончили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270402,
					"content": "Опасное было путешествие, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270403,
					"content": "Давай расскажем Джазари...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "Кстати, если он знает про ядро, то он может помочь нам с финансированием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270405,
					"content": "#Но Паймон не хочет в Академию. {NICKNAME}, ты ведь тоже не хочешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270409,
					"content": "Пока мы не знаем, какое отношение воплощение Мараны имеет к ордену Бездны, но мы можем попробовать сделать хорошее дело и исцелить лес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270410,
					"content": "Ох, спасибо вам за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270411,
					"content": "Не за что, Арарикан.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "И чем ты займёшься теперь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270413,
					"content": "Арарикан собирается посетить Праздник Утсава, но его очень беспокоит «болезнь» леса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270414,
					"content": "Злые штуки, из-за которых лес заболел, могут вернуться. Арарикан будет охранять лес.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270415,
					"content": "Поэтому после завершения Праздника Утсава Арарикан вернётся сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270416,
					"content": "Ого, аранары такие преданные.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "Если Арарикану потребуется помощь - обращайся к нам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270418,
					"content": "Да, Арарикан знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "Арарикан"
				},
				{
					"id": 730270419,
					"content": "Хи-хи! Береги себя! Скоро увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270406,
					"content": "Давай расскажем дедушке Роинджан...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "Да, дедушке Роинджан точно понравится эта история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730270408,
					"content": "Может быть, мы целый лес спасли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}