			"dialogs": [
				{
					"id": 240210201,
					"content": "Могу я попросить вас принести мне коробку с документами? Как войдёте, она стоит <color=#00E1FFFF>на столе, который находится слева</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210202
