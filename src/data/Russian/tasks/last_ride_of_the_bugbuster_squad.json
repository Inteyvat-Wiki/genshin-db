							-1273.595,
							223.105,
							8774.408
						],
						"pointId": 350100184
					},
					{
						"sceneId": 3,
						"position": [
							-1275.5,
							223.083,
							8774.396
						],
						"pointId": 350100229
					}
				]
			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#Шилонен? {NICKNAME} и Паймон тоже здесь? Всем привет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060202,
					"content": "Оророн? Что ты здесь делаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060203,
					"content": "Тебе уже лучше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "Спасибо за заботу. Бабушка несколько дней вливала в меня какие-то горькие гадости и заставляла отдыхать. Сейчас мне гораздо лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060205,
					"content": "Привет, Оророн! Ты здесь, чтобы помочь Шилонен поймать тлей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060206,
					"content": "Тля? О! Так это вы похитили Стопроцентную Сладость...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060207,
					"content": "Неудивительно, что Экстремальная Сладость и Необычайная Сладость тоже исчезли... Это ваших рук дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060208,
					"content": "Э... Это имена тлей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060209,
					"content": "Да.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060210,
					"content": "Так их легче различать. Я их не оцениваю, в конечном счёте они все одинаково прекрасны, даже если не дают мёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060211,
					"content": "Значит... Всех этих тлей... вырастил ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060212,
					"content": "На самом деле, я не сделал ничего такого, что могло бы нарушить их естественное поведение. Так получилось, что мы живём на одной территории. Это своего рода отношения, в которых мы прекрасно уживаемся друг с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060213,
					"content": "Э-э... Прости, я не знала. Но они были заражены Бездной, и это повлияло на племя, так что мы должны были разобраться с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060214,
					"content": "Да, именно так! ...И мы не причинили им вреда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060215,
					"content": "Правда? Это хорошо. И всё же не стоит беспокоиться, это не так уж важно. На самом деле, я пришёл сюда, чтобы решить эту проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060216,
					"content": "Но я должен прояснить ситуацию. Тли не были заражены Бездной. Они умные маленькие существа, которые решили питаться энергией Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060217,
					"content": "Что ты сказал? Они приняли это решение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060218,
					"content": "Именно так. Они едят понемногу за раз. Этого количества достаточно, чтобы их тело увеличилось, но оно их не убьёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060219,
					"content": "Через некоторое время они улетают куда-нибудь подальше, а затем создают флогистоновые медовые жемчужины, которые удерживают загрязнение внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060220,
					"content": "Внешняя оболочка жемчужины служит барьером от загрязнения, и таким образом они могут постепенно очищать свой дом от энергии Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060221,
					"content": "Правда, процесс приходится повторять снова и снова, но они очень терпеливые существа. Даже если муравьи найдут себе дом в другом месте, это не страшно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060222,
					"content": "Значит, они защищают свой дом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060223,
					"content": "Я тоже впервые об этом слышу. Значит, они тоже знают, что их земля подвергается вторжению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060224,
					"content": "Да, Стопроцентная Сладость и остальные сражаются изо всех сил! Они все замечательные, сильные тли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060225,
					"content": "Не зря Натлан называют страной войны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "Оророн, как ты нашёл это место?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060227,
					"content": "Я накормил их семенами паралитической ягоды. Они не могут такое переварить и выводят из организма через некоторое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060228,
					"content": "После того как семена попадают в землю, они быстро растут и превращаются в плодоносящие кусты. Я шёл по местам, где растут кусты, и нашёл тлей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060229,
					"content": "Затем я собрал медовые жемчужины, которые они произвели, и позаботился о них, а затем использовал ещё больше паралитических ягод, чтобы вернуть их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060230,
					"content": "Но, похоже, вы сделали за меня всю работу и не навредили им при этом. Правда, я очень благодарен вам всем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060231,
					"content": "Так вот откуда взялись эти ягоды! А Паймон голову ломала, пытаясь понять, нет ли здесь заговора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060232,
					"content": "Я доставил тебе немало хлопот?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060233,
					"content": "Нет, вовсе нет. Не волнуйся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060234,
					"content": "Оророн, будь уверен, мы вернём тебе всех тлей, очищающих землю от Бездны, в целости и сохранности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060235
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060235,
					"content": "Это было бы идеально! Они все очень важные живые существа, и с ними нужно хорошо обращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060236
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060236,
					"content": "Раз проблема решена, увидимся позже! Зайдите ко мне в следующий раз, не стесняйтесь, я познакомлю вас с другими моими друзьями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060237
					],
					"speakerTitle": "Оророн"
				},
				{
					"id": 755060237,
					"content": "Буду ждать с нетерпением. Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060238
					]
				},
				{
					"id": 755060238,
					"content": "Фух! Я и представить себе не могла, что всё так обернётся. Этот Оророн полон сюрпризов.",
