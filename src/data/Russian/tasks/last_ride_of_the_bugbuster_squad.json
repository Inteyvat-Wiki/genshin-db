					}
				]
			},
			"dialogs": [
				{
					"id": 755060101,
					"content": "А вот и вы. Это последнее место, где видели тлю Бездны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060102,
					"content": "Значит, осталось поймать тлей, что водятся здесь, и всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060103,
					"content": "В большей степени. Даже если нескольким удастся сбежать, ничего страшного. Я найду время, чтобы разобраться с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060104,
					"content": "В племени говорят, что за последние несколько дней состояние пациентов улучшилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060105,
					"content": "Отличная новость!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060106,
					"content": "Правда, есть и плохие новости. Паймон, твоя теория заговора нашла подтверждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060107,
					"content": "Похоже, что эти ягоды растут именно там, где обычно скапливаются тли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060108,
					"content": "Э... Паймон вовсе не имела в виду, что за всем этим стоят Фатуи или Похитители сокровищ... или какой-нибудь преступный гений... Паймон всего лишь проявила разумную осторожность, которой должен обладать любой уважающий себя проводник!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060109,
					"content": "Я верю, что ты не растеряешь бдительность, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "Хе-хе, даже не сомневайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 755060111,
					"content": "Ладно, давайте поскорее покончим с этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "Шилонен"
				},
				{
					"id": 755060112,
					"content": "Да! Охотники за насекомыми, вперёд! Настало время последней битвы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
