			"dialogs": [
				{
					"id": 20131101,
					"content": "Стойте! Это штаб комиссии Кандзё. Посторонним нельзя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131102
					],
					"speakerTitle": "Ёкояма"
				},
				{
					"id": 20131102,
					"content": "Нам надо встретиться с... с этим... главой комиссии Кандзё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20131103,
					"content": "Глава комиссии обычно не принимает чужеземцев. Уходите, а не то я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131104
					],
					"speakerTitle": "Ёкояма"
				},
				{
					"id": 20131104,
					"content": "А... Подождите, подождите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131105
					],
					"speakerTitle": "Хийраги Синсукэ"
				},
				{
					"id": 20131105,
					"content": "О! Глава комиссии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131106
					],
					"speakerTitle": "Ёкояма"
				},
				{
					"id": 20131106,
					"content": "Эти двое - дорогие гости из далёких земель, не надо с ними как обычно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "Хийраги Синсукэ"
				},
				{
					"id": 20131107,
					"content": "Проходите, рассказывайте, в чём дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131108
					],
					"speakerTitle": "Хийраги Синсукэ"
				},
				{
					"id": 20131108,
					"content": "Ха! Слышал?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20131109,
					"content": "Прошу прощения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ёкояма"
				}
