				"objectNames": [
					"Хийраги Тисато"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20131001,
					"content": "Фуф... Мы сможем передохнуть в той деревне. Госпожа, вы как?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20131002,
					"content": "Я в порядке. Вот и всё, вон дорога на остров Наруками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131003
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20131003,
					"content": "В письме я попросила Камадзи дать тебе особую подорожную грамоту от комиссии Тэнрё. Считай это моей благодарностью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131004,
						20131005
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20131004,
					"content": "Спасибо тебе, Тисато.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				},
				{
					"id": 20131006,
					"content": "Госпожа?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20131007,
					"content": "А?! Так вот оно что. Я догадался, что что-то не так, но ты, Синнодзё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20131008,
					"content": "Нет, я уверен, что у госпожи Хийраги нет злого умысла. Но, госпожа, кто этот Камадзи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20131009,
					"content": "Скажу прямо... Он мой возлюбленный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20131010,
					"content": "Возлюбленный?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20131011,
					"content": "Синнодзё... Неужели ты думал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20131012,
					"content": "Что?! Нет! Я, э... Кхм! Я просто уточнил. Я бы никогда такого... Кхм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20131013,
					"content": "Не волнуйтесь. Пожалуйста, забудьте о произошедшем. Если мой отец узнает, то я возьму всё на себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20131014,
					"content": "Да, конечно... Как пожелаете, госпожа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20131015,
					"content": "Но, Тисато, что если он правда узнает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20131016,
					"content": "Ничего страшного, отец с детства меня баловал. В худшем случае оставит меня без обеда, или что-то в этом роде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20131017,
					"content": "О, Паймон и не думала, что у него есть и такая сторона.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20131018,
					"content": "В добрый путь. Я уверена, что мы ещё встретимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20131019,
					"content": "Пока, Тисато!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20131020,
					"content": "Эй, пошли! Хватит пялиться и пошевеливайся. Нам ещё груз везти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20131021,
					"content": "Хнык... Ладно... Хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20131005,
					"content": "Будь осторожна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
		},
