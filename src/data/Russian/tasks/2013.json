							"201304",
							"2"
						],
						"stepId": 201304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Синнодзё"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130401,
					"content": "Вы двое, остановитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130402,
						20130403
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20130402,
					"content": "Ну конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				},
				{
					"id": 20130404,
					"content": "А? Что мы сделали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130405,
					"content": "Вам письмо от госпожи Хийраги. Она просила его немедленно прочитать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130406
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20130406,
					"content": "Письмо? Дай посмотрю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130407,
					"content": "#{M#Дорогой путешественник}{F#Дорогая путешественница}! Прошу прощения, что приходится обращаться к Вам в письме, и надеюсь, что оно никоим образом не смутит и не потревожит Вас. Впервые я прошу о встрече {M#незнакомца}{F#незнакомку} из чужой страны, но я верю, что наши пути пересеклись неслучайно. Поэтому я надеюсь, что Вы примете моё приглашение встретиться сегодня ночью под прекрасным ликом луны. Не беспокойтесь о страже и слугах, я позабочусь о том, чтобы отвлечь их внимание. С нетерпением жду нашей встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130408,
					"content": "#Получается... она хочет, чтобы ты тайно {M#встретился}{F#встретилась} с ней сегодня ночью?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130409,
					"content": "#Но ты, похоже, совсем не {M#удивлён}{F#удивлена}... В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130410,
						20130412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130410,
					"content": "Мы с ней пересеклись взглядами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130411
					]
				},
				{
					"id": 20130411,
					"content": "А? Что это вы у меня за спиной затеяли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130414,
					"content": "Хм... Давай расспросим её сегодня ночью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130412,
					"content": "Синсукэ вовсе не собирается нас отпускать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130413
					]
				},
				{
					"id": 20130413,
					"content": "Паймон сразу показалось, что что-то с ним не так!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130403,
					"content": "#Я так и думал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				}
			]
		},
		{
			"id": 201307,
			"completionStepIds": [
				201307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201307",
							"2"
						],
						"stepId": 201307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хийраги Тисато",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "А, вы наконец пришли... Позвольте представиться, я Хийраги Тисато.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130702,
					"content": "На самом деле это не первая наша встреча... Приятно видеть вас снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130703,
					"content": "Ого, действительно дочь клана Хийраги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130704,
					"content": "Я к вашим услугам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "Не надо таких формальностей! Я давно восхищаюсь вашими делами... И наконец мы встретились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130707,
					"content": "Паймон кажется или что-то тут не то?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130708,
					"content": "Причина, по которой я хотела с вами встретиться... Я боялась, что у меня не будет другой возможности обсудить с тобой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130709,
					"content": "Обсудить что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130710,
					"content": "Кхм... Я хотела попросить тебя помочь... доставить письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130711,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "Пф, вся в отца! Не могла что-нибудь новое придумать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130714,
					"content": "Нет! Вы меня не так поняли... Пожалуйста, позвольте мне объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130715,
					"content": "Я надеялась, что вы поможете мне доставить письмо Кудзё Камадзи из комиссии Тэнрё на острове Наруками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130716,
					"content": "Мой отец всегда запрещал нам общаться. Он хочет выдать меня замуж так, чтобы это принесло ему побольше политической выгоды. Но моё сердце принадлежит только Камадзи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130717,
					"content": "Никто на Рито не посмеет пойти против моего отца, но вы - чужеземцы. Чужеземцы, которые хотят попасть на остров Наруками. Нельзя было упустить такую возможность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130718,
					"content": "А, теперь Паймон всё поняла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130719,
					"content": "И конечно, я сделаю всё, что в моих силах, чтобы помочь вам покинуть Рито. Я обещаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130720,
					"content": "Хм... Звучит неплохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "На самом деле... Пока вы в Инадзуме, мой отец не собирается выпускать вас с Рито.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130723,
					"content": "Да, мы догадались. Было очевидно, что он просто хочет нас здесь удержать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130724,
					"content": "Несколько дней назад я подслушала, как отец разговаривал с какой-то надменной женщиной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130725,
					"content": "Они обсуждали, как удержать вас на Рито. Я никогда раньше не слышала, чтобы мой отец так почтительно разговаривал с кем-то, кроме сёгуна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130726,
					"content": "Надменная женщина...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "У нас мало времени. Я расскажу вам свой план, как вытащить вас с острова... Есть партия товара...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130729,
					"content": "#(Хийраги Тисато рассказывает путешественни{F#це}{M#ку} свой план...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130730,
					"content": "Очень хорошо, я буду ждать вас на границе. Прошу вас, доставьте письмо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130727,
					"content": "Кажется, надо как можно скорее отсюда выбираться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "У нас всё равно нет выбора...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "#Я {M#пошёл}{F#пошла}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "#Очень рад{F#а} встрече с вами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
		{
			"id": 201308,
			"completionStepIds": [
				201308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201308",
							"2"
						],
						"stepId": 201308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хийраги Тисато",
					"Синнодзё"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Подождите... Этот товар отправляется на... остров Ватацуми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130802,
					"content": "Госпожа! Какой неожиданный визит! Вы правы, глава комиссии Кандзё специально распорядился, чтобы этот товар обязательно доставили на остров Ватацуми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20130803,
					"content": "Госпожа Хийраги, что-то не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20130804,
					"content": "Нет, всё в порядке. Мой отец беспокоится о безопасности товара, поэтому приказал мне и дополнительному конвою сопровождать груз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130805,
					"content": "Госпожа, вы же не собираетесь лично сопровождать груз? Не стоит утруждать себя такими делами. А что этот «конвой»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20130806,
					"content": "Приятно познакомиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "Пожалуйста, хватит тратить время. Если мне не изменяет память, то отец особенно подчеркнул, что товар должен прибыть вовремя. Я уверена, что опоздание будет наказано.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130809,
					"content": "Да, конечно, госпожа. Просто... Я не знаю, кто это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20130810,
					"content": "Неужели вам нужно напоминать, что будет, если со мной что-то случится по дороге? Думаю, вы все знакомы с нравом моего отца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130811,
					"content": "Вы действительно уверены, что сами можете полностью гарантировать мою безопасность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130812,
					"content": "Ого, вот так хватка у Тисато. У них нет шансов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20130813,
					"content": "Да, госпожа. Хорошо... Это большая честь - сопровождать вас. Мы будем защищать вас до последнего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20130814,
					"content": "Синнодзё! Неужели ты согласился?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20130815,
					"content": "Ну... Это приказ самой госпожи Хийраги. Наш долг - верой и правдой служить ей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Синнодзё"
				},
				{
					"id": 20130816,
					"content": "Да, но... вопрос не в этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20130817,
					"content": "Ладно, если всё решено, то немедленно отправляемся. Чем дольше возимся, тем больше времени у воров на подготовку, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Хийраги Тисато"
				},
				{
					"id": 20130818,
					"content": "Да, госпожа. Слышали?! Отправляемся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кэндзабуро"
				},
				{
					"id": 20130807,
