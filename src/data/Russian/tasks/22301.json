		{
			"id": 2230151,
			"completionStepIds": [
				2230151
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230104",
							"2"
						],
						"stepId": 2230104,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"223010304",
							"22301"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайный доктор Лю Су"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015101,
					"content": "Казалось, что меч - это продолжение тела юного послушника. Его движения были точны и быстры. Резкие удары и выпады складывались в единую направленную атаку, словно капли дождя собираются в один гладкий и спокойный пруд... Противник был гораздо крупнее юноши, но это преимущество ему не помогло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015102
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015102,
					"content": "Здоровяк внезапно почувствовал резкую боль в руке. Ловким движением меча послушник обезоружил своего оппонента. Но возмущенный этой выходкой здоровяк не собирался сдаваться без боя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015103
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015103,
					"content": "Противник заметил, что после безупречного удара послушник решил перевести дух. Вдруг скрытое оружие в руках здоровяка начало светиться зелёным, и три ледяных луча вылетели прямо в лицо послушнику.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015104
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015104,
					"content": "Отчего ответ соперника был столь жесток? И что же случилось с юным послушником? Какова дальнейшая судьба школы Гухуа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайный доктор Лю Су"
				}
			]
		},
		{
			"id": 2230152,
			"completionStepIds": [
				2230152
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230104",
							"2"
						],
						"stepId": 2230104,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"223010305",
							"22301"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайный доктор Лю Су"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015201,
					"content": "Молодой человек обладал исключительным талантом фехтовальщика. С большим трудом ему удалось отразить атаку. Кроме того, он тоже выпустил три луча из своего собственного скрытого оружия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015202
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015202,
					"content": "Но перед тем, как совершить контратаку, он заметил, что здоровяк выпрямился во весь рост. Словно из воздуха в руке соперника возник гибкий тренировочный клинок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015203
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015203,
					"content": "Губы здоровяка скривились в зловещей улыбке. Резкая атака. На этот раз здоровяк одержал верх. Послушник не был готов к такой резкой атаке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015204
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015204,
					"content": "Перейдя в оборону, молодой послушник почувствовал усталость. Когда в очередной раз они скрестили свои клинки, сопернику удалось обезоружить молодого послушника. Через мгновение тот получил мощный удар в грудь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015205
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015205,
					"content": "Послушник снова пошатнулся, на этот раз от звона своего упавшего меча. Самодовольная ухмылка вновь появилась на лице здоровяка. Он занёс клинок над головой... Было очевидно, что он собирается прикончить послушника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015206
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015206,
					"content": "Но юноша лишь засмеялся и покачал головой. «Неплохо... Но пора это заканчивать!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайный доктор Лю Су"
				}
			]
		},
