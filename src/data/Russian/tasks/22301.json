				"objectNames": [
					"Маоцай Гун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223011401,
					"content": "Это так бесит... Как всегда, на самом интересном месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011402
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 223011402,
					"content": "Тебе доводилось слушать старика Лю Су?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011403
					]
				},
				{
					"id": 223011403,
					"content": "Конечно! Он просто приводит меня в ярость! В последний раз я слушал, как он рассказывал <color=#00E1FFFF>«Дождь клинков»</color> в чайном доме «Хэюй».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011404
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 223011404,
					"content": "Он дошёл до момента, когда школа Гухуа пришла в упадок. Существование школы оказалось под угрозой, многие ученики решили спастись бегством.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011405
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 223011405,
					"content": "Несколько верных послушников решили идти до конца. Они надеялись отстоять школу, но все их надежды пошли прахом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011406
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 223011406,
					"content": "Глава клана Гухуа пришёл в отчаяние. Он уже готов был покинуть школу, но в самый последний момент, в воротах появился мечник, который мастерски владел своим оружием...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011407
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 223011407,
					"content": "И вот именно на этом месте старик Лю Су решил остановиться! Чем всё закончилось? Узнаем в следующей главе! Как говорится, продолжение следует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011408
					],
					"speakerTitle": "Маоцай Гун"
				},
				{
					"id": 223011408,
					"content": "Запомни мои слова, в следующий раз я не уйду, пока не дослушаю историю до конца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Маоцай Гун"
				}
			]
		},
