			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайный доктор Лю Су"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015401,
					"content": "Гигантские волны вздымались на фоне чёрного неба. Но у флота Южного Креста были причины для беспокойства. Даже с лучшими на свете кораблями и прекрасно подготовленной командой матросов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015402
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015402,
					"content": "Когда бушует океан, даже самые большие корабли становятся лишь игрушками в руках капризной природы. Что говорить, когда в шторм попадает мелкие судёнышки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015403
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015403,
					"content": "Но худшее было впереди. Вдруг среди вздымающихся волн загорелись глаза гигантского чудовища. Испуганные моряки беспомощно молили Гео Архонта о спасении, не смея посмотреть в глаза чудовищу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015404
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015404,
					"content": "И лишь одна фигура гордо возвышалась на носу корабля, опираясь на лезвие меча. «Вот мы и встретились! Было непросто тебя найти!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015405
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223015405,
					"content": "Кем был этот герой? И что это был за исполинский зверь? И в чём причина их вражды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайный доктор Лю Су"
				}
			]
		},
