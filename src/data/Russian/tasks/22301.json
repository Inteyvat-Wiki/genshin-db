				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223011101,
					"content": "Старик Лю такой прекрасный рассказчик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011102
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 223011102,
					"content": "Тебе раньше доводилось слушать истории Лю Су?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011103
					]
				},
				{
					"id": 223011103,
					"content": "Ты говоришь о старике Лю Су? Его истории не сравнятся ни с чем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011104
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 223011104,
					"content": "В прошлый раз он пересказывал <color=#00E1FFFF>«Гнев Хай Шаня»</color>. Это было просто нечто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011105
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 223011105,
					"content": "Он начал с описания бури. Ревущие ветра и исполинские волны терзали корабли Южного Креста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011106
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 223011106,
					"content": "Но флот продолжал идти вперёд. На носу флагманского корабля возвышалась гордая фигура капитана с мечом в руке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011107
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 223011107,
					"content": "Тяжёлый взгляд капитана был прикован к громадам вздымающихся волн, и вдруг из морских пучин появилась зловещая тёмная фигура...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011108
					],
					"speakerTitle": "Дедуля Фаньэр"
				},
				{
					"id": 223011108,
					"content": "И на этом месте старик Лю остановился... Продолжение следует. Он всегда так говорит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дедуля Фаньэр"
				}
			]
		},
