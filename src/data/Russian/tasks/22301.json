			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайный доктор Лю Су"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "Где же я остановился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010102,
					"content": "Чем ты занимаешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "Здравствуй! Хочешь послушать историю?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010104,
					"content": "Я? Я рассказываю истории, чтобы заработать себе на хлеб.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010105,
					"content": "Дело в том, что я рассказываю так много историй, что у меня в голове уже всё перемешалось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010106,
					"content": "Несколько дней назад часть публики требовала рассказать «Гнев Хай Шаня», историю про флот Южного Креста, а другая часть публики хотела послушать «Дождь клинков» про школу боевых искусств Гухуа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010107,
					"content": "Но мне же нужно как-то зарабатывать? Я рассказал часть из одной книги и часть из другой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010108,
					"content": "И всем понравилось! Публика теперь хочет узнать, чем эта история закончилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010109,
					"content": "Я давно не перечитывал эти книги, и мне пришлось освежить память. Я перечитал книги, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010110,
					"content": "Теперь я забыл, на чём закончил свою историю в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010111,
					"content": "#Не мог{F#ла} бы ты поспрашивать у моих слушателей, на чём я остановился в прошлый раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010112,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "Спасибо! Ты мой спаситель! Сам я не могу это сделать, на кону моя репутация сказителя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010118,
					"content": "Предлагаю расспросить троих человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010119,
					"content": "Я бы начал с <color=#00E1FFFF>Маоцай Гуна</color>. Он не пропустил ни одного представления. Ещё можно поговорить с <color=#00E1FFFF>дедулей Фаньэр</color>, владельцем этого чайного домика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010120,
					"content": "И наконец госпожа <color=#00E1FFFF>Цзян Чжоу</color>. Я точно помню её личико в толпе слушателей, но не уверен, что она осталась до конца представления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010114,
					"content": "Ты же можешь просто начать сначала...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "Я тоже об этом думал. Можно было бы заработать лёгких денег на известной истории...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010116,
					"content": "Но дедуля Фаньэр этого не одобрит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010117,
					"content": "Расспроси, пожалуйста, моих слушателей. Так я смогу понять с какого момента мне продолжать историю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Чайный доктор Лю Су"
				}
			]
		},
		{
			"id": 2230102,
