			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайный доктор Лю Су"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "#О! Ты вернул{F#ась}{M#ся}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010202,
					"content": "Чем больше я читаю книг, тем больше путаницы у меня в голове.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010203,
					"content": "Удалось расспросить слушателей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайный доктор Лю Су"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230108",
							"2"
						],
						"stepId": 2230108,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чайный доктор Лю Су"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "Ты всё ещё здесь? Как тебе выступление?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010402,
					"content": "Что было дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "«Дождь Клинков» и «Гнев Хай Шаня» - очень большие книги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010404,
					"content": "Мне понадобилось бы несколько часов, чтобы вкратце пересказать только основные сюжетные линии. Приходи лучше на следующее выступление.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010407,
					"content": "Спасибо за помощь. Вот твоя награда. Надеюсь увидеть тебя на следующих выступлениях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 223010405,
					"content": "Но ты же сказал, что мы «всё узнаем в следующей главе»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "Ха-ха! Вы узнаете. Поэтому приходите слушать следующую главу, а потом ещё одну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
