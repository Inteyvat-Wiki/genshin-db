			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Цзян Чжоу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223011701,
					"content": "Эх... Было бы у меня больше свободного времени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011702
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 223011702,
					"content": "Тебе доводилось раньше слушать истории Лю Су?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011703
					]
				},
				{
					"id": 223011703,
					"content": "Истории Лю Су?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011704
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 223011704,
					"content": "Хм... Да, припоминаю. Я проходила мимо и решила послушать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011705
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 223011705,
					"content": "Я не всё запомнила. История называлась <color=#00E1FFFF>«Дождь клинков»</color> или как-то так...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011706
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 223011706,
					"content": "Дела у школы Гухуа шли неважно. У них появились сильные соперники или что-то вроде того.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011707
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 223011707,
					"content": "Я пропустила начало, поэтому не особо поняла, что происходит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 223011708,
					"content": "Хороший парень, казалось, вот-вот победит, но вдруг кто-то напал на него со спины и повалил его на землю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011709
					],
					"speakerTitle": "Цзян Чжоу"
				},
				{
					"id": 223011709,
					"content": "А потом мне надо было возвращаться на работу. Интересно, чем же там всё закончилось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цзян Чжоу"
				}
			]
		},
