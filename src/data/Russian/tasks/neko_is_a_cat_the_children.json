			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Нэко",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Ох, мяу. Куда же они подевались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100102,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "А, это ты. Маленькие негодники куда-то сбежали, и теперь я волнуюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100104,
					"content": "Внешний мир - опасное место. Я их много раз предупреждала: там водятся эти волосатые чурбаны с палками, а ещё такие круглые штуки из огня и воды, и ни от кого из них не стоит ждать ничего хорошего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100105,
					"content": "А если котята забегут в то щекочущее место, то у них вся шерсть встанет дыбом. Не хотелось бы, чтобы малышам пришлось такое испытать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100106,
					"content": "Но всегда кто-нибудь да не послушается и сбежит. А потом мне приходится их искать и возвращать домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100107,
					"content": "И вот сегодня они опять сбежали, и неизвестно где их искать. Я так переживаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100108,
					"content": "Помоги мне, разыщи Комбумару и Хатихо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100109,
					"content": "А кто такой Комбумару?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "Хороший малыш. Комбумару в этом поколении - большой умница.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100111,
					"content": "«В этом поколении»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Хибики иногда говорила это слово. Не знаю, что это, но судя по её выражению лица, что-то хорошее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100113,
					"content": "Я всегда называю малышей в честь разных хороших вещей. А когда они вырастают и уходят, я беру их имена для новых котят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100114,
					"content": "Комбумару любит забираться повыше, чтобы поспать. Ищи его в самом высоком месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100115,
					"content": "А Хатихо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Очень ловкий и активный котёнок. Он так любит рыбу! Поэтому иногда отправляется на берег моря, чтобы поискать рыбу, которую выбросило на берег.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100117,
					"content": "Но это очень опасно! Нет ничего страшнее воды. Много-много лет назад кто-то - кажется, это был тануки? - упал в воду и чуть было не утонул.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100118,
					"content": "Хатихо, скорее всего, найдётся на морском берегу, играющим с рыбками и крабами. Ищи его там, где много солёной воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100119,
					"content": "Довольно размыто...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "По-моему, все предельно ясно. Высокое-высокое место и место, где много солёной воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100121,
					"content": "Как насчёт того, чтобы показать Нэко нашу карту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722100122,
					"content": "Что тут непонятного? Вот здесь высокое-высокое место. А здесь солёная вода. Они наверняка там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100123,
					"content": "Мы с этим справимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Тогда займитесь этим. Мяу, ох уж эти малыши...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100125,
					"content": "Я не умею ловить кошек...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Мяу, мяу. Не переживай. Эти малыши совсем не боятся людей... На самом деле, они и убегают-то из-за того, что с ними никто не играет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100127,
					"content": "Тогда займитесь этим. Мяу, ох уж эти малыши...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
