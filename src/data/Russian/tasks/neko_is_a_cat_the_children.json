			"dialogs": [
				{
					"id": 722100201,
					"content": "Мяу, мяу-мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100202
					],
					"speakerTitle": "Хатихо"
				},
				{
					"id": 722100202,
					"content": "Ага, похоже, это у нас Хатихо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100203,
						722100205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722100203,
					"content": "Иди сюда, будь умницей...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100204
					]
				},
				{
					"id": 722100204,
					"content": "Мяу-мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "Хатихо"
				},
				{
					"id": 722100207,
					"content": "О, какой послушный малыш...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722100205,
					"content": "Мяу, мяу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100206
					]
				},
				{
					"id": 722100206,
					"content": "Мяу... Мяу, мяу, мяу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "Хатихо"
				}
			]
		},
		{
			"id": 7221003,
			"completionStepIds": [
				7221007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
