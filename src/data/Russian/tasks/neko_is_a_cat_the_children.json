						"rawParams": [
							"7221007",
							"2"
						],
						"stepId": 7221007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Комбумару",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100301,
					"content": "Мяу! Мяу-мяу, мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "Комбумару"
				},
				{
					"id": 722100302,
					"content": "Ой! Какой... сердитый котёнок, осторожно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722100303,
					"content": "Мяу, мяу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Мяу-мяу? Мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "Комбумару"
				},
				{
					"id": 722100307,
					"content": "Хе-хе, выглядел таким сердитым, но в результате послушно пошёл к тебе на ручки, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722100305,
					"content": "Я отнесу тебя домой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
					"content": "Мяу! Мяу... Мяу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "Комбумару"
				}
			]
		},
		{
			"id": 7221004,
			"completionStepIds": [
				7221004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221004",
							"2"
						],
						"stepId": 7221004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко",
					"Паймон",
					"Хатихо",
					"Комбумару"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "#Ты их {F#нашла}{M#нашёл}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100402,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "Вы! Почему вы меня никогда не слушаете? Почему вы не можете быть послушными, как Вкусняшка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100404,
					"content": "Вкусняшка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Ну да, точно, она же говорила, что использует хорошие вещи в качестве имён...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722100406,
					"content": "Мяу, мяу-мяу-мяу... Мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "Хатихо"
				},
				{
					"id": 722100407,
					"content": "Мяу! Мяу-мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "Комбумару"
				},
				{
					"id": 722100408,
					"content": "Хватит дерзить! Или что, в следующий раз мне не искать вас? Чтобы вы остались голодными, пока... пока на небе будет солнце, а потом луна, а потом снова выйдет солнце? И чтобы вы сами искали дорогу домой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100409,
					"content": "Мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "Комбумару"
				},
				{
					"id": 722100410,
					"content": "Ха-ха, вот так-то лучше. Ладно, главное, что вы вернулись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 722100411,
					"content": "Я перед вами в долгу. Если бы не вы, эти негодники остались бы голодными на улице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
