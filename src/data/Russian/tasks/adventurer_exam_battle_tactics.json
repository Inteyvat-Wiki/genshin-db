			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Энтони",
					"Анна"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Анна, прошу, одумайся. Подумай о будущем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140102,
					"content": "Ой, да не переживай ты так. Ничего со мной не случится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140103,
					"content": "Как здоровье, Анна?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "#Путешественни{F#ца}{M#к}! Как хорошо, что ты {F#пришла}{M#пришёл}. Помоги мне отговорить Анну. Она собирается стать искательницей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140106,
					"content": "А почему это мне нельзя быть искательницей приключений? Я совершенно здорова. И Сайрус говорит, что мой быстрый ум отлично подходит для такой работы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140107,
					"content": "Ты выздоровела не так давно. И что ты будешь делать, если снова заболеешь? Да и родители не позволят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140108,
					"content": "Мы с папой и мамой уже обсудили это. Они сказали, что я могу стать искательницей приключений, если пройду отборочные испытания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140109,
					"content": "Ч-что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140110,
					"content": "Спокойно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Пару дней назад дядя Сайрус составил мне расписание, вот с тех пор и тренируюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140113,
					"content": "Пока я занималась только разведкой, добычей еды, выживанием в дикой природе и так далее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140114,
					"content": "Но я слышала, что искатели приключений часто сражаются с чудовищами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140115,
					"content": "Мне очень хотелось бы этому научиться, но учителя я так и не нашла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140116,
					"content": "Да и братец мой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140117,
					"content": "Ни за что! Эти чудовища и убить могут. Даже если я и отпущу тебя, то только с бывалым искателем приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140118,
					"content": "Так я уже попросила Джека. Он согласился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140119,
					"content": "Да ладно, знаю я этого Джека. В условиях дикой природы он не то что о тебе, он о себе позаботиться не сможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140120,
					"content": "Других опытных искателей приключений в Гильдии я не нашла, а дать поручение нет денег...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140121,
					"content": "Я могу составить тебе компанию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Правда? Ты поможешь мне? Да это же замечательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140124,
					"content": "Теперь ты, брат, можешь быть спокоен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140125,
					"content": "Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140126,
					"content": "#Ох... Хорошо. Мне известно, как {F#сильна путешественница}{M#силён путешественник}. Мне будет не так тревожно, если {F#она}{M#он} будет с тобой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140127,
					"content": "Только обещай, что будешь осторожна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140128,
					"content": "Ты запомнила всё, что я сказал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Энтони"
				},
				{
					"id": 200140129,
					"content": "Запомнила, запомнила... Ты уже столько раз это повторял...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140130,
					"content": "#Скорее выдвигаемся, {F#путешественница}{M#путешественник}. О местонахождении того лагеря я уже узнала у Джека.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140122,
					"content": "Некоторый боевой опыт у меня имеется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Тогда как проходят твои тренировки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Энтони, о чём это вы беседуете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
