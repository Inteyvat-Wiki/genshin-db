				"points": []
			},
			"dialogs": [
				{
					"id": 200140201,
					"content": "#Ты так легко {F#перебила}{M#перебил} всех чудовищ... Невероятно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140202,
					"content": "Как в дневнике и говорится, способов победить чудовищ много...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140203,
					"content": "Если честно... мне немного страшно, когда они так близко. Хорошо, что ты рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140204,
					"content": "Тебе нужно больше тренироваться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Да, знаю. Стать искателем приключений непросто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140206,
					"content": "#Спасибо тебе, путешественни{F#ца}{M#к}. Мне пора обратно в город. Брат уже, наверное, места себе не находит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Анна"
				},
				{
					"id": 200140207,
					"content": "Отныне я буду тренироваться ещё усерднее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Анна"
				}
			]
		},
