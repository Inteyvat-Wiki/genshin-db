			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "Съёмка прошла отлично. Следующий - высокий друг из Фатуи. Что вы бы хотели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Ицтли"
				},
				{
					"id": 752570302,
					"content": "Я хочу выглядеть как меткий стрелок. С первого взгляда люди должны понимать, что я никогда не промахиваюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Вечтеках"
				},
				{
					"id": 752570303,
					"content": "Тогда мне не придётся беспокоиться, что я окажусь в самом низу рейтинга в соревнованиях по стрельбе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Вечтеках"
				},
				{
					"id": 752570304,
					"content": "Да, хорошо. Начинаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ицтли"
				}
			]
		},
