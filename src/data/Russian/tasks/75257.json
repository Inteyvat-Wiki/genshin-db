					}
				]
			},
			"dialogs": [
				{
					"id": 752570701,
					"content": "Фух, ну наконец-то. Большое спасибо за помощь. Если бы не вы, на меня бы обрушились жалобы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Ицтли"
				},
				{
					"id": 752570702,
					"content": "Не за что! Хе-хе, мы ведь самые увлечённые искатели приключений!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "Искатели приключений? Тогда как насчёт того, чтобы сфотографировать вас в разных позах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Ицтли"
				},
				{
					"id": 752570704,
					"content": "Улыбочку! Беззаботный Натлан, беззаботное лето!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Ицтли"
				},
				{
					"id": 752570705,
					"content": "Спасибо. Это вам за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ицтли"
				}
			]
		},
