			"dialogs": [
				{
					"id": 752570801,
					"content": "Последнее получилось просто великолепно! А вы, элегантный молодой человек, какую фотографию хотите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Ицтли"
				},
				{
					"id": 752570802,
					"content": "Благодарю за комплимент. Я с рождения придерживаюсь мнения, что главное в жизни - это манеры и стиль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Инти"
				},
				{
					"id": 752570803,
					"content": "Без манер нет элегантности, без характера нет благородства. Понимаете, к чему я клоню?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Инти"
				},
				{
					"id": 752570804,
					"content": "Хм... Дайте-ка подумать... О, вот! Давайте начнём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ицтли"
				}
			]
		},
