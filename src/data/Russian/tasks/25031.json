			"dialogs": [
				{
					"id": 250310101,
					"content": "Беда... Вот беда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310102,
					"content": "Что-то не так с подготовкой Алем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}! Как хорошо, что ты {F#пришла}{M#пришёл}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310104,
					"content": "#Нет времени объяснять! Ты {F#должна}{M#должен} помочь мне спасти её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310105,
					"content": "Твою подругу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "В-вроде того... Мы столько бились над нашими научными работами, даже плакали друг у друга на плече в библиотеке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310108,
					"content": "Ох, сейчас не время для воспоминаний! Она меня вообще не слушает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310109,
					"content": "Сказала, что готова на всё ради своей научной работы, а потом ушла со своей телохранительницей исследовать дикую местность!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310110,
					"content": "И они до сих пор не вернулись! Все члены племени заняты, никто не может отправиться на поиски...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310111,
					"content": "#Умоляю, {NICKNAME}! Спаси её!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310112,
					"content": "Не вопрос, это я умею.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#{NICKNAME}, только ты и можешь мне помочь! Очень тебя прошу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310113,
					"content": "Странные вы люди, учёные...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "Она... Эх... Понимаешь, она ужасно невезучая. Прибыв в Натлан, она сказала, что должна сделать последний рывок, чтобы закончить свою научную работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "Тахмурес"
				},
				{
					"id": 250310106,
					"content": "Твою знакомую?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
		{
