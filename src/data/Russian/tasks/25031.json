			"dialogs": [
				{
					"id": 250310301,
					"content": "Неужели нельзя бросить эту проклятую научную работу... Ох-ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тахмурес"
