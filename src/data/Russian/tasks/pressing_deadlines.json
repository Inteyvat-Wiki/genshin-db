			"dialogs": [
				{
					"id": 710201001,
					"content": "Ну вот, теперь у меня проблемы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201002
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 710201002,
					"content": "Клерк Чжао сказала передать это тебе...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710201003
					]
				},
				{
					"id": 710201003,
					"content": "А? Ей нужен отчёт по стоящим в порту кораблям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201004
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 710201004,
					"content": "Это... Что ж, у меня с самого начала всё было готово...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201005
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 710201005,
					"content": "Но появились новые списки на погрузку, отчёты об экипажах, об иностранцах, входящих в порт и покидающих его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201006
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 710201006,
					"content": "Слишком много различных факторов, которые нужно отслеживать... Сделай это, сделай то... Я не успеваю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нервный Ань"
				}
			]
		},
