			"dialogs": [
				{
					"id": 401960301,
					"content": "#{NICKNAME}, Кинич, вы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960302,
					"content": "Мы только что видели, как Шеврёз уводила преступника. Она выглядела довольной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960303,
					"content": "Что ж, всё прошло куда лучше, чем мы ожидали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "Хе-хе, выходит, он заставил нас бегать по кругу, а сам оказался слабаком? Видимо, бегство было единственным фокусом в его рукаве!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960306,
					"content": "Кстати, Ризли просил передать, что он отправился во Дворец Мермония, чтобы обо всём доложить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960307,
					"content": "По его словам, Сумеречный двор готовится провести тщательное расследование незаконной игорной деятельности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960308,
					"content": "Похоже, им придётся несладко... В любом случае это забота Дворца Мермония. Нас это не касается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960309,
					"content": "Судя по тому, как быстро герцог удрал, я бы сказала, что он пытался скрыться от моей камеры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401960310,
					"content": "Я уже привыкла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401960311,
					"content": "Эй, ты так легко сдаёшься? Это совсем не похоже на ту Шарлотту, которую мы знаем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960312,
					"content": "Ничего страшного - у меня и так много отличных снимков. Более чем достаточно для первой полосы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401960313,
					"content": "И на этой ноте одному занятому репортёру пора уходить - фотографии сами себя не проявят!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "Шарлотта"
				},
				{
					"id": 401960314,
					"content": "Не забудь выбрать самый лучший снимок для Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960315,
					"content": "Эх, ушла... Надеюсь, она услышала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960316,
					"content": "Доверься профессиональному фотографу, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "Хе-хе, точно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960318,
					"content": "Почему так долго? Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960319,
					"content": "Ахав ударился головой и расплакался.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 401960321,
					"content": "Ах ты... Промолчать слабо было?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 401960322,
					"content": "Когда это я, всемогущий драконий повелитель Кухул Ахав, опускался до такого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 401960323,
					"content": "Довольно часто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 401960329,
					"content": "Что будем делать дальше?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "По правде говоря, я ещё не решил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 401960331,
					"content": "У меня нет срочных дел, но мои показания могут потребоваться в суде.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 401960332,
					"content": "Оружие остаётся главной уликой, поэтому мне, вероятно, придётся подождать, пока дело будет закрыто, чтобы вернуть пистолет в Натлан.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 401960333,
					"content": "Думаю, я ещё немного побуду здесь, чтобы насладиться пляжем и морем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кинич"
				},
				{
					"id": 401960324,
					"content": "Кинич ударился головой и расплакался.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "Как скажешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "Кинич"
				},
				{
					"id": 401960326,
					"content": "Ха-ха-ха! Бедный маленький Кинич! Никого не было рядом, чтобы погладить его по голове, поэтому он рыдал в одиночестве...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 401960327,
					"content": "Правда? Плачущий Ахав звучит куда правдоподобнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401960328,
					"content": "Эй, мелюзга!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Ахав"
				},
				{
					"id": 401960304,
					"content": "Противник оказался слабым.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
