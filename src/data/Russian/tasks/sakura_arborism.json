	"talks": [
		{
			"id": 7212302,
			"completionStepIds": [
				7212305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212305",
							"2"
						],
						"stepId": 7212305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хидэаки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "П-прошу тебя, не убивай меня! Клянусь, я не имею никакого отношения к Громовым сакурам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230205,
					"content": "И как тебе вообще пришло в голову, что мы здесь ради Громовой сакуры? Не иначе как у тебя нечистая совесть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230206,
					"content": "Паймон готова поклясться, что эта ваша штуковина, напоминающая Электро гипостазис, предназначена для какого-то тёмного дела. Разве нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230207,
					"content": "В... Вы... А вам-то какое дело, а?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230208,
					"content": "Ну, это моя работа.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "Именно так! Нас попросили навести порядок и добиться справедливости! Так что выкладывай начистоту! Мы заставим тебя всё рассказать о том, что Похитители сокровищ собираются делать с Громовыми сакурами и откуда взялась эта штуковина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230210,
					"content": "#Если откажешься говорить, хе-хе, то почувствуешь, что значит жалящий удар этого меча путешественни{F#цы}{M#ка}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230211,
					"content": "Я... Я буду говорить! Не сказал бы, что кому-то вообще есть дело до этих деревьев! Но почему бы братьям не заработать на её силе немножко деньжат?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230212,
					"content": "У нас был крупный покупатель, который интересовался этими деревьями, и даже снабдил нас средствами и инструментом, чтобы добывать их силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230213,
					"content": "Мы делали, как нам было сказано. Мы проделывали в деревьях отверстия и с помощью этих инструментов собирали силу Громовых сакур.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230214,
					"content": "Оставалось лишь направить их силу в этот кристалл, и готово: у нас в руках было бы нечто, по цене как три особняка комиссии Тэнрё!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230215,
					"content": "И вдобавок, нам заплатили кучу денег! Сумма такая, что такой мелюзге, как ты, за всю жизнь не потратить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230216,
					"content": "Отпусти меня, и я с тобой поделюсь! 10% тебе, а 90% - мне. Ну что, по рукам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230217,
					"content": "Маловато, приятель.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "Что? Знаете что, я хотел дать вам шанс уйти по-хорошему. Как только наш покупатель сюда доберётся, вы будете молить господина Хидэаки о пощаде!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230220,
					"content": "Ты, я гляжу, умеешь заливать, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230221,
					"content": "Послушай ты, маленькое нахальное существо! Мои братья вот-вот могут появиться здесь, чтобы спасти меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230222,
					"content": "#Не важно, кого вы позовёте и сколько их будет. С головы Паймон и волос не успеет упасть, как путешественни{F#ца}{M#к} уже обратит вас всех в бегство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230223,
					"content": "Ямада, вы это слышали? Эта мелочь сказала, что вам до неё не добраться! Вы ведь этого так не оставите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230224,
					"content": "#Ямада? Кто это? Путешественни{F#ца}{M#к}, скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230225,
					"content": "Э? Здесь никого нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 721230218,
					"content": "Хотеть не вредно, дружище.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Миюки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "Тебе удалось что-нибудь разузнать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230302,
					"content": "О Хидэаки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "Так вот что происходит... но Похитители сокровищ всего лишь жалкие воры. Разве способны они вызвать такой хаос?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230304,
					"content": "Предполагаю, что есть и другие причины увядания Громовых сакур... У меня есть подозрения, но наверняка сказать не могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230305,
					"content": "В смысле?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "Это Каннадзука. И здесь не имеют влияния ни инадзумская вера, ни Сангономия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230307,
					"content": "С тех пор как была объявлена Охота на Глаза Бога, здесь часто возникают конфликты между армией сёгуна и мятежниками. Не думаю, что сторонам есть дело до того, что в ходе войны ненароком могут пострадать Громовые сакуры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230308,
					"content": "Как говорила госпожа Мико: «Военные заботятся лишь о чести и наградах». Они не будут слушать голос разума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230309,
					"content": "Мы хорошо подготовились, но не ожидали, что Громовые сакуры находятся в таком плачевном состоянии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230310,
					"content": "#Как бы то ни было, самый насущный вопрос здесь и сейчас - дать отпор Похитителям сокровищ. Путешественни{F#ца}{M#к}, я могу доверить тебе это дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230311,
					"content": "Так точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "#Только будь бдител{F#ьна}{M#ен}. Ослабление Громовых сакур и правда делает положение очень опасным. В конце концов, эти деревья подавляют того, кто находится внизу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230315,
					"content": "#Ой, я сказала слишком много... П... прошу тебя, забудь всё, что от меня сейчас услышал{F#а}. Но если коротко, соблюдай крайнюю осторожность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230316,
					"content": "Мне также нужно время, чтобы проработать свои выводы. Главный нерешённый вопрос: кто тайно управляет Похитителями сокровищ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230317,
					"content": "Это дело становится всё запутаннее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230313,
					"content": "Похоже, всё довольно просто.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "Боюсь, дело обстоит не так просто, как ты думаешь. Ослабление Громовых сакур и правда делает положение очень опасным. В конце концов, эти деревья подавляют того, кто находится внизу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Миюки"
				}
			]
		},
		{
			"id": 7212304,
			"completionStepIds": [
				7212314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212314",
							"2"
						],
						"stepId": 7212314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Миюки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "Как обстоят дела с Громовыми сакурами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230402,
					"content": "Так, с «маленькими вещицами» удалось разобраться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Отлично! По крайней мере, это стабилизирует состояние Громовых сакур. Не сомневаюсь, что госпожа Мико будет рада об этом узнать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230404,
					"content": "Как смеют эти мошенники так беззастенчиво пытаться похитить Громовые сакуры ради собственной выгоды? Их поведение непростительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230405,
					"content": "#Ты также упоминал{F#а}, что наш{M#ёл}{F#ла} в лагере Похитителей сокровищ энергетический кристалл, образованный из силы Громовых сакур? Это безумно опасно. С этим надо разобраться как можно скорее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230406,
					"content": "#Ты мне и так уже здорово помог{F#ла}. Так что я вряд ли осмелюсь просить тебя снова заняться этим в одиночку. На этот раз я пойду вместе с тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230407,
					"content": "Медлить нельзя. Идём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Миюки"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212315",
							"2"
						],
						"stepId": 7212315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хидэаки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "Пф-ф, так это ты, ведьма! Пытаешься помешать нам заработать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230502,
					"content": "Заработать? Ах вы мерзавцы! Как вы смеете что-то замышлять против Громовых сакур? Госпожа Мико это так не оставит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230503,
					"content": "Какие громкие слова! Решитесь ли вы повторить их, когда узнаете, кого прогневали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230504,
					"content": "#Хозяин, эт{F#а}{M#от} путешественни{F#ца}{M#к} - тот самый человек, что стоит у вас на пути. Если не поможете нам с этим, сделка отменяется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230505,
					"content": "Хе-хе. Что, мелюзга, хочешь показать передо мною свою крутизну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Застрельщик Фатуи"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212317",
							"2"
						],
						"stepId": 7212317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Миюки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "Фу! Вот не повезло мне с соперниками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230603,
					"content": "Ах вы, бессовестные негодяи! Снюхались с Фатуи... Великая Наруками рано или поздно поразит вас всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230604,
					"content": "Пытаетесь блефовать со мной? Я ни за что не позволю вам вмешиваться в мои дела и вдобавок поучать меня! У меня ещё есть козыри в рукаве!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хидэаки"
				}
			]
		},
		{
			"id": 7212307,
			"completionStepIds": [
				7212319
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212319",
							"2"
						],
						"stepId": 7212319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Миюки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "Хв... Хватит гнаться за мной... Пожалуйста... Мы уже три круга оббежали, и я едва волочу ноги...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Хидэаки"
				},
				{
					"id": 721230702,
					"content": "Вы, гнусные мерзавцы, готовы якшаться с чужеземцами ради наживы! Вам не будет пощады, даже если нам придётся пробежать ещё хоть десять кругов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230703,
					"content": "#Уф... Путешественни{F#ца}{M#к}, по твоему выражению лица вижу, что ты разобрал{F#ась}{M#ся} с нашей маленькой проблемой. Спасибо тебе огромное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230704,
					"content": "Сила Громовых сакур не должна попасть в руки этого сброда, а тем более нельзя, чтобы её тайно передали Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230705,
					"content": "Сложно сказать, что задумали Фатуи, но раз уж мы схватили это хныкающее ничтожество, я позабочусь о том, чтобы выбить из него нужные ответы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Миюки"
				},
				{
					"id": 721230706,
					"content": "Зачистку оставь мне. Позиции армии сёгуна мне хорошо известны. Этому человеку не скрыться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Миюки"
				}
			]
		},
		{
			"id": 7212308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
