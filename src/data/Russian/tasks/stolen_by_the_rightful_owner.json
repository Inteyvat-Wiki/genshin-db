					"Талиесин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660101,
					"content": "Ох, ерунда какая-то. Это так странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660102,
					"content": "Оно должно быть где-то здесь... Куда же оно подевалось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660103,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "Моё кольцо... Оно пропало. Оно так много для меня значит. Мне нужно его найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660105,
					"content": "Как оно выглядело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "Такое латунное с красным самоцветом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660107,
					"content": "Я нашёл его у озера лавы, где по легенде пал теневой дракон Дурин. Вот почему его блеск напоминает тёмное пламя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660108,
					"content": "Ух ты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710660109,
					"content": "Легенда гласит, что повелитель Бездны устремит свой взгляд на владельца кольца и пошлёт свою армию, чтобы убить его...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660110,
					"content": "Ох!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
