					"content": "А вот и ты! Получилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660202,
					"content": "Посмотри, это твоё?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
