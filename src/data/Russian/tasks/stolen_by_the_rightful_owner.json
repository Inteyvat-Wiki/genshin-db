			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Талиесин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "Да! Огромное спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660302,
					"content": "Пожалуйста, прими это в благодарность... Тут немного, но я сложу о тебе стихи, восхваляющие твои деяния!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Талиесин"
				}
			]
		},
		{
