				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Талиесин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Кхм... Это моя вина. Ведь я поэт, и мне не чужды драматизация и новые истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660702,
					"content": "По правде говоря, это кольцо было найдено в гнезде хорька-барахольщика. Оно было таким красивым и так хорошо сохранилось, что мне захотелось оставить его у себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660703,
					"content": "Хм, это же воровство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710660704,
					"content": "Не говори так... Оно случайно мне попалось! Как бы то ни было, это кольцо мне дорого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660705,
					"content": "Что-то известно о местонахождении кольца?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Вообще-то... тут водятся хорьки-барахольщики. Они могли украсть кольцо, пока я спал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660707,
					"content": "Ха, значит, бывают люди, которые снимают свои кольца перед сном...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710660708,
					"content": "Впервые о таком слышу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "А вот у Паймон нет такой привычки! Ведь нужно подумать, куда положить кольцо, а это отнимает время сна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710660710,
					"content": "А бывают ли маленькие кольца для Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Конечно, бывают! Ты ещё столького не знаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710660712,
					"content": "Хватит! Это так невежливо болтать впустую о привычках других людей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660713,
					"content": "В общем, если вы хотите помочь, то поищите логово хорька-барахольщика.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660714,
					"content": "Говорят, поблизости есть лагерь Похитителей сокровищ. Я отметил вам на карте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660715,
					"content": "По слухам, там часто появляются хорьки-барахольщики. Вероятно, они как-то связаны с Похитителями сокровищ... Проверьте там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710660716,
					"content": "Хм... Кольцо, украденное у хорьков-барахольщиков, вновь украдено хорьками-барахольщиками. Паймон считает, что оно вернулось к своему владельцу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710660717,
					"content": "Не смейся надо мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Талиесин"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
