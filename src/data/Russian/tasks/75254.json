				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Кажется, мы уже встречались...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "Друг мой, это знак судьбы, которым она отмечает поистине необыкновенных людей! Ведь наша первая встреча ощущается как долгожданное воссоединение после многих жизней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752540502,
					"content": "#Увидев мою повязку, точно как у свирепого волка, ты, должно быть, сразу понял{F#a}: перед тобой неординарная личность, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Текутли"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
