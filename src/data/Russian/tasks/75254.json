				{
					"id": 752540409,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "#Ты ещё не спросил{F#а}, что с моим глазом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Текутли"
				}
			]
		},
		{
