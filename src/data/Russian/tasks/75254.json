			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Текутли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "Добро пожаловать на остров Тете, в Пайтити, мир ваших грёз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752540102,
					"content": "Впереди два наших бара: «Пьяный мёд» и «Роса». Меня зовут Текутли, и моя работа - встречать гостей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Текутли"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Текутли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "#{M#Дорогой друг}{F#Дорогая подруга}, теперь, когда ты уже выпил{F#а} мой приветственный сок, позволь мне дать тебе один совет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752540202,
					"content": "Если ты простой человек, который приехал на отдых, то стоит держаться подальше от самой северной части острова Тете. Там не расслабишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Текутли"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Текутли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "А что с твоим глазом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Хе-хе... Это работа лысого. Он оставил мне эту метку, и я знаю, что он где-то на острове... Я потом обязательно «отблагодарю» его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752540311,
					"content": "Услышав мою историю, наверняка вы захотите отомстить за меня? Спасибо, но не стоит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752540312,
					"content": "В такое прекрасное лето никто не должен грустить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752540313,
					"content": "Пожалуйста, выпейте приветственный сок, который я готовлю для каждого гостя, а затем наслаждайтесь своим отпуском.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Текутли"
				},
				{
					"id": 752540314,
					"content": "Вы можете найти напитки на полке вон там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Текутли"
				}
			]
		},
		{
			"id": 7525404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
