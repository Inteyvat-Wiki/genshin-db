			"dialogs": [
				{
					"id": 400831601,
					"content": "Мне по душе такой настрой! Мощь, стоящая всей моей многолетней тяжёлой работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831602
					],
					"speakerTitle": "Дядюшка Йети"
				},
				{
					"id": 400831602,
					"content": "Подходите и убедитесь сами в могуществе отряда плесенников, владеющих силой Крио.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дядюшка Йети"
				}
			]
		},
		{
