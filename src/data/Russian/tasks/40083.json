			},
			"dialogs": [
				{
					"id": 400831501,
					"content": "Вы двое. Не думала, что так скоро встречусь с вами на арене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831502
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 400831502,
					"content": "Простите, но мне придётся победить вас ради своей писательской карьеры и одобрения госпожи Яэ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831503
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 400831503,
					"content": "Ну что ж, попробуй!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831504
					]
				},
				{
					"id": 400831504,
					"content": "Но не будь такой самоуверенной, Соука, мы тоже поблажек делать не будем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
