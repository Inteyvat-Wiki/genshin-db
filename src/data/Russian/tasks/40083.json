		{
			"id": 4008309,
			"completionStepIds": [
				4008309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008309",
							"2"
						],
						"stepId": 4008309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Дори"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830901,
					"content": "Вот место встречи с универсальным торговцем, согласно записке Лайлы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830902,
					"content": "Должно быть, вы ищете универсального торговца? Если так, то добро пожаловать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830903
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830903,
					"content": "Да-да, а ты откуда знаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830904,
					"content": "Не может быть, это же Дори! Так это ты универсальный торговец, о котором говорила Лайла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830905
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830905,
					"content": "Чему вы так удивляетесь? «У госпожи Сангема-бай самый большой и удивительный ассортимент товаров». Все торговцы и покупатели на Большом базаре об этом знают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830906
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830906,
					"content": "«Универсальный», «всемогущий», «всесильный» и другие подобные слова - всё это мои эксклюзивные бренды. Никто из других торговцев не имеет права их использовать. За исключением желающих купить это право за несколько миллионов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830907
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830907,
					"content": "Эмм... нам стоило догадаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830908,
					"content": "Так что, Лайла правда отправила вас с поручением? Похоже, она и впрямь одержима этим Турниром укротителей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830909
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830909,
					"content": "Значит, у вас с Лайлой довольно близкие отношения, раз ты так хорошо её знаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830910,
					"content": "Эй! Отношения здесь ни при чём. Лайла покупала у меня кое-что. Ничего особо ценного, но для учащегося это большие деньги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830911
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830911,
					"content": "Разумеется, было очень легко догадаться, что она участвует в каких-то подозрительных соревнованиях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830912,
						400830913
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830912,
					"content": "Похоже, тебе кое-что известно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				},
				{
					"id": 400830914,
					"content": "У меня просто смутное ощущение, что есть какой-то подвох. Кстати, у меня тут кое-что залежалось. Чем будет у меня ржаветь, лучше предложу это вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830915
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830915,
					"content": "Эм... Это какие-то детали и фрагменты записей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830916
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830916,
					"content": "Говорят, это аппаратура и документы, которые пытались уничтожить организаторы соревнования.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830917
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830917,
					"content": "Но они оказались слишком невнимательными, а чья-то тяга к обогащению - слишком сильной! И вот эти вещи оказались у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830918
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830918,
					"content": "Если присмотреться, текст на этих документах очень напоминает рецепт цветочного агара. А фрагменты аппаратуры кое в чём похожи на жемчужины мудрости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830919
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830919,
					"content": "Возможно, всё это использовалось в экспериментах. Возьмём их с собой и попозже покажем Мико. Может быть, она найдёт, что именно здесь не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830920,
						400830921
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830920,
					"content": "Короче говоря, можем сначала предположить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830922,
					"content": "Похоже, наши изначальные опасения вот-вот подтвердятся... А Паймон хотела просто поиграть с Бам-бам-шапочкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830923
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830923,
					"content": "Хоть я и не совсем понимаю, о чём вы говорите, но, похоже, эти вещи вам нужны. Сделаю вам хорошую скидку. С вас шестьдесят миллионов, спасибо за визит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830924
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830924,
					"content": "Эй! Так не честно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830925
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830925,
					"content": "Хи-хи, я пошутила. Никому, кроме вас и матры, эти вещи не нужны, верно? Так что я отдам вам их бесплатно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830926
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830926,
					"content": "Дайте мне заказ Лайлы. Я посмотрю, что ей нужно, а когда всё приготовлю, отправлю ей курьером, чтобы вас не гонять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830927
					],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830927,
					"content": "Как же ты напугала, Паймон уж было решила, что нам придётся работать впустую. Даже с премией нам вряд ли столько заплатят...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830928
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830928,
					"content": "Вот заказ Лайлы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830929
					]
				},
				{
					"id": 400830929,
					"content": "Так... Мука, смешанная с молотым мацутакэ, выдержанное варенье и сок персика зайтун... Неужели плесенники и правда всё это едят? И откуда Лайла это узнала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дори"
				},
				{
					"id": 400830921,
					"content": "Что с Каутильей что-то не так...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830913,
					"content": "Можешь сообщить нам что-нибудь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				}
			]
		},
		{
			"id": 4008313,
			"completionStepIds": [
				4008313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008313",
							"2"
						],
						"stepId": 4008313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лайла"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "#{NICKNAME}, Паймон. Я увидела в расписании, что вы прошли в следующий этап. Поздравляю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400831302,
					"content": "О, Лайла, у тебя сегодня хорошее настроение, и Кручезверь выглядит довольным. Значит, ты тоже выиграла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831303,
					"content": "На этот раз я сильно поволновалась. Я лишь на волосок обошла своего соперника. Как же здорово, что до соревнования я успела потренироваться с Яэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400831304,
					"content": "Я только что получила свой заказ от универсального торговца, огромное вам спасибо! Чуть позже мы вместе с Кручезверем пойдём менять статус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400831305,
					"content": "Кхэ-кхэ... не хватает сил... давайте просто уменьшим громкость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400831306,
					"content": "Кстати, а куда делась Мико?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831307,
					"content": "У госпожи Яэ, похоже, были какие-то срочные дела, она ушла вместе с Соукой. Кажется, ими руководил наёмник из Бригады тридцати...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400831308,
					"content": "Когда я вернулась на арену, они уже довольно далеко ушли, и догонять их и спрашивать показалось невежливо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400831309,
					"content": "Может, она занята своей работой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "Верно. В последнее время Мико всё время была на соревнованиях. Хотя бы изредка заниматься вопросами издательства - это вполне нормально.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831312,
					"content": "К тому же, Мико говорила, что хочет во время отпуска пособирать материал. Возможно, этот наёмник - их проводник, и нам беспокоиться не о чем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831313,
					"content": "Угу... Впереди четвертьфинал, самое важное состязание... Немного страшно, но мы сделаем всё, что сможем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400831314,
					"content": "Ага! Мы неплохо продвинулись. Удачи, Лайла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831315,
					"content": "Нам тоже не стоит расслабляться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "Верно! Мы должны быть начеку! Давай сфотографируем вещи, которые дала нам Дори, и вместе с утренними фотографиями покажем их Мико при следующей встрече.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831316,
					"content": "Нужно думать и о соревновании, и о расследовании.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "В конце концов, у издательского дома Яэ много заказов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
		},
		{
