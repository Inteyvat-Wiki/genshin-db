					"Соука"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831701,
					"content": "Ну почему я не выиграла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831702
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 400831702,
					"content": "Видимо, талант и сила «Гостя Тэнсюкаку» недоступны для простой смертной вроде меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831703
					],
					"speakerTitle": "Соука"
				},
				{
					"id": 400831703,
					"content": "Как же быть? Соука приняла поражение близко к сердцу... Мико говорила, что можно не сдерживаться, но когда она её увидит в таком состоянии, то точно на нас разозлится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831704,
					"content": "Я в панике! Никак не успокоюсь! Пойдём извинимся перед Мико! Бам-бам-шапочка, тебе придётся изобразить виноватое лицо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
