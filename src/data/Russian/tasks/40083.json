	"talks": [
		{
			"id": 4008305,
			"completionStepIds": [
				4008305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008305",
							"2"
						],
						"stepId": 4008305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико",
					"Лайла"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "Мико! Прости! Кто бы мог подумать, что Бам-бам-шапочка одним ударом выведет из строя Соуку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830502,
					"content": "Паймон... Укротитель здесь я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "Что? Должно быть, Соука была в отчаянии и начала бормотать что-то вроде «простым людям такое не под силу»? Сжавшись на полу и причитая?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830505,
					"content": "Всё так и было. Ты и правда очень хорошо её знаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830506,
					"content": "Так даже лучше. Этот удар станет для Соуки ценным материалом, прекрасным примером неудач, с которыми сталкивается главный герой в процессе своего роста. Это тронет сердце читателя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830507,
					"content": "Вы же станете прообразом злодеев, наносящих подлые удары в ходе борьбы за победу. Не выбывайте из игры раньше меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830508,
					"content": "#О нет! Я стал{F#а} {F#злодейкой}{M#злодеем}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "Сейчас не будем о сидении на шеях! Мико, обязательно проследи, чтобы Соука была помягче в своих описаниях!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830511,
					"content": "#{NICKNAME}, Паймон и Яэ... Кхе-кхе-кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830512,
					"content": "Лайла, тише-тише, только не падай в обморок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830513,
					"content": "Я в порядке... Я написала письмо учащимся Амурты. К моему удивлению, они проявили неподдельный интерес к делу. Они ответили всего лишь через несколько часов и отправили нужные мне данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830514,
					"content": "Основываясь на этих данных, я попыталась приготовить много еды для Кручезверя, но ему не особо понравилось. Может быть, ингредиенты были не совсем правильными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830515,
					"content": "Затем я составляла изменённый список ингредиентов, которые могли бы понравиться Бам-бам-шапочке, и в итоге не спала до глубокой ночи. Поэтому сегодня мне немного трудно дышать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830516,
					"content": "Ты так быстро получила результаты? Вот это да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830517,
					"content": "(Трудно дышать из-за всего лишь лёгкого недосыпания?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "Как ты, Лайла? Задаёшь соперникам жару?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830519,
					"content": "Да! Благодаря твоим тренировкам Кручезверь стал куда более послушным, а его реакции я скоро буду завидовать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830520,
					"content": "Но и соперники тоже становятся сильнее, поэтому расслабиться не получится. Хотелось бы ещё раз потренироваться с Кручезверем, чтобы пройти в четвертьфинал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830521,
					"content": "Проблема в том, что... Завтра в семь утра я хочу снова пойти к универсальному торговцу и разом купить все нужные ингредиенты...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830522,
					"content": "Это не проблема. Я пойду с тобой на закрытую тренировку. А что касается покупок, то попросим ребят. Они отлично справляются с такими поручениями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830523,
					"content": "Похоже, вы часто работаете на госпожу Яэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830524,
					"content": "Верно! И делаем это с удовольствием!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "А! Да-да-да! Только не превращай нас в злющих злодеев!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830527,
					"content": "Не волнуйся, Лайла, они просто только что извинялись передо мной за то, что победили Соуку. Сначала перекуси и отдохни немного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830528,
					"content": "Большое спасибо! Я так вам благодарна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830529,
					"content": "Вот, возьмите, это адрес универсального торговца, и здесь же находится список ингредиентов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 400830530,
					"content": "Не стоит благодарности! Ты ведь провела исследование вкусов Бам-бам-шапочки, так что не переживай, мы просто помогаем друг другу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830531,
					"content": "Что же касается не раскрытой в прошлый раз темы потенциальной нестабильности, являющейся следствием этого соревнования... Пожалуй, есть неплохая отправная точка - материалы, используемые для выращивания плесенников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830532,
					"content": "Цветочный агар?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "Это одна из лучших сцен в романе - тайное расследование. Маленьким читателям такое всегда нравится, верно? Откуда взялась магия цветочного агара и жемчужин мудрости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830535,
					"content": "К тому же, если, не разобравшись в сути этого соревнования, позволить Хании делать, что ей захочется, то выйдет ещё больший хаос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830536,
					"content": "О... Тема разговора вдруг стала такой замысловатой, что Паймон немного запуталась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830537,
					"content": "Рекомендую вам взяться за дело ближе к рассвету. В это время все обычно очень измотаны. Возможно, вы сможете найти основные зацепки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 400830538,
					"content": "Ты правда последуешь совету Мико?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830539,
					"content": "Это и была изначальная причина участия в соревновании.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "Раз так, то дождёмся завтрашнего раннего утра и пойдём осматривать место выращивания плесенников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830542,
					"content": "Мы просто хотим убедиться в безопасности соревнования. Я не сомневаюсь в Бам-бам-шапочке, не переживай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400830540,
					"content": "Это необходимо для спокойствия нашего компаньона.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "Ты что-то слышала об этом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "Если не согласимся, то наша репутация...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "#Паймон сидит у {F#злодейки}{M#злодея} на шее, она ещё хуже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "А это значит, что я несу полную ответственность...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
		{
			"id": 4008308,
			"completionStepIds": [
				4008308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
