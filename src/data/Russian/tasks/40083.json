			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831401,
					"content": "Похоже на обычный цветочный агар. Ничего секретного. Их рецепты лежат повсюду на столах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831402,
						400831403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831402,
					"content": "Пусть даже у них и странный состав.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				},
				{
					"id": 400831404,
					"content": "Значит, мы не можем их исследовать. Если возьмём их, это будет считаться воровством, нас дисквалифицируют, и Бригада тридцати даже может нас арестовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831405,
					"content": "Точно, у нас ведь есть фотокамера! Надо сфотографировать эти цветочные агары и их рецепты. Так мы сохраним много важных сведений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400831403,
					"content": "Но у простых участников не возникнет ни малейших подозрений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				}
			]
		},
		{
