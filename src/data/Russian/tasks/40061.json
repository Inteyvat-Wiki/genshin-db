				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "Сегодня на Ватацуми дул ветер с юга. Это верный знак, что нас навестят друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 400610102,
					"content": "#Всякий раз, когда ты говоришь что-нибудь в этом духе, у Паймон с {F#путешественницей}{M#путешественником} появляется куча хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400610103,
					"content": "Не говори так. Из нас вышла хорошая команда, разве не так? Да что там, лучшая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 400610104,
					"content": "Но сегодня у меня всё же будет к вам одна просьба.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 400610105,
					"content": "По преданию, мои предки, помимо Ватацуми горё мацури, создали ещё один ряд испытаний. Связан он не с выживанием Ватацуми, но с истиной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 400610106,
					"content": "Ещё один... ряд испытаний?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400610107,
					"content": "Теперь, когда угроза существованию острова устранена, долг клана велит мне поведать вам о новых испытаниях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 400610108,
					"content": "Вы можете отправиться в место под названием Сердце змея. Подсказки второго ряда испытаний спрятаны там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 400610109,
					"content": "Ох, какое облегчение! Теперь я могу передать бремя этой ответственности моей будущей дочери.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Цуюко"
				},
				{
					"id": 400610110,
					"content": "И вот так ты относишься к родовому долгу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400610111,
					"content": "Паймон до сих пор не понимает тебя, Цуюко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}