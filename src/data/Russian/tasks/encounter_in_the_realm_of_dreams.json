					}
				]
			},
			"dialogs": [
				{
					"id": 120440301,
					"content": "Откуда там появилась девушка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440302,
					"content": "Кажется, ей плохо... Давай посмотрим, что с ней!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440801
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440801,
					"content": "Что случилось? Мы только на секунду встретились с ней глазами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440802,
					"content": "Подожди, а откуда здесь столько людей? И что они здесь делают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440803,
					"content": "Они что, в очередь выстроились?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "Ага... И девушка с ними! Так, наверное, она знает, что происходит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440805,
					"content": "Если отправиться в путь сейчас, хватит ли времени?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "Тэдзима"
				},
				{
					"id": 120440806,
					"content": "Сколько раз мне ещё объяснять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 120440807,
					"content": "Я не смогу вернуться, если донесу на него. Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "Санада"
				},
				{
					"id": 120440808,
					"content": "Хм... тревога из-за недостатка вдохновения... Что ж, вдохновение не приходит, когда ум встревожен. Надеюсь, наше лечение поможет тебе немного расслабиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440809,
					"content": "...Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "Вакамурасаки"
				},
				{
					"id": 120440810,
					"content": "...Раскаяние за дурные поступки, совершённые в прошлом, горечь из-за тупика в настоящем... Я могу помочь с более оптимистичным настроем, но тебе самому тоже придётся постараться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440811,
					"content": "...Спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "Нисигути"
				},
				{
					"id": 120440812,
					"content": "Следующий! Кхе-кхе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440813,
					"content": "Что это с ней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440814,
					"content": "Ты в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "Всё нормально. Следующий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440816,
					"content": "Э-э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440817,
					"content": "Ммм! Как вкусно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440818,
					"content": "Ого, неожиданно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440819,
					"content": "Так, что у нас тут? Ох, простите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440820,
					"content": "За что ты извиняешься? Мы понятия не имеем, что сейчас произошло. Можешь объяснить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440821,
					"content": "Похоже, вы по ошибке попали в мой сон. Давайте я сначала разбужу вас, а потом всё объясню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440822,
					"content": "Сон? Как это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440901,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440902,
					"content": "#Привет! Ну что, очнулись? Не ожидала, что {NICKNAME} в буквальном смысле слова войдёт в мои сны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440903,
					"content": "Откуда ты меня знаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "Одна знакомая много про тебя рассказывала... И я легко узнаю людей по описанию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440905,
					"content": "А кто ты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440906,
					"content": "Да, уместный вопрос. Это наша первая встреча, я должна представиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440907,
					"content": "Меня зовут Юмэмидзуки Мидзуки. Можно просто Мидзуки. Я юмэкуй-баку, это одна из разновидностей инадзумских ёкаев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440908,
					"content": "Юмэкуй-баку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440909,
					"content": "Фью-фью!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "Маленький юмэкуй-баку"
				},
				{
					"id": 120440910,
					"content": "Этого малыша мы уже видели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440911,
					"content": "Так выглядит наша исходная форма. Наверное, он и привёл вас в мой сон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440912,
					"content": "Баку умеют поглощать кошмары людей, но для этого мы сами должны очутиться в собственном сне, иначе кошмар не переварится. Мы с вами встретились в моём сне, где я поедала чужие кошмары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440913,
					"content": "Я съела слишком много кошмаров за один раз, и у меня случилось небольшое несварение... Но тут появились вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440914,
					"content": "Можно сказать, мне повезло. С вашей помощью я смогла переварить все эти кошмары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440915,
					"content": "Да, мы заметили, что тебе нехорошо, и решили подойти поближе. Мы не поняли, что произошло, но рады, что смогли тебе помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440916,
					"content": "И да, Паймон терпеть не может кошмары. Поэтому здорово, что мы помогли ёкаю, который их съедает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440917,
					"content": "Спасибо... И простите ещё раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440918,
					"content": "За что?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "Пока вы были внутри моего сна... я съела один из твоих снов, но это был не кошмар, а счастливый сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440920,
					"content": "Я столько кошмаров сегодня проглотила, что механически съела твой сон и даже не заметила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440921,
					"content": "Значит, юмэкуй-баку могут съесть и счастливый сон? И что, это очень плохо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440922,
					"content": "Конечно. Люди дорожат счастливыми снами. А я взяла и съела его, будто какой-то кошмар...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440923,
					"content": "У нас есть неписанное правило: никогда не ешь счастливые сны без разрешения. Я была очень неосторожна...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440924,
					"content": "Не вини себя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "Но... Ты совсем не чувствуешь упадка сил? И сознание не затоплено печальными воспоминаниями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440927,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "Удивительно... Ни разу не видела, чтобы человек оставался настолько стабилен после того, как у него съели счастливый сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440929,
					"content": "#Гм... Наверное, всё дело в том, что у {F#неё}{M#него} целая куча счастливых снов в запасе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440930,
					"content": "Наверное, но я всё равно должна искупить свою вину... Вот, возьми это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440931,
					"content": "Приглашение для особо важных гостей в бани «Аиса»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440932,
					"content": "Наши клинические психологи окажут вам необходимую помощь, а ещё у нас вы сможете понежиться в горячих источниках и отведать изысканные деликатесы. Сколько бы ни было забот, вы уйдёте от нас полными сил и энергии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440933,
					"content": "Я там работаю. Адрес указан на приглашении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440934,
					"content": "Приглашение даёт вам право бесплатно пользоваться нашими услугами для особо важных гостей... Кстати, о работе, мне пора возвращаться, пока меня не потеряли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440935,
					"content": "Надеюсь увидеть вас в числе наших клиентов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120440936,
					"content": "Значит, она юмэкуй-баку, которая работает клиническим психологом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440937,
					"content": "#Я не удивл{F#ена}{M#ён}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "Психологическая помощь... Паймон она обычно не требуется. Ну, разве что иногда, когда Паймон не может решить, чем бы пообедать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440940,
					"content": "Кстати, про обед... В банях обещают изысканные деликатесы, а мы вроде как особо важные гости. Значит, мы сможем съесть сколько захотим? Такие приглашения на дороге не валяются!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440938,
					"content": "Интересно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "У меня всё отлично.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
