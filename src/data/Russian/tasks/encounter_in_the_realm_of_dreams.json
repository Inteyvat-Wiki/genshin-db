			},
			"dialogs": [
				{
					"id": 120440201,
					"content": "А помнишь, как мы здесь гонялись за тануки? Славное было времечко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440202,
					"content": "М? Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440203,
					"content": "Тануки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "Не похоже... Неужели в Инадзуме появились новые ёкаи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440206,
					"content": "Э... Кажется, он хочет позвать нас за собой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120440204,
					"content": "Поросёнок?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
			"id": 1204403,
