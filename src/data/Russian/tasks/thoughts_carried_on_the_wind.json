			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Глория"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "Надеюсь, с Годвином всё в порядке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350402,
					"content": "Годвин попросил проведать тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "Годвин? Вы... Вы знаете, где он? Я так давно от него ничего не слышала. Я так волнуюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350404,
					"content": "Он ещё на задании далеко отсюда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Ах... Тогда ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350406,
					"content": "Если бы не метеориты, я бы спросила у рыцарей, где он...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350407,
					"content": "Я всё жду в городе. Тут безопасно. Но он всё ещё на задании. А что, если это происходит по всему миру?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350408,
					"content": "Ах, надеюсь, с ним всё в порядке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350409,
					"content": "Конечно, с ним всё в порядке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Спасибо за ваши слова. Не согласитесь ли вы мне помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350411,
					"content": "Я купила у Флоры семена одуванчиков, хотела, чтобы кто-нибудь помог мне рассеять их с высокого холма... Пусть ветер отнесёт их к Годвину.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350412,
					"content": "Но вы видели, что творится в городе. Некому сейчас мне помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350413,
					"content": "Раз уж вы здесь, можно попросить вас передать семена Годвину?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350414,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "Спасибо вам. Хоть он и в далёких краях, но всё-таки он выполняет задание с рыцарем Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "Глория"
				},
				{
					"id": 411350416,
					"content": "Пожалуйста, передайте ему семена, скажите, что у меня всё хорошо и пусть он там поаккуратнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Глория"
				}
			]
		},
