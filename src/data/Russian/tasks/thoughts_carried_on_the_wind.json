			"trigger": {
				"objectNames": [
					"Годвин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "Как же там Глория...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "#А! Путешественн{F#ица}{M#ик}! Сейчас здесь опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350104,
					"content": "Если ищешь, где укрыться, то лучше всего вернуться в Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350105,
					"content": "А ты не пойдёшь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "Я... Я пока здесь побуду. В конце концов, я тоже рыцарь Ордо Фавониус... Мы не может отступать в такое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350107,
					"content": "По некоторым причинам я не могу пойти помогать в Мондштадте, но и здесь ещё есть много дел.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350108,
					"content": "Падение метеоритов повлияло на монстров, и теперь они стали особенно свирепыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350109,
					"content": "Если за ними не приглядывать, то не миновать беды. Я как раз собирался пойти разобраться с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350110,
					"content": "Ты справишься один?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "Эм... Хотя их довольно много... Если буду осторожен, то всё будет хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350112,
					"content": "Но если пойду один, то даже не знаю, сколько это займёт времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350113,
					"content": "#Путешественн{F#ица}{M#ик}, может быть, поможешь мне зачистить лагерь монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350114,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "Большое спасибо, ты мне очень поможешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350116,
					"content": "А почему ты не попросил рыцарей помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "Попросить рыцарей... Нет, не могу. Скажем, есть тут некоторая сложность. Даже не спрашивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350118,
					"content": "Помоги мне с лагерем монстров. Считай, и Ордо Фавониус поможешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Годвин"
				}
			]
		},
		{
			"id": 4113502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
