				"points": []
			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "Ну где же магистр? Такое произошло... Получил ли он сообщение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350202,
					"content": "Хотя если и получил, то, наверное, не сможет так быстро вернуться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Годвин"
				}
			]
		},
		{
			"id": 4113503,
			"completionStepIds": [
				4113505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113505",
							"2"
						],
						"stepId": 4113505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Годвин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "Вы уничтожили всех этих монстров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350302,
					"content": "С ними покончено.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "#Спасибо тебе, путешественн{F#ица}{M#ик}. Монстры ещё какое-то время не побеспокоят нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350304,
					"content": "Иди обратно в город. Прости, что пришлось бегать по пустошам в такое время.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350305,
					"content": "А, и... когда вернёшься в город, можешь кое-что проверить для меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350306,
					"content": "Совсем несложно! Просто проверить кое-что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350307,
					"content": "Да в чём же дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "Это... Когда вернёшься в город, можешь проверить, как там Глория?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350309,
					"content": "Она в безопасности за стенами города, но я всё равно волнуюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350310,
					"content": "Прошу тебя, посмотри, как она там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350311,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "#Спасибо тебе, путешественн{F#ица}{M#ик}. Ах, да... Не говори ей, что я здесь. Просто... скажи, что я ещё на задании далеко отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "Годвин"
				},
				{
					"id": 411350313,
					"content": "Прости за беспокойство, но я рассчитываю на тебя. Обязательно так ей и скажи. Есть тут некоторая сложность... Спасибо тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Годвин"
				}
			]
		},
		{
			"id": 4113504,
			"completionStepIds": [
				4113506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
