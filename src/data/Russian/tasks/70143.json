			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "#Привет, путешественни{F#ца}{M#к}. Надеюсь, твои приключения проходят гладко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430202,
					"content": "Довольно гладко.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "Это замечательно. На самом деле я слежу за твоими успехами. Не сомневаюсь, что если ты будешь продолжать в том же духе, то однажды обязательно станешь выдающимся искателем приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430204,
					"content": "Что касается других мероприятий Гильдии... Я хотела бы поделиться с тобой некоторыми разведданными, если тебе интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430205,
					"content": "Для меня есть новые поручения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "#По твоему тону можно сказать, что ты уже хорошо знаком{F#а} с принципами работы нашей Гильдии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430207,
					"content": "Однако в этот раз у меня нет для тебя новых поручений. Я всего лишь хочу поделиться с тобой некоторыми разведданными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430208,
					"content": "Это разведданные о Драконьем хребте, снежной горе недалеко от Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430209,
					"content": "У подножия горы Гильдия уже разбила лагерь и разместила в нём некоторое количество искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430210,
					"content": "Я отметила это место на твоей карте. По прибытии отыщи искательницу приключений по имени Айрис. Она введёт тебя в курс дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 701430211,
					"content": "Вот и всё. Счастливых приключений тебе. К звёздам и к безднам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				}
			]
		}
	]
}