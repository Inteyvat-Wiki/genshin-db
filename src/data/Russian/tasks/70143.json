			"dialogs": [
				{
					"id": 701430101,
					"content": "Насчёт приключений на Драконьем хребте...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430102
					]
				},
				{
					"id": 701430102,
					"content": "Если ты действительно хочешь искать приключения на Драконьем хребте, сначала нужно обязательно всесторонне подготовиться. Нельзя недооценивать опасности этих гор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430103
					],
					"speakerTitle": "Айрис"
				},
				{
					"id": 701430103,
					"content": "Драконий хребет не прощает легкомысленных искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айрис"
				}
			]
		},
		{
			"id": 7014302,
			"completionStepIds": [
				7014302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7014302",
							"2"
						],
						"stepId": 7014302,
						"stateName": "QUEST_STATE_UNFINISHED"
