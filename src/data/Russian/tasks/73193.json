			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Саббах"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "#Ты умеешь использовать силу Дендро? Неужели я встретила {F#обладательницу}{M#обладателя} Глаза Бога...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930902,
					"content": "Я давно не встречала таких людей. Ах, как я тоскую по тем временам...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930903,
					"content": "Саббах, теперь всё должно быть в порядке, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731930904,
					"content": "Верно, они скоро прорастут, если использовать силу Дендро. Давайте подождём и посмотрим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930905,
					"content": "Из земли медленно проросли несколько тонких побегов.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "А когда появились несколько зелёных листьев, рост неожиданно остановился.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#Они прорастают! Паймон знала, что {NICKNAME} может справиться с чем угодно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 731930908,
					"content": "Результат появился сразу... Спасибо вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930909,
					"content": "Жаль, что пока нет цветков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "Это естественный процесс. Такие вещи нельзя торопить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930911,
					"content": "#Растения должны пройти все стадии роста. Просто потрясающе, что ты заставил{F#а} их так быстро прорасти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930912,
					"content": "Дай розам больше времени, чтобы они впитали питательные вещества и расцвели. Это пойдёт им на пользу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930913,
					"content": "Я очень благодарна за то, что вы сделали сегодня, и больше вас не побеспокою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Саббах"
				},
				{
					"id": 731930914,
					"content": "Если будет время, заходите полюбоваться ими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Саббах"
				}
			]
		}
	]
