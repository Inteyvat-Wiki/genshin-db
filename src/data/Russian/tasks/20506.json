					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "Приветствую вас! Я Тимей, исследователь алхимии. Добро пожаловать в Мондштадт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060102,
					"content": "Алхимии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "Искусство алхимии передавалось из поколения в поколение долгие века, но сейчас это тайное знание практически утрачено...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060104,
					"content": "Алхимия базируется на загадочных магических принципах. Её законы отличаются от нашего привычного понимания физического мира.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060105,
					"content": "Если мы познаем секреты алхимии, то сможем делать удивительные вещи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060106,
					"content": "Это твоя алхимическая лаборатория?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205060107,
					"content": "Всё верно. Хочешь попробовать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060108,
					"content": "Даже не знаю. Это всё так сложно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "Не бойся. На самом деле всё просто. Если интересно, я могу научить тебя основам алхимии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060111,
					"content": "Алхимия",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "Вдруг я что-нибудь сломаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050602",
							"2"
						],
						"stepId": 2050602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Тимей"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "Как крууууто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205060202,
					"content": "Нам остаётся только тщательно воспроизводить методы древних.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060203,
					"content": "Для того чтобы летать на планере, тебе не нужно знать, как именно он устроен. С алхимией точно так же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060204,
					"content": "С той лишь разницей, что каждый раз, когда я уверен, что всё идет по плану, происходит что-то абсолютно неожиданное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060205,
					"content": "Какое ещё применение есть у алхимии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "Честно сказать, я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060210,
					"content": "Меня ждёт ещё столько неизученных рецептов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060211,
					"content": "Наверняка и ты найдёшь древние алхимические рецепты во время своих приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060212,
					"content": "Чем выше будет твой Ранг приключений, тем больше рецептов тебе станет доступно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060213,
					"content": "Спасибо, теперь стало чуть-чуть понятней.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "Не благодари. Мне уже не терпится узнать о твоих открытиях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060218,
					"content": "Увидимся. Пусть ветер приносит тебе только благие вести.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060215,
					"content": "Возможно, у меня получится сотворить новую Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "Что это за навязчивая идея?! А чем тебя эта Паймон не устраивает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205060217,
					"content": "Ха-ха! А вы отличная парочка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Тимей"
				},
				{
					"id": 205060207,
					"content": "А можно сотворить новую Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "Эй! Зачем тебе новая Паймон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 205060209,
					"content": "Ха-ха! Боюсь, у меня не получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Тимей"
				}
			]
		}
	]
}