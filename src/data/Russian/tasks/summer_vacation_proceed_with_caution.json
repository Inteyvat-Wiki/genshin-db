				"points": []
			},
			"dialogs": [
				{
					"id": 400110301,
					"content": "А? Я могу чем-то помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110302,
						400110306
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110302,
					"content": "Насчёт архипелага...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110303
					]
				},
				{
					"id": 400110303,
					"content": "Хочу сказать, что здесь очень красивое море!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110304
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110304,
					"content": "Море и солнце... О таком лете я и мечтала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110305
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110305,
					"content": "Так хочется устроить выступление с видом на море! Было бы очень здорово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110306,
					"content": "О летнем наряде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110307
					]
				},
				{
					"id": 400110307,
					"content": "Мне идёт? Неплохо, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110308
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110308,
					"content": "Я хотела всех удивить, поэтому специально выбрала наряд, подходящий к атмосфере острова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110309
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110309,
					"content": "А, не волнуйся! Я хоть и в летней одежде, но на меня всегда можно положиться!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				}
			]
		},
		{
