					"nextDialogs": [
						400110744
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110744,
					"content": "Но сначала давайте просто посмотрим поблизости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
