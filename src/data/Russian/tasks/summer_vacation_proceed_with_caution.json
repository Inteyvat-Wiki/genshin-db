	"talks": [
		{
			"id": 4001101,
			"completionStepIds": [
				4001101
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001101",
							"2"
						],
						"stepId": 4001101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Джинн",
					"Барбара",
					"Кли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "Ах... Какая хорошая погода. Паймон как будто до сих пор во сне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110102,
					"content": "Доброе утро! Ой! А что это за наряды?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110103,
					"content": "Хе-хе. Нам идёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110104,
					"content": "Мы переоделись по-летнему! Хотя мы сюда приехали не развлекаться... Но не хочется пропускать такие летние деньки у моря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110105,
					"content": "Выглядит не слишком странно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110106,
					"content": "Такая элегантная и лёгкая одежда мне явно не подходит... Кхм! Простите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110107,
					"content": "Вовсе нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "#Правда?.. Спасибо, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110110,
					"content": "Но то, что магистр Джинн подготовила летнюю одежду, просто поразительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110111,
					"content": "Нет-нет, сестра никогда бы этого не сделала. Мы с Лизой выбрали одежду за неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110112,
					"content": "Назвала её сестрой и даже не заметила... Барбара уже опьянела от лета!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110113,
					"content": "Летняя одежда... Та ещё история.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110114,
					"content": "Я думала, что свёрток от Лизы - это что-то на экстренный случай. Вот уж не думала, что там одежда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110115,
					"content": "И все эти украшения... Точно Лизиных рук дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110116,
					"content": "Все в Ордо Фавониус постоянно уговаривают меня взять отпуск. Пожалуй, я действительно слишком много работаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110117,
					"content": "Подойдите скорее сюда!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110118,
					"content": "Это голос Кли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110119,
					"content": "Здесь что-то странное!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110120,
					"content": "А? Что происходит? В смысле «что-то странное»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110121,
					"content": "Смотрите на море!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110122,
					"content": "Видите? Там что-то странное плавает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110123,
					"content": "Длинный предмет... Похоже на буёк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110124,
					"content": "Но когда мы прибыли вчера, ничего такого не было...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110125,
					"content": "Это Додокороль оставил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110126,
					"content": "Странные приспособления, которые появились за ночь... Что-то здесь не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110127,
					"content": "Он так и не пришёл к Кли. Это значит, что он не признаёт меня? Или...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110128,
					"content": "Может быть, он ждёт, пока я его найду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110129,
					"content": "Какой может быть смысл во внезапно появившихся буйках?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110130,
					"content": "Посмотрим поближе и узнаем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "Точно, гадая на берегу, мы ничего не поймём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110132,
					"content": "А ничего страшного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110133,
					"content": "Лучше всего подобраться к буйкам и проверить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110134,
					"content": "Сложно сказать, что нас может ожидать в море. Так что будьте готовы к битве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110135,
					"content": "Когда будете готовы, соберёмся здесь и отправимся туда на лодке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110136,
					"content": "Вот это наша Джинн!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "Брось. Это просто мой долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110139,
					"content": "Ладно, тогда оставляю подготовку на вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110137,
					"content": "На Джинн даже в летнем наряде можно положиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "Выглядишь замечательно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
