					"Кли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110401,
					"content": "Хм, не забыть взять Прыг-скок бомбы, Додоко... и себя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110406,
						400110402
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110406,
					"content": "О буйках...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110407
					]
				},
				{
					"id": 400110407,
					"content": "Их точно Додокороль в море запустил! Он плохой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110408
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110408,
					"content": "Но я смело встречусь с ним! Я сделаю всё для Додоко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110409
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110409,
					"content": "#{M#Дядя}{F#Тётя} почётный рыцарь, спасибо, что мне помогаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110402,
					"content": "О лете...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110403
					]
				},
				{
					"id": 400110403,
					"content": "Я люблю лето! Но не только лето...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110404
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110404,
					"content": "Ещё я люблю осень. А, да! Весну и зиму тоже люблю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110405
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110405,
					"content": "Хотя зимой очень холодно, но у меня есть Прыг-скок бомба. Если я замерзну, то всегда можно что-нибудь взорвать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
				}
			]
		},
		{
			"id": 4001105,
			"completionStepIds": [
				4001104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001104",
							"2"
