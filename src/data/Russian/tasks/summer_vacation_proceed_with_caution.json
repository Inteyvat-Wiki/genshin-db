						],
						"stepId": 4001109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "Что эти буйки могут значить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110202,
					"content": "Насчёт архипелага...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "Эти острова изолированы от всего мира. Будто секретное убежище, созданное самой природой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110204,
					"content": "Нас привело сюда письмо... И Венти с Двалином помогли... Слишком много совпадений, меня это немного беспокоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110205,
					"content": "Но я здесь, чтобы всех защитить. Так что не беспокойся, что бы ни случилось, я буду рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110206,
					"content": "О летнем наряде...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110207
					]
				},
				{
					"id": 400110207,
					"content": "А... Это... Это Лиза мне сюрприз сделала. Думаю, не обошлось без совета Барбары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110208,
					"content": "Да и Барбара только что сказала, что раз уж мы на острове, то для летнего настроения обязательно надо переодеться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110209
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110209,
					"content": "Но я не очень привыкла к такой одежде... Надеюсь, это не выглядит слишком нелепо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				}
			]
		},
		{
			"id": 4001103,
