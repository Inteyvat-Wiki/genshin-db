			},
			"dialogs": [
				{
					"id": 400110601,
					"content": "Осторожно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110602
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110602,
					"content": "А? Это очень высокий человек?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110603,
					"content": "Похоже на человека, но что-то с ним не то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110604
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110604,
					"content": "Додокороль, я тебя вижу! Я готова принять су... эм... промо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110605
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110605,
					"content": "Правосудие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110606,
					"content": "Да! Ты можешь правосудить Кли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110607
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110607,
					"content": "А! Чего она такое говорит?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110608
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110608,
					"content": "Очевидно, что она не знает, что это слово значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110609
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110609,
					"content": "Эй, Додокороль! Ты чего на меня внимания не обращаешь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110610
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110610,
					"content": "Ты сердишься из-за того, что я так долго сюда добиралась? Ну... тогда извини!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110611
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110611,
					"content": "Извиняется перед противником? У Кли явно своя особенная логика...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110612
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110612,
					"content": "ДО! ДО! КО! РОЛЬ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110613
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110613,
					"content": "Похоже, что Кли его совсем не интересует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110614
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110614,
					"content": "Это какая-то машина в виде человека. Никакой реакции... Наверное, сломана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110615
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110615,
					"content": "Ты такие уже видела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110616
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110616,
					"content": "Могу только догадываться. Он явно не вписывается в пейзаж этого острова... Судя по одежде, он из Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110617
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110617,
					"content": "Инадзума? Это же очень далеко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110618,
					"content": "То есть это чужеземец?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110619
					]
				},
				{
					"id": 400110619,
					"content": "Да. Эта часть моря никому не принадлежит и не граничит ни с какими странами. Так что он, пожалуй, тоже чужеземец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110620
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110620,
					"content": "Но учитывая текущую ситуацию в Инадзуме, как такое могло случиться?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110621
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110621,
					"content": "Безмолвный чужеземец... Странно! Кто-то его сюда принёс?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110622,
					"content": "О нет! Додокороль больше не двигается!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110623,
					"content": "Кли, может быть, Додокороль устал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110624,
					"content": "Точно-точно! Додокороль просто уснул. Он так терпеливо тебя ждал, а потом зевнул и уснул!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110625,
					"content": "Да, мы пойдём с Кли поиграем где-нибудь, а потом вернёмся, когда Додокороль проснётся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110626,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110627,
					"content": "Конечно! Поверь нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110628,
					"content": "Хм... Нет, я поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110629,
					"content": "Это не Додокороль. Настоящий Додокороль где-то в другом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110630,
					"content": "А? Ты уверена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110631,
					"content": "Я не сдамся. Только погоди, Додокороль! Я тебя найду!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110632,
					"content": "Опять убежала... Какая она резвая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110633,
					"content": "Кли, подожди нас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Барбара"
				}
			]
		},
