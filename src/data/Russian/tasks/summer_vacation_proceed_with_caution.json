			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Барбара",
					"Кли",
					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110501,
					"content": "Что здесь происходит? Местный океан слишком непонятен!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110502,
					"content": "Только что целый участок земли поднялся из воды!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110503
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110503,
					"content": "Додокороль! Додокороль! Я тебя поймаю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110504
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110504,
					"content": "Кли всегда такая активная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110505,
					"content": "Перед тем, как земля задрожала, я услышала звук, похожий на механический. Мне кажется, что под морем здесь находится какой-то гигантский механизм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110506
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110506,
					"content": "Если весь архипелаг расположен на некой механической структуре, то при активации она вполне может поднимать каждый остров из-под воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110507
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110507,
					"content": "Это было бы настоящим чудом... Неужели это сила Анемо Архонта Барбатоса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110508
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110508,
					"content": "Нет, наверное? Паймон кажется, что это кто-то специально всё подстроил...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110509,
					"content": "Как бы то ни было, это невероятно. Заманить нас сюда письмом, чтобы испытать подобным механизмом... Этот так называемый Додокороль не простак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110510,
					"content": "Джинн права.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110511
					]
				},
				{
					"id": 400110511,
					"content": "Эх, вот и праздничное настроение пропало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110512
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110513
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110513,
					"content": "Я изо всех сил буду сохранять предельную бдительность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110514
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110514,
					"content": "Ого! Магистр Джинн такая крутая, когда настроена решительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110515
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110515,
					"content": "Мы с Паймон тоже будем осторожны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110516
					]
				},
				{
					"id": 400110516,
					"content": "Спасибо за ваше понимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110517
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 400110517,
					"content": "Я нашла его! Это Додокороль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110518
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110518,
					"content": "Вон на том острове! Хи-хи, попался!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110519
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110519,
					"content": "Хотел, чтобы Кли тебя нашла, а вот и Кли! Прыг-скок бомбы, приготовились! Бежим вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110520
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 400110520,
					"content": "Это... <color=#00E1FFFF>Платформа посреди моря</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110521
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110521,
					"content": "Что-то появилось. Мы можем подойти поближе, но будьте все осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джинн"
				}
			]
		},
