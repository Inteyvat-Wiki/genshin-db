			"dialogs": [
				{
					"id": 400110701,
					"content": "Почётный рыцарь, взгляни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110702
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110702,
					"content": "А? Что это такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110703
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 400110703,
					"content": "Сложенные камушки и маленькие цветочки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "Барбара"
				},
				{
					"id": 400110704,
					"content": "Похоже на чей-то мемориал.",
