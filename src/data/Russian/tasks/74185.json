			},
			"dialogs": [
				{
					"id": 741850101,
					"content": "Эст, мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741850102,
					"content": "О, так оказывается... Подождите, нет, кто вы такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850103,
					"content": "#Что? Ты нас не узнаёшь? Мы {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} и Паймон... Я слышал эти имена, но это было во сне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850105,
					"content": "Ох... Но тогда ты точно не спал, Эст! А ещё, пока мы были внизу, то видели...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741850106,
					"content": "Ах, мне приснилось, что всех жителей превратили в каменные статуи, и только я один из деревни остался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850107,
					"content": "Пока наконец не появились два отважных героя и не взяли на себя задачу спасти всех... Может быть, это был вовсе не сон?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850108,
					"content": "Может, да, а может, и нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Да, в любом случае теперь все вернулись к нормальной жизни, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741850111,
					"content": "Но, кажется, всем приснились очень странные сны. Что же это произошло? Неужели мы попали под массовый гипноз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850112,
					"content": "Боюсь, чтобы всё объяснить, потребуется не один день... Давайте пока забудем о гипнозе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741850113,
					"content": "Кстати о гипнозе. Вы взяли с собой кота. Он кажется разумным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850114,
					"content": "Он ещё умнее, чем кажется.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "Он наш компаньон, но мы не можем взять его с собой в путешествие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741850118,
					"content": "Какое совпадение. Так получилось, что у нас в клубе остался кошачий домик. Он пустует с тех пор, как один любитель гипноза отправился со своим котом в путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850119,
					"content": "Если не возражаете, то можете оставить его здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850120,
					"content": "Не знаю почему, но между нами возникла особая связь. Я помогу вам присмотреть за ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850121,
					"content": "Кошачий домик находится с другой стороны здания. Если пройдёте, то сразу увидите его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эст"
				},
				{
					"id": 741850116,
					"content": "Он наш компаньон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "Это правда, но мы не можем взять его с собой в путешествие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741850109,
					"content": "Это неважно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
