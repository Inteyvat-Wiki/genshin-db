			"dialogs": [
				{
					"id": 100080101,
					"content": "Рэйзор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080102,
					"content": "Чую знакомый запах. А, это вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080103,
					"content": "Как поживаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080104,
					"content": "Хе-хе, отлично. Кстати, Рэйзор, почему Бореалис исчез, как только нас увидел? Какие секреты вы обсуждали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080105,
					"content": "Начинаем охоту, я убеждаю... вожака.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080106,
					"content": "Охота?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080107,
					"content": "#({NICKNAME}, может быть, это и есть «задание» для Рэйзора?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080108,
					"content": "Рэйзор, неужели у волчьей стаи снова нет еды, и всем нужно идти на охоту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080109,
					"content": "Дай мне капкан...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "Нет. Эта охота не ради еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080112,
					"content": "Мы охотимся на... врагов. Стая чёрных волков, захваченная территория... Странный запах. Всё сильнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080113,
					"content": "Нужно очистить лес... Охота на врага.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080114,
					"content": "Значит, Бореалис согласился? Паймон припоминает, как он сказал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080115,
					"content": "Как же там было?.. Кхе-кхе. «Рэйзор не должен вмешиваться. Волки сами разберутся».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080117,
					"content": "Ах, Паймон не хотела... Прости, Рэйзор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080118,
					"content": "Ничего страшного, ведь со мной Лупикал. К тому же наставница научила меня, как разговаривать с лордом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080119,
					"content": "Лиза научила тебя... как говорить с лордом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080120,
					"content": "А! Ты говоришь о способе убедить Волчьего лорда? У тебя получилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080121,
					"content": "Да, говорить было утомительно, но... у меня получилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080122,
					"content": "Надо же, тебе удалось убедить этого упрямого здоровяка! Потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080123,
					"content": "Чёрные волки - враги всего мира. Наставница говорит: дело не в волке, а в мире... Наставница права, и лорд признал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080124,
					"content": "Волчья стая не будет участвовать. Война между мной и чёрной стаей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080125,
					"content": "Хе-хе, тогда мы поможем! Эти ужасные гончие Разрыва нам тоже не по душе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080126,
					"content": "С-спасибо... Если вы поможете, всё получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080127,
					"content": "Но как нам начать охоту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080128,
					"content": "Ловушка. Загнать стаю чёрных волков сюда...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080129,
					"content": "Лорд загонит их в ловушку, а мы... разделаемся с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080130,
					"content": "#Дай знать, когда будешь готов{F#а}. И мы начнём охоту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080401,
					"content": "Сейчас же выдвигаемся!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "...Лесные кабаны выросли крупными.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
		{
