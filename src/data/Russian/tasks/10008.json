			"dialogs": [
				{
					"id": 100080601,
					"content": "Получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080602,
					"content": "Спасибо... за помощь. Я думал, что защита Лупикал - это моя обязанность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080603
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080603,
					"content": "Но Лупикал тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080604
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080604,
					"content": "Мы здесь, потому что заботимся о тебе так же, как и ты о нас! Это и делает нас Лупикал, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080605,
					"content": "Верно... Мы навсегда Лупикал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080606
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080606,
					"content": "Хе-хе, в Вольфендоме больше не будет незваных гостей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080607
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080607,
					"content": "Нет... стая чёрных волков разорвала пространство. Они... могут вернуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080608
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080608,
					"content": "Но я и Лупикал будем их преследовать... несмотря ни на что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080609
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080609,
					"content": "...Не забывай о нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080610
					]
				},
				{
					"id": 100080610,
					"content": "Да-да, если тебе нужна будет помощь, обязательно говори, мы поможем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080611
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080611,
					"content": "Да... спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080612
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080612,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080613
					],
					"speakerTitle": "Волчий вой вдали"
				},
				{
					"id": 100080613,
					"content": "Они... зовут меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080614
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080614,
					"content": "Хе-хе, похоже, они беспокоятся о тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080615,
					"content": "Мне... пора идти. Спасибо... за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080616
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080616,
					"content": "Не стоит благодарности. Для этого и нужна Лупикал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080617
					]
				},
				{
					"id": 100080617,
					"content": "Вольфендом обрёл недолгое, но долгожданное спокойствие. Рэйзор попрощался с вами и скрылся в лесу.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						100080618
					]
				},
				{
					"id": 100080618,
					"content": "Среди густой листвы вы замечаете несколько пар глаз, которые смотрят на него с теплотой, желая поприветствовать его дома.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
