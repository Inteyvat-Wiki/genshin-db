					},
					{
						"sceneId": 20301,
						"position": [
							2108.748,
							253.717,
							-403.607
						],
						"pointId": 5
					},
					{
						"sceneId": 20301,
						"position": [
							2107.804,
							254.285,
							-402.662
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "Фух, повезло! Хорошо, что волки помогли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080302,
					"content": "Да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080303,
					"content": "Они задержали гончих Разрыва... и помогали нам отгонять врагов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080304,
					"content": "Но это не волчье дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080305,
					"content": "Хе-хе, как ты хочешь помочь Лупикал, так и Лупикал не позволит тебе оказаться в опасности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080306,
					"content": "Возможно, они сказали Волчьему лорду: «Это не проблема Лупикал, это проблема всего мира!» И примчались на помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080307,
					"content": "Хм, Лупикал - это... Лупикал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080308,
					"content": "Я человек, но мне не нужно быть волком, чтобы быть Лупикал. Я... хочу им помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Рэйзор"
				},
				{
					"id": 100080309,
					"content": "Верно сказано, Рэйзор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 100080310,
					"content": "Возможно, Бореалис согласился помочь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "...потому что он знает твои чувства.",
					"roleType": "TALK_ROLE_PLAYER",
