	"talks": [
		{
			"id": 7905301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905301",
							"2"
						],
						"stepId": 7905301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Идия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790530101,
					"content": "Мы рады приветствовать вас в Мираже Велуриям. Надеемся, что здесь вы сможете позабыть о тяготах путешествия и как следует отдохнуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530102
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530102,
					"content": "Планировалось, что эту речь нужно говорить при первой встрече. Кто мог знать, что случится столько всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530103
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530103,
					"content": "Но теперь всё в порядке, и я решила, что лучше поздно, чем никогда... Ну, что скажете? Солидно звучит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530104,
						790530109,
						790530114,
						790530117
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530104,
					"content": "Расскажи о препринте...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530105
					]
				},
				{
					"id": 790530105,
					"content": "О, хотите услышать об основных принципах? На самом деле, я тоже не очень хорошо в них разбираюсь. Если вкратце, то создание препринта начинается с идеи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530106
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530106,
					"content": "Можно провести аналогию с ростом растения, который записан в семени, или с размахом крыльев у птицы, предопределённым уже в яйце.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530107
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530107,
					"content": "Все предметы становятся тем, чем им суждено стать, а самое начало, вполне возможно, уже заложило основу всего сущего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530108
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530108,
					"content": "Препринт - это и есть этот самый набросок, который затем расцветает в бутылке под действием преломлённых лучей. Но это волшебство проявляется лишь в той самой бутылке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530109,
					"content": "Расскажи об океанидах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530110
					]
				},
				{
					"id": 790530110,
					"content": "Хочешь знать, почему я сбежала из Фонтейна? Это будто воспоминания из прошлой жизни...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530111
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530111,
					"content": "Если нужно назвать причину, то это из-за воды, из-за того, что в Фонтейне изменилась вода. Для океанида эта вода наполнена... страданиями и злобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530112
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530112,
					"content": "Если мы хотели выжить, лучшим решением для нас стало покинуть родину. Как раз тогда я заблудилась и оказалась в пустыне...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530113
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530113,
					"content": "И надо сказать, пустыня эта просто гигантская!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530114,
					"content": "Расскажи о Родии.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530115
					]
				},
				{
					"id": 790530115,
					"content": "Вы о сестрице Родии? Вы встречались с ней?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530116
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530116,
					"content": "Кажется, она уже нашла своё пристанище... в деревне Цинцэ, что в Ли Юэ? В таком случае она действительно сейчас очень далеко, сестрица Родия...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Идия"
				},
				{
					"id": 790530117,
					"content": "Мы верим в тебя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530118
					]
				},
				{
					"id": 790530118,
					"content": "Да... Я приложу все силы! Прошу вас насладиться этом местом, в пустыне найти подобный уголок с достаточным количеством воды весьма нелегко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Идия"
				}
			]
		},
		{
			"id": 7905313,
			"completionStepIds": [
				7905302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905302",
							"2"
						],
						"stepId": 7905302,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"120310",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Идия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531301,
					"content": "Идия, у нас чрезвычайная ситуация!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531302,
					"content": "Мы нашли карманные часы! Посмотри, это случайно не карманные часы моры, о которых рассказывается в легендах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531303,
						790531304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531303,
					"content": "Они действительно такие золотистые и сверкающие!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				},
				{
					"id": 790531305,
					"content": "Хм, дайте-ка взглянуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531306
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531306,
					"content": "Вы... вы правда нашли их! Неужели всё действительно предопределено судьбой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531307
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531307,
					"content": "#Сюрприз, оставленный удивительным искателем приключений, {F#нашла легендарная путешественница}{M#нашёл легендарный путешественник}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531308
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531308,
					"content": "В этом чувствуется некое духовное наследие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531309
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531309,
					"content": "Ты так нахваливаешь нас... Паймон, конечно, счастлива, но куда интереснее, что ждёт нас теперь, когда мы нашли эти часы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531310,
						790531311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531310,
					"content": "Мы получим за это награду?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531312,
					"content": "Н-нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531313
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531313,
					"content": "На самом деле, мне и в голову не приходило, что их кто-нибудь найдёт... Я ведь и сама не помнила, где они зарыты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531314
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531314,
					"content": "Они сами по себе весьма ценны, не правда ли? Значит, дополнительной награды с меня не требуется.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531315
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531315,
					"content": "А я хотела бы записать эту новость. Подходящий стиль превратит это событие в захватывающую историю, красочное описание для будущих гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531316
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531316,
					"content": "А теперь карманные часы моры заменит другое сокровище - спрятанное вами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531317
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531317,
					"content": "Да, мы тоже обсуждали, что главная ценность таится в историях, стоящих за сокровищем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531318,
					"content": "#Итак, давай ещё раз как следует изучим эти часы, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531319,
					"content": "Идия, пожалуйста, запиши нашу историю покрасочнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531320,
					"content": "Не переживайте, я с этим справлюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531311,
					"content": "Начнётся секретное событие?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531304,
					"content": "На корпусе часов узор в виде моры!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				}
			]
		},
		{
			"id": 7905314,
			"completionStepIds": [
				7905304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905304",
							"2"
						],
						"stepId": 7905304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"120462",
							"1"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"0",
							"79053"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Идия"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531401,
					"content": "А, это вы... Судя по всему, вы хотите о чём-то спросить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531402
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531402,
					"content": "Если у вас вопросы о Мираже Велуриям, то вы обратились по адресу. Для меня Мираж то же самое, что морщинки на моих руках...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531403,
						790531405
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531403,
					"content": "Ты покрываешься... морщинами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531404
					]
				},
				{
					"id": 790531404,
					"content": "Это всего лишь метафора! У меня не могут появиться морщины!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531407,
					"content": "В общем, дело вот в чём: мы подобрали это письмо в парке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531408,
					"content": "Идия наверняка должна знать о его истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531409
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531409,
					"content": "С первого взгляда понятно, что это письмо от... О, я впервые такое вижу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531410
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531410,
					"content": "Морщинки на ладони показались странными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531411,
					"content": "Его... его явно кто-то спрятал, когда я отвлеклась на что-то. Вполне закономерно, что я впервые его вижу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531412
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531412,
					"content": "И по содержанию оно больше похоже на предсмертную записку. Чьё же оно? Стиль изложения кажется знакомым...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531413
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531413,
					"content": "Возможно, оно как-то связанно со Шкатулкой Синро?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531414
					]
				},
				{
					"id": 790531414,
					"content": "О! Я вспомнила! Его оставил тот старик, который принёс Шкатулку Синро. Это было почти в то же время, когда я оказалась в бутылке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531415
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531415,
					"content": "Тот старик был из Инадзумы. Когда он пришёл, он тут же спросил, не это ли тайное царство, где исполняют желания. Ещё он просил, чтобы я вернула его обратно на поле битвы из его прошлого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531416
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531416,
					"content": "Я пыталась ему объяснить, но... Его тело было в таком ужасном состоянии, было видно, что он проделал долгий путь. Его жизнь близилась к концу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531417
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531417,
					"content": "Он всё время повторял: «Прошу тебя, верни меня в тот день» или «Верни меня в ту битву...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531418
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531418,
					"content": "Поэтому я воспользовалась силой бутылки и... создала иллюзию той битвы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531419
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531419,
					"content": "А, поэтому в письме сказано «...наконец-то вернулся сюда»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531420
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790531420,
					"content": "Наверное, когда он на миг пришёл в себя, то увидел вокруг себя мираж той страшной битвы. Но он лишь широко улыбнулся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531421
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531421,
					"content": "Почему люди перед смертью вспоминают о таких ужасных сценах?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531422,
						790531423
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531422,
					"content": "Возможно, для него та битва обладала особым смыслом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531424,
					"content": "Этого мне не понять. Но в самый последний миг он казался довольным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531425
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531425,
					"content": "Если для исполнения его желания потребовалась такая сцена, то сложно представить, как мучительно было нести эту ношу столько лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531426
					],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531426,
					"content": "Шкатулка Синро пригодилась нам для перезапуска центрального узла. За это нам стоит благодарить того пожилого господина.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Идия"
				},
				{
					"id": 790531423,
					"content": "Возможно, там он чувствовал себя живее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531405,
					"content": "Правда? Дай посмотреть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531406
					]
				},
				{
					"id": 790531406,
					"content": "Это... это метафора. У меня такие же руки, как и у тебя, не на что там смотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "Идия"
				}
			]
		}
	]
}