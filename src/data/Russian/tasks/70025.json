			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элла Маск",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu... mimi tomo... У-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250202,
					"content": "Привет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika!! А... Это вы... Вы меня напугали. Пожалуйста, не мешайте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250204,
					"content": "Эй, разве это не ты сама позвала нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700250212,
					"content": "А? А-а! Это вы! Большое спасибо вам за помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250205,
					"content": "Правильно ли то, что записано в разговорнике? Можно ли использовать записи для мирного общения с хиличурлами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250206,
					"content": "Пустяки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "Ха-ха, моя работа над словарём продвигается широкими шагами! Ещё больше доводов в пользу того, что человечество сможет мирно сосуществовать с хиличурлами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250209,
					"content": "Жаль только, что не вышло наладить контакт с тем странным хиличурлом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250210,
					"content": "Согласно языковым материалам, которые мне удалось собрать, он, возможно, лишь очень хотел найти новых друзей на чужой земле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250213,
					"content": "Очень жаль, что мы не смогли хорошо пообщаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250214,
					"content": "А, кстати, это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250215,
					"content": "Я очень много раз вас беспокоила, поэтому прошу прощения. Надеюсь, если представится возможность, мы ещё поработаем вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700250211,
					"content": "Что? То есть этот тип всё-таки с самого начала мог хорошо говорить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700250207,
					"content": "Мне больше нравится мой способ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
}