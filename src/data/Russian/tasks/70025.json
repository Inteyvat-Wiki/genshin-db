				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250101,
					"content": "Здравствуйте, искатель приключений! Я уже знаю, что вы выполнили поручение. Спасибо за то, что помогаете гильдии искателей приключений! Вот ваша награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700250102,
					"content": "Хотя схватить того странного хиличурла не удалось, как и не удалось обнаружить причину беспорядков... Но, по крайней мере, в окрестностях вновь безопасно благодаря вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700250103,
					"content": "Кстати, Элла Маск ждёт вас в библиотеке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				}
			]
		},
		{
			"id": 7002502,
			"completionStepIds": [
				7002502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002502",
							"2"
