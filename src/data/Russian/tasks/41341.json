			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "П-приветствую, дорогие гости... Не желаете ли вы передохнуть и...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410203,
					"content": "Мы небесный фонарь принесли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "...Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410205,
					"content": "Юй, этот фонарик тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410206,
					"content": "Мэн Мэн? Ты сама его сделала? С-спасибо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410207,
					"content": "#Меня научил{F#а} эт{F#а}{M#от} {M#дяденька}{F#тётенька}. Какой-то он кривой получился... Т-тебе нравится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410208,
					"content": "Что ты, это отличный фонарик! Мне он очень нравится. Я уже переживал, что у меня не будет времени смастерить свой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410209,
					"content": "Спасибо, Мэн Мэн. Позже я попрошу кого-нибудь повесить его на дверь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410210,
					"content": "Но зачем?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Ну, эм... Папе постоянно нездоровится, а я слишком маленький и не дотягиваюсь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410213,
					"content": "Поэтому мне придётся кого-нибудь об этом попросить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410214,
					"content": "Я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "Ты правда поможешь? Как хорошо, спасибо тебе! Теперь мне не нужно беспокоиться, кого оставить смотреть за лавкой, пока я искал бы кого-нибудь помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410215,
					"content": "Оставь это мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "Неужели дома нет никого, кто может помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
