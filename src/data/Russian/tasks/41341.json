			"trigger": {
				"objectNames": [
					"Мэн Мэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "Делать небесные фонари так трудно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "#{NICKNAME}, ты умеешь плести небесные фонари? Я вот плету-плету, и ничего не получается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410104,
					"content": "Вот тут насквозь, потом обернуть... и каждый раз обязательно что-то отвалится или сломается...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410105,
					"content": "А я очень хочу сделать небесный фонарь для малыша Юя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410106,
					"content": "Малыш Юй постоянно приглядывает за чайной лавкой, и времени поиграть или делать небесный фонарь у него нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410107,
					"content": "Но он точно хотел бы загадать желание, поэтому я сделаю ему небесный фонарик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410108,
					"content": "Давай я тебе с этим помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "Но я хотела бы сделать для него фонарик сама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410111,
					"content": "А ещё я хочу узнать, как они делаются, чтобы потом рассказать малышу Юю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410112,
					"content": "#{F#Тётя}{M#Дядя} {NICKNAME}, научишь меня делать небесный фонарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410113,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "Ура! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410115,
					"content": "Выходит... небесный фонарь готов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410116,
					"content": "Спасибо! Скорее, отнесём фонарик малышу Юю!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410109,
					"content": "Я сделаю для тебя фонарик.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
