			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#Какой красивый небесный фонарик! Спасибо тебе, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410402,
					"content": "Ну, малыш Юй... Пойдём поиграем. Я тут видела одно место с красивейшими цветами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410403,
					"content": "#Только что эт{F#а}{M#от} {M#дяденька}{F#тётенька} показал{F#а} мне, как делать фонарики. Пойдём туда, и я научу тебя. Будет здорово, ну?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410404,
					"content": "Я... Не могу. Мне нужно оставаться в лавке. Пусть даже клиентов не будет, но я должен поддерживать идеальный порядок, как велел папа.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410405,
					"content": "Тогда... Тогда не будем делать фонарик. Просто сходим, поболтаем, а потом обратно. Много времени это не займёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410406,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410407,
					"content": "Я помогу тебе прибраться в лавке.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "К-как так? Я не могу просить тебя о таком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410410,
					"content": "Мы быстро! Одна нога тут, другая там. Ты и не заметишь, что куда-то уходил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410411,
					"content": "Спасибо тебе большое!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410408,
					"content": "Оставь уборку мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Малыш Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "Кажется, они всё ещё гуляют. Не стоит за них волноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413410702,
					"content": "Учитывая праздничную атмосферу... Их не следовало бы беспокоить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413410703,
					"content": "Интересно, о чём они будут беседовать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "Как думаешь, если мы сделаем твоему папе венок, он поправится быстрее?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410706,
					"content": "Не знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410707,
					"content": "Я читала, что любая болезнь стремительно отступает, если оставаться бодрым и радостным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410708,
					"content": "Думаю, твой папа очень рад видеть, что ты такой смышлёный и так ловко управляешься в лавке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410709,
					"content": "Но иногда папа ругается... Мол, «хватит торчать в лавке, иди поиграй» и всё такое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410710,
					"content": "«Если ты не выйдешь поиграть с Мэн Мэн, она всю округу без цветов оставит».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410711,
					"content": "А вот и нет, кругом полно цветов. Погоди, я сделаю тебе венок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410712,
					"content": "Спасибо, Мэн Мэн. Мне пора возвращаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410713,
					"content": "Ладно... Ведь когда он выздоровеет, ты будешь свободнее? Тогда я пришла бы к тебе поиграть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410714,
					"content": "Ага. Думаю, он скоро поправится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410715,
					"content": "Что?! ...И давно вы здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410716,
					"content": "#Я только что приш{F#ла}{M#ёл}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410718,
					"content": "Э... Я... Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410719
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410719,
					"content": "Счастливого вам Праздника морских фонарей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410720
					]
				},
				{
					"id": 413410720,
					"content": "И вам счастливого праздника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410721
					],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410721,
					"content": "И-и вас с праздником...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410722
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410722,
					"content": "Это... Спасибо тебе за всё. Вот, прими в знак благодарности. Папа говорит, что за помощь всегда нужно чем-нибудь отплатить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410723
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410723,
					"content": "Нам... нам нужно обратно в лавку. Пойдём, Мэн Мэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410724
					],
					"speakerTitle": "Малыш Юй"
				},
				{
					"id": 413410724,
					"content": "Да, мы пошли. Спасибо тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мэн Мэн"
				},
				{
					"id": 413410717,
					"content": "#Я ничего не слышал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410704,
					"content": "Послушаем их разговор.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				}
			]
		},
