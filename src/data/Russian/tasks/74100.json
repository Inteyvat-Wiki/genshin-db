			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мори"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "(Принюхивается.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Мори"
				},
				{
					"id": 741003102,
					"content": "Гав-гав! Хороший человек! Погладь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Мори"
				},
				{
					"id": 741003103,
					"content": "Конечно, я поглажу Мори.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Вы гладите Мори.\\n(Пёс) Мори создан из воды, поэтому он мокрый на ощупь.\\nНо Мори выглядит очень счастливым.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "Гав-гав! Спасибо, хороший человек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мори"
				},
				{
					"id": 741003106,
					"content": "В следующий раз поглажу тебя ещё, Мори.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "У-у-у... Мори плохой? Поэтому не гладишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Мори"
				},
				{
					"id": 741003108,
					"content": "При чём тут это?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "Гав-гав! Хороших собак гладят! Плохих собак... ремонтируют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Мори"
				},
				{
					"id": 741003110,
					"content": "У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Мори"
				},
				{
					"id": 741003111,
					"content": "Увидев, как огорчился Мори, вы решаете его погладить.\\n(Пёс) Мори создан из воды, поэтому он мокрый на ощупь.\\nСиние глаза Мори снова сияют.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "Гав-гав! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мори"
				}
			]
		}
	]
}