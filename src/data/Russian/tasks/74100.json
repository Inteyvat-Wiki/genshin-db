				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Жако"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#{NICKNAME}, это ты! Когда мы вернём сокровище Лирис, победа будет у нас в кармане.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "Жако"
				},
				{
					"id": 741002602,
					"content": "Наконец у нас появилась возможность изгнать захватчиков и спасти Лирис! А значит, Оркестр Жако исполнит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "Жако"
				},
				{
					"id": 741002603,
					"content": "Последнюю часть увертюры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "Жако"
				},
				{
					"id": 741002604,
					"content": "Правда? Это была всего лишь увертюра?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "#А? Неужели ты думал{F#а}, что история кончится спасением Лирис и восстановлением королевства? Ха! Это тебе не детская сказка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "Жако"
				},
				{
					"id": 741002607,
					"content": "Вот из-за таких наивных простаков человечество постоянно наступает на одни и те же грабли! Следующим шагом необходимо уничтожить укоренившуюся в обществе классовую структуру и изменить способы распределения общественных благ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "Жако"
				},
				{
					"id": 741002608,
					"content": "Только в справедливом мире, где все наделены равными правами... Хотя о чём я говорю, справедливость и есть равноправие, и именно такой мир хочет построить Лирис. И я потому ставлю справедливость и равноправие в один ряд, что в нынешнем положении...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "Жако"
				},
				{
					"id": 741002609,
					"content": "Ну... Я пойду...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "Прежде всего мы должны... учредить... свергнуть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Жако"
				},
				{
					"id": 741002605,
					"content": "#Я думал{F#а}, симфония близится к концу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
		{
			"id": 7410031,
