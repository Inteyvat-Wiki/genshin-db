			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хуссени"
				],
				"points": [
					{
						"sceneId": 6,
						"position": [
							1007.447,
							1015.942,
							879.091
						],
						"pointId": 600100139
					},
					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "Надо же, какая здесь необычная атмосфера. В таком случае энергетическая система шипа Пурсины...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010202,
					"content": "#{NICKNAME} и Паймон, давно не виделись. Что вы делаете в Разломе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010203,
					"content": "Ах да, Хедив рассказывал о твоей помощи отряду георазведки в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010204,
					"content": "Но сейчас в Разломе куда опаснее, здесь не место для прогулок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010205,
					"content": "Ты кто?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "Мы же недавно встречались, не помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010207,
					"content": "Конечно, при каждой встрече я доставляю тебе хлопоты, но это не повод делать вид, что мы незнакомы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010208,
					"content": "Ладно, снова представлюсь, я Хуссени, учёный из Академии Сумеру, раньше изучал Диск усиления, а ещё проводил исследования в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010209,
					"content": "Но сейчас средства на исследования закончились, поэтому пришлось вернуться в Сумеру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010210,
					"content": "Кажется, Паймон что-то припоминает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715010211,
					"content": "Правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010212,
					"content": "Ты же «господин Диск»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715010213,
					"content": "...Я уверен, что не представлялся никаким «господином Диском».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010214,
					"content": "В общем, по дороге в Сумеру я получил поручение от Хедива, моего коллеги по Академии. Хедив помогал мне раньше, в основном, с финансированием...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010215,
					"content": "Вот я и приехал, чтобы помочь ему разобраться с проблемой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010216,
					"content": "Ну вот я всё и объяснил, а что насчёт вас? Что вы делаете в Разломе в такое время?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010217,
					"content": "Мы решили взяться за поручение Хедива...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "А, вот как. Хедив говорил, что ищет помощников, и я тогда забеспокоился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010220,
					"content": "Но раз это вы, то мне не о чем волноваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010221,
					"content": "В одиночку мне было бы сложно справиться с этой чёрной грязью из Разлома. Но с вами шансов решить проблему куда больше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010222,
					"content": "Что нам нужно сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "Тебе известно о шипе Пурсины? Прибор, способный высвободить силы, нарушающие нормальное течение энергии в артериях земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010224,
					"content": "Предполагаю, что для очистки нужно установить шип Пурсины в местах выхода чёрной грязи и повлиять на артерии земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010225,
					"content": "Но какая связь между чёрной грязью и артериями земли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 715010226,
					"content": "Чёрная грязь появилась здесь из-за изменений в артериях земли. Есть вероятность, что это взаимосвязано. К такому заключению мы пришли с Хедивом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010227,
					"content": "Поэтому, если нарушить нормальное течение артерий земли и уничтожить их выход наружу, можно остановить появление чёрной грязи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010228,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
					"content": "Правда, мы впервые пытаемся не просто повлиять на артерии земли с помощью шипа, а полностью запечатать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010230
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010230,
					"content": "Я уже сделал кое-какие расчёты, настроил параметры шипа, теоретически проблем быть не должно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010231
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010231,
					"content": "Но теория - это теория, нужно ещё провести испытания. Я как раз собирался сделать пробный запуск, но это сопряжено с риском...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010232
					],
					"speakerTitle": "Хуссени"
				},
				{
					"id": 715010232,
					"content": "Я займусь испытаниями...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010233
					]
				},
				{
					"id": 715010233,
					"content": "Отлично, тогда поручаю это тебе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
