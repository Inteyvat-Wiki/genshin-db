				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166901",
							"2"
						],
						"stepId": 7166901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжэнь Чэнь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}, сотрудники сообщают, что ты {F#нашла}{M#нашёл} всех маленьких животных, оснащённых передатчиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690102,
					"content": "Это... удивляет, честно. Некоторые из них от природы чуткие и убегают, как только заметят незнакомое существо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690103,
					"content": "Однако они позволили тебе приблизиться. Довольно любопытно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690104,
					"content": "Я люблю животных.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "Ха-ха! Даже завидно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690107,
					"content": "В последние несколько раз, когда персонал сопровождал меня, чтобы покормить животных, на меня рычали и даже кусали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690112,
					"content": "У меня на руке остались шрамы... и они причиняют сильную боль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690113,
					"content": "И хотя эти милые создания, похоже, не очень-то меня любят, я рад, что у них всё хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690114,
					"content": "Как и все наши опекуны. Мы хотим защитить среду обитания животных и не тревожить их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690115,
					"content": "Я знаю, что для многих искателей приключений дикие животные являются важным источником пищи, и мы не просим членов Когтистого Конвоя совсем отказаться от охоты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690116,
					"content": "Но мы выступаем против бессмысленного отлова и истребления животных. Если бы каждый был в состоянии поступать так, окружающая нас среда, несомненно, стала бы более разнообразной и прекрасной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690117,
					"content": "#Было бы здорово, если бы ты тоже стал{F#а} руководствоваться этим принципом. Тем более, что ты {F#одна}{M#один} из нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690118,
					"content": "Полностью поддерживаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "Я знал, что ты, будучи рассудительным человеком, согласишься с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690122,
					"content": "Если мы донесём эту мысль до людей, это уже можно считать успехом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690123,
					"content": "По возможности приходи на следующее мероприятие Когтистого Конвоя. Буду очень рад тебя видеть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690124,
					"content": "Если повезёт, то к тому времени у меня на руке не будет свежих шрамов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690120,
					"content": "Пожалуй, я оставлю своё мнение при себе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "В этом нет ничего страшного, мы не заставляем всех принимать такое решение, но я бы хотел, чтобы каждый хорошо поразмыслил, прежде чем лишать животное жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Чжэнь Чэнь"
				},
				{
					"id": 716690105,
					"content": "#Вот такие мы, {F#искательницы}{M#искатели} приключений.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
