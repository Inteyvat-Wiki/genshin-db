			"dialogs": [
				{
					"id": 6070201,
					"content": "Оставьте страх. Монстры изгнаны в небытие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 6070202,
					"content": "Миледи имеет в виду, что сейчас лучше не выходить из дома без необходимости. Мы будем и дальше защищать ваш район.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 6070203,
					"content": "Спасибо! Большое спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Петрушка"
				},
				{
					"id": 6070204,
					"content": "Вот только... я никогда не видел, чтобы птица разговаривала, гм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Петрушка"
				},
				{
					"id": 6070205,
					"content": "О, не беспокойтесь, я всего лишь подданный миледи. Я не представляю для вас никакой угрозы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Оз"
				},
				{
					"id": 6070206,
					"content": "Им можно доверять, не бойся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "Ох, да! Конечно! Простите, я вовсе не то хотел сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Петрушка"
				},
				{
					"id": 6070208,
					"content": "Хм, забудь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Фишль"
				},
				{
					"id": 6070209,
					"content": "У моих вассалов остались невыполненные обязательства? Тогда ступайте и поразите жалких мятежников. Благословение принцессы осветит ваш путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фишль"
				}
			]
