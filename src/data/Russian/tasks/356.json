			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эмбер"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560401,
					"content": "А вот и обещанная награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560402,
					"content": "<color=#00E1FFFF>Планер</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560403,
					"content": "Такие есть у каждого скаута. Да и жители Мондштадта любят парить на ветру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560404,
					"content": "#Я привела тебя сюда для того, чтобы ты мог{F#ла} испытать его прямо сейчас!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560405,
					"content": "Тебе очень нравится парить на ветру, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3560406,
					"content": "Да, конечно! Ветер - это сердце Мондштадта!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560407,
					"content": "Ладно. Хватит болтать! Время парить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560408,
					"content": "Это очень легко, просто следуй моим инструкциям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				}
			]
		}
	]
}