				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "Добро пожаловать в город ветра, свободы и одуванчиков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560102,
					"content": "Мондштадт! Город, в котором за вашу безопасность отвечает Ордо Фавониус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560103,
					"content": "Наконец-то можно будет поспать в настоящей кровати!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3560104,
					"content": "Но горожане у вас выглядят как-то не очень счастливыми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3560105,
					"content": "Все переживают из-за этого дракона, Ужаса Бури.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560106,
					"content": "Но всё будет хорошо, потому что у нас есть Джинн!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560107,
					"content": "Джинн?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3560108,
					"content": "Действующий магистр Ордо Фавониус и главный защитник Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560109,
					"content": "Когда Джинн с нами, можно ничего не бояться. Даже Ужаса Бури!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560110,
					"content": "(Похоже, что эта Джинн - важная шишка...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#Кстати! {NICKNAME}, перед тем как мы пойдём в штаб Ордо Фавониус,\\nя хочу подарить тебе кое-что.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560113,
					"content": "Это награда за помощь с хиличурлами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560114,
					"content": "Эй! А я разве не заслужила награду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3560115,
					"content": "Ммм... Тебе эта награда ни к чему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560116,
					"content": "Но у меня есть для тебя традиционное мондштадтское угощение - медовое мясо с морковкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560117,
					"content": "Медовое мясо! С морковкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3560118,
					"content": "Но сначала мы поднимемся в <color=#00E1FFFF>верхнюю</color> часть города.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 3560111,
					"content": "(Надеюсь, она сможет рассказать об Анемо Архонте...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
		{
			"id": 35604,
			"completionStepIds": [
				35604
			],
