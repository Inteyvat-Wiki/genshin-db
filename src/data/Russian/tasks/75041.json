						],
						"pointId": 10040
					}
				]
			},
			"dialogs": [
				{
					"id": 750410301,
					"content": "Почему вы всё ещё здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410302
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750410302,
					"content": "Лидер отряда искателей приключений, герой в маске сокола, он... Мы не можем больше сопротивляться им...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410303
					],
					"speakerTitle": "Кенин"
				},
				{
					"id": 750410303,
					"content": "#Уходите, уходите. Это место проклято, {M#храбрый воин}{F#храбрая воительница}. Здесь не стоит людям оставаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кенин"
				}
			]
		},
		{
			"id": 7504104,
