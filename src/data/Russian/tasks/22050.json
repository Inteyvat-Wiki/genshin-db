					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "Это и есть Великий храм Наруками?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500202,
					"content": "Как много красных ворот. Людям нравится красный цвет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500203,
					"content": "Это называется тории.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "В святилище Асасэ тоже есть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500205,
					"content": "О, я начинаю понимать. Тории - место, где живут птицы, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500206,
					"content": "Чем больше торий, тем больше птиц, верно? Птицы - это хорошо. Люди тоже довольно умны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500207,
					"content": "Ты видишь Хибики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500208,
					"content": "Нет ни малейших следов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "Кажется, вокруг никого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500210,
					"content": "Давайте пойдём в Великий храм Наруками и спросим жриц.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500211,
					"content": "Хибики тоже должна быть жрицей. Может, они что-то знают.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "Мяу, это святилище очень большое, и здесь много людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500302,
					"content": "Вот это да! Ящик для подношений очень большой. Нэко не удивлена, что пришло так много людей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500303,
					"content": "Тебе нужно хорошенько поучиться у них. Однажды святилище Асасэ станет таким же величественным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500304,
					"content": "Вряд ли причина в этом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "К тому же Хибики нигде не видно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500307,
					"content": "Давайте спросим кого-нибудь о Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500305,
					"content": "#Почему учиться {F#должна}{M#должен} я?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Инаги Хотоми",
					"Нэко"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "#Привет, путешественни{F#ца}{M#к} издалека. Добро пожаловать в Великий храм Наруками!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500402,
					"content": "Если вы столкнётесь с неприятностями или просто захотите загадать желание, смело приходите сюда за предсказаниями, и да благословит вас Электро Архонт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500403,
					"content": "Мы здесь не за этим. Мы хотим спросить кое что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500404,
					"content": "Спросить? Ну что ж, спрашивай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500405,
					"content": "Тут такое дело...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "Хибики из святилища Асасэ. Неужели это Асасэ Хибики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500407,
					"content": "Да! Хибики - это Асасэ Хибики. Что ты знаешь о ней, человек? Ты знаешь, где она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500408,
					"content": "А?! Говорящая кошка! Или у меня начались галлюцинации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500409,
					"content": "Люди, любят делать много шума из ничего... Что удивительного в том, что Нэко говорит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500410,
					"content": "Вы знаете Хибики? Где она?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500411,
					"content": "Странно слышать такие вопросы от кошки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500412,
					"content": "К тому же если вы спрашиваете о Асасэ Хибики, то вы пришли не по адресу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500413,
					"content": "Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500414,
					"content": "Мы ошиблись местом?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "Я встречала её имя в немногих хорошо сохранившихся древних текстах святилища. Она - последняя наследница святилища Асасэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500416,
					"content": "Там говорилось, что около четырёх или пяти сотен лет назад «Трое из Ёго» - Асасэ Хибики, Камуна Харуносукэ и Микоси Нагамаса - однажды отправились на гору Ёго, чтобы учиться у тэнгу Ёго.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500417,
					"content": "В это время Асасэ проходила практику в нашем святилище, а также подружилась с кицунэ Сайгу. Однако в конце концов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500418,
					"content": "В конце концов, трое расстались после катастрофы, о которой в их рассказах было много неясного. Говорят, что Камуна Харуносукэ пересёк море и отправился в Ли Юэ, поскольку хотел научиться более могущественному пути Адепта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500419,
					"content": "Микоси Нагамаса вернулся в город Инадзума, чтобы служить сёгунату. Что касается Асасэ Хибики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500420,
					"content": "Она вернулась на остров Сэйрай...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "Это верно. Но поскольку исторической информации очень мало, детали не ясны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500423,
					"content": "Подожди...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "Она сказала четыреста или пятьсот лет назад. Хибики - человек из очень далёкого прошлого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500425,
					"content": "Значит, Нэко тоже четыреста или пятьсот лет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500426,
					"content": "Мяу? Я не уверена. Что значит четыреста или пятьсот лет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500427,
					"content": "Нэко - не человек. Не о чем беспокоиться. Нэко просто знает, что сначала всходит солнце, а затем - луна. Если у Нэко плохое настроение, сон - лучшее средство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500428,
					"content": "Паймон завидует...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500429,
					"content": "Паймон, для тебя это почти то же самое.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "Эй! Как грубо, Паймон каждый день беспокоится о тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500433,
					"content": "Нэко вас не понимает. Так что же стало с Хибики?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500434,
					"content": "При всём уважении, боюсь, что Асасэ Хибики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500435,
					"content": "Хибики здесь нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "Да-да, Хибики ушла в другое место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500438,
					"content": "Верно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500439,
					"content": "Ну что ж. Хибики словно ребёнок, бегает, как ей вздумается.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500440,
					"content": "Спасибо, госпожа жрица!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500441,
					"content": "Прошу прощения, нам пора идти.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500442
					]
				},
				{
					"id": 220500442,
					"content": "Берегите себя. Я готова помочь, когда понадобится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500431,
					"content": "Разве кошки живут так долго?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500432
					]
				},
				{
					"id": 220500432,
					"content": "Вообще-то нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500421,
					"content": "Она вернулась в святилище Асасэ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				}
			]
		},
		{
