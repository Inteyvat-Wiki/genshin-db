			"dialogs": [
				{
					"id": 220500501,
					"content": "Давайте отдохнём здесь. Нэко устала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500502
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500502,
					"content": "Это место похоже на то, о котором рассказывала Хибики.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500503,
					"content": "Разные острова действительно совершенно разные. Кроме того, оказалось, что святилище может находиться на такой высокой горе. Разве люди не боятся высоты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500504,
					"content": "Святилище Асасэ намного лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500505,
					"content": "Но где же всё-таки Хибики...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500506,
					"content": "Хочешь продолжить поиски?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "Нэко устала. Поговорим об этом потом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500508,
					"content": "Потом? Будет ещё и потом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220500509,
					"content": "Да. Хибики рассказала мне много-много историй. Истории о пляже, истории о месте, где много деревьев, истории о великой Кицунэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500510,
					"content": "Нэко помнит все эти истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500511,
					"content": "Сейчас самое главное - вернуться домой. Святилище Асасэ не может обойтись без настоятельницы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500512,
					"content": "Мы возвращаемся домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
				}
			]
		},
