			},
			"dialogs": [
				{
					"id": 220500601,
					"content": "Фух... наконец-то мы вернулись. После долгого пребывания рядом с этим святилищем, шерсть у Нэко начала скручиваться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500602,
					"content": "Большое спасибо за помощь. Ты на редкость надёжный человек.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500603
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500603,
					"content": "Нэко продолжит ухаживать за святилищем. Когда Хибики вернётся, Нэко познакомит вас с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500604
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500604,
					"content": "Мяу-мяу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500605
					],
					"speakerTitle": "Нэко"
				},
				{
					"id": 220500605,
					"content": "Хибики, когда же ты вернёшься...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нэко"
