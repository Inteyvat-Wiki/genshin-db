						220500702,
						220500705,
						220500710
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500702,
					"content": "О Микоси...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "Легенда гласит, что Микоси Нагамаса работал на сёгунат, и говорят, что он был чрезвычайно справедлив и честен, даже... упрям.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500704,
					"content": "Его род существует и по сей день. Большинство людей в городе, носящих сегодня фамилию Микоси, являются его потомками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500705,
					"content": "О Камуне...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "О нём сохранилось не так много записей. Он вернулся в Инадзуму после того, как изучал искусство Адептов в Ли Юэ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500707,
					"content": "Затем он создал свои собственные техники: Оммёдзи и Сики Тайсё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500708,
					"content": "Согласно записям, чтобы установить мир в Инадзуме, он однажды использовал эти техники, чтобы запечатать бакэ-дануки Иороя, который повсюду устраивал беспорядки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Инаги Хотоми"
				},
				{
					"id": 220500709,
					"content": "После этого о нём нет никакой информации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Инаги Хотоми"
