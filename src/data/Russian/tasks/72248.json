					"nextDialogs": [
						722480502
					]
				},
				{
					"id": 722480502,
					"content": "Тогда желаю... успехов в предстоящей битве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Абэраку"
				}
			]
		},
		{
			"id": 7224806,
