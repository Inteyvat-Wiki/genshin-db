			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вакарао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "И как же мне её вытащить? Вот незадача...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940102,
					"content": "Я могу помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "#О! {F#Добрая искательница}{M#Добрый искатель} приключений! Как ты вовремя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940104,
					"content": "Дело вот в чём. Когда-то в этой пещере был тоннель, ведущий на север. Но недавно из-за аномалии с куувяки в тоннеле произошёл обвал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940105,
					"content": "К счастью, никто не пострадал. Но странствующий купец из дальних краёв говорит, что его «спутница» застряла внутри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940106,
					"content": "Это ленивая овечка, которую он встретил здесь неподалёку. Если пробудешь здесь достаточно долго, поймёшь, что ленивые овечки следуют за людьми по большей части затем, чтобы семена распространились как можно дальше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940107,
					"content": "Но тот господин не слушает никаких объяснений и настаивает, что мы должны спасти ленивую овечку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940108,
					"content": "Восстановить тоннель, ведущий вглубь пещеры, можно только с помощью мудроцветов. К сожалению, я не владею магией Детей Морозной Луны, и у меня нет мощных устройств, работающих на куувяки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940109,
					"content": "#Хорошо, что я встретил тебя. Ты ведь искатель{F#ница} приключений? Наверняка тебе под силу вывести оттуда ленивую овечку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940110,
					"content": "Я отблагодарю тебя от лица того торговца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вакарао"
				}
			]
		},
		{
			"id": 7609402,
			"completionStepIds": [
				7609405
