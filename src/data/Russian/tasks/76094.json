			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вакарао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940501,
					"content": "#Ох, ты вызволил{F#а} из пещеры спутницу того иностранного торговца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940502,
					"content": "Мы все понимаем, что ленивые овечки следуют за людьми по большей части затем, чтобы семена распространились как можно дальше. Но тот господин и слушать меня не хочет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940503,
					"content": "#Право слово, я совсем не знал, что делать с этой бедой. Хорошо, что мне {F#встретилась такая отзывчивая искательница}{M#встретился такой отзывчивый искатель} приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940504,
					"content": "Прошу, прими это в знак благодарности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вакарао"
				}
			]
		}
