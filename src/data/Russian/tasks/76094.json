			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вакарао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "Отлично, я знал, что у тебя найдётся решение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940202,
					"content": "Ленивая овечка не может жить в среде без куувяки, но, по крайней мере, она может скрасить этому джентльмену время его пребывания в Нод-Крае.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Вакарао"
				},
				{
					"id": 760940203,
					"content": "Позволь мне откланяться. Прошу, прими это в знак благодарности...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вакарао"
				}
			]
		},
		{
			"id": 7609403,
