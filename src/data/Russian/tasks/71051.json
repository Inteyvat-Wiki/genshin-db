			"dialogs": [
				{
					"id": 710500801,
					"content": "О странном предмете у кромки воды...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "#Ты положил{F#а} ту штуку у кромки воды?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500803,
					"content": "Произошло что-нибудь интересное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500804,
					"content": "Появился вишап...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "Вишап? Эта штука превратилась в вишапа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500806,
					"content": "Нет. Вишап увидел её и приплыл...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500807,
					"content": "Нельзя же так пугать людей! Я думал, что штука превратилась в вишапа. Моя карта мира чуть не поменялась кардинальным образом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500808,
					"content": "Что это за штука в конце концов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "Всё довольно просто, но я не могу подобрать подходящие слова, чтобы объяснить. Скажи, в том вишапе было что-то особенное?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500810,
					"content": "Например, принадлежность к элементу Гидро или что-то в этом роде?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500811,
					"content": "Похоже, что да!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "Я так и думал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500816,
					"content": "Тот вишап должен уметь использовать элемент Гидро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500817,
					"content": "#Содержание элементов Гидро в воде под Разломом настолько высоко, что в особых местах их скопления могли появиться растения наподобие того, что ты выловил{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500818,
					"content": "Вишапы, как и другие существа в Разломе, которым необходим элемент Гидро, потребляют эти растения, чтобы увеличить свою силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500819,
					"content": "Получается, что эта штука, обогащённая элементом Гидро... водоросль!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500820,
					"content": "Всего-навсего водоросль?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "Не просто водоросль, а обогащённая элементом Гидро водоросль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500822,
					"content": "Они не растут в нормальных условиях, если только на водоём не влияет очень чистая и сильная энергия. Эти водоросли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500823,
					"content": "Их стоит изучить, потому что однажды они могут стать наделёнными сознанием элементальными существами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500813,
					"content": "#Я не заметил{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#Это потому, что ты очень быстро {F#разобралась}{M#разобрался} с проблемой... Ничего меньшего от {F#легендарной путешественницы}{M#легендарного путешественника} ожидать и не следовало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500815,
					"content": "Если мои догадки верны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Хедив"
				}
			]
		}
	]
}