				"points": []
			},
			"dialogs": [
				{
					"id": 710500501,
					"content": "О странном предмете...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "#Ты поймал{F#а} это на удочку? Очень похоже на наши наживки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500503,
					"content": "Можно ли поймать такие вещи на рыбалке? Аниса каждый день рыбачит на острове Ватацуми, но я не видел, чтобы она приносила с рыбалки что-то подобное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500504,
					"content": "Это типично для тебя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500505,
					"content": "Давай посмотрим, эта штука... я чувствую, что в ней содержится ужасающее количество элемента Гидро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500506,
					"content": "Воды Разлома насыщены элементальной энергией. Это не совсем нормально. Может ли это быть вызвано присутствием этих предметов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500507,
					"content": "После извлечения из воды элементальная энергия в той штуке начала иссякать. Для достижения эффекта её придётся оставить у кромки воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500508,
					"content": "У кромки воды?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "Помести её у кромки воды и активируй с помощью элемента Гидро. Ты наверняка поймёшь, для чего она предназначена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500510,
					"content": "#Раз уж ты выловил{F#а} эту штуку, то тебе её и активировать. Расскажешь потом, что произошло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "Хедив"
				},
				{
					"id": 710500511,
					"content": "Если произойдёт что-то стоящее с исследовательской точки зрения, ты получишь вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хедив"
				}
			]
		},
		{
