			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME}! Паймон! Привет! Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "Фреда"
				},
				{
					"id": 401450202,
					"content": "Знаешь, в последнее время мы не справляемся с заказами в магазине... Лиза порекомендовала обратиться к тебе за советом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401450203,
					"content": "Да, точно! Мы недавно обсуждали с ней ваш магазин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "Фреда"
				},
				{
					"id": 401450204,
					"content": "Сейчас есть три процесса, эффективность которых можно повысить: приготовление зелий, выращивание ингредиентов и продажи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "Фреда"
				},
				{
					"id": 401450205,
					"content": "Если повысить эффективность работы, управлять магазином станет намного проще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "Фреда"
				},
				{
					"id": 401450206,
					"content": "#Было бы здорово! Давай скорее попробуем, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 401450207,
					"content": "Повысить эффективность работы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "Кажется, все приготовления сделаны! Можете пробовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фреда"
				},
				{
					"id": 401450209,
					"content": "Купить ингредиенты...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "Вам повезло! Мне как раз пришла новая партия ингредиентов. Посмотрите, вдруг здесь есть то, что вам нужно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фреда"
				},
				{
					"id": 401450211,
					"content": "Пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "Удачи вам с магазином!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фреда"
				}
			]
		}
	]
