					"nextDialogs": [
						732580402
					]
				},
				{
					"id": 732580402,
					"content": "#«...Венок {M#ему}{F#ей} идёт и делает похож{M#им}{F#ей} на других. Как будто {M#он}{F#она} тоже аранара».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580403
					],
					"speakerTitle": "Запись неровным почерком"
				},
				{
					"id": 732580403,
					"content": "#«Нара {NICKNAME} и Паймон отдыхают. Не понимаю, зачем нарам отдыхать? Ведь пока отдыхаешь, нельзя творить воспоминания с друзьями...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580404
					],
					"speakerTitle": "Запись неровным почерком"
				},
				{
					"id": 732580404,
					"content": "#«Надо отправиться к Ашваттхе. {NICKNAME} и Паймон - дети леса, так что она обязательно признает нару».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580405
					],
					"speakerTitle": "Запись неровным почерком"
				},
				{
					"id": 732580405,
					"content": "#«Да, в Араньяке уже много написано. Тут и нара {NICKNAME}, и Паймон, все остальные с их приключениями».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580406
					],
					"speakerTitle": "Запись неровным почерком"
				},
				{
					"id": 732580406,
					"content": "#«Когда нара {NICKNAME} и Паймон найдут биджу и помогут наре Ране, мы призовём Арану и вместе прочтём истории в Араньяке!»",
					"roleType": "TALK_ROLE_NPC",
