			"dialogs": [
				{
					"id": 705340101,
					"content": "В чём смысл такого количества вариаций одной и той же настольной игры...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Фейн"
				},
				{
					"id": 705340102,
					"content": "#Путешественни{F#ца}{M#к}! Ты до смерти меня напугал{F#а}! Тоже хочешь принять участие в Гран-при Короля священного призыва?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Фейн"
				},
				{
					"id": 705340103,
					"content": "Что ты делаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "О, эту игру создал искатель приключений из Гильдии. Говорят, это... новая настольная игра, сочетающая «Священный призыв семерых» и сражения. Она называется «Стратегические дайсы».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Фейн"
				},
				{
					"id": 705340106,
					"content": "Поскольку мы участвуем в организации Гран-при Короля священного призыва, Гильдия решила устроить мини-игру в рамках Гран-при, вдохновлённую замыслом искателя приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Фейн"
				},
				{
					"id": 705340107,
					"content": "Как можно совместить карточную игру и сражения?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Ха-ха-ха, по правде говоря, я и сам не очень понимаю. Но здесь есть свод правил... Только посмотри, какой он толстый!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Фейн"
				},
				{
					"id": 705340110,
					"content": "Если я не ошибаюсь, основным игровым механизмом «Стратегических дайсов» будет... стратегическое использование дайсов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Фейн"
				},
				{
					"id": 705340111,
					"content": "В общем, если интересно, можешь сыграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фейн"
				},
				{
					"id": 705340108,
					"content": "Весьма неожиданное сочетание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "Что за настольная игра?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				}
			]
		}
	]
