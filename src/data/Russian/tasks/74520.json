			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эола"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#А, это ты, {NICKNAME}. Не ожидала встретить тебя в таком месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200402,
					"content": "Давно не виделись, Эола.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Всего лишь стандартный обход. Для меня это необходимая тренировка для поддержания боевой формы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200405,
					"content": "В последнее время в Мондштадте довольно спокойно, почти нет угроз, требующих полной мобилизации разведывательного отряда. Все в отряде... слегка расслабились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200406,
					"content": "Нужен баланс между работой и личной жизнью...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Верно, но как командир отряда я должна всегда быть готова к бою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200408,
					"content": "Клинки наших противников не стали менее острыми лишь оттого, что настали мирные времена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200409,
					"content": "Поэтому между обходами я обычно нахожу тихое место для тренировки с мечом, чтобы не растерять прежние навыки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200410,
					"content": "Какой удачный момент...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "А? Звучит интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200413,
					"content": "Вот только я двигаюсь быстро, поспеет ли за мной твоя фотокамера?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200414,
					"content": "Двигайся в обычном темпе!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "Хорошо. Раз в тебе столько уверенности, то и я выложусь на полную.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200417,
					"content": "Смотри внимательно. Волны поднимаются и опадают в одно мгновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эола"
				},
				{
					"id": 745200415,
					"content": "Я попробую успеть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Позволь мне сфотографировать тебя!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "Ты здесь на дежурстве?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
}