			},
			"dialogs": [
				{
					"id": 760780101,
					"content": "Обычно, как только все монстры, следующие за Дикой Охотой, побеждены, скверна должна исчезнуть вместе с ними.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760780102,
					"content": "Но этот разлом всё ещё существует. Это необычное явление, но не беспрецедентное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 760780103,
					"content": "Давайте осмотрим окрестности. Возможно, ещё осталась скверна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флинс"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
