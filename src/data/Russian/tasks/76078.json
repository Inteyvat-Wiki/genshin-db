			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Обычно после уничтожения всех чудовищ поблизости разломы исчезали сами собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780402,
					"content": "Тогда почему всё ещё ощущается присутствие Дикой Охоты... это очень странно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780403,
					"content": "Неужели ещё что-то заражено скверной Дикой Охоты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		},
