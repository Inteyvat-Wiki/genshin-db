					}
				]
			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Здесь тоже есть Фонарь клятвы. Должно быть, это реликвия какого-то предшественника...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780502,
					"content": "На фонаре всё ещё осталась скверна Дикой Охоты. Нетрудно догадаться, что здесь произошло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780503,
					"content": "Со дня поднятия Фонаря клятвы наши жизни связаны с пламенем внутри него... пока не будет выполнена предначертанная миссия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780504,
					"content": "Честь храброму воину, сражавшемуся до последнего вздоха за мир и спокойствие Нод-Края.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780505,
					"content": "Позвольте мне сохранить ваш фонарь. Будьте уверены, корона павших героев сохранит ваше наследие в целости и сохранности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780506,
					"content": "Я отнесу его в штаб, снова зажгу и передам тому, кто сможет унаследовать эту волю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Иллуги"
				},
				{
					"id": 760780507,
					"content": "Иллуги очищает фонарь и бережно убирает его.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "Итак, Дикая Охота здесь полностью уничтожена, и дух предка наконец обрёл покой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Иллуги"
				}
			]
		}
