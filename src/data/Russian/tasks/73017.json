			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Аракунти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "О! Мы всё-таки нашли тебя. Ты, должно быть, Аракунти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170202,
					"content": "Может быть и нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170203,
					"content": "А? Как это понимать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170204,
					"content": "Может быть, я дерево, а может - дождь, или сон ваны, или струна на лютне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170205,
					"content": "Э-э-э...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170206,
					"content": "#Паймон совсем не понимает, что он говорит! А ты, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170207,
					"content": "#Я тоже ничего не понял{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Паймон знает значение каждого слова по отдельности, но предложение какое-то бессмысленное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170213,
					"content": "#{M#Золотой}{F#Золотая} нара и... летающая малышка, зачем вы разыскиваете Аракунти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170214,
					"content": "Паймон не какая-нибудь там «летающая малышка»! Подожди-ка, Паймон в самом деле летающая... Нет! Паймон зовут Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170215,
					"content": "#У {M#золотого}{F#золотой} нары, вообще-то, тоже имя есть! {M#Его}{F#Её} зовут {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170216,
					"content": "Арапанду сказал нам, что ты сейчас в роще Сновидений, и отправил нас узнать, что тут происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170217,
					"content": "Передайте Арапанду, что с Аракунти всё в порядке. С рощей Сновидений всё хорошо, и с промокшими снами тоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170218,
					"content": "#Хорошо... {NICKNAME}, давай вернёмся к Арапанду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170219,
					"content": "Да нет же! Мы же пришли, чтобы излечить машину Варуны! Опасно! Нас чуть не обвели вокруг пальца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170220,
					"content": "Паймон может передать Арапанду, что Аракунти не хочет никого водить вокруг пальца.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170221,
					"content": "Вполне может быть, что Арапанду эта информация ни к чему.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "И Паймон ни к чему! Что не так с этим аранарой?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170223,
					"content": "Помнишь, Арапанду говорил...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "Арапанду упоминал, что Аракунти «далёк даже от аранар». То есть, он хотел сказать, что Аракунти не знает, как общаться с людьми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170225,
					"content": "Это мы не знаем, как общаться с аранарами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "Да, об этом Паймон не подумала. Мы должны следовать местным обычаям. Следовательно, это нам стоит научиться способам общения с аранарами, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170227,
					"content": "Паймон подумала, а как вообще аранары общаются?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170228,
					"content": "А ты как думаешь, летающая малышка?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "#Если уж {M#золотой}{F#золотая} нара этого не знает, то откуда это знать летающей малышке? Давайте-ка лучше расспросим об этом удивительного Аракунти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170233,
					"content": "Аракунти, ты не мог бы рассказать нам, как аранары общаются между собой? Мы бы хотели тоже научиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170234,
					"content": "Зачем? Нара от этого не перестанет быть нарой, Паймон так и останется Паймон, а аранара - аранарой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170235,
					"content": "О, понятно, Паймон тоже хочет стать маленьким семечком и укрыться в земле?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170236,
					"content": "Нет! Вовсе нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170237,
					"content": "#Тогда {M#золотой}{F#золотая} нара хочет превратиться в семечко?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170238,
					"content": "Спасибо, но нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "Семена очень хорошие. Жаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170242,
					"content": "Мы почти забыли, зачем пришли. Праздник Утсава!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170243,
					"content": "Ради Праздника Утсава мы должны исцелить машину Варуны и вернуть нормальную погоду. А ещё избавиться от ужасных спор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170244,
					"content": "Паймон дело говорит. Ради Праздника Утсава, ради центра Голубой земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170245,
					"content": "Влажная роща Сновидений хорошая, но споры плохие. Бегающие грибы тоже плохие. Дождей слишком много, грибы сложно готовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170246,
					"content": "О! Это более чем ясно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170247,
					"content": "#Давайте исцелим машину Варуны. Нара {NICKNAME}, Паймон, следуйте за Аракунти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170240,
					"content": "Если есть такая возможность, то почему бы нет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Не говори глупостей! Он может воспринять это всерьёз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170230,
					"content": "В общем, сначала испробуем метафоры?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "#Паймон попробует! {M#Золотой}{F#Золотая} нара {M#похож}{F#похожа} на яичницу по-тейватски?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170232,
					"content": "И всё-таки давай лучше расспросим Аракунти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170209,
					"content": "Примерно догадываюсь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Ого! Так о чём же он говорит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170211,
					"content": "Он говорит, что может превращаться во многие вещи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#Правда? {NICKNAME}, ты же не обманываешь Паймон...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7301704,
			"completionStepIds": [
				7301704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301704",
							"2"
						],
						"stepId": 7301704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Аракунти",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "Корни большого дерева, хорошо. Здесь можно услышать влажное дыхание, будто кто-то напевает тихую песню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170402,
					"content": "Ох, Паймон по-прежнему не понимает, о чём говорит Аракунти. Ну и ладно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170403,
					"content": "Кстати, здесь так много пространства, это и есть «Лабиринт корней»? Паймон не покидает чувство, что атмосфера здесь сильно отличается от других мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170404,
					"content": "Нам нужно отыскать здесь листы, которые перенаправят энергию машине Варуны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170405,
					"content": "И здесь, и нет. Паймон может услышать его шёпот, может почувствовать его дыхание и увидеть его артерии, но ей не найти его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170406,
					"content": "А? Что же делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170407,
					"content": "Паймон его не отыскать, но что насчёт меня?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "#{M#Золотой}{F#Золотая} нара, ты можешь увидеть мелодию, подобную прохладному вечернему ветерку, внезапный дождь, сон, словно гладь озера, разбитая на тысячи осколков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170409,
					"content": "Звучит солидно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#От тебя, {NICKNAME}, другого и не ожидалось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170411,
					"content": "Хе-хе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Хи-хи... Нет! {NICKNAME}, ты что, {F#присвоила}{M#присвоил} себе реплику Паймон?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170413,
					"content": "#Нара {NICKNAME}, {M#превратившийся}{F#превратившаяся} в Паймон... Это ещё страшнее, чем танцевать с грибами в Маране...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170414,
					"content": "Даже представить такое не могу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "Потому что такого просто не может быть! К счастью, не может быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170416,
					"content": "Почему Аракунти не может говорить понятнее? Куда же нам идти, чтобы найти эти листья?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170417,
					"content": "В мир грёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170418,
					"content": "А... Постой-ка! Почему нельзя было с этого начать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170419,
					"content": "Потому что Паймон спросила «почему», а не «где».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170420,
					"content": "О! Кажется, Паймон вдруг поняла, как разговаривать с аранарами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170421,
					"content": "Аракунти, ты не мог бы сказать нам, где именно искать три листа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170422,
					"content": "Мог бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170423,
					"content": "Ох, Аракунти в самом деле отвечает только на прямые вопросы. Хорошо, и где же именно эти три места?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170424,
					"content": "Здесь, там и там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170425,
					"content": "Аррр... Понятней не стало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170426,
					"content": "Паймон, это поражение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#Поражение Паймон - это и твоё, {NICKNAME}, поражение! Аракунти просто нельзя понять! Где же нам искать?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170428,
					"content": "Машина Варуны была создана самым великим аранарой. Связь её ветвей и листьев и видима, и невидима.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170429,
					"content": "#Когда нара {NICKNAME} сможет увидеть аранар и их следы, {M#он}{F#она} найдёт и нужное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730170430,
					"content": "О! Паймон... Паймон вдруг поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730170431,
					"content": "Достаточно просто идти по следам аранар?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "О! Уступи Паймон эту попытку ответа!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7301710,
