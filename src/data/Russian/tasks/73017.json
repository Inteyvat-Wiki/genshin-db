				"points": []
			},
			"dialogs": [
				{
					"id": 730171001,
					"content": "Промокшие сны или сухие... Дин-дон, кап-кап, ш-ш - это мелодия ваны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171002,
					"content": "#Нара {NICKNAME}? Ищи листья во сне, а ветви - здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аракунти"
				}
			]
		},
		{
			"id": 7301712,
			"completionStepIds": [
				7301712
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301712",
							"2"
						],
						"stepId": 7301712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Аракунти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "Мы вернулись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730171202,
					"content": "Аракунти услышал тебя. Всхлипывания превратились в мягкую мелодию, но чтобы войти в главный поток, понадобится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171203,
					"content": "Понадобится помощь Аракунти! Хи-хи, Паймон рассчитывает на тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730171204,
					"content": "Аракунти знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171205,
					"content": "Проблем не должно быть. Паймон надеется, что мы поскорее исцелим машину Варуны, а то как вспомнишь эти споры, так сразу в носу щекочет... Апчхи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730171206,
					"content": "Паймон просто поверить не может, что аранары на них не реагируют. Споры никак не влияют на аранар?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730171207,
					"content": "Аранары отваривают грибы. Так что нельзя сказать, что споры на нас не влияют. Споры слишком маленькие. Их слишком много, захочешь поймать все - не поймаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171208,
					"content": "Когда машина Варуны была в порядке, в ване не было столько грибов. Всё изменится к лучшему после того, как машина исцелится. Всё, кроме Мараны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171209,
					"content": "Не сомневаюсь, что так и будет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#Да! Паймон и {NICKNAME} обязательно помогут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730171211,
					"content": "Мы сможем также придумать, как решить проблему с Мараной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Нара {NICKNAME} - это нара Варуна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171213,
					"content": "О? Почему ты вдруг спросил об этом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730171214,
					"content": "#Арапанду говорил, что нара Варуна {M#была}{F#был} {M#золотой}{F#золотым} {M#отважной}{F#отважным} нарой. {M#Она}{F#Он} вместе с аранарами исцелил{M#а} машину Варуны, {M#прошла}{F#прошёл} сквозь чёрный дождь и грязь. {M#Вернулась}{F#Вернулся} с солнцем и луной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171215,
					"content": "#Нара {NICKNAME} тоже помогает исцелить машину Варуны. Ты {M#отважный}{F#отважная} {M#золотой}{F#золотая} нара, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171216,
					"content": "Но разве события, о которых ты упоминал, произошли не очень-очень много лет назад?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730171217,
					"content": "#Нара Варуна не {M#вернулась}{F#вернулся} в вану? Нара {NICKNAME} - совсем {M#другой}{F#другая} нара?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171218,
					"content": "У разных нар могут быть похожие мелодии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171219,
					"content": "Возможно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "#Аракунти не видел нару Варуну, но Арапанду многое рассказывал о {M#ней}{F#нём}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171222,
					"content": "#{M#Её}{F#Его} мелодия такая же, как твоя. Стоит её услышать, как сердце наполняется радостью.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Аракунти"
				},
				{
					"id": 730171223,
					"content": "#Да, Паймон тоже очень весело, когда рядом {NICKNAME}! Если вдруг {NICKNAME} когда-нибудь покинет Паймон, как нара Варуна {M#покинула}{F#покинул} чащу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Паймон"
				},
				{
