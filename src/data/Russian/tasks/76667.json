			"dialogs": [
				{
					"id": 766670301,
					"content": "Я пойду принесу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "В-вы хотите помочь мне? Большое спасибо, большое спасибо. Тогда... пожалуйста, принесите мне <color=#00E1FFFF>пять ягод лакка</color>. Этого будет достаточно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670303,
					"content": "Когда вы их принесёте, я обязательно приготовлю вам самое вкусное Лунное угощение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Люликки"
				}
			]
		},
