			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Люликки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "...Ух... Надо было запастись большим количеством ягод лакка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670102,
					"content": "(В прошлый раз, когда здесь была Лаума...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Здравствуйте, {NICKNAME}! Вы пришли за Лунным угощением? Извините, вам придётся немного подождать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670105,
					"content": "Что такое Лунное угощение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "А? Разве вы не получали его в прошлый раз? Ах да, в прошлый раз церемонию проводила госпожа Лаума, и похоже, вам не сказали официальное название этой трапезы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670107,
					"content": "Простыми словами, Лунное угощение - это бесплатная еда, которую мы, Дети Морозной Луны, раздаём нуждающимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670108,
					"content": "У нас издавна существовала традиция помогать нуждающимся, и поначалу это ограничивалось только окрестностями острова Хийси...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670109,
					"content": "Но под руководством госпожи Лаумы и благодаря нашим совместным усилиям мы постепенно расширили зону раздачи Лунного угощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670110,
					"content": "Госпожа Лаума сказала, что это тоже нужно для того, чтобы распространить благословение Богини Луны на всех людей, хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670111,
					"content": "«Первый плод урожая надлежит положить на лунный алтарь - не как подношение богам, но как искру для заблудившихся охотников...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670112,
					"content": "Оставить... Как же там дальше говорилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670113,
					"content": "Кхм, в общем! Здесь в основном раздают Лунное угощение, хе-хе, и я практически в одиночку управляю этим местом. Здорово, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670114,
					"content": "Хотя раздавать Лунное угощение в Нашгороде оказалось непросто... но я верю в слова госпожи Лаумы, что так мы сможем помочь большему количеству нуждающихся людей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670115,
					"content": "Однако... вчера, когда я готовила ингредиенты, я забыла плотно закрыть крышку коробки. Когда я проснулась утром, многие фрукты были склёваны птицами и теперь совершенно непригодны к употреблению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670116,
					"content": "Из оставшихся ягод лакка не приготовить много Лунного угощения, ох... Что же теперь делать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Люликки"
				},
				{
					"id": 766670103,
					"content": "(Похоже, здесь раздают еду...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
