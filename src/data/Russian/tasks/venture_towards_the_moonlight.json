			"dialogs": [
				{
					"id": 766600101,
					"content": "#Добро пожаловать, искатель{F#ница} приключений! Хотите я проверю, какие есть поручения за сегодня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600102,
						766600103
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 766600102,
					"content": "При этих словах чувствую, что я дома...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "О, вы спешите. Могу чем-нибудь помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 766600105,
					"content": "Нет-нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "Мы просто невероятно рады тебя видеть, Катерина! Хе-хе, ты лучше всех!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766600108,
					"content": "Благодарю вас за любезность... Простите, но, похоже, я не понимаю вашего чувства юмора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 766600109,
					"content": "Но тем не менее добро пожаловать в Нод-Край, страну, полную возможностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 766600110,
					"content": "Я уверена, что здесь вы сможете отправиться в грандиозные приключения и найти сокровища, превосходящие ваши самые смелые мечты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 766600111,
					"content": "Успехов в приключениях. К звёздам и к безднам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 766600106,
					"content": "Мы...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600103,
					"content": "Как хорошо, что ты здесь, Катерина.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				}
			]
		}
