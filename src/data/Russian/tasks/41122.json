			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мак"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "Ну что? Удалось их уговорить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220502,
					"content": "Похоже на то...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "Правда? Прекрасно! Как же я тебе благодарен... Погоди, что значит «похоже на то»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220504,
					"content": "Тебе просто нужно будет кое с чем помочь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "Помочь? Помочь с чем?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220506,
					"content": "Что? Отвести их на самую высокую точку Мондштадта? Но это ведь... Опасно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220507,
					"content": "К тому же они ещё маленькие... Мне нужно будет доложить об этом ордену...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220508,
					"content": "Письменный приказ у меня как раз под рукой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "Но он совсем не для этого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220510,
					"content": "Ладно, проехали. Мне нужно только, чтобы дети вернулись в город, а там... А там я что-нибудь придумаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220511,
					"content": "Ты ведь их не обманешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "Ни за что. Даю слово рыцаря, и, э... Взрослого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220513,
					"content": "Обещание есть обещание, и я его выполню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220514,
					"content": "Спасибо за помощь. Остальное предоставь мне - я скоро отведу их в Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "Мак"
				},
				{
					"id": 411220515,
					"content": "А потом... Я придумаю, как забраться на самое высокое в Мондштадте место...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мак"
				}
			]
		},
		{
			"id": 4112206,
			"completionStepIds": [
				4112206
			],
