			"dialogs": [
				{
					"id": 411225901,
					"content": "О Маке...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411225902
					]
				},
				{
					"id": 411225902,
					"content": "Ему нужно отвести детей на самую высокую точку Мондштадта? Ха-ха-ха, ладно, ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411225903
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411225903,
					"content": "Пусть только хорошенько за ними присматривает, а потом доложит мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411225904
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411225904,
					"content": "Мак никогда с детьми не ладил. Должно быть, ему пришлось несладко.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411225905
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411225905,
					"content": "О Гарри...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411225906
					]
				},
				{
					"id": 411225906,
					"content": "Гарри... Он всё равно хочет остаться на страже в горах Буревестника?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411225907
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411225907,
					"content": "Ну... Тоже хорошо. Если там что-нибудь произойдёт, он сможет быстро обо всём доложить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411225908
					],
					"speakerTitle": "Хоффман"
				},
				{
					"id": 411225908,
					"content": "Только вот он малость вспыльчив... Надеюсь, он переполоха там не устроит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хоффман"
				}
