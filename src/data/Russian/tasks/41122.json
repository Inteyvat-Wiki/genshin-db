					"Гарри"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220601,
					"content": "Привет. Чем могу быть полезен?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220602,
					"content": "У меня тут письменный приказ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "Письменный приказ? Позволь мне... Выходит, я должен вернуться в город?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220604,
					"content": "Прости, но перед тем как выполнять этот приказ, я должен сделать кое-что важное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220605,
					"content": "Похоже, метеориты повлияли на чудовищ в окрестностях. Они стали куда кровожаднее и опаснее обычного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220606,
					"content": "Ради безопасности этого региона я должен от них избавиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220607,
					"content": "Но здесь никого нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "Именно потому, что поблизости никого нет, я могу свободно сразиться с чудовищами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220609,
					"content": "Это очень важное дело. Я не могу уйти, не завершив его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220610,
					"content": "Я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "Отлично. В этом регионе не одна группа чудовищ, а несколько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220613,
					"content": "Давай разделимся, тогда каждому достанется по группе чудовищ. Когда закончим, встретимся на этом же месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Гарри"
				},
				{
					"id": 411220611,
					"content": "Возьмемся за дело вместе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
