				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джилли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "Привет! Чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220302,
					"content": "Дело вот в чём...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "О метеоритах я уже знаю. Но как они падают, мы не видели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220304,
					"content": "Вилли сказал, что знает место, откуда отлично видно метеориты. Вот мы сюда и пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220305,
					"content": "Из города их тоже видно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "Но в городе нужно забраться повыше, иначе ничего не увидишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220307,
					"content": "А стражники нам этого не разрешат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220308,
					"content": "Вот этот дяденька вам поможет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "А? Этот странный тип? Тот раз, когда он к нам подходил, то был злой-презлой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220310,
					"content": "Он сказал только, чтобы мы шли с ним в город, и больше ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220311,
					"content": "Но если он проведёт нас куда-нибудь высоко, чтобы посмотреть на метеориты, тогда... Мы согласны вернуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "Джилли"
				},
				{
					"id": 411220312,
					"content": "Но ты лучше поговори с Вилли. Всё-таки это он придумал прийти сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джилли"
				}
			]
		},
		{
			"id": 4112204,
			"completionStepIds": [
				4112204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112204",
							"2"
						],
						"stepId": 4112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Вилли"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220401,
					"content": "Хм? Привет. Что-то случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220402,
					"content": "Дело вот в чём...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "Я знаю. Затем мы сюда и пришли - чтобы посмотреть на метеориты. Вот увидим, как они падают, так сразу и вернёмся, не переживай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220404,
					"content": "Из города их тоже видно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "Но тогда нужно высоко залезть. Я пробовал много раз, но меня всегда заставляли спуститься стражники, а потом ещё и ругали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220406,
					"content": "Поэтому мы с Джилли сюда и пришли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220407,
					"content": "Вот этот дяденька вам поможет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "Поможет? То есть он проведёт нас куда-нибудь высоко, чтобы посмотреть на метеориты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220409,
					"content": "Да ну... Странный он какой-то. А ещё сердитый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220410,
					"content": "У меня есть письменный приказ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "Правда? Дай посмотреть... Ух ты... Это правда приказ ордена!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220412,
					"content": "С ним этот дяденька проведёт нас посмотреть на метеориты, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220413,
					"content": "Хе-хе... Посмотреть на метеориты из города было бы круто!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220414,
					"content": "#Тогда ты скажи ему, что готов{F#а} возвращаться, а я поговорю с Джилли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "Вилли"
				},
				{
					"id": 411220415,
					"content": "Ой, мне так не терпится... Очень хочется увидеть, как падают метеориты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вилли"
				}
			]
		},
		{
