					}
				]
			},
			"dialogs": [
				{
					"id": 765080101,
					"content": "Сейчас Народ Родников проводит какое-то мероприятие? Кажется, туристов прибавилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080102,
					"content": "Там какой-то гость из Сумеру показывает танец для всех?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080103,
					"content": "О! Великий герой и милая Паймон! Как здорово, что вы тоже здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080104,
					"content": "Приветствую, уважаемый воин, мастер силы и танца, а ещё знаток всех радостей жизни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080105,
					"content": "О, эта девушка кажется Паймон знакомой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080106,
					"content": "#И как она узнала, что {NICKNAME} радуется, когда танцует?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080107,
					"content": "#Конечно, я видела {M#его}{F#её} радостные танцы на стадионе Священного пламени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080108,
					"content": "#После совместного фото я отыскала тихое место, съела немного заврианского печенья и понаблюдала за вашим благословенным танцем, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080109,
					"content": "Танцевать надо легко и весело, чтобы отдохнуть душой! Я даже хотела присоединиться и потанцевать вместе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080110,
					"content": "Точно, я тебя помню!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "Я очень рад!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080114,
					"content": "Теперь по делу. Как вы видите, в последнее время к нам приезжают друзья из Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080115,
					"content": "После обсуждений с Мутотой, Аминой, Пакалем и Муалани наш клан Цветочного Пера решил вместе с Детьми Эха и Народом Родников принять гостей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080116,
					"content": "Похоже, много наёмников из Пустынников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080117,
					"content": "Дай угадаю, вы познакомились в пустыне после драки и стали друзьями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080118,
					"content": "Э-э, почти верно! Но дело было не в нас, а...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080119,
					"content": "Мы устраивали барбекю на юге пустыни Хадрамавет, как вдруг на нас напала стая свирепых красных стервятников. Это случилось, когда мы уже не могли быстро бежать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080120,
					"content": "Они были хитры и так ловко использовали преимущества местности, что нам пришлось отступить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080121,
					"content": "И вдруг на нашем пути появилась группа наёмников, которые начали загадочный боевой танец перед красными стервятниками...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080122,
					"content": "Те, похоже, всё поняли и улетели прочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080123,
					"content": "Говоришь, что они отпугнули красных стервятников... боевым танцем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080124,
					"content": "Танец был настолько странным, что отпугнул их...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "Удивительно, не так ли? Нам тоже интересно, в чём секрет такого танца!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080127,
					"content": "После того как мы привели в порядок лагерь, мы вдоволь поели и выпили, а потом начали обсуждать танцевальные приёмы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080128,
					"content": "Если по пути появлялись какие-то чудовища или звери, мы смело давали им отпор!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080129,
					"content": "Через пару дней мы стали настоящими боевыми и танцевальными товарищами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080130,
					"content": "Перед расставанием мы договорились, что будем ходить друг к другу в гости, чтобы продолжать «обмен танцевальными техниками». Это было только начало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080131,
					"content": "#{NICKNAME}, похоже, раньше мы ещё не участвовали в подобных мероприятиях, где друзья из Сумеру и Натлана показывали бы танцевальные навыки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080132,
					"content": "Да, действительно необычно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "Это редкая возможность. Может, поучите нас, раз вы здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080135,
					"content": "Муалани тоже присутствует. Она танцует зажигательнее всех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080136,
					"content": "А друзья из Пустынников пригласили известную местную танцовщицу в качестве руководителя и консультанта со стороны Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080137,
					"content": "Думаю, вы тоже знаете эту танцовщицу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080138,
					"content": "Кажется, Паймон уже догадалась, кто это... Ха-ха, потом устроим ей большой сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080139,
					"content": "Отлично! Я тоже хочу участвовать!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "Ха-ха-ха! Становится ещё веселее! По словам Муалани, там уже очень оживлённо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080142,
					"content": "Пойдёмте поищем Таране!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080140,
					"content": "Такое событие нельзя пропустить!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "Хочется посмотреть.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "Ты уверена, что эти стервятники не были уже знакомы с наёмниками или другими воинами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "Я тебя теперь точно не забуду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "Значит, я пока недостаточно заметна, нужно стараться получше!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Нуста"
				}
			]
		},
		{
			"id": 7650803,
			"completionStepIds": [
				7650802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
