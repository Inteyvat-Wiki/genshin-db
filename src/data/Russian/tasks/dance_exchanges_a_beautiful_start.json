							-2845.813,
							213.54,
							9052.487
						],
						"pointId": 14200
					},
					{
						"sceneId": 3,
						"position": [
							-2846.176,
							213.533,
							9051.414
						],
						"pointId": 14203
					},
					{
						"sceneId": 3,
						"position": [
							-2846.263,
							213.533,
							9053.336
						],
						"pointId": 14204
					},
					{
						"sceneId": 3,
						"position": [
							-2847.651,
							213.533,
							9052.41
						],
						"pointId": 350200533
					}
				]
			},
			"dialogs": [
				{
					"id": 765080301,
					"content": "#О, не может быть! Это же знаменитость {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080302
					],
					"speakerTitle": "Таране"
				},
				{
					"id": 765080302,
					"content": "Я думала, что нам повезло, что мы пригласили госпожу Нилу, а тут ещё и мастер высшего уровня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080303
					],
					"speakerTitle": "Таране"
				},
				{
					"id": 765080303,
					"content": "#Хвалите {F#её}{M#его} побольше. Словно музыка для моих ушей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080304
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080304,
					"content": "Эй? Это Паймон должна говорить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080305,
					"content": "Верно! Когда эту фразу произносит Паймон, она звучит легко и нежно, как мягкая и воздушная мелодия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080306
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080306,
					"content": "А когда говорю я, то возникает ощущение, будто пьяный барабанщик стучит изо всех сил невпопад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080307
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080307,
					"content": "Конечно, как учила мастер Иансан, двойные удары на бас-барабане тоже не помешают. В идеале они должны быть непрерывными, как выстрелы из пулемёта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080308
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080308,
					"content": "Так что, даже если мы говорим одну и ту же фразу, она не повторяется скучно, а дополняет друг друга в разных голосовых партиях и помогает держать ритм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080309
					],
					"speakerTitle": "Нуста"
				},
				{
					"id": 765080309,
					"content": "Ого... Вот это да, Паймон запуталась от такого объяснения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 765080310,
					"content": "Госпожа Нуста правильно подметила - всё дело в ритме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080311
					],
					"speakerTitle": "Таране"
				},
				{
					"id": 765080311,
					"content": "Наши танцы свободные и выразительные, но не полностью хаотичные. Ключевые движения должны точно попадать в ритм.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080312
					],
					"speakerTitle": "Таране"
				},
				{
					"id": 765080312,
