					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750800105,
					"content": "Р-р-р!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750800106,
					"content": "#Видишь, это цветок, который ты посадил, {REALNAME[ID(2)|SHOWHOST(true)]}. Семечко не погибло и выросло в красивый цветок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 750800107,
					"content": "#Я {F#удивлена}{M#удивлён}, что это не попрыгунья...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750800108
					]
				},
				{
					"id": 750800108,
					"content": "Хватит уже о своих попрыгуньях!",
