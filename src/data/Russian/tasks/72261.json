			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Китибоси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "Отлично получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610202,
					"content": "Мха-ха-ха, Китибоси милый.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610203,
					"content": "М-да, скромность - это не про Китибоси...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610204,
					"content": "Паймон, а какой магией владеют Адепты?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610205,
					"content": "Адепты могущественны! Например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610206,
					"content": "Например, янтарные ловушки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "А что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610208,
					"content": "О, Паймон помнит! У Творца Гор есть цветы, которые могут создавать янтарь. Он запирает в себе то плохое, что вторгается сюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610209,
					"content": "Цапелька - молодец! Защищает Ли Юэ, запирает плохое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610210,
					"content": "Давным-давно жили-были плохие-преплохие Четверо óни Огата, которые ворвались в лес и стали обижать бакэ-дануки. Иорой принял облик владыки и дал им отведать еду бакэ-дануки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610211,
					"content": "А потом вместе с Королём Отоги бросил их на бумагу и запечатал там.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610212,
					"content": "Вот такая история. Неудивительно, что когда Иорой увидел фотографию Китибоси, то пришёл в ужас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610213,
					"content": "Иорой не Адепт, не защищает Ли Юэ, но Иорой бережёт лес и тануки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610214,
					"content": "Разные люди защищают разное.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "Ммм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610216,
					"content": "Китибоси, вырастешь - поймёшь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "Китибоси должен тренироваться и стать великим бакэ-дануки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610218,
					"content": "Конечно. Знаменитый бакэ-дануки Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610219,
					"content": "Паймон интересно, как выглядел Иорой до того, как был запечатан! Должно быть, был весёлым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610220,
					"content": "Ах, Паймон вдруг вспомнились те Похитители сокровищ, которые были заперты в янтарных ловушках...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610221,
					"content": "Они даже приняли нас за посланников Адептов...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "Кажется, что это было давным-давно, но ведь нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610223,
					"content": "Ммм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610224,
					"content": "Гм. Когда мы прибыли в Ли Юэ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610225,
					"content": "#«Церемония Сошествия происходит только раз в год! Я, {NICKNAME}, собираюсь съесть всё вкусное! Пойдём, Паймон!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610226,
					"content": "«И ещё будут подношения! Поторопимся!»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610228,
					"content": "Хватит об этом...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610230,
					"content": "Вы кратко рассказываете о приключениях в Ли Юэ,\\nвплоть до посещения Адептов в Яшмовом лесу.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#...А потом {NICKNAME} и Паймон отправились в «Глазурный павильон», где мы уже были раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610232,
					"content": "Цапелька гор и цапелька облаков очень сильные! Они построили движущийся дом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610233,
					"content": "Цапелька обл... Хранитель Облаков очень любит изысканную еду! Нам пришлось приготовить много угощений, прежде чем мы смогли встретиться с ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610234,
					"content": "Обжорка, как Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610235,
					"content": "Да, Паймон такая.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610238,
					"content": "Паймон - Адепт? Паймон очень сильная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610239,
					"content": "Довольно смешанные эмоции. Это, конечно, был комплимент, но какой-то сомнительный...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610240,
					"content": "В любом случае Паймон не Адепт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610241,
					"content": "Хочу поиграть с Адептами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610242,
					"content": "Адепты обычно не являются людям. Но мы можем осмотреться. Здесь довольно мило.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610243,
					"content": "Китибоси, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610236,
					"content": "И летать тоже умеет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				}
			]
		},
		{
			"id": 7226104,
			"completionStepIds": [
				7226107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226107",
							"2"
						],
						"stepId": 7226107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Китибоси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610401,
					"content": "Слава Архонтам, мы тебя нашли! Ты в порядке, Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610402,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610403,
					"content": "Не волнуйся, всё в порядке. Но в следующий раз не убегай один, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610404,
					"content": "Ты прямо как старшая сестра, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Паймон старше Китибоси. Конечно, Паймон - старшая сестра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610406,
					"content": "Хотя по виду не скажешь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610412,
					"content": "#Мммм! Спасибо, {NICKNAME}. Спасибо, Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610413,
					"content": "Китибоси чуть не попался! Очень страшно. Но Китибоси слышал Паймон, поэтому было не так страшно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610414,
					"content": "Ах да, Иорой говорил, что некоторые более мелкие тануки также оказались в ловушке...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610415,
					"content": "В янтаре очень страшно. Темно, ничего не видно. Невозможно говорить. Невозможно двигаться. Невозможно бабахнуть! Как будто становишься камнем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610416,
					"content": "Иорой силён. Превратился в камень, но может говорить и видеть. Не может двигаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610417,
					"content": "Хочешь помочь Иорою, Китибоси?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Да! А потом и другим окаменевшим тануки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610419,
					"content": "Мы с тобой, Китибоси. Мы не допустим, чтобы ты оказался запечатанным!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610422,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610423,
					"content": "Но веди себя чуть спокойнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610424,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610425,
					"content": "Хороший мальчик! Может, пока остановимся здесь? Тебе тоже нужно отдохнуть, Китибоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610426,
					"content": "Китибоси не устал!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610427,
					"content": "Ох! Если Китибоси не будет слушаться, Паймон не знает, к чему это нас приведёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610428,
					"content": "Мм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610429
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610429,
					"content": "Китибоси нехотя признаёт, что устал...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "Ох! Китибоси как маленький.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610431
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610431,
					"content": "А ты всё лучше справляешься, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "Правда? Может быть, это потому, что Паймон так долго путешествовала с тобой! Хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610433,
					"content": "Это меня ты считаешь ребёнком?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
					"content": "Нет, я не про то! Мы ведь часто сопровождали детей? Малышка Мин, Чан Чан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610437,
					"content": "Паймон точно многому научилась во время наших путешествий.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610438,
					"content": "В этот раз мы узнали, что... бакэ-дануки и Адепты могут не ладить друг с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610439,
					"content": "Мы должны подумать о том, куда направимся дальше...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610435,
					"content": "Хм, да, вообще-то нам приходилось заботиться о многих детях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Точно! Малышка Мин, Чан Чан...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610420,
					"content": "Мы защитим тебя.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610421
					]
				},
				{
					"id": 722610421,
					"content": "Да, мы здесь, Китибоси. Ты не будешь запечатан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610408,
					"content": "Ты прямо как мамочка, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610409
					]
				},
				{
					"id": 722610409,
					"content": "Эй!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610410,
					"content": "Ты прямо как бабушка, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610411
					]
				},
				{
					"id": 722610411,
					"content": "#«О, {NICKNAME}, тебе нужно больше есть. Ты ещё растёшь! Как станешь выше, если плохо кушаешь?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Паймон"
				}
			]
