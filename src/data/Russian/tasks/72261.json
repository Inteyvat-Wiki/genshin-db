			},
			"dialogs": [
				{
					"id": 722610101,
					"content": "Эй... Творец Гор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610102,
					"content": "Эй, цапелька...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610104,
					"content": "Странно, Адепта здесь нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610105,
					"content": "Нельзя так неуважительно с Адептами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "Паймон, что такое Адепт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610107,
					"content": "Ну... особенный... особенное животное? Как-то так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610108,
					"content": "Как Китибоси?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610109,
					"content": "Нет, нет! Они обладают волшебными силами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610110,
					"content": "А, могут делать ба-бах? Тогда Китибоси точно Адепт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610111,
					"content": "Ну... Адепты намного старше и величественнее...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610112,
					"content": "А, тогда Китибоси не Адепт. Адепт - Иорой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610113,
					"content": "Ох, как же объяснить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610114,
					"content": "Адепты издревле защищают Ли Юэ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Понял. Иорой - хранитель леса Тиндзю, так что не может быть Адептом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610116,
					"content": "Ну, дело не совсем в этом, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610117,
					"content": "Но раз перед нами обитель Адепта, то надо сфотографировать Китибоси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722610118,
					"content": "Хорошо! Китибоси готов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "Китибоси"
				},
				{
					"id": 722610119,
					"content": "Китибоси - умничка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
