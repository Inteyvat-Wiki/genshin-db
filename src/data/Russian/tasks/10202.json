	"talks": [
		{
			"id": 1020201,
			"completionStepIds": [
				1020201,
				1020203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1020201",
							"2"
						],
						"stepId": 1020201,
