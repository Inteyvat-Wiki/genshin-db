			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Джинн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020101,
					"content": "Кли тоже здесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020102,
					"content": "Я с-сдаюсь... *Хнык*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020103,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020104,
					"content": "М-моя... б-бомба... Я кого-то п-покалечила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020105,
					"content": "Что же я наделала? Я нарушила правила... Не видать мне белого света... *Хнык*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020107,
					"content": "Произошло недопонимание.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "Кли, прошу тебя, ответь мне. Кого именно ты покалечила?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020109,
					"content": "Кли взорвала мага Бездны.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "Гм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020110,
					"content": "Но... Хоть пушистик и украл моё сокровище... Он не заслужил, чтобы его взрывали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020111,
					"content": "Ах... Паймон же говорила тебе, что орден Бездны - это плохие ребята!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020112,
					"content": "Хуже них ребят просто не существует! Они - заклятые враги человечества!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020113,
					"content": "Пушистики плохие? Заклятые... враги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020114,
					"content": "Что? Но как? Слишком... сложно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020115,
					"content": "Это было ошибкой с моей стороны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020116,
					"content": "С тобой ещё слишком рано говорить о таких вещах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020118,
					"content": "Это из-за «самого крутого сокровища Мондштадта»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "Орден Бездны - враги Мондштадта. В последнее время они были особенно активны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020119,
					"content": "Ага! Паймон всё поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020120,
					"content": "Из-за этих слухов орден начал следить за малышкой Кли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020121,
					"content": "Их тоже очень интересуют сокровища Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020122,
					"content": "Именно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020123,
					"content": "В свете последних событий, ты сможешь принять участие в следующем Луди Гарпастум.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020125,
					"content": "Тебе просто повезло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "#Я так рад{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "Луди Гарпастум! Ух ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020127,
					"content": "#Пойдём, почётный рыцарь {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020128,
					"content": "Вот это действительно - хорошие новости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020129,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020130,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020131,
					"content": "Кли, где ты спрятала сокровища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020133,
					"content": "Ты опять собиралась глушить рыбу на озере Звездопадов?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020134,
					"content": "Нет! Совсем нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020136,
					"content": "*Шепчет* Да. Магистр Джинн тоже на нас смотрит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "*Шепчет* Псс! Она смотрит на нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020137,
					"content": "Кли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "Джинн"
				},
				{
					"id": 102020138,
					"content": "Опять в <color=#00E1FFFF>одиночную камеру</color>... *Хнык*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 102020139,
					"content": "Кли там должно быть очень скучно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
