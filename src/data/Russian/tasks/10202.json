			"dialogs": [
				{
					"id": 102020401,
					"content": "Кто у нас тут?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020402,
					"content": "Малышка Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102020403,
					"content": "Хочешь отсюда выбраться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Да! Да! Пожалуйста... Стой! Нет, не надо. Кли будет хорошей послушной девочкой... Кли будет делать то, что ей сказали... Прекрати искушать меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102020406,
					"content": "Пока я наказана, я сделаю новое сокровище! Специальную версию для Луди Гарпастум!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102020407,
					"content": "«Сокровище»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020408,
					"content": "Хе-хе... Оно будет в форме мяча! Так мило...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102020409,
					"content": "Мяча для Луди Гарпастум...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "О, да! Дождитесь Луди Гарпастум! Всем очень понравится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Одиночная камера"
				},
				{
					"id": 102020412,
					"content": "Ох, если бы магистр Джинн это услышала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020413,
					"content": "Кли пришлось бы провести ещё больше времени за решёткой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 102020410,
					"content": "Который взрывается...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Принести тебе поесть?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}