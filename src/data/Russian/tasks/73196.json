			},
			"dialogs": [
				{
					"id": 731961301,
					"content": "В результате жалоб потребителей красильная мастерская Ани была закрыта по подозрению в краже одежды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961302,
					"content": "Проверка обнаружила, что красильная мастерская совершенно пуста. Мы работаем над возвратом похищенного имущества.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
