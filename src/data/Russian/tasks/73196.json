				"points": []
			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "«Если вы оказались на Большом базаре, обязательно посетите Театр Зубаира».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961502,
					"content": "«А в Театре Зубаира непременно посмотрите танец Нилу!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961503,
					"content": "«Если вы не видели танец Сабзеруз в исполнении Нилу, считайте, вы не были в Сумеру».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
