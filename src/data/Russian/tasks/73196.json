			},
			"dialogs": [
				{
					"id": 731961401,
					"content": "Вопрос, касающийся права собственности на кафе «Пуспа».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961402,
					"content": "Было установлено, что владелец данного заведения пропал три года назад во время экспедиции в пустыне. Таким образом, право собственности переходит в руки даршана Вахуман (школа этиологии).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961403,
					"content": "Решение: в связи с отзывом иска исполнение приостанавливается на неопределённый срок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319615,
			"completionStepIds": [
				7319615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
