			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960601,
					"content": "Отличное качество и доступные цены. Лавка специй Джута - место, созданное специально для вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731960602,
					"content": "Покупайте сейчас и получайте подарок!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319607",
							"2"
						],
						"stepId": 7319607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "В нашей лавке вы найдёте огромный ассортимент товаров повседневного использования, за качество отвечает сам владелец. Вы останетесь довольны нашим товаром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731960702,
					"content": "«Отец, одолжи мне немного моры? Я узнал, что цены на орехи аджиленах скоро взлетят. На этот раз я точно разбогатею».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319608,
			"completionStepIds": [
				7319608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319608",
							"2"
						],
						"stepId": 7319608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "Купим «Утерянные статуи Касани». Цена договорная. Обращайтесь к хозяину лавки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731960802,
					"content": "Если у вас есть какие-то важные сведения об этих статуях, также просим обратиться в магазин Менакери. Коллекционер Халид достойно вас наградит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319609,
			"completionStepIds": [
				7319609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319609",
							"2"
						],
						"stepId": 7319609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960901,
					"content": "Настоящее барбекю пустыни, обжаренное с особыми специями. Подаётся с секретным соусом царя Дешрета!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731960902,
					"content": "Никто не останется без вкусной еды и прохладных напитков!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319610,
			"completionStepIds": [
				7319610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319610",
							"2"
						],
						"stepId": 7319610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "«Когда-то я владел несметными богатствами. Но никакие траты не приносили мне счастья».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961002,
					"content": "«После этого путешествия в моём кошельке не осталось ни одной моры, зато я обрёл покой и безмятежность».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961003,
					"content": "«Если хочешь послушать мои рассказы, заходи в овощную лавку. И не забудь купить там немного овощей».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319611,
			"completionStepIds": [
				7319611
			],
