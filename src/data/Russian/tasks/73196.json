			"dialogs": [
				{
					"id": 731961701,
					"content": "«Не буду много разглагольствовать, всем и без меня знакомо имя госпожи Сангема-бай».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961702,
					"content": "«Пришла новая партия ковров! Они не умеют летать, зато намного прочнее ковров Зулейки. Уважаемые покупатели, скорее приходите за коврами. Вы сами знаете, где их найти, хе-хе».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961703,
					"content": "«Дори! Это уж чересчур!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
