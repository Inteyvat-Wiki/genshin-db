			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "Наша компания занимается внешней торговлей и уже много лет сотрудничает с флотом Южного Креста для защиты вашего товара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961202,
					"content": "Этим летом мы откроем четыре дополнительных маршрута, по которым можно перевозить шёлк, специи, руду и другие товары. Наши торговые суда обладают большой грузоподъёмностью. Приглашаем всех заинтересованных к сотрудничеству.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961203,
					"content": "Если вы хотите заключить контракт, свяжитесь с Фарзане для обсуждения деталей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
