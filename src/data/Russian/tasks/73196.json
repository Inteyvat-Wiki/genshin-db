			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961101,
					"content": "Красильная мастерская Ани использует самые деликатные технологии, чтобы придать вашей одежде новые цвета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961102,
					"content": "«Эй, хозяин, можно забрать одежду, которую я оставил на покраску в прошлом месяце?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961103,
					"content": "«Ох, у меня жена вчера родила, совсем не было времени. Приходите завтра, всё будет готово. Тысяча извинений».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961104,
					"content": "«Прошло уже три месяца! Верните мою одежду, мне не нужны ваши услуги».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 731961105,
					"content": "«Тысяча извинений! Я покрасил вашу одежду, но какой-то воришка украл её во время сушки. Так что обращайтесь к нему».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
			"id": 7319612,
			"completionStepIds": [
				7319612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
