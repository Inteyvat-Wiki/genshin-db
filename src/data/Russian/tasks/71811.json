			"dialogs": [
				{
					"id": 718110412,
					"content": "Насчёт «фотокамеры»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "#Ты уже доставил{F#а} фотографии их владельцам?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110402,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "Спасибо тебе, спасибо. Прости, пожалуйста, за беспокойство, но у нас дел невпроворот...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110404,
					"content": "А, точно. Вот тебе за труды «фотокамера».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110405,
					"content": "Но я не могу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "#Ничего, ничего. Ты ведь помог{F#ла} нам, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110408,
					"content": "И не такая она уж и дорогая. Это образец, который нам подарили партнёры из Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110409,
					"content": "От серийной модели она несколько отличается... Но все основные функции в ней есть. Их должно быть более чем достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110410,
					"content": "Ну и если она тебе понравится, не забудь посоветовать её своим друзьям и знакомым.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110411,
					"content": "Кхм... В общем, благодарю тебя за помощь! Прими эту фотокамеру, прими.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сюй"
				},
				{
					"id": 718110406,
					"content": "Она, наверное, очень дорогая...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
