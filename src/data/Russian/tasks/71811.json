				{
					"id": 718110602,
					"content": "Насчёт «фотокамеры»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110603
					]
				},
				{
					"id": 718110603,
					"content": "Ах да, припоминаю. Я обращался в торговую гильдию «Фэйюнь» с просьбой запечатлеть меня на снимке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110604
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 718110604,
					"content": "Ну как? Картинка уже готова? Дай посмотреть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110605
					],
					"speakerTitle": "Чайный доктор Лю Су"
				},
				{
					"id": 718110605,
					"content": "#Право, недурно. Спасибо, что {M#принёс}{F#принесла} мне его.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чайный доктор Лю Су"
				}
