			"dialogs": [
				{
					"id": 718110501,
					"content": "Хм? Что стряслось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110502
					],
					"speakerTitle": "Бабуля Шань"
				},
				{
					"id": 718110502,
					"content": "Насчёт «фотокамеры»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "«Фотокамеры»... Ах, да. Недавно я заходила в торговую гильдию «Фэйюнь» - просила их прийти и сфотографировать меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Бабуля Шань"
				},
				{
					"id": 718110504,
					"content": "#Так ты прин{F#есла}{M#ёс} мне этот снимок? Спасибо тебе большое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бабуля Шань"
				}
			]
		},
