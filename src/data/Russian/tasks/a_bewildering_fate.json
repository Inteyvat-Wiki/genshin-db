			"dialogs": [
				{
					"id": 105020301,
					"content": "Я нашла её! Вот она эта коробочка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020302,
					"content": "Удивительно, что она пережила все эти взрывы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105020303,
					"content": "Поиски завершены! Пойдём отнесём её той девушке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кли"
