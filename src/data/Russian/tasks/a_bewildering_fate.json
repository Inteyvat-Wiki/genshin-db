			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "Наконец-то вы вернулись. Мне было ужасно скучно ждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020402,
					"content": "Я хотела почитать книжку, но это оказался какой-то бредовый дневник. В нём вообще нет ни капли смысла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020403,
					"content": "Он выпал из рюкзака Кли. Я подумала, что в нём хранятся древние знания, но нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020404,
					"content": "Ладно, неважно. У вас получилось найти шкатулку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020405,
					"content": "Да! Мы её нашли и даже не повредили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020406,
					"content": "Великолепно! Подождите, а почему... Почему она открыта?! Что?! Почему она пустая???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020407,
					"content": "Что???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105020408,
					"content": "Я вытащила из неё всё, чтобы хранить там сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020409,
					"content": "Вытащила?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020410,
					"content": "Теперь вы пришли за ней, поэтому мне пришлось вытащить все свои сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020411,
					"content": "Ты хранила в нём свои вещи?! А-а где то, что в ней лежало до этого? Мне нужно оно, а не шкатулка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020412,
					"content": "Ох. Вам нужно то, что было в шкатулке? Надо было сразу сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020413,
					"content": "Ты же... ничего не сломала и не выкинула?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020414,
					"content": "Конечно нет! Я ничего не ломала...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020415,
					"content": "Фух...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020416,
					"content": "В этой шкатулке была только та книга, которая у вас в руках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020417,
					"content": "Что???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020418,
					"content": "Эта... Эта книга... Этот дневник... и есть те самые записи 50-летней давности?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020419,
					"content": "Те тайны, которые эта старуха стремилась вернуть себе 50 лет, оказались всего лишь её постыдными историями молодости?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020420,
					"content": "Теперь понятно, почему она наказала мне ни в коем случае не читать его, иначе она пустит меня на фарш...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020421,
					"content": "Кажется, мне крышка...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020422,
					"content": "А! Вы сами сказали, что хотите шкатулку, а не то, что в ней было!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020423,
					"content": "Я ничего не знаю, я пошла, всем пока!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Кли"
				},
				{
					"id": 105020424,
					"content": "Какой трогательный финал...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Хм... Если ты ничего не скажешь, твоя наставница ничего не узнает, ведь так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105020427,
					"content": "Узнает. Астрология делает скрытое явным, вы сами это видели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020428,
					"content": "Ох... Потратила всю мору, чтобы добраться до Мондштадта, но в итоге не нашла никаких знаний, да ещё и возвращаться нельзя... Как моя жизнь до такого докатилась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020429,
					"content": "Это очень грустно... Может быть, ты бы могла вернуться, когда забудешь всё, что прочитала в этой книге?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105020430,
					"content": "Это не так просто. И оставаться в Мондштадте тоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020431,
					"content": "Неловко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Да. Как мне продолжать заниматься астрологией, живя среди обычных людей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020435,
					"content": "Тогда тебе остаётся только вернуться к своей наставнице.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105020436,
					"content": "Хватит об этом говорить! Я... Я думаю, мне придётся...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020437,
					"content": "Решено, я временно поживу тут, в Мондштадте. Как только эта старуха испустит свой последний вздох, я стану свободна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020438,
					"content": "Чересчур жёсткое решение...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "Но что тогда станет с моими исследованиями астрологии? Подождите, мне же ведь даже негде остановиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020441,
					"content": "Хм... Может быть, нам стоит спросить у Катерины из <color=#00E1FFFF>Гильдии искателей приключений</color>? Может, она сможет помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 105020442,
					"content": "Гильдия искателей приключений? Точно, ведь за выполненные поручения они... Ну, вы понимаете...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020443,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "Ох, спасибо... Я, это... Я... Ладно, ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020444,
					"content": "Мы так и подумали.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "Ну да, «временно»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "Из-за денег?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "Да... В смысле, нет! Почему вы не можете меня поддержать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020425,
					"content": "Незачем злиться на Кли.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
			"id": 1050205,
			"completionStepIds": [
				1050208
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
