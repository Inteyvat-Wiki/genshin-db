					"content": "Эта шкатулка правда очень важна для меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020702
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 105020702,
					"content": "Если с ней что-то случится, я не смогу отчитаться перед старухой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
