			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "Рассказать о проблемах Моны...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 105020502,
					"content": "Вот как... Я поняла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 105020503,
					"content": "В Мондштадте есть <color=#00E1FFFF>магическая лаборатория</color>, на которую кто-то наложил печать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 105020504,
					"content": "Некоторые специалисты открывали её, но у всех них есть свои лаборатории, поэтому они не были заинтересованы в этом помещении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 105020505,
					"content": "Думаю, если бы упомянутый тобой астролог смогла разрушить печать, то хозяин этого дома не стал бы возражать и пустил её туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 105020506,
					"content": "Думаю, она справится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "Замечательно. Давайте, я покажу вам, где находится этот дом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 105020507,
					"content": "Я отведу её туда.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
