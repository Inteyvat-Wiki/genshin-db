	"talks": [
		{
			"id": 7052101,
			"completionStepIds": [
				7052102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052102",
							"2"
						],
						"stepId": 7052102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Эола",
					"Эмбер",
					"Бернхард"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705210101,
					"content": "Эола и Эмбер! И вы тут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210102,
					"content": "#{NICKNAME} и Паймон, наконец мы вас нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210103
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210103,
					"content": "А? Вы специально пришли нас проведать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210104,
					"content": "Конечно! Ваша лавка стала такой известной, что о ней говорят все!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210105
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210105,
					"content": "«Почётный рыцарь и белая помощница продают во \"Вкусноте и милоте от Фавониуса\" ценные вещи, а ещё дарят удивительные подарки. Непременно зайдите к ним!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210106
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210106,
					"content": "Ох, Паймон опять называют «белой помощницей». Но всё равно очень приятно слышать лестные отзывы о нашей лавке!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210107,
						705210108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210107,
					"content": "И всё это благодаря нашим посетителям.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210109
					]
				},
				{
					"id": 705210109,
					"content": "Кстати, Паймон давненько не видела Эмбер и Эолу. Вы куда-то уезжали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210110,
					"content": "Ха-ха, мы же всё ещё работаем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210111
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210111,
					"content": "Что? Всё ещё работаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210112,
						705210113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210112,
					"content": "И по праздникам не отдыхаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210114
					]
				},
				{
					"id": 705210114,
					"content": "Если быть точнее, то я и Эмбер работаем на полставки в ордене.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210115
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210115,
					"content": "Во время Праздника вина между Мондштадтом и Терновым портом туда-сюда ходят торговые караваны. Это как раз то время, когда нужно усилить безопасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210116
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210116,
					"content": "Потому что монстры и разбойники могут напасть на них?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210117,
					"content": "Именно поэтому. В задачу разведывательного отряда как раз входит патруль между двумя точками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210118
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210118,
					"content": "Во время сопровождения каравана и защиты груза мы должны активно проверять подозрительные места и заранее отводить опасность.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210119
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210119,
					"content": "Похоже, вам не сладко. У вас будет такой напряжённый график до завершения Праздника вина?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210120
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210120,
					"content": "Конечно, нет. Мы работаем посменно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210121
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210121,
					"content": "Пока одна группа дежурит, вторая группа отдыхает, а третья в резерве на экстренный случай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210122
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210122,
					"content": "Периодически эти три группы меняются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210123
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210123,
					"content": "Ведь Эола очень опытная руководительница. Благодаря её усилиям разведывательный отряд всегда справляется со своими задачами и даже успевает отдохнуть. Эола - великолепный организатор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210124
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210124,
					"content": "Будет тебе, Эмбер. Я делала свою работу, как всегда. Я действительно не понимаю, из-за чего весь сыр-бор...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210125,
						705210127
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210125,
					"content": "Хороший скаут всегда полон энтузиазма.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210126
					]
				},
				{
					"id": 705210126,
					"content": "Хи-хи, в следующий раз я расскажу тебе первые дни Эолы на посту капитана. Ты будешь в восторге.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210129
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210129,
					"content": "Кхм... Вообще-то, мы пришли по делу. Пусть Эола всё расскажет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210130
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210130,
					"content": "Да. Нам нужно сорок порций особого копчёного цыплёночка ордена и сорок порций «Расти гора» Фавониус...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210131
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210131,
					"content": "Ничего себе! И всё за раз?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210132,
					"content": "Неужели орден проводит званый ужин? А почему нас не позвали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210133,
					"content": "Ха-ха, всё совсем не так. Просто капитан Эола хочет наградить своих подчинённых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210134
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210134,
					"content": "Ага. Члены разведывательного отряда тратят много энергии, поэтому за один присест они могут съесть четыре, а то и пять порций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210135
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210135,
					"content": "К тому же к нам вернулся бывший сослуживец, поэтому мы бы хотели отпраздновать это событие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210136
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210136,
					"content": "И вот я решила купить вашу продукцию, чтобы поддержать вас, ведь деньги пойдут на благотворительность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210137
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210137,
					"content": "Ого! Мудрое решение, Эола! Двух зайцев одним выстрелом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210138,
					"content": "Благодарим за визит!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210139
					]
				},
				{
					"id": 705210139,
					"content": "Кстати, скорее всего, мы уже встречали вашего бывшего сослуживца, о котором упоминала Эола...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210140,
					"content": "Это наш геодезист Мика. Он был ключевым членом отряда, пока не отправился в экспедицию с магистром.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210141
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210141,
					"content": "Да, тот самый! Паймон никогда бы не подумала, что этот маленький застенчивый рыцарь такой крутой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210142,
						705210143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210142,
					"content": "Но, кажется, он нас боится.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210144
					]
				},
				{
					"id": 705210144,
					"content": "Дело не в том, что он вас боится. Это может показаться немного странным, но так он проявляет своё уважение к вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210145
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210145,
					"content": "Он считает, что все те, кто обладает силой, обладают уникальными личностями. Он хочет понять, какие вы и как вы мыслите, прежде чем общаться с вами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210146
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210146,
					"content": "Он говорит, что так легче общаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210147
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210147,
					"content": "Сначала он так же относился ко мне и Эмбер. И только познакомившись с нами поближе, он стал вести себя более естественно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210148
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210148,
					"content": "Ах, вот как... Значит, Мика - уникальная личность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210149,
						705210150
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210149,
					"content": "Я это запомню.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210151
					]
				},
				{
					"id": 705210151,
					"content": "Всё будет хорошо после того, как вы побольше пообщаетесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210152
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210152,
					"content": "Ты занимаешь важное место в ордене, поэтому, будучи его командиром, я не хочу чтобы между вами было недопонимание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210153
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210153,
					"content": "Хи-хи, Эола, не надо объяснять. Ты же за него переживаешь, мы всё видим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210154
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210154,
					"content": "Эола, ты мою порцию тоже посчитала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210155
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210155,
					"content": "Я сама за себя заплачу. Ведь я же официально не вхожу в разведывательный отряд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210156
					],
					"speakerTitle": "Эмбер"
				},
				{
					"id": 705210156,
					"content": "Если тебя беспокоят формальности, то я официально тебя угощаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210157
					],
					"speakerTitle": "Эола"
				},
				{
					"id": 705210157,
					"content": "Вы передаёте Эоле и Эмбер необходимое количество порций. И, поблагодарив, они уходят.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705210158
					]
				},
				{
					"id": 705210158,
					"content": "Хе-хе, благодаря Эоле и Эмбер мы одним махом заработали, как за целый день!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210159
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210159,
					"content": "Почётный рыцарь, Паймон! У меня прекрасные новости...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210160
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705210160,
					"content": "Благодаря вам двоим сбор средств на этом мероприятии превысил все ожидания. Можно сказать, что мы добились огромного успеха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210161
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705210161,
					"content": "Хе-хе, видишь? А Паймон говорила, что мы обязательно справимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210162,
						705210163
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705210162,
					"content": "Спасибо всем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705210164
					]
				},
				{
					"id": 705210164,
					"content": "Вы двое заслуживаете всяческих похвал. Именно благодаря вашему мудрому руководству благотворительная ярмарка прошла с таким успехом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210165
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705210165,
					"content": "Все вырученные средства я уже передал руководителю благотворительного фонда. А эта ярмарка торжественно объявляется завершённой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705210166
					],
					"speakerTitle": "Бернхард"
				},
				{
					"id": 705210166,
