			"dialogs": [
				{
					"id": 762130201,
					"content": "Миражи, иллюзии... К чему гоняться за ними? Даже если постигать истину тысячу лет, храня покой в сердце, понимания не прибавится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130202,
					"content": "Так... ты ищешь книгу?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "#Ты бывал{F#а} здесь раньше?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130204,
					"content": "А?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "Тогда ты понимаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130208,
					"content": "Что понимаю?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "Хочешь спать - спи, хочешь понять - пойми.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130211,
					"content": "Ступай. Когда мир рушится, следуй за ним.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130209,
					"content": "Как понимаю?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "Нет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "Ничего не понимаю. Ладно, пока.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "Иди прямо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цун Шэнь"
				}
			]
