			"dialogs": [
				{
					"id": 762130101,
					"content": "Ой? Похоже, эта комната завалена книгами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762130102,
					"content": "Ищете книги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130103,
					"content": "Хм... Да нет, нам просто было интересно, что тут внутри...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762130104,
					"content": "Кажется, тут можно пройти сбоку...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "Вам не пройти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130106,
					"content": "Перемещение книг, вот что происходит. Без перемещения вы найдёте себя совсем в другом месте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130107,
					"content": "Я не понимаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "Перемещение книг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130109,
					"content": "Что значит «перемещение книг»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "Если книги не здесь, значит, их переместили. Удел старого монаха - наблюдать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "Цун Шэнь"
				},
				{
					"id": 762130111,
					"content": "Тогда давай я попробую с Дексом.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "Ступай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Цун Шэнь"
				}
			]
		},
