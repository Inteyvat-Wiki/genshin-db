			"dialogs": [
				{
					"id": 6051101,
					"content": "#Господин Альбедо! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051102
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 6051102,
					"content": "Всё в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051103
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 6051103,
					"content": "Да! В город ворвалось несколько монстров, но мы с господином Дилюком и господином Кэйей отбили их атаку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051104
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 6059901,
					"content": "Незадолго до этого...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
