			"dialogs": [
				{
					"id": 6050201,
					"content": "Отличная работа! Вы прекрасно оборонялись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 6050202,
					"content": "Дальше мы сами справимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 6050203,
					"content": "Капитан Кэйа, Свен...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Лоуренс"
				},
				{
					"id": 6050204,
					"content": "Эй! Со мной всё в порядке. А вот нога у тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 6050205,
					"content": "Свен, Лоуренс, ступайте в церковь Фавония, вам надо подлечиться. Мы здесь обо всём позаботимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 6050206,
					"content": "Но господин Дилюк... вы ведь давно покинули орден?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 6050207,
					"content": "Да, но охранять ворота могут не только члены ордена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 6050208,
					"content": "Всё в порядке. Господин Дилюк, как всегда, очень... отзывчив. Если горожанин хочет помочь, кто мы такие, чтобы ему отказывать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 6050209,
					"content": "...Ясно. Мы очень благодарны вам за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Свен"
				},
				{
					"id": 6050210,
					"content": "Да, спасибо! Мы скоро вернёмся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Лоуренс"
				},
				{
					"id": 6051104,
					"content": "Пока есть время, я хотела приготовить немного зелий, чтобы укрепить силы наших воинов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 6051105,
					"content": "Отличный план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 6051106,
					"content": "Будь осторожна. Понимаю, вероятность этого не велика, но если поймёшь, что не справляешься, сразу отступай в безопасное место. За линию фронта не беспокойся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 6051107,
					"content": "Да, я поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сахароза"
				}
			]
		},
