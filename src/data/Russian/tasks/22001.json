					"Малыш Мэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "А вот и капитан!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010302,
					"content": "Что делаешь?! Зачем приводить сюда пиратов?! Ты должен был их отвлекать, чтобы мы с Лулу смогли спастись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220010303,
					"content": "Почему это вы с Лулу должны спастись, а я должен остаться с пиратами?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010304,
					"content": "У меня есть идея получше! Я сдам тебя пиратам, а сам сбегу с Лулу! Как тебе такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010305,
					"content": "Но... Ты... Бэй Доу говорит, что нельзя бросать своих друзей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220010306,
					"content": "Да? А что Бэй Доу говорит про капитанов, которые бегут от опасности?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010307,
					"content": "Ах ты... Я больше НИКОГДА не буду с тобой делиться чашечками лотоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220010308,
					"content": "Ну и не надо! Не нужны мне твои дурацкие семена лотоса!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010309,
					"content": "Кажется, ситуация выходит из под контроля...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220010310,
					"content": "Не переживай! Я знаю, что делать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010311,
					"content": "Чашечки лотоса - это их любимое лакомство. Если ты принесёшь им вкусняшек, то они точно успокоятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010312,
					"content": "Поможешь мне найти чашечки лотоса?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010313,
					"content": "Ладно, помогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Спасибо! Нужно действовать быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010315,
					"content": "Но они ругаются не из-за чашечек лотоса...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Эм... А из-за чего тогда? Разве это не их любимое лакомство?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010317,
					"content": "Давай поищем чашечки лотоса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				}
			]
		},
