					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "Ах ты!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010404,
					"content": "Ах ты!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220010405,
					"content": "Прекратите ссориться! Это ни к чему не приведёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010406,
					"content": "Это просто игра. Давайте жить дружно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010407,
					"content": "Смотрите, что у меня есть... Вкусные чашечки лотоса! Угощайтесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010408,
					"content": "Когда закончите, мы всё хорошенько обсудим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010409,
					"content": "Мы решим, кто будет капитаном, а кто первым помощником. Ладненько?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010410,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220010411,
					"content": "Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010412,
					"content": "Ого! Сработало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 220010413,
					"content": "Я же говорила!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010414,
					"content": "Откуда ты знала, что это сработает?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Мы играем уже очень давно. Я знаю, как это работает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010416,
					"content": "Ты просто чудо, Лулу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Спасибо... Но, на самом деле, чудо - это Бэй Доу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010418,
					"content": "Я хочу быть похожей на Бэй Доу, когда вырасту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малышка Лулу"
				}
			]
