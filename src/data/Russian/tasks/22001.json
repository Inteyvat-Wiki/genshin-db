			"dialogs": [
				{
					"id": 220010101,
					"content": "Малыш Мэн, сегодня я буду капитаном, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010102,
					"content": "Лулу, я был капитаном уже много раз. Пусть капитаном будет Фэй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Малыш Мэн"
				},
				{
					"id": 220010103,
					"content": "Малыш Мэн, ты самый крутой капитан на свете! Оставайся капитаном!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Малышка Лулу"
				},
				{
					"id": 220010104,
					"content": "Что вы делаете?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Мы играем. Они обещали, что в этот раз я буду капитаном!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010106,
					"content": "Лулу говорит, что играть веселее, когда капитан - Мэн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010107,
					"content": "Лулу так всегда говорит... Но ей виднее, наверное...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010108,
					"content": "Хочешь поиграть с нами? Ты можешь стать пиратом!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010109,
					"content": "Ладно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "Эх... Я опять только первый помощник...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010113,
					"content": "#Как и в прошлый раз, мы начнём игру, когда ты будешь готов{F#а}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Малыш Фэй"
				},
				{
					"id": 220010111,
					"content": "Но я хочу играть за хороших...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "Ух... Как же сильно я хочу быть капитаном!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Малыш Фэй"
				}
			]
		},
