						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Арапакати",
					"Арама",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "#Ой! {M#Золотой}{F#Золотая} нара...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130102,
					"content": "#Арапакати не боится. Нара {NICKNAME} {M#хороший}{F#хорошая}. Прямо как {M#та}{F#тот} нара из рассказов. А ещё нара {NICKNAME} и Паймон много помогали нам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130103,
					"content": "#Да, нечего бояться. Арама и Арапакати тебе верят. А ещё верят траве, листьям и семенам. Все они говорят, что ты {F#хорошая}{M#хороший} нара. Приветствую, нара {NICKNAME} и Паймон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130104,
					"content": "Привет, Арапакати!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130105,
					"content": "#На самом деле, я {M#злодей}{F#злодейка}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "Эй, что за шутки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130107,
					"content": "Нет. Арапакати знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130108,
					"content": "#В землях, где много ветров, летают крошечные семена. Они пришли в Ванарану вместе с нарой. Они говорят, что {NICKNAME} - {M#хороший}{F#хорошая} нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130109,
					"content": "Паймон слышала подобное и от Арамы! Семена из земель, где много ветров?.. То есть, семена одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130110,
					"content": "Может, семена ветряной астры.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#Нара {NICKNAME} поможет Аране вырастить биджу. Значит, будем готовиться к Празднику Утсава вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130116,
					"content": "Ой-ой-ой... Праздник Утсава...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130117,
					"content": "Как-то Арапакати неважно выглядит. Тебя что-то беспокоит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130118,
					"content": "Старшие братья Арапакати. Они до сих пор не вернулись в Ванарану. А ведь сёстры и братья должны встречать Праздник Утсава вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130119,
					"content": "Да, Арачаторы, Арасаки, Арапаса и Арафалы уже давно не было в Ванаране. После той истории они больше не появлялись.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130120,
					"content": "Давно?.. Насколько давно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130121,
					"content": "Много, много лун назад. Тогда семена только взошли. Теперь из них выросли деревья, под которыми аранары могут укрыться от дождя. Высотой они как семь Арапакати!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130122,
					"content": "Из семян выросли деревья?.. Ого! Так это ведь сколько времени прошло! Твои братья пропали, Арапакати?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130123,
					"content": "«Про-пали»? Это семена такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130124,
					"content": "О-о-о, значит, «пропали» - это семена нар. Удивительно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130125,
					"content": "#Нары потрясающи! У нары по имени {NICKNAME} наверняка есть много-много «пропали».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130126,
					"content": "Паймон не это имела в виду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130127,
					"content": "Это значит, никто не знает, куда они подевались.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "О, нет. Арапакати знает, где сейчас Арачатора, Арасака, Арапас и Арафала. Братья не пропали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130129,
					"content": "Они давным-давно покинули Ванарану, чтобы практиковаться. Практиковаться в кулинарии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130136,
					"content": "Практиковаться в кулинарии. Вот оно что...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130137,
					"content": "Паймон такое должно заинтересовать...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#Хм... Паймон куда больше интересует, когда в кулинарии практикуется {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130139,
					"content": "Что это за «практикование в кулинарии» такое?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130140,
					"content": "В прошлый Праздник Утсава нары приготовили много разных блюд, чтобы угостить аранар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130141,
					"content": "Чтобы приготовить нарам угощения к грядущему Празднику Утсава, Арачатора и остальные братья отправились практиковаться в кулинарии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130142,
					"content": "Паймон вдруг тоже захотелось на Праздник Утсава!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130143,
					"content": "Но там ведь еда аранар...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "Не беда! Вкусная еда - общий язык всех живых существ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130146,
					"content": "Но если ты знаешь, где твои братья, почему не отправишься на их поиски самостоятельно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130147,
					"content": "Идёт подготовка к великому Празднику Утсава. У Арапакати очень много дел. Нет времени на поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130148,
					"content": "Они покинули Ванарану обучаться кулинарии, готовиться к Празднику Утсава. Но они не знают, что Праздник Утсава вот-вот начнётся! Арачатора, Арасака, Арапас и Арафала глупые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130149,
					"content": "#Так поручи это дело нам! Мы всё равно собирались с Арамой искать аранар и готовиться к Празднику Утсава. Правда, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130150,
					"content": "Мы займёмся этим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "Но как мы найдём Арачатору, Ара... как их там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130153,
					"content": "Арачатора, Арасака, Арапас и Арафала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130154,
					"content": "Светяшки-валяшки! А ведь есть ещё Арана, Арама, Араджа и Арапакати... Почему у аранар такие сложные имена?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130155,
					"content": "Паймон, не говори так, не то аранары обидятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130156,
					"content": "Хорошо, Паймон поняла. Ну так что, как нам их найти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130157,
					"content": "Они пытались практиковаться в кулинарии в Ванаране, но наделали много дыма. Арапакати пришлось прогнать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130158,
					"content": "Все тогда здорово испугались. Некоторые даже впали в спячку. К счастью, Арама храбрый. Он наказал дым. Арапакати рассердилась и прогнала братьев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130159,
					"content": "Если увидите <color=#00E1FFFF>густые клубы дыма</color>, значит, они где-то рядом. Скорее всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130160,
					"content": "Так ты их прогнала?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130161,
					"content": "Да. Что не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130162,
					"content": "#Да ничего... Ладно, {NICKNAME}, отправляемся в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130163,
					"content": "Да, ещё кое-что. Если братья ведут себя странно, окатите их <color=#00E1FFFF>силой Дендро</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130164,
					"content": "Когда-то они делали очень много дыма. Вся Ванарана в дыму была. Они пугались и носились повсюду. Иногда они становятся такими, прикоснувшись к странным грибам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130165,
					"content": "Но аранары - духи леса. Напитавшись силой <color=#00E1FFFF>Дендро</color>, мы восстанавливаемся и приходим в себя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130166,
					"content": "#Ясно. {NICKNAME}, напитавшись цыплёнком в медовом соусе, тоже восстанавливается. Значит, {NICKNAME} - дух цыплёнка в медовом соусе. Очень логично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130170,
					"content": "...Словом, отправляемся в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130172,
					"content": "#Удачи, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арама"
				},
				{
					"id": 730130171,
					"content": "Да, отправляемся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "Вот бы он скорее наступил!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "Понимаю, каково тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#Нара {NICKNAME} понимает, каково мне?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130132,
					"content": "#Да, у {M#него}{F#неё} пропал{M#а} {M#сестра}{F#брат}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130133,
					"content": "#А-а. Нара {NICKNAME}, {M#твоя сестра}{F#твой брат} тоже {M#отправилась}{F#отправился} практиковаться в кулинарии?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130134,
					"content": "А? Вы не совсем поняли... Это значит, никто не знает, куда они подевались.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130135,
					"content": "О, нет. Арапакати знает, где сейчас Арачатора, Арасака, Арапас и Арафала. Братья не пропали. Они давным-давно покинули Ванарану, чтобы практиковаться. Практиковаться в кулинарии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130111,
					"content": "Или сосновые шишки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "Словно ветер приносит семена историй...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130114,
					"content": "Привет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301302",
							"2"
						],
						"stepId": 7301302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арапакати"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "...Разговаривать с нарами очень сложно. А ещё они такие высокие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130202,
					"content": "Привет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Ой! Нара {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130204,
					"content": "Арапакати не боится. И мои братья смелы. Они не испугаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130205,
					"content": "Иди на <color=#00E1FFFF>дым</color>, и ты найдёшь их. Если братья ведут себя странно, окати их <color=#00E1FFFF>силой Дендро</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапакати"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Арапакати",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Арапакати очень сердится! Ай-яй-яй! Арапакати сердитее самой сердитости!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130302,
					"content": "В лесу очень опасно. Там свирепствует Марана. Во время прощания Арапакати говорила братьям держаться вместе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130303,
					"content": "Но стоило вам переступить порог, как вы тут же разругались. А ты, Арачатора, ещё и съел странное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130304,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730130305,
					"content": "Арапакати не разрешает Арачаторе ходить за грибами, пока закатник не созреет десять раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130306,
					"content": "Как же так... У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Арачатора"
				},
				{
					"id": 730130307,
					"content": "Именно. Что мы будем делать, если ты сюда занесёшь дурные споры, а из них вырастут грибные монстры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730130308,
					"content": "И ты, Арафала. Надо было тебе уйти собирать фрукты в такую даль. Там много, очень много дурного! Как же предостережения Араджи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130309,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Арафала"
				},
				{
					"id": 730130310,
					"content": "Да, верно. Фрукты пьют воду, и аранары пьют воду. Так что лучше воды ничего не найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730130311,
					"content": "#Арапас, зачем было идти за водой к машине Варуны? Неужели ты не знаешь, даже нара Варуна {F#говорил}{M#говорила}, что самая вкусная вода - у нас, в Ванаране?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130312,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Арапас"
				},
				{
					"id": 730130313,
					"content": "Теперь... Теперь вы видите, что только «вкус счастья» и может обрадовать Арапакати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730130314,
					"content": "#Арасака, говорят, что ради твоего «вкуса счастья» Нара {NICKNAME} {M#ввязался}{F#ввязалась} в целую историю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130315,
					"content": "Это... Это всё ради «величайшего лакомства»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730130316,
					"content": "«Величайшее лакомство» готовится для того, чтобы показать плоды «кулинарной практики». Но зачем она была нужна, если для её завершения потребовалась помощь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130317,
					"content": "Арапакати считает, что Арасаке нужно как следует подумать над своим поведением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130318,
					"content": "Хнык-хнык...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Арасака"
				},
				{
					"id": 730130319,
					"content": "Арапакати! Вот и мы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130320,
					"content": "А, приветствую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130321,
					"content": "#Нара {NICKNAME} и Паймон разделили тяготы Арапакати и избавили Арапакати от их источника...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130322,
					"content": "Арапакати больше не тревожится, что братья пропустят Праздник Утсава, или что они в опасности. Всё благодаря вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130323,
					"content": "Арапакати и братья очень вам благодарны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130324,
					"content": "Вот и отлично!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130325,
					"content": "Но Паймон давно хочет кое о чём спросить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130326,
					"content": "Кто это - «нара Варуна»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "Это наш друг. Друг Ванараны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130328,
					"content": "#Давний-предавний друг аранар. {F#Он}{M#Она} и {NICKNAME} очень похожи, вы - золотые нары.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130329,
					"content": "Вот оно что. Но у Паймон был ещё один вопрос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130330,
					"content": "О «братьях»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Ага. Арапакати, кто из твоих братьев самый большой, а кто самый маленький?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130332,
					"content": "А? Большой и маленький?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130333,
					"content": "По возрасту...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "Возраст... А, Арапакати понимает. Это как годовые кольца на дереве. Но старшинство детей леса определяется не возрастом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130337,
					"content": "А? Почему тогда ты называешь их старшими братьями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130338,
					"content": "#Попробую объяснить. Когда-то мы подружились с нарой. {M#Её}{F#Его} звали нара Варуна. {M#Она}{F#Он} {M#говорила}{F#говорил}, что у {M#неё}{F#него} есть «{M#брат}{F#сестра}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130339,
					"content": "#Когда {M#она}{F#он} {M#рассказывала}{F#рассказывал} про «{F#сестру}{M#брата}», Арапакати и братья заметили, что {M#она}{F#он} {M#выглядела}{F#выглядел} {M#счастливой}{F#счастливым}, но немного {M#грустной}{F#грустным}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130340,
					"content": "И тогда мы поняли. «Сестра» для «брата» - самая важная нара. И «брат» для «сестры» - самый важный нара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130341,
					"content": "#Нам это понравилось. Поэтому, Арапакати и братья решили называться братьями и сестрой. Нара Варуна {M#сказала}{F#сказал}, что это очень хорошо. Близких нужно беречь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130342,
					"content": "Да, надо беречь своих близких.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Да...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130344,
					"content": "Паймон хотела ещё кое-что спросить... Аранарам вообще нужна пища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130345,
					"content": "Люди готовят еду из разных продуктов. Дети леса тоже готовят еду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130346,
					"content": "#Нара Варуна {M#показала}{F#показал} нам, как питаются нары. Тогда Арапакати с братьями начали практиковаться в кулинарии...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130347,
					"content": "Хм, как странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130348,
					"content": "Они будто играют в игру...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "#Арапакати и братья относятся к этому очень серьёзно. Нара Варуна {M#говорила}{F#говорил}, что разделять пищу с другими большая радость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130351,
					"content": "#Да, Арапас говорил, что нара {NICKNAME} тоже умеет готовить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130352,
					"content": "#Да, {NICKNAME} - настоящий мастер кулинарии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730130353,
					"content": "#Вот как... Нара {NICKNAME} непременно {M#должен}{F#должна} посетить Праздник Утсава. Помочь моим неумелым братьям приготовить угощения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130354,
					"content": "Пусть они ещё раз убедятся, что только нары знают толк в настоящей кухне. А аранарам этого никогда не понять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130355,
					"content": "Но тогда не удивляйтесь...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "Арапакати ждёт с нетерпением. На Празднике Утсава будет очень хорошо, очень весело!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арапакати"
				},
				{
					"id": 730130356,
					"content": "Хорошо, покажу вам класс!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "Словно игра в дочки-матери...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "По росту...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
					"content": "Эй! Нет, конечно. Паймон спрашивает про возраст.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130336
					],
					"speakerTitle": "Паймон"
				}
			]
		},
