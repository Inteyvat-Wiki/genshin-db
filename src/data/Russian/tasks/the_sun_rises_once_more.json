			"dialogs": [
				{
					"id": 766550101,
					"content": "Флинс! У тебя получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766550102,
					"content": "Конечно! И я вам очень обязан. Благодаря вам этот маяк выглядит намного лучше, чем раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 766550103,
					"content": "Да ерунда! Но знаешь, как бы мы ни старались, здесь всё равно очень темно. И остаётся много мест, куда свет маяка не может добраться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766550104,
					"content": "Да. Во внешнем мире жизнь идёт своим чередом, а на кладбище время будто остановилось той ночью, когда закончилась битва.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 766550105,
					"content": "Поначалу я не хотел здесь ничего менять. Но когда вы зажгли маяк, время будто проснулось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 766550106,
					"content": "Твоя жизнь теперь изменится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Если вы хотите узнать, не принесёт ли мне это беспокойства, мой ответ - нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 766550110,
					"content": "Жизнь циклична. Даже без нашего вмешательства призраки, обитающие на острове, постепенно рассеялись бы и вернулись в артерии земли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 766550111,
					"content": "Поэтому не стоит беспокоиться о том, что свет маяка не вездесущ. С исчезновением призраков исчезнет и туман, окутывающий окрестности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Флинс"
				},
				{
					"id": 766550112,
					"content": "Солнце однажды взойдёт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флинс"
				},
				{
					"id": 766550108,
					"content": "Прости, мы не хотели.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Нет, не нужно извиняться. Я не против таких перемен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Флинс"
				}
			]
		}
	]
}