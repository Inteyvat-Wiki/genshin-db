			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "Паймон нашла! «Книга гор и морей», настольная книга искателей приключений, автор - Леонард!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141402,
					"content": "Но страницы выцвели, а местами они вообще вырваны... Паймон этого прочесть не сможет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141403,
					"content": "Да что такое... Может, мы просто теряем время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141404,
					"content": "Не унывай. Посмотрим, что скажет Мона.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "А, точно. Может, она что-то придумает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4111415,
			"completionStepIds": [
				4111415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111415",
							"2"
						],
						"stepId": 4111415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141501,
					"content": "А ты страшный человек!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141502,
					"content": "Я же говорила, что со мной так нельзя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141503,
					"content": "Ты опасный противник, Мона.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "А то! Паймон, ты согласна? Я ведь показала тем Фатуи, кто тут главный?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141505,
					"content": "Конечно, конечно! Если бы не Мона, они бы доставили куда больше хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141506,
					"content": "Слышал, Предвестник Фатуи? Мерзавец...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141507,
					"content": "Но вид у него был потрясённый. Непохоже, чтобы он лгал. Моя наставница часто говорила о «Лживом небе». Может, у этой фразы есть другое значение?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141508,
					"content": "Кхм, что-то я отвлеклась. Пойдёмте, нужно закончить то, зачем мы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141509,
					"content": "<color=#00E1FFFF>Главный метеорит</color> должен быть где-то неподалёку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4111416,
			"completionStepIds": [
				4111416
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111416",
							"2"
						],
						"stepId": 4111416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141601,
					"content": "Ого, это он? Этот метеорит не похож на остальные. Более... блестящий, что ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141602,
					"content": "В этом камне таится колоссальная элементальная энергия и стремления человека. Это и есть главный метеорит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141603,
					"content": "Мы... должны его уничтожить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "Да, иначе остальные никогда не проснутся... Из-за него все беды и произошли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141605,
					"content": "#Давай, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141606,
					"content": "Ого. Такого я не ожидала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141607,
					"content": "Он отдал всё, чтобы взобраться на недосягаемый пик.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "Кто бы мог подумать, что человеческая воля способна пережить тысячи лет в небе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141610,
					"content": "Астрология - крутая штука!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141611,
					"content": "Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141612,
					"content": "Если ты способна общаться со звёздами, то для тебя открыты все секреты человечества... Но, конечно, мало кто из астрологов может достичь такого уровня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141613,
					"content": "Большое спасибо тебе за помощь, Мона.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "Н-ну к чему все эти любезности?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141615,
					"content": "Говоря о любезностях... Девочка эта, Фишль... Очень она занятная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141616,
					"content": "Так считает и Паймон! Она такая... Э... Как сказать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141617,
					"content": "Она - большой оригинал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "Возможно, но... Она всё это время была права.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141620,
					"content": "Может, она из тех, кто неправильными способами добывает правильные ответы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141621,
					"content": "Не исключено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141622,
					"content": "Но самое невероятное - то, что Колпачный пик оказался крошечным островком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141623,
					"content": "Древняя гора, закованная в лёд, теперь клочок суши среди синего моря. Каждый житель Мондштадта может взойти на эту вершину, просто переправившись на лодке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141624,
					"content": "Другими словами, любой может покорить Колпачный пик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141625,
					"content": "Любой может встать на вершину...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "Обрадовался бы этому Леонард? То, что случилось с Колпачным пиком, его бы несомненно поразило... Но теперь благодаря Анемо Архонту мондштадтцы могут летать на планерах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141627,
					"content": "С крыльями мы можем путешествовать дальше и выше, а также исследовать неизведанные места.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141628,
					"content": "(Сбылось ли твоё желание, Леонард?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "С главным метеоритом мы справились, значит, должны проснуться остальные спящие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141630,
					"content": "И мы наконец выполнили поручение Гильдии искателей приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141631,
					"content": "Желаю пострадавшим наискорейшего восстановления.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "У неё буйное воображение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "Он захотел передать своё упорство другим.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}