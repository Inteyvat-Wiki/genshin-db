						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140801,
					"content": "Автор, Леонард... Леонард... Есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140802,
					"content": "Согласно индексу, книга Леонарда должна находиться в <color=#00E1FFFF>северо-западной части первого этажа библиотеки</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140803,
					"content": "Северо-западная часть... Это, должно быть, прямо под нами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4111409,
			"completionStepIds": [
				4111409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111409",
							"2"
						],
						"stepId": 4111409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Мона"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "Мы нашли книжку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140902,
					"content": "Скорее, дайте её мне!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140903,
					"content": "Изложено сбивчиво... Некоторые части отсутствуют.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "Хм, я чего-то подобного и ожидала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140905,
					"content": "Обычный астролог уже признался бы в собственном бессилье!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140906,
					"content": "Но я, Мона, основатель астрологии будущего. Мне всё по плечу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140907,
					"content": "С помощью астролябии я рассчитаю недостающие части, впишу их, и затем расшифрую текст...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140908,
					"content": "Фух!.. Наконец-то готово...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140909,
					"content": "Что там? Что там?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140910,
					"content": "Как я и предполагала, Леонард - искатель приключений, и жил он две тысячи лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140911,
					"content": "Он всю жизнь мечтал покорить снежную вершину под названием Колпачный пик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140912,
					"content": "Две тысячи лет? И созвездию, из которого произошли метеориты, тоже две тысячи лет?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140913,
					"content": "По какой-то причине его созвездие было призвано на землю. Я полагаю, что с этим как-то связаны Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140914,
					"content": "Паймон считает так же. За тёмными делишками почти всегда стоят Фатуи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140915,
					"content": "В метеоритах заключена энергия элементов, которая чем-то вроде гипноза воздействует на людей в округе, заставляя их впасть в летаргический сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140916,
					"content": "Если моя догадка верна, то должен быть главный метеорит, внутри которого находится кристалл с душой Леонарда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140917,
					"content": "И как нам его найти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "Ну, будь я Леонардом, то хотела бы, чтобы он приземлился прямиком на макушку снежной горы, которая при жизни мне не покорилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140919,
					"content": "Значит, главный метеорит должен быть на Колпачном пике? Но где это? Паймон никогда о нём не слышала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140920,
					"content": "Я тоже слышу о таком впервые. Сопоставив карту из книги с современным рельефом Мондштадта, я обнаружила, что Колпачного пика больше не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140921,
					"content": "То есть такая огромная гора просто взяла и исчезла?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411140922,
					"content": "Я где-то читала, что Анемо Архонт Барбатос своей божественной силой ради своего народа сдул все льды и снега, из-за чего рельеф Мондштадта также претерпел изменения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140923,
					"content": "На месте древних гор появились бескрайние моря. Гора такой вышины, однако, не могла не оставить каких-нибудь следов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140924,
					"content": "Вершина горы всё ещё возвышается над водой. И называется она теперь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411140925,
					"content": "<color=#00E1FFFF>Риф Маска.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мона"
				}
			]
		},
		{
			"id": 4111411,
			"completionStepIds": [
				4111411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111411",
							"2"
						],
						"stepId": 4111411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сказитель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "А? Так это и есть бывший Колпачный пик? Какой он теперь крохотный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141102,
					"content": "Похоже, здесь уже кто-то есть... Это место что, какая-то достопримечательность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141103,
					"content": "А! Это ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141104,
					"content": "Э... Хм? Опять вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141105,
					"content": "Как ты нашёл это место?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "Судя по его виду... Ему снился тот кошмар?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141108,
					"content": "Ему удалось пробудиться без посторонней помощи... Разве такое возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141109,
					"content": "Ха-ха! Если у вас что-то не получается - это не значит, что и у меня не получится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141110,
					"content": "Однако вы всё равно опоздали. Моё исследование завершено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141111,
					"content": "Мы так и знали! Всё это грязные проделки Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141112,
					"content": "Только не надо вот этого вот. Сегодня времени на игры с вами у меня нет. Когда придёт час, мы ещё с вами увидимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141113,
					"content": "Постой! Чего ты пытаешься добиться?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "Ты ведь только что был во сне Леонарда? Что тебе о нём известно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141115,
					"content": "Леонарда? Что за Леонард такой?.. Ай, какая разница. Меня ждут большие дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141116,
					"content": "Я обнаружил нечто... Куда более важное... И куда более ужасное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141117,
					"content": "Что же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141118,
					"content": "Что именно?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "Звёзды, небо... Всё это колоссальная ложь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141120,
					"content": "Звёзды - ложь? Да что ты такое несёшь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141121,
					"content": "Хочешь опровергнуть свод астрологических теорий Моны? Тогда тебе понадобятся более весомые аргументы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141122,
					"content": "Ночью стоит просто поднять голову, чтобы увидеть, как мерцают звёзды. Отрицать такое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 411141123,
					"content": "Ха... Ха-ха-ха-ха-ха-ха! Какие вы наивные, вот умора!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141124,
					"content": "Но... Вины вашей в этом нет. Ведь до некоторых пор в это верил и я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141125,
					"content": "До некоторых пор? То есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "Мона"
				},
				{
					"id": 411141126,
					"content": "Ай, нет у меня времени сейчас с вами всё это обсуждать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141127,
					"content": "Чем Пьеро думал, когда поручил мне это задание и не предупредил, с какими открытиями я могу столкнуться?.. Или это он хотел так меня напугать?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141128,
					"content": "Мне пора на встречу с истиной. А вам, щенки, до свиданьица!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 411141106,
					"content": "Ты только что проснулся?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
		{
			"id": 4111414,
			"completionStepIds": [
				4111405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
