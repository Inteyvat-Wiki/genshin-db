				"points": []
			},
			"dialogs": [
				{
					"id": 742480201,
					"content": "«Настольная труппа» здорово затягивает!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 742480202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 742480204,
					"content": "Да, большому и страшному вампиру пора домой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 742480203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}