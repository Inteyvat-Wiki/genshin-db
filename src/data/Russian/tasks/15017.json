			"dialogs": [
				{
					"id": 150170101,
					"content": "Ого, вы так рано! За подарком?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150170102,
					"content": "Мы хотим навестить Тласоли и Нечку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "Да, Нечка так тяжело болела, а госпоже Тласоли пришлось отказаться от хорошей работы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150170104,
					"content": "Как бы то ни было, ситуация улучшилась, но я не уверена, что их жизнь придёт в норму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150170109,
					"content": "Ха-ха, я попросила, чтобы Тласоли сообщили о том, что мы придём. Она наверняка уже ждёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150170110,
					"content": "Тогда пойдёмте. Не присмотришь за магазином, Имиш? Я сейчас вернусь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чивень"
				},
				{
					"id": 150170105,
					"content": "Так что за подарок, интересно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "И Паймон тоже хочется узнать. Но нам также нужно навестить Нечку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150170107,
					"content": "Она тяжело заболела. Я не знаю, как она себя чувствует. А госпожа Тласоли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150170108,
					"content": "Потерять такую работу - это огромный удар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
