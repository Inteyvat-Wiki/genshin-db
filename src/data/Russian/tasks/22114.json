				"objectNames": [
					"Нервный Ань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140701,
					"content": "Я как тот бондарь-неумёха: работать руками толком не умею, и способностей особых нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140702,
					"content": "Бондарь-неумёха?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Ага. Как тот бондарь, которому до целой бочки не хватает одной доски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140704,
					"content": "Но та доска, которая у меня есть, короткая, поэтому такую бочку на полную не используешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140705,
					"content": "А если я примусь искать другую доску, то бочка будет готова непонятно когда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140706,
					"content": "Но срок-то уже подходит, поэтому приходится выбрать из двух зол меньшее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140707,
					"content": "Эх, кто знает, сколько ещё в мире подобных бондарей-неумёх в таком же трудном положении, что и я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140708,
					"content": "Насчёт работы Линь Лин...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "#А что с ней? Ах, да. О том, что ты помог{F#ла} ей пересчитать корабли, мне известно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140710,
					"content": "Не стоит этому удивляться. Меня процесс не волнует, главное результат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140711,
					"content": "К тому же платит она тебе из своего кармана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140712,
					"content": "Но вот сдавать расчёты без проверки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140713,
					"content": "Именно такая безответственность меня и разозлила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нервный Ань"
				}
			]
		},
