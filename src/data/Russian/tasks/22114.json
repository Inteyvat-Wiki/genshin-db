			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линь Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "Всё, всё пропало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "*Хнык* Нервный Ань говорит, что я для этой работы не подхожу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140104,
					"content": "Он ведь просто хочет меня уволить. Что мне теперь делать? О-ой, ма-а-мочки... Я от зари до зари вкалываю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140105,
					"content": "А? С чего это вдруг...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "Так это... Помнишь, я как-то попросила тебя пересчитать корабли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140107,
					"content": "Я доверилась тебе, поэтому ничего перепроверять не стала, и сдала всё, как было.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140108,
					"content": "Многие цифры оказались неверными. Нервный Ань крепко разозлился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140109,
					"content": "Может, ты поговоришь с ним? Я... Я буду относиться к работе серьёзней. И даже помощи твоей больше не попрошу, честное слово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140110,
					"content": "Самой мне идти к нему боязно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140111,
					"content": "Значит, тот подсчёт кораблей оказался неверным?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Да! Я ведь попросила тебя помочь мне посчитать корабли, помнишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140113,
					"content": "Я доверилась тебе, поэтому ничего перепроверять не стала. Сдала всё как было, с кучей ошибок...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140114,
					"content": "Но я прошу помощи очень редко. Так-то я много чего пересчитала сама...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140115,
					"content": "Всё перепуталось... Я совсем не поняла, где ошиблась, и нервный Ань вышел из себя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140116,
					"content": "Прошу тебя, поговори с ним! Я... Я буду относиться к работе серьёзней. И даже помощи твоей больше не попрошу, честное слово!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140117,
					"content": "Самой мне идти к нему боязно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				}
			]
		},
		{
			"id": 2211402,
			"completionStepIds": [
				2211402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нервный Ань"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "Ой, ну в самом деле...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140202,
					"content": "Мы можем поговорить о Линь Лин?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Хм? О Линь Лин, значит? Она... Как бы это сказать... Она для этой работы не подходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140204,
					"content": "Конкретно говоря, она делает в своих расчётах слишком много ошибок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140205,
					"content": "На этой неделе выдалась лишь пара дней, когда она подсчитала всё правильно. Да я на глаз прикидываю куда точнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140206,
					"content": "Вот как я могу доверить работу человеку с таким подходом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140207,
					"content": "Это же просто цифры...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "На работе места для «просто» не существует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140209,
					"content": "Если хоть одна доска в бочке будет короче остальных, то заполнить её доверху уже будет невозможно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140210,
					"content": "То же самое с работой. Если не уделить должного внимания хоть одной детали, вся работа пойдёт насмарку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140211,
					"content": "Взять, к примеру, подсчёт кораблей. Если допустить ошибку в цифрах, то все портовые дела пойдут не так.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140212,
					"content": "Неточности могут дорого обойтись. И если даже исправить положение, то потраченного на это времени будет уже не вернуть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140213,
					"content": "Ты понимаешь, о чём я?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140214,
					"content": "Да... Я понимаю...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "Тем не менее в порту слишком мало работников, поэтому увольнять я её не буду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140216,
					"content": "Всё-таки с короткой доской лучше, чем без неё, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140217,
					"content": "Работник, ответственный за проверку груза, ушёл по срочному делу. Скажи Линь Лин, что там её помощь будет очень кстати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140218,
					"content": "Если она серьёзных ошибок не наделает, то как только тот человек вернётся, она снова сможет считать корабли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140224,
					"content": "Хм... Пусть это будет для неё проверкой, и, наверное, вторым шансом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140225,
					"content": "Передай эту накладную Линь Лин. Скажи ей, чтобы она сверила по ней груз и записала на обратной стороне результат.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140226,
					"content": "Ещё, пусть она не унывает. Но если она даст маху и в этот раз, второго шанса ей не представится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140219,
					"content": "Я скажу об этом Линь Лин.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "Что именно ты ей скажешь? Что она уволена? Нет, она пока ещё не уволена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140221,
					"content": "В порту сильно не хватает рабочих рук. Да и всё-таки с короткой доской лучше, чем без неё, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140222,
					"content": "Работник, ответственный за проверку груза, ушёл по срочному делу. Скажи Линь Лин, что там её помощь будет очень кстати.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "Нервный Ань"
				},
				{
					"id": 221140223,
					"content": "Если она серьёзных ошибок не наделает, то как только тот человек вернётся, она снова сможет считать корабли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Нервный Ань"
				}
			]
		},
		{
			"id": 2211403,
			"completionStepIds": [
				2211403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211403",
							"2"
						],
						"stepId": 2211403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линь Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "У-у-у... Что же мне делать с работой?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140302,
					"content": "Нервный Ань говорит, что даёт тебе второй шанс.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Правда?! Отлично! Просто замечательно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140304,
					"content": "Что? Проверять груз? Вот беда... Я никогда таким не занималась...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140305,
					"content": "Ещё хоть одна ошибка, и мне конец. Ну уж нет, мне нужно хорошенько подготовиться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140306,
					"content": "Надо найти нормы проверки груза... А ещё заполненные стандартные формы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140307,
					"content": "#Не мог{F#ла} бы ты сперва помочь мне проверить количество единиц груза? Просто посмотри, совпадает ли оно с цифрами в накладной. Ну а потом я всё тщательно осмотрю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140308,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Спасибо тебе! А я пока подготовлюсь к проверке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140310,
					"content": "Мне больше ошибаться нельзя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140311,
					"content": "Давай этим займусь я.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "Нет, не надо. Проверять груз куда сложнее, чем считать корабли. Я всё должна сделать самостоятельно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140313,
					"content": "Так что просто проверь количество единиц груза, а я потом всё тщательно осмотрю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211405",
							"2"
						],
						"stepId": 2211405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линь Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "#Ты проверил{F#а} количество груза?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140502,
					"content": "Ну да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Отлично. Я тоже почти закончила с приготовлениями. Чуть позже я проверю весь груз ещё раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140506,
					"content": "Ах, да, это тебе за помощь. Чуть позже я схожу и проверю груз. Теперь мне ошибаться нельзя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140504,
					"content": "Ты ведь не сочиняла стихи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Что ты, совсем нет! Я прекрасно понимаю, что нужно делать в первую очередь. Сейчас для стихов не время...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Линь Лин"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Линь Лин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "Ай, нельзя больше отвлекаться на стихи... Нужно всерьёз приняться за работу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140602,
					"content": "В конце концов, работа важнее.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Я понимаю. Но изо дня в день годами делать одно и тоже надоедает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140604,
					"content": "Такая мелкая работёнка удовольствия не приносит, результата её никто не видит, вот и поневоле начинаешь отвлекаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140605,
					"content": "Нервный Ань постоянно твердит, что всякая работа важна, и что всякая работа на что-то там влияет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140606,
					"content": "Но тогда почему все не берутся за первую попавшуюся работу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140607,
					"content": "Работать нужно добросовестно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Я прошу помощи очень редко. Обычно я делаю всё сама.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140609,
					"content": "Я знаю, что нужно работать добросовестно... Но чем больше нужно сделать, тем сильнее тянет расслабиться. Поэтому иногда я прошу тебя помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140610,
					"content": "Но вот когда мне действительно нечего делать, то, наоборот, хочется найти себе занятие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140611,
					"content": "#Вряд ли ты меня поймёшь, ведь ты в своей жизни не проработал{F#а} и дня, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140612,
					"content": "Почему тебя так тянет писать стихи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "А почему ты вдруг меня об этом спрашиваешь? Дай-ка подумать... Скажи, вот зачем люди работают?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140614,
					"content": "Мне кажется, работать, чтобы потом работать ещё больше, тоска смертная.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140615,
					"content": "У всех есть мечты, так? Что-нибудь такое, что с унылыми буднями не имеет ничего общего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140616,
					"content": "Так вот, когда ты валишься с ног и уже совсем не выдерживаешь, то находишь утешение в мечте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140617,
					"content": "Но это всего лишь моё мнение. Что об этом думают искатели приключений, я не знаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140618,
					"content": "Они только и делают, что живут мечтой, а мне хочется твёрдо стоять на земле, для чего каждодневная работа и нужна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Линь Лин"
				},
				{
					"id": 221140619,
					"content": "И всё же... Ха-ха-ха! Послушай, что я тебе скажу. Мечты останутся мечтами. А работу свою нужно делать основательно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Линь Лин"
				}
			]
		},
