			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юдзу"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "Добрый день, чем могу помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Юдзу"
				},
				{
					"id": 220130302,
					"content": "Здравствуйте. Вам в последнее время, часом, не доводилось читать «Онибудо»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "А? Доводилось. И он мне понравился, вот только... Как бы сказать... В последнее время сюжет немного странноват.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Юдзу"
				},
				{
					"id": 220130304,
					"content": "Главный герой постоянно обретает новые способности и сразу же может победить любого, кто перешел ему дорогу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Юдзу"
				},
				{
					"id": 220130305,
					"content": "Мне нравился «Онибудо» за находчивость, которую требовалось проявлять главному герою для достижения победы над своими противниками, а теперь... Мне кажется, автор немного разленился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Юдзу"
				},
				{
					"id": 220130306,
					"content": "Практически все способности, которые получает главный герой используются лишь один раз. Из-за этого история кажется крайне... небрежной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Юдзу"
				},
				{
					"id": 220130307,
					"content": "Понятия не имею, что это взбрело автору в голову...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Юдзу"
				},
				{
					"id": 220130308,
					"content": "Кхм... ну... может, спросим еще пару человек? Уверен, что это единичный случай...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201304,
			"completionStepIds": [
				2201303
