			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Риэ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130501,
					"content": "Здравствуйте. Поговорить хотите?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 220130502,
					"content": "Здравствуйте. Вам в последнее время, часом, не доводилось читать «Онибудо»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "Читала. Очень симпатизирую главному герою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 220130504,
					"content": "Но в последнее время что-то очень тяжело заходит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 220130505,
					"content": "Почему тяжело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "В последних нескольких главах на главного героя снизошел целый водопад небесной маны в виде кучи неожиданных новых способностей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 220130507,
					"content": "Автор много пишет о том, как эти способности у него пробудились и как их использовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "Риэ"
				},
				{
					"id": 220130508,
					"content": "Но я уже счёт им потеряла, вспоминать их названия становится все сложнее и сложнее. Честно говоря, я уже даже ни одного припомнить не могу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
