				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сигэру",
					"Дзюнкити"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Тебе известно, что пишут о нас читатели? В последнее время их отзывы все хуже и хуже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130102,
					"content": "Не волнуйся. Это всего лишь затишье перед большой бурей успеха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130103,
					"content": "Когда ключевой момент сюжета будет раскрыт, мы увидим настоящий переворот в этих отзывах!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130104,
					"content": "Но какая будет от этого польза, если на тот момент твой роман загнётся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130105,
					"content": "Что происходит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "#Слава Архонтам, что ты здесь, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130107,
					"content": "В последнее время Дзюнкити приписывает слишком много совсем неумеренных способностей главному герою «Онибудо». Просто одну за другой, одну за другой, всё после этого своего «вдохновляющего путешествия».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130108,
					"content": "Издательский дом Яэ получил много негативных отзывов от читателей, которые говорят, что не понимают, откуда появляются все эти способности. Они считают, что автор не воспринимает историю всерьёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130109,
					"content": "Они не знают, о чём говорят. Я просто продолжу писать, а они в конце концов всё поймут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130110,
					"content": "Как я уже говорил, публикацию твоего романа прекратят задолго до того волшебного дня, когда это произойдет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130111,
					"content": "Ладно, мне уже надоело убеждать тебя... Насколько я помню, тут в округе живет несколько читателей «Онибудо»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130112,
					"content": "Почему бы тебе не пойти и не узнать у них, как им нравятся твои идеи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130113,
					"content": "#Именно так я и сделаю! Я уверен, что они-то все понимают. Пойдем со мной, {NICKNAME}, будешь свидетелем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130114,
					"content": "#Отлично. Да, возьми путешественни{F#цу}{M#ка} с собой. Так ты не сможешь потом переврать то, что они сказали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130115,
					"content": "Я обо всём позабочусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Да, пошли. Уверен, что мои читатели меня поймут!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130117,
					"content": "А сколько всего нового ты в итоге добавил?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Ну так... лишь самую малость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130119,
					"content": "«Самую малость»? У главного героя скоро будет больше способностей, чем у всех остальных персонажей вместе взятых!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130120,
					"content": "Кхм! Идём же. Уверен, что мои читатели поймут всю прелесть моего замысла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
