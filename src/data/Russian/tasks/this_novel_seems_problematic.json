			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хасэгава"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Здравствуйте, вы что-то хотели?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Хасэгава"
				},
				{
					"id": 220130402,
					"content": "Здравствуйте. Вам в последнее время, часом, не доводилось читать «Онибудо»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "А как же! Очень интересный роман. Персонажи и сюжет просто замечательные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Хасэгава"
				},
				{
					"id": 220130404,
					"content": "Но... в последнее время создается впечатление, что автор начал работать спустя рукава.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Хасэгава"
				},
				{
					"id": 220130405,
					"content": "Эм... эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130406,
					"content": "Теперь у главного героя постоянно появляются из ниоткуда новые способности, все без какой-либо предпосылки или причины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Хасэгава"
				},
				{
					"id": 220130407,
					"content": "Несмотря на то, что в книге это называется «пробуждением», что-то слишком много раз он пробуждается, думается мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Хасэгава"
				},
				{
					"id": 220130408,
					"content": "Я думаю, что такой дешевый сюжетный ход обесценивает и персонажа. Я очень надеюсь, что автор пересмотрит этот свой ход...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Хасэгава"
				},
				{
					"id": 220130409,
					"content": "#{NICKNAME}, давай... давай, может, спросим кого-нибудь другого?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Дзюнкити"
				}
			]
		},
		{
			"id": 2201305,
			"completionStepIds": [
				2201304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
