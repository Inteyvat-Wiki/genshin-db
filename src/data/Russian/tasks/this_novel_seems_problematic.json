			"dialogs": [
				{
					"id": 220130601,
					"content": "Ну что, как прошло? Вы собрали читательские...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130602
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130602,
					"content": "...Стоп, а почему он такой подавленный... Какого рода отзывы вы получили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130603,
					"content": "Эх... Что же, Дзюнкити, теперь ты видишь, как обстоят дела?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130604,
					"content": "Не могу поверить... Как такое могло произойти...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130605,
					"content": "Мои идеи... моё творчество... больше никому не интересны?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130606,
					"content": "Как я уже говорил, продвижение сюжета лишь за счет наделения персонажа новыми способностями - опасная затея...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130607,
					"content": "Его множественные новые качества могут на первых порах пользоваться популярностью, но как только новизна иссякает, они начинают вызывать у читателей лишь скуку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130608,
					"content": "Я это говорю, основываясь на годах опыта, понимаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130609,
					"content": "З-знаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Дзюнкити"
				},
				{
					"id": 220130610,
					"content": "Однако еще не поздно поправить дело... Плохие отзывы о предыдущих главах уже не изменить, но мы можем вернуть последующие главы на прочную основу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130611,
					"content": "#Спасибо тебе, путешественни{F#ца}{M#к}. Лучше пусть пострадает сейчас. Если бы он продолжил и дальше так писать, в итоге для него всё бы, несомненно, обернулось куда хуже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Сигэру"
				},
				{
					"id": 220130612,
					"content": "Так что спасибо. Вот твои честно заработанные деньги. Пожалуйста, возьми.",
