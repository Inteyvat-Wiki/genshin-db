			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "У вас ко мне ещё дело?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130802,
					"content": "Мы хотим пригласить тебя на Праздник морских фонарей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "...Я не люблю людные места. Идите без меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130804,
					"content": "Мы не собираемся тащить тебя в город.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "...То есть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130806,
					"content": "Раз ты не идёшь на праздник, то праздник идёт к тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "«Идёт ко мне»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130808,
					"content": "Да-да! Прямо на постоялый двор! Спускайся, там много-много вкусной еды, много небесных фонариков и совсем чуть-чуть людей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130809,
					"content": "Ещё там есть миндальный тофу и жареная рыба-тигр...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "Пойдём скорее, пока еда не остыла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "Та-дам! Твой маленький личный Праздник морских фонарей. Выглядит вкусненько, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130902,
					"content": "Вот что вы имели в виду, говоря, что праздник идёт ко мне? Люди всегда поступают так непредсказуемо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130903,
					"content": "В чём смысл ваших действий?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130904,
					"content": "Мы сделали это, чтобы ты мог принять участие в Празднике морских фонарей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "...Вот как? Человеческие мысли действительно трудно предугадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130907,
					"content": "Ой, хватит разговоров, давай скорее есть! А не то всё остынет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130908,
					"content": "Хе-хе, вот Паймон сейчас наестся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130909,
					"content": "Ну, раз мы закончили с самой важной частью праздника, можно и пойти посмотреть на лунный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130910,
					"content": "Сяо, пойдём с нами.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "Вы идите. Меня такие вещи не интересуют.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130912,
					"content": "Ты можешь хотя бы проводить нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "Точно, мы поняли, ты не хочешь смотреть на лунный фонарь. Но ведь нет ничего плохого в том, чтобы проводить нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130915,
					"content": "Дорога отсюда до Ли Юэ долгая и полная опасностей... Полная опасностей, верно?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130916,
					"content": "Тебе даже не нужно будет заходить в город. Ты можешь дойти только до пригорода...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130918,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130919,
					"content": "Хорошо. Я выполню вашу <color=#00E1FFFF>просьбу</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130920,
					"content": "Ура! Тогда в путь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130913,
					"content": "О, великий Защитник Якса, умоляем, проводи нас!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "Праздник морских фонарей для всех.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
			"id": 4131311,
			"completionStepIds": [
				4131311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
