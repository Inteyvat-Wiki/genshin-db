					"Сяо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413131101,
					"content": "Дальше я не пойду. В город ступайте сами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131102,
					"content": "Подожди, пожалуйста.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "Что ещё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131105,
					"content": "Ты один из героев Ли Юэ. Почему же ты не участвуешь в празднике?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413131106,
					"content": "Я... Не люблю толпу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131107,
					"content": "Толпы беззаботных, безмятежных людей... Я не похож на них.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131108,
					"content": "Я слишком много времени провёл, убивая других, и уже привык нести своё бремя в одиночестве. Вид счастливых людей лишь заставляет меня чувствовать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131109,
					"content": "...Нет, хватит об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131110,
					"content": "До встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131111,
					"content": "Точно не хочешь пойти с нами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "Тебе действительно так нравятся столпотворение и шум?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131113,
					"content": "Угадай.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "Эй! Это настоящий праздник, а не какое-то там «столпотворение»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413131115,
					"content": "Настоящий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131116,
					"content": "Хватит. Идите и смотрите на свои фонари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131117,
					"content": "Но будьте осторожны. Если вам что-то будет угрожать... позовите меня по имени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131118,
					"content": "И ты тут же придёшь в город?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "В любое время. В любое место. Я приду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131120,
					"content": "Я вижу каждый фонарь и слышу все просьбы о помощи. Неважно, от кого они исходят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413131104,
					"content": "(...Ничего. Отсюда тоже всё видно).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
