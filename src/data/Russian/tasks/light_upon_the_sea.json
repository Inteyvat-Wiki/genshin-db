				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "Вы закончили с тем делом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130202,
					"content": "Да, но...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "Вот и хорошо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130204,
					"content": "Ты точно не пойдёшь смотреть на лунный фонарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "Точно. Как я уже сказал, я не люблю находиться среди людей. Особенно в это время года.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130206,
					"content": "В этом году лунный фонарь посвящён Могучему Повелителю Небесных Пределов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "Да-да, это тот большой красивый олень! Пойдём, посмотрим вместе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 413130208,
					"content": "Могучий Повелитель Небесных Пределов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130209,
					"content": "Но это лишь небесный фонарь: предмет, сделанный руками человека. Он ничего для меня не значит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "Сяо"
				},
				{
					"id": 413130210,
					"content": "Если вы хотите присоединиться к шумной толпе, идите в город. Без меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сяо"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
