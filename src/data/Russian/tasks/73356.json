			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "У каждого свой путь. Что тут ещё сказать. Но спасибо тебе за чай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Мастер Шляпка"
				},
				{
					"id": 733560202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 733560204,
					"content": "Хорошо, до встречи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мастер Шляпка"
				},
				{
					"id": 733560203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}