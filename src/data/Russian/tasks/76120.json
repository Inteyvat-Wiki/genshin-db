			"dialogs": [
				{
					"id": 761200301,
					"content": "Хм, хороший выбор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200302
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761200302,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200303
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 761200303,
					"content": "Она кажется довольно воодушевлённой... и сразу начала рисовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761200304,
					"content": "Если подумать, картины Маалаус охватывают всю историю Коломбины с самого её появления на свет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761200305,
					"content": "И эта история продолжается.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "Да! Паймон хочет увидеть больше работ этой великой художницы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761200307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "Маалаус"
				},
				{
					"id": 761200308,
					"content": "О, уже закончила? Как всегда, быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761200309,
					"content": "Дай-ка Паймон посмотреть... Ух ты! Как красиво!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761200310,
					"content": "Паймон и представить не могла, как прекрасен Тейват, если смотреть на него с луны!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761200311,
					"content": "Ха... Теперь я понимаю, почему Маалаус сказала, что я изменилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761200312,
					"content": "Хм? Почему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761200313,
					"content": "Увидев эту картину, я вспомнила...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761200314,
					"content": "Тогда я сидела на луне, глядя на Тейват, и думала, что раньше я всё время искала место, которое могла бы назвать «домом».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761200315,
					"content": "Но теперь у меня внезапно появилось два «дома». И оба такие прекрасные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761200316,
					"content": "Тогда я поняла, что, возможно, «дом» - это место, где находятся дорогие тебе вещи, родные и друзья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761200317,
					"content": "Хорошо сказано.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200318
					]
				},
				{
					"id": 761200318,
					"content": "Спасибо. Думаю, теперь я буду чаще брать куухенки с собой на луну.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200319
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761200319,
					"content": "Вы также всегда можете посетить мой «второй дом», когда захотите.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
