			},
			"dialogs": [
				{
					"id": 200180401,
					"content": "#Фух... Какая удача, что ты оказал{F#а}c{F#ь}{M#я} рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180402,
					"content": "Но теперь я не уверен, что повозку получится починить...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180403,
					"content": "Она разваливается на части... Я постараюсь починить, что смогу, но долго она не продержится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180404,
					"content": "Ладно. Главное, чтобы до города дотянула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180405,
					"content": "Где-то тут была верёвка... Должно быть, они её утащили.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180406,
					"content": "#Путешественни{F#ца}{M#к}... Помоги мне найти <color=#00E1FFFF>верёвку</color>, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Испуганный Магар"
				}
			]
