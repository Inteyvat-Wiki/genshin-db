			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Испуганный Магар"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "#Спасибо, путешественн{F#ица}{M#ик}! Без твоей помощи я бы не справился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180102,
					"content": "Если я даже с обычной доставкой не могу справиться, то на что я вообще тогда гожусь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180103,
					"content": "Меня точно уволят с винокурни... Господин Коннор меня сразу невзлюбил. Уверен, господин Эльзер уже пишет заявление на моё увольнение... Всё пропало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180104,
					"content": "Успокойся, всё не так плохо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "Эх, в любом случае нужно доставить эту повозку в пункт назначения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180106,
					"content": "#А ей нехило досталось... Путешественни{F#ца}{M#к}, мне нужна твоя помощь! Одной <color=#00E1FFFF>крепкой доски</color> будет достаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Испуганный Магар"
				}
			]
		},
		{
			"id": 2001802,
