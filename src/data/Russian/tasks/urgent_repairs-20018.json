			},
			"dialogs": [
				{
					"id": 200180301,
					"content": "Должно сработать. Думаю, у меня получится починить телегу... Но это неточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180302
					],
					"speakerTitle": "Испуганный Магар"
				},
				{
					"id": 200180302,
					"content": "#Это снова они! Путешественни{F#ца}{M#к}, на помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Испуганный Магар"
				}
			]
		},
