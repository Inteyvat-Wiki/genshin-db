			"dialogs": [
				{
					"id": 413430601,
					"content": "Сестрёнка, когда мы уже вернёмся в Мондштадт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430602
					],
					"speakerTitle": "Гери"
				},
				{
					"id": 413430602,
					"content": "Хм... Мы приехали совсем недавно, давай ещё немного здесь побудем...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фреки"
				}
			]
		},
		{
			"id": 4134307,
			"completionStepIds": [
				4134307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134307",
