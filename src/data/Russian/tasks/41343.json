				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "Но как плести эти небесные фонари? У тебя есть идеи, Фреки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "Гери"
				},
				{
					"id": 413430102,
					"content": "Я без понятия... Может, попросим кого-нибудь нам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430103,
					"content": "Вы тоже хотите запустить небесный фонарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "#О, привет, путешественни{F#ца}{M#к}. Да, нам это было бы очень интересно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430105,
					"content": "Мы сначала собирались попробовать праздничные закуски, но Гери сказал, что хотел бы запустить небесный фонарь и ощутить атмосферу праздника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430106,
					"content": "Д-да! Сначала нужно проникнуться праздником, а потом уже и праздничные закуски пробовать, иначе опыт будет неполным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "Гери"
				},
				{
					"id": 413430107,
					"content": "Ещё я слышала, что перед тем, как запускать небесный фонарь, нужно загадать желание... Но мы его даже сплести не можем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430108,
					"content": "#Путешественни{F#ца}{M#к}, ты сможешь сплести для нас небесный фонарь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430109,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "Вот спасибо! Мы подождём тебя здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фреки"
				}
			]
		},
