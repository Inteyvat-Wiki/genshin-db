					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Фреки"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430701,
					"content": "#Здравствуй, путешественни{F#ца}{M#к}. Ты уже развеял{F#а} семена одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430702,
					"content": "#Да, я всё сделал{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "Отлично! Надеюсь, ветер унесёт их обратно в Мондштадт...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430704,
					"content": "Вот ты сказала как-то, что нужно проникнуться местной культурой, а сама позабыть о старых мондштадтских привычках не можешь. Почему бы нам сегодня не съесть чего-нибудь мондштадтского?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "Гери"
				},
				{
					"id": 413430709,
					"content": "Нет уж. Не-а.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430710,
					"content": "А? ...Чего?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "Гери"
				},
				{
					"id": 413430705,
					"content": "Старые привычки - это одно, а культура Ли Юэ - это другое. Пойдём запускать небесный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430706,
					"content": "Ты своё желание уже написал? Когда фонарь улетит в небо, давай пройдёмся по особым праздничным закускам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430707,
					"content": "Н-написал, но нам обязательно после этого снова есть местную еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "Гери"
				},
				{
					"id": 413430708,
					"content": "Ха-ха, а как же! Праздник морских фонарей только раз в году, и мы его лакомства упустить ни за что не можем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фреки"
				}
			]
		}
	]
}