				"points": []
			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "Спасибо. Теперь нам нужно написать желание, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430302,
					"content": "Хм... Дай подумать, что бы такое написать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430303,
					"content": "Пусть будет это... К слову, небесные фонари уносят желания в небеса...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430304,
					"content": "В Мондштадте мы сначала рассказывали одуванчикам свои заветные желания, а потом развеивали их семена по ветру...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430305,
					"content": "Раз уж речь зашла о доме, я так скучаю по родному Мондштадту. Давненько мы не видели одуванчиков...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "Гери"
				},
				{
					"id": 413430306,
					"content": "#Путешественни{F#ца}{M#к}, не мог{F#ла} бы ты принести нам немного семян одуванчика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "Фреки"
				},
				{
					"id": 413430307,
					"content": "Я этим займусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "Спасибо тебе за помощь! Когда найдёшь их, сразу же возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фреки"
				}
			]
		},
