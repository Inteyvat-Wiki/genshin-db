			"dialogs": [
				{
					"id": 732172001,
					"content": "Берегитесь морских чудовищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172002
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732172002,
					"content": "В последнее время в акватории всё чаще встречаются морские чудовища. Команды судов, выходящих из порта, должны внимательно следить за предупреждениями Фаросского маяка или заранее получать информацию о состоянии акватории из объявлений махаматы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172003
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732172003,
					"content": "Если у вас возникнут вопросы, обратитесь к смотрителю маяка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		}
