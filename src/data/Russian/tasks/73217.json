			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170701,
					"content": "Берегитесь морских чудовищ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732170702,
					"content": "В последнее время активизировались морские обитатели. Покидающие порт суда должны внимательно следить за предупреждениями Фаросского маяка или обязаны заранее запросить информацию о состоянии акватории через Акашу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732170703,
					"content": "Если у вас возникнут вопросы, пожалуйста, обратитесь к смотрителю маяка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
		{
