			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "«Наше отделение открыло маршрут в Терновый порт. В связи с этим событием мы приглашаем всех желающих присоединиться к нам для торговли фруктами».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732171802,
					"content": "«Постой! Доставлять фрукты из Мондштадта? Вот если бы была доставка алкоголя, то это было бы поинтересней».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732171803,
					"content": "«Все везут алкоголь из Мондштадта, и только я привожу оттуда фрукты. Вот так ведутся дела, понимаешь?!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732171804,
					"content": "«К тому же необязательно везти прямо из самого Мондштадта...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
