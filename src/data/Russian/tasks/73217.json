			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171901,
					"content": "«Мы снова открыли торговые маршруты на остров Рито. В связи с этим событием мы приглашаем всех желающих присоединиться к нам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171902
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732171902,
					"content": "«Торговля дикими грибами между Сумеру и Инадзумой, осуществляемая нашей ассоциацией, была одобрена портовым управляющим. Если вы занимаетесь грибами, то ждём вас у нас в офисе для обсуждения условий сотрудничества».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171903
					],
					"speakerTitle": "Доска объявлений"
				},
				{
					"id": 732171903,
					"content": "«При возникновении вопросов, касающихся поездки в Инадзуму, вы также можете обратиться к нам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Доска объявлений"
				}
			]
		},
