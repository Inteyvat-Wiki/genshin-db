					"Грейс"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Ох, Нора...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580902,
					"content": "Ты её опекун?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "Да. Мать... не может сейчас заботиться о ней. Сейчас я присматриваю за Норой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580904,
					"content": "Также я присматриваю ещё за несколькими детьми. Это входит в обязанности сестры.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580905,
					"content": "Внезапно у меня появилась новая семья, состоящая из детей. Они хорошие ребятишки, и неплохо ладят с Глорией.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580906,
					"content": "Дольше всего я приглядываю за Тимми. Он уже начал называть меня мамой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580907,
					"content": "Расскажи мне об отце Норы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Её отец - Паттон. Его пьянство привело к серьёзным проблемам в семье.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580909,
					"content": "Церковь и Ордо Фавониус не раз пытались вразумить его. Но Паттон смог измениться. В конец концов, господин Дилюк решил вмешаться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580910,
					"content": "Сестра Виктория взяла Нору под свою опеку. У Паттона есть время подумать над своим поведением.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580911,
					"content": "Но когда Нора вырастет, мы не сможем больше её удерживать. Она начнёт сомневаться, что папа постоянно занят на работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580912,
					"content": "Тогда даже одуванчики Анемо Архонта не смогут нам помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				}
			]
		},
