					"Нора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "Как же быть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "Видишь эту статую? Посмотри туда, повыше... Там, где руки Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580104,
					"content": "Я хочу туда залезть... Но Грейс не разрешает мне карабкаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580105,
					"content": "Можешь ненадолго отвлечь Грейс? Я быстренько заберусь туда и сразу спущусь обратно. Очень быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580106,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "Ура! Спасибо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580110,
					"content": "Отвлеки тётю Грейс на минутку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580111,
					"content": "Нора! Нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580112,
					"content": "Ах! Стоило на секунду отвлечься, а она уже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580113,
					"content": "Но почему? Я просто хочу поиграть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580114,
					"content": "Нет значит нет! Твой отец этого не одобрил бы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580115,
					"content": "#Пожалуйста, не надо потакать её капризам. Если бы ты был{F#а} в такой же опасности, другие бы переживали за тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Грейс"
				},
				{
					"id": 200580108,
					"content": "Это очень опасно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "Не переживай. Я знаю, что делаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Нора"
				}
			]
		},
		{
			"id": 2005802,
			"completionStepIds": [
				2005802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
