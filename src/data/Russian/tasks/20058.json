			"dialogs": [
				{
					"id": 200581101,
					"content": "Ого! Когда я вырасту, я тоже так смогу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581102,
						200581104
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200581102,
					"content": "Конечно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200581103
					]
				},
				{
					"id": 200581103,
					"content": "Ура! Я буду расти изо всех сил! Когда папа закончит работу, он сможет со мной поиграть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581106
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200581106,
					"content": "Наверное, это что-то для взрослых.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581107
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200581107,
					"content": "Спасибо! Вот тебе подарочек! Я собирала эти сокровища в тайне от других.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581108
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200581108,
					"content": "Скорей, возьми это! Только не рассказывай тёте Грейс...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нора"
				},
				{
					"id": 200581104,
					"content": "Только после того, как получишь лётную лицензию.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200581105
					]
				},
				{
					"id": 200581105,
					"content": "Лётная лицензия? Что это такое? Звучит сложновато...",
					"roleType": "TALK_ROLE_NPC",
