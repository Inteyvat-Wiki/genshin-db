				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "*хнык*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580202,
					"content": "Что ты забыла там наверху?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "Тётя Грейс говорит, что если хочешь поделиться секретом, то нужно рассказать его семенам одуванчика и развеять их по ветру... Анемо Архонт принесёт секрет нужному человеку вместе с семенами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580204,
					"content": "Чем выше ты подкинешь семена, тем быстрее секрет достигнет цели.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580205,
					"content": "#Однажды Глория попросила путешественни{F#цу}{M#ка} залезть на статую и развеять семена одуванчика. Через несколько дней Годвин написал Глории письмо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580206,
					"content": "Я хочу рассказать папе секрет. Одуванчик я уже подготовила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580207,
					"content": "Но тётя Грейс не разрешит мне это сделать. Она говорит, что я смогу жить с папой, только когда вырасту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580208,
					"content": "Я хочу вырасти поскорее... Стараюсь изо всех сил, но я всё ещё слишком маленькая.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580209,
					"content": "Эм... Я часто вижу, как ты паришь над городом. Научишь меня?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580210,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Ха-ха! Ура! Я буду просто стоять и смотреть. Надеюсь, хотя бы это мне можно делать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нора"
				},
				{
					"id": 200580212,
					"content": "Хочешь полетать со мной?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "Нет! Тётя Грейс ужасно разозлится, если увидит меня в небе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Нора"
				}
			]
		},
