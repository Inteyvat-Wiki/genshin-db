			"dialogs": [
				{
					"id": 766562001,
					"content": "#{NICKNAME}, Паймон, привет! Благодаря вам удалось наладить роботов, которых мы отыскали в прошлый раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562002
					],
					"speakerTitle": "Жинетт"
				},
				{
					"id": 766562002,
					"content": "Они же все здесь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766562003,
					"content": "Новых неисправностей пока нет, но у меня возникла одна идея...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562004
					],
					"speakerTitle": "Жинетт"
				},
				{
					"id": 766562004,
					"content": "#{NICKNAME}, когда отправитесь за другими роботами, присмотритесь к ним получше, вдруг заметите что-то странное в их поведении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "Жинетт"
				},
				{
					"id": 766562005,
					"content": "Паймон хотелось бы знать, на что конкретно обращать внимание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562006
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 766562006,
					"content": "Возможно... на их взаимодействие между собой? Когда у нас будет достаточно роботов, думаю, всё станет более очевидно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562007
					],
					"speakerTitle": "Жинетт"
				},
				{
					"id": 766562007,
					"content": "Гм... Берёмся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562008
					],
					"speakerTitle": "Паймон"
				},
				{
