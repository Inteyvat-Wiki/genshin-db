			"dialogs": [
				{
					"id": 150240101,
					"content": "Ох! За статуей кто-то прячется!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240102,
					"content": "Это маленький иктомизаврик! Какой милый... Но почему он на нас так смотрит?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240103,
					"content": "#{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240104,
					"content": "(Что это за место?..)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240105
					]
				},
				{
					"id": 150240105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240106
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150240106,
					"content": "(Ты...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240107
					]
				},
				{
					"id": 150240107,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150240108,
					"content": "Ох... Сколько времени прошло?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240109,
					"content": "Паймон встретилась глазами с иктомизавриком и перенеслась в какое-то странное место. И видела там огромного иктомизавра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240110,
					"content": "Да, и я тоже...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "Что это было?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240112,
					"content": "#{NICKNAME}? Эй, что такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240113,
					"content": "Он там...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "Смотри! Иктомизаврик хочет, чтобы мы пошли за ним! Настоящие искатели приключений обязаны выяснить, что происходит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240116,
					"content": "Тогда идём!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "Он зовёт нас...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				}
			]
		},
