				{
					"id": 150240802,
					"content": "Но как отсюда выйти?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240803
					]
				},
				{
					"id": 150240803,
					"content": "Хм... Комната выглядит закрытой наглухо. Здесь нет ничего похожего на выход.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240804
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240804,
					"content": "Давай осмотримся! Вдруг заметим какие-нибудь подсказки!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
