			"dialogs": [
				{
					"id": 150240901,
					"content": "Сколько здесь свитков... Некоторые из них Паймон видела раньше в других племенах. Кажется, на них записывают историю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240902,
					"content": "А этот отличается от остальных. Он намного больше. Интересно, какая история в нём записана?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240903
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240903,
					"content": "И цвета очень необычные...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240904
					]
				},
				{
					"id": 150240904,
					"content": "#Да, ты прав{F#а}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240905
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240905,
					"content": "#Смотри, там что-то вспыхнуло! {NICKNAME}, ты видел{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240906,
					"content": "Наверное, мы сможем выбраться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240907
					]
				},
				{
					"id": 150240907,
					"content": "...увидев то, чего не видели раньше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240908
					]
				},
				{
					"id": 150240908,
					"content": "Да, Паймон поняла!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
