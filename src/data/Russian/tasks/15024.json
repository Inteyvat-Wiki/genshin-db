					{
						"sceneId": 3,
						"position": [
							-1644.502,
							15.092,
							9709.844
						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "Ого, что это было?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240502,
					"content": "Обычная работа жреца. Мы пытаемся установить связь с душами предков, чтобы получить откровения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240503,
					"content": "Вождь сейчас там. Подождите немного, мне надо сказать ему пару слов. Я быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240504,
					"content": "Мда... Загадочные ребята эти Повелители Ночного Ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240505,
					"content": "Я рассказал вождю, зачем вы пришли. Можете идти к нему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240506,
					"content": "Значит, вы новые избранные? Меня зовут Бирам, я вождь Повелителей Ночного Ветра. Добро пожаловать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240507,
					"content": "Какой высокий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240508,
					"content": "Да, комплекцией я всегда отличался от обычных людей. Надеюсь, я вас не испугал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240509,
					"content": "Ой, нет, что ты! Паймон лишь удивилась немного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240510,
					"content": "Что значит «избранные»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "Кахолом сказал мне, что вы чужеземцы. Должно быть, вы не слышали о наших порядках и ничего не знаете о повелении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240512,
					"content": "За всю историю нашего племени избранными становились только члены Повелителей Ночного Ветра. А теперь впервые повеление коснулось чужеземцев.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240513,
					"content": "Да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240514,
					"content": "Позвольте я всё объясню. У Повелителей Ночного Ветра есть давняя традиция - записывать историю Натлана на тканых свитках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240515,
					"content": "Мы пишем не только историю нашего племени, свитки хранят легенды и героические предания других племён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240516,
					"content": "Мы много веков блюдём эту традицию. Плести свитки - наш священный долг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240517,
					"content": "Но если нужно записать событие, которое оказало влияние на всю историю Натлана, свиток будет не простой, а особенный.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240518,
					"content": "Такой свиток может сплести лишь тот, кто избран старейшиной иктомизавров.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240519,
					"content": "Заметив серьёзные изменения в артериях земли, старейшина иктомизавров объявляет повеление, в котором выбирает создателя нового свитка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240520,
					"content": "Ой, то есть...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240521,
					"content": "Старейшина Тлапо давно заметил перемены в артериях земли. Но только после вашего появления в племени он смог выбрать создателя нового свитка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240522,
					"content": "#Вот оно что... Но мы с {F#путешественницей}{M#путешественником} понятия не имеем, как плести эти свитки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240523,
					"content": "И я нисколько не удивлён.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240524,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240525,
					"content": "За два столетия, что старейшина Тлапо занимает свой пост, все избранные оказывались полнейшими новичками в плетении свитков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240526,
					"content": "Так значит, все события за последние двести лет остались без записи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240527,
					"content": "Нет, всё своевременно попало в свитки. Но каждый избранный уверял, что сплетённый свиток вовсе не его работа, а «дар духов».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240528,
					"content": "Гм... Всё загадочнее и загадочнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240529,
					"content": "Да... Меня этот момент тоже беспокоит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240530,
					"content": "Мысль о том, что в записи важнейших событий нам приходится полагаться на мистику вроде «дара духов», не может не вызывать беспокойства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240531,
					"content": "Ого. Немного неожиданно слышать такое от вождя Повелителей Ночного Ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240532,
					"content": "Понимаю. Наверное, вы думаете, что жизнь Повелителей Ночного Ветра овеяна тайной, что мы гордимся своими мистическими практиками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240533,
					"content": "Но я скорее исключение. Хоть я и вождь Повелителей Ночного Ветра, но я решил внести изменения в наши традиции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240534,
					"content": "Я занимаюсь расшифровкой всевозможных тайн нашего племени. Так я смогу установить более чёткие правила, которые помогут поддерживать наши традиции в будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240535,
					"content": "Ого, круто! И как, тебе удалось раскрыть тайну «дара духов»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240536,
					"content": "Увы, нет... Я долго бился над этой загадкой, но пока так и не понял, что это за дар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240537,
					"content": "В особых свитках записано лишь несколько событий, отделённых друг от друга десятилетиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240538,
					"content": "И когда старейшина объявит следующее повеление, на моём месте будет уже другой вождь. Я не смогу провести расследование.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240539,
					"content": "Значит...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240540,
					"content": "Всю правду я пока не узнал, но кое-что мне удалось выяснить. Но я смогу подтвердить свои догадки, только если избранный согласится мне помочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240541,
					"content": "Поэтому ты и решил назначить нам испытание...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "Именно. Беспокоиться вам не о чем. Я всего лишь хочу проверить свою версию. Это совсем не опасно и времени много не займёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240543,
					"content": "Хорошо. В чём конкретно заключается испытание?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "Я всё подробно объясню на месте. Подождите немного, я должен снять Одеяние Защиты Души.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240545,
					"content": "Одеяние - священная реликвия, что поколениями передаётся от вождя к вождю. Мы облачаемся в него для проведения особых церемоний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240546,
					"content": "Ого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240547,
					"content": "Бирам снимает одеяние и осторожно передаёт его жрецу.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "Теперь идите за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240549,
					"content": "Видите этот свиток? Прикоснувшись к нему, вы попадёте в секретное пространство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240550,
					"content": "Вам нужно будет придумать, как оттуда выбраться. В этом и заключается испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240551,
					"content": "И всё?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240552,
					"content": "Уверяю, это не так просто, как может показаться. Разумеется, если вы не сможете найти выход, я помогу вам вернуться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240553,
					"content": "Но тогда повеление старейшины так и останется загадкой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "Бирам"
				},
				{
					"id": 150240554,
					"content": "Мы попробуем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "Хорошо. Чтобы начать испытание, дотроньтесь до свитка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Бирам"
				}
			]
		},
		{
			"id": 1502406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
