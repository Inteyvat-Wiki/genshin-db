			"dialogs": [
				{
					"id": 150240301,
					"content": "Эм, привет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150240303,
					"content": "Наверное, он нас не понимает. Застыл истуканом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240304,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150240305,
					"content": "Прости! Паймон не хотела тебя обидеть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240306,
					"content": "Эй, вы! Как вы смеете грубить нашему старейшине?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "Тлапо"
				},
				{
					"id": 150240308,
					"content": "То есть... Ясно, ясно. Простите за дерзость. Званым гостям я должен был оказать тёплый приём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240309,
					"content": "Позвольте представиться. Меня зовут Кахолом, я один из жрецов нашего племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240310,
					"content": "А это Великий Тлапопоктицтетль, старейшина иктомизавров, живой тотем Повелителей Ночного Ветра.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240311,
					"content": "Ну и имечко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240312,
					"content": "Честно говоря, для краткости мы обычно называем его старейшиной Тлапо. Можете последовать нашему примеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240313,
					"content": "Приглашение выглядело очень необычно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "Наверное, ты имеешь в виду особую способность нашего старейшины.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240315,
					"content": "Старейшина Тлапо живёт на свете несколько столетий, и даже жрецы племени не знают всех его секретов. Ваше недоумение вполне естественно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240316,
					"content": "Но я точно могу сказать, что старейшина Тлапо вызвал вас сюда, чтобы дать весьма важное поручение. Но сначала вы должны пройти испытание.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240317,
					"content": "Что ещё за поручение? И что за испытание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240318,
					"content": "Если вы не возражаете, я отведу вас к вождю. Он лучше меня ответит на все ваши вопросы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240319,
					"content": "Эм... Ну ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 150240320,
					"content": "Если вы готовы, следуйте за мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240401,
					"content": "С этим свитком вы окажетесь сразу у обсидианового алтаря, где вас встретит вождь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "Кахолом"
				},
				{
					"id": 150240402,
					"content": "Не беспокойтесь, это одна из многих мистических способностей нашего племени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кахолом"
				}
			]
		},
