			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сунь Юй"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "Спасибо. Теперь мы сможем сделать небесный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370402,
					"content": "Готово, Цю Эр. Желания лучше напиши ты, твой почерк всегда был хорош...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370403,
					"content": "Конечно, я напишу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 413370404,
					"content": "Сестра... Ты чем-то расстроена? Что случилось?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370405,
					"content": "Нет, я в порядке. На самом деле я рада помочь тебе запустить небесный фонарик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 413370406,
					"content": "Кхм-кхм! Где вы собираетесь запускать этот небесный фонарь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "Да, верно, верно. Пора запускать фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370409,
					"content": "Тогда, братик, иди без меня. Лазанье по горам так выматывает, а у меня совсем не осталось сил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 413370410,
					"content": "Но... Мы ведь только что отдыхали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370411,
					"content": "У меня болит голова. Может быть, на горе продуло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "Цю Эр"
				},
				{
					"id": 413370412,
					"content": "Но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370413,
					"content": "...Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "Ну... Я был бы очень признателен. Я собирался запустить его в одном особенном месте...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370416,
					"content": "Когда школа Гухуа ещё... существовала, учитель на каждый Праздник морских фонарей вёл нас туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370417,
					"content": "К сожалению, школа пришла в упадок, и уже давно никто там фонарей не запускал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370418,
					"content": "#Раз уж ты вызвал{M#ся}{F#ась} помочь, прошу тебя сходить туда и запустить за меня небесный фонарь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370419,
					"content": "Я отмечу это место на твоей карте. А мне тем временем нужно позаботиться о сестре...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сунь Юй"
				},
				{
					"id": 413370414,
					"content": "Я запущу фонарь за вас!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "Кхм-кхм! Вам пора идти запускать небесный фонарь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
