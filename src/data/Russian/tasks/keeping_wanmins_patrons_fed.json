			"trigger": {
				"objectNames": [
					"Шеф-повар Мао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "Так, сколько блюд там было...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320202,
					"content": "Чем занимаешься?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "Ха-ха, чем я занимаюсь? Делами ресторана, конечно же.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320204,
					"content": "С наступлением Праздника морских фонарей у нас особенно много посетителей, а к ним ещё добавились путешественники из дальних стран.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320205,
					"content": "Хоть моя дорогая Сян Лин и вернулась, чтобы помочь, мы за работой света белого не видим. К слову, она только что отправилась доставить еду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320206,
					"content": "В то время как остальные развешивают праздничные фонари, мы ещё ни одного даже не сделали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320207,
					"content": "#Путешественни{F#ца}{M#к}, выручишь нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320208,
					"content": "Ты знаешь Ацуко? Это девушка из Инадзумы. Сейчас она на пристани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320209,
					"content": "Мы приготовили её заказ, даже сделали особенно большие порции в честь праздника. Пожалуйста, помоги его доставить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320210,
					"content": "А ещё портовые рабочие, <color=#00E1FFFF>Здоровяк Ван, Молот Ли, Гуань Хай и Чжи Хуа</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320211,
					"content": "Они наши постоянные клиенты. Уже наступил праздник, но они, кажется, всё ещё заняты работой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320212,
					"content": "Я хотел бы им всем чего-нибудь приготовить, но не могу отлучиться даже на минутку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320213,
					"content": "#Путешественни{F#ца}{M#к}, спросишь у них, чего они хотели бы отведать, а я бы тут быстренько состряпал.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413320214,
					"content": "Предоставь это мне.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "Спасибо тебе большое. Как расспросишь их - возвращайся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шеф-повар Мао"
				}
			]
		},
