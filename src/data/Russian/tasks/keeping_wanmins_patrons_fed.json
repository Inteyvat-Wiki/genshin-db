			"dialogs": [
				{
					"id": 413320301,
					"content": "Где же мой заказ из «Народного выбора»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Ацуко"
				},
				{
					"id": 413320302,
					"content": "Вот твой заказ. Приятного!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "О, спасибо! Я уж начала бояться, что он придёт куда позже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Ацуко"
				},
				{
					"id": 413320304,
					"content": "Праздник морских фонарей навевает тоску по дому... Но в Инадзуму я вернусь ещё нескоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Ацуко"
				},
				{
					"id": 413320305,
					"content": "Интересно, как сейчас там дела?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ацуко"
				}
			]
		},
