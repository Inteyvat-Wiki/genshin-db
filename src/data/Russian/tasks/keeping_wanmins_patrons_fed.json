					"nextDialogs": [
						413320518
					],
					"speakerTitle": "Молот Ли"
				},
				{
					"id": 413320518,
					"content": "Мне подойдёт всё, что <color=#00E1FFFF>с мясом</color>. В высокой кухне я не силён... Может, порекомендуешь чего?",
					"roleType": "TALK_ROLE_NPC",
