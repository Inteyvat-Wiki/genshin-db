			"dialogs": [
				{
					"id": 413320321,
					"content": "Где же мой заказ из «Народного выбора»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320322
					],
					"speakerTitle": "Ацуко"
				},
				{
					"id": 413320322,
					"content": "Вот твой заказ. Приятного!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320323
					]
				},
				{
					"id": 413320323,
					"content": "#Наконец-то, я уже заждалась... Но я всё равно благодарна за то, что в праздничную пору ты наш{F#ла}{M#ёл} время для доставки еды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320324
					],
					"speakerTitle": "Ацуко"
				},
				{
					"id": 413320324,
					"content": "Праздник морских фонарей навевает тоску по дому... Но в Инадзуму я вернусь ещё нескоро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320325
					],
					"speakerTitle": "Ацуко"
				},
				{
					"id": 413320325,
