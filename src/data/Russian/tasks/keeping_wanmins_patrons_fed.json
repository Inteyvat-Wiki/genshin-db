					"Шеф-повар Мао"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "#Ты уже доставил{F#а} еду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321402,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Отлично. Я знал, что на тебя можно положиться. А Здоровяк Ван, Гуань Хай и Чжи Хуа сказали тебе, чего желают отведать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321404,
					"content": "Здоровяк Ван и Молот Ли хотели бы свиного супа с бамбуком.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "У этих двоих схожие вкусы. Но на свиной суп с бамбуком уйдёт немало времени, так что придётся начать его готовить пораньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321407,
					"content": "Гуань Хаю захотелось рыбы-белки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "Запросто. Это моё фирменное блюдо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321409,
					"content": "А Чжи Хуа попросил печенье лотоса.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "Никогда бы не подумал, что Чжи Хуа такой лакомка. Но печенье лотоса сделать просто, это я мигом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321411,
					"content": "#Спасибо, что ты обош{M#ёл}{F#ла} всех и расспросил{F#а}. Этот скромный подарок тебе. А мне нужно приступать к готовке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321412,
					"content": "Ты не собираешься развешивать небесные фонари?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
					"content": "Ах, было бы время... Мне нужно готовить, а Сян Лин снова занята доставкой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321414
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321414,
					"content": "Мы и так едва поспеваем за заказами, куда уж там...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321415,
						413321416
					],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321415,
					"content": "Я обо всём позабочусь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321417
					]
				},
				{
					"id": 413321417,
					"content": "П-правда? Спасибо большое... А то я уже начал беспокоиться, что непраздничный вид ресторана приводит всех в уныние.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Шеф-повар Мао"
				},
				{
					"id": 413321416,
					"content": "Я сплету вам небесный фонарь.",
					"roleType": "TALK_ROLE_PLAYER",
