							"2"
						],
						"stepId": 1915302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лайла"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "Все поделились с нами ценными сведениями. Давай пройдёмся по ним и постараемся их систематизировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530802,
					"content": "Кое-что из услышанного было довольно простым, а что-то просто смешным...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530803,
					"content": "Мы должны выяснить больше о личности и расположении феи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "Дай-ка я подумаю и посмотрю, что можно сделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530805,
					"content": "(Так, Лайла, успокойся. Я знаю, информации много и она запутанная, но ты справишься.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530806,
					"content": "(Сначала попробуем установить личность феи, основываясь на имеющихся у нас подсказках.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530807,
					"content": "(Затем проанализируем, где её видели и какими мотивами она руководствуется... Наконец, соберём всё воедино...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530808,
					"content": "(Так мы сможем предсказать её действия. Ладно, попробуем.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лайла"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Лайла"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "Так, думаю, я поняла...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530902,
					"content": "Итак, к каким выводам ты пришла?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "Во-первых, судя по тому, что рассказала Катаюн, можно предположить, что фея учится в Ртавахисте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530904,
					"content": "Мы можем исключить всех, кто не входит в даршан, потому что к книгам нельзя получить доступ, минуя библиотекаря.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530905,
					"content": "Далее, если даже скептически отнестись к сообщениям о её невероятных способностях, все места, где её видели, официально рекомендованы Академией для астрологических наблюдений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530906,
					"content": "Другими словами, вероятно, она просто проводит исследования. И характер её исследований схож с тем, что делаю я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530907,
					"content": "Я задала сложный вопрос, но она смогла дать ответ всего за день. Значит, она знакома с этой областью знаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530908,
					"content": "По этой логике, нам остаётся ждать фею в следующем месте для астрологических наблюдений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530909,
					"content": "Очень убедительное рассуждение.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "А, ну... Ничего особенного. На самом деле я приняла в расчёт ещё несколько факторов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530912,
					"content": "Но сейчас это неважно. Давай продолжим. Хоть у нас есть зацепка, не факт, что нас ждут открытия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530913,
					"content": "Я расскажу тебе, что я имею в виду, если фея не появится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Лайла"
				},
				{
					"id": 191530910,
					"content": "Тебе явно под силу самостоятельно дописать работу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}