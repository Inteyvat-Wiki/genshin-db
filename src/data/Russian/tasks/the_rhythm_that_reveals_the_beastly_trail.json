			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арама"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730741901,
					"content": "Третий фрукт васома у нас в руках! По словам Араджи, трёх фруктов будет достаточно, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741902
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741902,
					"content": "#Думаю, да. Спасибо вам, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741903,
						730741905
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741903,
					"content": "Не за что.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741904
					]
				},
				{
					"id": 730741904,
					"content": "Это ты помогал нам, Арама. Зачем же благодаришь нас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741906
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741906,
					"content": "Ну... Вы помогаете Аране, а Арана - мой друг. Так что, спасибо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741907
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741907,
					"content": "#К тому же нара {NICKNAME} помог{F#ла} Араясе, Арадасе и Арасудраке найти древние песни. Они мои друзья, поэтому я благодарю вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741908
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741908,
					"content": "#И последнее, я очень рад, что нара {NICKNAME} и Паймон со мной. Я благодарен вам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741909
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741909,
					"content": "Паймон тоже очень рада! Спасибо, Арама!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741910
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741910,
					"content": "Зал Ашваттхи похож на древние руины. Здесь есть какая-нибудь предыстория?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741911
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741911,
					"content": "Это древняя-древняя легенда. В те времена я даже семечком ещё не был. Давным-давно нары могли видеть аранар, а аранары не боялись нар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741912
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741912,
					"content": "#Тогда нары помогали аранарам, а аранары - нарам. Мы вместе гуляли так же, как сейчас я и нара {NICKNAME}, а ещё вместе пели песни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741913
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741913,
					"content": "Как и Араяса, они коллекционировали песни. Ведь вначале аранары учились у нар.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741914
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741914,
					"content": "Раньше нары и аранары вместе проводили время в Зале Ашваттхи. Но эта история случилась много, много лет тому назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741915
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741915,
					"content": "После страшного бедствия Ванарана была разрушена, а Зал Ашваттхи опустел...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741916
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741916,
					"content": "Вот оно как...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741917
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741917,
					"content": "Ага. Это очень печальная история. К счастью, это всего лишь история, а не мои воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741918
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741918,
					"content": "#Не переживай так! Ведь теперь всё будет хорошо, да, {NICKNAME}?",
