					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741923,
					"content": "Удачи тебе, Арама! Паймон с нетерпением ждёт праздника!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741924
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741924,
					"content": "Я тоже очень жду! Тогда увидимся!",
