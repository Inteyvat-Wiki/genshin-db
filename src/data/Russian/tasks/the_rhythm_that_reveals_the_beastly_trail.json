			"dialogs": [
				{
					"id": 730740101,
					"content": "#Привет, нара {NICKNAME} и Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740102
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730740102,
					"content": "Вот мы и встретились снова, Арама! А кто этот аранара?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730740103,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740104
					],
					"speakerTitle": "Арадаса"
				},
				{
					"id": 730740104,
					"content": "Ага! Арадаса собирает различные песни. Он не любит беседы, потому что верит, что песни лучше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740105
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730740105,
					"content": "Хм, не совсем понятно, да и ладно. А это и есть Зал Ашваттхи?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730740106,
					"content": "Здесь нет деревьев, но зато растёт много роз... прямо в воздухе?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730740107,
					"content": "Нет, но это тоже великое открытие. Здесь собраны песни, которые мы, аранары, не могли найти в течение многих, многих лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740108
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730740108,
					"content": "Собиратели песен аранар всегда ищут красивые песни. А в конце они оставляют свою собственную песню.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740109,
						730740111
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730740109,
					"content": "А это имеет отношение к Залу Ашваттхи?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740110
					]
				},
				{
					"id": 730740110,
					"content": "Ага! Здесь находится песня, оставленная Араямой. А значит, поблизости должна расти васара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740113
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730740113,
					"content": "Кажется, Араджа говорил о васаре. Но всё равно нужно проверить Араньяку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730740114,
					"content": "#Васара! Это же именно на нём растут фрукты васома! Давай мы поможем, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730740115,
					"content": "Спасибо вам! Среди этих роз спрятана песня. Однако мы вместе с Араясой долго искали её, но так и не нашли. Эти розы даже не разговаривали с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740116
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730740116,
					"content": "#Ах вот как... {NICKNAME}, а давай мы тоже поищем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740117,
						730740118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730740117,
					"content": "Если это поможет Ране...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740119,
					"content": "Мы эксперты поиска!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730740118,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740111,
					"content": "Успехов вам.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740112
					]
				},
				{
					"id": 730740112,
					"content": "#Спасибо, нара {NICKNAME}. Это песня, оставленная Араямой. А значит, поблизости должна расти васара. Как нам повезло!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740113
					],
					"speakerTitle": "Арама"
				}
			]
		},
