					"Арама"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730741601,
					"content": "Подождите, мне нужно подготовиться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741602
					]
				},
				{
					"id": 730741602,
					"content": "Хорошо, я подожду тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Арама"
				}
			]
		},
		{
			"id": 7307417,
			"completionStepIds": [
				7307414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307414",
							"2"
						],
						"stepId": 7307414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Паймон",
					"Арама"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730741701,
					"content": "Это же...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741702
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741702,
					"content": "Ага, это и есть фрукт васома.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741703
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741703,
					"content": "Фрукты васома наполнены снами и воспоминаниями васары. Это ценные плоды, способные восстанавливать наши силы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741704
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741704,
					"content": "Чтобы вырастить биджу, Древу Ашваттха нужно много сил. Поэтому мы дадим ему фрукты васома для поддержания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741705
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741705,
					"content": "#Нара {NICKNAME}, береги фрукты васома!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741706
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741706,
					"content": "Раз так, то мы объясним Араме, что такое сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741707
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741707,
					"content": "Сокровища - это какие-то ценные вещи. Вот смотри, во фруктах васома хранится множество снов и воспоминаний. К тому же они способны восстанавливать силы аранар. Значит, эти фрукты очень редкие и обладают невероятными свойствами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741708
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741708,
					"content": "Вот такие важные и редкие вещи, как фрукты васома, и есть сокровища!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741709
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741709,
					"content": "Ах, вот что значит сокровища! Всё понятно! Спасибо, Паймон!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741710,
						730741712
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741710,
					"content": "Что дальше нужно делать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741711
					]
				},
				{
					"id": 730741711,
					"content": "Хм... Араджа, кажется, говорил, что нужен не один фрукт васома. Значит, нам нужно найти другие Залы Ашваттхи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741714
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741714,
					"content": "#Хорошо, я постараюсь. Нара {NICKNAME}, Паймон, ещё увидимся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741715
					],
					"speakerTitle": "Арама"
				},
				{
					"id": 730741715,
					"content": "До встречи, Арама!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 730741712,
					"content": "Спасибо, Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741713
					]
				},
				{
					"id": 730741713,
					"content": "Ох, ты сейчас о чём? Араджа, кажется, говорил, что нужен не один фрукт васома. Значит, нам нужно найти другие Залы Ашваттхи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741714
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7307418,
			"completionStepIds": [
				7307414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
