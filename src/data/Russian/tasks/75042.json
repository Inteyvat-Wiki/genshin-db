			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Манку"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750420101,
					"content": "О, здравствуй. Как поживаешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420102
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420102,
					"content": "Или можешь обращаться ко мне. Нужно что-то уточнить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420103,
						750420108,
						750420115
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420103,
					"content": "Расскажи о благословении Повелителя огня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420104
					]
				},
				{
					"id": 750420104,
					"content": "Благословение Повелителя огня... Некоторые считают это возвращением к истокам. Все сходятся во мнении, что эта сила имеет более глубокие истоки, от наших предков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420105
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420105,
					"content": "Вот только... согласно записям Ассоциации реликвий заврианов, большинство заврят с меткой по мере взросления оказываются во власти неконтролируемой внутренней силы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420106
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420106,
					"content": "Эта сила разрывает их плоть, превращая в нечто отличное от сородичей... Они впадают в ярость и сходят с ума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420107
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420107,
					"content": "Жестокий кукузавр по имени Холавака - лучший тому пример... Говорят, что он тот самый кукузавр, который когда-то получил благословение Повелителя огня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420108,
					"content": "Расскажи о решении клана.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420109
					]
				},
				{
					"id": 750420109,
					"content": "Они отправили его в Царство Ночи. Вероятно, при жизни он не нашёл одобрения ни среди драконов, ни в Царстве Ночи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420110
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420110,
					"content": "Но, покинув этот мир, он всё равно вернётся в объятия ночи. Пусть это царство будет холодным как лёд, но там он воссоединится с душами всех существ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420111
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420111,
					"content": "Может, я рассуждаю неверно, но это тоже можно расценивать как добро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420112
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420112,
					"content": "Есть какие-нибудь зацепки насчёт даров?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420113
					]
				},
				{
					"id": 750420113,
					"content": "Есть кое-что, но... для начала мне нужно во всём удостовериться. Вполне возможно, что в следующий раз вы найдёте меня у Пакаля, вождя Детей Эха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420114
					],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420114,
					"content": "Он любит... пустить пыль в глаза, но, если говорить прямо, он надёжнее самого прочного кристалла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Манку"
				},
				{
					"id": 750420115,
					"content": "У меня больше нет вопросов. До встречи!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420116
					]
				},
				{
					"id": 750420116,
					"content": "Рад был помочь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Манку"
				}
			]
		}
	]
}