				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071901,
					"content": "Есть дело. Хочу провести с тобой тренировочный бой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071902
					]
				},
				{
					"id": 761071902,
					"content": "#Тренироваться? Разве ты не {M#приглашённый исследователь}{F#приглашённая исследовательница}... Хм, если подумать, я никогда не видел, чтобы госпожа кого-то приглашала... Ах, так ты шпион! Умри!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
		{
			"id": 7610720,
