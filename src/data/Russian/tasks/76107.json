					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761072001,
					"content": "#Извините, я немного {M#заблудился}{F#заблудилась}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761072002
					]
				},
				{
					"id": 761072002,
					"content": "Вы можете выйти через порт или через главные ворота. Командир Азалия установила здесь строгие требования безопасности, и даже вы должны их соблюдать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
