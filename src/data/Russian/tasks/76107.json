					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071701,
					"content": "Фатуи мне не указ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "Раз не хочешь подчиняться нашим правилам, тогда исчезни!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
