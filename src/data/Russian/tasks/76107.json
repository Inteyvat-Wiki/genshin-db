					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "Я ваш Предвестник Марионетка!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "А? Теперь мы так говорим?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761071103,
					"content": "Хм, я восхищаюсь твоей смелостью, но такая откровенная ложь... Ты слишком недооцениваешь Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "Я... специально приглашённый исследователь Марионетки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "Специально приглашённый исследователь? Сложно представить, что госпожа нуждается в приглашенных исследователях, учитывая её непревзойдённые познания в области механических тел и куувяки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Научные исследования основываются на сотрудничестве.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Действительно, я тоже собирал немало исследовательских отчётов Исследовательского института Фонтейна для госпожи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Ристо"
				},
				{
					"id": 761071303,
					"content": "Раз уж вы эксперт в этой области, то для вас, наверное, будет очень легко решить проблему с этим сухопутным крейсером?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "Эм... я специализируюсь на теоретических исследованиях...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Вот оно что, теоретические исследования куувяки - это очень сложно, как впечатляюще! А ремонт сухопутных крейсеров более прикладная область. Это действительно совершенно разные вещи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Ристо"
				},
				{
					"id": 761071403,
					"content": "Однако, госпожа Марионетка сейчас отсутствует. Вы можете сначала обратиться к офицеру Азалии. Возможно, она знает о дальнейших планах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Конечно, так и сделаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Постучал пару раз по сухопутному крейсеру, и теперь он не двигается...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Похоже... совсем сломался. Что же теперь делать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761071504,
					"content": "#Хм, у меня с самого начала были подозрения, что что-то неладно. Настоящий исследователь никогда бы не стал хвастаться подобным образом! Ты точно {F#самозванка}{M#самозванец}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ристо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "#Можно сказать, что я её {M#наставник}{F#наставница}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "О! Однажды я собирал несколько исследовательских отчётов из Академии Фонтейна для госпожи, и она очень хвалила работу доктора Моссо. Может быть, вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Ристо"
				},
				{
					"id": 761071603,
					"content": "Кхе-кхе... хм.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "Д-да, значит, ваша слава, доктор Моссо, дошла и до этих мест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 761071605,
					"content": "Хм, насколько мне известно, доктор Моссо умер тридцать лет назад. Что ж, тебе пора последовать за ним!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ристо"
				}
			]
		},
		{
			"id": 7610717,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
