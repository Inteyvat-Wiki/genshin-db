			"dialogs": [
				{
					"id": 220470101,
					"content": "Снова промахнулся... Что я делаю не так?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470102,
					"content": "Учишься стрелять из лука?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "Большое тебе спасибо за прошлую демонстрацию!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470104,
					"content": "Благодаря тебе я...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470105,
					"content": "Попадаешь прямо в яблочко?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "Ну, до этого мне ещё далеко...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470108,
					"content": "Зато благодаря тебе я теперь попадаю в пяти случаях из десяти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470109,
					"content": "Однако инструктор хочет от меня большего, так что я буду продолжать стараться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470110,
					"content": "Раз уж ты здесь, можешь провести ещё одну демонстрацию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470111,
					"content": "Я уверен, что с твоей помощью смогу достичь результата быстрее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470112,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "Спасибо большое! Я буду внимательно смотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470120,
					"content": "Предоставляю тебе демонстрацию. Я буду внимательно смотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470114,
					"content": "Ты справился с предыдущими проблемами?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "Ты говоришь о плохой осанке, нехватке силы и неправильном способе держать лук?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470116,
					"content": "По правде говоря, я всё ещё работаю над этим.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470117,
					"content": "Но кроме этих проблем меня беспокоит, что я не смогу использовать полученные навыки в реальной битве...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470118,
					"content": "Тем не менее я полагаю, что мне нужно сначала овладеть базой, а уже потом беспокоиться об этом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470119,
					"content": "Предоставляю тебе демонстрацию. Я буду внимательно смотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёдзи"
				},
				{
					"id": 220470106,
					"content": "Стреляешь со ста шагов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
