	"talks": [
		{
			"id": 7469701,
			"completionStepIds": [
				7469701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7469701",
							"2"
						],
						"stepId": 7469701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Барбелот"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746970101,
					"content": "О? Это же Мидзуки с двумя мини-баку! Они разговаривают с Барбелот?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746970102,
					"content": "#{NICKNAME} и Паймон?.. Барбелот только что рассказала мне о вас. Я как раз думала, удастся ли нам встретиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970103
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970103,
					"content": "Хех... Похоже, судьба предопределила нашу встречу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970104
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970104,
					"content": "Ты в отпуске, Мидзуки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970105
					]
				},
				{
					"id": 746970105,
					"content": "Хм, можно и так сказать. Если работа над образовательным фильмом о психологии пройдёт гладко, я смогу отдохнуть. Но сперва нужно сосредоточиться на работе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970106,
						746970107
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970106,
					"content": "Фильм о психологии?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970108
					]
				},
				{
					"id": 746970108,
					"content": "Ого, фильмы на это способны? Потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746970109,
					"content": "Это моя новая идея. Когда я занималась продвижением бань «Аиса», вдохновилась фонтейнским кинематографом и сняла несколько выпусков развлекательного шоу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970110
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970110,
					"content": "Зрителям шоу понравилось. Они не только посмотрели все серии, но и запомнили все психологические концепции, которые мы освещали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970111
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970111,
					"content": "И тогда я подумала, почему бы не снять несколько фильмов о психических расстройствах, чтобы в увлекательной и познавательной форме объяснить основные концепции психологии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970112
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970112,
					"content": "Если мне удастся повысить общий уровень осведомлённости, люди смогут сформировать более объективное представление о том, что такое психические расстройства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970157
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970157,
					"content": "Возможно, мне удастся помешать людям бездумно отмахиваться от этих состояний как от выдумки или видеть в них нечто пугающее и опасное.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970113
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970113,
					"content": "И, кто знает, быть может, мои будущие сеансы терапии будут проходить легче.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970114,
						746970115
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970114,
					"content": "Ты много размышляла...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970116
					]
				},
				{
					"id": 746970116,
					"content": "Верно. Психические расстройства часто остаются незаметными, поэтому их сложно выявить. Порой непросто понять их природу и даже распознать сам факт проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970117
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970117,
					"content": "Хех... Но даже я не знаю, как вписать их в сценарий...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970118
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970118,
					"content": "Стыдно признаться. Я написала немало статей о психическом здоровье, но, когда дело доходит до написания сценария, я совершенно теряюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970119
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970119,
					"content": "Иногда я целый день сижу взаперти в своей комнате, бесконечно перебирая в голове несколько строк диалога или несколько секунд сценария. И даже после этого в итоге у меня может ничего не получиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970120,
						746970121
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970120,
					"content": "Это очень тяжело...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970122
					]
				},
				{
					"id": 746970122,
					"content": "Может быть, тебе не хватает вдохновения? Когда мы сами заходим в тупик, то стараемся переключиться на что-нибудь другое. И тогда решение приходит само собой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746970123,
					"content": "Великие умы думают одинаково, да, Паймон? Именно поэтому я и пришла сюда, чтобы попробовать гадание, совсем не похожее на те предсказания, с которыми привыкла иметь дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970124
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970124,
					"content": "Надеюсь, Лунный аркан ведьмы принесёт мне новое вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970125
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970125,
					"content": "Вдохновение... Аня как-то говорила, что хочет написать сказку для каждой карты Лунного аркана. Но историй, которые она хотела бы написать, было так много, а времени так мало... Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970126
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970126,
					"content": "Раз ты ищешь вдохновение, вытяни карту, госпожа ёкай. Надеюсь, незаконченные сказки той ведьмы помогут тебе найти вдохновение для твоей собственной истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970127
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970127,
					"content": "Хорошо, госпожа Барбелот. Однако... всё, что я знала ранее о «гадании», в основном было связано с... Великим храмом Наруками. Гадать на картах мне предстоит впервые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970128
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970128,
					"content": "Если что-то пойдёт не по правилам ритуала, пожалуйста, поправь меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970129
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970129,
					"content": "Ох, перевёрнутая «Луна»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970130
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970130,
					"content": "Значение «Луны» в прямом и перевёрнутом положении похоже: уход от реальности, иллюзия, самообман...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970158
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970158,
					"content": "Как человек, блуждающий под тёмной луной, заблудившийся, но не знающий, как выбраться из этого положения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970131,
						746970132
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970131,
					"content": "Звучит не очень хорошо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970133
					]
				},
				{
					"id": 746970133,
					"content": "Да, почему толкование этой карты звучит как предупреждение? У Паймон нехорошее предчувствие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 746970134,
					"content": "Раз госпожа Юмэмидзуки услышала это пророчество, значит, всё не настолько плохо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970135
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970135,
					"content": "Приложив немного усилий, ты сможешь пробиться сквозь туман, застилающий твой путь, и обрести желаемое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970136
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970136,
					"content": "Уход от реальности, иллюзия и самообман?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970137
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970137,
					"content": "Если рассматривать карту буквально, то да. Грубо говоря...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970138
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970138,
					"content": "Ты избегаешь ответа, который находится прямо перед тобой, и даже готова искать на краю земли, хотя нужно искать рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970139
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970139,
					"content": "Это означает, что тот, кто может помочь мне разобраться со сценарием, на самом деле находится совсем рядом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970140
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970140,
					"content": "Дело не только в сценарии. То, как ты интерпретируешь смысл этой карты, зависит исключительно от тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970141
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970141,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970142
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970142,
					"content": "Ответ прямо у меня перед глазами, но я ищу его далеко, чтобы избежать очевидного... Думаю, я понимаю, о чём ты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970143
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970143,
					"content": "Хм... Если посмотреть с этой точки зрения, то я действительно обманывала саму себя... Или, вернее, я зачастую искала далеко, когда нужно было искать рядом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970144
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970144,
					"content": "Я думала посетить издательский дом Яэ и попросить совета у Гудзи Яэ, но потом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970145
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970145,
					"content": "С клинической точки зрения это можно отнести к категории бессознательного избегания...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970146
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970146,
					"content": "Благодарю за предсказание, госпожа Барбелот. Ты помогла мне найти вдохновение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970147
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970147,
					"content": "Не нужно меня благодарить. Я ничего не сделала. Ты сама распутала нити судьбы. Я лишь вложила свободные концы в твои руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970148
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970148,
					"content": "Однако Гудзи Яэ тоже невольная заложница судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970149
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970149,
					"content": "Переплетающиеся нити часто приносят неприятности. Учитывая это, держаться от неё на расстоянии - не самая плохая идея.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970150
					],
					"speakerTitle": "Барбелот"
				},
				{
					"id": 746970150,
					"content": "Если я попрошу её высказать своё мнение о моём сценарии, это ведь не станет вмешательством судьбы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970151
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 746970151,
					"content": "Как я уже сказала, то, как ты интерпретируешь события, не зависит от меня, Юмэмидзуки. Я не могу предсказать все повороты твоей судьбы по одной карте.",
