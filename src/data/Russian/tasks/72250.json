			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Гама",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722500101,
					"content": "Спасите! Помогите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500102
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500102,
					"content": "Я слышал, что наши лидеры с трудом справляются с восстанием Супады но Хико и что Дайнити Микоси не защищён, поэтому мне в голову пришла мысль, которую я не должен был...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500103
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500103,
					"content": "Смилуйтесь! У меня больная мать, которую надо кормить, и 12 сирот на воспитании! Пожалуйста, смилуйтесь. Отпустите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500104
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500104,
					"content": "Кхм...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722500105
					]
				},
				{
					"id": 722500105,
					"content": "А! Так ты не один из стражей Дайнити Микоси.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500106
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500106,
					"content": "Судя по твоей необычной одежде... Может быть, ты работаешь в той же сфере, что и я, только в другом месте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500107
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500107,
					"content": "Кто бы хотел заниматься твоей работой?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722500108,
					"content": "О, да ладно, не нужно притворяться. Эх... Я, наверное, самый невезучий человек на свете. Столько усилий приложил, чтобы попасть в Дайнити Микоси, и как раз в тот момент, когда планировал сколотить настоящее состояние... я попал в механическую ловушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500109
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500109,
					"content": "Думаю, сегодня просто был неподходящий день, чтобы «грабить богатых, отдавать бедным».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500110
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500110,
					"content": "Ну-ну, называй лопату лопатой, а вора - вором!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722500111,
					"content": "Да что ты понимаешь? Большие шишки слушают декадентскую музыку, пьют и едят от пуза, а мы, низы, вкалываем до упаду, выбрасывая содержимое их горшков и грея их сандалии! Где в этом логика?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500112
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500112,
					"content": "Открою секрет - считай это платой за спасение моей жизни. Я дал ремесленникам, занимающимся здесь ремонтом и обслуживанием, кое-что, чтобы развязать их языки, и они рассказали, что тут есть ещё две комнаты, в которых хранятся сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500113
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500113,
					"content": "Ещё две!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722500114,
					"content": "#Мм, {NICKNAME}, а, может, сами «пограбим богатых, отдадим бедным».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722500115,
					"content": "Однако я не знаю, где находятся эти комнаты. Рабочие не осмелились рассказать мне больше ничего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500116
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500116,
					"content": "Считай эти сведения моим подарком!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500117
					],
					"speakerTitle": "Гама"
				},
				{
					"id": 722500117,
					"content": "Ну, сейчас в Энканомии никого нет, так что давай посмотрим, какие древние реликвии мы сможем найти в этих комнатах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 722500118,
					"content": "#Ну же, {NICKNAME}, просто немного осмотримся!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}