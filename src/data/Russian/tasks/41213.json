				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Альбедо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "Сила дракона... его воля к жизни может воскрешать погибшие растения и давать им такую силу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130602,
					"content": "Немыслимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130603,
					"content": "Как мог засохший пень превратиться в такого монстра?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130604,
					"content": "Ещё немного - и он бы нас проглотил!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130605,
					"content": "Но почему это случилось только сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130606,
					"content": "Скорее всего, потому что меч упал на землю. Это привело к утечке его энергии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130607,
					"content": "Это я виноват. Не прогоняйте меня! Умоляю, не прогоняйте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 412130608,
					"content": "Я больше не доставлю вам проблем, клянусь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 412130609,
					"content": "О, господин Паллад... Не нужно притворяться грибом, обняв колени...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130610,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130611,
					"content": "Неужели этот Крио папоротник засох здесь, потому что не имел возможности впитывать порочную энергию?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130612,
					"content": "#Когда ты пров{F#ела}{M#ёл} очищение, чистая энергия элементов не только воскресила его, но и усилила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130613,
					"content": "Чистая энергия жизни заставит его тело непрерывно восстанавливаться... вместе с его воинственным духом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130614,
					"content": "#Звучит хуже, чем я думал{F#а}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "Я ещё не встречался с подобным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130617,
					"content": "Нужно отметить, что наблюдение такого редкого феномена - это своего рода везение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130618,
					"content": "Сахароза.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130619,
					"content": "Да!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130620,
					"content": "Позаботься об этом искателе приключений и отведи его обратно в лагерь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130621,
					"content": "Слушаюсь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130622,
					"content": "#Что до нашего дела... Прошу прощения, путешественни{F#ца}{M#к}, но я вынужден снова просить твоей помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "Альбедо"
				},
				{
					"id": 412130623,
					"content": "Я сделаю всё, что в моих силах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "Мы единственные, кто может решить эту неожиданную проблему. Наверняка это потому что мы становимся всё сильнее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130615,
					"content": "#Неожиданно. Это потому что я слишком могущественн{F#ая}{M#ый}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
}