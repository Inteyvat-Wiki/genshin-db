				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "Альбедо! Мы опять к тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130102,
					"content": "Ой, кажется, Альбедо нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130103,
					"content": "Он ушёл проводить исследования? Или, может быть, опять рисовать свои таинственные картины?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130104,
					"content": "А! Это вы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130105,
					"content": "Да это же Сахароза! Ты здесь откуда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130106,
					"content": "Моё исследование закончено, поэтому у меня есть примерно пять часов и двадцать шесть минут свободного времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130107,
					"content": "Поэтому я решила разыскать вас, чтобы поговорить о моей просьбе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130108,
					"content": "У тебя прекрасное чувство времени! Ты что, человек-часы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130109,
					"content": "О, нет-нет, не стоит похвалы, ты слишком добра...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130110,
					"content": "Это был не комплимент!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130111,
					"content": "#Путешественни{F#ца}{M#к}! М-можно спросить?.. Как у тебя успехи с раскрытием тайны Альбедо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130112,
					"content": "Насколько Паймон помнит, мы говорили об этом больше недели назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130113,
					"content": "Мы думали, ты забыла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "Что?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130115,
					"content": "Б-больше недели?! Я, должно быть... Ах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130116,
					"content": "Ох, я была так увлечена экспериментами, что совершенно упустила из виду это дело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130117,
					"content": "Как у неё может быть такое прекрасное и такое ужасное чувство времени одновременно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130118,
					"content": "И... и всё-таки! Вы что-нибудь узнали?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130119,
					"content": "Можно и так сказать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "Замечательно! Можете мне рассказать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130122,
					"content": "Паймон, как ты считаешь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Хм... Наверное, ничего страшного не случится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130124,
					"content": "Пусть даже посмотрит, только руками не трогает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130125,
					"content": "Подождите, о чём вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130126,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130127,
					"content": "Это секрет Альбедо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "Это очень сильный меч, его нельзя трогать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130130,
					"content": "О... Это...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130131,
					"content": "Э-это! Я никогда не видела такого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130132,
					"content": "Ха-ха, наслаждайся зрелищем! Даже Паймон почему-то ощущает гордость, глядя на него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130133,
					"content": "Вот это да! Я впервые вижу волшебный меч.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130134,
					"content": "Я смутно ощущаю, как в нём медленно течёт энергия... Он будто живой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130135,
					"content": "Ты действительно ощущаешь это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130136,
					"content": "Думаю, это потому что я изучаю алхимию.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130137,
					"content": "Я не могу сказать наверняка, но течение энергии действительно заметно. Хотя это не особо точное описание... Обычно я объясняю вещи п-по-другому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130138,
					"content": "Пожалуйста, поверьте мне! Обычно я не выражаюсь так неопределённо!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130139,
					"content": "Ладно-ладно, мы поняли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130140,
					"content": "#Путешественни{F#ца}{M#к}, скажи... Ты не мог{F#ла} бы воспользоваться им в бою?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130141,
					"content": "Мне хотелось бы узнать о нём больше, но я не могу его использовать, поэтому прошу тебя...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130142,
					"content": "Только тихо, чтобы Альбедо не узнал.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "Давайте найдём подходящее место!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130143,
					"content": "Лучше сделать это где-нибудь, где никто не увидит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "Это то, о чём ты хотела узнать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "Да, нам всё ясно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
