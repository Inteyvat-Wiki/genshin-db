			"trigger": {
				"objectNames": [
					"Отчаянный Паллад"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130301,
					"content": "У-у-ух... О-о-ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 412130302,
					"content": "Г-господин Паллад?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130303,
					"content": "Т-ты ещё не вернулся?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130304,
					"content": "Разве это не тот искатель приключений из Мондштадта? Он тоже пришёл сюда вслед за Сайрусом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130305,
					"content": "Х-хо-олодно-о, как хо-олодно! Апчхи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 412130306,
					"content": "Ты что, стоишь здесь с тех пор, как я вытащила тебя из сугроба?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130307,
					"content": "Я... Я не хотел, н-но я заблудился! Простите...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 412130308,
					"content": "Б-р-р... Я так з-замёрз, что и шагу не м-могу сделать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "Отчаянный Паллад"
				},
				{
					"id": 412130309,
					"content": "Ах, господин Паллад, эти горы не прощают неподготовленных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130310,
					"content": "Давайте возьмём его с собой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "Можно? Он сейчас в таком состоянии, что сам идти не сможет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130312,
					"content": "Причём тут «можно»? Мы же не можем бросить его здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130313,
					"content": "#Тоже верно... Ох, путешественни{F#ца}{M#к}, извини... Я... прошу прощения за него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130314,
					"content": "Всё ещё думаешь о других? Сначала побеспокойся о себе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "А! Опять Фатуи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130316,
					"content": "Думаю, вы уже знаете, зачем мы здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Вадим"
				},
				{
					"id": 412130317,
					"content": "Отдайте меч, иначе живыми вам не уйти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Вадим"
				},
				{
					"id": 412130318,
					"content": "Нет! Пожалуйста, не отдавай им меч!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130319,
					"content": "Конечно не отдам!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "Вот это настрой! Зададим им жару!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130322,
					"content": "Паллад, я отведу тебя в безопасное место! Скорее!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130323,
					"content": "Хм! Наивные... Свидетелям не удастся уйти!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Вадим"
				},
				{
					"id": 412130324,
					"content": "Я преподнесу этот меч в подарок Её Сиятельству, Предвестнице Синьоре!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Вадим"
				},
				{
					"id": 412130320,
					"content": "Никто не смеет грабить меня!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
