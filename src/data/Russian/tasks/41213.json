			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сахароза"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "Вот это да, впервые вижу такой меч...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130202,
					"content": "#И ты просто потрясающ{F#ая}{M#ий}! Прекрасно смотришься в бою, и удары у тебя сильные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130203,
					"content": "Ты мне льстишь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "Этот меч особенный. Я не хотела углубляться в исследование, но он невольно приковывает взгляд...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130205,
					"content": "Паймон считает, что это, скорее, твоя особенность, а не меча...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130206,
					"content": "Опасный и притягательный волшебный одноручный меч... Точно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130207,
					"content": "Раз Альбедо рассказал вам о такой важной вещи, значит, он вам очень доверяет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130208,
					"content": "Меня это тоже удивляет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Хе-хе, ты заслуживаешь такого доверия.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130211,
					"content": "Я тоже так думаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130212,
					"content": "Но ведь до того, как меч попал тебе в руки, в нём не было энергии... Как господин Альбедо приметил его среди прочего хлама?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130213,
					"content": "Внезапное озарение обычно нельзя объяснить. Как, например, такое: Паймон захотела медовое мясо с морковкой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130214,
					"content": "Ох... Я ведь тоже сегодня ничего не ела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130215,
					"content": "Я поспешила к вам сразу же, как только закончила эксперименты, но по пути наткнулась на застрявшего в снегах искателя приключений. Пришлось потратить столько времени, чтобы ему помочь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130216,
					"content": "*Урчание*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130217,
					"content": "Кажется, ты действительно голодна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "Ой! Нет-нет, не настолько...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130219,
					"content": "Не надо стесняться. Смело выкладывай все свои мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130220,
					"content": "Эм... Ну...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130221,
					"content": "Повторяй за Паймон: «Я голодна! Я хочу есть!»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130222,
					"content": "#Я голод{F#на}{M#ен}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "Я г-голодна... Я х-хочу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130225,
					"content": "Мне так неловко!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130226,
					"content": "Нечего здесь стесняться! Если ты признаешься, что голодна, то еда будет вкуснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130227,
					"content": "О, правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Сахароза"
				},
				{
					"id": 412130228,
					"content": "Правда! Давайте соберёмся с силами, дойдём до привала и поищем еду...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130229,
					"content": "Медовое мясо с морковкой точно согреет нас в эту стужу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 412130223,
					"content": "Я хочу есть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "#Я рад{F#а}, что он мне доверяет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
