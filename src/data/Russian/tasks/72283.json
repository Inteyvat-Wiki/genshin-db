			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Акаси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "Уф, видимо, сегодня не мой день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830102,
					"content": "Что случилось?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "Со стрельбой у меня всё хуже и хуже. Однажды я всё-таки пущу стрелу себе же в колено.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830104,
					"content": "Почему ты тренируешься в таком месте?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "Хах, это всё из-за того дзибасири. Это он мне насоветовал! И знаешь что? Теперь я даже думаю, что им просто нравится мучить людей...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830106,
					"content": "Ты что-нибудь знаешь о разведении унаги? Мне кажется, ничего со стрельбой у меня не выйдет и нужно подумать о других вариантах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830107,
					"content": "Какая связь между унаги и стрельбой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Эх, забудь. Вижу, что ты ничего не смыслишь в разведении унаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830109,
					"content": "Для начала нужно поймать несколько мальков унаги. Но они такие крохотные, что невооружённым глазом их едва ли разглядишь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830110,
					"content": "Вот мне и подумалось, что, раз лучники могут поражать цели с очень большого расстояния, у них должно быть хорошее зрение. И опытные дзибасири посоветовали мне, как натренировать зоркость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830111,
					"content": "«Акаси, в тренировках нужна последовательность. Успехов ты добьёшься, только если заложишь прочный фундамент».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830112,
					"content": "«Унаги очень маленькие и очень вёрткие. Тебе нужно начать с неподвижных целей, но не выбирай цели, что близко. В обучении без серьёзного подхода не обойтись».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830113,
					"content": "И вот по их совету я практикуюсь тут в стрельбе, но в цель ни разу не попал... Это вообще возможно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830114,
					"content": "Кстати, а ты-то не хочешь попробовать? С каменной платформы видно цели. Попади во все - вот это будет успех.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830115,
					"content": "Что ж, я попробую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Ну посмотрим на твои способности. Приходи ко мне, как справишься.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Акаси"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228302",
							"2"
						],
						"stepId": 7228302,
						"stateName": "QUEST_STATE_UNFINISHED"
