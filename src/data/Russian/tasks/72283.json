				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Акаси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "Уф, и у тебя ничего не вышло.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830202,
					"content": "Думаю, сегодня просто не мой день. Мне точно что-то мешает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830203,
					"content": "Хочешь попробовать ещё? Цели не унаги - никуда не убегут.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Акаси"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Акаси"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "Ого! У тебя получилось!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830302,
					"content": "Эх, да ты словно с пелёнок с луком не расстаёшься. Мне с моими умениями за тобой не угнаться, даже если буду тренироваться ещё несколько лет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830303,
					"content": "И я так часто здесь тренируюсь, что уже и не помню, как выглядят резвящиеся унаги.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830304,
					"content": "А тебе нравятся унаги?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830305,
					"content": "Нравятся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "Вот как? А я так люблю унаги, что очень хочу их разводить. Тебе не кажутся они милыми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830308,
					"content": "Но лучшее - это унаги на тарелке. Прекрасное сочетание вкуса и вида.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830309,
					"content": "Тебе не кажется, что я гонюсь за мелочами, забывая о главном? Я тренируюсь в стрельбе только потому, что я хочу разводить унаги, ведь я так их люблю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830310,
					"content": "Но я люблю свободных унаги. Так что какой смысл их разводить?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830311,
					"content": "В любом случае спасибо за наглядный пример. Возьми это и удачи тебе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Акаси"
				},
				{
					"id": 722830306,
					"content": "Не особо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}