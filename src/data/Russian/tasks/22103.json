					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "Отлично! Просто гора с плеч... Теперь всё вернётся в норму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221030304,
					"content": "Вот. Это твоя награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221030305,
					"content": "#Хм. Тот самый юный джентльмен? Я думаю, что ты мог{F#ла} видеть его где-то неподалеку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221030306,
					"content": "Например, на крыше гостиницы. Он любит там отдыхать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221030307,
					"content": "Лучше его не тревожить. Юный джентльмен предпочитает одиночество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				}
			]
		}
