						221030202
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221030202,
					"content": "Пока нет...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Прошу, поторопись. Юный джентльмен имеет обыкновение появляться из ниоткуда и исчезать бесследно. Никто не знает, когда он объявится в следующий раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Верр Голдет"
				},
				{
					"id": 221030204,
					"content": "А если он объявится, то нам придётся на некоторое время закрыться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Верр Голдет"
				}
			]
		},
