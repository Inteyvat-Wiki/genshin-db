			"dialogs": [
				{
					"id": 760440101,
					"content": "Во «Флагмане» есть один особо скверный заказ, и почти нет никаких зацепок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760440102,
					"content": "Недавно ещё болтали, что он на севере острова Лемпо нападал на людей, а теперь словно в воду канул, ни следа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760440103,
					"content": "«Всякий путь оставляет след». Даже заметая их, создаёшь новые.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760440104,
					"content": "Да и если в заказе ничего дополнительно не написано, это вовсе не значит, что у них нет никакой информации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760440105,
					"content": "Верно. Я тогда к Лешеку загляну. С моим опытом авось что-нибудь выведаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760440106,
					"content": "Ну, тогда дело за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760440107,
					"content": "Конечно, не волнуйтесь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		},
