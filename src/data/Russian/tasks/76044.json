			"dialogs": [
				{
					"id": 760440301,
					"content": "Во «Флагмане» из всех заказов остался только последний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760440302,
					"content": "#Говорят, это во многом благодаря {NICKNAME}, но похоже, что даже {M#он}{F#она} не может справиться с этим делом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760440303,
					"content": "Ведь толком никаких зацепок-то и нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760440304,
					"content": "А то, что не написано в заказе, не значит, что сведений совсем нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760440305,
					"content": "Кажется, у тебя есть догадки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760440306,
					"content": "Я тогда к Лешеку загляну. С моим опытом авось что-нибудь выведаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 760440307,
					"content": "Ну, тогда дело за тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 760440308,
					"content": "Конечно, не волнуйтесь!",
					"roleType": "TALK_ROLE_NPC",
