					{
						"sceneId": 3,
						"position": [
							3558.252,
							427.355,
							4469.95
						],
						"pointId": 340100766
					}
				]
			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#Знаешь, {NICKNAME}, в последнее время все поручения стали какими-то трудными.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510102,
					"content": "Как настоящий заботливый проводник, Паймон обязана помогать тебе отдыхать. Та-дам! Угадай, где мы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510103,
					"content": "На вывеске написано, что это «Галерея Дамовиль».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "Обитель карманных воришек, кладбище кошельков.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "Здравствуйте. Добро пожаловать в «Галерею Дамовиль».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 756510106,
					"content": "Ну зачем вы так. Принцип «Галереи Дамовиль» - хорошее качество по доступным ценам. Можете ознакомиться с нашим прейскурантом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 756510107,
					"content": "Это не обычный магазин. Сюда люди приходят отдохнуть после тяжёлой работы, снять стресс покупками.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510108,
					"content": "Да, именно так! Недавно мы запустили акцию «Вторая вещь в подарок». Принять участие в акции могут все покупатели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 756510109,
					"content": "Я теряю мору, когда вы покупаете, вы теряете мору, когда не покупаете!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 756510110,
					"content": "Паймон увидела рекламу акции «Галереи Дамовиль» на улице и взяла на заметку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510111,
					"content": "Две покупки по цене одной! Хорошее предложение, как ни крути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510112,
					"content": "Паймон всегда кажется, что без покупок в «Галерее Дамовиль» жизнь проходит мимо... Сегодня мы с тобой всё исправим!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510113,
					"content": "Что ты хочешь купить, Паймон?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "И как ты собираешься всё исправить?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "Ха-ха, это будет сюрприз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510116,
					"content": "Тогда я отказываюсь платить.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "Пф, и не надо! Паймон сегодня заплатит своей морой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510118,
					"content": "#Бусико, заказ приехал? На нём должно быть написано: «Паймон и {NICKNAME}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510119,
					"content": "Приехал, одну минуту...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "Бусико"
				},
				{
					"id": 756510120,
					"content": "Бусико, хозяин магазина, приносит свёрток, по очертаниям которого невозможно догадаться, что в нём. Паймон выгребает из карманов целую гору карманных денег. Вы замечаете печаль на её лице, когда она расстается с такой значительной суммой.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "Вы вместе разворачиваете свёрток и видите, что внутри лежат два альбома для фотографий.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "Ха-ха, ура! Паймон так долго о них мечтала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510123,
					"content": "Мы с тобой постоянно что-нибудь снимаем, а теперь у нас есть альбомы, чтобы хранить фотографии!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510124,
					"content": "Не помню, чтобы ты держала в руках фотокамеру.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "#Ха-ха, ты просто не замечал{F#а}! Паймон часто фотографирует тебя, когда ты не видишь, хе-хе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510126,
					"content": "Знаешь, очень хочется посмотреть твои снимки...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "Дай посмотреть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "Не сейчас! Сначала Паймон наснимает на целый альбом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510129,
					"content": "Жадина Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "Плохая Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "Пф! Глупости! Вот, это будет твой альбом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510132,
					"content": "Не очень большой, но всё равно фотографий туда поместится довольно много.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510133,
					"content": "Мы часто снимаем разные красивые места по просьбе заказчиков, а себе почти ничего не оставляем на память.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510134,
					"content": "И Паймон решила купить альбомы, чтобы мы могли хранить в них свои фотографии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510135,
					"content": "Значит, это подарок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510136,
					"content": "Да! Паймон купила один альбом и получила второй в подарок. Один тебе, один Паймон. Паймон всё продумала!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510137,
					"content": "#Только ты {F#должна}{M#должен} сразу начать его использовать. Можешь сфотографировать места, где мы побывали, вспомнить прошлое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510138,
					"content": "#Кстати, хочешь поснимать на фотокамеру Паймон? Ты ведь ещё не пробовал{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510139,
					"content": "Паймон с таким трудом разместила индивидуальный заказ на фотокамеру в продуктовом магазине. Нельзя, чтобы она пылилась без дела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510140,
					"content": "Давай, я попробую.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "Спасибо, Паймон.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "Ха-ха, всегда к твоим услугам. Как и полагается настоящему заботливому проводнику!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 756510143,
					"content": "Идём! Надо сделать несколько снимков на память!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
}