			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сказитель"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150401,
					"content": "Тебе всё-таки удалось найти это место. Мои поздравления.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150402
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150402,
					"content": "Кхе. Мы только встретились, а ты уже словно смерти моей желаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150403,
						20150404
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150403,
					"content": "Вы изготавливаете Глаза Порчи...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				},
				{
					"id": 20150405,
					"content": "О, так вот в чём дело.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150406
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150406,
					"content": "Думаю, случилось небольшое недоразумение. Я понимаю, как это может выглядеть со стороны, но я просто выполняю приказы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150407
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150407,
					"content": "#Руковожу этой операцией вовсе не я. Ты ведь весьма {F#сильна}{M#силён}, верно? Тогда чего ждёшь, вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150408
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150408,
					"content": "#Эх, ты... из-за каких-то пустяков выходишь из себя. Да ты {F#изменилась}{M#изменился}... ты слабеешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150409
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150409,
					"content": "Никакие это не пустяки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150410
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20150410,
					"content": "Ну а что тогда? Так устроен мир. Человеческая жизнь - что тот сорняк.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150411
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150411,
					"content": "Они всё равно бы умерли, хоть с Глазом Порчи, хоть без него. С ним они хотя бы смогли воплотить свои надежды в жизнь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150412
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150412,
					"content": "Ты хоть понимаешь, насколько для нас ценна Охота на Глаза Бога? На её осуществление ушло немало сил. Естественно, этот указ нам крайне выгоден.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150413
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150413,
					"content": "Но теперь наш тяжёлый труд начал окупать себя. Сей вражду, и рынок для Глаз Порчи готов. Пусть сила приманивает слабых, которые её жаждут...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150414
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150414,
					"content": "За скромную цену они почувствуют себя на вершине мира. Жизнь в обмен на безграничную силу... Выгодная сделка, не находишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150415
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150415,
					"content": "Значит, указ об Охоте вышел из-за Фатуи? Так с самого начала это всё были вы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20150416,
					"content": "Извне Инадзума кажется неприступной, но внутри... это страна возможностей. Немного усилий и мы разрушим её изнутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150417
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150417,
					"content": "В вечности время простирается очень далеко, но каждое мгновение становится донельзя хрупким.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150418
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150418,
					"content": "Взять, к примеру, вашего друга из сопротивления. Ему уже не помочь. Он безнадёжен.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150419
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150419,
					"content": "Как пузырёк на воде. Прекрасен, но неуклонно идёт к разрушению.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150420
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150420,
					"content": "Чем больше они теряют, тем больше они Глазами Порчи дорожат, а немощность подхлёстывает их к борьбе! Ха-ха-ха, вот так комедия, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150421,
						20150422
					],
					"speakerTitle": "Сказитель"
				},
				{
					"id": 20150421,
					"content": "Не смей глумиться над Тэппэем...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150423,
					"content": "#{NICKNAME}, остынь, а?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20150422,
					"content": "Он вовсе не немощный!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150404,
					"content": "Вы даёте Глаза Порчи сопротивлению...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				}
			]
		},
