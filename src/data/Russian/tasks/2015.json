			"trigger": {
				"objectNames": [
					"Сангономия Кокоми",
					"Горо"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150101,
					"content": "#{NICKNAME}, как дела Тэппэя?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150102,
						20150103
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150102,
					"content": "Как мы могли упустить?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				},
				{
					"id": 20150104,
					"content": "...Я приказала забрать все Глаза Порчи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150105
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150105,
					"content": "У большинства упадок сил, но ничего серьёзного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150106
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150106,
					"content": "Но вот некоторые...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150107
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150107,
					"content": "Ваше превосходительство, я собираюсь открыть отдельный полевой госпиталь, чтобы следить за их состоянием.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150108
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20150108,
					"content": "Солдаты протестуют против запрета. Они знают, что такое Глаза Порчи, но всё равно намерены использовать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150109
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20150109,
					"content": "Поручаю разобраться с этой ситуацией тебе. Мне необходимо на передовую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150110
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150110,
					"content": "Такая неудача не может не сказаться на боевом духе войска. Если сёгун воспользуется сумятицей и нападёт, все наши труды пойдут прахом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150111
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150111,
					"content": "#{NICKNAME}, что ты думаешь на этот счёт?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150112
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150112,
					"content": "Я остановлю Фатуи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150113
					]
				},
				{
					"id": 20150113,
					"content": "Нет, это слишком опасно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150114
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150114,
					"content": "Указ Сакоку всё ещё в силе. Это значит, что их Глаза Порчи сделали в Инадзуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150115
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150115,
					"content": "Для организации такого производства требуется много рабочих рук, и без местной поддержки они бы этого сделать не смогли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150116
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150116,
					"content": "Чтобы остановить их, нужно разрушить фабрику, на которой производятся Глаза Порчи. Но она непременно хорошо охраняется...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150117
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150117,
					"content": "В одиночку отправляться слишком опасно. Возьми с собой солдат...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150118
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150118,
					"content": "На это нет времени.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150119
					]
				},
				{
					"id": 20150119,
					"content": "Ваше превосходительство, Глаза Порчи отбирались у солдат второпях, и Фатуи не могли этого не заметить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150120
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20150120,
					"content": "Пока мы будем собирать войска, они узнают о наших планах и скроются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150121
					],
					"speakerTitle": "Горо"
				},
				{
					"id": 20150121,
					"content": "Верно... секундочку...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150122
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150122,
					"content": "Пока изымались Глаза Порчи, я кое-что придумала. Фабрика наверняка крупная, в отдалённом месте, но достаточно близко к дороге, чтобы могли подвозить сырьё...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150123
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150123,
					"content": "Таких мест не так уж много. Если учесть те места, где солдаты получили Глаза Порчи, то, вероятнее всего, фабрика находится в горах у побережья <color=#00E1FFFF>Ясиори</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150124
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150124,
					"content": "#Я не стану тебя останавливать. Просто будь {F#осторожна}{M#осторожен}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150125
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150125,
					"content": "Мы уже потеряли немало отличных бойцов. Не хотелось бы потерять и тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150126
					],
					"speakerTitle": "Сангономия Кокоми"
				},
				{
					"id": 20150126,
					"content": "Нам пора.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150127
					]
				},
				{
					"id": 20150127,
					"content": "Что? То есть на <color=#00E1FFFF>фабрику Глаз Порчи</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150128
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20150128,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150129
					]
				},
				{
					"id": 20150129,
					"content": "#Ты серьёзно? Ты хорошо {F#подумала}{M#подумал}? Ладно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20150103,
					"content": "Ему вдруг стало намного хуже.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				}
			]
		},
		{
			"id": 201504,
			"completionStepIds": [
				201505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
