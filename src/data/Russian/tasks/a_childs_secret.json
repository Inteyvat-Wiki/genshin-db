					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100311,
						101100312
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100311,
					"content": "Паймон, время сказать свою любимую фразу!",
