					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100316
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100316,
					"content": "Слушайте меня внимательно... Давайте пока не пойдём туда!",
