					"nextDialogs": [
						101100408
					],
					"speakerTitle": "Дилюк"
				},
				{
					"id": 101100408,
					"content": "А что, если я напьюсь? Продашь меня за горстку моры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100409
					],
					"speakerTitle": "Кэйа"
				},
				{
					"id": 101100409,
					"content": "«Продам»?",
