			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Айлин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100901,
					"content": "Фух... Спасибо, теперь мне ясно, что впереди меня ещё ждёт много упорных тренировок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100902
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100902,
					"content": "Какая скромность. Лично я думаю, что ты уже достаточно хорошо владеешь мечом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100903
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100903,
					"content": "Но я ужасно устала, а значит мне не хватает выносливости... Вот увидите, однажды я обязательно смогу победить все чучела хиличурлов в Мондштадте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100904
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100904,
					"content": "Так держать, Айлин! У тебя обязательно получится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100905
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100905,
					"content": "Спасибо... Ой, я так увлеклась тренировками, что совсем забыла про свою встречу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100906
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100906,
					"content": "Но я так устала... Даже пошевелиться не могу...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100907
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100907,
					"content": "Почётный рыцарь, тебя не сильно затруднит передать моё сообщение Джеку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100908,
						101100913
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100908,
					"content": "Кто такой Джек?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100909
					]
				},
				{
					"id": 101100909,
					"content": "Это мой друг. Он совсем недавно стал искателем приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100910
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100910,
					"content": "Мы договаривались встретиться с ним сегодня вечером и обсудить план приключений... Можешь, пожалуйста, попросить его перенести встречу на другой день?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100911
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100911,
					"content": "Если я не ошибаюсь, он должен быть в <color=#00E1FFFF>храме Льва</color>, Хранителя южного ветра, вместе со Стэнли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100912
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100912,
					"content": "Это легендарный искатель приключений, чьи подвиги в Пепельном море потрясли весь Мондштадт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100917
					],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100917,
					"content": "#Храм Льва? Я там уже не был{F#а} очень давно!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100918
					]
				},
				{
					"id": 101100918,
					"content": "Отлично! Я очень сильно благодарна тебе за помощь!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айлин"
				},
				{
					"id": 101100913,
					"content": "Где он?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100914
					]
				},
				{
					"id": 101100914,
					"content": "Он должен быть в <color=#00E1FFFF>храме Льва</color>, Хранителя южного ветра, вместе со Стэнли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
