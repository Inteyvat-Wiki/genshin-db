			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Нора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#Эй, {NICKNAME}, гляди!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100102,
					"content": "Она же стоит здесь одна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100103,
					"content": "Как будто с кем-то разговаривает и смеётся... Ууу, Паймон страшно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100104,
					"content": "У меня в детстве тоже был воображаемый друг.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#Что? Хочешь сказать, ты тоже так себя {F#вела}{M#вёл}, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100106,
					"content": "То есть это просто воображение? Или всё-таки это кто-то невидимый, с кем можно поиграть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100107,
					"content": "«Воображаемый» и есть «воображение».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "Воображаемый... Воображение...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100111,
					"content": "А, так ты имеешь в виду «вымышленного друга»! Чего ж ты мне голову морочишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100112,
					"content": "Давай, показывай Паймон, как выглядит твой «воображаемый друг»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100113,
					"content": "Ох, мы больше не играем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "Правда? Значит, когда ты взрослеешь, воображаемый друг исчезает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100116,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#Ох... Паймон надеялась познакомиться с твоим... Эй, только не говори, что у тво{F#его}{M#ей} {F#брата}{M#сестры} тоже был воображаемый друг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100119,
					"content": "Конечно, был.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "Не может быть! Вам, ребята, так повезло...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100121,
					"content": "#В Ли Юэ есть такая игра, не знаю, слышал{F#а} ли ты о ней. В неё должны играть четыре человека, но вы с {F#братом}{M#сестрой}, наверное, могли бы играть и вдвоём.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100122,
					"content": "#Путешественни{F#ца}{M#к}! Какая встреча!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100123,
					"content": "Что? Опять ты, бродяжка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100124,
					"content": "Ха-ха! Лиза делает кое-какие интересные штучки. Я просто пришёл посмотреть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100125,
					"content": "Почему-то «интересные штучки» Лизы заставляют Паймон нервничать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100126,
					"content": "Эй, нельзя оценивать элегантную леди только по её «интересным штучкам».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100127,
					"content": "Для одной такой штучки ей пришлось заказать очень опасный прибор прямиком из Сумеру.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100128,
					"content": "Оп-опасный?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100129,
					"content": "Это какой-то детектор?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "Да! Он выглядит как монокль, но на самом деле он называется «детектор нирнама».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100133,
					"content": "К сожалению, у Лизы не получается им пользоваться. Я одолжил его, чтобы проверить, получится ли у меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100134,
					"content": "Что? Почему у Лизы не получается?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100135,
					"content": "Хм... Может быть, потому что ей не хватает детской веры в чудо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100136,
					"content": "Если вам интересно, можете сами у неё спросить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100137,
					"content": "Значит, ты их видишь? Тогда расскажи мне уже, как выглядит этот воображаемый друг!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100138,
					"content": "Ха-ха, это же тайна!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100139,
					"content": "#Ладно, путешественни{F#ца}{M#к}, теперь это твоя вещь. Попробуй разглядеть воображаемого друга Норы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100140,
					"content": "#Ну что там? Видно? Разглядел{F#а}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100141,
					"content": "Ого, это и вправду работает!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "Значит, ты тоже можешь его использовать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100144,
					"content": "Дайте Паймон посмотреть! ... Аргх, он слишком большой для меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100145,
					"content": "#Ладно, {NICKNAME}, ты будешь моими глазами! Давай, пойдём посмотрим воображаемых друзей у <color=#00E1FFFF>других людей</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100142,
					"content": "Да! Кажется, они лучшие друзья.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "Это просто монокль.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "Ага, я тоже так думал. Но он называется «детектор нирнама».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100117,
					"content": "Как бы грустно это ни было, но да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "Он стал невидимкой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "«Воображение» и есть «воображаемый».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "Воображение... Воображаемый...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Флора"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "Смотри, вот её воображаемый друг. Ага, это какой-то воздушный фрукт... порхающая помидорка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100204,
					"content": "Постойте, воображаемые друзья могут быть ещё и фруктами?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100205,
					"content": "#Привет, {NICKNAME}! Привет, бард!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100206,
					"content": "Привет, Флора. Можно задать тебе вопрос?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Конечно! Чем Флора может вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100209,
					"content": "Расскажи нам о своём... друге.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "Вы тоже можете видеть мистера Помидорку? Другие почему-то его не видят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100211,
					"content": "Мы с мистером Помидоркой лучшие друзья с детства!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100216,
					"content": "(Уф, так нечестно! Паймон не любит не понимать, что происходит...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100217,
					"content": "Флора, а почему твой друг - порхающая помидорка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100218,
					"content": "А почему нет? Я всегда мечтала подружиться с фруктом, который умеет летать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100219,
					"content": "С летающим фруктом? Но зачем?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100220,
					"content": "Потому что, когда поднимается ветер, с таким другом можно взлететь высоко в небо и улететь далеко-далеко. Это же так чудесно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100221
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100221,
					"content": "Вот так детей и уносит ветер!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101100222,
					"content": "Но я же не на самом деле улетаю...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100223
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100223,
					"content": "Я узнала о таком фрукте из историй одного странствующего путешественника.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100224
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100224,
					"content": "Вроде бы его звали... Стэнли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100225,
						101100226
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100225,
					"content": "О, я знаю Стэнли!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100227,
					"content": "Он искатель приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100228
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100228,
					"content": "Как только он начинает рассказывать какую-нибудь историю, тут же понимаешь, насколько он опытный искатель приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100229
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100229,
					"content": "«Удивительные приключения Стэнли» очень популярны по всему Мондштадту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100230
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100230,
					"content": "Он как раз сейчас в городе, так что вы можете сами послушать его истории.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100231
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100231,
					"content": "Очень интересно, но мы займёмся этим в следующий раз. Сейчас у нас есть другие дела...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 101100226,
					"content": "Я такого не знаю.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100212,
					"content": "Вы семья или...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100213
					]
				},
				{
					"id": 101100213,
					"content": "Мы с мистером Помидоркой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100214
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100214,
					"content": "Мы просто лучшие друзья и живём вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100215
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100215,
					"content": "Поздоровайся с ребятами, мистер Помидорка! Они тоже тебя видят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 101100207,
					"content": "Привет. Можно отвлечь тебя на минуточку?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				}
			]
		},
