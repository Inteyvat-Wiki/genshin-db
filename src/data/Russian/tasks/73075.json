			"dialogs": [
				{
					"id": 730750201,
					"content": "#Нара {NICKNAME}, с тобой Праздник Утсава такой же, как и с нарой Варуной... Давненько не было так весело... У-у-у...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
