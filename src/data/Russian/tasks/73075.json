			"dialogs": [
				{
					"id": 730750101,
					"content": "#Нара {NICKNAME} и Паймон, спасибо вам! Теперь в питомниках Ванараны растёт випариас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730750102,
					"content": "Випариас здесь весела. Аракара счастлив.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730750103,
					"content": "#Праздник Утсава подошёл к концу. Прежде чем золот{M#ой}{F#ая} нара покинет Ванарану...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730750104,
					"content": "Вам дают випариас.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#Весёлый випариас для золот{M#ого}{F#ой} нары. Надеюсь, что нара {NICKNAME} и Паймон тоже будут веселы. Випариас не увядает со временем, но...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Аранакула"
				},
				{
					"id": 730750106,
					"content": "Не забывайте хоть иногда с ним разговаривать. А лучше музыку исполнять для него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Аракара"
				},
				{
					"id": 730750107,
					"content": "#Земля и аранары вас не забудут. Надеюсь, что нара {NICKNAME} и Паймон тоже будут нас помнить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Аранакула"
				}
			]
		},
