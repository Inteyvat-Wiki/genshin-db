			"dialogs": [
				{
					"id": 711280201,
					"content": "«Когда это дерево немного подрастёт, я сорву его листья и заварю вам чай.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
