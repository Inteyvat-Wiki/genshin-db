					"nextDialogs": [
						710800632
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710800632,
					"content": "Ну это немного перебор...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800633
					]
				},
				{
					"id": 710800633,
					"content": "Ничего. А теперь, если вы мне позволите, я бы сочинил историю тех девяти рыцарей...",
