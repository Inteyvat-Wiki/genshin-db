				"points": []
			},
			"dialogs": [
				{
					"id": 710800601,
					"content": "Это может показаться немного неожиданным, добрый герой, но не можешь ли ты уделить мне минутку и рассказать мне одну-две свои истории, чтобы я сложил из них песни для тех, кто придёт после?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800602,
						710800603
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710800602,
					"content": "Ну, если тебе нужны только истории...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "Я был бы очень признателен! Я весь внимание!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710800603,
					"content": "У меня куча историй.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				}
			]
		},
