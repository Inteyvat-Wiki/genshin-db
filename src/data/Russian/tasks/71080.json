				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710800701,
					"content": "Спасибо вам за то, что помогли мне закончить эту эпическую поэму... Ах, да. Пожалуйста, примите эту копию моей рукописи в качестве благодарности!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800702
					],
					"speakerTitle": "Талиесин"
				},
				{
					"id": 710800702,
					"content": "Уф... В этой эпической поэме соединились мои чувства и устремления. Пожалуйста, возьми. Это то немногое, чем я могу отплатить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Талиесин"
				}
			]
		},
		{
			"id": 7108008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
