			},
			"dialogs": [
				{
					"id": 207420101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "Ах! Мои одуванчики! Они все разлетелись!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420103,
					"content": "Ты что делаешь? Мне стоило большого труда их вырастить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420104,
					"content": "Я помогаю семенам разлететься как можно дальше...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "Но мы ведь в городе! Куда они полетят, если на пути окажутся стены?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420106,
					"content": "Таким образом вырастет ещё больше одуванчиков...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "Почему бы тебе не взять немного семян одуванчиков и развеять их за городом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420108,
					"content": "Ай, мои одуванчики! Вырастить их было совсем непросто...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420109,
					"content": "#Ах ты... Если тебе нужны одуванчики, иди за город и нарви их сам{F#а}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420110,
					"content": "#Это ведь те одуванчики, которые ты помог{F#ла} мне собрать. Я о них заботилась, поливала... Зачем ты с ними так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Флора"
				}
			]
		},
		{
