				},
				{
					"id": 207420502,
					"content": "#Ну что, ты уже собрал{F#а} семена одуванчиков?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420503
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420503,
					"content": "Вот, держи.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420504
					]
				},
				{
					"id": 207420504,
					"content": "...Спасибо. Я потом посажу их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420505
					],
					"speakerTitle": "Флора"
				},
				{
					"id": 207420505,
