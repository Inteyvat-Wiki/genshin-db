	"talks": [
		{
			"id": 1204201,
			"completionStepIds": [
				1204202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204202",
							"2"
						],
						"stepId": 1204202,
						"stateName": "QUEST_STATE_UNFINISHED"
