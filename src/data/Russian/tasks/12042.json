				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420101,
					"content": "Кто-то не в духе... Позвольте угадать, вы запутались и хотите, чтобы я помогла?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420102
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420102,
					"content": "Надеюсь, вы понимаете, как вам повезло. Будь на вашем месте кто-то другой, не стала бы я после стольких ваших просьб изображать на лице улыбку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420103
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420103,
					"content": "...Но ты же и так всегда улыбаешься!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420104,
					"content": "Это метафора, ясно? Неслыханная дерзость - придираться к моим словам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420105
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420105,
					"content": "Паймон, давай к делу...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420106
					]
				},
				{
					"id": 120420106,
					"content": "Ой, да, да! Случилось такое! Такое! Эи... она... она...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420107,
					"content": "Вы рассказываете Яэ Мико о том, что случилось...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420108
					]
				},
				{
					"id": 120420108,
					"content": "О, я понимаю. Значит, Эи решила оставить Инадзуму людям, а сама ввязалась в жестокую битву, которая неизвестно когда закончится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420109
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420109,
					"content": "Ужасно упрямая, сразу прибегает к самым крайним мерам, которые только можно себе представить, и полагает, что её воля сможет довести всё до конца, несмотря на почти невыполнимую цель на пределе возможностей... Да, это похоже на Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420110
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420110,
					"content": "Вы, как и я, знаете, что она всегда такой была. Чего же вы сейчас разволновались?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420111,
						120420112
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420111,
					"content": "Ну, эта битва серьёзнее, чем всё, что было раньше.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				},
				{
					"id": 120420113,
					"content": "Бросилась без раздумий... Хе-хе. М-да, иногда она ведёт себя как ребёнок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420114
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420114,
					"content": "И, значит, вы отчего-то решили, что я могу вам помочь. И откуда у вас такие мысли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420115
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420115,
					"content": "Она что, нас разыгрывает? Она это нарочно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420116
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420116,
					"content": "А ты, кроха, умнеешь не по дням, а по часам. Но правда такова, что я не очень-то много знаю о пространстве сознания Райдэн Макото.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420117
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420117,
					"content": "Мне известно только то, что это основа Священной сакуры. Ещё говорят, оно отличается от Царства эвтюмии Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420118
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420118,
					"content": "Это потому, что Райдэн Макото больше нет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420119
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420119,
					"content": "Не только из-за этого. Природа самого пространства чем-то отличается... Но я могу только строить предположения. Вы там были, вот и скажите, на что это было похоже?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420120,
						120420121
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420120,
					"content": "Никакой разницы.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420122,
					"content": "Не будем вдаваться в подробности. Просто потом это будет сложновато объяснить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420123
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420123,
					"content": "Начнём с главного. Идёмте ко входу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420121,
					"content": "Не до этого было.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420112,
					"content": "И она бросилась в неё без раздумий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				}
			]
		},
		{
			"id": 1204202,
			"completionStepIds": [
				1204204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204204",
							"2"
						],
						"stepId": 1204204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Яэ Мико"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420201,
					"content": "Я всегда нахожу решения. Вопрос смекалки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420202
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420202,
					"content": "Для чужаков пространство сознания - это очень абстрактное понятие. К счастью, я фамильяр Эи, так что могу определить её приблизительное местонахождение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420203
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420203,
					"content": "Другими словами, даже если я не могу определить местоположение пространства сознания, я могу отправить вас к Эи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420204
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420204,
					"content": "Выходит, это абстрактно, но имеет своё местоположение, которого ты не знаешь, но можешь нас туда отправить... Так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420205,
					"content": "И не пытайся понять. Простыми словами, сейчас она погружена в хаос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420206
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420206,
					"content": "Всё словно в бурном потоке... Если вы попытаетесь силой пробиться внутрь, вас может смыть гигантская волна, которая унесёт вас в любое место пространства и времени.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420207
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420207,
					"content": "Именно поэтому, входя в Царство эвтюмии, гораздо безопаснее сначала поместить своё сознание в физический объект.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420208
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420208,
					"content": "Что? Тогда Паймон остаётся здесь. Идите туда сами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420209,
						120420210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420209,
					"content": "Размечталась!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				},
				{
					"id": 120420211,
					"content": "Как тебе угодно. В худшем случае мы всего лишь потеряем Эи. Что за печаль?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420212
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420212,
					"content": "Вы... вы... Паймон сыта вами по горло! Ладно, ладно, Паймон пойдёт с вами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420213
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420213,
					"content": "Да? Ну раз вы решили, то сейчас я вас туда отправлю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420214
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420214,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420215
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420215,
					"content": "А? Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420216
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420216,
					"content": "Что такое?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420217
					]
				},
				{
					"id": 120420217,
					"content": "О, ерунда. Просто всё в таком беспорядке. Мои подозрения подтвердились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420218
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420218,
					"content": "Кстати, когда будете входить, сосредоточьтесь на своих искренних желаниях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420219
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420219,
					"content": "Только достаточно сильная воля может помешать гигантским волнам абстрактного пространства поглотить вас. Только если вы достаточно сильны, я смогу отправить вас в нужное место.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420220
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420220,
					"content": "Ясно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420221
					]
				},
				{
					"id": 120420221,
					"content": "Проход открыт. В путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420222
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420222,
					"content": "Я останусь снаружи и постараюсь обеспечить наибольшую стабильность. Если что, я вас подстрахую.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420223
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420223,
					"content": "#Доверяю мою богиню тебе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420224
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420224,
					"content": "От себя лично и от лица жителей Инадзумы... прошу тебя, верни её.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420225
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420225,
					"content": "Мико, надеюсь, ты знаешь, что делаешь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420226,
					"content": "Мы справимся.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420227
					]
				},
				{
					"id": 120420227,
					"content": "Довольно болтовни. За работу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420210,
					"content": "Паймон, ты же меня не бросишь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				}
			]
		},
		{
			"id": 1204203,
			"completionStepIds": [
				1204206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204206",
							"2"
						],
						"stepId": 1204206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сёгун Райдэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420302
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420302,
					"content": "Как такое может быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420303
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420303,
					"content": "Вы... вы вернулись. Но как вам это удалось? И почему вы не изменились за эти годы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420304
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420304,
					"content": "За эти годы? Ты о чём?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420305
					]
				},
				{
					"id": 120420305,
					"content": "Эта битва навевает воспоминания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420306
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420306,
					"content": "Это как если бы мы вернулись в тот момент, когда впервые были установлены законы вечности. Твоя воля сегодня так же сильна, как и тогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420307
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420307,
					"content": "Ни одного поражения в битве. Ни мига колебаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420308
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420308,
					"content": "Если бы я заставила всех врагов вечности восстать против тебя, ты бы не дрогнула.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420309
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420309,
					"content": "Я восхищаюсь твоей твёрдой приверженностью правилам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420310
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420310,
					"content": "Ты не посрамила звание Защитника вечности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420311
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420311,
					"content": "Теперь эти двое снова вернулись в это пространство. Возможно, это проявление неизбежной судьбы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420312
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420312,
					"content": "Тогда пусть это будет нашим последним поединком и завершением того, что началось пятьсот лет назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420313
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420313,
					"content": "Решающая битва? Значит, ты наконец-то...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420314
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420314,
					"content": "#Отойди, путешественни{F#ца}{M#к}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420315
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420315,
					"content": "Ты собираешься положить всему конец?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420316
					]
				},
				{
					"id": 120420316,
					"content": "Я собираюсь положить начало чему-то новому.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёгун Райдэн"
				}
			]
		},
		{
			"id": 1204204,
			"completionStepIds": [
				1204208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204208",
							"2"
						],
						"stepId": 1204208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сёгун Райдэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420401,
					"content": "Всё кончено. Ты победила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420402
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420402,
					"content": "Я была уверена, что ты не способна преодолеть прошлое, но вера моя не имела почвы. Я недооценила твой дух.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420403
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420403,
					"content": "Но воля, которую нельзя сокрушить, не имеет возможности охватить будущее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420404
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420404,
					"content": "Тебе не нужно беспокоиться о будущем, и ты не одинока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420405
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420405,
					"content": "Мне ли не знать о твоей силе. Если бы я рассчитывала только на свою силу, то проиграла бы я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420406
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420406,
					"content": "И всё же причина, по которой я сражалась, предопределила мои способности и границы. И я несу тысячи взоров, устремлённых к свету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420407
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420407,
					"content": "При мысли об этом я чувствую странные перемены в Мусо иссин.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420408
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420408,
					"content": "Клинок, который я унаследовала от Макото, кажется, пытается направлять меня... воодушевлять.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420409
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420409,
					"content": "Я тоже заметила. В пылу битвы он, казалось, высвободил новую и незнакомую силу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420410
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420410,
					"content": "И сила эта за пределами моего понимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420411
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420411,
					"content": "Этот клинок принадлежал Мак{RUBY#[D]Предыдущий Электро Архонт}ото. Возможно, он откликается всей своей мощью, только когда я по-настоящему понимаю и принимаю неё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420412
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420412,
					"content": "Когда я использовала Мусо иссин, я почувствовала, что она снова со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420413
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420413,
					"content": "Это было одновременно знакомое и странное чувство... Макото не брала в руки оружие, и всё же её клинок приближает меня к ней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420414
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420414,
					"content": "Я даю своё согласие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420415
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420415,
					"content": "Твоя нынешняя воля не была порождена эрозией. Я не помешаю тебе изменить правила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420416
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420416,
					"content": "Отныне это тело станет твоим помощником.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420417
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420417,
					"content": "Я больше не буду создавать правил, которых нельзя изменить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420418
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420418,
					"content": "Ты олицетворяла моё прошлое, но теперь ты - это я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420419
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420419,
					"content": "Макото никогда не принимала меня за бесстрашное оружие. И я не должна видеть в тебе только лишь инструмент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420420
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420420,
					"content": "Хех, а ты и правда изменилась. Полагаю, люди называют это «вырасти».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420421
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420421,
					"content": "Я понимаю. Я стану твоей тенью. Такой, какой ты была для Макото.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420422
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420422,
					"content": "Мои обязанности не изменятся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420423
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420423,
					"content": "Но как воин я с нетерпением буду ждать подобных битв.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420424
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420424,
					"content": "Ты так говоришь, потому что не можешь смириться со своим поражением?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420425
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420425,
					"content": "Просто это были совершенно новые для меня ощущения, и я хочу испытать их снова.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420426
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420426,
					"content": "Значит, битва окончена? По-настоящему?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420427
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420427,
					"content": "Хм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420428
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420428,
					"content": "Мусо иссин светится?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420429
					]
				},
				{
					"id": 120420429,
					"content": "Привет, Эи. И все, кто стал свидетелем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420430
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420430,
					"content": "Я Райдэн Макото, предыдущий Электро Архонт, которая не справилась со своими обязанностями и бросила всех в разгар бед.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420431
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420431,
					"content": "Макото?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420432
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420432,
					"content": "Я так рада. Вы проделали такой путь, но я знала, что вы справитесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420433
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420433,
					"content": "Я оставила частичку своей воли в Мусо иссин. В тот миг, когда ты высвободишь всю его силу, я тоже буду свободна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420434
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420434,
					"content": "Это не самый простой способ, но... ты так укоренилась в своих мыслях, что никого не стала бы слушать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420435
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420435,
					"content": "У меня не было времени ждать перемен в тебе. Прошу, прости меня... Мне оставалось лишь придумать, как дождаться твоего прихода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420436
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420436,
					"content": "Но ты никогда не говорила мне об этом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420437
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420437,
					"content": "Всё случилось так неожиданно... Мне жаль.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420438
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420438,
					"content": "Всё это время мне было ужасно стыдно за то, что я бросила Инадзуму на тебя вот так второпях.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420439
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420439,
					"content": "Этим истинам я должна была учить тебя постепенно, тогда бы ты не стремилась так к «забвению».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420440
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420440,
					"content": "Ты знала, что должно было произойти в Каэнри'ах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420441
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420441,
					"content": "У меня было ощущение. Это место... это было не то место, которое Архонт может игнорировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420442
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420442,
					"content": "В моей нынешней форме я совсем не воспринимаю время. Я не знаю, как долго мы были в разлуке и не знаю, что пережила Инадзума.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420443
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420443,
					"content": "Но я знаю, насколько тяжёл этот путь был для тебя. Наверняка тебе не раз хотелось заплакать, правда же?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420444
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420444,
					"content": "...Не надо так со мной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420445
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420445,
					"content": "Видишь, ты признаёшь это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420446
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420446,
					"content": "Я подумала об этой возможности и оставила тебе подарок... Что-то, что может облегчить боль Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420447
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420447,
					"content": "Вот, возьми, пока не растворился последний лоскут моего сознания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420448
					],
					"speakerTitle": "Макото"
				},
				{
					"id": 120420448,
					"content": "Но именно тебе предстоит сделать важнейший шаг...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Макото"
				}
			]
		},
		{
			"id": 1204205,
			"completionStepIds": [
				1204209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204209",
							"2"
						],
						"stepId": 1204209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Сёгун Райдэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420501,
					"content": "Покинув пространство сознания и вернувшись в храм, вы рассказываете всё Яэ Мико...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420502
					]
				},
				{
					"id": 120420502,
					"content": "Значит, Эи из настоящего посадила Священную сакуру в пространстве сознания, а она проросла в Инадзуме прошлого...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420503
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420503,
					"content": "Это просто невероятно, как ни крути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420504
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420504,
					"content": "Всё это благодаря силе Макото. Её понимание вечности гораздо глубже моего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420505
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420505,
					"content": "Вечность - это понятие, тесно связанное со временем. Когда вы прикасаетесь к вечности, понятие времени становится условным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420506
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420506,
					"content": "В том пространстве так много удивительного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420507
					]
				},
				{
					"id": 120420507,
					"content": "Время одновременно двигалось вперёд и назад.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420508
					]
				},
				{
					"id": 120420508,
					"content": "Место, где время не имеет смысла, не понять обычной логикой... Значит, это и был тот самый бурный поток, который я почувствовала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420509
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420509,
					"content": "Наверное, поэтому вы благополучно вернулись в этот момент.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420510
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420510,
					"content": "И всё же ощущение хаоса пропало.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420511
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420511,
					"content": "Я ещё не до конца понимаю. Но моя интуиция подсказывает мне, что причина всему... то семя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420512
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420512,
					"content": "Хм... Я не уверена, что это была только сила Макото...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420513
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420513,
					"content": "Я понимаю, о чём ты. Возможно, в это действительно была вовлечена высша{RUBY#[D]Астарот}я сила. Как бы то ни было, её решение спасло всех нас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420514
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420514,
					"content": "Без Священной сакуры Инадзума погрязла бы в бедствиях ещё столетия назад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420515
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420515,
					"content": "Я знаю, ты и раньше чувствовала, что в Священной сакуре есть что-то особенное. Но для меня она существовала всегда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420516
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420516,
					"content": "Ты пыталась убедить меня в существовании связи между Священной сакурой и сознанием Макото, но у тебя не вышло, так ведь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420517
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420517,
					"content": "Нет, не вышло. Но теперь я понимаю почему - Священная сакура не была ещё даже посажена.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420518
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420518,
					"content": "М-м-м, но вам не кажется, что дерево выглядело совсем не так, как сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420519
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420519,
					"content": "Священная сакура растёт на моей территории. Разумеется, я могу подрезать её на свой вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420520
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420520,
					"content": "Уф... Диктаторские замашки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420521
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420521,
					"content": "Я шучу. Это дерево прошло через многое с тех пор, как проросло. Благодаря любовной заботе кицунэ, оно имеет свой теперешний облик.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420522
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420522,
					"content": "Разумеется, и я внесла свой вклад.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420523
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420523,
					"content": "Можно сказать, что между моментом, когда вы вышли из этого пространства, и моментом, когда вы снова вошли в него, прошло очень мало времени. Но в то же самое время внутри происходили столетия борьбы, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420524
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420524,
					"content": "#Путешественни{F#ца}{M#к}, если я правильно догадываюсь... всё это время у тебя в мыслях были твои желания?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420525,
						120420526
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420525,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420527
					]
				},
				{
					"id": 120420527,
					"content": "В то время я могла чувствовать местонахождение Эи, но я также чувствовала, как аномально текло время в том пространстве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420528
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420528,
					"content": "То есть время добавило совершенно новое измерение в наши поиски. Просто определить местоположение было недостаточно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420529
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420529,
					"content": "К счастью, ваша воля была достаточно сильна, чтобы поток перенёс вас в тот момент времени, в котором пересекались все ваши желания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420530
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420530,
					"content": "Поток вполне мог быть вызван Макото, но потребовались совместные усилия, чтобы в конечном счёте помочь Эи. Так что на этот раз, похоже, мы должны поблагодарить вас.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420531
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420531,
					"content": "Значит... мы неслучайно попали на решающую битву? Нам было предопределено стать свидетелями?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420532,
						120420533
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420532,
					"content": "Кажется, именно это и хотела сказать сёгун...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420534
					]
				},
				{
					"id": 120420534,
					"content": "#Я думала, что течение времени было одинаковым как внутри, так и снаружи. Поэтому для меня было большим потрясением, когда путешественни{F#ца}{M#к} появил{F#ась}{M#ся} вновь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420535
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420535,
					"content": "Моей первой мыслью было: «Неужели Инадзуму постигла великая беда?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420536
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420536,
					"content": "Но оказалось, вы хотели спасти меня... Вы пришли ради меня, чтобы помочь мне победить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420537
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420537,
					"content": "Большое спасибо вам обоим. Я никогда не забуду, что вы для меня сделали.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420538
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420538,
					"content": "Эи, как ты себя чувствуешь сейчас?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420539
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420539,
					"content": "Моё тело полностью восстановилось, и воля сёгуна больше не борется против меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420540
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420540,
					"content": "Рада слышать, что ты в добром здравии. Но, вообще-то, я спрашивала о твоих эмоциях. Тебе стало легче?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420541
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420541,
					"content": "Ты видела там Макото, да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420542
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420542,
					"content": "Не совсем. Я лишь слышала её голос...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420543
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420543,
					"content": "Со мной всё будет в порядке. Это всего лишь воспоминания. Я уже приняла решение двигаться вперёд.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420544
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420544,
					"content": "И я должна сказать, это ещё раз напомнило мне о том, какой великолепной была Макото. Ещё тогда она предсказала все возможные варианты развития Инадзумы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420545
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420545,
					"content": "И в своём плане она даже учла мою незрелость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420546
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420546,
					"content": "И только благодаря ей Инадзума стоит и по сей день.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420547,
						120420548
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420547,
					"content": "Да, Макото была великолепной.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420549
					]
				},
				{
					"id": 120420549,
					"content": "Я всего лишь посадила зерно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420550
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420550,
					"content": "Без твоей и её воли ничего бы не вышло.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420551
					]
				},
				{
					"id": 120420551,
					"content": "Да! И только благодаря твоим действиям ты смогла увидеть её снова. Потрясающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420552,
						120420553
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420552,
					"content": "Заключительный шаг может быть простым...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420554,
						120420555
					]
				},
				{
					"id": 120420554,
					"content": "Даже если причины и следствия поменялись местами...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420556
					]
				},
				{
					"id": 120420556,
					"content": "#Спасибо тебе, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420557
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420557,
					"content": "Сегодня ты и Инадзума наконец выходите из тени событий прошлых веков.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420558
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420558,
					"content": "Макото и ты - прошлое и будущее Инадзумы, и вы обе незаменимы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420559
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420559,
					"content": "Редко можно услышать столь утешительные слова. Я с благодарностью принимаю их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420560
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420560,
					"content": "Да ладно, ты думаешь, что это редкость, потому что раньше не слушала ни слова из того, что я говорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420561
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420561,
					"content": "И Макото так сказала.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420562
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420562,
					"content": "Великие умы мыслят одинаково, да? Интересно, дает ли мне это право пару дней побыть сёгуном?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420563
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420563,
					"content": "Хотя нет, забудь. Слишком много хлопот.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420564
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120420564,
					"content": "Пошутили - и хватит. Нам предстоит ещё много работы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420565
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420565,
					"content": "Мы с сёгуном внимательно осмотрим Инадзуму, чтобы понять, что здесь сейчас происходит. И подумаем о будущем.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420566
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420566,
					"content": "После этого... я отменю указ Сакоку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420567
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420567,
					"content": "Правда? Это большое событие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420568
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120420568,
					"content": "Я больше не стремлюсь к вечности, основанной на застое. И теперь нет необходимости держать народ под замком.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420569
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420569,
					"content": "Я не сомневаюсь, что Инадзуме предстоит ещё много испытаний...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420570
					],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420570,
					"content": "Но из проблем рождаются новые возможности.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420571
					]
				},
				{
					"id": 120420571,
					"content": "Я очень на это надеюсь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Сёгун Райдэн"
				},
				{
					"id": 120420555,
					"content": "...ты не должна недооценивать свою роль.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420556
					]
				},
				{
					"id": 120420553,
					"content": "...но этот шаг - результат огромных усилий.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420554,
						120420555
					]
				},
				{
					"id": 120420548,
					"content": "Но и ты, Эи, многое сделала.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420549
					]
				},
				{
					"id": 120420533,
					"content": "От судьбы не убежишь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420534
					]
				},
				{
					"id": 120420526,
					"content": "Разве это важно?",
