			"dialogs": [
				{
					"id": 721150201,
					"content": "Надеюсь, на этом всё и закончится...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
			"id": 7211503,
			"completionStepIds": [
				7211508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211508",
							"2"
						],
						"stepId": 7211508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "#Ты расставил{F#а} маячки?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150302,
					"content": "Да.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "Отлично. Теперь лишь осталось дождаться, пока они соберут все данные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150304,
					"content": "А откуда ты знаешь, где их нужно расставлять?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "Я же входил в команду проектировщиков горна. Разместив маячки в этих точках, можно получить практически всю информацию о происходящем внутри.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150306,
					"content": "Хм-м, знаешь если мы поставим в этих местах очистные устройства, наши проблемы будут решены в мгновение ока.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150307,
					"content": "Господин Флуа выйдет из себя и будет в ярости, когда узнает о сложившейся ситуации...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150311,
					"content": "Ладно, спасибо за помощь. Пожалуйста, возьми это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150312,
					"content": "Кхе-кхе... Хм-м... А ещё через какое-то время мне придётся попросить тебя вернуть эти маячки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150313,
					"content": "У меня нет Глаза Бога, а потому я не могу находиться в зонах, в которых бушует энергия Татаригами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150314,
					"content": "Кроме того, Фатуи всё ещё там. Вряд ли на всём острове есть хоть один человек, кроме тебя, способный справиться с ними и в то же время разобраться с горном.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150308,
					"content": "А эти маячки продаются?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150309
					]
				},
				{
					"id": 721150309,
					"content": "Да ты шутишь! Даже если бы я тебе их продал, какой тебе от них прок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150310
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150310,
					"content": "Хотя если ты когда-нибудь соберёшься в Фонтейн, я могу познакомить тебя с человеком, который их продаёт.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Ксавье"
				}
			]
		}
