	"talks": [
		{
			"id": 7211501,
			"completionStepIds": [
				7211502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211502",
							"2"
						],
						"stepId": 7211502,
						"stateName": "QUEST_STATE_UNFINISHED"
