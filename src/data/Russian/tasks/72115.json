				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ксавье"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#Приветствую тебя, {M#мой дорогой мальчик}{F#моя дорогая девочка}! У меня есть две новости про горн Микагэ: хорошая и плохая. Какую ты хочешь услышать первой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150102,
					"content": "Начни с хорошей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "Хорошая новость в том, что ядро пострадало совсем чуть-чуть. И починить его вполне в моих силах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150104,
					"content": "А вот и плохая новость: Фатуи, которые там ошиваются, кажется, не очень рады хорошей новости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150105,
					"content": "Они, очевидно, ищут способ наложить свои грязные лапы на ядро Татаригами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150111,
					"content": "Но если мы позволим и дальше там бесчинствовать, мы можем утратить контроль над силами Татаригами. И весь этот остров взлетит на воздух вместе с нами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150112,
					"content": "Но если мы займёмся только Фатуи, энергия, накопленная куполом, всё равно достигнет критического значения...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150113,
					"content": "Значит, нам придётся одновременно заняться и щитом, и ими?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "Хм-м. В целом, технически и сугубо субъективно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150115,
					"content": "Перед нами стоят две проблемы: Фатуи и Татаригами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150116,
					"content": "Но судя по тому, как развивается ситуация, мы в ходе решения первой проблемы, скорее всего, столкнёмся со второй.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150117,
					"content": "Следовательно, в нашей ситуации необходимо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150118,
					"content": "Ты хотел сказать «да».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "Э-э, да, абсолютно верно. Мы должны решить обе проблемы одновременно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150120,
					"content": "Но давай не будем торопить события. Как говорят в Ли Юэ, «торопливый не съест горячий тофу».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150121,
					"content": "Ты знаешь пословицы из Ли Юэ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "Я бывал в Ли Юэ. Я считаю этот образчик мудрости прекрасным сувениром с той поездки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150123,
					"content": "У меня есть много таких сувениров и из других краёв. Хотя, должен признаться, сувениры из Мондштадта я уже все выпил... Было очень вкусно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150124,
					"content": "Вернёмся к делу. У меня есть крохотный планчик, чтобы разрешить эту ситуацию с горном Микагэ, но мне потребуется твоя помощь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150125,
					"content": "Так точно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "#Ха! {M#Решителен и готов}{F#Решительна и готова} к бою!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150131,
					"content": "Кхе-кхе... Вернёмся к теме. Возьми, пожалуйста, эти сенсорные маячки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150132,
					"content": "Твоя задача: установить их в разных местах.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150133,
					"content": "Эти маячки могут собирать данные о дисперсии и плотности энергии Татаригами в горне Микагэ. Обладая этими данными, я смогу разработать более подробный план.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150134,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "В этом я полагаюсь на тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150141,
					"content": "#Я отмечу на твоей карте места для маячков. Я рассчитываю на тебя, путешественни{F#ца}{M#к}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150136,
					"content": "Как работают эти маячки?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "Вот самое простое объяснение. Эти инструменты используют силу элементов, чтобы оценить и обсчитать все прочие виды энергии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150138,
					"content": "Я говорю простое, но объяснить это не так просто... Но, полагаю, начать можно с теории семи элементов! Итак...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150139,
					"content": "Нет-нет, продолжать не стоит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "Как пожелаешь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150127,
					"content": "Так, а мне что от этого будет?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "Хм-м... Как насчёт неоткрытых сокровищ этого мира и кое-каких остаточных материалов из горна Микагэ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150129,
					"content": "Я не сомневаюсь, что внутри горна найдётся что-то достойное твоего внимания - это же самый большой завод во всей Инадзуме и вообще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150130,
					"content": "Конечно, как человек без Глаза Бога, я не смогу войти в горн Микагэ и узнать, что там происходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150106,
					"content": "Эх... Давай начнём с плохой.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "Плохая новость заключается в том, что Фатуи всё ещё безобразничают в горне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150108,
					"content": "Они, очевидно, ищут способ наложить свои грязные лапы на ядро Татаригами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150109,
					"content": "А хорошая новость в том, что ядро пока не получило серьёзного ущерба, и я могу его отремонтировать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "Ксавье"
				},
				{
					"id": 721150110,
					"content": "Фатуи наверняка были бы не в восторге, услышав это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Ксавье"
				}
			]
		},
		{
			"id": 7211502,
