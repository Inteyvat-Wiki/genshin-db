			"dialogs": [
				{
					"id": 3532801,
					"content": "Ого! Чувствуешь мощь стихий этого мира?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532802,
					"content": "#Ты всего лишь прикоснул{M#ся}{F#ась} к статуе и сразу получил{F#а} силу ветра!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532803,
					"content": "Всякому в этом мире, кто хочет завладеть властью, сделать это не так легко, как тебе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532804,
					"content": "Думаю, я знаю, в чём дело...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "Да! Это всё потому, что ты родом из другого мира!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532809,
					"content": "Если мы продолжим идти на запад, то дойдём до Мондштадта, города свободы!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532817,
					"content": "Ещё Мондштадт называют городом ветра. Его жители поклоняются Анемо Архонту.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532810,
					"content": "Может теперь, когда Анемо Архонт даровал тебе силу, стоит продолжить поиски в Мондштадте?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532811,
					"content": "#А ещё в городе много бардов. Возможно, кто-то из них слышал о тво{M#ей сестре}{F#ём брате}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532812,
					"content": "Ну всё, пойдём скорей!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532813,
					"content": "Стихии ответили на твои мольбы. Паймон думает, что это хороший знак.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 3532807,
					"content": "Не к добру это всё.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "#Ты долж{M#ен}{F#на} быть благодар{M#ен}{F#на} Архонтам за эту силу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Паймон"
				}
			]
		}
	]
