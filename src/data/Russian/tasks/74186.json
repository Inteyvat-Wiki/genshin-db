			"dialogs": [
				{
					"id": 741860301,
					"content": "Доминус Кассиодор, доминус Кассиодор... Это вы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741860303,
					"content": "Верно, это действительно вы. Вы наконец-то вернулись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860304,
					"content": "Мне было приказано охранять эту крепость, но жестокие вишапы и варвары оказались слишком свирепыми. Я был вынужден постепенно отступать, пока не оказался здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860305,
					"content": "Кажется, с тех пор прошло много-много лет... Какие новости? Мы победили?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741860307,
					"content": "...Правда? Тогда мы проиграли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860308,
					"content": "Мне очень жаль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741860309,
					"content": "Не говорите так, уважаемый доминус. Когда я вступил в легионы севаста, я думал, что этот день настанет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860310,
					"content": "Разве севаст не сказал, что поможет нам освободиться от оков Фортуны? Но так ли просто это сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860311,
					"content": "В конце концов мы сражаемся против судьбы, а бросить вызов судьбе не под силу даже великим богам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860312,
					"content": "В итоге все усилия оказываются напрасными...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741860313,
					"content": "Нет, доминус. Когда-то мы подняли мечи на само провидение, и нашими действиями бросили вызов законам небес. Мы восстали против пророчества...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860314,
					"content": "Мы всё равно потерпели неудачу... Должно быть, кто-то нас предал, поэтому мы сбились с пути...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860315,
					"content": "Результат уже не имеет значения. Что бы ни случилось, наши деяния будут вписаны в историю мира...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Безымянный голем"
				},
				{
					"id": 741860316,
					"content": "Эй, почему он внезапно упал? Разве каменные люди могут потерять сознание?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741860317,
					"content": "Я не знаю его имени... Кажется, его история закончилась.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Осси"
				},
				{
					"id": 741860318,
					"content": "Это так печально! Неужели он сражался здесь тысячелетия?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741860319,
					"content": "Теперь он наконец-то обрёл покой. Давайте продолжим путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Осси"
				}
			]
		}
	]
}