			"dialogs": [
				{
					"id": 761290101,
					"content": "Ещё раз благодарю вас за помощь Гильдии, босс Нефер, госпожа Ягода.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 761290102,
					"content": "Обычное сотрудничество, ничего особого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290103,
					"content": "Это так, но я всё равно хочу поблагодарить босса Нефер за готовность помочь Гильдии со... сложными изысканиями.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Сарин"
				},
				{
					"id": 761290104,
					"content": "Гильдия искателей приключений также отправила на помощь немало людей - это взаимовыгодное сотрудничество.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290105,
					"content": "Надеюсь, господин Сарин, что и в дальнейшем наше сотрудничество будет таким же приятным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290106,
					"content": "Не беспокойтесь, босс Нефер, Гильдия искателей приключений...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Сарин"
				},
				{
					"id": 761290107,
					"content": "О... точнее отделение Гильдии искателей приключений в Нод-Крае - надёжный партнёр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Сарин"
				},
				{
					"id": 761290108,
					"content": "Да, я заметила.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290109,
					"content": "(Ладно-ладно, давай так и сделаем. Босс Неф, не смотри на меня, не смотри на меня, не смотри на меня...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761290110,
					"content": "Ягода, почему ты молчишь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290111,
					"content": "(Всё-таки посмотрела на меня! Только не смотри на доску поручений, не смотри на доску поручений, не смотри на доску поручений...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761290112,
					"content": "А? Я... мне нечего сказать... Спасибо за... поручение?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761290113,
					"content": "Спасибо за помощь, госпожа Ягода. Без вас у Гильдии накопилась бы целая груда бумаг.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Сарин"
				},
				{
					"id": 761290114,
					"content": "Не стоит благодарности... я получаю зарплату, и это моя работа...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761290115,
					"content": "(Ох, она снова забыла все те фразы, которым я её учила...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290116,
					"content": "Раз уж мы здесь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290117,
					"content": "(Нет, не надо! Обстановка такая хорошая. Босс, пожалуйста, оставь меня в покое!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761290118,
					"content": "Господин Сарин, пожалуйста, принесите последнюю партию поручений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290119,
					"content": "Ягода, выбери одно поручение, которое, по-твоему, нужно выполнить в первую очередь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290120,
					"content": "Подумай хорошенько и не торопись с выбором, хорошо?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Нефер"
				},
				{
					"id": 761290121,
					"content": "Д-да, босс...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Ягода"
				},
				{
					"id": 761290122,
					"content": "(А-а-а, всё пропало! Пропало!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ягода"
				}
			]
		}
	]
}