							"2100701",
							"3"
						],
						"stepId": 2100701,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юань Чэн"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Пфф, тоже мне братья! Они думают только о том, как бы забрать лучшие находки себе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Юань Чэн"
				},
				{
					"id": 210070302,
					"content": "Отец на старости лет тоже ничего не заметил... Или сделал вид, что ничего не заметил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Юань Чэн"
				},
				{
					"id": 210070303,
					"content": "До них ещё не дошло, что сокровища в шахте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Юань Чэн"
				},
				{
					"id": 210070304,
					"content": "Я должен поскорее заграбастать сокровища... И убраться восвояси!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юань Чэн"
				}
			]
		},
		{
			"id": 2100704,
			"completionStepIds": [
				2100713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100713",
							"2"
						],
						"stepId": 2100713,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100701",
							"3"
						],
						"stepId": 2100701,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юань Лян"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Хе-хе! Сокровища будут моими!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Юань Лян"
				},
				{
					"id": 210070402,
					"content": "Мои братцы такие придурки... Они только услышали про сокровища и сразу бросились на поиски.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Юань Лян"
				},
				{
					"id": 210070403,
					"content": "Чтить волю отца? Ба! В его наставлении есть только одна стоящая строчка. И она говорит о том, что сокровища будут моими. Кстати... Скоро сокровища будут моими! Ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юань Лян"
				}
			]
		},
		{
			"id": 2100705,
			"completionStepIds": [
				2100714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
