			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070101,
					"content": "«...Одинокое древо стоит сиротливо... Но за суровой скалой скрывается золото... Объединитесь, чтобы получить благословение... Открываю вам это богатство: чтите волю своего отца...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Потерянные записи"
				}
			]
		},
		{
			"id": 2100702,
			"completionStepIds": [
				2100712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100712",
							"2"
						],
						"stepId": 2100712,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100701",
							"3"
						],
						"stepId": 2100701,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юань Цин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "О нет! Чем я это заслужил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Юань Цин"
				},
				{
					"id": 210070202,
					"content": "Мне наконец удалось сбежать, пока они не смотрели. Я мог бы первый добраться до шахты и найти сокровища... Но откуда взялись все эти монстры?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Юань Цин"
				},
				{
					"id": 210070203,
					"content": "Всё пропало...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юань Цин"
				}
			]
		},
		{
			"id": 2100703,
			"completionStepIds": [
				2100711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100711",
