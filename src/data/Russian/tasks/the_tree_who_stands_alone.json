			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юань Хун"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "Ушли... Они все ушли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Юань Хун"
				},
				{
					"id": 210070502,
					"content": "Юань Цин, Юань Лян, Юань Чэн... Глупые дети. Посмотрите повнимательней, да подумайте хорошенько.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юань Хун"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
							"3"
						],
						"stepId": 2100708,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Юань Цин"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Эй, смотри! Мы уже видели этих ребят.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 210070602,
					"content": "Одинокое древо стоит сиротливо... Ха-ха, верно. В одиночку ничего не добиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Юань Цин"
				},
				{
					"id": 210070603,
					"content": "Разлетелись без ветра багряные листья... Если бы я мог доверять отцу и братьям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Юань Чэн"
				},
				{
					"id": 210070604,
					"content": "По белому свету разбрелись сыновья... Сокровища... Всё пропало... Из-за сокровищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Юань Лян"
				},
				{
					"id": 210070605,
					"content": "Под густой тенью древа соберётся вся семья... Дети, мы когда-то были семьёй...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Юань Хун"
				},
				{
					"id": 210070606,
					"content": "Ты в самом деле спрятал сокровища в шахте? Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Юань Хун"
				},
				{
					"id": 210070607,
					"content": "Но сокровище действительно существует... Помните дерево, которое мы посадили, когда вы были детьми?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Юань Хун"
				},
				{
					"id": 210070608,
					"content": "Каждый год я здесь что-то закапываю. Надеюсь, когда вы вырастете, мы выкопаем это что-то вместе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Юань Хун"
				},
				{
					"id": 210070609,
					"content": "И устроим потом пир с угощениями и напитками... Соберёмся всей семьёй... Поболтаем о старых добрых временах...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Юань Хун"
				},
				{
					"id": 210070610,
					"content": "Детишки, дорогие мои детишки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Юань Хун"
				}
			]
		}
	]
}