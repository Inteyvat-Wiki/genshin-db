			},
			"dialogs": [
				{
					"id": 742490201,
					"content": "Ах! Сколько ни наслаждайся неспешным послеобеденным чаепитием, оно никогда не надоест.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 742490202,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 742490204,
					"content": "Эх... Время радости так быстротечно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Фурина"
				},
				{
					"id": 742490203,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
}