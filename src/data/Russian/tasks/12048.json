			"dialogs": [
				{
					"id": 120480101,
					"content": "Здравствуйте! Сейчас я вас запишу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "Хякудзицухаку Сион"
				},
				{
					"id": 120480102,
					"content": "Что происходит, откуда столько клиентов? Надо было пускать не всех...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "Сиба Мурасаки"
				},
				{
					"id": 120480103,
					"content": "Ого! Стоило решить проблему с Эмурой Итигэнсаем, и дела у бани пошли на лад! И Сион с Мурасаки поправились!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120480104,
					"content": "#{NICKNAME}, Паймон, доброе утро! Вы пришли записаться?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480105,
					"content": "Да! Если можно, на сегодня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120480106,
					"content": "Тогда надо выдать вам новое приглашение. Вы ведь для нас особые гости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480107,
					"content": "Ха-ха, отлично! Тогда особый гость Паймон первым делом займётся деликатесами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120480108,
					"content": "Ох, а если бы ты прислушалась к моему совету и продала акции? Ты едва не потеряла такой прибыльный бизнес. Надеюсь, ты не винишь меня, подруга?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480109,
					"content": "Почему я должна тебя винить? Я не собиралась прислушиваться к твоему совету.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480110,
					"content": "Да, я так соскучилась по твоим ласковым интонациям...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480111,
					"content": "Опять ты появляешься как из-под земли!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120480112,
					"content": "#Доброе утро, {F#малышки}{M#малыши}. Красивый вчера вечером был вид?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480113,
					"content": "Ты подсматривала?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "Что ты... Дерево, которое вы себе облюбовали, растёт прямо у Великого храма Наруками. Или мне ради вас Великий храм передвинуть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480115,
					"content": "Леди Гудзи, чем мы обязаны твоему визиту?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480116,
					"content": "Гм... Считай, что мне захотелось прогуляться. И заодно передать тебе весточку из комиссии Тэнрё.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480117,
					"content": "Жизнь молодого человека, которого вчера вечером достал из воды один из твоих сородичей, теперь вне опасности. Хотя его интеллект откатился до уровня маленького ребёнка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480118,
					"content": "Могло быть и хуже... Да, я должна поблагодарить тебя, леди Гудзи. Мы вышли победителями из вчерашнего противостояния во многом благодаря твоей помощи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480119,
					"content": "Ммм?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480120,
					"content": "Это не я...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "Перестань, Мико. Из нас двоих ты хуже умеешь скрывать свои мысли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480122,
					"content": "Признаю, рядом с тобой я чувствовала себя неполноценной и хотела показать, чего я стою. Но именно эти чувства и подтолкнули меня открыть бани.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480123,
					"content": "Чувство неполноценности помогает мне сохранять трезвость рассудка, а желание доказать свою состоятельность даёт силы не сдаваться. Я готова принять эти части себя, не нужно ходить вокруг них на цыпочках.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480124,
					"content": "#Гм... Могла бы и раньше сказать. Тогда {F#малышкам}{M#малышам} не пришлось бы столько стараться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480125,
					"content": "Думаю, всё было к лучшему. И я понимаю, какие мотивы были у тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480126,
					"content": "Эмура Итигэнсай собрал вокруг себя огромную армию последователей. Для Гудзи Великого храма Наруками было рискованно выступать против него открыто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480127,
					"content": "Разгневанная толпа его последователей могла нанести серьёзный ущерб репутации Великого храма... Для Гудзи лучше, чтобы её имя здесь не было замешано. Ты приняла верное решение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480128,
					"content": "Ты верно говоришь, но всё-таки для меня чувства старой подруги важнее. Иначе я бы действовала более открыто.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480129,
					"content": "Мико...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480130,
					"content": "Ты всё такая же, очень интересная особа, но очарования тебе не хватает... Похоже, зря я боялась тебя огорчить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 120480131,
					"content": "...Я тоже иногда огорчаюсь и унываю. Это бывает с каждым. Но от любого огорчения есть своё лекарство.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120480132,
					"content": "Вот ваше приглашение, не потеряйте.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мидзуки"
				}
			]
		},
