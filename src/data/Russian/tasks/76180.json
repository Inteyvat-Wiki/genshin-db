			},
			"dialogs": [
				{
					"id": 761800801,
					"content": "Мы так весело поиграли! Давай встречаться почаще.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761800802,
					"content": "(Посидим ещё немного.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800804,
					"content": "Уже уходишь? Ну хорошо, тогда увидимся в следующий раз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761800803,
					"content": "Думаю, чаепитие пора заканчивать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Марионетка"
				}
			]
		}
	]
