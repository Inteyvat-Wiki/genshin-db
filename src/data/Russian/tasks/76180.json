			"trigger": {
				"objectNames": [
					"Субретка"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "Что?! Как такое возможно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800602,
					"content": "Ты проиграла, Сандроне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761800603,
					"content": "Я... я тебе поддалась!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800604,
					"content": "Правда? Тогда почему ты так расстроилась?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761800605,
					"content": "Вот же... Сыграем ещё раз!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800606,
					"content": "Хм, проще простого.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800607,
					"content": "Я проиграла. Ты и правда хороша, Сандроне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761800608,
					"content": "В следующий раз покажу тебе игры посложнее. Я знаю много интересных математических игр.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800609,
					"content": "Давай! Ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761800610,
					"content": "Эй, а что тут смешного?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800611,
					"content": "Раньше тебя редко можно было увидеть в таком весёлом настроении. И ты никогда не предлагала мне поиграть, наоборот, чаще прогоняла меня прочь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 761800612,
					"content": "Эй... Ты так говоришь, будто я только и делала, что обижала тебя! Ладно, буду приглашать тебя на чаепития почаще!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Марионетка"
				},
				{
					"id": 761800613,
					"content": "Давай! Мне очень нравится проводить время с тобой за чаем, Сандроне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Субретка"
				}
			]
		},
