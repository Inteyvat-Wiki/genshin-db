			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Катерина"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "#Путешественни{F#ца}{M#к}, подойдите, пожалуйста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240102,
					"content": "Мне очень неловко отнимать у вас время, но могу я поинтересоваться, не хотите ли вы принять новое поручение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240103,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "По последним данным Гильдии, хиличурлы стали собираться группами и блокировать торговые пути.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240106,
					"content": "Мы отправили несколько человек на разведку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240107,
					"content": "Искатели приключений обнаружили среди хиличурлов одного очень странного...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240108,
					"content": "Мы предполагаем, что этот странный хиличурл взбудоражил остальных хиличурлов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240114,
					"content": "Поэтому нам нужно, чтобы кто-нибудь схватил или выгнал того странного хиличурла.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240109,
					"content": "#Путешественни{F#ца}{M#к}, вы заинтересованы в этом поручении?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240110,
					"content": "Конечно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "Спасибо вам! Я уже сделала отметку на вашей карте!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240113,
					"content": "В этом месте часто появляются хиличурлы. Пожалуйста, начните расследование отсюда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240115,
					"content": "Если встретите того странного хиличурла... Пожалуйста, будьте осторожны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Катерина"
				},
				{
					"id": 700240111,
					"content": "Буду иметь в виду.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "Что за поручение?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
						],
						"stepId": 7002404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Элла Маск",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "Хорошо, что мы пришли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "С тобой всё в порядке?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "Фух... Пронесло! Как хорошо, что вы пришли...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240204,
					"content": "Эх...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240205,
					"content": "Всё шло гладко, я делала успехи... Но потом оказалось, что та фраза была неверной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240206,
					"content": "Как бы то ни было... Спасибо, что пришли на помощь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240207,
					"content": "Она выглядит несчастной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700240208,
					"content": "В конце концов вы видели, что случилось.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240223,
					"content": "Идти и самой общаться с хиличурлами действительно слишком опасно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240210,
					"content": "Вот как...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "Я могу тебе чем-нибудь помочь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "Жаль, что редкая возможность поговорить с хиличурлом пропала впустую...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240212,
					"content": "Кажется, работа над словарём откладывается в долгий ящик...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240213,
					"content": "Я помогу тебе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "Если бы кто-то мог подтвердить достоверность этих записей вместо меня...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240214,
					"content": "П-правда?! Замечательно! Обязательно возьми с собой эту книгу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240215,
					"content": "Ого... Сразу командный тон появился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700240217,
					"content": "В теории?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "Если столкнётесь с какими-то трудностями в общении, воспользуйтесь словарём, и всё встанет на свои места... Ну, в теории...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240218,
					"content": "Значит, Маск сама не знает, что написала?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700240219,
					"content": "Только дилетант будет задавать такие вопросы! Научное исследование не было подтверждено на практике, откуда мне знать, насколько оно достоверно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240225,
					"content": "Эх... Ладно, ты всё равно не поймешь, что я хочу сказать. Но я действительно благодарна вам двоим за спасение моей жизни.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700240221,
					"content": "Конечно, пойдём!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "Ну, пошли...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "Если вы не против, позвольте мне вместе с вами пойти на переговоры с хиличурлами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "Элла Маск"
				}
			]
		}
	]
}