			"dialogs": [
				{
					"id": 747060101,
					"content": "...А эта?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 747060102,
					"content": "Кажется, чего-то не хватает...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747060103,
					"content": "Коломбина? Фурина? Что делаете?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747060104,
					"content": "Мы с режиссёром Фуриной проводим... «кастинг»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 747060105,
					"content": "Ну, ты права. Только вот актёров мы выбираем среди рыб в аквариуме.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747060106,
					"content": "Рыбы тоже могут быть актёрами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747060107,
					"content": "Ну, животные-актёры сейчас не редкость. Мы хотим выбрать рыбку с подходящим характером, чтобы снять несколько атмосферных кадров для фильма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747060108,
					"content": "Правда, мы отсмотрели всех рыб, но ни одна не подходит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747060109,
					"content": "#Может, попросим {M#путешественника}{F#путешественницу} и Паймон? Они способны решить любую проблему.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 747060110,
					"content": "Приятно, что ты так нам доверяешь... но в этом вопросе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747060111,
					"content": "Найти вам новых кандидатов?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Отличная мысль! Ведь вы управляете океанариумом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747060114,
					"content": "То есть нам нужно обращать внимание на таланты, когда в следующий раз будем нырять? Кажется, ничего сложного.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747060115,
					"content": "Тогда решено! Чуть позже я расскажу, какие рыбки нам нужны.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Фурина"
				},
				{
					"id": 747060116,
					"content": "Значит, теперь вы охотники за талантами?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "Субретка"
				},
				{
					"id": 747060117,
					"content": "Ты столько новых слов узнала, когда начала общаться с Фуриной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 747060112,
					"content": "Может, устроим кастинг прямо под водой?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
}