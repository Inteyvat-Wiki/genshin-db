			},
			"dialogs": [
				{
					"id": 750230301,
					"content": "Хм? Хочешь, чтобы я повторил?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "Акатанга"
				},
				{
					"id": 750230302,
					"content": "А можешь повторить, что нужно сделать?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "Сначала давай разместим реквизит. Поставь бочки <color=#00E1FFFF>в центре сцены, но не закрывай фигуры главных героев и задний план</color>. Потом размести элементальную приманку <color=#00E1FFFF>там, откуда появляется враг</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "Акатанга"
				},
				{
					"id": 750230304,
					"content": "Далее жди подходящего момента и <color=#00E1FFFF>замани врага к бочке</color>. Потом отойди в безопасное место и <color=#00E1FFFF>разбей бочку</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Акатанга"
				},
				{
					"id": 750230305,
					"content": "Не нужно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "Спасибо. Желаю удачи!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Акатанга"
				}
			]
		},
