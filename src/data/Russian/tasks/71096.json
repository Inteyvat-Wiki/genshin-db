			"dialogs": [
				{
					"id": 710960101,
					"content": "Нашли староцветы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960102,
					"content": "Вот.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Му Нин",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "Ещё три староцвета.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960202,
					"content": "Я с благодарностью приму староцветы, представленные нашими двумя доблестными энтузиастами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960203,
					"content": "Не ожидал, что вы так быстро отыщете камни. И даже лучше, чем те, что я видел раньше.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960204,
					"content": "Эх... Они мне напоминают о том, что и у меня раньше был один.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960205,
					"content": "У тебя был староцвет?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710960206,
					"content": "Зачем же тогда нас отправил на поиски?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "Я же сказал, что раньше был староцвет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960209,
					"content": "Мой отец однажды перевозил партию руды в зале Шэнлу. Этот камень был всего лишь остатком, и его качество было плохим, поэтому он отдал его мне как игрушку.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960210,
					"content": "В те времена мы часто ссорились. Я не желал работать. И что ещё хуже, я проводил большую часть своего времени в чайном доме «Яньшан». Так я погряз в долгах и был загнан в угол...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960211,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710960212,
					"content": "Как-то это странно...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "Ну, кто по молодости не делал глупостей? В общем, когда выхода у меня не осталось...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960214,
					"content": "Кто-то распознал староцвет у меня в руках и предложил хорошую цену. Это был просто камень, но за него я мог получить немного моры и выйти сухим из воды.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960215,
					"content": "Но вот несколько дней назад отец вдруг вспомнил о камне и спросил: «Му Нин, а где же тот камень, который я тебе дал?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960216,
					"content": "«Это же просто камень, я его давно потерял», - скрепя сердце ответил я.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960217,
					"content": "И хотя я так ответил, я не мог перестать думать о том, что, если бы в ответ на его вопрос я бы вытащил камень...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960218,
					"content": "А сейчас уже нет смысла об этом гадать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960219,
					"content": "Ну хоть непутёвый сын исправился.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 710960220,
					"content": "Ну да... Просто мне предстоит пройти долгий путь, прежде чем я смогу расплатиться с долгами.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960221,
					"content": "Что-то я отвлёкся. В общем, принеси мне камни, если найдёшь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960222,
					"content": "А этих не хватит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "Хм... Принеси ещё три. Этого должно хватить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960225,
					"content": "Староцвет - редкая руда. Если зал Хуэйшань хочет большего, я сильно сомневаюсь, что смогу найти что-нибудь здесь, в Разломе.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Му Нин"
				},
				{
					"id": 710960223,
					"content": "Да сколько же тебе надо?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "Вот и отдал бы сначала свой староцвет.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}