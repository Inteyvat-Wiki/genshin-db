			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "<color=#FFCC33FF>Мир внутри</color> не так уж плох.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "Угу. Это же дом Эснора. Эснору наверняка здесь тоже нравится. Вот только...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790610303,
					"content": "Здесь много близких друзей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Верно! Именно это я и боюсь потерять, вот что меня беспокоит больше всего.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610307,
					"content": "Здесь всё хорошо, даже слишком... Я не хочу, чтобы они изменились или изменился я сам.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610308,
					"content": "Но... Дальнее странствие всё изменит. Ведь так, Розель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610309,
					"content": "Да, так. Я не хочу тебе лгать и уж тем более огорчать, дорогой Эснор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610310,
					"content": "Хорошо. Уверен, мы друг друга поняли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610311,
					"content": "Я обдумаю твоё предложение и приму решение позже... А сейчас давай просто выпьем вместе чаю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610312,
					"content": "Хорошо... Я составлю тебе компанию, Эснор. До следующего плавания ещё далеко. Можем вместе всё обдумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610304,
					"content": "Много красивых цветов.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "И вкусные торты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
							"2"
						],
						"stepId": 7906102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"79061"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "Розель, я хочу отправиться с тобой, но... я не знаю, как подготовиться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610402,
					"content": "Всё просто. Возьми варенье, хлеб и немного любопытства. Надень удобную одежду и возьми запасную.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610403,
					"content": "И наконец, подготовься морально: вполне вероятно, что по пути придётся выбросить часть вещей.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610404,
					"content": "Ох, звучит очень сложно. Я не хочу их выбрасывать. Они мои, они ценны, я люблю их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610405,
					"content": "Когда их у тебя больше не будет, тебе встретятся новые ценные вещи, мой дорогой Эснор.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610406,
					"content": "Поверь мне, это будет незабываемое путешествие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
