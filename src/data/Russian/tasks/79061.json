					}
				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Розель, хватит об этом. Я не отправлюсь с тобой в дальнее странствие.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610102,
					"content": "Мы друзья, и так будет всегда. Ты мне дорог. Но... Просто я не люблю дальние поездки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610103,
					"content": "Эснор, это просто путешествие, тебе нечего бояться.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610104,
					"content": "В мире так много цветов, которых нет в деревне, людей, которых мы никогда не встречали, и даже облака имеют другую форму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610105,
					"content": "Я же привёз тебе семена цветов. Уверен, ты никогда прежде не видел цветов таких форм и расцветок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610106,
					"content": "Пока это всего лишь семя. Нужно сначала посадить его и дождаться, когда распустится цветок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610107,
					"content": "Если ты отправишься со мной в дальнее странствие, то, возможно, мы найдём и сам цветок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610108,
					"content": "Розель... Прости, я не хочу отправляться в дальнее странствие и становиться похожим на путников.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610109,
					"content": "Они только и делают, что беспокоятся о цене ковров, и не обращают внимание на красивые шляпы...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610110,
					"content": "Далёкие странствия вас меняют, и меня это пугает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610111,
					"content": "Так и есть. А ты обратил внимание на карты, образцы растений и исписанные вдоль и поперёк путевые заметки в их чемоданах?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610112,
					"content": "Мы как порыв ветра, кочующий сквозь леса, как река, текущая сквозь озёра... Ищем что-то новое, оставляя позади прошлое.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610113,
					"content": "Далёкие странствия нас меняют. Эти перемены меня пугают, но я также благодарен им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610114,
					"content": "Это как бутерброд, который всегда падает маслом вниз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610115,
					"content": "Значит, я буду есть хлеб и масло по отдельности, так будет даже вкуснее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610116,
					"content": "Отличная идея! И вполне себе можно наесться.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "А вот и вы! Розель рассказывал о красоте большого мира и звал с собой в далёкое странствие...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610119,
					"content": "А вам что-нибудь известно о большом мире? Там... Действительно именно так, как говорит Розель?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610117,
					"content": "Отличный способ! И пол останется чистым.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906101",
							"2"
						],
						"stepId": 7906101,
						"stateName": "QUEST_STATE_UNFINISHED"
