				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Да. В <color=#FFCC33FF>большом мире</color> происходит много всего нового и интересного.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Угу, там полно вкусняшек и веселья, а ещё можно столько всего узнать и встретить потрясающих людей. Например...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790610203,
					"content": "Люди, которые ценят красоту вещей.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Правда? Мне казалось, что в большом мире только и говорят что о «цене», и все хотят надеть шляпу, но не решаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610207,
					"content": "Это... это... как посыпка для торта: у каждой гранулы свой вкус.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790610208,
					"content": "А если все гранулы будут одинаковы на вкус, то торт получится заурядным.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790610209,
					"content": "Отлично сказано, Паймон!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Паймон столько всего услышала, что уже сама начала кое в чём разбираться. Хи-хи, а ведь в этом есть смысл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 790610212,
					"content": "Даже так? Я... Мне нужно подумать... Может, небольшое странствие мне не помешает?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Эснор"
				},
				{
					"id": 790610213,
					"content": "Спешить некуда, Эснор. До следующего плавания ещё далеко. Можем вместе всё обдумать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Розель"
				},
				{
					"id": 790610210,
					"content": "Паймон, ты отлично слилась с окружением...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Великолепные идеалы, которые никогда не померкнут.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "А ещё люди, которые упорно трудятся ради своей мечты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
