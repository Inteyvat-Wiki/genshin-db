					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270903,
					"content": "Почти готово.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270904
					]
				},
				{
					"id": 741270904,
					"content": "Когда сделаешь фотографии, принеси их мне.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
