					}
				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "...Как я подчёркивал ранее, дорогие сотрудники Палаты Жестьон, таковы правила, ничего не могу поделать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270102,
					"content": "Господин Роялт уже отправил перечень всех необходимых документов, эти документы я подготовил.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270103,
					"content": "Однако нельзя просто прийти и забрать документы. Это не соответствует нашим правилам корреспонденции.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270104,
					"content": "Что? Айюн?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Привет, Айюн! Ты отлично выглядишь, ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741270108,
					"content": "За это я благодарен господину Роялту и господину Семану.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270109,
					"content": "#Что? Айюн, {NICKNAME} - {M#твой знакомый}{F#твоя знакомая}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270110,
					"content": "#Разумеется. {NICKNAME} мне как-то раз очень помог{F#ла}. Без {M#него}{F#неё} я бы уже не работал в Палате Жестьон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270111,
					"content": "#В самом деле? Не зря {NICKNAME} - {M#почётный старший исследователь}{F#почётная старшая исследовательница} в нашем Исследовательском институте, ха-ха-ха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270112,
					"content": "#Я всего лишь оказал{F#а} моральную поддержку.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "Как бы то ни было, без вашей поддержки, я бы... я бы не справился...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270115,
					"content": "#Господин Шуазёль обмолвился, что вы {M#почётный старший исследователь}{F#почётная старшая исследовательница} в Исследовательском институте Фонтейна?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270116,
					"content": "Ага, у меня и почётная грамота есть!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "Фотографию сделала Паймон! На снимке есть Паймон, а грамоты у Паймон нет...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 741270118,
					"content": "#Верно. За выдающиеся достижения {NICKNAME} получил{F#а} от Института звание {M#почётного старшего исследователя}{F#почётной старшей исследовательницы}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270119,
					"content": "#Что касается самих достижений... Пусть об этом рассказывает {F#она сама}{M#он сам}. А мы вернёмся к делу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270120,
					"content": "Я совершенно точно не могу передать тебе этот документ прямо сейчас, Айюн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270121,
					"content": "Но ведь ты говорил, что тебе нужен исследователь, чтобы показать дорогу к Исследовательскому институту и сделать несколько снимков на память... Разве не так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270122,
					"content": "#Я считаю, что {NICKNAME} совершенно подходит для такой задачи. Он{F#а} прекрасно ориентируется на местности и с работой справится.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270123,
					"content": "#А что ты думаешь, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270124,
					"content": "Без проблем.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "Благодарю. С вами мне всегда спокойно. Когда я прибыл, то снова встретил неуправляемых меков и злобных чудовищ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270127,
					"content": "Фотографии не самая важная задача... По правде говоря, господин Шуазёль...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270128,
					"content": "Айюн, я тоже хочу тебе помочь. Но правила связывают мне руки. Я всего лишь бюрократ, который ставит печати...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270129,
					"content": "Хорошо, хорошо... Я поговорю об этом с господином Роялтом...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270130,
					"content": "До свидания, господин Шуазёль. Хорошего дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270131,
					"content": "Спасибо. Надеюсь, вам понравится в Исследовательском институте Фонтейна.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Шуазёль"
				},
				{
					"id": 741270132,
					"content": "#{NICKNAME}, побудьте моим гидом. Сначала нам нужно посетить Мемориальный парк Мари-Анн.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270125,
					"content": "С радостью помогу Айюну.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "#Я только починил{F#а} Автозаверитель 3000.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "Могу доставить тебя на планере в кратчайшие сроки.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}! Как я рад встретить вас здесь, вот так совпадение!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Айюн"
				}
			]
		},
