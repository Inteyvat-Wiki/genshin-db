			"dialogs": [
				{
					"id": 741270301,
					"content": "Это и есть Академический зал собраний Института?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270302,
					"content": "Да, конструкция напоминает зал, но что здесь академического?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270303,
					"content": "Академичность у исследователей в головах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Хорошо, я здесь не ради академических интересов. Здание выглядит целым... относительно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270306,
					"content": "Относительно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Кхм. Давайте осмотримся. Мне кажется, это подходящее место для общей фотографии.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270308,
					"content": "Я поищу подходящее место для съёмки, чтобы не оплошать перед господином Роялтом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME}, сделайте несколько снимков, пожалуйста. Я слышал, вы управляетесь с камерой получше меня!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Айюн"
				},
				{
					"id": 741270310,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "Камни уж точно не академические.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
