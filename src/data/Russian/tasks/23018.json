			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Закария"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "Увы, от этого одни проблемы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180102,
					"content": "Нужна помощь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "В последнее время у нас действительно не хватает рабочих рук, и я не отдыхал уже несколько дней.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180120,
					"content": "#Путешественни{F#ца}{M#к}, если у тебя есть время, не {F#могла}{M#мог} бы ты отнести лекарство больным поблизости? Также, пожалуйста, проверь их состояние здоровья.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180121,
					"content": "Я могу помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Спасибо тебе. Слава Архонтам. Мне действительно очень нужна помощь того, кто целый день не будет говорить о благословении Дендро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180123,
					"content": "Ага, слава Архонтам... Кажется, я сам часто так говорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180124,
					"content": "А ты пока отдохни.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Я не могу отдыхать, поскольку разместил пациентов с более серьёзными заболеваниями в другом месте. Мне ещё нужно приготовить для них лекарства.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180126,
					"content": "Увы, эти пациенты обязательно снова спросят меня, что им нужно сделать, чтобы получить благословение Дендро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180127,
					"content": "#Спасибо тебе, путешественни{F#ца}{M#к}. Мне действительно очень нужна помощь того, кто целый день не будет говорить о благословении Дендро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180103,
					"content": "Что здесь произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "#Ты, должно быть, путешественни{F#ца}{M#к}. Это Бимарстан, где помогают обычным людям... гм... распространяя благословение Дендро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180105,
					"content": "Неважно, бедный или богатый, мы оказываем медицинскую помощь всем нуждающимся.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180106,
					"content": "Именно из-за этого в последнее время у нас очень много пациентов, и на самом деле совсем я не успеваю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180107,
					"content": "Увы, даже если милосердие Дендро Архонта к нам безгранично... но бюджет и людские ресурсы больницы ограничены.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180108,
					"content": "Некоторые пациенты совершенно игнорируют рекомендации врача, но продолжают спрашивать, как им лучше принять благословение Дендро Архонта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180109,
					"content": "Ха-ха, благословение Дендро Архонта... Как же!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180110,
					"content": "Если бы Дендро Архонт действительно могла напрямую давать благословение, то они бы никогда не заболели!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180111,
					"content": "...Ох, извини, я не должен был этого говорить. Не рассказывай Гольшан, иначе она снова начнёт ворчать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180112,
					"content": "Разве ты не преданный последователь Дендро Архонта?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "На самом деле да, но разве в Сумеру не все такие?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180114,
					"content": "Но можно заменить слово преданный, я... относительно рациональный последователь Дендро Архонта, ха-ха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180118,
					"content": "Ох... Извините, я, должно быть, слишком устал. Это моё личное мнение, не принимайте его всерьёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180115,
					"content": "Некоторые люди говорят, что лечение это само по себе благословение Дендро Архонта...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "Угу, только не воспринимай эти слова всерьёз, как все больные.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180117,
					"content": "Если Дендро Архонт так всемогущ, то бы просто дал им немного грибов, и они бы исцелились.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Закария"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301802",
							"2"
						],
						"stepId": 2301802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Закария"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "На этот раз лекарство нужно доставить господину Гургену на травяные поля.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180202,
					"content": "Этот парень так усердно работал на днях, что растянул мышцу руки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180203,
					"content": "Отнеси ему это лекарство и заодно скажи, чтобы он сегодня остался дома и помолился Дендро Архонту, а не ходил работать в поле.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180204,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Возвращайся ко мне, когда отнесёшь лекарство. Тебя будет ожидать достойная награда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Закария"
				},
				{
					"id": 230180205,
					"content": "Помолился Дендро Архонту?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "Да ладно, думаешь, иначе он меня послушает? Просто делай, как я говорю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Закария"
				}
			]
		},
		{
			"id": 2301803,
			"completionStepIds": [
				2301803
			],
			"beginWay": "TALK_BEGIN_AUTO",
