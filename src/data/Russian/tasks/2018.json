			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзё Сара",
					"Яэ Мико",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Госпожа Гудзи, я пришла, как и обещала. Не беспокойтесь, я одна. Никто о нашей встрече не знает.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180202,
					"content": "Я знала, что ты сдержишь обещание. Ещё мне кажется... последние несколько дней твоя душа не знала покоя, а ночью не приходил сон.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180203,
					"content": "В-вы ошибаетесь. Я ни за что бы не стала подозревать главу клана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180204,
					"content": "Итак, где доказательства?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180205,
					"content": "У нас.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "О, замечательно. Сегодня прямо-таки день сдержанных обещаний.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180207,
					"content": "Ты не представляешь, через что нам пришлось пройти, чтобы достать их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180208,
					"content": "Передайте Саре. Пусть она сама просмотрит их.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180209,
					"content": "Что это?..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180210,
					"content": "...Печать главы клана Кудзё на месте. На подделку не похоже...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180211,
					"content": "Не понимаю... ни слова о сопротивлении, Сангономии, ситуации на передовой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180212,
					"content": "А как же павшие в боях солдаты, бедствующий народ?.. Они не заслуживают даже упоминания?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180213,
					"content": "Полное пренебрежение к человеческой жизни. Почему они решили это скрыть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180214,
					"content": "Конечно же, ради Охоты на Глаза Бога. Ведь если бы всё это включили в отчёт, сёгун могла пересмотреть указ, не так ли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180215,
					"content": "Значит, комиссия Тэнрё... намеренно вводила сёгуна в заблуждение?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180216,
					"content": "Ну да. Подумай... кому ещё выгодна Охота на Глаза Бога?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180217,
					"content": "Тут ещё есть секретное письмо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "Это письмо от комиссии Тэнрё Фатуи. Глава клана Кудзё скрыл от сёгуна и это.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180220,
					"content": "Ну что? Вещи, которые ты хотела видеть, но в то же время и не хотела видеть, перед тобой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180221,
					"content": "Ты ведь... не закроешь на них глаза?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180222,
					"content": "Всё, во что я верила... всё это... Как они могли... Проклятье!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180223,
					"content": "Предателям нет прощения... Такаюки, пора поговорить начистоту!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180224,
					"content": "Кудзё Сара здорово разозлилась. Значит, переворот удался.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180225,
					"content": "Армия сёгуната временно лишилась командующего.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Да, бежим за ней тогда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180228,
					"content": "#Постой, путешественни{F#ца}{M#к}. Мне нужно кое-что тебе сказать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180229,
					"content": "Да?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180230,
					"content": "#Впервые ты {F#попала}{M#попал} в Царство эвтюмии перед статуей всевидящего божества, верно?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180231,
					"content": "Верно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "Постарайся воссоздать обстоятельства того дня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180233,
					"content": "Если всё получится, и сёгун Райдэн раскроет тебе своё сердце, у тебя появится возможность...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180234,
					"content": "Я сделаю всё, что в моих силах.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Вот, надень. Это прощальный подарок.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180236,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180237,
					"content": "Омамори Великого храма Наруками, сильный амулет. Я отложила этот для тебя.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180238,
					"content": "Спасибо...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Хе-хе, в трудную минуту просто достань и посмотри на него. Может статься так, что все трудности разрешатся легко и быстро.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180241,
					"content": "Ты, конечно же, можешь достать его, когда соскучишься по мне. И тогда, кто знает, вдруг я предстану перед тобою.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180242,
					"content": "#Будет тебе, госпожа кицунэ. Сейчас не время с {F#путешественницей}{M#путешественником} шутки шутить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180243,
					"content": "Хе-хе-хе... прошу прощения. Что же, тебе пора встретиться с моей нерадивой подругой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Яэ Мико"
				},
				{
					"id": 20180239,
					"content": "Я буду дорожить им.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "Если мы последуем за ней, будет возможность увидеть сёгуна.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201805",
							"2"
						],
						"stepId": 201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзё Сара"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "Вы следовали за мной? Хватило же вам смелости.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180302,
					"content": "Поскольку вы свидетели, я смогу защитить вас от ареста. По меньшей мере, пока не услышу от Такаюки объяснений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180303,
					"content": "Но... если сказанное вами ранее окажется клеветой, вас ждёт не только арест, но и обвинение в ещё одном преступлении.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180304,
					"content": "Понятно.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "Хм. Ладно.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180305,
					"content": "Показывай дорогу.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Кудзё Такаюки",
					"Кудзё Сара",
					"Паймон"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "Стой! Сара, ты совсем спятила? Как ты посмела ослушаться моего приказа?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180404,
					"content": "Господин...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180405,
					"content": "Спрашивай! Не дай ему запугать тебя!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180406,
					"content": "...Господин Такаюки, я видела отчёт комиссии и письмо для Фатуи... пожалуйста, скажите, почему?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180407,
					"content": "Так это ты выкрала документы и письмо? Хм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180408,
					"content": "Означает ли это, что... эти бумаги настоящие? Вы писали их собственной рукой?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180409,
					"content": "Прошу, господин, я должна знать... Правда ли, что комиссия Тэнрё... предала сёгунат?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180410,
					"content": "Хм-м... Да, я веду дела с Фатуи, и отчёт, который ты видела, написан моей рукой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180411,
					"content": "Даже отпираться не стал...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180412,
					"content": "Дипломаты Снежной предложили щедрую награду, а взамен попросили лишь сохранить Охоту на Глаза Бога в силе...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180413,
					"content": "У клана Кудзё всегда было много завистников. Множество кланов свергло бы нас при первой возможности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180414,
					"content": "И когда появилась возможность в одночасье заручиться поддержкой сильного государства и сокрушить врагов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180415,
					"content": "Мне показалось, что это отличная сделка. Я просто не счёл нужным сказать тебе, Сара.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180416,
					"content": "Но вы... вы же всегда почитали сёгуна. Как вы можете так спокойно говорить о предательстве?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180417,
					"content": "Предательстве? Разве это считается предательством?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180418,
					"content": "Фатуи думают, что используют меня, но на деле всё наоборот! Что они могут сделать?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180419,
					"content": "Когда в Инадзуме грянет гром, они упадут на колени, дрожа от страха.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180420,
					"content": "В конце концов...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180421,
					"content": "Могуществу сёгуна Райдэн и Мусо но хитотати нет равных!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180422,
					"content": "Он не собирался предавать сёгуна...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Да... он преклоняется не столько перед сёгуном Райдэн, сколько перед её боевой мощью, особенно Мусо но хитотати. Чуть ли не до фанатизма...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180425,
					"content": "Но... как же ваша преданность?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180426,
					"content": "С момента удочерения вы учили меня преданности подданных своему господину...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180427,
					"content": "Выходит, вы хотели моей преданности лишь для клана Кудзё, и боялись, что я однажды предам вас, так?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180428,
					"content": "Каков лицемер! Всеми этими добродетелями вы просто хотели скрыть свой отвратительный эгоизм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180429,
					"content": "Эгоизм? Я стою на страже вечности клана Кудзё. Уверен, сёгун поняла бы меня, как и бывший глава клана.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180430,
					"content": "Паймон не хотелось бы этого говорить, но он зазнался. Клану Кудзё не справиться с Фатуи...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180431,
					"content": "Нет смысла продолжать спорить с ним...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "Я всегда спрашивала себя, правильно ли оставлять указ об Охоте в силе? Даже если он перечит всему, что я знаю о справедливости?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180434,
					"content": "Но я решила подчиниться сёгуну. Сёгун ведёт нас по пути, и пока мы не дошли до цели, никто не может утверждать, что правильно, а что нет.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180435,
					"content": "Но теперь я понимаю, что пути вечности нет конца, и путь этот... был осквернён грязью вашего эгоизма.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180436,
					"content": "Поэтому я расскажу сёгуну всю правду. По крайней мере, моя совесть будет чиста.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180437,
					"content": "Упрямство. Напрасное упрямство...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180438,
					"content": "Иди и доложи сёгуну, если хочешь. Статус клана Кудзё непоколебим, и ничто этого не изменит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180439,
					"content": "Сёгун сейчас в <color=#00E1FFFF>резиденции Тэнсюкаку</color> принимает дипломата из Снежной, Предвестницу по имени Синьора.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Кудзё Такаюки"
				},
				{
					"id": 20180440,
					"content": "Синьора!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "Так за всем стоит Синьора? Тьфу, опять она!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180442,
					"content": "Ещё на острове Рито Тисато что-то говорила о встрече комиссии Кандзё с одной напыщенной дамой... Как же мы не догадались...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180443,
					"content": "Дипломат Снежной... Что же, если она и покинет Инадзуму, то только по частям!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180444,
					"content": "Сара убежала... Думаешь, она просто так возьмёт и войдёт в резиденцию Тэнсюкаку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180445,
					"content": "Не имеет значения. У нас с Синьорой свои счёты.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "Вот именно!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180447,
					"content": "Тогда вперёд!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 20180448,
					"content": "Скорее, в <color=#00E1FFFF>Тэнсюкаку</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Кудзё Сара"
				},
				{
					"id": 20180432,
					"content": "Посмотрим, что скажет Кудзё Сара.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "Он просто чрезмерно уверен в её силе.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
