					"nextDialogs": [
						721340103,
						721340104
					],
					"speakerTitle": "Кадзи"
				},
				{
					"id": 721340103,
					"content": "Что произошло?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721340105
					]
				},
				{
					"id": 721340105,
					"content": "Это форт Мумэи! Форт Мумэи поднялся из моря!",
					"roleType": "TALK_ROLE_NPC",
