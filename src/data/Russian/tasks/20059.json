			"dialogs": [
				{
					"id": 2005906001,
					"content": "За это можно будет выручить неплохую сумму.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005906002
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005906002,
					"content": "Подожди немного. Как только я продам трофеи, ты получишь вознаграждение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005906003
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005906003,
					"content": "Смотри! Кто-то уже заинтересовался...",
