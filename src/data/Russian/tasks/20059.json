				"points": []
			},
			"dialogs": [
				{
					"id": 2005902001,
					"content": "Хм... Я ещё не рассказала тебе, какие товары у нас хорошо продаются. Ты ведь даже не знаешь, что искать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005902002,
					"content": "Например, ты можешь принести мне <color=#00E1FFFF>что-то связанное с хиличурлами</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005902003,
					"content": "Думаю, что трофеи хиличурлов заинтересуют многих искателей приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				}
			]
		},
