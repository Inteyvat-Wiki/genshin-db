			"trigger": {
				"objectNames": [
					"Марджори"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "Плохо... Всё очень плохо...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "#Путешественн{F#ица}{M#ик}! Ты то мне и нуж{F#на}{M#ен}! Ты знал{F#а}, что это моя сувенирная лавка?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590104,
					"content": "Раньше мой отец скупал у путешественников трофеи, а потом продавал их в этой лавке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590105,
					"content": "Но сейчас, когда искателей приключений всё меньше, запасы пополнять сложнее.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590106,
					"content": "К тому же наши товары резко обесценились. Никто больше не хочет их покупать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590107,
					"content": "#Путешественн{F#ица}{M#ик}, тебе наверняка встречаются разные сокровища. Я смогла бы продавать их в лавке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590108,
					"content": "Буду смотреть в оба.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "Спасибо тебе! Я дам тебе хорошую цену за любые трофеи.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590110,
					"content": "За Паймон можно выручить целое состояние...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "Прости, но вряд ли кого-нибудь заинтересует такая покупка.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 200590112,
					"content": "Мои покупатели предпочитают неодушевлённые покупки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Марджори"
				}
			]
		},
