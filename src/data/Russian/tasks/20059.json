			"dialogs": [
				{
					"id": 2005910001,
					"content": "Что это?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 2005910002,
					"content": "Добро пожаловать! У вас отличный вкус! Это самый драгоценный предмет в нашей лавке.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005910003,
					"content": "Это боевой трофей, снятый с тела вождя племени хиличурлов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005910004,
					"content": "Чудовищный монстр угрожал безопасности всего Мондштадта.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005910005,
					"content": "#Даже наше{F#й}{M#му} храбро{F#й}{M#му} путешественн{F#ице}{M#ику} было непросто справиться с таким опасным чудовищем!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005910006,
					"content": "Ого... Похоже, это был серьёзный монстр...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 2005910007,
					"content": "Стоит показать этот трофей Сайрусу. Или Стэнли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 2005910008,
					"content": "Возможно, они наконец станут воспринимать меня всерьёз.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 2005910009,
					"content": "Безусловно! Не переживайте, мы умеем хранить секреты.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005910010,
					"content": "Покупайте прямо сейчас! А то будет поздно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Марджори"
				},
				{
					"id": 2005910011,
					"content": "#Мне надо подумать... Путешественн{F#ица}{M#ик}, это всё правда?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Джек"
				}
			]
		},
