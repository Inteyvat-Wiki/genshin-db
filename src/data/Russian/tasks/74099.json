			"dialogs": [
				{
					"id": 740990101,
					"content": "Расскажи о том, как вместо рыбы тебе на удочку едва не попались монстры...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "А! Если подумать...Это был удивительный опыт! Моя наживка вместо рыбы приманила монстров!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 740990103,
					"content": "Я не особенно боюсь монстров, раньше мне приходилось в одиночку мотаться из Кур-де-Фонтейна в Исследовательский институт и обратно, на пути нередко встречались разбойники, и я никогда не оставалась у них в долгу.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 740990104,
					"content": "Но я избрана главой Ассоциации рыболовов, а значит, должна соответствовать своей должности.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 740990105,
					"content": "Если я распугаю рыбу в округе или помешаю промыслу других рыболовов, это подорвёт мой авторитет главы Ассоциации.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Деларош"
				},
				{
					"id": 740990106,
					"content": "Поэтому я должна действовать осторожно и не пускаться в авантюры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Деларош"
				}
			]
		}
	]
