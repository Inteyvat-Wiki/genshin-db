			"dialogs": [
				{
					"id": 700160101,
					"content": "...Yaya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160102
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700160102,
					"content": "Mimi tomo, mimi mosi mita, Muhe mita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160103
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700160103,
					"content": "Mita?.. Gusha... Dada ika odomu Plata mimi, mimi mosi gusha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160104
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700160104,
					"content": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160105
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700160105,
					"content": "Mani?.. Dada! Kundala zido mi, mi dada, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160106
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700160106,
					"content": "Кажется, им весело...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160107,
						700160108
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 700160107,
					"content": "Неплохо, мисс Маск.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				},
				{
					"id": 700160109,
					"content": "Он действительно неразговорчивый, но я узнала всё, что хотела.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160110
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700160110,
					"content": "Просто помогите ему победить врага. Предоставляю это вам!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160111
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700160111,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700160108,
					"content": "Разговор идёт хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				}
			]
		},
