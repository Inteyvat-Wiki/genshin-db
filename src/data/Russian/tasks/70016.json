			"dialogs": [
				{
					"id": 700160201,
					"content": "Yoyo dada! Mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160202
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700160202,
					"content": "Mimi muhe du, du ya Wei zido dala si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160203
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700160203,
					"content": "Mi mito nye. Mi mito du, du ya mito Wei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160204
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 700160204,
					"content": "Он указал нам на это место. Сказал, что кто-то должен был увидеть это здесь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160205
					],
					"speakerTitle": "Элла Маск"
				},
				{
					"id": 700160205,
					"content": "Valo! Tomo!",
