			"dialogs": [
				{
					"id": 120460201,
					"content": "Мидзуки, мы хотели записаться на следующий раз...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120460202,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "Хякудзицухаку Сион"
				},
				{
					"id": 120460203,
					"content": "Как больно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "Сиба Мурасаки"
				},
				{
					"id": 120460204,
					"content": "Ой! Что с ними такое?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120460205,
					"content": "Они так с самого утра, как проснулись...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "Айкава Сусуму"
				},
				{
					"id": 120460206,
					"content": "...Крайняя степень несварения.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120460207,
					"content": "Но что случилось? Они вчера переели кошмаров?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120460208,
					"content": "Вряд ли... У нас вчера было всего четыре клиента, в том числе вы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "Айкава Сусуму"
				},
				{
					"id": 120460209,
					"content": "Наверное, это те двое...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120460210,
					"content": "Да. С их кошмарами что-то было явно не так. На то, как усваиваются кошмары, влияет не только их количество, но и концентрация негативных эмоций.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120460211,
					"content": "Кошмары такой концентрации у нормальных людей обычно не встречаются.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120460212,
					"content": "Ох...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "Хякудзицухаку Сион"
				},
				{
					"id": 120460213,
					"content": "Ситуация серьёзная. Если не помочь им скорее переварить кошмары...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120460214,
					"content": "Что мы можем сделать? Только скажите!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120460215,
					"content": "Нужно найти вчерашних посетителей. Узнать, откуда у них взялись такие кошмары. Тогда я смогу помочь Сион и Мурасаки их переварить.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}, Паймон, я знаю, вы с ними вчера разговаривали. Скажете, где их найти?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "Мидзуки"
				},
				{
					"id": 120460217,
					"content": "Надо подумать... Да, они ведь говорили, что сегодня снова пойдут к Эмуре Итигэнсаю за духовным руководством! Значит, там их и надо искать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 120460218,
					"content": "Отведите меня туда.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мидзуки"
				}
			]
		},
		{
			"id": 1204603,
			"completionStepIds": [
				1204603
			],
