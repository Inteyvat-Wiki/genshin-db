			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Соруш"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							282.506,
							280.695,
							6348.923
						],
						"pointId": 3306
					}
				]
			},
			"dialogs": [
				{
					"id": 733180201,
					"content": "Вот уж не думала, что они такими станут. Какая жалость.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180202
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180202,
					"content": "Соруш, ты о чём?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180203
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180203,
					"content": "Ни о чём, просто увидела, до чего докатились в итоге некоторые из моих сородичей. Не обращай внимания.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180204
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180204,
					"content": "Ты так сказала, что только интереснее стало!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180205
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180205,
					"content": "Сейчас посмотрим... Ага, там какое-то странное дерево. Свернулось так, что на дверь похоже.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180206,
						733180207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180206,
					"content": "Может, если через неё пройти...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733180208
					]
				},
				{
					"id": 733180208,
					"content": "Что-то прям захотелось попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180209,
					"content": "Деревья фраваши вовсе не двери. Если вы в них полезете, то только потревожите оставшихся пари.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180210
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180210,
					"content": "Так они называются деревьями фраваши? Но что за оставшиеся пари? Не видно же никого!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180211,
					"content": "Тебе-то, конечно, не видно. Они всё ещё цепляются за мысли о прошлом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180212
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180212,
					"content": "Может, они сами этого и не хотят, но видеть, как отчаянно они держатся за этот мир, невыносимо.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180213
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180213,
					"content": "Очень даже пышно выглядит. Разве не красиво?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180214
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180214,
					"content": "Пф, что ты понимаешь, Белая Болталка. Пари, которые до последнего сражались со скверной, отравлявшей землю, использовали остатки сил, чтобы превратиться в деревья фраваши.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180215
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180215,
					"content": "У них не осталось сил, чтобы сохранять свою телесную форму, а оазис Вурукаша отверг их, ведь они были загрязнены скверной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180216
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180216,
					"content": "Легенды гласят, что в древности орден скептиков проводил для них ритуал очищения, чтобы они могли вернуться в оазис Вурукаша.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180217
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180217,
					"content": "Но сейчас в ордене скептиков не осталось никого, кто мог бы провести такой ритуал. Они разве что могут заботиться о деревьях, чтобы те не засохли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180218
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180218,
					"content": "Но это лишь продлевает их страдания. Судя по виду, у них, пожалуй, не осталось ничего, кроме горьких воспоминаний, которые им приходится переносить в одиночестве.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180219,
						733180220
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180219,
					"content": "Тогда мы должны им помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733180221
					]
				},
				{
					"id": 733180221,
					"content": "Да! Нельзя просто бросить их страдать в одиночку!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180222
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180222,
					"content": "Но это, считай, наша, пари, судьба. Возможно, это их желание - защищать землю таким образом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180223
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180223,
					"content": "Ну это мнение Соруш, а они, может, по-другому считают!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180224
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180224,
					"content": "Паймон на их месте, конечно, предпочла бы вернуться вместе со всеми в оазис Вурукаша, а не тут оставаться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180225
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 733180225,
					"content": "Как ты смеешь так пренебрежительно о нас говорить!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733180226
					],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180226,
					"content": "Пф. Ладно. Я разбужу её своей силой и дам вам послушать её затухающий голос.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Соруш"
				},
				{
					"id": 733180220,
					"content": "Значит, есть способ им помочь.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733180221
					]
				},
				{
					"id": 733180207,
					"content": "...окажемся в каком-нибудь другом месте.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733180208
					]
				}
			]
		},
