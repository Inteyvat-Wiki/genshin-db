			"dialogs": [
				{
					"id": 401730501,
					"content": "#{NICKNAME}, меня ищешь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730502,
					"content": "Ритуальный меч я должна вернуть вождю, а всё остальное оставим как есть. Бери любую вещь, которая тебя заинтересует.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730503,
					"content": "У меня есть последний том «Войны миражей»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "М?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730505,
					"content": "И специальное издание спин-оффа «Дела госпожи Орит».",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "Что-о?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730507,
					"content": "Хочешь, почитаем вместе?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Эм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730509,
					"content": "#(Что? Что происходит? Откуда {M#ему}{F#ей} известны названия моих любимых книг? Неужели {M#он}{F#она} тоже ко мне {M#неравнодушен}{F#неравнодушна}?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730510,
					"content": "(Нет, это смешно, какой бред... Наверняка Оророн меня выдал. Паршивец...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730511,
					"content": "#(И всё-таки... {M#Он}{F#Она} запомнил{F#а}, что я люблю... А даже если и не запомнил{F#а}, какая разница. Всё равно это мелочи...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730512,
					"content": "#(Но... Он{F#а} пригласил{F#а} меня почитать вместе! Что делать?! Как отвечать?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730513,
					"content": "Кхм...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Ситлали"
				},
				{
					"id": 401730514,
					"content": "Конечно. Вот закончу с делами, и почитаем. Я дам тебе знать.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ситлали"
				}
			]
		}
	]
}