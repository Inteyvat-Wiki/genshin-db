			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "Смотри, <color=#00E1FFFF>Меч ослепительной доблести</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120402,
					"content": "Ты уверен? Выглядит простовато...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120403,
					"content": "Чего это хиличурлы водят хоровод вокруг какого-то мусора?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120404,
					"content": "(Хм... Кажется, кто-то закинул этот меч в кучу барахла, которой они и так уже поклонялись...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120405,
					"content": "И правда, он в ужасном состоянии! И очень простой... У меня нет слов.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101120406,
					"content": "Хм... Послушай, Джек, ты когда-нибудь видел кристальных бабочек Анемо, которые летают за городом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120407,
					"content": "Если бы ты увидел одну средь бела дня, ты бы и глазом не повёл. Но если бы ты увидел её во тьме ночи... Её блестящее сияние завораживает, а полёт напоминает изысканный танец светящегося драгоценного камня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120408,
					"content": "Разве храбрость не то же самое? Когда всё идёт своим чередом, она кажется ненужной, отходит на второй план. Но когда ты в отчаянном положении, храбрость разжигает в тебе мужество и заставляет дать отпор. Это яркий луч света, который ведёт тебя из тьмы.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120409,
					"content": "Слова льются словно мёд.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "Святые Архонты, ты прав! Это наверняка и есть Меч ослепительной доблести!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101120413,
					"content": "Ага. Меч мы нашли, осталось найти щит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120414,
					"content": "Давайте осмотримся, он наверняка где-то <color=#00E1FFFF>в ущелье Дадаупа</color>... Что?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120415,
					"content": "Там кто-то есть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120416,
					"content": "Стэнли? Что он здесь делает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120417,
					"content": "Очень странно...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120418,
					"content": "Что случилось? Почему вы остановились?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101120419,
					"content": "Ничего. Мы просто увидели хорька-барахольщика, разбрасывающего мору.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120420,
					"content": "Что? Где? Я тоже хочу посмотреть!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101120421,
					"content": "В другой раз. Нам ещё нужно найти щит.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120410,
					"content": "Поразил, как гром средь бела дня.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "#Я почти поверил{F#а}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011206",
