			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Венти"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "Спасибо! Большое спасибо, ребята! Не могу поверить, что у меня получилось найти и меч, и щит!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101121002,
					"content": "Мама! Папа! Посмотрите на это легендарное оружие!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101121003,
					"content": "Эй, постой!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121004,
					"content": "Что насчёт вина, которое ты пообещал? Я ведь тоже старался...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121005,
					"content": "Хм? Что ты здесь делаешь, Стэнли? Вышел погулять?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121006,
					"content": "А? ... Ха-ха! Ха-ха-ха! Что ты здесь делаешь, бард? Как удивительно, что мы здесь встретились. Ты... тоже вышел на прогулку?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101121007,
					"content": "Ага, вышел перед сном подышать воздухом. А вообще, мы помогаем нашему другу кое-что найти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121008,
					"content": "(Паймон перестаёт сомневаться в том, что Стэнли может быть мошенником...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101121009,
					"content": "(Я тоже так думаю...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "(Мог ли Стэнли спрятать здесь меч и щит специально, чтобы не ранить чувства Джека?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101121012,
					"content": "Опытные искатели приключений хорошо знакомы с ущельем Дадаупа. Особенно, ты, ведь здесь проходили твои сражения?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121013,
					"content": "Конечно, само собой! Я могу ориентироваться здесь с завязанными глазами!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101121014,
					"content": "Вот это да... Тогда я правда завидую твоей памяти.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121015,
					"content": "От великого искателя приключений другого и не ждут! А вы, ребята, были бы поосторожнее, здесь полно хиличурлов!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101121016,
					"content": "А теперь... мне пора! Бывайте, молодёжь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "Стэнли"
				},
				{
					"id": 101121017,
					"content": "Мне кажется, его мучает совесть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101121018,
					"content": "Не нужно было тогда столько хвастаться перед Джеком...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121019,
					"content": "Но всё же... Этот человек очень заинтересовал меня.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121020,
					"content": "Он не может отпустить прошлое и полностью пренебрегает настоящим...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121021,
					"content": "Мне интересно... Если бы такому человеку нужно было сделать шаг навстречу будущему, какой бы путь он выбрал?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121022,
					"content": "Что ты имеешь в виду?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101121023,
					"content": "Ха-ха, веду беседу с самим собой.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121024,
					"content": "#Знаю! {NICKNAME}, пойдём поспрашиваем в <color=#00E1FFFF>«Доле ангелов»</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Венти"
				},
				{
					"id": 101121010,
					"content": "(Не может быть, а точно.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
