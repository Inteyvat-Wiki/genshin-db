				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Хиличурл"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Смотри, <color=#00E1FFFF>Щит сияющей воли</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120602,
					"content": "Врушка! Это ведь обычная деревяшка!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120603,
					"content": "Обычная деревяшка с ручкой... Кто вообще такое назовёт щитом?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120604,
					"content": "К тому же на ней есть брызги вина. Уверен, что это просто крышка от винной бочки...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Джек"
				},
				{
					"id": 101120605,
					"content": "И всё же моя бардовская интуиция говорит, что это и есть Щит сияющей воли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120606,
					"content": "Настоящий щит должен быть покрыт шрамами, как и тело храброго воина, защищающегося им.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120607,
					"content": "Конечно, тот щит, что никогда не участвовал в битве, будет в идеальном состоянии. Разве не сломанный и расколотый щит помогает доблестно сражаться своему владельцу?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120608,
					"content": "Тело настоящего воина, даже будучи уставшим, неустанно сражается до победного конца, пока вся кровь не истечёт из организма. Разве такая удивительная выносливость не является подлинным доказательством силы воли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120609,
					"content": "Венти прав!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "Если так подумать, то ты прав... Где вы видели, чтобы щит был чистеньким и новеньким после битвы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120613,
					"content": "Хорошо, тогда... Может, если мы попросим вежливо, он отдаст нам этот Щит сияющей воли?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120614,
					"content": "Кхм-кхм... Здравствуйте, мистер хиличурл!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 101120616,
					"content": "#Упс! Давай лучше ты, {NICKNAME}! Надеюсь, к этому времени ты уже выучил{F#а} хоть немного хиличурлского. Если нет, то всегда можно объясниться жестами...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120617,
					"content": "Хочешь, я тебе заплачу за этот щит?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 101120623,
					"content": "Ой. Похоже, ему это <color=#00E1FFFF>не понравилось</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120624,
					"content": "#Вот, хочешь этот свежий цвето{F#че}к?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 101120628,
					"content": "Хм, кажется, всё идёт <color=#00E1FFFF>гладко</color>, и у нас ещё получится договориться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120631,
					"content": "Венти - петь. Ты щит - давать.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "Я? Так уж и быть, сыграю что-нибудь...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "Венти"
				},
				{
					"id": 101120634,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120635
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 101120635,
					"content": "Хм, кажется, всё идёт <color=#00E1FFFF>гладко</color>, и у нас ещё получится договориться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120633,
					"content": "Mani nini Biaodomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120636
					]
				},
				{
					"id": 101120636,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120637
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 101120637,
					"content": "Ой. Похоже, ему это <color=#00E1FFFF>не понравилось</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120625,
					"content": "Я подарю тебе маску хиличурла.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120629,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120630
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 101120630,
					"content": "Ой. Похоже, ему это <color=#00E1FFFF>не понравилось</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120626,
					"content": "Kucha pupu gusha ye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "Пожалуйста, отдай нам щит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "Vin plata dada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "Хиличурл"
				},
				{
					"id": 101120621,
					"content": "Хм, кажется, всё идёт <color=#00E1FFFF>гладко</color>, и у нас ещё получится договориться...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 101120610,
					"content": "Я тоже думаю, что это щит.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "Венти сегодня жжёт.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				}
			]
