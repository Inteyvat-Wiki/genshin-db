		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "«...Практикую технику \"Путь светлого жала\". По ошибке уничтожил все манекены... Ни денег, ни материалов... У меня есть идея. Я свяжу солому и сделаю собственные манекены...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080302,
					"content": "«Собираю солому».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080303,
					"content": "«Связываю солому. Устал».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080304,
					"content": "«...Практикую технику \"Путь светлого жала\". По ошибке уничтожил все манекены... Я мог бы сначала потренироваться с мечом».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080305,
					"content": "(Читать дальше)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "«...Скучно. Сидя во дворе, я почувствовал, что слегка проголодался... Я размышлял о том, что видел на днях, и вдруг меня озарило. Если я использую меч... (неразборчиво), я назову его \"Путь лезвия дождя\". Попробую на днях».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080308,
					"content": "«...Случайно упал, когда практиковал технику \"Путь лезвия дождя\". К счастью, обошлось без серьёзных последствий... В голову пришла идея вырыть глубокий пруд под столбами. Это не только предотвратит травмы от падений, но и позволит разводить рыбу для пропитания...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080309,
					"content": "«...Купил у рыбаков несколько десятков рыб... Попытался их приготовить. Вкус неописуемый...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080310,
					"content": "(Следующие десять с лишним страниц посвящены подробному описанию способов приготовления рыбы. Некоторые из них даже сопровождаются иллюстрациями.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080311,
					"content": "«...Случайно упал, когда практиковал технику \"Путь лезвия дождя\"».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080312,
					"content": "«...Получилось».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080313,
					"content": "(Читать дальше)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "«...Копьём и мечом нужно владеть с таким мастерством, словно... (Неразборчиво. Сбоку есть комментарий третьего мастера: вторая натура.) ...И это истина... Всё же её нет... Как же она будет дарована? Как она будет явлена?»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080316,
					"content": "«...Реконструировать библиотеку. Разработать проект... внутри и...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080317,
					"content": "«...Взгляни <color=#00E1FFFF>глазами</color> и соедини свитки знаний из <color=#00E1FFFF>четырёх точек</color> с <color=#00E1FFFF>палатами в четырёх углах</color>, затем...»",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080318,
					"content": "(Следующие несколько страниц размыты и не поддаются разбору. Сбоку есть комментарий третьего мастера: настоятельно рекомендуется для прочтения будущими поколениями.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080319,
					"content": "(Читать дальше)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "«...Оправился от ранения. Малыш Бай навестил и принёс козлятину и рыбу. Жирная, вкусная, без резкого запаха. Я попросил рецепт... Передал ему технику \"Путь жнеца жизни\"... Записано здесь».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080322,
					"content": "(На следующих страницах подробно описаны различные способы приготовления козлятины.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "«Записи Гухуа»"
				},
				{
					"id": 711080320,
					"content": "С меня хватит... Бред какой-то...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "С меня хватит. Про процесс обучения вообще ни слова не написано...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "С меня хватит... Бред какой-то...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
