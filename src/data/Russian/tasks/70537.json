			"dialogs": [
				{
					"id": 705370101,
					"content": "Подозрительный деревянный ящик, который раньше никто не видел. Из щели на крышке торчит записка: «Оборудование исследовательской команды: Осторожно! Повышенный уровень опасности».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Подозрительный деревянный ящик"
				}
			]
		},
		{
			"id": 7053711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
