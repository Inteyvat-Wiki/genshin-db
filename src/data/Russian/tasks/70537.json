				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Подозрительный деревянный ящик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371101,
					"content": "Стоит присмотреться...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371102
					]
				},
				{
					"id": 705371102,
					"content": "Эта записка звучит пугающе!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371103
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371103,
					"content": "Это явно что-то опасное. Почему же его оставили рядом с Сидровым озером? Может, это вещи тех рыцарей?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371104
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371104,
					"content": "Здесь в ящике большая трещина, в неё можно рассмотреть какое-то оборудование!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371105
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371105,
					"content": "Дай-ка Паймон посмотрит... Внутри много круглых красных шариков, по размеру они намного больше закатников...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371106
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371106,
					"content": "Подожди-ка! Это бомбы?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371107
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371107,
					"content": "Почему рыцари ордена оставили здесь бомбы? Неужели они собираются с их помощью избавиться от рыб, заполонивших Сидровое озеро, которых упоминала Лиза?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				}
			]
		},
		{
			"id": 7053712,
			"completionStepIds": [
				7053701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Подозрительный деревянный ящик"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371201,
					"content": "Ха-ха! Бомбы! Хочу-хочу-хочу!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371202
					]
				},
				{
					"id": 705371202,
					"content": "#Чего ты вдруг так {M#воодушевился}{F#воодушевилась}? Пока не понятно, насколько опасны могут быть эти бомбы. А если кто-нибудь пострадает?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371203,
						705371204
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371203,
					"content": "Да ладно, для рыбы точно сгодятся. Бросим в озеро, да и всё!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				},
				{
					"id": 705371205,
					"content": "Хм!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371206,
					"content": "Ну вот, после твоих слов Паймон захотелось попробовать...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371207
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371207,
					"content": "Обычно все рассказывают, как Кли захотелось порыбачить, как она пошла глушить рыбу или как её за это наказали...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371208
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371208,
					"content": "А сами оставляют на берегу озера ящик с бомбами... И теперь так и хочется попробовать!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371209
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371209,
					"content": "Если бросим одну, ничего страшного же не случится?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371210,
						705371211
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371210,
					"content": "#Давай-ка {M#каждый}{F#каждая} по одной!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371212,
					"content": "Вы вместе с Паймон открываете подозрительный ящик, достаёте по бомбе, выясняете, с какой стороны их зажигать, считаете до трёх, выдёргиваете детонатор и швыряете бомбы далеко в Сидровое озеро...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371213
					]
				},
				{
					"id": 705371213,
					"content": "Из воды раздаётся глухой рёв, в небо взмывают два водяных столба, поднимая с собой крутящихся иглобрюхов...\\nВы с Паймон переглядываетесь, с улыбкой ударяете по рукам, затем начинаете быстро собирать улов, готовясь покинуть это место...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371214
					]
				},
				{
					"id": 705371214,
					"content": "Но ваше весёлое браконьерство проходит не так гладко, как вы думали. Сразу после взрыва вас разоблачают...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371215
					]
				},
				{
					"id": 705371215,
					"content": "А!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371216
					],
					"speakerTitle": "Фония"
				},
				{
					"id": 705371216,
					"content": "Мои уши!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371217
					],
					"speakerTitle": "Фония"
				},
				{
					"id": 705371217,
					"content": "Напугала до смерти! Что такое, Фония? Ты в порядке?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371218
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Растерянный крик"
				},
				{
					"id": 705371218,
					"content": "Взрыв под водой! Меня едва не оглушило! И судя по звуковому рисунку, это была твоя бомба, Эмметт!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371219
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Плохо скрывающий обиду голос"
				},
				{
					"id": 705371219,
					"content": "А? Да я всё это время стояла рядом с тобой и ничего не делала! У меня и бомб-то с собой нет!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371220
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371220,
					"content": "Ты! Ты наверняка хотела застать меня врасплох! Заранее завела на бомбах детонатор и бросила их в озеро!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371221
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Плохо скрывающий обиду голос"
				},
				{
					"id": 705371221,
					"content": "В таком случая я бы держала фотокамеру наготове, чтобы вовремя запечатлеть, как ты сидишь на корточках на земле, обхватив голову руками, и рыдаешь в три ручья! В противном случае, какой мне от этого прок?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371222
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371222,
					"content": "Ты! Можешь больше не рассчитывать, что я сделаю тебе скидку на арендную плату! А ещё ты вернёшь мне всё до последней моры за воду, мебель и питание!..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371223
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Плохо скрывающий обиду голос"
				},
				{
					"id": 705371223,
					"content": "Нет-нет-нет! Я была неправа! Фония, ты моя лучшая подруга! Я признаю, что в прошлом устроила несколько десятков розыгрышей, но сейчас... я здесь ни при чём!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371224
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371224,
					"content": "Если бы я только могла создать сверхнадёжный детонатор, который мог бы так долго пролежать под водой...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371225
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371225,
					"content": "Пришлось бы мне тогда в прошлый раз в бою против хиличурлов рисковать своей жизнью и пытаться взорвать бомбы вручную?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371226
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371226,
					"content": "...Хм, верно... Тебе не хватило бы фантазии, чтобы так меня разыграть.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371227
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Плохо скрывающий обиду голос"
				},
				{
					"id": 705371227,
					"content": "Ах ты!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371228
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371228,
					"content": "Ты тоже меня обманула! Разве ты не говорила, что пока ты используешь это оборудование для исследования, любой громкий звук может повредить твой слух?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371229
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371229,
					"content": "Я так смотрю, ты не оглохла, ещё и активно ругаешься со мной!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371230
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371230,
					"content": "Ты не понимаешь! Глухота развивается постепенно! Ты сейчас ещё и орёшь во всё горло, это тоже вредно для моего слуха!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371231
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Плохо скрывающий обиду голос"
				},
				{
					"id": 705371231,
					"content": "Может быть, скоро я буду не в состоянии различать оттенки звука, и это будет закат моей карьеры!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371232
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Плохо скрывающий обиду голос"
				},
				{
					"id": 705371232,
					"content": "И вот тогда ты останешься без крыши над головой! Потому что тогда я сдам дом тому, кто предложит более высокую цену! А потом... потом я подамся в рыбаки! И до тебя мне не будет никакого дела!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371233
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Плохо скрывающий обиду голос"
				},
				{
					"id": 705371233,
					"content": "Ну, давай я буду просто ругаться потише... В смысле говорить потише...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371234
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Испуганный и сомневающийся голос"
				},
				{
					"id": 705371234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371235
					],
					"speakerTitle": "Эмметт",
					"speakerSubtitle": "Неразборчивый голос"
				},
				{
					"id": 705371235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371236
					],
					"speakerTitle": "Фония",
					"speakerSubtitle": "Затихающий голос"
				},
				{
					"id": 705371236,
					"content": "Не особо слышно, что они там говорят... Они просто ругаются друг с другом.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371237,
						705371238
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371237,
					"content": "Ого! Это было весело!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371239,
					"content": "Отличное развлечение! Можем бросить ещё по одной...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371240
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371240,
					"content": "Хотя нет! И одного раза было достаточно! Сделаем так ещё раз, и эти двое доберутся до нас. Нельзя, чтобы нас схватили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371241
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371241,
					"content": "Кажется, мы натворили дел... Но зато мы удовлетворили своё любопытство!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Паймон"
				},
				{
					"id": 705371238,
					"content": "И никаких проблем!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371211,
					"content": "Швыряй со всей силы!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
