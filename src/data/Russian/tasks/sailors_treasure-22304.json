			"dialogs": [
				{
					"id": 223040601,
					"content": "С возвращением! Получилось найти сокровища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040602
					],
					"speakerTitle": "Бо Лай"
				},
				{
