			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Чжан Шунь"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040101,
					"content": "Как же быть?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040102
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040102,
					"content": "В чём дело?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040103
					]
				},
				{
					"id": 223040103,
					"content": "Раньше я был матросом Южного Креста, но потом получил травму...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040104
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040104,
					"content": "После того как я покинул флот, мне нужны были деньги. Я продал карты сокровищ торговцу по имени Бо Лай.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040105
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040105,
					"content": "Мы договорились, что я получу часть от каждого найденного сокровища. Но от Бо Лая давно ничего не слышно. Думаю, что он даже и не пытался искать сокровища.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040106
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040106,
					"content": "Может быть, ты поищешь для меня сокровища?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040109,
						223040116
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040107,
					"content": "Хорошо.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040108
					]
				},
				{
					"id": 223040108,
					"content": "Благодарю.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040120,
					"content": "Для начала поговори с <color=#00E1FFFF>Бо Лаем</color>, чтобы получить <color=#00E1FFFF>карты сокровищ</color>. Затем найдите <color=#00E1FFFF>сокровища</color> и принесите их <color=#00E1FFFF>Бо Лаю</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040121
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040121,
					"content": "Я уже обо всём с ним договорился. Моя доля будет храниться у него.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040109,
					"content": "Почему ты решил покинуть флот?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040110
					]
				},
				{
					"id": 223040110,
					"content": "По состоянию здоровья. Моя травма давала о себе знать, и я решил не подвергать риску остальную команду.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040111
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040111,
					"content": "Потом я торговал разными безделушками, но бизнес шёл ни шатко ни валко. В конце концов, у меня закончились все безделушки.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040112
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040112,
					"content": "У меня осталось несколько карт сокровищ. Они сохранились со времён лихих приключений.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040113
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040113,
					"content": "Но в моём нынешнем состоянии, пройти по улице - уже целое приключение.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040114
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040114,
					"content": "Поэтому я продал их Бо Лаю, чтобы выручить хотя бы немного наличных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040115
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040115,
					"content": "Но, похоже, он тоже не спешит охотиться за сокровищами. В конце концов, он простой торговец.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040116
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040116,
					"content": "О каких сокровищах идёт речь?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040117
					]
				},
				{
					"id": 223040117,
					"content": "Хе-хе. Вряд ли там что-то серьёзное. Это были самые простые карты сокровищ, которые есть у каждого матроса.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040118
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040118,
					"content": "Если бы там были большие сокровища, то другие члены команды уже давно бы их нашли.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040119
					],
					"speakerTitle": "Чжан Шунь"
				},
				{
					"id": 223040119,
					"content": "Нас ждут небольшие, но всё-таки сокровища! Их точно хватит, чтобы разделить на троих. Удачи в поисках!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Чжан Шунь"
				}
			]
		},
		{
			"id": 2230402,
