					"nextDialogs": [
						223040903
					]
				},
				{
					"id": 223040903,
					"content": "Отлично! Я же говорил, что ты настоящий искатель приключений!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040904
