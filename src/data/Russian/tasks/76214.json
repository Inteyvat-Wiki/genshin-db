			"trigger": {
				"objectNames": [
					"Госпожа Рыжуня"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							-218.828,
							107.68,
							1292.547
						],
						"pointId": 234
					},
					{
						"sceneId": 103,
						"position": [
							-219.685,
							107.68,
							1293.968
						],
						"pointId": 243
					},
					{
						"sceneId": 103,
						"position": [
							-220.55,
							107.68,
							1293.102
						],
						"pointId": 244
					}
				]
			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "...Мяу. Твоё владение мечом... даже кошку не может оставить равнодушной.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Госпожа Рыжуня"
				},
				{
					"id": 762140209,
					"content": "#Благодарю вас, {F#достопочтенная воительница}{M#достопочтенный рыцарь} из чужеземья. Надменные грубияны больше не потревожат дома моих подданных.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Госпожа Рыжуня"
				},
				{
					"id": 762140210,
					"content": "Итак, говорите. Что привело вас в мой дворец?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Госпожа Рыжуня"
				},
				{
					"id": 762140202,
					"content": "Дворец?..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Эм... Раз мы попали в сказку, наверное, это тоже часть сюжета?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Паймон"
				},
				{
					"id": 762140206,
					"content": "Вы передаёте госпоже Рыжуне приглашение на чаепитие от господина Серого Котика...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Госпожа Рыжуня"
				},
				{
					"id": 762140208,
					"content": "#...Ясно. Спасибо вам, {F#достопочтенная воительница}{M#достопочтенный рыцарь} из чужеземья. Что ж, я последую вашему мудрому совету и отправлюсь в путь.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Госпожа Рыжуня"
				},
				{
					"id": 762140204,
					"content": "Ваше величество, позвольте доложить...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "#Ты так быстро {F#вжилась}{M#вжился} в роль! Кхм-кхм, ладно, раз уж так задумано...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Паймон"
				}
			]
		},
