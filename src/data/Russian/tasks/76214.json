				]
			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#Гав? Что случилось, {M#господин путешественник}{F#госпожа путешественница} с золотыми волосами? Могу ли я вам помочь?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Мадам-пудель"
				},
				{
					"id": 762140302,
					"content": "Вы передаёте мадам-пуделю приглашение на чаепитие от господина Серого Котика...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Э? Неужели уже пора?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Мадам-пудель"
				},
				{
					"id": 762140304,
					"content": "Спасибо вам! Гав-гав, если бы не дела, я бы лично пригласила госпожу Рыжуню... Тогда бы и господин Серый Котик не...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Мадам-пудель"
				},
				{
					"id": 762140305,
					"content": "Кошки и собаки могут жить друг с другом в мире и согласии... Да, это несомненно. Как бы там ни было, мне пора бежать на чаепитие. Спасибо, что напомнили!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам-пудель"
				}
			]
		},
