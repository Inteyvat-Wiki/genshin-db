			"dialogs": [
				{
					"id": 762140401,
					"content": "#Мяу-мяу! Теперь все в сборе, мяу! Благодаря {M#господину}{F#госпоже} {M#путешественнику}{F#путешественнице} с золотыми волосами наше весёлое чаепитие наконец начинается, мяу!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140402
					],
					"speakerTitle": "Господин Серый Котик"
				},
				{
					"id": 762140402,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140403
					],
					"speakerTitle": "Госпожа Рыжуня"
				},
				{
					"id": 762140403,
					"content": "Хе-хе, не хмурьтесь так, госпожа Рыжуня. Лучше выпейте чего-нибудь сладенького, и настроение сразу улучшится!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Мадам-пудель"
				}
			]
		},
