			"dialogs": [
				{
					"id": 700200208,
					"content": "Parece que quiere decirnos algo... ¿Tendrá que ver con ese Hilichurl tan peculiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700200201,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200202
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200202,
					"content": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200203
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200204,
					"content": "Ehm... ¿Gracias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200205,
					"content": "Tomo, valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200203,
					"content": "<color=#00E1FFFF>Unta nunu</color>... Al parecer tiene alguna relación con el tiempo... No olvides consultar el manual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200204,
						700200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700200206,
					"content": "Valo, tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200207
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200207,
					"content": "Jeje, valo!",
