			"dialogs": [
				{
					"id": 700200102,
					"content": "Odomu! Ya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200103
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200103,
					"content": "Espera, yo me encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200104,
					"content": "Mimi tomo, Odomu nye! Muhe mani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200105,
					"content": "Mani? Mani! Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200106,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200107,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200108,
						700200109
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200108,
					"content": "Creo que fue como la seda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "Le estoy preguntando si necesita ayuda y, al parecer, así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200112,
					"content": "Oh... Dice que quiere que derrotemos a un... enemigo muy poderoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200115,
					"content": "Bien, ya nos marcó la ubicación en el mapa, ¡ahora cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200109,
					"content": "¿De qué hablan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				}
			]
		},
