			"dialogs": [
				{
					"id": 60080101,
					"content": "Hace unos días que no venimos. ¿Cómo habrán cambiado las cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080102,
					"content": "No tanto como pensé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "Parece que poco a poco se ha ido estabilizando todo. Lauma es la mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080104,
					"content": "¡Lauma, ya estamos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080105,
					"content": "¿Cómo va todo últimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "Ultimar los detalles finales ha sido más complicado de lo que esperaba. Está siendo todo un reto resolver los problemas que se han ido acumulando a lo largo del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080107,
					"content": "Creo que me llevará un par de semanas más. Por suerte, los que se han quedado parecen haberse librado de la confusión que sentían y se han vuelto más proactivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080108,
					"content": "Es como si por fin hubieran conocido su auténtica fe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080109,
					"content": "Y todo gracias a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080110,
					"content": "O-oh... No, esto es algo que debería haber hecho hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080111,
					"content": "He estado cuidando de mí misma en los últimos días. Ahora que tú estás guardando la médula lunar, debería poder ayudarte a investigar el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080112,
					"content": "Gracias por acordarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "Por cierto, ¿has oído algo más sobre el espectro que vimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080114,
					"content": "He intentado preguntar a varias personas, pero no ha habido suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080115,
					"content": "¿Y a ustedes cómo les fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080116,
					"content": "No hemos progresado mucho, pero las cosas están así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080117,
					"content": "Creo que entiendo lo que quieren decir... Ustedes tampoco lo tienen nada fácil, así que, por favor, cuídense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080118,
					"content": "#En cualquier caso, {NICKNAME}, ven aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "¿Qué ves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080121,
					"content": "(Esto es... ¿Nod Krai? El paisaje me es familiar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(Y eso que vuela por el cielo... ¿es un meteorito?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(¡No! ¡Es nuestra nave!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "¿Y-ya está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080125,
					"content": "Parece que se trata de algo que ocurrió hace mucho tiempo. Los recuerdos que he sentido eran muy turbulentos y caóticos, es lo máximo que me permite ver mi poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080126,
					"content": "(Al menos ahora sabemos dónde aterrizó nuestra nave en Nod Krai... Parecía ser en algún lugar cerca de la Playa Arenaestelar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#(Todo esto coincide con lo que me dijo {F#Éter}{M#Lumina}, pero... quiero saber más.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "¡¡¡...!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 60080129,
					"content": "¿Eh? ¿Qué te pasa a ti de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080130,
					"content": "Las flores cambiaron de color.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080131,
					"content": "(Estas flores son un reflejo del poder de Colombina. ¿Quiere esto decir que su cuerpo ha vuelto a...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(Recuerdo que dijo que quería recuperar una parte de su poder por medio de la médula lunar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "Sí, Paimon te ha entendido. Tenemos que ir a verla, a ver si podemos ayudarla de algún modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080135,
					"content": "Cuento con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080136,
					"content": "Ah, por cierto, Lauma, esta es la medicina que le pediste a la Cámara de Secretos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080137,
					"content": "Gracias por haber venido hasta aquí para traérmela. Es de gran ayuda para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080138,
					"content": "Por otro lado, también quería decirte que creo que Kuu{RUBY#[S]Doncella Lunar}tar podría ayudarte a ver más recuerdos de tu nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080139,
					"content": "¡Ah, claro! Al fin y al cabo, ¡ella es la Diosa Lunar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080140,
					"content": "Pero primero, debemos asegurarnos de que se encuentre bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080141,
					"content": "¡Nos vemos luego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
