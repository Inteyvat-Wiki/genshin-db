			},
			"dialogs": [
				{
					"id": 60080201,
					"content": "Colombina tiene muy mal aspecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "P-perdón por molestarte, pero... ¿te encuentras bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080204,
					"content": "¿Tu estado ha empeorado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "Estoy mareada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080206,
					"content": "Es como si... estuviera regresando a la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080207,
					"content": "E-entonces no es tan malo, ¡¿no?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "¿Eh? Puedo sentir... el poder de la luna... ¿en ti?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080209,
					"content": "Les hemos quitado a los Fatui la médula lunar. ¿Podría serte de ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Humm... ¿Y qué necesitan esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080211,
					"content": "¡Oye, no es momento para hablar de eso! ¡Ahora lo más importante eres tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080213,
					"content": "(¿Será una costumbre que ha desarrollado después de haber tenido durante toda su vida relaciones de beneficio mutuo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Tal vez puedas ayudarme con algo más adelante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "Oh... Está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080216,
					"content": "Dame la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080217,
					"content": "*Suspira*, ya estoy de vuelta en la tierra. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080218,
					"content": "Pero si ya estabas aquí... ¿Cómo te sientes? ¿Te encuentras mejor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Mucho mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080220,
					"content": "¿Qué hiciste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "La luna que hay dentro de ti es silenciosa como un reflejo en el agua. Fascinante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080223,
					"content": "Lo único que hice fue sacar del agua un rayo de su luz. Es suficiente para mantenerme en tierra por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080224,
					"content": "Yo he notado otros cambios también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "Eso es la gracia de la Diosa Lunar. Todo aquello que entra en contacto conmigo recibe esta marca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080226,
					"content": "Es una marca inofensiva y se desvanecerá por sí sola después de un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080227,
					"content": "Ahora que has recuperado tu poder, ¿no deberíamos darte la médula lunar para que la guardes tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "Al fin y al cabo, se supone que es algo divino, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Son los restos de Aria, la Diosa de la Luna Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080230,
					"content": "Entonces, ¿están relacionados con...? Espera, ¡¿qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "¿No lo sabían?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080232,
					"content": "Lo único que nos dijo Lauma es que era diferente a otros fragmentos y que podía sentir en ella un poder divino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "Y tiene razón. Cuando saqué un rayo de luz lunar, también extraje algunos recuerdos que había en la médula lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080234,
					"content": "Esos recuerdos me confirmaron que estos restos pertenecen a la Diosa de la Luna Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080235,
					"content": "Pero Lauma también ha visto la historia por medio de la médula lunar, ¿no? ¿Cómo es que no se había dado cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma dijo que ella solamente podía ver algunas escenas breves y borrosas. Tal vez esto sea algo que solo la Diosa Lunar en persona puede percibir.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Antiguamente, en el cielo había tres lunas, las cuales pertenecían a las tres diosas que gobernaban cada una de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080238,
					"content": "Sin embargo, después de la Guerra de la Llama Funeraria, las tres diosas perecieron y, de las tres lunas, dos se rompieron en pedazos durante el conflicto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080239,
					"content": "Tras la muerte de Aria, la Luna Eterna, su poder se condensó en esta médula lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080240,
					"content": "Nunca se encontraron los restos de la Luna Arcoíris y, aunque la Diosa de la Luna Escarchada está muerta, su luna nunca se hizo pedazos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080241,
					"content": "Tal y como vaticinaba la profecía, tarde o temprano, esta luna daría a luz a una nueva diosa: aquella conocida como “Kuu{RUBY#[S]Doncella Lunar}tar” entre los Descendientes Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080242,
					"content": "Puedo sentir que mi poder pertenece a la Luna Escarchada, pero esta se encuentra muy lejos, más allá del cielo falso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080243,
					"content": "En mi estado actual, no es que no pueda controlarla, sino que incluso a veces me cuesta sentir su poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080244,
					"content": "#E-espera, deja que Paimon haga cálculos... A ver, nosotr{F#a}{M#o}s tenemos la médula lunar de la Luna Eterna, nadie encuentra a la Luna Arcoíris... Entonces, ¿la médula lunar de la Luna Escarchada está dentro de ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "No, la médula lunar es algo que solo se forma tras la muerte de una Diosa Lunar. Pueden considerarla una especie de núcleo de poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080246,
					"content": "Es como preguntarle a la luna si en ella hay rocas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080247,
					"content": "Aaaah, entonces, ¿te refieres a que tú misma representas el poder de la Luna Escarchada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "#Sí. Por eso, si a un dios que posee una Gnosis se le llama “Arconte”, entonces tú, que tienes la médula lunar, ¿serías {F#una Diosa}{M#un Dios} Lunar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080249,
					"content": "No creo que sea lo mismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "#¿No quieres ser {F#una Diosa}{M#un Dios} Lunar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080251,
					"content": "¡El problema no es ese! Y, por cierto, ¡¿por qué tienes tantas ganas de deshacerte de ese título?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "Dejando a un lado ese tema, ¿no deberíamos darte a ti la médula lunar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "No la quiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080254,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "Y tampoco parece que ella quiera estar conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080256,
					"content": "Paimon no te sigue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Al entrar en contacto con su poder, sentí una especie de rechazo o repulsión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080258,
					"content": "Supongo que se debe a que yo también soy una Diosa Lunar, y si dos lunas no pueden elevarse a la vez, mucho menos pueden consumirse la una a la otra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080259,
					"content": "Entonces, tendré que seguir llevándola yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "#¿Estás segur{F#a}{M#o}? Lauma dijo que está bien escondida contigo, pero Colombina ha podido sentir su poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "La Cacería salvaje tampoco es algo muy normal que digamos, así que si llega a detectar la médula lunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "¿La Cacería salvaje? Están hablando de ese fenómeno como si se tratara de una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080263,
					"content": "Sí, porque parece como si hubiera alguien detrás de ella, y además, con un objetivo concreto. Todo este tiempo no ha dejado de ir tras la médula lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "¿De qué me suena esto?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080265,
					"content": "¿Eh? ¿Te suena de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Cuando aún estaba con los Fatui, oí a mis compañeros hablar de una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080267,
					"content": "Era alguien de Khaenri'ah que obtuvo el poder del Abismo durante la catástrofe. Además, estaba terriblemente obsesionado con las lunas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080268,
					"content": "¿De Khaenri'ah? Aún no sabemos si ese espectro que vimos está relacionado con Khaenri'ah, pero los demás datos sí que coinciden. ¿Sabes cómo se llama esa persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "Lo único que sé es que la gente lo llama “el Cazador de la Luna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080270,
					"content": "¡¿Uno de los Cinco Grandes Pecadores?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah, sí, creo que también lo llamaban de ese modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080272,
					"content": "¡¿Eh?! Es uno de los que nos habló Dain, ¿verdad? Entonces, ¡¿eso quiere decir que nuestro enemigo es Rerir, “el Cazador de la Luna”, uno de los Cinco Grandes Pecadores?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "Tratándose de un pecador, seguramente sea más fuerte de lo que pensamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Según tengo entendido, el Cazador de la Luna desapareció poco después del desastre de Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080275,
					"content": "Cuando les pregunté a mis compañeros a dónde había ido, me respondieron con otra pregunta: “¿De verdad no lo sabes?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080276,
					"content": "¿Y eso por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "Porque, según dicen, su final fue que cayó al “reflejo de la luna”, del cual nunca pudo volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080278,
					"content": "A ver, espera, espera... ¡Esto es demasiada información para Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "Eso pensé yo también en su momento, pero mis compañeros asumían que yo estaba al corriente de todo lo relacionado con las lunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080280,
					"content": "Sin embargo, tal y como ya les dije a ustedes, mi “prólogo” se encuentra más allá del cielo falso. Ni siquiera recuerdo mi nombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080281,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "El caso es que, tras la desaparición del Cazador de la Luna, la Cacería salvaje se agravó en Nod Krai hasta convertirse en sinónimo de “desastre del Abismo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080283,
					"content": "La Cacería de hoy en día solo ha conservado el nombre, ya que, en realidad, se trata de un fenómeno mucho más peligroso y de mayor escala que en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080284,
					"content": "Paimon sigue sin creerse que nuestro enemigo sea uno de los Cinco Grandes Pecadores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "#¡Es demasiado para nosotr{F#a}{M#o}s! En ese caso, el incidente en la Playa Arenaestelar debió de ser pura suerte... ¿o es que no utilizó todo su poder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "Y aunque así fuera... le bastó para derrotar a La Títere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "¿Hice algo sin darme cuenta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
				600802,
				600803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Colombina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Perdón, ¿qué has dicho? ¿Podrías decirlo otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080402,
					"content": "#¿Eh? Ah, sí, es una de tus... ¿excompañeras? La Títere, estuvo con nosotr{F#a}{M#o}s en la Playa Arenaestelar y tampoco pudo hacer nada contra la Cacería salvaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080404,
					"content": "¿Acabas de... reírte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "No, para nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080406,
					"content": "(¡Sí que se ha reído! ¡Paimon lo vio!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "¿No te llevas bien con ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "No, simplemente me resultó interesante imaginar su cara de enfado tras una derrota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080409,
					"content": "La verdad es que se la veía muy afectada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Bueno, solo por un tiempo. Se le da muy bien autorregularse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080411,
					"content": "#Volviendo al tema, si ya sabemos que quien busca la médula lunar es alguien muy peligroso, ¿de verdad quieres seguir llevándola contigo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Si la información de los Fatui es fiable, ni toda Nod Krai junta sería rival para el Cazador de la Luna en caso de que usara toda su fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080413,
					"content": "Tal vez haya algo que le esté restringiendo de momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Antes de tomar una decisión, hay algo que me gustaría pedirte, Colombina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "¿De qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080417,
					"content": "#¿Crees que podrías mostrarme lo que pasó cuando mi herman{F#o}{M#a} y yo aterrizamos en nuestra nave en Nod Krai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Sí, no hay problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080419,
					"content": "¡Qué rápido aceptó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Como ya les dije, para mí esto no es más que sacar un rayo de luz lunar, nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080421,
					"content": "Dame la mano y prepárate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(Es como lo que vimos antes, pero con más claridad.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(Menos mal que pudimos aterrizar sin problema...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Es como si hubiera pasado mucho tiempo desde entonces...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(Aún estamos dentro de la nave. Y pensar que estuvimos tanto tiempo en ella... Me pregunto cuándo salió {F#Éter}{M#Lumina}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(¡¿Eh?! Es{F#e}{M#a} es... ¡¿{F#Éter}{M#Lumina}?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(¿Cómo es posible? ¡Nadie salió de la nave después del aterrizaje! ¡La puerta ni siquiera estaba abierta!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "¿Qué lugar... es este?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#¡{F#Lumina}{M#Éter}, rápido, tenemos que salir de aquí!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "#¿E-estás bien, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Nuestra nave... Pasó mucho tiempo después de que aterrizáramos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Aunque nadie salió de la nave en ese tiempo, de algún modo... {F#Éter}{M#Lumina} me encontró desde fuera de ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "¡¿Eh?! ¿C-cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "No lo sé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "Los secretos que se esconden en los recuerdos son como una galleta: una vez que la muerdes, las migajas se esparcen por todos lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080439,
					"content": "(Esto es demasiado extraño... Tengo que llegar al fondo del asunto.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Pero, como dijo Néfer, no habrá nada que investigar si Nod Krai es destruida.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Yo me quedaré con la médula lunar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "¿E-eh? Bueno, está bien, ya que insistes... Pero aun así, esta cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "¿Necesitarás ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080445,
					"content": "¿Con qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "Podría ayudarte a esconderla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080447,
					"content": "¡¿De verdad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "De por sí es difícil detectarla, pero puedo enseñarte a esconder aún mejor su presencia utilizando el kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080449,
					"content": "Así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080450,
					"content": "Oooh, ¡es como un escudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(Qué sensación tan... suave y agradable... Es como la luz de la luna...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "¿Lo sientes? Ahora, intenta mantenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Aprendes rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080455,
					"content": "Parece bastante resistente. Podrías usarlo para defenderte en un momento de necesidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "Gracias por enseñarme esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Colombina, ¿tú siempre estás aquí? ¿No sales a pasear ni nada de eso? Paimon sabe que ahora sería peligroso hacerlo, pero aun así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080459,
					"content": "No me gustan los desconocidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080460,
					"content": "#¿Y a nosotr{F#a}{M#o}s cómo nos ves?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Como alguien un poco mejor que un desconocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080462,
					"content": "Deberíamos salir a dar una vuelta cuando termine todo esto de la Cacería salvaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "¡Eso! Los Descendientes Lunaescarcha han cambiado mucho. Paimon cree que hasta te podrían caer bien y todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080466,
					"content": "Lo pensaré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080467,
					"content": "Parece un poco cansada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Seguramente hacía mucho tiempo que no hablaba tanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "Bueno, muchas gracias por habernos ayudado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "No es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080471,
					"content": "#A las flores de aquí les gustan mucho l{F#a}{M#o}s visitantes como ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60080463,
					"content": "#Cuando hayamos resuelto el problema de la Cacería salvaje, demos un paseo junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}