				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "#Buen día a amb{F#a}{M#o}s. Ha pasado mucho tiempo desde nuestro último encuentro. Tienen buen aspecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120202,
					"content": "¡Hola, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120203,
					"content": "¿A qué debo el honor de su visita? ¿Tienen algún asunto importante del que hablar con el Sr. Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120204,
					"content": "Solo queríamos un jugo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "Así es. Adelinde, ya que estás aquí, ¿nos harías un favorcillo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120207,
					"content": "Siempre nos perdemos la oferta de jugo del Viñedo, así que esta vez hemos venido con tiempo de sobra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120208,
					"content": "¿Podrías reservarnos una botella? ¡Te pagaremos lo que haga falta, porfi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120209,
					"content": "¡No hay problema! Y no tienen que pagar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120210,
					"content": "Aunque me temo que tendrán que esperar un buen rato. El jugo promocional del Viñedo del Amanecer lleva su tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120211,
					"content": "Cada verano, el Sr. Diluc escoge personalmente dos barriles de uva de la mejor calidad para preparar el jugo promocional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120212,
					"content": "¿Qué? ¿Y por qué vende los mejores productos con descuento? ¿No debería vender las mejores uvas al mayor precio posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120213,
					"content": "Lo cierto es que el Sr. Diluc nunca me ha explicado el porqué, pero si tuviera que adivinar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120214,
					"content": "Yo creo que lo usa como estrategia de mercadotecnia. Las promociones siempre atraen a clientes potenciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120215,
					"content": "A lo mejor quiere aumentar la popularidad del jugo para que el público tenga más opciones entre las que elegir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120216,
					"content": "Es una alternativa fantástica para los que tienen la costumbre de tomar una copita o dos de más. Así no irán tan ebrios como para causar problemas. Y, por otra parte, los que no beben alcohol podrán probar algo nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120217,
					"content": "¿Y eso no es malo para el negocio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "El Sr. Diluc no le da tanta importancia al dinero. Estoy segura de que prefiere que la gente beba con moderación a ganar una fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120220,
					"content": "Sería maravilloso si todos pudieran disfrutar de una copa de buen vino sin perder el sentido o sin causar problemas, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120221,
					"content": "Guau, parece que Diluc tiene un gran corazón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120222,
					"content": "Entonces, ¿Diluc se ha ido a escoger las uvas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120223,
					"content": "Todavía no. Tenía algunos asuntos de los que encargarse. Supongo que se pondrá a ello en cuanto acabe con lo que se trae entre manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120224,
					"content": "Si les apetece, estoy segura de que al Sr. Diluc le encantaría que le dieran su opinión al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120225,
					"content": "¿De qué asuntos se trata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "Bueno, supongo que ya sabrán que cuando el Sr. Diluc tiene noticia de algún visitante que no es bienvenido en la ciudad, tiene por costumbre ir a “darle la bienvenida” personalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120227,
					"content": "Creo que dijo que estaría por la zona de la Costa del Halcón. No sé cuánto tardará, así que ¿por qué no pasan y se sientan mientras lo esperan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120228,
					"content": "Yo he de permanecer en la entrada para saludar a los clientes, pero Hillie y Moke cuidarán bien de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120229,
					"content": "¿“Visitantes no bienvenidos”? ¿Qué significa eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120230,
					"content": "Supongo que tiene que ver con el trabajo de media jornada de Diluc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "¿Eh? Así que te refieres a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120232,
					"content": "¡Oh! Así que la Orden del Abismo está haciendo de las suyas otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120233,
					"content": "#Diluc es nuestro amigo, ¡no podemos quedarnos aquí sentad{F#a}{M#o}s de brazos cruzados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120238,
					"content": "Sería fantástico si le echaran una mano. El Sr. Diluc confía en ustedes y no me extraña, son de confianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120239,
					"content": "Estoy segura de que les agradecerá la ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120240,
					"content": "¡No hay problema! Si le ayudamos, terminará antes nuestro jugo, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120241,
					"content": "#Andando, {NICKNAME}. Vamos a buscar a Diluc en la Costa del Halcón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120234,
					"content": "Deberíamos esperar a Diluc en el Viñedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "#Humm... A Paimon no le parece bien que nos quedemos aquí parad{F#a}{M#o}s mientras Diluc se encarga de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120236,
					"content": "Vayamos a buscarlo a la Costa del Halcón. Así podremos echarle una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120237,
					"content": "Diluc es muy fuerte, pero cuantos más seamos, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120218,
					"content": "A mí no me parece muy rentable, la verdad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "No creo que pueda considerarse algo importante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "No parece que esta tienda sea de Diluc. Tal vez es de un aventurero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120402,
					"content": "Mira, hay una hoja y un cuaderno. A ver qué pone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120403,
					"content": "“Estimado Héroe Oscuro, el fenómeno extraño de aquella vez vuelve a ocurrir”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120404,
					"content": "“Aunque la última vez resolviste el problema por completo, algo ha alterado las líneas ley recientemente y están dejando escapar criaturas que registraron en el pasado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120405,
					"content": "“Imagino que querrás lidiar con aquellos que suponen una amenaza para todos de inmediato”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120406,
					"content": "“Por ello, y de acuerdo con la normativa, notifico a las partes involucradas en el asunto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120407,
					"content": "Humm... Por el tono, Paimon diría que se trata de alguien que conoce a Diluc muy bien. Llamémosle el “amigo de Diluc” por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120408,
					"content": "Así que... El amigo ese vio que pasaba algo malo, le dejó una nota a Diluc y se largó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120409,
					"content": "A Paimon le parece una irresponsabilidad. ¿Y si alguien más la hubiera leído? Y encima se ha dejado el cuaderno también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120410,
					"content": "Ahora que Paimon lo piensa... ¿Ves ese extraño sedimento de línea ley que hay en la playa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120411,
					"content": "Ese debe ser el “fenómeno extraño” que menciona la carta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "Aparte de eso, todo parece estar en orden por aquí... No hay monstruos en la costa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, ¿tú también quieres leer el cuaderno del amigo de Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120414,
					"content": "Si no, vamos a echarle un vistazo al sedimento de línea ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7051205,
			"completionStepIds": [
				7051205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051205",
							"2"
						],
						"stepId": 7051205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "¡Guau! ¡¿De dónde salieron todos estos monstruos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120502,
					"content": "Espera un momento... ¿Ese es Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120503,
					"content": "Se ve algo diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120504,
					"content": "¡Míralo! ¡Tan concentrado y lleno de energía! ¡Así que este es el Capitán Pyro en acción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120505,
					"content": "Debe ser el Diluc que luchó aquí en el pasado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "¡Tienes razón! Ahora que Paimon lo ve bien, este Diluc parece más joven de lo normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120508,
					"content": "¿Pero qué pasó entonces? ¿Por qué Diluc estaba peleando aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120509,
					"content": "Humm, supongo que podemos preguntarle la próxima vez que lo veamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120510,
					"content": "#¿Qué hacemos, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120511,
					"content": "No podemos precipitarnos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "Bien, veamos cómo solía luchar Diluc cuando era joven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120512,
					"content": "Primero hay que observarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "Las líneas ley están mostrando la escena que registraron en ese momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
		{
			"id": 7051207,
			"completionStepIds": [
				7051207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
