			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120701,
					"content": "La batalla terminó. Diluc arrasó con ellos... Parece que algunas cosas nunca cambian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120702,
					"content": "Bueno, pero ¿hay algún peligro real aquí? Parece que solo son ilusiones del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120703,
						705120704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120703,
					"content": "Diluc debe haber estado aquí antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				},
				{
					"id": 705120705,
					"content": "¿Entonces Diluc ya terminó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120706,
					"content": "¿Si volvemos a acercanos a ese extraño sedimento de línea ley, saldrán más monstruos? ¿Y qué hay del joven Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120707,
					"content": "Si es como los otros sedimentos de líneas ley que hemos visto antes, entonces ya debería haber desaparecido ahora que todos los monstruos han sido derrotados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120708,
						705120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120708,
					"content": "¿Sientes curiosidad por el joven Diluc?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120710,
					"content": "No, no, jeje, Paimon solo está un poco preocupada, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120711,
					"content": "¿Y si algún curioso pasa por aquí y se acerca a echar un vistazo y, de repente... “¡Ahh!”, un monstruo salta y “*pumm*”, lo golpea en la cabeza? Eso sería terrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120712,
					"content": "¿Eran necesarios los efectos de sonido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120713
					]
				},
				{
					"id": 705120713,
					"content": "¡Así suena más peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120714,
					"content": "En fin, estamos aquí para ayudar a Diluc, ¿no? Deberíamos quedarnos un poco más y asegurarnos de que este lugar sea completamente seguro antes de volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120715,
					"content": "¡Te has vuelto muy responsable!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120716
					]
				},
				{
					"id": 705120716,
					"content": "Jeje... Para nada, en realidad Paimon solo quiere el jugo de uva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120717,
					"content": "#Vamos, {NICKNAME}, hay que terminar lo que vinimos a hacer. ¡Paimon te dejará que pruebes un sorbito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120709,
					"content": "¿De pronto te interesan las líneas ley anómalas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120704,
					"content": "Como mucho quedará algún que otro vestigio del pasado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				}
			]
		},
