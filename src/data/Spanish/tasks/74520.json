				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#Ah, eres tú, {NICKNAME}, no esperaba encontrarte aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "Cuánto tiempo sin verte, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Sí, una patrulla rutinaria. Aunque para mí, es más bien una actividad necesaria para mantenerme en estado de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "Últimamente todo está relativamente tranquilo en Mondstadt, casi no hay amenazas que requieran la intervención de toda la Compañía de Reconocimiento. De hecho, se nota que todos se han podido relajar bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "Está bien saber descansar del trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Si bien es cierto, pero como capitana debo estar preparada en todo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "Después de todo, las espadas de los enemigos no descansan en tiempos de paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "Por eso, durante los descansos del patrullaje suelo buscar un lugar tranquilo para practicar con la espada y asegurarme de no haber perdido la técnica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "Me viene como anillo al dedo. ¡Déjame tomarte una imagen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "¿Oh? Es una petición interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "Pero me muevo muy rápido, ¿tu Daguerrotipo podrá capturar mis movimientos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "¡Ya me encargo yo de eso! ¡No te preocupes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "#Muy bien. Ya que estás tan segur{F#a}{M#o}, yo también daré lo mejor de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "Mira con atención, el momento en que las olas se arremolinan es fugaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "Tranquila, ¡no dejaré que salgas borrosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Oh, ¡pues perfecto para que te tome una imagen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "¿Estás de guardia aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
