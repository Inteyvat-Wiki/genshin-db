			"dialogs": [
				{
					"id": 730410101,
					"content": "#¡Eh! Es nara rubi{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "#{M#Buen}{F#Buena} nara, ¡ven a divertirte con Aralila! Aranishat es demasiado débil, no juegues con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Puff, última vez Aralila perdió contra Aranishat. Aralila es más débil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "#Bien, con amig{F#a}{M#o} nara aquí ya no hará falta discutir quién es sol y quién es luna. Juguemos juntos a ver quién es más fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "Está bien, Aranishat no tiene miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "#Aralila esconderá primero y amig{F#a}{M#o} nara tendrá que buscar a Aralila. Después esconderá Aranishat y amig{F#a}{M#o} nara tendrá que buscar a Aranishat. Pierde primero que deje encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "#Amig{F#a}{M#o} nara, ¿quieres jugar? Si estás preparad{F#a}{M#o}, ¡empezaremos enseguida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
			]
		},
