			},
			"dialogs": [
				{
					"id": 730410601,
					"content": "¿Eh? ¿Pero qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410602,
					"content": "¡Encontraste a Aranishat muy rápido! ¡Aranishat es tan débil como Aralila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "#Oh... Todos somos débiles, solo nara rubi{F#a}{M#o} es fuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "Esto no puede seguir así, tenemos que entrenar ararakalari para que sea más fuerte, ¡así seguro que no encontrará a nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "No creo que sea eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "#¿Amig{F#a}{M#o} nara tiene miedo de perder? ¡Cuando se juega no hay que tener miedo a derrota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "#Aunque Aralila haya perdido, fue divertido. Amig{F#a}{M#o} nara es {F#buena}{M#buen} nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "#Amig{F#a}{M#o} nara ganó. ¡Fue increíble! ¡Aquí tienes nuestras flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410611,
					"content": "#¡Gracias, {F#buena}{M#buen} nara! ¡Eres {F#buena amiga}{M#buen amigo}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410607,
					"content": "¡Ánimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410608
					]
				},
				{
					"id": 730410608,
					"content": "¡Sí! ¡Seguro que próxima vez Aranishat no perderá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aranishat"
				}
			]
