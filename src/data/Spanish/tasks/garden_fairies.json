					"content": "¡Jajajaja! ¡Aralila es muy débil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410502
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410502,
					"content": "#{F#Nara rubia}{M#Nara rubio} es impresionante, de verdad tiene reflejos muy buenos... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410503
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410503,
					"content": "#{F#Nara rubia}{M#Nara rubio} es excepcional, pero porque Aralila es demasiado débil. Aranishat no dejará encontrar tan rápido. ¡Hum! ¡Ya verás!",
					"roleType": "TALK_ROLE_NPC",
