			"dialogs": [
				{
					"id": 721160401,
					"content": "¡Gracias! Formarán la estructura básica de nuestro dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Ahora, todo lo que tenemos que hacer es esperar a que nuestras balizas recopilen suficientes datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Una vez que tengamos esos datos a mano, haré los ajustes correspondientes a este dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Cuando todo esté listo, pondremos fin a este incidente de una vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
