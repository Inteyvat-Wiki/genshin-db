			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Tardará un poco más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "¿Has reunido todos los datos necesarios?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "¡Ah, eres tú! Maravilloso. Todavía no hemos recopilado todos los datos que necesitamos. Creo que llevará un poco más de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "Sin embargo, he aprovechado esta oportunidad para reflexionar sobre la estructura del purificador de energía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "¿Y qué sería eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "Es un truco de último hora que he hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "De acuerdo con nuestras discusiones anteriores, debemos lidiar con un problema de dos frentes: los Fatui y los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "Creo que podrás lidiar con esos Fatui. Por lo tanto, yo me ocuparé de los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "Este purificador de emergencia es un dispositivo que he construido especialmente para esa tarea. Sin embargo, necesitaré tu ayuda para terminarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "¿De qué manera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "Necesitaremos materiales especiales para garantizar la operación del dispositivo sin contratiempos dentro de la Fragua Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "La médula cristalizada, que contiene la energía inerte de los tatarigami, sería lo más adecuado para esta tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "En realidad, el secreto del famoso acero de jade es que se le agrega este mismo material durante el proceso de forja para aumentar la resistencia de los metales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "Por supuesto, este “método especial” es un secreto comercial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "Si no recuerdo mal, estos minerales se pueden encontrar cerca de aquí. Ayúdame a conseguir tres de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Bueno, entonces tienes mi agradecimiento. Recuerda, son 3 médulas cristalizadas, tráelas una vez que las tengas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "Y yo que pensé que tendría un nombre más oficial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "Ese es su nombre oficial: ¡el “purificador de emergencia”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "A menos que a lo que te refieras sea a su código de producto oficial y su fecha de fabricación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "Bueno, dado que este es un dispositivo puramente de emergencia, no necesitamos esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "¿Eso también es una “medida de emergencia”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "Supongo, aunque dudaría en proporcionar este tipo de ayuda durante un servicio al cliente normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
