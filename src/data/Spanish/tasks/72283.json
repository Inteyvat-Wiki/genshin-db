			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "*Suspira*, debe ser que no es mi día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830102,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "No importa cuánto practique, cada vez disparo peor. ¡Seguro que un día de estos acabaré disparándome en la rodilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830104,
					"content": "¿Por qué practicas tiro con arco en un lugar como este?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "¡Bah! Todo es culpa de ese jibashiri... ¡Él me dijo que hiciera esto!... ¿Sabes? Quizás los jibashiri tan solo son una panda de sádicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830106,
					"content": "Por cierto, ¿sabes algo sobre la cría de anguilas? Siento que continuar practicando tiro con arco no tiene ninguna salida, tal vez debería dedicarme a otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830107,
					"content": "¿Qué tiene que ver una cosa con la otra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Oh, cierto, olvídalo. Parece que no sabes nada sobre criar anguilas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830109,
					"content": "Como principiante, tendrás que atrapar unas cuantas anguilas primero, pero son tan pequeñas que apenas puedes verlas a simple vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830110,
					"content": "Así que pensé que, ya que los arqueros pueden acertar sus disparos desde muy lejos, deben de tener buena vista. Por eso, les pregunté a algunos jibashiri experimentados sobre cómo entrenar mi vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830111,
					"content": "“Akashi, tienes que tomarte el entrenamiento con calma. Solo podrás progresar de forma continuada cuando tengas una buena base”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830112,
					"content": "“Las anguilas son pequeñas y se mueven con agilidad, así que es necesario comenzar con objetivos que no se muevan. Y tampoco puedes disparar desde muy cerca. Si quieres hacer las cosas bien, tendrás que tomártelo con seriedad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830113,
					"content": "Así que seguí sus instrucciones y practiqué el tiro con arco aquí. Pero no acerté ni una sola vez... ¿Cómo es eso posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830114,
					"content": "Por cierto, ¿quieres probar? Si te paras en esa plataforma de piedra, puedes ver los objetivos. Tendrás éxito si aciertas a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830115,
					"content": "Claro, lo intentaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Muy bien, déjame ver tus verdaderas habilidades. ¡No olvides venir a buscarme cuando hayas terminado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228302",
							"2"
						],
						"stepId": 7228302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "Ah, tú tampoco les diste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830202,
					"content": "Parece que hoy no ha habido buena suerte. Debe de haber algo malo afectando tu desempeño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830203,
					"content": "¿Te gustaría intentarlo un par de veces más? Al fin y al cabo, ¡estos objetivos no saldrán escopetados como las anguilas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "¡Oh! ¡Lo lograste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "#Ah, te veías como {F#toda una}{M#todo un} profesional, así que debes tener experiencia. Un arquero con poco entrenamiento como yo no podría ser tan bueno como tú incluso después de algunos años de práctica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "Además, ha pasado mucho tiempo desde la última vez que vi una anguila viva y coleando, y eso que vengo aquí todos los días para practicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "Por cierto, ¿a ti te gustan las anguilas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "¿Ah, sí? En mi caso, yo adoro las anguilas, me gustan tanto que me encantaría poder criar unas cuantas algún día. ¿No crees que se ven adorables?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "Bueno, las anguilas lucen mucho mejor en el plato, por supuesto. Adorables por fuera y ricas por dentro. ¡La combinación perfecta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "Hablando de eso, ¿crees que me estoy equivocando con respecto a mis prioridades? Estoy practicando tiro con arco solo para poder criar anguilas, pero solo quiero criar anguilas porque me encantan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "En realidad, me encanta cuando son libres. Así que tal vez no tenga sentido criarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "En cualquier caso, gracias por la demostración. Esto es para ti. ¡Buena suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "No mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}