			"dialogs": [
				{
					"id": 751790901,
					"content": "I-Itsaho, aún f-faltan muchas cosas de la lista. ¡A-ayuda a buscarlas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*Suspira*... No pierdas el tiempo, ya lo he comprobado yo. La mayoría eran mercancías frágiles. ¿Acaso piensas que siguen de una pieza después de la erupción y la colisión del carro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Ahorra fuerzas y descansa. Cuando la jefa y los demás regresen, aún nos quedará un largo camino por recorrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "¡N-no! B-bueno, si tú no vas, iré yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
				}
			]
		},
