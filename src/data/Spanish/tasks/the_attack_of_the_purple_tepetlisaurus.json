			"dialogs": [
				{
					"id": 751790701,
					"content": "Entonces, has salido ilesa gracias a estos tres, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Jaja, ¡exacto! Deberías haberlos visto en acción. Acabaron con los monstruos en unos segundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Gracias por salvar a la jefa. Esto es solo un pequeño regalo como muestra de gratitud. Por favor, acéptenlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "¿Cómo puedes ser tan tacaño, Tizlo? ¿Esa es la recompensa que le das a quienes te han salvado la vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
			]
		},
