			"dialogs": [
				{
					"id": 751791101,
					"content": "¿Qué voy a hacer? ¿Qué voy a hacer? La jefa me va a dar una buena tunda cuando vuelva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "¿Qué ha pasado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*Suspira*... Nuestra caravana estaba pasando por aquí sin problemas cuando el volcán entró en erupción. Después, salieron unos Tepetlisaurios morados del suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Por accidente, mi compañero saurio se llevó un buen susto, se alejó del grupo y, cuando me di la vuelta, el camino ya estaba completamente bloqueado. Ahora me es imposible reunirme con los demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "*Suspira*... No sé cómo estarán, pero abandoné el grupo sin permiso, así que la jefa debe de estar furiosa. Estoy acabado, estoy acabado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "Yo ya habría salido corriendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "¿Correr? No, eso es imposible. La jefa es como el Reino de la Noche, está en todas partes. Me encontraría fuera a donde fuese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Tengo que volver a pedir disculpas. Pero ¿cómo? El camino está bloqueado. Estoy acabado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
		},
