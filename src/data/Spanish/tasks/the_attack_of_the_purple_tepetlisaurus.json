					"Tizlo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "¡Oye! ¡Tú, sí, tú! Es peligroso estar fuera, ¡entra ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790402,
					"content": "Ay, ¿es que no has visto el desastre que hay por el camino? El volcán ha entrado en erupción y los monstruos están bloqueándolo. Será mejor que no sigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "#Escúchame, espera aquí un poco y luego únete a nuestra caravana. Así cuidaremos los unos de los otros. Si continúas tú sol{F#a}{M#o}, puede ser muy peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "¿Monstruos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "¡Sí! ¡Un grupo de Tepetlisaurios morados! ¡Se ve que los ha corrompido el Abismo con solo mirarlos! Tienen un gran poder destructivo... A decir verdad, ¡nunca había visto Tepetlisaurios tan aterradores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Deja que te diga que esos infelices hicieron pedazos nuestro carro de un coletazo. Son más fuertes que un Tatankasaurio. La gente normal como nosotros no puede ocuparse de oponentes así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Hazme caso y no te busques la condena peleándote con ellos. Si los ves, sal corriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "No te preocupes, yo puedo con ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "*Suspira*... Está bien, pero ten cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
