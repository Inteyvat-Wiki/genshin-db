			"dialogs": [
				{
					"id": 751790601,
					"content": "Uff... Vaya engorro. ¡Maldición! Casi me derriban unos Tepetlisaurios... ¡Qué rabia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Te equivocas, esos son monstruos del Abismo. Son mucho peores que los Tepetlisaurios. ¡A Paimon no le extraña que estuvieras en apuros si los tratas como si lo fueran!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "#Jaja, ya veo. Eso tiene sentido... Bueno, me gustaría darles las gracias a amb{F#a}{M#o}s. Si no fuera por ustedes, lo habría perdido todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "Esperen aquí un momento, primero tengo que ir a reagrupar a esos inútiles. Les daré las gracias como es debido cuando me haya asegurado de que todos están a salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Con tu ayuda, los miembros de la caravana comienzan a reunirse.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
