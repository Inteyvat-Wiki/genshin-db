			"dialogs": [
				{
					"id": 751790201,
					"content": "*Jadea*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790202,
					"content": "¿Te encuentras bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "E-estoy bien, es solo que salí corriendo a toda prisa y e-el corazón aún me late a mil por hora. Me bastará con un momento para recobrar el aliento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790204,
					"content": "Descansa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "Sí, g-gracias por preocuparte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				}
			]
		},
