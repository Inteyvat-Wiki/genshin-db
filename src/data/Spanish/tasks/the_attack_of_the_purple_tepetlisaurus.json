			"dialogs": [
				{
					"id": 751791301,
					"content": "¡Oye, tú, el grandullón! ¿No es tu trabajo garantizar la seguridad de las caravanas? Entonces, ¿qué haces permitiendo que otros hagan tu trabajo? ¿Algo que decir?",
					"roleType": "TALK_ROLE_NPC",
