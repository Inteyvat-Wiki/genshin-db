						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "¡Eh, tú, d-detente! ¡Todo esto es nuestro, así que ni se te ocurra acercarte! ¡T-te aviso de que yo podría participar en la Guerra de los Peregrinos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "C-como te atrevas a robarnos, ¡lo pagarás caro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "*Suspira*... ¿Qué está pasando hoy? Primero el volcán entra en erupción, luego está lo de ese Tepetlisaurio morado... y ahora, ¿bandidos? ¿Qué clase de mala suerte es esta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "#Masose, es{F#a}{M#e} tip{F#a}{M#o} parece muy fuerte. No podremos con {F#ella}{M#él} ni en sueños, así que será mejor dejarlo... Además, solo hemos venido a ver la competición, no a participar en ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "¿C-cómo puedes decir eso, Itsaho? ¡Estas son las cosas de todos! Es más, a-aquí somos d-dos contra uno, tenemos ventaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "¿Me estás contando a mí también? Si quieres que te den una paliza, bien, pero a mí no me metas en esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "#Amig{F#a}{M#o}, no queremos estas cosas. Si las quieres, tómalas. Tan solo te pido que no nos hagas daño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Me parece que ha habido un malentendido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "#¡Es todo un malentendido! Nosotr{F#a}{M#o}s somos aventurer{F#a}{M#o}s que ayudamos a la gente, ¡no somos personas turbias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "#¿P-por qué iba a creerl{F#a}{M#o}s? ¡Ay, qué daño! ¿Y eso a qué ha venido, Itsaho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "Si tuvieran malas intenciones, ya te habrían dado una buena tunda. ¿Para qué iban a malgastar saliva hablando contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "#La verdad es que nuestra caravana se ha separado. Ya que son aventurer{F#a}{M#o}s, ¿podrían avisar a nuestra jefa de que estamos aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Podrás quedarte con las cosas de esta caja como regalo de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "¡Eso es pan comido, pueden dejarlo en nuestras manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Sí que eres una lumbrera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "#¡Oye! ¡Hablando así parece que somos nosotr{F#a}{M#o}s l{F#a}{M#o}s mal{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
