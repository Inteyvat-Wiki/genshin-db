					}
				]
			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "Claro está que una muestra de agradecimiento así por salvarme la vida resulta un tanto insignificante, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "Sí, ya podrías haber dado más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "¡Jajaja, bien dicho! ¡Me gusta la gente directa como tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "*Ejem*, en fin, este es mi regalo de agradecimiento. ¡Quédatelo con la recompensa! Puedes considerarlo como un extra para comprarle más comida al Tepetlisaurito. ¡No hace falta que me des las gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Bueno, aún tenemos que recoger todas las cosas que hemos perdido por el camino, así que nos despedimos ya. ¡Espero que volvamos a vernos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "No, eso será suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "*Tch*, qué poca franqueza. Así no se puede. Llévatelo, o se correrá la voz y me tildarán de tacaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
