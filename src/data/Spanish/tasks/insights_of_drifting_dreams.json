			"dialogs": [
				{
					"id": 111030701,
					"content": "Con eso terminamos el ritual. ¡Seguimos las instrucciones al pie de la letra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030702,
					"content": "Sí... más o menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030703
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030703,
					"content": "Déjenme el resto a mí. Ustedes prepárense para darle la bienvenida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030704,
					"content": "¿Dónde estoy?... ¿Eh? Ustedes dos me resultan familiares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030705,
					"content": "¿Qué le pasa a mi cuerpo? Me siento... ligero como una pluma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030706,
					"content": "Invocamos tu espíritu con magia adéptica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "¿Magia adéptica? ¡Jajaja! ¿Te atreves a fingir ser un Adeptus en mi presencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030708,
					"content": "Por cierto, ¿qué lugar es este? Estaba descansando serenamente en la Posada Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030712,
					"content": "¡Ah, ya entiendo! Sí, debe ser eso... Tal como se esperaría de un Adeptus como yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030713,
					"content": "¡Debo estar soñando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030714,
					"content": "¡Hum! Este tipo no tiene remedio, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "No estás soñando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "¿Eh? ¿Qué pretenden hacer? ¿De verdad creen que permitiré tal insolencia en mis propios sueños?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030718,
					"content": "#Vamos, {NICKNAME}, hazlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "Pero no puedes sentir dolor en tus sueños...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Sí, porque estás muerto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "¡¿Mu-mu-muerto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030711,
					"content": "¡Imposible! Estaba descansando serenamente en la Posada Wangshu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Ladrón de Estrellas"
				}
			]
		},
		{
			"id": 1110309,
			"completionStepIds": [
				1110309
			],
