				"points": []
			},
			"dialogs": [
				{
					"id": 111030901,
					"content": "¡Espera, por favor! M-me rindo... ¡Me rindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030902,
						111030904
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030902,
					"content": "¿Ahora sí nos crees?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030903
					]
				},
				{
					"id": 111030903,
					"content": "¡Sí! ¡Les creo! Pensé que iba a morir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030906,
					"content": "#¿Por qué tuve la desgracia de conocerl{F#as}{M#os} a ustedes dos?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030907
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030907,
					"content": "Por favor, grandes Adeptus, perdónenme la vida. No volveré a hacerlo nunca más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030908
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030908,
					"content": "Invocamos tu espíritu, pero no somos Adeptus. El verdadero Adeptus es él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030909,
					"content": "Engañaste a la gente con tu charlatanería, te hiciste pasar por un Adeptus, exorcizaste a los demonios sin matarlos y mostraste una total falta de respeto por la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030910,
					"content": "Un día, cosecharás lo que sembraste. ¡Para aquellos que atraen el mal, no hay redención!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030911,
					"content": "Ah... Yo... Usted es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030912
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030912,
					"content": "Parece que Xiao lo asustó tanto que no se atreve ni a hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "Oh, gran Adeptus, ¿puedo preguntar cuál es su nombre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030914,
					"content": "Es el Gran Cazador de Demonios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "¡Es usted! ¡De verdad es usted! ¡Nunca imaginé que un día me encontraría con el Gran Cazador de Demonios, el Guardián Yaksha, en persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030917,
					"content": "¿Conoces a Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "¡Por supuesto! Mi abuelo era un estudioso del folclore. Crecí escuchando historias sobre el Gran Cazador de Demonios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030919,
					"content": "Sigo coleccionando libros sobre los Yakshas hasta hoy en día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030920,
					"content": "Pero desde que descubrí un Sello del Permiso mientras buscaba entre los objetos personales de mi abuelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030921,
					"content": "Al principio, solo imitaba a los Adeptus por diversión, pero con el tiempo comencé a alejarme más y más del camino del bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030922,
					"content": "Así que esa es tu historia... Entonces, básicamente, eres admirador de Xiao, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "Sí. Gracias a ambos por darme la oportunidad presenciar al Gran Cazador de Demonios en carne y hueso. ¡Es como un sueño hecho realidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030924,
					"content": "En realidad, esa no era nuestra intención...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Oh, Gran Cazador de Demonios, permítame hacer este juramento ante usted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030926,
					"content": "¡Juro alejarme del mal, vivir una vida honesta y no manchar el nombre de los Adeptus nunca más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030927,
					"content": "Recordaré tu juramento. Ahora, vete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Gracias... Mil gracias por su perdón, y por todo lo que ha hecho por Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111030929,
					"content": "Ese juramento que hizo pareció bastante sincero. Supongo que ya no seguirá engañando a la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "¡Espera! Aún no hemos recuperado el Sello del Permiso. ¡Vayamos a la Posada Wangshu mañana a primera hora a buscarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "Es el Guardián Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "¿Sigues haciéndote pasar por un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "No, de ninguna manera. Por poco muero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Ladrón de Estrellas"
				}
			]
		},
		{
			"id": 1110310,
			"completionStepIds": [
				1110310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
