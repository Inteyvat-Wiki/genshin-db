					"nextDialogs": [
						752130403
					]
				},
				{
					"id": 752130403,
					"content": "¿Bebida? No pedí ninguna bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130404
					],
					"speakerTitle": "Turista vestido de azul"
				},
				{
