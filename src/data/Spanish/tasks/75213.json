				"points": []
			},
			"dialogs": [
				{
					"id": 752130201,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "¿Eh? ¿En serio? Bueno, si insistes... Ya enviamos a todos los empleados a hacer otras cosas, y todavía tenemos una entrega urgente pendiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "Hay una nota en el pedido para que se envíe al <color=#00E1FFFF>cliente de pantalones azules en la playa</color>. Lo más importante es que llegue a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "¡Muchas gracias! Además de la comisión por la entrega de este pedido, también te regalaré la receta de nuestra bebida como compensación. ¡Cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
