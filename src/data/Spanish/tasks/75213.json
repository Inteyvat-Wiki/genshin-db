			"dialogs": [
				{
					"id": 752130601,
					"content": "¡Hola! Aquí está tu bebida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "#¡Oh! ¡Oh! Así que son repartidor{F#a}{M#e}s. Me preguntaba por qué no la había recibido en todo este tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "¡Ha sido culpa tuya! Dejaste una nota en el pedido que decía: “Para el cliente de pantalones azules en la playa”, pero te escondiste en la arena y nos costó mucho encontrarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "¡Deberías pagarnos el doble por las molestias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Oh, lo siento, lo había olvidado. Debería haber puesto los pantalones a un lado para que pudieran encontrarme fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "¿Por qué te entierras en la arena?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Porque es muy divertido. He oído que muchas personas hacen esto cuando van de vacaciones, así que quería probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Pero tu postura no es la correcta. Pareces un rábano enterrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "¿Eh? ¿Y qué tiene de malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Es fácil que los demás se tropiecen y te lastimen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Entendido, lo tendré en cuenta. ¡Gracias! ¡Aquí tienen la propina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
