			"dialogs": [
				{
					"id": 710750101,
					"content": "¡Eh! Eres tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750102,
					"content": "Llevo mucho tiempo buscando a ese tal Erge y no he podido encontrarlo. ¡Tú que conoces mejor este lugar, deberías poder hacerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750103,
					"content": "¿No? Bueno, entonces hay que buscar a alguien que sí pueda, obligarle a encontrarlo y quitárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750104,
					"content": "La gente me llama “el Pequeño Chingtsé” y ningún mísero minero miedoso va a detenerme. Si no, sería el hazmerreír de todos. Así que ¡vamos, dámelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750105,
					"content": "Nos llevaremos el tesoro de la Geoarmada, ¡muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750106,
					"content": "No sé qué buscas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "¿Y tengo que creerme lo que digas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750109,
					"content": "Hum... Yo pensaba que con tanta ida y venida, te habrías vuelto más fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750110,
					"content": "Tienes dos opciones. O me das el Casco de protección ahora, o me lo das después de que te haya dado una paliza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750111,
					"content": "No creo que quieras luchar conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "#Vaya, tenemos aquí a {F#una fanfarrona}{M#un fanfarrón}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750113,
					"content": "¡Al final parece que será por las malas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				},
				{
					"id": 710750107,
					"content": "Aquí no está lo que buscas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				}
			]
		}
	]
