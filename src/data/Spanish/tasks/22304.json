			"dialogs": [
				{
					"id": 223040301,
					"content": "Sí, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040302
					]
				},
				{
					"id": 223040302,
					"content": "Bien, te marcaré los lugares ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040303,
					"content": "Después de que encuentres los tesoros, no olvides regresar para repartirlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
