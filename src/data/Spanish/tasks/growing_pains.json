					"nextDialogs": [
						225001008
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001008,
					"content": "Pero lo más importante es que la fragancia es perfecta para una niña como Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001009
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001009,
					"content": "La fragancia de una niña es mucho más que un simple olor...",
