					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "Vaya, eres tú de nuevo. ¿Me extrañabas? ¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "Vine a recoger algo para Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "¿Para Lulu?... Oh, cierto. Me pidió que le hiciera un perfume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "Pero me temo que este no es el mejor momento... Por alguna razón, desde la última vez que viniste, cada vez más gente pide perfumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "Tengo una enorme cantidad de pedidos. Es demasiado para mí sola, sobre todo porque también tengo que atender la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "Además, Lulu es solo una niña. Sería un poco inapropiado darle el mismo tipo de perfume que usan las mujeres adultas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "Así que estaba pensando en una forma de hacer que mi perfume fuera más apto para los niños. Hace poco, se me ocurrió una fórmula adecuada, pero aún no la he probado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "Si es tan urgente, podría comenzar ahora, es solo que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
