			"dialogs": [
				{
					"id": 225000501,
					"content": "El perfume está listo. Hice una versión personalizada con el aceite esencial de menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000502,
					"content": "Aquí tienes. Llévaselo a Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000503,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "¿Por qué menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Contrarresta algunos de los componentes más... estimulantes con su aroma neutro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000506,
					"content": "Para ser sincera, me sorprendió mucho recibir un pedido de Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000507,
					"content": "Me recuerda a mí misma a su edad, cuando una vive el amor por primera vez. ¡Oh! ¡Cómo palpita el corazón!... Si hubiera sido un poco más sabia en ese entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000508,
					"content": "*Ejem*... En fin, deberías volver con Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
