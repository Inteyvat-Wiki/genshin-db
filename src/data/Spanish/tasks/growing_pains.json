			"dialogs": [
				{
					"id": 225000401,
					"content": "Puedo ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "Eso me vendría muy bien. Después de todo, tienes mucha experiencia con estas cosas. De eso estoy segura, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000403,
					"content": "Por suerte, tengo por aquí algunos ingredientes que me han sobrado. Iré a la cocina del Chef Mao para hacer los preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Ve a recoger tres hojas de menta, y luego extrae su aceite esencial en una mesa de fabricación. Supongo que sabes cómo usarla, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000405,
					"content": "Tráeme el aceite esencial de menta, yo me encargaré del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
