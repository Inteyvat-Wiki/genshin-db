			"dialogs": [
				{
					"id": 225000301,
					"content": "¿Qué te parecen 3000 Moras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "¡Guau! Si tienes tanta prisa... Muy bien, le daré prioridad al perfume de Lulu, solo por nuestra amistad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000303,
					"content": "Pero tengo que cuidar de la tienda durante el día, mis asuntos personales los atiendo de noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000304,
					"content": "Pasa esta noche, lo tendré listo para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
