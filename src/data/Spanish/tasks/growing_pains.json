						225001003
					]
				},
				{
					"id": 225001003,
					"content": "#¿Lo olvidaste? Pero si lo hicimos junt{F#as}{M#os} hace poco. Qué rápido te olvidas de las cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
