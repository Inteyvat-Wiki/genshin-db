					"Pequeña Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "¿Cuándo estará listo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000102,
					"content": "¿Hoy no van a jugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "¡Oh, hola! No, últimamente no jugamos mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000104,
					"content": "Meng está de mal humor y se pasa el día enfadado, y Fei desaparece a cada rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000105,
					"content": "Le pregunté a Meng qué le pasaba, pero no me lo quiso decir. Ambos actúan muy extraño últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000106,
					"content": "Bienvenida al mundo de los adultos, niña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "¿Así que cuando creces dejas de ser feliz? Entonces, ¿por qué Meng y Fei tienen tantas ganas de crecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000108,
					"content": "Entonces no quiero ser grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000109,
					"content": "En fin, estamos cambiando de tema. Necesito que me ayudes con algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000112,
					"content": "¿Puedes traerme algo de la tienda de Ying'er? Ya hablé con ella, debe estar listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000113,
					"content": "Con gusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "¡Qué bien! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000115,
					"content": "Conque la tienda de Ying'er, ¿eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "No sé en qué estás pensando, pero no es eso. Solo le pedí a Ying'er que hiciera algo para mí, y ella dijo que lo haría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000117,
					"content": "Así que ¿me ayudarías, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 225000110,
					"content": "¿Tú también estás triste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "¿Yo? No, estoy bien, pero... necesito que me ayudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Pequeña Lulu"
				}
			]
		},
