			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "Podría decirse que soy su maestro y no estaría exagerando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "¡Oh! Recopilé gran cantidad de informes de investigación del Instituto de Ciencias de Fontaine para la señora. Ella no para de elogiar los resultados de la investigación del profesor Mosso. ¿Acaso es usted...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "*Ejem*... Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "#E-eso, parece que la fama {F#de la profesora}{M#del profesor} Mosso ha llegado hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Hum, según lo que tengo entendido, el profesor Mosso falleció hace treinta años. ¡Y tú vas a seguir pronto sus pasos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
