					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Por supuesto, yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Después de golpear varias veces el Patrullero Terrestre, ahora sí que no se mueve ni un poco...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Parece que... ¿se ha averiado por completo? ¡¿Qué vamos a hacer ahora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "#Hum, ya sabía yo que algo no encajaba contigo. ¿Qué clase de investigador{F#a} de verdad hablaría así? ¡Eres un{F#a} impostor{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
