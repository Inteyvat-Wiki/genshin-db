			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "¡Soy Sandrone, una de Los Once!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "¿Eh? ¿A-ahora hablamos así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Hum, tienes agallas, pero veo que te estás riendo de los Fatui con una mentira tan osada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
