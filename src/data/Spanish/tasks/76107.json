					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "#Soy un{F#a} investigador{F#a} contratad{F#a}{M#o} por La Títere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "#¿Un{F#a} investigador{F#a}? Me resulta difícil de creer que alguien como ella contratara a un{F#a} investigador{F#a} extern{F#a}{M#o}, dado que ella es una experta como ninguna otra en el tema de la investigación de las máquinas y el kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "La investigación científica se basa en la colaboración.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Eso es cierto, he recopilado gran cantidad de informes de investigación del Instituto de Ciencias de Fontaine para la señora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "#Bueno, ya que es un{F#a} expert{F#a}{M#o} en la materia, seguro que no será un problema para usted reparar el fallo de este Patrullero Terrestre, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "Eh... me dedico más a la investigación teórica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "¡Ah, ya veo! La investigación teórica del kuuvahki es uno de los campos más complejos del conocimiento, ¡es realmente impresionante! Por otro lado, el mantenimiento del Patrullero Terrestre es algo más bien práctico. Definitivamente son dos cosas muy diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "Sin embargo, La Títere no se encuentra aquí en estos momentos, así que puede ir en busca de la comandante Azalea, puede que ella sepa el plan que deben seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
