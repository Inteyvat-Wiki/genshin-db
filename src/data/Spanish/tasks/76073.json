				},
				{
					"id": 760730106,
					"content": "Háblame de Raskólnikov.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760730107
					]
				},
				{
					"id": 760730107,
					"content": "Ah, él... Antes era el alumno favorito y más brillante de mi padre. ¿Y parece que ahora también destaca entre los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760730108
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760730108,
					"content": "Yo llegué a admirarlo mucho, quería ser como él... Pero, por más que lo intentara, no podía superarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760730109
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760730109,
					"content": "Humm, siempre había pensado que nunca había recaído en mí, pero esta vez pude sentir su hostilidad. Me pregunto por qué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760730110
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760730110,
					"content": "Además, dijo que yo era arrogante... No sé de dónde salió eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
