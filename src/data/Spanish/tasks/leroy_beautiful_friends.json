			"dialogs": [
				{
					"id": 741570301,
					"content": "Esta casa está a la venta. Precio asequible. ¡Resérvela ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Casa en venta"
				},
				{
					"id": 741570302,
					"content": "#¡{NICKNAME} y Paimon! ¿Han venido para visitar al Sr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570303,
					"content": "¿Está Benoit en casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "No está. Papá dijo que el Sr. Leroy no iba a volver a vivir aquí. Se ha ido a vivir bajo tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570308,
					"content": "¿Al Río Ceniciento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "¿Al mismo Río Ceniciento al que fuimos anteriormente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "No, no es ese. El lugar que dijo papá está aún más bajo tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570311,
					"content": "«El Pájaro de Vapor» dijo que el Sr. Leroy se cayó de un lugar muy alto mientras escalaba y se dio un buen coscorrón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570312,
					"content": "La verdad es que no entiendo muy bien la relación entre caerse de un lugar muy alto y mudarse de casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570313,
					"content": "Por cierto, ¡he visto al yerno del Sr. Leroy! Y también había una señora muy amable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570314,
					"content": "Le caí muy bien a la señora, ¡y tenemos el mismo color de ojos! Ojos de color calavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570315,
					"content": "Incluso me preguntó dónde vivía, y dijo que vendría a verme si tenía tiempo, ¡y también dijo que seríamos amigas! ¡Parece que todos en la familia Leroy son buenas personas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570316,
					"content": "*Suspira*, hasta traje algunas burburanjas para el Sr. Leroy, pero como ya no está aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570317,
					"content": "¿Puedo dárselas a ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570318,
					"content": "¡Gracias, Moli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "¡No hay de qué! Mi mamá y mi papá siempre dicen que hay que ser generosos con los amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570320,
					"content": "¡Hoy también he hecho una buena acción! Cuando regrese, lo escribiré en mi diario. ¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570321,
					"content": "Mientras ven cómo la alegre Moli desaparece de la calle, la historia de la familia Leroy llega a su fin.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Solo pasábamos por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "Estaba pensando en si debía decirles que el Sr. Leroy se ha mudado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570307,
					"content": "Papá dijo que el Sr. Leroy no iba a volver a vivir aquí. Se ha ido a vivir bajo tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Moli"
				}
			]
