			"dialogs": [
				{
					"id": 741570201,
					"content": "Esta casa está a la venta. Precio asequible. ¡Resérvela ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "Casa en venta"
				},
				{
					"id": 741570202,
					"content": "#{NICKNAME}, Paimon, ¡parece que el Sr. Leroy ya no vive aquí! ¿Lo han vuelto a ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570203,
					"content": "(Oye, ¿quieres que le digamos la verdad?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570204,
					"content": "Nos lo hemos encontrado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "¡Así que lo han visto! ¿Le dijeron que los dulces estaban deliciosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570206,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#¡Sabía que {NICKNAME} era de fiar! Son muy amables. Tomen, he traído burburanjas, ¡coman unas pocas conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570214,
					"content": "Moli suspira y se despide con la mano, pero justo cuando iba a marcharse...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "La puerta se abre, y Automne y Atos salen de dentro.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "Así que las voces que estábamos oyendo eran de ustedes. ¿Quieren algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570217,
					"content": "Solo pasábamos por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "¿De verdad? Sí que es pequeño el mundo. Automne y yo justamente íbamos a salir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570219,
					"content": "¿Y Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "Oh, ya se ha marchado a otro lugar. Un lugar al que iremos dentro de unas décadas. No creo que vuelvan a verlo próximamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570221,
					"content": "Aunque es difícil saber qué llegará antes, si el mañana o un imprevisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570225,
					"content": "Oh, ¿esta no es la diablilla que siempre anda buscándolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570227,
					"content": "¡Hola, señora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570228,
					"content": "... Eres igual que ella. Hasta tienes los ojos de color calavanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570229,
					"content": "Señora... ¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570230,
					"content": "¿Cuántos años tienes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570231,
					"content": "¡Nueve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570232,
					"content": "¿Cómo se llaman tus padres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570233,
					"content": "Humm... ¿Se encuentra bien, señora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570234,
					"content": "Tu expresión... ¿Qué pasa con esta niña?... Espera, no puede ser una coincidencia tan grande, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570235,
					"content": "¿Eres adoptada? Dime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570236,
					"content": "#... {NICKNAME}, Paimon, ¿conocen a esta señora? ¿Qué le pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570237,
					"content": "¿Quién hace preguntas como esas? Permíteme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570238,
					"content": "Jovencita, recuerdo que te llevabas muy bien con nuestro padre, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570239,
					"content": "¡Sí! El Sr. Leroy es muy amable conmigo. Señor yerno, ¿es que él ya no vive aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570240,
					"content": "Así es. Se ha ido a un lugar muy lejano y ya no va a volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570241,
					"content": "¿De qué hablan normalmente con mi suegro? ¿Me lo puedes contar? Cuando vuelva, puedo decirle que lo echas de menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570242,
					"content": "El Sr. Leroy siempre me ha regalado dulces, me deja acariciar a Nana ¡y me dice que tengo unos ojos bonitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570243,
					"content": "¿Algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570244,
					"content": "Me suele pedir que le dé saludos a papá y a mamá de su parte, pero a ellos no les suele gustar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570245,
					"content": "Papá se enfada mucho y dice que el Sr. Leroy es una mala persona porque los “chantajea”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570246,
					"content": "Aunque me prohibieron venir por aquí, yo llegué a un acuerdo con el Sr. Leroy, así que sigo viniendo a escondidas. Por favor, señor, ¡no se lo diga a mi padre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570247,
					"content": "Así es él. No iba a detenerse hasta haber exprimido la última gota de valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570248,
					"content": "... Ese desgraciado... Perdón. Estábamos hablando de otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570249,
					"content": "S-señor, señora, ¿quieren algo más? Si no, yo t-tengo que volver a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570250,
					"content": "... Tu papá y tu mamá, ¿te quieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570251,
					"content": "Son los mejores padres del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570253,
					"content": "Bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570254,
					"content": "¡Me voy! ¡Adióóós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570255,
					"content": "Hasta la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570256,
					"content": "¿Vas a dejarlo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "Me he imaginado este escenario muchas veces... Pero ninguno es mejor que saber que es feliz. Eso es suficiente para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570259,
					"content": "Yo... Yo no soy mi padre. No quiero causarle problemas a su familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570260,
					"content": "No quiero estropear el momento, pero ¿no le habías comprado una caja de música? ¿Por qué no se la das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570261,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570262,
					"content": "No hace falta. Ella... No parece que necesite ese tipo de cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570263,
					"content": "Seguiré pensando en formas de visitarla de forma regular en el futuro. Si necesita algo, encontraré la forma de ayudarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570264,
					"content": "... Le daré la caja de música a otra persona. Al fin y al cabo, he invertido mucho tiempo en escogerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570265,
					"content": "Disculpa, pequeña de pelo blanco. ¿Te gustan los regalos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570266,
					"content": "¿Te refieres a Paimon? ¿Quieres regalárselo a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570267,
					"content": "Sí. Es un regalo, así que disfrútalo. Espero que tenga algo de valor para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570268,
					"content": "Lo siento, Atos, pero creo que tendremos que quedarnos un poco más en la Corte de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570269,
					"content": "No te preocupes. A mí no me importa dónde vayamos. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570270,
					"content": "Mientras se quedan observando cómo la pareja desaparece de la calle, la historia de la familia Leroy llega a su fin.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "¿No piensas decirle nada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "¿Cómo está Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "El mundo está lleno de desigualdad, pobreza extrema y avaricia desmedida. Los castigos que las leyes de Fontaine son incapaces de impartir, los impartimos nosotros mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570224,
					"content": "Lo que quiero decir es que ha ido a donde debía ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570208,
					"content": "Se nos olvidó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "Oh, vaya. Qué pena. *Suspira*, supongo que no volveré a tener la oportunidad de decírselo. Entonces, las burburanjas que he traído... se las doy a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570210,
					"content": "No lo hemos visto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "Vaya, qué pena. Supongo que no volveré a verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570212,
					"content": "He traído algunas burburanjas con la idea de dárselas al Sr. Leroy, pero como no está... Tomen, para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570213,
					"content": "Pase lo que pase, yo siempre lo recordaré. ¡Adiós, Sr. Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Moli"
				}
			]
		},
