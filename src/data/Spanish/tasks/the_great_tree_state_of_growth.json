			"dialogs": [
				{
					"id": 230290401,
					"content": "¿Y bien? ¿Pudieron registrar el Árbol Sagrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290402,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "¡Oh! Veamos, ¿qué tenemos aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290404,
					"content": "Pues no está nada mal. El ángulo está perfecto, y la imagen es bastante nítida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290405,
					"content": "#Aquí tienes la recompensa. Gracias por ayudarme, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290406,
					"content": "Tanto el tronco como las ramas están en buen estado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290407,
					"content": "Solo falta que Ladep y Farés recopilen los datos pertinentes y podremos pasar al siguiente asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
