			"dialogs": [
				{
					"id": 230290101,
					"content": "Ya casi es la hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290102,
					"content": "¿Sigues investigando las raíces del Árbol Sagrado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "#Hola, viajer{F#a}{M#o}, siempre tan oportun{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290104,
					"content": "¡Muchas gracias por tu ayuda! El Árbol Sagrado está en perfectas condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290105,
					"content": "Estuve hablando con Ladep y cree que se mantendrá así de sano durante mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290106,
					"content": "Parece que por fin podremos ponernos manos a la obra con nuestra tesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290107,
					"content": "Mira, Farés me ha dejado su Daguerrotipo. Iba a sacar unas cuantas imágenes del Árbol Sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290108,
					"content": "¿Por qué no me ayudas a sacar una imagen panorámica del Árbol Sagrado? Mira, te marco la ubicación en el mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290109,
					"content": "Claro, iré ahora mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "¿Por qué no lo haces tú misma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Bueno, es que... Está muy alto para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290112,
					"content": "Tengo miedo a las alturas. Me da la sensación de que el viento me llevará volando... o a mis apuntes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230290113,
					"content": "#Normalmente es Farés el que se encarga de esos registros, pero parece que hoy está muy ocupado. Eres {F#la única}{M#el único} en quien puedo confiar, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
				}
			]
		},
