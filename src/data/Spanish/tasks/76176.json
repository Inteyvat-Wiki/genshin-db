						],
						"pointId": 344
					}
				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "... Aria, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "Esto va mucho más allá de un simple “castigo”... Además, no es la primera vez que lo hace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Tanto la ciudad de los dragones que nuestro rey nos confió como esos hogares frágiles y hermosos que construyeron los pequeños humanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "¿Cuántas vidas inocentes más tienen que ver morir para dejar de quedarse sin hacer nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "Si nuestro rey siguiera aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "Pero él no está aquí, Sonnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "Si ese soberano, tan lejos de ser omnipotente, considera este destino pálido y cruel como “orden”; si esta es la única forma de evitar que este mundo condenado sea devorado, entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "Por doloroso que sea el precio que exija... por mucho que me entristezca... sigue siendo mejor que el silencio sepulcral de la oscuridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "Pero si el mundo está predestinado a la destrucción... ¿qué sentido tiene luchar contra la oscuridad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "... ¿Sonnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "¡N-nada, Aria! ¡No dije nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "Solo creo que no deberíamos quedarnos de brazos cruzados mientras ese tirano masacra a los seres vivos que confían en nosotras... ya sean dragones o aquellos pequeños humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "¿No deberíamos... salvarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "... Entiendo la rabia de Sonnet, Aria. A mis ojos, lo que ha hecho ese soberano sí que es demasiado cruel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "Aunque solo exista la más mínima posibilidad... haré todo lo que esté a mi alcance para salvar a quienes aún puedan salvarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "Pero ¿qué hay de los que no se salven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Aquellos que no logramos salvar, las vidas que se pierden... ¿Acaso sus lágrimas, su sangre y sus lamentos están condenados a desaparecer sin dejar rastro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "No... No debería ser así. Quiero que todos puedan salvarse. Que nadie caiga en la perdición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "Si tan solo su “orden” muriera junto con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "... Sonnet, no olvides la razón por la que nacimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "Nuestra única misión es sostener este mundo hasta que el rey que nos dio la vida regrese desde la distancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "Desde el principio sabíamos cuál era el precio de este orden... pero no podíamos permitir que el mundo avanzara hacia la destrucción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "... No, Aria. Esto ni siquiera tiene que ver con el orden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet, para nosotras... para mí, eres nuestra hermanita más importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "Así que... por favor, no hagas nada que nos cause dolor a Aria y a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "No te enfrentes directamente al orden de los cielos. Al menos... no ahora, mientras el mundo sigue siendo tan frágil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "Canon... yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Astaroth me habló de una palabra que pertenece solo a los humanos... “esperanza”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "Mientras haya vida, habrá esperanza... Siempre habrá esperanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}