				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "*Jadea*, no ha... sido fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350202,
					"content": "Siento que me hayas tenido que ver así. No esperaba ponerme tan nervioso a la hora de la verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350203,
					"content": "#Supongo que aún tengo que seguir entrenando. Gracias, viajer{F#a}{M#o}. Acepta esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350204,
					"content": "¿De verdad piensas marcharte de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "Bueno, no lo tengo decidido aún, pero estoy pensándolo. Mientras tanto, me gustaría convencer a Chue'er para que venga conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		}
	]
}