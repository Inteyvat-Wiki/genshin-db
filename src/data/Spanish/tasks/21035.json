			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "*Suspira*, Chue'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350102,
					"content": "¿Sun Yu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "#¿Viajer{F#a}{M#o}? Qué casualidad verte aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350105,
					"content": "V-verás, estaba entrenando un poco, preparándome para cuando me marche de Liyue, ya sabes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350106,
					"content": "¿Vas a abandonar Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "*Suspira*, bueno, la verdad es que es un poco bochornoso... Lo cierto es que no dejo de repetir que estoy intentando restaurar la gloria del Clan Guhua, pero lo único que hago es deambular por el Desfiladero Jueyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350109,
					"content": "Sé que Chue'er nunca diría nada, pero así jamás conseguiré hacer nada por el clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350110,
					"content": "Hace poco fui a la ciudad a comprar algunas cosas y escuché a un comerciante de Fontaine hablando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350111,
					"content": "Me dijo que “la solución a un problema no está en el lugar del problema”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350112,
					"content": "He estado pensando mucho sobre aquella frase. Tal vez lo que quería decir era que debía ir a otros lugares más allá de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350113,
					"content": "Viajar te cambiará la vida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "¡Eso mismo pienso yo! Pero Chue'er no está dispuesta a dejar Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350116,
					"content": "Normalmente, cuando se enfada, no suele durarle mucho y es más bien por cosas sin importancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350117,
					"content": "Pero esta vez parece realmente molesta. Da igual lo que diga, no me hace caso. Incluso se ha marchado a la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350118,
					"content": "#Bueno, no quiero aburrirte con mis dramas, así que dejemos eso a un lado. Dime, viajer{F#a}{M#o}, ¿te importaría hacerme un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350119,
					"content": "He aprendido algunos movimientos defensivos a lo largo de los años, pero casi nunca he tenido oportunidad de ponerlos en práctica. Si voy a emprender un viaje, no sería de extrañar que me encontrara con algún que otro peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350120,
					"content": "He oído muchas historias sobre tus hazañas, y estoy seguro de que te habrás enfrentado a todo tipo de enemigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350121,
					"content": "¿Te importaría acompañarme y luchar conmigo contra algunos monstruos? Ya sabes, para darme algunos consejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350122,
					"content": "Sin problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "Veamos... Hay un campamento de monstruos ahí delante. Pasemos por ahí primero, ¿te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350123,
					"content": "Espero que puedas ver mis movimientos con claridad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "#¿T-tan diestr{F#a}{M#o} eres? Jajaja, entonces intenta tomártelo con calma, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350114,
					"content": "Tal vez te sirva para ver las cosas desde otra perspectiva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "¿No estabas intentando restaurar la gloria del Clan Guhua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
		{
			"id": 2103502,
