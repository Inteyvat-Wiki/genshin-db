			"dialogs": [
				{
					"id": 747120101,
					"content": "#Tengo las mejores noticias que compartir con ustedes, {NICKNAME} y Paimon: ¡todo está resuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120102,
					"content": "¡La operación de desescalada de agresividad en peces ha sido todo un éxito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120103,
					"content": "Una vez que los buzos hayan despejado toda la chatarra del fondo y nuestros pacientes estén un poco más tranquilos, podremos devolverlos a la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120104,
					"content": "Muchas gracias por todo su esfuerzo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "#Jeje, tú también has trabajado tan duro como nosotr{F#a}{M#o}s, Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120106,
					"content": "He redactado un informe del incidente y lo he enviado al Palacio Mermonia. Un especialista en ese campo debería estar elaborando la normativa correspondiente y notificará a las agencias pertinentes en breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120107,
					"content": "También he oído que algunos periodistas, e incluso un director de kinografías, han mostrado gran interés en este asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120108,
					"content": "¿Quién sabe? Quizás algún día hasta podamos ver una kinografía sobre la importancia de proteger los ecosistemas acuáticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120109,
					"content": "¡Eso sería genial! Puedes hablar con la gente todo lo que quieras, pero siempre habrá personas descuidadas o tercas que se nieguen a escuchar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120110,
					"content": "Necesitan ver algo terrorífico... para que piensen que si el medioambiente sufre daños graves, los peces... ¡mutarán hasta convertirse en monstruos gigantes e invencibles que lo destruirán todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120111,
					"content": "¡Quienes tiran basura al mar deberían tener las pesadillas más espeluznantes! ¡Así aprenderán a respetar la naturaleza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120112,
					"content": "¡Qué idea tan brillante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		}
	]
}