			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Pobre Yumkasaurito... ¡Qué seres tan despreciables! ¡Les enseñaré una lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260102,
					"content": "Canallas... Pueden intentar huir, ¡pero no encontrarán dónde esconderse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260103,
					"content": "¿Qué ha pasado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "#Tú eres... {F#la viajera forastera}{M#el viajero forastero}, ¿verdad? Disculpa, no he podido darte una bienvenida en condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260105,
					"content": "Esos ladrones de tesoros desgraciados querían llevarse al pequeño Yumkasaurio. Menos mal que he podido llegar y ahuyentarlos a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260106,
					"content": "Seguro que el pequeño Yumkasaurio estaba aterrorizado. Por más que lo llamase, no se atrevía a acercarse a mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260107,
					"content": "Pero al menos ahora ya sé por dónde se mueven esos ladrones de tesoros. Luego iré a darles una buena tunda, ¡los ataré a los árboles y les daré una paliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260108,
					"content": "También, debería ir a buscar algo rico de comer para el Yumkasaurito, quizá así se sienta un poco mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
