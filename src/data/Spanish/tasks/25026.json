			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "El pequeño suele estar por esta zona. Pero hoy, no he visto ni rastro de él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260302,
					"content": "Quizá se haya escondido por el susto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260303,
					"content": "¿Vamos a buscarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "No hace falta. Es mejor dejar que se calme un poco primero. Dejemos las setas aquí, ya saldrá cuando él quiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260305,
					"content": "Se nota que tienes experiencia con los bebés saurio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "Simplemente he cuidado de él antes. Es un saurito muy sensible, se asusta solo con toparse con alguien desconocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260307,
					"content": "Estuve alimentándolo durante mucho tiempo, él dependía de mí... *Suspira*, pero ahora que esos estúpidos le han dado un susto de muerte, seguro que no se atreve a salir de su escondite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260308,
					"content": "No queda más remedio que esperar a que se tranquilice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260309,
					"content": "Muchas gracias por acompañarme. Aquí tienes tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260310,
					"content": "Qué pena no haber podido conocerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "No te preocupes. Ese pequeño no olvida a la gente que se ha portado bien con él. Cuando se sienta con más confianza, seguro que vendrá a buscarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260311,
					"content": "Cómo me hubiera gustado ver a ese adorable Yumkasaurito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
