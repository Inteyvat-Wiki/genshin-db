			"dialogs": [
				{
					"id": 250260401,
					"content": "Démosles su merecido a esos ladrones de tesoros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#¿Vienes conmigo? Estupendo, solo con verte ya puedo sentir que eres {F#una aventurera}{M#un aventurero} con experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "Te recompensaré según los estándares de los aventureros. Vamos, ¡en marcha! Esos ladrones de tesoros se acordarán de nosotros para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
