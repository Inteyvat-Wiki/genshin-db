			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "Primero vayamos a consolar al pequeño Yumkasaurio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "Oh... Tienes razón, el bebé debe de estar muy asustado... Es mejor que vayamos a tranquilizarlo primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260203,
					"content": "#Acompáñame, entonces. Cualquiera podría percibir que eres {F#una aventurera experimentada}{M#un aventurero experimentado} a simple vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260204,
					"content": "Si vamos juntos, esas sabandijas no se atreverán a enfrentarse a nosotros. Por supuesto, no tienes que preocuparte por la recompensa. Te compensaré de acuerdo a las reglas de los aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260206,
					"content": "Humm... Creo que a esa criatura le gustaría comer setas sombrillavela. Recuerdo haber visto muchas de ellas bajo los árboles de esa zona, ¿podrías ir a recoger unas cuantas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260205,
					"content": "Iré a otro lugar a buscar setas sombrillavela. Cuando tú ya hayas recogido tu parte, nos encontraremos en el acantilado que hay junto a la Arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260207,
					"content": "He visto muchas veces al saurito descansando allí. Quizá logremos encontrarlo en ese lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
