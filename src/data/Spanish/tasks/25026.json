			"dialogs": [
				{
					"id": 250260501,
					"content": "Hum, apuesto a que a la próxima se lo pensarán dos veces antes de acercarse al pequeño Yumkasaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "¿Por qué tengo la sensación de que algo se ha malinterpretado aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Ni se te ocurra confiar en sus dulces palabras. Yo lo he visto con mis propios ojos, iban a usar una cuerda para atar la cola del Yumkasaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Si no llego a estar allí, no quiero imaginar qué habría sucedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260505,
					"content": "Gracias de nuevo, te has ganado esta recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260506,
					"content": "Qué pena que los ladrones de tesoros corran tan rápido. Si hubiéramos logrado alcanzarlos, ¡habríamos acabado con todos ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
