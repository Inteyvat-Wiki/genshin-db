				]
			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#{NICKNAME}, Paimon ha notado que últimamente hemos tenido muchos encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510102,
					"content": "Y como Paimon es una guía muy considerada, tiene el deber de ayudarte a relajarte un poco. ¡Tachán! ¡Adivina qué sitio es este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510103,
					"content": "Bueno, en el cartel pone: Grandes Almacenes Damoville.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "La guarida de los ladrones de Mora y el cementerio de las carteras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "Hola, les damos la bienvenida a los Grandes Almacenes Damoville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510106,
					"content": "#Estimad{F#a}{M#o} client{F#a}{M#e}, por favor no diga eso. En los Grandes Almacenes Damoville ofrecemos productos de calidad a buen precio. Puede comprobarlo usted mism{F#a}{M#o} si así lo desea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510107,
					"content": "Esta no es una tienda cualquiera, es un lugar en el que los trabajadores pueden relajarse a cambio de Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510108,
					"content": "Así es, no podría haberlo dicho mejor. ¡Además, ahora tenemos una oferta de dos por uno para todos los clientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510109,
					"content": "Si lo compras, yo pierdo. Si no lo compras, ¡yo gano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510110,
					"content": "Hace un tiempo Paimon vio el cartel con la oferta de los Grandes Almacenes Damoville y le llamó la atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510111,
					"content": "¡Compras una cosa y te dan otra gratis! Es una gran oferta se mire por donde se mire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510112,
					"content": "#Paimon tiene la sensación de que, si no compra algo aquí, su vida no va a estar completa... {NICKNAME}, tenemos que remediar esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510113,
					"content": "¿Qué te gustaría comprar, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "Paimon, ¿cómo quieres remediar esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "Jeje, Paimon te lo dirá más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510116,
					"content": "Entonces no voy a pagarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "Jeje, hoy no hace falta que pagues tú. Paimon trajo su propio dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510118,
					"content": "#Hola, ¿ya llegó lo que encargó Paimon? La reserva está a nombre de Paimon y {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510119,
					"content": "Sí. Un momento, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510120,
					"content": "Boucicaut trae algo tan bien envuelto que no se puede ver bien qué es. Paimon, a tu lado, saca un montón de Moras y pone una cara triste al ver cómo se alejan de ella.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "Abres el paquete junto a Paimon y descubres que se trata de dos álbumes de imágenes.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "¡Por fin! ¡Paimon llevaba mucho tiempo queriendo conseguirlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510123,
					"content": "Paimon ha capturado muchas imágenes todo este tiempo, ahora tendrá un sitio para guardarlas todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510124,
					"content": "Pero si nunca te vi usar un Daguerrotipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "Eso es porque Paimon no lo saca cuando tú estás mirando, pero tiene un montón de imágenes que tomó de ti sin que te dieras cuenta, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510126,
					"content": "Me han entrado ganas de verlas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "¡Rápido, enséñamelas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "¡Todavía no! Espera a que Paimon termine un álbum entero primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510129,
					"content": "Paimon, eres una tacaña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "Pero mira que eres mala, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "¡No es cierto! En fin, este álbum es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510132,
					"content": "Este álbum es un poco delgado, pero se pueden poner muchas imágenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510133,
					"content": "#Hemos ido a un montón de sitios y tomado imágenes de mucha gente, pero apenas tenemos imágenes junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510134,
					"content": "Paimon pensó que estaría bien guardar algunos de nuestros recuerdos, por eso compró estos dos álbumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510135,
					"content": "Entonces, ¿es un regalo para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510136,
					"content": "¡Así es! Es un dos por uno. Un álbum para ti, y otro para Paimon. Paimon ya lo tenía todo pensado cuando hizo la reserva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510137,
					"content": "¡Tienes que empezar a usarlo ahora mismo! Puedes tomar imágenes de los sitios a los que fuimos para recordar nuestras aventuras pasadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510138,
					"content": "Ya sé, ¿quieres usar el Daguerrotipo de Paimon? Nunca lo has usado, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510139,
					"content": "Paimon encargó este modelo personalizado, así que sería una pena no darle un poco más de uso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510140,
					"content": "Voy a probarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "Gracias, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "Jeje, Paimon se alegra de que te guste. Es el deber de una guía considerada como Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510143,
					"content": "Vamos, Paimon te acompañará a tomar imágenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}