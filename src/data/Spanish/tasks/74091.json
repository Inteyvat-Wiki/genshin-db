			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Espero que no lo hayan capturado los Hilichurls y lo hayan usado como ingrediente para su comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "¿A quién se han comido los Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Allí, ¿ven ese campamento Hilichurl que hay sobre el agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "Parece que la montaron de la noche a la mañana. Trabajan día tras día y no descansan cuando deberían. ¡Ay! Son exactamente iguales que ese maldito mocoso de Balent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "Si tiene suerte y no está en una olla Hilichurl, probablemente esté entablando una interesante conversación con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "¿Eh? ¿Quieres decir que los Hilichurl capturaron a un conocido tuyo? ¿Y por qué no estás nada nervioso? Si es verdad lo que dices, tenemos que apresurarnos para salvarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "¿Salvar? ¿Salvar a quién? Ya le dije que no debía jugarse la vida por ese trabajo peligroso, que se esperase a reportarlo cuando Estienne nos contactara y que él buscara a alguien para solucionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "Yo enseñándole con la mejor intención del mundo para que él me acusara de no hacer bien mi trabajo y de descuidar mis obligaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Le importa un comino la experiencia y la sabiduría de las generaciones anteriores, lo único que puedo decir es que fue su decisión. Los jóvenes deben pasar por algunas dificultades. De no ser así, ¿cómo iban a madurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "Es difícil juzgar si solo se tiene una versión de los hechos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Ahora lo importante es que tenemos que salvarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "¡Es muy peligroso! ¿Qué pasa si se lastiman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#No te preocupes, ¡{NICKNAME} es muy fuerte! Quédate aquí. ¡Enseguida volvemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "Podría estar en peligro y uno no puede madurar si está muerto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "¿Qué comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "¡Eso no es lo importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
