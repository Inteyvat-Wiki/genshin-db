			"dialogs": [
				{
					"id": 740910401,
					"content": "Qué buena gente son... Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910402,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910403,
					"content": "E-estoy bien... Creo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910404,
					"content": "No lo estás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "¿P-podrían llevarme al muelle de allí? Y-yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910406,
					"content": "Guarda el aliento, ya te llevamos ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
