			"dialogs": [
				{
					"id": 740911001,
					"content": "¡Estamos de vuelta! La verdad es que había algunos problemas, pero usamos el método que nos enseñaste y ya quedó todo perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "¡Muchas gracias por su ayuda! Si no se hubieran encargado de solucionar el problema, podría haber ido a mayores y entonces habría sido demasiado tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "Aunque no estoy de acuerdo con la forma de pensar del Sr. Aigouy, sé que, a su manera, se preocupa por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Sea como sea, les agradezco que me hayan rescatado y que me hayan ayudado con el trabajo. Aquí tengo la recompensa. Por favor, acéptenla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Siento haber interrumpido su viaje. Espero que les vaya todo bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
