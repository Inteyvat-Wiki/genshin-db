			"dialogs": [
				{
					"id": 190940701,
					"content": "... Kaeya no es una persona fácil de tratar, pero la sidra gratis sabe fenomenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940702,
					"content": "Podrías haberte negado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940703
					]
				},
				{
					"id": 190940703,
					"content": "Aunque no comprendo del todo las convenciones de la Iglesia de Favonius, no creo que eso sea relevante. Siempre que alguien sienta verdadera pasión por la música, podré ayudarlo sin duda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940704,
						190940705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940704,
					"content": "Presiento que tendrán que ensayar muchas veces...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				},
				{
					"id": 190940706,
					"content": "Ay, yo estaré contento, la hermana estará contenta, y el público también lo estará... ¿No es estupendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940705,
					"content": "¿Seguro que no lo haces por el vino gratis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				}
			]
		},
