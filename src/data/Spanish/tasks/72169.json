					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "#¡Ah, viajer{F#a}{M#o}! ¿Cómo va la recolección de cangrejos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "#¡Oh! Este cangrejo se ve genial. ¡Eres asombros{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Pues bien, ya que tenemos todos los ingredientes, empecemos a cocinar cuanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "#Deja que me prepare un momento, viajer{F#a}{M#o}. Por favor, espera aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216903,
			"completionStepIds": [
