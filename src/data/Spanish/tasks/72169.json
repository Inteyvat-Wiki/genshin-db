			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "Este plato definitivamente tiene el toque de Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "De hecho, la primera vez que lo vi, pensé que debía venir de Mondstadt. Pero resulta que, en vez de eso, es una especialidad local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "¡Me imagino que es tan rico como suena, Xudong! ¡Vamos, hagamos un poco, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "Nos encontramos de nuevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "#¡Oh, eres tú, viajer{F#a}{M#o}! Jeje, ves, ¿no te dije que nos encontraríamos de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong tomó una receta nueva de la ciudad. Se llama caparazón de cangrejo con huevas. Muy buen nombre, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "Tampoco es muy difícil de hacer. Pero requiere una gran cantidad de cangrejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "Preparé algunos cangrejos normales, y ahora estoy buscando algunos... especiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "¿Cangrejos especiales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "¡Exactamente! En concreto, ¡vamos por los que habitan bajo ese Cerezo del Trueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "Se podría decir que son “cangrejos del trueno”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Bueno, solo tengo curiosidad, ¿sabes? Me pregunto qué gusto tienen los cangrejos que viven en esas circunstancias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "Sin embargo, con los rayos que rodean a ese árbol, no me atrevo a acercarme demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "Mi libro dice que, al igual que antes, basta con tocar una rama del Cerezo del Trueno para que se te adhiera un electrógrano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "Y así no te darán los rayos del Cerezo del Trueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "Pero bueno, ya viste cómo es ese árbol. No voy a arriesgarme basándome en un resumen tan aproximado de una solución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "¿No funcionaría si corriéramos lo suficientemente rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "¿Estás demente? ¡¿Crees que puedes correr más rápido que un rayo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Bueno, ¿por qué no usamos un palo para sacar esos cangrejos o algo así...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "En mi opinión, podríamos cavar una zanja cerca. Eso sacará tanto el agua como los cangrejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Jajaja. Todos tenemos muy buenas ideas. ¡Eso es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "#Si no te molesta, viajer{F#a}{M#o}, ¿podrías ayudarnos a atrapar algunos cangrejos que viven bajo ese Cerezo del Trueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "Si lo haces, te prepararé un gran festín como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "Ah, sí. Espera... Toma este cebo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "Si vas a pescar cangrejos allí, usa esto para atraerlos primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "Debería ahorrarte tiempo y esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Cangrejos que viven cerca de un Cerezo del Trueno. Me pregunto qué gusto tendrán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Oh, volvemos a hablar de comida deliciosa, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
		{
			"id": 7216902,
			"completionStepIds": [
				7216903
			],
