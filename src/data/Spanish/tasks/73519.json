			},
			"dialogs": [
				{
					"id": 735190101,
					"content": "No lo entiendo... Si fue ella quien dijo de venir al café a escribir el informe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "¿Qué haces aquí solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "*Suspira*, no quiero hablar de ello. Está escribiendo el informe por su cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "Ayer, quedamos los dos en vernos en el café, pero tardó muchísimo en aparecer. ¡Y cuando llegó, ni siquiera trajo papel ni nada para escribir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "Le reproché que no debía malgastar el tiempo que tenemos para escribir el informe, ¡y va y entra en cólera! Luego dijo que lo escribiría ella misma, ¡y me dejó totalmente de lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "¡Es ridículo! ¿No crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Pero bueno, ya estoy acostumbrado a su temperamento impetuoso. En unos días se le habrá pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "Ojalá su estado de ánimo fuera tan fácil de controlar como un mecanismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "Te deseo suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "¿Eh? Hasta tú dices cosas raras... En fin, no importa. Volviendo al tema, todavía quedan algunos gusanos de arena afectados por la zona, aunque la situación se irá calmando por sí sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Aunque, si tienes tiempo y me puedes echar una mano, podemos evitar que sean una amenaza para los transeúntes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "Por cierto, el entorno elemental y los dispositivos de recarga han vuelto a la normalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "¡Esta es la mejor oportunidad para probar el cañón gusicida a máxima potencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Espero que te vaya bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "¿Dónde está Shriya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
}