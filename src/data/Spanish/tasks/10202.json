			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Celda"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020401,
					"content": "¿Adivina quién?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "¡Esa es la voz de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Celda"
				},
				{
					"id": 102020403,
					"content": "¿Necesitas ayuda para salir de esta celda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "¡Sí, por favor! Esperen, no, no puedo. Klee será una buena niña y reflexionará sobre lo que hizo... ¡No me tienten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Celda"
				},
				{
					"id": 102020406,
					"content": "En fin, mientras estoy castigada, haré un tesoro especial... ¡Una versión nueva para el Ludi Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Celda"
				},
				{
					"id": 102020407,
					"content": "¿Cuando dices “tesoro”...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "Jeje... ¡Lo hice en forma de Harpastum! Se ve tan lindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Celda"
				},
				{
					"id": 102020409,
					"content": "¿Disfrazaste una bomba como un Harpastum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Solo esperen al Ludi Harpastum... ¡Les va a encantar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Celda"
				},
				{
					"id": 102020412,
					"content": "Si la Maestra Jean te escuchara en estos momentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Podrían ponerte una sentencia mucho más larga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "... En realidad sigue siendo una bomba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "¿Quieres un bocado o algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}