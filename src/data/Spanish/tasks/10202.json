			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020101,
					"content": "¿Klee? ¿Tú también estás aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020102,
					"content": "Yo... *solloza*, me entregué a las autoridades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020103,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020104,
					"content": "M-mi bomba... Lastimé a alguien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020105,
					"content": "Rompí las reglas. No volveré a ver la luz del día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020107,
					"content": "¡Espera! Hubo un malentendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "Klee, necesito que me respondas a algo. Dijiste que hubo heridos. ¿Dónde están?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020109,
					"content": "Lo que Klee explotó era un Mago del Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "¿Por qué lo dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020110,
					"content": "Pero el Sr. Bola de Estambre era solo un ladrón... No merecía explotar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020111,
					"content": "*Suspira*, cuando Paimon dijo que los Magos del Abismo eran “malas personas”, no lo decía en sentido figurado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020112,
					"content": "De hecho, son el peor tipo de personas que te puedes imaginar. No solo odian a la gente buena, odian a todo el mundo. Su enemigo es... la humanidad en sí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020113,
					"content": "¿Esa bola de estambre... es mala a propósito? ¿Es enemigo de la humanidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020114,
					"content": "¡¿Qué?! No lo entiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020115,
					"content": "Sí. Fue un descuido de mi parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020116,
					"content": "No te dije estas cosas antes porque eras muy pequeña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020118,
					"content": "¿Será por el tesoro más poderoso de toda Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "La Orden del Abismo es una fuerza hostil en Mondstadt que ha estado inusualmente activa últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020119,
					"content": "¡Ajá! ¡Paimon lo entiende todo ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020120,
					"content": "¡Estaban rastreando a la pobre Klee porque escucharon rumores sobre su tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020121,
					"content": "Al igual que la primera reacción de Paimon fue tratar de obtener el... quiero decir, tratar de saber cuál era el tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020122,
					"content": "¿Eso quiere decir que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020123,
					"content": "De acuerdo. En vista de tu ayuda en este asunto, te permitiré participar en el próximo Ludi Harpastum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020125,
					"content": "¡Tienes mucha suerte!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "¡Estoy tan feliz por ti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "¡Ludi Harpastum! ¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020127,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, ¡tú también tienes que venir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020128,
					"content": "¡Guau! ¡Es un final feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020129,
					"content": "Excepto por...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020130,
					"content": "... ¿Excepto por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020131,
					"content": "Klee, ¿dónde escondiste el tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020132,
					"content": "Yo... eh... pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020133,
					"content": "¿Estabas tratando de volar los peces del Lago Estelar otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020134,
					"content": "¡Por supuesto que no! ¡Lo juro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020136,
					"content": "(¡Jean también lo notó!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "(Klee nos está guiñando...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020137,
					"content": "Em... ¿Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020138,
					"content": "No hace falta que escolten a Klee a su <color=#00E1FFFF>celda</color>... *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020139,
					"content": "Paimon cree que Klee se sentirá aburrida y sola en su celda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1020204,
