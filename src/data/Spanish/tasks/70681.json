					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "¡Espero que logres tus objetivos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "¡Sí! ¡Espero que a ustedes también les vaya bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811217,
					"content": "Gesine agita el brazo para despedirse.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "Ya que estamos aquí, podemos aprovechar para dar una vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811219,
					"content": "¡Quizás nos encontremos algo interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
