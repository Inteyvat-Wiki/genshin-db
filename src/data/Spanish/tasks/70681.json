					}
				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "Lo que hay delante es el <color=#00E1FFFF>Pantano Dihua</color>, ¿no? ¡Es precioso! En Mondstadt no hay paisajes así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810502,
					"content": "¡Sabía que salir de viaje era la decisión correcta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810503,
					"content": "Por cierto, ya que estamos aquí, ¡tomemos una imagen de recuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				}
			]
		},
		{
			"id": 7068106,
