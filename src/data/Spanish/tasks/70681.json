					}
				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "Lo siento mucho, ¿pueden esperarme aquí un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "¿Se te olvidó algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "No es eso. Acabo de mirar el mapa, y estamos a punto de salir de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "No sé cuándo voy a poder volver... Puede que mi profesor se enfurezca al leer mi carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "Antes habías mencionado a tu profesor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Sí... Justo después de convertirse en aventurero se topó con un Mitachurl. Mientras estaba girando, se descuidó y perdió el conocimiento por culpa de un hachazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "Menos mal que un caballero pasó por ahí y lo rescató.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "Se sintió tan avergonzado que prometió no salir de aventuras hasta perfeccionar sus habilidades. Y así lleva diez años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "El profesor siempre dice que la base es lo más importante, ¡pero no soporto pasarme los días cortando maniquíes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "Así que decidí irme yo sola sin decirle nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Puedes volver cuando te hagas más fuerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "¡Sí, eso mismo pienso yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "Ah, ya lo tengo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine saca unas semillas de diente de león, las pone en la palma de la mano y les susurra algo. Después, deja que el viento se las lleve volando...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "Según nuestra tradición, los dientes de león pueden portar nuestros deseos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "Acabo de pedirles que me ayuden a completar mi objetivo y que el profesor me comprenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
					"content": "Seguro que el Arconte Anemo ha escuchado tus deseos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "¡Sí! ¡Bueno, sigamos adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Haz algo que lo haga sentirse orgulloso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "¿También es un aventurero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
		{
			"id": 7068105,
