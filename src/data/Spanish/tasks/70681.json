			"dialogs": [
				{
					"id": 706810301,
					"content": "Uff... Por fin a salvo. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810302,
					"content": "Me llamo Gesine. Como pueden ver, soy una aventurera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810303,
					"content": "#A juzgar por su habilidad, seguro que no son gente normal. ¿Acaso son un{F#as}{M#os} caballer{F#as}{M#os} de buen corazón? ¿O un{F#as}{M#os} guerrer{F#as}{M#os} errantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810304,
					"content": "#Tan solo soy {F#una}{M#un} viajer{F#a}{M#o} que pasaba por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#Paimon es Paimon, y {F#ella}{M#él} es {NICKNAME}. En realidad, {F#ella}{M#él} también es miembro del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810310,
					"content": "#¡Así que eres {F#una}{M#un} aventurer{F#a}{M#o}! Con razón acabaron tan rápido con esos monstruos tan feroces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810311,
					"content": "No como yo, que a pesar de haber memorizado los movimientos durante el entrenamiento, me tiemblan las piernas en cuanto llega la hora de luchar de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810312,
					"content": "¿Acaso es verdad lo que me ha dicho mi profesor y aún tengo que entrenar tres o cinco años más? Pero volver con las manos vacías me da mucha vergüenza... *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810313,
					"content": "#Paimon cree que solo se trata de experiencia. ¡Nosotr{F#as}{M#os} tuvimos que pasar por muchos combates para llegar a ser así de fuertes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810314,
					"content": "Lo primero es mantener la calma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "Así es. Los principiantes suelen ponerse nerviosos en un combate real y no logran usar su verdadera fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810316,
					"content": "Por muy fuerte que parezca un enemigo, hay que observarlo con calma y encontrar sus puntos débiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810317,
					"content": "¡Así podrás hacer bam, bam, bum y acabar con él en un abrir y cerrar de ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810320,
					"content": "Ya veo... ¡Se nota que tienen mucha experiencia! Parece que tendré que seguir entrenando mis habilidades mientras viajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810321,
					"content": "¿Tú también estás viajando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "Sí... Me dirijo a <color=#00E1FFFF>Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810323,
					"content": "¿Han oído hablar de las artes marciales de Liyue? ¡Dicen que si las aprendes, podrás caminar por las paredes, volverte inmune a las armas y cortar el acero como si fuera barro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810324,
					"content": "Si hubiera alguien que pudiera ser mi maestro, me sentiría mucho más tranquila al ir de aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810325,
					"content": "A pesar de que llevo un tiempo en el Gremio de Aventureros, es la primera vez que voy a un sitio tan lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810326,
					"content": "Ay... Nada más salir me topé con monstruos. ¿De verdad voy a ser capaz de llegar a salvo a Liyue?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810327,
					"content": "#Nosotr{F#as}{M#os} también nos dirigimos a Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "¿De verdad? ¿También van en busca de algún maestro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810330,
					"content": "No se trata de eso. Estamos viajando por varias naciones debido a ciertos motivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810331,
					"content": "No sabemos mucho sobre Liyue, pero de todas formas, tarde o temprano tendremos que ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810332,
					"content": "#Ya que tenemos el mismo destino, ¡podemos ir junt{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810333,
					"content": "#¡Guau! Voy a tener la oportunidad de viajar con un{F#as}{M#os} aventurer{F#as}{M#os} tan increíbles... ¡Por fin veo un rayo de esperanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810334,
					"content": "Déjenme que les indique el camino. ¡Revisé muy bien el mapa antes de salir, así que seguro que no nos vamos a perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810328,
					"content": "#¿Quieres ir con nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "Saber evaluar la situación también es muy importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "Exacto. Si un enemigo es más fuerte que tú, lo mejor es retirarse a tiempo. ¡Una pelea imposible es muy peligrosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810305,
					"content": "Prefiero no revelar mi identidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "¡Entiendo! Seguro que tienes una misión secreta y debes actuar con cautela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810307,
					"content": "Más o menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "#¡Ey, no te hagas {F#la}{M#el} interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
