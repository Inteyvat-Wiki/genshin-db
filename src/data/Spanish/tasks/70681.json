				]
			},
			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine pregunta por el menú al gerente y pide varios platos típicos de alto valor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "He oído que la cocina Liyue se centra tanto en la apariencia como en el aroma, e incluso en el sabor. Realmente es muy distinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "¡A Paimon se le hace agua la boca con solo mirarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "#Degustan junt{F#as}{M#os} la comida de la Posada Wangshu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Guauuu, ¡qué rico! Esto está muy delicioso, y esto también. Uff, ¡a Paimon ya no le cabe nada más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "¡Estuvo delicioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "¡Se me ha quitado totalmente el cansancio del viaje!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Muchas gracias por todo. Si no fuera por ustedes, seguro que no habría podido llegar hasta aquí tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "Acabo de escuchar a la gente de la posada decir que el <color=#00E1FFFF>Puerto de Liyue</color> está un poco más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "Creo que voy a descansar aquí unos días para preguntarle a los viajeros dónde podría encontrar a un maestro, y ya luego decidiré mi próximo destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "Disfruté muchísimo de su compañía, pero no puedo hacerles perder más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "¡Voy a seguir esforzándome para hacerme más fuerte y convertirme en una aventurera digna de confianza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "#¡Jeje, aunque nos conocimos hace muy poco, para nosotr{F#as}{M#os} también fue un placer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "¡Paimon espera que nuestros caminos se vuelvan a cruzar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "Nos veremos si así lo quiere el destino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "¡Espero que logres tus objetivos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "¡Sí! ¡Espero que a ustedes también les vaya bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine agita el brazo para despedirse.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Ya que estamos aquí, podemos aprovechar para dar una vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "¡Quizás nos encontremos algo interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine decía que el <color=#00E1FFFF>Puerto de Liyue</color> está justo delante. ¡Podemos ir a echar un vistazo cuando tengamos tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
