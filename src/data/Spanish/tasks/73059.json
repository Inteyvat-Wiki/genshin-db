			"trigger": {
				"objectNames": [
					"Aranakin",
					"Aragaru",
					"Aranaga",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "¡Aranaga! ¡Está aquí! ¡Están aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590202,
					"content": "¡Sí, sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590203,
					"content": "#Nara {NICKNAME}, cosa blanca voladora, hola. Nosotros tres dar bienvenida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590204,
					"content": "#Luna ya llegar. Ahora plantar flores. ¿Ustedes list{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590205,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "¡Sí! ¡Paimon también está lista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590207,
					"content": "Entonces... Aranakin, Aragaru, nosotros comenzar ceremonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590208,
					"content": "Volver, volver, sueños de jardín, recuerdos de bosque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590209,
					"content": "Sean todos bienvenidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590210,
					"content": "Sueños profundos, alegría permanente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590211,
					"content": "Celebremos esta ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590212,
					"content": "¡Para que granadas canten, para que manzanas aclamen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590213,
					"content": "Los aranara plantan las flores secas mientras suena el eco de una balada en el aire. Milagrosamente, las flores vuelven a la vida...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "¡Guau! ¡Las tres flores están vivas otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590215,
					"content": "Sí, porque Moutiyima buena. Moutiyima da oportunidad a recuerdos para revivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590216,
					"content": "¡Sí! Incluso si nosotros olvidar, recuerdos... humm, unirse a ramas y a raíces, convertirse en hojas nuevas. ¡Nueva vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590217,
					"content": "O se convierten en insectos que comen insectos. Son alimento de plantas. ¡Y nosotros también crecemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590218,
					"content": "#Pero... ustedes todavía no se acuerdan de nosotr{F#as}{M#os}, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590219,
					"content": "Sí... porque recuerdos no ser tuyos, tampoco ser de Aranaga. Lo que nosotros vivir dar a plantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590220,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "Pero no pasa nada, porque ya somos amigos otra vez, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590222,
					"content": "¡Sí! ¡Otra vez somos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
