				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "Para que las granadas canten, para que las manzanas aclamen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590102,
					"content": "¡Hola, Sr. Jayam! ¿Qué hace por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590103,
					"content": "#¡Oh! Hola, amiguita blanca y... Humm... Disculpa, niñ{F#a}{M#o}, mi memoria no es tan buena como antes, se me olvidan los nombres con frecuencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590104,
					"content": "#Puede llamarme {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "#Jaja, muy bien. Ustedes son {F#las}{M#los} de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590106,
					"content": "#¡Sí! ¡Somos {F#las}{M#los} yuvan de la última vez! ¡{F#Las}{M#Los} jóvenes valientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590107,
					"content": "Humm, entonces, díganme, ¿los aranara me recuerdan? ¿Nos recuerdan a todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590108,
					"content": "Humm... Bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590109,
					"content": "Sí, se acuerdan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590111,
					"content": "¿Ah, sí? Pero yo no puedo verlos ni escuchar cuánto me han extrañado... Es una pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590114,
					"content": "Jeje, pero yo no puedo verlos. Soy demasiado viejo, no puedo ver sus rostros, ni escuchar sus voces... Se ha ido todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590115,
					"content": "*Ejem*, lo lamento, debo irme. Tal vez no quede más que esperar un milagro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590116,
					"content": "Los milagros no se pueden entender y tampoco se pueden perseguir, solamente se puede esperar a que ocurran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730590117,
					"content": "Jayam se aleja tambaleándose...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "No, se olvidaron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "#¡Pero podemos ser sus amig{F#as}{M#os} otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
