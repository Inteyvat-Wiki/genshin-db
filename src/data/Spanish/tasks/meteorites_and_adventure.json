			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "*Suspira*, si tan solo pudiera ir a mirar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Ah, eres tú. No me pasa nada en especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "Bueno, tal vez sí sea especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "¿Los meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "¡Sí! Tú también los viste, ¿cierto? No paran de caer del cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Pero, gracias a la protección del Arconte Anemo, o simplemente por pura suerte, ninguno ha caído dentro de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Algunos cayeron fuera, en el campo, y dicen que quien los toca cae en un profundo sueño del que es imposible despertar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "Cyrus ya publicó el encargo y reunió a unos cuantos aventureros. Algunos fueron a informar a las personas que todavía estaban en el campo para que se refugiaran en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "Y otros fueron a ayudar a los Caballeros de Favonius a localizar la ubicación de los meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "Después, llevaron a cabo operaciones de búsqueda y rescate en los alrededores de esos meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "En cuanto a mí... Cyrus dijo que mejor me quedase en la ciudad para ayudar a las personas que se habían quedado inconscientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Tal vez sea porque mis habilidades aún no están a la altura, pero siempre soy yo el que se encarga de estas trivialidades. Así es imposible que me vuelva más fuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "#*Suspira*, en fin, primero tengo que cumplir con mi deber y, además, hacerlo bien... Aun así, ¿puedo pedirte un favor, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "¿Podrías ir al campo y recopilar información sobre los meteoritos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "¿Para qué necesitas la información?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Cyrus siempre dice que, antes de empezar una aventura, hay que estar totalmente preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Si pudiera convencer a Cyrus de que entiendo perfectamente la situación y que estoy completamente preparado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Quizás me dejaría ir al campo a investigar con los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Pero ahora estoy ocupado cuidando a la gente. No puedo ir a recopilar información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "#Así que, por favor, viajer{F#a}{M#o}, ayúdame a investigar por el campo. Puedes ir al Bosque Susurrante para empezar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Si averiguas algo, vuelve y cuéntamelo. De ti depende que pueda ir a investigar por mí mismo o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Entonces, quieres escaparte y...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "¿Eh? Escaparme y... ¡No! ¡En absoluto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Aunque me encantaría ir a investigar, en la ciudad me necesitan, ¡es muy importante! No puedo dejar el trabajo así como así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "Es solo que... Cyrus siempre dice que, antes de empezar una aventura, hay que estar totalmente preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Si pudiera convencer a Cyrus de que entiendo perfectamente la situación y que estoy completamente preparado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Quizás me dejaría ir al campo a investigar con los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Pero ahora estoy ocupado cuidando a la gente. No puedo ir a recopilar información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "¿Te refieres a los descuentos del 50% por el aniversario de El Buen Cazador?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "¡¿Qué?! ¿Hay descuentos en El Buen Cazador? ¡No lo sabía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Espera, ¡no! No era eso. Lo que decía es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "Tú también has visto los meteoritos que no paran de caer del cielo, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250112,
					"content": "Pero, gracias a la protección del Arconte Anemo, o simplemente por pura suerte, ninguno ha caído dentro de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				}
			]
		},
