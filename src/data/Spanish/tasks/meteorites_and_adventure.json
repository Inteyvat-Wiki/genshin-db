				"objectNames": [
					"El Temerario Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250201,
					"content": "Creo que ya están todos, pero... ¿Qué es lo que está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250202,
					"content": "¿Viniste a investigar los meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Sí, acepté un encargo del Gremio para venir a investigarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250204,
					"content": "Pero, no sé por qué, los monstruos que había cerca de donde cayeron los meteoritos empezaron a actuar de manera extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250205,
					"content": "Su fuerza, sus movimientos y todo en general no es nada normal. Además, hay más monstruos que nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250206,
					"content": "Me descubrieron y no me atreví a quedarme en la zona, por lo que tomé otro camino para evadirlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250207,
					"content": "Tengo que informar de esta situación a Cyrus lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250208,
					"content": "¿Algo más que deba tener en cuenta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Humm... Bueno, si insistes... Algunos eruditos se niegan a buscar refugio en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250210,
					"content": "He intentado convencerlos, pero insistían en quedarse en el campo investigando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250211,
					"content": "Tampoco hay suficientes aventureros que puedan venir hasta aquí, y no podemos estar recordándoselo cada pocos días...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250212,
					"content": "Todo esto es un dolor de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 411250213,
					"content": "#Bueno, viajer{F#a}{M#o}, si no necesitas nada más, vuelve tú también a la ciudad para resguardarte. Ahora no es buen momento para estar por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Temerario Pallad"
				}
			]
