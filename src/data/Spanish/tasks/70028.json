				"points": []
			},
			"dialogs": [
				{
					"id": 700280301,
					"content": "¿Cómo te fue? ¿Los Clavos funcionaron como esperábamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280302,
					"content": "Todo fue de acuerdo al plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "Bien, bien. Espero que no se arruinen más tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280304,
					"content": "Solo necesitamos que el Demoledor de las Ruinas anómalo esté dentro del radio de efecto de los Clavos para que se quede sin suministro de energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280305,
					"content": "Esta vez, deberías poder derrotarlo de una vez por todas. ¡Adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280306,
					"content": "Confío en tus habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
