			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "Gracias a los datos de prueba que recopilaste, hemos acabado los ajustes finales de los Clavos de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280102,
					"content": "Estoy seguro de que funcionarán como espero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280103,
					"content": "Conque coloquemos los Clavos en un lugar en el que el Demoledor anómalo suela aparecer, deberíamos poder controlar su suministro de energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280104,
					"content": "Siempre y cuando activemos los Clavos con todo su poder, la máquina no podrá iniciar sus protocolos de autorreparación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280105,
					"content": "Gracias por tu ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "Oh, no me lo agradezcas a mí, agradéceselo a aquellos que vivieron antes que nosotros y que nos dejaron su sabiduría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280109,
					"content": "Si no tuviéramos ese conocimiento como referencia, no hubiéramos podido idear una forma de derribar al Demoledor de las Ruinas anómalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280110,
					"content": "Todo lo que hemos hecho hasta ahora se basa en ese conocimiento, y es que el conocimiento es el recurso más valioso del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280111,
					"content": "Suena un poco complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "Es normal que no lo comprendas. Después de todo, aún no te ha instruido la sabiduría más suprema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280113,
					"content": "Jajaja, estoy desvariando. Me dejé llevar al reparar los Clavos de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280114,
					"content": "Bueno, ahora viene la última fase de los preparativos. Esto quiere decir que tenemos que colocar los Clavos en la Isla Tsurumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280115,
					"content": "Me temo que no podré ayudarte con eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280116,
					"content": "#Según las leyes de Inazuma, las personas que no tenemos un permiso de residencia no podemos movernos con libertad. Así que esta tarea depende de ti, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280117,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "Gracias. Te sugiero no precipitarte después de colocar los Clavos. Asegúrate primero de que todo funciona bien y vuelve conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280119,
					"content": "Creo que, por tu seguridad, deberíamos ser un poco más cuidadosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280107,
					"content": "¡Viva la ciencia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "En realidad, deberías agradecérselo a la sabiduría que nos dejaron nuestros ancestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
		{
			"id": 7002803,
			"completionStepIds": [
				7002803
			],
