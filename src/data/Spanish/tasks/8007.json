			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070901,
					"content": "Eso fue todo, ¿cierto? ¿El dispositivo quedó desactivado por completo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070902,
					"content": "La sensación de ardor se ha ido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070903
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070903,
					"content": "Entonces, ¿conseguimos frenar los planes del Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070904,
						80070905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070904,
					"content": "Pero Halfdan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				},
				{
					"id": 80070906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070907
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070907,
					"content": "Me aseguraré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070908,
					"content": "Dain debe estar triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070909,
					"content": "Encontrarse con tus compañeros de armas después de tanto tiempo y de esta forma... Debe ser duro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070911
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070911,
					"content": "... Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070905,
					"content": "Parece que fue su último aliento de vida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				}
			]
		},
		{
			"id": 800710,
			"completionStepIds": [
				800710
