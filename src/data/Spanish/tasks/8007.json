			"trigger": {
				"objectNames": [
					"Sacerdote del Abismo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Pensé que se convertiría en cenizas en un instante... Parece que el espíritu de Halfdan es realmente tenaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "¡Tontos entrometidos! ¡A un lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Sacerdote del Abismo"
				},
				{
					"id": 80070103,
					"content": "¿No tienes algo más importante de lo que preocuparte? Vamos, esta es tu oportunidad de acabar conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "... ¡Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Sacerdote del Abismo"
				},
				{
					"id": 80070105,
					"content": "¡Desháganse de él y desactiven el dispositivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
				800703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800703",
							"2"
						],
						"stepId": 800703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "¿Qué hacemos? Ya nos encargamos del Sacerdote del Abismo, pero el dispositivo sigue funcionando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "Y Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Yo ocuparé su lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "¡No! Siempre que el dispositivo esté funcionando, aquellos que sufrimos de la maldición somos incapaces de usar todo nuestro poder. Solo tú puedes hacer frente al Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "Si de verdad valoras su sacrificio, no pierdas más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "¿Ves todos esos rayos de luz y portales? Seguramente han instalado otros dispositivos de energía en varias ubicaciones. ¡Encuéntralos, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "¿Entonces tenemos que pasar a través de esos portales del Abismo? ¡Oye, espera a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "La purificación de la maldición no tiene efecto en mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
			"completionStepIds": [
				800709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
