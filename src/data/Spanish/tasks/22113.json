			"dialogs": [
				{
					"id": 221130301,
					"content": "¿Trajo las tablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130302,
					"content": "Sí, las traje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Genial, estos monstruos son realmente molestos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130304,
					"content": "Es suficiente. Muchas gracias. Comenzaré a trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
