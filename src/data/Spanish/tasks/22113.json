			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "En serio, las cosas malas solo se acumulan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130102,
					"content": "¿Sigues trabajando en las escaleras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "Llega justo a tiempo. Gracias por lo de la vez anterior. Pero tengo que volver a molestarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130104,
					"content": "Compré otro lote, porque la grieta era un poco grande, y las tablas de madera no eran suficientes. Se supone que el portero de la posada la recibiría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130105,
					"content": "Pero en el camino fue atacado inesperadamente por un grupo de monstruos, y huyó en pánico, dejando las tablas en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130106,
					"content": "Sea lo que sea que lo haya asustado, el portero sabe el lugar exacto donde se cayeron, pero se rehúsa a volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130107,
					"content": "Quisiera ir, pero tengo que volver a molestarle y pedirle que vaya a recogerlas. ¿Podría hacer eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130108,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Perdón por importunarle, le espero aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130110,
					"content": "Esta grieta es tan grande...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "No me mire así, esta ocasión no fue un monstruo lo que la destruyó. Harían falta muchos grandullones para hacer una grieta así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130112,
					"content": "Esto fue lo que ocurrió: en la posada había dos huéspedes que estaban en riña. Uno perseguía al otro, y el otro se escondía, y nunca llegaban a encontrarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130113,
					"content": "Eventualmente, ambos vinieron a hospedarse en la posada, y al subir por las escaleras se encontraron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130114,
					"content": "Entonces armaron una trifulca sobre las escaleras, y terminaron por destrozarlas. Pasé el día entero intentando separar a esos dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130115,
					"content": "Estaba furioso... En ese mismo instante les cobré a cada uno tres días más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130116,
					"content": "Bueno, basta de cotilleo. ¿Puede ir por las tablas? Quisiera arreglarlo lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130117,
					"content": "Si algo así vuelve a ocurrir, no me molestaré en pedirles que paguen los daños... Pero definitivamente haré que lo reparen ellos mismos en el acto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
