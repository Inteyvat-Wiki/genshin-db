			"dialogs": [
				{
					"id": 221130201,
					"content": "¿Trajo las tablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130202,
					"content": "No las he encontrado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "Por favor, apresúrese en recuperarlas para comenzar de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
