			},
			"dialogs": [
				{
					"id": 221130501,
					"content": "Ya terminé de repararla, ¿qué le parece? ¿Nada mal, cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130502,
					"content": "Con esto, los huéspedes tendrán una estancia más cómoda. ¡Jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130503,
					"content": "Por cierto, toma esto como agradecimiento. Buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130504,
					"content": "No dude en venir de vez en cuando a tomar una taza de té y comer aperitivos. Las habilidades culinarias de nuestro chef son de lo mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
