				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "Guau, me dan muchas ganas de meter los pies en el agua. ¡O de tirarme directamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "Seguro que nos regañarían si lo hacemos. Es mejor que nos limitemos a mirar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050203,
					"content": "¿Eh? ¿Y para qué sirven unas fuentes tan grandes si no son para jugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Por muy bonitas que sean, si solo están ahí para mirarlas, no dejan de ser un estanque de lo más normal. No tiene sentido ninguno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Esta no es una fuente como cualquier otra. Mi padre dijo que las fuentes normales... Espera, ¿cómo era lo que dijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "“El propósito principal del proyecto de renovación estilística de la ciudad impulsado por la Corte de Fontaine es resolver el problema de los impuestos de manera flexible”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050207,
					"content": "El Sr. Delereu me lo ha explicado a mí también hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050208,
					"content": "Jaja, por un momento he pensado que eras mi padre de verdad. Con razón le gustas tanto, Aurèle. Siempre lleva unos libros en la mano cuando va a hablar contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Pues yo no me he enterado de nada de lo que ha dicho, pero, siendo mi hermano, seguro que era algo malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Lovi, vayamos a jugar a otro sitio. Por fin hoy no tienes que estudiar, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Está bien, vayamos a ver otros sitios. Deja que piense... ¡Ah, ya sé! El periódico debería seguir abierto, vayamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
