			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Así que este es «El Pájaro de Vapor». Pues no parece que tenga nada de especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050302,
					"content": "Un lugar de los más normalito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "¡Guau! ¡De verdad que tienen un pájaro mecánico! ¡Qué pasada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "¿A que sí? Mi padre me trae mucho aquí a comprar el periódico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Le encanta «El Pájaro de Vapor». Creo que incluso sería capaz de pasarse el día entero leyéndolo. A veces hasta hace recortes y los guarda en sus libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Él los llama “reseñas”. A veces incluso nos los lee a mi madre y a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "A nosotras no es que nos interese mucho, así que normalmente solo respondemos con algún “Oh, vaya”, “¿De verdad?” o “Ya veo”, pero a él no parece importarle. Le encanta leerlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "¿Qué es una “reseña”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Una reseña es cuando das tu opinión sobre algún asunto partiendo de tu forma de ver las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050311,
					"content": "El padre de Lovi, el Sr. Delereu, es un investigador del Instituto de Ciencias de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050320,
					"content": "Además, trabaja también como crítico para «El Pájaro de Vapor».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050312,
					"content": "Así es, y le encanta escribir esas enormes reseñas suyas sobre cualquier cosa que se le ocurra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "A veces, cuando habla, se le ocurre alguna cosa y sale corriendo a su estudio para escribirlo. Y nunca come mientras escribe, solo bebe té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "¿Eh? ¿Te pagan por dar tu opinión sobre cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "Hace falta más que eso para ser un verdadero crítico. Tienes que seguir unas directrices si quieres conseguir que otros se identifiquen con tu crítica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050316,
					"content": "#Humm... Oye, Verut, {NICKNAME}, ¿no tienen hambre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "El Sr. Louis me dijo que estos días está vendiendo papas fritas a la burburanja. ¿Les apetece probarlas? ¡Yo invito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "¡Sí, sí! ¡Vamos, hermanito, deja de hablar tanto y vamos a comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050303,
					"content": "No tiene nada de especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
