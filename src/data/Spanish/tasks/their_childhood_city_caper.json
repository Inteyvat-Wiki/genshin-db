			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle",
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Vamos, hermanito. ¡Por aquí! Todavía no hemos visto esa casa enorme de ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "No corras tanto, Verut, no vayas a caerte. Lo mismo te digo, Lovi. Tu padre dice que no te encuentras muy bien, a ver si vas a resfriarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050103,
					"content": "Aaaah, tu hermano es un auténtico pesado. Me recuerda a mi madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Qué me vas a contar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Oigan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050106,
					"content": "¡Nos vemos de nuevo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "¡Hola de nuevo! Como verás, esta vez no estamos jugando al escondite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "Bueno, más bien ya hemos terminado de jugar... La Srta. Nour nos ha echado una buena bronca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050110,
					"content": "Siempre está muy seria mientras trabaja y no deja de regañar a la gente. ¡No debí regalarle aquellas galletas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Bueno, da igual. El caso es que estamos cansados de tanto jugar, así que pensé en llevar a Verut y Aurèle a comer algo rico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "¿Te gustaría unirte a nuestra...? ¿Cómo se llamaría esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "¿Paseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050114,
					"content": "¡Sí, eso! ¡Ven con nosotros a dar un paseo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Vayamos a la plaza, ¡quiero ver la fuente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Muy bien, tú eres la guía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Bien, pues vayamos a aquella plaza. Las fuentes de allí son preciosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Muy bien, les sigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "¿Qué están haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
