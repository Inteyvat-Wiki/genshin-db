			},
			"dialogs": [
				{
					"id": 240050401,
					"content": "¡Sr. Louis! Deme... cinco raciones de papas fritas a la burburanja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050402,
					"content": "Ah, Lovi, si eres tú. Lo siento mucho, pequeña, pero hoy hay muchísima gente por el puerto. Ya he vendido todas las raciones que había preparado para hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "P-pero si le había avisado hace ya tiempo... Incluso he traído a mis amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "*Suspira*, lo siento, de verdad. Había tantos clientes que se me pasó por completo. Aunque sí me quedan papas de las normales. Llévenselas, invito yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "Bueno, está bien. Gracias, Sr. Louis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Bueno, solo le falta la burburanja, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Bueno, si tienes algunas, podría prepararles la salsa ahora mismo. Sí que me han sobrado algunos condimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "#¡Genial! ¡Eres la bomba, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "Lo siento. Al final siempre acabamos pidiéndote ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050412,
					"content": "No hace falta ser tan cortés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Está bien... Debería aprender de ti. El Sr. Delerue dice que soy demasiado impasible. No me será fácil convertirme en un crítico como él si sigo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050415,
					"content": "*Ejem*, no importa. Yo me quedo con ellos. Dejo lo de las burburanjas en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050413,
					"content": "Bueno, arriba el ánimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Puedo buscarte algunas burburanjas para acompañar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
