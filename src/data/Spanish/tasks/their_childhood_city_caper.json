					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240051101,
					"content": "¿Por qué tu hermano siempre es tan estirado? No le he visto sonreír ni una vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051102
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051102,
					"content": "Antes no era así, pero desde que conoció a tu padre y comenzó a leer esos libros, ha cambiado mucho. Se pasa el día con el ceño fruncido. No sé en qué estará pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051103
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051103,
					"content": "Uff, sí que suena a algo que haría mi padre. Mi madre dice que siempre tiene la sensación de que mi padre está batallando con algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051104,
					"content": "¿Con qué? ¿Es que se ha peleado con tu madre o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051105,
					"content": "¡Claro que no! Ellos nunca se pelean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051106
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051106,
					"content": "Los adultos son todos unos raritos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
