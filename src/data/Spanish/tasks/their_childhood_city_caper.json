			"dialogs": [
				{
					"id": 240050601,
					"content": "Con estas bastará. Esperen un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis empieza a preparar la salsa de burburanja...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "¡Listo! Unas papas fritas a la burburanja recién hechas. No les voy a cobrar esta vez, así que aprovechen, pero ¡cuidado que queman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "¡Yuju! Vamos, pruébenlas. ¡Están buenísimas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Ah, y Aurèle, no se lo digas a mi padre o me volverá a regañar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Jaja, no te preocupes, no creo que el Sr. Delerue esté interesado en las papas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050607,
					"content": "¿Y yo qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "¡Tú también come! Pueden repartirse mi ración, también. A mí no me gustan mucho estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050609,
					"content": "#Jejeje, ¡pues a comer se ha dicho! Pruébalo tú también, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Ah, por cierto, tengo que comprarle algo de café al Sr. Delerue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050611,
					"content": "¿Qué? No, ¡no puedes! Mamá le prohibió hace mucho beber café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Siempre que bebe café, se pasa el día tosiendo a destajo en su estudio. A veces incluso se queda afónico unos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Papá siempre dice que es por trabajo, ¿pero qué clase de trabajo te hace pasarlo tan mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "... ¿Ese es el precio que ha de pagar el Sr. Deleure para ser un crítico excelente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050615,
					"content": "Ser crítico no parece un trabajo sencillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400511,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
