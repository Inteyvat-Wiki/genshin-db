				"objectNames": [
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240051201,
					"content": "Siento mucho haber tenido que molestarte otra vez. Yo me encargo de ellos, así alguien se asegurará de que no salen corriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051202
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051202,
					"content": "Si logro convertirme en crítico y trabajar para «El Pájaro de Vapor», podría darme un sueldo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051203,
					"content": "Pero el Sr. Delereu dice que si quiero ser crítico, no puedo darle demasiada importancia al Mora. Si no, empezaré con mal pie con algunas personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051204
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051204,
					"content": "Pero es que a mí me urge ganar Moras. No sé qué hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		}
	]
