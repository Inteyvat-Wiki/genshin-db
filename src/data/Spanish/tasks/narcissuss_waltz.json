			"dialogs": [
				{
					"id": 742540501,
					"content": "¡Seymour! ¡Cuánto tiempo sin verte! ¡Y Maime también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 742540502,
					"content": "Jaja, Seymour no paraba de decirme lo mucho que las echaba de menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540503,
					"content": "Así es. Nunca dejé de pensar en usted, Srta. Marianne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "Gracias, Sandrone, por organizar esta hora del té. Es muy agradable reunirnos y charlar sobre nuestros viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Marianne"
				},
				{
					"id": 742540505,
					"content": "Ni lo menciones. Siento que, en cierto modo, somos como una familia con una larga historia en común. Bueno, al menos así es como yo lo veo, así que no hay nada de malo en reunirnos cuando todos estén libres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540506,
					"content": "¿Una familia? No sé por qué, pero escucharte decir eso me llena de alegría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 742540507,
					"content": "Entonces, ¿eso convierte a Sandrone en nuestra... hermanita menor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Marianne"
				},
				{
					"id": 742540508,
					"content": "Eh... Quizás podríamos dejar de lado por ahora todo eso de “mayor” y “menor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540509,
					"content": "Afirmativo. Dado que se trata del prototipo original creado por el Sr. Alain, la manera más apropiada de dirigirse a mí debería ser “hermano mayor”, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "*Tch*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540511,
					"content": "Qué bonito. ¿Puedo formar parte de esta familia yo también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540512,
					"content": "¡Por supuesto! Para empezar, no somos precisamente una “familia” convencional. ¿Qué daño podría hacer añadir una melusina al grupo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540513,
					"content": "Afirmativo. Además, la Srta. Maime ya es parte de mi familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Jeje. ¡Esto me hace tan feliz! ¿Y si pinto un retrato familiar de todos nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540515,
					"content": "¿Un retrato familiar? Hace mucho tiempo que no poso para uno de esos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Marianne"
				},
				{
					"id": 742540516,
					"content": "¡Tienes que hacer que yo salga superbién, Maime! ¡Como la hermana mayor de la familia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 742540517,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540518,
					"content": "Ja... ¿Por qué no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
