			"dialogs": [
				{
					"id": 742540601,
					"content": "Qué día tan tranquilo y agradable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "Marianne"
				},
				{
					"id": 742540602,
					"content": "(Quedémonos sentados así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540604,
					"content": "Mhm, gracias por la invitación, Sandrone... ¿O debería llamarte “hermanita”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marianne"
				},
				{
					"id": 742540603,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
