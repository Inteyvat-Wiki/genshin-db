			"dialogs": [
				{
					"id": 733550201,
					"content": "¿Eh? Parece que no necesito dejar un mensaje en el Gremio de Aventureros. El destino siempre nos vuelve a reunir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550202,
					"content": "Por fin volvemos a vernos, Meteoro Dorado y Estrella Plateada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550203,
					"content": "#Verl{F#a}{M#o}s a amb{F#a}{M#o}s tan radiantes y llen{F#a}{M#o}s de vida me da la maravillosa sensación de que el tiempo se ha detenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550204,
					"content": "¡Cuánto tiempo sin verlos, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "¡Sí que son ustedes, Haniyyah y Cabezabombo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550206,
					"content": "Con razón Paimon sentía que algo le resultaba familiar... ¡Eso significa que el vínculo entre Paimon y Cabezabombo sigue intacto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550207,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Cabezabombo"
				},
				{
					"id": 733550212,
					"content": "#He imaginado muchas formas en las que podríamos reunirnos. Un gran banquete, una fiesta de bienvenida creativa, algo que verdaderamente pudiera sorprenderl{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550213,
					"content": "#Pero todas esas ideas se me antojaban demasiado formales. Han estado ocupad{F#a}{M#o}s, y me preocupaba robarles demasiado tiempo y que acabaran pensando que era un incordio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550214,
					"content": "Además, a los compihongos les gustan los ambientes tranquilos y pacíficos. Así que es mejor que nos reunamos de forma relajada y natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550215,
					"content": "¡Así es! Al final, las lecturas de prosa de Haniyyah dieron sus frutos. ¡Después de todo, tener la mente tranquila es bueno para la vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550216,
					"content": "Tomarse las cosas con calma es la mejor forma de vivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550217,
					"content": "♫...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "Chispitas"
				},
				{
					"id": 733550218,
					"content": "Souka también está aquí, y Chispitas, y... ¿quién es este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550219,
					"content": "Es mi compihongo, Bailarín Setéreo. Cabezabombo y tú nos derrotaron en la ronda de dieciseisavos de final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550220,
					"content": "Jeje, ¡Paimon ve que lo recuerdas bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550221,
					"content": "Cada vez me va sonando más...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "#Bueno, como pueden ver, querid{F#a}{M#o}s patron{F#a}{M#o}s, no hace falta que concertemos una fecha o un lugar para nuestro próximo encuentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550224,
					"content": "¡Haniyyah y yo hemos comprado este distrito comercial y lo hemos transformado en el “Champiparque”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550225,
					"content": "Espera, ¿estás diciendo que no han alquilado estas instalaciones para el juego de mesa, sino que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550226,
					"content": "Exacto. A partir de ahora viviremos en el Puerto Bayda y promocionaremos el juego de mesa de los Hongos, además de compartir nuestra teoría sobre cómo comunicarse con los animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550227,
					"content": "¡Podrán venir cuando quieran para jugar con los compihongos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550228,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "Cabezabombo"
				},
				{
					"id": 733550229,
					"content": "¡Genial! ¡Compihongos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "¡E-esta es una de las mejores noticias que le han dado a Paimon hoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550232,
					"content": "Tras el primer Torneo de Hongos, ¡a Paimon se le ocurrieron muchísimas ideas para jugar junto a Cabezabombo! ¡Ahora por fin podremos hacerlas realidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550233,
					"content": "Qué pena que no hayamos traído ningún aperitivo para los compihongos... ¡Sería increíble poder acurrucarnos junto a ellos y disfrutar de un banquete de comida deliciosa juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550234,
					"content": "No se preocupen por eso. En mi versión mejorada de «Compendio sobre las comunidades de Hongos», he estado investigando los alimentos predilectos de los Hongos desde el nivel más básico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550235,
					"content": "Mi objetivo es identificar ingredientes que tanto los Hongos como los humanos puedan comer para que nuestros compañeros no tengan que pasarse todo el año alimentándose solo de agar mirífico de diferentes sabores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550236,
					"content": "¡Algún día encontraré ingredientes que satisfagan tanto el gusto humano como el de los Hongos, y diseñaré platos deliciosos que todos podamos disfrutar juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550237,
					"content": "Cuando llegue el momento de poner la teoría en práctica, yo me encargaré de cocinar. No vaya a ser que Haniyyah termine arruinando nuestra olla número once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550238,
					"content": "Parece que el día en que nos sentemos en círculo a compartir una comida con los compihongos no está tan lejos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550239,
					"content": "¡Esperaremos tus buenas noticias, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "En ese caso, por favor, vuelvan a visitar el Champiparque cuando tengan la oportunidad. Nosotras y los compihongos estaremos aquí esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550242,
					"content": "¿Quién sabe? La sorpresa podría llegar incluso antes de lo que esperan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550243,
					"content": "¡♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cabezabombo"
				},
				{
					"id": 733550240,
					"content": "¡Qué ganas de probar el banquete de Souka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550230,
					"content": "¡Ahora podremos vernos siempre que queramos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550222,
					"content": "Este ambiente cálido y acogedor me está ayudando a relajarme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550208,
					"content": "Aunque no me acuerdo del todo... ¡Hola!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550209
					]
				},
				{
					"id": 733550209,
					"content": "¡Son Haniyyah y Cabezabombo de verdad! Nos conocimos en el Torneo Loto Nilotpala de Doma de Bestias. ¡Son viejos amigos nuestros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550210,
					"content": "Después nos volvimos a encontrar cerca de Puerto Ormos y en la Corte de Fontaine. Pero ha pasado tanto tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550211,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Cabezabombo"
				}
			]
		}
	]
}