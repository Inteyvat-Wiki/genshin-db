			"dialogs": [
				{
					"id": 733550101,
					"content": "Eh, acaba de pasar un Hongo flotando. ¿Seguro que no pasará nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550102,
					"content": "Normalmente, que un Hongo esté tan cerca de la ciudad sería peligroso, ¿no? A no ser que sea uno de esos especiales que han recibido entrenamiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550103,
					"content": "Un momento, ¿por qué le resulta familiar a Paimon? ¿Acaso ya vivimos algo así antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550104,
					"content": "Eh, ¿no es ese Cabezabombo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "¡Eso es! ¡Cabezabombo! ¡El amigo Hongo que hicimos en Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550106,
					"content": "¡Aaah, ha pasado muchísimo tiempo desde que lo vimos por última vez! ¡Vamos a saludarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550107,
					"content": "¿De qué lo conocemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "Paimon cree que se trata de... ¿Cabezabombo? ¡El amigo Hongo que hicimos en Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550109,
					"content": "¡Aaah, ha pasado muchísimo tiempo desde que lo vimos por última vez! ¡Vamos a saludarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
