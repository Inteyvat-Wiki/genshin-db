			"dialogs": [
				{
					"id": 721180301,
					"content": "¿Tomaste imágenes de cómo estaba la situación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180302
					],
					"speakerTitle": "Xavier"
				},
				{
