			"dialogs": [
				{
					"id": 721180501,
					"content": "Últimamente, los movimientos de los Fatui son más extraños que nunca. Se están reuniendo alrededor del núcleo de la fragua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180502,
					"content": "Espero que no estén tramando otro plan maléfico... O, mejor dicho, que no planeen nada que no podamos solucionar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
