			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "¡Genial! Déjame ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "Parece que estamos de suerte. La Fragua Mikage está bastante estable, y la energía de los tatarigami en su interior no se ha condensado demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "Mi dispositivo resistirá estos niveles de condensanción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "¿Tenemos que purificar toda la energía de los tatarigami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Si este dispositivo pudiera hacer eso, ya habría mandando una solicitud de licencia hace mucho tiempo. Pero nuestro amiguito solo puede disminuir los niveles de energía en un área concreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Sin embargo, la razón por la que la Fragua Mikage fue desactivada, y el fracaso al intentar reactivarla, se deben a la alta concentración de energía de los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "Si encontramos el área con la más alta concentración y la purificamos, podremos reactivar el núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "En ese momento, la Fragua Mikage debería reiniciarse, y todo lo que venga después... no son asuntos que nos incumban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Hasta aquí llegan mis planes. Antes de que los pongamos en marcha, todavía tengo que hacer unos preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
