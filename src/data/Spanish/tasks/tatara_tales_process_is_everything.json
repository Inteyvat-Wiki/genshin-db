			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "¡Bien! ¡Por fin está terminado! Por suerte, recuerdo las especificaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180102,
					"content": "Entonces, ¿vamos a purificar la energía de los tatarigami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Me encantaría hacerlo, sí, pero no debemos bajar la guardia ni siquiera por un segundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180104,
					"content": "Además, dado que no pudimos encontrar algunos materiales y, por lo tanto, tuvieron que ser reemplazados en el momento por otros, este dispositivo no es muy confiable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180105,
					"content": "Humm. Bueno, déjenme decirles que en algunas circunstancias, es posible que no logre la eficacia deseada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180106,
					"content": "Aunque se puede usar correctamente, dudo que pueda resistir accidentes, y si lo movieran con demasiada fuerza, podrían salirse algunos componentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180107,
					"content": "Dicho esto, todavía necesitamos un poco más de preparación antes de utilizarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180108,
					"content": "Me gustaría que vayas cerca de la Fragua Mikage y recabes un poco de información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180109,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Muchas gracias. Te estaré esperando aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180111,
					"content": "¿De veras tenemos que andar con tanta cautela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Por supuesto que sí. A decir verdad, ahora incumplí algunos pasos. Si el señor Flois estuviera aquí, con su forma de proceder, tendríamos que esperar otra semana antes de poder ponernos a trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180113,
					"content": "En resumen, debemos proceder en función de lo que exige la situación. Después de todo, el equipo de evaluación especial somos nosotros... y yo nos autorizo a adaptarnos a nuestra situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
