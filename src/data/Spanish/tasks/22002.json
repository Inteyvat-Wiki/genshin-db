			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Bien, ¡comenzamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020203,
					"content": "Empieza tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020204,
					"content": "Hola, esto es un asalto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "¿Robando a plena luz del día? ¡La Geoarmada te castigará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, rápido, tenemos que huir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220020207,
					"content": "Hola, ¿qué le gustaría robar el día de hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020208,
					"content": "Pues... dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Pero no tengo mucho dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020213,
					"content": "Papá dice que en un barco lo que más vale son las cosas que lleva el comerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020214,
					"content": "¡Lo tengo! Ayúdame a buscar algo de valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020215,
					"content": "¡Así tendré algo que valga la pena robar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020216,
					"content": "Déjame pensar... Ayúdame a buscar cabezas de loto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020217,
					"content": "#A nosotros nos encanta comer cabezas de loto. Si quieres ser {F#una}{M#un} pirata malvad{F#a}{M#o}, robar cabezas de loto es un buen comienzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020209,
					"content": "¡A ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Si bien es un juego, hay que tener precaución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020211,
					"content": "¿Ves? Los soldados de la Geoarmada nos están observando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Pequeña Lulu"
				}
			]
		},
