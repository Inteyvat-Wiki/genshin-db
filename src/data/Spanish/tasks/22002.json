					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020304,
					"content": "Meng, Fei, ¡vengan a comer cabezas de loto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020305,
					"content": "Pero estamos en medio de un asalto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Oh, es verdad. ¡Bah! Ten el dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020307,
					"content": "#¡Eres {F#una}{M#un} pirata {F#nata}{M#nato}! ¡No todos tienen agallas para robarle a un niño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020308,
					"content": "#Paimon siente que se burla de nosotr{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "#¡Gracias, {NICKNAME}! Ven a jugar pronto con nosotros.",
					"roleType": "TALK_ROLE_NPC",
