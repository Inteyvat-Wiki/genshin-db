			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, ¿por qué soy yo el capitán de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220020102,
					"content": "Porque es más divertido cuando tú eres el capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020103,
					"content": "Pues si estás de acuerdo, no tengo ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220020104,
					"content": "¿Qué hacen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Vamos a jugar un juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020106,
					"content": "Meng es capitán, Fei es marinero, y yo soy comerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020107,
					"content": "¡Solo nos falta un pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020108,
					"content": "¿Quieres jugar con nosotros y ser un pirata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020109,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020113,
					"content": "#De acuerdo, ¡ven cuando estés list{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220020111,
					"content": "Quiero ser una persona buena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "Solo es un juego, sé que eres una persona buena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Pequeña Lulu"
				}
			]
		},
