				},
				{
					"id": 760020709,
					"content": "“Verificación fallida. <color=#FF5E41FF>Verificación fallida</color>. <color=#FF5E41FF>Verificación fallida</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>AniquilarAniquilarAniquilarAniqui</color>...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020710
					],
					"speakerTitle": "Srta. Belleville"
				},
				{
					"id": 760020710,
					"content": "#¡Ah! ¡Cuidado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020704,
					"content": "Bueno, ahora el botín es mío...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020705
					]
				},
				{
					"id": 760020705,
					"content": "#¡Sí! Claramente nos lo hemos ganado, ¿por qué íbamos a compartirlo con ellos? Un momento, ¡no deberíamos decir esas cosas! Somos aventurer{F#a}{M#o}s honrad{F#a}{M#o}s... ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020706,
