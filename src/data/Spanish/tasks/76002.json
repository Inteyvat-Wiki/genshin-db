			},
			"dialogs": [
				{
					"id": 760020301,
					"content": "Uff... Deja que se marchen. Esas comadrejas no tienen luces, ¿cómo se atreven a aparecer por nuestro territorio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Gracias por la ayuda. Cuando mis hombres lleven a la Srta. Belleville a la Villa Nasha, les pagaré como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Sí, sí, mientras recuerden el pago... ¿Eh? Un momento, ¿acaso son traficantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Jaja, no nos malinterpretes, pequeña. No hacemos negocios con secuestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "“Srta. Belleville” es el nombre de este cacharro de metal. La hemos traído desde el Río Ceniciento, con todo el esfuerzo que eso ha supuesto. Si se la hubieran llevado, estaríamos acabados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "¡Oh, así que es un Mecabot de Fontaine!... Visto así, la tecnología de Fontaine debe ser increíble, si puede seguir moviéndose después de llegar hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Estarás de broma, pequeña. Este cacharro de metal lleva mucho tiempo sin tener un sistema de alimentación, ¿cómo iba a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "Alerta. <color=#FF5E41FF>Anomalía</color> detectada en el modo de inicio. Módulo de energía <color=#FF5E41FF>anó5F02&#5E38malo</color>. Error en la verificación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Srta. Belleville"
				},
				{
					"id": 760020309,
					"content": "“Verificación fallida. <color=#FF5E41FF>Verificación fallida</color>. <color=#FF5E41FF>Verificación fallida</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>AniquilarAniquilarAniquilarAniqui</color>...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Srta. Belleville"
				},
				{
					"id": 760020310,
					"content": "#¡Ah! ¡Cuidado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
