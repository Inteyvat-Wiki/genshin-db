			"dialogs": [
				{
					"id": 760020701,
					"content": "Jeje, ¡han salido corriendo con el rabo entre las piernas! ¡Y pensar que estos Ladrones de Tesoros querían que los ayudáramos a luchar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020702,
						760020704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020702,
					"content": "¡La justicia siempre prevalece!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020703
					]
				},
				{
					"id": 760020703,
					"content": "¡Eso, eso! Oh, por cierto, a Paimon le da mucha curiosidad saber qué es lo que intentaban robar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020707
