			"dialogs": [
				{
					"id": 760020501,
					"content": "¡Ja! Por fin nos libramos de ellos. Esos forasteros no paraban de decir chorradas, que si quemar, que si no... Ahora que están congelados, seguro que ya no les quema nada, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Eh... Bueno, Paimon supone que eso impedirá que las mercancías de contrabando lleguen a la Villa Nasha, ¿verdad? Por cierto, ¡no se olviden de nuestra recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Hum, antes que nada, dejen que inspeccione la mercancía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "¿Humm? ¿Inspeccionarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "¡Pues claro! Si hay algún problema, ni mis chicos ni ustedes recibirán ni un solo Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "*Tch*... Estos rayajos... ¡Incluso tiene manchas de óxido! Qué chapuceros están en el Río Ceniciento últimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "¿Eh? ¿No es eso un Mecabot de Fontaine? Visto así, la tecnología de Fontaine debe ser increíble, si puede seguir moviéndose después de llegar hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "¿Moverse? Este cacharro debe de llevar mucho tiempo sin tener un sistema de alimentación, ¿cómo iba a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
					"content": "Alerta. <color=#FF5E41FF>Anomalía</color> detectada en el modo de inicio. Módulo de energía <color=#FF5E41FF>anó5F02&#5E38malo</color>. Error en la verificación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020510
					],
					"speakerTitle": "Srta. Belleville"
				},
				{
					"id": 760020510,
					"content": "“Verificación fallida. <color=#FF5E41FF>Verificación fallida</color>. <color=#FF5E41FF>Verificación fallida</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>AniquilarAniquilarAniquilarAniqui</color>...”.",
					"roleType": "TALK_ROLE_NPC",
