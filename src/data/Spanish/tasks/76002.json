			},
			"dialogs": [
				{
					"id": 760020101,
					"content": "#¡Oye, {F#la}{M#el} camarada rubi{F#a}{M#o} de ahí! Vienes justo a tiempo, este tipo se la está buscando. ¡Échame una mano y te pagaré bien cuando acabemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "#¿De qué vas? ¿No puedes tú solo y pides refuerzos? Como quieras, si tú puedes hacerlo, yo también. Escúchame, chic{F#a}{M#o}, ayúdame con este tipo, ¡y te daré la mitad cuando tengamos el Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "#¡¿C-cómo?! Nosotr{F#a}{M#o}s solo pasábamos por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
