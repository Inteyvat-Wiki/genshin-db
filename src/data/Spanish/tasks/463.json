						4630530
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630535,
					"content": "Qué sorpresa que hayan resuelto todos los rompecabezas por cuenta propia y llegaran antes que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630536,
					"content": "Entonces, ¿fuiste tú quien dejó todas esas pistas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630537,
					"content": "Efectivamente. Sin embargo, incluso yo creía que las pistas eran demasiado ambiguas para ser de ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630538,
					"content": "Estaba preparado para responder tus preguntas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630539,
					"content": "Muy impresionante. Esto fue lo único que no anticipé de toda la operación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630541,
					"content": "¡Fue un juego de niños!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4630542,
					"content": "Oh, en realidad, usé otras fuentes para obtener ayuda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4630540,
					"content": "¡Ja! ¡Eso no fue nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630543,
					"content": "No importa lo que digas, reconozco tu sabiduría. Después de todo, la sabiduría misma no engaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630544,
					"content": "¡Pero algunas personas disfrutan engañando a otras con su ingenio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630545,
