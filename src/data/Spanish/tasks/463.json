				},
				{
					"id": 4630503,
					"content": "Oye... ¿Así es como los Caballeros de Favonius tratan a un prisionero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630504
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630504,
					"content": "Estoy bromeando. Bien, llevémoslo de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630505,
					"content": "¡Señor! ¡Sí, señor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630506
					],
					"speakerTitle": "Caballero de Favonius"
				},
				{
					"id": 4630506,
					"content": "#Capitán, ¿deberíamos llevarnos también a es{F#as}{M#os} dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630507
					],
					"speakerTitle": "Caballero de Favonius"
				},
				{
					"id": 4630507,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630508,
					"content": "#Jaja, claro que no. Ell{F#as}{M#os} son l{F#as}{M#os} que hicieron posible este arresto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630510,
					"content": "¡Entonces fue un engaño!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630511,
					"content": "¿Entonces no hay ningún tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630512,
					"content": "¡Nos mentiste!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630509,
					"content": "#Si ell{F#as}{M#os} no hubieran difundido la <color=#00E1FFFF>información falsa</color> que les di, no habríamos podido atrapar a los ladrones de tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630510,
						4630511,
						4630512
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630513,
					"content": "*Snif*, eres un mal hombre por mentirnos... ¡Qué vergüenza para los Caballeros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630514,
					"content": "Calma, calma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630515
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630515,
					"content": "El tesoro no existe, pero lo querías para ti, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630516,
					"content": "De lo contrario, ¿por qué no me informaron de sus acciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630517
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630517,
					"content": "Pues... Eh... ¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630518,
					"content": "#Vámonos, {NICKNAME}. ¡Paimon no tiene nada que discutir con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630519,
					"content": "¡Jaja! Esperen un segundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630520
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630520,
					"content": "En realidad me ayudaron, así que merecen una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630521
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630521,
					"content": "Esta es la “Espada Triunfal del Alba Apuntavictorias”. Como su nombre indica, simboliza la luz y la victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630533,
					"content": "Si te parece bien, me gustaría entregarte esta Espada del Alba como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630522
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630522,
					"content": "¿La Espada del Alba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630523,
					"content": "Así es. Es apta para una persona culta y disciplinada como tú, ¿no lo crees, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630524,
					"content": "Bueno... Si esa es la recompensa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630525,
					"content": "Entonces, ¿me perdonas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630526,
					"content": "Me siento honrado de tener una amiga tan comprensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630527,
					"content": "De acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630529,
					"content": "... Paimon ha quedado completamente encantada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630530,
					"content": "¿Significa que usarás un método diferente la próxima vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630528,
					"content": "Te pido disculpas por haberte engañado. No usaré la misma táctica dos veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630531,
					"content": "¡Hoy es un buen día! Ahora, tengo que ir a interrogar a mi sospechoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630532,
					"content": "Con permiso. Vengan a visitarme a nuestra sede cuando tengan la oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
