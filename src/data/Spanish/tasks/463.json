			"dialogs": [
				{
					"id": 4630001,
					"content": "Nos ha costado, pero al fin hemos resuelto el misterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630014,
					"content": "Sinceramente, este mapa del tesoro es terrible... Parece que fue dibujado por un pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630002,
					"content": "Y ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630003,
					"content": "Primero informemos a Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "¿Eh? ¡Paimon no cree que sea necesario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630006,
					"content": "¡Leíste la mente de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630007,
					"content": "#¡Vamos! ¡Que nadie llegue antes que nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630008,
					"content": "Como... Como los ladrones de tesoros de los que Kaeya nos habló.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630009,
					"content": "De todos modos, Paimon solo quiere pedir prestada la espada para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630010,
					"content": "No, ¡no escuchaste nada! ¡Paimon solo quiere verla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630011,
					"content": "No es que quiera ser mega poderosa ni nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630012,
					"content": "Muy bien, Paimon dejará la charla para más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630013,
					"content": "¡Vamos de cacería de tesoros a Arcadia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630005,
					"content": "¡Vamos a la ubicación del tesoro directamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
