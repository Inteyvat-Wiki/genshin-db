			"dialogs": [
				{
					"id": 4630101,
					"content": "Estas deben ser las ruinas de Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630102,
					"content": "¿Es imaginación de Paimon o parecen muy... normales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630103,
					"content": "¡Paimon lo sabe! ¡El mejor disfraz es estar a la vista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630104,
					"content": "El abuelo de Kaeya es sorprendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630105,
					"content": "*Tap, tap*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 4630106,
					"content": "Paimon, ¿oíste eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "Ratones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630108,
					"content": "Respondiste lo primero que se te vino a la cabeza, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "No es momento de dudas. ¡Estamos cerca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630110,
					"content": "¡Apresúrate! ¡El tesoro nos está esperando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 46303,
