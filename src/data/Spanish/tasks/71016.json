			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Encontré los tres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "¿De verdad lograste reunir los tres? A ver... Sí, al juntar estos tres patrones, cuentan la historia de Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Esta grulla debe ser el Adeptus Moldeador de Montañas, y este ciervo podría ser Escultor de la Luna. Pero este último...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "¿Eh? Parece que alguien borró intencionalmente este patrón. No puedo entenderlo. ¿Quién era el tercer Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Bueno, no importa. Eso ya va más allá de lo que sé. Aun así, el tesoro está completo y seguramente se venderá a un buen precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Entonces, ¿te gustaría quedártelo como recuerdo o prefieres vendérmelo? Te pagaré una buena suma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "Todo tuyo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Bien. Toma, este dinero es para ti. Yo me quedo con el objeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Aun así, ¿por qué la imagen de uno de los tres Adeptus se volvió irreconocible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160510,
					"content": "¿Quién fabricó esta cosa? ¿Y quién la rompió y borró la imagen del Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160511,
					"content": "Cierto, creo que Soraya está en Liyue. Podría escribirle una carta... Seguro que se sentiría muy interesada por este objeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
			"id": 7101606,
			"completionStepIds": [
