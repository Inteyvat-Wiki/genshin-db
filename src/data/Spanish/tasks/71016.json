				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "Sobre el tesoro sin nombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "Esta cosa que has traído ... Se ve bastante bien. Este patrón también parece bastante antiguo. Espera mientras lo abro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "#Tiene algunos defectos, pero si estás ansios{F#a}{M#o} por venderlo, puedo ofrecerte un precio justo, pero no muy alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Acabo de echar un vistazo a este. Estas marcas son las de Liyue, y mira, aquí hay inscrita una anécdota sobre Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "Dicen que Azhdaha fue un dragón engendrado por una condensación de espíritus Geo en Liyue, y que ni siquiera Rex Lapis podía contenerlo fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Rex Lapis invocó a tres Adeptus para que lo ayudasen a crear un terreno lleno de cavernas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Rex Lapis atrajo a la criatura a una caverna para luchar contra ella. Luego, ordenó a los Adeptus que sellaran la entrada para dejar a Azhdaha atrapado en el interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "Los patrones de lo que trajiste parecen describir a los tres Adeptus que se unieron para crear la caverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "Supongo que debería haber, al menos, tres reliquias de este tipo. Al combinarlas, puede que obtengamos el objeto completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Cuántas cosas sabes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Bueno, comercio con todo tipo de artículos. Debo tener un cierto conocimiento general.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Me desvié del tema, lo siento. Como dije antes, debería haber tres objetos iguales que este. Si solo vendes uno de ellos, el precio no será muy alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Otra cosa sería que pudieras reunir los tres, pero son unos objetos muy antiguos. Reunirlos podría ser una tarea difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue es el lugar más extraño en el que he estado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "No estoy segura de esto, pero una persona me dijo una vez que Liyue es demasiado grande, y que su historia es, igual que su extensión, demasiado larga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "No te sorprendas si encuentras reliquias extrañas en Liyue. Nuestro conocimiento sobre su larga historia no es más que una gota en el inmenso océano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
