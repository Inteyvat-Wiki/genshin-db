						730030503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030503,
					"content": "Explican brevemente lo ocurrido.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730030504
					]
				},
				{
					"id": 730030504,
