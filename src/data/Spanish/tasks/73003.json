			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rhana",
					"Paimon",
					"Iotham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#Lo siento... {NICKNAME}, Paimon, necesito descansar un poco... Iotham, espérame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030802,
					"content": "Rhana, ¿seguro que no es nada serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030803,
					"content": "Vayamos a buscar ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "No pasa nada... Solo tengo que... descansar un rato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030805,
					"content": "Lo siento, Rhana... Lo siento mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030806,
					"content": "En serio... Ya te dije que estoy bien, pero todavía estoy muy enfadada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030807,
					"content": "Me prometiste que... no irías al bosque... Lo dijiste. Una vez que me haya recuperado, te daré una lección por no haberte portado bien... Diablillo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030808,
					"content": "*Solloza*... ¡Escuché decir a Alphonse que aquí crecían setas muy grandes! Quería recoger algunas frescas para ti, para darte energía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030809,
					"content": "Tonto... No necesitabas hacer eso. A mí me basta con pensar en ustedes para tener energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030810,
					"content": "Aunque... Jajaja, es cierto que las setas de aquí son enormes. Si las utilizamos para hacer curri, seguro que sale riquísimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030811,
					"content": "¿Alphonse te dijo que vinieras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "No. Alphonse también dijo que no saliese de la aldea. Pero yo quería darle algo rico de comer a Rhana, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030813,
					"content": "Alphonse no habría hecho algo así. Al fin y al cabo, es como si fuese tu hermano mayor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030814,
					"content": "Sí... ¿Pero cómo es que Iotham quedó atrapado en una zona marchita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030815,
					"content": "Me pareció que alguien me estaba siguiendo por el bosque. Estaba muy asustado y pensé que era el avatar del Marana, así que seguí corriendo... *Solloza*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030816,
					"content": "Y al final acabé cayendo en el Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030817,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030818,
					"content": "¿El Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "¿Quieres decir... una zona marchita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030820,
					"content": "¡Ah! Eso es, una zona marchita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "¿Un avatar del Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Sí, es una cosa negra y grande que hace cosas malas en el mundo en nombre del Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "Marana... Qué nombre tan extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "¿Cómo he sabido que el Marana es una zona marchita? Ay... Todo me da vueltas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030830,
					"content": "Iotham, ¿qué fue eso verde de hace un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "Era el ararakalari. Puede proteger a alguien y evitar que le afecte la corrosión del Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "Cada vez entiendo menos cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "Es... un tipo de magia del bosque, y también es un tipo de música. Es algo que los ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030835,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Eso ahora no importa, Rhana. Lo que tienes que hacer es descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "Lo tenía en la punta de la lengua, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030839,
					"content": "Perdón, Rhana, perdóname... Nunca más me escaparé, seré bueno y me quedaré en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "Sí, lo sé. Tienes que convertirte en alguien inteligente, sano y que sepa distinguir qué está bien y qué está mal. Como saber qué setas son comestibles y cuáles no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030841,
					"content": "Lo sé, lo sé... Perdón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Tienes que saber que el Marana es malo y que el bosque es bueno para hacerte más fuerte y ser una persona buena que pueda ayudar a los demás, como {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030843,
					"content": "Bien, y no lo olvides: el bosque se acuerda de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030844,
					"content": "¡Ay! ¡Esto es terrible! ¡Parece que Rhana está empeorando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "Vayamos a buscar ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "¿Eh? Ah... Está bien, no pasa nada... Será mejor que descanse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, por favor... Llévate de vuelta a Iotham por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030849,
					"content": "Sí, vamos, Iotham. Tú no te muevas, Rhana. ¡Enseguida volvemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rhana, espera aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "No pienses en eso ahora, será mejor que descanses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
					"id": 730030823,
					"content": "¿Un avatar del Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030824
					]
				},
				{
					"id": 730030824,
					"content": "Sí, es una cosa negra y grande que hace cosas malas en el mundo en nombre del Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030825
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030825,
					"content": "¿El Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030826
					]
				},
				{
					"id": 730030826,
					"content": "¿Quieres decir... una zona marchita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030827
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030827,
					"content": "¡Ah! Eso es, una zona marchita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
