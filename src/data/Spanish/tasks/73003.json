						730030505
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730030505,
					"content": "De acuerdo. Lo siento, Alphonse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030506,
					"content": "#No pasa nada, lo importante es que estés bien. {NICKNAME}, espérame. L{F#as}{M#os} acompañaré en cuanto haya reunido algunas medicinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730030507,
					"content": "No hay tiempo. Aquí está la ubicación, ve tú mismo.",
