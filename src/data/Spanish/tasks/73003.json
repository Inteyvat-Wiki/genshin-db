			"dialogs": [
				{
					"id": 730031001,
					"content": "... ¿Quiénes son ustedes? No se interpongan en nuestro camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031002
					],
					"speakerTitle": "Oficial Fatui"
				},
				{
					"id": 730031002,
					"content": "¡Ey! ¡Eso lo debería preguntar yo! Soy la guarda forestal de aquí y estoy buscando a un niño que se perdió. ¡Digan sus nombres!",
					"roleType": "TALK_ROLE_NPC",
