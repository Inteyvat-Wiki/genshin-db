			"dialogs": [
				{
					"id": 730030201,
					"content": "Iotham... ¿Qué ha pasado?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030202,
					"content": "#*Solloza*, ¡Rhana, eres tú! Y {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030203,
					"content": "¿Eh? ¿Qué hace Iotham en una zona marchita? Además, aquí hay muchos monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030204,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030205,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "No... No tenemos tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030208,
					"content": "#¡Maldición! ¡{NICKNAME}, por favor, ayúdame! ¡Hagamos esto junt{M#os}{F#as}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030209,
					"content": "Iotham, pórtate bien y no te muevas. ¡Vamos a salvarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030206,
					"content": "¿Qué es eso verde...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
