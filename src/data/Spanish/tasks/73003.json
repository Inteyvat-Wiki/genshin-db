					"id": 730030604,
					"content": "No hay respuesta... ¡Ay! ¿Qué habrá ocurrido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030605,
					"content": "¿Eh? Estos rastros son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030607,
					"content": "Vamos a seguirlos a ver hacia dónde nos llevan. Quizá sean unas pistas que Rhana nos dejó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030606,
					"content": "¿Qué son estos rastros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030607
					]
				}
			]
		},
