						730031005
					]
				},
				{
					"id": 730031005,
					"content": "¿Eh? ¿Son estos los Fatui que Alphonse mencionó? Expliquen qué hacen aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031006
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730031006,
					"content": "¿Alphonse?... Da igual. ¡Sean quienes sean, no piensen que podrán salir de aquí de una pieza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031007
					],
					"speakerTitle": "Oficial Fatui"
				},
				{
					"id": 730031007,
					"content": "¡Hum! ¡Parece que no quieren atender a razones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhana"
				},
