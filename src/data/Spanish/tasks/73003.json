			"dialogs": [
				{
					"id": 730030301,
					"content": "Uff, por fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030302,
					"content": "Rhana... *Buaaaa*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham... Ya eres un hombrecito, no llores. Mira... Puedo explicarles a ellos... A los eruditos de la Academia de Sumeru... lo que se siente en una zona marchita. Entonces, podrán encargarse de ellas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030304,
					"content": "#Además... ¿Lo viste? ¿Viste cómo luché... no, cómo luchó {NICKNAME}? Tendrás que darle las gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030305,
					"content": "Rhana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Es suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Rhana, deberías descansar un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Ja... ¡Jaja! Está bien, solo me siento un poco mareada y cansada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030310,
					"content": "Rhana... Perdóname...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "¿Qué...? ¿De qué estás hablando? Eres mi fierecilla, ¡no llores! ¿De verdad estás bien, Iotham? ¿Te has lastimado? ¿Te encuentras mareado o débil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030312,
					"content": "Estoy bien, pero tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "¡No me pasa nada! Estoy bien. Al fin y al cabo, ¡soy una guarda forestal bien curtida! ¡Anda, vámonos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030308,
					"content": "Iré a buscar ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
