			"dialogs": [
				{
					"id": 730030701,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030702
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030702,
					"content": "¡Ey! ¡Rhana! ¿Escuchas a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030704
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730030704,
					"content": "¿Qué está pasando aquí? ¿No es esto el ara, ara... eso de lo que hablaron Iotham y Rhana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
						730030708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030705,
					"content": "¿Ararakalari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "¡Ah! ¡Sí, sí, sí! ¡Eso mismo! Parece que dijeron que podía resistir a la corrosión del Marana o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "#Así es. Eres nara list{M#o}{F#a}. Ararakalari puede contrarrestar Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030711,
					"content": "¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030712,
					"content": "¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030713,
						730030715
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030713,
					"content": "¿No es la criatura que vimos antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "¡*Fiu...*! ¡Vaya susto! Paimon pensaba que ahora las verduras hablaban...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030716,
					"content": "Arana no es ninguna verdura, es aranara, y también amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030717,
					"content": "Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "¿Eh? ¿Dijiste aranara? A Paimon le parece que te hemos visto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030719,
					"content": "Arana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "A Paimon le parece haber escuchado ese nombre cuando le contamos la historia a Iotham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030721,
					"content": "Sí, nara Iotham es amigo de Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030727,
					"content": "#Aranara son retoños de bosque, viven con árboles. No como tú, nara {NICKNAME}. Eres hij{F#a}{M#o} de diente de león, siempre estás viajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030728,
					"content": "#¿Cómo es que sabes el nombre de {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030729,
					"content": "No importa cómo Arana sabe. Pero importa mucho que Arana ayude a nara Rhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030730,
					"content": "Nara Rhana... ¡Vaya trabalenguas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "¿Quieres ayudar a Rhana? ¿Qué necesitas que hagamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030733,
					"content": "#Gracias. Son {F#buenas}{M#buenos} nara. Ella es buena amiga, muy importante para Arana. Así que Arana protegerá a ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030734,
					"content": "#Pero eso no basta. Para curar a nara Rhana necesitamos fruto bija. Nara {NICKNAME}, tienes que ir a Vanarana y pedir que consigan fruto bija para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030735,
					"content": "¿Fruto bija?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "Marana corroyó mucho a nara Rhana. Si insectos dañinos roen raíces de árbol, se seca hasta morir y frutos de árbol se pudren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030738,
					"content": "Vida de nara es como árbol, e insectos malos son como Marana. Solo fruto bija puede hacer que Rhana se recupere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030739,
					"content": "Humm... Entonces, tenemos que ir a un lugar llamado Vanarana y buscar una manera de conseguir ese fruto bija, ¿no? Y después, ¿podremos curar a Rhana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030740,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030741,
					"content": "¿Y qué pasa con Rhana mientras tanto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "No se preocupen. Arana se quedará aquí para luchar contra corrosión de Marana. Así, situación de nara Rhana no se pondrá más mala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030743,
					"content": "Pero sin fruto bija, tampoco podrá mejorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030745,
					"content": "Sigan camino de bosque y lugares de donde agua viene y podrán llegar a Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030746,
					"content": "Después, canten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030747,
					"content": "¿Cantar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "(Puedo escuchar una melodía en la cabeza.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "Es «Melodía de gran sueño». Si cantan esta melodía, pueden entrar en Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030752,
					"content": "Entrar en nuestro sueño, en nuestro mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030748,
					"content": "Si canto, atraeré a una Megaflora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#Qué chistos{F#a}{M#o}, nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030744,
					"content": "Entendido. ¿Cómo se llega allí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
					"content": "¿Qué es eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030732,
					"content": "¿Qué necesitas que haga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030733
					]
				},
				{
					"id": 730030722,
					"content": "Arana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "A Paimon le parece haber escuchado ese nombre cuando le contamos la historia a Iotham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030724,
					"content": "Sí, nara Iotham es amigo de Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030725,
					"content": "Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "¿Eh? ¿Dijiste aranara? A Paimon le parece que te hemos visto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030715,
					"content": "¡Una verdura!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "¿Cómo era?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Al parecer dijo que era algo que podía contrarrestar la corrosión del Marana... Tenía un nombre muy raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030710,
					"content": "Es ararakalari, puede contrarrestar Marana. Y no es nombre raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				}
			]
		},
		{
			"id": 7300308,
			"completionStepIds": [
				7300314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
