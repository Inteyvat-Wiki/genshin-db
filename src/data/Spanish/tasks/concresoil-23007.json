				{
					"id": 230070301,
					"content": "Tengo un par de ideas. En concreto, hoy busco un poco de barro que haya estado en contacto con criaturas elementales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070302,
					"content": "No estaría mal encontrar una Megaflora. El terreno donde crecen las Megafloras está cubierto por un barro de características muy peculiares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070303
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070303,
					"content": "Aunque yo no soy más que un humilde albañil. No podría enfrentarme a una Megaflora armado con mis ladrillos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070304,
					"content": "#Viajer{F#a}{M#o}, ¿podrías hacerme este favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070305,
						230070308
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070305,
					"content": "Está bien. Te ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070306
					]
				},
				{
					"id": 230070306,
					"content": "Entonces, por favor, tráeme un poco de barro de las raíces de una Megaflora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070307,
					"content": "Te marcaré la localización de una Megaflora.",
					"roleType": "TALK_ROLE_NPC",
