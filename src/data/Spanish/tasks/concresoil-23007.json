			"dialogs": [
				{
					"id": 230070201,
					"content": "Tengo un par de ideas. En concreto, hoy busco un poco de barro impregnado de condensado de Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070202,
					"content": "#Pregunté a la gente dónde puede haber muchos Slimes. Viajer{F#a}{M#o}, ¿puedes ir a buscar algo de barro para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070203,
					"content": "Está bien. Te ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "Cuento contigo, entonces. Puedes derrotar a los Slimes o ignorarlos, lo que prefieras. Con que me traigas un poco de barro de la zona donde están, me basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070205,
					"content": "Te marcaré en un mapa su localización...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070206,
					"content": "¿Y por qué no vas tú mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "Me gustaría ir, pero tengo una montaña de encargos que solucionar en la alfarería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070208,
					"content": "No te preocupes, te compensaré por tu esfuerzo. Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070209,
					"content": "Tienes que buscar el barro en esta zona. Mira, te la marco en el mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070210,
					"content": "Cuento contigo, entonces. Puedes derrotar a los Slimes o ignorarlos, lo que prefieras. Con que me traigas un poco de barro de la zona donde están, me basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
