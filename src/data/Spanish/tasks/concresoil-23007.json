				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "¿Habrá algún material más útil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070102,
					"content": "¿Qué material?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Perdón, estaba hablando en voz alta otra vez. Últimamente hace un tiempo de locos, así que estoy teniendo muchos problemas con la casa. No doy abasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070104,
					"content": "¿No te dedicas a la alfarería?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Así es, pero también hago trabajos de albañilería. Al fin y al cabo, ambos trabajos se sirven de barro, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070106,
					"content": "¿Nunca has oído el dicho: “Para construir una buena casa hay que poner unos buenos cimientos”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070107,
					"content": "“Para desarrollar una teoría académica hay que tener unos buenos fundamentos. Sin una base sólida, todo se viene abajo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070108,
					"content": "Así es como hablan los eruditos. Y aunque yo no lo entienda del todo, parece que le dan la misma importancia a la construcción como al desarrollo de la actividad intelectual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070109,
					"content": "Pero eso es solo una metáfora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "Sea como sea, si se trata de los cimientos de una casa, se necesitan unos buenos materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070112,
					"content": "El barro sirve como material de unión y soporte. Si logro adaptarlo y fortalecerlo, la casa será más sólida y eso hará mi trabajo mucho más sencillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070110,
					"content": "No deberías interpretarlo al pie de la letra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
