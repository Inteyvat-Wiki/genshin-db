				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705050201,
					"content": "Mmmm. Nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050202,
					"content": "¡Todo está en los ingredientes! No hace falta endulzarlo más si las frutas están frescas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050203,
					"content": "Deberíamos agradecérselo al suelo de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050204,
					"content": "En realidad, la primera bebida que preparé fue un Atardecer ceniciento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050205,
					"content": "Yo aún era joven. Mi padre sacó unos ingredientes y me dejó experimentar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050206,
					"content": "Sin peticiones ni instrucciones, el objetivo de mi padre era poner a prueba mi creatividad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050207,
					"content": "El resultado fue un vaso de jugo como este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050208,
					"content": "¿Eh? ¿Por qué un jugo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050209,
					"content": "Mi padre también se extrañó. En realidad, no lo pensé demasiado, solo supuse que sabría dulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050210,
					"content": "Ahora que lo pienso, era tan joven e ingenuo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050211,
					"content": "No creo que a tu padre le pareciera extraño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050213,
					"content": "#Estoy segur{F#a}{M#o} de que para tu padre fue la mejor bebida del mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "No lo había pensado de esa forma... En fin, en aquel entonces, mi padre no dijo ni una palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050216,
					"content": "De todos modos, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050217,
					"content": "Por cierto, tengo algo para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050218,
					"content": "#... Aunque pensándolo bien, esperaré a que hayas adquirido más experiencia como cantiner{F#a}{M#o}. A juzgar por tu habilidad, estoy seguro de que harás un buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050219,
					"content": "¡Y Paimon estará aquí para apoyarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050220,
					"content": "Bien, espero tus resultados con ansias. Nos vemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050221,
					"content": "¡Vuelve cuando tengas un rato libre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050214,
					"content": "#Estoy segur{F#a}{M#o} de que le gustó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
	]
}