	"talks": [
		{
			"id": 39702,
			"completionStepIds": [
				39702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39702",
							"2"
						],
						"stepId": 39702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "La Orden del Abismo... Enemigos de la raza humana. Ni en mi red de contactos hay alguien que tenga información sobre ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970202,
					"content": "Me costó bastante, pero pude conseguir algunas pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970203,
					"content": "¿En serio? ¿Tan rápido? Tiene muy buenos contactos, Sr. Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970204,
					"content": "Ahora que lo pienso, Señor Arconte Anemo Barbatos, ¿por qué necesita la ayuda de unos simples humanos como nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970205,
					"content": "¡Jaja! Pues verás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970206,
					"content": "Los Siete, como nos llama la gente, éramos conocidos como “Los Siete Arcontes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970207,
					"content": "Cada Arconte gobierna sobre su propio territorio de Teyvat. Ese es el papel que desempeñan los Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970208,
					"content": "Obtenemos poder cuando cumplimos con nuestro deber. Pero no me gusta la idea de “gobernar” Mondstadt, y tampoco creo que a la gente le guste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970209,
					"content": "“Construir una ciudad libre y sin gobierno”. No hemos olvidado el deseo de Barbatos para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970210,
					"content": "¡Qué fiel eres, Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970211,
					"content": "Pero parece que alguien tiene demasiada libertad y es demasiado vago como para preocuparse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970212,
					"content": "*Ejem*, en fin, no había vuelto a Mondstadt en un largo tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970213,
					"content": "¡No hay duda de que actualmente soy el Arconte más débil de Los Siete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970214,
					"content": "Y lo dices como si estuvieras orgulloso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Oh, haces que me sonroje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970217,
					"content": "¡Oh, qué dios tan humilde! ¿Es una bendición, o una maldición?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970218,
					"content": "Pero nos estamos desviando. Regresemos al tema en cuestión: el enemigo común de toda la humanidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970219,
					"content": "Rastreemos al <color=#00E1FFFF>Mago del Abismo</color> en los alrededores del <color=#00E1FFFF>Viñedo</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970220,
					"content": "Debemos atraparlo cueste lo que cueste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970221,
					"content": "¡Qué comience la cacería!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Supongo que por eso eres el dios de la Capital de la Libertad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "¿Eh? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970402,
					"content": "Después de derrotar al Mago del Abismo, su cuerpo desprendió una especie de energía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970403,
					"content": "Al parecer sirve para cortar la conexión entre Dvalin y yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}, ¿conoces la <color=#00E1FFFF>Guarida de Stormterror</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970406,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "Bueno, la Maestra Jean y el Sr. Diluc seguro que lo saben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970410,
					"content": "Después de que Dvalin despertara, hizo de las ruinas antiguas su guarida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970411,
					"content": "Igual que las tormentas que aislaron a Mondstadt del resto del mundo, la entrada a las ruinas también está sellada por una barrera especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970412,
					"content": "Pero ahora, conforme la energía se desprendía del Mago del Abismo, pude leer el flujo rítmico con el que estaba tejida la barrera mágica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970413,
					"content": "Tengo que admitirlo, suena peor que un coro de Hilichurls, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970414,
					"content": "... Con esto debería bastar para romper la barrera y llegar al interior de la <color=#00E1FFFF>Guarida de Stormterror</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970415,
					"content": "¿Significa eso que vamos a enfrentarnos a Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970416,
					"content": "Por mí, bien... Es Jean la que quiere evitar cualquier tipo de confrontación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970417,
					"content": "No. Cuando no quedan más opciones, cambiar de estrategia es mi responsabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970418,
					"content": "Si matarlo es la única opción, seré la primera caballera en el frente de batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970419,
					"content": "Por suerte, aún no será necesario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970420,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970421,
					"content": "Quieres decir que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970422,
					"content": "La Lira Sagrada no es nuestro último as en la manga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970423,
					"content": "#No hay duda de que nuestra mejor carta es {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970424,
					"content": "#¿{NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970425,
					"content": "¿Es porque purifiqué la Lágrima cristalizada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "Así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970430,
					"content": "Las impurezas en las lágrimas y la maldición que atan a Dvalin provienen del mismo poder maléfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970431,
					"content": "Así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970432,
					"content": "¡De eso nada, bardo de pacotilla! ¡Eso sería demasiado peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970433,
					"content": "#¿Has visto las enormes mandíbulas de Dvalin? ¡Devoraría a {NICKNAME} antes de siquiera pestañear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970434,
					"content": "#Oye, todos han dicho que soy {F#una caballera}{M#un caballero} muy fuerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "Oye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970437,
					"content": "Parece un buen plan. Vale la pena intentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970438,
					"content": "#Estoy contigo, {F#Caballera Honoraria}{M#Caballero Honorario}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970439,
					"content": "Entonces, nuestros enemigos son los monstruos del Abismo... ¡y un dragón! Nada por qué estresarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970440,
					"content": "Los humanos tenemos nuestro orgullo y valor. ¡Preparen las armas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970441,
					"content": "Y entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970442,
					"content": "Las proezas de los héroes los han llevado hasta el capítulo final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970435,
					"content": "¡Tenemos que darlo todo si queremos ganar esta batalla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "¿Es porque puedo pelear?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "#Claro, {NICKNAME}. Tus poderes son excepcionales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970429,
					"content": "Pero tienes otro punto fuerte aún más valioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970408,
					"content": "Algo escuché en Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
				{
					"id": 3970409,
					"content": "Creo que todo el mundo en Mondstadt ha escuchado hablar de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}