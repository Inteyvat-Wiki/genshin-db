					"nextDialogs": [
						718140304
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140304,
					"content": "Esta caja, en cambio, no me es familiar. Quizás debas entregársela a Baiwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140305
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140305,
					"content": "Actualmente está atendiendo algunos asuntos en el Pabellón Yuehai. Quizás ella sepa qué es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kun"
				}
			]
