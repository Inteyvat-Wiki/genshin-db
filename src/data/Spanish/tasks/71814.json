			"dialogs": [
				{
					"id": 718140401,
					"content": "Hola, ¿en qué puedo ayudarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140402
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140402,
					"content": "Recogí esto del mar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "¿Eh? Permítame echarle un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140404,
					"content": "Efectivamente, esto proviene de la Cámara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140405
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140405,
					"content": "¿Puedes darme más detalles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140406
					]
				},
				{
					"id": 718140406,
					"content": "Pues, el contenido consta de varios documentos y un anuncio que aún no ha sido revisado. Y pensar que todavía están tan bien conservados... Qué sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140407
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140407,
					"content": "En fin, su hallazgo nos ahorra algo de trabajo. Limpiarlo todo después de lo ocurrido requiere muchísimo esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140408
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140408,
					"content": "Bien, gracias por traernos esto. Tome, como muestra de nuestro agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
