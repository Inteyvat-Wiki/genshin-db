							0.896
						],
						"pointId": 61
					}
				]
			},
			"dialogs": [
				{
					"id": 40190301,
					"content": "#¿Pero qué ven mis ojos? ¿Dos reclus{F#a}{M#o}s fugitiv{F#a}{M#o}s volviendo a la cárcel? Cómo cambian las cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190302,
					"content": "¡Venimos a ver cómo van las cosas en el Fuerte Merópide! ¿Todo bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190303,
					"content": "Sí, muy bien. Neuvillette vino y se encargó del mayor problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190304,
					"content": "En ese caso, ¿por qué no le pidieron que se quedara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190305,
					"content": "¡Por Los Siete, qué gran idea! ¿Cómo no se me había ocurrido antes? Podemos convencer a su señoría el juez supremo para que abandone el tribunal a cambio de una charca de agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190306,
					"content": "Mejor no...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "Vino a toda prisa y se fue sin ni siquiera tomar un sorbo de té. Menos mal que sí se llevó el regalo de Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190308,
					"content": "Qué persona tan ocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190309,
					"content": "La Srta. Clorinde también se fue y se llevó el regalo de Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190310,
					"content": "Deja que Paimon lo adivine, ¿los regalos eran unos batidos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190311,
					"content": "El de Su Señoría, sí, pero el de Clorinde era un lápiz labial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190312,
					"content": "¿Eh? ¡Son dos cosas totalmente distintas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190313,
					"content": "Bueno, es que Clorinde está menos ocupada y tiene mejor salud que su señoría Neuvillette. Además, a Sigewinne le gusta regalar cosméticos a las damas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190314,
					"content": "Ah, cierto, también tengo un regalo para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190315,
					"content": "¿De parte de Sigewinne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190316,
					"content": "No, de parte mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190317,
					"content": "Como ya terminaron lo que tenían que hacer aquí, pueden volver a la superficie cuando quieran. No obstante, aún no han cumplido su condena, así que hasta entonces pueden seguir usando su celda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190318,
					"content": "¿En serio? ¡Entonces podemos quedarnos aquí un buen tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190319,
					"content": "¿La comida está incluida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "El Comedor será gratis para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190321,
					"content": "¡Yujuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190322,
					"content": "Recuerden venir a mi oficina para hacer el papeleo pertinente cuando hayan cumplido su condena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
