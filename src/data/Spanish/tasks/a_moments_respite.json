						],
						"pointId": 340800094
					}
				]
			},
			"dialogs": [
				{
					"id": 40190601,
					"content": "#Otra vez de vuelta en esta celda, pero la sensación es distinta. Ahora no somos reclus{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190602,
					"content": "De no tener nada a tenerlo todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "Sí, pero en realidad nunca hicimos nada malo para acabar aquí, ¡así que siempre lo hemos tenido todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190604,
					"content": "Es como si hubiéramos recuperado la libertad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "¡Sí! La libertad es una sensación muy especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190606,
					"content": "¿Algo que decir, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "¿Eh? ¿Cómo lo sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190608,
					"content": "Porque normalmente te vas a dormir sin más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190609
					]
				},
				{
					"id": 40190609,
					"content": "#¡Oye, Paimon no hace eso! Bueno... Paimon quiere decir que cree que somos fantástic{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190610,
					"content": "Hemos estado en tantos sitios y conocido a tanta gente... No hemos dejado de viajar y de hacer nuevos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190611,
					"content": "#Hay tantos problemas en el mundo y nosotr{F#a}{M#o}s, siendo dos, los vamos solucionando todos. ¿No te parece fantástico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190612,
					"content": "#¡Somos l{F#a}{M#o}s mejores aventurer{F#a}{M#o}s del mundo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190613
					]
				},
				{
					"id": 40190613,
					"content": "#¿Paimon también? Pero tú eres {F#la única aventurera}{M#el único aventurero} de l{F#a}{M#o}s dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190614,
					"content": "Tú eres la guía, eso también cuenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190615
					]
				},
				{
					"id": 40190615,
					"content": "¡Pues díselo a Katheryne para que también le dé a Paimon un Manual del aventurero! ¡Paimon será la aventurera Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190616,
					"content": "#Ay, qué contenta se pone Paimon solo de pensarlo. Bueno, Paimon quiere irse a dormir, tú también deberías hacerlo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190617,
					"content": "La última vez que dormimos aquí, había un buen alboroto montado afuera... Y también subió el nivel del agua del Mar Primigenio... Qué miedo...",
					"roleType": "TALK_ROLE_NPC",
