			},
			"dialogs": [
				{
					"id": 40190101,
					"content": "¡Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#¡{NICKNAME}, Paimon, han vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "#¿Están bien? No están herid{F#a}{M#o}s ni nada, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "#No te preocupes, ¡estamos fresc{F#a}{M#o}s como un repollo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "¡Sí, estamos bien! ¿Y ustedes? Sabemos que todo se puso patas arriba, ¿están todos bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Algunas personas están heridas, pero en general todo bien. Su señoría Neuvillette vino y, gracias a él, pudimos detener el problema por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Gracias también a ustedes dos por ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "¿Cómo sabía Neuvillette que aquí necesitaban su ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "Su señoría tiene una potente resonancia con el elemento Hydro. Seguramente sintiera las fuertes ondulaciones producidas por el aumento del nivel del agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "Mientras vendaba a algunos reclusos, oí a los Hermanos Bombazo chismear sobre que habían bajado ustedes al piso inferior... Menos mal que están bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Si no tienen mucha prisa, ¿por qué no se quedan aquí unos días más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "#Si hay algo que les apetezca comer, díganmelo para que avise al chef Wolsey. Y si se sienten muy cansad{F#a}{M#o}s, pueden venir a descansar a la enfermería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "De hecho, me gustaría observar un poco más sus músculos faciales. Su sonrisa es supercontagiosa, ¿saben? Tanto que ya la echaba de menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
