			},
			"dialogs": [
				{
					"id": 40190401,
					"content": "¿Eh? ¿Qu-qué hacen ustedes aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190402,
					"content": "¡Cuistot, Lavérune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190403,
					"content": "#¿L{F#a}{M#o}s han capturado y traído de vuelta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Lavérune"
				},
				{
					"id": 40190404,
					"content": "¿Eh? No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190405,
					"content": "#¡Rayos! Pensé que aprovecharon el tumulto para escapar y que se habían convertido en l{F#a}{M#o}s primer{F#a}{M#o}s en conseguir tal hazaña. Pero ahora veo que... en ningún momento se fueron de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190406,
					"content": "Oh, jaja... es que... bueno... teníamos cosas que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190407,
					"content": "De acuerdo, de acuerdo, no hace falta que expliquen nada. Me alegro de que todo esté bien. Cuistot estaba preocupadísimo, ¿saben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Lavérune"
				},
				{
					"id": 40190408,
					"content": "¡No hables solo por mí! ¡Tú estabas igual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Bueno, la verdad es que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Lavérune"
				},
				{
					"id": 40190410,
					"content": "#Me enviaron a trabajar de ayudante de cocina durante unos días. Mientras trabajaba hoy, aún podía oír a Cuistot susurrándole a las zanahorias: “Es{F#a}{M#o}s dos estarán bien, ¿no? Seguro que están viv{F#a}{M#o}s”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Lavérune"
				},
				{
					"id": 40190411,
					"content": "A lo que yo le respondía: “Claro que sí. Seguro que están disfrutando de una bebida en algún sitio bonito”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Lavérune"
				},
				{
					"id": 40190412,
					"content": "#¡Eh! ¿Qué hay de malo en preocuparse por {F#unas compañeras reclusas}{M#unos compañeros reclusos}? Sobre todo, teniendo en cuenta lo mucho que les gustan nuestros chismes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Estos dos... la verdad es que son más simpáticos y humanos de lo que pensaba Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "Seguro que la comida de comedor de estos días sabe mejor gracias a ustedes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "Ay, cómo eres... Si te veo por el Comedor, ¡más te vale acabarte la comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "Seguro que el Comedor es un mejor lugar gracias a ustedes dos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
