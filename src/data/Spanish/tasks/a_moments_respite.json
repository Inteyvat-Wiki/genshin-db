			"dialogs": [
				{
					"id": 40190501,
					"content": "¡Jurieu! La enfermera jefa me dijo que no has comido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190502
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190502,
					"content": "Estaba muy ocupado trabajando, así que me olvidé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190503
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190503,
					"content": "Pero eso no es excusa para... ¿Eh? Vaya, ¡son ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190504
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190504,
					"content": "¡Jurieu, Lourvine, hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190505,
					"content": "¡Hola, hola! Las cosas han sido un caos por aquí, ¿qué tal están?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190506
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190506,
					"content": "Todo bien, gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "¿Y ustedes? ¿Siguen tomando el pasadizo secreto de la enfermería para investigar el barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190508,
					"content": "Sí, pero es un secreto que solo sabemos nosotros, así que, por favor, no lo vayan contando por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190509,
					"content": "Es un rollo cuando hay mucha gente en la enfermería, pero aun así, prefiero esa ruta antes que la de la oficina del duque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190510,
					"content": "Todos sabemos que aprovechas esa excusa para escabullirte del trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190511,
					"content": "¿Ah, sí? ¿Y entonces por qué vas tú también tan a menudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190512,
					"content": "Lo que todos sabemos es que usan la excusa del barco para ir de cita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190513,
					"content": "¡¿Pero qué tontería es esa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurieu"
				}
			]
		},
