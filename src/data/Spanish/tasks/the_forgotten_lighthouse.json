			"dialogs": [
				{
					"id": 762050201,
					"content": "¡Qué hueco tan grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "Todo puede servir de guía, escrituras repletas de nombres divinos. Las palabras y los capítulos... se entrelazan... ¡y los ángeles actúan alineados! Que las palabras forjen un camino en este lugar sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050203,
					"content": "¡*Ding*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050204
					],
					"speakerTitle": "Examinar puerta"
				},
				{
