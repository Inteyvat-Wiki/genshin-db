					"content": "¿Ven? ¡Hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050205,
					"content": "Todo puede servir de guía, escrituras repletas de nombres divinos.",
					"roleType": "TALK_ROLE_NONE",
