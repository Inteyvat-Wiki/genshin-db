			"dialogs": [
				{
					"id": 762050301,
					"content": "¡El tesoro! ¡Yujuuu, esto es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Aunque... a Paimon todavía le palpita la cabeza. ¿De verdad tenías que gritar tan alto para que apareciera la plataforma, Nicole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "¿Y esto? ¿Ya estamos quejándonos? ¿No te preocupa que una poderosa bruja como yo chasquee los dedos y convierta tu tesoro en zanahorias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "P-Paimon no sabe lo que dice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Jeje, estoy de broma. No soy el tipo de ángel silencioso que tomaría nota de cada pequeña trivialidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#Y así llegó el día en que {NICKNAME} y Paimon subieron los siete escalones, donde l{F#a}{M#o}s esperaba una figura familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "Llamas radiantes convergieron a su espalda para formar unas alas. Su silueta desprendía la misma nobleza y hermosura que el primer día en que se conocieron, pero sus ojos brillaron con cierta crueldad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#“¿Por qué”, preguntaron al mismo tiempo {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "“Todo comenzó el día en que Paimon se quejó de lo alto que había gritado...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050311,
					"content": "¡Eh, que aquí las palabras son mágicas! ¡No digas cosas así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050305,
					"content": "No te lo tomes a pecho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
		},
