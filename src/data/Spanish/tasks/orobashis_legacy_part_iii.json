			"dialogs": [
				{
					"id": 721310101,
					"content": "La extraña linterna de piedra parece irradiar una energía perturbadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310102,
					"content": "¿Es una lámpara de piedra? ¿Qué hace aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Oh, hay algo escrito en la lámpara. Veamos qué pone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "“Trabajador, si tienes alguna pregunta sobre este altar, dirígete a la Garganta Musoujin y habla con el Sr. Kaji.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310105,
					"content": "La escritura parece reciente. Hay algunas palabras escritas toscamente más abajo:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310106,
					"content": "“Lamentamos no poder ayudar en nada. Ayer recién recibimos la orden de evacuación de la Comisión Tenryou.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310107,
					"content": "“Espero que podamos volver a encontrarnos algún día y debatir sobre la resolución de los problemas causados por los tatarigami.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310108,
					"content": "Este Sr. Kaji parece preocuparse mucho por la linterna de piedra, ¿por qué no vamos a la Garganta Musoujin a preguntarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
