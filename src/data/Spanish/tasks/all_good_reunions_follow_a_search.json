			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cacucu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "Volvemos a vernos, colega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "En realidad, lo que quería decir es que aquella no fue la primera vez que conocí a Ifá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Pero me he contenido. Al fin y al cabo, soy un saurio muy maduro. Hay que saber decir las cosas según la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
	]
}