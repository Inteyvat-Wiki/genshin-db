			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ifá",
					"Ororon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475001,
					"content": "¿Qué tal? ¿Te lo has pasado bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752475002,
					"content": "¡Por Los Siete, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "Parece muy contento. Feliz cumpleaños, colega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "Pero, hablando de eso... ¿Por qué no me hablaste del plan antes? ¿Acaso no soy tu colega?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Jeje... Si te soy sincero, quería ver si te acordabas del aniversario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752475006,
					"content": "... Has cambiado, Ifá. Te has vuelto malvado. A partir de ahora, tendré que tener cuidado contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "Menos mal que me acordé y le dejé un poco de miel fresca a Cacucu. Si no, me daría picotazos en la cabeza durante todo un año.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "¡No, colega! ¡Eres el mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7524704",
							"3"
