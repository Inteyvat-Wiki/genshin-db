						],
						"pointId": 11895
					}
				]
			},
			"dialogs": [
				{
					"id": 752470401,
					"content": "¡Aquí está! ¡Es cierto que estaba en el Mercado Brisapacible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470402
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470402,
					"content": "¡¡Mercado Brisapacible!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470403
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470403,
					"content": "Tranquilo, colega. Sé que estás la mar de contento, pero debemos entender cuál es la situación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470404
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470404,
					"content": "*Ejem*... Deténganse un momento, estimados clientes. ¡Elijan un huevo cualquiera! ¡Veamos si es su día de suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470405
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470405,
					"content": "Pueden probar totalmente gratis. ¿Qué les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470406
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470406,
					"content": "Así que la imagen nos estaba guiando hasta el lugar de origen de los huevos de regalo relucientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470407,
					"content": "Jeje, veamos si la buena suerte nos sigue acompañando. ¡Probemos a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470408,
					"content": "¡N-ni lo duden! Los huevos de regalo ya están listos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470409
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470409,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470410
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470410,
					"content": "Tú primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470411
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470411,
					"content": "¿En serio, colega? No creerás realmente eso de que la mala suerte se la lleva el primero, ¿no? Bueno, está bien. Lo haré yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470412
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470412,
					"content": "¡Concédanme su bendición, Ashas! ¡Que la suerte esté conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470413
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470413,
					"content": "¡Guau! ¡Son sauriogalletas deliciosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470414,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470415
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470415,
					"content": "¡*Pfft*!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470416
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470416,
					"content": "¿No te gustan las sauriogalletas, Ifá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470417,
					"content": "Las sauriogalletas están muy ricas, y a los dos nos encantan, pero como premio de un huevo de regalo reluciente, son bastante comunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470418
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470418,
					"content": "Da igual. Si están ricas, eso es lo que importa. Vamos, compartámoslas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470419
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470419,
					"content": "Y no te burles de mí. Si no tienes cuidado, puede que te toque un huevo volcánico de esos tan raros. ¡Si eso pasa, no pienso ayudarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470420
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470420,
					"content": "Eso es imposible, no podrías resistirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470421
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470421,
					"content": "Humm... ¿Se debe hacer algún tipo de ritual especial antes de abrir un huevo de regalo reluciente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470422,
					"content": "Usa el método que creas que te traerá buena suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470423
					]
				},
				{
					"id": 752470423,
					"content": "Ya sé. “Equipo de patrulla de la Tribu Plumaflora... ¡Abran la puerta!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470424
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470424,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470425
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470425,
					"content": "Guau, es la especialidad “canto a pleno pulmón” de la Tribu Plumaflora... ¡Parece que su ritual ha funcionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470426,
					"content": "¡Qué buena suerte! En realidad, mientras no fuera un brebaje fantástico, me consideraría afortunado. Ya estoy harto de esa bebida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470427
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470427,
					"content": "¡Esto es un montón de caramelos! Tomen todos uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470428
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470428,
					"content": "¡Eres el mejor, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470429,
						752470431
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470429,
					"content": "Después de comerse las galletas, Cacucu mastica ruidosamente los caramelos.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470430
					]
				},
				{
					"id": 752470430,
					"content": "Es un poco más dulce de lo esperado, y a todos les da un subidón de azúcar...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470431,
					"content": "¡Le toca a Paimon, le toca a Paimon! A ver qué dice... ¡Ah, Paimon ya lo tiene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470432,
					"content": "*Ejem*... “¡Paimon quiere el mejor premio, sea como sea!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470433,
					"content": "Eh... ¡Oh! Es el brebaje fantástico que tan poco quería Ororon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470434,
					"content": "¡Genial, Paimon! ¡Todo tuyo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470435
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470435,
					"content": "Sí, ¿verdad? Jeje, entonces Paimon no se corta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470436,
					"content": "¡Qué dulce y qué fresco! ¡Es la bebida perfecta para la temporada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470437,
					"content": "Bien, y ahora... ¿Cuál de los dos va primero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470438
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470438,
					"content": "¡Sin prisa, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470439,
						752470440
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470439,
					"content": "Iré yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				},
				{
					"id": 752470441,
					"content": "¡Vamos! ¡Piensa en una frase que te dé buena suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470442,
					"content": "(Una frase que dé buena suerte...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470443
					]
				},
				{
					"id": 752470443,
					"content": "*Inspira profundamente*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470444
					]
				},
				{
					"id": 752470444,
					"content": "¡Brigada de Benny, en marcha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470445
					]
				},
				{
					"id": 752470445,
					"content": "Gemas resplandecientes... ¡Vaya, otra cosa dulce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470446,
					"content": "Jeje, esto hace que recuerde el día en que acepté a mi discípula...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470447
					]
				},
				{
					"id": 752470447,
					"content": "#Parece que {F#la}{M#el} abuel{F#a}{M#o} se ha sumergido por completo en recuerdos hermosos... Fue buena suerte, entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470448
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470448,
					"content": "Está bien, Cacucu, te toca. ¡Demuéstranos tu verdadero poder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470449
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470449,
					"content": "¡No puedes perder, colega! O al menos, no saques nada peor que Ifá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470450
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470450,
					"content": "¿Qué estás diciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470451
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470451,
					"content": "¡Ya voy, colegas! “¡Mucho gusto, colega!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470452
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470452,
					"content": "Guau... ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470453,
					"content": "¡Pum, pum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470454
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470454,
					"content": "¡Oh, vaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470455
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470455,
					"content": "*Ejem*... ¡Tenemos un ganador! ¡Felicidades, Sr. Cacucu, usted es el tercero en obtener el gran premio hoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470456
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470456,
					"content": "Además de estos bollitos de Asha tan exclusivos, ¡también le ofrecemos al Sr. Cacucu una unidad de cada tipo de los premios obtenibles en los huevos de regalo relucientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "¡Qué estás diciendo, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "¡Eso! ¡Qué estás diciendo, colega! ¿Acaso Cacucu es el más afortunado de entre todos nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Jaja. Felicidades, colega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470460,
					"content": "Cacucu, colega... Quiero decir, señor, tengo una petición para usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "Dicen que si le estrechas la mano a alguien, puedes contagiarte de su buena suerte. ¿Podríamos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "¡Jaja! ¡No hay problema, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470463,
					"content": "Siguiendo la iniciativa de Ororon, todos le estrechan el ala a Cacucu uno a uno.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470464
					]
				},
				{
					"id": 752470464,
					"content": "Como es tan suave al tacto, lo que había empezado así acaba convirtiéndose en que todos le acaricien la cabeza.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "Es redondito y suavecito, digno de su reputación. Te pierdes en esa sensación tan agradable.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "¡Vaya, Paimon le ha acariciado un buen rato! Debería de tener buena suerte durante todo lo que queda de año...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "#Seguro que sí. Paimon también tiene un{F#a} compañer{F#a}{M#o} increíble, como Cacucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "¿P-por qué me miran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470469,
					"content": "Bueno, todo ha salido como tenías previsto, ¿no? Es hora de que les cuentes la verdad a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470471,
					"content": "¿Eh? ¿Qué quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "¿Acaso la buena suerte de Cacucu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Está bien, está bien, no importa. Es cierto, Cacucu tiene suerte de contar con un colega como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470475,
					"content": "Deja de evitar la pregunta y cuéntanos la verdad. Lo tenías todo planeado desde que empezamos a pescar, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470477,
					"content": "¿Ya conocías a ese aventurero de Mondstadt antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "No, tan solo lo conocí un día antes que tú. Le pedí que me indicara el camino correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470479,
					"content": "Y, sí, preparé todo con antelación: las imágenes del acuibara y el Asha, los juegos con Cacucu por el camino y los huevos de regalo relucientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470480,
					"content": "Por Los Siete, colega...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Jaja... Aunque está claro que es imposible que un animal te comprenda del todo, por lo que el Rey Acuibara malinterpretó mis palabras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470482,
					"content": "Supongo que pensó que había traído a otras personas a robar lo que había preparado para Cacucu, y por eso se puso de mal humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470483,
					"content": "Entonces sí que se llama “Rey Acuibara”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Claro que no, tan solo estaba siguiéndote el rollo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470485,
					"content": "Por Los Siete, colega, eso es muy conmovedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "... ¡Bueno, ya lo saben! La cosa es que justo iba a ser el aniversario de cuando conocimos a Cacucu, así que quería prepararle un pequeño regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470487,
					"content": "Como no sabemos exactamente cuándo es el cumpleaños de Cacucu, siempre lo hemos celebrado en esta fecha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "Puede que Cacucu finja ser como un hermano mayor saurio, pero en realidad no es más que un pequeñín al que le encanta jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470489,
					"content": "Un saurín como tú debería actuar como un saurín, y divertirse tanto como quiera, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470490,
					"content": "Colega, colega...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "¿Oh? ¿Quieres decir algo, Cacucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Colega, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "No hace falta que lo digas, yo te entiendo. Te queremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "Exacto. Y que no te dé vergüenza divertirte como cualquier Qucusaurio salvaje durante estos días en el resort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470495,
					"content": "¡Feliz aniversario, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "¡Colegas, colegas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Todo ha sido por...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "Será mejor dejar a Cacucu para el final.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
		{
			"id": 7524750,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
