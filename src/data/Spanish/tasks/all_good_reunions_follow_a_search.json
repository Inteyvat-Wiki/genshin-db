			"dialogs": [
				{
					"id": 752470301,
					"content": "*Uff*... Por fin hemos terminado. La verdad es que cansa muchísimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470303,
					"content": "Tú eres Cacasha, ¿verdad? ¡Cacucu y tú hacen una pareja increíble! ¡Y como parte de una pareja formidable, Paimon sabe de lo que habla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470304,
					"content": "¡Impresionante, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470305,
					"content": "¿Ven? Tenía razón: esos dos juntos son una verdadera amenaza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470306,
					"content": "Cacucu, puedo decir que te has ganado oficialmente tu certificado en el “arte de la ocultación”. A partir de ahora, serás considerado un maestro del subterfugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470307,
					"content": "¡Por Los Siete, colega! ¡Eres el mejor, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470308
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470308,
					"content": "¿Y yo qué? Yo soy quien más ha jugado contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470309
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470309,
					"content": "¡Tú también eres genial, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470310
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470310,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470311
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470311,
					"content": "Humm... Parece que quiere darnos algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470312
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470312,
					"content": "Bajo la atenta mirada de los humanos y el saurio, Cacasha saca un huevo de regalo reluciente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						752470313
					]
				},
				{
					"id": 752470313,
					"content": "¡Oh! ¡Otro huevo de regalo reluciente y una nueva imagen! Creo que ya había visto este símbolo en el Mercado Brisapacible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470314
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470314,
					"content": "Humm... Algo me dice que un nuevo desafío está por presentarse ante nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470315
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470315,
					"content": "¿Una yincana oculta en el resort? ¡Quiero participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470316
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470316,
					"content": "¡Participa, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470317
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470317,
					"content": "Parece que Cacucu se lo está pasando en grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470318,
					"content": "#Bueno, en ese caso, ¡{NICKNAME} y Paimon tampoco podemos faltar! ¿Qué te parece? ¿Vamos a ver de qué va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470319,
					"content": "¡Tenemos que participar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470320
					]
				},
				{
					"id": 752470320,
					"content": "Está bien, hagámoslo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifá"
				}
			]
		},
		{
			"id": 7524704,
			"completionStepIds": [
				7524704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
