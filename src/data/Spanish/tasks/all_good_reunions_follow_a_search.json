			"dialogs": [
				{
					"id": 752470101,
					"content": "Parece que estamos en el lugar de la imagen. ¡Ahí están esos dos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470102,
					"content": "¡Hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470103,
					"content": "A juzgar por su tono de voz, Paimon está contenta. Genial, así no hay nada de lo que preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470104,
					"content": "Bueno, una Paimon enfadada tampoco es mucho de lo que preocuparse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "¡Eh! ¡No subestimen a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470106,
					"content": "Basta con darle algo rico de comer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "¡Hum! Eso ya está mejor... ¡Un momento, Paimon no es como Cacucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470108,
					"content": "Da igual, Paimon hoy está contenta, así que no piensa discutir con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470109,
					"content": "Por cierto, ¿dónde está Cacucu? No se lo habrá comido el Rey Acuibara, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470110,
					"content": "Claro que no. ¿Tú te estás escuchando, colega?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470111,
					"content": "Cacucu se ha aliado con el enemigo para atormentarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470112,
					"content": "Jajaja, que Cacucu los está atormentando a ustedes... Qué bromista eres, Ororon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470113,
					"content": "No estoy de broma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470114,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470115,
					"content": "Entonces, ¿quién es el enemigo?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "Dice que se llama Cacasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470117,
					"content": "¿Quién? ¿En serio? ¿Los Ashas pueden hablar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470118,
					"content": "Un momento, no hagan caso a sus tonterías. Será mejor que yo se lo explique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470119,
					"content": "Cacucu está jugando al escondite con un Asha que ha encontrado aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470120,
					"content": "Para ser más precisos, se ha aliado con Cacasha contra nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470121,
					"content": "Cacucu es muy rápido, y a Cacasha se le da muy bien camuflarse. Son rivales formidables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470122,
					"content": "Ya hemos jugado con esos dos pequeñines muchísimas veces antes de que llegaran ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470123,
					"content": "Es cierto que Cacucu es increíble, pero lo que era orgullo en un inicio se ha convertido en cansancio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470124,
					"content": "Eso es culpa tuya por no haberte apuntado a las clases de ejercicio de Iansán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470125,
					"content": "Ay, con tanto buscar para arriba y para abajo, ¡me está empezando a doler la espalda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470126,
					"content": "Pues claro, por eso tenías que haberte apuntado a la clase de ejercicio de Iansán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470127,
					"content": "... Que sí, que sí. Iré en cuanto terminemos con nuestro trabajo aquí. ¿Contento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470128,
					"content": "¡Dejen de discutir! ¡Lo importante es saber quién se encargará de atrapar a Cacucu y Cacasha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470129,
					"content": "¡Oh! Bueno, creo que ha aparecido el limón perfecto ante nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470130,
					"content": "¿Otra vez me toca a mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "Sip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470132,
					"content": "Está bien, ya voy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#¡Seguro que lo consigues, abuel{F#a}{M#o}! ¡Y la abuela Paimon también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470134,
					"content": "Tampoco te agobies. Si necesitas ayuda, llámanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470135,
					"content": "Eh, yo pensaba que haríamos de Ashas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470136,
					"content": "¿Hacer de Ashas?... ¿Te refieres a que van a esconderse y hacer que vayamos a buscarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470137,
					"content": "¡Sí! A partir de ahora, yo soy Orasha, y él es Ifasha. ¡Vamos, ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470138,
					"content": "Pero ¿qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470139,
					"content": "Lo siento, pero parece que tendré que seguirle el rollo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470140,
					"content": "No pasa nada, es divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "#¡Gracias a l{F#a}{M#o}s dos! ¡Supongo que entonces debería ir a esconderme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752470141,
					"content": "No te preocupes, tengo energía de sobra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
