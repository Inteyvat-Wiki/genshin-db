						"stepId": 7268903,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268901",
							"2"
						],
						"stepId": 7268901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "En los próximos días, estaré aquí para orientar a los visitantes del Festival Irodori y para que experimenten las maravillas de los arreglos florales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870202,
					"content": "¡No se olviden de revelar un acertijo floral cada día! En total, habrá cuatro acertijos esperándoles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870203,
					"content": "#Huelga decir que, si tienen cualquier pregunta, haré todo lo posible por ayudarl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870204,
					"content": "¿Qué puedes contarme sobre tus flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "Las flores que uso son todas de la Floristería Sakuya. Son de gran calidad y tienen un precio muy asequible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870206,
					"content": "No sé si conocen a Sakuya, pero ella y yo aprendimos ikebana del mismo maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870207,
					"content": "Sakuya tiene un gran conocimiento sobre este arte, pero cuando escuchó que el Festival Irodori se inundaba de gente, le entró un poco de pánico escénico y dijo que le costaría mucho trabajo hacer arreglos florales con tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870208,
					"content": "Por eso, la ayudaré a promocionar su floristería en el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870209,
					"content": "#Si quieres, ¡nosotr{F#as}{M#os} también podemos ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870219,
					"content": "¿Tienen alguna duda más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870220,
					"content": "Gracias, Srta. Fushizome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "No es nada. Si tienen tiempo, pueden venir a verme cuando quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870210,
					"content": "¿Cuál es el papel de la Comisión Yashiro en esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "La Comisión Yashiro siempre ha apoyado al sector del ikebana en Inazuma. En este caso, la persona que tuvo la gran amabilidad de proporcionarnos la financiación fue la Princesa Garza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870212,
					"content": "Desde pequeña, siempre mostró su increíble talento con este arte. Una vez, la vi hacer una demostración de ikebana y tuve el honor de charlar con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870213,
					"content": "Aunque soy mayor que ella, mis conocimientos sobre el ikebana y los arreglos florales no son nada comparados con los suyos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870214,
					"content": "Siempre que la situación lo permite, la Princesa Garza nos ofrece financiación para promover el arte del ikebana. Incluso escuché que a veces invierte todos sus ahorros en esta causa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870215,
					"content": "Una vez, expresó muy claramente su deseo: que más gente conociera y se interesara por el ikebana para comenzar a estudiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870216,
					"content": "Guau, parece que Ayaka ha hecho mucho por el arte de las flores de Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870217,
					"content": "Ojalá que su deseo se haga realidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "Muchas gracias también a ustedes dos por su apoyo y comprensión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870222,
					"content": "No tengo más preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Pueden venir a verme cuando quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		}
	]
}