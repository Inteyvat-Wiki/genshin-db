				"points": []
			},
			"dialogs": [
				{
					"id": 726890101,
					"content": "Vaya, llegan justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890102,
					"content": "Con solo dos veces que practicaron, ya han avanzado a pasos de gigante en su entendimiento del ikebana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890103,
					"content": "Por eso mismo, el acertijo floral de hoy será un tanto diferente, para que vayan un nivel más allá en su pensamiento creativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890104,
					"content": "#Estamos preparad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890105
					]
				},
				{
					"id": 726890105,
					"content": "Oh... Paimon se está poniendo nerviosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726890106,
					"content": "Jeje, no hay de qué preocuparse. Relájense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890107,
					"content": "#Visto lo talentos{F#as}{M#os} que son, si reflexionan sobre el acertijo floral, la escena correspondiente se revelará en sus mentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890108,
						726890111
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890108,
					"content": "En realidad todavía tenemos mucho que aprender, pero adelante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890109
					]
				},
				{
					"id": 726890109,
					"content": "Bien, el acertijo floral de hoy es: “Hojas en reposo esmeralda, flores del viento celeste”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890110,
					"content": "¿Qué solución proponen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890111,
					"content": "Tengo cosas que hacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890112
					]
				},
				{
					"id": 726890112,
					"content": "No hay problema, el ikebana precisa tener la mente serena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890113
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890113,
					"content": "Esperaré a que se ocupen de sus asuntos primordiales y se liberen de sus problemas. Así, podrán elaborar sus arreglos florales con más eficacia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268903",
							"2"
