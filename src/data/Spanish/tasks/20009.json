			"dialogs": [
				{
					"id": 200090701,
					"content": "¿Qué opinas? Mi hilichurlio no está tan mal, ¿eh? Ahora que podemos comunicarnos, solo es cuestión de tiempo para podernos entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090702
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090702,
					"content": "Al menos eso espero... Mi sueño es ser amiga de los Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090703
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090703,
					"content": "¡Cierto! Antes de que lo olvide, toma. Es un regalo de ese Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090704
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090704,
					"content": "¡Un regalo de un Hilichurl! ¡Apuesto a que nunca pensaste que llegaría ese día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090705
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090705,
					"content": "Bueno, mejor me voy, tengo tantos hallazgos nuevos que anotar. Quizás tengamos la oportunidad de encontrarnos de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
