			"dialogs": [
				{
					"id": 200090201,
					"content": "Afortunadamente hay uno despierto en este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090202,
					"content": "Vamos a saludar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090203,
					"content": "Pero ten cuidado, sería grosero de nuestra parte despertar a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090204,
					"content": "No queremos que piensen que estamos asaltando su campamento para atacarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090205,
					"content": "Entonces no habrá forma de que nos hablen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
