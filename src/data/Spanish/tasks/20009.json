					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200090101,
					"content": "#¡Viajer{F#a}{M#o}! ¡Por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090102,
					"content": "No asustes a esos Hilichurls. ¿Por qué siempre corres directo a los campamentos de Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090103,
					"content": "Olvídalo, no es importante. He estado estudiando hilichurlio durante un tiempo, pero preferiría ponerlo en práctica en lugar de estudiarlo en libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090104,
					"content": "Al fin me topé con todo un campamento de Hilichurls... ¡No puedo dejar pasar esta oportunidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090105,
					"content": "#Entonces, viajer{F#a}{M#o}, ¿puedes ir conmigo al campamento y ayudarme a encontrar un Hilichurl para practicar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2000902,
