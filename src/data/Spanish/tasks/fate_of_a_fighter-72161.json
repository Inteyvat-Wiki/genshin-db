			"dialogs": [
				{
					"id": 721611401,
					"content": "¡¿Tú otra vez?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611402,
					"content": "¿No te dije...? No importa. Haz lo que quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611403,
					"content": "#No desordenes mis cosas. Todavía hay suficientes suministros a bordo para compartirte un poco. Cuando estés satisfech{F#a}{M#o}, vete rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611404,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "No. ¿No ves que la estoy pasando bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611406,
					"content": "Pero tu herida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "Esa es mi herida, no tuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611408,
					"content": "¡Oye, te lo ofrecemos de buena voluntad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611409,
					"content": "Entonces yo también les responderé de buena voluntad: déjenme en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611410,
					"content": "Yo te puedo ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "¿Cómo? ¿Entregándome al shogunato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611412,
					"content": "#Jaja, ¿cómo podrías ayudarme entregándome al shogunato? Te aconsejo que no seas tont{F#a}{M#o}... me tratarán de desertor. El Sr. Kujou nunca tiene piedad con los desertores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611413,
					"content": "Si realmente quieres ayudarme, déjame en paz.",
