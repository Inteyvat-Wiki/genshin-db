				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "Triturar las hierbas hasta convertirlas en una pasta va a tomar mucho tiempo. Ya puedes irte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610506,
					"content": "... No, no te estoy echando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610507,
					"content": "Vuelve luego. Tener a alguien con quien hablar... No es tan malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610508,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				},
				{
					"id": 721610510,
					"content": "#Cuídate, foraster{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610509,
					"content": "Mejórate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				}
			]
		},
		{
			"id": 7216106,
			"completionStepIds": [
				7216107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
