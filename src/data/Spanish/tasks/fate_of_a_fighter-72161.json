			"dialogs": [
				{
					"id": 721610701,
					"content": "Las ratas comienzan a inquietarse nuevamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610702
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610702,
					"content": "#Foraster{F#a}{M#o}, ten cuidado con los piratas de los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610703
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610703,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610704
					]
				},
				{
					"id": 721610704,
					"content": "No hay de qué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610705
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610705,
					"content": "No son rivales para mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "#Jaja, qué modest{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "¡Acaba con todos antes de hablar así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610708,
					"content": "Es un trato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
				},
				{
					"id": 721610709,
					"content": "Bueno, trato hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				}
			]
		},
