				},
				{
					"id": 721611321,
					"content": "#Sal antes de que te sientas abrumad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611322,
					"content": "Humm... Paimon no entiende nada... Qué raro.",
