					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391405,
					"content": "Según el plan original, el barco de Drake tendría que pasar por aquí en algún momento. Cuando llegue, nos iremos con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391406
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391406,
					"content": "#Mientras tanto, viajer{F#a}{M#o}, ¿podríais regresar a la Cámara de Jade y llevarle a Ninguang un mensaje de mi parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391407
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391407,
					"content": "Decidle que casi hemos terminado de recuperar las cosas y que empiece a preparar mi recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391408
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391408,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400391409
					]
				},
				{
					"id": 400391409,
					"content": "Os lo agradezco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391410
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391410,
					"content": "Si tanto Carmelo como Liuliu rondaban por aquí... Me pregunto si estará también la “jefa” de los Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391411
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391411,
					"content": "Tengo que decirles a Drake y los demás que se mantengan alerta...",
					"roleType": "TALK_ROLE_NPC",
