					"nextDialogs": [
						400391203
					]
				},
				{
					"id": 400391203,
					"content": "Pones a Ninguang al corriente de lo sucedido...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400391204
					]
				},
				{
					"id": 400391204,
					"content": "Así que los Ladrones de Tesoros... Ya veo, debe haber sido bastante problemático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391205
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 400391205,
					"content": "Parece que esta vez los ahuyentaron, pero dudo que esto se acabe así como así. No son precisamente del tipo de persona que perdona y olvida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391206
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 400391206,
					"content": "Pero ya no tienen que preocuparse por ellos. Beidou se encargará, tiene mucha experiencia con los Ladrones de Tesoros. Prepararé una buena recompensa para ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391207
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 400391207,
					"content": "Agradezco que hayan venido hasta aquí para entregar el mensaje de Beidou. Acepten esto como compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391208
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 400391208,
					"content": "Ahora, si me disculpan, tengo que atender otros asuntos. Espero que se diviertan en el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				}
