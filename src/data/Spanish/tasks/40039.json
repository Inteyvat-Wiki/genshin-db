				"points": []
			},
			"dialogs": [
				{
					"id": 400391101,
					"content": "¡Vamos, tenemos que acabar ya! ¡Tomen todo lo que sea de valor y dejen lo demás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391102
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391102,
					"content": "¡Necesito que algunos de ustedes vayan y carguen el barco! ¡Vamos, muévanse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391103
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391103,
					"content": "Sea lo que sea que vayáis a hacer, ni lo intentéis. Y esos objetos son para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391104,
					"content": "¿Beidou? ¿Qué hace usted aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391105
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391105,
					"content": "Lo mismo podría preguntaros yo a vos, Liuliu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391106,
					"content": "Pues es lo que parece... Tuvimos suerte y nos encontramos unos tesoros flotando en el océano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391107
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391107,
					"content": "Si ve algo que le guste, puede quedárselo. ¡Una muestra de nuestro aprecio por la poderosa Capitana Beidou, jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391108
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391108,
					"content": "¿De veras? Bien, me lo quedaré todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391109,
					"content": "Eh... pero... sea razonable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391110
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391110,
					"content": "Los chicos y yo nos hemos deslomado para recoger todo esto... Tiene que dejar algo para nosotros, ¿no cree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391111
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391111,
					"content": "Os lo diré tan claro como el agua: estas cosas no os pertenecen, ni serán vuestras nunca. Así que soltadlas y alejaos de mí todo lo que podáis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391112
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391112,
					"content": "Pero eso es un poco... Eh, ¿por qué no empezamos de nuevo? Mire, Beidou, nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391113
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391113,
					"content": "Parece que queréis hacerme perder el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391114
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391114,
					"content": "Las palabras se las lleva el viento. ¡Resolvamos esto a la antigua usanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
			]
		},
