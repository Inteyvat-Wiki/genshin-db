				"points": []
			},
			"dialogs": [
				{
					"id": 400390801,
					"content": "¡Deténganse inmediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "Carmelo"
				},
				{
					"id": 400390802,
					"content": "¿Están ciegos? ¿No ven que es la Capitana Beidou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "Carmelo"
				},
				{
					"id": 400390803,
					"content": "Jeje... Capitana Beidou, ¡cuánto tiempo! Veo que sigue luchando igual de bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "Carmelo"
				},
				{
					"id": 400390804,
					"content": "Ha pasado mucho tiempo, Carmelo. Veo que habéis vuelto a engordar bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390805,
					"content": "Tenéis que tener cuidado si pretendéis emplear con frecuencia la táctica de esconderos tras los arbustos. ¡Pronto no os cubrirán por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390806,
					"content": "Siempre con sus bromas, qué graciosa, Beidou, jajaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "Carmelo"
				},
				{
					"id": 400390807,
					"content": "Bueno, hablando en serio, necesitaré todas estas cosas. Dejadlas en el suelo y no os causaré más problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390808,
					"content": "Por supuesto, lo que ordene. Ya la oyeron, ¡déjenlo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "Carmelo"
				},
				{
					"id": 400390809,
					"content": "Aquí lo tiene. Eh... Ahora nos iremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "Carmelo"
				},
				{
					"id": 400390810,
					"content": "Carmelo se escabulle con los Ladrones de Tesoros...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "Guau, hizo lo que le pedimos sin dudar ni un instante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390812,
					"content": "Tenía mucha prisa por rendirse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "Y por salir corriendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390814,
					"content": "No perdáis el tiempo pensando en ellos. ¡Tenemos que seguir recuperando esas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390815,
					"content": "#Oh, pero primero tenemos que cargar esto... Venga, viajer{F#a}{M#o}, ayudadme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
			]
		},
		{
			"id": 4003911,
			"completionStepIds": [
				4003911
			],
