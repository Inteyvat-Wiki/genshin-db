			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "Lo sabía. Contigo tampoco funcionó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750102,
					"content": "¿“Lo sabías”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750103,
					"content": "#Solo quería ver qué tan influyente era {NICKNAME}, {F#la}{M#el} nuev{F#a}{M#o} recluta de los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750104,
					"content": "Ya sabes, los mejores caballeros siempre han de presentarse con la mejor espada. Pero henos aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750105,
					"content": "¿No es acaso algo digno de ser cantado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750106,
					"content": "#¿Qué quieres decir? ¿Que no somos lo suficientemente buen{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750107,
					"content": "#No, no me entendiste bien. Quiero decir que es una pena que nadie en Mondstadt sea capaz de apreciar la valía de {F#una caballera}{M#un caballero} como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750108,
					"content": "Pues bien. Si por las buenas no podemos obtener la Lira Sagrada, tendrá que ser por las malas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750110,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "Todas las ideas son bienvenidas. ¿Alguna sugerencia de cómo robarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750112,
					"content": "¡No quiero robar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "Hablen. Que no les dé vergüenza. Son libres de decir lo que piensen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750113,
					"content": "¡Jaja! Mírate, desviando el tema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750114,
					"content": "#A decir verdad, eres más apt{F#a}{M#o} para esta tarea que yo,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750115,
					"content": "que no tengo otro talento más que el de cantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750116,
					"content": "Si me arrestaran, no tendría a nadie de confianza que pudiera defenderme ante semejante injusticia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750117,
					"content": "¿Cómo va a ser injusto si te atrapan con las manos en la masa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750118,
					"content": "#Pero es diferente en el caso de {NICKNAME}. Has hecho grandes contribuciones para Mondstadt, eres la estrella en ascenso de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750119,
					"content": "Aunque te arrestaran, podrías salirte con la tuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750140,
					"content": "Al parecer, los guardias de por aquí están fuera de servicio por la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750141,
					"content": "Pero si te atrapan, será difícil salirte con la tuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750120,
					"content": "¡Deja de decir que nos van a arrestar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750122,
					"content": "Acabas de decir que eres Barbatos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME}, dime, ¿qué piensas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750123,
					"content": "Así es, creo que lo mencioné...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750125,
					"content": "Si de verdad eres un dios, no podemos abandonarte así sin más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "¿Por qué me lo preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750126,
					"content": "Oh, ¿y eso por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750128,
					"content": "Y, aunque no seas un dios, pienso rescatar a Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#Paimon te pondrá al corriente del pasado de {NICKNAME} cuando tengamos más tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750130,
					"content": "Te traeré a Der Himmel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "No quiero ver otra separación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "Venti"
				}
			]
		},
