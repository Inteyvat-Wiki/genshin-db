			"dialogs": [
				{
					"id": 3750202,
					"content": "Esto apesta... Tener que estar parado vigilando la entrada todo el <color=#00E1FFFF>día</color>...\\n¡Oye, tú! ¡Alto! ¡No puedes entrar ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750203
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3750203,
					"content": "Parece que tendremos que esperar a que sea de <color=#00E1FFFF>noche</color> para colarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
