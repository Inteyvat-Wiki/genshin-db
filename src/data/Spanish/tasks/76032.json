			"dialogs": [
				{
					"id": 760320201,
					"content": "Eh, tú, ¿sabes lo que le pasa a los intrusos que entran en zonas restringidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Opríchnik Fatui"
				},
				{
					"id": 760320202,
					"content": "... ¡Parece que voy a descubrirlo pronto! Todo esto es nuevo para mí, no tengo experiencia en esto... ¿Por qué no me das otra oportunidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Persona sospechosa"
				},
				{
					"id": 760320203,
					"content": "¡Dame otra oportunidad, te aseguro que la próxima vez no me atraparás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Persona sospechosa"
				},
				{
					"id": 760320204,
					"content": "Estarás de broma. Son <color=#00E1FFFF>ratas ávidas de tesoros</color>, ¡y no vamos a permitir que escape ni una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Opríchnik Fatui"
				},
				{
					"id": 760320205,
					"content": "¡Eh! Puede que esa mocosa ya se lo haya llevado todo... ¡y tú mientras discutiendo aquí conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Persona sospechosa"
				},
				{
					"id": 760320206,
					"content": "No te preocupes por lo que le pase a ella. ¡Tú vas a venir con nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Opríchnik Fatui"
				}
			]
		}
	]
