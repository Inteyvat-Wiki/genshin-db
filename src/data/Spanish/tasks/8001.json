			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "Nos encontramos de nuevo... Un poco antes de lo que esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010102,
					"content": "¡Oh, es Dain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010103,
					"content": "A juzgar por sus semblantes, deben haber experimentado algo bastante extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010104,
					"content": "¿Se encontraron con el Emisario del Abismo en aquellas ruinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010105,
					"content": "¿Eh? ¡¿Cómo lo supiste?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010106,
					"content": "Todavía sigo el rastro del Emisario del Abismo. No esperaba encontrarme con ustedes aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010107,
					"content": "En realidad, el Emisario no fue lo único que encontramos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "¿Una Estatua de Los Siete invertida... sosteniendo energía abismal? Nunca he visto algo así en todo el tiempo que llevo combatiendo al Abismo. Pero... tenía mis sospechas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010110,
					"content": "Terminen de contarme lo que pasó ahí dentro. Entonces, escaparon de las ruinas llenas de energía abismal, ¿y luego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010111,
					"content": "Luego, cuando nos acercábamos a la salida, de repente apareció el Emisario del Abismo y nos bloqueó el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010112,
					"content": "Tuvimos una ardua batalla contra él. Ahora no debería estar muy lejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010113,
					"content": "Una rara oportunidad, ciertamente. Síganme, vamos a alcanzarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010114,
					"content": "¡De acuerdo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "¡Vamos! Es una oportunidad única. Con la ayuda de Dain, ¡esta vez quizás podamos resolver muchos misterios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010115,
					"content": "Espera, pensaba que era yo quien te hizo un encargo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "En las ruinas hay algo incluso más extraño que el Emisario del Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800103",
							"2"
						],
						"stepId": 800103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "Esos Magos del Abismo... ¿estaban tratando de emboscarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010202,
					"content": "No, solo estaban buscando algo de valor entre los restos de esos Guardianes de las Ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010203,
					"content": "#¿Ah, sí? {NICKNAME} también suele hacer eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010204,
					"content": "Busca dispositivos del caos, circuitos del caos, cosas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010205,
					"content": "¡Claro, son materiales muy importantes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "No debe ser algo tan simple como eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010208,
					"content": "Yo estaba investigando en esta área justamente porque, de vez en cuando, salen Magos del Abismo de esas ruinas a explorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010209,
					"content": "Parece que están buscando algún objeto valioso entre los restos de los Guardianes de las Ruinas para llevárselo de vuelta a esas ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010210,
					"content": "Sin embargo, parecen decepcionados. No deben haberlo encontrado todavía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010211,
					"content": "Entonces, ¿por qué no capturaste a uno para interrogarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010212,
					"content": "Igual que hace el Sr. Diluc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "Por supuesto que no tengo la intención de mostrarle piedad a esos monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010215,
					"content": "Pero presiento que este asunto guarda una importancia crucial para toda la Orden del Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010216,
					"content": "La verdad no se podrá obtener a través de un interrogatorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010217,
					"content": "O, mejor dicho, hay algo a lo que estos Magos del Abismo le temen más que a un doloroso interrogatorio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010218,
					"content": "¿Algo que ellos temen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "Ay... ¡Pensar en esto le pone a Paimon la piel de gallina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010221,
					"content": "Bien, no perdamos más tiempo aquí. Sigamos con nuestra búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010219,
					"content": "¿Algo relacionado con lo que vimos en las ruinas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "Deberías ser más duro con ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "Seguro que los Magos del Abismo no buscaban eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "Uf... Aparte de la Orden del Abismo, los Guardianes de las Ruinas también están bastante activos por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010302,
					"content": "Parece que siempre hay Guardianes de las Ruinas rondando cerca de los escondites de los Magos del Abismo. ¿Será una coincidencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010303,
					"content": "No existen las coincidencias. Todo es fruto de semillas plantadas largo tiempo atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010304,
					"content": "Igual que cuando apareciste en aquella taberna... El tiempo solo espera a que las semillas germinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010305,
					"content": "Pero yo solo escuché hablar de ti por casualidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "Olvídalo. Solo eran reflexiones innecesarias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010308,
					"content": "La relación entre la Orden del Abismo y los Guardianes de las Ruinas no es en absoluto casual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010309,
					"content": "Es más, son ramas del mismo árbol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010310,
					"content": "¿A qué te refieres con eso de ramas y árbol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010311,
					"content": "Ambos se originaron en Khaenri'ah, un antiguo reino que fue destruido hace quinientos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010312,
					"content": "¿Ah? ¡¿Khaenri'ah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010313,
					"content": "¿En serio? ¿La Orden del Abismo y los Guardianes de las Ruinas son supervivientes de la destrucción de Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010314,
					"content": "Hablando de Khaenri'ah... Ese sí que es un nombre superantiguo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010315,
					"content": "Ah, sí. Como tu guía, Paimon debe explicar esto. Hace mucho tiempo, el reino de Khaenri'ah era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010316,
					"content": "Conozco ese nombre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010318,
					"content": "Porque tengo recuerdos de haber estado ahí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "¿Tienes recuerdos de haber estado en Khaenri'ah? Pero ese reino fue destruido hace quinientos años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010320,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010321,
					"content": "¿Ah, sí? Bueno, todos tenemos nuestros secretos. Tú no has curioseado sobre los míos, así que yo no lo haré con los tuyos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010322,
					"content": "Sin embargo, si quisieras contármelo, te escucharía. Así que... ¿cómo era el Khaenri'ah que recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010323,
					"content": "(Bueno, ya no puedo seguir guardando el secreto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "Así que esa era la historia completa... Paimon creía que lo primero que te encontraste fue esa deidad desconocida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010327,
					"content": "#Ya veo... Así que tu primer recuerdo de cuando llegaste a este mundo es de tu herman{F#o}{M#a} despertándote en ese meteorito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010328,
					"content": "#Parece que tu herman{F#o}{M#a} se despertó antes que tú, pero... ¿cuánto tiempo antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010329,
					"content": "#¿Luego, tu herman{F#o}{M#a} te dijo que la destrucción de Khaenri'ah había llevado a este mundo llamado Teyvat al caos, y que debían marcharse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010330,
					"content": "¿“La destrucción de Khaenri'ah”? ¿Eso dijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010331,
					"content": "Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "Esa destrucción que presenciaron... sucedió hace quinientos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010334,
					"content": "Parece que realmente te despertaste en este mundo por primera vez en esa época.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010335,
					"content": "#Humm... Entonces tu herman{F#o}{M#a} debe conocer este mundo mejor que tú, ya que se despertó primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010336,
					"content": "Y, justo después de eso, se encontraron con la deidad desconocida que les bloqueó el camino para que no escaparan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010337,
					"content": "Oh, Paimon ya conoce muy bien esa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010338,
					"content": "... Entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010339,
					"content": "En ese entonces, cuando despertaste e inmediatamente intentaron dejar este mundo, no sabías nada sobre Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010340,
					"content": "Pero ahora que conoces un poco más sobre Teyvat, puedes darte cuenta de que la guerra que presenciaste hace tantos años debe ser la que acabó con Khaenri'ah, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010341,
					"content": "#Ah, ahora que lo mencionas, estos meses que hemos estado viajando junt{F#as}{M#os}, has estado revisando varios libros antiguos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010342,
					"content": "Antes solo habías visto información imprecisa, pero una vez que llegaste a Mondstadt y a Liyue, recolectaste un montón de libros viejos. Solo que siempre le decías a Paimon que eran “inútiles”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010343,
					"content": "#Ahora Paimon se da cuenta de que buscabas más información sobre Khaenri'ah para encontrar a tu herman{F#o}{M#a}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010344,
					"content": "Es la segunda pista más importante después de buscar a Los Siete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "Claro. Para encontrar a Los Siete solo tienes que viajar por las Siete Naciones, pero ¿cómo encontrar un reino destruido hace quinientos años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010347,
					"content": "Probablemente yo sepa más sobre Khaenri'ah que ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010348,
					"content": "Khaenri'ah era un reino sin dios. No porque su dios muriera o los abandonara, sino porque desde el comienzo no tuvieron ninguno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010349,
					"content": "Simplemente era un formidable reino construido por mortales. Su próspera y gloriosa civilización era el orgullo de la humanidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010350,
					"content": "Un reino... sin dios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010351,
					"content": "Después de eso, ocurrió lo que tú recuerdas. Los dioses arrasaron con todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010352,
					"content": "Te refieres a que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010353,
					"content": "Hace quinientos años, los dioses descendieron para destruir Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010354,
					"content": "El supuesto “orgullo de la humanidad” fue arrancado como una mala hierba del jardín de los dioses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010355,
					"content": "¿Cómo es posible?... Los libros de historia no mencionan nada de eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010356,
					"content": "Qué terrible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "Sí. Seguir hablando del pasado solo va a arruinar nuestro ánimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010359,
					"content": "(La próxima vez que vea a Venti o a Zhongli...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "Continuemos. En el camino puedo contarte más sobre lo que te interese saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010360,
					"content": "(Necesito oír una explicación de lo que hicieron los dioses.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#Qué mundo tan peligroso... Ahora tengo más prisa por encontrar a mi herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "Sí, aunque la única pista sea el nombre de un lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "Eso es lo que le oí decir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(Dain y Khaenri'ah... Asumiré el riesgo.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "(La persona que me despertó...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "(... y el mar de fuego que vi en cuanto abrí los ojos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "No entiendo muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
							"2"
						],
						"stepId": 800107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "Oh, el talismán que dejó caer este Mago del Abismo es... ¿una especie de mensaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010402,
					"content": "Humm, este talismán parece estar relacionado con el Emisario del Abismo. ¿Pero por qué lo llevaba un Mago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010403,
					"content": "Tal vez realmente contenga información sobre su operación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010404,
					"content": "Pero Paimon no entiende nada. ¿Es la escritura de Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010405,
					"content": "#“Convierte la fe del enemigo en leña para el fuego y trae gloria a su alteza {F#el Príncipe}{M#la Princesa}...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010406,
					"content": "¡¿Eh?! ¿Eso dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010407,
					"content": "“... ‘Telar del Destino’, primera operación”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010408,
					"content": "Parece ser que el Abismo está llevando a cabo una operación importante. Su nombre clave es... “Telar del Destino”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010409,
					"content": "Por ahora, parece que están en una fase inicial o llevando a cabo las pruebas preliminares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010410,
					"content": "¿“Telar del Destino”? ¿Qué es eso? ¿Será literalmente sobre una máquina para hilar el destino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010411,
					"content": "El Mago del Abismo salió de esas ruinas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "Por la espeluznante sensación que Paimon está sintiendo, la probabilidad de que esas extrañas ruinas estén relacionadas con la operación es muy alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010414,
					"content": "Bueno, Dain, ¿qué dice el mensaje del talismán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010415,
					"content": "Lo estoy leyendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010416,
					"content": "Humm... Una operación ambiciosa, pero hay algunas partes difíciles de entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010417,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010418,
					"content": "Para resumir, la primera fase de la operación está relacionada con Osial, el Señor del Vórtice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010419,
					"content": "¡¿El Señor del Vórtice?! ¡¿Ese dios de las profundidades del mar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010420,
					"content": "No logramos acabar con él la última vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "Bueno, ¿pero qué es lo que quieren con Osial? Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010423,
					"content": "¿Quizás lo mismo que con Dvalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "Estoy al corriente de tus hazañas y, de igual forma, conozco la participación de la Orden del Abismo en el ataque de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010425,
					"content": "Aunque no haya sido intencionalmente, impediste una operación de la Orden del Abismo muy parecida a esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010426,
					"content": "¿La última vez fue el viejo amigo de un Arconte y ahora es un dios antiguo? Cada vez apuntan más alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010427,
					"content": "¿Esta vez quieren corromper a Osial con mentiras y hechizos, tal como hicieron con Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010428,
					"content": "No... Según el mensaje, esta operación va a llegar más lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010429,
					"content": "No solo van a influenciar la voluntad de Osial. Están planeando utilizar la tecnología de los Labradores para modificar el cuerpo de Osial por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010430,
					"content": "¿A-acaso eso es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010431,
					"content": "Entonces, ¡¿la Orden del Abismo quiere fabricar algo así como un... cibercalamar divino de destrucción masiva?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010432,
					"content": "Algo así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "Hoy en día, muy pocas personas entienden realmente a la civilización de Khaenri'ah. Aunque, ciertamente, es difícil juzgar la precisión de ese entendimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010435,
					"content": "Solo la Orden del Abismo persiste en su búsqueda de los restos de Khaenri'ah. Aunque ya no tienen ninguna conexión con la humanidad, mantienen su obsesión por esta civilización.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010436,
					"content": "El mensaje dice que van a usar “la estatua profanada” como base para adherirle las extremidades de Osial, y así crear un dios mecánico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010437,
					"content": "Y que el nuevo núcleo que reemplazará al orbe que suelen sostener las Estatuas de Los Siete es... el ojo del primer Labrador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010438,
					"content": "¿“El ojo del primer Labrador”?... ¡Oh! Paimon ahora entiende. Lo que están buscando todos esos Magos del Abismo es ese ojo, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010439,
					"content": "Eso parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010440,
					"content": "Todavía no lo han encontrado. Aún tenemos tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "Esto se está complicando cada vez más. Pero, básicamente, todo está relacionado con esa Estatua de Los Siete, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010443,
					"content": "Sí. Según el mensaje, el ojo debe colocarse en las manos de la “estatua profanada”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010444,
					"content": "De ese modo, imbuirán al dios recién nacido con el poder para “derrumbar los tronos divinos de Celestia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010445,
					"content": "(Celestia...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "Oh, no... La Orden del Abismo no está escatimando esfuerzos en este plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010448,
					"content": "Humm... Ya que por ahora nadie sabe dónde se encuentra el primer Labrador, ¿no sería mejor tomar la información que tenemos sobre la estatua como punto de partida de nuestra investigación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010449,
					"content": "Esa estatua... parecía la del Arconte Anemo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "Ese bardo de pacotilla es muy difícil de encontrar. Mejor vamos a la <color=#00E1FFFF>Catedral</color> a preguntar primero, quizás nos enteremos de algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010452,
					"content": "La Catedral... Humm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010453,
					"content": "¿Eh? ¿Pasa algo, Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010454,
					"content": "No, nada. Vamos y allá veremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010450,
					"content": "¿Y si le preguntamos a la Iglesia de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "(Derrumbar los tronos divinos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "Debemos encontrarlo antes que ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "¡Tus apodos son cada vez más largos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "Solo lo contuvimos con la Cámara de Jade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "¿Estará relacionado con la estatua invertida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "¡Miren! Allá hay más Guardianes de las Ruinas y Magos del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010502,
					"content": "Dain, nos contabas que estas máquinas antiguas también provienen de Khaenri'ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010503,
					"content": "¿Khaenri'ah tenía muchas ruinas que proteger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010504,
					"content": "No. “Guardianes de las Ruinas” es el nombre que les dieron en la época actual. Hace quinientos años nadie los llamaba así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010505,
					"content": "Los “Guardianes de las Ruinas” eran conocidos por la gente de Khaenri'ah en aquel entonces como “Labradores”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010506,
					"content": "¿Labradores? Qué nombre tan raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010507,
					"content": "¡¿Eran herramientas de cultivo?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "No es lo que se imaginan. “Labrador”, en realidad, era solo un código. La gente de Khaenri'ah le ponía nombres en código a sus armas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010510,
					"content": "“La tierra no existe para ser labrada con herramientas agrícolas, existe para ser conquistada con acero y sangre”. El nombre de los “Labradores” surgió de este lema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010511,
					"content": "¿“Conquistada con acero y sangre”? ¿Esa era la idea que tenía la gente de Khaenri'ah acerca de la tierra? A Paimon no le parece muy positiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010513,
					"content": "Después de la destrucción de Khaenri'ah, estos “Labradores” sin dueño perdieron el control por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010514,
					"content": "Deambularon sin rumbo durante siglos hasta que se dispersaron progresivamente por todo Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010515,
					"content": "Tal vez yacen inactivos cerca de todo tipo de ruinas porque en ellos resuena el sufrimiento de otras civilizaciones que compartieron el mismo destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010516,
					"content": "Eso suena... muy triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010517,
					"content": "Deambulando sin rumbo durante quinientos años...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "Bueno, una vez que profundicen más en el tema, esos detalles no les van a importar tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010521,
					"content": "Sea cual sea su pasado, lo único que queda es la amenaza que representan actualmente. Así que deben destruirlos a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010518,
					"content": "Creo que... deberíamos acabar con su sufrimiento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "Sí... Paimon piensa que has hecho un buen trabajo en ese aspecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010508,
					"content": "Entonces, ¿por qué ahora son armas letales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
}