			"dialogs": [
				{
					"id": 220470101,
					"content": "Uf, he vuelto a fallar... ¿Qué estoy haciendo mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470102,
					"content": "Veo que sigues practicando el tiro con arco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "Oh, eres tú... ¡Muchas gracias por la demostración que hiciste para nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470104,
					"content": "Gracias a ti, me he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470105,
					"content": "¿Convertido en un francotirador de élite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "Oh, todavía me falta mucho para llegar a eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470108,
					"content": "Pero ahora, por lo menos puedo acertar cinco de cada diez disparos... Y todo gracias a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470109,
					"content": "Sin embargo, nuestros instructores quieren ver aún más de mí, así que voy a seguir trabajando en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470110,
					"content": "Ya que estás aquí, ¿te importaría hacer otra demostración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470111,
					"content": "Con tu ayuda, creo que progresaré aún más rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470112,
					"content": "Presta atención.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "¡Muchas gracias! ¡Prometo observar con atención!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470120,
					"content": "Adelante con la demostración. Prometo que observaré atentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470114,
					"content": "¿Resolviste tus demás problemas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "¿Te refieres a mi mala postura, poca fuerza y mal agarre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470116,
					"content": "Seré sincero contigo. Todavía estoy trabajando en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470117,
					"content": "Además de estos problemas, mi otra preocupación es no ser capaz de utilizar las habilidades que he aprendido en una batalla real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470118,
					"content": "*Ejem*, aun así, supongo que primero tengo que aprender lo básico antes de preocuparme por eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470119,
					"content": "Adelante con la demostración. Prometo que observaré atentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470106,
					"content": "¿Convertido en un maestro de la puntería?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
