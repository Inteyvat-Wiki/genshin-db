				{
					"id": 220470401,
					"content": "Tus habilidades son tan agudas como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470402,
					"content": "Espero que lo hayas observado bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "¡Claro que sí! Estaba observándolo todo, desde tu agarre hasta tu fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470404,
					"content": "Parece que, cuanto más observo, más noto la diferencia abismal en nuestras habilidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "Bueno, mejor no pensar en eso ahora. Por favor, toma esto como agradecimiento por la demostración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "Empezaré a entrenar solo en un rato. La próxima vez, fijemos como objetivo acertar siete de diez disparos, ¿qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				}
