			"dialogs": [
				{
					"id": 411440301,
					"content": "Escuché que alguien hizo un pedido especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411440302
					]
				},
				{
					"id": 411440302,
					"content": "¿Eh? ¿Viniste para ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440303
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411440303,
					"content": "Bueno, llegas justo a tiempo. Una clienta llamada Linguan me pidió que le hiciera unos rollos de carne con matsutake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411440304,
					"content": "Dejó la comida pagada y dijo que se lo llevara al norte del Pantano Dihua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411440305,
					"content": "Si tienes tiempo, ¿podrías ayudarme a llevárselo? Te recompensaré por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
