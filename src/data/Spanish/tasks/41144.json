					"content": "Iré a entregarlo ahora mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411440102
					]
				},
				{
					"id": 411440102,
					"content": "#Vaya, veo que eres muy direct{F#a}{M#o}. Bien, date prisa, y <color=#00E1FFFF>no dejes que te toque nada extraño</color> en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440103
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411440103,
					"content": "Y, por cierto, recuerda <color=#00E1FFFF>no usar el planeador para ir más rápido</color>. Si al aterrizar se te cae la carne, el cliente no lo aceptará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
