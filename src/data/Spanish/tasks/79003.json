			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "Esto es... ¿un barco? No, ¿medio barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030102,
					"content": "¿Por qué hay medio barco en este lugar? ¡Mira! Parece que tiene algo escrito. Veamos qué dice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030103,
					"content": "“... Falta la mitad delantera del barco... Pero por suerte hemos podido mantenernos a flote en la otra mitad durante un tiempo... ¡Ese es mi barco! Jajaja. Aunque las cosas que traíamos ya se las tragó el mar...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030104,
					"content": "“... Parece que flotamos hacia el sureste, ¿no? Qué más da, no importa. La cuestión ahora es... ¿Cómo saldremos de aquí?”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030105,
					"content": "Parece que es el grupo de personas que naufragaron... Dice que se perdió “la mitad delantera del barco”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030106,
					"content": "¿Será esta la popa? ¿Qué les pasaría para que el barco se partiera por la mitad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030107,
					"content": "También dice que flotaron hacia el sureste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030108,
					"content": "¡Vayamos en la misma dirección que ellos y busquemos la mitad delantera del barco! Tal vez descubramos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030109,
					"content": "Llevémonos la tabla de madera con la inscripción.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "Oh, Paimon lo entiende. Crees que esta inscripción puede contener alguna pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030111,
					"content": "¡Tiene sentido! De todas formas, la mayoría de la madera del barco ya ha empezado a pudrirse, así que esa tabla será fácil de arrancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030112,
					"content": "Vamos, arranquémosla y después vayamos a buscar la otra mitad del barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
