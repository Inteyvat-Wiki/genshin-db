						790030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030311,
					"content": "¡Paimon ya lo entiende! Estas personas estaban transportando algo en el barco cuando tuvieron algún problema y acabaron flotando hasta llegar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030312,
						790030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030312,
					"content": "Vaya calamidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030313
					]
				},
				{
					"id": 790030313,
					"content": "¡Desde luego! El barco incluso se partió en dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030316,
					"content": "Pero la pregunta clave es... ¿qué transportaban en el barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030317,
					"content": "¿Por qué no investigamos un poco más? ¡Oh! ¡Tal vez encontremos un tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030318,
						790030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030318,
					"content": "Cualquier cosa que haya estado en el agua tanto tiempo se habrá arruinado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030319
					]
				},
				{
					"id": 790030319,
					"content": "¡Oye, no tires por tierra nuestro espíritu cazatesoros! Paimon está segura de que el tesoro que encontremos estará perfecto y reluciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030322,
					"content": "Bueno, en marcha. ¡Tenemos mucho océano que investigar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030320,
					"content": "O tal vez solo encontremos más monstruos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030321
					]
				},
				{
