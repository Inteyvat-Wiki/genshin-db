				},
				{
					"id": 750460414,
					"content": "Ya están todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460415
					]
				},
				{
					"id": 750460415,
					"content": "¿Fuiste tú quien los trajo de vuelta? ¡Muchas gracias! Por favor, acepta la recompensa que hay en estos cofres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460416
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460416,
					"content": "Iré a verlos enseguida. Oh, sauritos... ¡mis sauritos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460417
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460417,
					"content": "Ahora puedo seguir dando clases de entrenamiento sin más preocupaciones. Por cierto, si te interesa participar en el Desafío del Audaz, puedes venir a verme cuando quieras.",
