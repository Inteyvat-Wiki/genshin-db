			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Urubamba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "*Solloza*... ¡Vuelvan pronto!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Hola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "*Solloza y suspira*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "No me encuentro bien... Qué tristeza. ¿Qué puedo hacer para que mejore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Salí un rato a comprar heno y no sé dónde se han metido las otras ocho crías de Tatankasaurio que estoy criando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "Son tan pequeños... ¿Qué voy a hacer si algún Hilichurl les ha hecho algo? ¿O si se han perdido? ¡¿O si los han atrapado?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "Oye, alma bondadosa, ¿has visto a mis pequeños Tatankasaurios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "¿Qué aspecto tienen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "Yo mismo crie a la madre de estas ocho crías de Tatankasaurio. Es como si fuera mi propia hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "Ella es una de las saurias más hermosas de la Comunidad de la Feracidad... ¡incluso ganó el primer premio en nuestro concurso de belleza regional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "Mis ocho traviesos heredaron la belleza de su madre, por lo que tienen el pelaje rosa claro y unos cuernos en forma de abanico con un toque púrpura perfectamente simétricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "Si los encuentras, ayúdame a traerlos de vuelta, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Mis sauritos... Su abuelo no volverá a enfadarse con ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "#Estaré atent{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "Gracias, alma bondadosa. Estoy seguro de que hoy batirás tu récord en levantamiento de pesas y no tendrás calambres después de hacer dominadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
