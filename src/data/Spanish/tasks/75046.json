					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460807,
					"content": "Oye, alma bondadosa, ¿has visto a mis pequeños Tatankasaurios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460808
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460808,
					"content": "¿Qué aspecto tienen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460809
					]
				},
				{
					"id": 750460809,
					"content": "Yo mismo crie a la madre de estas ocho crías de Tatankasaurio. Es como si fuera mi propia hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460810
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460810,
					"content": "Ella es una de las saurias más hermosas de la Comunidad de la Feracidad... ¡incluso ganó el primer premio en nuestro concurso de belleza regional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460811
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460811,
					"content": "Mis ocho traviesos heredaron la belleza de su madre, por lo que tienen el pelaje rosa claro y unos cuernos en forma de abanico con un toque púrpura perfectamente simétricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460812
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460812,
					"content": "Si los encuentras, ayúdame a traerlos de vuelta, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460813
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460813,
					"content": "Mis sauritos... Su abuelo no volverá a enfadarse con ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460814
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460814,
					"content": "He encontrado algunos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460815
					]
				},
				{
					"id": 750460815,
					"content": "Gracias. Menos mal que están bien, ¡estaba muy preocupado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460816
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460816,
					"content": "Aunque aún no sé dónde están los demás. *Suspira*, siento pedirte que sigas buscando y que me los traigas si los encuentras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
