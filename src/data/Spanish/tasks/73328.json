			"dialogs": [
				{
					"id": 733280201,
					"content": "¡A mis brazos! ¡Hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280202,
					"content": "¿Dónde te encontraremos la próxima vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "¿Quién sabe? Puede que en Celestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280204,
					"content": "¡Jajaja, es broma! Pero si quieres verme allí, allí estaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280205,
					"content": "No me preguntes por qué, pero estoy segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280208,
					"content": "Bueno. ¡Hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280206,
					"content": "Un fuerte abrazo para ti también, Yeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "¡Jaja, gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Yeht"
				}
			]
		}
	]
