					"Yeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "¡Yeht! ¡Eres tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280102,
					"content": "#¡¿{NICKNAME}?! ¡Y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280103,
					"content": "¡*Crin-crin*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280104,
					"content": "¡Jeje! ¿Qué les había dicho? ¡Nos volvemos a encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280105,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "Eh... Es secreto de mujer hecha y derecha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280107,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280108,
					"content": "#{F#Si vas a buscar un buen Izakaya y encuentras la forma de ponerme contenta, puede que te lo cuente... No necesitas que te dé lecciones a estas alturas, ¿no?}{M#¡Eso quiere decir que no husmees! Yo también tengo mis asuntos privados, ¿sabes?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280109,
					"content": "#{F#¡E-estoy de broma, no te lo tomes en serio! Son las reglas de los escoltas a sueldo. No debemos revelar nada sobre la mercancía que escoltamos. Lo siento.}{M#*Pfft*... Son las reglas de los escoltas a sueldo, así que no puedo decírtelo. Lo siento.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280110,
					"content": "¡Vaya! ¡Ahora eres Yeht, “la secretitos”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280111,
					"content": "Bueno... ¿Cómo les ha ido últimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280112,
					"content": "Nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "A mí me ha ido más o menos igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280115,
					"content": "#Bueno, no l{F#as}{M#os} retendré. Ay... Tengo cosas que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280116,
					"content": "Qué ocupada estás, Yeht. Antes no eras así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280117,
					"content": "Uff... Es lo que tiene tener un trabajo “estable”, ¿no? Aunque lo que hago ahora y lo que hacía antes tampoco es tan distinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280118,
					"content": "Poco después de empezar a trabajar como escolta, empecé a añorar mis días despreocupados y sin ataduras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280119,
					"content": "Aunque no sé cómo les ha ido a ustedes, siempre espero con ilusión oír sus aventuras. Y yo también tengo muchas historias que contarles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280120,
					"content": "Pero no hay prisa, no hay prisa... Hay que dar tiempo para que las buenas historias se acumulen y maduren como buen vino. Antiguamente, los viajeros vivían de estas historias en el desierto, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280121,
					"content": "En fin, cuídense mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280122,
					"content": "Tú también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "Sí. ¡Denme un abrazo! ¡Siempre rezaré por ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280124,
					"content": "¡*Crin-crin*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280125,
					"content": "¡Jaja, y Benben también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733280113,
					"content": "Ni fu ni fa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
		{
