					"Daimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "#Soy Daimon de los jibashiri. {F#Heroína}{M#Héroe} de Sangonomiya, reconozco que eres dign{F#a}{M#o} de embarcarte en este desafío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "La valentía es el poder de derrotar a todos tus adversarios, sin importar los medios que utilices. Tan solo con derrotar a todos los oponentes y liberar las llamas del gran portal, tu acceso será autorizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Deberías tener en cuenta que todos esos adversarios son ilusiones que surgieron a partir de los espectros solares y los mayores enemigos que tu corazón conoce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "Incluso así, te derrotarán si no llevas cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Esperaré a que completes el desafío en la Torre de las Tres Fronteras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
