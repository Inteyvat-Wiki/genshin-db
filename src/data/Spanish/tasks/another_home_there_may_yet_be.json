			"dialogs": [
				{
					"id": 130280201,
					"content": "Al llegar al campamento, los dos Hongos son admitidos sin problemas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "#Parece que todavía se acuerdan de nosotr{F#a}{M#o}s. Están siendo muy amables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280203,
					"content": "Parece que todos le tenían mucho aprecio a ese ser elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280204,
					"content": "¿Eh? ¿Qué están haciendo? ¿Quieren jugar con Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280205,
					"content": "♩♩",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "Flotihongo Anemo"
				},
				{
					"id": 130280206,
					"content": "#Sí, sí, ya voy. {NICKNAME}, Paimon se va a jugar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280207,
					"content": "Perfecto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "Me gustaría disculparme contigo. Cuando entramos en el interior de Apep y la semilla crepitante se resquebrajó, estaba dispuesta a sacrificarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280210,
					"content": "¿Te lo dijo Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280211,
					"content": "Sí, y me preocupé mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "Me precipité. Debería haberlo pensado más y haber tomado una decisión más racional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280214,
					"content": "Pero solo podía pensar en el gran peligro que corría Apep y en la amenaza que ello suponía para toda Sumeru. Me dejé llevar por el miedo y la angustia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280215,
					"content": "Si no hubiera actuado mientras todavía podía, o si mi poder se hubiera agotado antes de que todo acabara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280216,
					"content": "Utilizar mi poder suele ser la alternativa más sencilla, pero también la más dura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280217,
					"content": "Todavía puedes seguir creciendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "Estoy de acuerdo. Nos han enseñado mucho, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280219,
					"content": "Comprendo lo que supone que tus sueños se hagan realidad, pero aun así soy incapaz de aceptarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280220,
					"content": "No entiendo por qué su voz sonaba tan calmada cuando estaba haciendo algo tan trágico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280221,
					"content": "Supongo que aún no soy capaz de sentir suficiente empatía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280222,
					"content": "No es tu culpa, Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "Gracias por consolarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280225,
					"content": "Las emociones son realmente complicadas. Aún me queda mucho por aprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280226,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280227,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "Flotihongo Hydro"
				},
				{
					"id": 130280228,
					"content": "♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "Flotihongo Hydro"
				},
				{
					"id": 130280229,
					"content": "Están cuidando de los cultivos... Tal vez estén imitando las acciones de los seres elementales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280230,
					"content": "Aquel Hongo fue incluso capaz de aprender a hablar. Tal vez se deba a la influencia a largo plazo de la energía elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280231,
					"content": "El tiempo es algo realmente poderoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "Así es. Ahora ya no tendremos que preocuparnos por esos dos Hongos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280233,
					"content": "Me encargaré de echarle un ojo al campamento y venir a visitarlos de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280234,
					"content": "Preservaré la esencia remanente que han dejado tras de sí para que algún día puedan reencontrarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280235,
					"content": "Después de todo, él recordó el nombre de Nur. Sus recuerdos aún prevalecen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280236,
					"content": "Creo en el poder de la familia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "Entonces lo consideraremos un bonito deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280239,
					"content": "¡Nahida! ¡Los Hongos han traído fruta! ¡Vengan a comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280240,
					"content": "¡Sí, ya vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280237,
					"content": "Creo en los milagros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "Yo siento lo mismo, Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "Sí, y me enfadé mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280208,
					"content": "¡Diviértete!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				}
			]
		}
	]
