			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Ustedes son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "¿Eres Antei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Sí, ese soy yo. Me siento... un tanto extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "Recuerdo perseguir a esos sinvergüenzas, extraer el núcleo y arrojarlo a un campamento. Después de eso, me sentí un tanto mareado por mis heridas, que no dejaban de empeorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "#Pero cuando desperté y {F#las}{M#los} vi, comencé a sentirme bien. Díganme, ¿estoy en ese momento en el que uno parece mejorar antes de morir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "... No, eso no importa ahora. ¿Vinieron a arrestarme de nuevo? Ya probé mi inocencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "Fueron esos tipos de Khaenri'ah, ellos robaron los libros de la biblioteca. Aunque me asignaron como uno de sus guardaespaldas, ¡nunca podría haber estado coludido con ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "Seguí a su grupo de diplomáticos hasta aquí y los derroté a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Pero invertí demasiado tiempo en derrotar a una criatura mecánica que venía con ellos. Al final, fui capaz de extraerle el núcleo, pero me hirieron gravemente en el intento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "Cuando la máquina quedó deshabilitada se precipitó sobre el libro perdido. Ahora es imposible recuperarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Guau, los jibashiri del reino de Byakuya son tipos intimidantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "Esperen, ¿ustedes no son jibashiri o aprendices? *Suspira*, qué mas da. Los jibashiri fueron conocidos como héroes que lucharon contra los Dragartos de las Profundidades, pero con el tiempo acabaron convirtiéndose en agentes de la ley, en jueces del inframundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "El núcleo se halla en el campamento. Vayan ustedes para verlo con sus propios ojos si no me creen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
