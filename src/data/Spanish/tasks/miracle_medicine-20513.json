			"dialogs": [
				{
					"id": 205130101,
					"content": "Esta vez parece bastante normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Te ves bastante bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Sí, bueno... Es que me asusto por tonterías...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Anna ya se encuentra mejor. Al parecer, aquel médico era realmente bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "Si quieres, ¿podrías ayudarme con otra medicina? Esta vez necesito una margarita voladora aventada por un Slime Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "Eso no suena a medicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Sí... A veces se usan margaritas voladoras para hacer medicina, pero solo para curar síntomas muy leves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Lo importante son los Slimes Anemo, aunque rara vez se los ve junto a margaritas voladoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Jack me dijo que alguna vez lo vio, y me dio la ubicación aproximada del lugar. He señalado en tu mapa el sitio más cercano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Yo no puedo luchar contra un Slime Anemo volador. ¿Podrías hacerlo tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "Un encargo típico de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Lo es, ¿cierto? Lo difícil será ver las margaritas voladoras y los Slimes Anemo juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130113,
					"content": "Jack me dijo que alguna vez lo vio, y me dio la ubicación aproximada del lugar. Te he señalado el sitio más cercano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130114,
					"content": "Yo ni en sueños podría luchar contra un Slime Anemo volador. ¿Podrías hacerlo tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130115,
					"content": "¿Y si te traigo un Slime Anemo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "*Suspira*, quieres hacerme pasar vergüenza, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130117,
					"content": "Aunque es cierto que pocas veces se ven margaritas voladoras y Slimes Anemo juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130118,
					"content": "Jack me dijo que alguna vez lo vio, y me dio la ubicación aproximada del lugar. Te he señalado el sitio más cercano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130119,
					"content": "Si realmente no lo encuentras, puedes traerme un Slime Anemo. ¡Todo sea por Anna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
