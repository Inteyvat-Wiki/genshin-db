					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267205",
							"2"
						],
						"stepId": 7267205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "¿Encontraste a Wakamurasaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720502,
					"content": "Sobre la Red de la ubicuidad suprema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "Red de la ubicuidad suprema... Me gusta el nombre, pero esa técnica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "¿Esa técnica puede realmente retener la esencia de un humano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Hum, no. No puede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "Solo conocemos la existencia de esa técnica gracias a los registros, pero su práctica desapareció hace mucho, con el paso del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "La técnica que le enseñé a Wakamurasaki solo puede retener pequeños animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Entonces, ¿por qué se la enseñaste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Oh, bueno. Solo quería que Wakamurasaki me ayudase a difundir algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "“La presidenta de la Agencia de Detectives Bantan Sango está desarrollando una red capaz de hacer que la gente diga la verdad con magia onmyoudou de Kamuna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "La magia onmyoudou de Kamuna que desapareció en tiempos inmemoriales, la Agencia de Detectives Bantan Sango y una red que puede retener las esencias de pequeñas criaturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Junta esos tres elementos y tendrás una leyenda urbana que suena increíble pero con un toque de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "Para la mayoría de la gente, las leyendas urbanas no son más que pequeñas historias... Pero para los criminales que ya viven con el miedo en sus corazones, esos cuentos no son tan simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Esto sí que no me lo esperaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "Por otro lado... Wakamurasaki me estaba poniendo de los nervios con eso de “¡encuéntrame la técnica de magia onmyoudou más poderosa que exista!”. Menudo sinsentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "Le dije múltiples, incontables ocasiones que esas cosas no existen, ¡pero ella no me hacía caso! Así que no tuve más remedio que darle “algo” en lo que trabajar para que me dejase en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "¿Y si Wakamurasaki no se lo cuenta a nadie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "Imposible. Ella no podría guardar un secreto ni aunque su vida dependiese de ello. Confía en mí, la conozco demasiado bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720519,
					"content": "De todos modos, gracias por ir por mí. Ten, considéralo una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720520,
					"content": "Por los Arcontes, que no vuelva a fastidiarme de nuevo. Yo soy una detective, no una hechicera onmyouji...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
