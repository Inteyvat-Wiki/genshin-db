			"dialogs": [
				{
					"id": 747080101,
					"content": "#Hola, {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "La Srta. Guillotin mencionó que estaban montando un acuario. Así que, naturalmente, acepté su invitación para venir a servir como asesora marina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "¡Me alegra tenerte a bordo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "¡Genial! ¡Con la enfermera jefa Sigewinne aquí, no tendremos que preocuparnos de que los pececitos se enfermen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Jeje, como me pidieron que cuidara a los animales en el Parque Kinográfico Chevalmarine, he aprendido unos cuantos trucos del oficio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "Resulta que cuidar animales no es tan diferente a cuidar pacientes. Al menos los que se portan bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "#Pero esta vez, además de exhibir los peces normales, tengo ciertos planes de recuperación que me gustaría discutir contigo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Adelante, te escucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "La oficial Ceasth me ha contado que ciertos peces se han vuelto inusualmente agresivos últimamente. Al parecer, están atacando a otras criaturas, a buzos e incluso a pequeñas embarcaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "¿Creen que podríamos traerlos al acuario para que descansen y se relajen un poco? Por lo menos, así dejarán de causar problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Una vez que estén aquí, puedo buscar la manera de tratar ese mal humor tan repentino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "Así podremos ayudar a los peces, devolver las aguas a la normalidad, ¡y ustedes podrán añadir algunos artistas invitados únicos a su acuario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "¡Qué idea tan brillante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "¡Tienes todo mi apoyo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Bien, les daré toda la información que tengo sobre dónde encontrar esos peces agresivos. ¡El resto depende de ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "¡Muchas gracias por la ayuda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}