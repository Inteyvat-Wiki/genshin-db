							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "Imposible... Ya he alcanzado el punto de no retorno. ¿Cómo he podido caer tan bajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650202,
					"content": "También he perdido todo mi control sobre el Mar Primigenio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650203,
					"content": "¿Por qué? ¿Por qué? ¿Por qué? ¡¿Por qué hacen esto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650204,
					"content": "El nuevo mundo no puede nacer. ¡Todos perecerán dentro de un cascarón, como si fuera un sueño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650205,
					"content": "Paimon cree que eres tú quien debería despertar ya de su sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "El fin del mundo es ese tipo de cosas que todo el mundo debe intentar resolver de forma conjunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "Ya veo. La Sacroespada no está de mi lado. Con cada movimiento corta la voluntad de los seres que me rodean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650208,
					"content": "Hasta que, al final, mi frágil naturaleza mundana... mi personalidad, ha regresado a mi cuerpo físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650209,
					"content": "El Mar Primigenio no se desbordará tan rápidamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "Puedo sentir cambios en los valores originales de la fórmula del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650211,
					"content": "¿Quién ha tomado control de la vida? ¿Quién ha abierto el reino de las bestias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650212,
					"content": "Y hay una variable más. Tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650213,
					"content": "#La persona destinada a ser testigo de la derrota del Narval Devoralotodo. {F#La}{M#El} testigo universal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650214,
					"content": "Ya veo... Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650221,
					"content": "Yo también he soñado con convertirme en un ser como tú, pero ese sueño se acaba de hacer añicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650222,
					"content": "Todo lo que he hecho ha sido en vano. Un sueño vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650223,
					"content": "No, ni siquiera se le puede considerar un sueño. Pero yo... No, ustedes y ellos han pagado un precio muy alto por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650224,
					"content": "Cruznarciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650225,
					"content": "Ah, eres tú. No me había dado cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650226,
					"content": "¿Sabes quién soy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650227,
					"content": "Los nombres no son sino una etiqueta. Pero sí, estoy familiarizado con los dos colores que se mezclan en tu alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650228,
					"content": "La directora Lyris no sabía lo que había ocurrido. Tan solo sostenía en sus brazos a Marianne, que estaba a las puertas de la muerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650229,
					"content": "Era incapaz de comprender un presente y un futuro tan complejos, así que se aferró al pasado e hizo lo único que podía hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650230,
					"content": "Mi nombre es Anne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650231,
					"content": "En ese caso, hola, Anne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650232,
					"content": "Estoy dispuesta a perdonarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650233,
					"content": "¿Qué estás diciendo? Desde un principio, mi plan tenía un propósito noble y sagrado, sin cabida para el egoísmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650234,
					"content": "Nadie puede criticarme o juzgarme. Tampoco pueden perdonarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650235,
					"content": "Puede que tu propósito fuera noble, pero tu locura ha hecho daño a mucha gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650236,
					"content": "Ni siquiera has introducido la fórmula correctamente. ¿Qué problema hay con perdonar un error?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650237,
					"content": "... Tienes razón. Mis disculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650238,
					"content": "Por favor, Cruznarciso, acompáñanos. Hay más gente a la que deberías conocer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650239,
					"content": "Parece que se ha vuelto mucho más dócil, pero una petición como esa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650241,
					"content": "¡¿Eh?! ¿Con este tipo de cosas lo normal no es tener un conflicto interno e intentar persuadir durante horas a la otra persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "Como he dicho antes, no siento que haya hecho nada malo. Mi misión ha fracasado, pero el mundo está a salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650243,
					"content": "Dejen que otros se burlen de mí y me maldigan. Ahora mismo, soy alguien vacío. Solo me queda un único deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650244,
					"content": "¿De qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "Yo también quiero volver al principio, a cuando los valientes héroes Narcisos aún no habían comenzado su viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650246,
					"content": "Pero eso ya no es posible. No somos dueños de nuestro destino, y he perdido el poder de crear mis propios sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650247,
					"content": "#Entonces, caballer{F#a}{M#o} {NICKNAME}, cuando estés list{F#a}{M#o}, procedamos a sellar de nuevo el Mar Primigenio y abandonemos este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650215,
					"content": "La criatura ya ha sido derrotada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "Debería haber sentido cambios en los valores originales introducidos en la fórmula del mundo. Una “variable” ha descendido a este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650217,
					"content": "No a cualquier cosa de fuera del universo se la puede considerar “descendida” o “variable”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650218,
					"content": "Pero parece ser que pasé por alto una variable. Tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650219,
					"content": "#{F#La}{M#El} testigo de todo, quien dejará constancia de todo. {F#La diseñadora}{M#El diseñador} de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650220,
					"content": "Solo aquellas personas cuyo valor sea equiparable al de un mundo entero son dignas de ese título.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Cruznarciso"
				}
			]
		},
		{
			"id": 7416503,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7416505",
							"2"
						],
						"stepId": 7416505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cruznarciso",
					"Anne"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650301,
					"content": "Imposible... Ya he alcanzado el punto de no retorno. ¿Cómo he podido caer tan bajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650302
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650302,
					"content": "También he perdido todo mi control sobre el Mar Primigenio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650303
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650303,
					"content": "¿Por qué? ¿Por qué? ¿Por qué? ¡¿Por qué hacen esto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650304
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650304,
					"content": "El nuevo mundo no puede nacer. ¡Todos perecerán dentro de un cascarón, como si fuera un sueño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650305
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650305,
					"content": "Paimon cree que eres tú quien debería despertar ya de su sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650306,
					"content": "El fin del mundo es ese tipo de cosas que todo el mundo debe intentar resolver de forma conjunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650307,
					"content": "Ya veo. La Sacroespada no está de mi lado. Con cada movimiento corta la voluntad de los seres que me rodean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650308
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650308,
					"content": "Hasta que, al final, mi frágil naturaleza mundana... mi personalidad, ha regresado a mi cuerpo físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650309
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650309,
					"content": "El Mar Primigenio no se desbordará tan rápidamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650310
					]
				},
				{
					"id": 741650310,
					"content": "Puedo sentir cambios en los valores originales de la fórmula del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650311
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650311,
					"content": "¿Quién ha tomado control de la vida? ¿Quién ha abierto el reino de las bestias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650312
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650312,
					"content": "Y hay una variable más. Tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650313
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650313,
					"content": "#La persona destinada a ser testigo de la derrota del Narval Devoralotodo. {F#La}{M#El} testigo universal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650314
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650314,
					"content": "Ya veo... Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650315
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650315,
					"content": "Yo también he soñado con convertirme en un ser como tú, pero ese sueño se acaba de hacer añicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650316
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650316,
					"content": "Todo lo que he hecho ha sido en vano. Un sueño vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650317
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650317,
					"content": "No, ni siquiera se le puede considerar un sueño. Pero yo... No, ustedes y ellos han pagado un precio muy alto por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650318
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650318,
					"content": "Cruznarciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650319
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650319,
					"content": "Ah, eres tú. No me había dado cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650320
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650320,
					"content": "¿Sabes quién soy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650321
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650321,
					"content": "Los nombres no son sino una etiqueta. Pero sí, estoy familiarizado con los dos colores que se mezclan en tu alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650322
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650322,
					"content": "La directora Lyris no sabía lo que había ocurrido. Tan solo sostenía en sus brazos a Marianne, que estaba a las puertas de la muerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650323
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650323,
					"content": "Era incapaz de comprender un presente y un futuro tan complejos, así que se aferró al pasado e hizo lo único que podía hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650324
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650324,
					"content": "Mi nombre es Anne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650325
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650325,
					"content": "En ese caso, hola, Anne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650326
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650326,
					"content": "Estoy dispuesta a perdonarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650327
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650327,
					"content": "¿Qué estás diciendo? Desde un principio, mi plan tenía un propósito noble y sagrado, sin cabida para el egoísmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650328
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650328,
					"content": "Nadie puede criticarme o juzgarme. Tampoco pueden perdonarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650329
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650329,
					"content": "Puede que tu propósito fuera noble, pero tu locura ha hecho daño a mucha gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650330
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650330,
					"content": "Ni siquiera has introducido la fórmula correctamente. ¿Qué problema hay con perdonar un error?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650331
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650331,
					"content": "... Tienes razón. Mis disculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650332
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650332,
					"content": "Por favor, Cruznarciso, acompáñanos. Hay más gente a la que deberías conocer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650333
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650333,
					"content": "Parece que se ha vuelto mucho más dócil, pero una petición como esa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650334,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650335
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650335,
					"content": "¡¿Eh?! ¿Con este tipo de cosas lo normal no es tener un conflicto interno e intentar persuadir durante horas a la otra persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650336,
					"content": "Como he dicho antes, no siento que haya hecho nada mal. Mi misión ha fracasado, pero el mundo está destinado a ser salvado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650337
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650337,
					"content": "Dejen que otros se burlen de mí y me maldigan. Ahora mismo, soy alguien vacío. Solo me queda un único deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650338
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650338,
					"content": "¿De qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650339,
					"content": "Yo también quiero volver al principio, a cuando los valientes héroes Narcisos aún no habían comenzado su viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650340
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650340,
					"content": "Pero eso ya no es posible. No somos dueños de nuestro destino, y he perdido el poder de crear mis propios sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650341
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650341,
					"content": "#Entonces, caballer{F#a}{M#o} {NICKNAME}, cuando estés list{F#a}{M#o}, procedamos a sellar de nuevo el Mar Primigenio y abandonemos este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anne"
				}
			]
		}
	]
}