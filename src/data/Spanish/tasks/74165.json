			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cruznarciso",
					"Anne"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
