			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cruznarciso",
					"Anne"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "#Siento... Siento “razón”. Visitantes, ¿son ustedes l{F#a}{M#o}s hereder{F#a}{M#o}s de la Cruz de los Narcisos, o son una amenaza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650102,
					"content": "Veo que has desenvainado el arma, así que la respuesta está clara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650103,
					"content": "Cruznarciso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 741650104,
					"content": "¿Eh? ¿Esta cosa es Cruznarciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "#Si han oído mi nombre, entonces son conocedor{F#a}{M#o}s de mi misión de salvar el mundo y la semilla de la salvación yace dentro de su consciencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650106,
					"content": "Si apuntan sus armas hacia mí, debe ser porque se han dejado embaucar por falacias. Pero no es momento de malgastar mi poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650107,
					"content": "¡Alégrense! ¡Regocíjense! Pues cuando todo haya concluido, daré respuestas y explicaciones. Pero, por ahora, dejen la Sacroespada en mis manos y busquen refugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650108,
					"content": "No te vamos a dar la Sacroespada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "#Son ustedes un{F#a}{M#o}s neci{F#a}{M#o}s, pero aun así l{F#a}{M#o}s perdonaré y l{F#a}{M#o}s salvaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650110,
					"content": "Puedo sentir que los cuatro cuadrantes han sido revertidos, pero el árbol del flujo aún no está completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650111,
					"content": "Ya no es posible salvarlos a todos. Extenderé mi misericordia hasta alcanzar mi límite, aunque sea a expensas de mi propia vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650112,
					"content": "Si solo puedo salvar a cinco de cada diez, haré todo lo posible para convertirlo en seis de cada diez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Cruznarciso"
				},
				{
					"id": 741650113,
					"content": "Ahora, debo tomar la Sacroespada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cruznarciso"
				}
			]
		},
		{
			"id": 7416502,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
