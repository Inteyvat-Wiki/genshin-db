							"20063"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "¿Cuándo me volveré un gran aventurero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Oh, eres tú... Cyrus me contó una historia de aventuras ayer... Esta vez fue en las <color=#00E1FFFF>Montañas Portatormentas</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "Dijo: “... El enorme escudo era como salido de una pesadilla, no importa cuánto lo golpeara, no le sacaba ni una astilla, y detrás del escudo, el monstruo me miraba con desprecio, riéndose de mi debilidad...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "Un escudo de madera que resiste sin importar el tipo de ataque... ¡Quiero verlo por mí mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "Pero con tanto trabajo por hacer, no tengo tiempo. ¿Qué monstruo temible será? Y además, ¡carga un escudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Humm... ¿puedes ayudarme a encontrar ese monstruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Muchas gracias. Cuando lo encuentres, vuelve y habla conmigo directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Voy contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "¿Ir? ¿Yo? Lo siento, hay muchas tareas que me esperan en el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "Hoy en día, las actividades de aventura no son muy rentables, aunque se llama “Gremio de Aventureros”, la mayoría de las veces en realidad solo están ayudando a las personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "Como ayudar a Draff a atrapar jabalíes, a Margaret a encontrar gatos, o a Flora, que quiere flores frescas hoy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "¡Jaja! Cuando me uní al Gremio de Aventureros, no me imaginé este tipo de “aventuras”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
			],
