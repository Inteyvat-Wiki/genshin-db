					"content": "Esa es la descripción del monstruo según Stanley. También dijo que después de pelear con todas sus fuerzas logró extinguir las llamas del monstruo y derrotarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630603
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630603,
					"content": "Pero se rehusó a contar los detalles sobre cómo extinguió las llamas. ¿Acaso tiene un arma letal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
