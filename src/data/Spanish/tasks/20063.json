			"dialogs": [
				{
					"id": 200631301,
					"content": "Jack, ¿sabes? uno tiene que ir de aventura personalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631302,
					"content": "Lo sé, pero... Vaya, volviste. ¿Qué tal? ¿Encontraste al monstruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631303,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631304
					]
				},
				{
					"id": 200631304,
					"content": "¡Genial!... ¿Qué? ¿Un simple Hilichurl sosteniendo un escudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631305,
					"content": "Imposible, no es como lo describió Cyrus... ¿Te habrás equivocado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631306,
					"content": "Por fortuna Cyrus está aquí. Vamos, Cyrus, cuéntale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631307,
					"content": "Ehm... Sí, tienes razón, Jack. No es el mismo monstruo que vi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631308,
					"content": "Vaya... Cyrus no deja de guiñarnos el ojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200631309,
					"content": "Jaja, justo como lo pensé. Pero no importa, si fuera tan fácil de encontrar este monstruo tan temible, ¡no me atrevería a salir de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631310
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631310,
					"content": "De todos modos, hiciste un buen trabajo. Ya puedo volver a mis asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
			]
		},
