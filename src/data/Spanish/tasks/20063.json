			"dialogs": [
				{
					"id": 200631601,
					"content": "Vamos, no me mires así, me acabo de disculpar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631602,
					"content": "¿... un Hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631603
					]
				},
				{
					"id": 200631603,
					"content": "Sí, de acuerdo, en la historia que conté, el monstruo era realmente un simple Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631604,
					"content": "*Suspira*, escucha, sabes bien que los todos jóvenes de Mondstadt quieren entrar a la Orden de los Caballeros de Favonius. Es difícil encontrar nuevos reclutas en el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631605,
					"content": "¿El motivo? Las expediciones de los Caballeros se enfrentan a monstruos temibles, como un dragón. El Gremio de Aventureros se encarga de alimañas pequeñas, como Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631606,
					"content": "Si no tenemos una historia heroica para promocionar el Gremio, ¿cómo piensas reclutar sangre nueva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631607,
					"content": "Pero bueno, este método también resultó un fracaso... Ya estoy muy viejo, no puedo ir de expedición a luchar con monstruos legendarios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631608
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631608,
					"content": "*Suspira*, ¿qué será del Gremio de Aventureros de Mondstadt cuando me retire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
