					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200631001,
					"content": "“Unos cristales de mal augurio emanaban del cuerpo de la bestia, el malévolo monstruo crecía y crecía. Temía que fuera a congelar mis ojos. Yo blandía mi espada a diestra y siniestra, pero aquellos cristales atraían mi mirada...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631002,
					"content": "Esa es la descripción de Stanley, pero bebió mucho vino y dijo muchas incoherencias. Cuando recuperó la sobriedad, no recordaba nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631003,
					"content": "Pero cuando se trata de “hielo”, hay que usar “fuego”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631004
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631004,
					"content": "Pero, ¿qué tipo de fuego se necesita para derrotar a este terrible monstruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
