				},
				{
					"id": 200631402,
					"content": "No importa, le pedí a alguien que fuera a buscarlo ¿Encontraste el monstruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631403
					],
					"speakerTitle": "Jack"
