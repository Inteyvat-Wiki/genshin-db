					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630801,
					"content": "“... El enorme escudo era como salido de una pesadilla, no importa cuánto lo golpeara, no le sacaba ni una astilla, y detrás del escudo, el monstruo me miraba con desprecio, balbuceando y riéndose de mi debilidad...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630802
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630802,
					"content": "Esto es lo que dijo Cyrus... ¡Lo recuerdo muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630803,
					"content": "También dijo que la clave para derrotar a este monstruo era usar un truco para destruir el escudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630804
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630804,
					"content": "De lo contrario, mientras el monstruo cargue con él, no importa cuántos golpes de espada des, no le harás ni un rasguño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630805
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630805,
					"content": "Y Cyrus también dijo que el monstruo espera al momento oportuno para atacar. Basta con un descuido para aplastarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630806
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630806,
					"content": "Cyrus es un gran aventurero, capaz de derrotar monstruos así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630807
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630807,
					"content": "Yo lo haría, pero lamentablemente no tengo tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
