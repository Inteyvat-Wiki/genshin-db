					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "De verdad quisiera ir allá afuera de aventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Stanley me contó otra historia ayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "Pero bebió demasiado, no tenía ni pies ni cabeza... Ya lo recuerdo, fue en el <color=#00E1FFFF>Viñedo del Amanecer</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "Dijo algo así: “Unos cristales de mal augurio emanaban del cuerpo de la bestia, el malévolo monstruo crecía y crecía. Temía que fuera a congelar mis ojos. Yo blandía mi espada a diestra y siniestra, pero aquellos cristales atraían mi mirada...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "¿Qué clase de monstruo haría que Stanley peleara con uñas y dientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "Realmente quiero verlo por mí mismo... Pero solo pensaría en huir si tuviera que enfrentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "Tú en cambio, no deberías tener problema. ¿Qué dices? ¿Quieres ayudarme a encontrarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "¡Te lo encargo! Después de encontrarlo, vuelve y habla conmigo con lujo de detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "¿Por qué no vamos juntos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "Tengo muchas ganas acompañarte, pero la situación del Gremio de Aventureros es... bueno, tú sabes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630313,
					"content": "Cyrus tenía la intención de retirarse. Siempre dice que planea ir a Aguaclara a pasar el resto de sus días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630314,
					"content": "Desde que Herman tuvo a su hija, ni siquiera ha ido a Mondstadt. Antes de eso era un as en las aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630315,
					"content": "Y Stanley se ha tomado un descanso muy, muy largo. Hace mucho que no emprende una aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630316,
					"content": "Ahora que el Gremio quiere recaudar fondos, solo puede hacerlo mediante todo tipo de tareas... Pero, no hay muchas personas que puedan hacerlas estos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630317,
					"content": "Tengo que hacer más trabajo, y no puedo contar con Bennett, él también trabaja muy duro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
