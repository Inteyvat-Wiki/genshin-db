			"dialogs": [
				{
					"id": 200631201,
					"content": "Jack, escúchame... no es así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631202
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631202,
					"content": "Vaya, volviste. ¿Qué tal? ¿Encontraste al monstruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631203,
					"content": "Lo encontré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631204
					]
				},
				{
					"id": 200631204,
					"content": "¿Un simple Slime Pyro? ¡La historia que me contó Stanley es totalmente distinta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631205,
					"content": "Afortunadamente Stanley está aquí con nosotros. Stanley, vamos, cuéntale tu hazaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631206,
					"content": "Es el “monstruo ardiente”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631207,
					"content": "Pues verás... ese día bebí demasiado, no recuerdo con claridad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631208
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631208,
					"content": "¡Ya lo recuerdo! Lo tengo todo en mis notas, vean, las escribí con sumo detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631209
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631209,
					"content": "¡Vaya! Jack, acabo de recordar otra historia, te garantizo que nunca has oído hablar de ella, hace mucho tiempo, yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
			]
		},
