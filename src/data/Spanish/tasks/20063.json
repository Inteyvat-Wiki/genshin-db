				{
					"id": 200631403,
					"content": "Lo encontré...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631404
					]
				},
				{
					"id": 200631404,
					"content": "¿Un Slime Cryo? Está muy lejos de ser la descripción de Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631405,
					"content": "¿Será que te equivocaste? Oye, Stanley, ¿qué piensas de todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631406,
					"content": "*Ejem, ejem*, Acabo de recordar una nueva historia, ¿quieres escucharla, Jack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631407
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631407,
					"content": "Pero el Slime Cryo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631408,
					"content": "¡Te garantizo que no conoces esta historia! Eso fue hace mucho, mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
