					"content": "Realmente te estoy agradecida... ¿Sabes qué? Mi esposo recientemente dejó de beber por mi bien, y ha sido tan miserable desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490402
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490402,
					"content": "Quizás un poco de sus frutas favoritas lo animará un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490403
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490403,
					"content": "Aunque por otro lado... Las manzanas están a mejor precio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
