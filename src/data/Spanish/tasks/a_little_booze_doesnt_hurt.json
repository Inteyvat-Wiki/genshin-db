			"dialogs": [
				{
					"id": 200490601,
					"content": "¿Encontraste solsettias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490602
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490602,
					"content": "¿Son suficientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490603
					]
				},
				{
					"id": 200490603,
					"content": "¡Por los dioses! ¡Es más que suficiente! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490604
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490604,
					"content": "¡Se ven muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490605
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490605,
					"content": "... Pero estas manzanas son muy baratas. ¿Tal vez debería llevar un poco de cada una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
