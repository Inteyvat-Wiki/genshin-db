					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "Necesito un trago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490102,
					"content": "Pero si Eury me atrapa bebiendo, será mi fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490103,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "¿Eh? Oh... Todo bien, solo me apetece un trago, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490105,
					"content": "Pero mi esposa Eury no lo soporta, así que no bebo ni una gota en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490106,
					"content": "Lo único que puedo hacer es esperar hasta que ella se vaya de compras y luego escaparme a beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490107,
					"content": "El primer paso es admitir que tienes un problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "¡Oye, no seas así! No soy la única persona en Mondstadt a la que le gusta beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490109,
					"content": "¿Podrías distraer a Eury un poco? Solo lo suficiente para que me tome una o dos cervezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490110,
					"content": "Cada vez que Eury va de compras y se encuentra con muchas opciones distintas, se pasa el día entero tratando de tomar una decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490111,
					"content": "Siempre que tiene muchas opciones para escoger, se pasa el día tomando una decisión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490112,
					"content": "De acuerdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "Jaja, ¡excelente! ¡Que en tu copa siempre fluya el buen vino de la fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490114,
					"content": "¿Cuánto tiempo planeas beber exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "Jeje, bueno, eso depende de cuánto tiempo puedas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490116,
					"content": "... N–no, solo el tiempo suficiente para disfrutar de una buena bebida sin tener que tomarla de golpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490117,
					"content": "Solamente una, ¡lo juro! ¡Los que solemos frecuentar las tabernas de Mondstadt somos de fiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
