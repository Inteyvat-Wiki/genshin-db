			"dialogs": [
				{
					"id": 200490801,
					"content": "¡Estás de vuelta! ¿Cómo está Eury?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490802
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490802,
					"content": "A juzgar por el olor, diría que has bebido más de una cerveza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490803,
					"content": "Eury está dudando sobre qué comprar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490804
					]
				},
				{
					"id": 200490804,
					"content": "¡Bien, bien! Yo, eh... ¡Supongo que tengo tiempo para otra entonces! ¡Mesero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490805
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490805,
