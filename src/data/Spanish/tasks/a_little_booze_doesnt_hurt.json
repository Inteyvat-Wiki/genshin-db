					"Eury"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200490201,
					"content": "Humm... ¿solsettias o manzanas? ¿Cuál debería escoger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490202
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490202,
					"content": "*Suspira*, si Nimrod estuviera aquí, solo tendría que escoger lo que él quiere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490203
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490203,
					"content": "Lo sentimos, señorita Eury. Nos quedamos sin solsettias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490204
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490204,
					"content": "Ya veo. Bueno, supongo que tendrán que ser manzanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490205,
					"content": "Oh... Lo siento, Eury, creo que estas manzanas están empezando a pudrirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490206,
					"content": "¿En serio? Humm... No me queda otra opción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490207,
					"content": "¡Con permiso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490208,
					"content": "¿Eh? ¿Permiso para qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490209,
					"content": "Para ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "No te preocupes. Encontraremos algunas <color=#00E1FFFF>solsettias</color> frescas para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490211,
					"content": "¿De verdad? Vaya, ¡muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490212,
					"content": "¡Genial! Nimrod prefiere las solsettias a las manzanas. Esperaré aquí entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
			]
		},
