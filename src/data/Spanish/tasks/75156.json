			"dialogs": [
				{
					"id": 751560101,
					"content": "Por fin puedo salir de este carro de saurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560102,
					"content": "Uff, este carro es realmente sofocante, caluroso y maloliente. En tan solo medio día, me siento como si hubiera perdido dos o tres años de mi vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560103,
					"content": "¿Otra vez tú? ¿Qué ha pasado esta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560104
					]
				},
				{
					"id": 751560104,
					"content": "#Oh, eres tú, mi benefacto{F#ra}{M#r}. ¡Qué suerte que nos hayamos vuelto a encontrar en nuestro viaje! O mejor dicho, ¡que me hayas salvado una vez más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560105
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560105,
					"content": "#Ay, mi benefacto{F#ra}{M#r}, ¿no te dije la última vez que me llamo Conulaf, y que soy una sacerdotisa aprendiz de los Augures Vientonocturno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560106
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560106,
					"content": "Me estoy entrenando para ser una sacerdotisa. Los ancianos de la tribu me contaron que nuestros ancestros nos habían dejado tesoros por toda Natlan y me dijeron: “¡Ve a buscar los tesoros, Conulaf!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560107
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560107,
					"content": "Así que me echaron de la tribu con el pretexto de mi formación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560108
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560108,
					"content": "Y bueno, con mis astutos oídos, obtuve la pista de que en esta zona hay un tesoro... Dicen que se puede encontrar siguiendo las huellas de un no sé qué de carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560109
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560109,
					"content": "Es evidente que se referían a un animal de carga. Espera, ¿acaso era una alpaca de carga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560110
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560110,
					"content": "#En fin, mi benefacto{F#ra}{M#r}, lo cierto es que seguí a un animal de carga y acabé en el campamento de esa gente que pensó que era una ladrona de animales de carga y me encerraron en el acto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560111
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560111,
					"content": "No solo no encontré ningún tesoro enterrado, sino que casi me terminan enterrando a mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560112
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560112,
					"content": "La información que manejabas estaba incompleta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560113
					]
				},
				{
					"id": 751560113,
					"content": "Tienes razón, la próxima vez no actuaré precipitadamente... Tal vez quedarme encerrada era el precio que tenía que pagar para aprender esta lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560114
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560114,
					"content": "Arg, este olor... Necesito darme un buen baño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560115
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560115,
					"content": "#Muchas gracias, benefacto{F#ra}{M#r}, por salvarme esta vez. Como muestra de agradecimiento, te compartiré parte de los pocos fondos que me quedan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
