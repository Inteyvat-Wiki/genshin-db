			},
			"dialogs": [
				{
					"id": 4890201,
					"content": "¡Has vuelto! ¿Trajiste los ingredientes? Déjame ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890202,
					"content": "... Sí. Eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890203,
					"content": "Ahora toma el séptimo pedido: un <color=#00E1FFFF>pollo asado con miel</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890204,
					"content": "#... Y esa es la historia de cómo {NICKNAME} se convirtió en {F#una verdadera}{M#un verdadero} chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890205,
					"content": "Dijiste que ayudarías a El Buen Cazador, asegúrate de servirlo mientras esté caliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
