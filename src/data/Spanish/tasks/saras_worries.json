			"dialogs": [
				{
					"id": 4890301,
					"content": "¡Un pollo asado con miel, recibido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890302,
					"content": "Huele... ¡bastante bien! Tienes un don para esto, ¡justo la persona que necesito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "Así que... ahora deberías hacer este <color=#00E1FFFF>asado a la miel</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890304,
					"content": "¿<color=#00E1FFFF>Asado a la miel</color>? Estoy segura de que alguna vez lo comimos con Amber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "Así es. Es un pilar del menú de El Buen Cazador. ¡Es mi orgullo y alegría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "Los Caballeros lo piden cada vez que vienen aquí para una cena grupal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "Déjame enseñarte la receta de <color=#00E1FFFF>asado a la miel</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Espera, pensé que habías dicho que es tu orgullo y alegría. ¿Vas a enseñarnos cómo hacerlo, así como así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
					"content": "¡Con tus habilidades culinarias, no creo que vaya a perjudicar a la imagen de El Buen Cazador! ¡Jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890310,
					"content": "Tan pronto como esté listo el <color=#00E1FFFF>asado a la miel</color>, tráelo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
