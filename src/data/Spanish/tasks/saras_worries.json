			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "Entendido. ¡Partiré de inmediato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890102,
					"content": "¡Amber! ¿Estás aquí para ayudar con la carga de trabajo de Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890103,
					"content": "Oh, hola. Sí, me estaba preparando. ¿Quién mejor que una Caballera Exploradora para deshacerse de algunos Hilichurls en la ruta de entrega?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890104,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890105,
					"content": "Sara... ¡No hay de qué preocuparse! Como Caballera Exploradora, ¡estaré a la altura y no te decepcionará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890106,
					"content": "No me malinterpretes, no dudo de tus habilidades. Estoy abrumada por la cantidad de pedidos que hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890107,
					"content": "Justo ahora entró uno muy extraño. Es como si estuvieran organizando un banquete o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890108,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890109,
					"content": "¿Hay algo con lo que necesites ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "¡Puedo ayudar en la cocina!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "¿Lo dices en serio? ¿No te importa ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890112,
					"content": "¡Eso sería maravilloso! Realmente eres el ángel guardián de El Buen Cazador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890113,
					"content": "¡Vaya, te llevas todo el mérito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890114,
					"content": "Bueno, ¿qué tal si empiezas con este pedido? Comienza por obtener los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890115,
					"content": "#¿Estás segura de que se puede confiar en {NICKNAME}? Podría terminar sabiendo a rayos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890116,
					"content": "No podemos darnos el lujo de aspirar a la perfección. Ahora es una lucha para salvar el negocio de El Buen Cazador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890117,
					"content": "¿Una lucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890118,
					"content": "Para este plato necesitamos <color=#00E1FFFF>tres flores dulces y tres trozos de carne de ave</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890119,
					"content": "Ve y prepárate. Tú también, Amber. Estaré esperando aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890120,
					"content": "¡D-de acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48902,
