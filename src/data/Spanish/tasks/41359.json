			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "¿Y bien? ¿Cómo va la búsqueda de tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590202,
					"content": "Ya los encontré todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "Vaya, lograste descifrar las tres imágenes... Impresionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590204,
					"content": "#*Ejem*, el Gremio de Aventureros preparó un regalo especial para ti por ser {F#una aventurera}{M#un aventurero} sobresaliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590205,
					"content": "¿Ves esos cofres? Ábrelos. Todo lo que contienen es tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590206,
					"content": "Pero si los abro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "No habrá nada para los demás. Así son las aventuras, ¡el que lo encuentra, se lo queda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590208,
					"content": "Bien, te deseo un feliz Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				}
			]
		},
