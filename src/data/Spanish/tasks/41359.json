			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "#¡Bienvenid{F#a}{M#o}! ¿Quieres intentar el juego de las linternas giratorias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590102,
					"content": "¿Tienes otra imagen para mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "¡Por supuesto! Y ya que no tuviste problemas para resolver los últimos dos rompecabezas, cambié las linternas por las más complejas que tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590104,
					"content": "El principio es el mismo: combina las tres imágenes para hacer una. Pero ahora, la dificultad está en que las linternas están <color=#00E1FFFF>conectadas entre sí</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590105,
					"content": "Jeje, entenderás de lo que hablo si lo intentas. En esta ocasión, la imagen es de una <color=#00E1FFFF>grulla</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413590106,
					"content": "Después de formar la imagen, puedes ir a buscar el tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				}
			]
		},
		{
			"id": 4135902,
			"completionStepIds": [
				4135907
