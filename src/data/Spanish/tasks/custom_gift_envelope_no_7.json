				},
				{
					"id": 715390105,
					"content": "Vamos, que Paimon tiene muchas ideas para las felicitaciones. ¡Seguro que te gustan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715390106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715390106,
