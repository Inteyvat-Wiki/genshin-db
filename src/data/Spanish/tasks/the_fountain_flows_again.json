			"dialogs": [
				{
					"id": 740370701,
					"content": "¡Con esos basta y sobra! Bien, espera un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle se pone a trabajar como si no hubiera un mañana...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Bien, ya está todo, tanto la válvula y la boquilla como los componentes secundarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "#Edel, viajer{F#a}{M#o}, vamos a las Erinias. Conmigo allí, repararemos la fuente en un abrir y cerrar de ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "#Muchas gracias, Estelle. Yo llevaré estas cosas. Viajer{F#a}{M#o}, en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
