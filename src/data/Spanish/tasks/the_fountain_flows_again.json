			"dialogs": [
				{
					"id": 740370801,
					"content": "Pues empecemos. Esta es la fuente, lleva mucho tiempo sin funcionar, así que ya es hora de repararla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370802,
					"content": "Ambos se ponen a trabajar como si no hubiera un mañana...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "Ya he colocado la válvula. He comprobado y parece que está todo bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Bien, entonces alejémonos un poco. En un momento abriré la compuerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "A ver... La compuerta principal está ahí, y la secundaria también tiene que funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Un segundo, voy a abrir la compuerta principal primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "¿Pero quién diseñó esta fuente y por qué puso tan lejos unas compuertas de otras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel va a donde está la compuerta y vuelve a toda prisa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Uff, estoy agotado solo de abrir estas compuertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Ahora esperemos. El agua debería salir pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Tras unos estruendosos sonidos, la fuente vuelve a funcionar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Genial, la fuente ha vuelto a la normalidad, así que, aunque Kératry hable de lo que ocurrió la otra noche, puedo fingir que no sé nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370813,
					"content": "No vuelvas a hacer magia sin pensarlo bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "No creo que sea una cuestión de magia... Bueno, gracias por tu ayuda. Toma, me gustaría que aceptaras este pequeño obsequio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370816,
					"content": "Dentro está la recompensa que prometí darte. Muchas gracias por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370817,
					"content": "Edel, Estelle, gracias a ustedes dos también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370818,
					"content": "No hace falta que me las des, era mi deber. Pero recuerda no volver a salir por la noche con tu hermana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Remaudière, ¿qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Kératry"
				},
				{
					"id": 740370820,
					"content": "¡¿Kératry?! ¿Qué haces tú aquí? ¿No estabas... no estabas paseando con papá y mamá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370821,
					"content": "Jeje, me escapé cuando mamá no miraba para venir a ver cómo estaba la fuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Kératry"
				},
				{
					"id": 740370822,
					"content": "Como la paraste con tu magia, pensé que hoy seguiría igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Kératry"
				},
				{
					"id": 740370823,
					"content": "Jaja, bueno, es que... la magia tiene un límite de tiempo. Solo se puede usar durante cierto periodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370824,
					"content": "Oh... ¡Pues quiero volver a verte hacer magia! Remaudière, ¿puedes hacer que la fuente vuelva a parar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Kératry"
				},
				{
					"id": 740370825,
					"content": "Es que... *Suspira*, mira, Kératry, hay demasiada gente por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370826,
					"content": "Si hago que la fuente pare, la gente se pondrá triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370827,
					"content": "Entonces... ¡volveremos más tarde con papá y mamá! ¡Seguro que a ellos también les encantaría ver cómo haces magia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Kératry"
				},
				{
					"id": 740370828,
					"content": "¡¿Qué?! Kératry, hermanita... lo cierto es que... aún no he estudiado bien cómo hacer magia en esta fuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370829,
					"content": "No creo que papá y mamá quieran ver a un mago de medio pelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370830,
					"content": "Así que, por favor, no les digas nada sobre la magia que usé en la fuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370831,
					"content": "Cuando lo haya estudiado todo bien, les daré una sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370832,
					"content": "¡Bieeeen! ¡Papá y mamá se pondrán supercontentos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Kératry"
				},
				{
					"id": 740370833,
					"content": "Sí, seguro que sí. Vamos, volvamos a casa, te mostraré... un nuevo truco de magia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370814,
					"content": "La magia, igual que los milagros, tienen un precio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370822
					]
				}
			]
		}
	]
}