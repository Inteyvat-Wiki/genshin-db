			"dialogs": [
				{
					"id": 740370501,
					"content": "Hola, ¿en qué puedo ayudar...? ¿Eh? ¿Edel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370502,
					"content": "Vengo a recoger la válvula y la boquilla que encargué. Si no reparo ya la fuente, Remaudière va a empezar a tirarse de los pelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370503,
					"content": "L-la válvula, ¿eh?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370504,
					"content": "¿Por qué tartamudeas? Estelle... no me digas que no la tienes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370505,
					"content": "¡No, para nada! La tenía, pero... como vino otra clienta que también tenía que hacer unas reparaciones de urgencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370506,
					"content": "Le di... Le di algunos componentes secundarios genéricos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370507,
					"content": "¡No te preocupes! ¡Puedo hacer unos nuevos ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370508,
					"content": "Pero Estelle... te hice el encargo con mucha antelación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370509,
					"content": "¡Lo sé, lo sé! Pero es que esa clienta lo necesitaba urgentemente porque tenía que reparar no sé qué válvula de alcantarillado, así que no pude negarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370510,
					"content": "No pasa nada, en cuanto me lleguen los pedazos de hierro que encargué, ¡podré ponerme a ello y estarán listos en un santiamén!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370511,
					"content": "¿Cuándo los encargaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370512,
					"content": "E-esta mañana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370513,
					"content": "Yo me encargo de reunir los pedazos de hierro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "#¿De verdad lo harás? ¡Fenomenal! Muchas gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370516,
					"content": "¡Y lo siento, de veras! Lo siento muchísimo... En fin, con tres pedazos de hierro será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370517,
					"content": "#*Suspira*, pues nada, no me queda más remedio que pedírtelo a ti, viajer{F#a}{M#o}. No te preocupes, te pagaré por tomarte las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370514,
					"content": "Dejen que yo vaya a recoger unos pedazos de hierro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
