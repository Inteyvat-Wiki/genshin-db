			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Hay que cambiar las tuberías... Las válvulas también están mal... Y luego, también hay que limpiar... Esto es un problema tras otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "¿Necesitan algo? Humm... No parece que sean las personas que mandó Estelle para reparar la fuente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "Venimos de parte de Remaudière.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Ah, ¿es por él? Ja, su magia es tan poderosa que deformó una válvula de las tuberías de la fuente y, de paso, también rompió la boquilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Jajaja, era broma. Lo que pasó en realidad es que la válvula que cambió de forma está obstruyendo todo el sistema de agua. Por seguridad, apagamos directamente la fuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Lo que no entiendo es cómo se rompió la boquilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudière no deja de decir que, si no arreglo la fuente, le van a regañar, pero he estado tan ocupado que no me da la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "Justo hoy pude hacer un hueco para encargarle a Estelle una nueva válvula y una nueva boquilla. De hecho, estaba a punto de ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "¿Querrías venir conmigo? Como son bastantes cosas, no sé si voy a poder con todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
		{
			"id": 7403704,
