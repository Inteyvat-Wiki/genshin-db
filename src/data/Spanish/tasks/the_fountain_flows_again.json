			"dialogs": [
				{
					"id": 740370101,
					"content": "*Suspira*, ¿por qué Edel no ha arreglado ya esta fuente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370102,
					"content": "Si sigue sin arreglarla, Kératry se lo contará a todo el mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370103,
					"content": "¿Está rota esta fuente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "*Suspira*, hace poco funcionaba bien, pero de repente dejó de expulsar agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370105,
					"content": "Y de hecho... ¡se rompió en cuanto terminé de hacer un número de magia para Kératry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370106,
					"content": "Mis padres estaban en la Ópera y me dijeron que me quedara en casa leyendo y jugando con mi hermana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370107,
					"content": "Ella no dejaba de insistir en que quería salir, y como yo no soy capaz de convencerla, al final salimos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370108,
					"content": "Pero cuando llegamos aquí, a la fuente, Kératry dijo que quería esperar a papá y a mamá al salir de la Ópera para volver juntos a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370109,
					"content": "¿Qué tiene eso de malo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "Eso dice Paimon... Total, ya han venido hasta aquí. Además, cuando sus padres salgan de la Ópera, ¡a lo mejor los llevan a comer algo rico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370111,
					"content": "Para entonces ya será noche cerrada... Si mis padres se enteran de que he venido hasta aquí con mi hermana y que nos hemos quedado hasta tan tarde, ¡no creo que viva para contarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370112,
					"content": "Por eso, le conté una mentira a Kératry. Le dije que domino un tipo de magia con la que puedo hacer que deje de salir agua de la fuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370113,
					"content": "En realidad, solo estaba calculando los intervalos en los que el agua sale de la fuente para entretenerla y que volviéramos a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370114,
					"content": "Mis cálculos fueron correctos y logré engañar a Kératry con mi “magia”, pero entonces se obsesionó con que quería que le enseñara a hacer esa magia en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370115,
					"content": "Al llegar a casa, me inventé un par de cosas para satisfacer su curiosidad y logré que se fuera a dormir. Yo también volví a mi habitación y papá y mamá llegaron poco después. Todo parecía muy normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370116,
					"content": "Pero al día siguiente, cuando fui a comprar el periódico para mi padre, vi que la fuente no funcionaba. ¡Estaba rota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370117,
					"content": "Sí que era fuerte tu magia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "¡Por favor, no te rías de mí! Si Kératry le cuenta algo a mis padres, ¡estaré acabado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370120,
					"content": "“Vaya, la fuente de la plaza no funciona. Querido, ¿sabes qué le pasa?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370121,
					"content": "“Qué extraño... Funcionaba cuando fuimos a ver la ópera de la otra noche”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370122,
					"content": "“¡Yo sé por qué es! ¡Es porque Remaudière hizo que la fuente parara! ¿Verdad? ¿Verdad, Remaudière?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370123,
					"content": "¡También se te da muy bien actuar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "Y entonces, mis padres descubrirán que el otro día salí de casa con mi hermana, me darán una buena reprimenda y no tendré vida durante dos meses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370126,
					"content": "Pero alguien se tiene que encargar de esta fuente, ¿no? Si está rota, ¡llama a alguien para que la repare y ya está!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370127,
					"content": "Sí, ya hablé con Edel, el encargado de la fuente. Me prometió que la repararía pronto, pero... hoy todavía no ha empezado a hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370128,
					"content": "Ya no puedo seguir ocultándolo por mucho más tiempo. Este es el fin... ¡el fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370129,
					"content": "Iré a preguntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "¿En serio? ¿De verdad vas a ayudarme? Entonces, yo... ¡te daré el poco dinero que tengo ahorrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370132,
					"content": "Edel está por allí, así que puedes ir a preguntarle cuando quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370130,
					"content": "Bah, qué tontería. Yo te echaré una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "Es como si lo hubiera visto con mis propios ojos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "Después de todo, eres un gran mago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "Alguien llega a la fuente mientras la observan...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
