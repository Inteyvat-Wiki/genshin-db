				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Hola, ¿en qué te puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Tengo una carta para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "¿Una carta?... Oh, es de ella. Apuesto a que está preguntando de nuevo por el próximo equipo de exploración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "*Suspira*, no sé qué puedo hacer, es raro encontrar un equipo que esté dispuesto a hacer frente a la montaña en estos días, es demasiado peligroso allá arriba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "Le escribiré una carta pronto para explicarle la situación. Gracias por hacer el viaje para entregar esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "Hablando de cartas, no hace mucho me envió otra en la que me pedía que preparara una recompensa para ti. Por favor toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "Una última cosa... Puedo ver que eres muy tenaz, sin embargo, te recomiendo que tengas cuidado en las montañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Ah, Espinadragón... Si alguna vez tuviera la oportunidad de liderar allí un equipo de exploradores, ¡seguramente la tomaría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
