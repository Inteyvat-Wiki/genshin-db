				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "¿Pusiste la baliza en su lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "¡Maravilloso! Gracias, ahora finalmente puedo obtener una medición confiable de la altura de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Ah, y con respecto a la compensación, le pedí a Cyrus que hiciera algo. Pregúntale por ella la próxima vez que estés en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "Y como lo verá antes que yo, ¿podría entregarle también esta carta por mí? Prometió mantenerme informada sobre un segundo equipo de exploración que se dirigía a las montañas, pero todavía no he recibido noticias al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Una vez que el resto de mis balizas estén reparadas, tendré que regresar e instalarlas todas. Hay muchas cosas que aún necesitan ser examinadas en esa montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
