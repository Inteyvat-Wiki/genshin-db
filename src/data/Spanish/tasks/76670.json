			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Lyylikki, ¿cómo has estado últimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "¡Ah! Buenos días, Srta. Lauma, todo va muy bien últimamente en la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "¡No han dejado de llegar ingredientes, nadie ha venido a causar problemas y, además, mis habilidades culinarias han mejorado mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "Por cierto, esos “amigos” que mencionó antes... ¿Se refería a los animales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Se portan muy bien, tan solo se quedan mirando fijamente a la gente que hace cola. Quise darles de comer, pero no querían nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "Esos pequeños saben que tienen una responsabilidad y, cuando están de servicio, se mantienen firmes en sus puestos con total concentración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "Sin embargo, cuando hayan terminado su turno, podrías darles un pequeño agasajo. Jeje, estoy segura de que se pondrán muy contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "¡Qué buena idea! Prepararé algo delicioso para agradecérselo como se merecen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Gracias, Lyylikki. Si necesitas ayuda, solo tienes que decírmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "No, no hace falta, puedo encargarme yo. Además, cuento con la ayuda del Sr. Kantor y la Srta. Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Está bien, entonces no te molesto más. Adiós, Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Sí, yo también tengo que ir a servir la siguiente ronda de comida... Ah, por cierto, Srta. Lauma, pruebe este plato, por favor. Lo acabo de preparar y tiene un sabor muy fresco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "Bien, ahora tengo que servir la comida... ¿Eh? ¿Dónde está el plato que acababa de lavar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}