			"dialogs": [
				{
					"id": 401460801,
					"content": "Con el tiempo, el negocio no ha dejado de crecer y expandirse, lo cual abre las puertas a una nueva oportunidad comercial...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
