				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "#¡Hola! Soy Atefeh, comerciante errante de Sumeru. ¡Encantada de conocerl{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460102,
					"content": "¡Vaya, vienes desde muy lejos! ¿La reputación de nuestra tienda ha alcanzado tal envergadura sin darnos cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460103,
					"content": "Todo gracias a ti, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "Jeje. ¡Con todos ustedes, la gran estrella de los negocios, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460106,
					"content": "Jajaja, la verdad es que últimamente muchos comerciantes bien informados han oído hablar de su negocio de pociones alquímicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460107,
					"content": "La mayoría no se atreve a arriesgarse con artículos tan poco comunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460108,
					"content": "Pero, desde mi punto de vista, ¡si uno quiere ser rico, debe aprovechar oportunidades comerciales como esta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460109,
					"content": "Aunque la mayoría de la gente todavía no entiende muy bien el asunto de las pociones alquímicas, si usan una buena estrategia de venta y se hacen un hueco en el mercado, ¡les caerán los Moras del cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460110,
					"content": "Si se genera la suficiente demanda, los precios podrían multiplicarse por diez... Jeje, con semejante margen de beneficio, podrían irse de vacaciones el resto del año si lo desean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460111,
					"content": "¿Multiplicarse por diez? ¿Lo dices en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460112,
					"content": "Jeje, siempre y cuando haya gente dispuesta a comprar sus productos, no importará cuán alto sea el precio. Es la ley de la oferta y la demanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460113,
					"content": "La forma en la que hablas le recuerda a Paimon a otra comerciante obsesionada con el Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460114,
					"content": "Espera, si vienes de Sumeru... debes de conocer a Dori, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460115,
					"content": "¿Dori? ¿Acaso te refieres a Dori, la magnate Sangemah Bay? ¿De verdad conocen a alguien de tanto nivel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460116,
					"content": "Es amiga mía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "¡Increíble! La magnate Sangemah Bay es mi ídolo. ¡Su olfato para los negocios y su dedicación al Mora me resultan inspiradores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460119,
					"content": "Una vez, tuve la fortuna de visitar el Palacio Alcazarzaray. ¡Qué residencia tan magnífica y hermosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460120,
					"content": "Un día, llegaré a ser como ella. Tendré más Moras de los que pueda contar, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460121,
					"content": "Eh... Parece que se ha puesto a soñar despierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460122,
					"content": "Que tengas suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "¡Gracias por los buenos deseos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460126,
					"content": "#Bueno, hablemos sobre cómo nos vamos a hacer ric{F#a}{M#o}s junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460127,
					"content": "En realidad, se trata de una idea muy sencilla. Ustedes producen las pociones, me las suministran de forma regular, ¡y yo les ayudaré a venderlas por otros lugares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460128,
					"content": "Si están de acuerdo, podemos empezar a hablar sobre el lote de pociones que venderemos ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460129,
					"content": "¿Qué pociones requieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "Según mis agudos sentidos mercantiles, estas son las pociones que tendrán más demanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460131,
					"content": "Puede que más tarde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "#Las oportunidades de hacerse ric{F#a}{M#o}s no esperan a nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460124,
					"content": "Vamos al tema que nos ocupa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "*Ejem*, perdón, me estaba yendo por las ramas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460117,
					"content": "Hemos coincidido alguna vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Parece que nuestro esfuerzo está dando resultados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
