					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090502,
					"content": "#Lily, {NICKNAME}, regresaron. ¿Qué tal les fue? ¿Encontraron a los perros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090503
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090503,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090504
					]
				},
				{
					"id": 700090504,
					"content": "¡Sí! Gracias, Blans, ¡nos divirtimos mucho con ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090505
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090505,
					"content": "Qué bien. Cierto, si tienen tiempo, podrían ir a mirar donde Flora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090506
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090506,
					"content": "Después de todo, es el Festival de las Flores de Viento. Sería bonito llevarse un ramo de flores ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090507
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090507,
					"content": "#Guau... Yo quiero ver, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090508
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090508,
					"content": "Pues vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090509
					]
				},
				{
					"id": 700090509,
					"content": "¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
