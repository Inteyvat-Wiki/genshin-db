			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "Señor, ¿los Fatui celebran el Festival de las Flores de Viento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090102,
					"content": "*Suspira*, yo no puedo celebrarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090103,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "¿Eh? Ah, hola. ¿Por qué tienes esa expresión de sospecha otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090105,
					"content": "Solo estoy hablando con esta niñita, ¡no hice nada malo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090106,
					"content": "¿Así que los Fatui no celebran el Festival de las Flores de Viento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "#¿Tú tampoco celebras el Festival de las Flautas de Cuento, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090108,
					"content": "#Seguro que {F#la Caballera Honoraria}{M#el Caballero Honorario} de Mondstadt tiene mucho trabajo que hacer y tampoco debe poder celebrar el festival, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090109,
					"content": "No hace falta que lo digas con ese tono.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "*Ejem, ejem*, olvídalo. No hablemos más. Si estás libre, ¿podrías echarme una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090111,
					"content": "Los padres de esta niña tuvieron que ir a comprar algo para este ruidoso festival y la dejaron aquí al cuidado de las monjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090112,
					"content": "Pero, como ya sabes, durante el festival todo el mundo está ocupado dentro y fuera de la ciudad. Las monjas están cada una en lo suyo y no tienen tiempo de jugar con esta niña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090113,
					"content": "Por eso no deja de seguirme y de pedirme que juegue con ella. Pero tú sabes que no puedo dejar la catedral, así que solo puedo conversar aquí con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090114,
					"content": "Es una pena. Soy un Fatui, aunque se trate de hablar con una niña, la hermana de allí no deja de observarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090115,
					"content": "Debe estar pensando que, como soy un Fatui, tengo malas intenciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090116,
					"content": "¡Hum! Para que esa monja no se acerque a molestar y por el bien de esta niña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090117,
					"content": "#... quisiera pedirte, {F#honorable y honesta Caballera Honoraria}{M#honorable y honesto Caballero Honorario}, que juegues con ella afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090118,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "#Vaya, qué direct{F#a}{M#o} has sido. Era de esperarse {F#de la Caballera Honoraria}{M#del Caballero Honorario}. Y yo que pensaba que tratarías de negociar conmigo una recompensa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090120,
					"content": "Date prisa, ve a jugar con la niña. Yo me quedaré aquí a seguir siendo observado por esas monjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090121,
					"content": "*Suspira*, ¿cuánto falta para que se acabe el día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090122,
					"content": "En realidad, solo quieres que Lily se divierta, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "N-no te confundas. Nosotros, los Fatui, somos malos. Ese tipo de buenas intenciones no cabe en nuestros corazones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090124,
					"content": "Bueno, suficiente. Apresúrate y lleva a esta niña a jugar. Si no, se va a sofocar en esta catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090125,
					"content": "Yo me quedaré aquí a seguir siendo observado por esas monjas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090126,
					"content": "*Suspira*, ¿cuánto falta para que se acabe el día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
