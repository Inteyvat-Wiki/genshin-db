					"nextDialogs": [
						700090404
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090404,
					"content": "Y que los de ellos son muy grandísimos y peludísimos... Seguro son muy suaves también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
