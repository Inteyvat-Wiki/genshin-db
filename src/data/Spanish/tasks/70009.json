						700090604
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090604,
					"content": "#¿Lily? ¿Qué haces con {F#la viajera}{M#el viajero}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090605
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090605,
					"content": "#Papá y mamá tienen algo muy impotante que hacer, por eso {NICKNAME} juega conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090606
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090606,
					"content": "Así que algo importante... Lo suponía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090607
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090607,
					"content": "Bueno, no hablemos de eso. ¿Qué necesitan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090608
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090608,
					"content": "Venimos a ver las flores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090609
					]
				},
				{
					"id": 700090609,
					"content": "Ah, vienen a mirar. Afortunadamente, justo aquí tengo un diente de león que quiero regalarte, Lily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090610
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090610,
					"content": "¿En serio? Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090611
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090611,
					"content": "Vaya, eso no me lo esperaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090612
					]
				},
				{
					"id": 700090612,
					"content": "En realidad... es porque el Sr. Rudolf hace un momento me encargó un gran ramo para la Srta. Jilliana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090613
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090613,
					"content": "Obsequiarle un diente de león no es nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090614
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090614,
					"content": "¡Qué bonito! Tengo que volver ya. Si papá y mamá regresan y no me encuentran, se preocuparán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090615
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090615,
					"content": "#Pero antes... {NICKNAME}, ¿sabes dónde puedo encontrar una sartén muy grandísima en la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090616
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090616,
					"content": "He visto a mamá hacer pancheques y quiero hacerte unos por haber jugado conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				}
			]
		},
