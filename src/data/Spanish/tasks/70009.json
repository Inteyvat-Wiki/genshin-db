			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lily"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "¿Por qué el Sr. Flauti no celebra el Festival de las Flautas de Cuento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090202,
					"content": "Es porque tiene un trabajo importante que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "¿Impotante?... ¿Más impotante que el Festival de las Flautas de Cuento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090207,
					"content": "Pero para ser bueno, solo tiene que dejar de hacer esas cosas, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090208,
					"content": "¡Sí! Voy a decir al Sr. Flauti que, si se porta bien, ¡lo dejarán celebrar el Festival de las Flautas de Cuento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090209,
					"content": "#Ahora está muy ocupado. Mejor vamos a jugar nosotr{F#as}{M#os}, ¿sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "*Suspira*... está bien. Entonces, ¿vamos a jugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090211,
					"content": "Claro, pero no nos alejemos mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "¡Yuju! ¡Rápido, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090204,
					"content": "Tal vez los Fatui no tienen permitido participar en el festival.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "¿Por qué? ¿Es porque los Flauti son los malos? Papá dice que no cepillarse los dentes antes de domir y agarrar la comida con la mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090206,
					"content": "es portarse muy, muy mal. Seguro que el papá del Sr. Flauti tampoco gusta esas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
