						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "#¿Viajer{F#a}{M#o}? ¿Pasó algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090303,
					"content": "Estás con... ¿Lily? ¿Qué haces aquí sin tus padres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090304,
					"content": "#Papá y mamá tienen algo muy impotante que hacer, por eso {NICKNAME} juega conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090305,
					"content": "¿Algo muy importante dices? Rudolf y Jilliana, de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090306,
					"content": "Blans, ¿dónde están los perritos de hace un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090307,
					"content": "¿Los perritos? Humm... No lo sé, normalmente se esconden en su casita. Solo se acercan cuando pongo comida en el plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090308,
					"content": "Tal vez huyó con los demás porque la ciudad está muy ruidosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090309,
					"content": "¿Por qué lo preguntas, Lily? ¿Quieres jugar con ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090310,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090311,
					"content": "Ah, ya veo... Creo que no los encontrarán fácilmente. Mejor vayan allá y pongan comida en el plato para atraerlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090312,
					"content": "Humm, a ver... Lo mejor que pueden ponerles es carne de ave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090313,
					"content": "Oh... ¿Pero a dónde encontramos eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090314
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090314,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090315
					]
				},
				{
					"id": 700090315,
