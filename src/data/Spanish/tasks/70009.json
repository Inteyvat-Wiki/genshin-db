					"nextDialogs": [
						700090808
					]
				},
				{
					"id": 700090808,
					"content": "No se ve... nada mal. Nunca me imaginé que tuviera tal habilidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090809,
					"content": "Jiji, aprendí de mamá. Señor, cuando termine de comer, ¡me gustaría que me cuente otra historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090810,
					"content": "¿Quieres... otra historia...?",
