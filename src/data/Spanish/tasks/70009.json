					"nextDialogs": [
						700090402
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090402,
					"content": "¡Guau, vinieron! Jiji, quiero acariciarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090403
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090403,
					"content": "Jiji, qué suaves son... El Sr. Flauti me contó que donde él vive tienen muchos perritos.",
