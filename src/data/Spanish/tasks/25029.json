					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290220,
					"content": "¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290223,
					"content": "#Entonces, ¡contamos contigo, amig{F#a}{M#o} aventurer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290224,
					"content": "Nosotros nos encargaremos de medir el tiempo que tardas en subir la montaña desde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290225,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290221,
					"content": "Presten mucha atención, ¿de acuerdo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "¡Por supuesto que sí! ¡Qica y yo no te quitaremos los ojos de encima esta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290212,
					"content": "Parece que se está recuperando bien.",
