					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370201,
					"content": "¿Pero de dónde han salido estos champiñones?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370202,
					"content": "¡Vine para limpiar los champiñones!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "¿Te envió el señor Vahid para que me ayudaras a deshacerme de ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370206,
					"content": "Entonces son todos tuyos. Hay demasiados champiñones en el campo. No es un trabajo para un anciano como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370207,
					"content": "¿Cómo crecieron tan rápido estos champiñones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370203,
					"content": "¡Perdone las molestias!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "Ah, ¿los champiñones? Bueno, a mí desde luego que no me faltan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
		{
			"id": 2203703,
			"completionStepIds": [
				2203703
			],
