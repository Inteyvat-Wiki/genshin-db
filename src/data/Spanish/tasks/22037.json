				},
				{
					"id": 220370404,
					"content": "Aquí tengo todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370405
					]
				},
				{
					"id": 220370405,
					"content": "Había muchos champiñones, pero parece que los recogiste todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370406
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370406,
					"content": "#Gracias, jovencit{F#a}{M#o}. No sé qué habría hecho sin tu ayuda. Toma esto como muestra de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370407
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370407,
					"content": "He de decir que estos fertilizantes son bastante sorprendentes. Los hongos crecieron a toda velocidad. Si también pudieran ayudar a los cultivos a crecer así de rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370408
					],
					"speakerTitle": "Konda Densuke"
				},
				{
