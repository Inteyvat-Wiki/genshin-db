			"dialogs": [
				{
					"id": 220370301,
					"content": "¿Los quitaste todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "Aquí tengo todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "¿Eso es todo? Recuerdo que había muchos más. ¿De verdad los quitaste todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "#En cualquier caso, muchas gracias, jovencit{F#a}{M#o}. Acepta esto como pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "He de decir que estos fertilizantes son bastante sorprendentes. Los hongos crecieron a toda velocidad. Si también pudieran ayudar a los cultivos a crecer así de rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "Cuando tenga tiempo, compraré más y los probaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
