			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "¡Genial! ¡Funciona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "El casco no tiene problemas estructurales, y la línea de flotación es estable, no hay inclinación alguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "¿Lo has visto, Chishan? ¡Mi diseño y mis cálculos son perfectos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Esta es solo la primera etapa de la prueba de carga. No te emociones tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230210805,
					"content": "Ni siquiera tuviste en cuenta el clima y el centro de gravedad del barco debido al desplazamiento de la carga durante la navegación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230210806,
					"content": "Pues... Lo tendré en cuenta. Pero déjame ser feliz un minuto al menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "#Ah, sí, muchas gracias por tu ayuda, viajer{F#a}{M#o}. Aquí tienes la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Chishan, ¿no podrías alegrarte por mí solo por esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "Cuando se trata de construcción naval, no puedes emocionarte tan rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230210810,
					"content": "Deberías estar pensando en cómo ganar dinero con todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chishan"
				}
			]
		},
