			"dialogs": [
				{
					"id": 160111101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "... Camina hacia adelante y no mires atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160111103,
					"content": "“Varka... Ahora, yo entender el significado de mi nombre”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "“... Después de todo lo que nos has hecho pasar a todos, más te vale agradecérnoslo como es debido cuando regreses”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 160111105,
					"content": "“Sabes, tengo muchas cosas que contarte... pero pueden esperar a que vuelvas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "“No tengo intención de volver a los Caballeros de Favonius... Pero confío en que encontrarás la manera de arreglártelas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "... “Gran Maestro, todos le estamos esperando”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "¿Eh?... Ah. Je.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "No lo estoy haciendo tan mal como Gran Maestro, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "... Tomaré ese silencio como una aprobación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "Todo lo que juraron proteger con sus vidas... Sigue aquí, sano y salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "Los Caballeros de Favonius, Mondstadt... y el juramento que hizo cada Caballero. Lo protegeré todo con mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "Así que... Entregaré la carta en su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "... Sé que eres solo una sombra del verdadero Roland, pero... si tienes tiempo, ¿podrías leerla por él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "Rostam y Arundolyn... Nunca te olvidaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "*Suspira*... Esta ha sido una expedición muy larga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "A partir de ahora, creo que voy a dejar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "... “Que el viento me guíe”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 160111130,
					"content": "... Vaya, cuánto tiempo sin vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "Estoy... encantado de verlos a todos de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "Bienvenido, Gran Maestro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "... Sí, por fin estoy de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111124
					],
					"speakerTitle": "Varka"
