						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110202,
					"content": "... ¿La espada está intacta? Pero no siento el espíritu del lobo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110203,
					"content": "(... Parece que ya no estoy en la realidad. Este debe ser un espacio creado a partir de las consciencias entrelazadas de Boreas y Roland.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110204,
					"content": "No hay vuelta atrás, y lo único que hay por delante son las fauces del lobo... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110205,
					"content": "Ja, pues tendré que entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601107,
			"completionStepIds": [
				1601107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
