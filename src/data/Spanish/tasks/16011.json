					}
				]
			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "¿Esto es... el “corazón” del lobo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110702,
					"content": "¡...! ¡Roland!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "... Como desees, Caballero de Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Ja, no eres como te imaginaba. No pareces tan desquiciado como en los recuerdos de los fragmentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Jamás me he desviado del camino correcto. Y tú... ahora mismo no pareces el héroe capaz de matar dragones, sino más bien un caballero caído... que ha vagado durante demasiado tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Lo mismo digo. Parece que ninguno de los dos está en su mejor momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "El ejército del Cazador de la Luna ha sido derrotado, y el “yo” simulado por el Abismo no es más que un reflejo incompleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Su poder ha alcanzado el límite de Roland, pero su espíritu permanece estancado en aquel momento teñido de sangre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "Por lo tanto, “yo” tampoco soy correcto... y un caballero no puede permitirse estancarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Después de redimirte de la injusticia y guiarte hacia el Abismo, yo mismo me enmendaré y continuaré siguiendo el camino de la caballería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Ja, el mundo ya no aguanta más tus estragos... Tu obstinación es tal y como la imaginaba. Parece que no tengo forma de convencerte, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Las virtudes que profesa un caballero no pueden ser mancilladas por meras palabras, sin importar cuán nobles sean. Ninguno de los dos puede convencer al otro, y eso ya lo sabías desde hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "De lo contrario, ¿por qué habrían depositado todas sus esperanzas en un “anhelo” de Boreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Pero la espada que usabas para albergar el espíritu del lobo se hizo añicos, y lo que ahora empuñas no es más que una ilusión que conserva su forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Ya no tienes medios para cambiar nada, ni refuerzos que esperar... Este lugar será el fin de tu camino, expedicionario solitario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "Ja, puede que lo de los medios sea cierto, pero los refuerzos... ¿acaso no tenemos a alguien aquí mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "... ¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "Y ese es el único al que quería persuadir desde un principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "¿Ya olvidaste dónde estamos? Este es el corazón de Andrius, el Dios del Viento del Norte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "¡Andrius! ¿Puedes oírme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "¡Despierta! ¡Eres el gran Dios del Viento del Norte! ¿Cuánto tiempo más vas a permitir que el Abismo te domine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "Si esto es todo lo que tienes, me decepcionas, Caballero de Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "El ímpetu y los deseos no invocan milagros. Este mundo nunca ha sido tan benevolente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "... Regresar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "...Regresar a... las líneas ley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "... Esta es “mi” elección... Son “mis” recuerdos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "¿Es la respuesta que “yo” encontré... al final de mi viaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "And{RUBY#[D]Boreas}rius... Me aseguré de entregar tu amuleto directamente a “tu” corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "Oh... El Caballero de Boreas, ¿eh? Observa bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "... Esto es lo único que un lob{RUBY#[S]yo}o puede hacer por los hum{RUBY#[S]ustedes}anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "... En nombre de los humanos de este mundo, te doy las gracias, Señor de los Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Boreas... está regresando a las líneas ley. ¿Por qué? Tu espada está destrozada, ya no tienes ningún recipiente para su alma. No, a menos que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Por supuesto que sé que ni el ímpetu ni los deseos pueden invocar milagros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "... Pero una espada es solo un tipo de recipiente. Hay otras formas de almacenar un alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "El Señor de los Lobos otorgó antaño el poder de su alma a su manada, fortaleciendo sus corazones y afilando sus garras y colmillos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "... Aunque no sea mi intención, el alma del Rey Lobo inevitablemente devastará, devorará y asimilará un corazón mortal... Como si humano y lobo se fusionaran a la fuerza en un solo ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 160110938,
					"content": "... Si un corazón mortal ha de portar el alma de un dios... Es un camino sin retorno. Aun así, no disuadiré a un caballero de emprender la gesta que él mismo ha elegido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "El Capitán"
				},
				{
					"id": 160110939,
					"content": "Tu corazón, tu alma... ¿también se están desintegrando?... Ya veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "“¿Cómo puede un cordero atar un cascabel al corazón de un lobo?”... Eso fue lo que preguntaste una vez, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Esta es mi respuesta: haz que el lobo se trague el corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "La parte del espíritu del lobo en la espada no era más que una distracción. Los verdaderos pensamientos y recuerdos los porta tu corazón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Para evitar que me diera cuenta, dejaste que el alma del Rey Lobo se fusionara contigo a propósito, para que luego yo la devorara... ¿Todo este tiempo has estado luchando cargando con ese peso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "Comparado con la determinación del Rey Lobo... este sacrificio no es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "Una voluntad inquebrantable, una estrategia brillante... Pero esta no es la forma de luchar de un caballero. Por eso mismo, tu elección fue un error.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "Tu alma se ha fusionado con la de Andrius. Cuando él se haya unido por completo a las líneas ley, tú también caerás con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "#Cuando llegue ese momento, ni Barbatos ni {F#la}{M#el} viajer{F#a}{M#o} que te acompaña podrán anclar tu alma desde las líneas ley, y mucho menos rescatarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Has perdido, y yo también. Lamentablemente, ya no puedo salvarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "... Que tu alma descanse en paz con el Viento del Norte, expedicionario solitario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "... Jaja, ¿solitario?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Siento decepcionarte, pero... por muy perfecto que sonara ese final en el que ambos regresamos juntos a las líneas ley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "La verdad es que, a diferencia del verdadero Roland del pasado, aún tengo buen vino y buenos amigos esperándome, aguardando mi regreso triunfal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "¡Así que todavía no estoy listo para aceptar mi destino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "¡Tilín! ¡Hay una carta para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1601111,
			"completionStepIds": [
				1601111
