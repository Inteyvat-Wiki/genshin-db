			},
			"dialogs": [
				{
					"id": 402461001,
					"content": "¡Está bien! Podría decirse que hemos arreglado ese desastre del pasado. Ya me siento mucho más aliviada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461002,
					"content": "Hacer una buena acción de vez en cuando es bastante agradable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461003
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461003,
					"content": "En Nod Krai también ayudaste a tus amigos en muchas ocasiones. ¡Siempre has sido buena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Je, quién sabe. Yo terminaré volviendo con los Fatui. ¿De verdad confían tanto en el bien de la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461005,
					"content": "Sabemos que al menos podemos confiar en ti, Sandrone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "Hum, no digan que no les avisé si luego lo pasan mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461007,
					"content": "¿A dónde vamos ahora? ¿Regresamos al barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461008,
					"content": "Eso, tú ya has resuelto tus asuntos, Sandrone, al igual que las cosas del pasado. Es hora de que tus amigos sepan que estás bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "¡Todos se pondrán muy contentos al ver que has vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Ja... En el pasado no lo hubiera admitido, pero... Es cierto que los he echado a todos de menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461011,
					"content": "¡Pero Colombina es una excepción! ¡Esta vez tengo que vengarme de ella por todas las veces que viene a incordiarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
