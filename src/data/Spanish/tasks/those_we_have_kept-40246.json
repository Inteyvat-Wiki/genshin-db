			"dialogs": [
				{
					"id": 402461201,
					"content": "¡Hemos venido, Citlalí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Oh, qué puntuales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461203,
					"content": "Tú... ¿Estás bien después de beber tanto ayer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "¿Quién crees que soy? Eso no fue nada para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461205,
					"content": "Pero si acabaste diciendo cosas sin sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "¿S-sí? ¿Y por qué no me acuerdo? No habré dicho nada... terrible, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461207,
					"content": "Estuviste hablando pestes de tu nieto media hora, quejándote del trabajo en los Augures Vientonocturno otra media hora, una hora entera hablando de novelas ligeras... Y luego, eh... Paimon se quedó dormida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "... ¿Se han ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461209,
					"content": "¿Quiénes? Oh, te refieres al equipo de producción. Sí, se han ido ya, acabamos de verlas en cubierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Aunque ya que has solucionado tu problema, ¿por qué sigues sin ir a ver a Colombina? Está claro que tiene muchas ganas de verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Yo... quiero resolver primero ese desastre que tengo entre manos antes de verla. Además, ahora que cuento con la oportunidad perfecta para darle un buen susto, ¡debo planearlo todo al milímetro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461212,
					"content": "Dejemos el tema. ¿Han encontrado la ubicación de esa acumulación de corrupción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461213,
					"content": "Claro que sí. Si la abu Itztli dice que puede hacer algo, es que puede hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461214,
					"content": "Buen trabajo. A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461215,
					"content": "El Condado Morte... ¿Oh? ¿No es esa la Torre de la Gestalt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461216,
					"content": "El lugar donde las almas fueron separadas... ¿Es esa la fuente de su resentimiento? ¿O la Cruz de los Narcisos en general?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461217,
					"content": "Yo iré con ustedes, este tipo de cosas no suelen aparecer en un lugar fijo. Si no está allí, podría realizar un ritual para invocarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461218,
					"content": "¿De verdad? Pero este tema ya te ha dado suficientes problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461219,
					"content": "No es nada, estos viejos huesos no tienen mucho más que hacer ahora mismo. Ayudar a una jovencita a invocar un espíritu no es algo que vaya a agotarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461220,
					"content": "(Si no voy, ¿quién sabe de qué otro tema hablarán en el que yo no pueda participar?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402461221,
					"content": "Bien, muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461222,
					"content": "Jeje, no hay tiempo que perder. ¡En marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
