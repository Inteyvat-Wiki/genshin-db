					}
				]
			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "¿Ya ha terminado?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Así es. Les dije que se trataba de algo sencillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460903,
					"content": "¿Cómo lo has hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460904,
					"content": "Esa criatura no era especial. Si juntas un montón de almas sin un lugar al que ir, un toque de energía malévola, unas cuantas impurezas y una buena cantidad de resentimiento... ese es el resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460905,
					"content": "Lo único que hice fue separar sus almas originales de toda esa corrupción para que pudieran ser aceptadas por las reglas que rigen el mundo actualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460906,
					"content": "El principio detrás de la fórmula del mundo es la divergencia. Comenzando desde el punto de origen, deconstruye y reconstruye las posibilidades del mundo para encontrar ciertas respuestas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460907,
					"content": "Por eso tenía sentido que, al calcular de forma inversa la fórmula del mundo, pudiéramos lograr la convergencia y la restauración. Lo he conseguido usando mi matriz aritmética.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460908,
					"content": "Es algo similar al concepto de la reducción homológica en las matemáticas. Las reduje a la esencia más básica y fundamental de su ser sin cambiar su naturaleza subyacente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460909,
					"content": "Así que... Eh, no importa. Por las caras que ponen, no parece que quieran saber de estas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460910,
					"content": "Creo que acabo de comprender qué sienten los forasteros al oír hablar a los chamanes de los Augures Vientonocturno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460911,
					"content": "B-bueno, ¡la cosa es que sabemos que has hecho algo genial! ¡Eres increíble, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Qué gracia, ¡yo siempre he sido increíble! Jajaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460913,
					"content": "No podíamos esperar menos de la Descifradora de Toda Razón...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "¡Eh, ya basta con eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460915,
					"content": "B-bueno, ¡es hora de irse! Yo voy a restaurar los mecanismos de la Torre de la Gestalt. ¡Nos vemos en la orilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
