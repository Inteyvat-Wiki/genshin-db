				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "#¿List{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460702,
					"content": "Sí. Intentaré comunicarme con ellos primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460703,
					"content": "Pero me temo que este cúmulo de espíritus ya ha perdido la razón. Si no logramos comunicarnos, es probable que esto acabe en un combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460704,
					"content": "Si la cosa se pone fea, Paimon encontrará un lugar donde esconderse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Sí, si tenemos que acabar a puñetazos, dejen que yo dé el último. Ustedes no hagan nada, confíen en mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460706,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460707,
					"content": "Muy bien, permanezcan en silencio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460708,
					"content": "... Espíritus errantes que deambulan con la marea, yo los invoco. Almas fragmentadas, separadas, abandonadas y obligadas a guardar silencio, sigan el rastro del pasado y vengan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460709,
					"content": "... ¡Que el rencor reconozca al rencor! ¡Que las entidades malignas se atraigan entre sí y tomen forma en este lugar una vez más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(¿Y ahora qué? ¿Ya ha terminado?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460713,
					"content": "(Arg... Por esto mismo trabajo con las matemáticas y no con la magia. ¿Cómo se supone que vamos a saber en qué estado se encuentra el hechizo? Es como si no hubiera ninguna lógica en todo esto.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460714,
					"content": "(Es completamente diferente a la ciencia de la mecánica que tan bien conozco...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460715,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460716,
					"content": "¡Cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460717,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Rencor de almas errantes"
				},
				{
					"id": 402460718,
					"content": "¡Eh, ustedes! O quien sea que haya dentro... ¿Pueden entenderme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460719,
					"content": "Soy descendiente del gran rey de la mecánica de Fontaine, Alain Guillotin. Puedo restaurarlos y devolverlos a las líneas ley. Tan solo necesitarán cooperar conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460720,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Rencor de almas errantes"
				},
				{
					"id": 402460721,
					"content": "¡Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "*Tch*... Parece que hablar no es una opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460723,
					"content": "Bueno, plan B... ¡Es hora de desahogarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
