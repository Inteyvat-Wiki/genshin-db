			"dialogs": [
				{
					"id": 402460501,
					"content": "Parece que no está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460502,
					"content": "¿Quieres que comience con el ritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 402460503,
					"content": "Espera un momento, drenemos primero el agua de este piso de la Torre de la Gestalt. Así nos resultará más sencillo movernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460504,
					"content": "¿De verdad podemos drenar el agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Pues claro. Después de que Alain y René descubrieran el destino de Fontaine por separado, ambos compartieron algunos métodos de prevención de inundaciones para edificios. El principio es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460506,
					"content": "*Ejem*, me estoy yendo por las ramas. Limítense a activar los mecanismos según el orden que les diga y ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
