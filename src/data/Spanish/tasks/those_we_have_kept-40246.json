				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Ayer Citlalí bebió demasiado, Paimon se pregunta si habrá despertado ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Buenos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460203,
					"content": "¡Aaah! ¡Colombina! ¿Qu-qué haces aquí? Mejor dicho, ¿por qué te gusta tanto aparecer por la espalda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "Esta mañana vine con los demás a rodar una escena que nos faltaba, y acabamos de terminar. He venido a cubierta a tomar el aire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460205,
					"content": "Creo que los demás siguen abajo hablando sobre el acto final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460206,
					"content": "¿El acto final?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Sí, el final de la kinografía. Están considerando si la protagonista de la historia encontrará o no a su antigua amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460208,
					"content": "Ah... Porque lo importante es que vino a la tierra de su amiga para buscarla, ¿verdad? A Paimon casi se le olvida la trama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Sí. La directora Furina y Chiori piensan que un final trágico en el que ambas no se llegan a encontrar sería más conmovedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460210,
					"content": "El director Xavier cree que un final en el que se encuentren sería más conmovedor, casi sanador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460211,
					"content": "¿Y tú qué piensas, Colombina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "¿Yo? Pues... no lo sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460213,
					"content": "Si se tratara de mí, me gustaría encontrarme con ella... Sigo esperando que podamos volver a vernos... aunque sea en una kinografía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460214,
					"content": "Pero teniendo en cuenta que eso significaría que otra persona tendría que interpretarla, me siento un tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Bueno, no te preocupes por eso ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460218,
					"content": "Eso, eso. No te pongas triste por todo esto. ¡Deberías estar disfrutando de poder rodar una kinografía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "Además... ¡Paimon se arriesgaría a prometerle a Colombina que todo saldrá bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "¿Saldrá bien? ¿A qué te refieres?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460221,
					"content": "Eh, a... a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "A que habrá un buen final.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "¡Eso! ¡Eso quería decir Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Ja... Está bien. Confío en ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460225,
					"content": "Entonces haré lo que dicen y disfrutaré del rodaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460226,
					"content": "#¿Oh? ¡Pero si son {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "#¿Oh? ¡Pero si son {F#la iluminadora}{M#el iluminador} y la claquetista que se escabullen del trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "Eh... Lo sentimos... Es cierto que hemos pedido varios días libres durante el rodaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "Jeje, es solo una broma, no se lo tomen en serio. El rodaje ha ido muy bien, así que pueden ocuparse de sus asuntos tranquilamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Gracias por comprenderlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Vaya, parece que Colombina está de mejor humor. Ah, siento si te incomodó que habláramos antes del final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#No pasa nada, ya estoy bien. {NICKNAME} y Paimon me ayudaron a pensar con claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460234,
					"content": "Oh, ¿entonces te gustaría rodar el final en el que se encuentran o en el que no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "Me gustaría rodar un buen final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402460236,
					"content": "... ¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "Se lo compensaremos luego...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
