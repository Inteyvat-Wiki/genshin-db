					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402461102,
					"content": "Oh, Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402461103,
					"content": "Cállate. Ya te había dicho que no podías llevarme a sitios tan extraños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461104,
					"content": "P-pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402461105,
					"content": "¡Oh, increíble! ¡Esto es genial! ¡Es justo el final que quería, la escena que anhelaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Productor kinográfico"
				},
				{
					"id": 402461106,
					"content": "... ¡¿Cómo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461107,
					"content": "¿A dónde has ido, Colombina? ¿Cómo has desaparecido de golpe del set y has... aparecido abrazada a esta chica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "E-estaban... r-rodando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461109,
					"content": "Todo ha pasado muy deprisa y el Daguerrotipo seguía funcionando, así que todo ha quedado grabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "¿Ella es...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Sí, es mi mejor amiga. No imaginaba que volvería a verla de verdad. ¡Qué alegría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402461112,
					"content": "Parece que la kinografía ha tenido un buen final, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402461113,
					"content": "(¿Sandrone?...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 402461114,
					"content": "Lo sabía... ¡¡Sabía que seguirías siendo todo un incordio, Colombinaaa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
