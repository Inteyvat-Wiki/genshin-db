					"speakerTitle": "Akim"
				}
			]
		},
		{
			"id": 2300803,
			"completionStepIds": [
				2300803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300803",
							"2"
						],
						"stepId": 2300803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "¡Excelente! Con esto bastará. Dame un minuto y estará listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080302,
					"content": "Esperas un rato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "¡Eureka, estaba en lo cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080304,
					"content": "El barro húmedo tiene una gran adherencia, pero cuando se solidifica, se rompe fácilmente. Sin embargo, si lo mezclo con el barro de la Megaflora, adquiere cierta flexibilidad incluso tras solidificarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080305,
					"content": "El problema estaba en que carecía de plasticidad cuando aún estaba húmedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080306,
					"content": "Sin embargo, tras añadirle el barro que había estado en contacto con los Slimes, adquiere una mejor elasticidad antes de solidificarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080307,
					"content": "No tengo claro por qué, pero si tuviera que describirlo, diría que es como si el barro se hubiese convertido en algo parecido a un Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080308,
					"content": "“Slime barroso”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Creo que las propiedades de los Slimes se imbuyen en el barro. Por eso estaba pensando que si agrego condensado de Slime a la mezcla, tal vez pueda aumentar su utilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080312,
					"content": "Lo he estado probando y, en función de la cantidad de condensado de Slime que le añada, cambia la plasticidad y la solidez del barro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080313,
					"content": "Por decirlo de otra manera, se convierte en un material que no solo se puede usar para la construcción, ¡sino también en la alfarería y muchas otras cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080314,
					"content": "¡Felicidades!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Muchas gracias. Como dicen los sabios, “Piedra a piedra se levantan las torres”, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080317,
					"content": "Puede que a simple vista no parezca nada excepcional, pero con este barro se podría construir una torre que roce las nubes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080318,
					"content": "Por eso he decidido llamarlo “lodomento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080319,
					"content": "El siguiente paso será experimentar con el lodomento para determinar cuáles son sus posibles aplicaciones prácticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080320,
					"content": "Por fin existe una solución para esos problemas de edificación que tanto tiempo llevan preocupándonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080321,
					"content": "#Muchísimas gracias, viajer{F#a}{M#o}. Aquí tienes tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080315,
					"content": "Tus esfuerzos por fin están dando sus frutos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "¿Quieres probarlo, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "¡Ni hablar, Paimon no va a comer barro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}