			"dialogs": [
				{
					"id": 740812901,
					"content": "¡Otra vez esos temblores y esos golpes! Creí que era el Sr. Eastinghouse que había vuelto y era alguien que activó el dispositivo de afuera sin querer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812902
