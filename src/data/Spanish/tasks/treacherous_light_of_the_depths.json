				]
			},
			"dialogs": [
				{
					"id": 740812401,
					"content": "Las cintas perforadas que tenemos que devolver son estas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812402,
					"content": "Le muestras a Sévigné las cintas perforadas que recuperaste.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740812403
					]
				},
				{
					"id": 740812403,
					"content": "#Así es, son estas. Qué buen{F#as}{M#os} son completando encargos. Lo hicieron a la perfección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740812404,
					"content": "Es un trabajo simple que se puede hacer en un tris tras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812405,
					"content": "¡Qué bien! Lo digo sin exagerar, tengo compañeros que podrían haber tardado un día entero para buscar un documento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740812406,
					"content": "No hablemos más de eso. Les pido que hagan llegar estas cintas perforadas a la Srta. Chisseray, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740812407,
					"content": "Díganle que por el momento no voy a volver. ¡Ah! Díganle también que se ponga en contacto con el Sr. Maillardet para que lleve de vuelta lo antes posibles los prototipos que hay aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740812408,
					"content": "#Eso haremos. {NICKNAME}, ¿volvemos por donde vinimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812409,
					"content": "Ah, no será necesario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740812410,
					"content": "¿Ustedes dos saben bucear? Hay una vía acuática por la que se puede salir de aquí. Se selló de forma temporal para que nadie diera un paso en falso y cayera. Les ayudaré a abrir esa vía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740812411,
					"content": "#¡Qué bien! {NICKNAME}, ¡volvamos por la vía acuática!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812412,
					"content": "La terminal que abre la vía está ahí dentro, puedo ir yo a activarla. No deberían tener problemas para irse por su cuenta, ¿verdad? Espero que no se pierdan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740812413,
					"content": "#¡No nos subestimes de esta manera! Paimon es la mejor guía de Teyvat. Si Paimon está, {NICKNAME} no se perderá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812414,
					"content": "¡Qué fiable! Pues les encargo lo del mensaje y las cintas perforadas. Cuídense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sévigné"
				}
			]
		},
