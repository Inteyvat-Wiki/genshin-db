			"dialogs": [
				{
					"id": 740813101,
					"content": "¡Hola! Tenemos un mensaje de Sévigné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740813102,
					"content": "Le explicas la situación a Chisseray y le entregas las tres cintas perforadas que tienen que devolver.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "La verdad es que estoy preocupada por ella. Estaba considerando ir para ver cómo está. Ahora veo lo que pasó. Les agradezco que me hagan llegar este mensaje. Ah, y las cintas perforadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813104,
					"content": "No esperaba que los prototipos del Sr. Maillardet siguieran funcionando. Si Sévigné sigue trabajando en un ambiente tan peligroso como ese, tendré que comentar el asunto de la recuperación con el administrador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813105,
					"content": "De paso también le puedo preguntar por el pago... Sévigné es muy inteligente, pero el administrador deberá valorar si cumple con las normas, así que de momento les adelanto la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813106,
					"content": "De todas formas, gracias por ofrecerse. Por favor, acepten la recompensa de este encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chisseray"
				}
			]
