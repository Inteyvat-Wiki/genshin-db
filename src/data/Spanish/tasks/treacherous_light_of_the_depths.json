				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sévigné"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4409.336,
							372.716,
							3834.281
						],
						"pointId": 5247
					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3835.364
						],
						"pointId": 6385
					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Ay... ¿No nos habremos metido en un gran problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811702,
					"content": "¡Qué extraño! Acabo de sentir una sacudida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811703,
					"content": "Creo que yo también lo sentí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "Humm, quizá sea porque antes movimos la parte superior del dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811706,
					"content": "¿Esta puerta no estaba cerrada? Coloqué especialmente unos Mecabots para vigilarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811707,
					"content": "Los invité a descansar y luego abrí la puerta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "#Bueno, es que ellos nos atacaron primero. Nosotr{F#a}{M#o}s solo los atacamos en defensa propia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811710,
					"content": "Los prototipos del Sr. Maillardet... En teoría, ¿tendrían que estar apagados? Desde que encontró un buen sitio en las Erinias, casi ya no se pasa por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811711,
					"content": "Pensándolo bien, nadie querría volver a este ruinoso, húmedo y oscuro laboratorio después de haber mostrado los resultados de su investigación en un paisaje tan bonito como una pista de baile rodeada por un jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811712,
					"content": "Después de que el Sr. Bossuet dejara su cargo, todo el mundo se dispersó en distintos lugares del Instituto de Ciencias de Fontaine, como los materiales de aquí. Ni siquiera quedó un sofá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811713,
					"content": "Aquí solo quedan los prototipos que esperan a personas que nuncan van a volver. Antes solo tenían que estar aquí en modo espera, pero ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811714,
					"content": "¡Miren! Está todo patas arriba. Casi tienen el núcleo fuera. Si el Sr. Maillardet lo supiera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811715,
					"content": "Fui yo. Lo siento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Lo sentimos... ¿L-los prototipos son muy caros? Si necesitas una compensación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811719,
					"content": "#No se pongan nervios{F#as}{M#os}. Lo que quiero decir es que si el Sr. Maillardet lo hubiera sabido, seguro que se habría reído a carcajada limpia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811720,
					"content": "De hecho, él mismo solía interrumpir el baile de los prototipos y, después de que fueran derribados, se sentaba en el suelo y se reía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811721,
					"content": "Por cierto, hablé mucho, pero todavía no me he presentado. Soy una investigadora del Instituto de Ciencias de Fontaine, me pueden llamar Sévigné. ¿Y ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811722,
					"content": "#Paimon es Paimon y est{F#a}{M#e} es {NICKNAME}. Nosotr{F#as}{M#os}... Emm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811723,
					"content": "Solo pasábamos por aquí, no teníamos otra intención.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "¡Así es! Solo estábamos de paso, no pensábamos que por aquí hubiera un tesoro o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811726,
					"content": "Oh, ¿exploran ruinas para encontrar tesoros? Entonces, están en el lugar equivocado. Aunque este sitio parecen unas ruinas... Bueno, no lo parecen, lo son.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811727,
					"content": "Sin embargo, no está incluido en los lugares recomendados para un tour por las ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811728,
					"content": "Está bien, entonces nos vamos ahora mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811729,
					"content": "¡Un momento! ¿Conocen el Nuevo Instituto de Ciencias de Fontaine? Si van a ir ahí, háganme un favor: busquen a la Srta. Chisseray.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811730,
					"content": "En realidad, no teníamos la intención de ir al Nuevo Instituto de Ciencias de Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Entonces, ¿qué hago? Todavía me queda trabajo por hacer. Los prototipos del Sr. Maillardet se han estropeado y necesito informar a alguien para que se los lleve de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811733,
					"content": "#Ay, {NICKNAME}, ayudémosla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811734,
					"content": "¡Qué bien! Ya que se ofrecieron para ayudarme a transmitir el mensaje, les pido por favor que también lleven de vuelta las cintas perforadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811735,
					"content": "De haberlo sabido, no hubiera movido el dispositivo de afuera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "No digas eso, tampoco era muy complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811737,
					"content": "Con la excusa de recuperar los materiales de investigación, podré pedir un pago para el encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811738,
					"content": "¿Eh? ¿Estás segura de que si lo hacemos así, no habrá problemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811739,
					"content": "Ayudaron en el trabajo de la investigación, es perfectamente justificable. Claro que no habrá ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811740,
					"content": "Además, si de verdad no cumple con las normas, el administrador lo rechazará. Si eso sucede, yo asumiré los gastos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811741,
					"content": "¿Siempre hacen esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Yo no. Si lo hacen o no los demás, no lo sé. La verdad es que había escuchado algunos rumores, aunque... ¡Ay! No vale la pena comentar esto con personas ajenas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811743,
					"content": "Tienen que recuperar tres cintas perforadas. Bueno, en realidad es que solo quedan tres en las estanterías. Vayan a buscarlas, por favor. No creo que les cueste mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811744,
					"content": "Mientras tanto, yo comprobaré de nuevo los prototipos. De hecho, hace mucho que no les dan un poco de mantenimiento. Será un problema si pierden el control...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811745,
					"content": "De acuerdo, cuando hayamos reunido las cintas perforadas volveremos a buscarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811736,
					"content": "No hay problema, yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Tenemos otros tesoros que buscar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "¿Sabes si hay algún tesoro por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "¿Han considerado incrementar la fuerza de los prototipos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "Sí, eso hizo el Sr. Maillardet. Quizá el producto final cumpla con tus estándares de fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Sévigné"
				},
				{
					"id": 740811708,
					"content": "Eso, qué extraño. ¿Se ha abierto sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Será tu imaginación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
		{
