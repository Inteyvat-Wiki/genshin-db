		},
		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "¡Arrr! ¿Por qué no ha llegado aún?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020202,
					"content": "#No importa. Comencemos con vuestro gran debut, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020203,
					"content": "¡Atención, silencio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020204,
					"content": "Llegó el momento más esperado del Torneo Crux... ¡El combate final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020205,
					"content": "El día de hoy hemos presenciado muchas peleas emocionantes, y ahora ya tenemos dos finalistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020206,
					"content": "#Primero, permitid que presente {F#a la primera}{M#al primer} contendiente. Aunque no {F#la}{M#lo} hayáis visto nunca, seguro que habéis oído hablar de {F#ella}{M#él}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020207,
					"content": "#Infunde el miedo en el corazón de Osial y el simple hecho de mencionar su nombre pone enfermos a los Fatui. Os presento {F#a la heroína viajera}{M#al héroe viajero} de Liyue... ¡{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020208,
					"content": "¡¡Guau!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Participante"
				},
				{
					"id": 20020209,
					"content": "¡Llevaba mucho tiempo esperando este momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Participante"
				},
				{
					"id": 20020210,
					"content": "Estoy segura de que visteis su brillante actuación en las semifinales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020211,
					"content": "¡Pero la final de hoy será de otro nivel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020212,
					"content": "En cuanto al otro combatiente... todavía no ha llegado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020213,
					"content": "¿Qué estará haciendo? No puede simplemente conceder la victoria al ausentarse... ¡Esto es la final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020214,
					"content": "¡Mis disculpas! ¡Esperemos un poco más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020215,
					"content": "¿A lo mejor se ha equivocado de hora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "No hay otra elección... Si no se presenta, habrá que posponer la pelea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020218,
					"content": "Un momento. Algo no encaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020219,
					"content": "Capitana Beidou, deberíamos comprobar que el premio sigue en su lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, acompáñanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020216,
					"content": "¿Quizás no se atreve a pelear en la final?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
