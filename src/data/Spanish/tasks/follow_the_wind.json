			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "¿Eh? ¿Beidou ya se fue? ¿Quizás volvió a su barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Si están buscando a Beidou, Ninguang la llamó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Parece que el Torneo Crux llamó demasiado la atención esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "Mientras partía hacia Liyue, la Capitana iba murmurando algo sobre la “aguafiestas” de Ninguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Jaja, esas dos son como perros y gatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Pero esta vez la Capitana estaba decepcionada por no haber podido coronar a un nuevo ganador. Llevaba mucho tiempo esperando ese momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "#De hecho, el que robó la Visión era quien se tenía que enfrentar en la final a {F#esta heroína}{M#este héroe}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Sabía que no tenía ninguna posibilidad de ganar el combate, así que se le ocurrió llevarse el premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "Por tanto, el Torneo Crux se puede dar por finalizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "¿Eh? Ya veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "#Si ese es el caso, las reglas estipulan que debe ser descalificado... ¡y tú eres {F#la vencedora}{M#el vencedor}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Paimon sabía que ganaríamos, pero no de esta forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "No se preocupen. Como dice el dicho, “quien talento tiene, honor obtiene”. Iré por la medalla de campeón para entregártela como premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "¿Entonces podremos ir a Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Sí, eso creo. Aunque la Capitana Beidou ya no está aquí, yo me encargaré de que llegue a sus oídos. Es una mujer de palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "#Pero deben saber que el viaje a Inazuma es muy peligroso. Serán aquejad{F#as}{M#os} por una tormenta perpetua durante todo el viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "De hecho, la incansable lluvia y el viento también son el reflejo de la voluntad de la Shogun Raiden por cerrar la nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Un momento, ¡¿estás diciendo que puede influir en el clima con el poder de su mente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "Recuerden que se trata de una de los Siete Arcontes. Si Morax pudo formar el Bosque de Piedra Guyun arrojando sus lanzas, no debería ser una sorpresa que la Shogun Raiden pueda invocar una tempestad eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "En resumen, que el Alcor debe prepararse a conciencia para ir a Inazuma. Les avisaremos cuando hayamos terminado con los preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "Yo también me embarcaré en mi propio viaje. Tengo la intención de viajar por toda Liyue para encontrar a quien sea capaz de activar la Visión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "¡Paimon está segura de que lo lograrás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Gracias. Espero que tanto mi viaje como el suyo sean significativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Una última advertencia. Es posible que la parte del viaje posterior a la tormenta sea la más difícil de todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
