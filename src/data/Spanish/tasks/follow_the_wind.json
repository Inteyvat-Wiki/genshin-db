			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Paimon",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020402,
					"content": "En efecto... la Visión no está aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020403,
					"content": "¿Eh? ¿Alguien la robó? ¿Quién se atrevería a hacerlo a plena luz del día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020404,
					"content": "No sabemos cuándo se la llevaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020405,
					"content": "¡Que me aspen! ¿Qué rata de sentina se atreve a desafiar a la Capitana Beidou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020406,
					"content": "No hay de que preocuparse. Incluso la mano más hábil no puede escapar al ojo avizor de la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020407,
					"content": "Hummm... El culpable actuó hace poco. No puede haber ido lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020408,
					"content": "La Visión era el premio que yo mismo ofrecí, y vigilarla era mi responsabilidad. Me aseguraré de recuperarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020409,
					"content": "Si insistís, dejaré que os encarguéis de este asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020410,
					"content": "Yo me quedaré aquí para dar una explicación a los espectadores que vinieron a ver la pelea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020411,
					"content": "#Si no es mucha molestia, acompáñame, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020412,
					"content": "Parece que no tengo elección.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "Pero estamos en una isla... ¿Por dónde se habrá ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020415,
					"content": "Vengan conmigo. Noto que los vientos se aproximan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020413,
					"content": "De todas formas, mi rival no ha aparecido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei el Surcacielos",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "¡Me alcanzaron! ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020902,
					"content": "Incluso había preparado una barca para salir de aquí, ¡pero me atraparon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020903,
					"content": "Por muy veloz que sea una barca, no puede compararse con la velocidad del viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "¿El viento? ¿De qué estás hablando? Ah, ya sé... ¡Tu Visión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020905,
					"content": "¡Maldición! Si yo tuviera una Visión, o si consiguiera activar esta... ¡Nunca me atraparían!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020906,
					"content": "Esto no tiene nada que ver con las Visiones. Puede que seas hábil a la hora de desaparecer entre la multitud, pero parece que no sabes cómo ocultarte de la vista de la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "Además, tu ruta de escape tenía muchos problemas que no detallaré ahora. Además de eso, el viento me trajo el sonido de tus risotadas y alardes mientras te perseguíamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "En otras palabras, no cumpliste ninguno de los requisitos necesarios para dar un buen golpe: velocidad, cautela y estilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020910,
					"content": "Pero lo peor de todo es el estado en el que está la Visión que tienes en la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "Parece que la Visión no responde indiscriminadamente a los deseos humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "¡Está bien, lo admito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020913,
					"content": "Tenía el ojo puesto en esta Visión desde hace tiempo. Al oír que los participantes de esta competición de lucha era muy mediocres, decidí inscribirme. Llegué hasta la final y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020914,
					"content": "¡Ajá! ¡Así que tú ibas a ser nuestro rival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "Mi intención era ganar el torneo gracias a mis habilidades, ¡pero entonces apareciste tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020916,
					"content": "Tras ver las semifinales, sabía que no tenía ninguna posibilidad. ¡Pero no iba a renunciar tan fácilmente a la Visión después de haber llegado hasta aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020917,
					"content": "Ya que no iba a poder vencerte en la pelea, decidí utilizar mis habilidades mientras todos tenían sus ojos posados en Beidou y en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020918,
					"content": "Estaba convencido de haberlo planeado todo... pero, de alguna forma, se las arreglaron para atraparme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020919,
					"content": "Ya no tienes escapatoria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "¡Arg! ¡Esto no tendría que acabar así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020923,
					"content": "Si te resistes, habrá consecuencias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "¡Bah! ¡Qué amenaza tan poco convincente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020928,
					"content": "¡Está bien! Espero que lo digas en serio. De todas formas, no he logrado activarla, así que no me sirve de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020929,
					"content": "¿Sabías, que, según las leyes del océano, el castigo por robar es romper los brazos del ladrón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "¿Eh? ¡Debes estar bromeando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020931,
					"content": "Por no mencionar que lo que robaste era un premio, no te presentaste a la final del torneo y has perjudicado la reputación de la Capitana de la Flota Crux Meridianam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Parece que lo más justo sería marcarte la palabra “ladrón” en la frente con un hierro al rojo vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "¡Oye! No es necesario llegar a esos extremos, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "¡Arg! ¡Nunca pensé que serían tan crueles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020935,
					"content": "Si esto es lo que consigo hablando, ya no quiero perder más tiempo. ¡Me arriesgaré a luchar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020921,
					"content": "Entréganos la Visión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "¿Con lo que me costó hacerme con ella? ¡Jamás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020925,
					"content": "Haz lo que te decimos, y no te pasará nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei el Surcacielos"
				},
				{
					"id": 20020927,
					"content": "Si nos entregas la Visión, te dejaremos ir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
