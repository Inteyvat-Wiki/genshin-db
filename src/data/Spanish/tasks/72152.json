			"dialogs": [
				{
					"id": 721520101,
					"content": "“... Aquí es donde el pirata Rinzou escondió el tesoro. Sus colegas sacaron los últimos cofres...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Notas de los Ladrones de Tesoros"
				},
				{
					"id": 721520102,
					"content": "“... En vida, Rinzou fue una persona muy astuta, y dejó todo tipo de señales especiales en la isla...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Notas de los Ladrones de Tesoros"
				},
				{
					"id": 721520103,
					"content": "“... Quizás sea una cortina de humo, o quizás de verdad haya un tesoro. Solo lo descubriremos si vamos nosotros mismos...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Notas de los Ladrones de Tesoros"
				},
				{
					"id": 721520104,
					"content": "“... Encontramos algunos de los símbolos. Bien, no hay tiempo que perder, ¡vamos por el tesoro de Rinzou!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Notas de los Ladrones de Tesoros"
				},
				{
					"id": 721520105,
					"content": "Guau... Qué largo... Paimon no se molestará en leer algo más que no sea la sección donde habla del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Espera... ¡¿Un tesoro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "#Vamos, {NICKNAME}, ¡un tesoro nos aguarda! ¡No podemos permitir que los Ladrones de Tesoros se nos adelanten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
