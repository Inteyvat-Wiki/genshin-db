						200250402
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250402,
					"content": "Encontré esta llave, ¿es la tuya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250403
					]
				},
				{
					"id": 200250403,
					"content": "¡Sí! ¡Es esa! No puedo permitir que vuelva a suceder... Realmente debo controlar mi consumo de alcohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250404
					],
					"speakerTitle": "Wyatt"
				},
				{
