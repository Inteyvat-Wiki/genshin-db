				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "“¡Gaaa!”.\\nComo si supiera que no es rival para su enemigo, el Qucusaurio pega un rugido y sale volando...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "¡Guau, qu-qué rápido vuela! ¡Se ha ido en un santiamén!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180303,
					"content": "¡Paimon, a por él!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "¡A por él!... Espera, ¿Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180307,
					"content": "Bueno, con lo rápido que se ha ido, parece que ya se ha recuperado. Lo siguiente será...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180308,
					"content": "Por cierto, ¿por qué estaba tan enfadado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180309,
					"content": "¡Ah, Paimon ya sabe! Le has quitado sus aperitivos, ¿verdad? El rencor por la comida puede ser enorme, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180310,
					"content": "¿Aperitivos? Pues sí, algo sí que me he comido, pero Kururuk no es un Qucusaurio al que le importen esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180311,
					"content": "¿Kururuk? Oh, con que tiene nombre... ¡Pues tiene muy mal genio! Hace un momento se ha puesto a atacarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180312,
					"content": "Bueno, no le culpo. Todo sea por el tratamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180313,
					"content": "¿Recibir palizas también cuenta? Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#¡Cómo puede haber un tratamiento así! ¡Mira! Por culpa tuya, ¡parece que {REALNAME[ID(2)|SHOWHOST(true)]} se está haciendo una idea equivocada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180316,
					"content": "¿Mmm? ¿Gruuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "Jaja, si realmente existiera y funcionase, ¡a mí también me gustaría probarla! Pero los saurios son diferentes de los humanos, así que aunque les dijera que algo los ayudaría a recuperarse, no lo entenderían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180318,
					"content": "Por cierto, aún no me he presentado, soy Mazkal. Suelo cuidar a los saurios heridos o enfermos por aquí. No estoy presumiendo, pero mis medicinas gozan de bastante buena reputación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180319,
					"content": "Su pequeño compañero se ve tan sano que no necesita ninguno de mis cuidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180320,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "Así que eres una veterinaria que trata a los saurios. Humm, por el aspecto de Kururuk, lo tuyo debe ser un trabajo duro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180322,
					"content": "No es para tanto, es solo que el caso de Kururuk es un poco particular... Es extremadamente desconfiado con los humanos y resistente a cualquier tratamiento o medicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180323,
					"content": "*Suspira*. Ojalá yo también fuera un saurio. Según mis observaciones, se llevaba bastante bien con otros saurios, así que si hubiera sido un saurio el que lo hubiera convencido de tomar la medicina, tal vez le hubiera hecho caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180324,
					"content": "¿Gruuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "En tal caso, quizá podamos ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180326,
					"content": "#¿Eh? ¿A-acaso ustedes son sauri{F#as}{M#os} y no human{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180327,
					"content": "¡Desde luego que imaginación no te falta! A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180328,
					"content": "#E-es que {REALNAME[ID(2)|SHOWHOST(true)]} es un saurio muy inteligente y... ¡él podría ayudar con este asunto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180329,
					"content": "¿En serio? ¿Tan inteligente es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180330,
					"content": "#Hombre, me ha elegido a mí como compañer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "Cierto... pero la cuestión ahora no es esa, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180333,
					"content": "#¡Así es! Tú tranquila, ¡que seguro que {REALNAME[ID(2)|SHOWHOST(true)]} puede con esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180334,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#En ese caso, {REALNAME[ID(2)|SHOWHOST(true)]}, ¡te doy las gracias en nombre de Kururuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180336,
					"content": "Estaba realmente preocupada de que si seguía así, no solo no se curaría de sus viejas heridas, sino que le saldrían nuevas... ¡Con su ayuda, me quedo mucho más tranquila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180337,
					"content": "Tengo preparadas dos pociones para Kururuk, y por mucho que me gustara equilibrar curación y palatabilidad, no se me ocurre ninguna receta que cumpla los requisitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180338,
					"content": "Así que, de las dos pociones que tengo, una es más efectiva pero no gusta tanto a los saurios, mientras que la otra sí que les gusta, pero no es tan efectiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "Mazkal"
				},
				{
