			"dialogs": [
				{
					"id": 750180101,
					"content": "¡Grraaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "Kururuk"
				},
				{
					"id": 750180102,
					"content": "Buen chico, no armes jaleo. ¿Cómo vas a recuperarte si no tomas la medicina...? ¡Ay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180103,
					"content": "#¡Cuidado! {NICKNAME}, ¡la tenemos que ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
