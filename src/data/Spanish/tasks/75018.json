				{
					"id": 750181009,
					"content": "#Ustedes dos, que son capaces de mantener una relación tan cercana con este pequeño Tepetlisaurio, ¡también son auténtic{F#as}{M#os}! Tengo que aprender de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181010,
					"content": "#¡Soy {F#la mejor}{M#el mejor}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "Les iba a decir que vinieran a buscarme para cualquier cosa que necesiten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181013,
					"content": "Pero sería mejor desearles buena salud y bienestar, ¡y que nunca tengan que visitarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181014,
					"content": "#Aunque si quieren venir a charlar conmigo, siempre son bienvenid{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181015
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181015,
					"content": "¡Por supuesto! Esperamos que Kururuk se mejore pronto, o por lo menos que deje de atacar a la gente sin motivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181016,
					"content": "En cuanto a eso... pueden confiar en mí. Ya se me ocurrirá alguna solución. Una vez que se haya recuperado de sus heridas, ¡probablemente cambiará de temperamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181011,
					"content": "#¡Qué va! ¡{REALNAME[ID(2)|SHOWHOST(true)]} sí que es el mejor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				}
			]
		},
