				"points": []
			},
			"dialogs": [
				{
					"id": 705030101,
					"content": "Una copa pequeña de Arrecife espumoso, por favor... Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030102,
						705030103
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030102,
					"content": "¿Eula?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				},
				{
					"id": 705030104,
					"content": "E-estoy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030105
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030105,
					"content": "Humm... Algo le pasa a Eula. ¿Estuvo bebiendo antes de venir aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030106,
					"content": "El Arrecife espumoso tiene café. ¿No le sentará mal al estómago si toma café después de beber licor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030107,
					"content": "¡Deberíamos aguarlo un poco antes de servírselo! Seguro que su estómago nos lo agradece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030103,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				}
			]
		},
		{
			"id": 7050302,
			"completionStepIds": [
				7050303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050303",
							"2"
						],
						"stepId": 7050303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705030238,
					"content": "Agregas agua al café, tal y como dijo Paimon...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705030201,
					"content": "Esto sabe muy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030202
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030202,
					"content": "Guau, ni siquiera notó la cantidad de agua que agregamos. Debe de haber bebido mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030203,
					"content": "Cantinero, ¡una más! ¿Eh? U-un momento, ¿qué hacen ustedes aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030204,
						705030205
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030204,
					"content": "Estamos aprendiendo el oficio de cantinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030205,
					"content": "¿No nos habías visto hasta ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030207
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030207,
					"content": "Perdón, vengo de Cola de Gato. Tal vez bebí más de la cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030208,
						705030209
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030208,
					"content": "¿Te preocupa algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030209,
					"content": "Si quieres hablar, te escucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030210,
					"content": "#Sí, beber sola es algo un tanto triste. ¡Te sentirás mejor si hablas con nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030212
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030212,
					"content": "Supongo que yo siempre bebo sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030213
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030213,
					"content": "Siempre y cuando esté en Mondstadt, no soy bienvenida en las tabernas. Sin embargo, hoy estaba de buen humor y me apetecía un trago, pero la gente no deja de señalarme y murmurar a mis espaldas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030214,
					"content": "#{NICKNAME}, cuéntame, ¿cómo conseguiste hacer tantos amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030215
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030215,
					"content": "Cuando la gente habla contigo, tienen un tono de admiración y una sonrisa en sus rostros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030216
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030216,
					"content": "En cambio, con solo mencionar mi apellido, todo el mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030217
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030217,
					"content": "No digas eso, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030218
					]
				},
				{
					"id": 705030218,
					"content": "No escogiste ser descendiente de los Lawrence, y tampoco es que nos importe. ¡Sabemos que eres una buena persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030219,
					"content": "Es solo que no eres directa al hablar. Siempre pretendes guardarle rencor a la gente e intentas ocultar tu lado amable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030220,
					"content": "Oye, ¿quién dice que estoy fingiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030221,
						705030222
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030221,
					"content": "Los demás acabarán aceptándote, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030222,
					"content": "#Además de nosotr{F#as}{M#os}, los demás también acabarán aceptándote.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030223,
					"content": "¿Lo dices en serio? Jaja... Es difícil de imaginar cuando la cabeza te da vueltas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030224
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030224,
					"content": "Aun tras haber sido una Caballera de Favonius durante todo este tiempo, la gente todavía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030225,
					"content": "“El viento siempre cambia su curso”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030226
					]
				},
				{
					"id": 705030226,
					"content": "¡Oh, cierto! El bardo de pacotilla también dijo esa sabia frase una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030227,
					"content": "Solo sé tú misma, Eula, y sigue hacia delante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030228,
					"content": "¡Tarde o temprano cambiarás la impresión que la gente tiene de los Lawrence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030229,
					"content": "Solo tienes que ser paciente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030230
					]
				},
				{
					"id": 705030230,
					"content": "Está bien, muchas gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030231
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030231,
					"content": "Y-yo... *Ejem*, debo irme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030232
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030232,
					"content": "¿Quieres que te acompañe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030233
					]
				},
				{
					"id": 705030233,
					"content": "No hace falta. No puedo distraerme, debo recordar lo que dijiste y anotarlo lo antes posible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030234
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030234,
					"content": "Eula se vuelve más sincera tras unas cuantas copas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030235,
					"content": "Pero Paimon siente que falta algo sin su típica frase de venganza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030236,
					"content": "Oh, oh... Cuando se despierte por la mañana, ¿crees que vendrá a amenazarnos para que olvidemos lo que ocurrió hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030237,
					"content": "Quizás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}