				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "¡Ah! ¡Ese tanuki de juguete se acaba de convertir en humana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170202,
					"content": "¿Qué está pasando? ¡Paimon nunca había visto algo así antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170203,
					"content": "No soy una tanuki... Soy una mujina... *Zzz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170204,
					"content": "Qué cansada estoy... Si no duermo lo suficiente... no creceré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170205,
					"content": "Humm... ¿Esta es la “profesional” de la que hablabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170206,
					"content": "Pues no parece nada profesional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170207,
					"content": "Jeje. Es miembro de Los Ocelos y una auténtica ninja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170208,
					"content": "¡Vaya, una ninja! Entonces, ¿eso de antes era una de esas legendarias técnicas de transformación ninja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170209,
					"content": "Por cierto, ¿quiénes son “Los Ocelos”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170210,
					"content": "Pertenecen a la Comisión Yashiro. Son una organización secreta bajo el mando de Kamisato Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170211,
					"content": "Actualmente, Kamisato Ayato y la Comisión Yashiro se mantienen neutrales, así que yo no tengo derecho a dar órdenes a Los Ocelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170212,
					"content": "Sin embargo, convencer a su miembro más perezosa para que nos ayude sí está dentro de mis capacidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170213,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170214,
					"content": "Esto es lo que necesito que hagas: ve a la ciudad y encuentra pruebas de la traición de la Comisión Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170215,
					"content": "No sería apropiado que yo me dejara ver por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170216,
					"content": "Haces que parezca sencillo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170217,
					"content": "No tengo ni idea de lo que estamos buscando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "¿Eh? Oh, pensé que ya lo sabrías. Muy bien, te daré un poco más de información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170220,
					"content": "Para un forastero, comprender el funcionamiento interno de la Comisión Tenryou es casi imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170221,
					"content": "Pero como las tres Comisiones trabajan juntas para servir a la Shogun, guardan una estrecha relación entre sí. A alguien de alguna de las otras Comisiones le resultaría más fácil averiguar lo que están haciendo las demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170222,
					"content": "¡La Comisión Yashiro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Jeje... Veo que ya vas entendiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170224,
					"content": "El ejército de la Shogun aún no ha dejado de buscarte, pero con la ayuda de esta ninja de Los Ocelos, estoy segura de que podrás reunirte con tus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170225,
					"content": "No olvides que tenemos una agenda muy apretada, así que asegúrate de traer las pruebas a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170218,
					"content": "¿Cuáles son exactamente las pruebas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
			"completionStepIds": [
				201704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201704",
							"2"
						],
						"stepId": 201704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, ¿qué te trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170404,
					"content": "¿Te encontraste con el ejército de resistencia? ¿Cómo va la batalla? ¿Ya es seguro que yo salga de aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170405,
					"content": "Todavía no... vimos gente patrullando en el camino hacia aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "Así que aún no ha terminado... Entonces, supongo que has venido porque tienes algo de lo que hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170407,
					"content": "Le pediré a alguien que llame a la Srta. Kamisato. Esperen un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170408,
					"content": "Informas a Ayaka y a Thoma de la situación actual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Veo que has pasado por muchas cosas desde la última vez que nos vimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Entiendo. Así que necesitas pruebas de la traición de la Comisión Tenryou... Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "Ahora que lo dices, hay una cosa que siempre me ha preocupado. El ejército de la Shogun lleva mucho tiempo en guerra con la resistencia, pero ella nunca ha preguntado por ese asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "Antes pensaba que simplemente no le importaba, pero pensándolo ahora, tal vez el problema todo este tiempo haya sido con los <color=#00E1FFFF>documentos oficiales</color> que la Comisión Tenryou le da a la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "¿Qué quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "La Comisión Tenryou se encarga de los asuntos militares internos. Si quisieran ocultar información en sus informes, no tendríamos forma de saberlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "Mientras tanto, la Shogun pensaría que el Decreto de captura de Visiones no representa ninguna amenaza, y se mantendría firme en su decisión. Si tuviéramos acceso a esos documentos, podríamos confirmarlo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Pero, según recuerdo, la única persona con autorización para acceder a ese tipo de documentos oficiales es Kujou Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170417,
					"content": "Además, están férreamente protegidos. Incluso con la ayuda de Sayu, robar un documento delante de sus narices no será tarea fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170418,
					"content": "Si hubiera una forma de distraer a los guardias el tiempo suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170419,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170420,
					"content": "¿Dijiste “distraerlos”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "¡Los fuegos artificiales de Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170423,
					"content": "Esa es una sugerencia muy típica de Thoma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170424,
					"content": "Pero es razonable. La Estatua de la Diosa Omnipresente está justo al lado de la Comisión Tenryou. Si alguien lanzara fuegos artificiales cerca de la estatua, seguro que no lo ignorarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170425,
					"content": "Mientras estén distraídos con eso, Sayu podría infiltrarse en la Comisión Tenryou para llevarse el informe y cualquier otra prueba que pueda encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170426,
					"content": "¡Genial! Parece que cada vez estoy más cerca de volver a ser un hombre libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170427,
					"content": "Ah... Parece que ha pasado una eternidad desde la última vez que nos sentamos a hablar así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170428,
					"content": "No ha pasado tanto tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "Bueno, a mí me lo ha parecido... Desde que llegué aquí, ¡he estado todos los días esperando verte de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170430,
					"content": "Esta casa de té solía ser mi escondite favorito, pero ahora... Sinceramente, he perdido la cuenta de cuánto tiempo ha pasado desde la última vez que puse un pie afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170431,
					"content": "¡Ay! ¡Tengo tantas ganas de ir a las aguas termales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170432,
					"content": "Pobre Thoma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170433,
					"content": "Centrémonos en el tema que nos ocupa. Cuanto antes se derogue el Decreto de captura de Visiones, antes podrá Thoma ser libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170434,
					"content": "Fue una bonita reunión, pero no tenemos tiempo para ponernos al día. Lo celebraremos adecuadamente cuando todo haya terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170435,
					"content": "¡Oh! ¡Podremos jugar de nuevo al juego del shabu shabu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170436,
					"content": "¿Todavía estás pensando en eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170437,
					"content": "La Comisión Tenryou está muy bien vigilada. Tengan cuidado cuando estén cerca y reunámonos aquí después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170438,
					"content": "#Muy bien, {NICKNAME}. Primero, vamos a <color=#00E1FFFF>Hanamizaka</color> para encontrarnos con <color=#00E1FFFF>Yoimiya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170421,
					"content": "Ya hemos hecho esto antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
		{
			"id": 201707,
			"completionStepIds": [
				201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
