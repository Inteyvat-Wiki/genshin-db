					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "¿De verdad es buena idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170708,
					"content": "Bueno, ¡vayamos a la <color=#00E1FFFF>estatua</color>! Ten cuidado y mantente alerta para que no nos atrapen los guardias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
