	"talks": [
		{
			"id": 201702,
			"completionStepIds": [
				201702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201702",
							"2"
						],
						"stepId": 201702,
						"stateName": "QUEST_STATE_UNFINISHED"
