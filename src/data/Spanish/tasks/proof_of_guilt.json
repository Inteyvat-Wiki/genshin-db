			"dialogs": [
				{
					"id": 20171000,
					"content": "¡Yoimiya, necesitamos un fuego artificial extragrande! ¡Super-ultragrande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171001
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171001,
					"content": "¿Un “fuego artificial extragrande”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171002
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171002,
					"content": "Jeje, entonces han venido a la persona adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171003
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171003,
					"content": "Resulta que hace un par de días preparé este. ¡Es megafuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171004
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171004,
					"content": "Pero es tan potente que aún no he encontrado ningún sitio donde probarlo... Así que se lo daré a ustedes. ¡Ya me contarán qué tal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171005
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171005,
					"content": "No olviden alejarse mucho después de prender la mecha, y procuren no quemarse la ropa. Además, lo mejor será que se tapen los oídos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171006
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171006,
					"content": "De repente Paimon está muy nerviosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171007,
					"content": "Jajaja, no te preocupes, no es más que un fuego artificial. ¿Qué es lo peor que puede pasar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171008,
					"content": "Lo intentaremos... Gracias, Yoimiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
