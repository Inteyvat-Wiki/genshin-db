			"dialogs": [
				{
					"id": 20170702,
					"content": "Hay mucha, mucha gente... Si alguien me ve, me atraparán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170703,
					"content": "Tenemos que deshacernos de ellos, o no podré infiltrarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170704,
					"content": "Tendremos que confiar en Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Reunámonos en la <color=#00E1FFFF>Casa de Té Komore</color> después de que consiga el documento, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Y si me atrapan... por favor, vengan a rescatarme...",
