			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170701,
					"content": "Humm... Eso es lo que pensaba hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170702,
					"content": "Hay mucha, mucha gente... Si alguien me ve, me atraparán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170703,
					"content": "Tenemos que deshacernos de ellos, o no podré infiltrarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170704,
					"content": "Tendremos que confiar en Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Reunámonos en la <color=#00E1FFFF>Casa de Té Komore</color> después de que consiga el documento, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Y si me atrapan... por favor, vengan a rescatarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "¿De verdad es buena idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170708,
					"content": "Bueno, ¡vayamos a la <color=#00E1FFFF>estatua</color>! Ten cuidado y mantente alerta para que no nos atrapen los guardias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201709,
			"completionStepIds": [
				201709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201709",
							"2"
						],
						"stepId": 201709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170901,
					"content": "#¿Y bien {NICKNAME}? ¿Qué tal fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170902,
					"content": "#Ni yo mism{F#a}{M#o} lo sé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "Buen trabajo. Ahora esperemos noticias de Sayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170905,
					"content": "Un tiempo después...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170906,
					"content": "Puff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170907,
					"content": "Sé que el ejercicio es bueno para crecer, pero esto fue demasiado ejercicio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170908,
					"content": "Me siento mareada... Todo me da vueltas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170909,
					"content": "No, todavía no puedo dormir. Había algo importante que debía hacer primero... Oh, claro, ¡ya sé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170910,
					"content": "No sabía cómo encontrar el documento del que hablaban, así que traje un montón de cosas que parecían sospechosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170911,
					"content": "Aquí tienen... Yo me voy a dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170912,
					"content": "Señorita, ¿qué es todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170913,
					"content": "Este sobre cerrado debe de ser un informe al trono que la Comisión Tenryou está preparando para la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170914,
					"content": "Además, tenemos... una correspondencia con los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170915,
					"content": "Parece que la Suma Sacerdotisa Yae tenía razón. Ellos son quienes han estado causando problemas desde las sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}, con estas pruebas debería ser suficiente. Llévaselas a la <color=#00E1FFFF>Suma Sacerdotisa Yae</color>. Confío en que ella tendrá un plan para nuestro siguiente paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170917,
					"content": "Intentaré reunir gente para acabar con el resto de los Fatui que hay en Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170918,
					"content": "Aun así, ten cuidado cuando te enfrentes a la Shogun. Todavía me dan escalofríos solo de pensar en ella desenfundando su espada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170919,
					"content": "Tendremos que confiar en la Suma Sacerdotisa Yae. Ella es más cercana a la Shogun, así que tal vez sepa qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170920,
					"content": "Si Paimon no recuerda mal, deberíamos encontrarnos con Yae Miko muy pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170921,
					"content": "Guardemos nuestras cosas y preparémonos para partir hacia el <color=#00E1FFFF>Gran Santuario Narukami</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170903,
					"content": "Encendimos los fuegos artificiales y huimos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
