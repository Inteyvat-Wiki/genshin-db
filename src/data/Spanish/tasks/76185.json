			"dialogs": [
				{
					"id": 761850201,
					"content": "El té sabe mucho mejor cuando se acompaña de información útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850202,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850204,
					"content": "Oh, cuídese. Y no olvide pasar por aquí cuando tenga tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
