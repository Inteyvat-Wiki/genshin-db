			"dialogs": [
				{
					"id": 761850101,
					"content": "Mmm, qué té tan rico y qué aperitivos tan deliciosos. Gracias por su hospitalidad, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850102,
					"content": "Me alegro de que te guste. También traje algunos aperitivos para Ashru. ¿A que sí, Ashru? Ven aquí. Qué gatito más bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850103,
					"content": "¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "Espero que su aprecio por Nod Krai y la Cámara de Secretos resulte beneficioso para nuestra futura colaboración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850105,
					"content": "Sí, yo también. Ven, Ashru, prueba esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850106,
					"content": "Por cierto, en cuanto a lo que pregunté antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850107,
					"content": "Jaja, tus patitas son tan suaves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850109,
					"content": "Srta. Sandrone... ¿No me dirá que usó esta hora del té como pretexto para venir aquí y acariciar a mi gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850110,
					"content": "¿Eh...? ¿Y-yo? ¡Nunca haría algo así! ¡Me tomo muy en serio mis relaciones con la Cámara de Secretos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850111,
					"content": "Ven aquí, Ashru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850112,
					"content": "¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850114,
					"content": "Entonces, ¿por qué no hablamos más en detalle de nuestros negocios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850115,
					"content": "*Tch*, ¿y-y qué pasa si quería acariciar a Ashru?... ¡¿A quién no le gustaría?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850116,
					"content": "Los animales pequeños suelen desconfiar de las máquinas. Me costó mucho ganarme la confianza de Ashru cuando estuve aquí trabajando en la matriz aritmética. ¿Qué hay de malo en que quiera acariciarle un poco la barriga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850117,
					"content": "Ja... No hace falta ponerse tan a la defensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850118,
					"content": "Ve, Ashru. Yo no soy quién para decirte con quién puedes o no puedes frotarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850119,
					"content": "¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Pero, una vez que haya terminado de acariciarlo, no olvide que tenemos asuntos que tratar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761850121,
					"content": "¡Como ya te dije, me tomo muy en serio nuestros asuntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
