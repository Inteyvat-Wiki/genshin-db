			"dialogs": [
				{
					"id": 718080301,
					"content": "¡Volviste! ¿Descubriste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080302
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080302,
					"content": "La situación en Nantianmen es esta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Terremotos, monstruos, y una niña pequeña... ¿Es alguna niña perdida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Sobre lo que dijo esa chica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "¿Qué dijo? ¿“Su resurrección”? Tonterías...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Seguro que ha estado leyendo libros extraños otra vez... Bueno, no importa. Le pediré a alguien que vaya por esa niña y la traiga a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "Terremotos y monstruos... Espero que no esté herida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Gracias. Acepta esto por la molestia de haber venido hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080309,
					"content": "*Suspira*, siempre hay tantas cosas que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
