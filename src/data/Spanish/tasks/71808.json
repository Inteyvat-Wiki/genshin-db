			"dialogs": [
				{
					"id": 718080201,
					"content": "Pronto resucitará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080202
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080202,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "¿Viniste a atestiguar su resurrección?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080204,
					"content": "Viniste un poco temprano, pero tampoco puede decirse que llegaste tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080205,
					"content": "¿De qué demonios está hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080206,
					"content": "Eh, ¿qué estabas diciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "Jeje, ¿no te has dado cuenta todavía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080208,
					"content": "Bueno, podría ser algo bueno para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080209,
					"content": "Ahora, vete y espera a que esa persona vuelva a despertar. Entonces, lo entenderás todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiu"
				}
			]
		},
