			},
			"dialogs": [
				{
					"id": 721130201,
					"content": "Deja ver a Paimon, ¡deja ver a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130202,
					"content": "¡Guau! Dice muy auspicioso. ¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130203,
					"content": "¡Parece que hoy es el día de suerte de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130204,
					"content": "¿El tuyo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "¡Así es! ¡Tu fortuna es la fortuna de Paimon! Y viceversa, la fortuna de Paimon también es tu fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130206,
					"content": "Cuando Paimon come buena comida, eso es buena fortuna. Entonces, por el bien de tu fortuna, dale a Paimon algo bueno de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
