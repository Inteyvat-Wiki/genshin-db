			"dialogs": [
				{
					"id": 721130401,
					"content": "Deja ver a Paimon, ¡deja ver a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130402,
					"content": "¡Eh, es negativo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130403,
					"content": "¡Recuerdo este escenario! Decía... que se debe atar el papel negativo en el gancho de papeles de la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130404,
					"content": "Y luego darle a Paimon algo delicioso de comer. Eso ayudará a cambiar la mala suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130405,
					"content": "¿Ah, sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "¡Por supuesto! ¿Te atreves a cuestionar la sabiduría de los antiguos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "¡La sabiduría de los antiguos es increíble! De cualquier forma, ¡encontremos primero el gancho de papeles de la fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
