				"objectNames": [
					"Gendou Ringo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "¿Quién eres exactamente? ¿Y cuáles son tus intenciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131002,
					"content": "¡Eso mismo queremos preguntarte! ¡¿Por qué nos atacas de esa forma, Gendou?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131003,
					"content": "Qué falta de cortesía. Respóndanme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131004,
					"content": "#Me llamo {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "#Conozco sus nombres, así que sean buen{F#as}{M#os} y díganme, ¿cómo se enteraron del código secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131006,
					"content": "P-Paimon me lo dijo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "¡Oye! ¡Date prisa y dile lo que ocurrió! ¡Gendou nos está mirando de esa forma tan extraña!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131010,
					"content": "... Ya veo, así que fueron ustedes quienes recibieron las notas. Eso quiere decir que Momoka ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131011,
					"content": "¿Quién es Momoka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "Mi colega, y la persona detrás de estas notas, pero parece que no puede seguir cumpliendo con su responsabilidad hacia Inazuma. Qué pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131013,
					"content": "¡Hum! Está bien, si tanto desconfían, no pierdo nada con decírselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131014,
					"content": "En realidad, Momoka y yo somos ninjas de Los Ocelos. Nuestra organización se hace cargo de todo tipo de amenazas externas, y estos pedazos de papel son una manera en la que comunicamos nuestras misiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131015,
					"content": "Como resultado, hemos tenido que soportar mucho resentimiento y sufrimiento. Como, por ejemplo, el de algunas personas que se han infiltrado en nuestra nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131016,
					"content": "La gente de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "¡¿A qué te refieres con “la gente de Mondstadt”?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131020,
					"content": "El código secreto nos permite distinguir a los nuestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131021,
					"content": "Sin embargo, el código secreto de cada miembro es único. Al parecer Momoka dejó su propio código por escrito para informar a Los Ocelos de la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131022,
					"content": "Ella intentaba atraer al enemigo que quería utilizar el código secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131023,
					"content": "Entonces...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "Entonces te diste cuenta al instante, ¿verdad, Gendou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131025,
					"content": "Por supuesto. Es por eso que tenía que confirmar la situación por mí misma. Pero extrañamente, no lograba comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131026,
					"content": "Si de verdad fueran espías de Snezhnaya, ¿por qué no fueron a informar del asunto a los Fatui al concluir la misión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131027,
					"content": "Por eso creo su historia sobre el campamento abandonado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131028,
					"content": "#A juzgar por sus acciones, veo que, aunque emparejaron los códigos por mera curiosidad, no son enemig{F#as}{M#os} de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131029,
					"content": "Bien, así habremos limpiado nuestro nombre. ¡Pero Paimon sigue molesta por haber trabajado gratis para ti todo este tiempo, Gendou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131030,
					"content": "Pero... ¿esa era la verdadera Gendou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "Así que se dieron cuenta, ¿eh? Sí, la Gendou que les dio aquellas misiones era una impostora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131032,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131033,
					"content": "#Mientras l{F#as}{M#os} seguía, fui emboscada por unos Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131034,
					"content": "Sé una cosa o dos sobre las técnicas ninja, así que fingí mi muerte para engañarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131035,
					"content": "Poco después, usaron a uno de los suyos para hacerse pasar por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131036,
					"content": "Con razón había algo raro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "¿Eh? ¿Eso quiere decir que la Gendou amable fue un engaño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131039,
					"content": "¿“Amable”? ¡Hum! Debe de haber sido muy popular, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131040,
					"content": "#En fin, ellos debieron pensar que eras {F#una}{M#un} miembro oficial de Los Ocelos e intentaron usarte para infiltrarse en nuestra organización.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131041,
					"content": "#Esa fue mi oportunidad para actuar. Mientras la impostora no estaba, utilicé mis propios métodos para traerl{F#as}{M#os} a ustedes hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131042,
					"content": "Escuchen bien, les daré una elección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131043,
					"content": "Trabajen para nosotros como miembros externos. Ellos no saben que estoy con vida, así que la situación está a nuestro favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131044,
					"content": "¿Qué pasa si me niego?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "Inténtalo, si quieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131046,
					"content": "¡De cualquier forma, los Fatui también son nuestros enemigos! ¿Por qué no unimos fuerzas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131049,
					"content": "Una sabia decisión. Los suministros del almacén están a tu disposición. Úsalos como consideres conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131050,
					"content": "Bien, contactaré con ustedes si hay alguna novedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131051,
					"content": "Espero mucho de nuestra cooperación. Hasta pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131047,
					"content": "Suena razonable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "Con razón llamaba al papel de la fortuna por su nombre correcto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "Los Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "Exactamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131008,
					"content": "Permíteme explicarme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "Encontramos un campamento abandonado en una colina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
