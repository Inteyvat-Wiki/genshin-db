			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "¿Quieres probar tu suerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130102,
					"content": "Guau, qué fría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130103,
					"content": "Puedo intentarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "Bien, funciona así: primero tienes que agitar esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130105,
					"content": "Es una caja con palitos de la suerte, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "Sí. Un palito de bambú saldrá de él. Dámelo y buscaré la tira de papel correspondiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130107,
					"content": "Parece que les llaman “papeles de la fortuna”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "Lo que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130109,
					"content": "Paimon tiene una pregunta. ¿Qué pasa si sacamos un papel con mala suerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130110,
					"content": "Es el destino. ¿Tienes un problema con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130111,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130112,
					"content": "Hay algo así como un estante allí afuera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "*Tch*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130114,
					"content": "¿En serio acaba de chascar la lengua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130115,
					"content": "Déjame ver... Ah, sí, dice así: “ata el papel con la mala fortuna en el estante para cambiar la mala fortuna por buena”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130116,
					"content": "¡Oh, casi lo olvido! Si sacan un papel con mala suerte, solo tienen que colgarlo en el estante de allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130117,
					"content": "#Son ustedes un{F#as}{M#os}... *Ejem*, lo siento. En el Gran Santuario Narukami la amabilidad es lo primero. Incluso si sacas un papel con mala suerte, puedes cambiar tu fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130118,
					"content": "Hay algo muy extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130119,
					"content": "#¡Vamos, {NICKNAME}! ¡Saquemos un palito de la fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
