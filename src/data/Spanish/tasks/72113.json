			"dialogs": [
				{
					"id": 721130701,
					"content": "La actitud de Gendou es la misma de siempre... Humm... En fin, veamos qué dice el papelito de la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130702,
					"content": "¿Eh? Es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130703,
					"content": "Paimon entiende. ¡Debe ser un tipo malo al que debemos derrotar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130704,
					"content": "Así que de eso se trata... Gendou es una espía que utiliza este método para comunicarse con otros y eliminar a aquellos que quieran hacerle daño a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130705,
					"content": "Qué escándalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130706,
					"content": "¡P-Paimon lo siente! ¡Por favor, no pongas a Los Ocelos en contra nuestra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130707,
					"content": "Márchense de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130708,
					"content": "¡Ya nos vamos! ¡Vayamos al lugar que indica la imagen a ver si podemos encontrar el objetivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
