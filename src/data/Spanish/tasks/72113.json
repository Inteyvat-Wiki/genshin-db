			"dialogs": [
				{
					"id": 721130501,
					"content": "Dame ese palillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130502
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130502,
					"content": "E-está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130503
					]
				},
				{
					"id": 721130503,
					"content": "A este santuario le falta un aura sagrada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130504,
					"content": "Toma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130505
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130505,
					"content": "Veamos qué tal es nuestra suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130506,
					"content": "Por cierto, solo puedes probar tu suerte una vez al día, no lo olvides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130507
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130507,
					"content": "Si no, te resultará cansado... No, espera... Si no, no podrás colgar el papel de la fortuna... Tampoco... Ay, ¿cómo era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130508
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130508,
					"content": "“Los papeles de la fortuna son una manifestación de la voluntad de la Arconte. Nos corresponde a nosotros los humanos respetarla”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130509
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130509,
					"content": "¿Ves? Está muy bien escrito. Así que recuerda, solo puedes sacar un papel de la fortuna por día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
