			"dialogs": [
				{
					"id": 721130601,
					"content": "¿Eh? ¿Qué es esto? Parecen las notas de alguien. Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130602,
					"content": "“... el fin... Fatui... conspiración contra...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130603,
					"content": "¿Qué es esto? No tiene pies ni cabeza y está manchado. No se puede leer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130604,
					"content": "Podría ser una pista del tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "¡Tiene sentido! Deja que Paimon eche otro vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130606,
					"content": "“... al descifrar el palito de la fortuna, el código secreto...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130607,
					"content": "¿Palito de la fortuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "Deja ver a Paimon... La primera mitad es: “En medio de una noche brumosa...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130610,
					"content": "Aquí se acaba. Paimon no sabe cuál es la segunda parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "Pero ya que es un código secreto, debe de haber algún secreto escondido, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130612,
					"content": "En fin, parece importante. La próxima vez que descifremos nuestro palito de la fortuna, mencionaremos este código, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130608,
					"content": "¿Código secreto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
