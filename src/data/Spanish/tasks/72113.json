			"dialogs": [
				{
					"id": 721130801,
					"content": "¿Eh? ¿A dónde fue la señorita Gendou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130802,
					"content": "#Estoy algo preocupad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130803
					]
				},
				{
					"id": 721130803,
					"content": "Sí, ¿y si no regresa? ¿Cómo hará Paimon para saber la fortuna de hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130804,
					"content": "¿Eh? Aquí hay un papel. Deja que Paimon eche un vistazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130805,
					"content": "No deberíamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130806
					]
				},
				{
					"id": 721130806,
					"content": "¡No importa! ¡Podría ser una pista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130807,
					"content": "¿Eh? Es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130808,
					"content": "Parece que nos dice que visitemos este lugar y recibamos la siguiente instrucción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130809,
					"content": "¡Vamos a averiguarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
