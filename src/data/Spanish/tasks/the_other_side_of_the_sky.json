					}
				]
			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "¡Yujuuu, lo conseguimos! Pero, aun así, ¿de qué le suena esta inscripción iridiscente a Paimon? ¿Será el famoso Jade del Retorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "Un momento, ahora que Paimon se fija, ¿este no es el Disco Dorado de la Diplomacia? ¡Es igual que el que encontramos en aquella estela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "Gruuu, grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "¿En serio? Guau, ¿cómo no me había dado cuenta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "Un tesoro capaz de contener la ponzoña del Abismo es bastante similar a un amuleto que puede quitar maldiciones y prevenir desastres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "¿Ahora te das cuenta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "#Bueno, y si eres tan list{F#a}{M#o}, ¿por qué no se lo dijiste antes a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "Un tesoro capaz de contener la ponzoña del Abismo es bastante similar a un amuleto que puede quitar maldiciones y prevenir desastres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "Pero ¿de verdad podrá contener al Abismo en Ochkanatlan? Paimon nunca ha oído a nadie de la Asociación de Arqueología Sáurica decirnos algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "#Oye, y ¿podría ser que ese dragón se hubiera fijado en nosotr{F#a}{M#o}s porque el Jade del Retorno es, en realidad, un Disco Dorado de la Diplomacia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Conque no fue por el estofado de carne flameante que desayunó Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
					"content": "Todo encaja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360513
					]
				},
				{
					"id": 751360513,
					"content": "Al final sí que era un presagio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360514
					]
				},
				{
					"id": 751360514,
					"content": "Humm, tal vez Bona no sepa lo del Disco Dorado de la Diplomacia... ¿Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360515,
					"content": "No puede ser, hay algo que no encaja. El Tonatiuh... el Jade del Retorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360516
					],
					"speakerTitle": "Bona"
