			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-306.442,
							1277.558,
							9810.905
						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "#*Fiu*, ¡e-estamos viv{F#a}{M#o}s! Qué bien sienta pisar tierra firme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360102,
					"content": "Pero si tú siempre estás flotando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Bueno, ¡pero flotar en tierra firme es muy distinto a hacerlo en el cielo mientras el viento te da meneos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360104,
					"content": "Este sitio no es muy firme que digamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#Oye, no asustes a Paimon. Si nos caemos, ¡Paimon no podrá traerlos de vuelta a ti y a {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360106,
					"content": "Ñiii, gluuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751360107,
					"content": "¿Ese es el Tonatiuh? ¡Bieeeen, lo conseguimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360108,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Más que un barco, parece un ovillo de hilo gigante, pero con lo enredado que está, lo que sí parece es una serpiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360110,
					"content": "Por allí parece más seguro, así que busquemos la forma de llegar. Humm, ¿dónde está Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360111,
					"content": "Es cierto que dijo que tenía mucha experiencia de vuelo, pero aun así, Paimon está preocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360112,
					"content": "Mientras la corriente de viento la haya llevado en la dirección adecuada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "Tienes razón. Si era la dirección adecuada, debe haber aterrizado por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360114,
					"content": "#No lo averiguaremos si nos quedamos aquí parad{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "#Tienes razón, no tiene sentido que nos quedemos aquí preocupad{F#a}{M#o}s. A lo mejor ya está esperándonos en el Tonatiuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360116,
					"content": "¡Vamos, en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
