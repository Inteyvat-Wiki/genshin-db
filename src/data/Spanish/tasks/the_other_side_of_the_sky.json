			"dialogs": [
				{
					"id": 751360201,
					"content": "¿Qué es esto? Se parece a una pirofosforita, pero brilla y no deja de echar fuego. ¡Es aún más increíble que la de Bona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360202,
					"content": "¿Será que esta es la forma original de la pirofosforita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360203,
					"content": "¡Cómo quema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#*Tsk*, es que, {NICKNAME}, no puedes ir tocando cualquier cosa que parezca un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360205,
					"content": "Aprendí de la mejor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "Mira quién fue a hablar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#Oh, {REALNAME[ID(2)|SHOWHOST(true)]}, ¿sabes algo al respecto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360209,
					"content": "#Guau, {REALNAME[ID(2)|SHOWHOST(true)]}, ¡puede que por fin haya llegado tu momento de brillar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360210,
					"content": "Si encontramos más tesoros que quemen, ¡tú te encargarás de ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360211,
					"content": "Yiii, ¡grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "¡Eeeeh! ¡Eeeeh! ¡Aquíííí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360213,
					"content": "¡Mira, es Bona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360214,
					"content": "Pero ¿qué hace ahí? ¿Será que aterrizó en...? Bueno, da igual, ¡vamos con ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
