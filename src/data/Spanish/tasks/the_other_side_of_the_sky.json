			"trigger": {
				"objectNames": [
					"Bona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751360401,
					"content": "Quién iba a decirme que, con lo difícil que ha sido llegar al Tonatiuh, lo que haríamos aquí es buscar piedras... ¡Pensé que sería una aventura mucho más emocionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "En fin, cuento con ustedes para encontrar los sílex. Si necesitan cualquier cosa, ¡ya saben dónde estoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
			]
		},
		{
