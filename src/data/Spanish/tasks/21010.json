				{
					"id": 210100001,
					"content": "Humm... Necesito pensarlo bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100002
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100002,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100003
					]
				},
				{
					"id": 210100003,
					"content": "Oh, no es nada. Estaba pensando que la Posada Wangshu es un edificio tan alto... Me pregunto cuánto tiempo tomaría bajar todas esas escaleras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100004
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100004,
					"content": "Iba a intentarlo yo mismo, pero luego estas pilas de hojas arruinaron mis planes. Solo quiero deshacerme de ellas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100005
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100005,
					"content": "Pero eso significaría bajar las escaleras y limpiarlas escalón por escalón. De solo pensarlo me siento cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100006
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100006,
					"content": "Lo intentaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100007
					]
				},
				{
					"id": 210100007,
					"content": "Jaja, muy bien. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dandy"
				}
			]
		},
