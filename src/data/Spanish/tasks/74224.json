				"points": []
			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "Qué paisaje tan espectacular. Cada año compro numerosos instrumentos del pueblo, pero solo he estado aquí antes una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240802,
					"content": "¿Qué me puedes contar sobre esta partitura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "Ya me voy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "Cuento con ustedes. Estaré esperando en el pueblo a que regresen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
