			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "Humm... De veras es la partitura de «El forastero a la deriva». ¡No puedo creer que consiguieran encontrarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "#Seguro que les costó muchísimo... ¡Pero nadie podría esperar menos de dos aventurer{F#a}{M#o}s insuperables como ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Jeje, pero ¿qué piensas hacer con esa partitura? No estarás pensando en hacerte rica al ponerla en escena en la Ópera de la Epíclesis, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Hummm... Ganar dinero es importante, pero lo último que haría sería quedarme con esta partitura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Una partitura tan antigua como esta debe formar parte del patrimonio de la humanidad. Por eso, publicaré «El forastero a la deriva» como propiedad pública cuando haya completado mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "Después de todo, ¿no les parece más alucinante el hecho de restaurar una obra perdida y reescribir una página de la historia del pasado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Mucha suerte con ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Bien, ¡será mejor que regrese ya para seguir investigando esa partitura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Ah, aquí tienen su recompensa. ¡Nos veremos cuando el destino vuelva a juntarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "Pero no te olvides de mi contribución, ¿eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "Claro que no. ¡Mencionaré sus nombres en la guarda del libro sobre mi investigación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "Tailleferre"
				}
			]
		},
