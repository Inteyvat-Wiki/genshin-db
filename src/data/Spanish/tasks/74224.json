	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422402",
							"2"
						],
						"stepId": 7422402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "¿Eh? ¡Pero si es Tailleferre! ¡Hola de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "#Vaya, son ustedes dos, {F#la}{M#el} aventurer{F#a}{M#o} y su pequeña ayudante. Me temo que he olvidado sus nombres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#Paimon es Paimon, y est{F#a}{M#e} es {NICKNAME}. La última vez que nos vimos, pudimos interpretar una canción antigua con la arpacola gracias a tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "¿Qué te trae por Petricor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "#Eso es lo mismo que iba a preguntarles a ustedes. Yo he venido por un rumor que he oído por ahí, pero seguro que aventurer{F#a}{M#o}s como ustedes ya están al tanto de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "¿Un rumor? ¿A qué te refieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "¿Eh? Todo el mundo habla de ello cuando mencionan a Petricor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "¿Un rumor sobre cómo salvamos el mundo sin querer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "¿Eh? No, nada de eso. ¡Es obvio que me estoy refiriendo al redescubrimiento del Castillo Apagado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "La última vez que se mencionó el Castillo Apagado en los registros fue hace varios siglos. ¡Y yo que pensaba que ustedes habían venido por eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "En realidad... A lo mejor tenemos algo que ver con eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "Oh, entonces supongo que ya saben que el Castillo Apagado solía pertenecer a Boecio, el músico más importante de la historia de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Tanto las óperas que escribió como las antiguas partituras de Remuria que recopiló son de vital relevancia en la historia de la música de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Y ya que él solía habitar el castillo en cuestión, seguro que se encuentran numerosos documentos valiosos allí. Suponen unos documentos de valor incalculable para la Asociación de Músicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "Por eso, en cuanto me enteré de la noticia, me apresuré a venir hasta aquí. Mi plan era llegar antes que los aventureros para poder recoger esos documentos y conservarlos como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "No pensé que ustedes serían quienes se me adelantasen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(¿Qué hacemos? ¿Deberíamos contarle que ese tal Boecio en realidad es un idiota y que usó la música para cometer malvadas fechorías?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(Pero seguro que se pondría muy triste si descubriese la verdad...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "La serenata ya no podrá usarse con malas intenciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "¿Eh? ¿Qué están rumoreando en mis narices? ¿Acaso ya encontraron alguna partitura antigua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Verás... Paimon tiene una pregunta que hacerte. En el hipotético caso... Paimon solo se está refiriendo a un hipotético caso, ¿eh? Si se diera la casualidad de que Boecio fuera un tipo mezquino y despreciable, ¿todavía estarías interesada en sus partituras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "Humm... Aunque no sé a qué te refieres con eso de “mezquino y despreciable”, la verdad es que Boecio solo ha destacado en el transcurso de la historia por sus contribuciones musicales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "Desde que compuso su ópera romántica «El forastero a la deriva» hasta el fin de sus días podemos presumir que nunca se rindió ante la idea de resucitar Remuria, y que, por lo tanto, veía a la nueva Fontaine como región enemiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "Además, los historiadores alegan que él participó en las guerras que tuvieron lugar antes de que se fundara Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Sin embargo, sus proezas musicales se consideran aparte. Incluso si estuviéramos equivocados en cuanto a la historia de sus piezas musicales, nada de eso podría cambiar el valor artístico que estas poseen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "Y, en mi opinión, eso también es parte de la historia. Hasta el arte más puro puede usarse con fines maliciosos, y todo músico que se precie mantiene eso en mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "#Estoy segur{F#a}{M#o} de que tú nunca utilizarías la música para hacer algo malo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Jaja, pero yo solo soy una investigadora. Para mí es un honor tener la oportunidad de escuchar piezas musicales de tal antigüedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "Por cierto, ya que se ha dado la casualidad de que me he encontrado con ustedes, ¿podría pedirles ayuda con algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "¡Así podrían devolverme el favor de la última vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Pero la última vez nos dijiste que lo hiciste por gusto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Jeje, entonces ayúdenme ustedes a mí esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "En fin, tal y como he mencionado antes, he venido hasta aquí en busca de la ópera pérdida «El forastero a la deriva».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "De acuerdo a unos registros que dejó un tal Ruggiero varios siglos atrás, dicha ópera debe de haber permanecido escondida en alguna parte del Castillo Apagado. Sería maravilloso si ustedes pudieran echarme una mano para encontrarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "#Imagino que ustedes serían más rápid{F#a}{M#o}s que yo en encontrarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME}, ya que nos lo ha pedido, aceptemos ayudarla. De todas formas, esas partituras ya habrán perdido todo ese... poder. ¿No crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "Humm, entonces les tomaré la palabra. ¡Qué alegría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Cuento con ustedes. Estaré esperando en el pueblo a que regresen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "Me temo que eso no te saldrá gratis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "#No se preocupen, pueden estar segur{F#a}{M#o}s de que recibirán una recompensa. ¡Los miembros de la Asociación de Músicos tenemos recursos de sobra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "Esto me lo veía venir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Tus convicciones son de lo más interesantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Jeje, simplemente les di mi opinión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "Me temo que esto va a ser difícil de explicar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "¿Un rumor sobre la famosa hipnosis de Petricor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
