			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#¿{NICKNAME} y Paimon? ¿Qué pasa? ¿Tienen un encargo megaimportante para el genio de la mecánica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "#Como somos amig{F#as}{M#os}, ¡les haré un descuento del 20%! Solo tráiganme unos dulces... Shh, ¡no se lo digan a Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "Estamos dando vueltas para ver si hay algo que valga la pena capturar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Pues llegaron al lugar indicado. En el taller de Aino hay montones de cosas brillantes que no encontrarán en ningún otro sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Solo caminen con cuidado. No quiero que se tropiecen con las piezas que hay por el suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Qué curioso es este robot, ¿es uno de los tuyos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Jeje, ¡sí! Se llama “Puñopato”. Al principio quería que fuera un robot clasificador de residuos que me ayudara a ordenar toda la chatarra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Pero lo hice tan resistente, y sus brazos son tan flexibles, que se me ocurrió incorporarle un sistema de defensa ultrapotente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "Así, si algún tipo malvado y despistado se atreve a colarse en mi taller, él se ocuparía de arrasarlos como basura no reciclable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Aino siendo tan imaginativa como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Ya que estamos, ¿te puedo tomar una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "¿A mí? ¿Con el Puñopato? Normalmente a la gente solo le interesan mis inventos. Rara vez me quieren tomar una imagen a mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Pero si lo que quieren es documentar a este genio de la mecánica con su robot sin rival en su día a día, ¡adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "Es solo que... no suelo tomar imágenes, así que no sé cómo posar... ¿Qué pasa si no salgo bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Sé tú misma, es todo lo que tienes que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "De acuerdo, confío en ti. ¡Asegúrate de que el Puñopato también salga impresionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "¡Intentaré que salgas divina!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "¿Te parece si te tomo una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "Este robot es muy especial, ¿forma parte de tu colección?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "Estamos buscando inspiración para tomar imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
