				"points": []
			},
			"dialogs": [
				{
					"id": 210230201,
					"content": "Espero que se apresuren a reparar esas escaleras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230202,
					"content": "¿Es usted el gerente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "Sí, ¿tienen algún asunto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230204,
					"content": "Es un paquete para usted. La persona de abajo nos pidió que lo trajéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210230205,
					"content": "Ya veo, debe ser el paquete de ese cliente. ¿Por qué no vino a entregarlo Zhen Chiang en persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230206,
					"content": "¿Todavía tiene que recibir materiales? ¿O será que le da pereza subir y bajar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230207,
					"content": "Les pido disculpas, ustedes son huéspedes. Las escaleras se rompieron en un mal momento. Tendré que pensar en cómo arreglarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230208,
					"content": "De verdad, lo siento. A pesar de todo, les hice subir a que me entregaran un paquete. Por favor, acepten esto como compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230209,
					"content": "Pensaba dárselo a Zhen Chiang, pero ya que les hizo venir hasta aquí, es mejor que se lo dé a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230210,
					"content": "Bien, estaré preparando los materiales para arreglar esas escaleras. Pueden recorrer la posada. Si se les ofrece algo, solo vengan a buscarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
	]
