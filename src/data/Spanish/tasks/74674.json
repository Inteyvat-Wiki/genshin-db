			"dialogs": [
				{
					"id": 746740101,
					"content": "Taeles antiguos y más Taeles antiguos... Muy bien, ¡así me gusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740102,
					"content": "Con tantos taeles, podré ganar una pequeña fortuna. ¡Gracias a ti y a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740103
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740103,
					"content": "¿Qué tienes planeado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746740104
					]
				},
				{
					"id": 746740104,
					"content": "Pues... convertir estos Taeles antiguos en Moras o cosas que me sean de utilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740105
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740105,
					"content": "En serio, ya no quiero colaborar con ese intermediario, siempre se lleva una gran parte de la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740106,
					"content": "Además, el Mora tarda mucho en llegar a mis manos. ¿Qué diantres estará haciendo con todo eso?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740107,
					"content": "Pero es que aparte de él, ya no conozco a nadie más, *suspira*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740108,
					"content": "¡Dejemos el tema! Esto es para ustedes, ¡considérenlo como un pequeño detalle por nuestra fructífera cooperación a largo plazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740109,
					"content": "Una vez que termine mi negocio aquí en Fontaine, tendré que pensar detenidamente en el próximo. No puedo estar siempre viajando, es demasiado cansado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				}
			]
		}
	]
