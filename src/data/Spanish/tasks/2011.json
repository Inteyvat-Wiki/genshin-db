			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "¡Ojo al parche! Al fin estáis aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110302,
					"content": "Durante todos estos años, ni las tempestades lograron retrasar a la Flota Crux Meridianam. Si no se tratara de vos, ya habría zarpado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110303,
					"content": "¡Mis disculpas, Capitana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "Jajaja, no hagáis caso de mis chanzas. Llegáis justo a tiempo, la tripulación acaba de terminar con los últimos preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110306,
					"content": "Ahora que estamos todos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110307,
					"content": "Zarpamos hacia la tierra rodeada de tormentas y tempestades... ¡La nación de la “eternidad”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110308,
					"content": "¡Leven anclas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110304,
					"content": "¡Es un honor estar a bordo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "¡Por fin está aquí! Me ha hecho esperar, Capitana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110702,
					"content": "#¡Y parece que tenemos un par de polizon{F#as}{M#es}! O debería decir... invitad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110703,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110704,
					"content": "Podéis echarle la culpa a vuestra poderosa Shogun. Las tempestades que rodean Inazuma son incluso más fieras que antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110705,
					"content": "Aunque la flota estaba a la altura del desafío, el tiempo inclemente causó algún retraso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110706,
					"content": "Ahora dejad que os presente. Este es Thoma, un socio comercial al que he conocido recientemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110707,
					"content": "#Je, tenía muchas ganas de conocerl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110708,
					"content": "#Thoma, est{F#as}{M#os} son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110709,
					"content": "#No hay necesidad de presentaciones. ¡Su reputación les precede! Parece que ni los mares agitados pueden contener los rumores sobre las hazañas de {F#estas forasteras}{M#estos forasteros}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110710,
					"content": "Es un placer, Thoma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Me alegra oír eso, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110713,
					"content": "Jeje, si tenéis suerte, esto os resultará conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Thoma lleva muchos años en Ritou. Podría decirse que es la persona a la que acudir para cualquier asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110715,
					"content": "Si tenéis cualquier problema, hablad con él. Pero si intenta engañaros, me encargaré de él personalmente la próxima vez que venga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110716,
					"content": "Jajaja, no hay de que preocuparse. Estoy seguro de que nos llevaremos muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110717,
					"content": "En ese caso, me marcharé ya. A fin de cuentas, llevo a un fugitivo en mi navío, no querría que me pillaran con las velas bajadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110718,
					"content": "¡Es cierto! Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110719,
					"content": "#Hasta la próxima, viajer{F#a}{M#o}. No olvidéis dar lo mejor de vos mism{F#a}{M#o}, cualesquiera que sean las “tempestades” a las que os enfrentéis en Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110720,
					"content": "No habrá ningún problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "¡Buen viaje, Capitana Beidou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110723,
					"content": "Bueno, lo primero es lo primero. Ahora debemos ir al puesto fronterizo para que les registren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110724,
					"content": "¿Eh? Paimon pensaba que teníamos que mantener un perfil bajo... ¿Vamos a entregarnos directamente al gobierno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110725,
					"content": "Jaja, no subestimen el alcance del Decreto de cierre de fronteras. No podrían evadir las inspecciones ni aunque lo intenten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110726
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110726,
					"content": "Así que debemos seguir las reglas del juego... aunque las adaptemos un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110727,
						20110728
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110727,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
