				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "#¡Ad astra abyssosque! ¿Qué puedo hacer por ti, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110102,
					"content": "¿Qué sabes sobre Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "Ah, sí, escuché que ya hiciste los arreglos con la capitana de la Flota Crux Meridianam para viajar a Inazuma. ¿Es correcto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110105,
					"content": "Ahora que lo pienso, hace mucho tiempo que no visito esas tierras. Lamentablemente, no tengo ninguna información que pueda servirte en este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110106,
					"content": "#¡Ahí estás! Eres {F#la viajera}{M#el viajero} que Beidou llevará a Inazuma, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110107,
					"content": "¡Te he estado esperando el día entero!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Ah, ya veo. Jeje... Es un honor conocerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110110,
					"content": "La flota casi ha completado el acopio de suministros. Una vez que los tripulantes hayan terminado el inventario, podemos ponernos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110111,
					"content": "La Capitana Beidou me envió a buscarte. Levaremos anclas en cuanto estés a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110112,
					"content": "Parece que Beidou es una persona de palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "#¡Por supuesto! La capitana tiene un fuerte sentido de la responsabilidad. Estoy seguro de que lo verás por ti mism{F#a}{M#o} una vez que estés a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110114,
					"content": "Entonces, ¿te marchas? Supongo que me corresponde felicitarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110115,
					"content": "Ya sea que el viaje que tienes por delante te lleve más allá del firmamento o a las profundidades del abismo, cada paso que des es un nuevo logro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110116,
					"content": "¡Hasta que nos volvamos a encontrar, ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110117,
					"content": "Ad astra abyssosque, Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Ay... Es tan difícil despedirnos de ti. Prácticamente nos vemos todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "#Jeje, ¿en serio? ¿Por qué no vienen a buscarme cuando lleguen? L{F#as}{M#os} estaré esperando en la Isla Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "¡Entonces hay otra Katheryne en Inazuma! ¿Ves? No hay necesidad de despedidas cursis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Jaja, bueno, supongo que es hora de que se despidan de Liyue. Ahora que he entregado mi mensaje, volveré. El barco está anclado actualmente en el Bosque de Piedra Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110125,
					"content": "De acuerdo, gracias por venir hasta aquí a informarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "#Solo sigo órdenes. L{F#as}{M#os} veré a bordo del Alcor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drake"
				},
				{
					"id": 20110122,
					"content": "... ¡Lo sabía!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Te extrañaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Parece que llegó nuestro informe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "Cuéntame de la Flota Crux Meridianam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201103",
							"2"
						],
						"stepId": 201103,
						"stateName": "QUEST_STATE_UNFINISHED"
