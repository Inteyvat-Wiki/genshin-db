			"dialogs": [
				{
					"id": 761920201,
					"content": "Qué buena imagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "Macey"
				},
				{
					"id": 761920202,
					"content": "¿Ya estás satisfecha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920203,
					"content": "¡Sí! No importa si la leyenda es cierta o no, espero que vayas a donde vayas, Helka, la buena suerte te ayude a superar cualquier peligro, y que al final regreses sana y salva al Speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "Macey"
				},
				{
					"id": 761920204,
					"content": "... Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920205,
					"content": "Jeje. ¿Volvemos? Linnéa, ¡gracias a ti también! ¡Nos vemos en el Speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "Macey"
				},
				{
					"id": 761920206,
					"content": "¡Allí nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnéa"
				}
			]
		},
