			},
			"dialogs": [
				{
					"id": 150050201,
					"content": "El paisaje de este lugar es hermoso, incluso hay Koholasaurios... ¿Por qué no intentamos tomarnos una imagen con uno salvaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050202,
					"content": "¿Y si nos atacan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Eh... Paimon piensa que los Koholasaurios son demasiado adorables para atacar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050204,
					"content": "¿Eh? Esos de ahí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050205,
					"content": "¡Socorro! ¡Que alguien nos ayude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050206,
					"content": "¡Vaya, los Koholasaurios salvajes están intentando atacarlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050207,
					"content": "¡Hora de defender a los necesitados!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#¡Exacto! Esos dos están en problemas, ¡y {F#la}{M#el} célebre {NICKNAME} y su compañera no se quedarán de brazos cruzados viendo cómo sufren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050209,
					"content": "Supongo que esa imagen tendrá que esperar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "Sí, no hay tiempo para eso. Hay gente pidiendo ayuda, ¿cómo vamos a quedarnos de brazos cruzados mirando sin más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}