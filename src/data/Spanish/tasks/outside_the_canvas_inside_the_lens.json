			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "*Cof*... No puedo seguir así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830102,
					"content": "Si sigo retrasándolo, no habrá manera de entregar la versión final. Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830103,
					"content": "Hola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830106,
					"content": "¡Perdón, perdón! ¡Le aseguro que entregaré la versión final hoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830107,
					"content": "#¡Aah! Espera, nosotr{F#as}{M#os} solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830108,
					"content": "Srta. Moriko, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830109,
					"content": "¿Eh? Así que no eres la Srta. Moriko, qué alivio... *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830110,
					"content": "Y la Srta. Moriko es...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "La Srta. Moriko es mi editora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830112,
					"content": "Soy Asagiri. Soy una... ilustradora independiente, supongo. La Srta. Moriko se encarga de coordinar mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830113,
					"content": "¿Ilustradora? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830114,
					"content": "Supongo que leyeron las novelas ligeras de la Editorial Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830115,
					"content": "En esas novelas, ¿no encontraron que en algunas páginas no hay texto, sino imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830116,
					"content": "Ese tipo de imágenes que se incorporan en algunas novelas se llaman ilustraciones, ¿saben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830117,
					"content": "Si en las novelas aparece un escenario o personaje importante, o si simplemente se desea que la imagen auténtica del protagonista aparezca, algunos autores prefieren añadir ilustraciones en sus libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830118,
					"content": "De esta manera, no solo se mejora la experiencia del lector, sino que el contenido también resulta mucho más enriquecedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830119,
					"content": "Oh... Las novelas ligeras son más complicadas de lo que Paimon imaginaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830120,
					"content": "¡Puedo recomendarles algunos libros! Por ejemplo, ¡ese libro!... Ese que... *Cof*, *cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830121,
					"content": "Eh... ¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "No es nada. Siempre he tenido una salud delicada, quizás sea porque a menudo trasnocho para hacer ilustraciones y a veces hasta me olvido de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830123,
					"content": "*Cof*... Por eso mi salud va de mal en peor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830124,
					"content": "Si afecta tanto a tu salud, ¿por qué dibujas aquí? Podrías hacerlo en tu casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830125,
					"content": "Vine aquí para inspirarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830126,
					"content": "Hace un tiempo que se disipó mi inspiración para dibujar. Ya llevo con retraso varias entregas pendientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830127,
					"content": "La Srta. Moriko pospuso por mí la fecha de entrega en numerosas ocasiones. Si no consigo acabar a tiempo esta vez, seguro que estallará de furia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830128,
					"content": "Si al menos pudiera ir a dar un paseo, tal vez así podría encontrar un atisbo de inspiración. Por eso quería irme de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830129,
					"content": "Pero, al final... Jeje, como pueden ver... Camino unos pasos y ya no puedo más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830130,
					"content": "*Suspira*, será mejor que vaya al Gremio de Aventureros a publicar un encargo, quizás el tipo del Daguerrotipo pueda echarme una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830131,
					"content": "¿Eh? Ha mencionado el Daguerrotipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830132,
					"content": "Justamente tengo un Daguerrotipo aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "¡¿Qué?! ¿Tienes un Daguerrotipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830135,
					"content": "Les encargo a los aventureros que utilicen el Daguerrotipo para tomar imágenes para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830136,
					"content": "¡Dicen que hay cientos de lugares interesantes allá afuera! Como esa montaña nevada tan alta que hay cerca de Mondstadt o ese lugar repleto de pilares en Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830137,
					"content": "Y, y, y, y... Ese sitio de Liyue que se llama Desfiladero Jueyun. ¡Dicen que ahí viven los Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830138,
					"content": "El hogar de los Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830139,
					"content": "Lamentablemente, mi estado de salud no me permite ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830140,
					"content": "Pero, si tú puedes ayudarme a capturar esos paisajes con el Daguerrotipo, yo también podré... *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830141,
					"content": "¡Ay! ¡Tranquila! ¡No te fuerces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830142,
					"content": "Descuida, yo te traeré las imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "¡¿De verdad?! ¡Eso es maravilloso! Hay tantos sitios que me gustaría ver... Espera, déjame que te los muestre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830145,
					"content": "Por cierto, no te preocupes por la recompensa... Tengo mis ahorros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830146,
					"content": "¿Dónde he puesto mi cuaderno? Cuaderno, cuaderno... ¿Dónde estás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830143,
					"content": "Encontraré la forma de mostrarte esos lugares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "¿Por qué necesitas un Daguerrotipo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "Disculpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}