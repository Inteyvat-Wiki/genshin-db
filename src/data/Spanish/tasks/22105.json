			"dialogs": [
				{
					"id": 221050101,
					"content": "Qué dolor de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "Hay algo extraño alrededor de esta posada, pero no puedo explicarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "Y tampoco ayuda que la gente que viene a hospedarse sea un tanto sensible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "Con tan solo un soplo de brisa en la hierba, terminamos con las ventanas y las puertas rotas, a veces incluso el suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "Los huéspedes están dispuestos a pagar por las reparaciones, pero hay cosas rotas por doquier. Es horrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "¿Puede echarle un vistazo a los alrededores de la posada? Sea lo que sea... hágase cargo. Yo tengo que quedarme a atender a los huéspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "¿Qué le pasa a estos huéspedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "¿Los huéspedes? Oh, no hace falta preocuparse por ellos. Si escalas montañas y cruzas ríos todo el año, es de comprender que estén alertas todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Pero, por favor, ¿puede inspeccionar los alrededores? No será gran cosa para alguien como usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
