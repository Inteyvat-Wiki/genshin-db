			"dialogs": [
				{
					"id": 735340901,
					"content": "#Oh, ¿tú eres {F#la amiga extraordinaria}{M#el amigo extraordinario} de Dharmakirti? Me llamo Piyush, trabajo en la arquitectura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "Kaveh me habló de ti, pero no había tenido la oportunidad de conocerte en persona. Parece que el destino ha querido que nos encontremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "Creo que soñaré con el proyecto que acabo de entregar. Puff, una gran pesadilla... No pensé que nuestro primer encuentro fuera en una situación como esta... En fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
