			"dialogs": [
				{
					"id": 735340701,
					"content": "¿Tan jóvenes son los voluntarios para este ensayo onírico? Vaya, la juventud de hoy en día es prometedora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Llámame Nitesh. Soy un erudito itinerante de la Escuela de Elementalismo y actualmente estoy trabajando en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "#Cuando uno envejece, es fácil encontrarse con todo tipo de problemas. Jovencit{F#a}{M#o}, dependeré de ti para encontrar el origen de todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
