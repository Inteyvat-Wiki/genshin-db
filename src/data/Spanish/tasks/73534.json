			"dialogs": [
				{
					"id": 735340301,
					"content": "#Es un placer conocerte. Supongo que en breve entraremos junt{F#as}{M#os} en un sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "Mi nombre es Youguang, una escolta de Liyue. Estoy aquí para pedir ayuda. Hace unos días me topé con algo extraño mientras hacía mi trabajo y no he dormido bien desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Sería genial que pudieras eliminar mis pesadillas con una terapia onírica. Te lo agradecería eternamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
