			"dialogs": [
				{
					"id": 735340101,
					"content": "Hola, ¿eres tú quien me hará la terapia onírica? Para ser sincero, no tengo idea de qué soñaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Soy de Mondstadt. No tengo ninguna afición... excepto beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "A veces, cuando bebo demasiado, termino metiéndome en problemas... Esta vez cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
