			"dialogs": [
				{
					"id": 735340501,
					"content": "Es un placer. Soy Higuchi Tetsuya, un escritor de novelas de youkai de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "Últimamente, he estado muy estresado por entregar a tiempo una novela que estoy escribiendo. Estaría dispuesto a probar cualquier cosa con tal de recobrar el ánimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "Me gustaría pedirte disculpas de antemano por si ves algo raro. Después de todo, este es un sueño basado en los problemas con los que estoy lidiando actualmente, por lo que podría contener algunas cosas muy personales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
