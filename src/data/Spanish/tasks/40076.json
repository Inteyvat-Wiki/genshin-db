					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "¡Guau! Un momento, ¿pero qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "¿Otra casa en Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "¡¿Cómo hemos acabado en mi casa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "¿Tu casa? ¿Esta es tu casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "Vaya, es realmente inesperado... Había escuchado que la Srta. Megistus llevaba una vida modesta. En cambio, esta morada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "Miren las etiquetas de los libros en el suelo. “Único e inigualable. Novecientos noventa mil Moras. Precio no negociable”... ¡Es carísimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "Las portadas de muchos de estos libros parecen caras... Así que así luce la habitación de una astróloga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "Un diseño exquisito... Este lugar debe de ser muy caro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "Conque Mona es millonaria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Oye, a veces no tengo Moras, pero nunca dije que fuera pobre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "¿No lo eres? ¡Hum! ¿Y qué hay de todas las veces que te he invitado a comer? ¡Incluso te invité a mi casa para cenar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "Señorita, el decoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "*Ejem*... Tuviste el privilegio de visitar mi palacio en el Reino de la Noche Eterna, donde tuviste un encuentro con el Káiser y la Káiserin del Juicio. ¿O acaso olvidaste deliberadamente esa magnífica ocasión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "¡Es verdad! ¡El estofado y las carnes frías que hizo tu madre estaban deliciosos! De repente me dieron ganas de ir de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "Srta. Megistus, ¡ahora no es el momento de hablar de eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "¿Comida de Mondstadt? ¡Yo también quiero probarla! Escuché que Mondstadt tiene muchos platos especiales, sobre todo de carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "Jeje, entonces te concederé el honor de conocer al Káiser y a la Káiserin la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#¿En serio? ¡{NICKNAME}, deberíamos ir también nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "Ahora que lo mencionan, hace mucho que no visito la casa de algún amigo. Me encantaría ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "Ehmm, deberíamos llevar un obsequio, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "Ambos son muy buenos y comprensivos, así que no se preocupen por ese tipo de cosas. Con su asistencia es más que suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "Deben probar el plato de carnes frías de su madre. Creo que es su especialidad. En fin, ¡que es una delicia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "Lamento la interrupción, pero ¿no deberíamos resolver el acertijo primero? Desde que entramos, no deja de inquietarme ese adorno de ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "¡Oh, tienes razón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "#Toda mi vida engañad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "Estamos de vuelta. ¿Entonces ya salimos de la ilusión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761302,
					"content": "Qué extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761303,
					"content": "No había pistas relacionadas con la máquina ni con los Fatui en mi ilusión... Tal vez no tienen nada que ver con estas ilusiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761304,
					"content": "¿A lo mejor estas ilusiones son una consecuencia, y no el resultado de un proceso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761305,
					"content": "Eh... Paimon no entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761306,
					"content": "Me refiero a que estas ilusiones no son pistas para resolver un misterio, sino que son el resultado directo de lo que sea que está ocurriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761307,
					"content": "Alguien hizo algo para crear estas ilusiones. Ya que son solo consecuencia de ello, es normal que no nos den ninguna información útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761308,
					"content": "En otras palabras, estas ilusiones solo están relacionadas con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761309,
					"content": "Son solo materializaciones de nosotros mismos. Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761310,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761311,
					"content": "Deberíamos volver a donde todo comenzó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761312,
					"content": "#El día en el que llegamos por primera vez a la isla, {NICKNAME} y yo investigamos el campamento de los Fatui juntos. Había una máquina extraña y algunos Fatui desorientados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761313,
					"content": "Sip.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "El investigador con el que hablamos dijo que la máquina solo era una invención de los Fatui, e incluso nos prometió que no nos molestaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761315,
					"content": "Es verdad, el tipo rechoncho del sombrero se veía somnoliento. ¡No dejaba de decir disparates!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761316,
					"content": "¿Tal vez la “locura” y las ilusiones son dos consecuencias diferentes de esa máquina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761317,
					"content": "Si ese es el caso, todo esto está relacionado con ese aparato dañado. Solo que la forma en que afecta a cada persona depende del individuo en sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761319,
					"content": "Dicho de esa forma, sería difícil discernir entre un sueño y una alucinación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761320,
					"content": "¿Estás diciendo que la máquina nos afecta de forma distinta porque somos diferentes a los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761321,
					"content": "Así es. De acuerdo a lo que hemos podido observar estos días, creo que, a diferencia de ellos, tenemos una voluntad más firme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761322,
					"content": "Sí, tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761323,
					"content": "En lugar de caer en la locura, las personas con una voluntad firme alucinan, pero aquellos de convicción débil flaquean y no pueden mantener una ilusión estable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761324,
					"content": "En otras palabras, tenemos que volver inmediatamente al campamento de los Fatui y destruir ese aparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761325,
					"content": "No. En lugar de destruirlo, deberíamos repararlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761326,
					"content": "Lo que quiere decir la señorita es que destruir una máquina de la que sabemos poco podría producir graves consecuencias. Es mejor encontrar una forma de repararlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761327,
					"content": "Sí, tenemos que ser precavidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761328,
					"content": "Si no me equivoco, esta máquina afecta al cerebro de las personas, así que debemos tener mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761329,
					"content": "¡Démonos prisa! ¡No hay tiempo que perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl",
					"Oz",
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "¡Qué vista tan espectacular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "Srta. Megistus, esta es la mejor prueba de su gran inteligencia. Sin duda alguna, usted es la mejor archimaga en la historia del Reino de la Noche Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "Gracias. Aunque el Reino de la Noche Eterna no tiene tanta historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "Estrellas que parecen diamantes, una luna que parece una perla. La vista más maravillosa sobre la faz de la tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "¡Es hermoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "Si esto es solo una ilusión, Mona debe albergar en su corazón un mar infinito de estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona, ¿ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "Me imagino que esto debe de ser a lo que aspiramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "Este cielo estrellado es hermoso. Me atrevo a decir que es incluso más hermoso que lo que veo en mis adivinaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "Cada estrella está en el lugar correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "Definitivamente, esta es mi ilusión. Solo aquí podría ver un paisaje tan extraordinario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "¿“Extraordinario”? ¿Por qué lo dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "¿Saben? El cielo estrellado de Teyvat es realmente maravilloso. Es como si todas las respuestas del universo estuvieran ocultas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "“¿Cuándo encontraré a mi hijo desaparecido?”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "“¿Esa persona realmente me ama?”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "“¿Lograré recuperarme?”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "Conforme tus estrellas se mueven por el firmamento, registran en su trayecto todos los acontecimientos de tu vida. De todas las personas que hay en este mundo, las estrellas de muchas de ellas se desvían del camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "Si tu estrella mantiene su trayectoria, tendrás una vida sana, alegre y tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "Pero si se desvía, todo empezará a salir mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "El cielo estrellado de mis adivinaciones nunca lucirá tan perfecto como este. Algunas estrellas pierden el camino y otras caen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "Desearía que todo el mundo fuera feliz y siguiera su camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "Es por eso que doy mi consejo y hablo con la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "Sé que es inútil. El cielo nocturno revela el destino de todos, incluso el mío. Pero no hay nada que pueda hacer para cambiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "Sin embargo... Poniendo la astrología y los hechos a un lado, todavía me aferro a una fantasía absurda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "La humanidad se guía por los límites de la realidad. Sin embargo... llámenme ingenua si quieren, pero creo en los milagros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "En este mar de estrellas tan vasto están sus estrellas, las mías y las de todos los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "¿Cuál es la probabilidad de que dos estrellas se encuentren? ¿Acaso esos encuentros no son los mayores milagros del destino? No lo sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "Pero en Teyvat, las estrellas siempre tendrán un lugar para nosotros. Por más pragmática que sea la astrología, el destino es arbitrario, cruel y romántico a la vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "Mona, parece que has meditado mucho al respecto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "¿Has encontrado la respuesta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "Creo que ya sé qué es lo que las estrellas ocultan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "“Ahora tomaré las riendas de mi propio destino”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
