			"dialogs": [
				{
					"id": 756750101,
					"content": "¡Jé! ¡Já!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750102,
					"content": "La música no ha parado de sonar en mi mente. ¡A bailar, a bailar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750103,
					"content": "¡A moverse, a moverse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750104,
					"content": "¡La más feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750105,
					"content": "¡Grra, grra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Mo'o"
				},
				{
					"id": 756750106,
					"content": "Y además gané un poco de dinero extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750107,
					"content": "¿Eh? ¿Y eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750108,
					"content": "La señorita Ñusta andaba hasta el cuello de trabajo, así que me escapé un rato para ayudarle a su aprendiz a acabar con unos cuantos nidos de monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750109,
					"content": "En Natlan, pelear se disfruta tanto como bailar. Me gusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750110,
					"content": "Te debo una, Marine. Mi intención era que los nuevos integrantes pudieran aprender con la práctica, pero parece que aún no están capacitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 756750111,
					"content": "Cuando vuelva, ¡les voy a poner un entrenamiento intensivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 756750112,
					"content": "Tranquila, lo hicieron muy bien. El problema fue que no esperábamos que en el nido hubiera siete veces más monstruos de lo previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750113,
					"content": "La Tribu Plumaflora me pagó muy bien, así que ya reuní suficiente dinero para comprarle un regalo a Aeval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750114,
					"content": "Ya se te están acabando las vacaciones, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750115,
					"content": "Sí, en unos días más tendré que reservar el billete de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750116,
					"content": "No hay prisa. Todavía podemos bailar. La pequeña Roxane, Letellier, Chênée y Fréjus últimamente se están peleando por aceptar encargos, así que no debería quitarles trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750117,
					"content": "Entonces sigamos bailando y disfrutando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750118,
					"content": "¡Una vida sin preocupaciones! ¡Bailen hasta cansarse, coman hasta llenarse y duerman a pierna suelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750119,
					"content": "¡Grraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Mo'o"
				},
				{
					"id": 756750120,
					"content": "Las melusinas y el pequeño Koholasaurio forman una fila y van saltando felices hacia el escenario.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "Qué grupo de invitados tan adorable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 756750122,
					"content": "Jeje, parece que a ti también te está gustando, Ñusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756750123,
					"content": "Estás sonriendo y se te ve más relajada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "¿De verdad? Entonces, de ahora en adelante, no pienso perderme ningún festival de baile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 756750126,
					"content": "Quiero que esos jóvenes que me llaman “señora” algún día se den cuenta de que mi espíritu es más joven que el de todos ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 756750127,
					"content": "Los futuros festivales de baile deberían tomar este como ejemplo y celebrarse con más frecuencia. ¡Yo digo que una vez al mes sería lo ideal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 756750124,
					"content": "Hasta pareces más joven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}