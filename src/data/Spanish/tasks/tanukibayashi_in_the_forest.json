			"dialogs": [
				{
					"id": 721080101,
					"content": "Por fin llegamos. Este debe ser el Bosque Chinju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080102,
					"content": "La miko de la máscara dijo que tiene un viejo amigo dentro del Bosque Chinju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080103,
					"content": "Entonces, ¡adelante, entremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
