						"rawParams": [
							"7210816",
							"2"
						],
						"stepId": 7210816,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210810",
							"3"
						],
						"stepId": 7210810,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "La estatua de Zorro Celestial que debía proteger a los amuletos... está vacía por dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080402,
					"content": "Quizás el viejo amigo de la miko de la máscara lo escondió. ¡Vamos a averiguarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080403,
					"content": "¿M-miko de la máscara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "Se le acaba de ocurrir ese apodo a Paimon. ¿Te gusta? Es más fácil de recordar, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080405,
					"content": "No, en absoluto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "Bueno, olvídalo... En fin, ¡busquemos pistas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080406,
					"content": "No tiene sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "Ah, yo... soy Ioroi. ¡Hagan lo que quieran! Si quieren matarme, ¡adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080702,
					"content": "Guau, ¡la estatua habla! Y está tan asustada que ni siquiera puede hablar con claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080703,
					"content": "¡No soy una estatua! Me veo así solo porque alguien me encerró en esta forma temporal. ¡Soy Ioroi, el tanuki reconocido a nivel mundial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080704,
					"content": "¿Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "¿Qué? ¿Acaso están diciendo que la gente hoy en día no ha oído hablar de Ioroi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080707,
					"content": "«El pergamino del Tanuki Gyoen», «La tetera Ioroi», «El protector oculto Oobayashi», «La batalla de los tanuki en la Montaña Yougou»... ¿nunca han oído hablar de estas historias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080708,
					"content": "¿Cuánto tiempo he estado encerrado aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080709,
					"content": "No tengo intenciones de dañarte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "¿Qué? ¿No vienes a destruirme? ¿Por qué no lo dijiste antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080719,
					"content": "*Ejem*, ¡habla! ¿Por qué vienes a buscarme a mí, el Rey de los Tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080720,
					"content": "Es por la ceremonia de purificación del Cerezo Sagrado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "¿La ceremonia de purificación de qué? ¿Qué clase de patraña demoniaca es esa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080726,
					"content": "Increíble...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "Ah, ¿será realmente el viejo amigo de la miko de la máscara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080728,
					"content": "En fin, estamos buscando algo escondido dentro de una estatua kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080729,
					"content": "Ah... ¿p-por qué l-lo están buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080730,
					"content": "Guau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "Fue por culpa de esa peineta que me encerraron aquí durante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080733,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080734,
					"content": "¿Cien años?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "¡No sé por cuánto tiempo! La luz del sol no llega al Bosque Chinju. ¡No hay forma de saber cuánto tiempo pasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080738,
					"content": "En aquel entonces, causé estragos por todas partes para obligar a salir a esa kitsune escurridiza, pero todo fue en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080739,
					"content": "Liberé mi ira contra la estatua de la kitsune y encontré una peineta dentro. ¡Entonces se me ocurrió una idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080740,
					"content": "La peineta estaba escondida dentro de la estatua de la kitsune, e incluso tenía el símbolo de Hakushin. Eso, combinado con el cabello blanco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080741,
					"content": "Me llevó a pensar que debía ser un objeto muy importante para ella. Si quería obligar a salir a la kitsune escurridiza de su madrigera, ¡solo necesitaba esconder la peineta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080742,
					"content": "Sí, ¡un tesoro es una buena forma de captar la atención de alguien! ¿Y qué pasó luego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080743,
					"content": "Luego vino uno de los humanos de los Tres Yougou. Me derrotó a mí y a mi tribu, y nos convirtió a todos en piedras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080744,
					"content": "Por eso Ioroi le teme a los humanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080745,
					"content": "¡Bah! Los humanos son tan efímeros y volubles... No entiendo qué les ve esa kitsune escurridiza que le agradan tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080746,
					"content": "En especial ese tipo que me encerró... Me dijo que adoptara una buena pose para que pudiera convertirme en una estatua agradable a la vista. ¡Maldito sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080747,
					"content": "Bueno, ciertamente combinas con el paisaje...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "¿Eh? ¡¿Cómo se te ocurre...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080749,
					"content": "#(Oye, {NICKNAME}, no lo hagas enojar, o nunca conseguiremos el amuleto...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080750,
					"content": "Me refiero a que te ves muy fuerte y enérgico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "¡Exacto! ¡Haces que este bosque oscuro luzca mucho más animado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080753,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080754,
					"content": "Continúa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080755,
					"content": "Como la estatua de un dios...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "Ah, estar sellado no es tan malo después de todo, ¿ves? ¡Los humanos no quieren hacerte daño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080758,
					"content": "Creo que entiendo lo que quieres decir, pero tampoco tiene mucho sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080759,
					"content": "¿Podemos echarle un vistazo a la peineta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "Sí, podrían... Solo si antes juegan con los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080761,
					"content": "#No hay problema, {NICKNAME} es buen{F#a}{M#o} con los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080762,
					"content": "Creo que te confundes de persona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "Shousei, Gyoubu Koban y Kichiboushi. Busca a estos <color=#00E1FFFF>tres pequeños tanuki</color> en el bosque y juega con ellos. Yo lo haría, pero como verán, estoy un poco indispuesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080766,
					"content": "Ese tipo no hizo un buen trabajo al encerrarlos. Por eso, algunos de ellos pudieron liberarse antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080767,
					"content": "Espera, ¡así no era! En realidad, como el poder de los tanuki es tan grande, ¡era solo cuestión de tiempo para que pudiéramos liberarnos de un mero sello humano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080768,
					"content": "Entonces, ¿cómo es que tú acabaste...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "*Ejem*... Oh, sí, ¡tiene razón, gran y poderoso Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080771,
					"content": "A pesar de que su poder realmente no se compara con el mío, aún lo pueden usar para esconderse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080772,
					"content": "¡Ahora, vayan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080770,
					"content": "¡Cuánto poder!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "Así es, juego con Paimon todo el tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080756,
					"content": "Ni siquiera las Estatuas de Los Siete se ven tan majestuosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "Me refiero a que te ves muy apuesto y fornido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "¿Mil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "¿Un millón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "Parece que tocamos una fibra sensible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "El amuleto de este lugar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "¿Cateto? ¿Eso se come? Los tanuki somos expertos en cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080724,
					"content": "¡No, es para la ceremonia de purificación del Cerezo Sagrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080725,
					"content": "¿Cerdo magro? Uff, hace tanto tiempo que no saboreo una buena chuleta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080711,
					"content": "Vine a cobrar una deuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "Eh, ¿cobrar una deuda? ¿Dónde? ¿Cuándo? Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080713,
					"content": "Tú... ¿Qué te debo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080714,
					"content": "Sí que se está esforzando por recordar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080715,
					"content": "¡Oye, no deberías bromear así con extraños!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080716,
					"content": "¡Basta de bromas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080717,
					"content": "Está bien, está bien... Será mejor que me asegure. ¿De verdad no te debo nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080718,
					"content": "... ¿Tantas deudas tienes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080705,
					"content": "¿Reconocido a nivel mundial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
