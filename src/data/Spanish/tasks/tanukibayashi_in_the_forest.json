			"dialogs": [
				{
					"id": 721080931,
					"content": "¿Qué? No imaginé que fuera tan importante. ¿Por qué no lo dijeron antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080932,
					"content": "Por culpa de este objeto me sellaron durante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "¿Cien años?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "¡Ah! ¡Deja de burlarte de mi desgracia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "No importa. Es cosa del pasado. También tengo una idea respecto a la barrera cerca del bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Antes, cuando peleé con esa kitsune escurridiza, vi la barrera en la costa este. Es un arco torii y unas raíces del Cerezo del Trueno , ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Cuando ese tipo estaba luchando contra los demonios, me preocupaba que alguno de ellos viniera a hacernos daño, así que coloqué un sello mágico en ese lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "#Déjame pensar. Un sello del lado este del acantilado... Kichiboushi, lléval{F#as}{M#os} allí y eliminen el sello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Gracias, Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "De acuerdo, suficiente charla. Vayan, rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "Si se encuentran con esa kitsune escurridiza, salúdenla de mi parte. Díganle... déjenme pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "“¡Esta vez cruzaste la línea! ¡Regresa y pelea conmigo! ¡Nuestra competición aún no ha terminado! ¡Y ayúdame a romper el sello de paso! No es que no pueda hacerlo yo mismo, ¡sino que aún me debes un favor! Además, ¡Gyoubu Koban dice que te extraña!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Guau, ¡no sé si Paimon lo recordará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080934,
					"content": "¿Mil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080935,
					"content": "¿Un millón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				}
			]
		}
