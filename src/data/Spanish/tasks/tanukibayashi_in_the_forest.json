			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "Jeje. ¡Bien hecho! Parecen estar bastante contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080902,
					"content": "... ¿Eh? Oh, sí, sí. Les preguntaré por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080903,
					"content": "Gyoubu Koban pregunta: “Si son humanos, ¿por qué huelen a tanuki?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080904,
					"content": "... ¡Es cierto! ¡Será mejor que me den una buena explicación! ¿Por qué huelen a tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080905,
					"content": "¿Eh? Cuánto tardaste en preguntar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080906,
					"content": "Fue la miko de la máscara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "¡Exacto! ¡Eso fue lo que pasó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080909,
					"content": "La miko de la máscara nos preparó una comida muy abundante y dijo que, para hacerla, usó la magia que había aprendido de los tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080910,
					"content": "¿Qué? ¿Cómo se atreve a aprender nuestra magia sin permiso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080911,
					"content": "Humm... ¿Será que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080912,
					"content": "¡Esa kitsune escurridiza...! Si aún sigue con vida, debería al menos pasar a saludar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080913,
					"content": "Es una miko enmascarada. Te llamó “viejo amigo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080914,
					"content": "¿Enmascarada? No recuerdo ninguna máscara, y tampoco conozco a ninguna miko. Pero sí que conozco a una kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080915,
					"content": "Ahora que lo mencionan, esa kitsune escurridiza ya había aparecido en forma de miko antes. ¿Qué aspecto tenía esa miko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080916,
					"content": "Usa una máscara de zorro blanco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080917,
					"content": "¿Algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080918,
					"content": "Cabello corto azabache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "Y usa un atuendo de miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080922,
					"content": "Humm... no la conozco. Jamás he visto a alguien así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080923,
					"content": "En serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080924,
					"content": "... Humm... Está bien, déjenmelo a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080925,
					"content": "Shousei dice: “Fue divertido jugar con ustedes. ¡Gracias!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080926,
					"content": "¡Paimon también se alegra mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080927,
					"content": "Sobre la peineta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "Soy Ioroi, el tanuki reconocido a nivel mundial. Por supuesto que cumpliré mi palabra. Pueden llevarse la peineta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080929,
					"content": "Pero ¿qué planeas hacer con ella? Quizás apeste a kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080930,
					"content": "Bueno, esto es lo que ocurrió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080920,
					"content": "Usa un atuendo de miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
					"id": 721080921,
					"content": "Y tiene cabello corto azabache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080907,
					"content": "Comimos algo extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				}
			]
		},
