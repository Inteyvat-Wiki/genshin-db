			"dialogs": [
				{
					"id": 221120501,
					"content": "De acuerdo, puede retirarse. No creo que nadie vaya a caerse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "No combina bien con el resto de las escaleras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "¿Eso cree? Tampoco soy carpintero, es lo más que puedo hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Humm... Pero esta es solo la primera grieta, todavía hay otra por arreglar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "En fin, es todo por hoy. La posada todavía está abierta y tengo que ir a recibir a los huéspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "Escaleras que arreglar, un negocio que administrar... En fin, buen trabajo. Tome, como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
