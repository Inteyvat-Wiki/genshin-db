			"dialogs": [
				{
					"id": 221120201,
					"content": "¿Las encontró?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120202,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Puse todas las tablas en la planta baja. No es difícil de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120204,
					"content": "Vaya a buscarlas, estaré aquí para evitar que alguien se caiga y tenga un accidente. Si un huésped desprevenido fuera a caer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
