					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Déjeme ver... creo que son suficientes. ¡Buen trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120304,
					"content": "Voy a comenzar a trabajar, tengo que terminar lo más pronto posible...",
					"roleType": "TALK_ROLE_NPC",
