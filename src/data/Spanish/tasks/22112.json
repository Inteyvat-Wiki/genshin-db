					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "Al parecer no queda más remedio que repararla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "Oh, es usted. Mire, las escaleras de la posada están rotas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120104,
					"content": "Con una grieta así de grande, es fácil que alguien se caiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120105,
					"content": "¿Que cómo se rompió? Oh, había un grupo de monstruos intentando entrar a la posada, así que salí a lidiar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120106,
					"content": "Debí haberme contenido, pero golpeé a un monstruo grande y obeso que hizo pedazos la escalera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120107,
					"content": "Y siempre digo que voy a arreglarla, pero nunca tengo tiempo para hacerlo. Y ahora que hay cada vez más clientes, no me queda remedio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120108,
					"content": "No es gran cosa, puedo arreglarla yo solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120109,
					"content": "Si está libre, ¿puede ayudarme a conseguir unas tablas de madera? Tengo que quedarme a cuidar de que nadie tropiece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120110,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "Compramos una pila de madera para arreglarla, está en la planta baja de la posada. Siento tener que molestarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120112,
					"content": "Vaya y recoja unas cuantas tablas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120113,
					"content": "Si alguien vuelve a destrozarla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "No, ya no soy joven... Si vuelven a venir, tendré que contenerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120115,
					"content": "Pero primero tenemos que arreglarla. Compré una pila de tablas, está en la planta baja de la posada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120116,
					"content": "Perdón por molestarle, ¿puede ayudarme a traer unas cuantas tablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
