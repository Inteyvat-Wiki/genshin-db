			"dialogs": [
				{
					"id": 111131101,
					"content": "¿Ustedes son nuevos? ¡Qué coincidencia, yo también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131102
					],
					"speakerTitle": "Zhu Ming"
				},
				{
					"id": 111131102,
					"content": "¡No puedo creer lo maravilloso que es este paisaje! Pensé que sería oscuro y helado, sin ninguna noción del tiempo y el espacio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131103
					],
					"speakerTitle": "Zhu Ming"
				},
				{
					"id": 111131103,
					"content": "Aquí puedo poner mis ideas en orden, es genial. ¡Jaja! Quizás mis expectativas eran muy bajas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhu Ming"
				}
			]
		},
