			"trigger": {
				"objectNames": [
					"Lanxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111131001,
					"content": "¿Son... visitantes? Lo siento, esto es un poco inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131002
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131002,
					"content": "Sin embargo, al ver que vienen con Hu Tao, me siento más tranquila... Solo que me temo que no tenemos los medios para recibir visitas como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131003
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131003,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111131004
					]
				},
				{
					"id": 111131004,
					"content": "Me llamo Lanxi. Llevo mucho tiempo esperando a alguien, aunque no sabría decir exactamente cuánto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131005
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131005,
					"content": "Dicen que la espera es difícil, pero caminar, observar y hablar con las nuevas visitas, así como con los viejos conocidos, me ha ayudado a pasar el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131006
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131006,
					"content": "Puedo seguir esperando, pero ¿alguna vez llegará aquella persona a quien espero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131007
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131007,
					"content": "Todo me da igual. Después de todo, lo único que puedo hacer es esperar. Pero si tú también buscas a alguien importante, es mejor no esperar por siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanxi"
				}
			]
		},
