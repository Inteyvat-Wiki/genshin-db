				"points": []
			},
			"dialogs": [
				{
					"id": 111130501,
					"content": "¿“Captar la indirecta”? ¿En serio? Eres tú la que debería aprender a leer entre líneas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130502,
						111130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130502,
					"content": "¿No tienes que “proteger la frontera” o algo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130503
					]
				},
				{
					"id": 111130503,
					"content": "Meng Dan ya cruzó la frontera. De otro modo, no podría ver al Temible Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130506,
					"content": "Como iba diciendo, hubo un tiempo en el que la Funeraria El Camino parecía más una clínica que una funeraria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130507
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130507,
					"content": "Durante la Guerra de los Arcontes, todo estaba cubierto de montones de cuerpos. La gente estaba hundida en la miseria y el sufrimiento. Las enfermedades se propagaron por todas partes y la muerte devastó el mundo de los vivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130508
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130508,
					"content": "Esa fue la época en la que se fundó la Funeraria El Camino. Como humanos, aunque sus fundadores eran personas insignificantes con una enorme tarea, poco a poco lograron que la muerte cediera terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130509
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130509,
					"content": "Debieron pagar un precio alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130510,
					"content": "Después de varias generaciones, Liyue se convirtió en un centro próspero que atrajo a gente con sueños de grandeza y con los bolsillos llenos de Mora. Al final, algunas personas sin escrúpulos sacudieron el “legado” de los muertos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130511
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130511,
					"content": "Me refiero a los restos de los dioses derrotados que desolaban la tierra. No entraré en detalles, pero basta con decir que en su peor momento, la vida estaba al borde de su desaparición, mientras la muerte avanzaba implacablemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130512
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130512,
					"content": "Restaurar el equilibrio y restablecer la frontera tomó más tiempo del que pueden imaginar. Pero, de no ser por ello, Liyue no sería el puerto que conocen hoy día. Lo mismo para la Funeraria El Camino, ustedes o yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130513,
						111130515
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130513,
					"content": "No esperaba que fueras tan buena narradora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130514
					]
				},
				{
					"id": 111130514,
					"content": "Jajaja. Esta era la historia favorita de los antiguos directores. Aunque, si me lo preguntas, creo que yo la cuento mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130517,
					"content": "De ustedes depende cómo interpretar mis palabras, aunque espero que la mayoría de lo que dije haya pasado desapercibido. La Funeraria El Camino es solo eso, una funeraria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130518,
						111130519
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130518,
					"content": "Quizás sea lo mejor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130520,
					"content": "Vivimos en tiempos de paz, pero no podemos dar por hecho la coexistencia entre la vida y la muerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130521
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130521,
					"content": "Humm, ya casi es hora. ¡Vamos a llevarlos a “donde todo comenzó y donde todo terminará”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130522
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130522,
					"content": "¿Qué lugar es ese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130523,
					"content": "Es donde nos encontramos la primera vez. Me invento nombres creativos para las cosas, ¡tampoco me tienen que preguntar todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130519,
					"content": "Estoy de acuerdo. Ahora, regresemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130515,
					"content": "¿Nos puedes contar más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130516
					]
				},
				{
					"id": 111130516,
					"content": "Lo siento, ¡la curiosidad puede ser muy peligrosa! Recuerda mi consejo: mientras menos sepas, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130504,
					"content": "El trabajo de la funeraria no es en absoluto como imaginaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130505
					]
				},
				{
					"id": 111130505,
					"content": "¿En serio? Al final, el resultado es el mismo. El qué y el cómo son meras trivialidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				}
			]
		},
		{
			"id": 1111306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111303",
							"2"
						],
						"stepId": 1111303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130601,
					"content": "#¡Al fin! ¡Paimon pensó que nos quedaríamos atrapad{F#as}{M#os} en este lugar extraño para siempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130602,
					"content": "Esa es la cuestión. Los intrusos terminan por huir asustados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130603
					]
				},
				{
					"id": 111130603,
					"content": "¿Todavía hay más cosas raras adelante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130604,
					"content": "Así es, solo tenemos que zambullirnos un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130605
					]
				},
				{
					"id": 111130605,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111307,
			"completionStepIds": [
				1111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111307",
							"2"
						],
						"stepId": 1111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130701,
					"content": "Temible Lang, ahora debes sentirte muy satisfecho ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130702
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130702,
					"content": "Si alguna vez te convirtieras en un espíritu maligno y regresaras con intenciones nefastas, tendré que poner nuestra amistad a un lado y darte una despedida no tan grata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130703
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130703,
					"content": "No lo haré, ¡lo prometo! Estoy muy agradecido por todo lo que han hecho por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130704
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130704,
					"content": "Ahora que sé que a todos les está yendo muy bien, no quiero entrometerme en sus vidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130705
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130705,
					"content": "Yo también quiero agradecerles. Ustedes también cumplieron mi deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130706
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130706,
					"content": "Tú también deberías hacer caso a mi advertencia, Meng Dan. Si no dejas ir el pasado, quizás haga que te reúnas con tu amigo antes de lo planeado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130707
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130707,
					"content": "¿Cómo puede decir algo tan espeluznante mientras sonríe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130708
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130708,
					"content": "Jajaja. Entonces, para terminar, démosle nuestra despedida al Temible Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130709
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130709,
					"content": "Nos vemos, Temible Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130710,
					"content": "¡No, no! No lo “verás” más adelante. Es mejor decir “adiós” o algo por el estilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130711
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130711,
					"content": "Jajaja, no hay problema, me voy en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130712
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130712,
					"content": "Lo siento, de todos los sueños que pedimos gritando aquella vez, solo el nuestro no se pudo hacer realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130713
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130713,
					"content": "No te preocupes, no hay vida sin arrepentimientos. Puedes irte tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130714
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130714,
					"content": "De acuerdo. Los recordaré a todos. ¡Adiós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130715
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130715,
					"content": "Se fue, *suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130716
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130716,
					"content": "Se siente como si hubiera cerrado una gran etapa de mi vida, pero, aun así, deja un vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130717
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130717,
					"content": "¿Cuál fue el deseo que pidieron? Antes no pudimos escucharlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130718,
					"content": "“Después de haber formado una familia y empezado un negocio, queremos que nuestras dos familias pasen el Rito de la Linterna juntas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130719
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130719,
					"content": "Por eso envidio a mis amigos. El pequeño Wu y los demás todavía pueden hacer realidad sus deseos, pero el mío seguirá siendo solo eso, un deseo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130720,
						111130721
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130720,
					"content": "Ánimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				},
				{
					"id": 111130722,
					"content": "Eso es verdad. Además, piensa en esto: todos nos convertiremos en cenizas algún día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130723
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130723,
					"content": "Disfruta de la vida mientras puedas. Cuando hayas cumplido tus deberes en vida, podrás reunirte con quien quieras en el otro mundo. ¿No es genial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130724
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130724,
					"content": "Eh... G-gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130725
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130725,
					"content": "En fin, no creo que vuelva a venir a la Colina Wuwang. Además, tengo que ordenar mis pensamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130726
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130726,
					"content": "No te preocupes. Aprovecha esta ocasión para salir a distraerte. Te permito unas vacaciones. Naturalmente, eso no cambia las condiciones de nuestro contrato previo. Las vacaciones no son pagadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130727
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130727,
					"content": "¿No estás olvidando algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130728,
					"content": "Dijiste que nos ayudarías con nuestra búsqueda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130729
					]
				},
				{
					"id": 111130729,
					"content": "#Oh, l{F#as}{M#os} traje a la “frontera” y dejé que buscaran en los alrededores, ¿cierto? Pero, a juzgar por su reacción, parece que no encontraron lo que buscaban. Es una pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130730
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130730,
					"content": "¡La pena es que no nos ayudaste para nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130731,
					"content": "#Jajaja. {F#Las}{M#Los} ayudé a buscar con métodos que no están a su alcance. Desafortunadamente, no encontré ninguna pista valiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130732
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130732,
					"content": "Seguiré prestando atención en caso de que encuentre algo. Si eso ocurre, se lo haré saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130733
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130733,
					"content": "No parece que lo digas en serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130734,
					"content": "Jeje, después de todo, no soy experta en encontrar a los vivos. En cambio, si me pidieran buscar a alguien en el otro lado de la “frontera”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130735
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130735,
					"content": "¡Deja de decir cosas tenebrosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130736,
					"content": "#Relájate, {F#las}{M#los} ayudaré a buscar a esa persona, tienen mi palabra. *Tch*, como siempre, no aprecian mi refinado sentido del humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130737,
						111130738
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130737,
					"content": "Parece que de verdad disfrutas tu trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130739,
					"content": "Jaja... Tengo mis propias razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130740
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130740,
					"content": "¿Razones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130741,
					"content": "Los que vimos hoy fueron espíritus que todavía sienten apego por el mundo de los vivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130742
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130742,
					"content": "Pero nunca he visto a los antiguos directores ahí... Ni siquiera una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130743
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130743,
					"content": "Eso significa que convertirse en directores de la Funeraria El Camino fue la decisión correcta para ellos, y que se fueron sin ningún arrepentimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130738,
					"content": "Te sienta muy bien ser la directora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130721,
					"content": "Todavía te queda mucho por vivir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				}
			]
		},
		{
			"id": 1111308,
			"completionStepIds": [],
