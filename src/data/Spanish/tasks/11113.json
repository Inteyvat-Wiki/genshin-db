			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Wu",
					"Mumu",
					"Tsongzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "Ahora que lo pienso, las cosas de ustedes dos son hechas a mano y la mía es la única comprada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111122302,
					"content": "Pero lo tuyo tiene mucho más valor que lo nuestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111122303,
					"content": "Lo importante no es el precio, sino el peso que tuvieron estas cosas en nuestra niñez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111122304,
					"content": "Y son una muestra de que nunca olvidaremos nuestra promesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsongzi"
				}
			]
		},
		{
			"id": 1111304,
			"completionStepIds": [
				1111304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111304",
							"2"
						],
						"stepId": 1111304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Temible Lang",
					"Pequeño Wu",
					"Mumu",
					"Tsongzi",
					"Meng Dan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130401,
					"content": "Es el Rito de la Linterna de nuevo. ¿No sería genial si pudiéramos ver las linternas con nuestros propios ojos un día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130402
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111130402,
					"content": "Sabes que puedes pedir un deseo sin una linterna, ¿verdad? Mamá dice que siempre y cuando lo grites en voz alta, tu deseo se volverá realidad en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130403
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111130403,
					"content": "¿Gritarlo? ¿No les da un poco de... vergüenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130404
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130404,
					"content": "Si uno comienza a gritar y los demás le siguen, nadie se sentirá avergonzado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130405
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130405,
					"content": "Exacto. Wu, empieza tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130406
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111130406,
					"content": "D-de acuerdo... ¡Deseo abrir un restaurante supergrande, con platos y comida ilimitada! ¡Así podré comer pollo al chile Jueyun todos los días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130407
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111130407,
					"content": "Jajaja, ¿ese es tu deseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130408
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111130408,
					"content": "Si tanta risa te da, ¿cuál es el tuyo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130409
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111130409,
					"content": "¡Ser millonario, por supuesto! ¡Hacer negocios y muchos Moras! Con tantos Moras, puedes hacer lo que quieras y ser feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111130410,
					"content": "¡Sí! Si te vuelves rico, cómpranos esa caja de juguetes supercara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130411
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130411,
					"content": "No solo una... ¡Una para cada uno! No, ¡un montón para cada uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111130412,
					"content": "Si Mumu será un hombre de negocios, entonces yo no necesito ganar nada de dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130413
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111130413,
					"content": "¡Oye, eso no vale! Es difícil hacerse rico, ¡no me presionen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111130414,
					"content": "Yo quiero aprender a hacer linternas mingxiao, ¡de las grandes! Y también linternas celestes. Seré la mejor artesana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130415
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111130415,
					"content": "¡Sí! ¡Así no tendremos que ir hasta Liyue a liberar las linternas celestes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130416
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130416,
					"content": "En fin, Meng Dan, Lang, ¿qué hay de ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130417
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111130417,
					"content": "Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130418
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130418,
					"content": "Oh, desaparecieron... Justo cuando estaba a punto de pedir su deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130419,
					"content": "¡Cuántos recuerdos! Ese fue el último Rito de la Linterna que pasamos los cinco juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130420
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130420,
					"content": "Ha pasado mucho tiempo... y hemos crecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130421
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130421,
					"content": "¿Se cumplieron todos sus deseos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130422,
						111130423
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130422,
					"content": "Todos y cada uno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				},
				{
					"id": 111130424,
					"content": "Les pedimos a cada uno un obsequio de despedida para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130425,
					"content": "El pequeño Wu se convirtió en un chef, Mumu es un hombre de negocios exitoso, y Tsongzi hace las mejores linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130426,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130427
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130427,
					"content": "Guau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130428
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130428,
					"content": "No olvidamos nuestros sueños de la infancia. Los conservamos en nuestros corazones como una promesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130429
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130429,
					"content": "En fin, hora de liberar esta linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130430
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130430,
					"content": "#Oye, {NICKNAME}, capta la indirecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130431
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130431,
					"content": "Démosles un poco de espacio para que recuerden los viejos tiempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130423,
					"content": "Los tengo aquí mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				}
			]
		},
		{
			"id": 1111305,
			"completionStepIds": [
				1111305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
