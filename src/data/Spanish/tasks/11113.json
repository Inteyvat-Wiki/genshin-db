				"points": []
			},
			"dialogs": [
				{
					"id": 111130801,
					"content": "Guau, ¡incluso tiene los nombres de los cinco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130802
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130802,
					"content": "Jeje, increíble. Por cierto, dijeron que liberaban las linternas cada año, ¿cierto? ¿No piensan agregar más nombres a la lista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130803
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130803,
					"content": "¿Qué hay de los hijos del pequeño Wu o de la esposa de Mumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130804
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130804,
					"content": "De hecho, tengo una buena noticia. Mumu pronto será padre. Últimamente, no deja de hablar de eso. Está tan emocionado como nervioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111130805,
					"content": "Jaja, me pregunto si ese cabeza de alcornoque será un buen padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130806
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111130806,
					"content": "Oh, al contrario. Te sorprenderías si vieras lo ingenioso que se ha vuelto. Verás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meng Dan"
				}
			]
		},
