			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130101,
					"content": "¡Oh! ¡Volvieron! Les tomó menos tiempo del que pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130102,
					"content": "Paimon, no se te habrá escapado nada, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130103
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130103,
					"content": "¡¿Tan poca confianza tienes en Paimon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130104,
					"content": "Jeje, era una broma. En realidad, no importa. Si accedieron a entregarles unos recuerdos, quiere decir que adivinaron más o menos de qué se trata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130105,
					"content": "Sin embargo, cuando se trata de espíritus y fantasmas, hay que esperar lo inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130106,
					"content": "Esa es la razón por la que no quieren involucrarse más, ni saber la historia completa. Si lo intentaran, me empujarían al límite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130107,
						111130108
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130107,
					"content": "Suena aterrador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				},
				{
					"id": 111130109,
					"content": "Proteger la frontera entre la vida y la muerte es el trabajo más importante de la Funeraria El Camino, y en eso soy más seria de lo normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130110,
					"content": "#¿Nosotr{F#as}{M#os} somos un caso especial? ¿No hay problema si cruzamos la “frontera”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130111,
					"content": "#¡Claro que no! Después de todo, ustedes ya están involucrad{F#as}{M#os} en esto, igual que Meng Dan. No pasa nada si echan un vistazo detrás del telón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130112
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130112,
					"content": "Y no deben sorprenderse por nada de lo que vean o lo que suceda en el lugar al que nos dirigimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130113
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130113,
					"content": "Es un lugar normal que existe en la frontera entre la vida y la muerte. Lo único especial de ese lugar es que nadie lo conoce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130114,
					"content": "Bajo ninguna circunstancia se sobresalten, ¿entendido? De lo contrario, antes de irnos tendré que borrarles la memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130115
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130115,
					"content": "¡Vamos! Si me obedecen, todo saldrá bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130116,
					"content": "P-Paimon tiene miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130117,
					"content": "#Pero, como dijo Hu Tao, ya estamos involucrad{F#as}{M#os} en esto. Tenemos que llegar al fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130108,
					"content": "No sé si lo dices en serio o de broma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				}
			]
		},
		{
			"id": 1111302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
