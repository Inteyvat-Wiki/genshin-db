			"dialogs": [
				{
					"id": 111131201,
					"content": "Por cierto, ¿has visto al viejo Zhang últimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131202
					],
					"speakerTitle": "Shuyang"
				},
				{
					"id": 111131202,
					"content": "¿Zhang? Recuerdo que dijo que ya era hora de seguir adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131203
					],
					"speakerTitle": "Mo"
				},
				{
					"id": 111131203,
					"content": "Oh, ya veo, ya veo. Me pregunto a dónde irá ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131204
					],
					"speakerTitle": "Shuyang"
				},
				{
					"id": 111131204,
					"content": "Si tienes tanta curiosidad, ¿por qué no vamos a ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131205
					],
					"speakerTitle": "Mo"
				},
				{
					"id": 111131205,
					"content": "Jaja, quizás en otra ocasión. Quisiera quedarme aquí por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shuyang"
				}
			]
