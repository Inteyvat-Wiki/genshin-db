			},
			"dialogs": [
				{
					"id": 752190101,
					"content": "#¡Ah!... ¡Oye! ¡{NICKNAME}, espera un momento, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "Ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Oh, ¿qué sucede? ¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "#Jaja, no es eso. Acabo de recibir un paquete para ustedes dos. Me preguntaba cómo iba a encontrarl{F#a}{M#o}s, y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "Justo van y aparecen frente a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "¡Un paquete! ¿Quién lo ha enviado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "Bueno, lo cierto es que este paquete ha recorrido un largo camino y ha pasado por muchas manos hasta llegar aquí, desde el Gremio de Aventureros hasta los mensajeros de los Retoños Arbóreos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "Después de todo, la situación reciente de Natlan es bastante particular, y las rutas comerciales normales han estado suspendidas por un tiempo. No tiene remitente, pero por la firma... parece que viene de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Parece que también tienen muchos amigos en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Entonces, lo recibiré con gusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "#Así da gusto empezar un día de trabajo. En cuanto he recibido el paquete, he encontrado a su destinatari{F#a}{M#o}. ¡La gracia de la Arconte Pyro me sonríe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Bueno, me voy a entregar el resto de los paquetes. ¡Que tengan un excelente día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "¡De acuerdo! ¡Que vaya bien el trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "Humm, viene de Fontaine... Y por el tamaño, más que un paquete parece una carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "¡Vamos a abrirlo y ver qué hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "¡Oh, es de Charlotte! Es la imagen que nos tomamos cuando salimos de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "Aunque no ha pasado mucho tiempo desde que se tomó esta imagen, Paimon siente como si hubiera pasado una eternidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Jeje, ¡guardémosla bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190111,
					"content": "¡Genial! ¡Dámelo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				}
			]
		}
	]
}