			},
			"dialogs": [
				{
					"id": 721043801,
					"content": "Señorita Gendou, hoy luce de buen humor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043802
					]
				},
				{
					"id": 721043802,
					"content": "¿Eh? ¿Qué ocurre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043803
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043803,
					"content": "No luces como de costumbre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043804
					]
				},
				{
					"id": 721043804,
					"content": "¿Eh? ¿Eso crees? Lo tomaré en cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043805
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043805,
					"content": "Tal vez es porque hoy estoy de buen humor. Después de todo, ¡acabo de obtener “suerte mayor”! Así que quería compartir mi suerte contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043806
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043806,
					"content": "Aun así, lo que algunos llaman “suerte mayor” puede ser “infortunio mayor” para otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043807
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043807,
					"content": "Me pregunto qué les depara en el estante de papeles de la fortuna a aquellos que reciben uno de “infortunio mayor”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043808
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043808,
					"content": "¡Esto de la fortuna es muy interesante! Adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
