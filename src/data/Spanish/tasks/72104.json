					"id": 721043901,
					"content": "Señorita Gendou, ¿podemos ayudarla en algo hoy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043902
					]
				},
				{
					"id": 721043902,
					"content": "¿Eh? ¿Me preguntas a mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043903
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043903,
					"content": "Pues... he estado muy ocupada recientemente. Pero, si estás de acuerdo, veré si puedo organizar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043904,
						721043905
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043904,
					"content": "Es un malentendido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043906
					]
				},
				{
					"id": 721043906,
					"content": "Oh, ya veo... Pensé que sería el día en que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043905,
					"content": "Creo que tu mente está en otra parte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043906
					]
				}
			]
		},
