			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Preservadora de Nubes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "Los árboles azulados se erigen en el paisaje nevado; la tierra está solitaria y tranquila. Mi tercer plato es muy apropiado en este ambiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000102,
					"content": "¿Qué piensas preparar esta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "Humm... ¿Has oído hablar alguna vez de una técnica culinaria llamada “estofado”? Me topé con ella mientras buscaba recetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000104,
					"content": "Me pareció tan interesante que usé esa técnica para escribir una nueva receta llamada “carne estofada”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000105,
					"content": "Aunque el plato no es demasiado problemático para mi cocinadora mecánica suprema, el ingrediente principal es carne, así que debe ser de excelente calidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000106,
					"content": "Es por eso que activé el mecanismo y seguí el aroma de los ingredientes hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000107,
					"content": "La ventisca sopla fuerte aquí, haciendo difícil el paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000108,
					"content": "#Viajer{F#a}{M#o}, sé que eres {F#una conocedora y habilidosa aventurera}{M#un conocedor y habilidoso aventurero}. Una simple montaña nevada no es algo que te preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000109,
					"content": "Por eso quiero pedirte que vayas y me consigas algunos ingredientes otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000110,
					"content": "También quiero la receta de este tercer plato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "Naturalmente, no puedo olvidarme de ti. Te estaré esperando aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000112,
					"content": "Oh, el mecanismo se detuvo. ¿Quizás hace mucho frío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000113,
					"content": "Espera a que lo reinicie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000114,
					"content": "Cocinadora mecánica suprema... ¡actívate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000115,
					"content": "#Eso debería servir... Viajer{F#a}{M#o}, ve a buscar los ingredientes que necesito siguiendo el rastro de sus olores y tráemelos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000116,
					"content": "¿Tienes demasiado frío como para volar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "¡Vaya broma! ¡No debes subestimar el poder de esta Adeptus! Lo que pasa es que... ¡necesito arreglar el dispositivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000118,
					"content": "Ve rápido, no me hagas esperar demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Preservadora de Nubes"
				}
			]
		},
