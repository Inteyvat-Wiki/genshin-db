					"Preservadora de Nubes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000701,
					"content": "¡Mmm! Un sabor exquisito. No esperaba menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000702,
						705000703
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000702,
					"content": "... ¿De ti...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				},
				{
					"id": 705000704,
					"content": "Exactamente. Después de cocinar estos tres platos, hemos confirmado la fiabilidad de esta cocinadora mecánica suprema, que fue hecha personalmente por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000705
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000705,
					"content": "Una vez resueltos los dos problemas principales de control del fuego y de recolección automática de ingredientes, el mecanismo estará listo para la “cocción todo en uno”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000706
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000706,
					"content": "Por cierto, deberías conservar esta receta de carne estofada. Puedes usar carne cruda común en su lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000707
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000707,
					"content": "En Espinadragón hace demasiado frío como para venir siempre a buscar ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000708
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000708,
					"content": "Se puede usar carne común para una ocasión común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000709
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000709,
