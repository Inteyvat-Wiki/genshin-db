			"dialogs": [
				{
					"id": 705000501,
					"content": "¿Qué... carne es esta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000502,
					"content": "Carne congelada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "Carne congelada... Sí que le va bien el nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000504,
					"content": "Humm... No está mal, pero necesitaremos un fuego pequeño para que se descongele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000505,
					"content": "Afortunadamente, la cocinadora mecánica suprema que diseñé puede descongelar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000506,
					"content": "Parece que este aparato tiene de todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "¡En absoluto! Le faltan muchas funciones, como recolectar automáticamente los ingredientes, o controlar automáticamente el fuego... entre otras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000508,
					"content": "La cocinadora todavía necesita muchas mejoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000509,
					"content": "Bueno, sin más preámbulos. Como los ingredientes están listos, la prenderé ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000510,
					"content": "#Tú encárgate de vigilar el fuego, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000511,
					"content": "Avísame cuando esté listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705000512,
					"content": "Los Adeptus son realmente poderosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "En lugar de apreciar el poder Adeptus, me gustaría que apreciaras las habilidades de la cocinadora mecánica suprema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Preservadora de Nubes"
				}
			]
		},
