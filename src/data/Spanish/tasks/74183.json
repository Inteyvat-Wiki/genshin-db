				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "Por cierto, ¿Neuvillette no era...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "Cierto, ¿Neuvillette no era el Dragón del Agua? ¿Eso significa que ese tal Escila es mucho más antiguo que él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832203,
					"content": "¿Ya ha nacido un nuevo Dragón del Agua? Bueno, supongo que hace mucho tiempo que la antigua Maestra de Todas las Aguas falleció... Mucho, mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Os"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "El caso es que el malvado dragón Escila fue amigo de nuestro sebasto, pero instigó una rebelión justo en el momento decisivo de la guerra entre los remurianos y la gente de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832302,
					"content": "Entonces, guio a los violentos descendientes de los dragones hasta Máximo e intentó asediar el Capitolio, la ciudad interior en la que se encontraba nuestro sebasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832303,
					"content": "¿Máximo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Los habitantes de Petricor no dejaban de hablar de Máximo y de un campanario o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832306,
					"content": "Así es. Máximo era la ciudad exterior de la capital, pero para que el dragón llegara a la ciudad interior, necesitaba cruzar las Puertas de Jano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832307,
					"content": "Eran las puertas que separaban la ciudad interior de la exterior. Nuestro sebasto y los compositores también tuvieron que cruzar dichas puertas y sus acualíneas doradas para tejer la serenata y conseguir que su música llegara a toda Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832308,
					"content": "Boecio y su legión aprovecharon eso para cerrar las Puertas de Jano y dejar encerrado al dragón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832309,
					"content": "Tal vez Escila quería llegar ante nuestro sebasto, pero como eso ya no era posible, Remuria y él se hundieron bajo el agua y nuestro sebasto desapareció. Ni siquiera hoy día sabemos qué fue de él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832310,
					"content": "(Algo en todo esto no encaja...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#{NICKNAME}, ¿qué piensas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832314,
					"content": "Todo esto es muy confuso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Sí... Me enteré de ello después de que sucediera, porque yo no estaba en la capital cuando ocurrió el desastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832316,
					"content": "Nadie sabe lo que le sucedió a nuestro sebasto en aquel momento. Puede que averigüemos algo si seguimos avanzando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832317,
					"content": "El gran pez luminoso que vimos en el castillo debe de ser la manifestación de los pensamientos que escaparon a través de las grietas de la prisión pétrea de Escila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832318,
					"content": "Me temo que ya se habrá percatado de nuestra presencia. Lleva tantos años encerrado que, al percibir a gente de fuera, no es de extrañar que haya pensado en una forma de llamar nuestra atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832319,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832320,
					"content": "Un momento, dices que tenemos que cruzar unas puertas para llegar al Palacio Dorado, pero si Boecio las cerró, ¿cómo vamos a lograrlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832321,
					"content": "Sí, la verdad es que va a ser complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832322,
					"content": "¡Qué maleducado! Nos cierra las puertas en nuestras narices y encima tiene la vergüenza de decir que nos esperará en el Palacio Dorado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832323,
					"content": "Paimon cree que lo que deberíamos hacer es romper el sello que encierra al dragón y dejar que él, que fue derrotado por Boecio en el pasado, derribe las puertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832324,
					"content": "¡No podemos hacer eso! A pesar de todo, él es el gran enemigo de Remuria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832325,
					"content": "¡Los enemigos de nuestros enemigos son nuestros amigos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "¡Eso, eso! Además, después de tanto tiempo, ¿quién te dice que no haya cambiado de parecer y ahora sea un dragón bueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832328,
					"content": "Pero es que es un dragón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741832329,
					"content": "#¿Y qué? Que sea un dragón no significa que no atienda a razones. Además, ¡ya tenemos experiencia luchando contra dragones! ¿A que sí, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832326,
					"content": "Pero Remuria dejó de existir hace mucho tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832311,
					"content": "(En el sueño que tuve...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832312,
					"content": "(Escila vino a ver a Remo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832304,
					"content": "Alguien en Petricor nos habló de ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				}
			]
		},
		{
			"id": 7418324,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
