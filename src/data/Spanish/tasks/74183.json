			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "No sabía que los Dragartos podían llegar a ser tan grandes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Bah, no son más que una raza salvaje y sin educación. No me sorprendería que se convirtieran en algo aún más extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Os"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
