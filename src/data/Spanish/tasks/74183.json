				]
			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "Guau... ¡Se parece al extraño pez luminoso que vimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "Y tiene algo raro enredado a él... ¿Qué está pasando? Paimon está cada vez más confusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "Esta voz... La oí en el sueño de antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "Es probable que lo vieras en los recuerdos de mi sebasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830406,
					"content": "Se llama Escila, y es el dragón malvado que en el pasado sirvió a mi sebasto. Boecio lo subyugó y lo selló aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830407,
					"content": "¿Eh? ¿Subyugó al dragón malvado? Paimon no se imaginaba que don maleducado también hiciera cosas buenas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "Aunque lo llamaran “dragón”, en realidad no era más que un Dragarto un poco más fuerte de lo normal. Al fin y al cabo, no nacería ningún nuevo Dragón del Agua mientras la Maestra de Todas las Aguas estuviera hibernando en las profundidades del mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Os"
				},
				{
					"id": 741830404,
					"content": "Creo que soñé con esta voz, pero no recuerdo de quién era...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Escila",
					"Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Oooooh, ¡qué corrientes oceánicas tan cálidas! ¡Al fin soy libre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830602,
					"content": "Pequeñines, ¿vienen de la superficie? Desconozco la razón por la que han arribado a esta prisión subacuática, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830603,
					"content": "¡No somos ningunos “pequeñines”! ¡Eres tú el que es demasiado grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Jajaja, está bien, lo que tú digas. En cualquier caso, me han liberado de las cadenas a las que llevaba miles de años encadenado, por lo que ahora estoy en deuda con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830605,
					"content": "Si existe algo en lo que pueda prestar mi ayuda, solo tienen que decírmelo. Considérenlo una muestra de mi gratitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830606,
					"content": "#Jeje, ¡Paimon sabía que eras un dragón con el que se puede razonar! Por cierto, Paimon es Paimon, est{F#a}{M#e} es {NICKNAME} y este de aquí es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "#Humm, en realidad, Paimon no sabe por cuál de sus nombres lo conocerás, ¡pero nosotr{F#a}{M#o}s lo llamamos Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "Oh, Casiodoro, eres tú. Tiempo ha que no nos vemos. Nunca pensé que volverías... pero has de saber que llegas demasiado tarde. Para ser exactos, ¡varios milenios tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830609,
					"content": "Oooh, ¡parece que todo el mundo te conoce, Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "No tengo nada que hablar con traidores despreciables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830611,
					"content": "¡Vigila tu lengua, mortal! A diferencia de ustedes y su arrogante raza, los descendientes de los dragones siempre hemos mantenido nuestra promesa y jamás hemos cometido un acto de traición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830612,
					"content": "Tus palabras son más insignificantes que el plancton del mar. Admítelo, tu traición es un hecho indiscutible, ¡así como la razón por la que perdimos la guerra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830613,
					"content": "Si no hubiéramos perdido la guerra... perdido nuestra nación... nuestro sebasto habría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830614,
					"content": "¡Llevas demasiado tiempo alejado de todo, Casiodoro! La verdad no es como conjeturas... Aunque un plan secreto no habría sido secreto si los detalles al respecto hubieran llegado a tus oídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830615,
					"content": "¿Un plan secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830616,
					"content": "Como parte de su último plan secreto, Remo me ordenó liderar una legión de Dragartos para asediar la capital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830617,
					"content": "Lo hizo todo para salvar a su nación y a su pueblo, pues tan grandiosa era su magnanimidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830618,
					"content": "Eso suena un tanto absurdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "¡Paimon no se traga eso! ¿Cómo va un rey a pedirle a alguien que asedie su propia nación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "Oh, pequeñina, ¿acaso crees que tú o yo podemos comprender el pensamiento de Remo? En cualquier caso, Casiodoro, estoy seguro de que incluso tú entenderás lo que esto significa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830623,
					"content": "Las abejas doradas... Las abejas doradas que marcaban el camino del destino solo escuchaban la llamada de la serenata. Pero ¿por qué nuestro sebasto le daría el poder de la serenata a un salvaje dragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830624,
					"content": "Porque hicieron una promesa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "#¿Eh? Sabes demasiado, muchach{F#a}{M#o}. ¿Quién te ha dicho eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830626,
					"content": "Lo vi en los recuerdos desperdigados en el agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "Efectivamente, hicimos una promesa, pero yo lo defraudé al no estar a la altura de su noble sacrificio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830628,
					"content": "¡No pude llegar a tiempo al Palacio Dorado! Así pues, las devastadoras olas engulleron la ciudad entera y los de mi especie no lograron escapar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830629,
					"content": "¿Cómo fue posible?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830630,
					"content": "¡Hum! Si hablamos de traición, ¡el verdadero traidor es Boecio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830631,
					"content": "De no ser por ese bellaco embustero, esa rata mentirosa, y sus ingeniosas falacias, ¿crees que yo, el príncipe que lideró a los descendientes de los dragones tras la era de los dragones antiguos, me habría dejado vencer tan fácilmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830632,
					"content": "Ese bellaco mintió al afirmar que las órdenes de Remo eran que la legión renunciara a combatir, y luego se rebeló contra nosotros cuando llegamos al lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830633,
					"content": "Ahora que he tenido tiempo de sobra para pensar en ello, me temo que logró descubrir el plan de Remo de alguna forma. Así fue como me engañó para, finalmente, tenderme una trampa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830634,
					"content": "También fue así como mi cuerpo y mi sangre se transformaron en piedra, hasta que hoy, después de miles de años, ustedes me han rescatado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830635,
					"content": "Boecio sabía que sus acciones desencadenarían una enorme catástrofe, pero aun así, él... ¿Será que intentaba hacerse con el control de la «Fobos»? ¿Por eso cometió esos pecados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830636,
					"content": "Tengo la sensación de que aún nos falta información.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "¡Ja! El que criticaba a los demás diciendo que eran traidores, ¡y ahora resulta que el mayor traidor es él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "Pero ¿por qué lo hizo? ¿Vamos a tener que preguntárselo directamente a ese maleducado? Aunque la verdad es que Paimon no cree que obtengamos una respuesta honesta por su parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "¿Cómo? ¿Ese diablillo obstinado y despreciable no ha desaparecido aún?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830640,
					"content": "Pues no, ¡y además le ha robado el alma a un montón de personas de Fontaine! De hecho, si hemos venido hasta aquí es para salvar a esa gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "#Dijo que nos esperaría en el Palacio Dorado... Bueno, mejor dicho, que esperaría a Os. ¡Nosotr{F#a}{M#o}s somos {F#las heroínas no invitadas}{M#los héroes no invitados}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "El muy maleducado ni siquiera nos dejó la puerta abierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "¿Las Puertas de Jano? Hum, aunque lanzaron un conjuro sobre ellas, en realidad no son más que unas ostentosas puertas de piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830643,
					"content": "Aunque ya no dispongo de mi cuerpo, enviar hasta allí a unos pequeñines como ustedes será pan comido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830648,
					"content": "¡Tengan cuidado, pequeñines!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830644,
					"content": "¡Ooooh! ¡Al final parece que podemos confiar en ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "Ahora solo tenemos que romper cada uno de los sellos. ¡Si están listos, manos a la obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Escila"
				},
				{
					"id": 741830645,
					"content": "Os, ¿estás listo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "Llegados hasta este punto, el único camino que hay es hacia delante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741830647,
					"content": "#¡Eso es lo que quería oír Paimon! ¿Y tú, {NICKNAME}, estás list{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "¿Él también se volvió loco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
