			"dialogs": [
				{
					"id": 411500301,
					"content": "Escuché que alguien hizo un pedido especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411500302
					]
				},
				{
					"id": 411500302,
					"content": "Verás... La despistada de Linguan pidió un ¡Ven por ello! y dijo que vendría más tarde a recogerlo. Pero creo que se encontró con algo en el camino y se entretuvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500303
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411500303,
					"content": "¿Podrías llevarle esto? <color=#00E1FFFF>Ve con cuidado, y ni corras ni vueles</color>, o se te caerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411500304,
					"content": "Ah, y <color=#00E1FFFF>procura que no te toque ningún Elemento, o afectará al sabor</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411500305,
					"content": "Si la comida se pone mala, vuelve y te haré otra ración para llevar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
