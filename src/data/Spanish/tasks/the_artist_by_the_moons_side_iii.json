			"dialogs": [
				{
					"id": 760600301,
					"content": "Esto debería bastar. ¿Tú qué crees, Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Parece más que satisfecha. Jeje... Paimon se pregunta qué pintará esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "¿Cómo? ¿Ya ha terminado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Maalaus parece algo triste. ¿Será por la pintura? A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Oh, ha vuelto a pintar a Colombina... ¿paseando bajo la luz de la luna? Y, en el cuadro, levantas la cabeza para mirar el cielo nocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Creo que estoy... contemplando la luna que hay detrás del cielo falso. Antes solía pasear así por la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600310,
					"content": "¿Solías? Ah, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(Ahora Colombina apenas puede salir de aquí... Y eso que Nod Krai es su lugar de nacimiento...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Cuando paseaba, solía pensar en qué habría en la verdadera Luna Escarchada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600313,
					"content": "En si habría tantos animalitos como aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600314,
					"content": "O si, por el contrario, no habría nada en ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600315,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Podrías llevarte unos pocos contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ja, qué idea tan interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600318,
					"content": "Aunque... la luna está más allá del cielo falso, así que tal vez lo mejor sería que no los llevara conmigo para no ponerlos en peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600322,
					"content": "(Por una parte, tiene un “hogar” en el que no puede moverse con libertad, y por otra, un “hogar” en el que no sabe lo que hay...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Seguro que Maalaus y las demás kuuhenki te echarían mucho de menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "Yo también las echaría mucho de menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600327,
					"content": "Pero ese es un viaje que debo hacer sola, es una respuesta que necesito averiguar por mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600328,
					"content": "¿Quién sabe? Puede que la respuesta sea hermosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600329,
					"content": "#Bueno, entonces, cuando vayamos a visitarte, ¡llevaremos a Maalaus con nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "¡Sí! Y podríamos organizar una exposición de arte en la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600331,
					"content": "¡Guau, eso suena genial! ¡Dicho y hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600333,
					"content": "Eso espero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600319,
					"content": "Puede que allí encuentres otras criaturas adorables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Oh, eso espero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600321,
					"content": "También espero que estén dispuestas a recibir a esta “diosa” que vuelve a su hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Colombina"
				}
			]
		},
