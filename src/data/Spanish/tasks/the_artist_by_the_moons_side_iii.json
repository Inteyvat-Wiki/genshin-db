			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "¿Eh? ¿Esa no es Maalaus? ¿Ha vuelto a salir en busca de inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Sí, pero está así desde que volvió, como si estuviera meditando algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600104,
					"content": "Puede que el tema de esta vez sea muy profundo... Como cuando los grandes pintores descubren alguna gran verdad sobre el mundo de golpe, o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Por cierto, Maalaus ya nos ha entregado muchas pinturas. Si sigue pintando así, podríamos organizarle su propia exposición de arte, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Jeje, llegado el momento, Paimon podrá hablarles a todos del proceso creativo de la gran pintora Maalaus. Aunque, claro, si de verdad montamos una exposición, necesitaríamos tu permiso, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "¿Oh? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600108,
					"content": "Porque tú eres la protagonista de la mayoría de sus pinturas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Oh, no pasa nada, no me importa. Parece una idea interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760600110,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "¡Oh, parece que Maalaus ya ha decidido qué quiere pintar! ¡Rápido, veamos si tenemos algo del color adecuado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Esta vez... ¡elijamos colores oscuros y que denoten cierta serenidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
