					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220608
					],
					"speakerTitle": "Yumkasaurio extraño"
				},
				{
					"id": 750220608,
					"content": "¿Tienes hambre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220609,
					"content": "Está solo aquí sin su dueño, seguro que no puede encontrar comida por sí mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220610,
					"content": "#{NICKNAME}, ¡busquemos algo para alimentarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Cuando se haya quedado satisfecho, se apartará y el tesoro será nuestro, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "¿Qué le podemos dar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Humm... Los saurios de Natlan comen un poco de todo, pero Paimon no sabe lo que le gusta comer al Yumkasaurio. A juzgar por su color, Paimon cree que le gustaría comer plantas, hojas o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "Probemos con algo sencillo primero. ¡Cuando uno tiene hambre no es quisquilloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
