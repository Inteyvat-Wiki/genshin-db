			"dialogs": [
				{
					"id": 750220404,
					"content": "Ay... ¿No hay manera de despertarlo? Argh, ¡qué fastidio! No lo estará haciendo a propósito, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220405,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "Creo que realmente está dormido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "Contar lo que dice en sueños",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "¿Estás diciendo que está bloqueando deliberadamente la entrada de la cueva para conseguir comida? Esto es una estafa... ¡Paimon se siente timada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220410,
					"content": "¡Hum! Si es así, ¡también jugaremos sucio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220411,
					"content": "#¿Qué tal si mandamos a {REALNAME[ID(2)|SHOWHOST(true)]} para que tome el cofre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220412,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "¡Él empezó jugando sucio, no nos puede culpar por seguir este juego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220407,
					"content": "Habla en sueños, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
			]
