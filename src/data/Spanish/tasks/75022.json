			"dialogs": [
				{
					"id": 750220801,
					"content": "¡Grr! ¡Grrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Jeje, ¡buen trabajo! ¡Veamos qué tesoro esconde el cofre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "¿Eh? No hay nada. Solo hay una nota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "#¿Así que el que dejó la nota es su dueño? Entonces, ¿no fuimos engañad{F#as}{M#os} por él, sino por su dueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Qué irresponsable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "Pues sí... Aunque esté gravemente enfermo, ¡no puede dejar a un Yumkasaurio en un lugar como este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "Aprovecharse así de la codicia de la gente... Paimon quiere decir de la compasión que tiene la gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "En fin, no podemos dejar que siga estafando a la gente de esta forma, avisemos al jefe de los Retoños Arbóreos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Le cuentas al jefe de los Retoños Arbóreos lo sucedido y lo llevas a ver al Yumkasaurio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "Ay, cuando me vinieron a buscar, ya tenía un presentimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220813,
					"content": "Pero no me esperaba que fuera el saurio de ese tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220814,
					"content": "¿Qué tipo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "Alguien que cometió un error y dejó la tribu por miedo a ser castigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220817,
					"content": "No revelaré su nombre porque no vale la pena. Tal vez él mismo era muy consciente de que lo que hizo no fue nada bueno. Mira, ni siquiera dejó su nombre en la nota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220818,
					"content": "A pesar de eso, su compañero saurio lo eligió a él...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "No, no es una elección. Los dragones son criaturas simples que no saben distinguir el bien del mal. Suelen confiar en sus compañeros por pura afectividad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220820,
					"content": "Como era de esperar, sigue siendo la misma persona de siempre. Ha usado su ingenio para engañar a los demás y a su compañero saurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220821,
					"content": "Me ocuparé de que alguien venga a alimentarlo cada cierto tiempo. Al fin y al cabo, es un saurio de nuestra tribu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220822,
					"content": "En cuanto a ese tipo... *Suspira*, es un final trágico, pero no voy a sentir compasión por él. La gente debe ser responsable de sus actos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huayna"
				},
				{
					"id": 750220808,
					"content": "En conclusión, comer demasiado puede hacer que te abandonen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "Ay, no bromees con eso. Él no hizo nada, tal vez aún está esperando que su dueño regrese, por eso no se aparta del camino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
		},
