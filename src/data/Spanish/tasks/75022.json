			"dialogs": [
				{
					"id": 750220703,
					"content": "El Yumkasaurio devora la comida en un abrir y cerrar de ojos.\\nNo llegas a ver cómo se la ha comido...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "¡P-p-pero qué comilón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "Parece que tienes competencia, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Me da que... con una ración no es suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "¿Qué dices? Paimon es muy exigente con la comida, no la engulliría así... ¡Ni siquiera le dio tiempo a saborearla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#E-eso parece... Resulta que es un saurio comilón, menos mal que {REALNAME[ID(2)|SHOWHOST(true)]} no come tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "¡Seguro que estaba muerto de hambre! ¡Pobrecito! ¿Y si le damos un poco más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#¿Tú también quieres, {REALNAME[ID(2)|SHOWHOST(true)]}? Vamos a alimentar a este saurio primero, ¡y enseguida Paimon te dará algo rico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "El saurio hambriento devora la comida en un abrir y cerrar de ojos.\\nParpadeas un par de veces, creyendo haber visto la misma escena dos veces...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Bien, ahora debería estar lleno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "¡Oye! Espera, ¿por qué te sientas de nuevo? ¿Dos raciones no fueron suficientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "¡Eh! Se va a acostar nada más después de comer... ¡Paimon cree que no tiene ninguna intención de quitarse de la entrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#¿Qué hacemos, {NICKNAME}? Paimon no comprende a este saurio... Puede dormir, pero que escoja otro lugar, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Bueno, nunca prometió que se iría.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "#Me siento engañad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "¡Qué rabia tiene Paimon! Le dimos tanta comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "¡GRRR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Hasta {REALNAME[ID(2)|SHOWHOST(true)]} se está quejando. {NICKNAME}, ¿y si lo despertamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
