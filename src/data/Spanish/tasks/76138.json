				]
			},
			"dialogs": [
				{
					"id": 761380201,
					"content": "¿Jefa Néfer? Y... Sr. Tzompanco. ¿Qué los trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380202,
					"content": "Nuestro invitado de Natlan desea visitar a los Descendientes Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380203,
					"content": "Pero, por ciertas razones... de etiqueta, prefiere que alguien lo presente. Adelante, Sr. Tzompanco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380204,
					"content": "Muy buenas, Srta. Lyylikki. Un gusto conocerla. Eh... ¡este es un fósil que traje desde Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380205,
					"content": "Gracias, pero... Sr. Tzompanco, yo ya lo conozco. No necesita ser tan formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380206,
					"content": "¿Eh? ¿Me reconoce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380207,
					"content": "Siempre ha estado allí cuando yo repartía la comida, ¿no es así? Se quedaba mirando de cerca, dando vueltas, pero nunca se ponía en la fila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380208,
					"content": "Pensé que quería una ración pero le daba vergüenza acercarse, así que guardé una para usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380209,
					"content": "Pero nunca vino a recogerla. De todas formas, si hoy no se presentaba, también iba a mandar a alguien para preguntarle si necesitaba ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380210,
					"content": "Eh... mil disculpas. En realidad estaba pensado en cómo saludarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380211,
					"content": "Entonces, Srta. Lyylikki, ¿podría visitar a los Descendientes Lunaescarcha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380212,
					"content": "Claro. En el campamento también acogemos algunos visitantes forasteros. ¿Le importaría decirme el propósito de su visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380213,
					"content": "Tomar unas cuantas imágenes y algunas notas y, si es posible... ¡preguntar a alguien por las leyendas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380214,
					"content": "Soy miembro de la Asociación de Arqueología Sáurica de Natlan. Si puedo recopilar datos útiles para mi investigación, ¡sería perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380215,
					"content": "Oh, así que quiere leer libros. Déjeme pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380216,
					"content": "Ya que se han conocido sin problemas, doy por cumplido el encargo. Debo irme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380217,
					"content": "¡Mil gracias, jefa Néfer! Le pagaré de todos modos. No puedo dejar que haga todo esto sin nada a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380218,
					"content": "Como prefiera, Sr. Tzompanco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380219,
					"content": "Bueno, me despido. Que disfruten de la conversación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Néfer"
				}
			]
		}
	]
}