				]
			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "Oh, ¡jefa Néfer! Vaya, viene en el momento perfecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380102,
					"content": "¿Ya tomaste una decisión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380103,
					"content": "¿Eh? ¿Decisión...? ¿Qué quiere decir? Acaso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380104,
					"content": "Sé que siempre ha querido visitar a los Descendientes Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380105,
					"content": "Por eso desea conocer primero a Lyylikki para así poder usar esa amistad como trampolín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380106,
					"content": "¿Ya-ya lo sabía? Ay, pero si no se lo he contado a nadie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380107,
					"content": "Sr. Tzompanco, cuando uno guarda un secreto, también tiene que aprender a ocultar ese hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380108,
					"content": "De lo contrario, tarde o temprano, el muro que construyó en su interior empezará a tener grietas por donde entrará el viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380109,
					"content": "*Suspira*, en mis tierras nunca fui bueno escondiendo mis pensamientos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380110,
					"content": "Bueno, ya que conoce mi intención, ¿sería tan amable de presentármela? Soy un forastero aquí, y no quisiera incomodar a la Srta. Lyylikki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380111,
					"content": "Los Descendientes Lunaescarcha tienen un alma bondadosa. No importa si eres forastero o incluso si no eres humano, te acogerán con calidez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380112,
					"content": "¿Eh? ¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380113,
					"content": "Pero de todos modos, irrumpir sin aviso sería una descortesía. Prefiero que sea usted, la jefa Néfer, quien me presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761380114,
					"content": "De acuerdo. Justo ahora deben de haber terminado de repartir la comida, es un buen momento para charlar. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380115,
					"content": "Por cierto, esta vez no le cobraré. Solo pasaba por casualidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761380116,
					"content": "¡Gracias, jefa Néfer! Voy a preparar mis cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tzompanco"
				}
			]
		},
