			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuching"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Gracias por ayudarme a hacer el pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220402,
					"content": "Con estas bebidas especiales, los marineros podrán saciar su sed y recuperar fuerzas con diferentes sabores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220403,
					"content": "¿Sabores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "Cada marinero tiene diferentes gustos. A algunos les gusta el té suave, otros prefieren el jugo agridulce... Si uno bebe siempre lo mismo, al final se acaba aburriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220405,
					"content": "Por eso suelo traer bebidas de diferentes sabores, para adaptarme todo lo posible a las necesidades de los marineros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220406,
					"content": "¿Qué puedes contarme sobre tu tienda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "Gracias a que los marineros me ayudaron, logré abrir mi tienda a este lado del muelle, y así poder servir bebidas para ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220408,
					"content": "No obstante, todavía no tengo mucha experiencia, el negocio avanza poco a poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220409,
					"content": "¡Hasta luego!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "¡Adiós! ¡Buena suerte en su viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuching"
				}
			]
		},
		{
			"id": 7052221,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
