				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "#¡Bienvenid{F#a}{M#o}s a la taberna Cola de Gato! ¿Hay algo en lo que estén interesad{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220202,
					"content": "¡Hola, Diane! ¡Esta vez vinimos a hacer negocios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220203,
					"content": "Le explicas a Diane los requerimientos del pedido de Chuching...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "¿Eh? ¿Esa tiendecita que acaba de abrir en el muelle norte de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220205,
					"content": "Los marineros del Puerto Dornman me hablaron alguna vez de la dueña y creo que Margaret alguna vez compró ingredientes allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220206,
					"content": "Estos días, Chuching estaba vendiendo bebidas a los marineros del muelle. Aprovechó para pedirles que promocionaran el agua de manantial de la Aldea Chingtsé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220207,
					"content": "Ella obtiene el agua a un alto precio y luego la revende allá donde se demande. Tan solo gana el coste básico que supone su mano de obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220208,
					"content": "Con ella como intermediaria, la gente de otros lugares puede utilizar el agua de manantial de la Aldea Chingtsé para elaborar un vino de sabor sin igual. Así, en la Aldea Chingtsé pueden hacer una fortuna. Puede decirse que matan dos pájaros de un tiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220209,
					"content": "Conque de eso se trata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Entonces, Chuching debe ser muy buena persona, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220211,
					"content": "Sí. Quizás la taberna Cola de Gato colabore con ella a largo plazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220212,
					"content": "Bueno, cambiando de tema... ¿Cuánto van a pagar por esas bayamentas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052203,
			"completionStepIds": [
				7052203
