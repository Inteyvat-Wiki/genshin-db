			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuching"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "#¡Bienvenid{F#as}{M#os}! ¿Qué les gustaría tomar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220102,
					"content": "Oh... A juzgar por su vestimenta, no parecen ser de por aquí... No sé si el té que tengo será de su gusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220103,
					"content": "Les prepararé una tetera de té blanco Yunlai. Si no les gusta, pueden volver más tarde. Para ese entonces, ya debería haber encontrado a alguien que me consiga bebidas especiales del Festival de la Vendimia de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220104,
					"content": "Eres muy amable, pero no vinimos a tomar nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "¡Eso es! ¡Somos tus ayudantes de confianza! Paimon escuchó que publicaste un encargo en el Festival de la Vendimia para encontrar a alguien que ayudase con los pedidos, por eso, ¡aquí estamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220107,
					"content": "#Si quieres hacer cualquier pedido de bebidas, ¡nosotr{F#a}{M#o}s podemos echarte una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220108,
					"content": "Solo por ayudarme con los pedidos de los clientes... ¿vinieron especialmente hasta Liyue? ¡¿Cómo pueden ser tan amables?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220109,
					"content": "#Creí que nadie querría tomarse la molestia de aceptar este encargo... ¡Siento mucho tener que molestarl{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220110,
					"content": "Los marineros que estuvieron en Mondstadt me contaron que la especialidad de <color=#00E1FFFF>la taberna Cola de Gato</color>, la “bayamenta”, es de lo más relajante y refrescante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220111,
					"content": "Así que quiero pedir <color=#00E1FFFF>65 cajas de bayamentas</color> para servírselas a los marineros junto con otras bebidas. Así podrán mantenerse de buen humor y trabajar con fervor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220112,
					"content": "Antes, los comerciantes de Mondstadt también solían preparar mercancías similares según mis necesidades. Esta vez reuní algunos néctares cristalizados de acuerdo a las normas del Festival de la Vendimia, ¡todos para ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220113,
					"content": "Hice mis cálculos y reservé una buena cantidad de fondos, pueden quedarse con lo que sobre como recompensa por su trabajo duro, aunque todavía no lo veo suficiente para expresarles mi gratitud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220114,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#¡Tú no te preocupes! Has dicho que son 65 cajas de bayamentas, ¿no? Pues Paimon y {NICKNAME} se encargan sin problema, ¡ya somos expert{F#a}{M#o}s en estas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220117,
					"content": "¡Enseguida estaremos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220115,
					"content": "#Esto es coser y cantar para nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "Estamos aquí para ayudar con los encargos de la compra de bebidas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052202",
							"2"
						],
						"stepId": 7052202,
						"stateName": "QUEST_STATE_UNFINISHED"
