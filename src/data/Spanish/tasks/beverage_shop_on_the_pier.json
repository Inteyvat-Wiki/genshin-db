			"dialogs": [
				{
					"id": 705222101,
					"content": "Eh... Me están tomando el pelo, ¿no? Al fin y al cabo, nosotras también tenemos un negocio que sacar adelante, les pido que sean razonables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052222,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
