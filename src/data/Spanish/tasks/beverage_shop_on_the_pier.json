	"talks": [
		{
			"id": 7052201,
			"completionStepIds": [
				7052204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
