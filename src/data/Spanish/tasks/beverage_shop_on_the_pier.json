			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuching"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "¡Chuching, Chuching! ¡Ya estamos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220302,
					"content": "Ya nos encargamos del pedido que necesitabas. ¡Mañana cargarán la mercancía en el barco y la transportarán al muelle lo más pronto posible! ¡Tendrás que guardar bien este recibo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220303,
					"content": "¿Y ya está? ¡Con qué velocidad resolvieron el asunto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220304,
					"content": "Y-yo... Les preparé un té con la mejor agua de manantial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220305,
					"content": "¡Para eso estamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "¡Eso, eso! Tenemos que ayudar a otros a hacer sus pedidos, no es necesario que te molestes en atendernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220308,
					"content": "#¡Paimon espera que tu negocio vaya viento en popa! A la próxima regresaremos para tomar ese té junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220309,
					"content": "#Oh... ¡Entonces pueden estar segur{F#a}{M#o}s de que a la próxima les prepararé su bebida preferida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220310,
					"content": "#¡Aquí l{F#a}{M#o}s espero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuching"
				},
				{
					"id": 705220306,
					"content": "En realidad ya nos llevamos nuestra remuneración...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
