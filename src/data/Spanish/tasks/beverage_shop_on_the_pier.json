				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705222201,
					"content": "Mis disculpas, el precio que ofrecen es demasiado bajo. Margaret me echará la culpa si se entera de que yo acepté un precio así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
