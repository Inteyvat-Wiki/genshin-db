					"nextDialogs": [
						411311310
					]
				},
				{
					"id": 411311310,
					"content": "Es verdad... Los meteoritos y las flores no tienen nada que ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311311
					],
					"speakerTitle": "Paimon"
				},
