	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivánovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "Humm... No está mal, podría hacer una fortuna con esto. Solo hay un pequeño problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310102,
					"content": "¿Cuál es ese problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "#¿Eh? Oh, {F#viajera}{M#viajero}, eres tú. ¡Llegas justo a tiempo! ¿Te interesaría participar en un... un...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310107,
					"content": "Me refería a un... misterioso... magnífico... e innovador negocio con ganancias aseguradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310108,
					"content": "Solo necesito un poco de ayuda, ¡y te aseguro que nos haremos de oro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310104,
					"content": "Sabes que el Banco del Reino del Norte es un lugar de máxima seguridad, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "Claro que lo sé, y sus guardias son de Snezhnaya. Lo que quería decir es... Espera, ¿qué pensabas que iba a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310106,
					"content": "Parece que, efectivamente, viajar amplía tus horizontes y hace que te vuelvas más imaginativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310112,
					"content": "Además, es realista y consistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310113,
					"content": "¿Sabes de los meteoritos que cayeron del cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310114,
					"content": "Me gustaría encontrar uno y llevarme unos cuantos trozos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310115,
					"content": "Después, buscaremos a un buen artesano para que lo talle y lo convierta en joyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310116,
					"content": "Imagínatelo... Joyas hechas con un meteorito: anillos, colgantes, brazaletes, aretes... ¡La gente rica estará ansiosa de pagar por ello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310117,
					"content": "#{F#Viajera}{M#Viajero}, tu trabajo es muy sencillo. Solo tienes que asegurarte de que ningún monstruo me moleste mientras hago mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310118,
					"content": "¿Qué opinas? ¿Trato hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310119,
					"content": "No deberías acercarte a esos meteoritos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "¿Eh? ¿Por qué? ¡No puedo perder esta oportunidad de negocio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310109,
					"content": "¿Encontraste un vacío legal en las leyes de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "Bueno, sinceramente, el código legal de Liyue es bastante exhaustivo. Apenas tiene vacíos legales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310111,
					"content": "¡Pero eso no es lo que quería decir! Mis plan es completamente legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivánovich"
				}
			]
		},
		{
