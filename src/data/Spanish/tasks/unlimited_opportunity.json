					"nextDialogs": [
						411311316
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411311316,
					"content": "Toma, aquí tienes tu recompensa. Fue un placer hacer negocios contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311317
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411311317,
					"content": "¿Qué podría hacer con esta flor dulce?... ¿Un perfume? ¿Un marcapáginas? ¿Dejar que se seque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivánovich"
