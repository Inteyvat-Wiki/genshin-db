					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "#Por eso necesito tu ayuda, {F#viajera}{M#viajero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivánovich"
				}
			]
		},
		{
			"id": 4113103,
			"completionStepIds": [
				4113103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivánovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "Seguro que otras personas también pensaron en este negocio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "Sí, seguramente. Por eso debemos apresurarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310303,
					"content": "#{F#Viajera}{M#Viajero}, si quieres ayudarme, deberíamos salir ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310304,
					"content": "¡Cada segundo que pasamos hablando es un Mora menos para nuestros bolsillos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310305,
					"content": "Guau... Es imposible convencerle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310306,
					"content": "Tal vez si pudiéramos dejarle claro que con este negocio no podrá ganar mucho dinero, o que los meteoritos son muy peligrosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
				4113104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivánovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "Si tocas un meteorito, te dejará inconsciente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "¿Eh? Ah, sí, escuché ese rumor. Eso sería un problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310403,
					"content": "Pero creo que debería haber alguna máquina que pudiera resolver ese pequeño detalle, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411310404,
					"content": "Oh, parece que está empezando a dudar. Tal vez esté valorando los pros y los contras de este negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310405,
					"content": "Sigamos así. Tenemos que convencerle de que con este negocio no ganará mucho dinero, y que los meteoritos son demasiado peligrosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113105,
			"completionStepIds": [
				4113105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivánovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310501,
					"content": "¿Estás seguro de que encontrarás accesorios que combinen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310502
					]
				},
				{
					"id": 411310502,
					"content": "Oh, no te preocupes por eso. Ya encontraré algo.",
