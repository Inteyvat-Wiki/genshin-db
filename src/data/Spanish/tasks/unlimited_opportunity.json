					"nextDialogs": [
						411311312
					],
					"speakerTitle": "Ivánovich"
				},
				{
					"id": 411311312,
					"content": "Que no, que no tiene nada de especial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311313
					]
				},
				{
					"id": 411311313,
					"content": "#No, {F#amiga mía}{M#amigo mío}, no. Si ha estado cerca de un meteorito, tiene que ser especial.",
