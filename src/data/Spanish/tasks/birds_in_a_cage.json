				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neuvillette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140251001,
					"content": "Creo haberles dicho alguna vez que mis emociones pueden resonar fácilmente con las de otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251002
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251002,
					"content": "Sin embargo, nunca he podido sentir eso en ningún encuentro que he tenido con esa miembro de Los Once. Su interior es como un lago de aguas calmas: oscuro, profundo y sin ninguna ondulación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251003
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251003,
					"content": "No tengo muy claro si es así desde que nació o si es capaz de controlar sus emociones por medio de su propia voluntad. Cualquiera de las dos opciones significa que es una persona peligrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251004
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251004,
					"content": "No indagaré más en los motivos que tengan para seguirla, pero sí les diré una cosa: tengan mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		}
	]
}