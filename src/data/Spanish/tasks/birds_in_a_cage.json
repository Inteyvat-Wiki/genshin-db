			"dialogs": [
				{
					"id": 140250801,
					"content": "¿A dónde vamos hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250802
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140250802,
					"content": "Probemos en un lugar un poco más alejado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				}
			]
		},
		{
			"id": 1402510,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1402505",
							"2"
						],
						"stepId": 1402505,
						"stateName": "QUEST_STATE_UNFINISHED"
