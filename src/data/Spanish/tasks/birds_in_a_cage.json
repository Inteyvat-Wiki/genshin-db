			},
			"dialogs": [
				{
					"id": 140250501,
					"content": "Arlecchino, ¿de qué se supone que has hablado con Neuvillette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250502,
					"content": "Que si un lago, que si unos ríos... ¿Es que estaban hablando de algún proyecto hidrológico o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250503,
					"content": "¿Tanto les interesa? Creo que ahora hay otros asuntos de mayor urgencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250504
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250504,
					"content": "Cierto... ¿Cómo estará Lyney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250505,
					"content": "#{NICKNAME}, ¿estás pensando en algo? ¡Ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250506,
					"content": "(Arlecchino parece estar muy tranquila, pero no bromeaba cuando dijo que quienes traicionan a la Casa de la Hoguera lo pagan con sus vidas. Creo que lo de castigar a los niños iba totalmente en serio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250507
					]
				},
				{
					"id": 140250507,
					"content": "(¿Cómo podemos detenerla? No, antes de hacer nada, aún hay otra cuestión.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250508
					]
				},
				{
					"id": 140250508,
					"content": "(Mencionó a Clervie cuando estábamos en la entrada del Palacio Mermonia. ¿Significa eso que siempre ha sabido dónde estaba? ¿Anticipó incluso el plan de Lyney, Lynette y Fréminet?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250509
					]
				},
				{
					"id": 140250509,
					"content": "¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250510
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250510,
					"content": "Qué dolor... Ah, ¿estás bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250511
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250511,
					"content": "Lo siento. Estaba tan concentrado vendiendo estos periódicos que ni me fijé por dónde iba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250512,
						140250513
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250512,
					"content": "Perdón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				},
				{
					"id": 140250514,
					"content": "Toma, te doy este periódico como disculpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250515
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250515,
					"content": "(Humm, ¿de qué me suena esta persona?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250516
					]
				},
				{
					"id": 140250516,
					"content": "No te preocupes, no es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250517,
					"content": "No, insisto. Total, aún me quedan muchos y los que me sobren no me servirán de nada mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250518
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250518,
					"content": "Es culpa mía... Compré de más con la esperanza de llevarle un dinero extra a mi familia, pero hoy apenas me han comprado periódicos, así que aún me quedan muchos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250519
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250519,
					"content": "¿De qué hablan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250520
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250520,
					"content": "#Oh, de nada. Es que me he chocado con {F#ella}{M#él}, pero ya me iba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250521
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250521,
					"content": "Espera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250522
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250522,
					"content": "Eh... Si quieren una compensación monetaria, me temo que no llevo ni un Mora encima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250523
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250523,
					"content": "Dame tres periódicos. Aquí tienes los Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250524
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250524,
					"content": "¿Eh? Vaya, muchas gracias por su compra, ¡y que los Arcontes la bendigan con mucho dinero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250525
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250525,
					"content": "Ojalá todos los días me encontrara con clientes tan generosos como usted... En fin, mañana compraré menos periódicos, no puedo hacer cosas tan impulsivas solo porque vaya a casarme pronto. ¡Nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250526
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250526,
					"content": "Bueno, ahora que he terminado mis asuntos pendientes, tomaremos un ferribús de vuelta a Poisson. Hasta tendremos algo que leer para matar el tiempo durante el trayecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250527
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250527,
					"content": "E-espera, ¿y si damos otra vuelta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250528,
					"content": "El estómago de Paimon ya está haciendo “grugrugrú”. ¡No podemos volver hasta que comamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250529,
					"content": "(Paimon está buscando alguna excusa para no volver. Es demasiado pronto, así que dudo mucho que Lyney haya conseguido hacer algo. ¿Qué hacemos?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250530
					]
				},
				{
					"id": 140250530,
					"content": "Ya veo que aún creen que por demorarnos un poco más, las cosas van a cambiar. En mi opinión, sus esfuerzos son en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250531
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250531,
					"content": "A pesar de ello, estoy dispuesta a concederle a Lyney un poco más de tiempo, con una condición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250532
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250532,
					"content": "Y, además, también resolveré todas sus dudas en cuanto a quién es Clervie y qué relación tengo con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250533
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250533,
					"content": "¿C-cómo te has vuelto tan generosa de repente? No querrás que hagamos algo malo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250534,
					"content": "No se sobrevaloren. Ustedes no tienen lo que se necesita para hacer el mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250535
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250535,
					"content": "Arg... Entonces, ¿por qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250536,
					"content": "Lo más importante en una negociación es que ambas partes reciban algo que deseen obtener. De nada sirve estar todo el tiempo pidiendo cosas y amenazando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250537
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250537,
					"content": "De acuerdo. Escuchemos cuál es esa condición.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250538
					]
				},
				{
					"id": 140250538,
					"content": "Muy bien. La condición es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250539
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250539,
					"content": "... Llegado el momento, tomen la decisión que crean más adecuada para ayudar a la Casa de la Hoguera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250540
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250540,
					"content": "Bueno, a Paimon le parece una petición muy normal... Pero ¿qué quieres decir con “llegado el momento”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250541,
					"content": "Eso tendrán que decidirlo ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250542
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250542,
					"content": "Aceptamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "Tenemos un trato. Vengan conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250513,
					"content": "Yo tampoco te vi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
		},
		{
