				]
			},
			"dialogs": [
				{
					"id": 140250201,
					"content": "Hola de nuevo. ¿Y esas caras de cansancio? ¿Es que ayer no pudieron dormir bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250202
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250202,
					"content": "No mucho, la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250203,
					"content": "Dejar de pensar en sus preocupaciones les ayudaría a dormir mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250204
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250204,
					"content": "¿Qué van a hacer? ¿Volver a dormir o devanarse los sesos pensando en un tema de conversación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250205
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250205,
					"content": "La verdad es que tengo curiosidad... Si hoy no está Nobile, ¿cómo planean retenerme aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250206
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250206,
					"content": "(¡¡¡...!!!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250207
					]
				},
				{
					"id": 140250207,
					"content": "¡Qu-qué dices! ¡Si solo venimos a charlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250208,
					"content": "Si no saben de qué hablar, ¿quieren acompañarme a un sitio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250209
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250209,
					"content": "#Tranquil{F#a}{M#o}s, iremos por un camino en el que no habrá niños rebeldes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250210
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250210,
					"content": "¿Eh? Oh... Qué buen tiempo hace hoy, ¿no te parece, Arlecchino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250211,
					"content": "¿Ya lo sabías?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250212
					]
				},
				{
					"id": 140250212,
					"content": "Los niños siempre creen que pueden engañar a los adultos, pero yo puedo ver muy claramente a través de sus pequeñas artimañas. No obstante, soy una persona muy paciente, así que dejaré que jueguen un poco más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250213
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250213,
					"content": "Me voy. Nos veremos en el Palacio Mermonia cuando hayan tomado una decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250214
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250214,
					"content": "Si me hacen caso, tal vez ellos puedan salir vivos de esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250215
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250215,
					"content": "¡¿Qu-qué hacemos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250216,
					"content": "A juzgar por su tono de voz, ¡sabía claramente que hemos hecho algo malo! Es más, ¡eso último sonó a una amenaza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250217,
					"content": "Soltaremos el pájaro mágico que nos dio Lyney.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250218
					]
				},
				{
					"id": 140250218,
					"content": "De acuerdo. A ver si recibe el aviso a tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250219,
					"content": "Deberíamos ir al Palacio Mermonia. Ya lo ha dicho: si no lo hacemos, las consecuencias serán terribles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250220,
						140250221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250220,
					"content": "Supongo que no hay más remedio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				},
				{
					"id": 140250222,
					"content": "Pongámonos en marcha. No podemos permitir que vaya a buscar a Lyney por haberse cansado de esperarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250221,
					"content": "Tendremos que ir viendo sobre la marcha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				}
			]
		},
