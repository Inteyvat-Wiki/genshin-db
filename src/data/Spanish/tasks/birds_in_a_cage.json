			"dialogs": [
				{
					"id": 140250102,
					"content": "Ya estamos todos. Hoy también actuaremos según lo planeado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250103,
						140250104
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250103,
					"content": "Espera un momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				},
				{
					"id": 140250105,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250106
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 140250106,
					"content": "¿Arlecchino ha colaborado alguna vez con Dottore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250107
					]
				},
				{
					"id": 140250107,
					"content": "¿Por qué lo preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250108,
					"content": "Nos lo contó ayer Clervie cuando nos la encontramos por la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250109,
					"content": "Conocimos a Dottore en Sumeru. No solo es peligroso, ¡sino también una persona malísima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250110,
					"content": "No puedo garantizarles que Padre y Dottore no tengan ningún tipo de relación, pero no creo que Padre quisiera colaborar con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250111
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250111,
					"content": "Ni estamos en el mismo bando ni confiamos los unos en los otros, así que no habría ninguna base para una colaboración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250112
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250112,
					"content": "No obstante, sí he oído que cuando Padre acababa de convertirse en una de Los Once, Dottore quiso colaborar con la Casa de la Hoguera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250113
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250113,
					"content": "Padre rechazó casi todas sus propuestas, a excepción de un experimento secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250114,
					"content": "¿Un experimento secreto? ¿Sería eso a lo que se refería Clervie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250115,
					"content": "No creo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250116
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140250116,
					"content": "No sé en qué consistirá concretamente ese experimento secreto, pero la Casa de la Hoguera lo llevó a cabo de manera independiente. Dottore solo propuso el enfoque de la investigación, así que ni siquiera se podría considerar una colaboración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250117,
					"content": "Además, lo único secreto era el experimento en sí. Los nombres de las personas que participaron en él se registraron, lo cual se contradice con la versión de Clervie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250118
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250118,
					"content": "Por favor, confíen en nosotros. Aunque la Casa de la Hoguera esté adscrita a los Fatui y en ocasiones no tenga más remedio que hacer algunas cosas que para ustedes son inaceptables, tenemos nuestras propias reglas y límites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250119,
					"content": "#Bueno, entonces nos quedamos más tranquil{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250120,
					"content": "A decir verdad, si Arlecchino realmente hubiera colaborado con Dottore y ambos hubieran hecho algo horrible, Paimon no sabría ni cómo mirarlos a ustedes a la cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250121,
					"content": "Pero entonces, ¿Clervie nos mintió? Paimon no tuvo la sensación de que estuviera haciéndolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250122,
					"content": "Ojalá pudiéramos preguntárselo directamente a Arlecchino, pero Paimon está segura de que no nos lo diría así como así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250123,
					"content": "Bueno, empecemos con el plan de hoy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250124
					]
				},
				{
					"id": 140250124,
					"content": "Ayer Padre no volvió, así que probablemente esté aún en la costa. Ya saben lo que deben hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250125,
					"content": "Lynette, ven conmigo. Y Fréminet, ya sabes lo que tienes que hacer. Ve con cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250126
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250126,
					"content": "Que comience el plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250104,
					"content": "Tengo una pregunta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				}
			]
		},
