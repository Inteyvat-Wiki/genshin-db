				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1856.942,
							155.632,
							5478.944
						],
						"pointId": 330700023
					},
					{
						"sceneId": 3,
						"position": [
							-1855.365,
							155.684,
							5479.971
						],
						"pointId": 330700024
					},
					{
						"sceneId": 3,
						"position": [
							-1855.176,
							155.344,
							5478.426
						],
						"pointId": 330700025
					}
				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "¡Espera! ¡Para, para! ¡No me pegues más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480202,
					"content": "Ay... No hace falta que seas tan cruel por una mísera caja de libros. Si los quieres, te los doy todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480203,
					"content": "¿Eso es todo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "¡Solo encontramos esta caja! ¡Te lo juro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480206,
					"content": "Aparte de los libros, hay algunas piedras y barro dentro de las botellas... Entre las piedras, hay unas gemas preciosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480207,
					"content": "¿Se llevaron las gemas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "¡Eh! ¡Devuelvan todas las gemas! ¡Son muestras geológicas de mucho valor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480209,
					"content": "Muestras... geológicas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480210,
					"content": "Devuélvanlas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "¡Claro, claro! ¡Todo suyo! ¡Rápido! ¡Metan las cosas en la caja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480213,
					"content": "Allí lo tienen todo. Nosotros nos vamos primero, jejeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480214,
					"content": "Todas las cosas que buscaba Sadife deberían estar dentro, llevemos la caja de vuelta con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480215,
					"content": "Es sorprendente que haya venido solito al desierto. No solo consiguió muchas muestras geológicas, sino que también tomó una gran cantidad de apuntes... Es realmente un erudito impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480211,
					"content": "Contaré hasta tres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "¿Falta algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
		{
			"id": 7334803,
			"completionStepIds": [
				7334805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7334805",
							"2"
						],
