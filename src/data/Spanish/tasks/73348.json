			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sadife"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "#Viajer{F#a}{M#o}, ya está aquí. ¿Qué hay de mi caja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "Aquí tiene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "¡Qué bien! Muchas gracias... Ay, vino con una carta de recomendación y yo le hice trabajar tanto... ¡Qué vergüenza! Por favor, acepte estos Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "¿No habían dicho ustedes que...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "¿Eh? ¿Usted también conoce esa frase? Es cierto que los Purbiruni tenemos este precepto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "Esta frase solo sirve para avisarnos de que no nos dejemos influir por el dinero o por otros motivos externos a la hora de seguir los principios de la investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "Al fin y al cabo, si un investigador considera que el lucro es su principal principio académico, no se merece la reputación de investigador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "Usted, en cambio, se ha esforzado mucho por ayudarme y se merece una recompensa razonable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Le agradezco de nuevo su ayuda. Si en un futuro necesita la mía, no dude en pedírmela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "¿No se supone que “la sabiduría no puede pagarse con Moras”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "La traje de vuelta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
		{
			"id": 7334804,
			"completionStepIds": [
				7334804
