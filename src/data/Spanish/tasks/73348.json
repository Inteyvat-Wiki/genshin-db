			"dialogs": [
				{
					"id": 733480901,
					"content": "Ay, ¿cómo puedo continuar con mi investigación con tan poco presupuesto?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "D-disculpa que te moleste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "¿Un erudito de los Purbiruni? ¡Oh! ¿Buscas a Sadife? Es muy raro que alguien venga especialmente para visitarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Últimamente se encuentra en la Academia de Sumeru gestionando unos asuntos, debe de estar cerca... ¿Por qué lo buscas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "Es sobre una carta de recomendación de Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "¿Khedive? ¿Ya ha terminado su investigación? Qué envidia que tenga dinero para contratar a todo un equipo que le acompañe a explorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "En cambio, yo ni siquiera consigo una subvención para una investigación de campo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "¿Conoces a Khedive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Claro. Es normal que, nosotros, los eruditos, al estar sufriendo por la carencia de presupuesto y sin saber qué hacer para obtener fondos, hayamos oído rumores sobre su fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "¡Guau! Entonces... ¿los eruditos de la familia de Khedive son todos ricos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "¿Eso quiere decir que recibiremos una generosa recompensa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "No es así, Khedive es una excepción. No te hagas ilusiones con los eruditos de los Purbiruni y los Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Sobre todo con aquellos que se especializaron en astrología con historia y biología como asignaturas secundarias... Debido al rumbo que tomaron sus investigaciones, tuvieron mala suerte y no pudieron conseguir financiación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480915,
					"content": "Además, siempre dicen que la sabiduría no puede pagarse con Moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480916
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480916,
					"content": "Bueno, ya he hablado mucho... Mira, está allí Sadife. Si tienes otras preguntas, deberías hacérselas a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480903,
					"content": "¿Conoces a algún erudito de los Purbiruni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				}
			]
		},
