						],
						"pointId": 600100254
					}
				]
			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "Oh, ya estás de vuelta. ¿Encontraste a alguien de los Purbiruni? No ha sido tan difícil, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "Sí, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "¿Por qué parece que me quieres decir algo, pero no te atreves? No te habrán dado problemas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Le cuentas a Khedive lo que ha pasado con Sadife...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Ah, Sadife... Es famoso por ser muy terco, a veces ni siquiera los profesores pueden con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "Además, rechaza cualquier forma de financiación, insiste en hacer sus propias investigaciones y dice que quiere mantener la pureza de su trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "¿A esto se refería con “la sabiduría no puede pagarse con Moras”?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Este es el principio de investigación de los eruditos de los Purbiruni... ¡Jaja! Nosotros, los Pursina, no somos tan pedantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Humm... Bueno, tampoco es eso, simplemente soy más rico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "¿Cómo ganas dinero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "¿Por qué me miras con tanta desconfianza? Mi dinero lo he ganado yo con mi propio esfuerzo. ¿Sabes lo complicados que son los contratos de futuros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "¿C-contratos de futuros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "Para contratar futuros, hay que vigilar el volumen de ventas de los productos, la fluctuación del mercado... También hay que prever la dirección que van tomando las inversiones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Al principio solo invertí un poco de dinero para divertirme, pues no quería que afectara a mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Pero ¿quién iba a decir que...? ¡Ah! ¿Quién iba a imaginar que ganaría cada vez más y más dinero y que mis inversiones se estaban multiplicando?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "¡Mi verdadera vocación es ser erudito! ¡Quiero investigar! ¡Quiero ser académico! ¡Quiero obtener logros académicos, no logros económicos! Eso es lo que siempre me digo a mí mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Sin embargo, siempre que me quedo en la Ciudad de Sumeru, soy incapaz de controlarme... Siempre acabo pactando un contrato de futuro tras otro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "El saldo de mi cuenta va en aumento, ¡pero mi investigación académica no avanza en absoluto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "¡Así que contraté a mucha gente que me acompañara a explorar la Sima! Como en este lugar no existe el mercado de futuros, podré seguir con mi investigación académica sin distracciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Si no consigo logro alguno con mi investigación, yo... ¡no pienso salir de la Sima hasta que así sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "Conque así es como ganas dinero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "¿Y por qué eres más rico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Ocurrió algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
