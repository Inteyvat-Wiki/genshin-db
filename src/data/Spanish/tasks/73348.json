			"dialogs": [
				{
					"id": 733480101,
					"content": "Pero... si no dispongo de esas muestras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "Sobre los Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Sí, y soy el actual herbad. ¿Me buscaban para algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "#¿Es sobre un asunto académico? Por su vestimenta, no parecen erudit{F#as}{M#os} de la Academia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "Es sobre una carta de recomendación de Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "¿Una carta escrita por Khedive? ¿Mi compañero Khedive? Un momento, déjenme leerla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Humm, parece que su investigación en la Sima está yendo por buen camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "Investigaciones sobre hongos... ecosistemas acuáticos... fósiles de organismos antiguos... entornos geológicos especiales... muestras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "¡Muy bien! Su olfato académico y su capacidad de investigación siguen siendo excelentes. ¡No me ha decepcionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Humm... Aunque no me guste admitirlo en público, lo cierto es que la capacidad académica de los discípulos de Pursina se merece mi confianza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Además, en su carta, Khedive también enfatizó muchas veces la gran ayuda que usted le brindó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Con su ayuda, ¡su investigación fue como la seda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "No hace falta que lo repita...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Ya veo. Perdón, perdí la compostura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Cuando regrese a la Academia de Sumeru, esto será un nuevo capítulo a registrar en la gloriosa historia de los Pursina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "Oh... ¡También hay que considerar la amistad milenaria entre las dos familias, que seguramente se fortalecerá mucho más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "¡Bueno! En nombre de los Purbiruni y los Pursina, me veo en la obligación de agradecérselo una vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Por cierto, en la carta también me pidió que le preparara algún regalo... Esto no me supone ningún problema. Por favor, espere un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "No me dará tan solo una carta como recompensa, ¿verdad?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "¡Por supuesto que no! Ha hecho un gran trabajo ayudando a Khedive con su investigación en diferentes lugares. Recompensarle con Moras es lo mínimo que podría hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Discúlpeme, salí de casa tan apurado que no traje muchos Moras. Si no le importa, espéreme aquí un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Aunque ambos sean eruditos que se enorgullecen de sus respectivas familias... Él y Khedive son completamente diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Parece que... no tiene mucho dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "¡N-ni hablar! Nosotros, los Purbiruni, somos una familia de eruditos, nunca podríamos tener problemas económicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "Lo que sucede es que invertimos la mayor parte de nuestro dinero en la investigación... Por eso, hemos tenido que apretarnos el cinturón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Sin embargo, este asunto no ha sido un obstáculo en nuestra investigación. Al contrario, al no tener los ojos nublados por la codicia, pudimos ver el camino de la sabiduría con más claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Ahora mismo le preparo su recompensa. Antes de eso, tengo una petición...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "#He visto que Khedive escribió en su carta que usted tiene una gran fuerza y vigor, además de una amplia experiencia en combate. También menciona que es {F#una}{M#un} aventurer{F#a}{M#o} excepcional...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "#En el caso de que... estuviera dispuest{F#a}{M#o}, ¿podría hacerme un favor? Hace poco me aventuré yo solo en el desierto para investigar la geología de una zona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "Ya que no tengo mucho dinero, no contraté guardias. Pensé que no habría ningún peligro si íbamos y volvíamos enseguida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Pero tuve muy mala suerte. Después de terminar la investigación, me atacaron unos ladrones de tesoros en el camino de vuelta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Logré escapar sano y salvo, pero perdí la caja que contenía todas las muestras geológicas y los apuntes que tomé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "Es posible que esa caja no tenga ningún valor para un comerciante o un ladrón, pero para mí... lo que hay en esa caja es de valor incalculable, ¡es irreemplazable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "#No logro encontrar ningún aventurero dispuesto a ayudarme en este momento... Viajer{F#a}{M#o}, ¿usted podría ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Yo le ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "¡Muchas gracias! Sin usted, no sabría qué hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "Le enseñaré en el mapa el lugar donde me atacaron. ¡La caja tiene que estar por ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Déjelo en mis manos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Ya me lo ha dicho muchas veces...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "¿Es usted un erudito de los Purbiruni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
