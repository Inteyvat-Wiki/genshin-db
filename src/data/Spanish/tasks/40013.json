				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean",
					"Bárbara",
					"Albedo",
					"Klee",
					"Alice",
					"Paimon",
					"Kaeya",
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "¿Eh? Esto es... Esperen, estoy muy confundida. ¡¿Qué es este lugar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130202,
					"content": "Toda esta isla es como una enorme caja de regalo escondida debajo del escudo de energía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400130203,
					"content": "Parece que hay algo ahí. ¿Y si le echamos un vistazo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130204,
					"content": "¡Sí, quiero verlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130205,
					"content": "¡Malvada chica de fuego, finalmente has llegado! ¡He esperado demasiado tiempo! ¡Ha sido demasiado aburrido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130206,
					"content": "¿Te atreves a enfrentarte a mí, el soberano del Clan Dodo, el Rey Dodo? ¡Qué osadía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130207,
					"content": "Aunque admiro tu valentía, no servirá de nada porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130208,
					"content": "¡Porque yo, el Rey Dodo, soy tu madre, Alice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130209,
					"content": "¿Eh? ¡¿Mamá?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130210,
					"content": "Espera... ¿Alice? ¡¿La autora de la Guía de viaje de Teyvat?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130211,
					"content": "¡Saludos, Klee y sus compañeros isleños!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130212,
					"content": "¿Qué les parece este lugar? ¿Se están divirtiendo? El cielo del verano, el mar... Nada mal para unas vacaciones, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130213,
					"content": "No sirve de nada que me busquen. El dispositivo que emite este sonido es nada más y nada menos que otra de mis invenciones, ¡el gramófono de Alice! Lo estoy utilizando para transmitir el amor de una madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130214,
					"content": "¿Eh? Tienes que estar bromeando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130215,
					"content": "Oigan, no los asusté, ¿o sí? Lo siento mucho, a mi Klee le encanta jugar con todo tipo de pequeños juguetes. Como madre, naturalmente quiero darle todo mi apoyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130216,
					"content": "¡Estos juguetes no son para nada pequeños!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130217,
					"content": "¿Madre... de Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130218,
					"content": "Es una pena que no podamos vernos en persona, pero estaré observando todos sus movimientos desde lejos, como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130219,
					"content": "¡Así que era la Srta. Alice! Qué descuidado de mi parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130220,
					"content": "Un momento... ¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400130221,
					"content": "Quizás les parezca un poco extraño. ¿Por qué una madre que está tan lejos de casa dedicaría tanto esfuerzo para crear un maravilloso mundo acuático?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130222,
					"content": "¡Ding, ding, ding! Acertaron. Porque yo misma he estado en esas islas. Adoro sus antiguas ruinas y su paisaje único. Lo preparé todo para que ustedes pudieran participar y disfrutar de las islas al igual que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130223,
					"content": "La madre de Klee también parece tener un espíritu muy libre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130224,
					"content": "Jeje, ¿alguno de ustedes está hablando mal de mí en mi ausencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130225,
					"content": "¿Eh? ¡N-no! ¿Nos puede escuchar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130226,
					"content": "No hace falta que te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130227,
					"content": "¿A qué te refieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130228,
					"content": "La madre de Klee, Alice, es una hechicera extremadamente enigmática y poderosa. No le prestes tanta atención, es simplemente su forma de ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130229,
					"content": "Deben tener curiosidad por saber lo que hay detrás de las cartas, los barcos, las boyas y ese escudo de energía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130230,
					"content": "Humm... En realidad, yo también pensé que sería un gran esfuerzo, pero solo así podría invitarlos a todos aquí, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130231,
					"content": "Las islas están llenas de historias. Sus primeros habitantes, los naufragios, la maquinaria misteriosa... Aquí hay muchas coincidencias. Habría sido una lástima no haber hecho estos preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130232,
					"content": "Ahora déjenme adivinar... Los que recibieron una carta deben estar presentes. Kaeya, Diluc, Razor, Jean, Bárbara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130233,
					"content": "#Albedo, siempre tan confiable e inteligente... {F#La viajera misteriosa}{M#El viajero misterioso} y su buena acompañante, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130234,
					"content": "Yo misma los invité para acompañar a Klee. Gracias a todos por permitir que mi hija pase un verano inolvidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130235,
					"content": "Todo en las islas es un regalo para ustedes como agradecimiento por hacer compañía a mi pequeña Klee. Sin embargo, cuando escuchen esta grabación, ya estaré viajando por otras tierras lejanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130236,
					"content": "#La vida de un viajero es tan acelerada y está tan llena de emociones. Jaja, pregúntenle {F#a la viajera}{M#al viajero} a su lado y lo entenderán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130237,
					"content": "¿Así que la Srta. Alice hizo todo esto porque estaba demasiado ocupada para estar con Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130238,
					"content": "¡No, mamá es así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130239,
					"content": "Bien, si están tratando de encontrar algún significado detrás de todo esto, les diré que la situación no es tan complicada como piensan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130240,
					"content": "La razón por la que me gusta Mondstadt es porque nosotras, madre e hija, deseamos esa misma libertad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130241,
					"content": "Mi deseo es muy simple: quiero que Klee crezca con un espíritu curioso y amable. Siempre que así lo desee, podrá hacer lo que quiera e ir a donde sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130242,
					"content": "Entonces de eso se trataba... Debo admitir que ciertamente encaja con el estilo de la Srta. Alice. Lo siento, fue un malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130243,
					"content": "Debe ser bueno tener una madre con esa personalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130244,
					"content": "¡Sí! ¡Es la mejor mamá del mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130245,
					"content": "Mamá, pescamos, navegamos en un bote, nadamos y jugamos muchos juegos divertidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130246,
					"content": "¡Todos han sido supergeniales y amables conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130247,
					"content": "¡La próxima vez, ven con nosotros y podremos jugar todos juntos de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130248,
					"content": "*Suspira*, parece que madre e hija son almas gemelas con un espíritu indomable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130249,
					"content": "Ah, el verano... Hablando de eso, cuando fui a esas islas, también era verano. Sentada en la playa, escuchando las olas que rozaban mis pies, pensé en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130250,
					"content": "Klee, eres una hija del verano, un regalo para mí traída por el mar y el viento. Mamá está agradecida por tu nacimiento, así que quería regalarte algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130251,
					"content": "Es por eso que mamá preparó estas islas, transformó las ruinas antiguas en un parque veraniego y asumió la identidad del Rey Dodo para invitarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130252,
					"content": "En otro mundo, hay muchas historias de una isla maravillosa cuyo nombre se inspiró en las manzanas doradas. Es llamada de muchas otras formas, pero siempre lleva consigo los sueños más bellos del ser humano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130253,
					"content": "A mamá le encanta esa historia, y quería que disfrutaras de sus maravillas, así que te di aguas color zafiro, arenas blancas como la perla y un paraíso fantástico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130254,
					"content": "Todo esto es para ti y para los que te aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130255,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130256,
					"content": "Así que solo había tres cristales, uno rojo claro como los pétalos de una flor, otro azul claro como las olas del mar, y uno amarillo claro como las hojas otoñales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400130257,
					"content": "Quizás desde el punto de vista de Alice, este archipiélago es el cuarto cristal por naturaleza. Ubicado en el medio del mar y cubierto de vegetación, es verdaderamente un “cristal del verano” color esmeralda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130258,
					"content": "Klee, al igual que mamá, tú eres de una raza bendecida con la longevidad. Para nosotros, el tiempo es como un soplo del viento: los momentos vienen y van.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130259,
					"content": "En una vida tan larga, los padres no somos más que la primera relación de un niño. Aunque no queramos separarnos, llegará el día en que tendrás que recorrer tu propio camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130260,
					"content": "Klee, mamá siempre te amará, pero también hay otras personas a tu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130261,
					"content": "Amigos que te acompañan, maestros que te educan, gente que está dispuesta a quedarse en una isla por ti por más insólito que sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130262,
					"content": "El verano es para todos. No importa qué giros tenga la vida, no importa cuántas cosas sucedan este año, el verano nunca desaparecerá, al igual que el amor de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130263,
					"content": "A partir de ahora, no importa a dónde vayas, espero que nunca olvides a las personas que te aman en este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130264,
					"content": "Por cierto, hazle caso al Sr. Albedo en casa. Mamá regresará a visitarlos de vez en cuando. De hecho, cada vez que tengo tiempo libre, me escabullo para ver cómo están todos ustedes. Jeje, ¿a que nadie se había dado cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130265,
					"content": "La misma Alice de siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130266,
					"content": "¿Crees que Albedo lo supo desde un principio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130267,
					"content": "¿Eh? El tiempo casi se acaba, así que es todo por ahora. Bien, puse mucho tiempo y dedicación en este lugar, ¡así que diviértanse al máximo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130268,
					"content": "A todo el mundo, especialmente a mi querida Klee: ¡nos vemos a la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130269,
					"content": "¡Adiós, mamá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130270,
					"content": "Klee está muy feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "Jeje... ¡En realidad el Rey Dodo era mamá! No sé por qué, ¡pero estoy muy contenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130272,
					"content": "Ya sea la que vuela las puertas de Mondstadt en pedazos, a la que castigan, o la que escribe cartas extrañas, amo todas las versiones de mamá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130273,
					"content": "¿No te sientes sola sin tu madre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "No. Mamá es la maga más fuerte del mundo mundial, así que siempre me hace compañía esté donde esté. ¡Nunca me sentiré sola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130275,
					"content": "¡Mi amor por mamá es así de grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130276,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, ¿me quieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130277,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "¡Yo también te quiero mucho! ¡Tienes que jugar mucho conmigo aquí para no decepcionar a mamá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130279,
					"content": "Aún tengo muchas bombas saltarinas, y también está Dodoco... ¡Vamos a nadar y a explotar peces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130280
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130280,
					"content": "¡Siempre nos divertimos mucho contigo, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130281
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130281,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130282
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130282,
					"content": "¡No hagamos esperar a Klee! ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4001303,
			"completionStepIds": [
				4001310
			],
