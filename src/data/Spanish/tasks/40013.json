				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bárbara",
					"Jean",
					"Klee",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130301,
					"content": "#¡Aquí, Caballer{F#a}{M#o} Honorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130302
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400130302,
					"content": "¿Cómo están los peces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130303
					]
				},
				{
					"id": 400130303,
					"content": "Tal y como imaginábamos, los cristales los atrajeron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130304
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130304,
					"content": "¡A pescar, a pescar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130305,
					"content": "¡Ah! ¡No, no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130306,
					"content": "#Quizás es mejor que nosotr{F#as}{M#os} atrapemos los peces para evitar que exploten en pedazos por las bombas de Klee. Al fin y al cabo, ¡somos expert{F#as}{M#os} en recolectar recursos naturales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4001304,
			"completionStepIds": [
				4001311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
