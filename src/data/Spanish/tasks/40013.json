			},
			"dialogs": [
				{
					"id": 400130101,
					"content": "¡Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130102,
					"content": "Ya colocamos las escamas en su lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "¡Yupi, genial! Jejeje, ahora es mi turno, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130104,
					"content": "Sí. ¡Dejamos el mecanismo de allá en tus manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130105,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130106,
					"content": "Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130108,
					"content": "Por favor, ten mucho cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "Sí, ¡lo sé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130112,
					"content": "Klee, ¿qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400130113,
					"content": "Estoy... preocupada... ¿Qué pasa si el Rey Dodo realmente está aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130114,
					"content": "¿Y si no me permite ser parte de la familia de Dodoco? ¿Y si pierdo contra él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130115,
					"content": "Entonces Dodoco no podrá estar conmigo, y mamá también se pondrá muy triste... Dodoco es el más mejor amigo que me dio mamá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130116,
					"content": "Tengo miedo de presionarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130117,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130118,
					"content": "#{F#Srta. Caballera Honoraria}{M#Sr. Caballero Honorario}, ¿puedes presionar el botón por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130119,
					"content": "No puedo hacerlo por ti, Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130121,
					"content": "Porque tengo que sujetar mi arma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "Solo así puedo protegerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "Sí, Klee, todos estamos aquí contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130124,
					"content": "No te preocupes, Klee, ¡te cubriremos la espalda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130125,
					"content": "Sea quien sea el enemigo, mientras estemos aquí, no tienes nada que temer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130126,
					"content": "Perfecto, yo también quiero ver qué tan fuertes son los adversarios en esta isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 400130127,
					"content": "Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130128,
					"content": "Yo estar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130129,
					"content": "Oigan, no digan cosas así... ¿Y si el Rey Dodo solo quiere invitar a Klee a su casa para charlar? O... ¡Quizás ya aceptó a Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400130130,
					"content": "¿Realmente creen que me aceptará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130131,
					"content": "¿Por qué no? Has dado lo mejor de ti, y has hecho un buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130132,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130133,
					"content": "Klee, eres mi persona preferida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "... ¡De acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130136,
					"content": "¡Déjenmelo a mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130137,
					"content": "Presionar el botón... ¡Presionar el botón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130134,
					"content": "Él te aceptará, lo sé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "Todos estamos contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
		{
			"id": 4001302,
