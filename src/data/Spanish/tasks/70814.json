			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "#¿E-eres {F#una aventurera}{M#un aventurero}? ¿Viniste a aceptar algún encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "Por favor, espera un momento... Déjame ver qué tengo por aquí... “Competición de vuelo”, “Guía de supervivencia en la naturaleza”, “Se busca instructor de escalada libre”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "¿De verdad son encargos del Gremio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "¡Lo sé! ¡Lan también lo dice! Pero todas las aventuras que he leído en los libros eran algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "Si no doy estos encargos, ¿qué debería dar?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "¿Qué tal algo como “derrota a los monstruos”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "¡Pero eso es muy peligroso! Es cierto que hay muchos de ellos alrededor de Lisha, y que son una amenaza para los transeúntes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "Pero la gente normal no tiene nada que hacer contra ellos. Incluso podrían salir heridos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "¡Yo me encargo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "¿De verdad? Bueno... Muy bien. Entonces, lo dejo en tus manos. Voy a discutir con Lan el pago apropiado por tus servicios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "¡Los aventureros no somos “gente normal”!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Ya veo... B-Bueno, entonces, dejaré que te encargues de ello. Discutiré tu pago con Lan más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 7081404,
