				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140201,
					"content": "¿Querías algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140202,
					"content": "¿Encontraste la espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "No pensé que te acordarías. Por desgracia, aún no tengo ninguna pista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140204,
					"content": "Aún estoy en el punto de partida, esperando a que algo suceda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140205,
					"content": "Tal vez te pida ayuda si surge algo relacionado con ese asunto... Cuando eso suceda, contaré contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
