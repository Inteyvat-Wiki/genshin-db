				"objectNames": [
					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "Arachatora está muy contento. Por fin consiguió tupeta y terminó de practicar cocina. Y también ha conocido a nara fuerte y amable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Seguro que Arapacati, Arasaka, Arapas y Arafala también están agradecidos contigo. Nara {NICKNAME}, eres {F#buena}{M#buen} nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "¿Agradecidos? ¿Y eso por qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Cuando ayudar a Arachatora, diste a ellos oportunidad de probar tupetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				}
			]
		},
		{
			"id": 7302005,
