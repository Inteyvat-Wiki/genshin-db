				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "*Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200102,
					"content": "¡Ah, nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200103,
					"content": "*Ejem*, Arachatora está muy avergonzado de que nara lo vean así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200104,
					"content": "#{F#Buena}{M#Buen} nara, Arachatora es Arachatora. ¿Ustedes cómo se llaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200105,
					"content": "#Me llamo {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "¡Y Paimon se llama Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200107,
					"content": "#Nara {NICKNAME} y Paimon, Arachatora entiende. Muchas gracias. Si Arachatora no hubiera conocido a ustedes, habría tardado poco más en recuperarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200108,
					"content": "¿Cuánto es un poco más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200109,
					"content": "A Arachatora da poco de vergüenza reconocer, pero ya pasó una vez. Fue por champiñones que encontró. Arachatora tardó en recuperarse mismo tiempo que lotos nilotpala tardaron en abrirse y cerrarse dos veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200110,
					"content": "Florecieron y marchitaron... ¡¿Eso no son dos días?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200111,
					"content": "Ah, dos días, Arachatora ya entiende. Así que eso significa “día”. Nara son muy interesantes. ¿Dos días es mucho o poco tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200112,
					"content": "#Humm... ¿Qué opinas tú, {NICKNAME}? ¿Dos días es mucho o poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200113,
					"content": "Supongo que mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "Humm. Es difícil imaginar a Arachatora llorando dos días enteros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200115,
					"content": "¿De verdad? Así que es mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200126,
					"content": "Pero si tú eres Arachatora... ¿eres familia de Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200127,
					"content": "No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200128,
					"content": "¿Eh? Pero... eres el hermano de Arapacati, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200129,
					"content": "Ah, ¿cómo saben eso? Arapacati es hermanita de Arachatora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200130,
					"content": "¿Entonces son familia o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200131,
					"content": "Tal vez sea diferente para los aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "Bueno, esto es lo que pasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200133,
					"content": "Le cuentan lo ocurrido a Arachatora.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "Festival Utsava se celebrará pronto... ¿Qué debería hacer Arachatora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200135,
					"content": "Arachatora todavía no ha preparado ingredientes necesarios. Festival Utsava es mejor momento para demostrar a Arasaka, Arapas y Arafala que platos con champiñones son más ricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200136,
					"content": "Entonces, Ara... apas... fala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200137,
					"content": "Arasaka, Arapas y Arafala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "¡Ah! ¡Los nombres de los aranara son muy difíciles! Arachatora, ¿dónde están tus hermanos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200139,
					"content": "Nos separamos para seguir nuestros propios caminos de práctica. Igual que río se divide en arroyos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200140,
					"content": "¿Entonces, se separaron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200141,
					"content": "Debemos practicar cocina para preparar manjar supremo, pero ellos no reconocen valor de platos con champiñones. ¡Champiñón “tupeta” es mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200142,
					"content": "Por eso, decidimos practicar cocina por separado y perfeccionar nuestros propios manjares supremos para poder comparar más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200143,
					"content": "Así que eso fue lo que pasó... Bueno, ya que se trata de perfeccionar los manjares supremos, ¡es totalmente comprensible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200144,
					"content": "¿Y dónde están las tupetas esas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200145,
					"content": "Marana se propaga a gran velocidad. Ya ha ocupado territorio de tupetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200146,
					"content": "*Suspira*, así que ahora es una zona marchita... Paimon espera que Rhana esté a salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200147,
					"content": "Arachatora teme que sus terribles garras ya hayan arrancado preciados champiñones de Arachatora. Seguro que ustedes ya saben que Marana es muy, muy peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200148,
					"content": "Sin tupetas, Arachatora solo podía probar champiñón raro que ningún aranara había probado nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200149,
					"content": "¿Y qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200150,
					"content": "Ya hemos visto lo que pasó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "Arachatora lo siente mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200153,
					"content": "Ahora que Paimon lo piensa, ya nos encargamos de las zonas marchitas y del Marana, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200154,
					"content": "Sí, fue pan comido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "¡Oh! ¡Increíble! Así que ustedes son suficientemente fuertes como para derrotar a Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200157,
					"content": "#Bueno, a Arachatora no le extraña. Como nara {NICKNAME} pudo curar a Arachatora con poder de Reina Menor Kusanali, seguro que fue fácil deshacerse de Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200158,
					"content": "#Por eso, nara {NICKNAME}, a Arachatora le gustaría que acompañaras a lugar donde crecen tupetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200159,
					"content": "#¡Es nuestra oportunidad para probar un delicioso plato con champiñones! {NICKNAME}, ¡todo sea por reunir a los hermanos de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200160,
					"content": "Muy bien. De todos modos, ya se lo habíamos prometido a Arapacati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "Bien. Están en cueva de ahí delante. Vengan con Arachatora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200161,
					"content": "Tú solo estás pensando en la comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "¿Qué tiene de malo matar dos pájaros de un tiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200155,
					"content": "Sí, casi nos cuesta la vida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "Ahí fue cuando vimos a Arachatora llorando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "Poco tiempo, creo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "#Humm, Paimon supone que sí. Igual que nosotr{F#a}{M#o}s nos conocemos desde hace mucho, pero parece que fuera ayer cuando nos encontramos por primera vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200118,
					"content": "¿De verdad? Si perder control durante dos días en bosque no es mucho, Arachatora está tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200119,
					"content": "¡Eso no es lo que queríamos decir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200120,
					"content": "Depende de para qué se utilice ese tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "Bueno, eso es cierto. Pasar dos días enteros llorando es mucho tiempo. Pero dos días en la vida de un jabalí salvaje tampoco es mucho, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200122,
					"content": "¿De verdad? Así que es mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200123,
					"content": "El tiempo es subjetivo y no tiene significado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#Tienes razón, nara {NICKNAME}. Entiendes bien principios de bosque. Para bosque, vida nace, crece y regresa a tierra. No necesitamos concepto de “día”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200125,
					"content": "Paimon no entendió nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "¡Ajá! ¡Aquí está tupeta que tanto deseaba Arachatora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200202,
					"content": "Tupeta, si perdieras tu dulce fragancia, ¿seguirías siendo tupeta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200203,
					"content": "Jeje, este champiñón huele muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200204,
					"content": "Bueno, ¡salgamos de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "Arachatora ha tenido mucha suerte de haber conocido a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200302,
					"content": "Este es sabor de tupeta completamente madura. Es mucho más fuerte que última vez que Arachatora olió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200303,
					"content": "Parece que ha crecido bien aunque Marana haya ocupado su territorio. ¡Maravilloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200304,
					"content": "Eh... bueno... ¿Podemos probar ya la tupeta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200305,
					"content": "Claro. Porque han sido muy amables con Arachatora y porque objetivo de Arachatora era servir a nara delicioso plato con champiñones de Arachatora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200306,
					"content": "¡Yuju! ¡Una tupeta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200307,
					"content": "Arachatora comienza a cocinar.\\nEl fresco aroma del champiñón inunda el ambiente.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "Arachatora sirve los platos.\\nSorprendrentemente, el plato carece de sabor alguno.\\nRebosa vitalidad y está demasiado duro como para masticarlo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "Ya está. Arachatora por fin terminó de practicar cocina. ¿Qué piensan? Arachatora está seguro de que es mejor plato que nara haya comido jamás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200310,
					"content": "Ñam, ñam... Glup, glup... Humm... Vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200311,
					"content": "(Te cuesta masticar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "(Te cuesta tragar la comida.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "Si te esfuerzas mucho, es comestible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "Humm... El champiñón huele de maravilla, pero el sabor y la textura no van mucho con nuestros gustos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200317,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200318,
					"content": "#¿Por qué? Cuando Arachatora lo sirvió a {F#aquel}{M#aquella} nara, dijo que estaba muy rico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200319,
					"content": "#¿{F#Aquel}{M#Aquella} nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200320,
					"content": "#Sí, Arachatora sirvió plato de champiñón a nara y, como estaba delicioso, {F#él}{M#ella} terminó en santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200321,
					"content": "Debería saber bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200323,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "*Suspira*, a cada aranara crecen hojas diferentes, así que Arachatora supone que nara también tienen gustos diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200325,
					"content": "Así es. Oye, y ahora que Paimon lo piensa, ¿cómo es que a los aranara no les asusta el fuego si parecen hojas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200326,
					"content": "Claro que tenemos miedo a fuego. A veces, incendio puede convertir bosque en páramo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200327,
					"content": "Pero, a fin y a cabo, para practicar cocina, Arachatora tiene que perder miedo a fuego y aprender a controlar su tamaño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200328,
					"content": "Así que es eso... Bueno, ya va siendo hora de que volvamos. Arapacati nos está esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200329,
					"content": "Está bien. Arachatora volverá a Vanarana ahora mismo. No está bien hacer que hermanita de Arachatora se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200330,
					"content": "En cuanto a hermanos de Arachatora... Arasaka, Arapas y Arafala están cerca de <color=#00E1FFFF>Villa Gandharva</color>, <color=#00E1FFFF>Floresta Apam</color> y <color=#00E1FFFF>Montaña Devantaka</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200331,
					"content": "#Muchas gracias. Nara rubi{F#a}{M#o}, eres deslumbrante como sol. Paimon también es más o menos genial. Gracias por ayudar a hermanita de Arachatora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200332,
					"content": "¡¿Por qué Paimon es “más o menos genial”?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200333,
					"content": "Ay, no hay que preocuparse por eso... En fin, Arachatora no sabe cómo pagar su ayuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200334,
					"content": "Arachatora ha decidido que dará a ustedes su receta para manjar supremo. Quizás guste más su sabor cuando sean mayores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200335,
					"content": "#({NICKNAME}, deja que Paimon modifique un poco la receta. ¡Debe haber una manera de convertirlo en un plato original y delicioso!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200314,
					"content": "Por lo menos no es venenoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "#No estoy acostumbrad{F#a}{M#o} a comer estas cosas a estas horas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
		{
			"id": 7302004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
