			"dialogs": [
				{
					"id": 742250201,
					"content": "#Gracias, {F#buena mujer}{M#buen hombre}. Gracias al rey divino, ¡por fin estoy a salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "¿Eres uno de esos soldados legionarios que se encargan de proteger la ciudad? ¿O simplemente eres un alma cándida que me he cruzado por el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "Seas quien seas, permíteme que me presente. Soy Fausto, un comerciante fronterizo bajo las órdenes del rey divino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "He venido para transportar especias desde las regiones del sur... No pensé que esos Dragartos me rodearían en cuanto puse el pie en la orilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "¿Dragartos? Yo no he visto ninguno por aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "#¿Eh? ¡Resulta que eres {F#una}{M#un} guerrer{F#a}{M#o} tan versad{F#a}{M#o} en el combate que ni siquiera te ha dado tiempo a apreciar a los enemigos que has derrotado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "Por favor, acepta esto. Me ahorraré las palabras de agradecimiento. Tengo que apresurarme a transportar estas mercancías a la ciudad. Quizá volvamos a vernos por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
