			"dialogs": [
				{
					"id": 750761201,
					"content": "#Por fin... Si no fuera por tu ayuda, {F#guerrera forastera}{M#guerrero forastero}, este lugar habría sido invadido por el enorme enemigo oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Manifestación Wayob débil"
				},
				{
					"id": 750761202,
					"content": "Hace mucho tiempo, los habitantes de esta tribu fueron engañados por la apariencia del enorme enemigo oscuro, por lo que muchas almas noctámbulas se vieron envueltas con el Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Manifestación Wayob débil"
				},
				{
					"id": 750761203,
					"content": "Incluso en la zona sellada, el poder de la manifestación de la noche se ha ido desgastando poco a poco... El sello aisló a este lugar del mundo exterior, pero también cortó la fuente de la fe de la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Manifestación Wayob débil"
				},
				{
					"id": 750761204,
					"content": "Solo rompiendo el sello había esperanza para luchar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Manifestación Wayob débil"
				},
				{
					"id": 750761205,
					"content": "#Gracias, guerrer{F#a}{M#o} foraster{F#a}{M#o}. Las almas noctámbulas pudieron encontrar el camino de regreso a la tierra de los sueños y el Reino de la Noche se ha salvado de la invasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Manifestación Wayob débil"
				},
				{
					"id": 750761206,
					"content": "Ah, al fin, podemos volver a la serenidad de la noche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manifestación Wayob débil"
				}
			]
		}
	]
}