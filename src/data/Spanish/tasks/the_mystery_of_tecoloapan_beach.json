			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sakau"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "La niebla del mar se ha vuelto cada vez más espesa... Ay... es realmente preocupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760404,
					"content": "¿Acaso esa leyenda es cierta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760405,
					"content": "¿Qué leyenda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "#Eh... Eso depende de la leyenda que quieras escuchar, foraster{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760407,
					"content": "Hay dos versiones sobre la isla flotante en el mar y la enorme pintada. Una es más parecida a una historia, y la otra es más parecida a una leyenda real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760402,
					"content": "#Guerrer{F#a}{M#o} foraster{F#a}{M#o}, ¿cuál te gustaría escuchar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760408,
					"content": "Quiero escuchar la historia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "De acuerdo. Las historias siempre suelen ser más conmovedoras, pues la isla envuelta en la niebla es parte de «La historia de Qoyllor y Ukuku».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760403,
					"content": "Cuenta la leyenda que la joven llamada Qoyllor, con el fin de comunicarse con su padre, el sol, dejó una enorme pintada en la playa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760410,
					"content": "Cuando su padre, el sol, vio la pintada desde el cielo, se llevó a su hija de la tierra mundana... Más o menos esa fue la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760417,
					"content": "Se dice que la perturbadora niebla era el castigo que el padre sol había impuesto a las tribus de la superficie, pues fueron estas las que le arrebataron el poder a su hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760415,
					"content": "*Suspira*, sea leyenda o historia, la niebla que se forma sobre el mar nunca es buena señal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760416,
					"content": "#{F#Guerrera forastera}{M#Guerrero forastero}, allí puede ser muy peligroso. Ten cuidado y no te acerques demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760411,
					"content": "Quiero escuchar la leyenda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Se dice que, hace mucho tiempo, un malvado brujo se disfrazó de Wayob para engañar a los guerreros de la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760413,
					"content": "Por lo que, después, los héroes de la tribu tuvieron que sellar al malvado mago oscuro dentro de la enorme pintada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760414,
					"content": "Dicen que la razón por la que en el mar hay niebla es un presagio de que el malvado mago romperá el sello y escapará para hacer el mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakau"
				}
			]
		},
