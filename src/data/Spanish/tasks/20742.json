					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420702,
					"content": "... ¿Ocurrió algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420703
					]
				},
				{
					"id": 207420703,
					"content": "¡Tú! Donna me lo contó todo. ¡Vio que mandaste a volar mis dientes de león!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420704
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420704,
					"content": "Lo siento, es que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420705
					]
				},
				{
					"id": 207420705,
					"content": "Donna me lo contó todo. Mandaste a volar mis dientes de león, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420706
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420706,
					"content": "¡Si tanto te hacían falta semillas de diente de león, podrías haberlas recogido afuera! ¡Yo estaba cuidando de estas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420707
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420707,
					"content": "#Además, ¡tú mism{F#a}{M#o} me ayudaste a recolectarlas! ¿Así es como las tratas?",
