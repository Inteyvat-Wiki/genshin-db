					"content": "... Hagamos esto: tú me ayudarás a encontrar más semillas de diente de león, y yo las sembraré de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
