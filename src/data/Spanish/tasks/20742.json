					"nextDialogs": [
						207420503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420503,
					"content": "Sí, toma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420504
					]
				},
				{
					"id": 207420504,
					"content": "Déjalas aquí, las pondré en una maceta más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420505,
					"content": "¡Pero nunca más la dejaré afuera!",
					"roleType": "TALK_ROLE_NPC",
