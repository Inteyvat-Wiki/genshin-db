	"talks": [
		{
			"id": 7280302,
			"completionStepIds": [
				7280304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280304",
							"2"
						],
						"stepId": 7280304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladrón de Tesoros sarcástico"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "¡Ladrones! ¡La deidad no me responde porque robaron todas mis ofrendas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030202,
					"content": "¿Ofrendas? ¿Te refieres a las cosas que estaban junto al altar? ¡No querríamos esas cosas ni de regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "Ladrón de Tesoros sarcástico"
				},
				{
					"id": 728030203,
					"content": "Además, si ofreces ese tipo de basura al altar, sería gracioso que la deidad te respondiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "Ladrón de Tesoros sarcástico"
				},
				{
					"id": 728030204,
					"content": "¡¿Qué dijiste?! ¡Mis ofrendas no son basura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030205,
					"content": "¡Olvídalo, no tenemos tiempo para jugar contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "Ladrón de Tesoros sarcástico"
				},
				{
					"id": 728030207,
					"content": "M-Mis ofrendas no son basura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030208,
					"content": "¿Puedes contarme tus deseos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "Bien... ya que las cosas resultaron así, supongo que mi deseo no se concederá de todos modos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030210,
					"content": "Mis dos deseos son simples. Mi primer deseo es que no quiero tomar más exámenes. Si no tengo que tomar exámenes, no me regañarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030211,
					"content": "Mi otro deseo es... que la bravucona de la escuela deje de acosarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030212,
					"content": "Tampoco me gustan los exámenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "¡Claro! Los exámenes son espantosos... Pero esa malvada me hace sentir aún más incómodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030216,
					"content": "Me vio muchas veces mientras pedía un deseo en el altar. Cuando me oyó decir que no quería hacer exámenes, fue a ver a mis profesores y les pidió mis resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030217,
					"content": "A partir de entonces, siempre me decía que era mejor emplear mi tiempo prestando atención en clase que rezando en un altar, y que si me obstinaba con mis deseos, hasta las deidades se impacientarían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030218,
					"content": "Incluso dijo que yo era realmente patético.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030219,
					"content": "No es bueno depender demasiado de las deidades.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "Pero cuando los adultos se enfrentan a dificultades, siempre hacen ofrendas en el altar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030221,
					"content": "Solo piden un deseo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "No lo entiendo... Pensé que todos daban ofrendas a los altares para pedir la ayuda de las deidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030224,
					"content": "Vamos a preguntar a alguien más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030225,
					"content": "De acuerdo. De todos modos, no me va a conceder los deseos ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030222,
					"content": "Al final, tienen que resolver sus problemas por sí mismos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "¿Bravucona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "Una persona de mi curso. ¡Es totalmente irracional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280304,
			"completionStepIds": [
				7280306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280306",
							"2"
						],
						"stepId": 7280306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "Hola, ¿hay algo en lo que pueda ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030402,
					"content": "Es sobre las ofrendas en el altar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "Los altares... También he ido allí unas cuantas veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030404,
					"content": "Quiero las bendiciones de las deidades para que, cuando crezca, pueda ir al mundo exterior y ver cómo es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030405,
					"content": "Sin embargo, al final del día, las ofrendas son solo una forma de oración. Aún tengo que trabajar duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030406,
					"content": "Mis padres me dijeron que si quería viajar, primero debía ganar suficiente dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030407,
					"content": "Sí, mientras tengas la bendición de las deidades, tus sueños se harán realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030408,
					"content": "No puedo asegurarlo. Después de todo, si realmente salgo al mundo exterior, no creo que las deidades de Inazuma puedan protegerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030409,
					"content": "Mis padres solían decir que al dar ofrendas a las deidades uno solo consigue algo de tranquilidad. El cumplimiento de tus deseos depende del esfuerzo que realices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030410,
					"content": "No puedo explicar las cosas realmente bien. Si quieres saber más, habla con Nanatsuki. Ella sabe bastante de estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030411,
					"content": "#Busquemos a Nanatsuki, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "¿Shouta? ¿Por qué pareces tan molesto? ¿Alguien te está molestando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030502,
					"content": "Nanatsuki, debes saber que todos los habitantes de la ciudad hacen ofrendas al altar para pedir la bendición de las deidades, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030503,
					"content": "Mientras pongamos el corazón en nuestras ofrendas y hagamos que las deidades tengan una razón para responder, entonces pueden conceder cualquier deseo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030504,
					"content": "¿Eh? ¿Por qué preguntas eso de repente? ¿Pasó algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030505,
					"content": "Es así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "Shouta, así que estabas tan emocionado por ir al altar por algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030508,
					"content": "¡Sí! Le di mis ofrendas a la Arconte de todo corazón. Sin embargo, alguien se las llevó... Pensé que ella me culparía y no me protegería más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030509,
					"content": "¡Tonterías! No te preocupes, ella no se enojará contigo por algo tan pequeño como eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030510,
					"content": "¿En serio? ¡Qué bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030511,
					"content": "Igualmente, la deidad probablemente no ayudará a alguien solo por las ofrendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030512,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030513,
					"content": "La razón por la que la gente da ofrendas y pide bendiciones no es que quiera que se le conceda su deseo, sino que las personas dan sus ofrendas para sentir más confianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030514,
					"content": "¿Confianza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030515,
					"content": "“Como ya le contamos nuestros deseos a la deidad, debemos esforzarnos para que esos deseos se hagan realidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030516,
					"content": "“La deidad ahora vela por nosotros, si nos esforzamos, seguro lo conseguiremos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030517,
					"content": "La gente está dispuesta a darlo todo para cumplir sus deseos con este tipo de confianza. Esa es la razón por la que todo el mundo hace ofrendas a los altares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030518,
					"content": "A fin de cuentas, las personas son las que mueven el mundo. Si rezamos a las deidades y no actuamos, incluso si una deidad quisiera ayudar, seguiría sin saber qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030519,
					"content": "Pero cuando, en el pasado, daba ofrendas al altar, la deidad siempre me ayudaba directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030520,
					"content": "Aquella vez con el fuego, aquel señor que quería hacerse más fuerte y aquel cómic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030521,
					"content": "(Sigue hablando de la deidad...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "Humm... Tienes razón. Parece que esa deidad cumple los deseos de forma directa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030524,
					"content": "Pero, pero... No solo no desaparecieron los exámenes, sino que esa bravucona sigue en la escuela. Todavía me regaña todos los días para que haga la tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030525,
					"content": "Humm, espera un minuto. ¿Cómo se llama la persona que te acosa? ¿Cuándo apareció?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030526,
					"content": "Ella... Ella... Se llama... ¿Cómo se llama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030527,
					"content": "Creo que entró a la escuela al mismo tiempo que yo... No, no, creo que un poco antes... ¿O fue después?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030528,
					"content": "Qué extraño... ¿Por qué no puedo recordar nada? Lo único que puedo recordar es una chica que me decía que estudie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030529,
					"content": "Humm, parece que la deidad respondió a tus deseos de nuevo y te está ayudando a conquistar tu aversión a los exámenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030530,
					"content": "Me estás diciendo que esa chica, la que me intimida todo el tiempo... ¿La deidad la envió para obligarme a estudiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030531,
					"content": "¡No! ¡No quiero estudiar, no quiero hacer más exámenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030532,
					"content": "*Solloza*, está aquí otra vez. Está justo ahí. ¡Viene del otro lado de la calle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030533,
					"content": "¿Dónde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "#¿No la ves, viajer{F#a}{M#o}? ¡Viene con una enorme pila de exámenes! ¡Buaaa! ¡No quiero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030536,
					"content": "Parece que la deidad es muy dedicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030537,
					"content": "La deidad actúa de formas misteriosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "Sin embargo, bajo la supervisión personal de esa deidad, ese niño debería ser capaz de superar los exámenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030540,
					"content": "Después de todo, supongo que incluso las deidades no pueden soportar sus constantes plegarias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030541,
					"content": "¿Eh? Espera... ¿Por qué hay hojas en el camino? No estaban aquí antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030538,
					"content": "No parece algo que haría una deidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "No puedo ver nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "(Están en frecuencias completamente diferentes...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}