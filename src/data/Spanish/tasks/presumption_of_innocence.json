				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "Jajaja, este es el trago que ansío todos los días...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "Pensé que habías dejado de beber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "¡Ah! Oh, me diste un susto... Pensé que eras mi esposa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "¡Uno al año no hace daño! Tuve una jornada pesada el día de hoy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "¡De acuerdo, tú ganas! Terminaré este y regresaré. De todos modos, Eury probablemente habrá terminado de hacer sus compras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 2002303,
			"completionStepIds": [
				2002304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
