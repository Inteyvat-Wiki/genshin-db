			"dialogs": [
				{
					"id": 200230901,
					"content": "¿Fuiste a verlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230902
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230902,
					"content": "Nimrod está tan sobrio como una monja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "... ¿De verdad? ¿Está sobrio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230904,
					"content": "Lamentablemente no hay evidencias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "Está bien. Mientras no encuentre evidencia de que beba, me contento con creer que es un hombre distinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Hasta que me demuestren lo contrario, siempre estaré dispuesta a creer en la inocencia de una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "Pero normalmente hay montañas de evidencias que prueban sus malas acciones... Es realmente cómico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230908,
					"content": "Toma esto como agradecimiento por las molestias. Espero no ver el día en que tengas algo de lo que arrepentirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		}
