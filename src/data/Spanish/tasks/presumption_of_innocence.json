			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "Me pregunto si finalmente se arrepentirá esta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230102,
					"content": "¿Arrepentirse de qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Mucha gente viene aquí todos los días para confesar sus pecados y buscar el perdón de los dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230104,
					"content": "Pero si solo hablas y no lo pones en práctica, ¿no crees que es una pérdida de tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230105,
					"content": "Mira a Nimrod, por ejemplo. Él ha venido aquí para confesar su abuso de alcohol en numerosas ocasiones, pero no ha cambiado en lo absoluto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230106,
					"content": "Si tienes tiempo, ¿podrías ir a ver cómo está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230107,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "Ah, y si está bebiendo de nuevo, por favor trae alguna evidencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230109,
					"content": "A veces, los delincuentes seriales necesitan una pequeña lección para ayudarles a corregir su camino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230110,
					"content": "¿Entonces, beber es pecado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Beber por sí solo no es pecado. Pero es pecaminoso beber hasta el punto de traer una angustia indebida a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230112,
					"content": "Si todos se comportaran tan despreocupadamente, tarde o temprano toda la ciudad de Mondstadt se encontraría en una situación muy angustiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230113,
					"content": "Entonces, cada vez que un pecado asoma su fea cabeza, necesita ser cortado de raíz. Así que, rápido, ve a ver a Nimrod por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
		{
			"id": 2002302,
			"completionStepIds": [
				2002302
			],
