			},
			"dialogs": [
				{
					"id": 200230301,
					"content": "¿Ocurre algo? ¿En qué puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230302,
					"content": "Cuéntame sobre Nimrod.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "Ha estado aquí bebiendo por horas. Mira, aquí está su cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230304,
					"content": "Si sigue así, tendremos que llamar a Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230305,
					"content": "¿Quieres tomarla prestada? Supongo que no hay nada de malo en eso, pero ¿de verdad la necesitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 2002304,
			"completionStepIds": [
				2002305
