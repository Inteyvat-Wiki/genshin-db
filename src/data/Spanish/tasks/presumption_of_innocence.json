				"points": []
			},
			"dialogs": [
				{
					"id": 200230401,
					"content": "¿Fuiste a verlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230402
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230402,
					"content": "Esta es la cuenta de Nimrod en la taberna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "¡Hum! Justo como pensaba, ha vuelto a las andadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230404,
					"content": "La gente olvida pronto su pasado, a menos que realmente hayan tenido que sufrir por ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230405,
					"content": "Toma esto como recompensa por todas las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230406,
					"content": "En cuanto a la venganza contra Nimrod... ya pensaré en algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
