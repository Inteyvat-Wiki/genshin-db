				{
					"id": 726920601,
					"content": "Jaja, dicen que surcar los cielos con total libertad como el viento es el sueño de todo habitante de Mondstadt. Este verso tiene todo el estilo de Lenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920602
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920602,
					"content": "Es una pena que de pequeño no me gustara salir para nada. Si por aquel entonces Ootomo hubiera estado conmigo, tal vez ahora tendría mi licencia de vuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
