			"dialogs": [
				{
					"id": 726920501,
					"content": "Ya que a Ootomo y a ti les gusta tanto, me quedo con este verso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920502,
					"content": "El poema de Lenne se complementa con las imágenes. Si lo lees mientras las contemplas, parece como si cobraran vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920503,
					"content": "Lo cierto es que yo también estoy trabajando en un poema últimamente y me gustaría que me ayudaras mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920504,
					"content": "¿Usted también necesita imágenes, Sr. Ootomo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "Jeje, lo descubrirás mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
