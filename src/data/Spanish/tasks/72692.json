				"points": []
			},
			"dialogs": [
				{
					"id": 726920101,
					"content": "Llegas justo a tiempo. Lenne y yo estamos componiendo un poema justo en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920102,
					"content": "¿Necesitan que les ayude a encontrar inspiración?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Jaja, has dado en el clavo. Llevo dos días intentando escribir un poema al estilo de Inazuma siguiendo las instrucciones de Ootomo, pero la cosa aún está un poco verde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920104,
					"content": "Siento como si conociera a Ootomo de toda la vida, así que estoy escribiendo un poema sobre la amistad. Hay un verso en el que me gustaría describir un paisaje con animales viajando en compañía mutua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920105,
					"content": "Puesto que estoy componiendo un poema al estilo de Inazuma, lo lógico es que piense en <color=#00E1FFFF>animales autóctonos de Inazuma</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920106,
					"content": "#Nosotr{F#as}{M#os} solemos ver muchos animales de Inazuma. Algunos corren, otros vuelan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920107,
					"content": "#Ya que los animales viven en la naturaleza, vamos a ver si vemos alguno por ahí, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920108,
					"content": "Bueno, entonces te lo dejo a ti. Ayúdame a capturar <color=#00E1FFFF>cuatro imágenes</color> de diferentes animales de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
