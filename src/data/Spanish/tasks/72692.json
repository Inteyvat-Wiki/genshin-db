				"points": []
			},
			"dialogs": [
				{
					"id": 726920201,
					"content": "¿Ya tienes todas las imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920202,
					"content": "Aquí tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "Déjame ver... Sí, muy bien. ¡Ahora sí me siento inspirado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920204,
					"content": "#Igual que la vez anterior, he escrito diferentes versos basándome en las imágenes que me diste. Deberías ser tú {F#la}{M#el} que elija el verso más adecuado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
