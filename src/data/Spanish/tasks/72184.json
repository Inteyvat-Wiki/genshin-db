						721840502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840502,
					"content": "Me pregunto a qué sabrá una pizza con ingredientes de Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840503,
					"content": "¡Listo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840504,
					"content": "Esta pizza... no está mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840505,
					"content": "#Gracias por tu ayuda, viajer{F#a}{M#o}. Toma, esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840506,
					"content": "Me aseguraré de probar qué tal sabe esta pizza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840507,
					"content": "Si sale bien, debería lanzarla como el nuevo producto oficial.",
					"roleType": "TALK_ROLE_NPC",
