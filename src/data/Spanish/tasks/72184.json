				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "#Viajer{F#a}{M#o}, regresaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "¿Y bien? ¿Le preguntaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "Sobre la opinión de los clientes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Pizza con calavanda... no es tan complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "La preparación de los demás ingredientes es la misma de siempre. Bien, ya que quieren incorporar ingredientes locales, eso les daré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Humm... ¿Hongos marinos? ¿Percibetormentas? ¿Qué tal hongos fluorescentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "¡Oh! Lo siento, ¡estaba pensando qué ingredientes agregar! Veamos, creo que no nos queda suficiente calavanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ayudarme a conseguir calavanda? En cuanto a ingredientes, debe ser lo único que falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Bien, cuento contigo. Una calavanda es más que suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "¿Necesitas otros ingredientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "Lo demás lo tenemos en existencia. Solo trae una calavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
