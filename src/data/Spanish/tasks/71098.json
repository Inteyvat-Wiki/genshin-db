					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980901,
					"content": "Comencemos, Lutong. Esta vez añadiremos un diez por ciento menos de cada ingrediente. Muy bien. Paso 1: empezar a cocinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980902
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980902,
					"content": "Sí, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980903
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980903,
					"content": "Primero, el agua. ¡Cuidado! Hay que medir la velocidad a la que se vierte el agua. Es de vital importancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980904
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980904,
					"content": "Después, los ingredientes. Primero se añaden los rábanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980905
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980905,
					"content": "Humm, esto se parece más a una clase de alquimia que a una de cocina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980906,
					"content": "¿Tú crees que así les saldrá bien el plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980907,
					"content": "¡Listo! ¡Una sopa vegetariana de rábano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980908
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980908,
					"content": "Hemos conseguido terminar sin grandes problemas, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980909,
					"content": "#Magnífico. Es hora de la degustación. Viajer{F#a}{M#o}, ¿nos harían el honor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980910
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980910,
					"content": "¡Yuju! ¡A comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980911,
					"content": "Gracias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980912
					]
				},
				{
					"id": 710980912,
					"content": "Humm, este plato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980913,
					"content": "... Señor, tal vez deberíamos cocinar los rábanos un poco más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980914
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980914,
					"content": "*Cof, cof*, ¡puaj! ¿Qué le ha pasado a la menta? Estoy seguro de que calculé correctamente el tiempo de cocción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980915,
						710980916
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980915,
					"content": "Creo que ya no hace falta que la pruebe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980917
					]
				},
				{
					"id": 710980917,
					"content": "*Cof, cof*, ¡el sabor es incluso peor que la última vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980918
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980918,
					"content": "Yo... *Cof, cof*, estoy totalmente de acuerdo con usted, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980919
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980919,
					"content": "*Cof*... Bueno. Paso 2: retroalimentación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980920
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980920,
					"content": "¡Por Los Siete! He debido olvidar incluir algún parámetro, o tal vez mis cálculos no hayan sido lo suficientemente precisos. Tengo que reajustar el algoritmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980921
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980921,
					"content": "Lutong, ¿has anotado ya todos los datos de esta prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980922
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980922,
					"content": "Sí, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980923
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980923,
					"content": "Magnífico, eso quiere decir que estamos un paso más cerca de lograrlo. Paso 3: pedirle al chef que vuelva a enseñarnos la técnica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980924,
						710980926
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980924,
					"content": "Humm, ¿por qué me miran así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980925
					]
				},
				{
					"id": 710980925,
					"content": "#Me temo que eres nuestra última esperanza, viajer{F#a}{M#o}. Yanxiao... hace tiempo que nos ignora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980926,
					"content": "¡Iré a buscar a Yanxiao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980927
					]
				},
				{
					"id": 710980927,
					"content": "Creo que ya ha hecho bastante por nosotros al permitirnos usar su cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980928
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980928,
					"content": "#Viajer{F#a}{M#o}, eres {F#la única}{M#el único} capaz de enseñarnos a cocinar una sopa vegetariana de rábano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980916,
					"content": "Creo que voy a esperar al siguiente intento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980917
					]
				}
			]
		},
