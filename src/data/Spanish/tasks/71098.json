				"points": []
			},
			"dialogs": [
				{
					"id": 710981501,
					"content": "El sabor no está nada mal. Aunque he de señalar que es completamente diferente al de la sopa de Yanxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981502
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981502,
					"content": "Disculpa mi curiosidad, pero... ¿Cómo lo haces? ¿Qué cantidad exacta de ingredientes introduces? ¿Qué tipo de condimentos usas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981503,
					"content": "¡Oye! ¡Respeta mi espacio vital!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "Ah, sí, discúlpame. De todas formas, me gustaría saber cómo preparaste este plato. Cuantos más detalles puedas darme, mejor. Uno nunca sabe cuándo le llegará la inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981506,
					"content": "Explicas en detalle cómo hacer una sopa vegetariana de rábano...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981508,
					"content": "*Suspira*, en cada plato intervienen demasiadas variables a tener en cuenta. Necesitaré hacer muchos cálculos para refinar el algoritmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981509,
					"content": "Además, tendré que mejorar la máquina contable para que sea capaz de procesar todos esos cálculos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981510,
					"content": "Espero que los documentos de la biblioteca de la Academia de Sumeru me sirvan de inspiración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981511,
					"content": "¿Por qué quieres crear una máquina así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Humm, una gran pregunta, la verdad. Antes de responderte, me gustaría hacerte una yo a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981513,
					"content": "¿Tú crees que la máquina contable es capaz de “pensar”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981514,
					"content": "¿Y eso qué significa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Precisamente. Por favor, piensa primero en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981517,
					"content": "Podemos responder a esas dos preguntas, la tuya y la mía, la próxima vez que nos veamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981518,
					"content": "Por el momento, tengo que organizar todos estos datos. ¡Vamos, Lutong, manos a la obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710981519,
					"content": "Sí, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981520,
					"content": "#Toma, llévate esto, viajer{F#a}{M#o}. Y no te enfades con el Sr. García. Él es así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981521,
					"content": "¿Irán a Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "Así es. El Sr. García quiere acceder a la biblioteca de la Academia y me ha contratado para que vaya con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981523,
					"content": "#Hasta la próxima, viajer{F#a}{M#o}. Ojalá tengamos la fortuna de volver a vernos en Sumeru. Estoy seguro de que al Sr. García también le gustaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981515,
					"content": "¿Tu máquina es capaz de “pensar”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "¿Te importaría no respirarme en la cara?",
					"roleType": "TALK_ROLE_PLAYER",
