			"dialogs": [
				{
					"id": 710980701,
					"content": "Hay que incluir este parámetro... Y este otro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980702
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980702,
					"content": "¿Sr. García?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980703
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980703,
					"content": "No, así no... Un poquito más. Espera, sí, así es... Fascinante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980704
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980704,
					"content": "Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980705
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980705,
					"content": "¿Eh? Lutong, mi querido Lutong, ¿has pedido ya el plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980706
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980706,
					"content": "Sí, señor, ya he pedido la sopa vegetariana de rábano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980707
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980707,
					"content": "Magnífico. Eres muy considerado, mi querido Lutong. Estoy convencido de que obtendremos la fórmula esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980708
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980708,
					"content": "Nada me gustaría más, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980709
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980709,
					"content": "¿Eh? ¿De qué están hablando? ¿Qué es eso de una fórmula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980710,
						710980712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980710,
					"content": "Yo tampoco lo entiendo muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "Entonces vamos a averiguarlo. A lo mejor están intentando crear algún tipo de plato nuevo. ¿Quién sabe? Tal vez incluso nos dejen probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980712,
					"content": "Iré a preguntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980713
					]
				},
				{
					"id": 710980713,
					"content": "¡Bien pensado! A lo mejor están intentando crear algún tipo de plato nuevo. ¿Quién sabe? Puede que incluso nos dejen probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
