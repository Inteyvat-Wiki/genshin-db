	"talks": [
		{
			"id": 7109801,
			"completionStepIds": [
				7109803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109803",
							"2"
						],
						"stepId": 7109803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Sr. García",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Señor, creo que merece la pena señalar que si contamos también el día de hoy, llevamos comiendo sopa vegetariana de rábano seis días seguidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Aunque pueda ir en detrimento de nuestro fondo monetario, creo que no deberíamos seguir ignorando el aguante de nuestro sistema digestivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "¡Tienes toda la razón del mundo, mi querido Lutong! Tan agudo como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980104,
					"content": "Lo más probable es que sea el lamentable estado de nuestros sistemas digestivos lo que nos impide juzgar adecuadamente la calidad de este plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980105,
					"content": "¡Creo que la situación requiere un mediador! Mi querido Lutong, es el momento de buscar un tercer participante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980106,
					"content": "Me halaga, señor, pero lo que pretendía decir era que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Disculpen, ¿qué están haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "#¡Jaja! Hemos encontrado a {F#nuestra mediadora}{M#nuestro mediador}... Y son en realidad dos. ¡Esto es formidable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980110,
					"content": "#¿Eh? ¿{F#Mediadora}{M#Mediador}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "#¿Te refieres a nosotr{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "#Precisamente. Permítanme preguntarles, ¿alguna vez han probado la sopa vegetariana de rábano? ¿Están familiarizad{F#a}{M#o}s con su sabor y su receta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980113,
					"content": "Señor, creo que es de recibo explicar primero el porqué de estas preguntas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#Oh, sí, ¡claro que lo estamos! ¡{NICKNAME} incluso sabe prepararla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, tal vez deberíamos enterarnos de qué va todo esto primero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Será mejor que sea yo el que explique el encargo... Si le parece bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Yo soy Lutong y este es mi jefe, el Sr. García. Viene de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "El Sr. García está desarrollando algo que él llama “máquina contable”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Para ser más específicos, es una herramienta que permitirá a la gente hacer todo tipo de cálculos. ¿Es eso correcto, señor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "Tan preciso como siempre, mi querido Lutong. Así es precisamente como funciona la máquina contable. Una respuesta cuando menos concisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980121,
					"content": "Sí, debemos ser concisos. El mecanismo es demasiado complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980122,
					"content": "¿Y qué tiene que ver esa cosa con la sopa vegetariana de rábano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Ah, esos detalles debería explicarlos mejor el Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "¿Cómo podría explicarlo de forma sencilla? ¡Oh, sí! Ya lo tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980125,
					"content": "#Humm... Empecemos por lo más básico. ¿Están familiarizad{F#as}{M#os} con las “fórmulas”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980126,
					"content": "¿“Fórmula”? A Paimon no le suena de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "A mí tampoco me suena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Bien, bueno, no pasa nada. Pueden considerar las fórmulas como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980129,
					"content": "... una ecuación que expresa la relación entre varias cantidades y que posee una utilidad general aplicable a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980130,
					"content": "¿Eh? ¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "Suena formidable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "Básicamente, queremos utilizar la máquina contable para crear una nueva receta de sopa vegetariana de rábano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "El Sr. García está convencido de que si conseguimos crear la fórmula adecuada, podremos convertir la receta de la sopa vegetariana de rábano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "... en un proceso estándar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980135,
					"content": "... en un proceso apto para tontos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Si se sigue el proceso al pie de la letra, cualquiera sería capaz de cocinar una deliciosa sopa vegetariana de rábano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "Suena muy complicado. ¿Y no sería mejor buscar a alguien que te enseñe a cocinarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Por desgracia, las artes culinarias dependen en gran medida del talento de la persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Fíjate en el Sr. García y en mí, por ejemplo. Carecemos de cualquier talento natural para la cocina, por lo que es poco probable que, ni con la ayuda del mejor chef de todo Teyvat, consiguiéramos completar la receta con un resultado medianamente aceptable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "De hecho, creo que Yanxiao tiene experiencia de primera mano en este asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "¿Así que lo que necesitan es ayuda calculando la fórmula?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Definitivamente, no. Nunca podría pedirte que llevaras a cabo una tarea de semejante dificultad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980145,
					"content": "Para ser más exactos, necesitamos que hagas de “tercera parte neutral”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980146,
					"content": "Siendo más claros aún, necesitamos que prueben la sopa vegetariana de rábano que prepare el Sr. García sirviéndose de la fórmula y nos den su opinión al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "#Entonces, quieren que seamos l{F#a}{M#o}s primer{F#a}{M#o}s en probar su comida, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Qué resumen tan simple, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "¡Sin problema! Paimon nunca ha probado la sopa vegetariana de rábano hecha a partir de una fórmula. ¡Deberíamos probarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "Bien, si estamos todos de acuerdo, podemos marchar hacia la cocina. Yanxiao nos ha permitido utilizarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Humm... Sr. García, ¿deberíamos seguir los pasos de la última prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "¿Eh? ¿Qué? Perdona, estaba distraído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980153,
					"content": "Tengo demasiados parámetros subversivos merodeando por la cabeza. En fin, sí, sigamos con nuestro proceso anterior de tres pasos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980143,
					"content": "Entonces, ¿quieren que les enseñe a cocinar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Humm, diría que tampoco se trata de eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 710980108,
					"content": "Sobre la “fórmula” de la sopa vegetariana de rábano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109804",
							"3"
						],
						"stepId": 7109804,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "No lo entiendo. ¿De verdad hay gente que no es capaz de preparar una sopa vegetariana de rábano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980302
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 710980302,
					"content": "Además, ¿cómo voy a saber la cantidad exacta y el momento preciso en que tengo que usar cada ingrediente de cada plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980303
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 710980303,
					"content": "Cocinar es más de poner los ingredientes en las cantidades que estimes oportunas y dejarte llevar. ¡Ningún chef se preocupa por esas nimiedades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980304
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 710980304,
					"content": "Si no fuera por todos los Moras que han pagado, ya habría ido a quejarme al jefe hace tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980305
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 710980305,
					"content": "¡Hum! No lo soporto. ¿Por qué siempre tengo que lidiar con gente así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
