			"dialogs": [
				{
					"id": 747020101,
					"content": "Vaya, últimamente han traído tantos peces que el acuario comienza a parecerse a un hábitat marino de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020102,
					"content": "#¡Jeje, ya somos un{F#a}{M#o}s auténtic{F#a}{M#o}s expert{F#a}{M#o}s en esto de la pesca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "#Parece que están muy orgullos{F#a}{M#o}s de su trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020104,
					"content": "¡Claro que sí! Pero detrás de esa satisfacción hay otro sentimiento... algo como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "¿Pena?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "¡Sí, eso es! Eso es lo que Paimon siente en el fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020109,
					"content": "Paimon no está segura... Es solo que siente que falta algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "¿Quizás un restaurante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "¡Eh, no digas eso! ¡¿Quién podría comerse a estos peces tan hermosos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "¡Nos faltan visitantes que vengan a admirar nuestra increíble obra maestra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "¿Están diciendo que... quieren abrir el acuario al público?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020116,
					"content": "¿Acaso no te gustaría?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "¿Te preocupa que sea demasiado ruidoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "¡Si es así, déjalo todo en nuestras manos! Nos encargaremos de la publicidad y de todo lo del día a día, tú solo tendrás que concentrarte en tu trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "Si eso es lo que quieren...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020121,
					"content": "¡Podemos repartir las ganancias al 30% y 70% respectivamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "¿Eh?... ¿Solo nos llevaremos el 70%?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "No, Sandrone se llevaría el 70%.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Ah, sí, claro... Al fin y al cabo, es Sandrone quien alquila el barco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "¡Arg, hacen que parezca una casera tirana! Ya que ustedes harán el trabajo duro, quédense con el porcentaje más grande. No soy tan tacaña como Pantalone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020126,
					"content": "Entonces, ¿eso significa... que nos das luz verde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Claro, tienen mi bendición. Solo asegúrense de que no interfiera con mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020128,
					"content": "¡Yupi! ¡El Acuario Vingalet-Gluglú queda oficialmente abierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "*Suspira*, así que ya habías elegido un nombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020118,
					"content": "¿Te preocupa que cause demasiados problemas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "¿Visitantes quizás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "¡Oh! ¡Eso es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "¿Soledad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}