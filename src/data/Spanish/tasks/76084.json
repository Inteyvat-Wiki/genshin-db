			"dialogs": [
				{
					"id": 760840101,
					"content": "¿Ya llegaron? Hoy las kuuhenki están tocando la lira otra vez. ¿Podrían tocar algo para ellas, igual que la otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760840102,
					"content": "De hecho, a mí también me gustaría escuchar algo diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760840103,
					"content": "(¿Qué debería tocar?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7608402,
