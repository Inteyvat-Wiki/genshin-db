			},
			"dialogs": [
				{
					"id": 760840201,
					"content": "Tocaré la canción que Colombina suele cantar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "Tocaré la canción que Colombina suele cantar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(¿Qué tipo de emoción quiero evocar?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Probemos con una melodía serena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Qué hermoso. No sabía que habías memorizado la melodía que suelo tararear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490605,
					"content": "Jeje, bueno, como cantas tan bien, a veces nos quedamos a un lado y te escuchamos en silencio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Las kuuhenki se han quedado encantadas con la música, aunque no sé si se la habrán aprendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490607,
					"content": "Tal vez tendrán que venir más veces para enseñársela en un futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490608,
					"content": "Ven, dame la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490609,
					"content": "¿Eh? Pero si era una actuación gratuita, ¡no hace falta que nos pagues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "¿Eh? ¿Pagar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490611,
					"content": "Tan solo he pensado que, como era una melodía tan hermosa, la bella luz de la luna sería un buen acompañamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490701,
					"content": "Probemos con algo alegre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "¿Ya terminaste? Podría seguir escuchándola todo el tiempo del mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490703,
					"content": "Como te dije, esa es la única canción de cuna que recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490704,
					"content": "Aunque aún no he logrado descifrar su significado, tras escucharte tocarla, no puedo evitar pensar que la respuesta que me espera en la luna será, al menos, hermosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490705,
					"content": "Ven, dame la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490706,
					"content": "No necesitas darnos nada a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "No es eso, tan solo quiero adornar la melodía con un haz de la bella luz de la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
