			"dialogs": [
				{
					"id": 401960201,
					"content": "¡Parece que esta playa se ha vuelto muy animada en los últimos días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960202,
					"content": "(Sí, tal vez también se deba a que hay muchos agentes vestidos de civiles.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960203
					]
				},
				{
					"id": 401960203,
					"content": "#{NICKNAME}, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960204,
					"content": "*Ejem*, Paimon tiene un poco de hambre. ¿Por qué no vamos al restaurante a echarle un vistazo a la carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960205,
					"content": "(Esta persona que trae la caja debería ser el tipo que viene a realizar la transacción.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960206
					]
				},
				{
					"id": 401960206,
					"content": "#(Bien, es hora de ponernos seri{F#a}{M#o}s.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960207
					]
				},
				{
					"id": 401960207,
					"content": "Maldición, ¡cómo te atreves a arrastrarme así! ¡Esto es un acto de desprecio a la vida! ¡Pienso denunciarte ante el tribunal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960208
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960208,
					"content": "¿Ah, sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960209
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960209,
					"content": "Y yo que pensaba que sacarte de la vista del “público” era hacerle un favor a tu reputación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960210
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960210,
					"content": "Pero tú mismo puedes elegir si quieres caminar con la cabeza gacha o bien alta a partir de ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960211
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960211,
					"content": "¡¿Cómo te...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960212
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960213
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960213,
					"content": "Está bien, lo admito, ha sido culpa mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960214
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960214,
					"content": "*Suspira*... Sé perfectamente lo que está bien y lo que no, pero no me quedaba otra alternativa. Realmente necesito el dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960215
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960215,
					"content": "Antes era un investigador de ruinas antiguas con una familia feliz y un gran trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960216
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960216,
					"content": "¿Quién iba a imaginar que embaucarían a mi hijo y acabaría metido de lleno en la trampa de las apuestas?... Antes teníamos nuestros ahorros, pero acabaron yéndose por el desagüe como si los arrastrara la corriente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960217
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960217,
					"content": "Debido a sus deudas, los acreedores lo amenazaban constantemente, y yo, como su padre, no podía verlo sufrir de esa manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960218
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960218,
					"content": "*Suspira*, mi hijo tiene tu misma edad... Tan solo quiero que pueda crecer así de fuerte y sano... ¡Por eso necesito el Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960219
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960220
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960220,
					"content": "T-tienes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960221
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960221,
					"content": "Tienes que ayudarme, muchacho, ¡por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960222
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960222,
					"content": "Ambos somos compatriotas de Natlan... ¡Ten piedad de mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960223
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960223,
					"content": "Si regreso, aún podré enderezar a ese hijo mío. Pero si me arrestan, ¡estoy seguro de que seguirá por el mal camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960224
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960224,
					"content": "La familia debe permanecer unida para luchar por un futuro mejor, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960225
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960225,
					"content": "El destino de nuestra familia queda en sus manos... ¡Por favor, ten piedad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960226
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960227
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960227,
					"content": "Jaja, Kinich, ¿qué pasa? ¿Te ha comido la lengua el gato? ¿Acaso te ha ablandado el corazón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960228
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 401960228,
					"content": "Hum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960229
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960229,
					"content": "No me creo ni una sola palabra de lo que dices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960230
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960230,
					"content": "Parece que Wriothesley no iba muy desencaminado. Eres un ludópata empedernido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960231
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960231,
					"content": "¿Yo, un ludópata? ¿Qué estás diciendo? Yo te estaba hablando de mi hijo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960232
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960232,
					"content": "En primer lugar, ¿de verdad eres de Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960233
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960233,
					"content": "Pensaba que reconocerías al menos algún rostro conocido si realmente habías estado siguiendo la pista de la pistola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960234
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960234,
					"content": "Además, cuando hablaste de denunciarme ante el tribunal, lo dijiste con demasiada naturalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960235
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960235,
					"content": "¿Cómo? ¿Y te basas solo en eso para...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960236
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960236,
					"content": "¡P-puedo explicarlo! E-en realidad, crecí en...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960237
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960237,
					"content": "*Tch*, no quiero escuchar ni una palabra más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960238
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960238,
					"content": "Esta es tu oportunidad, Ahau. Cállale la boca a alguien por una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960239
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960239,
					"content": "¡Jajaja! ¡No sabes cuánto tiempo llevaba esperando este momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960240
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 401960240,
					"content": "¡Viejo sinvergüenza, te vas a enterar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960241
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 401960241,
					"content": "Una de las características de los adictos al juego es que mienten más que hablan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960242
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960242,
					"content": "Diría que eres un ciudadano de Fontaine que se ha estado haciendo pasar por alguien de Natlan. No creo que tengas familia o amigos o, si los tuviste, te abandonaron hace tiempo por tu actitud deshonrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960243
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960243,
					"content": "Aunque, claro está, también podría estar equivocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960244
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960244,
					"content": "Pero ¿acaso importa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960245
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960245,
					"content": "Mi única responsabilidad era capturarte, no soy ni tu representante legal ni tampoco tu confidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960246
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960246,
					"content": "Además, descubrir la verdad es el deber de tu querido tribunal, ¿o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960247
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960247,
					"content": "Así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960248
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960248,
					"content": "Cuánto tiempo, Sr. Kinich. La Unidad Especial de Seguridad y Vigilancia se encargará de este criminal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960249
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960249,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960250
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960250,
					"content": "No hay de qué. Gracias a usted por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960251
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960251,
					"content": "¿Y qué hay de mí, eh? ¡Qué poca cortesía! ¿Es que el todopoderoso Señor de los Dragones no es merecedor de tu sincero agradecimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960252
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 401960252,
					"content": "Está bien. Les doy las gracias también al Sr. Cacucu y a usted por su gran actuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960253
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960253,
					"content": "¿Eh? ¿Cómo que...? Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960254
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 401960254,
					"content": "¿Te encuentras bien, Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960255
					]
				},
				{
					"id": 401960255,
					"content": "#Puedes estar tranquil{F#a}{M#o}, no es a mí a quien han arrastrado hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960256
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960256,
					"content": "Me dio la sensación de que no estabas muy contento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960257
					]
				},
				{
					"id": 401960257,
					"content": "Pfff... ¿Acaso el pequeño Kinich estaba acordándose de cuando era un mini-Kinich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960258
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 401960258,
					"content": "¡Ni se te ocurra ponerte a llorar! ¡El todopoderoso Señor de los Dragones no puede permitirse tener un esclavo tan debilucho! ¡Qué deshonra para mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960259
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 401960259,
					"content": "¿De qué estás hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960260
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960260,
					"content": "Ahau, malo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960261
					]
				},
				{
					"id": 401960261,
					"content": "No tengo nada que ocultar. Simplemente, detesto a la gente adicta a las apuestas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960262
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960262,
					"content": "No tienen ningún sentido de la responsabilidad, ni respetan el principio de dar para recibir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960263
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960263,
					"content": "Son capaces de contar un sinfín de mentiras por una simple moneda, y luego intentan apostarla para hacerse ricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960264
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960264,
					"content": "Pero todos sabemos muy bien que todo lo que se obtiene sin ningún coste siempre trae consigo un precio oculto inimaginable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960265
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960265,
					"content": "En el pasado, yo también acabé pagando el precio de las apuestas de mi padre. Si es posible, me gustaría evitar que otros se encuentren en la misma situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960266
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960266,
					"content": "Kinich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960267
					]
				},
				{
					"id": 401960267,
					"content": "No estés triste por mí, ni siquiera yo me siento de esa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960268
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960268,
					"content": "Dicen que el pasado moldea a las personas y, si yo he logrado llegar hasta aquí, eso quiere decir que he hecho muchas cosas bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960269
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960269,
					"content": "Uno nunca debe culparse a uno mismo por los errores de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960270
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960270,
					"content": "Yo prefiero recordar aquellos momentos que me han hecho crecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960271
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960271,
					"content": "Como la primera vez que aprendí a usar el gancho de agarre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960272
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960272,
					"content": "O la primera vez que anhelé el conocimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960273
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960273,
					"content": "Entiendo lo que dices.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960274
					]
				},
				{
					"id": 401960274,
					"content": "Sí, te creo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960275
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960275,
					"content": "Vamos. Si no regresamos, la gente empezará a preocuparse sin necesidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				}
			]
		},
