			"dialogs": [
				{
					"id": 401960101,
					"content": "¡Hola! No llegamos tarde, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960102,
					"content": "No, llegan justo a tiempo. ¿Han descansado bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960103,
					"content": "#Mantenerme ocupad{F#a}{M#o} me mantiene llen{F#a}{M#o} de energía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "Ciertamente, es una buena forma de mantenerse con energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960105,
					"content": "¿Ya están preparándolo todo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "Ayer recibí la información del Sr. Argenteau confirmando la ubicación y la hora de la transacción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960107,
					"content": "Se llevará a cabo esta tarde en un lugar que todos conocemos bien: el restaurante del parque kinográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960108,
					"content": "¿Eh? ¡Parece que está obsesionado con ese lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960109,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#Parece que compartes nuestra misma preocupación, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960111,
					"content": "Sí. Un lugar tan concurrido como el lugar de celebración de un evento dificultará la operación de captura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960112,
					"content": "El culpable podría perderse entre la multitud o incluso usar rehenes para darse a la fuga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960113,
					"content": "Por ese mismo motivo, debemos estar aún mejor preparados. Así que, desde que recibimos el aviso ayer, hemos estado planificando el trabajo de la Gendarmería Fantasmal y la Unidad Especial de Seguridad y Vigilancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960114,
					"content": "Así es. Habrá muchos agentes de incógnito en la escena. Si la situación se descontrola, nuestra prioridad será garantizar la seguridad de los civiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960115,
					"content": "Aunque espero que todo vaya viento en popa, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960116,
					"content": "Bueno, muchos de los participantes son caras conocidas del anterior caso, como la capitana de la Unidad Especial de Seguridad y Vigilancia, la Srta. Chevreuse. Por eso me mantengo optimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960117,
					"content": "Esperemos que las palabras de este gran héroe de Natlan sean un buen augurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960118,
					"content": "Por cierto, la Srta. Lépine-Pauline y la Srta. Navia ya han sido informadas de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960119,
					"content": "Spina di Rosula prestará su apoyo dentro de la zona de control, así que no se preocupen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960120,
					"content": "El único problema... puede ser la Srta. Escoffier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960121,
					"content": "¿No quiere servir comida a criminales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "¿Quiere darles a probar su tenedor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "Jaja, ojalá fuera solo eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960124,
					"content": "Oh, pues eso no sería una mala idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960125,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960126,
					"content": "Bueno, dejémonos de bromas. La Srta. Escoffier dijo que no quería que su restaurante sufriera daño alguno por culpa de nuestra operación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960127,
					"content": "El caso es que... jaja... tengo el presentimiento de que las cosas no irán tan bien como espera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960128,
					"content": "¿Necesitan mi ayuda con algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "En realidad, este asunto no tiene nada que ver contigo y creo que ya te hemos causado suficientes problemas. Las autoridades de Fontaine deberían ser capaces de encargarse del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960130,
					"content": "Pero imagino que sientes curiosidad por saber cómo acabará todo esto, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960131,
					"content": "Qué bien me conoces.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "Humm, entonces podrías dirigirte al lugar del encuentro y actuar como lo consideres pertinente. Tal vez tu participación no sea necesaria, pero tu presencia podría resultar de utilidad llegado el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960133,
					"content": "Yo haré todo lo posible para que las cosas no lleguen a tal extremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960134,
					"content": "¿Tú también irás, Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960136,
					"content": "Quedan muchas dudas que resolver, pero la información de la que disponemos parece indicar que el culpable viene de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960137,
					"content": "Además, soy testigo del crimen. No puedo quedarme de brazos cruzados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960138,
					"content": "¡Una decisión muy propia de ti, Kinich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960139,
					"content": "Siguen hablando sobre los detalles y otros asuntos de importancia de la operación.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "Bueno, basta de cháchara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960143,
					"content": "Llevaremos a cabo la operación por la tarde. Si acabamos pronto, podremos tomar una taza de té antes de salir y todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960144,
					"content": "#Eso, {NICKNAME}, ¿por qué no vamos a comer algo nosotr{F#a}{M#o}s también? ¡Con el estómago lleno se trabaja mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960145,
					"content": "Pero si tú solo vas a mirar, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "¡Hacer compañía también es una tarea importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960147,
					"content": "Yo me adelantaré e iré ya al lugar del evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960148,
					"content": "Ahau no ha parado de molestar estos días con que quiere probar el menú exclusivo del evento, así que será mejor que quede satisfecho cuanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960149,
					"content": "Bueno, nos vemos luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960150,
					"content": "Sí, esperaré sus buenas noticias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
