			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pahsiv"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#¡Paimon, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930102,
					"content": "¡Guau, pero si es Pahsiv! ¡Qué alegría verte! ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930103,
					"content": "Pahsiv... ¡trabajar! Pahsiv... ¡cansada! Pahsiv... ¡tumbarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930104,
					"content": "¿Eh? ¿Dices que estabas trabajando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930105,
					"content": "Ramas silvícolas... ramas silvícolas... ¡muy perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930106,
					"content": "¿Ramas silvícolas? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930107,
					"content": "Ramas silvícolas... ¡Información!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930108,
					"content": "Sauce llorón, coleccionar. Senda caliginosa, tratar. Manantial, enviar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930109,
					"content": "Ramas silvícolas... ¡Información de senda caliginosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930110,
					"content": "¿Te refieres a alguna información sobre la Senda Silvícola Caliginosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930112,
					"content": "Ramas silvícolas... ¡muy perder! ¡Muy muchos lugares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930113,
					"content": "Pahsiv... ¡buscar! Pahsiv... ¡cansada! Pahsiv... ¡comer! Pahsiv... ¡tumbarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930114,
					"content": "Ramas silvícolas... ¡no muy muchas! ¡Pero cofres muy muchos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930115,
					"content": "#Ah... Gracias, Paimon, gracias, {NICKNAME}, ¡tomar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930116,
					"content": "¿Nos encontraste otro cofre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "¡Pahsiv! Cofre, tesoro, flores, brillante, dulce, ¡muy mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930118,
					"content": "Guau, ¿encontraste todas esas cosas? Qué buena eres, Pahsiv. Nos da un poco de vergüenza aceptar estas cosas como si nada, ¡pero podemos hacer un intercambio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930119,
					"content": "¿Inter... cambio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930120,
					"content": "#Claro, somos amig{F#a}{M#o}s, ¡y {F#las amigas}{M#los amigos} intercambian la bondad con más bondad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930121,
					"content": "Así que te ayudaremos a buscar esas ramas silvícolas y te las cambiaremos por otras cosas. ¿Te parece bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930122,
					"content": "También podemos darte comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "Cierto, debe de ser muy duro para Pahsiv estar sola por aquí, así que le ayudaremos a encontrar comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930124,
					"content": "¡Comida! ¡Marealgas! ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930125,
					"content": "¿Te gusta comer marealgas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "¡Marealga! ¡Marealga! ¡Marealga, marealga, marealga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930127,
					"content": "¿Comes marealgas cinco veces al día? ¿O comes cinco marealgas en cada comida? Sea como sea... guau, ¡a Paimon le pareces que hasta comes más que ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930128,
					"content": "¿Y qué hay de las ramas silvícolas, Pahsiv? ¿Las encontraremos en la Senda Silvícola Caliginosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930129,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930130,
					"content": "Ramas silvícolas... ¡muy perder! ¡Muy muchos lugares! ¡Muy Erinias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930131,
					"content": "¿Las ramas silvícolas están por toda Erinias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#¡Inteligente {NICKNAME}! ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930133,
					"content": "Senda caliginosa, haber flores, ramas silvícolas, ¡y también flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930134,
					"content": "Ramas silvícolas... ramas silvícolas... ramas silvícolas... ramas silvícolas... ramas silvícolas... ramas silvícolas... ¡cantidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930135,
					"content": "Aaaah, ¡Paimon ya lo entendió! En los lugares donde hay ramas silvícolas crecen unas flores iguales que las de la Senda Silvícola Caliginosa, y en total hay seis lugares, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930136,
					"content": "¡Inteligente Paimon! ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930137,
					"content": "Jeje, ahora sí lo entendemos. Bueno, Pahsiv, ¡tú descansa y deja esto en nuestras manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930138,
					"content": "#Paimon, {NICKNAME}, ¡cosas buenas! Así que cuidado... ¡cuidado! ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
		},
