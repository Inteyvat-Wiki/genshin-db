				{
					"id": 741930503,
					"content": "¡Pahsiv... salir! ¡Pahsiv... buscar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930504
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930504,
					"content": "No importa si no tienes nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930505
					]
				},
				{
					"id": 741930505,
					"content": "¡Sí! ¡Podemos darte directamente marealgas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930506,
					"content": "¡Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930507
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930507,
					"content": "#Paimon, amiga... ¡buena! {NICKNAME}, amig{F#a}{M#o}... ¡bueno! Así que... ¡intercambiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930508
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930508,
					"content": "Oh, está bien. ¿Cuánto tiempo estarás fuera, Pahsiv? No será esto un adiós, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930509,
					"content": "¿A... diós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930510
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930510,
					"content": "Sí, Paimon se pregunta si volveremos a vernos alguna vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930511,
					"content": "“Adiós” es una palabra que se usa para despedirse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930512
					]
				},
				{
					"id": 741930512,
					"content": "¡Cierto! Dijimos que te enseñaríamos a decir adiós. Pahsiv, ¿qué tal si lo intentas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930513,
					"content": "¿A... diós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930514
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930514,
					"content": "Oh, ¿no entiendes lo que significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930515,
					"content": "A ver cómo te lo puede explicar Paimon... Es algo así como un intercambio, como intercambiar un mañana por otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930516,
					"content": "#Si tú nos das un poquito de tu mañana y nosotr{F#a}{M#o}s te damos un poquito del nuestro, ¡podremos vernos otra vez! ¿Y bien? ¿Lo entiendes ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930517,
					"content": "Mañana... intercambiar... mañana... ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930518
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930518,
					"content": "#¡Guau! ¡Parece que lo has entendido! Entonces, nosotr{F#a}{M#o}s nos vamos despidiendo. ¡Nos vemos pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930519,
					"content": "¡Adiós, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930520,
					"content": "¡Adiós!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930521
					]
				},
				{
					"id": 741930521,
					"content": "#¡Adiós, {NICKNAME}! ¡Adiós, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
		}
	]
