			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "¡Regresaste! ¡Que eficiente! Ahora entiendo por qué le caes tan bien a ese señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180202,
					"content": "Sí, sí. Vamos, dame el dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "#Oh, qué direct{F#a}{M#o} eres. Toma el dinero. No gano mucho en mi trabajo, así que espero que sea suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180204,
					"content": "Gracias por tu amabilidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "De nada. Guárdalo bien, y espero colaborar más contigo en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Esos bandidos... ¡Sigan escondiéndose, y ya verán cuando averigüe dónde están!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180302,
					"content": "Yo sé dónde se esconden los Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "¿Tú? ¿Y se puede saber cómo...? ¿Eh? Las indicaciones en este mapa son realmente detalladas. ¿De dónde lo sacaste? Ah, ¿te lo dio Vile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180304,
					"content": "... Esto ni siquiera está cerca de la ubicación que habíamos establecido anteriormente. ¿Cuál es el objetivo de estos Ladrones de Tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180305,
					"content": "Disculpa, deja que lo grabe bien en mi memoria... Bien, ya lo tengo. Enviaremos a alguien inmediatamente a inspeccionar el lugar. Si lo que dices es verdad, iremos a expulsarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180306,
					"content": "¡Gracias de nuevo! ¡Gracias por tu ayuda a Mondstadt! ¡Esos Ladrones de Tesoros no escaparán esta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "¡Ya regresaste! ¡Guau, qué eficacia! Ahora entiendo por qué a ese señor le gusta encargarte estas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180402,
					"content": "Le informé de la situación a los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "¿A los Caballeros de...? ¡Oye! ¿No te dije que decírselo a los Caballeros de Favonius causaría muchos problemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180404,
					"content": "¡Cómo te gusta holgazanear! *Suspira*, menos mal que ese señor también me dijo que tal vez harías algo así. Por eso, ya tenía un plan B preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180405,
					"content": "No te preocupes, ya me encargo yo. Otra vez a hacer mandados... *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180406,
					"content": "Aunque, según ese señor, también eres capaz de hacer que las cosas tomen otra dirección interesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180407,
					"content": "Después de todo, sería demasiado descarado que fuera yo quien informara de los planes de los Ladrones de Tesoros, y, con su posición, ese señor no tiene mucha autoridad para dar órdenes a los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180408,
					"content": "Toma, acepta esto. Como diría ese señor, esta es tu recompensa por hacer que el viento haya cambiado de dirección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
