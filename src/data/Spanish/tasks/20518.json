				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180101,
					"content": "Nos volvemos a ver. ¿Y bien? ¿Cómo estás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180102
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180102,
					"content": "Ah, por cierto, Jilliana no está mal. Por lo menos no tuvo que irse de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180103
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180103,
					"content": "Lo malo es que se lo confesó todo a la hermana Victoria, aunque ella aún no ha hecho nada al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180104
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180104,
					"content": "Solo nos queda esperar para saber cómo acabará todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180105
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180105,
					"content": "¿Qué quieres hacer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180106
					]
				},
				{
					"id": 205180106,
					"content": "¿Eh? No me mires así, que no soy mala persona. Yo te indiqué con mi mejor intención el camino para ayudar a Jilliana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180107
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180107,
					"content": "Bueno, hablando en serio, vine a buscarte por un pequeño problema causado por el asunto de la otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180108
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180108,
					"content": "Para que lo entiendas, al expulsar a los Ladrones de Tesoros, también destapaste lo que ocurrió con Jilliana en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180109
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180109,
					"content": "Los Ladrones no serán blandos con los traidores. Por lo que sé, se ha visto el rastro de algunos de ellos alrededor de la ciudad, y no conocemos a ninguno de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180110
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180110,
					"content": "Me temo que buscan problemas con Jilliana y, de paso, vengarse de ella. Con una gente tan peligrosa, solo podemos confiar en ti para expulsarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180111,
						205180113,
						205180115
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180111,
					"content": "Esto es todo por tu culpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180112
					]
				},
				{
					"id": 205180112,
					"content": "*Suspira*, yo solo recibo órdenes. Si no fuera por la insistencia de ese señor, habrían querido que tú lo hicieras y yo no seguiría buscándote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180121,
					"content": "No te preocupes. Tengo preparada una buena recompensa para cuando regreses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180122
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180122,
					"content": "Esta vez ese señor me dio muchos Moras, no como la última vez, que fui yo quien tuvo que pagar... Ah, también señalé en tu mapa la ubicación de los Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180123
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180123,
					"content": "Dejando el dinero a un lado, te confío la tarea de proteger a Jilliana, a Rudolf, a Lily y a Mondstadt. ¡Ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180113,
					"content": "Encárgate tú de ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180114
					]
				},
				{
					"id": 205180114,
					"content": "¡No digas eso! Yo no soy tan fuerte como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180115,
					"content": "Esto es tarea de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180116
					]
				},
				{
					"id": 205180116,
					"content": "Eso es cierto. Pero según ese señor, en este caso, cuanta menos gente sepa lo de Jilliana, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180117
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180117,
					"content": "Además, ese señor tampoco quiere que los Caballeros de Favonius se metan en este asunto. Después de todo, están acostumbrados a hacer las cosas a lo grande y suelen pasarse de la raya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180118
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180118,
					"content": "Por ejemplo, si Huffman, que es una persona de fiar, se entera de que los Ladrones de Tesoros están merodeando por Mondstadt, seguro que se lo contará a los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180119
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180119,
					"content": "Si ellos actúan con todo su poder, los Ladrones de Tesoros se escabullirían, y todo el plan para expulsarlos habrá sido en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180120
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180120,
					"content": "#Así que no tengo más remedio que pedirte que luches por ti sol{F#a}{M#o} para resolver el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051802,
			"completionStepIds": [
				2051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
