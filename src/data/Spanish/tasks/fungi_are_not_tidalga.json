			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "Después de un rato, llegas junto a Paimon al puesto de La Champifiesta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "¡Hum! ¡Me encantan estos Hongos tan tiernos y blanditos! ¡Quiero seguir jugando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080103,
					"content": "¿Y tú eres...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "Soy Enghiene. ¡Solía ser la instructora de Turenna antes de que se uniera a la Unidad Especial de Seguridad y Vigilancia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080105,
					"content": "¡No soy como Turenna! ¡En absoluto! ¡No les tengo miedo solo porque sean seres con una capacidad combativa de nivel superior!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080106,
					"content": "¿Así que esta arrogante melusina... antes era la instructora de Turenna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080107,
					"content": "No se preocupen, Meteoro Dorado y Estrella Plateada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080108,
					"content": "Hace poco, enviaron a Turenna a otra misión y regresó a la base de la Unidad Especial de Seguridad y Vigilancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080109,
					"content": "Turenna llamó a Enghiene y le encargó ocuparse de mantener la seguridad donde se organiza el evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080110,
					"content": "A ella también le gusta mucho La Champifiesta y nos divertimos mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080111,
					"content": "Sí, ¡me encantan ese juego de mesa y esos Hongos redonditos en la vida real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080112,
					"content": "Esponjosos, suaves y tiernos, como las marealgas... Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080113,
					"content": "¿Por qué estás babeando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "¡No voy a comérmelos! No hay nada de malo en acariciarlos, ¿verdad? A Haniyyah no le importa que apriete un poquito a Chispitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080116,
					"content": "#Entonces, ¡solo puedes apretar a Chispitas! ¡A Cabezabombo solo lo pueden abrazar {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080117,
					"content": "¡No seas así! ¡Quiero achucharlos a todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080118,
					"content": "#Haniyyah dijo que ustedes son expert{F#as}{M#os} en este juego, ¿por qué no compiten conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080119,
					"content": "Si gano, ¡achucharé a Cabezabombo también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080120,
					"content": "¡Hum! ¡Nos está subestimando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080121,
					"content": "#¡{NICKNAME}! ¡Vamos, enseñémosle de qué están hech{F#a}{M#o}s l{F#a}{M#o}s expert{F#a}{M#o}s de La Champifiesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080122,
					"content": "#¡También somos l{F#a}{M#o}s primer{F#a}{M#o}s {F#campeonas}{M#campeones} del Torneo Loto Nilotpala!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "¡Sí, sí! No conseguimos esos sobrenombres tan imponentes por cualquier motivo. Es imposible que nos derroten tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080123,
					"content": "¡También somos las Estrellas de la sabiduría y el coraje!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "¡No puedes comerte a los compihongos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}