				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Miau miau, ¿cuándo se convirtió esa roca en la viva imagen de Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150102,
					"content": "¿Cómo está la estatua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "El humano de las piedras dice que pronto terminará de darle golpecitos a la roca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150104,
					"content": "Hibiki se pondrá tan contenta cuando vuelva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150105,
					"content": "Sí, la roca está bien, pero también debemos arreglar un poco los alrededores del santuario, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150106,
					"content": "Ayuda a Neko a colgar por el santuario estas bolitas de metal que tintinean, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150107,
					"content": "Las preparó Hibiki. Si la memoria de Neko no le falla, Domeki se las dio a Hibiki porque le encantaba jugar con Neko y los demás gatitos. A Neko le costó mucho encontrarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150108,
					"content": "¿Son... cascabeles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "¿“Cascabeles”? Neko no sabe qué es eso, pero Hibiki solía usar estas bolitas de metal para jugar con Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150110,
					"content": "Las ponía en el suelo y las lanzaba muy lejos. Entonces, tintineaban al moverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150111,
					"content": "Neko no entiende qué poder tienen, pero su sonido hacía que Neko y los demás gatos quisieran perseguirlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150112,
					"content": "Entonces, Neko se dio cuenta de que la razón por la que tan poca gente viene al santuario es porque no hay bolitas de metal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150113,
					"content": "Por eso, Neko necesita tu ayuda para colgar estas bolitas de metal en lugares altos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150114,
					"content": "Así, los humanos escucharán su tintineo, vendrán y no se perderán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150115,
					"content": "El baúl de ofrendas se llenará de Mora, el santuario prosperará y... Hibiki se pondrá muy contenta cuando vuelva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150116,
					"content": "Así que, por favor, ayuda a Neko a colgar estas bolitas de metal en el santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150117,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Gracias, miau miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221502,
