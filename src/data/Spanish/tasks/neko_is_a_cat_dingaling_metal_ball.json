			"dialogs": [
				{
					"id": 722150201,
					"content": "Estas bolitas de metal atraerán a más gente. Eso pondrá contenta a Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221503,
			"completionStepIds": [
				7221503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221503",
							"2"
						],
						"stepId": 7221503,
						"stateName": "QUEST_STATE_UNFINISHED"
