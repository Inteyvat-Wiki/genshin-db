			"dialogs": [
				{
					"id": 728070201,
					"content": "*Suspira*, qué dolor de cabeza... Hola, ¿deseas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070202,
					"content": "Sobre Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "¿Estás hablando del Maestro Kamaji? ¿Qué quieres con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Muestra la carta de Chisato)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "¿Dices que esta carta es de la Srta. Hiiragi Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Si esta carta es realmente de Hiiragi Chisato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Creo que... deberías hablar con el maestro Kamaji directamente. Últimamente, suele pasear cerca del puente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
