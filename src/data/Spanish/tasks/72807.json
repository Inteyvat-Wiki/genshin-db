			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070501,
					"content": "#Volviste, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070502,
					"content": "Supongo que entregaste mi carta a Kamaji... ¿También te las arreglaste para conseguir el salvoconducto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070503,
					"content": "Así es. Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070504
					]
				},
				{
					"id": 728070504,
					"content": "No tienes que agradecérmelo. Más bien deberías darle las gracias a Kamaji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070506
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070506,
					"content": "¿Eh? ¿Qué es esto? Golosinas y... ¿una carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070507
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070507,
					"content": "¿Te pidió que trajeras esto? ¿Son dango tricolor?... Los preparó para mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070508
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070508,
					"content": "#Gracias, viajer{F#a}{M#o}. Me aseguraré de saborear estas delicias. Esta carta... También la leeré detenidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070509
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070509,
					"content": "Por favor, acepta esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070510
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070510,
					"content": "Podría... necesitar tu ayuda de nuevo en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070505,
					"content": "Esto es de Kamaji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070506
					]
				}
			]
		},
		{
			"id": 7280706,
