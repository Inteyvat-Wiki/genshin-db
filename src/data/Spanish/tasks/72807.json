			"dialogs": [
				{
					"id": 728070401,
					"content": "#Bienvenid{F#a}{M#o} al restaurante Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070402,
					"content": "Sobre las golosinas de Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "Ya preparé las golosinas que pidió el Maestro Kamaji. Se las traeré ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070404,
					"content": "Aunque... quisiera saber a quién le dará el maestro Kamaji estas golosinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070405,
					"content": "No es más que un buen gesto de relaciones públicas, señorita Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070406,
					"content": "Hace un tiempo, el Sr. Hiiragi Shinsuke le regaló a mi padre un cargamento de té de gran calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070407,
					"content": "Mi padre sabe que a Chisato, la querida hija del señor Hiiragi, le gustan las golosinas. Así que me dijo que preparara algunas como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070408,
					"content": "#Me preocupaba que la entrega pudiera tardar demasiado, y también que hubiera algunos baches durante el viaje... Así que pedí específicamente que las entregara est{F#a}{M#e} viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070409,
					"content": "Señorita Kiminami, ¿puedo echar un vistazo a las golosinas, por favor? Quiero asegurarme de que no falte nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070410,
					"content": "Claro, aquí están. Puede revisarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070411,
					"content": "Está todo. Gracias, señorita Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070412,
					"content": "#Acompáñame, viajer{F#a}{M#o}. Tengo algo que decirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070413,
					"content": "Aquí tienes el salvoconducto. Toma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070414,
					"content": "Con este salvoconducto, puedes entrar y salir libremente de Ritou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070415,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "No hay de qué. Este permiso hará la entrega mucho más sencilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070417,
					"content": "Ah, y aquí está la carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070418,
					"content": "¿La escribiste tú mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "Sí. Intenté escribirla con... tacto. Espero no ofender a la Srta. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070420,
					"content": "Llévale esta carta y las golosinas a la Srta. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070421,
					"content": "Otra vez para allá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "Jeje, esta vez tienes el salvoconducto. Deberías tener mucha más libertad que antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070423,
					"content": "#Pues muchas gracias, viajer{F#a}{M#o}. Yo debo regresar para ocuparme de algunos asuntos oficiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070424,
					"content": "¿Cuándo podré ir yo también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				}
			]
		},
