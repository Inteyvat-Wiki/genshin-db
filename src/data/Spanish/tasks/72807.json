				"objectNames": [
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "#¿Eres...? Ah, eres es{F#a}{M#e} viajer{F#a}{M#o} del extranjero. ¿Qué puedo hacer por ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "Tengo una carta de Hiiragi Chisato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "¿La Srta. Hiiragi te pidió que me entregaras esta carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "Esta letra... De verdad es de ella... Gracias a Los Siete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "#Gracias por venir hasta aquí, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "En cuanto al salvoconducto... Como es una petición personal de la Srta. Hiiragi, naturalmente me encargaré de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Sin embargo, necesitaré un tiempo para prepararme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "¿Qué te parece esperarme en el restaurante Kiminami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "¿Por qué quieres ir allí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Bueno... Necesito que me hagas un pequeño favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Hace poco también estuve pensando en enviar algo a la Srta. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "Escribí una carta y también le pedí a la señorita Kiminami que me preparara unas golosinas. Pensaba mandárselo todo a la Srta. Hiiragi como regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "Pero si mi padre se entera de mis planes, podría molestarse... Apareciste justo cuando estaba pensando qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "Es solo un regalo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Mi padre no quiere que me comunique con la Srta. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Entiendo sus preocupaciones. Después de todo, soy un miembro del clan Kujou y uno de los funcionarios de la Comisión Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "La Srta. Hiiragi es la joven dama del clan Hiiragi de la Comisión Kanjou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Si me acerco demasiado a ella, alguien seguramente se aprovechará de nuestra situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Aunque solo sea un regalo, a los ojos de algunas personas es mucho más que eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Jeje. No hablemos de estos asuntos triviales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "#Viajer{F#a}{M#o}, por favor, espérame en el Restaurante Kiminami. Cuando tenga aprobado el salvoconducto, te lo llevaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "¿Tu padre es muy estricto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Mi padre... Sí, es muy estricto. Entiendo por qué no quiere que me comunique con la Srta. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070322,
					"content": "Después de todo, soy miembro del clan Kujou y uno de los ejecutores de la Comisión Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070323,
					"content": "La Srta. Hiiragi es la joven dama del clan Hiiragi de la Comisión Kanjou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070324,
