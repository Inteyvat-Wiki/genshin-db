				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "¿Eh? ¿Por qué aquí hay un Daguerrotipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "“Noticia que sigue, Daguerrotipo que persigue”. ¿Nunca han escuchado esta frase?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "Creo que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Me la acabo de inventar, ¿dónde la has escuchado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "Ay, tal y como pensaba, no hay nada nuevo en este mundo. Da igual lo que digas y lo que escribas, son meras interpretaciones de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "El Daguerrotipo ya está presente, ¿dónde está la noticia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "La noticia... es como la pesca. Tienes que esperar con paciencia y tomar la decisión adecuada en el momento perfecto para poder pescar un pez grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "Ah, no, es pescar una gran noticia. Espera, tampoco. Bah, ¡déjalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "Suena poco profesional, no eres una periodista de verdad, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Pues te equivocas, sí que lo soy, pero amateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "Hablando de que eres una periodista amateur, ¿qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "Estoy completando una tarea que me ha encomendado mi maestro: ¡capturar con el Daguerrotipo cómo trabajan los celadores del Fuerte Merópide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "Pero me costó mucho tiempo preparar el papeleo para entrar. Miren y lo sabrán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "Nelly saca un montón de documentos donde hay todo tipo de reglamentos y firmas. Nada más ojearlos, la cabeza te da vueltas...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Hasta que termine con todo el procedimiento, los celadores ya habrán salido del trabajo. En el mundo de la pesca, diríamos que no hay pez que esté nadando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "¿Eh? ¿Pero no hay celadores por todos lados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "Es que yo quiero pescar a los mecarreparadores dorados de coleccionismo, los de función básica y purificaaguas son demasiados comunes. Aunque llegue a entregar los deberes, a mi maestro no le va a sorprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Si no quieres volver con las manos vacías, será mejor que las tomes ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Tienes razón, no debería sobreestimar mis habilidades y pensar que podría pescar peces que están fuera de mi alcance. *Snif*, no soy una pescadora calificada... Digo, periodista amateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Bueno, fuera pesimismo. Tengo que ser optimista. Si les favorece, ¿me podrían ayudar con algo? ¡Se lo ruego! ¡Tendrán una recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Eso fue rápido, ¿no crees? Bueno, depende de lo que necesites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "Ese celador de allí se llama Grainville. Según mis observaciones, una noticia de él es igual de impactante que el mecarreparador de control entre los mecapeces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "Si le toman imágenes, podría ser capaz de escribir un buen reporte sobre él y entonces mi maestro quedará satisfecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "¡Pero el caso es que no se pasa por aquí! ¿Podrían llevarlo a una zona que esté al alcance del Daguerrotipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "¿Por qué no le cuentas la situación y le pides que venga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "En ese caso, si viene sabiendo del Daguerrotipo, hará su trabajo de forma rígida y entonces las imágenes quedarían poco naturales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Déjame que piense. Lo mejor sería esto, apaguemos el altavoz y le decimos a Grainville que se ha estropeado y que tiene que venir a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "Así seguro que puedo capturar una imagen perfecta de un celador del Fuerte Merópide trabajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "Que pueda entregar mis deberes o no, ¡depende de ustedes! Ayúdenme, ¡por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#Parece fácil, {NICKNAME}. Paimon cree que podemos ayudarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "¿Y si vas con el Daguerrotipo a dónde está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Ay, es que aquí las vistas son mejores. Además, si ve el Daguerrotipo, le prestará mucha atención, y saldrá con unas posturas muy rígidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Pues sigue esperando. Yo me voy ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "¿Ya? ¿Ahora mismo? ¿No me van a ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "#Ehmm... Pero nosotr{F#as}{M#os} tampoco sabemos dónde pescar los mecarreparadores dorados de coleccionismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Olvidémonos de las noticias, a mí también me gusta pescar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "¿En serio? Pues qué bien. En realidad soy una pescadora principiante y tenía unas dudas. Por ejemplo, si llegaras a pescar un mecarreparador y este te quiere morder, ¿qué harías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Dejaría que vuelva al mar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "Ah, ya veo. Me sirve para tomarlo en cuenta, anotado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "¡Pero bueno! ¿Por qué estamos hablando de pesca? Qué bien se les da introducir un tema, ay... Siendo una periodista amateur, me queda mucho por aprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "¡Pero si has sido tú quien ha empezado con el tema de la pesca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "Le pegaría a golpetazos para que sepa lo fuerte que soy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Lo cocinaría en un plato delicioso para Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "¡Aaah! Paimon se fía de tu cocina, ¡pero esa cosa no parece en absoluto algo comestible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Es la primera vez que la oigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Aah, pues ahora ya lo sabes. Acuérdate de que si te la encuentras en otro lugar, tienes que especificar la fuente, o sea, yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
