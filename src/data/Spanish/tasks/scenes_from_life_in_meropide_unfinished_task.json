			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grainville"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "Hola, nos hemos dado cuenta de que el altavoz de ahí no funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630402,
					"content": "¿Otra vez? Qué cosa más rara, pero si Clynes ya lo había arreglado. Parece que no sabe mucho más que yo... si lo único que hay que hacer es darle un par de golpes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630403,
					"content": "Gracias, voy a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630404,
					"content": "¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
