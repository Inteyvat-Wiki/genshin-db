					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630509,
					"content": "Sí, ¿por? Yo creo que son geniales. Mi maestro seguro que no se espera unas imágenes como estas. Se va a llevar una gran sorpresa.",
					"roleType": "TALK_ROLE_NPC",
