			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "¡Estamos de vuelta! ¿Son suficientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Sí. Son suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Razor me estaba hablando sobre el código de conducta de los lobos. ¡Es alucinante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Gracias por ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "Hemos buscado por todas partes y no hemos visto un solo lobo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4540307,
					"content": "Así son los lobos. El que capturamos debía estar enfermo o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4540309,
					"content": "Vine a saldar nuestra cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "¡Es él! ¡El que fue criado por lobos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4540312,
					"content": "Así que fuiste tú. Debí imaginarlo. Los lobos no son lo suficientemente inteligentes como para estar detrás de esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4540313,
					"content": "¡No me puedo creer que ayudaras a los lobos a conspirar contra los humanos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4540314,
					"content": "¿Te dan las sobras de su comida y ya los tratas como si fueran familia? ¿Has olvidado lo que eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "El Maravilloso Hopkins"
				},
				{
					"id": 4540315,
					"content": "¡Basta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "¡No puedes hablar así de Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "¿Los Caballeros de Favonius van a dejar que este tipo se salga con la suya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "Nosotros no atacar aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
