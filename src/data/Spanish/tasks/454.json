			},
			"dialogs": [
				{
					"id": 4540601,
					"content": "Por favor. Calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540602
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540602,
					"content": "¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540603
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540603,
					"content": "Ya lo dijo Razor. Una manada de lobos rompió el acuerdo y entró al territorio. Cosecharán lo que sembraron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540604,
					"content": "Pero Razor, no debes involucrarte. Esto es un ajuste de cuentas entre lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540605,
					"content": "No luchas con las garras, sino con una espada; no atacas con los dientes, sino con el rayo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540606,
					"content": "Eres un humano, Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540607
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540607,
					"content": "¡No soy como ellos! ¡Yo no pertenecer a humanos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540608,
					"content": "Tú no eres un lobo. Este es un asunto de lobos, y nada más que de lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540609
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540609,
					"content": "En cuanto a ti, eres el lupical de Razor entre los humanos. Tu nobleza te hace especial entre ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540610
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540610,
					"content": "Si así lo quieres, puedes venir y entrenar conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540611
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540611,
					"content": "No tengo nada más que decir. Espero que nos veamos de nuevo, Razor y compañía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540612
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540612,
					"content": "Oye... Razor, ¿por qué la cara tan larga? ¿Y si vienes unos días a la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540613
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540613,
					"content": "¡Sí! De todos modos, tienes una amiga en Mondstadt, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540614,
					"content": "Ya sabes... ¿Esa amiga tuya de rojo y de carácter explosivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540615,
					"content": "Ya no estás a salvo de los cazadores y otras personas que andan por el campo, y sé que no quieres lastimarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540616,
					"content": "Estoy bien. No preocuparse. No pertenezco a ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540617
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540617,
					"content": "Pero tampoco aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540618,
						4540619
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540618,
					"content": "Razor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				},
				{
					"id": 4540621,
					"content": "#Gracias, {NICKNAME} y Paimon y... otra chica de rojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540622
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540622,
					"content": "¡Oye! Tanto tiempo hablando y todavía no te sabes mi nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540623
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540623,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540619,
					"content": "No estés triste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				}
			]
		},
		{
