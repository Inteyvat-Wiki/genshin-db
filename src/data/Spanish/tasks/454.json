				{
					"id": 4540202,
					"content": "Ganchos de lobo ser así. Pueden detener sangrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
		{
			"id": 45411,
			"completionStepIds": [
				45411
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
