			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "Este ser lobo herido. Pobre. Hombres malos lo lastimaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541302,
					"content": "Fueron demasiado lejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541303,
					"content": "Sí, sí, es terrible, pero eso no cambia el hecho de que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541304,
					"content": "¡Nosotros no atacar pueblo! ¡No ser nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541305,
					"content": "Era manada de lobo negro. No ser de aquí. Intentaban apoderarse de tierras. Rompieron reglas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541306,
					"content": "¿Las reglas de <color=#00E1FFFF>quién</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541307,
					"content": "Reglas de guardián de esta tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541308,
					"content": "Ya es la segunda vez que lo dices. Dinos, ¿de quién hablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541309,
					"content": "#Necesito llevar lupical más adentro. Seguirme, verán ustedes mism{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
		{
			"id": 45415,
			"completionStepIds": [
				45415
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
