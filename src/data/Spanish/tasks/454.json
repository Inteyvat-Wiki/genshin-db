			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "¡Marcas de sangre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541102,
					"content": "No ser sangre humana, ser sangre de lobo. Sangre lupical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541103,
					"content": "¿Lupi... qué? ¿Alguna vez nos dirás qué significa eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541104,
					"content": "Lupical ser familia del destino. Cuando lobo adopta humano, o cuando humano adopta a lobo. Eso ser lupical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541105,
					"content": "A mí me suena a que te lo estás inventando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541106,
					"content": "Qué extraño. ¿De dónde viene la palabra? No creo que fuera inventada por los lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541107,
					"content": "Es nombre que él le dio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541108,
					"content": "¿Que le dio quién?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541109,
					"content": "Guardián de esta tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541110,
					"content": "¿No sería Barbatos? Él es el gobernante de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541111,
					"content": "Basta de charla. Encontré otra pista. Síganme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541112,
					"content": "¡Oye! ¡Espera! Te estoy dando una oportunidad para explicarte y probar tu inocencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541113,
					"content": "¡Razor se fue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45413,
			"completionStepIds": [
				45413
			],
