			},
			"dialogs": [
				{
					"id": 4540101,
					"content": "¿Quién estar ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540102,
					"content": "#Calma, Razor, somos nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540103,
					"content": "Tú... ¿También ser Caballera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540104,
					"content": "¿Entonces no se conocen, después de todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540105,
					"content": "“La de rojo, una chica explosiva”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "No. Ella vestir rojo, pero más explosiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540108,
					"content": "Todo está empezando a tener sentido. ¿Es este el Niño-lobo del que me hablaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540109,
					"content": "¡Correcto! Se llama Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540110,
					"content": "Ayúdenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540111,
					"content": "¿Con qué cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540112,
					"content": "No hay tiempo. Ya envié al lupical. Personas que vienen ser malas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540113,
					"content": "¿Esos tipos de antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540114,
					"content": "Entiendo. Pero primero, tengo algunas preguntas que ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540115,
					"content": "*Olfatea*... Huelo sangre. Rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540116,
					"content": "¿Sangre? Espero que los lobos no hayan atacado a esos tontos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540106,
					"content": "¿No es Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
