			"dialogs": [
				{
					"id": 732181801,
					"content": "“Espero que los de la Academia intensifiquen las inspecciones en el Caravasar Ribat”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181802
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181802,
					"content": "“Ahora se permite a cualquier habitante del desierto cruzar la frontera como le dé la gana, y acaban robándole los puestos de trabajo a los lugareños. Por no hablar de que los bandidos aprovechan esto para huir al bosque”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181803
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181803,
					"content": "“Aún no han dado permiso a los habitantes del desierto para usar los conmutadores Akasha, pero los encargos de la Ciudadela Regzar ya no son solo para los mercenarios. De seguir así, aunque todo el mundo quisiera entrar en la Academia, siempre habría alguien que se quede sin trabajo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181804
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181804,
					"content": "“¿Pero qué estás diciendo? Los habitantes del desierto también son hijos de la Arconte Dendro y ciudadanos de Sumeru. Tienen todo el derecho del mundo de entrar en la ciudad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181805
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181805,
					"content": "“Ten cuidado con lo que dices por aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
