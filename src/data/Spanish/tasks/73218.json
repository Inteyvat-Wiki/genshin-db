			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "“He oído que algunas personas se han hecho ricas vendiendo grasa de crisálida del desierto en la ciudad. Ahora tienen hasta mansiones en propiedad y alardean de tener algún tipo de relación con los eruditos de la Academia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181402,
					"content": "“En cambio, yo llevo toda la vida transportando piedras de un lado para otro y no tengo absolutamente nada”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181403,
					"content": "“Para tu información, para comerciar con crisálidas del desierto necesitas una licencia de la Academia, y alguien como tú nunca podría conseguirla”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181404,
					"content": "“Si quieres hacerte rico, deberías dedicarte al contrabando de libros conmigo. Si nos funciona, al menos ya no tendremos que cargar piedras todo el día”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
