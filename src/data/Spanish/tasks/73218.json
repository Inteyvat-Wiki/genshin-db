			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Se ruega a los aventureros que se dirijan al desierto que recuerden que toda expedición al Gran Desierto Escarlata debe notificarse previamente a la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181302,
					"content": "Todos los artefactos encontrados en las ruinas del desierto pertenecen a la Academia, y nadie podrá reclamar propiedad sobre ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181303,
					"content": "Por razones de seguridad, la Academia prohíbe el tránsito a cualquier otra zona que no sea el Gran Desierto Escarlata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181304,
					"content": "La Academia no se hará responsable de los accidentes que se produzcan tras el acceso a las zonas no permitidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
