			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Los investigadores que se alojen en el Caravasar Ribat durante un periodo de tiempo prolongado deben registrarse ante la Academia previamente para evitar cualquier tipo de filtración o posible problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Los comerciantes y los viajeros deben registrarse formalmente en la Academia antes de poder recibir el permiso necesario para cruzar la frontera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180902,
					"content": "Está prohibido el transporte de cualquier mercancía no registrada o cuya importación y exportación esté restringida. Cualquier infracción de este tipo supondrá la inmediata confiscación de dicha mercancía y la expulsión al desierto del propietario de los bienes en conformidad con la normativa vigente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180903,
					"content": "Por otra parte, los residentes de la Aldea Aaru podrán cruzar la frontera con un permiso otorgado por la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
