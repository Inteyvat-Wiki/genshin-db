			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "Este camino se dirige hacia el Gran Desierto Escarlata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180302,
					"content": "Aquellos que sientan el más mínimo respeto por la muerte, que den media vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "La Academia de Sumeru prohíbe estrictamente cualquier forma de destrucción del Muro de Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180402,
					"content": "Cualquier infracción será severamente castigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "“Venta de fruta confitada y otros ingredientes de repostería”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180502,
					"content": "“Envío gratuito para pedidos al por mayor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180503,
					"content": "“No está nada mal, podría preparar dango con ello. ¿Podrían enviarlo hasta Inazuma?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180504,
					"content": "“Lo sentimos. Nuestros servicios de entrega internacionales se limitan a Liyue”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Travesía Dorada no necesita publicidad puesto que es el único hotel del Caravasar Ribat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180602,
					"content": "Preparamos la parrilla más deliciosa con auténticos ingredientes del desierto. No encontrarás nada parecido en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180603,
					"content": "La comida ideal para exhaustos viajeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "“Espero que los de la Academia intensifiquen las inspecciones en el Caravasar Ribat”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180702,
					"content": "“Ahora se permite a cualquier habitante del desierto cruzar la frontera como le dé la gana, y acaban robándole los puestos de trabajo a los lugareños. Por no hablar de que los bandidos aprovechan esto para huir al bosque”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180703,
					"content": "“Aún no han dado permiso a los habitantes del desierto para usar los conmutadores Akasha, pero los encargos de la Ciudadela Regzar ya no son solo para los mercenarios. De seguir así, aunque todo el mundo quisiera entrar en la Academia, siempre habría alguien que se quede sin trabajo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180704,
					"content": "“¿Pero qué estás diciendo? Los habitantes del desierto también son hijos de la Reina Mayor Rukkhadevata y ciudadanos de Sumeru. Tienen todo el derecho del mundo de entrar en la nación”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180705,
					"content": "“Ten cuidado con lo que dices por aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
