			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "“Se venden kits de viaje para el desierto. Ofrecemos solución a cualquier problema que pueda surgir durante tu travesía por el desierto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181002,
					"content": "“Te garantizamos que volverás sano y salvo de tu viaje con este kit. En caso contrario, te devolveremos diez veces el precio que pagaste. ¡Haz tu reserva ahora y recibirás un descuento!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
