			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "“Dicen que la Academia creó un hospital en el desierto especializado en el tratamiento contra la eleazar, pero por algún motivo está abandonado...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181102,
					"content": "“Los habitantes de la Aldea Aaru dicen que muchos se curaron de la eleazar allí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181103,
					"content": "“Si se encontraran los registros de aquel hospital, tal vez se pueda hallar una cura para la enfermedad...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "“Dicen que un habitante de la Aldea Aaru acaba de obtener una posición de gran importancia en la Academia. Tal vez ahora las cosas vayan mejor para los habitantes del desierto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181202,
					"content": "“El pago por transportar piedras es una auténtica miseria. Si pudiera transportar en su lugar cápsulas de conocimiento o algo así, podría volver a casa y sentar cabeza”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181203,
					"content": "“El problema es que ese oficial tiene el ojo echado a los que participan en el contrabando. No creo que recibamos ninguna ayuda de su parte”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181204,
					"content": "“Ay, ese es el problema de los habitantes del desierto. No cuidamos los unos de los otros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
