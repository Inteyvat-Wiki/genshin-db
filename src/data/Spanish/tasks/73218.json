			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "“Los jóvenes de hoy en día piensan demasiado. Si no fuera por la protección de la gran Rukkhadevata, los habitantes de la Aldea Aaru ya estaríamos sepultados bajo las ruinas de esos templos desde hace tiempo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181502,
					"content": "“Además, últimamente he oído rumores de que un tal ‘Rey Deshret’ va a renacer o no sé qué. Pero si ni siquiera la gran Rukhadevata ha podido revivir, ¿cómo va a hacerlo ese Rey Deshret imaginario?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181503,
					"content": "“Creo que lo que tenemos que hacer ahora es trabajar. No podemos darnos el lujo de vivir con los pocos suministros que llegan a la Aldea Aaru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
