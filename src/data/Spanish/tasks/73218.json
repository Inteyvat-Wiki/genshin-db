				{
					"id": 732181601,
					"content": "Estamos contratando trabajadores por tiempo indeterminado para el mantenimiento del Muro de Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181602,
					"content": "Ofrecemos un buen salario con comida y alojamiento gratuitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732181603,
					"content": "Yo mismo recomendaré a los trabajadores más destacados para que puedan estudiar en la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
