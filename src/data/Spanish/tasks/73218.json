					"content": "“Te absuelvo del pecado en nombre del Rey de la Botella Mágica, pero ¿quién absolverá los nuestros?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
