			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "Este tablón de anuncios se ha instalado aquí puesto que el Caravasar Ribat es una importante vía de entrada y salida de Sumeru. Aquí avisaremos de todos los asuntos, tanto importantes como menos importantes, para que todos los comerciantes estén enterados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "“Amor mío, aunque estés tan lejos de mí, mi corazón siempre será tuyo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180202,
					"content": "“Ya sé que tienes cosas más importantes que hacer. Al fin y al cabo, cuanto más alto sea tu rango, más responsabilidades tendrás”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180203,
					"content": "“Pero no soporto tener que guardarme esto y no poder contárselo a nadie, no poder decirles tu nombre”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 732180204,
					"content": "“Espero que algún día pueda gritar al mundo lo culto y sabio que eres”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321803",
