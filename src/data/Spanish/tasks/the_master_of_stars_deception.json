							"2"
						],
						"stepId": 1110006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Comerciante creyente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "¿Quién necesita a la Geoarmada teniendo a Maestro de las Estrellas con nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Comerciante creyente"
				},
				{
					"id": 111000602,
					"content": "¿Qué puedes contarme de Maestro de las Estrellas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Soy comerciante, y hace poco tenía que transportar una mercancía especialmente valiosa. Entonces, le pregunté a Maestro si podía viajar conmigo, por presuntuosa que fuera la petición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Comerciante creyente"
				},
				{
					"id": 111000604,
					"content": "Lo hice porque los monstruos salen corriendo tan pronto como ven el talismán que lleva. No tuvimos ningún problema en todo el viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Comerciante creyente"
				},
				{
					"id": 111000605,
					"content": "#No fue barato, pero claro, solicitar los servicios de un Adeptus no es un asunto menor. Por eso puedo aceptarlo. ¡Solo mira el Rito del Ascenso! Pero dudo que {F#una forastera}{M#un forastero} como tú estuviera dispuest{F#a}{M#o} a hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Comerciante creyente"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladrón de Estrellas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "¿Y bien? ¿Qué piensan? Es posible que algunos seguidores exageren un poco, pero hablan desde el corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000802,
					"content": "Querrás decir que es producto de su imaginación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Jaja, eres muy bromista. Había una vez un Adeptus llamado Xue Wuliang, a quien la gente llamaba Liangzi, que una vez dijo lo siguiente:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000804,
					"content": "“Todas las cosas están conectadas. Lo que los mortales llaman ‘imaginación’ es simplemente una conexión entre el espíritu y el objeto de deseo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000805,
					"content": "En otras palabras, sus deseos están de camino a su materialización. ¿Ahora lo entienden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000806,
					"content": "No, de hecho, ahora es más confuso... Pero, básicamente se refiere a que sus deseos pueden cumplirse, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Así es. Eres muy perspicaz, mi diminuta amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000808,
					"content": "Entonces, tenemos otra pregunta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "¿Oh? Pues, pregunten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000810,
					"content": "¿Por qué llevas una máscara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "Como Adeptus, solo camino entre los mortales mientras hago el bien y limpio el mal. No me quito la máscara para no perturbar este mundo más de lo necesario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000815,
					"content": "Oh, Paimon lo entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "Bueno, ¿cuál es su deseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000817,
					"content": "#Me gustaría saber el paradero de mi herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Oh... Presiento que debe haber una historia trágica detrás de todo esto, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000824,
					"content": "Que así sea. Después de todo, tu deseo no está fuera del alcance de mi poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000825,
					"content": "Sin embargo, todavía tengo que ver una prueba... de tu fe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000826,
					"content": "¿A qué te refieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "#El camino de los Adeptus no se comprende solo con palabras. Uno debe buscar las... verdades profundas que se encuentran más allá de ellas... Si no logran entender mis palabras, me temo que no puedo ayudarl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000828,
					"content": "¿Qué hacemos? Paimon no entiende lo que quiere decir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "Creo que quiere que le demos algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "¡Oh, cierto! Algunos de sus seguidores mencionaron que tuvieron que pagar una buena suma para que el Adeptus los ayudara, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Pero Paimon no tiene ni un Mora, y tampoco tenemos nada de valor que ofrecerle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "Además, tú ni siquiera tienes una Visión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "No creo que la gente venda sus Visiones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "¡Oye! ¿Y si le cocinamos algo delicioso? Nadie puede resistirse a una buena comida, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "Al menos para ti, así es...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "¡Sí, algo delicioso! Eso funcionará seguro, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "¿Por qué no vamos a la Casa de Libros Wanwen a ver si hay recetas nuevas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "¡Hagamos algo delicioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "Cierto... Es una lástima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "Creo que quiere Moras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "Quiero una fuerza con la que hacer frente a los dioses.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "En efecto, muchos obstáculos pueden superarse con el poder suficiente. Pero ¿por qué le guardas rencor a los dioses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000821,
					"content": "#¡Quiero ser ric{F#a}{M#o}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#¡Oye! ¿Es que ya te olvidaste de tu {F#hermano}{M#hermana}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "Humm, un deseo muy común entre los mortales. No pareces ser de Liyue, pero siento en ti la influencia del materialismo de su gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111000811,
					"content": "¿Podrías quitarte la máscara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "¡Oye! ¡Eso no se pregunta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Humm... Ciertamente, sería inadecuado quitarme la máscara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Ladrón de Estrellas"
				}
			]
		},
		{
			"id": 1110010,
			"completionStepIds": [
				1110010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
