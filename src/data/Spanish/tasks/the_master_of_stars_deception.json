			},
			"dialogs": [
				{
					"id": 111002301,
					"content": "#Habla con ellos cuanto desees. Un Adeptus no debe jactarse de sus hazañas. Tú mism{F#a}{M#o} debes decidir si lo que dicen es cierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladrón de Estrellas"
				}
			]
