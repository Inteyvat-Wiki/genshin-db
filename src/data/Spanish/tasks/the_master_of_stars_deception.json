			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladrón de Estrellas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "#¡Hola! Permite que nos presentemos. {F#Ella}{M#Él} es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "Si están aquí para darme las gracias, ahórrense las molestias, no es necesario. Limpiar la maldad del mundo es el deber de los Adeptus. No le presten mucha atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111001003,
					"content": "#Un momento, ¿quiénes son ustedes? Pensé que eran seguidor{F#as mías}{M#es míos}, pero, ahora que l{F#as}{M#os} veo más de cerca, creo que no nos conocemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111001004,
					"content": "#Somos aventurer{F#as}{M#os} que pasaban por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#¡Yo soy Paimon! Y est{F#a}{M#e} es mi compañer{F#a}{M#o} de viaje, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "Oh, ya veo. Entonces, según el protocolo, yo también me presentaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111001010,
					"content": "*Ejem*, soy el Adeptus Ladrón de Estrellas. Mis seguidores me conocen como “Maestro de las Estrellas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111001011,
					"content": "Descendí de mi residencia en las montañas para limpiar la maldad del mundo, ante lo cual el destino consideró oportuno que nuestros caminos se cruzaran. Ahora díganme, ¿cuál es su deseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111001012,
					"content": "¿Nuestro deseo? Paimon pensaba que los Adeptus de Liyue eran buenos peleando, pero ¿también le conceden deseos a la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Jaja, hay distintos rangos de Adeptus. ¿O acaso no están las estrellas por encima de las montañas, las nubes y la luna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111001014,
					"content": "#Sin embargo, no es propio de un Adeptus jactarse de sus poderes. Hablen con mis humildes seguidores y juzguen por ustedes mism{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladrón de Estrellas"
				},
				{
					"id": 111001007,
					"content": "Estamos siguiendo el camino de los Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#¡Yo soy Paimon! Y est{F#a}{M#e} es mi compañer{F#a}{M#o} de viaje, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "Oh, veo que compartimos el mismo camino. Entonces, según el protocolo, yo también me presentaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Ladrón de Estrellas"
				}
			]
		},
		{
			"id": 1110023,
			"completionStepIds": [],
