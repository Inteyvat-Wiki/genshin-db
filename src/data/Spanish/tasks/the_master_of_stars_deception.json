	"talks": [
		{
			"id": 1110001,
			"completionStepIds": [
				1110001
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110001",
							"2"
						],
						"stepId": 1110001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#Oye, {NICKNAME}, ¿es imaginación de Paimon, o hay algo extraño en esos Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "Se ven más... ¿malignos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Sí. Hemos visto muchos Hilichurls, y siempre son malos... Pero estos son diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "¡Oh, no! La Posada Wangshu está aquí al lado, ¡sus huéspedes podrían correr un gran peligro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Ahora que los hemos visto, si no hacemos nada, Paimon se sentirá muy culpable... {NICKNAME}, ¡tenemos que ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "Se ven muy sobresaltados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "¡Sí! ¿Tal vez tenga algo que ver con esa especie de... energía oscura que están emitiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110003",
							"2"
						],
						"stepId": 1110003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "Esos Hilichurls tan malvados son más difíciles de derrotar que los normales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000302,
					"content": "Mira, parece que allí hay un grupo de gente reuniéndose, ¿qué estarán haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000303,
					"content": "Guau, ¿viste al tipo de la máscara? ¡Ahuyentó a todos los Hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000304,
					"content": "¿Será un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Oh, ¿como Xiao? Ahora que lo dices, la máscara que lleva es muy parecida a la suya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000307,
					"content": "Pero la técnica que usó parecía más adéptica que la de Xiao. ¿Vamos a hablar con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000305,
					"content": "Parece como si hubiera usado una técnica adéptica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
