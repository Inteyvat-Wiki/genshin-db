			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hombre creyente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "¿Viste a Maestro de las Estrellas en acción? ¡Su poder es casi divino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Hombre creyente"
				},
				{
					"id": 111000402,
					"content": "Creo que por fin habrá algo de esperanza para mi padre enfermo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Hombre creyente"
				},
				{
					"id": 111000403,
					"content": "¿Qué puedes contarme de Maestro de las Estrellas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Ver cómo usa su magia es prueba suficiente de su poder. No cabe duda de que es un verdadero Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Hombre creyente"
				},
				{
					"id": 111000405,
					"content": "Hace poco, le pedí una medicina para mi padre enfermo. ¡Compararlo con la Farmacia Bubu es como comparar el día y la noche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Hombre creyente"
				},
				{
					"id": 111000406,
					"content": "Una vez que la medicina hirvió, emitió una especie de niebla etérea muy típica de los Adeptus. Aunque también podría haber sido porque la medicina llevaba flor helada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Hombre creyente"
				},
				{
					"id": 111000407,
					"content": "Las medicinas de los Adeptus son, sin duda, las más potentes. Estoy convencido de que mi padre se recuperará pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Hombre creyente"
				},
				{
					"id": 111000408,
					"content": "Por supuesto, tuve que hacer algunos sacrificios para que el Adeptus Maestro de las Estrellas me ayudara, como ofrecerle algunas antigüedades, pero la vida de mi padre vale mucho más que unas reliquias antiguas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hombre creyente"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110005",
							"2"
						],
						"stepId": 1110005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mujer creyente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Por fin siento que en la vida hay sentido y esperanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Mujer creyente"
				},
				{
					"id": 111000502,
					"content": "¿Qué puedes contarme de Maestro de las Estrellas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "#¿Ustedes también son seguidor{F#as}{M#es} de Maestro de las Estrellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Mujer creyente"
				},
				{
					"id": 111000504,
					"content": "Después de que mi prometido se fuera sin decir nada, lloraba todos los días...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Mujer creyente"
				},
				{
					"id": 111000505,
					"content": "Pero, entonces, vine a ver a Maestro de las Estrellas en busca de ayuda. Él me sugirió que quemara todas las pinturas que tuviera de mi prometido y que arrojara las cenizas al océano al amanecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Mujer creyente"
				},
				{
					"id": 111000506,
					"content": "No sé cómo explicarlo, pero... ¡funcionó! Sé que mi prometido volverá. Y no, no es que sea optimista, sino que estoy segura de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Mujer creyente"
				},
				{
					"id": 111000507,
					"content": "Estoy tan feliz de haberle dado parte de mi ajuar de bodas a Maestro de las Estrellas como ofrenda... Después de todo, si no fuera por él, no podría recuperar a mi esposo, en cuyo caso no necesitaría ese ajuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mujer creyente"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
