			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "¡Guau! ¡Estamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750802,
					"content": "Mona, ¿ese aventurero... de verdad murió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750803,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750804,
					"content": "Esa fue la única vez que lo vi. Han pasado más de tres años desde entonces, así que... no creo que siga en este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750805,
					"content": "¿Existe la posibilidad de que siga vivo? Ya sabes, que te hayas equivocado, o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750806,
					"content": "Es injusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "No puedes llamarle “adivinación” si rechazas las cosas malas y solo crees en las cosas buenas. Es engañarse a uno mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750808,
					"content": "Hacer adivinación por diversión es muy distinto. En esta disciplina no hay lugar para mentiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750809,
					"content": "Negar mis propias adivinaciones sería una blasfemia en contra de la astrología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750810,
					"content": "Es cruel, pero es la verdad. Así es el destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750811,
					"content": "No suelo decir cosas así, pero ya que estamos hablando del tema, espero que no confundan la astrología con palitos de la fortuna baratos que ofrecen en las calles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750812,
					"content": "La astrología no está para complacer a la gente. Los astrólogos solo confirmamos y atestiguamos las verdades del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750813,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750814,
					"content": "¡Ah! ¡Es por eso que la gente desprecia tanto la astrología! Es una ciencia poderosa, pero también incomoda a las personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750815,
					"content": "¿A qué se deben tus quejas, Srta. Megistus? No eres la clase de persona con la que me desagrada asociarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750816,
					"content": "Lo que la señorita quiere decir es que está muy contenta de ser su amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750817,
					"content": "¡No! ¡Yo no dije eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750818,
					"content": "Oz, ¿qué te pasa? ¡Malinterpretas mis palabras a un ritmo cada vez más alarmante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750819,
					"content": "¡Ay! ¿Por qué será? Tal vez me preocupa que la señorita ofenda a sus amigos. Es por eso que mido sus palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750820,
					"content": "Eres la única astróloga que conozco, pero me agradas. ¡No me pareces molesta, para nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750821,
					"content": "Las personas a las que les gusta husmear en los secretos de otros y a las que no les gusta ver la verdad son las que necesitan reflexionar sobre sí mismas. Conocer tu destino tiene su precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750822,
					"content": "Si el destino se pudiera prevenir con unas pocas palabras, no habría tantas tragedias en el mundo. Mona, no te lo tomes a pecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750823,
					"content": "Sigue lo que te dicte el corazón y no olvides lo que es correcto. Con eso es suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750824,
					"content": "*Ejem*... No hace falta que me consueles, soy muy fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750825,
					"content": "Entonces, ¿por qué te sonrojas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "Eh... Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750827,
					"content": "Pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750828,
					"content": "Gracias... a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750829,
					"content": "¿Qué dijiste? Habla y ofrece tus más altos respetos y gracia a tu Princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750830,
					"content": "De acuerdo, Princesa, en lugar de discutir, ¿por qué no vas a recolectar los otros fragmentos en el nuevo sitio que refleja el estanque? No podemos entrar a la ilusión sin ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750831,
					"content": "Señorita, solo usted puede discernir los secretos a través de su mirada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750832,
					"content": "Está bien. Si ese es el caso, me dirigiré a la playa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750833,
					"content": "Vamos, Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750834,
					"content": "¡Oh, de acuerdo! ¡Allá voy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750835,
					"content": "Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		}
	]
}