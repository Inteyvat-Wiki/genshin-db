						"position": [
							1641.498,
							588.635,
							4626.62
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "*Ejem, ejem*, legionarios de la Legión XIX...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "#¿Eh? ¿Quiénes son ustedes, l{F#a}{M#o}s ayudantes de Est?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870603,
					"content": "Has dado en el clavo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "#¡Y no somos un{F#a}{M#o}s ayudantes cualquiera, sino un{F#a}{M#o}s muy fuertes! Venimos con Casiodoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "#(Parece que {NICKNAME} y Paimon son {F#unas actrices natas}{M#unos actores natos}.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870610,
					"content": "Oooh, ¿se refieren al Sr. Casiodoro? Oí que nuestro grandioso sebasto le envió a Armórica. Entonces, ¿ya regresó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870611,
					"content": "En realidad, este de aquí es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870613,
					"content": "*Ejem*, da igual. ¡Venimos a inspeccionar el frente militar de la legión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "De acuerdo, es lo que supuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870615,
					"content": "No hemos ido con las demás tropas al Fuerte Caribdis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870616,
					"content": "¡Pero quedarse aquí a rematar el trabajo como legionarios de la retaguardia también es una tarea útil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870617,
					"content": "¿Son órdenes de la «Fobos»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Pues... Aunque la «Fobos» debería ser nuestra guía, desde que estamos aquí, en muchas ocasiones no llegamos a oír su melodía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870619,
					"content": "Es por eso que no tenemos más remedio que seguir las instrucciones del ilustre Boecio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870620,
					"content": "Ese maleducado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "¡Eh, tú! ¡¿Cómo te atreves a hablar así del ilustre Boecio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870622,
					"content": "Como honorable afinador que es, siempre ha seguido las instrucciones de nuestro sebasto, así que sus órdenes equivalen a las órdenes de la «Fobos».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870626,
					"content": "¿Alguna vez han pensado que la «Fobos» también puede equivocarse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "#¿Eres siquiera remurian{F#a}{M#o}? ¿Acaso no sabes que la «Fobos» la crearon enteramente nuestro sebasto omnipotente y la infalible profetisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870628,
					"content": "Sí, pero no oyen su melodía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Humm, eso es cierto... Pero si no podemos confiar en la «Fobos», entonces, ¿qué nos queda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870630,
					"content": "Si nos desviamos del camino establecido por ella, no tendrá piedad alguna con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870623,
					"content": "Su sebasto nunca les dijo que hicieran daño a inocentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "¿Hacer daño a inocentes?... Es cierto que, antes de que estallara la guerra, nuestro sebasto nos ordenó ayudar a los más desfavorecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870625,
					"content": "Pero si ahora la «Fobos» aprueba nuestras acciones, ¿quiere eso decir que su melodía va en contra de la sagrada voluntad de nuestro sebasto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870605,
					"content": "#Somos un{F#a}{M#o}s enviad{F#a}{M#o}s especiales de nuestro sebasto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "#¿Enviad{F#a}{M#o}s especiales?... Aaah, sí, sí, claro, venimos con Casiodoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "#Somos {F#las sirvientas}{M#los sirvientes} de Casiodoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "#Así es, ¡{F#las leales sirvientas}{M#los leales sirvientes} de Casiodoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
