			"dialogs": [
				{
					"id": 741870201,
					"content": "¡Eh, tú, idiota! ¿Por qué quedan tantos tesoros todavía? ¡Por Los Siete, qué lento eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870202,
					"content": "¡No es eso, jefe! Es que estos tesoros pesan tanto que llevamos un día entero transportándolos sin parar, y encima resulta que aún quedan un montón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "Aquel al que llaman “idiota”"
				},
				{
					"id": 741870203,
					"content": "¡Tanto músculo para tan poco cerebro! ¡¿Cómo no van a pesar un poco si se trata de unos tesoros valiosísimos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870204,
					"content": "Además, los hemos recuperado de las manos de esos malditos bárbaros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870205,
					"content": "¡Hum! ¿Cómo pudo esa escoria que vive como cerdos en una pocilga hacerse con estos tesoros? ¡Qué desperdicio más grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870206,
					"content": "Si queremos llevarlos todos de vuelta a Remuria, no tendremos más remedio que pedir unos cuantos botes más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "Aquel al que llaman “idiota”"
				},
				{
					"id": 741870207,
					"content": "¿Tú eres idiota o comes piedras? ¡¿Cómo vamos a usar los buques de carga del imperio para algo como esto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870208,
					"content": "Bah, ¿sabes qué? ¡Destrúyelo todo! Esto no puede acabar en las manos de esos bárbaros bajo ningún concepto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "Aquel al que llaman “idiota”"
				},
				{
					"id": 741870209,
					"content": "Humm, ¿por qué Paimon tiene la sensación de haber oído antes esta conversación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "Cuando llegamos a Petricor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "¡Ah, cierto! Aquel grupo de aventureros desafortunados a los que ahuyentamos dijeron algo parecido, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "¡Pero esta conversación de ahora es mucho más fuerte que la otra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "¿Será que el bote en el que iban naufragó y se convirtieron en Gólems?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Sea lo que sea, ¡a Paimon le da mucho miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "¿Son ustedes de la Legión XIX? ¿Qué hacen aquí? Según las órdenes de arriba, la Legión XIX ya debería haberse retirado al Fuerte Caribdis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870217,
					"content": "Eh, Est, ¡ni se te ocurra aguarnos la fiesta! ¿Me oyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870218,
					"content": "Estos bárbaros son incluso menos peligrosos que los peces muertos, así que déjanos divertirnos un rato más por aquí, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870219,
					"content": "Estos tesoros... *Suspira*, no sé qué órdenes les dio el afinador que los lidera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870220,
					"content": "Pero nuestro sebasto nos ordenó subyugar a los bárbaros ignorantes y romper las cadenas del destino que los aprisionan. Y sus acciones... no hay duda de que son un crimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870221,
					"content": "¿Eh? Las órdenes del comandante, el ilustre Boecio, fueron que debíamos castigar implacablemente a los bárbaros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870222,
					"content": "Además, si no hemos recibido ningún castigo, quiere decir que tanto la «Fobos» como su majestad, nuestro sebasto, aprueban nuestras acciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870223,
					"content": "Así que ¿a qué viene eso de un crimen? ¿Acaso intentas causar una disputa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870224,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870225,
					"content": "Aquí también hay un Est... ¡Esto es cada vez más raro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Parece que es hora de responder a esa pregunta suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870227,
					"content": "El Est que conocieron en Petricor es descendiente de los remurianos. Imagino que sus ancestros me siguieron hasta la nueva nación y se convirtieron en ciudadanos corrientes de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870228,
					"content": "Es por eso que la serenata no tiene ningún efecto sobre él. Por el contrario, la melodía que registra los recuerdos de sus ancestros se adhirió a esa estatua porque no tenía ningún sitio al que ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870229,
					"content": "Es decir, ¿que este Est es el ancestro del Est de Petricor, el auténtico “Est el Astuto”? Pero entonces, ¿quiénes son los demás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "No son más que almas perdidas del pasado que deambulan sin rumbo. Vamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870231,
					"content": "Caminan junto a Os...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "¡Hola, Est!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Oh, hola. ¿Quiénes son ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870234,
					"content": "No tienen pinta de remurianos. ¿No serán de esos salvajes bárbaros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870235,
					"content": "#Solo soy {F#una}{M#un} viajer{F#a}{M#o} que está de paso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Pues tengan cuidado, porque esto es un campo de batalla. Sean quienes sean, les aconsejo marcharse lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870238,
					"content": "Hola, Est, cuánto tiempo sin vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870239,
					"content": "¡Por los cielos, Sr. Casiodoro! Como rara vez lo he visto en esta forma, por poco no lo reconozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870240,
					"content": "#Entonces, est{F#a}{M#o}s dos son... ¿tus sirvient{F#a}{M#e}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870241,
					"content": "Se podría decir que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Pero, Sr. Casiodoro, ¿qué hace usted por aquí? ¿No era que nuestro sebasto le había enviado a...? Maldición, no me acuerdo... No me digan que esto es un sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870246,
					"content": "Eso parece, querido Est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870247,
					"content": "Jajaja, qué bromista es usted, Sr. Casiodoro. Nuestro sebasto le encomendó una especie de misión secreta, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870248,
					"content": "Brillante deducción. Por cierto, ¿por qué esos legionarios de la Legión XIX estaban protegiendo las cadenas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870249,
					"content": "¿Las cadenas?... Aaaah, se refiere a esos tesoros. Creo que los robaron como botín de guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870250,
					"content": "Aunque para nuestro sebasto la guerra no es sino un método con el que alcanzar nuestras grandiosas aspiraciones, hace mucho tiempo que prohibió ese tipo de viles comportamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870251,
					"content": "Seguro que usted ya sabrá que ahora todo el mundo está haciendo cosas como esa... Nos precipitamos hacia la oscuridad, pero nadie se da cuenta de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870252,
					"content": "Sr. Casiodoro, ¿usted sabe qué demonios sucedió? La «Fobos» debería habernos traído la felicidad, pero ¿por qué solo siento un sufrimiento indescriptible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870253,
					"content": "Yo también estoy buscando la respuesta a esa pregunta. Pero ahora mismo, la prioridad es resolver el problema que tenemos ante nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870254,
					"content": "Sí, pero en cualquier caso, hágalo de la forma más pacífica posible. Después de todo, son de nuestra legión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Est"
				},
				{
					"id": 741870242,
					"content": "#En realidad, soy su dueñ{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870244,
					"content": "#¡Eh, {NICKNAME}, no hagas las cosas más complicadas de lo que son! No te preocupes, Est, {NICKNAME} solo estaba bromeando. Continúa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "Uy, sí, puedo llegar a ser muy salvaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870211,
					"content": "Fue cuando nos encontramos con esos ladrones de tesoros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				}
			]
		},
