			"dialogs": [
				{
					"id": 741871201,
					"content": "La «Fobos» es una creación absolutamente perfecta, así que como remuriano, mi consejo es que no dudes de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741871202,
