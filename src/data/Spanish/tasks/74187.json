			"dialogs": [
				{
					"id": 741870701,
					"content": "De acuerdo... Tienes razón, deberíamos reconsiderar nuestros actos. La verdad es que no sé cómo hemos llegado hasta este punto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870702,
					"content": "Siento algo muy extraño desde que estalló la guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870703,
					"content": "En un principio buscábamos la libertad y la felicidad, pero la «Fobos» fue guiándonos hasta aquí paso a paso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870704,
					"content": "¿En qué momento se torció el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870705,
					"content": "Si se encuentran con nuestro sebasto, por favor, infórmenle de lo que está ocurriendo aquí y de nuestras dudas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870706,
					"content": "Se lo ruego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Jefe"
				},
				{
					"id": 741870707,
					"content": "¡Claro que sí! No te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
