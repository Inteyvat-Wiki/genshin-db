						741870902
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870902,
					"content": "Ahora tendrá que dirigirse hacia su siguiente objetivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870903,
					"content": "Sí. Cuento contigo para que te ocupes de este lugar, Est.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870904,
					"content": "Y en vez de creer ciegamente en el criterio de la «Fobos» o de alguno de los afinadores, recuerda que lo más importante es que creas en tu propio juicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870905,
					"content": "Nuestro sebasto creó la «Fobos» para que nos liberáramos de la esclavitud del destino, pero la fe ciega de nuestro pueblo acabará llevándonos a una esclavitud aún peor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870906,
					"content": "Es posible que en el futuro tengas que tomar una decisión al respecto, y espero que, llegado el momento, elijas el camino correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osifuz"
				},
				{
					"id": 741870907,
					"content": "Sr. Casiodoro, ¿por qué dice eso de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870908,
					"content": "No importa, le garantizo que recordaré sus palabras. Yo, Est, me aferraré a mi propia justicia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Est"
				},
				{
					"id": 741870909,
					"content": "Me alegra oír eso. Bueno, he de marcharme, pero tengo la corazonada de que volveremos a vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osifuz"
				}
			]
		},
