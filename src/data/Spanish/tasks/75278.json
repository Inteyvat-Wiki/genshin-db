			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "¡O-oigan! ¡Esperen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780102,
					"content": "¿Qué pasa, pequeña? ¿Necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "“¡Con el milagro del florecimiento de los guiztli, que el Fuego Sagrado ilumine tu sonrisa!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780104,
					"content": "¿E-eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "“En nombre del Resort Brisapacible, ¡te presento un baile de bienvenida! ¡Brilla, Ídolo Pipilpan!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780106,
					"content": "¡Ah! ¡Otra vez esa frase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#Sí, soy yo, Xiton. ¡Cuánto tiempo sin vernos! {NICKNAME}, Paimon, ¡lo he vuelto a hacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780108,
					"content": "Oh, ¡eres tú, Xiton! ¡Ya pensaba Paimon que se había vuelto a topar con alguien extraño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "¿A qué viene tanta alegría?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Jeje, ¡papá va a entrenarme personalmente y quiere que me convierta en una gran bailarina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780112,
					"content": "Aunque parezca un gruñón, ¡se preocupa mucho por ti!... Aunque sería mejor que no te enseñara cosas tan raras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "¡Oh, por cierto! ¡Esto es para ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780114,
					"content": "¿Este no es tu traje de actuación? Pero sin él, ¿cómo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Jeje, no se preocupen. ¡Papá me ha hecho un nuevo traje que me queda mejor! ¡Esta vez no me caeré en el escenario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780116,
					"content": "Convertí el traje antiguo en un recuerdo. ¡Quédenselo como símbolo de nuestra amistad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780117,
					"content": "#La próxima vez que nos veamos, ¡me pondré mi nuevo traje y les dedicaré la danza de bienvenida! Así que ¡vengan a apoyarme siempre que puedan! ¡L{F#a}{M#o}s estaré esperando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780118,
					"content": "¡Sí! ¡Seguro que lo haremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "¡Xiton! ¡Deberías estar entrenando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Bueno, se está haciendo tarde. ¡Me voy a entrenar estos músculos! {NICKNAME}, Paimon, ¡nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "Xiton"
				},
				{
					"id": 752780121,
					"content": "¡Nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(¿De verdad vas a ir?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "¡Por supuesto! Aunque lo ideal sería poder asistir a una actuación de un ídolo normal y corriente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "¿Cómo va todo últimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}