			},
			"dialogs": [
				{
					"id": 100060901,
					"content": "De hecho, desde un punto de vista biológico, no soy un gato en absoluto, sino un ser alquímico. Supongo que no te considerarías un Espectro simplemente porque también flotas en el aire, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "¿Un Espectro? ¿Qué insinúas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Ya sé, a esto se refieren con el significado que hay detrás de las palabras, ¿verdad? Lo que quiere decir Sebas es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060904,
					"content": "Mejor no termines esa frase, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "Eh, ¡¿qué están diciendo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060906,
					"content": "Oh, y considerando cómo terminó el mensaje de la maestra Rhinedottir, supongo que esta técnica ya no sirve de nada. La destruiré sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060907,
					"content": "Son pocas las personas que pueden hacerla cambiar de opinión. Impresionante, jovencito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060908,
					"content": "Bueno, debo irme ya, que tengo otros mensajes que entregar. Quizás nos volvamos a encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
