			"dialogs": [
				{
					"id": 100060101,
					"content": "Hola, Durin, así que estabas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060102,
					"content": "#{NICKNAME}, Paimon. ¿Cómo es que han venido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060103,
					"content": "Jeje, con el tiempo tan bonito que hace fuera, ¿por qué estás aquí solo leyendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060104,
					"content": "Oh. Bueno, desde que tengo más oportunidades de interactuar con la gente de Mondstadt, me cuesta distinguir cuándo están bromeando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060105,
					"content": "Por ejemplo, la otra vez estuve en la floristería y vi una flor muy bonita. Así que se lo comenté a la florista y ella dijo:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060106,
					"content": "“Jeje, si tanto te gustan estos hierbajos, podrías añadir unas mentas y flores dulces y hacer un ramo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060107,
					"content": "Hice lo que me dijo, pero cuando le enseñé el ramo terminado, me dedicó una mirada terrorífica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060108,
					"content": "Tienes una perspectiva única, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "Pero después, Albedo me dijo que eso sucedió porque tengo problemas para entender el significado detrás de las palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060111,
					"content": "Por eso, tras aprender la escritura de Mondstadt, me dijo que podía venir aquí a leer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060112,
					"content": "Como nací de un libro de cuentos, pensé que tal vez estos libros podrían enseñarme más cosas sobre las reglas de este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060113,
					"content": "Pero creo que he perdido la noción del tiempo... Bueno, ¿necesitaban algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060114,
					"content": "Los amigos a veces pasan solo para saludar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "Oh, ya veo. Entonces esa es otra regla que acabo de aprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060116,
					"content": "¡Sí! Dicho eso, teníamos algo importante de lo que hablar, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060118,
					"content": "Sí, tenemos un mensaje de parte de Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060119,
					"content": "Oh... ¿de la tía Rhinedottir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060120,
					"content": "Sí, ¿qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "No, simplemente... estoy sorprendido. Rhinedottir es amiga de mi madre... y la madre del dragón que existió en este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060123,
					"content": "Lo suplanté... le arrebaté el destino que debiera haber sido suyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060124,
					"content": "Así que, si ella me odiara... No sé muy bien lo que podría hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060125,
					"content": "No creo que ella te guarde rencor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "¡Sí! ¡Estamos aquí para apoyarte! Pero en serio, Paimon no cree que sea nada malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060128,
					"content": "Eso me hace sentir mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060129,
					"content": "Si es así, entonces voy a abrirlo a ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060126,
					"content": "#De cualquier forma, nos tienes a nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "No te pongas nervioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "Estamos aquí por petición de una bruja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "A mí me parece que el problema es suyo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
