					"nextDialogs": [
						100060803
					]
				},
				{
					"id": 100060803,
					"content": "#¡Sí! A estas alturas ya estamos acostumbrad{F#a}{M#o}s a los gatos parlantes, pero uno que puede imitar la voz de los demás... ¡Eso sí que es nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060804,
					"content": "No veo por qué importa eso, pero si insisten... Soy Sebas, un simple mayordomo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060805
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060805,
					"content": "#Ustedes son amig{F#a}{M#o}s de Albedo, ¿verdad? Estrictamente hablando, podría decirse que soy su “mayor”, así que no me comparen con un simple felino.",
					"roleType": "TALK_ROLE_NPC",
