			"dialogs": [
				{
					"id": 752420401,
					"content": "¡Bienvenidos al Resort Brisapacible! Yo me encargaré de hacer su registro de entrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420402
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420402,
					"content": "Les ruego que tomen este mapa, junto con un álbum conmemorativo especial que hemos preparado para nuestros huéspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420403
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420403,
					"content": "El Resort Brisapacible consta de cuatro zonas principales: los Acantilados Irisados, el Peñasco Guiztli, la Bahía de las Olas y la Isla Tete. ¡No duden en explorarlas libremente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420404
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420404,
					"content": "Bueno, su alojamiento está en esa dirección. No duden en dirigirse allí si necesitan descansar. Y si quieren ir de compras, el Mercado Brisapacible, nuestra atracción más concurrida, está justo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ukucha"
				}
			]
