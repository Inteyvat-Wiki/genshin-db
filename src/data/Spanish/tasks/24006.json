			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "Aaah, has vuelto a encontrarme. Supongo que eres incluso mejor que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Nos vemos donde antes. Espero que mi hermano no se deje encontrar tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "¿Y eso por qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Bueno, es por eso que ha dicho de que piensa mejor cuando hace ejercicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "El problema es que luego piensa demasiado y se hace una bolita durante un buen rato para intentar acordarse de todas las ideas que se le han ocurrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi dice que esas ideas son muy valiosas y que no deberíamos molestarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "Por eso jugamos al escondite con él. Si lo encontramos, perdemos un poco el tiempo hasta que ya ha terminado de recordarlo todo antes de atraparle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "Pero si le toca a él atraparnos... Siempre nos toca esperar una eternidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
