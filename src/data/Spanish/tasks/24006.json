			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "No, no. Esa línea de argumentación no sirve. Necesito cambiar el punto de vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060302,
					"content": "¿Y así? No, tampoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060303,
					"content": "¿Eh? Ah, me has encontrado. Iré a esperar allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060304,
					"content": "¿Está bien este punto de vista? ¿Está bien o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400604,
			"completionStepIds": [
				2400604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400604",
							"2"
						],
						"stepId": 2400604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "Me pregunto si Aurèle ya habrá sido capaz de poner en orden sus ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060402,
					"content": "¿Qué? ¿De verdad me has encontrado? ¿Cuántas veces has jugado a esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060403,
					"content": "Bueno, está bien. Volveré con los demás. ¡La próxima vez me esconderé mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
			"id": 2400606,
			"completionStepIds": [
				2400606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400606",
							"2"
						],
						"stepId": 2400606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle",
					"Lovi",
					"Verut"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.448,
							281.167,
							4542.663
						],
						"pointId": 340100170
					}
				]
			},
			"dialogs": [
				{
					"id": 240060601,
					"content": "No, no... El argumento no es lo suficientemente riguroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060602,
					"content": "#Bueno, pues parece que Aurèle está en las nubes otra vez. Gracias por jugar con nosotros, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060603,
					"content": "¿Seguro que está bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060605
					]
				},
				{
					"id": 240060605,
					"content": "Mientras no sustituya el agua por el café, no habrá problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060606,
					"content": "Yo me encargo de eso. ¡No dejaré que beba demasiado café! Si lo hace, se lo esconderé todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060607
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060607,
					"content": "*Suspira*, y yo que pensaba esconderle el café a mi padre en su casa... Supongo que ya no es una opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060608
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060608,
					"content": "No es nada fácil ser crítico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
