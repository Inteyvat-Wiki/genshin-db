	"talks": [
		{
			"id": 2400601,
			"completionStepIds": [
				2400601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400601",
							"2"
						],
						"stepId": 2400601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Lovi",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "¡Me toca a mí encontrarles! ¡Ya verás, Lovi, pienso encontrarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "No estés tan seguro. Hay sitios a los que ni tú eres capaz de trepar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "Pues será porque no llevo los zapatos adecuados. ¡Si me los cambio, seguro que te atrapo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "¿Ah, sí? Pues vamos a quitarnos los zapatos los dos. ¡Así será más justo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "¡Ni hablar! Ninguno de los dos tiene permiso para corretear por ahí descalzo. Hay todo tipo de basura tirada por el suelo. ¿Y si se cortan o algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060106,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "Por cierto, hermanito, cuando te tocó encontrarme, estabas un poco distraído. Pasé corriendo por delante y ni te diste cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "¿Eh? ¿De verdad? No lo sabía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060110,
					"content": "¡Eso es precisamente de lo que estoy hablando! Me di toda una vuelta corriendo y no pareció que me vieras siquiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "#¿Eh? {NICKNAME}, ¿qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060112,
					"content": "¿Qué hace Lovi aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Papá tenía un viaje de trabajo y mamá tenía trabajo también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Aurèle vino a casa a devolver un libro, así que mi papi le pidió que cuidara de mí. Por eso he venido a jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Bueno, ¿jugamos o qué? ¿A quién le toca contar ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060119,
					"content": "Pensaba que no te gustaba jugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Bueno, verás, es que estoy intentando escribir una crítica, pero todavía tengo que sopesar algunos aspectos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060122,
					"content": "Me he dado cuenta de que estoy más despierto cuando hago ejercicio, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060123,
					"content": "Pero se queda embobado cada dos por tres. A veces incluso se pone a hablar solo. Da igual lo que hagas, no te presta atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "#¿Por qué no juegas con nosotros, {NICKNAME}? Tú eres mucho mejor en el escondite que mi hermano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Claro, no hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Jeje, ya veremos. Lovi y yo somos los campeones del escondite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "¡Vamos, Lovi! ¡Escondámonos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi y Verut ponen pies en polvorosa, pero Aurèle se marcha con parsimonia pensando en sus cosas...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "No pienso ponérselo fácil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "¿A qué viene este repentino entusiasmo por el escondite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "¿Siguen jugando al escondite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Así es. Da la casualidad de que el Sr. Delerue tenía que irse de viaje y la Sra. Dumay también tenía que ir a trabajar, así que estoy cuidando de Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060117,
					"content": "Se me ocurrió traerla aquí para que pudieran jugar. Espero que no se ensucie el vestido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400602,
			"completionStepIds": [
				2400602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
