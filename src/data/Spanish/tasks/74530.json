				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "#¡Ah, profesor{F#a}! ¡Has vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300402,
					"content": "Parece que estás muy feliz, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "Jeje, ¡encontré un mineral estupendo en la excavación de hoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300405,
					"content": "Si lo pulimos bien, ¡quizás se convierta en una gema brillante y preciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300406,
					"content": "¡Qué bien!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "¡Sí! No había encontrado nada hasta ahora y casi me voy con las manos vacías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300408,
					"content": "Pero pienso que no debería rendirme... así que me decía a mí misma: “Vamos, Kachina, excava un poco más, solo un poquito más”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300409,
					"content": "¡No sé cuántas veces lo repetí, pero al fin lo encontré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300410,
					"content": "Cuando salí, me di cuenta de que el sol ya casi se estaba poniendo... Y así se me pasó el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300411,
					"content": "Tienes una determinación admirable, Kachina. ¿Te parece si te tomo una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "¿L-lo dices en serio? Me... me da un poco de vergüenza estar frente al Daguerrotipo... No sé si saldré bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300414,
					"content": "Pero si me lo pides tú, ¡me esforzaré al máximo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300415,
					"content": "Ya lo estás haciendo muy bien, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "¡Entendido! Entonces te lo dejo a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300416,
					"content": "Simplemente sé tú misma, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "¿Puedo tomar una imagen de nuestra brillante Kachina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "¿Ha ocurrido algo bueno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
