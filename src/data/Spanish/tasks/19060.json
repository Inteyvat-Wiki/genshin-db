				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "#Viajer{F#a}{M#o}, confío en que descubrirás la verdad, seguro que Shikanoin esconde algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190602902,
					"content": "*Suspira*... La jefa Sango y el detective Heizou son muy amables, pero cuando están juntos, siempre acaban discutiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190602903,
					"content": "Madura un poco, Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
