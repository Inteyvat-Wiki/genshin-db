				{
					"id": 190603101,
					"content": "No te tomes las palabras de Uesugi demasiado en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603102
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603102,
					"content": "¿Qué sabes de Takatsukasa Isamu y Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603103
					]
				},
				{
					"id": 190603103,
					"content": "Ah, sobre eso. Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603104
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603104,
					"content": "No hay duda de que Ryuuji consideraba a Takatsukasa Isamu como su padre adoptivo. Por otro lado, no diría que Takatsukasa ayudó a Ryuuji sin esperar nada a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603105
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603105,
					"content": "Después de todo, Takatsukasa Isamu es una persona muy ingeniosa. Alguien tan simple e ingenuo como Ryuuji no le serviría como consejero, pero sí como un ayudante leal y confiable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603106,
					"content": "Isamu esperaba un bebé. Por desgracia, falleció antes de dar a luz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603107,
					"content": "En fin, no hablemos más de eso. Viniste a investigar el caso, ¿cierto? Más vale que te pongas manos a la obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
