			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "#Oye, viajer{F#a}{M#o}, la investigación es un dolor de cabeza, ¿cierto? Descuida, te contaré todo lo que tienes que saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Cuéntame sobre la jefa Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "¡Ah! La jefa Sango... Conque el clan Takatsukasa contrató a una gran detective, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "Venía cada tres o cuatro días para solicitar que se reabriera el caso de Ryuuji, pero Heizou se oponía rotundamente. No imaginé que fuera a escribir una carta de queja. Es implacable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "La razón por la que el Sr. Heizou se opuso a que se involucrara en el caso, es porque quizás teme que corra peligro. Después de todo, se trata del asesinato de un hombre de alto rango. Si no tienes cuidado, puedes meterte en problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Quizás Sango tiene una agencia de detectives, pero al final del día, es una persona ordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "¿Ellos dos se llevan bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "No del todo. Siempre que los veo juntos, están discutiendo. Pero Heizou la considera una vieja amiga. Escuché que solía trabajar para Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
					"content": "A veces me pedía que entregara algunos casos menores a la agencia de detectives. Supongo que quería ayudar al negocio de Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603010,
					"content": "Sí. El Sr. Heizou es una muy buena persona. No hay duda de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
