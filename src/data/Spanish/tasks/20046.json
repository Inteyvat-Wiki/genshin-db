				"points": []
			},
			"dialogs": [
				{
					"id": 200460101,
					"content": "Muy bien... ¡Hoy tenemos otro encargo por cumplir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460102,
						200460106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460102,
					"content": "Estás muy motivada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460103
					]
				},
				{
					"id": 200460103,
					"content": "¡Por supuesto! ¡Ser una aventurera es muy divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460104,
					"content": "Pero... Jeje, todavía me queda mucho por aprender sobre los encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460105,
					"content": "#Viajer{F#a}{M#o}, ¿podrías acompañarme a completar otro encargo? Quiero hacerte más preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460108,
					"content": "¡Entonces, vamos! El encargo de hoy es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460109,
					"content": "Oh... Es escoltar un globo de carga... de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460106,
					"content": "¿Quieres que te acompañe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460107
					]
				},
				{
					"id": 200460107,
					"content": "¿Lo harías? Jeje, tengo muchas preguntas que me gustaría hacerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2004602,
			"completionStepIds": [
				2004604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004604",
							"2"
						],
						"stepId": 2004604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460201,
					"content": "#¡Listo! Gracias, viajer{F#a}{M#o}. El encargo fue viento en popa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460202,
					"content": "Pero... ¿todos los encargos son como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460203,
					"content": "Hay otros tipos de encargos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "#No te oyes muy entusiasmad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460207,
					"content": "Ya veo... ¡Está bien! ¡Entonces tendré que seguir esforzándome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460208,
					"content": "Cuando tenga suficiente dinero, ¡me llevaré a mi hermano y a mis padres de viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460209,
					"content": "Mi hermano siempre ha querido viajar, pero... como yo estaba enferma, tuvo que quedarse a cuidarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460210,
					"content": "Ahora ya me siento mejor, ¡y ya me convertí en una aventurera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460211,
					"content": "Jeje, es hora de cumplir los sueños de mi hermano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460205,
					"content": "Pronto lo entenderás...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "Oye, no pongas esa cara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2004603,
			"completionStepIds": [],
