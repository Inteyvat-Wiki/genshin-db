			"dialogs": [
				{
					"id": 250330101,
					"content": "¡Buen chico! ¿Has comido bien hoy? ¿Tienes energías para entrenar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330102,
					"content": "Gruuu, gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330103,
					"content": "¡Guau, cuánta energía! ¡Muy bien! ¡Hoy vamos a darlo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330104,
					"content": "¡Podemos hacerlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "¿Eh? Oh, ¡hola! Justo estábamos entrenando nuestras habilidades de escalada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330107,
					"content": "¡Gruuu! ¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330108,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330109,
					"content": "¿Qué tal está yendo su entrenamiento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "Bueno... Podría decirse que hay algo de progreso. Qica ha conseguido escalar hasta un punto más alto que el de la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330111,
					"content": "Es solo que Qica aún no sabe escalar bien, y necesita algo de práctica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330116,
					"content": "¿Sería mucha molestia si nos hicieras otra demostración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330117,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "¡Muchas gracias! Seguro que así me será más fácil imitar tus movimientos a la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330119,
					"content": "#Qica, fíjate muy bien en todo lo que hace {F#la aventurera}{M#el aventurero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330120,
					"content": "¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330123,
					"content": "#Entonces, ¡contamos contigo, amig{F#a}{M#o} aventurer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330124,
					"content": "Nosotros nos encargaremos de medir el tiempo que tardas en subir la montaña desde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330125,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330121,
					"content": "Presten mucha atención, ¿de acuerdo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "¡Por supuesto que sí! ¡Qica y yo no te quitaremos los ojos de encima esta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330112,
					"content": "Parece que se está recuperando bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "Así es. Mamá dice que se me da muy bien cuidar de Qica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330114,
					"content": "Qica ha mejorado muchísimo, ahora es capaz de escalar más alto que antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330115,
