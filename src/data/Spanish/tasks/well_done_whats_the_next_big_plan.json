			"dialogs": [
				{
					"id": 745310101,
					"content": "#¡{NICKNAME}, Paimon, han regresado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310102,
					"content": "Esta vez tomamos muchas imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "¡Genial! ¡Muchas gracias por su ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310105,
					"content": "Mientras ustedes me ayudaban a tomar imágenes, pensé que no podía quedarme de brazos cruzados, o me quedaría estancada para siempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310106,
					"content": "Así que me armé de valor y le pedí ayuda a la gente que pasaba. ¡Me esforcé mucho para sacar todas estas imágenes! ¡Con esto deberíamos tener suficientes datos de prueba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310107,
					"content": "#Je, sabía que no me ibas a fallar. ¡Y gracias a {NICKNAME} que estuvo dispuest{F#a}{M#o} a ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310108,
					"content": "¡Lépine-Pauline! ¿Cuándo regresaste? Ninette nos dijo que estabas ocupada con otros asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310109,
					"content": "Ah, ¡es que estoy con un tremendo negocio que me hará rica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310110,
					"content": "Últimamente he estado muy ocupada, muchas gracias por cuidar de Ninette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310111,
					"content": "Es una chica que tiene mucho talento y muy buen gusto, pero es un poco tímida. Gracias a su ayuda, ella ha podido dar un paso importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310112,
					"content": "¿De qué negocio se trata? Qué misterioso todo... ¡No le digas a Paimon que escuchaste otro rumor raro y vas a invertir todos tus ahorros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310113,
					"content": "¡Claro que no! ¡Yo, Lépine-Pauline, también aprendo de mis errores! ¡Esta vez es un proyecto increíble, totalmente garantizado y sin riesgo de pérdidas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310114,
					"content": "(Tengo un mal presentimiento...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "#Jeje, si te lo dijera ahora, pierde la gracia. Cuando esté listo, ¡serán {F#las primeras}{M#los primeros} en probarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310103,
					"content": "La lente instantánea es fascinante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
