					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "No es tan fácil, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320802,
					"content": "Si los miembros de la Brigada de Vuelo son derrotados tan fácilmente por cualquier aventurero que pasa, el capitán se enojará mucho, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320803,
					"content": "Bueno, no te desanimes, tengo que darte las gracias por no hacer quedar mal a una exdomasaurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320804,
					"content": "Vuelas bastante bien, pero aún te queda mucho para ganarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "#Si no estás satisfech{F#a}{M#o} con el resultado, ¡inténtalo de nuevo! A tu edad, hay que ser persistente y no te debe importar perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
