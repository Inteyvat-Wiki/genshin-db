			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "¿Qué te parece? ¿Competimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320202,
					"content": "Sigue el circuito cerrado y vuela a lomos de un saurio para conseguir la máxima puntuación que puedas en el límite de tiempo. <color=#00E1FFFF>Si superas el segundo nivel, me habrás ganado</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320203,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "¡Fantástico! Vamos al punto de partida del circuito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320205,
					"content": "Deja que me prepare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "Claro, ven cuando te apetezca. Volar tiene que servir para relajarse y divertirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503204,
			"completionStepIds": [
				7503204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503204",
							"2"
						],
						"stepId": 7503204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "Jajaja, muy bien. Supongo que hay que admitirlo: los jóvenes siempre acaban superando a sus mayores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320402,
					"content": "Incluso las estrellas se caen en algún momento, lo cual es todavía más verdad para las personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320403,
					"content": "Mi momento se acabó. Mi mejor opción es retirarme felizmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320405,
					"content": "¡Pero qué pocas ganas de hacerlo! Como aún no soy tan mayor ni tengo arrugas, no quiero retirarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320406,
					"content": "¡Mi carrera ha sido demasiado corta! Aún no he saboreado lo suficiente la sensación de estar en la cima y ya tengo que bajar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320407,
					"content": "De haber sabido que me daría tanta lástima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320408,
					"content": "Olvídalo, no puedo decir eso. De hecho, si pudiera vivir otra vez, tomaría las mismas decisiones que ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320409,
					"content": "Lo daría todo de mí para entrar en la Brigada de Vuelo, cosa que podría conseguir perfectamente con mis habilidades. Luego, me retiraría con la misma edad que ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320410,
					"content": "Pero, en fin, he hecho todo lo que he podido, así que no me queda más remedio que aceptarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320411,
					"content": "Tal vez la vida sea así y haya muchas cosas en las que no podemos hacer nada. Si quieres convertirte en un héroe, tienes que ser consciente de que el prestigio es algo fugaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320412,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320413,
					"content": "#No te preocupes, {M#él}{F#ella} ha volado estupendamente. ¿No me mirabas con lástima? ¿Por qué ahora pones esa cara de preocupación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320414,
					"content": "Jaja, en la vida te encuentras con todo tipo de cosas. Da igual si las aceptas o no, acabarán ocurriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320415,
					"content": "Tómalo como un consejo de vida de una exdomasaurios. Mis problemas solo los puedo resolver yo, así que no quiero que mi estado de ánimo afecte también al tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320416,
					"content": "Lo has hecho muy bien. Ojalá mis hermanos también fueran tan tranquilos como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320417,
					"content": "Paimon no sabía que tuvieras hermanos, Manyoya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320418,
					"content": "Sí, pero no son tan simpáticos como ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320419,
					"content": "Ellos también están entrenando sus habilidades de vuelo. Bueno, Acomitl solo piensa en huir, a lo mejor se está escondiendo en algún lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320420,
					"content": "Pero bueno, mejor no hablemos de esos muchachos. Hablemos de ti, me parece que tienes mucho talento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320421,
					"content": "Si tienes tiempo, puedes probar a volar más a menudo. Quizá te inviten a unirte a la Brigada de Vuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320422,
					"content": "Claro, volaré más a menudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "#¡Genial! Espero verte más por el cielo, ¡muchos ánimos, joven guerrer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503206,
			"completionStepIds": [
				7503206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503206",
							"2"
						],
						"stepId": 7503206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320601,
					"content": "Ya es hora de que mi saurio vuelva a su madriguera. ¿Debería retirarme yo también del escenario del cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320602,
					"content": "Deberías seguir volando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "Me escuchaste hablando sola, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320606,
					"content": "Voy a dejar este lugar y volver a casa una temporada, aunque aún no he hablado con mi familia sobre mi retirada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320607,
					"content": "De ahora en adelante tendré mucho tiempo libre, ¿qué debería hacer? Aún no lo tengo muy claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320608,
					"content": "Tendré que mantener la cabeza fría y hacer frente a mi siguiente etapa de la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320609,
					"content": "Creo que escucharé primero los consejos de mi familia, porque mi padre también fue miembro de la Brigada de Vuelo, y tras su retirada empezó su carrera como entrenador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320610,
					"content": "Él ya pasó por lo que estoy pasando yo ahora. Seguro que tiene buenos consejos para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320611,
					"content": "Así que me llevaré la casa flotante, pero el circuito seguirá aquí. Después de todo, los jóvenes guerreros como tú necesitan un lugar para entrenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320612,
					"content": "Manyoya, Paimon se pregunta si nos volveremos a ver algún día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320613,
					"content": "No lo sé, pero tengo el presentimiento de que haga lo que haga, nunca podré abandonar el cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320614,
					"content": "Entonces, mientras sigas pudiendo volar, es muy probable que nos volvamos a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320615,
					"content": "Hasta la próxima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "#¡Hasta otra, joven guerrer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320604,
					"content": "Manyoya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "¡Ahí estás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				}
			]
		},
