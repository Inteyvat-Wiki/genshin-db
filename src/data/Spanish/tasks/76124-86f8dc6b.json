			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "¡Listo, se acabó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240302,
					"content": "#Muchas gracias a l{F#a}{M#o}s dos, me han hecho muy feliz. Especialmente {M#tú, jovencito}{F#tú, jovencita} de cabello dorado, tienes unas habilidades impresionantes. Me atrevería a decir que eres más fuerte que ese discípulo de Guhua que conozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240303,
					"content": "#¡Soy {F#la}{M#el} mejor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Gracias a ustedes dos, he tenido un momento de revelación que no había experimentado en mucho tiempo. Para realzar el sabor de la salsa de pescado, lo mejor es añadirle un poco de carne cruda picada. De lo contrario, si se deja reposar demasiado tiempo, no habrá forma de disimular el olor a pescado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240307,
					"content": "Oh, Paimon entiende... ¿Eh? ¡Eso no tiene nada que ver con lo que estábamos hablando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "#Jaja, ¡no le den importancia a esas pequeñeces! La próxima vez, le pediré a Castiglione que me pinte más peces. ¡L{F#a}{M#o}s invitaré a comer salsa de pescado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240304,
					"content": "No fue para tanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "#Ja, no hace falta ser modest{F#a}{M#o}. Tu técnica con la espada es formidable, es evidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jinggui"
				}
			]
		},
