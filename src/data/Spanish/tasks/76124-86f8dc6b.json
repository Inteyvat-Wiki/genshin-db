				},
				{
					"id": 761240203,
					"content": "¡Muy bien, ustedes dos! Ya que han desplegado el pergamino, permítanme explicarles las reglas en nombre de esos pequeños aprendices del Clan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240204
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240204,
					"content": "Entre estos muñecos de bambú, algunos visten de <color=#00E1FFFF>azul</color> y otros de <color=#FF5E41FF>rojo</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240205,
						761240206
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240205,
					"content": "Oh, te refieres a los del Salón Wangshan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				},
				{
					"id": 761240207,
					"content": "¡Paimon también se acuerda! Tenemos que darle a todos los muñecos de bambú de <color=#00E1FFFF>azul</color>, pero sin tocar a los de <color=#FF5E41FF>rojo</color>, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240208,
					"content": "¡Jaja, exactamente! En ese caso, no hace falta que me extienda más. ¡Muéstrame tu habilidad con la espada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240206,
					"content": "Conozco las reglas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				}
			]
		},
