				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "¿Eh? Parece que por aquí hay otra pintura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "Ajá, tienes buen ojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240403,
					"content": "Esto es algo que esos chiquillos que se hacen llamar “herederos de Guhua” le encargaron pintar a Castiglione. Decían que era su valioso “campo de entrenamiento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240404,
					"content": "Aunque bueno, son todos muy orgullosos. Creen que ya son maestros absolutos y que no necesitan este tipo de entrenamiento básico, así que me regalaron la pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240405,
					"content": "¿Eh? ¿No eres del Clan Guhua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Jajaja, me encantaría decir que sí, pero por desgracia, ese chico de Guhua no tuvo las agallas de aceptarme como miembro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240407,
					"content": "Cuando estábamos acabando con unos bandidos de la Llanura Guili, ese muchacho casi pierde la vida por no dominar bien sus técnicas, y no me quedó más remedio que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240408,
					"content": "Bah, qué más da, tampoco tiene importancia. Aunque esta pintura sí que tiene su gracia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240409,
					"content": "Si te interesa, ¿por qué no la desenrollas y le echas un vistazo? No pasa nada si la rompes. De todos modos, Castiglione no tiene nada que hacer en todo el día, así que puede pintar otra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		}
	]
}