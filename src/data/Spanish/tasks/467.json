					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "Además, <color=#00E1FFFF>El Buen Cazador</color> vende alimentos e ingredientes. Ve a echar un vistazo cuando tengas tiempo.",
