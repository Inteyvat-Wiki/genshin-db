					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "¿De verdad podemos quedárnoslos? ¿No te quedarás sin ingredientes?",
