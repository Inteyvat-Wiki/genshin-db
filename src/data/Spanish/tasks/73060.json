			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika está bien, pero a Arapandu le preocupa que Aranakula esté en Monumento de Yasna y Arakunti esté en Arboleda Onírica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula... Hay demasiados hongos malvados. Si vuelven a atrapar a Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "#No sirve de nada preocuparse. Nara rubi{F#a}{M#o} es muy fuerte, rompió ese gran pedazo de hierro como si fuera papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Si arreglamos máquina divina de Váruna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
		{
