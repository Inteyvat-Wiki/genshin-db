					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600501,
					"content": "Arabalika debería volver pronto de Ruinas de Dahri. Con su ararakalari, no tendrá que temer ni a pedazos de hierro ni a hongos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600502,
					"content": "Si Aranakula fuese mitad de fuerte que Arabalika, podría proteger jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600503,
					"content": "Pero Aranakula no tiene ni mitad de mitad de fuerza que Arabalika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600504,
					"content": "*Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600505,
					"content": "#Aranakula puede llegar a ser tan valiente como nara rubi{F#a}{M#o}. Solo necesita tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
