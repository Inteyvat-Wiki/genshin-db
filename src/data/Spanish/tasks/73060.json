			"dialogs": [
				{
					"id": 730600701,
					"content": "Aranakula está en Monumento de Yasna. A Arapandu le preocupa porque ahí hay muchos hongos. Y Arabalika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600702
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600702,
					"content": "Arabalika no irá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600703,
					"content": "Aranakula sabe muy bien cómo esconderse. Hongos no encontrarán. ¿Por qué se preocupa tanto Arapandu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
