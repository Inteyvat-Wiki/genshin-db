			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600401,
					"content": "En Arboleda Onírica se volverá a escuchar suave melodía, murmullo de agua, batir de alas de pájaros, crujir de ramas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "#A Arakunti le gusta hablar con nara rubi{F#a}{M#o} y Paimon. Paimon es muy divertida, lástima que no quiera convertirse en semilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "Eso es porque Paimon no es aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "Calma volvió a Arboleda Onírica. A Arapandu ya no le preocupa tanto que Arabalika esté en Ruinas de Dahri. Pero en Monumento de Yasna sigue habiendo muchos hongos. A Arapandu le preocupa cómo estará Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
		{
