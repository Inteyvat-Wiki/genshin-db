			"dialogs": [
				{
					"id": 730600101,
					"content": "#Aranakula está en Monumento de Yasna, Arabalika se fue a Ruinas de Dahri, Arakunti está en Arboleda Onírica. Nara {NICKNAME}, Paimon, tengan cuidado.",
					"roleType": "TALK_ROLE_NPC",
