				"points": []
			},
			"dialogs": [
				{
					"id": 730600601,
					"content": "En Monumento de Yasna hay muchos tipos malos, pero Aranakula regresó, así que ahora todo debería estar bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "#Nara rubi{F#a}{M#o} y Aranakula esquivaron todos ataques de tipos malos y limpiaron piedra de recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Cuando hayamos arreglado máquina divina de Váruna, podremos llevar flores de jardín. Aranara nunca olvidaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "Ahora solo queda que Arakunti regrese de Arboleda Onírica. Cuando vuelva, nos desharemos de bicho malo que mordisquea máquina divina de Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
