			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "#Nara rubi{F#a}{M#o}, parece que no tienes miedo a nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "#Nara rubi{F#a}{M#o} es valiente, igual que nara Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "#Aunque a Arapandu le preocupan Arabalika, que está en Ruinas de Dahri, y Arakunti, que está en Arboleda Onírica, con ayuda de nara rubi{F#a}{M#o}, estaremos bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "#Cuando arreglemos máquina divina de Váruna, ningún tipo malo podrá volver a causar alboroto en jardín. A Aranakula le gustaría regalarte algunas flores de jardín, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
		{
