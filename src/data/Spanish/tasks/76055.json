			"dialogs": [
				{
					"id": 760550101,
					"content": "(Parece que <color=#FFCC33FF>Lauma</color> ha oído algo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "... Qué extraño. Acabo de oír algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "(¡Oh, una nueva clienta! ¡Gira la ruleta, detenla, y saldrá algo delicioso!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550104,
					"content": "(¿Eh? ¿Por qué no gira la ruleta? ¡Date prisa, quiero comer buena comida!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550105,
					"content": "Suena como... ¿un perrito? Girar la ruleta, buena comida... ¿Qué quiere decir eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(¡Hola! Puedes hablar conmigo. Gira la ruleta, rápido, o no podré comer nada delicioso.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550107,
					"content": "¿Es que tienes hambre? He traído algunas galletas. Toma una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(¿Eh? No giras la ruleta, pero me das de comer... Humm, comeré un poco entonces.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550109,
					"content": "(Gracias. Yo soy Pávlov, y te agradezco el detalle de las galletas. Están muy ricas. Pero no has girado la ruleta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550110,
					"content": "No es nada, pero... ¿Qué es esa ruleta de la que hablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Si giran la ruleta y luego la hacen detenerse, cae comida rica. Siempre es así.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550112,
					"content": "(¿No vas a girar la ruleta? Todos los que lo hicieron se pusieron muy contentos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550113,
					"content": "No creo que sea necesario. Parece que... ¿vives bien aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Claro, claro. La gente juega conmigo, la ruleta juega conmigo y hay comida deliciosa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pávlov"
				},
				{
					"id": 760550115,
					"content": "Eso está bien. Bueno, saluda a tu dueño. Yo debo irme ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Oh... ¡Hasta la próxima! ¡Vuelve pronto!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pávlov"
				}
			]
		},
