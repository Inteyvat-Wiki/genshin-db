			"dialogs": [
				{
					"id": 413311001,
					"content": "Ah, volviste. Buen trabajo. Siento que estés yendo de aquí para allá en una festividad tan importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311002
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413311002,
					"content": "Solo cumplo con mi deber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413311003
					]
				},
				{
					"id": 413311003,
					"content": "Eres muy amable. Yo también puse de mi parte, e hice unas cuantas linternas celestes para la gente de la Aldea Chingtsé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311004
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413311004,
					"content": "Si quieres, puedes venir a verme en la entrada de la aldea por la noche. Liberaremos las linternas celestes y festejaremos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413311005,
					"content": "Pero ¿a dónde habrán corrido esos niños? No puedo ir a buscarlos con estas piernas desgastadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413311006,
					"content": "Si tienes tiempo, ¿podrías buscar a los niños? Les encanta liberar linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311007
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413311007,
					"content": "Y si de paso puedes avisar a los demás, sería perfecto. Después de todo, mientras más, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				}
			]
		},
