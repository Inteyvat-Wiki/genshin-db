					"nextDialogs": [
						413312003
					]
				},
				{
					"id": 413312003,
					"content": "¿Qué? ¿Podemos liberarlas en la noche? ¡Genial! Iré a decirle a mi hermano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312004
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312004,
					"content": "El abuelo dice que, al liberar las linternas celestes, puedes pedir un deseo. ¿Es cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312005
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312005,
					"content": "Hay un deseo muy importante que quiero pedir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312006
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312006,
					"content": "¿Qué deseo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413312007
					]
				},
				{
					"id": 413312007,
					"content": "Yo... no, no. Papá dice que los deseos no se vuelven realidad si los dices en voz alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312008
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312008,
					"content": "Iré en un rato más a decirle a mi hermano. ¡Seguramente él también tiene un deseo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312009
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312009,
					"content": "Humm... Espera, al parecer tenemos que escribir nuestros deseos en la linterna. Entonces, ¿no funciona si lo pido directamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "You"
				}
