			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abuela Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "Una vez más, el Rito de la Linterna ha llegado. *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310202,
					"content": "¿Le preocupa algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "El ambiente debería ser más animado durante el Rito de la Linterna, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310204,
					"content": "Pero en la Aldea Chingtsé solo hay niños y ancianos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310205,
					"content": "Esos jóvenes que van a la ciudad a trabajar y no pueden tomarse ni un día libre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310206,
					"content": "... o que viven muy lejos y no tienen tiempo para regresar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310207,
					"content": "Este es un festival para pasarlo juntos y en familia, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310208,
					"content": "Entiendo que puedan tener dificultades, pero en un festival tan importante... *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310209,
					"content": "Ay, no diré más. No puedo ponerme así en una celebración tan grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310210,
					"content": "Por cierto, si no te importa, ¿podrías ayudar a la Srta. Bai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310211,
					"content": "Esa jovencita dijo que quiere preparar una mesa con alimentos para todos, pero me temo que ha de tener las manos llenas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310212,
					"content": "¡Déjemelo a mí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Muchas gracias, eres muy amable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413310213,
					"content": "No se preocupe, iré a ayudarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
