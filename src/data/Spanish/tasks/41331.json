					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413313705,
					"content": "Anda, Abuela Ruoxin, si no comes más, toda la comida que preparé se enfriará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 413313706,
					"content": "¡Guau, cuántas cosas deliciosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 413313707,
					"content": "¡Abuela, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "Dongdong"
				},
				{
					"id": 413313708,
					"content": "Estos niños... Bien, bien, vayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413313709,
					"content": "¿No va a ir usted?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "¿Yo? No tengo prisa, quiero quedarme un rato más a ver las linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413313711,
					"content": "#Por cierto, esto es para ti, jovencit{F#a}{M#o}. Es mi forma de expresar mi agradecimiento por ayudarnos en esta festividad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413313712,
					"content": "Gracias, abuela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "#No hay de qué. Veo que eres muy joven, pero ir de aquí para allá debe haberte dejado exhaust{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413313714,
					"content": "¿Por qué no te quedas un rato a descansar y a divertirte con los demás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 413313715,
					"content": "Después de haber corrido por todos lados, no te hará daño descansar un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				}
			]
		},
