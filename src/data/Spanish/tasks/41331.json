			"dialogs": [
				{
					"id": 413310301,
					"content": "Aún me faltan muchos ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 413310302,
					"content": "Vine a ayudarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "#¿Eh? Oh, si estás dispuest{F#a}{M#o} a ayudarme, vienes en el momento perfecto. Justo me estaba preguntando cómo comprar todos estos ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 413310304,
					"content": "Veamos... ¿Puedes ayudarme a conseguir tres pedazos de carne cruda y tres pedazos de carne de ave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "Srta. Bai"
				},
				{
					"id": 413310305,
					"content": "Yo me hago cargo del resto de los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Bai"
				}
			]
		},
