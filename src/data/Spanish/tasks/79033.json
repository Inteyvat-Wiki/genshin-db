				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "Bueno, la imagen está justo en el centro de la escena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330102,
					"content": "¿Qué hacen estos dos? Parece que ella está diciendo algo y él está sentado en el suelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330103,
					"content": "¡Ya sé! ¡Le está contando una historia! Deben de estar a punto de irse a dormir, por eso la imagen muestra a la mujer leyendo un cuento a quien está sentado en el suelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330104,
					"content": "¿A los Fatui también les gustan los cuentos para dormir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "A lo mejor algunos de los Fatui también necesitan estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330106,
					"content": "Agafya, Persikov nos ha ordenado que realicemos algunas pruebas de recepción de señal. Parece que tenemos que ir los cuatro... Chevka se enfadará conmigo por esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330107,
					"content": "Eso no va a pasar, Yakov. Es una orden que viene de arriba. Chevka no te echará la culpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330108,
					"content": "Ay, si realmente te da tanto miedo, iré contigo a hablar con Chevka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330109,
					"content": "Oh, así que, después de todo, no estaba contando una historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330110,
					"content": "Parece como si este fragmento saliera de la nada. Es imposible saber qué está pasando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
