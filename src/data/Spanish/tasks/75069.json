						750691203,
						750691207
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691203,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "Soy... un guerrero del grupo de aventureros. Aunque no sea tan valiente como nuestro líder, el señor Taika, hay otras cosas en las que puedo ser útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691205,
					"content": "Yo me encargo de proteger nuestro campamento... Cuando no logro conciliar el sueño por la noche, me levanto a patrullar para mantenerlo seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691206,
					"content": "No sé desde cuándo, pero cada vez hay menos gente en el campamento... ¿Eh? Qué extraño... ¿Por qué estoy aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691207,
					"content": "No necesito nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691208
					]
				},
				{
					"id": 750691208,
					"content": "#Ya veo... Por cierto, tengo un consejo para ti, guerrer{F#a}{M#o}. Será mejor que te vayas lo antes posible.",
