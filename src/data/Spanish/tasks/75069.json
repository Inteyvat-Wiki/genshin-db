			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "*Suspira*, aquí no viene mucha gente... Después de todo, es un lugar peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "¿Acaso también eres miembro del grupo de aventureros?... Humm, me dijeron que la sombra de la serpiente negra gigante descendió del Tonatiuh... Ten mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "O mejor, márchate de este lugar cuanto antes. En el grupo de aventureros también hay criaturas inhumanas escondidas... Esas voces, esas maldiciones... son atronadoras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "En cambio, aquí me siento mucho más tranquilo gracias a la cascada. Jaja, dado que el ruido de la cascada es tan fuerte, no deja lugar para otros sonidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
							"2"
						],
						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Una hoja rasgada. Al comienzo, se logran apreciar unas líneas escritas con cuidado...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690502,
					"content": "“... Los monstruos del Abismo se están multiplicando cada vez más, pero esto ya se veía venir... El grupo de aventureros al final fracasó, y el plan de retirada ya está en curso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690503,
					"content": "“Hay que hacer que el resto salga de aquí sano y salvo, y tener mucho cuidado con los que desaparecen de repente por la noche, o de los que regresan de lugares sin luz”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690504,
					"content": "“... Aparecen cada vez más monstruos del Abismo, y quizás pronto podamos descubrir su guarida, pero antes de eso...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690505,
					"content": "(El texto de abajo empieza a ser ininteligible...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690506,
					"content": "“Uff, qué frío... hace mucho frío. Allí... allí ya no queda sangre...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690507,
					"content": "“El sonido de la cascada es muy fuerte... Sí, así está bien. Mientras esté... bajo la cascada, habrá silencio. Las caras pálidas, sus bocas abiertas, la sangre drenada...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690508,
					"content": "“Allí... hay algo... ¿Qué es eso? Eso que está allí...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Diario de Quenin"
				},
				{
					"id": 750690509,
					"content": "“Bajo la cascada, bajo la cascada, bajo la cascada, bajo la cascada, bajo la cascada, bajo la cascada, bajo la cascada, bajo la cascada, bajo la cascada...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario de Quenin"
				}
			]
		},
