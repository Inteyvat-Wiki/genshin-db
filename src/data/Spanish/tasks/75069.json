			"dialogs": [
				{
					"id": 750690801,
					"content": "(Un cuerpo frío con la apariencia de Quenin. Por alguna razón, no se ha descompuesto y parece detenido en el tiempo...).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690802
					],
					"speakerTitle": "Cuerpo frío"
				},
				{
					"id": 750690802,
					"content": "(Además, a juzgar por los alrededores, parece que lleva bastante tiempo en este estado...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuerpo frío"
