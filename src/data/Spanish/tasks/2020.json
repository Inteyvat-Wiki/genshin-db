	"talks": [
		{
			"id": 202003,
			"completionStepIds": [
				202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202003",
							"2"
						],
						"stepId": 202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Satisface mi curiosidad. ¿Cuál es la razón por la que te encuentro ante mí una vez más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200302,
					"content": "¿Esperas que tu temeridad proteja a esa gente? O... ¿simplemente quieres tener una audiencia conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200303,
					"content": "Los Fatui engañaron a la Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "¿Eh? No me habrás despertado de mi estado de eterna meditación solo para decirme esto, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200306,
					"content": "Si es así, entonces me subestimas. Estoy muy bien informada sobre el Decreto de captura de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200307,
					"content": "¿Sabes todo lo que ocurre fuera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "No, solo sé todo lo pertinente a la eternidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200309,
					"content": "El Decreto de captura de Visiones tiene mi aprobación tácita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200310,
					"content": "Las acciones de los Fatui hasta ahora no constituyen una amenaza para la eternidad, de lo contrario... habrían sido purgados hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200311,
					"content": "Pero el Decreto de captura de Visiones es perjudicial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Es natural que las ambiciones individuales sean incompatibles con la eternidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200314,
					"content": "Lo que tal vez no sepas es que, con demasiada frecuencia... la gente tiene mucho más que perder al perseguir sus sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200315,
					"content": "Piénsalo así: nadie perderá la vida porque le quiten su Visión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200316,
					"content": "Más bien, los que perdieron sus vidas son quienes insistieron en perseguir sus propias aspiraciones, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "#Viajer{F#a}{M#o}, para mí, tu existencia es única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200319,
					"content": "Parece que hay una incertidumbre ilimitada en ti. Por decirlo de otro modo, eres lo más alejado de la eternidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200320,
					"content": "Así que no insistiré en que comprendas el significado de mis acciones. Lo que importa es que recorro el camino de la eternidad en nombre de mi pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200321,
					"content": "Este plano de la eutimia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Es producto de tu conciencia, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "Así es. Me sorprende que lo entiendas tan bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200324,
					"content": "En fin... Estás buscando una oportunidad para desestabilizar mi voluntad, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200325,
					"content": "No estoy aquí para debatir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Estoy aquí para demoler tus ideas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200328,
					"content": "Que así sea. Entonces, tú que desafías a la eternidad... es hora de que me ilumines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200312,
					"content": "La gente de Inazuma ha pagado un precio muy alto por el decreto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "El Decreto de captura de Visiones nunca debería haber existido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Has perdido, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200503,
					"content": "... Sí, es cierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200504,
					"content": "¿Por qué no puedes confiar en tu gente y en el poder de sus ambiciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Estas ambiciones han trascendido el espacio y el tiempo. Son algo que nadie puede apagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "Cuando las personas avanzan con todas sus fuerzas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "¿Esta es la lección que aprendiste de tu viaje a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "¿Hay naciones donde los humanos dejan de lado a su dios y siguen adelante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "Entonces, ¿debemos abandonar la noción de progreso... por una ilusión vana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "... Tú y yo hemos presenciado la gran pérdida que el progreso puede traer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200514,
					"content": "La eternidad... la eternidad es el único camino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200515,
					"content": "El Orden Celestial es una tontería irrelevante en lo que a mí respecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "Al fin y al cabo, lo único que quieres es proteger a tu amada Inazuma, por siempre y para siempre, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "Esa es una simplificación excesiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200518,
					"content": "¿Pero vale la pena que esta nación exista por toda la eternidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Despojada de ambiciones y de potencial de cambio, lo único que hace es simplemente existir. Es la cáscara hueca de una nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Me pregunto qué pérdida supondría realmente que una nación así fuera destruida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, retira tus palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200522,
					"content": "La eternidad sin cambios es la promesa que le hice a mi pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200523,
					"content": "Pero lo que tu pueblo necesita de ti no son tus promesas. Quieren tu atención... tu mirada divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "¿Te refieres a las Visiones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200525,
					"content": "Los humanos tienen una vida de apenas cien años. No pueden permitirse el lujo de soportar más pérdidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200526,
					"content": "Pero yo lo he experimentado todo. Por eso he elegido guiarlos por el camino correcto hacia la eternidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200527,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "Pero la eternidad es un destino demasiado cruel para ti, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "¿Para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200530,
					"content": "No solo has dejado de prestar atención al mundo, sino que has dejado de prestarte atención a ti misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "Debes haberte sentido muy sola aquí durante siglos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "Pero es necesario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200533,
					"content": "Te perderás muchas cosas por rechazar el progreso... Buscas evitar la pérdida, ¿pero has considerado todo lo que pierdes al permanecer aquí inmóvil por toda la eternidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "Es obvio que te sientes sola, y sin embargo, por el bien de la eternidad, eliges prolongar tu soledad hasta el infinito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Dime, ¿por qué el cielo, que antes era tan oscuro aquí, vuelve a brillar? ¿Por qué ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Este es tu plano de la eutimia, tu mundo interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Así que solo puede significar... que estás feliz de verme de nuevo. La soledad de este lugar te resulta insoportable desde hace mucho tiempo, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Yo... no tengo nada que decir al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200539,
					"content": "Oh, pues yo tengo mucho que decirte. Deja que te cuente todo lo que ha pasado en los últimos siglos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "¿Cuánto tiempo te llevará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200541,
					"content": "Como kitsune, tengo una memoria excelente. Recuerdo cada detalle de los últimos siglos con toda claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Así que probablemente tardaré otros tantos siglos en transmitírtelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Jeje... Miko, nunca pensé que tendría la oportunidad de volver a encontrarme contigo de esta manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200544,
					"content": "*Suspira*, verte de nuevo es un cambio en la eternidad... y una sorpresa muy grata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200545,
					"content": "Jeje, ya que lo admitiste, supongo que podemos seguir siendo amigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Qué conversación tan infantil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200547,
					"content": "No obstante, ahora que he sido derrotada por su plan, honraré su deseo de abolir el Decreto de captura de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200548,
					"content": "Pero con respecto a la eternidad y a la cuestión de si esta nación debe seguir adelante, necesito tiempo para pensarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200549,
					"content": "Jeje, eres tú la que se ha comportado como una niña desde el principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "Pueden superar las expectativas de los dioses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "Pueden incluso hacer el trabajo de los dioses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
