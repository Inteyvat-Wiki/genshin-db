						10330103
					]
				},
				{
					"id": 10330103,
					"content": "(Xiao no dice nada más. Un torrente de emociones pasan a través de su rostro mientras mira el templo de Pervases.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10330104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10330104,
					"content": "(Su rostro refleja tristeza, decepción y consuelo, pero son solo una pequeña parte de un todo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10330105
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10330105,
					"content": "(Su expresión es como la de alguien que ha estado bajo una ventisca durante tanto tiempo que su mirada está cansada, hasta que un día al fin encuentra un refugio de la nieve.)",
