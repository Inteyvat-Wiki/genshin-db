				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "... ¿E-Eh? ¿Quiénes son? ¡¿Cómo osan despertarme?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150402,
					"content": "¡¿Eh?! ¿Quién está hablando? ¡Qué miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150404,
					"content": "¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "¡Jajaja! ¡Así es! ¡Teman! Si no estuviese confinado a esta roca, ¡ya se habrían convertido en mi almuerzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150406,
					"content": "¿Qué...? ¡Ah! Eres una estatua de piedra que habla... ¡Paimon pensó que eras un monstruo o algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "¡Hum! ¿Acaso una estatua que habla no es algo aterrador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150408,
					"content": "Pues, ya hemos visto muchas estatuas así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "#¡¿Qué?! *Suspira*. Está bien, parece que no podré asustarl{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150410,
					"content": "¿Por qué tienes que asustar a la gente? ¡Solo eres una estatua de piedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "¡Hum! Aunque solo sea una estatua de piedra, ¡esta es la morada de Herbóloga! Cuando vivía aquí, no le gustaba que la molestaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150412,
					"content": "Así que, aunque ella ahora ya no esté, ¡seguiré asustando a los molestos que se acercan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150413,
					"content": "#Sin embargo, en ustedes siento un aura diferente a la de los mortales comunes, y teniendo en cuenta que no pude asustarl{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150414,
					"content": "¿Podría pedirles un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150415,
					"content": "¿Eh? ¿De qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "*Ejem*, ¡observen esas mariposas coloridas que vuelan por ahí! Están por todas partes después de que Herbóloga se marchara de este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150417,
					"content": "¡Shh! ¡Espera! Tienes una en la cabeza. Un momento, deja que te la quitemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
