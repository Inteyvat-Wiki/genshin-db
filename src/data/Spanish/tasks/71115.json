						],
						"pointId": 310100247
					}
				]
			},
			"dialogs": [
				{
					"id": 711151101,
					"content": "¡Oye! ¡Mentiroso! ¡Guiamos a todas las mariposas hacia los recipientes, pero el árbol adéptico sigue igual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "#¿Eh...? ¿Quién está ahí? ¡¿Cómo se atre...?! ¡Ah! Son ustedes, amables human{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711151103,
					"content": "¡Ah! Solo lo decía por decir, no creí que conseguirían guiar a las mariposas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711151104,
					"content": "¡No! Lo que quiero decir es que... ¡Siento el poder adéptico! ¡Solo necesitamos recitar en voz alta el conjuro que Herbóloga nos dejó para que el árbol adéptico renazca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711151105,
					"content": "¡Esperen! Olvidé el conjuro, déjenme pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711151106,
					"content": "“Nace el árbol en invierno, pero se marchita con el paso del tiempo. Cuando la primavera llegue, todo a su esplendor vuelve...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711151107,
					"content": "Mariposas coloridas... revolotean... No recuerdo cómo seguía, pero el final quiere decir que todo vuelve a renacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Figurilla adéptica despreocupada"
				}
			]
		},
