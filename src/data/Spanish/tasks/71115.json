			"dialogs": [
				{
					"id": 711151201,
					"content": "¡Guau! ¡Ha cambiado por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "#¡Jeje! Herbóloga me pidió que cuidara del árbol. ¡De ninguna manera iba a dejar que se marchitara! Gracias, amables human{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711151203,
					"content": "¡Ni siquiera te acuerdas del conjuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "¡Ese detalle no es importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711151205,
					"content": "Por cierto, si les interesa, ¡tengo otro secreto que contarles! Busquen una rama y pónganla en el recipiente que está fuera de la morada, y la puerta de piedra se abrirá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Figurilla adéptica despreocupada"
				}
			]
		},
