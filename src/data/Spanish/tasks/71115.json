			"dialogs": [
				{
					"id": 711150601,
					"content": "*Fiu*... Sí, ¡como esa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150602,
					"content": "Herbóloga trajo estas mariposas para decorar la entrada de la morada. Pero tiempo después, el mecanismo se estropeó. Antes, estas mariposas y recipientes medicinales se usaban para nutrir el árbol adéptico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150603,
					"content": "¿El árbol adéptico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "¡Jeje! ¡Así es! Herbóloga lo plantó hace muchos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150605,
					"content": "Aunque ahora está marchito, Herbóloga dijo que mientras las mariposas no se dispersen por completo, ¡el árbol podrá renacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150606,
					"content": "*Suspira*... Cuando se quedó sin poder para mantener su apariencia humana, se marchó de este lugar. Me pregunto cómo estará ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150607,
					"content": "¿Entonces qué hacemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, perdón, estaba inmerso en los recuerdos de Herbóloga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150609,
					"content": "*Ejem*, ¡escuchen! Guíen a las mariposas hacia los recipientes medicinales para que el árbol renazca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150610,
					"content": "¡Jeje! Este es el mecanismo de los Adeptus que Herbóloga diseñó, ¿no es una maravilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150611,
					"content": "Lo intentaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "#¡Cuento con ustedes, amables human{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150613,
					"content": "¿Por qué son mariposas coloridas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "¿Eh? Buena pregunta... ¿Tal vez sea porque a Herbóloga le encantaban ese tipo de mariposas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150615,
					"content": "#En fin, por favor, guíen a las mariposas hacia los recipientes medicinales. Cuento con ustedes, amables human{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Figurilla adéptica despreocupada"
				}
			]
		},
