					}
				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "*Fiu*... Sí, ¡como esa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150502,
					"content": "Herbóloga trajo estas mariposas para decorar la entrada de la morada. Pero tiempo después, el mecanismo se estropeó. Antes, estas mariposas y recipientes medicinales se usaban para nutrir el árbol adéptico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150503,
					"content": "¿El árbol adéptico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "¡Jeje! ¡Así es! Herbóloga lo plantó hace muchos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150505,
					"content": "Aunque ahora está marchito, Herbóloga dijo que mientras las mariposas no se dispersen por completo, ¡el árbol podrá renacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150506,
					"content": "*Suspira*... Cuando se quedó sin poder para mantener su apariencia humana, se marchó de este lugar. Me pregunto cómo estará ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150507,
					"content": "“... Mientras que las mariposas multicolores converjan en el recipiente, el árbol marchito podrá renacer...”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "¡Sí! ¡Eso mismo! Pero ¿cómo lo supieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "Figurilla adéptica despreocupada"
				},
				{
					"id": 711150509,
					"content": "#¡No importa! Si guían a las mariposas hacia los recipientes, el árbol renacerá. ¡Cuento con ustedes, amables human{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Figurilla adéptica despreocupada"
				}
			]
		},
