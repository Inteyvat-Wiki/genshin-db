			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "#¡Viajer{F#a}{M#o}, regresaste! ¿Cómo te fue? ¿Conseguiste las imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Tengo las imágenes y las muestras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "#Guau, ¡qué rápido! Se nota que eres {F#una aventurera}{M#un aventurero} con experiencia, eres increíble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "#¡Gracias, viajer{F#a}{M#o}! Humm... ¡Ya sé! ¿Qué tal si te cocino algo delicioso como muestra de mi agradecimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "¿Qué te parece? Se ve bastante bien, ¿no? ¡Espero que lo disfrutes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Voy a seguir escribiendo mis notas. Humm... Estas plantas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Tengo que preguntarle a Jack si sabe cómo preservarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "En cuanto a las cecilias, se verían mejor en un jarrón en lugar de usarlas como muestras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
