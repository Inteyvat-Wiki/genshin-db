				{
					"id": 210080401,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "La Llanura Guili yace sobre formaciones rocosas, así que algunas áreas son un poco más escarpadas, como la pendiente en dirección a la torre de vigilancia al oeste de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080403,
					"content": "Por otro lado, en dirección al mar al este es plana. Si tienes tiempo, debes ir y visitar la Costa Yaoguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
