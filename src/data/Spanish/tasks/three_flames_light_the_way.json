			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "Hola viajer{cf#a}{cm#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080001,
					"content": "¿Qué le pasa a estas antorchas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "#Ah, hola, viajer{F#a}{M#o}. ¿Puedes ver tres torres de vigilancia allí adelante? Sus antorchas deberían estar encendidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080003,
					"content": "Los caminos a lo largo de la Llanura Guili ya son difíciles de atravesar de por sí, así que peor aún cuando hay monstruos al acecho. Las antorchas no solo iluminan el camino para los viajeros, sino que también indican que no hay amenaza de monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080004,
					"content": "Pero estaba tan ocupado deshaciéndome de los monstruos en el área que me olvidé por completo de avivar las antorchas. Cuando me di cuenta, ya se habían apagado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "Es que... vendrán a revisar las antorchas. Si vas tú, podré entretenerlos y ganar un poco de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080103,
					"content": "No es bueno que estés parado aquí si estás a solas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080104,
					"content": "#¡Así que por favor, viajer{F#a}{M#o}, ve y enciende la antorcha por mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080201,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080203,
					"content": "Hay tres torres de vigilancia a lo largo del camino, cada una con su propia antorcha. Nos vemos aquí después de que las enciendas, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080204,
					"content": "Al final del camino hay una Estatua de Los Siete. Puedes ir de paso a visitarla. Quizás puedas recibir la bendición del Arconte Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080205,
					"content": "Puede sonar fácil, pero es algo que debe hacerse, así que, ¡gracias y no lo olvides!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
