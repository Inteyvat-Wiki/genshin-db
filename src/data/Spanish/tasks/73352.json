			"dialogs": [
				{
					"id": 733520101,
					"content": "#Hola, pequeña y viajer{F#a}{M#o} de tierras foráneas. ¿Se están divirtiendo en el Festival Sabzeruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520102,
					"content": "#Si aún están de humor, yo, el Maestro Juguetero, l{F#a}{M#o}s invito a probar un nuevo juego: ¡el Vaivén de carrozas! Un juego que solo está disponible durante el Festival Sabzeruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520103,
					"content": "¿Vaivén de carrozas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520104,
					"content": "Con escuchar el nombre, ¡Paimon ya puede imaginar a Nahida sentada en una carroza de flores moviendo su cabecita alegremente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520105,
					"content": "¡De solo pensarlo ya me siento feliz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "¡Claro! Que la Arconte Dendro sea siempre feliz es el deseo de todos nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520108,
					"content": "Las asociaciones que hacen... forman una escena tan hermosa que merece plasmarse en un lienzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520109,
					"content": "Sin embargo, este juego es más animado. Más que una celebración, es más bien una aventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520110,
					"content": "“Ya sea inteligente o no, ya sea travieso o no, todo niño que tenga un corazón puro recibirá su propia carroza durante el Festival Sabzeruz”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520111,
					"content": "“En esta carroza, los niños comenzarán su propio viaje único e inigualable. A pesar de que se encuentren con dificultades, las superarán todas y lograrán hallar el tesoro de las mil flores...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520112,
					"content": "Paimon es inteligente y es buena chica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "#Jeje, ¡tienes razón! ¡Nosotr{F#as}{M#os} también podemos hacernos con el tesoro de las mil flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520115,
					"content": "Jaja, muy bien. Pues entonces, ¡diviértanse con la carroza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520113,
					"content": "#Somos expert{F#as}{M#os} en superar dificultades.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "Ay, qué ganas de ver a Nahida haciendo eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}