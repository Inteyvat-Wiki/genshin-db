			"dialogs": [
				{
					"id": 220280501,
					"content": "Este es el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280502,
					"content": "He oído que, hace mucho tiempo, un guardia hizo una ofrenda de muchas grullas de papel aquí para desear que todo el mundo en Hanamizaka pudiera vivir en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280503,
					"content": "Poco después, se produjo un incendio en las cercanías y una casa se prendió fuego. La casa estaba construida con materiales de mala calidad, por lo que el fuego acabó con ella muy rápidamente y, por suerte, no se extendió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280504,
					"content": "Todo el mundo cree que se debió a la protección de la Arconte. Por eso yo también doblé algunas grullas de papel y las traje aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280505,
					"content": "Pero no hablemos más de eso. ¿Qué deberíamos ofrecer esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280506,
					"content": "Tal vez obtengamos una respuesta si ofrecemos grullas de papel, como ese guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280507,
					"content": "Pero como este altar está cerca de la casa de té, ¿quizás sería mejor hacer una ofrenda de caramelos con sabor a matcha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280508,
					"content": "Creo que sí. Además, me gustan mucho los caramelos con sabor a matcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280509,
					"content": "#¿Qué opinas, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
