						220280801
					]
				},
				{
					"id": 220280801,
					"content": "¡Genial! ¡Eso haremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280802
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280802,
					"content": "Espero que la Arconte también me responda esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280803,
					"content": "Volveré mañana para ver si ocurrió algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280804,
					"content": "Gracias por venir conmigo. ¡Por favor, toma esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280805,
					"content": "Espero que la Arconte responda a mis deseos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
