			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#¡Viajer{F#a}{M#o}! ¡Escucha, escucha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "Después de la ofrenda que le hice al altar, mi deseo se cumplió. Al menos, una pequeña parte. Pero aunque solo sea así, esta debe ser la respuesta de la Arconte, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "¿Cuál era tu deseo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Ah, pedí que el creador del manga que estoy leyendo fuera más productivo. ¡Un tomo cada dos días sería lo mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "Entonces, ¡el creador duplicó la cantidad de contenido nuevo en un solo tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "Sin embargo... también oí que se va a tomar un descanso de tres tomos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "Parece una forma de cumplir deseos bastante equilibrada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Humm... De todos modos, estoy seguro de que la Arconte escuchó mi deseo. Eso significa que, si no se cumplió por completo, ¡es porque no ofrecí suficientes cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "¡Así que hoy vamos a hacer una ofrenda en otros altares! De este modo, ¡estoy seguro de que mi deseo se cumplirá por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "Pregunté a mis padres y me dijeron que hay otros dos altares por aquí. Uno está cerca de la Casa de Té Komore y el otro está en la salida de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "#¿A qué altar crees que deberíamos ir primero, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Entonces, ¿no te faltará un tomo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
