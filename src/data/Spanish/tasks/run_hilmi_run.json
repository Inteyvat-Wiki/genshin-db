					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "Jeje, te dije que era un gran corredor. ¿Acaso me subestimaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390405,
					"content": "Pero, aunque somos muy rápidos, Habachi consigue alcanzarnos. ¿Por qué será?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390406,
					"content": "Debe haber un atajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "¿Tú crees? Humm, parece que no hay ningún atajo por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390409,
					"content": "De todas formas, vuelve a jugar con nosotros la próxima vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390410,
					"content": "Digo... ¡Acompáñanos a entrenar! A entrenar ese juego... ¡“Escondite en la naturaleza”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390411,
					"content": "¡Claro! Si no podemos correr más rápido que Habachi, entonces hay que rodearlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390412,
					"content": "¿No lo intentamos ya antes? Habachi siempre se da cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390407,
					"content": "Debe haber algún truco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "Co-corres muy rápido...",
					"roleType": "TALK_ROLE_PLAYER",
