				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "¡Oye! ¡Espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390102,
					"content": "#¿Eres {F#una aventurera}{M#un aventurero}? Ya sabes, de {F#las}{M#los} que han vivido muchas aventuras y son buen{F#as}{M#os} luchando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390103,
					"content": "Sí, algo así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#¿Has visto, Hilmi? ¡Es {F#una aventurera}{M#un aventurero}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390106,
					"content": "#¿Pero {F#las aventureras}{M#los aventureros} no usan ropa de color verde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390107,
					"content": "Yo soy fuerte, no necesito usar esa ropa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390110,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390111,
					"content": "¡Entonces puedes ayudarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390112,
					"content": "¿Has visto el almacén de la aldea? Habachi dice que contiene cosas muy importantes y que debemos protegerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390113,
					"content": "También dijo que si los malos atacan el pueblo, tendrá que detener el ascensor y cortar el puente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390114,
					"content": "Pero el almacén está lejos del ascensor. Eso significa que Habachi tendría que correr si quisiera detenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390115,
					"content": "Le dijimos que podíamos entrenar con él, pero no nos hace caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390116,
					"content": "Pues podría ignorarnos también cuando queremos ir a lanzar piedrecitas al agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390117,
					"content": "*Ejem*, bueno, si los malos atacan la aldea y Habachi no puede correr, nosotros tendremos que detener el ascensor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390118,
					"content": "#Tú eres {F#una aventurera}{M#un aventurero}, así que seguro que corres muy rápido. ¡Ayúdanos a entrenar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390119,
					"content": "Está bien, correré con ustedes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "¡Genial! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390126,
					"content": "Ya decidimos por dónde comenzar. ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390127,
					"content": "Jeje, esta vez será contra mí. Debo advertirte, soy un gran corredor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390121,
					"content": "Pueden confiar en Habachi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "¡Juega con nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390123,
					"content": "¡Ayúdanos a entrenar! ¡Por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390124,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "¡Genial! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390108,
					"content": "Yo soy especial, no necesito usar esa ropa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "No te equivocas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
		},
