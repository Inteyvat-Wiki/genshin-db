			"dialogs": [
				{
					"id": 401479401,
					"content": "Es una pena que no haya probado la tentación de Adeptus, pero “cuerdas y flautas” no estaba nada mal. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479402
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401479402,
					"content": "Pensé que no aceptabas encargos que no fueran ir a ruinas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401479403
					]
				},
				{
					"id": 401479403,
					"content": "Ah, sí... Aunque los mecanismos de última generación no son lo mío, la oferta de Dori era bastante tentadora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479404
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401479404,
					"content": "Me dijo que cada vez que nos detuviéramos en un nuevo puerto, tendría la libertad de ir al mercado local para buscar algunos libros antiguos y llevármelos a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479405
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401479405,
					"content": "Ja, con una oferta así sobre la mesa, estaba dispuesta a aceptar menos que todos mis competidores de la Escuela de Tecnología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faruzán"
				}
			]
