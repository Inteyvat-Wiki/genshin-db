			"dialogs": [
				{
					"id": 401479701,
					"content": "Ahora bien, ¿cómo justifico el elevado precio de un plato sin ingredientes sofisticados? ¿Quizá empezando por darle un nombre elegante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479702,
						401479703
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401479702,
					"content": "Por cierto, todo ese rollo de que no haya marisco y que sea rápido de elaborar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401479704
					]
				},
				{
					"id": 401479704,
					"content": "Eh... Jeje. Me has descubierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479705
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401479705,
					"content": "*Suspira*... Cuando se lo prometí anoche, estábamos todas que nos moríamos del mareo y del sueño, así que pensé que hoy no tendríamos muchas ganas de comer. Pero luego, ya sabes lo que sucedió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479706
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401479706,
					"content": "Intenté poner algunas limitaciones para controlar el presupuesto, pero igualmente descubriste mi plan. *Suspira*, eso me pasa por no estudiar primero el mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479707
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401479707,
					"content": "Ey, ¡pero si ni siquiera les estás pagando mucho! La próxima vez trátalas justamente y no seas tan tacaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401479708,
					"content": "Mira quién fue a hablar, la que se aprovecha de mí a la primera de cambio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401479709
					]
				},
				{
					"id": 401479709,
					"content": "Paimon... Paimon... ¡Por eso Paimon es la más indicada para hablar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401479703,
					"content": "Admítelo, escogiste la Posada Wangshu por los precios, ¿a que sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401479704
					]
				}
