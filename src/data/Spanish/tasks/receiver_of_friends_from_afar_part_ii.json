				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							888.421,
							255.563,
							329.875
						],
						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401470401,
					"content": "O sea que quieren algo caro, pero que no sea marisco y tampoco puede tardar mucho en prepararse. Eso descarta casi todo nuestro menú. ¿Esta gente se divierte complicándonos la vida o qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470402
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470402,
					"content": "Arg, ¡esta Dori! ¿No lo habrá hecho adrede, verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470403,
					"content": "Me da que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470404
					]
				},
				{
					"id": 401470404,
					"content": "Esto no es el Pabellón Liuli o el Quiosco Xinyue, estamos en la Posada Wangshu. No almacenamos ingredientes raros y exóticos todos los días. Solo los encargamos cuando alguien nos los pide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470405
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470405,
					"content": "Bueno, si no tenemos más remedio que utilizar ingredientes normales para preparar algo en poco tiempo, solo hay una forma de subir el precio... Y es cocinando un plato que utilice al máximo la pericia y la creatividad del chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470406
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470406,
					"content": "#{NICKNAME}, conozco un plato llamado “cuerdas y flautas”. Se puede preparar rápidamente con lo que ya tenemos en la cocina. El precio de este plato suele ser de... ¡treinta mil Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470407
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470407,
					"content": "¡¿Treinta mil?! ¿No has dicho que es rápido de elaborar? Tampoco tiene ingredientes especiales, ¿por qué es tan caro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470408,
					"content": "“Rápido” no tiene por qué significar fácil. Para que este plato sea perfecto, se necesita una técnica perfecta con el cuchillo y un control muy preciso del fuego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470409
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470409,
					"content": "Hay que cortar varios tipos diferentes de carne en hebras finas, amasarlas hasta formar tiras y luego saltearlas suavemente en la sartén. El resultado es una gran variedad de sabores que se van degustando capa a capa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470410
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470410,
					"content": "Este plato es único, ya que ofrece una mezcla armoniosa de varios tipos de carne, todos ellos cocinados a la perfección, pero con sus propios sabores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470411
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470411,
					"content": "Si lo haces bien, será una obra maestra culinaria. Pero si no, no será más que carne picada tirada en un plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470412
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470412,
					"content": "#Oh, Paimon ya lo capta. Lo que cuesta no es el plato en sí, ¡sino la pericia {F#de la}{M#del} chef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470413,
					"content": "Me están haciendo dudar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470414
					]
				},
				{
					"id": 401470414,
					"content": "No te preocupes, puedo encargarme de amasar y hacer los preparativos. Tú solo tienes que centrarte en el paso más importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470415
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470415,
					"content": "¡Vamos, que tú puedes! Y aunque sea carne picada, ¡Paimon se la acabará toda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
