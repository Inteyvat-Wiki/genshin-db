			"dialogs": [
				{
					"id": 401479601,
					"content": "Algo que no sea marisco y que sea fácil de preparar. ¡Lo dejo en tus manos, jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479602
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401479602,
					"content": "Humm... Tenía ganas de probar la tentación de Adeptus, la sopa de brotes de bambú, las albóndigas de camarón dorado y el cangrejo dorado. En fin, los tendré que dejar para la próxima, pero a saber cuándo será eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479603
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401479603,
					"content": "#Ay, parece que doña Faruzán ahora está de bajón. {NICKNAME}, ¿puedes intentar servirnos lo más caro, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
