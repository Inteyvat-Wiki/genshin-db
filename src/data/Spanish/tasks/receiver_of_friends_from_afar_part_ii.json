			"dialogs": [
				{
					"id": 401470301,
					"content": "Empezamos bien la mañana. ¡Sigan así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470302
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401470302,
					"content": "Paimon y tú atienden a un sinfín de clientes hasta la hora de cierre, y todos ellos quedan satisfechos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4014704,
			"completionStepIds": [
				4014706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
