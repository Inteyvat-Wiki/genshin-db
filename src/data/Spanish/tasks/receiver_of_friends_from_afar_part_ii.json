						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470201,
					"content": "¡La comida está preparada! ¡Que la disfruten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470202,
					"content": "Oooh, ¡qué bien huele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470203
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470203,
					"content": "Ah, por cierto, ¿han desayunado? ¿Qué tal si se unen a nosotras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470204
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470204,
					"content": "Eh... ¿Dori nos está ofreciendo comida? ¿Desde cuándo es tan generosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470205,
					"content": "#Jeje, no olvidemos que los grandes negocios siempre se cierran durante una comida. Vamos, vamos, siéntense y únanse a nosotras. ¡Tod{F#as}{M#os} a comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470206
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470206,
					"content": "(Este plato parece bastante sencillo. Según lo que he investigado, es imposible que cueste tanto. Como máximo, diez mil Moras...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470207
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470207,
					"content": "#(Más vale que haya valido la pena trabajar toda la noche para comer este plato... En fin, {NICKNAME}, ¡este es el momento de la verdad!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470208
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470208,
					"content": "(Qué cansancio... Qué sueño... Solo quiero comer y luego meterme en la cama...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470209
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 401470209,
					"content": "#Cada un{F#a}{M#o} come mientras piensan en sus cosas...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470210
					]
				},
				{
					"id": 401470210,
					"content": "Esto es... ¿carne de pollo? Espera, también me sabe a micóquero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470211
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 401470211,
					"content": "Cada bocado me sabe diferente. Incluso hay algo que me sabe ahumado. Es realmente extraordinario... ¿Cómo lo has preparado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470212
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470212,
					"content": "Es jamón, agregué jamón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470213
					]
				},
				{
					"id": 401470213,
					"content": "¿Jamón? Pero no lo veo por ninguna parte... ¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470214
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470214,
					"content": "Jeje, ¿ya te has dado cuenta? Sí, ¡cada tira está amasada con diferentes tipos de carne! Paimon y Yanxiao se esforzaron mucho para hacerlo bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470215,
					"content": "Humm... No soy experta en esto, pero ¿distintos tipos de carne no requieren diferente tiempo de cocción? ¿Cómo es posible que combinen tan bien en un mismo plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470216
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 401470216,
					"content": "#Pues verás... ¡e-es un secreto comercial de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470217,
						401470218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470217,
					"content": "Solo es cuestión de práctica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				},
				{
					"id": 401470219,
					"content": "Vaya, así que este plato es realmente único... Eso hace que todo el viaje valga la pena. Por cierto, ¿este plato tiene nombre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470220
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470220,
					"content": "Ah, a Paimon se le olvidó presentarlo. Este plato se llama “cuerdas y flautas”, alude a la forma en que se entretejen las distintas hebras de carne, y también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470221,
					"content": "A los múltiples niveles de sabor que se pueden distinguir, ¿no? ¿Como una especie de armonía musical?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470222
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470222,
					"content": "El nombre, si no me equivoco, es un proverbio de Liyue que evoca una vigorosa interpretación orquestal con instrumentos de cuerda y viento tocando juntos... Humm, un nombre bastante apropiado para este plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470223
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470223,
					"content": "Ah... ¿Ya lo sabías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470224,
					"content": "Todos los estudiantes tienen que dominar al menos veinte idiomas antes de graduarse. Aunque... ¿lo seguirán exigiendo hoy en día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470225
					],
					"speakerTitle": "Faruzán"
				},
				{
					"id": 401470225,
					"content": "¿Qué? ¡¿Eso antes era obligatorio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470226
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 401470226,
					"content": "Paimon casi olvida que también eres de la Escuela de Semiótica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470227,
					"content": "Entonces... e-el precio de este plato es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470228
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470228,
					"content": "Ah, no te preocupes, no es mucho. ¡Solo les sale a treinta mil Moras, gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470229,
					"content": "¡¿Treinta mil Moras?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470230
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470230,
					"content": "#Para ser precisa... Paimon, {NICKNAME}, les dije que se unieran a nosotras, pero no dije que l{F#as}{M#os} fuera a invitar, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470231
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470231,
					"content": "Entonces... ¿no creen que deberíamos dividir la cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470232
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470232,
					"content": "¡Ya decía Paimon que había algo raro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470233,
						401470236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470233,
					"content": "Pero si treinta mil Moras no es nada para la magnate Sangemah Bay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470234
					]
				},
				{
					"id": 401470234,
					"content": "¡Eso! ¡Una mujer de negocios como tú tiene que estar a la altura de su reputación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470235,
					"content": "Ya... Pero cada Mora tiene su valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470239,
					"content": "*Suspira*, está bien, está bien. Me lo tomaré como un gasto por haber conocido este plato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470240
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470240,
					"content": "Cuando vuelva a Sumeru, le pediré a alguien que me ayude a rehacerlo, ¡y recuperaré todo el dinero perdido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470236,
					"content": "Te podemos hacer el veinte por ciento de descuento. Se lo diré al jefe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470237
					]
				},
				{
					"id": 401470237,
					"content": "Eh... Bueno, de acuerdo, has hecho un trabajo duro. Tú mandas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470238,
					"content": "Un descuento del veinte por ciento de treinta mil Moras... Uff, sigue siendo mucho Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470218,
					"content": "Manejo algunas técnicas especiales de cocina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				}
			]
		},
