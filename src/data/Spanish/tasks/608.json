			"dialogs": [
				{
					"id": 6080101,
					"content": "Jeje, hacía tiempo que no electrocutaba a alguien durante el Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080102,
					"content": "¿Antes hacerlo mucho, maestra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080103,
					"content": "¿Electrocutar a la gente, dices? No, no, tampoco tanto, jaja, solo de vez en cuando. Aunque la verdad es que ayuda a liberar el estrés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080104,
					"content": "Hasta mi antiguo profesor me escribió hace unos días preguntándome por ello. Le dije que yo solo “trato a los demás con amabilidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080105,
					"content": "Es normal que un estudiante herede el estilo de su maestro, ¿no crees? Y el mío era un amable anciano de la Escuela de Elementalismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080106,
					"content": "Por eso, esta vez he electrocutado con amabilidad. Tan amablemente que ni siquiera Jean tendría motivos para decirme nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080107,
					"content": "No sabía que poder electrocutar con amabilidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080108,
					"content": "Veo que está de muy buen humor, Srta. Lisa. Me alegro por usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6080109,
					"content": "Claro, moverse un poco es bueno para el cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
