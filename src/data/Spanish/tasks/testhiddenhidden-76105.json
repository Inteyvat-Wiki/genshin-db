			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Malta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "Oye, ¿viste esos cangrejos hogarpétreos? Parece que están realizando algún tipo de ritual misterioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050102,
					"content": "Supongo que es su comportamiento natural.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "¿Ah, sí? Oh... creo que ya entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050104,
					"content": "En la Villa Nasha hay mucha gente como estos cangrejos hogarpétreos: algunos caminan juntos hombro con hombro, mientras que otros se saludan a puñetazos y luego se separan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050105,
					"content": "Ese es el comportamiento natural en la Villa Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050106,
					"content": "Así es. Aprendes muy rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "Oye, ¿y tú podrías hacer que todos estos cangrejos hogarpétreos se metan en el pequeño estanque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050109,
					"content": "Humm... ¿Sería algo así como reunir a todos los cazadores de tesoros en el Buque Insignia? Suena divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761051501,
					"content": "Me pregunto qué pasaría si juntáramos a todos los cangrejos hogarpétreos... ¿Estás libre ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050107,
					"content": "Con algunas pequeñas diferencias, pero no importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
