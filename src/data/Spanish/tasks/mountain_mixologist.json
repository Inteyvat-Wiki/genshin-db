			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230201,
					"content": "¿Eh? ¿Otra vez ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230202,
					"content": "¿Sigues ayudando a los clientes de otros lugares a hacer pedidos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230203,
					"content": "¡Así es! Esta vez necesitamos 100 cajas de jugo festivo para Guanchui, el chef de la Aldea Chingtsé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230204,
					"content": "¡Paimon está lista para regatear, Georg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230205,
					"content": "De repente siento una arrolladora rivalidad comercial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "¡Oh! ¡Eso no lo vi venir! Muy bien, ¡veamos qué me traen esta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230206,
					"content": "¡Prepárate, Georg!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052303",
							"2"
						],
						"stepId": 7052303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "Guanchui, ¡ya regresamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230302,
					"content": "Ya encargamos tu pedido de 100 cajas de jugo festivo, aquí tienes el recibo. ¡No lo pierdas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230303,
					"content": "¡Alucinante! ¡Realmente fueron de gran ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230304,
					"content": "Revisaré con detenimiento la receta del jugo festivo para mezclar la proporción adecuada de bebida fresca con el té. Así conseguiré el sabor más delicioso, ¡para que los muchachos puedan trabajar con más ahínco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230305,
					"content": "Eh... ¡Vas a parecer un cantinero! Pero... ¿con té quedará bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230306,
					"content": "Sí, no se preocupen. Trabajé como chef durante un tiempo cuando vivía fuera. Esta receta es el equilibrio perfecto entre sabor y precio, ¡la he preparado montones de veces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230307,
					"content": "Ahora tengo curiosidad por su sabor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "La próxima vez que vuelvan a la Aldea Chingtsé les esperaré con el jugo ya listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230309,
					"content": "#¡Genial! ¡Que lo pruebe {NICKNAME} para la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230310,
					"content": "¡Buena suerte, chef cantinero!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "¡Gracias! ¡Vengan cuando tengan tiempo libre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
