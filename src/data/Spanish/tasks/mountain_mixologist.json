			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "¡El agua de manantial de la Aldea Chingtsé es idónea para preparar las bebidas especiales del Festival de la Vendimia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230402,
					"content": "¡Gracias por su ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230403,
					"content": "¿Qué podrías contarme sobre ti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "Hace no mucho que me mudé a la aldea con algunos muchachos. Normalmente yo me encargo de cocinar y de llevar la comida a los que trabajan en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230405,
					"content": "#Pero lo que más suelo cocinar son platos sencillos y saciantes, que no son presentables para {F#unas invitadas forasteras}{M#unos invitados forasteros}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230406,
					"content": "#Puede que en esta aldea no se sienta la algarabía, pero comida deliciosa nunca va a faltar. ¡Si se dan un paseo por la aldea podrán comprobarlo ustedes mism{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230407,
					"content": "¿Qué me puedes contar sobre el té?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "Los muchachos que trabajan en el campo lo beben como si no hubiera mañana. Normalmente, en medio día ya se terminaron una tinaja de té de las grandes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230409,
					"content": "El campo está un poco lejos del puesto de té, así que ir y volver desde allí resulta un tanto engorroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230410,
					"content": "Además el abuelo Kai ya está mayor, no está en condiciones de cargar con té de aquí para allá para los muchachos. Así que ahora yo me hago cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230411,
					"content": "Recuerdo que, cuando me fui con otros muchachos a vivir fuera durante un tiempo, el sabor del té siempre nos parecía demasiado suave. A veces ellos extrañaban beber algo que tuviera un sabor más intenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230412,
					"content": "Por eso suelo mezclar el té con otras bebidas, para conseguir sabores refrescantes, y que así los muchachos estén más contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230413,
					"content": "Por supuesto, el té que yo preparo es solo para mis muchachos, ¡no pretendo arruinar el negocio del Abuelo Kai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230414,
					"content": "Cuando estamos de descanso, también vamos al puesto de té del Abuelo Kai, tomamos alguna taza y le ayudamos a hacer alguna cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230415,
					"content": "Volveremos pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "¡Muy bien! ¡Espero que regresen con buenas noticias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
