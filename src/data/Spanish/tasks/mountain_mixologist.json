			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "#¿Ustedes vienen de fuera? ¡Bienvenid{F#a}{M#o}s a la Aldea Chingtsé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230102,
					"content": "Hola, eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "¡Deja que Paimon hable primero! ¡Paimon hará las presentaciones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230105,
					"content": "#{F#Esta}{M#Este} es {F#la viajera}{M#el viajero} invencible: ¡{NICKNAME}! Y Paimon es Paimon, ¡su mejor compañera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230106,
					"content": "Estamos ayudando a clientes de otros lugares a comprar bebidas especiales del Festival de la Vendimia. Vimos tu encargo y vinimos a hablar contigo del asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230107,
					"content": "Ya veo. ¡Me gusta su franqueza! Entonces, yo también iré directo al grano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230109,
					"content": "Soy el chef Guanchui, necesito conseguir <color=#00E1FFFF>100 cajas de jugo festivo</color> para hacer té con el que brindar un sorbito de alegría a esos trabajadores que se dejan el alma trabajando todo el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230110,
					"content": "¡Estupendo! ¡Manos a la obra! Solo tienes que darnos los fondos que pienses destinar al pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230111,
					"content": "¡Voy un paso por delante de ustedes! Aquí tienen los néctares cristalizados. Una vez que hayan hecho el pedido, seguro que sobran. No importa cuántos queden, ¡pueden quedárselos como recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230112,
					"content": "¡Todo listo! ¡En marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230113,
					"content": "¡Muy bien! ¡Aquí les espero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230114,
					"content": "Qué rápido ha sido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#¡No te duermas en los laureles, {NICKNAME}! ¡Vámonos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230117,
					"content": "Si tienes algo que decirle a Paimon, hazlo cuando acabemos con el pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230118,
					"content": "¡Cuanto antes terminemos el encargo, antes abriremos la tienda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230119,
					"content": "Tieeenda, tieeenda, Paimon quiere abrir la tieeenda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230115,
					"content": "La verborrea de Paimon tan efectiva como siempre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "¿Tú eres?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
			"id": 7052302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
