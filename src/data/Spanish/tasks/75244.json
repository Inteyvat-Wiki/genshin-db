			"dialogs": [
				{
					"id": 752440302,
					"content": "¡Este es! ¡Muchas gracias! Me siento mucho más tranquilo con mi sombrero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440303,
					"content": "Este es un casco de seguridad especial que mandé hacer. Es resistente incluso a las balas de un mosquete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440307,
					"content": "No te preocupes tanto, solo es pescar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "Puede parecer una locura, pero hace algún tiempo, había un tipo pescando por aquí y le dispararon en un ojo. Creo que fue con un mosquete o un arco. Incluso la pesca tiene sus peligros, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440305,
					"content": "No importa que las malas lenguas digan que todo fue un conflicto interno entre bandidos de Nod Krai... ¡El hecho de que haya sucedido significa que debemos tener cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
			]
		},
