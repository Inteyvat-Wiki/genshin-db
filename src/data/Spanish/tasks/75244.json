			"dialogs": [
				{
					"id": 752440101,
					"content": "Oh, ¿tú también vienes a pescar? Deberías saber que para pescar, es necesario llevar un sombrero lo suficientemente resistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440106,
					"content": "¿Por qué necesito un sombrero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "¿Por qué? Porque es más seguro llevar sombrero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440107,
					"content": "Pero tú tampoco llevas sombrero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "Es por eso que te lo digo... Verás, el viento se llevó mi sombrero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440104,
					"content": "Así que... ¿te importaría ayudarme a buscarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440108,
					"content": "¿Por qué no vas a buscarlo tú mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Si quiero buscar el sombrero, debo dejar la caña de pescar. Pero si me quedo con la caña de pescar, no puedo buscar el sombrero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440109,
					"content": "Así que te lo ruego... Ayúdame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rantiy"
				}
			]
		},
