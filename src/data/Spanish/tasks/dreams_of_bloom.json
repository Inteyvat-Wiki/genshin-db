					"Sakuya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726580101,
					"content": "¡Hola! ¿Quieres plantar tus propias flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580102
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580102,
					"content": "¿Qué tipo de flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580103
					]
				},
				{
					"id": 726580103,
					"content": "#¿Estás interesad{F#a}{M#o}? Si hay algo que no entiendas, te lo explicaré brevemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580104
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580104,
					"content": "Me llamo Sakuya y soy una florista con un pequeño negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580105
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580105,
					"content": "Bueno, lo llamo negocio, pero en realidad, la mayor parte del tiempo solo envío flores a la gente o ayudo a alguna tienda a hacer ikebana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580106
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580106,
					"content": "¿“Ikebana”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580107
					]
				},
				{
					"id": 726580107,
					"content": "Oh, ¿no lo conoces? El ikebana es un importante arte de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580108
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580108,
					"content": "En términos sencillos, el ikebana es el acto de cortar y preparar las flores y otras plantas para luego colocarlas de forma adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580109
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580109,
					"content": "Sin embargo, debes tener cuidado con el estado de las plantas y solo recortar las partes que parezcan menos presentables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580110
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580110,
					"content": "Además, su arreglo y colocación, e incluso el ángulo en que las flores se extienden hacia el exterior, deben adecuarse al entorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580111
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580111,
					"content": "Estos detalles deben ser estudiados minuciosamente, por lo que puede ser un proceso muy engorroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580112
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580112,
					"content": "Hasta para alguien a quien le encanta el ikebana como a mí, es un trabajo agotador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580113
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580113,
					"content": "Antes tenía una tienda en la ciudad, pero las calles eran demasiado ruidosas para concentrarme en mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580114
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580114,
					"content": "Así que cerré la tienda y ahora solo recibo clientes al lado de mi campo de flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580115
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580115,
					"content": "Es mucho más tranquilo, pero tengo menos trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580116
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580116,
					"content": "Por eso, he ideado un plan promocional para hacer publicidad de mi tienda, la Floristería Sakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580117
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580117,
					"content": "Y a este plan lo he llamado... ¡“Flores de ensueño”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580118
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580118,
					"content": "¿De qué trata tu plan exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580119
					]
				},
				{
					"id": 726580119,
					"content": "En concreto, se trata de permitir a los clientes plantar sus propias flores y luego crear sus propios y exclusivos arreglos florales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580120
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580120,
					"content": "#Si estás interesad{F#a}{M#o} en probarlo, dímelo. Las dos cosas son muy interesantes, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakuya"
				}
			]
		}
	]
}