			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Ah, viniste. Tengo una buena noticia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020102,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "No, no. Ya encontré la causa del problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020105,
					"content": "Al fin logré encontrar a ese vendedor de Daguerrotipos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020106,
					"content": "Le expliqué mi problema, pero no me quiso creer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020107,
					"content": "Afortunadamente, tomaste muchas imágenes. De lo contrario, ese vendedor no reconocería su error.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020108,
					"content": "Gracias a tu ayuda, finalmente aceptó inspeccionar el Daguerrotipo que me vendió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020109,
					"content": "De hecho, el día de ayer me dio un líquido como compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020110,
					"content": "Dijo que el diseño de este tipo de Daguerrotipos es distinto a los demás, y que necesitas agregarle este líquido para imprimir normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020111,
					"content": "Si no lo agregas, solo habrá color, pero no con tanta nitidez, como en las imágenes que capturaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020112,
					"content": "Me alegro que esté bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Sí, pero, a decir verdad, ahora tengo más interés en ese líquido que en el Daguerrotipo mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020115,
					"content": "Piénsalo, la mayoría de personas solo comprarían el Daguerrotipo, ¿cierto? Después de comprarlo, lo puedes usar para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020116,
					"content": "Pero ese líquido se consume. Después de agotarse, tienes que volver a comprarlo para seguir usando el aparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020117,
					"content": "Además, de acuerdo a lo que dijo ese vendedor, hay pociones distintas, con efectos distintos. Él mismo está investigando al respecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020118,
					"content": "Quizás... ¡el negocio está en la venta de ese líquido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020119,
					"content": "*Ejem*, lo siento. Era un monólogo conmigo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020120,
					"content": "Gracias por tu ayuda. Primero, dame ese Daguerrotipo para ponerle el líquido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020113,
					"content": "Entonces, ¿está bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "¿Tomaste una imagen de algo “colorido”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
			"completionStepIds": [
				4140202
			],
