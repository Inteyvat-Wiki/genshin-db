			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "#Espera un minuto, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020202,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "Es un poco repentino, pero... ¿Te interesan los Daguerrotipos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020204,
					"content": "Un poco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "*Suspira*, es mi Daguerrotipo... No es un Daguerrotipo normal, es lo último en tecnología en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020207,
					"content": "Se supone que con este aparato puedo imprimir imágenes como ningún otro Daguerrotipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020208,
					"content": "¿Cómo lo haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "#¡Oye, qué desconfiad{F#a}{M#o} eres! Si no me crees, ¿por qué no vas al Gremio de Aventureros a preguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020211,
					"content": "Yo tampoco lo creía, estuve jugando con él el día entero, e incluso le pedí ayuda a alguien del gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020212,
					"content": "La diferencia entre este Daguerrotipo y los demás, es un pequeño componente en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020213,
					"content": "Entre sus componentes, hay un líquido que permite imprimir imágenes con efectos especiales, mucho mejores que las de los Daguerrotipos comunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020214,
					"content": "¿Qué te parece? Si te interesa, ¿te gustaría intentarlo? No le queda mucho líquido, pero puedes probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020215,
					"content": "Puedo regresar a Fontaine por más líquido. Si quieres intentarlo, es todo tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020216,
					"content": "Eh... Gracias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Entonces, te regalo este Daguerrotipo como muestra de apreciación. Si es de tu agrado, vuelve a visitar mi tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020217,
					"content": "¿Cuánto cuesta el líquido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "Eh... *Ejem*, no te preocupes por eso. Cada botella es muy barata. Si quieres comprar más, podemos negociar un precio especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020209,
					"content": "No lo sé, Ji Tong, parece falso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Suena un poco aburrido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
			"beginWay": "TALK_BEGIN_AUTO",
