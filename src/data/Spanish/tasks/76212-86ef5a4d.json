			"trigger": {
				"objectNames": [
					"Quiauhquetzal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "Se detienen en lo alto de una estantería cercana...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "#Aquí están a salvo. Amig{F#a}{M#o} dorad{F#a}{M#o}, ¿qué sucede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120305,
					"content": "Nada, solo tenía un poco de curiosidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "Este lugar está muy alto y la vista es amplia. Es un buen sitio para esconderse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120309,
					"content": "En mi calp{RUBY#[D]tribu}ulli, quedarse en el suelo es peligroso. Aunque los g{RUBY#[S]máximos soberanos}obernantes supremos sobre nosotros no decidan matarnos por capricho, las otras calp{RUBY#[D]tribus}ulli vendrían a saquearnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120310,
					"content": "Solo posándonos en los riscos y las copas de los árboles, como los quetzales, podemos huir de la calamidad antes de que nos alcance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120311,
					"content": "Además, Vindia dijo que quería verme volar, porque quiere ca{RUBY#[D]escribir}ntar una historia de aventuras a lomos de un pájaro gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120312,
					"content": "¿Seguro que no te engañó?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "No es así. Vindia es muy buena persona. Quizás tan buena como el Señor de la Encrucijada. Ambos son muy amables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120314,
					"content": "Pero ustedes... vuelan muy alto. Es impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120315,
					"content": "Esto es para ustedes, como prueba de nuestra amistad. Tengo que pensar en cómo volar más alto para que no me alcancen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120316,
					"content": "Aunque aquí no hay ninguno de esos g{RUBY#[S]máximos soberanos}obernantes supremos, ni conquistadores a los que les guste desollar a la gente. Es un lugar muy seguro, pero... estoy acostumbrada a tener siempre una ruta de escape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120306,
					"content": "Me preocupaba que estuvieras atrapada ahí arriba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "Gracias, pero no estaba atrapada. Los lugares altos son seguros, nadie podrá matarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "Quiauhquetzal"
				}
			]
		}
	]
}