			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "Los jabalíes de aquí están rechonchos y llenos de energía. Por eso la calidad de su carne es excelente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000402,
					"content": "¡Ah! De tanto hablar de comida ya me dio hambre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "¡Guau! ¡Cuánta carne! Freiré un poco y otra parte la asaré con champiñones. Me pregunto cómo sabrá con el condensado de Slime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "Con qué facilidad se distrae...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "#Creo que se ha olvidado de nosotr{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "Oh, ¡lo siento! Me emocioné pensando en nuevas recetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "Como prometí, ¡aquí tienen un sabroso aperitivo! ¡Adelante, pruébenlo! Y díganme qué piensan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "¿Somos tus catadores de comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "¡Por Los Siete! ¡Esto está... delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "¿Puedes decirnos cómo hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Jiji, ¡claro! Solo que aún no he escrito la receta. Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "¡Lo tengo! Haré otro ahora mismo para que puedan ver. Estoy segura de que lo entenderán de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "No sé si podremos recordar a la primera cómo hacer un plato tan complicado. Y no tenemos ni sartén ni condimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "¡Vamos, es muy sencillo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "Podemos freír sobre una losa de piedra y cocinar usando algo de esa grasa de jabalí. Luego construyes una estufa de rocas, usas hierba seca para encender un fuego y unas ramitas para la fogata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "Las flores dulces servirán para endulzar. En cuanto a la sal, el otro día encontré un montón de sal de roca en una cueva y todavía me queda mucha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "Parece que ha hecho esto un millón de veces antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Jiji, me emociono cuando hay una oportunidad de probar algo nuevo. Pero tampoco puedo traer conmigo la cocina entera cada vez que salgo de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Dame un segundo mientras preparo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "¡Oye! ¿Qué crees que estás haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000601,
					"content": "Este es el hábitat natural de los jabalíes, ¡no puedes cazarlos aquí! Los ahuyentarás a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000602,
					"content": "Los cazadores sabemos que no tienes que matar a la gallina para obtener un huevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000603,
					"content": "¡Oh! Ya entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "¡La carne más fresca y de mejor calidad proviene de jabalíes que corren libres en la naturaleza! Si se agotaran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "sería un gran golpe para la gastronomía... ¡No! ¡Para toda la humanidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "Vaya forma de entender las cosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "Lo siento, no tenía idea de que esto podría causar un problema tan grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000609,
					"content": "*Suspira*, deberías disculparte con Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000610,
					"content": "Como líder de los cazadores, él siempre enfatiza la importancia de respetar las reglas de la caza. Debe estar muy molesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000611,
					"content": "¿Qué vamos a hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "Cometí un error y debería ir a disculparme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000614,
					"content": "Déjanos acompañarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000615
					]
				},
				{
					"id": 110000615,
					"content": "#Jiji, gracias chic{F#as}{M#os}. Cocinaré algo muy sabroso para ustedes una vez que esto termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000616,
					"content": "Está bien, no te preocupes. Paimon te lo recordará si se te olvida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000617
					],
					"speakerTitle": "Paimon"
				},
