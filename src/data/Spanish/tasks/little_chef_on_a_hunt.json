				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "¡Shh! Hablen en voz baja, estoy cazando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000302,
					"content": "Siempre he escuchado muchas cosas sobre la amplia gama de ingredientes que puedes encontrar en Mondstadt, ¡y parece que es verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000303,
					"content": "¿Eres una cazadora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "No, soy chef. ¡Una chef con la misión de encontrar ingredientes raros y exóticos de todos los rincones del mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000306,
					"content": "Mi nombre es Xiangling, y vengo de Liyue. ¿Y tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000307,
					"content": "#Yo soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "Hola, ¡mi nombre es Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000309,
					"content": "¡Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000310,
					"content": "¿Por qué me miras así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000311,
					"content": "Qué criatura tan exótica, ¿es comestible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000312,
					"content": "#Somos amig{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "Qué pena. No la puedo comer si es tu amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000316,
					"content": "#Parecen {F#buenas amigas}{M#buenos amigos}. Yo también tengo un buen amigo. Se llama Guoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000317,
					"content": "... ¿Ese no es el nombre de una comida de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000318,
					"content": "Jeje... Eso es porque tanto la comida como mi amigo tienen un lugar especial en mi corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000319,
					"content": "En fin, ¿pueden ayudarme a cazar algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000320,
					"content": "Hay muchas cosas por aquí con las que se podrían cocinar cosas increíbles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000321,
					"content": "¡No soy capaz de atrapar nada, y no quiero dejar pasar esta oportunidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000322,
					"content": "No suena nada fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000323,
					"content": "¡Vamos, te prepararé un sabroso aperitivo más tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000324,
					"content": "#¿Un sabroso aperitivo, dijiste? ¡No te preocupes! ¡{NICKNAME} es {F#la mejor cazadora}{M#el mejor cazador} de la historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000325,
					"content": "¡Oye! ¡¿De qué lado estás tú?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "#Jeje, no pasa nada. Tu amig{F#a}{M#o} ya aceptó ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000328,
					"content": "No me importa cómo lo hagan, siempre y cuando me traigan algo de carne cruda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000329,
					"content": "Bien. Entonces, ¡confío en ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000326,
					"content": "Podrías preguntarme primero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "Claro. ¡Buen provecho!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "¡No! ¡Por última vez, Paimon NO ES COMIDA DE EMERGENCIA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000304,
					"content": "¿Eres una aventurera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
		{
			"id": 1100004,
