			"dialogs": [
				{
					"id": 752500101,
					"content": "Los visitantes que compraron muñecos van saliendo uno tras otro. En ese momento, unos invitados inesperados llegan al Parque Alpaca...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "¡Los Fatui que me robaron ayer! ¡Son ustedes! ¿Qué más quieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500104,
					"content": "No te preocupes, estoy aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "No...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "El Fatui líder te hace un gesto con la mano y te entrega una nota. Al abrirla, ves que está escrita con una caligrafía muy torcida. La nota dice:",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "¿Así que cuando pusieron la mano en el bolso, en realidad estaban pagando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500113,
					"content": "Lo... lo siento, me equivoqué con ustedes. ¡De verdad, lo siento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500114,
					"content": "¡Llévenselos todos! ¡Es mi forma de agradecerles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500115,
					"content": "El Fatui líder sacude la cabeza y levanta tres dedos de la mano.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Ya veo... ¡Ustedes son como los héroes de Natlan! ¡Son dignos de admiración!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500117,
					"content": "Entonces, elegiré tres juguetes con los colores más adecuados para ustedes. ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
