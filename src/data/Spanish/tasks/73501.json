				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "El padre aranara reconoció su error y obtuvo el perdón de su hijo aranara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010202,
					"content": "Humm... Creo que a la gente le gustará cómo se desarrolla la historia, pero la razón por la que el padre reconoció su error fue demasiado simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010203,
					"content": "Tal vez podríamos hacerles pasar algún tipo de dificultad juntos. Estoy seguro de que así se entenderán mejor el uno al otro. El padre aranara se sentirá culpable después de ver a su hijo trabajar duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "Tánger"
				},
				{
					"id": 735010204,
					"content": "Hmm, cuando el padre aranara empieza a sentirse culpable, ¿debe hablar más despacio o más rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010205,
					"content": "Eso depende del hijo aranara. Sería interesante escucharlos hablar a diferentes ritmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "Tánger"
				},
				{
					"id": 735010206,
					"content": "Hola. Tánger, Razi, ¿qué hacen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010207,
					"content": "Papá y yo estamos discutiendo nuestra última historia. Esta vez seré yo quien la cuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010208,
					"content": "Pero me pone un poco nervioso contar una historia delante de tanta gente. Por eso le pido consejo a papá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010209,
					"content": "¡Oh! Sumeru va a tener un nuevo joven cuentacuentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010210,
					"content": "Muchas gracias. Si no fuera por ustedes, Razi seguramente me habría dejado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "Tánger"
				},
				{
					"id": 735010211,
					"content": "¡Paimon se alegra de que todo haya salido bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010212,
					"content": "Pero... ¡todavía hay algo que no cuadra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010213,
					"content": "Oh, ¿a qué se refieren? ¿Necesitan ayuda para investigar algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010214,
					"content": "¿Por qué alguien de Mondstadt dejaría una nota en el hueco de un árbol en lo profundo del Bosque Avidya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010215,
					"content": "¡Pensé que habíamos pasado de este tema! Humm... ¡Fue solo una coincidencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010216,
					"content": "Mucha gente escribe sus secretos y los esconde en los huecos de los árboles. No es nada del otro mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010217,
					"content": "Collei, de repente te ves un poco nerviosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "Humm... Ahhh... Está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010220,
					"content": "Yo también tengo mis secretos y problemas. Y... se los cuento a los huecos de los árboles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010221,
					"content": "Pero ver a Razi y a Tánger me ha dado una idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010222,
					"content": "#Viajer{F#a}{M#o}, ¿podrías convertirte en mi árbol hueco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010223,
					"content": "Con mucho gusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "¿De verdad es tan común?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
