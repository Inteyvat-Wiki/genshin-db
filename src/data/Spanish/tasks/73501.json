	"talks": [
		{
			"id": 7350101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350101",
							"2"
						],
						"stepId": 7350101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qasit",
					"Alia",
					"Mamduh",
					"Fayez",
					"Ruhi",
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "Ohh... Obtuve el mismo de nuevo. ¿Cuándo voy a conseguir el que es gordito y blandito?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010102,
					"content": "No importa. Supongo que tendré que ahorrar un poco. Tengo que hacerme con todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010103,
					"content": "¿Eh? ¡Pensé que venías aquí todos los días! ¿No los tienes todos todavía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010104,
					"content": "Deberías haberlos comprado como un conjunto. Así tendrías siete diseños diferentes a la vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010105,
					"content": "Pero entonces no sería una sorpresa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010106,
					"content": "¡Las sorpresas son aburridas! ¡Quiero tener todos los diseños que hay! Eso es lo que haces cuando de verdad te gusta algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010107,
					"content": "Por fin he ahorrado lo suficiente para poder comprar el conjunto entero hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010108,
					"content": "Lo siento mucho, pero la que compró Qasit fue nuestra última unidad. Hoy se nos ha acabado la mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "Mamduh"
				},
				{
					"id": 735010128,
					"content": "Estamos ampliando la plantilla de nuestro equipo, así que vuelve a visitarnos mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "Mamduh"
				},
				{
					"id": 735010109,
					"content": "Bueno... volveré de nuevo mañana. Pero para que lo sepa, ¡las figurillas aranara no son simples “mercancías”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010110,
					"content": "¡Eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010111,
					"content": "De acuerdo, de acuerdo... Disculpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "Mamduh"
				},
				{
					"id": 735010112,
					"content": "Lo siento, amigo. Nuestras figurillas aranara se han agotado por hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010113,
					"content": "¿Se han agotado? Oh no... Iba a comprar algunas para mi primo que viene de visita mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010114,
					"content": "Escucha, ¿qué te parece esto? Vives cerca de la casa de Razi, ¿verdad? Te entregaremos las nuevas figurillas mañana a primera hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010115,
					"content": "¡Genial! ¡Gracias, Sr. Fayez! ¡Que no se le olvide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010116,
					"content": "Lo prometo. ¡Artesanía Acara nunca defraudaría a un niño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010117,
					"content": "Ah, más clientes. Lo siento, nuestras figurillas aranara se han...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010118,
					"content": "Oh, hola, son ustedes. Muchas gracias por su ayuda. Estábamos pensando en visitarte para expresarte nuestra gratitud, pero como puedes ver... hemos estado muy ocupados en nuestra tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010119,
					"content": "Si no fuera por ti, el aniversario de la tienda habría sido una historia diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010120,
					"content": "Parece que el negocio va muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "Parece que los aranara son muy populares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "Todo gracias a Razi. Para ser tan joven, tiene una creatividad increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010123,
					"content": "Por cierto, nos gustaría que tuvieras el Prototipo Aranara como una pequeña muestra de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010124,
					"content": "Guau, espera... Esto parece un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010125,
					"content": "Asombroso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "Sí, asombroso. Tiene una apariencia muy... misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010127,
					"content": "Humm... Apreciamos tu oferta, pero por favor danos algo de tiempo para decidir si queremos quedárnoslo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010129,
					"content": "Ahora que los problemas de Artesanía Acara se resolvieron, van a visitar a Razi y Tánger.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
			"completionStepIds": [
				7350101
			],
			"beginWay": "TALK_BEGIN_NONE",
