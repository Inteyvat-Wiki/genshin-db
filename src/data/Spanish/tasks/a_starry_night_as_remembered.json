			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeroney"
				],
				"points": [
					{
						"sceneId": 10,
						"position": [
							-86.963,
							390.917,
							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "Vaya, ¿qué hacen aquí? En esta zona no hay vías, estamos al borde del Espejismo Veluriyam y a unas alturas muy elevadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "Muy poca gente suele venir por aquí, ni siquiera Idía... Dudo que ella sepa de la existencia de este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Si aquí no hay nada, ¿por qué vienes aquí, Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Solo quería tomar un poco el aire... No me miren con esa cara de “seguro que has vuelto a discutir con Ferdinand y te has ido de casa, ¿a que sí?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "No hemos discutido, de verdad que no. He salido porque... me apetecía, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Ustedes ya saben que el Chitty-Chitty Volador fue idea mía. Lo único que deseaba es que hubiese algo que me pudiera transportar fácilmente a lugares altos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "Fue así como yo... tuve la idea de construir esas vías y el Chitty-Chitty Volador, pues adoro el cielo y los lugares altos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Parece una tontería, ¿verdad? Recuerdo que un dicho de Inazuma decía que solo los fuegos artificiales y los que están mal de la cabeza aspiran a subirse a lo alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "La idea del Chitty-Chitty Volador es estupenda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Pero solo puede existir en el Espejismo Veluriyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "... Ya da igual. No hablemos más de eso. Vine aquí también para ver el cielo estrellado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "Aunque el cielo del Espejismo Veluriyam no es más que un reflejo del cielo que hay fuera de la botella, para mí ya es lo suficientemente hermoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Cada vez que me quedo a contemplar las estrellas, me siento en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "Al que le gustaba el cielo estrellado, ¿era Jeroney?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Cualquiera que vea un cielo estrellado así saldrá enamorado. Qué pena, ojalá también pudiéramos ver las estrellas de día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "Eso sí, si no tuviéramos que escalar tanto cada día para verlo, sería mejor todavía, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "¡Paimon tiene una idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Oh, ¿en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Podemos capturar una imagen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "¿Ima-imagen? Eso tiene pinta de ser una tecnología avanzada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Sí, ¡capturemos una imagen del cielo estrellado para mostrárselo a Jeroney!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "¿De verdad que se puede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Pero Paimon no sabe dónde puede ponerse para capturar las mejores vistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "¡Aquí! En esta plataforma podrás ver las mejores vistas del cielo estrellado. Por eso me he subido hasta aquí, quería disfrutar de estas vistas en la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "¡Genial! Solo espera a que capturemos la imagen, Jeroney.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "Creo que es muy divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
