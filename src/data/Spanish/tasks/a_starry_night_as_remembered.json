			"dialogs": [
				{
					"id": 790540301,
					"content": "Jeroney, ¡ya estamos de vuelta! Mira, esta es la imagen que decíamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540302,
					"content": "... Guau, ¡parece real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540303,
					"content": "¿De verdad que me puedo quedar con la imagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540304,
					"content": "Claro, ¡la capturamos para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540305,
					"content": "Jaja, ¡muchísimas gracias! Nunca pensé que vería una tecnología tan avanzada. Con toda esta tecnología, quizá ya no sea un sueño ver un Chitty-Chitty Volador fuera del Espejismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540306,
					"content": "Qué cielo más bonito... Ojalá en aquel entonces también hubiéramos tenido esta tecnología. Así... él hubiera podido ver este cielo siempre que quisiera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeroney"
				}
			]
		},
