				{
					"id": 790540401,
					"content": "Imagen... No puedo creer que ahora exista algo tan asombroso. Esto también nos permitiría llevar un registro de los paisajes que nos encontremos durante el camino.",
					"roleType": "TALK_ROLE_NPC",
