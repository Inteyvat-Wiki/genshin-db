				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030601,
					"content": "¿No ven que es mi hora de descanso? ¡Largo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030602,
					"content": "Queremos pedirte un tofu de almendras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Largo, he dicho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030604,
					"content": "¡Vaya, su servicio es tan bueno como el de Wagner en Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "Lo pidió la jefa, Verr Goldet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030607,
					"content": "Ya veo. Si es para la jefa, supongo que no me queda de otra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030608,
					"content": "Pero ahora no tengo las fuerzas para hacer un plato tan elaborado como el tofu de almendras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030609,
					"content": "¿Por qué lo dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "Las manos de un espadachín tienen que ser estables, tal y como las de un cocinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030611,
					"content": "Pero ahora mismo me encuentro un poco indispuesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030612,
					"content": "Porque... una vez, un viajero me dijo que esta posada estaba... embrujada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030613,
					"content": "Y hace unos momentos, vi algo en la cocina... Algo no estaba bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030614,
					"content": "(Este cocinero se ve muy intimidante, pero cuando habla de fantasmas, suena como un debilucho...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030615,
					"content": "No dejo de pensar que la Posada Wangshu no es un lugar seguro. No puedo estabilizar mis manos para preparar el tofu de almendras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 10030616,
					"content": "#De acuerdo, vamos a la cocina, {NICKNAME}. Todo sea por el mejor tofu de almendras jamás visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
