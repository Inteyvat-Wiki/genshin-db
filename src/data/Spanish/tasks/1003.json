						10031707
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031707,
					"content": "No me lo puedo creer. Por mucho que hayan cambiado los tiempos, no me puedo imaginar a Liyue sin Rex Lapis.",
