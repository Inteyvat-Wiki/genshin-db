			"dialogs": [
				{
					"id": 10039401,
					"content": "Disculpa, ¿quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039402
					]
				},
				{
					"id": 10039402,
					"content": "Mi nombre es Goldet y vengo de Mondstadt. Soy quien manda aquí, en la Posada Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039403,
					"content": "No pienses que soy la esposa del jefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039404,
					"content": "Yo soy LA JEFA, con mayúsculas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039405,
					"content": "He escuchado algunos rumores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "Jajaja. Bueno, en un lugar como este, una posada sin una buena relación con las Siete Estrellas apenas podría funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039407,
					"content": "Me refiero a que, obviamente, necesito su visto bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039408,
					"content": "Sin embargo, todas esas otras tonterías son solo rumores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039409,
					"content": "Hablando de eso, ¿tienes alguna noticia interesante para compartir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039410,
					"content": "¿De quién es este gatito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "*Suspira*, este gato se invitó solo... Pero es lindo, así que lo dejé quedarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039412,
					"content": "Se llama Bigotes. Ese fue simplemente el primer nombre que se nos ocurrió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039413,
					"content": "Tal vez te parezca que Bigotes es algo travieso. Ya sabes cómo son los gatos. Pero por favor, abstente de rebajarte a su nivel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
