			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "Háblame del Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "Oh, ¿han visto a Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030403,
					"content": "No está nada mal. No siempre está de buen humor para dejar que lo vean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030404,
					"content": "¿A eso le llamas “de buen humor”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030405,
					"content": "Sí, no se ven a los Adeptus todos los días... Muchas personas añoran verlos, y pueden pasar una vida entera sin encontrarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030406,
					"content": "Cuando el Arconte Geo fundó Liyue, usó las fuerzas de los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030407,
					"content": "Pero la mayoría de ellos solo sabe proteger a Liyue peleando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030408,
					"content": "Pero por muchos milenios, los humanos han tomado las riendas de Liyue, mientras que los Adeptus se han escondido en las afueras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030409,
					"content": "Sabes mucho del tema, señorita jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030410,
					"content": "Solo llámenme “jefa”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030411,
					"content": "En fin. Ya que tuvieron un encuentro con uno de los Adeptus, me hacen las cosas más fáciles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030412,
					"content": "Si quieren saber mi opinión, las cosas irán bien si logran poner de buen humor a Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030413,
					"content": "¿Ponerlo de buen humor? No puedo imaginarme al Guardián Yaksha sonriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030414,
					"content": "Jaja, sería interesante verlo, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030415,
					"content": "(A decir verdad, yo tampoco lo he visto sonreír nunca...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030416,
					"content": "Tengo una idea. Primero pídanle al cocinero que prepare un tofu de almendras y, luego, compleméntenlo con el plato que mejor sepan hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030417,
					"content": "El tofu de almendras es el plato favorito de Xiao. El plato depende de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030418,
					"content": "#Conque depende de nosotr{F#as}{M#os}, ¿eh? {NICKNAME}, ¿qué es lo mejor que puedes preparar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030419,
					"content": "La ensalada saludable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "Es difícil meter la pata con ese plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030423,
					"content": "Pero creo que hay que ser precavidos con los Adeptus. Mejor preparemos una ensalada saludable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030421,
					"content": "Slime Gigante Pyro al loto rojo picante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "¡Guau! ¡Nunca había oído hablar de ese plato! ¡Paimon quiere probarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
