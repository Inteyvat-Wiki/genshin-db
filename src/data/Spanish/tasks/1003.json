					"nextDialogs": [
						10031711,
						10031712
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031711,
					"content": "¿Los Adeptus vendrán a hacerse cargo de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031713
					]
				},
				{
					"id": 10031713,
					"content": "Los Adeptus no podemos evadir nuestra responsabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031714
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031714,
					"content": "Tengo razones por las que no quiero ensuciarme del mundo mortal, pero la responsabilidad es la responsabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031715
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031715,
					"content": "Después de todo, Rex Lapis es el Patrono de los contratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031716
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031716,
					"content": "¡Un momento! Tengo una última pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031717,
					"content": "¿Oh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031718
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031718,
					"content": "La Pequeña Ming... ¿quién es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031719,
					"content": "Al exorcizar demonios, de vez en cuando hay fantasmas que no le han hecho daño a nadie, y que no pueden trascender al otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031720
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031720,
					"content": "Por eso, les pedí a la jefa y al gerente que los recibieran por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031721
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031721,
					"content": "¡Así que la Posada Wangshu está cuidando de ella! Esta posada hace todo tipo de actividades comerciales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
