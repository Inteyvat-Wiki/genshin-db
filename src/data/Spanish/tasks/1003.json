					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10039301,
					"content": "Cuéntame sobre tu esposo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039302
					]
				},
				{
					"id": 10039302,
					"content": "Está por allá. Es el gerente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039303
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039303,
					"content": "No te dejes llevar por la descarada sonrisa en su rostro. Es un artista marcial bastante formidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039304,
					"content": "Yo también practico artes marciales, al igual que el personal de cocina. Es un requisito de contratación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039305,
					"content": "Tienes que ser ágil de manos y pies cuando estás sirviendo a los huéspedes, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 100394,
