			"dialogs": [
				{
					"id": 100090601,
					"content": "Los materiales ya están listos y el caldero alquímico está justo ahí... Podemos empezar cuando quieran. Aunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090602,
					"content": "¿Hay algún problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "No, no. Es solo que... ¿Te molestaría si lo observo todo desde un lado? Para poder registrarlo todo con precisión, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090604,
					"content": "Sé que a mucha gente no le gusta ser observada durante los experimentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090605,
					"content": "No hay ningún problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "#Gracias. Podemos empezar cuando estén list{F#a}{M#o}s. Yo me encargaré de registrarlo todo al detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090607,
					"content": "Entonces, ¿empezamos con el experimento?",
