			"dialogs": [
				{
					"id": 100090801,
					"content": "Terminado... El proceso ha sido perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090802,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Sí, no he visto ningún defecto en la preparación... Déjame extraer un poco para analizar la composición. Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090804,
					"content": "Sacarosa extrae unas gotas de la poción y usa un dispositivo para examinar su composición...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Sí, la ejecución fue perfecta, y la poción resultante también lo es. Es exactamente lo que esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090806,
					"content": "Entonces, ¿a la séptima fue la vencida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Después de examinarla, parece idéntica a las seis versiones anteriores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090808,
					"content": "Oh... ¿Eso significa que los resultados son idénticos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "No necesariamente. Los resultados de los experimentos pueden variar incluso con variables similares. Nunca se sabe cuál será el resultado... Eso es lo que hace que los experimentos sean valiosos en primer lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090810,
					"content": "Vamos, pongámoslo a prueba. Planté algunas flores dulces antes que podemos usar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 100090811,
					"content": "Tan solo tendremos que regarlas con una dosis de la poción y ver qué ocurre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sacarosa"
				}
			]
		},
		{
			"id": 1000909,
			"completionStepIds": [
				1000909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
