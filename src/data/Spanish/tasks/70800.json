			"dialogs": [
				{
					"id": 708001501,
					"content": "Ah, volviste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001502
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001502,
					"content": "Tengo la carne conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "¡Perfecto! ¿Eh? ¿Qué hay de Schuster? No se topó con un peligro, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001504,
					"content": "Ya debe estar bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "Me alegro de que esté a salvo... Lo invitaré a que pruebe mi nuevo plato cuando esté listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001506,
					"content": "De vuelta al tema, esta carne congelada no es como las demás. ¡Si uso este ingrediente, quizás pueda lograr ese “bum”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001507,
					"content": "Pero si quiero que tenga sabor a viento, necesito semillas de diente de león para condimentarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001508,
					"content": "Si lo dejo así como está, no habrá gran diferencia con un plato de carne común y corriente. Le falta el ingrediente ganador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001509,
					"content": "¡Oh, lo tengo! A decir verdad, he visto a Xiangling un par de veces después de ese duelo culinario. La escuché decir que había un plato llamado “estofado de Slime con champiñones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001510,
					"content": "Nunca he usado un ingrediente tan novedoso como ese... Pero, si quiero hacer un plato innovador, debo usar ingredientes innovadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001511,
					"content": "#Viajer{F#a}{M#o}, te pido que me ayudes a buscar condensado de Slime y unas cuantas semillas de diente de león.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001512,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "Bien, gracias. Yo seguiré pensando en mi receta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
