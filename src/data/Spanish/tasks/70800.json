			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Miedoso Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "¡E-estoy vivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 708001302,
					"content": "#¿Fuiste tú quien encendió la hoguera? ¡Oh, bondados{F#a}{M#o} viajer{F#a}{M#o}! ¡Gracias, mil gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 708001303,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "Ahora que entré en calor, estoy un poco mejor... Vine porque acepté un encargo para recoger carne congelada de Espinadragón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 708001305,
					"content": "Al principio pensaba buscar por los alrededores, pero mientras caminaba perdí mi yesca, y antes de darme cuenta, ya estaba perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 708001306,
					"content": "Si no estuvieras aquí, no hubiera sabido qué hacer. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 708001307,
					"content": "¿Qué hay del encargo de Brook?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "¿Así que Brook te pidió que vinieras a buscarme? *Suspira*... Debe estar apurada. Pero, a decir verdad, no tengo fuerzas para llevar la carne de vuelta hasta Aguaclara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 708001309,
					"content": "Me da vergüenza, pero... ¿puedo pedirte que le entregues esta carne congelada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 708001310,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Muchas gracias. Debo regresar al campamento en la falda de la montaña y beber un poco de sopa caliente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Miedoso Schuster"
				}
			]
		},
