			"dialogs": [
				{
					"id": 708001001,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "#¿Eres...? Ah, te recuerdo, eres {F#la}{M#el} ayudante de Xiangling, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001003,
					"content": "El duelo culinario de la última vez dejó una fuerte impresión en mí, por supuesto que te recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001004,
					"content": "Quizás la última vez perdí ante Xiangling, ¡pero esta vez conseguiré hacer un plato con sabor a viento! Y después, ¡usaré ese plato para retar a Xiangling de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001005,
					"content": "Para este plato, le pedí especialmente a un aventurero que fuera a Espinadragón a recolectar un poco de carne congelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001006,
					"content": "Se llamaba Schuster. Pero por el momento no ha regresado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001007,
					"content": "Escuché que Espinadragón es muy peligroso. ¿Quizás ese aventurero se topó con algún peligro? ¿Podrías ir a buscarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001008,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
				},
				{
					"id": 708001009,
					"content": "¿De verdad? ¡Muchas gracias! Allá en la montaña hace un frío extremo, recuerda encender una hoguera de vez en cuando para preservar el calor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
