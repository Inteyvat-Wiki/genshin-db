					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Tengo pensado inventar un nuevo plato para el Festival de las Flores de Viento, uno que capte el “sabor a viento”. Ahora mismo estoy haciendo una lista de los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000203,
					"content": "Así que le pedí a Allan que me ayudara a cazar la carne más fresca que pudiera encontrar, pero está tardando mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000204,
					"content": "#Si sigue así, tal vez los ingredientes ya no estén frescos, así que, viajer{F#a}{M#o}, ¿puedo pedirte que vayas al Cañón Coronabrillante a ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000205,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Gracias. ¡Cuando regreses podrás probar mi nuevo plato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080006",
