					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "Gracias, con esto ya están listos todos los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000902,
					"content": "Buen trabajo, acepta esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000903,
					"content": "Pero ¿cómo preparar el plato para que tenga “sabor a viento”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000904,
					"content": "Al vapor y frito... Humm... si no, tomo como base el sabor auténtico de los ingredientes y echo encima las semillas de diente de león una vez que termine la cocción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
