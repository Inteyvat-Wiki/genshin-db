						"stepId": 7080006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "M-me salvaste. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000602,
					"content": "No imaginé que cazar jabalíes fuera un verdadero dolor de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000603,
					"content": "¿Qué hay de los ingredientes de Brook?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "¿Brook te envió? Ah... Si lo que quiere es carne cruda, conseguí un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000605,
					"content": "Pero le estaba prestando tanta atención a los jabalíes que no me di cuenta de que había monstruos en los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000606,
					"content": "Y aunque logré cazar unos cuantos jabalíes, los monstruos me rodearon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000607,
					"content": "#Viajer{F#a}{M#o}, ¿puedo pedirte que le envíes la carne a Brook? Yo iré primero a la catedral a pedirles que atiendan mis heridas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000608,
					"content": "*Suspira*, si me ve en este estado, Draff me dará otro de sus sermones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080007",
							"2"
