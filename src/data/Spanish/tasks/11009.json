				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ninguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Los he convocado a todos hoy para hacer un anuncio importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090102,
					"content": "Tal vez algunos de ustedes ya se han enterado de que recientemente tengo la intención de reconstruir la Cámara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090103,
					"content": "¿Reconstruir la Cámara de Jade? No será una tarea fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Así que los rumores eran ciertos... Por eso los precios de los materiales de construcción han aumentado tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changui"
				},
				{
					"id": 110090105,
					"content": "La Cámara de Jade significa mucho para la Srta. Ninguang. Participar en este proyecto sería una gran oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Srta. Ninguang, ¿en qué podemos ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Paciencia. Desde que se difundió la noticia hace unos días, muchas personas se pusieron en contacto conmigo para unirse al proyecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090108,
					"content": "Sin embargo, tengo algunas cosas entre manos que me gustaría encargarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090109,
					"content": "Ahora que se ha elegido el terreno y los materiales de construcción están listos, quedan tres elementos pendientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090110,
					"content": "Son los siguientes: plaustrita crepuscular, un núcleo de los prodigios y un talismán de los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090111,
					"content": "Perdone mi atrevimiento, conozco la plaustrita, pero nunca he oído hablar de los dos últimos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changui"
				},
				{
					"id": 110090112,
					"content": "Solamente cuando el tamaño de la plaustrita es lo suficientemente grande se le puede llamar “crepuscular”. Esa es la base para asegurar que la Cámara de Jade pueda elevarse en el aire. El núcleo de los prodigios, por otra parte, es el componente clave de la estructura mecánica de la Cámara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090113,
					"content": "En cuanto al talismán de los Adeptus, se usa para combinar eficazmente los dispositivos mecánicos con la taumaturgia adéptica y es igualmente indispensable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090114,
					"content": "Aunque son tres objetos raros, con sus contactos y habilidades, debería ser solo cuestión de tiempo hasta que los encuentren todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090115,
					"content": "Me tomo muy en serio el dicho “el tiempo es oro”. La eficiencia es de suma importancia. Compraré a buen precio los materiales que encuentren. Además, las tres primeras personas que los reúnan tendrán la oportunidad de hacerme una pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090116,
					"content": "Sea cual sea la pregunta, la responderé con sinceridad. Estoy segura de que esa recompensa estará a la altura de sus expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090117,
					"content": "Son cosas difíciles de encontrar, pero estaría bien poder preguntar por los planes de desarrollo de Liyue para el próximo año...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changui"
				},
				{
					"id": 110090118,
					"content": "¡Es un trato increíble! Quien logre conseguir información de la Srta. Ninguang, será el primero en hacerse con el mercado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Jaja, ¡qué casualidad! Oí rumores sobre la plaustrita no hace mucho. ¡Perdónenme, señores, pero me adelantaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Maldición... Debemos actuar pronto, ¡o nos arrebatarán esta oportunidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changui"
				},
				{
					"id": 110090121,
					"content": "¿Ninguang está reconstruyendo la Cámara de Jade? ¡Es muy importante, tenemos que participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "#Escucharon todo lo que dije, ¿no? ¿Qué les parece? ¿Están interesad{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090123,
					"content": "¿De verdad puedo preguntar cualquier cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Sí, responderé cualquier pregunta de la que conozca la respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090125,
					"content": "#(Quizás pueda preguntar sobre mi herman{F#o}{M#a}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "¿En serio? ¡Entonces Paimon te preguntará cómo hacer negocios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "¡Así nunca nos quedaremos sin Moras en futuros viajes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Jaja, por supuesto que sí. Sin embargo, el alcance de la información que se proporcione dependerá del desempeño que demuestren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090129,
					"content": "La reconstrucción de la Cámara de Jade requiere de una gran superficie, así que he dispuesto que se sitúe en la mina abandonada afuera de la Casa Dorada. En cuanto hayan reunido los materiales, llévenlos ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090130,
					"content": "Tengo otros compromisos, no podré ir con ustedes. Cuando lleguen allí, pónganse en contacto con mi secretaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090131,
					"content": "Recuerden que es una carrera contrarreloj. Es una oportunidad única, así que no dejen que otros se les adelanten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 110090132,
					"content": "#Ninguang sí que es una persona ocupada... ¡Rápido, nosotr{F#as}{M#os} también tenemos que ponernos en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Primero tenemos que salir de la Terraza Yujing... ¿Eh? Mira allá, {NICKNAME}, parece que está pasando algo extraño allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Señorita, veo que tiene un estilo elegante y una personalidad poco común. Se nota a simple vista que tiene madera para tomar la delantera en la competición de la Srta. Ninguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090135,
					"content": "Resulta que tenemos información sobre los materiales que podría ser de su interés. Vamos, busquemos un lugar tranquilo para hablar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090136,
					"content": "No, no me hace falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "No diga eso. ¡Oiga, no se vaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090138,
					"content": "¿Qué haces parado ahí? ¡Ve detrás de ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090139,
					"content": "Oh, cierto, ¡s-sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Valiente Chiang"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Jeje, vaya, vaya... La señorita no tiene a dónde ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090202,
					"content": "No se preocupe, no somos malas personas. Podemos intercambiar información valiosa por un poco de Moras, así nadie sale perdiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090203,
					"content": "Jefe, tengo un mal presentimiento sobre esto. Se ve que tiene un aura diferente a la de los demás, y su cabello es blanco. No parece una persona normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "El Valiente Chiang"
				},
				{
					"id": 110090204,
					"content": "¿Y qué? ¡Seguro que tiene dinero! ¿Cómo vamos a pagar esas deudas de nuestras apuestas si dejamos que el dinero se nos escape, ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090205,
					"content": "Ya se lo he dicho, no necesito su información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Si no lo entienden, volveré a decirlo de forma que no lo olviden más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "Oiga, señorita, usted parece una persona inteligente, ¿acaso tengo que decírselo más claro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090208,
					"content": "No se trata de si necesita o no la información, solo tiene que ser una buena chica y darnos el dinero. Así, nadie saldrá herido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090209,
					"content": "Yo no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "¡No pongas excusas! Yo sé que tienes dinero. Te lo he visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090211,
					"content": "Sí, te vi ir al Pabellón Liuli y pedir una mesa llena de platos, pero solo probaste un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090212,
					"content": "Luego fuiste al Quiosco Xinyue y al Restaurante Wanmin. Es siempre la misma historia: pides todas las especialidades, pruebas uno o dos bocados y luego te marchas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090213,
					"content": "Si no eres una chica rica, ¿cómo puedes tener hábitos tan extravagantes? Y, ya que eres tan rica, ¿qué hay de malo en compartir un poco con nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090214,
					"content": "Aunque mi maestra me haya ordenado no ponerle una mano encima a nadie en Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "No importa... Tal vez sea el destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Jefe, ya le dije que algo no anda bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "El Valiente Chiang"
				},
				{
					"id": 110090217,
					"content": "¿De qué tienes miedo? No estamos infringiendo la ley al vender información. ¡Si se atreve a hacernos algo, la demandaremos por una fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090218,
					"content": "¡Son ellos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "¿Eh? Son ustedes de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "¿La Geoarmada? ¿Qué hace la Geoarmada aquí? ¿Fueron ustedes? ¡Hum! ¿Por qué tienen que meterse en nuestros asuntos? Juro que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090222,
					"content": "¡Silencio! ¿Cómo te atreves a amenazar a civiles inocentes? ¡Vengan con nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Oh... Jeje... N-no se enfade, señor, déjeme explicarle con calma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Liu el Cicatrices"
				},
				{
					"id": 110090224,
					"content": "La Geoarmada se lleva a los delincuentes que acosaban a la mujer de cabello blanco.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "... Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "¿“Shenhe”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "Es mi nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#Ooh, ¡así que te llamas Shenhe! ¡Paimon se llama... Paimon y {F#ella}{M#él} es {NICKNAME}, {F#la compañera}{M#el compañero} de viaje de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "He oído hablar de ustedes. Gracias por ayudarme a solucionar la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "Sin embargo, podría haberlo resuelto yo misma. Según mis deducciones, bastaba con golpear la cabeza del hombre contra el suelo tres veces para que se rindiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "¡Guau! ¡N-no puedes hacer eso! ¡Eso es demasiado violento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Esto es Liyue, y aquí hay leyes y esas cosas, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "¿Leyes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "¿No has oído hablar de las leyes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "No, parece que no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "¿De verdad? Entonces, ¿cómo has...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "¿Ah? Me pareció oír algo extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "Era mi estómago... No he comido suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "Qué sincera es esta chica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "Hablando de eso, Paimon acaba de escuchar de esa gente que vas a muchos restaurantes, pides comida y solo pruebas un bocado de cada plato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "¡Con razón te quedaste con hambre! ¿Hay algo en especial que te gustaría comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "Flores chingxin, lirios de cristal, campanitas de cristal... Eso es lo que como normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "Pero todas esas son hierbas medicinales...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "¿Cómo que medicinales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "Es difícil explicarlo... pero la Farmacia Bubu está por aquí, ¿por qué no llevamos a Shenhe a comer algo bueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Después de todo, ¡no se puede trabajar con el estómago vacío!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "No te preocupes, ya todo está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Esos tipos están haciendo negocios a la fuerza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herborista Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "¿Vienen por hierbas medicinales? Espero que hayan traído su receta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 110090302,
					"content": "Flores chingxin, lirios de cristal y campanitas de cristal... Un cuarto de kilo de cada cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "¿Qué tipo de receta es esa? Eso es tomar medicina como si fuera comida... Aquí tienes, esto es todo lo que hay en la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 110090304,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "¡De verdad se está comiendo las hierbas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Mientras todos observan atónitos, Shenhe acaba con las hierbas que tiene delante.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Ya estoy satisfecha, muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "¿Qué tal saben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Son horribles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Huelen muy bien, pero después de comer demasiado solo se nota un sabor amargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Entonces, ¿por qué prefieres comer esto en lugar de la comida de los restaurantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Si Paimon tuviera mucho dinero, iría a los mejores restaurantes y pediría montones de buena comida, ¡y se la comería toda de una sentada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Porque no estaba segura de si me quedaría aquí en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "La comida humana es deliciosa, pero si volviera a las montañas en el futuro, el gusto por ella se convertiría en un obstáculo para mi entrenamiento espiritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Así que es mejor solo probar un poco para entender los sabores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#¿Volver a las montañas...? {NICKNAME}, no cabe duda, ¡definitivamente es una Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Dejando mis asuntos de lado, ¿cuáles son sus próximos planes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "¡Oh, sí! Paimon casi lo olvida, ¡estamos aquí para competir en la reconstrucción de la Cámara de Jade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "Y... y ahora seguramente nos habremos quedado muy atrás porque nos entretuvimos demasiado tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Ya veo. Me enteré de esa competencia cuando pasaba por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "Jeje... Sí, ¡podrás preguntarle a Ninguang lo que quieras si ganas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "¿Tú también viniste a participar en la competición, Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "Vine con el propósito de restaurar la Cámara de Jade, pero no había considerado participar en una competencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "Ahora que he recibido sus atenciones, me gustaría ayudarles. No se preocupen, no espero nada a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "¡Guau! No tienes por qué hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "Pero con la ayuda de una Adeptus, las cosas serían mucho más fáciles, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Entonces, unamos fuerzas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Pues no perdamos más tiempo. Tengo un plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "¡Genial! ¡Paimon está segura de que será un plan genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "No estoy segura de hasta qué punto se puede clasificar como “genial”, pero debería ser efectivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "#Eliminando a todos los que están por delante de nosotros en la clasificación, seremos {F#las}{M#los} número uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "... ¡Ni hablar! ¡No podemos hacer eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "¿En serio? Pero he oído que la competencia en sí consiste en conspirar y ponerse en contra de los demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "#¡No, nosotr{F#as}{M#os} vamos a conseguir el primer puesto limpiamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "Plaustrita crepuscular, un núcleo de los prodigios, y un talismán de los Adeptus... Los buscaremos en orden, empezando por la plaustrita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Me preguntaba quiénes podrían estar discutiendo en mi tienda. Así que son ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "¿Baizhu? ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "La Srta. Ninguang necesita comprar un lote de medicina para heridas, y es posible que la tienda no tenga suficientes hierbas, así que salí para recoger los ingredientes yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "¿Eh? ¿Para qué necesita Ninguang tanta medicina para heridas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "No estoy seguro. He oído que va a reconstruir la Cámara de Jade, ¿quizás sea para el botiquín de primeros auxilios de la obra? De todos modos, se trata de la privacidad de un cliente, así que no tengo la libertad de preguntar de más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "#También me pidió prestada a Qiqi, así que estoy escaso de ayuda en la Farmacia Bubu en este momento... ¿Algun{F#a}{M#o} de ustedes busca trabajo de medio tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "#No, no, no. Nosotr{F#as}{M#os} estamos ocupad{F#as}{M#os} ahora mismo. Pero, ahora que lo mencionas, tú sabes muchas cosas. Por casualidad, ¿no habrás oído sobre la plaustrita crepuscular?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Ah, te refieres al tipo que se usará en la Cámara de Jade, ¿sí? Recuerdo que los «Tratados de las siete montañas» mencionan que la plaustrita crepuscular puede subir directamente a las nubes cuando se activa y es muy rara.",
