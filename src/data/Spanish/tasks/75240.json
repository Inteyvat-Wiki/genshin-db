				"objectNames": [
					"Nahuatlalli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "#Bienvenid{F#a}{M#o} a la Copa Héroes de Ayar, amig{F#a}{M#o}. Yo soy la anfitriona de esta competición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400102,
					"content": "Hoy es el último día de la competición. Si quieres ganar, tendrás que derrotar a nuestros tres mejores guerreros uno tras otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400107,
					"content": "¿Qué es la Copa Héroes de Ayar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "Es una lucha por la gloria de Ayar. ¡Utiliza tus puños, armas o cualquier otro truco para derrotar a tu oponente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400109,
					"content": "¿Y Ayar es una persona o...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "#Amig{F#a}{M#o} mí{F#a}{M#o}, ¡solo los campeones tienen derecho a hacer preguntas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400111,
					"content": "¡Sube al escenario! Veamos si tienes la fuerza para ganarte ese respeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahuatlalli"
				}
			]
		},
