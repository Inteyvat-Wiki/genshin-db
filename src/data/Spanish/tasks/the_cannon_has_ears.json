					}
				]
			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "Fréjus, llevamos medio día así y el número de monstruos no se ha reducido nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870102,
					"content": "¿Debería ir a pedir refuerzos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870103,
					"content": "No hay nada de que preocuparse. ¡Confía en mi torreta y en nuestra compañera infiltrada de civil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870104,
					"content": "#Además, hay {F#una aventurera}{M#un aventurero} que siempre percibe el peligro y {F#una}{M#un} oficial que siempre aparece en momentos de crisis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870105,
					"content": "¿Cuál es la crisis esta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "#¡Ahí están! ¡{F#La}{M#El} cuasilíder y su ayudante aparecieron de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870108,
					"content": "Hola. Permítanme explicarles brevemente lo que está pasando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870109,
					"content": "¿Por qué no descansas un poco? Yo me encargo de explicar lo que ocurre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870110,
					"content": "*Ejem*, ¿quieres probar a manejar una torreta? No se tiene una oportunidad como esta todos los días, al menos desde que la flota fue destruida. ¡Será como teletransportarse cientos de años al pasado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870111,
					"content": "¡Hacer añicos a los monstruos con los proyectiles especiales de esta torreta es una actividad perfecta para descargar tensión! Es más, ¡la Guardia hasta te recompensará por ello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870112,
					"content": "Disparar a monstruos... ¡Esa es nuestra especialidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870113,
					"content": "No suena muy complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "#Fréjus, sé que estás eufórico, pero deberíamos estar un poco nerviosos. Deja que yo ponga al corriente a {F#la}{M#el} cuasilíder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870116,
					"content": "Hace poco, unos trabajadores desenterraron unas ruinas en los alrededores y despertaron a los monstruos que había durmiendo en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870117,
					"content": "Para evitar que escaparan, la Guardia creó un frente de contención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870118,
					"content": "Bueno, digo “frente”, pero en realidad solo estamos nosotros dos, una agente melusina que está de vacaciones y una torreta que hemos mejorado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870119,
					"content": "Guau, ¡suena peligroso! ¿Está bien esa agente melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870120,
					"content": "Sí, no se preocupen. No tiene que pelear en el frente para detener a los monstruos, ya que puede hacerlo manejando a distancia la torreta que hay en la salida de las ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870121,
					"content": "Es alguien en quien podemos confiar, pero trabajar durante tanto tiempo acabará agotándola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870122,
					"content": "#¿Estarías dispuest{F#a}{M#o} a ayudarnos, cuasilíder? Si la situación se complica, iré a buscar más refuerzos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870123,
					"content": "#¿Qué dices, Chênée? Sabes lo hábil que es {F#la}{M#el} cuasilíder, ¡deberíamos dejarle usar mi torreta para acabar con todos los monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870124,
					"content": "No se hable más. Me encantaría probarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "¡Ignorar los problemas no es nuestro estilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870127,
					"content": "Fantástico. Muchas gracias por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870128,
					"content": "Después del último experimento, volví a hacer unos ajustes a mi invento. Espero que les sea fácil manejarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870129,
					"content": "*Suspira*, si tan solo pudiéramos hacer que apuntara y disparara automáticamente... ¿Crees que podrías hacerlo, Fréjus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870130,
					"content": "¡Claro! La próxima vez, probaré a instalarle el módulo de reconocimiento de un Mecagendarme para que funcione de manera autónoma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 746870131,
					"content": "¡Sabía que podrías hacerlo, Fréjus! ¡Qué inteligente eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chênée"
				},
				{
					"id": 746870125,
					"content": "Da igual lo complicada que sea la situación, quiero ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "Pero ¿por qué de repente hay que disparar a monstruos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "¿Llegamos justo a tiempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
		{
