				]
			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "¡Han venido los refuerzos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870302,
					"content": "¿Eh? ¿Qué hacen ustedes aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870303,
					"content": "¿N-no podemos estar aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "¿Nos conocemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870305,
					"content": "#Tranquil{F#a}{M#o}s, tranquil{F#a}{M#o}s, no hay ningún problema. ¡Me alegro de tener aquí a unas personas tan famosas como ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870306,
					"content": "En mi puesto de trabajo, cuando volví a la aldea, todo el mundo decía que se podía confiar en ustedes para cualquier cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870311,
					"content": "En comparación con ustedes, aunque mis dos compañeros son de fiar, a veces son un poco... extraños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870312,
					"content": "Las emociones humanas son tan complicadas... En fin, ¿deberíamos darles un empujoncito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870313,
					"content": "¿“Extraños”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "Olvídalo, tenemos cosas más importantes de las que hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870315,
					"content": "¡Ánimo con ello! Ya verán que la torreta no es difícil de manejar. Seguro que se desharán de esos monstruos en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870307,
					"content": "Nos hemos visto antes, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "¿Te acuerdas de mí? Te envié mi currículum cuando estabas contratando empleados para el Parque Kinográfico Chevalmarine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870309,
					"content": "Humm, sí, a Paimon le quiere sonar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870310,
					"content": "Sé que son muy fuertes y que se puede confiar en ustedes para lo que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				}
			]
		}
	]
}