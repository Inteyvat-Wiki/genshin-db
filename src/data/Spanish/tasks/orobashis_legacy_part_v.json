				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "¡Agradecemos tu esfuerzo! Aunque la isla sigue siendo muy peligrosa, las personas que tuvieron que abandonar su hogar ahora tienen alguna esperanza de volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Aunque ahora que ya ha parado la tormenta, es posible que ambos bandos avancen de forma aún más agresiva para luchar por la isla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "En cuanto a la situación de la isla, aunque ellos no tienen tiempo de cambiarla, lo que nosotros hacemos al menos es mejor que dejar que se deteriore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Por eso, el regalo de agradecimiento que acordamos será tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Esta es la famosa lanza que utilizó el gran prefecto de Yashiori. No sé si este dibujo te será muy útil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Pero si se lo das a un hábil herrero, podrá restaurar la gloria de la que gozó cuando estuvo en manos de Kitain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*Suspira*, ya no estamos en la era de los héroes, y Kitain, que con tantos males acabó, nunca volverá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Pero gracias a ti, nos hemos acercado un paso más a los logros de Kitain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "A continuación iré a ver a mi amigo del shogunato para ver en qué puede ayudarnos. Espero que volvamos a vernos algún día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
