				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "Algunas montañas de la isla han perdido su vegetación y sus corrientes de agua. ¿Sabes cómo dragar los cauces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700402,
					"content": "Creo que sé quién podría ayudarnos con este asunto. Arriba vive mi compañera, Corazón Gélido. Vayan a preguntarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Corazón Llameante"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Corazón Gélido",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "¿Quiénes son ustedes? ¿A qué vienen a mi morada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "Corazón Gélido"
				},
				{
					"id": 400700502,
					"content": "Hola. Nos preguntábamos si podíamos usar su poder para desbloquear los cauces en las montañas de la isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700503,
					"content": "¿Montañas? Ah, ya veo... Ustedes también quieren ser grandes músicos, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "Corazón Gélido"
				},
				{
					"id": 400700504,
					"content": "Oh, ¿así que de eso se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400700505,
					"content": "Exactamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700506,
					"content": "En ese caso, buscamos lo mismo. A pesar de mi fragilidad, me siento obligada a compartir parte de mi poder contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "Corazón Gélido"
				},
				{
					"id": 400700507,
					"content": "Planten mi pétalo en donde confluyen las melodías, y aquello que alguna vez se sumergió en la tierra brotará de nuevo con la música. Siempre y cuando haya música, la vida continuará floreciendo en este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "Corazón Gélido"
				},
				{
					"id": 400700508,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701002,
					"content": "Por fin, el momento ha llegado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701003,
					"content": "Escuchen todos, un día pedí el deseo de tocar en un concierto con alguien que nadie habría esperado. Hoy encontré la respuesta en esta isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701004,
					"content": "Nadie sabe cómo se llama ni qué aspecto tiene la persona que convirtió esta isla en un enorme instrumento musical hace tantos años, pero seguro que fue uno de los mejores músicos de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701005,
					"content": "Nunca pensé que vería un instrumento musical así, y mucho menos imaginé que podríamos tocarlo durante la marea alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701006,
					"content": "¿Vas a tocar un poco de rock?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701008,
					"content": "La música es un regalo para las almas afines, así que tocaré algo más adecuado para un dúo con el músico de estas tierras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701009,
					"content": "No más rock por hoy, ¡les mostraré algo nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701010,
					"content": "*Fiu*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701011,
					"content": "¿Qué les parece? Nada mal, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701012,
					"content": "Impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701013,
					"content": "Nunca había oído un dueto así. Muy interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701014,
					"content": "¡Y muy elegante! Paimon no sabe cómo expresarlo, pero fue... diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701015,
					"content": "Una interpretación con mucha personalidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "Jeje, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701018,
					"content": "Con esto, doy mi deseo por cumplido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701019,
					"content": "¿Hay algo más que quieras hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701020,
					"content": "No. Hoy dormiré como un bebé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701021,
					"content": "Entonces nadie tiene planes, ¿cierto? Tengo una sugerencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701022,
					"content": "Me gustaría volver a visitar el campamento de los Fatui para ver cómo está la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701023,
					"content": "¿Eh? ¿Ustedes también vieron el campamento de los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701024,
					"content": "Espera, ¿tú también lo sabías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701025,
					"content": "Soy una genio de la astrología. Por cierto, ¿les he dicho que mi artilugio de adivinación ya está un poco mejor? Ya puedo percibir lo que está ocurriendo con mis predicciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701026,
					"content": "¿Eh? ¿Los Fatui están aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701027,
					"content": "Así es. También se lo advertí a Fischl cuando nos separamos hoy. Si se encuentra con los Fatui, se esconderá para evitar el peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701028,
					"content": "Ya veo. Entonces deberíamos contarles lo que sabemos nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701029,
					"content": "Cuentas cómo encontraste el campamento Fatui y la máquina extraña cuando llegaste a las islas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "Una máquina extraña, un Fatui delirante... ¿Estás diciendo que todo esto está relacionado con las ilusiones recientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701031,
					"content": "No puedo decirlo con seguridad, pero creo que alguna relación deben tener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701032,
					"content": "Tiene sentido. Vayamos a inspeccionar el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701016,
					"content": "Una actuación encantadora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
		{
			"id": 4007016,
