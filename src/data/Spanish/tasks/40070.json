					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701601,
					"content": "Qué extraño. En todo el camino solo encontramos monstruos autóctonos de la isla, pero ningún rastro de los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701602,
					"content": "Qué extraño... Aún hay rastros en el campamento, y la máquina está aquí, pero la gente ha desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701603,
					"content": "(Me pregunto si la máquina de los Fatui tiene que ver con la creación de las ilusiones. Parece que está rota, así que quizás esa es la causa del problema).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701604
					]
				},
				{
					"id": 400701604,
					"content": "(Si la máquina puede causar alucinaciones, ¿por qué desaparecieron ellos? ¿Está ocurriendo algo más?).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701605
					]
				},
				{
					"id": 400701605,
					"content": "(¿Habrán desaparecido? ¿O se estarán escondiendo de nosotros?).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701606
					]
				},
				{
					"id": 400701606,
					"content": "Me rindo. Intentaré adivinar la respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701608,
					"content": "¿Qué es esto? ¿Una especie de flujo de energía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701609,
					"content": "Lo siento, no encuentro ningún rastro de los Fatui. El artilugio de adivinación se ha enturbiado de nuevo, pero en esta ocasión noto algún tipo de fuerza que está tomando forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701610,
					"content": "Y su objetivo es... esa isla de allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701611,
					"content": "¿De quién será la ilusión esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701612
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701612,
					"content": "Humm... Vayamos a echar un vistazo. Quizás esta vez encontremos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007017,
			"completionStepIds": [
				4007017
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
