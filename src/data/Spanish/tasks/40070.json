				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701701,
					"content": "Hemos llegado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701702,
					"content": "¿Eh? ¿Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701704,
					"content": "¡De verdad es ella! ¡Hola, Fischl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701705,
					"content": "¡Hum! Al fin arribaron, mis imprudentes súbditos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701706,
					"content": "Vaya, ¡cuánto tiempo sin vernos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701707,
					"content": "No pasó tanto tiempo, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701708,
					"content": "*Ejem*, la señorita y yo detectamos un aura peculiar y nos adelantamos para reunirnos con ustedes. No esperábamos que... quiero decir, llegaron antes de lo que pensamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701709,
					"content": "¿Es solo Paimon u Oz está un poco nervioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701710,
					"content": "El advenimiento del Reino de la Noche Eterna es inminente. Necesito prepararme para la ceremonia de consagración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701711,
					"content": "Señorita, ¿está segura de...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701712,
					"content": "Puedo hacerlo sola, Oz. Si te preocupa la oscuridad de la noche que se cierne sobre nosotros, eres libre de retirarte a la luz radiante del día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701713,
					"content": "Señorita, no diga eso, por favor. Soy su fiel sirviente y sus ojos. Nunca me separaré de usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701714,
					"content": "¡Dejen de mirarme así! E-en fin, el momento de las explicaciones aún no ha llegado. ¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701715,
					"content": "¡Oh, señorita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701716,
					"content": "Disculpen. La señorita ha tenido un mal día, no se lo tomen a pecho. Con su permiso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701717,
					"content": "¡Ja! Parece que alejarse del grupo tanto tiempo no mejoró su humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701718,
					"content": "En cuanto vi a Fischl, me di cuenta de que la ilusión que va a aparecer en esta zona tendrá algo que ver con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701719,
					"content": "Sí... Yo, al menos, tuve una sensación muy familiar conforme me acercaba a mi ilusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701720,
					"content": "Yo también. Quizás no tenga sentido, pero tuve la impresión de que algo emocionante iba a pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701721,
					"content": "Exacto. Si Fischl y Oz también sienten algo, nuestras sospechas deben de ser ciertas. Quizás Fischl está nerviosa porque no quiere enfrentarse su ilusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701722,
					"content": "¿Y eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701723,
					"content": "Puede que en su ilusión haya algún secreto que ella no quiere que otros sepan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701724,
					"content": "Descansemos aquí por el momento. Cuando aparezca la ilusión, podremos llegar al fondo de todo este misterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
