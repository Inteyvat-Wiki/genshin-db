				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701901,
					"content": "Ya plantamos el pétalo. ¿Notas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701902,
					"content": "Sí, puedo sentirlo. El sol brilla, el mar emite un resplandor iridiscente, las olas acarician la playa, y la arena fluye mientras va y viene en la marea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "Corazón Gélido"
				},
				{
					"id": 400701903,
					"content": "Las aves marinas se posan sobre las rocas, picoteándolas suavemente al ritmo de la música. Toc, toc... Toc, toc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "Corazón Gélido"
				},
				{
					"id": 400701904,
					"content": "Es a lo que yo llamo “música”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701905,
					"content": "Ciertamente, es música. Esta isla es un instrumento gigante. Ya que eres una artista musical, seguramente comprendes lo significativo que es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "Corazón Gélido"
				},
				{
					"id": 400701906,
					"content": "Interpretar música con la brisa marina, las olas y la marea como instrumentos es lo más romántico del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701907,
					"content": "Andando. Es hora de mi actuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		}
	]
