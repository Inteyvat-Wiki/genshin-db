				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701801,
					"content": "Hicimos lo que pudimos, pero ¿cómo hacemos con las últimas dos montañas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701802,
					"content": "Sigamos pensando. Tiene que haber una solución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701803,
					"content": "Después de mirarlo con detenimiento, parece que la mayoría de las montañas de la isla tienen corrientes de agua subterráneas y plantas. Todo esto conforma un sistema que conecta a las montañas entre sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701804,
					"content": "Sin embargo, ahora que muchas de las montañas colapsaron, la conexión entre las plantas y las corrientes de agua está obstruida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701805,
					"content": "Si dragamos todas las obstrucciones, podríamos conectar las islas para formar el instrumento gigante que menciona Albedo en sus notas, y hacer música usando las propias islas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701806,
					"content": "Sí, tengo que hacerlo para alcanzar mi objetivo. Quisiera consultarlo con la flor, ella sabrá qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007019,
			"completionStepIds": [
				4007019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
