				]
			},
			"dialogs": [
				{
					"id": 750680301,
					"content": "¿Por qué sigues aquí?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680302,
					"content": "Hasta el líder de nuestro grupo de aventureros, el héroe con máscara de halcón, él... Ya no tenemos forma de resistir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680303,
					"content": "#Márchate cuanto antes, este lugar está maldito. Guerrer{F#a}{M#o}, las personas no deberían estar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
