				]
			},
			"dialogs": [
				{
					"id": 750680401,
					"content": "#Sigues aquí, guerrer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680402
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680402,
					"content": "En el pasado, los sabios decían que el señor tirano de esta Ciudad de las Cenizas... conocía una forma de detener la entrada del Abismo, por eso nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680403
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680403,
					"content": "#Sin embargo, este lugar es realmente extraño, guerrer{F#a}{M#o}. Últimamente, me siento algo... raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680404
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680404,
					"content": "A veces, al despertar, me doy cuenta de que un camino que estaba bien el día anterior, aparecía completamente destrozado... ¿Esas casas de piedra eran así antes? Tengo la impresión de que deberían estar en mejor estado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680405
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680405,
					"content": "Pero otras veces, cuando me despierto, puedo ver a amigos que no deberían seguir en este mundo... ¿Serán monstruos? Eso debe ser... monstruos que tomaron la forma de mis amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680406
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680406,
					"content": "Mi deber aquí... es acabar con esos monstruos, pero... ¿por qué tengo que hacer eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680407
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680407,
					"content": "En fin, este lugar es muy extraño. Sal de aquí cuanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
