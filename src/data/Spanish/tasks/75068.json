			},
			"dialogs": [
				{
					"id": 750680101,
					"content": "#Qué pesados son estos seres inhumanos... Mejor dicho, monstruos. Saludos, guerrer{F#a}{M#o}. Soy Quenin, un miembro del grupo de aventureros. Mi deber es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680102,
					"content": "#Mi deber es... aniquilar estos monstruos. Sí, soy un guerrero del grupo. Debes tener cuidado, valiente guerrer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680103,
					"content": "Estos monstruos son muy astutos y capaces de tomar diferentes formas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680104,
					"content": "Todas las noches antes de dormir puedo oír los sonidos que hacen desde sus escondites en las ruinas antiguas. Por esta razón, en el campamento me es imposible conciliar el sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680105,
					"content": "Este lugar está lleno de esos monstruos, así que no bajes la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
