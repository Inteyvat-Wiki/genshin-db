			},
			"dialogs": [
				{
					"id": 750680201,
					"content": "Ah... sabía que este lugar estaba maldito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680202,
					"content": "No te quedes aquí mucho tiempo, vete pronto... Sí, tienes que abandonar este sitio antes de que llegue la ola negra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680203,
					"content": "Sí, la ola negra. Esa sombra gigantesca ya casi está aquí. T-tengo que asegurarme que todos estén a salvo... antes de que llegue el peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
