			},
			"dialogs": [
				{
					"id": 750680501,
					"content": "Es mejor que te vayas ahora o será demasiado tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680502,
					"content": "¿Que por qué será demasiado tarde? Ah, es p-porque todos los miembros de nuestro grupo de aventureros fueron aniquilados. Ese monstruo gigante y negro los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680503,
					"content": "Me ordenaron proteger a las personas para que puedan irse, al menos hasta que abandonen esta ciudad. Los socorristas de la Tribu Plumaflora están en camino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680504,
					"content": "Tengo que eliminar a esos malditos monstruos, así la gente que queda podrá regresar a una tierra bañada por la luz... Pero... ¿por qué estoy aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680505,
					"content": "Los sonidos que me rodean... se están volviendo cada vez más fuertes, yo... tengo que regresar a donde está la cascada. Sí, tengo que... regresar a la cascada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680506,
					"content": "#Guerrer{F#a}{M#o}, tú también tienes que irte lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
