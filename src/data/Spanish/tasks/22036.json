					"content": "Primero debes agregar <color=#37FFFF>hojas trituradas</color> a los fertilizantes y, después, un poco de <color=#37FFFF>agua</color>. Por último, <color=#37FFFF>mézclalo todo bien</color> y espárcelo en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360410
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360410,
					"content": "#Cuento contigo, viajer{F#a}{M#o}... Debemos esforzarnos y, con un poco de suerte, ¡este mes, el negocio irá mucho mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
