			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "Qué duro es este negocio. Toda mi mercancía es realmente buena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "... Pero ¿por qué nadie quiere comprarme nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "#Oh, eres tú, viajer{F#a}{M#o}. *Suspira*, ni lo menciones. Sigo sin vender ningún fertilizante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "¿No te estaba ayudando Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Me ayudó un poco. Pero el problema es que ninguno de los dos sabemos cómo promocionar estos productos. Solo esperamos a que aparezcan los clientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "Y ya sabes cómo están las cosas en Ritou. Nadie compra nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Por eso, visité a los señores de la cámara de comercio para pedirles ayuda, y me sugirieron que hiciéramos algo llamado “mercadotecnia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "En concreto, quieren que hablemos con los clientes de los efectos de los fertilizantes y de sus principios de funcionamiento. También deberíamos hacer más promoción basada en datos y deberíamos ofrecer un servicio de “pruebas gratuitas”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Pero... la verdad es que no entiendo esas cosas tan complicadas. Y no soy yo a quien se le ocurrieron estos fertilizantes, así que ¿cómo voy a explicarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "De todos modos, aunque solo sea para leer en alto las instrucciones, creo que tendré que darme una vuelta para promocionarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "#Alrani ya ha salido a hacerlo. Yo también saldré más tarde. Viajer{F#a}{M#o}, ¿podrías ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Cuenta conmigo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "#¡Excelente! Contamos contigo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "El lugar al que quiero que vayas se llama Aldea Konda. No está lejos de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "Un señor llamado Konda Densuke mostró cierto interés por nuestros fertilizantes. También vino a la tienda a charlar conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Si pudieras promocionar algunos de nuestros productos en el lugar donde vive y ofrecerle una prueba gratuita, probablemente compre algunos fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "¿A dónde fue Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Dijo que necesitaba ir a buscar algunos materiales y que tendría que ir bastante lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "El lugar al que quiero que vayas se llama Aldea Konda. No está lejos de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203602,
			"completionStepIds": [
				2203602,
				2203608
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
