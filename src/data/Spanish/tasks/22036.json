			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "¿Cómo se usa el fertilizante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Ah, sí, claro, aún no te lo he explicado. Los fertilizantes que quiero que le lleves deben utilizarse de una manera determinada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "A ver... según el manual, el orden debería ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Primero debes agregar <color=#37FFFF>agua</color> a los fertilizantes. Después, añade unas <color=#37FFFF>hojas trituradas</color> y, por último, <color=#37FFFF>mézclalo todo bien</color> y espárcelo en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "No te equivoques, por favor, o podría causar problemas que afectarán a la impresión que nuestros clientes tienen de nosotros. Nuestro futuro negocio está en juego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Bien, cuento contigo. Una vez que entregues la Bendición de Anahita al cliente, su primer pago será tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "¿Podrías repetírmelo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Primero debes agregar <color=#37FFFF>agua</color> a los fertilizantes. Después, añade unas <color=#37FFFF>hojas trituradas</color> y, por último, <color=#37FFFF>mézclalo todo bien</color> y espárcelo en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "#Cuento contigo, viajer{F#a}{M#o}... Debemos esforzarnos y, con un poco de suerte, ¡este mes, el negocio irá mucho mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
