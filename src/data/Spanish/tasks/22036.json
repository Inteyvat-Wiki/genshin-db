			"dialogs": [
				{
					"id": 220360501,
					"content": "#Jovencit{F#as}{M#os}, nos encontramos de nuevo. ¿Qué les gustaría saber esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360502,
						220360503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360502,
					"content": "Esta vez no vine para hacer preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				},
				{
					"id": 220360504,
					"content": "Oh, ¿te envió Vahid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360505,
					"content": "Oí hablar de una novedosa tienda de fertilizantes en Ritou. Por eso fui a conocer al señor Vahid, para probar sus fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360506,
					"content": "Si funcionan y aumentan la producción de cultivos, podría haber esperanza para restaurar la Aldea Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360507,
					"content": "Supongo que todavía soy yo, una vieja reliquia, quien debe revitalizar la aldea. Esos jóvenes de la aldea... ¡Uf! No se puede contar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360508,
					"content": "Muy bien, dime entonces. ¿Cómo debo utilizar estos fertilizantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360509,
					"content": "Añade primero el agua y las hojas trituradas y mézclalo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "Qué procedimiento tan complicado para unos fertilizantes... Muy bien, creo que ya lo tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360510,
					"content": "Añade primero las hojas trituradas, luego mézclalo y, al final, añade el agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360511,
					"content": "Añade las hojas trituradas, luego añade el agua y, por último, mézclalo todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360503,
					"content": "Estoy aquí para hablarte de cómo utilizar fertilizantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				}
			]
