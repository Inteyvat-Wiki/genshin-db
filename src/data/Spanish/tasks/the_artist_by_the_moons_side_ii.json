			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510102,
					"content": "¿Qué pasa, Colombina? No estarás en problemas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510103,
					"content": "¿Tienen pintura con ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510104,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510105,
					"content": "¡Ah! Tú eres... Maalaus, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510106,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510107,
					"content": "¿Quieres ponerte a pintar otra vez? ¿Cómo has hecho para llenarte entera de pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510108,
					"content": "Salió un rato y, al volver, ya estaba así. No he podido quitarle el color por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510109,
					"content": "¿Se habrá encontrado con algún problema al buscar inspiración en el exterior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510110,
					"content": "Aunque así también tiene buen aspecto... ¡Parece toda una artista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510111,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510112,
					"content": "Ah, hablando de pintura, ¿bastará con que le demos algunas cosas de colores, como la última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510113,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510114,
					"content": "Jeje, con lo contenta que está, ¡seguro que encontró algo que la inspiró fuera! Algo que la tiene así de alegre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510115,
					"content": "Bueno, esta vez deberíamos entregarle colores cálidos y alegres a Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
