				]
			},
			"dialogs": [
				{
					"id": 760510301,
					"content": "Esto debería ser suficiente, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "¡Oh, ya ha empezado a pintar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "#*Ejem*... Querid{F#a}{M#o}s jue{F#zas}{M#ces}, ¡prepárense para quedar maravillad{F#a}{M#o}s! ¿Con qué nos sorprenderá la increíble pintora kuuhenki Maalaus esta vez?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "¡Eh! ¿Ya has terminado? ¡Pero si Paimon ni siquiera ha podido acabar la presentación que preparó para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "¡Oh, parece que esta vez también ha pintado a Colombina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "Es muy bonito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "¿Es... en un bosque de Nod Krai? ¡Hay un montón de animales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "Me temo que... es una escena de cuando aún no había dejado a los Descendientes Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510312,
					"content": "¡Vaya! ¿De verdad se te acercaban todos esos animalitos? ¡Qué envidia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Sí, a la mayoría le encantaba el kuuvahki que irradio, así que se me acercaban para dormir a mi lado en completa paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510314,
					"content": "¡Guau! ¡Así podrías acariciarlos cuando quisieras sin que salieran corriendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Oh... Los tejones mantomelena eran los más suaves al tacto, tenían una cola enorme y blandita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510316,
					"content": "El pelaje que tienen los ciervos astaglaciales en el cuello también es muy suave. Dormir apoyada sobre ellos es muy cómodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510317,
					"content": "¿Cuál les gusta a ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510318,
					"content": "#Eh, nosotr{F#a}{M#o}s no tenemos la experiencia necesaria para poder responder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Pero si Paimon tuviera que dar una respuesta... diría que querría acariciar la cola de un tejón mantomelena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Algunos tejones mantomelena son muy tímidos y, si el entorno no parece seguro, no dejarán que otros los toquen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510321,
					"content": "Ah... Pero deberías tener cuidado, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510322,
					"content": "¿Eh? ¿Qué pasa? ¿Acaso muerden? P-Paimon no los hará enojar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "No, me refiero a que deberás tener cuidado con el cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510324,
					"content": "¿El cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Sí, algunos ibis plumalarga cazan animales pequeños. Antes incluso tenían la costumbre de atrapar kuuhenki, pero les advertí que no lo hicieran y poco a poco fueron cambiando de hábito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510326,
					"content": "¡Podrías habernos dicho eso cuando nos conocimos! ¡Es un milagro que uno de ellos no se haya llevado aún a Paimon volando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Oh... Está bien, la próxima vez que vea un ibis plumalarga, les advertiré de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510328,
					"content": "¡No, hazlo ya! ¡Si no, Paimon no se atreverá a salir de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Entonces, debería decirles a los ibis plumalarga que eres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510330,
					"content": "La mejor compañera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "¡Eso, eso! ¡No se pueden llevar volando a una gran compañera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "Esta pequeñina... Parece que le ha interesado la idea de Paimon siendo atrapada por un ibis plumalarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760510338,
					"content": "¡Que no se le ocurra pintar una escena así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "La mejor guía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Eh... Paimon se alegra de que pienses eso, pero no creo que los ibis plumalarga sepan lo que es una “guía”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Algo que podría hacerles enfermar si se lo comen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "¡A Paimon no le gusta que la condición de esa frase sea acabar en su estómago! ¿Qué pasará si un ibis plumalarga quiere tentar a la suerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "#Me pongo content{F#a}{M#o} solo de verlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
