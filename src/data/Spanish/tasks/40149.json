			},
			"dialogs": [
				{
					"id": 401490401,
					"content": "¿Lo que sea? Por Los Siete, esa es la mayor pesadilla de los cocineros. Sin tener idea de las preferencias de los clientes, solo puedes ir probando a ciegas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490402
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401490402,
					"content": "Aun así, ya que llevas tantos días trabajando en la cocina, tengo fe en que serás capaz de resolverlo. ¡Vamos, muéstrales lo que sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490403
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401490403,
					"content": "(Déjame pensar... ¿Qué les gusta comer? ¿Qué les podría apetecer?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
