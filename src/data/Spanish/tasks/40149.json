			"dialogs": [
				{
					"id": 401490301,
					"content": "#¡Hola, {NICKNAME}! Gracias por su arduo trabajo en estos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490302,
					"content": "Con mucho gusto, siempre que me paguen, claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "#Jaja, qué chic{F#a}{M#o} más honest{F#a}{M#o}. Por supuesto, aquí tienes. También les he puesto una bonificación. ¡Es un pago extra por lo laborios{F#as}{M#os} que fueron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "¡Yupiii! ¡A Paimon se le han ido el cansancio y el estrés de golpe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "Tengo suerte de que solo hayas trabajado en mi puesto unos días. Al ritmo que estabas progresando, ¡unas semanas más y creo que me despedirían!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401490306,
					"content": "Yo quiero seguir probando las delicias que preparas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Jaja, ¡cuando quieras! Tráete a tus amigos la próxima vez que vengas. ¡Les enseñaré lo que pueden hacer estas manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401490308,
					"content": "¡Estupendo! Bueno, cuídate mucho, ¿eh? No vaya a ser que te vuelvas a quemar y tengamos que volver de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
