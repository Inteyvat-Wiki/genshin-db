					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499402,
					"content": "¿Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "... Ah, lo siento. No me di cuenta de que estabas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Se te ve pensativa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "Sí... La comida que nos acabas de preparar me ha recordado a la que me preparaba mi abuelo. Pensé que había olvidado cómo sabía, pero de repente me invadió la nostalgia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "Le encantaba preparar comida de Liyue. Entrenaba con él hasta la noche y luego esperaba pacientemente en la mesa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "Me quedaba allí sentada, olía la deliciosa comida que salía de la cocina y esperaba a que por fin sirviera los platos en la mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "A veces invitábamos a Eula a cenar y, aunque siempre encontraba algo de lo que quejarse, me daba cuenta de que le gustaba mucho la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Tal vez ella también recuerde esto que me has contado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "Será mejor que no se lo preguntes, ¡o se vengará de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "Quizá sea por eso que propuso cenar comida de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				}
			]
