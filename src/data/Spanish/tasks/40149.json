				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "Qué rápido pasa el tiempo. Mis quemaduras están casi curadas, así que creo que mañana ya podría retomar la cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401490102,
					"content": "#Has hecho un gran trabajo estos días, {NICKNAME}. Espero que este último día lo pasemos sin problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401490103,
					"content": "Eh... ¿Por qué Paimon tiene el presentimiento de que tú eres quien los atrae?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "El día transcurre sin incidentes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "*Fiu*, lo hemos conseguido, ¡ya es de noche! Al final fue un día bastante tranquilo. ¿Quizá porque ya tenemos experiencia en todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "Hemos avanzado mucho desde nuestro primer día de trabajo, ¿verdad? Al principio, incluso nos costaba recordar qué habían pedido los clientes. ¡Pero ahora todo es pan comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "No te adelantes, no vaya a ser que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "Sí, ¿pero quién vendría a estas horas de la noche? Oh... Aunque, ahora que Paimon lo piensa, Lyney y sus hermanos también vinieron a esta hora el primer día, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#¿{NICKNAME}? ¿Paimon? ¡Cuánto tiempo sin verl{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "¿Amber? ¡Y también Eula y Mika! ¿Vienen a cenar? Ya es muy tarde para ello, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Acabamos de terminar una misión de escolta para una caravana de comerciantes. El plan original era conformarnos con algo de comida militar y continuar nuestro camino hacia el norte para volver por la Puerta de Piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Sin embargo, la capitana Eula mencionó que hacía mucho que no disfrutábamos de la deliciosa comida de Liyue. Así que se nos ocurrió pasarnos por la posada para ver si aún podíamos pedir algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Ooh, ¿así que es una propuesta de Eula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "*Ejem*, llevo todo el camino comiendo esas raciones militares y pensé que ya era hora de que comiéramos algo decente. ¿Qué pasa, no puedo hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Bienvenida a la Posada Wangshu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "Humm... ¿qué comemos?... Espera, ¿por qué nos estás atendiendo tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#¡{NICKNAME} ahora es {F#la}{M#el} gran chef de aquí! Han tenido suerte, ¡serán los últimos afortunados en probar su cocina antes de que el chef original vuelva a tomar las riendas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Guau, ¿en serio? Menos mal que Eula se ha acordado, porque si no, ¡nos lo habríamos perdido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "¿Y qué pedimos para cenar? Ya no recuerdo muy bien cómo era la comida de Liyue... Mika y Eula, ¿les apetece algo en especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "#¡Lo que sea! Para mí, ya es un honor probar la cocina {F#de la}{M#del} Caballer{F#a}{M#o} Honorari{F#a}{M#o}, ¡estoy seguro de que será una gran oportunidad para aprender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "Lo que sea. Algo ligero, que después tenemos que seguir con el trayecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "¿No era idea tuya venir aquí? ¿Ahora no sabes qué comer? Amber, ¿y tú? ¿No te apetece nada en especial? ¡Pide lo que sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "¿Eh? Pues... “lo que sea”. Yo como de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "¡Pero bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "¿Qué les pongo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "Aún no hemos cerrado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
			"id": 4014902,
