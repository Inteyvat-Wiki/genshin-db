					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "Mmm, ¡qué bien huele! Está perfectamente sazonado, ¡y el arroz tiene un montón de sabor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "No hay nada mejor que una comida recién cocinada. Cómo echaba de menos un poco de comida caliente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "Jaja, acaban de poner en evidencia a la mejor comida militar de los Caballeros de Favonius, y eso es algo imperdonable. Vamos, disparen, ¿cómo se llama este plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Se llama... eh... No podemos llamarlo “lo que sea”, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "¡Paimon no sabe cómo explicar este plato! No tiene nombre, está hecho con los ingredientes más normales y cocinado de la manera más simple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "¿Ah, sí? Pensé que le habían añadido algún ingrediente especial o lo habían preparado siguiendo alguna receta mágica, se lo juro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "No es el plato más delicioso del mundo, pero sí el más apropiado para la ocasión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Es el plato que mejor se adapta a estas circunstancias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "¿A qué te refieres con eso? Paimon se ha perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Llevan mucho tiempo de viaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "Llevan mucho tiempo comiendo comida militar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "¿Quieres decir que nos parece delicioso solo porque tenemos hambre? Humm, tiene que ser por algo más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "Tal vez sea porque echábamos de menos el aroma a comida recién hecha comparado con la comida precocinada y fría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "Ah, ¿como la sensación de despertarse con el olor a pan recién horneado por la mañana? Ahora tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Sí... Es como si hubiésemos vuelto al restaurante El Buen Cazador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "¿Eh? Si les recuerda al restaurante El Buen Cazador... Entonces no tiene sentido que vengan a probar la comida de Liyue, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Ah, no me refiero al sabor. Me refería a esa sensación de... bienestar, ¿sabes? ¡Es como la sensación de estar en casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Sensación de bienestar y de estar en casa... Eso es, ¡Yanxiao nos dijo que debíamos hacer que los clientes se sintieran como en casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "Los gustos para la comida son totalmente subjetivos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "Cada uno tiene sus gustos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "Pero un chef siempre se pondrá en el lugar de sus clientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "Pero un chef siempre sabrá satisfacer a sus clientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "Siempre mostrará su gran pasión por la cocina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Así que, en otras palabras, ¿el ingrediente especial que añadieron es la “pasión”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "#A pesar de lo terriblemente cliché que suena, admito que es cierto en el caso de esta comida. No está mal, {NICKNAME}. ¡Recuérdenlo bien, esta receta será mía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "Muy bien, pero no puedes tener una receta sin nombre. ¿Ya le han dado un nombre a este plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490226,
					"content": "Pues no...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490227,
					"content": "¿Se les ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490228,
					"content": "Humm... ¿Qué tal si lo llamamos “como en casa”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
