			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#{NICKNAME}, Paimon, ¿cómo están? ¿Ya comieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "¿Ineffa? ¿Qué haces en el tejado? ¿Acaso... estás observando las nubes para calcular la probabilidad de lluvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "Estoy llevando a cabo una misión que está teniendo... una desviación imprevista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "El plan original era comprar unos “engranajes de alta precisión” y “tornillos hexagonales especiales” de la lista de Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "Pero de regreso al taller, fui víctima de un evento inesperado de intercepción de suministros: un halcón me arrebató el tornillo especial a toda velocidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "¿Subiste aquí para buscar el halcón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Así es. Según los patrones de comportamiento de esta especie, los tejados son posibles puntos de descanso. Estoy realizando un escaneo visual y auditivo completo para intentar localizarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "Pero hasta el momento no he detectado señales útiles. Mi hipótesis es que el objetivo ya escapó de mi alcance o escondió la “presa” en un nido más resguardado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Plan de respaldo activado: volveré a la tienda del proveedor y compraré otro tornillo del mismo tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "¿Y ustedes? ¿Por qué están en un lugar elevado? ¿Acaso también están siguiendo a algún animal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "No, no. Íbamos a tomar unas imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Sí, estábamos buscando un buen lugar con vista amplia para tomar una imagen panorámica de la Villa Nasha, y así registrar su dinamismo y vitalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "¡No nos esperábamos encontrarte aquí persiguiendo a un ladrón! Paimon diría que es un evento sorpresa con desviación imprevista de bajísima probabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Ya que estamos, ¿te puedo tomar una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "De acuerdo. Indícame la posición requerida, orientación y expresión facial recomendada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "#Creo que subirme al tejado, toparme con ustedes y que {NICKNAME} me tome una imagen... la probabilidad de que todo esto ocurriera es inferior a la de que ese halcón devolviera el tornillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Así que, por favor, registren este momento sorpresa con precisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "¿Te parece si te tomo una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "Estamos buscando inspiración para tomar imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
