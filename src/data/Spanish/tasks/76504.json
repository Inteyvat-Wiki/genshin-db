			"dialogs": [
				{
					"id": 765040701,
					"content": "#{NICKNAME}, Paimon, ¿cómo están? ¿Ya comieron? ¿Tienen algún plan especial para hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "Estamos dando vueltas para ver si hay algo que valga la pena capturar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Entendido. Pasear y capturar imágenes con el Daguerrotipo es una forma agradable de relajarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
