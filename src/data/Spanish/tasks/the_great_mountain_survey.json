			"dialogs": [
				{
					"id": 701040301,
					"content": "¿Están todas las balizas en su lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "Espléndido, has sido de gran ayuda. Por favor, acepta esto como agradecimiento. Gracias de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040304,
					"content": "*Suspira*, con tan pocas balizas para la investigación, quién sabe si podré encontrar algo de interés...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
