			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Esther"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "¿Encontraste mis balizas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040202,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "Déjame ver... ¡Sí, son estas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040204,
					"content": "Ay, mira su estado... Ya veo que esos monstruos no fueron nada cuidadosos con ellas. Por suerte, no se rompieron del todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040205,
					"content": "*Suspira*, aun así, supongo que no podré usarlas pronto... No hay más remedio, tendré que conformarme con una investigación a menor escala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040206,
					"content": "Tengo otras balizas aquí. ¿Podrías instalarlas en la montaña por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040207,
					"content": "¿Dónde exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "...¿Eso es un sí? ¡Lo tomaré como un sí, gracias! Te marcaré el lugar en el mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040215,
					"content": "Ahí tienes, está claramente marcado. Solo tienes que colocar las balizas en los alrededores de esos sitios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040216,
					"content": "Asegúrate de colocarlas en lugares altos. Cuanto mayor sea la altitud, más precisos serán los resultados de la investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040209,
					"content": "¿Por qué no lo haces tú misma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "No me atrevo a ir... Si ni siquiera un equipo completo de exploradores pudo hacerle frente a esos monstruos, no pienso ir allá yo sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040211,
					"content": "No encuentro a ningún otro explorador que esté pensando en ir a la montaña, pero tampoco puedo postergarlo indefinidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040212,
					"content": "#Por eso, eres la única oportunidad que tengo. Como lograste recuperar mis balizas, creo que eres más que apt{F#a}{M#o} para esta tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040213,
					"content": "Gracias una vez más. ¡Te aseguro que tendrás una buena recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040214,
					"content": "Espera, déjame marcar la ubicación en tu mapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				}
			]
		},
