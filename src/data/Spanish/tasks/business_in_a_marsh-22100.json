					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000302,
					"content": "Listo, ya no darán problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Gracias, buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000304,
					"content": "Tome, esta es la recompensa que prometí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000305,
					"content": "Por fin puedo descansar tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000306,
					"content": "¿Que quién es ese muchacho? Puede preguntarle a la jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
