				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "*Suspira*, no sé qué hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "Abrir una posada en este lugar no es nada fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000104,
					"content": "Aquí, en el Pantano Dihua, abundan los carrizos, los tesoros y los monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000105,
					"content": "Menos mal que siempre puedo contar con la Geoarmada. Ellos se hacen cargo de los monstruos de los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000106,
					"content": "Pero últimamente, los monstruos se han abierto camino hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000107,
					"content": "No se atreven a acercarse a la posada, pero son una molestia para los huéspedes y para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000108,
					"content": "Si tiene tiempo, ¿puede echarle un ojo a los alrededores y hacerse cargo de los monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000109,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "¡Jaja! ¡Me gusta su franqueza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000114,
					"content": "Es un poco vergonzoso tener que pedirle a un huésped que me ayude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000115,
					"content": "No se preocupe, cuando termine, le daré una buena recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000116,
					"content": "Le estoy agradecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000110,
					"content": "Si son solo una molestia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "Como podrá ver, los monstruos de por aquí son un dolor de cabeza para los huéspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000113,
					"content": "Especialmente para ese jovencito de carácter tan frío y sosegado. Si algo le molesta, todo el Pantano Dihua tiene que enterarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
