			"dialogs": [
				{
					"id": 221000201,
					"content": "¿Y bien? ¿Se deshizo de los monstruos de alrededor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000202,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "No hay prisa, solo están merodeando. No se atreverían a acercarse a la posada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000204,
					"content": "Pero si un monstruo llegara a acercarse y se topara con ese muchacho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000205,
					"content": "Pondría al Pantano Dihua patas arriba y me vería obligado a cerrar la posada unos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
