			"dialogs": [
				{
					"id": 750013201,
					"content": "Lo han logrado de veras... Una hazaña así solo aparece en las historias. ¡Es increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013202,
					"content": "También han acallado esos incesantes ruidos de antes... La Sombraguja menor ha recuperado su aspecto original. Su enorme estructura ha caído con un fuerte estruendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013203,
					"content": "*Fiu*... ¡No esperaba que hubiera alguien capaz de lograrlo! ¿No será esto un sueño? ¿Son reales y no un producto de mi imaginación?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013204,
					"content": "¡Despierta!... ¡Tienes que resolver este problema tú mismo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "Oye, no digas cosas tan crueles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013206,
					"content": "#¿Ves? ¡Paimon ya te había dicho que {NICKNAME} era muy fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013207,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Jeje, {REALNAME[ID(2)|SHOWHOST(true)]} también cree que es genial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013209,
					"content": "#¿No te ha afectado el Abismo, {NICKNAME}, oh, valiente guerrer{F#a}{M#o} llegad{F#a}{M#o} de tierras lejanas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013210,
					"content": "No te preocupes, solo es el Abismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#Incluso los guerreros más poderosos de la tribu deben mantenerse vigilantes hasta el extremo cuando combaten contra el Abismo. Debes de ser alguien extraordinari{F#a}{M#o}, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013213,
					"content": "Ay, tal vez una historia sobre este tema sea mejor incluso que las que recopiló Sanhaj.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013214,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Paimon no sabe quién es ese tal Sanhaj, pero parece alguien importante, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013216,
					"content": "Jaja, para todos los cuentacuentos de las tribus, Sanhaj, de los Augures Vientonocturno, es un personaje digno de gran respeto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013217,
					"content": "Aunque ahora la situación es urgente. ¡Ya les hablaré más de la historia de Sanhaj cuando tengamos tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013218,
					"content": "Está bien, vamos hacia la siguiente Sombraguja flotante. ¡Resolvamos el problema cuanto antes y, así, podré ponerme a escribir esta noche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013219,
					"content": "¡En marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013220,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "Por ahora estoy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Vaya, acabo de escuchar un ruido terrible, así que he venido a mirar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "Mientras venía, intentaba tranquilizarme diciéndome: “No pienses tonterías, Titu, ¿qué podría pasar?”... ¡Pero al final ha sucedido algo increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "#Hay un pequeño Tepetlisaurio aquí y todo... ¿Has traído tú a est{F#a}{M#o}s dos foraster{F#a}{M#o}s a este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "Y esta Sombraguja... ¿La han clavado ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "... ¿Acaso no debíamos hacerlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#¿Oh? {NICKNAME}, ¿y si hemos hecho algo terrible?... Aunque solo hay un testigo, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Jaja, no intenten asustarme, no es nada grave. Podría decirse que han hecho algo bueno. Si est{F#a}{M#e} muchach{F#a}{M#o} es {NICKNAME}, ¿quién eres tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#¡Y este es {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Bien, mi nombre es Titu. Soy el encargado de narrar his{RUBY#[D]cuentacuentos}torias de la tribu. Además, también me ocupo de cuidar los pilares de piedra del valle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "Este pilar que han vuelto a clavar es una de las tres Sombragujas menores. También están bajo mi protección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "¿B-bajo tu protección?... Parece que hemos tirado el pilar de piedra y ahora los habitantes de Natlan vendrán a buscarnos para exigirnos compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Ay, si Paimon lo llega a saber antes, no habría dado su nombre real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Una compensación... “A Titu le vino una idea a la cabeza... Tal vez podría recurrir a tal método para conseguir que aquellos que estaban ante él pudieran cumplir su objetivo”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "Siento que una trama así pediría una narración como esta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Ah, perdón, solo estaba pensando en la historia. Yo soy el encargado de contar rel{RUBY#[D]cuentacuentos}atos de la tribu. Llevo muchos años dedicándome a esto, y ahora ha llegado el momento de que cree mis propias historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "Ya ando varios días preocupado por eso, y justo le ha ocurrido algo a las Sombragujas... Como nos advierte un antiguo dicho: “Cuando los humanos se topan con la mala fortuna, los saurios van detrás”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "#*Ejem*, no es que quiera intimidarl{F#a}{M#o}s... Si quisiera hacerlo, no habría dicho lo que pensaba en voz alta, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Miren, nos hemos presentado y no hemos empezado a pelearnos. ¡Eso quiere decir que ya somos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "Así que podrían escuchar la petición de este amigo suyo, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Siempre y cuando no quieras una compensación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "¡Pues claro que no! Por cierto, ¿cómo decirlo?... Cuando paseaban por el valle, ¿vieron un enorme pilar de flogisto sólido con inscripciones doradas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "Justo en el centro de esta zona. Resulta de lo más llamativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "Diría que sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "Lo que quería decirles en realidad guarda relación con ese gran pilar de piedra... La gente de la tribu lo llama Sombraguja, y últimamente ha estado dando problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "#Antes de verl{F#a}{M#o}s a ustedes, estaba a punto de rendirme. Incluso me dije a mí mismo que escribir una historia en la que era imposible resolver el problema de las Sombragujas y la calamidad acababa destruyendo la tribu tampoco era mala idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Un momento... Es solo un pilar de piedra, ¿qué tiene que ver con la destrucción de la tribu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "Además, ¿qué es eso de las Sombragujas? ¿La que acabamos de hacer bajar era una menor? A Paimon le parecen pilares de piedra gigantes... ¿Por qué los llamas así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#Oh, ya que amb{F#a}{M#o}s son foraster{F#a}{M#o}s, dejen que se lo explique mejor. En realidad, todo esto guarda relación con una leyenda de la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "Cuenta la historia que las Wayob clavaron aquí las Sombragujas para atrapar la sombra del Gran Rey del Volcán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "Aunque lo que nos cuenta la historia real es que bajo el pilar está sellado el Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "En Natlan, la mayoría de las historias son así: advertencias entretejidas en forma de narración. Toda esa narrativa llena de retórica sirve de metáfora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Un momento... ¡¿Entonces ahí abajo está sellado el Abismo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "Eso es, pero recientemente dos de las tres Sombragujas más pequeñas han salido flotando. Tal vez, cuando la tercera se desprenda, los horrores de abajo surgirán como si de un torrente de agua se trataran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "Por eso, al ver que ustedes lograron volver a clavar una, me alegré sobremanera. No podría pedirles compensación alguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "Es más, me gustaría pedirles que volvieran a clavar la Sombraguja menor restante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Humm... ¿Qué hacemos, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "Si el Abismo está involucrado en esto, no podemos quedarnos de brazos cruzados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Sí, incluso {REALNAME[ID(2)|SHOWHOST(true)]} está de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "Ah... Así como el fulgor de las llamas se abre camino en la oscuridad, los grandes héroes se alzan orgullosos en tiempos de calamidad. Las posibilidades del ser humano siempre brillan en momentos así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#Tal vez esta también pueda ser una historia increíble. {NICKNAME}, posees un aire insólito incluso entre los héroes de las leyendas. ¡Qué ganas de ver qué sucede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "#Vamos, {F#heroínas}{M#héroes}, en marcha. Vayamos a ver la otra Sombraguja flotante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "#¿Tal vez podamos ayudar nosotr{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "No me suena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "¿Sí? Llama mucho la atención... Aunque no importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "Paimon es la culpable, yo solo seguía órdenes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "¡Vaya, siempre haces lo mismo! ¡Paimon va a enfadarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "#Jaja, no se pongan nervios{F#a}{M#o}s. Podría decirse que me siento aliviado. Si esta pequeña es Paimon, ¿cómo te llamas tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Me llamo {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}