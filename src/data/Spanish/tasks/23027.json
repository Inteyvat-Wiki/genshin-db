			"dialogs": [
				{
					"id": 230271101,
					"content": "Aquí están. ¿Cómo están las raíces del Árbol Sagrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230271102,
					"content": "Le describes a Yasmín el estado de las raíces...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "Así que los seres vivos se reúnen en la zona. Eso quiere decir que la tierra está llena de vitalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230271104,
					"content": "De momento, parece que las raíces del Árbol Sagrado podrán seguir creciendo sin problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230271105,
					"content": "Lo único que me preocupa es que se produzca un exceso de nutrientes en el agua. Eso podría resultar en la proliferación de Hongos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230271106,
					"content": "Bueno, aquí tienes el pago por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230271107,
					"content": "Le diré a Ladep y Farés que estén pendientes de la composición del agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
				}
			]
		}
	]
}