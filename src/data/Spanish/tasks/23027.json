			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "#Viajer{F#a}{M#o}, nos encontramos de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270202,
					"content": "¿Todavía estás investigando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "Así es. Ladep y Farés necesitan más datos, así que vine aquí para continuar con mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270204,
					"content": "Aunque tampoco estoy segura del estado de las raíces en este momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270205,
					"content": "#Viajer{F#a}{M#o}, ¿te importaría ayudarme a registrar el estado de las raíces del Árbol Sagrado una vez más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
				}
			]
		},
