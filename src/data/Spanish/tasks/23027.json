			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "No podemos descuidarnos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270102,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "#¿Quién eres tú? Tienes aspecto de... viajer{F#a}{M#o}, ¿me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270104,
					"content": "Me llamo Yasmín. Soy estudiante de la Facultad Amurta. Estoy aquí para investigar el Árbol Sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270105,
					"content": "El Árbol Sagrado tiene más años que granos de arroz hay entre todos los pilafs de Puerto Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270106,
					"content": "Además, es la base de la Academia de Sumeru. Juega un papel fundamental, al igual que las verduras en un plato de pollo tandoori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270107,
					"content": "¿Qué clase de metáforas son esas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Si algo malo le pasa, también sería un desastre para la Ciudad de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270111,
					"content": "Cualquier cosa... Una plaga de insectos o un ataque de langostas gigantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270112,
					"content": "O sus ramas podrían crecer descontroladamente, o las raíces podrían soltarse del suelo y arrasar con las casas de la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270113,
					"content": "Tal vez el tronco del Árbol Sagrado se seque y se caiga, aplastando la mitad de la Ciudad de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270114,
					"content": "¡¿De verdad podría pasar eso?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Claro que no. De momento no hay ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270116,
					"content": "Pero es lo mismo que cuando vas al bosque a recoger champiñones. Los Hongos no te avisan previamente de que te van a atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270117,
					"content": "Estoy aquí para investigar el Árbol Sagrado y prever cualquier posible situación catastrófica que pudiera llegar a ocurrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270118,
					"content": "Aunque, como puedes ver, mi mente es ágil como un pájaro crepuscular en plena caza, pero mi cuerpo es tan débil como un simple hongo estelar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270119,
					"content": "#Viajer{F#a}{M#o}, ¿te importaría registrar el estado de las raíces del Árbol Sagrado por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270120,
					"content": "Suelo contratar aventureros para que me acompañen, pero parece que esta vez no había ninguno disponible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270121,
					"content": "Lo haré yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "¿Todos los académicos hablan así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "¿Eh? ¿Te refieres a mis metáforas? Lo siento, es una costumbre que tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270124,
					"content": "Varios miembros de la Academia ya me han llamado la atención al respecto, pero es superior a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270125,
					"content": "Bueno, lo dejo en tus manos. Yo te espero aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmín"
				},
				{
					"id": 230270108,
					"content": "Seguro que Paimon sabe de lo que hablas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Es un árbol verdaderamente majestuoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
