			},
			"dialogs": [
				{
					"id": 200060101,
					"content": "¿Alguien pidió comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "#Oh, hola, viajer{F#a}{M#o}. Llegas en buen momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "#Lo siento, has de estar hambrient{F#a}{M#o}, pero ¿antes puedo pedirte un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "Orlean, de Aguaclara, pidió un <color=#00E1FFFF>asado a la miel</color>, pero escuché que cerca de Aguaclara hay algunos Slimes causando problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "No me atrevo a emprender el viaje por mí misma... ¿Podrías entregar la orden a <color=#00E1FFFF>Orlean en Aguaclara</color> por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Si tanto insistes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "¡Te aseguro que a tu regreso habrá comida abundante esperándote!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "¡Cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "Solo vine a comer. ¡Muero de hambre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "Una vez que hayas hecho lo que te pedí, ¡te invitaré a comer algo del menú especial de El Buen Cazador! Es lo menos que puedo hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
