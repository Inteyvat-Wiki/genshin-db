			"dialogs": [
				{
					"id": 200060401,
					"content": "Vengo a pagar la cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060402
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060402,
					"content": "¡Estás de vuelta! ¿Hiciste la entrega?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060403,
					"content": "Aquí está tu dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "Veamos... ¡Excelente! Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060405,
					"content": "Ten, es un <color=#00E1FFFF>asado mar y montaña delicioso</color> de parte de la casa. Está recién salido del horno, ¡así que cómelo mientras esté caliente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
