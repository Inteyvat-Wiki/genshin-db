			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "Gracias, esos Slimes son un dolor de cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "La Vivaz Orlean"
				},
				{
					"id": 200060202,
					"content": "Tenía tanta hambre que me quedé sin fuerzas, de lo contrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "La Vivaz Orlean"
				},
				{
					"id": 200060203,
					"content": "Su comida, señorita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "¡Mmm!... Huele a zanahoria y carne... Es una pena que no haya llegado antes, ¡habría mandado a esos Slimes por los aires si hubiera luchado con el estómago lleno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "La Vivaz Orlean"
				},
				{
					"id": 200060205,
					"content": "Bueno, qué se le va a hacer. Aquí está el dinero, dáselo a Sara por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Vivaz Orlean"
				}
			]
		},
