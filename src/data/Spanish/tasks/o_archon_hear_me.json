				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Hola, ¿hay algo en lo que pueda ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "Ehmm, pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "Quiere preguntar sobre los objetos de laca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "Ah, ¿así que quieres ofrecer objetos de laca a un altar y quieres hacer uno tú mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Por favor, señorita Nanatsuki. ¡Tengo un deseo que quiero que se cumpla! Yo... no se preocupe, ¡no le contaré a nadie su fórmula secreta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "El problema no es la aplicación de la laca. Si quieres conseguir un lacado hermoso, además de aplicar la pintura, también necesitas muchas horas de práctica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "Y no se trata solo del tiempo, sino más bien... del capital. Soy la sucesora de la cuarta generación de una familia de fabricantes de objetos de laca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "Incluso he viajado a Sumeru para estudiar este arte. Así que es imposible que entiendas el proceso de fabricación de la noche a la mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "¿E-en serio?... Pero no se me ocurre nada más que ofrecerle al altar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "En mi opinión, no se trata del valor del objeto ofrecido, sino de que ese objeto represente tus sentimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "Siempre que tengas los sentimientos y las intenciones correctas y ofrezcas algo que te guste, obtendrás una respuesta de los Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "Los sentimientos y las intenciones correctas... algo que me guste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Humm, creo que lo entiendo... y al mismo tiempo, no. Pero gracias de todos modos, señorita Nanatsuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "#Volvamos al altar, viajer{F#a}{M#o}. Todavía necesito tu ayuda para saber qué tipo de cosas quiero ofrecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
