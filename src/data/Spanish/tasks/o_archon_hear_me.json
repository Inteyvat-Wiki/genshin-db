			"dialogs": [
				{
					"id": 220270301,
					"content": "A pesar de lo que dijo Nanatsuki, no sé qué debería ofrecer exactamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Entre las cosas que me gustan, está el dango tricolor. Me gusta tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Pero no sé si ofrecerlo sería una falta de respeto. He ofrecido golosinas en el pasado, pero no obtuve respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "También he oído que algunas personas guardan pétalos frescos en bolsitas y los ofrecen. Eso podría ser mejor que el dango...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "#¿Qué deberíamos hacer? ¿Qué crees que debemos ofrecer, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
