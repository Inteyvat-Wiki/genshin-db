				{
					"id": 220270401,
					"content": "El dango tricolor está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "¿De verdad? ¡Genial! Resulta que traje uno. Mi madre me lo preparó y aún no me lo comí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Bien, ¡ofrezcámoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "Oh, Arconte, bendíceme y haz que mis deseos se cumplan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "#Gracias por acompañarme, viajer{F#a}{M#o}. Por favor, toma esto. ¡Es para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "Mañana volveré a ver si ocurrió algo. Espero recibir una respuesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
