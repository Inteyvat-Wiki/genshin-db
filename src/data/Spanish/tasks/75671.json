			"dialogs": [
				{
					"id": 756710101,
					"content": "¡Pío, pío! ¡Cuuu, cuuu! ¡Pío, pío, pío!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710102,
					"content": "¿Qué acaba de decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "¿Es un código secreto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "¡Sí! ¡Es una técnica para comunicarse con los adorables pinzones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710106,
					"content": "Ay, olvidé presentarme y decir mi frase indispensable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710107,
					"content": "#Querid{F#as}{M#os} viajer{F#as}{M#os} de buen corazón, l{F#as}{M#os} saluda Basima V, erudita de la Escuela de Biología, comerciante estrella y especialista de animales adorables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710108,
					"content": "Por favor, relájense y despejen su mente, pues tengo una cosa importante que decirles:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710109,
					"content": "¿Los pinzones son de lo más adorable?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "¡Totalmente correcto! ¡Felicidades, te has dejado conquistar por los pinzones y has acertado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710111,
					"content": "Qué extraño, Paimon no sabe por qué, pero al ver el juego sobre la mesa, esa frase le vino a la mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#¿Lo recuerdas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "Ya conocíamos a esta señorita de antes, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "#¡Exacto! Y no solo nos hemos visto una vez. ¡Me alegra tanto verl{F#as}{M#os} tan llen{F#as}{M#os} de energía como siempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710117,
					"content": "Bueno, ¿quieren probar este juego que tengo aquí? ¡Es la decimoséptima edición, o sea, la tercera generación de “Gordibolitas pam-pam”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710118,
					"content": "En este juego divertido y relajado, ¡podrán conocer la historia de cómo el gran pinzón plumanaranja ancestral derrotó a las gaviotas ladronas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710119,
					"content": "Estupendo. ¡Siempre nos han gustado los juegos casuales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "¡Quiero jugar una partida ahora mismo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "¡De acuerdo! Espero que encuentren el modo de juego que más les convenga y puedan disfrutar de corazón cada experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710121,
					"content": "¡Vamos, empecemos ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Ya puedes decir esa frase: “¡Los pinzones son de lo más adorable!”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "¡Exacto! Y aunque ahora mismo no recuerdes el pasado, no pasa nada. Lo importante es vivir el presente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima V"
				},
				{
					"id": 756710104,
					"content": "¿Es alguna clave?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
