				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "¡Únete a Los Eremitas! ¡Disfruta de la buena vida! Hola, ¿tienes un momento para hablar de Los Eremitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670102,
					"content": "Humm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "Hazme caso, aquí donde Los Eremitas se está estupendamente. ¡Somos libres! ¡Unidos! ¡Buenos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670104,
					"content": "Y también podremos vaciar los bolsillos de esos tipos que viven en los árboles. Los eruditos de la Academia de Sumeru son todos ricos, ¡y nunca se retrasan en los pagos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670105,
					"content": "Ya soy miembro del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "Oh, el Gremio de Aventureros... ¡Pero eso no es ningún problema! ¿Quién no tiene un trabajo a tiempo parcial hoy en día? Además, los aventureros y los mercenarios son casi lo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670108,
					"content": "Bueno, en realidad, son bastante diferentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "Pero la comida es buena, tenemos pescado y carne de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670110,
					"content": "Y si tienes suerte, ¡puede que incluso llegues a conocer a Dehya, la Leona Ardiente! Bueno, yo... *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670111,
					"content": "Bebe un poco de agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "*Cof*, lo siento. Hablé demasiado rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670114,
					"content": "La gente no suele estar dispuesta a escucharme... Me emocioné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670115,
					"content": "#Pero ¿estás segur{F#a}{M#o} de que no considerarías ni un poco unirte a Los Eremitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670116,
					"content": "No por ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "De acuerdo, si tú lo dices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670119,
					"content": "¿Siempre andas reclutando gente por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "Sí, este es mi trabajo. Hoy en día escasea la mano de obra por todas partes, y entre los mercenarios es aún peor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670121,
					"content": "Bueno, no importa, supongo que a ti puedo contártelo. Somos muchos, cierto, pero el trabajo de mercenario es muy peligroso. Escoltar caravanas no es tan difícil, como mucho es un poco cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670122,
					"content": "Pero si se trata de un trabajo con eruditos, realmente tienes que arriesgar tu vida. Tienes suerte si no vuelves con un brazo o una pierna menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670123,
					"content": "Cuando un compañero vuelve de un trabajo así, tiene que tomarse al menos diez días de descanso. Y luego alguien tiene que tomar su lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670124,
					"content": "Sumeru es tan grande y hay tantos eruditos que todos los días hay algo por hacer. Casi trabajamos las 24 horas del día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670125,
					"content": "Si no reclutamos más gente, no podremos mantener este ritmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670126,
					"content": "¿Y has logrado reclutar a alguien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "¿En este pueblo? Jaja, no. Ni a una sola persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670128,
					"content": "Bueno, no es que no haya conseguido a nadie, sino que las personas que me gustaría reclutar no quieren venir y las que se mueren por venir no pueden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670129,
					"content": "Si no me crees, ven a dar una vuelta conmigo. Quizá después de esto te animes a unirte a nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670130,
					"content": "... Es una broma. Dijiste que no querías unirte, así que no te voy a obligar. Solo quiero que me hagas compañía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670132,
					"content": "Claro, iré contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "Jeje, muchas gracias. Veamos. Primero busquemos a Sania, ella debería estar libre durante el día. Se pasa las noches ocupada hablando de la vida con Yabari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670117,
					"content": "#Ya estoy muy ocupad{F#a}{M#o} con el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "Has estado ensayando el discurso, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "Ya tengo demasiados encargos que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
			"id": 7326703,
			"completionStepIds": [
				7326703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
