					"Ayten",
					"Karima",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732671001,
					"content": "Guau, ¡esos escorpiones son gigantes! ¡No deberíamos acercarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671002,
					"content": "Les disparé con una flecha, ¿por qué no reaccionan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671003,
					"content": "En cambio tú... ¿Cómo los derrotaste tan fácilmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671004,
					"content": "Son muchos años de experiencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "Pero Candace dijo que he mejorado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671007,
					"content": "Karima, no te frustres tanto. Mientras mejores un poco cada día, tú también serás muy poderosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671008,
					"content": "Tú también, Ayten. Si sigues entrenando así, es solo cuestión de tiempo para que formes parte de Los Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671009,
					"content": "Ay, si pudiera pedirle a Dehya que me enseñe artes marciales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671010,
					"content": "La próxima vez que vea a Candace, ¡le pediré que me entrene de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671011,
					"content": "¡Estas niñas están muy motivadas, jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671012,
					"content": "Al final no reclutaste a nadie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "*Ejem*, ¡prefiero no hablar de eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671015,
					"content": "Podemos hablar de trabajo después. ¡Y no es que no haya tenido éxito reclutando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671016,
					"content": "Después de escucharme, muchos jóvenes comenzaron a visitar las afueras de la aldea. Aunque, bueno... ninguno de ellos quería unirse a Los Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671017,
					"content": "Tengo que llevar a estas dos niñas de vuelta. Han estado fuera mucho tiempo, sus padres deben estar preocupados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671018,
					"content": "#Aquí tienes tu recompensa. Gracias por hacer este viaje conmigo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671019,
					"content": "*Suspira*, ¿ahora cómo voy a explicar esto a los Eremitas cuando vuelva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671020,
					"content": "Cierto, Atiyah, todavía no nos has evaluado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671021,
					"content": "¿Eh? Sí, sí, volvamos primero. Les haré una prueba en cuanto regresemos a la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671013,
					"content": "¿Y tu trabajo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
					"content": "Ustedes todavía son pequeñas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				}
			]
		}
	]
}