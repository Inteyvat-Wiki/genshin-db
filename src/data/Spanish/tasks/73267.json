				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sania",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "Es tan triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670302,
					"content": "¡Sania! Buenos días, ¿ya te decidiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670303,
					"content": "Atiyah, ya te lo dije, Yabari no tiene ningún interés en unirse a Los Eremitas. No quiero que se convierta en mercenario, así que ni se te ocurra pedirme que hable con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670304,
					"content": "Qué lástima, Yabari es un gran cocinero, podría tener un buen puesto en Los Eremitas. Los ingresos de tu familia serían mucho mejores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670305,
					"content": "Además, ¿no dijo que quería salir a buscar trabajo? Si realmente quiere trabajar, lo mejor sería que un viejo amigo como yo lo recomiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670306,
					"content": "No le hagas caso, de vez en cuando dice ese tipo de cosas y luego se termina arrepintiendo al cabo de unos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670307,
					"content": "A fin de cuentas, él no quiere dejarme sola en el pueblo... Y yo no quiero que salga a trabajar solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670308,
					"content": "Para colmo, los mercenarios salen a jugarse la vida todos los días. Así que olvídalo, incluso si Yabari quisiera ir, ¡yo lo detendría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670309,
					"content": "Bueno, basta ya de este tema. Tengo que hacer la compra. Ve a buscar a alguien más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670310,
					"content": "#Uff, está bien. ¿Lo ves, viajer{F#a}{M#o}? Este es mi día a día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670311,
					"content": "Ahora vamos a buscar a Fodil. Él solía ser uno de los nuestros, pero renunció.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670312,
					"content": "Sería estupendo si pudiera convencerlo para que vuelva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fodil",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "Atiyah, ¿qué haces aquí otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670502,
					"content": "Jeje, la perseverancia es la mejor cualidad de Los Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670503,
					"content": "Entonces deberías saber que ceñirme a mis principios es mi manera de hacer las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670504,
					"content": "Fodil, compañero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670505,
					"content": "Ya no soy parte de Los Eremitas, no me llames así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670506,
					"content": "*Suspira*, está bien, Fodil. ¿De verdad nunca has pensado en volver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670507,
					"content": "Aunque algunos de nosotros somos un poco... humm... rebeldes, hay otros que sí siguen la ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670508,
					"content": "Atiyah, ya te dije, no voy a volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670509,
					"content": "He confirmado todo lo que me dijiste con mis propios ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670510,
					"content": "Tal vez no todos los Eremitas sean rebeldes, y no a todos les guste aprovecharse de los demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670511,
					"content": "Pero Atiyah, el mal se extiende. En cuanto una persona infrinja la ley, influirá en la conducta de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670522,
					"content": "Una persona puede influir en otra, y esa otra, en otra. Si un grupo entero se comporta de una manera, también lo harán otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670523,
					"content": "Deberías saberlo mejor que yo, Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670512,
					"content": "En ese entorno es fácil caer en las malas andanzas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670514,
					"content": "Tú quieres convencerme para que vuelva y yo intento convencerte para que te vayas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670515,
					"content": "Tal vez para ti Los Eremitas no sean tan terribles aunque su comportamiento no sea de lo más ético... Pero no puedes vivir siempre en el medio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670516,
					"content": "Solo es un consejo. Al final tú decides qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670517,
					"content": "Lo sé, Fodil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670518,
					"content": "Está bien. Si los dejas y necesitas una nueva forma de ganarte la vida, yo te ayudaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670519,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "Jajaja, nunca puedo discutir con Fodil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670521,
					"content": "Bueno... Jaja, tomemos un descanso. Me duele la garganta de tanto hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326706,
			"completionStepIds": [
				7326706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326706",
							"2"
						],
						"stepId": 7326706,
						"stateName": "QUEST_STATE_UNFINISHED"
