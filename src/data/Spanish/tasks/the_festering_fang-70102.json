			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "¿Qué piensas de este diente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "¿Un diente? Déjame ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Humm... Sí, es algo inusual, tanto en forma como en tamaño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "No soy una experta en objetos descomunales... Pero quizás Orban sepa algo. Él se encuentra con todo tipo de materiales al forjar armas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "¿Por qué no vas a preguntarle? Puedes encontrarlo por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010207",
							"2"
						],
						"stepId": 7010207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010206",
							"3"
						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "¿Qué piensas de este diente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "¿Un diente? Humm... No me digas que has estado recolectando basura en la montaña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020203,
					"content": "¿Eh? Este diente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020204,
					"content": "¿Qué? ¿Qué tiene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "Este diente es un espécimen raro. Es tan duro como un clavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020206,
					"content": "Y su contorno... parece el colmillo de un dragón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020207,
					"content": "¿El colmillo de un dragón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "Así es. Dicen que las armas hechas de colmillos de dragón son extremadamente duras y afiladas... E incluso tienen una especie de poder extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020209,
					"content": "No es algo que se vea todos los días. En las leyendas, solo los grandes héroes han podido encontrar colmillos de dragón y hacer armas con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020210,
					"content": "Como se suele decir: si no tienes un arma matadragones, ¿cómo piensas quitarle un colmillo a un dragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020211,
					"content": "Entonces, ¿realmente es un colmillo de dragón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "La verdad es que nunca me he topado con uno, así que no sabría responderte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020213,
					"content": "Pero estoy seguro de que se trata de una bestia gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020214,
					"content": "Bueno, ya que viniste hasta aquí, supongamos que de verdad es un colmillo de dragón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020215,
					"content": "Humm... pero no será suficiente para forjar un arma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020216,
					"content": "¿Qué tal si buscas tres colmillos más? Yo aprovecharé para consultar información sobre cómo trabajar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020217,
					"content": "Oh, y aparte de los <color=#00E1FFFF>colmillos de dragón</color>, también necesitaremos un buen mineral para complementarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020218,
					"content": "En ese caso, cuando vayas a la montaña, trae <color=#00E1FFFF>50 piezas</color> de argento estelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020220,
					"content": "Ah, casi lo olvido... También necesitaré un <color=#00E1FFFF>prototipo de lanza del Norte</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020219
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020219,
					"content": "Cuando hayas recolectado esos materiales, ven a verme de nuevo.",
