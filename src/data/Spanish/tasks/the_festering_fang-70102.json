			"dialogs": [
				{
					"id": 701020301,
					"content": "Encontré más colmillos de dragón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020302
					]
				},
				{
					"id": 701020302,
					"content": "Ah, volviste. Mira, antes de que vayas por esos colmillos de dragón... Oh, veo que ya los reuniste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020303,
					"content": "Lo siento, pero tengo un pequeño problema. No importa con qué lo golpee, no logro sacarle ni una astilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020304,
					"content": "Es como si fuera un auténtico colmillo de dragón... Si es así, según lo que he leído, hay ciertos métodos específicos para forjar este material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020305,
					"content": "Entre ellos, uno de los métodos es... dejar que el colmillo absorba una especie de “fuerza vital” relacionada con los dragones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "Y usar ese colmillo impregnado de fuerza vital para procesar los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020307,
					"content": "Pero, ¿cómo se la impregnamos? No tengo la menor idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020308,
					"content": "#¿Tienes alguna sugerencia, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020309,
					"content": "Pensaré en algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "¡Muy bien! Toma este colmillo de dragón. Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020311,
					"content": "*Suspira*, si un solo colmillo causa tanto alboroto, debe ser muy molesto tener que lidiar con todo un dragón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
