					"nextDialogs": [
						191735304
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 191735304,
					"content": "¡Ah! Sí, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735305
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 191735305,
					"content": "Vamos, ponte a la tarea cuanto antes o se te hará muy tarde, Collei. Si quieres ser de ayuda, no hagas que doña Faruzán se preocupe por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
