			"dialogs": [
				{
					"id": 191735301,
					"content": "Un sistema de irrigación automática... Desde luego, doña Faruzán se propone tareas nada sencillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735302
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 191735302,
					"content": "¿Maestro, puedo hacer algo para ayudar? Puedo ir a comprar materiales o preparar las herramientas...",
