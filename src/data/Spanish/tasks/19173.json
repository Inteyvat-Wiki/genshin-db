				{
					"id": 191737201,
					"content": "“Estimada doña Faruzán:”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737202
					],
					"speakerTitle": "Carta con caligrafía impecable"
				},
				{
					"id": 191737202,
					"content": "“Ya hemos organizado y completado todas las notas que dejó sobre Tamimi. También se han incluido los nombres de todos los eruditos que han participado en el proyecto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737203
					],
					"speakerTitle": "Carta con caligrafía impecable"
				},
				{
					"id": 191737203,
					"content": "“Espero que dentro de cien años, las nuevas generaciones de estudiantes sigan recordando su nombre, doña Faruzán”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carta con caligrafía impecable"
				}
			]
