				{
					"id": 191737101,
					"content": "“La remodelación de Tamimi va viento en popa. Ahora ya es capaz de lidiar con situaciones adversas de manera autónoma. Ojalá pudieras verla tú también”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737102
					],
					"speakerTitle": "Carta amarillenta"
				},
				{
					"id": 191737102,
					"content": "“Cada vez que trabajo en sus modificaciones, no puedo evitar pensar que tú lo harías mucho mejor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737103
					],
					"speakerTitle": "Carta amarillenta"
				},
				{
					"id": 191737103,
					"content": "“Después de todo, eres la estudiante más impresionante que he conocido nunca”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carta amarillenta"
				}
			]
