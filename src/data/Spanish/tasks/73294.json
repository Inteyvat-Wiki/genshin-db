		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "¡Qué lugar tan austero! ¿Puede considerarse un campamento siquiera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940502,
					"content": "Bueno, al menos las vistas son bastante buenas, e ir a la playa da una gran sensación de amplitud. Es mucho más relajante que estar en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940503,
					"content": "¿Pero qué clase de vida tenías en Fontaine? Paimon no se imaginaba algo así de un artista renombrado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940504,
					"content": "Lo cierto es que mi hogar en Fontaine es muy pequeño. Nunca he sido una persona muy ostentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940505,
					"content": "Los campamentos de los aventureros son mucho más lujosos que esto. ¿Eh? Esto es... ¿Dónde está tu mascota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940506,
					"content": "Humm... No tengo ninguna. Esto debe haberlo dejado algún aventurero que haya estado aquí antes que yo. Hablando de lo cual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940507,
					"content": "Me habría encantado tener algo que ofrecerles como recompensa, pero por desgracia, gran parte de mi equipaje cayó al agua cuando la balsa se rompió, y como no sé nadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940508,
					"content": "Pero si pudieran ayudarme a recuperar el equipaje extraviado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940509,
					"content": "¿No habrá quedado inservible después de haberse empapado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Lo empaqueté todo con cuidado, pero hay algunas cosas que... *Suspira*. Bueno, si se han perdido, se han perdido. No importa, puedo volver a dibujarlas... Sí, dibujarlas de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940511,
					"content": "#Humm... Quizá deberíamos echarle una mano, {NICKNAME}. A Paimon le da mucha lástima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940512,
					"content": "No tengo a nadie más con quien contar por aquí, así que solo puedo pedírselo a ustedes. Estaré aquí esperando mientras preparo un buen té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329410,
			"completionStepIds": [
				7329410
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329410",
							"2"
						],
						"stepId": 7329410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Perro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "Qué raro. ¿Qué hace un perro aquí? Parece que está protegiendo algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941002,
					"content": "#(Fija su vigilante mirada en l{F#a}{M#o}s dos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "Perro"
				},
				{
					"id": 732941003,
					"content": "Parece un perro muy inteligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "(Suelta un leve ladrido.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Perro"
				},
				{
					"id": 732941007,
					"content": "Ahora que lo dices, ¿no vimos un bol de comida en el campamento de Julien? ¡Puede que sea suyo! Aunque sería extraño. ¿Por qué habrá dicho entonces que no tiene ninguna mascota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941008,
					"content": "*Gime*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "Perro"
				},
				{
					"id": 732941009,
					"content": "El perro corre en dirección al campamento...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "Se ha ido. Preguntemos a Julien más tarde. Pero, por ahora... Paimon se pregunta qué habrá debajo de este montículo de arena. ¿Vamos a ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941005,
					"content": "¿De dónde ha salido este perro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "(Lanza un gruñido grave.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Perro"
				}
			]
		},
		{
			"id": 7329412,
			"completionStepIds": [
				7329412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329412",
							"2"
						],
						"stepId": 7329412,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "¡Hemos vuelto! ¡Oh, así que es tu mascota, Julien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Emite un sonido amenazador.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Perro"
				},
				{
					"id": 732941203,
					"content": "... Muy bonito, Pimienta. ¡Y encima me ladras! ¿Es que no sabes quién trae el pan a casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(¡Así que tiene nombre! Pero ¿este tipo está bien? Discutir así con un perro...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Parece que se llevan bastante bien.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(¿A eso lo llamas llevarse bien?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "¡Ey, Julien! ¡Hemos encontrado lo que habías perdido! Y por cierto, Pimienta es tu mascota, ¿verdad? ¿Por qué nos mentiste antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "¿Yo? ¿Con este desagradecido? Antes preferiría tener un Sabueso Acechador como compañero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Dudo que duraran mucho siendo compañeros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "Exacto. Si una persona común como Julien, que se desmaya de hambre, tuviera un problema con un Sabueso Acechador, no sería una situación que se pudiera resolver con un huevo frito de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "Por cierto, parecía que estaba custodiando una pizarra en la playa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Puede que estuviera intentando ocultarla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "¿Cómo? ¡Perro malo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(Ladra, aparentemente, a modo de protesta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Perro"
				},
				{
					"id": 732941218,
					"content": "¿De verdad tienes el valor de protestar? Si no te hubiera seguido hasta este callejón sin salida, al menos habría podido seguir el camino de vuelta para volver a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "¿Eh? ¿Pero no dijiste que viniste por el río porque querías apreciar el paisaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "Está bien. Lo cierto es que no estaba buscando un paisaje de Sumeru. Acabé aquí siguiendo a este granuja y, a decir verdad, es difícil no perderse entre estos caminos tan sinuosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "Así que eso fue lo que pasó. Podrías habernos dicho toda la verdad desde un principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Ehh... lo hice para... ¿preservar la imagen de un artista renombrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "Si lo dices así, suena a que te estás inventando cualquier excusa para intentar engañarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#Pero en lo referente a paisajes de Sumeru, {NICKNAME} y Paimon conocen algunos sitios con unos paisajes bastante buenos. Podríamos llevarte hasta ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "N-no es necesario. Les agradezco su consideración, pero, eh... como artista renombrado, creo que los paisajes que merece la pena dibujar debo descubrirlos por mí mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Ah, sí, el té ya está listo. Tomemos un poco. Y de paso, si tienen más huevos fritos, ¿podrían darme otro? Ya saben, para acompañar al té...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "¿En qué mundo un huevo frito es un buen acompañamiento para el té?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#¡Eso! ¡{NICKNAME} sabe preparar muchos platos! Podemos comer otra cosa, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Toman el té que preparó Julien junto con unos aperitivos.\\nEl sabor del té resulta difícil de describir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Este té... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "Un amigo mío me lo vendió. Se dice que tiene un efecto estimulador de la inteligencia latente de quien lo bebe. Creo que sabe bastante bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "Menos mal que no tengo amigos como ese.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "¿Por qué lo dices? No hay nada malo en tener amigos. De hecho, he venido a Sumeru por indicación de un amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "Muchas gracias por haberme ayudado hoy. No estoy seguro de si esto será remuneración suficiente por lo que han hecho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "No te preocupes, pero... ¿estás seguro de que no quieres que te ayudemos a buscar inspiración? Paimon teme que puedas perderte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "El peregrinaje... *Ejem*, quiero decir, el viaje está pensado para que uno mismo recorra el camino. No es necesario causarles más molestias. Puedo encargarme de este asunto por mí mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Si lo dices así... está bien. ¡Recuerda no desmayarte de hambre de nuevo por el camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
					"content": "¿Me pones otra taza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#{NICKNAME}, ¿todo bien con tus papilas gustativas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941239,
					"content": "Jaja, no es por ser tacaño, pero voy a estar en Sumeru una temporada, así que debo guardarme un poco para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941230,
					"content": "Soñar es gratis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "En serio... ¿no te parece que al té solo le falta algo? ¡Acompañémoslo con algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941215,
					"content": "A lo mejor la estaba vigilando para evitar que la robaran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "¡Pero si se fue corriendo en cuanto la encontramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941207,
					"content": "(No percibo olor a alcohol...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "(¿Acaso así es como se comporta normalmente? Parece algo problemático...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}