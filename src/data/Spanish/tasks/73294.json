			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#No tiene pinta de estar demasiado bien... ¡Seguro que está hambriento! {NICKNAME}, ¿y si le damos algo de comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "Espero que esta comida le dé fuerzas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "#No es porque Paimon esté de su lado ni nada, ¡pero la cocina de {NICKNAME} está a otro nivel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Le das al hombre que está en el suelo un huevo frito de Teyvat.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "¡He vuelto! ¡He vuelto a la vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Vaya, sí que debía de estar hambriento. Solo era un huevo frito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Estaba tan bueno que era como volver a la vida... *Suspira*, de haberlo sabido, le habría comprado aquel huevo de pájaro mágico a aquel chico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "¿Qué huevo de pájaro mágico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "Se dice que quien lo coma puede anular la mala suerte de un día entero. Si hubiera comprado uno en aquel momento... O más bien, si hubiera comprado una docena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Humm, parece muy sospechoso... Suena a que se trata de algún tipo de estafa. De todos modos, ¿cómo has acabado aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Yo... Bueno, soy un renombrado pintor de Fontaine que ha venido a Sumeru en busca de algo de inspiración. Pueden llamarme Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "¿Inspiración? ¿Aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "¿No hay lugares más adecuados en los que buscar inspiración? Como por ejemplo, un paisaje más bonito, o un lugar más seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Además, si eres un pintor de Fontaine, ¿cómo es que vas con las manos vacías?... No serás un topo de los Fatui, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "¡Qué razonamiento tan radical! Tanto que me resulta difícil imaginar qué tipo de experiencia te habrá llevado a pensar eso. Pero, en efecto, soy pintor. Un simple pintor y nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "Es solo que... Bueno, de hecho, yo ya he conseguido aquí la inspiración que buscaba, y me disponía a regresar a Fontaine al terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "No me esperaba que el clima de Sumeru fuera tan seco. En comparación, el Valle Chenyu parece un humedal. Y eso sin mencionar que las tormentas de arena aumentaron en cuanto llegué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Debo confesar que estoy más acostumbrado a los climas húmedos, por lo que tenía planeado regresar por vía fluvial para ver distintos paisajes, pero perdí la balsa, y como tampoco sé nadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "La vida no debe haber sido fácil para ti en Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Lo cierto es que sí, aunque el problema no es que sepa o no nadar... *Suspira*, es igual. Encontré un lugar cerca del agua en el que descansar y algunas hojas de té que todavía no se habían humedecido. Acepten esto como muestra de gratitud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "¿Nos quieres invitar a tomar el té?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "Oh, ¡p-por supuesto! Debo expresarles mi gratitud por ese huevo frito. Por cierto, ¿cuál es su nombre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Ah, cierto, a Paimon casi se le olvida presentarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Ah, qué nombres tan espléndidos. Bueno, vengan a tomar el té. Mi campamento está cerca, llegaremos enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "#{F#La}{M#El} mensajer{F#a}{M#o} de la justicia y su compañera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#¡Somos {NICKNAME} y la mejor compañera de aventuras, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "#Llámanos Rubi{F#a}{M#o} Esplendoros{F#a}{M#o} y Plata Reluciente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#Somos {NICKNAME} Rubi{F#a}{M#o} Esplendoros{F#a}{M#o} y Paimon Plata Reluciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "¿Quién se refiere a uno mismo como “renombrado” en algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "¡Eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Jaja, pero él no es Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "¡Qué dices! Todo el mundo se ha desmayado de hambre alguna vez en su vida, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
