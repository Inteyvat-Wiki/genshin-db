			"dialogs": [
				{
					"id": 726680101,
					"content": "¡Genial! De cierta forma, todas las personas que buscaban al leviatán lunar cumplieron su deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "¿Ya terminaron?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "¿Lo ves? Jiawei encontró una esposa acaudalada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "En cuanto a Nantuck, se convirtió en un autor famoso por su libro acerca del leviatán lunar, aunque su contenido no sea correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Kujirai Momiji se convirtió en la pescadora más famosa de Inazuma, y logró lo que su padre no pudo, ¡atrapó al leviatán lunar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "#¡Así que Paimon cree que el deseo de {NICKNAME} también se volverá realidad! ¡Jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "¿Qué deseo pediste, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "¡Paimon no puede decirlo! Si lo dice, ¡no se volverá realidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "No creo que el leviatán lunar sea tan tacaño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Humm... Está bien, pero escucha con atención, ¡Paimon solo lo dirá una vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "El deseo de Paimon es que tu deseo se vuelva realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "No te escuché, ¿qué dijiste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "¡Hum! Paimon no lo volverá a decir. Paimon quiere un caramelo. La, la, la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}