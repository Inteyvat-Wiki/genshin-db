			},
			"dialogs": [
				{
					"id": 111120801,
					"content": "Muchas gracias. Es de muy buena calidad. Por favor, esperen un momento más, falta el paso final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120802
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120802,
					"content": "Está lista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120803,
					"content": "Dentro de la linterna celeste escribí los nombres de nosotros cinco. En realidad, todos los años, en el Rito de la Linterna, liberamos una como esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120804,
					"content": "No importa lo que pase de ahora en adelante, o qué rumbo tomemos cada uno, mientras continuemos con esta tradición, cada uno seguirá siendo el mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120805,
					"content": "En cuanto al tema del Temible Lang, ya acordamos entre nosotros que no indagaremos más al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120806,
					"content": "Pero esperamos que, si hubiera una oportunidad, pudieran decirle que todos nos encontramos bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120807,
					"content": "Además, hemos logrado todas las cosas que planeamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120808,
					"content": "#Pueden contar con nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "¡Gracias a todos! ¡Le transmitiremos el mensaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120811,
					"content": "El Temible Lang es afortunado por tener amigos como ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120809,
					"content": "Yo tampoco indagaré sobre “las cosas que planearon”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
			]
		},
