			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "Bien, con esto será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120302,
					"content": "Empezaré a preparar el pollo al chile Jueyun. Seguro que ustedes todavía tienen otras personas que buscar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120303,
					"content": "Cuando tengan todo listo, les entregaré el plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120304,
					"content": "Perfecto. ¡Nos vemos luego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120305,
					"content": "(¿Eh? ¿Cómo supo sobre los otros?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111204,
			"completionStepIds": [
				1111204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111204",
							"2"
						],
						"stepId": 1111204,
						"stateName": "QUEST_STATE_UNFINISHED"
