				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Ustedes otra vez... *Suspira*, ya les dije que no me interesan las propuestas de la Funeraria El Camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120402,
					"content": "Esta vez venimos de parte de Meng Dan. Ustedes son buenos amigos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120403,
					"content": "Sí, claro. Hablando de él, me parece que hace poco se unió a la Funeraria El Camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120404,
					"content": "No nos tomó mucho tiempo averiguar por qué: por el incidente del Temible Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120405,
					"content": "Pero sé que no hay forma de persuadirlo. Dejar el pasado atrás es muy doloroso, eso me consta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120406,
					"content": "Entonces, ¿me buscan por el asunto del Temible Lang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120407,
					"content": "¿Cómo lo supiste? Ni siquiera hemos mencionado nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120408,
					"content": "Jaja, soy un hombre de negocios, no iría por allí contando su secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120409,
					"content": "Cuando la gente escucha mi nombre, lo primero en lo que piensan es que soy un poco lento. Lo seguían diciendo incluso después de abrir mi tienda. Pero le he demostrado a más de uno que se equivocaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120410,
					"content": "Tomen, es una lujosa caja de juguetes que todos soñábamos con tener cuando éramos niños. En ese entonces, no podíamos comprarla porque no teníamos ni un Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120411,
					"content": "Ahora le va muy bien a mi negocio y compré decenas de estos. Fue como un sueño hecho realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120412,
					"content": "¡Guau! ¡Debes ser muy rico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120413,
					"content": "Jaja, para mí, esto es un recuerdo para conmemorar nuestra infancia, sin la cual no seríamos quienes somos ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120414,
					"content": "Así que, ahora que vinieron a buscarme, supongo que también irán a buscar al pequeño Wu y a Tsongzi, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120415,
					"content": "Justo antes nos encontramos con el pequeño Wu, ahora vamos a buscar a Tsongzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120416,
					"content": "Oh, si buscas a Tsongzi, acordamos vernos en un momento en el paso elevado de la Pendiente Feiyun, justo encima de las escaleras que llevan al muelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120417,
					"content": "Yo todavía tengo un pequeño asunto que atender. En cuanto termine, iré para allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mumu"
				}
			]
		},
		{
			"id": 1111205,
			"completionStepIds": [
				1111205
			],
