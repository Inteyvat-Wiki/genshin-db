			"dialogs": [
				{
					"id": 111122301,
					"content": "Ahora que lo pienso, las cosas de ustedes dos son hechas a mano y la mía es la única comprada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111122302,
					"content": "Pero lo tuyo tiene mucho más valor que lo nuestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111122303,
					"content": "Lo importante no es el precio, sino el peso que tuvieron estas cosas en nuestra niñez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111122304,
					"content": "Y son una muestra de que nunca olvidaremos nuestra promesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsongzi"
				}
