			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Las cosas dieron un giro inesperado, Paimon no entiende qué está pasando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "No esperaba que fuéramos a encontrarnos con el Temible Lang así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "No me sorprende en absoluto. ¿Recuerdan lo que dije? En este mundo hay muy pocos espíritus malignos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "Debe haber salido por algún azar del destino de la Colina Wuwang y, por alguna razón, ya no puede regresar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "A Paimon le parece una explicación muy descabellada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "En realidad, es más o menos como ella dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120108,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Jeje, ¡no subestimen mi instinto profesional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "Solo quería saber cómo le iba a mis amigos. Por eso vine a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120111,
					"content": "¡Juro que nunca pensé en hacer cosas malas ni travesuras! ¡Y nunca asusté a nadie intencionadamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120112,
					"content": "Hace unos días un grupo de gente estuvo en la Colina Wuwang por una apuesta. Escuché que eran de Liyue, así que seguí a uno de ellos hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120113,
					"content": "Debes haber seguido al pobre Luocheng. Aunque no te podía ver, sentía que lo estaban siguiendo. Ahora sabemos qué provocó sus pesadillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "¿Eh? ¿Me descubrió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120115,
					"content": "Eso creo. De lo contrario, no habría estado tan asustado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "¿Por qué no buscaste a Meng Dan antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Cierto, hiciste que Hu Tao y Meng Dan te buscaran por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Es porque no los encontraba. Como nunca había venido a Liyue, me perdí en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120119,
					"content": "Oh, ahora que lo dices, recuerdo que de niños el Temible Lang tenía muy mala orientación. Si no lo guiábamos, él no se atrevía a bajar de la colina solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111120120,
					"content": "¡¿Todo esto solo porque te perdiste?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "¿Por qué no volaste como cualquier otro espíritu o fantasma? Desde arriba podrías haberte ubicado mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "N-no puedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120123,
					"content": "Está muy alto, me da mucho miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120124,
					"content": "Ah... sí, sí. De niños solía tener tanto miedo a las alturas que no se atrevía a mirar desde lo alto de la colina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111120125,
					"content": "Jajaja, ¡no has cambiado en nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Sé que no debo aparecer ante los vivos, pero con tanta gente en Liyue, no me quedó otra opción más que esconderme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120129,
					"content": "No te hubiera encontrado si no fuese por el llamado del monolito de líneas ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120130,
					"content": "Es un alivio que no te hayas convertido en un espíritu maligno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111120131,
					"content": "Nunca duden de mi juicio profesional. Solo nos queda acompañar a este niño perdido de vuelta a la Colina Wuwang y todo se habrá solucionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "¿Pero no acaba de decir que vino a ver a sus amigos? No se trata solo de mí, aún faltan el pequeño Wu, Mumu y Tsongzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 111120133,
					"content": "Bueno... en ese caso, no podemos decepcionarlo. Les pediremos su ayuda para preparar una ceremonia de despedida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Meng Dan y yo escoltaremos al Temible Lang hasta la Colina Wuwang. Tú encárgate de buscar a sus tres amigos y pídele a cada uno un recuerdo que los represente en el ritual. Luego ve a buscarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "Si son amigos, ¿no podemos llamarlos para que se reúnan todos? ¿O tal vez podemos llevar al Temible Lang a verlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Humm... No creo que sea buena idea. No quiero darles un susto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "El Temible Lang"
				},
				{
					"id": 111120137,
					"content": "No quiero que la gente común comience a creer en supersticiones. Mientras menos sepan, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "Por lo tanto, ¡cuando les pidas los recuerdos debes tener cuidado con lo que dices!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "Quizás el nombre “Temible Lang” no es muy adecuado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "¿Así que el Temible Lang no es un espíritu maligno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Hola, ¿nos recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Ustedes... Disculpen, pero de verdad no necesito los servicios de la Funeraria El Camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120203,
					"content": "Meng Dan nos contó su historia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Sí, Meng Dan y yo crecimos juntos. Todavía nos reunimos de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120206,
					"content": "No sé en qué momento empezó a trabajar en la Funeraria El Camino. A decir verdad, la directora de ese lugar es muy extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120207,
					"content": "Pero seguro que tiene sus motivos. Después de todo, él no tiene a nadie y no ha superado el asunto del Temible Lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120208,
					"content": "¿Les contó algo sobre eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120209,
					"content": "Sí, nos contó todo. Entonces, hipotéticamente, si tuvieras que elegir un recuerdo tuyo para dárselo al Temible Lang, ¿cuál sería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "Solo hipotéticamente, no es que de verdad queramos hacer una conmemoración en su honor ni nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(Eso fue demasiado obvio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120214,
					"content": "Le prepararía algo de comer. Él era el que podía comer más picante de nuestro grupo. Le gustaba el pollo al chile Jueyun extra picante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120215,
					"content": "Si me consiguen algunos chiles de Jueyun, puedo ayudarles a prepararlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120216,
					"content": "Seguro que le encantaría volver a probar ese sabor de su infancia. Todavía lo hago siguiendo una receta antigua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120217,
					"content": "¡Trato hecho! ¡Espéranos un momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120212,
					"content": "(Típico de Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "Meng Dan nos dijo que es un viejo amigo tuyo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
			"completionStepIds": [
				1111203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
