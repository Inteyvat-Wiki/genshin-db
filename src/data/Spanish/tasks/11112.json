					"Tsongzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120501,
					"content": "¿Eh? ¿Están todos aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120502,
					"content": "Nos reunimos para conmemorar los viejos tiempos. Es una tradición que hemos mantenido durante muchísimos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Pequeño Wu"
				},
				{
					"id": 111120503,
					"content": "Nuestro pueblo natal fue destruido por un desastre, así que no tenemos donde volver. Ahora, nuestro hogar es donde están los amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120504,
					"content": "Me contaron que ustedes estaban buscando recuerdos, ¿es cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120505,
					"content": "Ahora yo me dedico a hacer linternas celestes artesanales en Liyue. Supongo que es lo que mejor me representa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120506,
					"content": "Hace unos días, compré unos fragmentos de plaustrita de buena calidad, están en el almacén del muelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120507,
					"content": "Ya avisé al gerente. ¿Podrían ayudarme a recogerlos, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Tsongzi"
				},
				{
					"id": 111120508,
					"content": "#Parece que no hace falta dar más explicaciones, {NICKNAME}. Volveremos en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111208,
			"completionStepIds": [
				1111208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
