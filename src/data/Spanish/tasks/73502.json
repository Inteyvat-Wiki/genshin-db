				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "“Cuando el día da el relevo al siguiente día, desde el puente puede verse la silueta apresurada del faro terminando de trabajar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 735020102,
					"content": "¿Qué es esto?... ¿Un acertijo? ¿Un proverbio o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020103,
					"content": "¿El día que da el relevo al siguiente día? ¿La silueta que termina de trabajar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020104,
					"content": "#¿No eres tú {F#la}{M#el} viajer{F#a}{M#o}? ¿También te interesan los acertijos del Sr. Drusus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020105,
					"content": "¿Esto de verdad es un acertijo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "Este acertijo lo puso el Sr. Drusus, un erudito de la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020108,
					"content": "Hasta donde yo sé, es considerado un excéntrico incluso en la Academia de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020109,
					"content": "Lo que más le gusta hacer es hablar de acertijos e investigar todo tipo de métodos de encriptación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020110,
					"content": "Pero a veces sus acertijos son demasiado difíciles de comprender, por lo que no hay mucha gente que esté dispuesta a hablar con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020111,
					"content": "Por eso, se le ocurrió la idea de recompensar a quienes resuelvan sus acertijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020112,
					"content": "En pocas palabras, lo que indica en realidad este acertijo es la ubicación de un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020113,
					"content": "Para obtenerlo, solo hay que llegar en el momento justo al lugar correcto y usar el método adecuado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020114,
					"content": "El Sr. Drusus también señaló que todos los tesoros están ubicados dentro de la Ciudad de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020115,
					"content": "Pero como pueden ver, ningún aventurero ha conseguido descifrar este acertijo aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020116,
					"content": "Si les interesa, también pueden intentarlo ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020117,
					"content": "Pero si quieren que les diga mi opinión, será mejor que vayan a hacer algo más productivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020106,
					"content": "¿Sabes quién lo puso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "¿Hoy tampoco viene nadie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020302,
					"content": "¿Es esta la entrada principal del Salón de la Sabiduría?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "¡Así es! Esta es la entrada principal del Salón de la Sabiduría. Parece que usted... resolvió todos mis acertijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020304,
					"content": "¡Maravilloso! ¡Pensé que nadie podría lograrlo hoy! Un poco más y habría llegado la hora de irme a almorzar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020305,
					"content": "¿Por qué escribiste estos acertijos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "Porque es divertido, claro está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020307,
					"content": "¡Qué respuesta tan rápida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020308,
					"content": "¿Por qué creen que escribí estos acertijos si no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020309,
					"content": "¿Creen que disfruto poniéndole las cosas difíciles a la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020310,
					"content": "Igual sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "Jajaja, entonces me han malinterpretado, al igual que algunas otras personas de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020313,
					"content": "Escribí estos acertijos porque simplemente me encanta la sensación de esclarecimiento que surge en el momento de descifrarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020314,
					"content": "Si vuelven a observar mis acertijos, verán que siempre contienen una palabra clave que permite resolverlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020315,
					"content": "Si se reflexiona partiendo de esta palabra clave, se podrá resolver el acertijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020316,
					"content": "Si simplemente hubiera querido ponerle las cosas difíciles a la gente, solo tendría que borrar todas las pistas y convertiría el acertijo en un verdadero problema sin solución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020317,
					"content": "No hablemos de esto ahora. Ya que han resuelto todos mis acertijos, pueden llevarse estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020318,
					"content": "Esta es la recompensa que lograron ganar gracias a su capacidad analítica, guárdenla bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020311,
					"content": "No sabría decirlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
