					"Lynette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191854901,
					"content": "Si Bonnie llevaba el sinte de imitación en su cuerpo, entonces era un lastre que había que recuperar a toda costa. Pero si no llevaba nada, entonces habría tenido sentido decirle a Bernard que no se preocupara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854902
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854902,
					"content": "Y pensándolo bien, solo sospechamos de Bernard porque vino a buscar a Bonnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854903
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854903,
					"content": "¿Podría ser que la persona que escribió la carta tampoco supiera nada de lo de Bonnie? ¿O tal vez... tenía un objetivo totalmente distinto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
