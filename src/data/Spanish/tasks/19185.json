						],
						"pointId": 340100652
					}
				]
			},
			"dialogs": [
				{
					"id": 191851001,
					"content": "Cuando la Gendarmería Fantasmal estuvo en casa de Pierre, no había rastro de estos barriles, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Haberlos traído directamente sería demasiado obvio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Sí, no parece que ese sea su modus operandi... Pero entonces, ¿cómo los ha traído?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "Examinar los barriles",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(Los barriles muestran signos de daños causados por el agua. Parece haber rastros de agua seca por fuera.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Examinar"
				},
				{
					"id": 191851006,
					"content": "(También parece haber un patrón en la ubicación de esos rastros de agua. Por alguna razón, solo están en la mitad inferior de los barriles.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Examinar"
				},
				{
					"id": 191851007,
					"content": "(Las tapas no parecen muy herméticas. Dejan huecos considerables en los bordes, pero no parece haber restos de agua en el interior de los barriles.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Examinar"
				},
				{
					"id": 191851008,
					"content": "Solo la mitad inferior de los barriles parece haberse mojado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
		{
			"id": 1918511,
