				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3926.022,
							443.657,
							4548.217
						],
						"pointId": 340100651
					}
				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "Estas bolsas son de un material bastante raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851102,
					"content": "(Conocimiento) Ayudar a Lyney a evaluar el material",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "¿No se parece mucho al material de tus bolsos mágicos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "... Sí, es el mismo: fibra de flor rociomarina. Pero estas bolsas tienen algo de especial. Al fijarse bien, parece que no solo son resistentes al agua, sino que también lo son a la corrosión y a las filtraciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851105,
					"content": "Incluso las cuerdas parecen especialmente diseñadas para mantener las bolsas bien cerradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851106,
					"content": "Acabo de encontrarme con unas bolsas del mismo material, pero mucho más pequeñas y finas. Por su aspecto, también parecían mucho menos resistentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "¿Algo así como... una de esas bolsas selladas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "... Sí, algo así. Normalmente, un perro de la Guardia podría detectar fácilmente el sinte de imitación, pero si se encuentra dentro de una de estas bolsas cerradas, quizá podría se podría eludir su detección de forma temporal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851109,
					"content": "Pero entonces, ¿para qué podrían servir estas bolsas tan grandes? Si el objetivo es mantener el sinte de imitación oculto, estas bolsas parecen demasiado llamativas...",
