					"nextDialogs": [
						191854802
					]
				},
				{
					"id": 191854802,
					"content": "Bernard afirma haber recibido anoche una carta de Pierre. En la carta, Pierre decía que se había escondido. ¿Hay algún problema con la carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
