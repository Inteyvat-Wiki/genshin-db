			"dialogs": [
				{
					"id": 191851201,
					"content": "Tal y como esperábamos, este es el lugar donde se fabrica el sinte de imitación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851202,
					"content": "(Medicina) Ayudar a Chevreuse a identificar los fármacos",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Estas botellas y frascos... ¿todos contienen sinte de imitación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "... Y no solo eso. También están los ingredientes necesarios para la preparación junto con un montón de productos de limpieza y una pequeña cantidad de fármacos desconocidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "Los productos de limpieza probablemente se empleen para eliminar ciertos rastros... como el olor del sinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "Según registros de la Unidad Especial de Seguridad y Vigilancia, es difícil para la gente común detectar los restos de sinte de imitación. Y lo mismo ocurre con Pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "Debe de haberle llevado una cantidad considerable de tiempo y pericia asegurarse de que todos esos rastros desaparezcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Sin embargo, el resto de los fármacos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		},
