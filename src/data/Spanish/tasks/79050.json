			"dialogs": [
				{
					"id": 790501501,
					"content": "Jeje, ¡dicho y hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501502,
					"content": "Parece que las Gotitas están muy contentas. Ay, Paimon también siente una llamita de alegría en el corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501503,
					"content": "Hemos protegido el valor de la amistad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "Ahora tanto los amigos del artista como su obra maestra están mejor que nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501506,
					"content": "¡Paimon espera que algún día el artista vuelva para reencontrarse con sus amigos y ver de nuevo su gran obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501507,
					"content": "Por cierto, ¿no te parece que el mural tiene un estilo único? No es superartístico, pero es bonito, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501508,
					"content": "¡Y lo mejor es que hasta Paimon lo entiende! Jeje, tal vez si Paimon lo usa de inspiración, sea capaz de crear una obra de arte también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501509,
					"content": "Las mejores obras de arte no tienen por qué ser complicadas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "¡Sí! Si no te parece mal, ¿nos tomamos una imagen con el mural?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501512,
					"content": "¡Así Paimon podrá estudiarlo cuando quiera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501514,
					"content": "¿Quién sabe? A lo mejor si Paimon pinta un mural así de bonito, muchas Gotitas se sentirán atraídas y vendrán para ser nuestras amigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501510,
