			"dialogs": [
				{
					"id": 220010601,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010602
					]
				},
				{
					"id": 220010602,
					"content": "De acuerdo, ¡comenzamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010603
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010603,
					"content": "En serio, ser marinero es muy aburrido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010604
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010604,
					"content": "Lulu y Meng sí que se divierten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010605
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010605,
					"content": "¡Esto es un motín!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "#¿{F#Una}{M#Un} pirata? Lo siento, pero soy un pobre marinero, no tengo nada que puedas robar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010607
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010607,
					"content": "Si estás aquí para robar el bote, necesitas encontrar a alguien con suficiente dinero. Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010608
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010608,
					"content": "¡Lo tengo! El capitán es muy rico, ¡deberías asaltarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010609
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010609,
					"content": "¿Eh? ¿No eres el marinero de este barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010610,
					"content": "Así es, así que sé dónde está el capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010611
					],
					"speakerTitle": "Pequeño Fei"
				},
