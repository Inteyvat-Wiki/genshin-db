					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010402,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "¡Tú...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010404,
					"content": "¡Tú...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220010405,
					"content": "¡Dejen de pelear! ¿Es que no se cansan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010406,
					"content": "Es un juego, no se enojen, somos amigos, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010407,
					"content": "Miren, lotos recién cortados, coman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010408,
					"content": "Después de comer hablamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010409,
					"content": "¿Qué tal si establecemos un orden para decidir quién es capitán y quién es marinero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010410,
					"content": "Bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220010411,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010412,
					"content": "Realmente se calmaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Jeje, te lo dije.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010414,
					"content": "¿Cómo lo supiste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Jugamos desde siempre, claro que los conozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010416,
					"content": "Eres sorprendente, Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Gracias, pero Beidou es aún mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010418,
					"content": "Cuando sea grande, quiero ser como Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				}
			]
		},
