			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "Meng, ¿hoy puedo ser el capitán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010102,
					"content": "Lulu, ya fui capitán varios días, ahora le toca a Fei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220010103,
					"content": "Pero creo que tú haces un buen papel. Quiero que sigas siendo capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010104,
					"content": "¿Qué hacen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Estamos jugando. Ahora me toca a mí ser capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010106,
					"content": "Pero Lulu dice que es más divertido cuando Meng es el capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010107,
					"content": "Lulu siempre es así... pero si ella cree que es mejor de esa forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010108,
					"content": "Si estás libre, ¿podrías volver a hacer de pirata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010109,
					"content": "Bueno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "Al final, soy marinero de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010113,
					"content": "#Igual que la otra vez, ven cuando estés list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010111,
					"content": "Quiero ser una persona buena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "Pero, aun así, quiero ser capitana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Pequeño Fei"
				}
			]
		},
