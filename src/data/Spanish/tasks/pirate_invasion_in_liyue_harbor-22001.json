					"Pequeño Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "¡Es aquí, aquí es donde está el capitán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010302,
					"content": "#¡¿Por qué trajiste {F#a la}{M#al} pirata?! ¿No deberías distraerle, mientras Lulu y yo escapamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220010303,
					"content": "#¿Y por qué tú tienes que estar con Lulu y yo tengo que distraer {F#a la}{M#al} pirata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010304,
					"content": "Tengo una mejor idea, ¡te entrego a los piratas y yo escapo con Lulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010305,
					"content": "¡Hum! ¡Beidou dice que no debes abandonar a tus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220010306,
					"content": "¿También dijo que el capitán puede simplemente huir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010307,
					"content": "¡Ya no te daré de mi loto para comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 220010308,
					"content": "¡Pues no me des! Como si fuera tan especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Pequeño Fei"
				},
				{
					"id": 220010309,
					"content": "¿Por qué pelean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "No te preocupes, tengo una idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010311,
					"content": "Les encanta comer cabezas de loto. Si les traemos algo de comer, estoy segura que se calmarán los ánimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010312,
					"content": "¿Me ayudas a buscar cabezas de loto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010313,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Gracias, ¡regresa pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010315,
					"content": "Pero no están peleando por cabezas de loto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "¿No? ¿Entonces por qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Pequeña Lulu"
				},
				{
					"id": 220010317,
					"content": "De todas formas, encuentra algunas cabezas de loto y así dejarán de pelear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeña Lulu"
				}
			]
		},
