			"dialogs": [
				{
					"id": 762000501,
					"content": "Lumi, ¿tú también crees que está aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000502,
					"content": "¡Yajuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "Rescatan al gato atigrado atrapado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Parece que eras tú a quien buscaban. No tienes heridas visibles, pero si hubiéramos llegado un poco más tarde, quién sabe qué habría pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000505,
					"content": "En fin, ¡vayamos a buscar a tus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnéa"
				}
			]
		},
