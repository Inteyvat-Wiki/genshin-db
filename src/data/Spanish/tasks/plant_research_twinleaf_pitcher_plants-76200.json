			"dialogs": [
				{
					"id": 762000801,
					"content": "Estúpido gato... ¿Dónde se habrá metido?... ¿Eh? ¡Lo has encontrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Estaba atrapado en esa jaula bifolia de allá. Aunque es una planta, es un depredador carnívoro. Solo necesita unos días para digerir una luciérnaga lunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000803,
					"content": "Menos mal que lo encontramos a tiempo. Ahora solo está un poco débil, pero si hubiéramos tardado más... quién sabe qué habría pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000804,
					"content": "S-sí que es peligrosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Todo es culpa suya por haberse metido ahí. ¡Qué gato tan estúpido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Para ser justos, no es culpa suya. La jaula bifolia emite un olor especial que no afecta a las personas, pero atrae a los insectos y criaturas similares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000807,
					"content": "Así es como la jaula bifolia caza a sus presas. En esta zona hay una cantidad anormal de ellas, así que hasta los animales pequeños se han visto afectados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000808,
					"content": "Oh... Vaya. En fin, que estas hierbas hayan crecido tanto de la nada seguro que no es algo bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Así es. Si no hacemos nada, podría ser peligroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000810,
					"content": "Bien. Entonces, deja que nos encargarnos de arrancar las hierbas. ¡Jukka, tú también puedes ayudarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "Tenemos que devolverle el favor al culpable de que ese pobre gato haya sufrido tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "Eliminan las jaulas bifolias que crecían de forma anómala en la zona junto a los dos cazadores de tesoros...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Uf, por fin terminamos. Ya es hora de que volvamos a la Villa Nasha... Gracias por ayudarnos a encontrar a este gato tan estúpido, señorita. Si no hubieras estado aquí, quién sabe cuánto tiempo habría estado atrapado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "Aunque pensándolo bien, si no te hubieras puesto a gritar tan fuerte, tal vez lo habríamos encontrado mucho antes, Marja...",
					"roleType": "TALK_ROLE_NPC",
