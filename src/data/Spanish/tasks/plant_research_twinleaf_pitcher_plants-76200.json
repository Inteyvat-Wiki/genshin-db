			"dialogs": [
				{
					"id": 762000201,
					"content": "Disculpa, quería preguntarte si has visto un gato atigrado por aquí cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "¿Un gato atigrado? No parece que haya ninguno. ¿Lumi, has visto alguno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000203,
					"content": "¿Yajuuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "Parece que Lumi tampoco lo recuerda... ¿Se les ha perdido su gato? ¡Puedo ayudarles a buscarlo! Conozco bastante bien esta zona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000205,
					"content": "¡Oye, Jukka! ¿De dónde vamos a sacar dinero para contratar a una aventurera? Además, es solo un estúpido gato. Si se pierde, pues que se pierda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Marja, no digas eso. Si te escuchara, se pondría triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "¡Pero si no puede oírnos! Si pudiera, nos habría respondido cuando lo llamamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "No hace falta que me paguen por algo tan sencillo. Además, tengo que investigar por aquí cerca, así que me viene de paso. ¡Vamos, Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000209,
					"content": "(Hace poco no había nada aquí, y ahora han crecido tantas jaulas bifolias...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 762000210,
					"content": "(Quizás algún animal trajo semillas de las jaulas bifolias, pero no puedo dejar que sigan creciendo así...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnéa"
				}
			]
		},
