			"dialogs": [
				{
					"id": 221110101,
					"content": "¿Tienes nuevos encargos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110102,
					"content": "#Saludos, aventurer{F#a}{M#o}. Tus hazañas son famosas en toda Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110103,
					"content": "#Si sigues así, serás un{F#a}{M#o} de los más grandes aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110104,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "Si quieres convertirte en uno de los mejores, no puedes ir siempre a los mismos lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110106,
					"content": "#Si ya cuentas con tanta experiencia como aventurer{F#a}{M#o}, ¿por qué no explorar otras áreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110110,
					"content": "Toma este mensaje y llévaselo a la Katheryne de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110111,
					"content": "¿También hay una Katheryne en Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Así es, no te será difícil de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110115,
					"content": "Con esta carta, ella también podrá ofrecerte los servicios más profesionales para diferentes aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110116,
					"content": "#Tranquil{F#a}{M#o}, en caso de que regreses a Mondstadt, yo también continuaré ofreciéndote encargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110117,
					"content": "Por cierto, no abras esta carta. Si algo de su contenido llegara a caerse, estarías en problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110118,
					"content": "¡Ad astra abyssosque! ¡Y que tengas más éxitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110113,
					"content": "¿Entonces tú eres “Katheryne de Mondstadt”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "#Lo que sea que haga mejor tu experiencia de aventurer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110107,
					"content": "Estoy muy cómodo en Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "Hasta ahora solo has ido de aventura alrededor de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110109,
					"content": "Pero pronto querrás explorar el mundo más allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
