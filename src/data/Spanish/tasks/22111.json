			"dialogs": [
				{
					"id": 221110201,
					"content": "Esta carta es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110202,
					"content": "#¡Ad astra abyssosque! ¡Bienvenid{F#a}{M#o} al Gremio de Aventureros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110203,
					"content": "Creo que esto es para ti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "#¿Una carta? Déjame ver... Conque eres {F#una aventurera}{M#un aventurero} que viene de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110205,
					"content": "¿Eh? ¿Dientes de león? ¿Por qué alguien pondría algo así en un sobre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110206,
					"content": "¿Acaso metiste los dientes de león como prueba de que eres de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110207,
					"content": "No era necesario, si querías probar tu identidad solo bastaba con la carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110208,
					"content": "Yo no fui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "Bueno, no importa, tampoco es para tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110214,
					"content": "Por lo que veo en esta carta del Gremio de Aventureros de Mondstadt, cuentas con mucha experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110215,
					"content": "Entonces seguramente tienes lo que se necesita para los encargos del Gremio de Aventureros de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110216,
					"content": "¡Ad astra abyssosque! ¡Nuevas y grandes aventuras te esperan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110210,
					"content": "¿Tal vez fue Katheryne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "¿Katheryne? ¿Te refieres a “Katheryne de Mondstadt”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110212,
					"content": "¿Por qué metió dientes de león en el sobre? Qué extraño... ¿De qué le sirven los dientes de león a un aventurero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110213,
					"content": "Bueno, no importa, tampoco es para tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
