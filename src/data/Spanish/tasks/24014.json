			"dialogs": [
				{
					"id": 240140601,
					"content": "¿Has puesto ya los alevines en el agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140602
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140602,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "Muchas gracias. Volveré al trabajo en cuanto termine de arreglar mi traje de submarinismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140604,
					"content": "Espero que esos alevines puedan crecer bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "No te preocupes, hemos preparado diferentes especies de peces en función de las características de cada ecosistema acuático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140606,
					"content": "Los alevines que acabas de colocar están escogidos precisamente para esta zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140607,
					"content": "En un rato colocaré un nuevo grupo de alevines. También hemos contratado a un grupo de aventureros para que venga a encargarse de los Mecapeces de esta zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Estoy segura de que crecerán fuertes y sanos. Así, serán capaces de restablecer el ecosistema de esta zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Cuando hayamos reestablecido el orden natural de varios ecosistemas, escribiré un artículo larguísimo en el que explique con pelos y señales lo que los científicos de Fontaine le han hecho a los ecosistemas submarinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Prepárate, Damestier. ¡No dejaré que me detengas esta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				}
			]
		},
		{
			"id": 2401407,
