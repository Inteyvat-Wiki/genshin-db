			"dialogs": [
				{
					"id": 742500201,
					"content": "Muchas gracias por su hospitalidad, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500202,
					"content": "(Quedémonos sentados así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500204,
					"content": "De acuerdo, cuídese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
