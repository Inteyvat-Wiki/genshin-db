						"pointId": 108
					},
					{
						"sceneId": 103,
						"position": [
							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, ya hemos liberado prácticamente las tres zonas. También hemos salvado a casi todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "Y también hemos recuperado las cosas que perdió Zeitlind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Oh, muchísimas gracias. Parece que desde que Nihilita abrió los ojos, tiene muy buen juicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "Bueno, ¡ahora te toca a ti hablar! Antes dijiste que había una forma de subir y que había que pagar cierto precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "Si solo son un par de aventuras o pagar un poco de Mora, ¡a Paimon no le da miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "Bueno, y otra cosa, ¿cómo vamos a llevar a Zeitlind abajo? Ya terminó lo que tenía que hacer aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Eso no será problema alguno, pero descansen primero. Mañana se lo explicaré todo al detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "Está bien. Aunque aquí no hay ni camas ni comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "En este lugar no existe el deseo. ¿No te has dado cuenta de que, aunque llevas aquí bastante tiempo, no has sentido ni hambre ni sueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "¡Vaya! Pero si Paimon no puede comer ni dormir... ¿cómo va a pasar el rato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "¡Aquí hay personajes fascinantes de todas las épocas! Seguro que les resultará muy interesante charlar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Bueno, está bien. Pero dormir es un derecho básico de Paimon, ¡así que aunque no tenga sueño, va a echarse una siestecita sobre la cabeza de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "Zeitlind, cuando hayas descansado, me gustaría hablar contigo. Es sobre lo que mencioné antes, aquello que necesitaba un tiempo para pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "Ven a verme más tarde, ¿está bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}, Paimon, cuando hayan descansado lo suficiente, vengan a buscarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
