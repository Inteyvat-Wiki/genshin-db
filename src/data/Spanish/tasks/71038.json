						710380403
					]
				},
				{
					"id": 710380402,
					"content": "No tengas miedo, yo te llevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380403
					]
				},
				{
					"id": 710380403,
					"content": "Lo siento... Lo siento mucho, Jinwu y... *Cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380406
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710380406,
					"content": "#Por favor, no... *Cof*... No me mires así... No queríamos decepcionarl{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380407
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710380407,
					"content": "La ciudad dorada... La torre oscura... ¡*Cof*, *cof*! Los emisarios divinos se han marchado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380404
					],
					"speakerTitle": "Zhichiong"
				},
				{
