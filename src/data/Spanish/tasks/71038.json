				{
					"id": 710380408,
					"content": "¡Por Los Siete! Esta chica no parece encontrarse bien, ¡rápido, llevémosla de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380401,
