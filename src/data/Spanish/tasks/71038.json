	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhichiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "#¡Hola, viajer{F#a}{M#o}! Siéntate donde quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360402,
					"content": "Sobre esas aventuras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Lo que quieres preguntarme es por qué fui tan terca e hice que todo el mundo se preocupara, ¿verdad? Jaja... Ya sé que estuvo mal, no tienes que recordármelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360404,
					"content": "#Aunque, para ser sincera, creo que buscar peligros es casi como una obsesión para los aventureros como nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360405,
					"content": "Al fin y al cabo, nacemos con huesos fuertes y miembros ágiles... Y nos oponemos a la mera idea de enfrentarnos a las adversidades de esta vida sin una espada a nuestro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360406,
					"content": "Y en lo que se refiere a si hay riesgo de que muera... No es que no haya pensado en eso, pero... Por cierto, quiero hacerte una pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360407,
					"content": "Adelante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "Stanley, el gran aventurero de Mondstadt, es famoso por haber cruzado Mare Jivari... pero perdió a un amigo en esa travesía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360409,
					"content": "Su amigo murió... Aunque su historia es una leyenda entre los aventureros, muy pocos saben si quiera cómo se llamaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360410,
					"content": "#Jaja, por favor, {NICKNAME}, no te rías, pero estuve pensando... ¿Y si el compañero de Stanley no murió realmente y es ahora cuando “vive” de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360411,
					"content": "La vida en sí es lo más importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Incluso si murió prematuramente, ahora todo el mundo lo recordará... ¿No es eso una continuación de la vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360413,
					"content": "Vivir así, en la memoria de los demás, en su admiración y recuerdo... Esa también es una forma de vivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360422,
					"content": "No deberías darle tanta importancia a lo que piensan los demás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "Eso mismo me ha dicho mucha gente. “Sé tú misma”, “preocúpate por tus propios asuntos”... Parece que intentan ayudarme, pero en realidad solo quieren que me rinda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360424,
					"content": "Yo siempre lo digo. Mis aventuras... No las tengo por los demás, ni siquiera por mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360425,
					"content": "#¿Te lo has planteado alguna vez, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360426,
					"content": "Los dioses reinan sobre este mundo. Pero incluso nosotros, unos simples mortales sin una “Visión”, nos negamos a vivir una vida de tranquilidad y olvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360427,
					"content": "No creo que ese sentimiento carezca de sentido. Por eso, me paso la vida explorando lugares peligrosos. Al fin y al cabo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360428,
					"content": "Lo que nos hace humanos es esa eterna lucha contra aquello que incluso los dioses temerían si fueran tan frágiles como nosotros. O, al menos, eso es lo que yo creo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360429,
					"content": "Pero tú no eres lo único que le da sentido a la aventura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Hum... Lo entiendo. No olvidaré la ayuda que todos me prestaron ni todas las molestias que te causé... Al fin y al cabo, esta aventura no solo me concierne a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360437,
					"content": "Jaja, ¡eso es lo que hace un aventurero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360432,
					"content": "¿Así que quieres ser una heroína?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "Comparada contigo, aún me queda un largo camino... Pero más que una heroína, me considero alguien que “no le teme a la muerte para vivir plenamente”, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360434,
					"content": "Esa frase me la enseñó una amiga de Sumeru. Ella se la escuchó a alguien de Los Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360435,
					"content": "Creo que tiene mucho sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360436,
					"content": "¡Pero bueno! Paimon diría que más bien estás persiguiendo desastres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Ser recordado por todos es también un éxito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Hum... Nunca me he planteado tener una vida exitosa. Al contrario, incluso si fracaso, solo quiero dejar huella en los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360416,
					"content": "Al menos así habrá alguien que diga: “¡Zhichiong también se enfrentó a la Sima!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360417,
					"content": "Al menos así, no sería olvidada como todos esos que murieron en tierra de nadie. Al menos así... no sería como la yo de ahora, una donnadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360418,
					"content": "Nunca lo había pensado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "¿D-de verdad? A lo mejor es porque las personas como tú, da igual dónde vayan o qué hagan, siempre son el centro de atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360420,
					"content": "Igual que las personas que nacen en una cuna de plata. Para ellos la pobreza es tan solo una aventura innecesaria y emocionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710360421,
					"content": "¡Ah! Disculpa... No quería decir eso. Es solo que... Bueno, da igual. Olvida lo que dije.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhichiong"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "Se trata de Zhichiong otra vez. Fue a recoger los datos de las balizas... pero aún no ha regresado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380202,
					"content": "Ya sé que tiene la fea costumbre de deambular por todos lados y preví tres horas adicionales para que volviese... Pero ya han pasado cinco o seis horas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380203,
					"content": "¿Me ayudarías a buscarla? Ella te tiene en alta estima, así que debería escucharte. No me gustaría que volviera a pasarle nada a alguien delante de mis narices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380204,
					"content": "¡Pero bueno! ¡¿Qué le pasa a esa muchacha?! ¿Cómo es que se perdió otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380205,
					"content": "De acuerdo, iré a buscarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380207
					]
				},
				{
					"id": 710380207,
					"content": "¡Oh! ¡Por cierto! Casi olvido decirles lo más importante de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380208,
					"content": "No creo que haya llegado muy lejos, pero... ¿adónde habrá ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380209,
					"content": "No te preocupes, Jinwu. ¡Empezaremos por buscarla en los lugares donde dejamos las balizas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380210
					],
					"speakerTitle": "Paimon"
				},
				{
