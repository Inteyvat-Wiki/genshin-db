					"nextDialogs": [
						710380606
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380606,
					"content": "No importa, lo que Zhichiong necesita ahora es descansar. Llévenle esta sopa para que se la tome mientras está caliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380607
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380607,
					"content": "La cocina no es mi punto fuerte, pero he cuidado de muchos mineros y ninguno se ha quejado de mi comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380608
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380608,
					"content": "Vayan a ver si Zhichiong se encuentra mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380609
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380609,
					"content": "Tengo que informar a Muning de que Zhichiong no puede permanecer bajo tierra.",
