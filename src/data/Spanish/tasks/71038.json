					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380602,
					"content": "¿Ustedes saben qué le ocurrió? ¿Cómo puede una persona como ella acabar así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380603
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380603,
					"content": "Cuando la encontramos, estaba atrapada en el fango oscuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380604
					]
				},
				{
					"id": 710380604,
					"content": "¡Eso! ¡Menos mal que fuimos a rescatarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380605
					],
					"speakerTitle": "Paimon"
				},
