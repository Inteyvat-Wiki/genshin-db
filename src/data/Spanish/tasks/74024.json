				},
				{
					"id": 740240702,
					"content": "¿Crees que esto servirá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240703,
					"content": "O más bien, ¿en serio podrá elaborar colores brillantes con estos materiales?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240704,
						740240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240704,
					"content": "Me temo que no...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Pero a Sluasi se la ve muy contenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "Resulte el color que resulte, les estaré igualmente agradecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Acepten esto como un obsequio por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "¡Es una piedra preciosa! ¡Y un componente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Jeje... Me alegra que les gusten. Si algún día buscan cualquier tipo de joya, pueden venir a buscarme siempre que quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "#Seamos positiv{F#a}{M#o}s, el que la sigue la consigue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "Al fin y al cabo, Maime también utiliza pinturas de colores muy extraños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
