						740240301
					]
				},
				{
					"id": 740240301,
					"content": "Muchas gracias por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240302,
					"content": "#Pero {NICKNAME}, no puedo aceptarte eso de cualquier manera. Basta con que sepa el nombre del material, así me será más fácil hallar la forma de encontrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240303,
					"content": "Pero ¿no les parece que ese color es demasiado oscuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240304,
					"content": "Pienso que el sol es de un tono más claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240305,
					"content": "¿Más claro? ¿Más cercano al blanco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240306,
					"content": "Visto así, la verdad es que el sol es más blanco que dorado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240307,
					"content": "Entonces, ¿nos decantamos por el blanco? Pero todavía no estoy segura de qué materiales deberíamos usar para conseguir un tono más claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240308,
					"content": "¿Y si le añades agua y ya está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "Agua... Humm, probé a hacerlo una vez, pero el resultado final no quedó demasiado bien. Aclarar colores con agua siempre da como resultado colores sin vida. No podríamos conseguir ese esplendor que ella desea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240310,
					"content": "Así que, si es posible, creo que deberíamos pensar en otra opción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240314,
					"content": "Paimon está convencida de que a menudo vemos cosas blancas y brillantes que nos podrían servir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240311,
					"content": "Podrías usar el cabello de Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "¡Hemos dicho que el cabello no puede usarse para elaborar pinturas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240313,
					"content": "Y aunque se pudiera, ¡no puedes arrancarle el cabello a Paimon así como así! ¡Será posible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
