			"dialogs": [
				{
					"id": 740240516,
					"content": "Sluasi observa el material con meticulosidad antes de devolvéserlo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "Así que esto es a lo que llaman “blanco”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240502,
					"content": "Me parece que representa todo lo contrario al color del sol... De hecho, hasta diría que es el color opuesto al del sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240503,
					"content": "El color opuesto... ¿no sería el negro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240504,
					"content": "El negro... Así es, debe de ser el negro. No esperaba menos de la inteligencia de Paimon. El color del sol sería el color negro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240505,
					"content": "Creo que hay algo que falla en esa afirmación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "Pero ya que lo has mencionado, ¿por qué sería negro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240509,
					"content": "Eso, el sol es dorado, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "¿Podría pedirles una última cosa más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240513,
					"content": "Me gustaría que me trajeran algo de color negro. Así podría hacerme una idea mejor de qué material utilizar para crear un color tan esplendoroso como el sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240514,
					"content": "¿En serio tenemos que ir a buscar eso? Paimon piensa que ese color ya no tendrá nada que ver con el sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240515,
					"content": "#En fin, ya que nos lo ha pedido... {NICKNAME}, vayamos a buscar alguna cosa de color negro que podamos mostrarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240510,
					"content": "A no ser que te refieras a cuando el sol se pone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "Aunque se haga de noche, ¡el sol sigue sin ser de color negro! De hecho, ¡por la noche ni siquiera vemos el sol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240506,
					"content": "Se trata de una afirmación paimoniana en toda regla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "¡EH! ¡Ya está bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
