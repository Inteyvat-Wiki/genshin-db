					"nextDialogs": [
						740241203
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241203,
					"content": "Eh... Bueno, pero es que “nilotpala” hace referencia al color de sus hojas azules. Es solo la coronita la que tiene el color del sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
