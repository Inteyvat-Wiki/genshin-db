					{
						"sceneId": 3,
						"position": [
							2408.11,
							252.736,
							4985.173
						],
						"pointId": 340300092
					},
					{
						"sceneId": 3,
						"position": [
							2408.264,
							252.729,
							4986.404
						],
						"pointId": 340300093
					}
				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "Oye, ¿qué haces aquí sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240102,
					"content": "¡Aaah! ¿Es que no te han dicho que está mal hablarle a la gente por la espalda? Casi tiro por tierra estos polvos por tu culpa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240103,
					"content": "¿Eh? ¿Qué son esos polvos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240104,
					"content": "¡Son piedras preciosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240105,
					"content": "¿Y cómo es que aquí hay piedras preciosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240106,
					"content": "Más raro sería que no hubiera, ¿no? Este es mi taller y yo me dedico a procesar piedras preciosas, así que... Pero no le he puesto nombre todavía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240107,
					"content": "Estaba pensando en algo así como “El Taller de Sluasi”, pero no estoy segura de si usar mi nombre es una buena idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240108,
					"content": "¿Qué es eso de “procesar piedras preciosas”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "Quiere decir que las convierto en todo tipo de abalorios bonitos y cosas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240110,
					"content": "No obstante, me temo que no podré aceptar más encargos por ahora. Estoy ocupada preparando pinturas... Aunque también use piedras preciosas para ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240111,
					"content": "¿Eh? ¡¿Cómo que usas piedras preciosas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240112,
					"content": "¿Eh? Pues sí, ¿les parece raro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240113,
					"content": "Oh... Paimon piensa que es todo un desperdicio. Si lo que pasa es que ya no te hacen falta esas piedras preciosas, puedes dárselas a Paimon, seguro que ella les da buen uso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240114,
					"content": "Pero ¿por qué quieres hacer pinturas? No parece que sea parte del proceso de fabricar joyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240115,
					"content": "Hace tiempo, una melusina a la que le gustaba pintar vino a preguntarme si podía elaborar para ella un pigmento que fuera tan brillante como los diamantes y tan esplendoroso como el sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240116,
					"content": "Y fue ella quien salvó a mi hermana pequeña durante el terremoto que sucedió hace no mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240117,
					"content": "Por eso, espero poder darle una alegría consiguiendo lo que ella quiere, y regalarle “un pigmento tan esplendoroso como el sol” como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240118,
					"content": "¿Te estás refiriendo a...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "Oye, esa melusina a la que le gusta pintar que has mencionado, ¿no se llamará Maime por casualidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240120,
					"content": "¿Eh? Pues sí, esa es. ¿Acaso la conocen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240121,
					"content": "Le explicas a Sluasi lo que sucedió anteriormente con Maime...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#¿M-me están diciendo que {F#las legendarias}{M#los legendarios} {NICKNAME} y Paimon salvaron a Pucca con la ayuda de Maime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240123,
					"content": "#¿L-legendari{F#a}{M#o}s?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240124,
					"content": "#Bien dicho, es{F#a}{M#o}s somos nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "¡No saben lo agradecida que les estoy! Si no fuera por ustedes, Pucca habría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240127,
					"content": "Si no les importa, ¡me gustaría darles esto como muestra de agradecimiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240128,
					"content": "(Guau, qué gema tan bonita...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#¿De verdad podemos quedárnosla, {NICKNAME}? Tiene pinta de ser carísima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240131,
					"content": "Pero Paimon nunca habría imaginado que Maime tuviera tanta iniciativa como para hacerle un encargo a alguien ella solita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240132,
					"content": "Bueno, tampoco puede considerarse un encargo del todo, ¿no? Al fin y al cabo, ella solo me preguntó si yo sería capaz de hacerlo, pero salió corriendo antes de que pudiera darle una respuesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240133,
					"content": "Suena a algo que ella haría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240134,
					"content": "#Por cierto, legendari{F#a}{M#o}s {NICKNAME} y Paimon, hay algo que me gustaría preguntarles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240135,
					"content": "¿Cómo sería para ustedes “algo del color del sol”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240136,
					"content": "Aunque he observado el sol para tenerlo como referencia, todavía no tengo claro qué materiales debería utilizar para poder reproducir un color lo más aproximado posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240137,
					"content": "Humm... “Algo del color del sol”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240138,
					"content": "... ¿Oro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "Humm, me parece que alguna vez escuché a Canotila mencionar que “las pepitas de oro eran lágrimas derramadas por el sol”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240140,
					"content": "¿Pero no te parece demasiado extravagante elaborar pintura hecha de oro? Seguro que hay otro material más corriente que podría servir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240148,
					"content": "Además, seguro que hemos visto antes “algo del color del sol”, y debe de ser algo común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240141,
					"content": "... ¿El mismo sol?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "#... Solo se le podría ocurrir a alguien tan grandios{F#a}{M#o} como {NICKNAME}. Por supuesto, no hay cosa que represente mejor el color del sol que el sol en sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240143,
					"content": "Pero ¿cómo voy a moler el sol para convertirlo en polvo con el que elaborar pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240144,
					"content": "No, ¡ni se te ocurra tomar en serio un disparate como ese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240145,
					"content": "Si no hay más remedio, puedes usar mi cabello rubio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240147,
					"content": "¡Tampoco sirve! ¿Cómo vas a elaborar pintura hecha de cabello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240130,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "Bueno, tampoco es para tanto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
