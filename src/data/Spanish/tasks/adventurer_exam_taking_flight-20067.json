					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670102,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "#Viajer{F#a}{M#o}... Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670104,
					"content": "Estudié mucho después de nuestro último entrenamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670105,
					"content": "Y luego le pedí a Jack que viniera a ayudarme con un examen de prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670106,
					"content": "Pero... no lo aprobé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670107,
					"content": "#No sé en qué fallé. Viajer{F#a}{M#o}, ¿podrías ayudarme otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670108,
					"content": "Sí, claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "#¡Muchas gracias, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670111,
					"content": "Veamos... la primera pregunta es, ¿cuántas personas pueden usar un solo planeador para volar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670109,
					"content": "(¿Será que yo le di las respuestas equivocadas?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
