			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "¡Kun Jun! ¿Qué estás buscando? ¡Ya nos quedamos sin pistas! ¡Andando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Oh, lo siento, estoy haciendo una investigación rápida por cuenta propia. Estoy en busca de una piedra preciosa conocida como “dragonita”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "¿“Dragonita”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Nunca había oído hablar de ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "La dragonita se utiliza a menudo en la forja. ¿Para qué la buscas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "Yo... no lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "L-lo siento, no recuerdo por qué la estoy buscando... Últimamente, he estado un poco distraído... A excepción de mi nombre y mi hogar, tengo problemas para recordar las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "De hecho, recientemente me siento extremadamente... ansioso. Como si me hubiera olvidado de terminar algo. Es... una sensación desagradable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "¡Oh, Paimon conoce ese sentimiento! Cuando sabes que olvidaste algo, pero no puedes recordar exactamente qué es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "*Suspira*... No sé ni por dónde empezar. He estado... vagando sin rumbo fijo. Ese día en el mercado, escuché una conversación mientras estaba comprando algo. Mencionaron algo sobre la dragonita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Me sonaba tan familiar... Era como si todas mis acciones estuvieran relacionadas con esa piedra... Así que decidí buscarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Quizás, si puedo conseguirla, recordaré qué es lo que tenía que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Ya veo... En la medida de lo posible, te ayudaré a encontrar esa piedra durante nuestra empresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "¿En serio? ¡Se lo agradezco, Sr. Zhongli! ¡Es usted demasiado amable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "No es nada, en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "¿No deberíamos irnos ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Si nos dirigimos hacia el norte desde la Sima, llegaremos al Paso Lingju. Si este es realmente el camino que tomaron, habrán dejado rastros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "¡Genial! ¡Echemos un vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "No es mi área de especialización.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
		{
			"id": 1112109,
