			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Disculpe, ¿trabaja aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Ah, sí, sí. Seguramente están aquí por la desaparición. Por favor, ¡hagan lo posible por encontrarlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210303,
					"content": "N-no sé qué pasó. Ese día, el cielo estaba bastante oscuro y el capataz se había ido con unos cuantos hombres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210304,
					"content": "Yo me quedé atrás con los otros cuatro. Al cabo de un tiempo, decidí tomar un descanso... ¡Para darme un respiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210305,
					"content": "Me quedé dormido en el cobertizo del interior. Cuando desperté, ¡no había nadie a la vista! En un instante, estaba hablando con ellos, y al otro, ¡habían desaparecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210306,
					"content": "Tal vez... ¿Tal vez yo sea el próximo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210307,
					"content": "Entonces los hombres que estaban afuera desaparecieron y el único que quedó para contarlo estaba dormido dentro del cobertizo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "¿Quizás ocurrió un accidente en el área de trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "¡Ah! ¡Qué miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "Un accidente en el área de trabajo... Anotemos eso también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "¡Por aquí! ¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Camisas y pantalones dispersos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Algunos objetos de uso diario... Deben de ser del Sr. Dai y sus hombres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Uno, dos, tres, cuatro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Humm... Sí. Diez camisas y diez pares de pantalones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Deben ser de repuesto, ¿cierto? Mira, la ropa del Sr. Dai es totalmente idéntica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Los cuatro llevan seis días desaparecidos sin cambiarse de ropa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "También hay unos cuantos pañuelos y jabón en el suelo... Ah, y unos cinturones para herramientas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Artículos para lavarse la cara antes del turno matutino, equipo de minería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "Entonces, ¿no se llevaron su equipaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "¿Tal vez no lo necesitaban?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Es poco probable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Faltan cuatro picos. Claramente llevaron herramientas con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "¿Tuvieron tiempo de llevarse las herramientas, pero no los objetos de uso diario? Interesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Humm... ¿Por qué alguien se llevaría las herramientas, pero dejaría su equipaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "Primera posibilidad: estaban trabajando en los alrededores, así que no necesitaban llevar consigo sus bienes. Pero, como no han regresado aún, es una hipótesis poco probable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Segunda posibilidad: fueron obligados a irse y no tuvieron tiempo para pensar en sus posesiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "¡Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Estás diciendo que... ¿alguien se los llevó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Es una posibilidad. Necesitaremos más pruebas antes de hacer más conjeturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "Si no se fueron por su propio pie, quizás algo los obligó a irse... Anotémoslo para informarle al Sr. Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "¿Tal vez se les olvidó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "¡Volvieron! ¿Qué tal va la investigación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210702,
					"content": "Encontramos tres pistas en los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "En primer lugar, faltan cuatro picos y los objetos de uso diario todavía están en su lugar. Quiere decir que sus hombres no se fueron por decisión propia, sino que se los llevaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "¿Llevárselos? Pero... ¿quién secuestraría a unos mineros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210705,
					"content": "En segundo lugar, había cinco trabajadores en la mina. Uno de ellos dejó el área de trabajo para descansar. Al despertar, sus colegas ya habían desaparecido sin dejar rastro alguno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Aquellos que siguieron trabajando desaparecieron. El que salió antes quedó sano y salvo. Todo indica que el incidente ocurrió en el área de trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Ahora que lo menciona, recuerdo que Hu dijo que tomó un descanso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210708,
					"content": "¿Cómo pudo alguien meterse al lugar de trabajo y llevárselos así sin más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210709,
					"content": "Lo cual me lleva al tercer punto: el señor Kun Jun, haciendo uso de su conocimiento como experto... llegó a una conclusión. Un niño se llevó a sus hombres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "¡¿Un niño?! ¡Pero no hay casas en millas! ¡Es imposible que un niño llegue hasta la mina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210711,
					"content": "Por más improbable que parezca, esa es nuestra conclusión. Sus hombres iban siguiendo a un niño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "¿A dónde fueron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210713,
					"content": "Suponemos que siguieron el camino hacia el norte, lejos de la mina y en dirección a las ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "¡El norte! De acuerdo, reuniré a unos hombres e iremos a buscarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210715,
					"content": "¿Necesita ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Han sido de gran ayuda para la investigación, pero pueden dejarnos el trabajo pesado a nosotros. Si partimos pronto, tal vez podamos alcanzarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210717,
					"content": "No tan rápido. El incidente ocurrió hace seis días. Incluso si se fueron a pie, ya habrán recorrido mucho terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "*Suspira*, es verdad... Es momento de idear un nuevo plan. Llevaré a mi grupo de búsqueda a los asentamientos más alejados a averiguar qué pasó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210719,
					"content": "En realidad, fuera de la mina solo quedan unos pocos asentamientos para pasar la noche. Nosotros nos haremos cargo de esa parte de la investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210720,
					"content": "¿Puedo pedirles que sigan buscando pistas? Debemos dividirnos. Si no nos volvemos a encontrar, reunámonos en la Posada Wangshu mañana al anochecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210721,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "¡Muy bien, mis hombres y yo nos pondremos en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210723,
					"content": "Entonces... ¿van a hablar con la gente de los asentamientos mientras seguimos investigando aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "En efecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Pero... no hay más pistas en la mina... ¿No deberíamos ir al norte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Espera... me temo que olvidamos a alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Oh, sí, ¿dónde está Kun Jun? Paimon está segura de que todavía está investigando. ¡Llamémoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
							"2"
						],
						"stepId": 1112108,
						"stateName": "QUEST_STATE_UNFINISHED"
