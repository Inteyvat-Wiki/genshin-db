			},
			"dialogs": [
				{
					"id": 741540201,
					"content": "Aquí hay gato encerrado... ¡Hasta Paimon se da cuenta de que algo no está bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, tú eres quien mejor ideas tiene. ¿Qué deberíamos hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoit quiere ayuda, pero insiste en que no lo ayudemos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Entonces, ¿qué te parece si vamos a echar otro vistazo por los alrededores de la casa de Benoit? ¿No había unas cajas extrañas cerca de la ventana trasera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "Seguro que dentro hay algo escondido, y podría ser la prueba que estamos buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Esa pareja podría provenir del Río Ceniciento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "Por sus reacciones, diría que esconden algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Tengo algunas hipótesis, pero no tengo pruebas que las respalden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
