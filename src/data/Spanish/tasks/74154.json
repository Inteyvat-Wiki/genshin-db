					},
					{
						"sceneId": 3,
						"position": [
							3582.053,
							435.073,
							4515.892
						],
						"pointId": 7528
					},
					{
						"sceneId": 3,
						"position": [
							3582.002,
							435.073,
							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Teniendo en cuenta lo insistentes que son, supuse que no se irían así como así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540702,
					"content": "Pensé que irían directamente a la Oficina Judicial, pero no lo hicieron. Parece que tienen sus propias ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540703,
					"content": "¿Por qué tienen encerrado a Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "A decir verdad, me tienen algo impresionado. Si utilizaran ese entusiasmo de forma correcta, podrían tener un futuro brillante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540706,
					"content": "Es una pena que eso no vaya a ocurrir. *Suspira*, no tienen ni un poco de miedo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540707,
					"content": "Has elegido a la persona equivocada a la que intimidar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "¿Eh? ¿Es porque no tienen ni idea de cuál es su situación, o porque piensan que están del lado de la justicia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540709,
					"content": "Hablando de todo un poco, hace poco salió una noticia sobre un comerciante que se ahogó. Se llamaba Brandt. Era un tipo bastante hablador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540710,
					"content": "¿Pero saben qué? Según la noticia, resulta que no se ahogó, sino que lo asesinaron y lo arrojaron al lago después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540711,
					"content": "Tras una larga investigación, todo lo que la Gendarmería Fantasmal pudo concluir fue que fue asesinado, y que el asesino merecía morir por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540712,
					"content": "Y eso fue lo que se escribió en la noticia. Quién sabe qué ocurrió en realidad, o quién merecía morir, si la víctima o el asesino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540713,
					"content": "Es una pregunta complicada, ¿no creen? Todavía no se me ha ocurrido una respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540714,
					"content": "Oh, me estoy yendo por las ramas. Esto no tiene nada que ver con lo que nos concierne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540715,
					"content": "¿Qué quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Lo que quiero decir es que actuar de forma precipitada sin entender la situación es algo estúpido, y podría traer consecuencias indeseadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540717,
					"content": "Lo que es estúpido es no reaccionar ante la injusticia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Jaja. Si nos hubiéramos conocido en otras circunstancias, quizás podríamos haber sido amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540720,
					"content": "Aunque me gusta tu forma de pensar. Tengo cosas que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540721,
					"content": "#Este es el límite de mi paciencia. La próxima vez que l{F#a}{M#o}s vea deambulando por mi casa, tomaré cartas en el asunto. No lo olviden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540722,
					"content": "Tras murmurar algo incomprensible, Atos se marcha.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "Te sorprende su extraña actitud, y te empiezas a preguntar qué posición deberías tomar en el asunto...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "Se oye un ligero golpe en el cristal de la ventana trasera y, tras un ligero crujido, una nota sale despedida por la ventana...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "La nota está escrita en color marrón. Parece que alguien la escribió con mucha prisa y utilizó café para hacerlo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "¡Rápido, veamos qué pone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "¡Es Benoit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "¡Shh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "#... ¡Perdón! De todos modos, estemos atent{F#a}{M#o}s al cuenco de comida de la gata y esperemos a su señal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Cuando veo algo injusto, actúo sin dudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "¿Qué relación tienen de verdad con Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
