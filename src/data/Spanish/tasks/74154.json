						],
						"pointId": 7531
					},
					{
						"sceneId": 3,
						"position": [
							3596.88,
							435.073,
							4532.97
						],
						"pointId": 7532
					},
					{
						"sceneId": 3,
						"position": [
							3598.11,
							435.073,
							4532.42
						],
						"pointId": 7533
					},
					{
						"sceneId": 3,
						"position": [
							3598.08,
							435.073,
							4533.55
						],
						"pointId": 7534
					}
				]
			},
			"dialogs": [
				{
					"id": 741540801,
					"content": "#¡{NICKNAME}, mira! Hay pescado fresco y el suelo está limpio. Seguro que alguien acaba de limpiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "Debe haber alguien en casa de Benoit. Vayamos a ver si oímos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "... Tiene razón. No puede desaparecer para siempre. Al menos, debe aparecer de vez en cuando y dar un paseo o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540804,
					"content": "Así podremos evitar que los vecinos llamen a la Oficina Judicial. No me apetece tener al Cuerpo de Mosqueteros encima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540805,
					"content": "Papá, ¿quieres salir a dar un paseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "¿P-puedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540807,
					"content": "¡Claro que puedes! No solo eso, sino que además estaremos encantados de acompañarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "#Ten cuidado. Que no aproveche la oportunidad para salir a pedir ayuda. Es{F#a}{M#o}s dos rarit{F#a}{M#o}s han estado vigilando como si fueran halcones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540809,
					"content": "Papá no haría eso, estoy segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Papá, tú no querrías que la Oficina Judicial sepa que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "¡¿Saber qué?! ¿Por qué hablan en voz baja? Paimon no oye bien lo que están diciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "Van a salir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Sí, alejémonos un poco. Esta vez tenemos que encontrar la forma de hablar con Benoit, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Muy bien. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "¿Qué tal, papá? ¿Te encuentras mejor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "¡Son ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540818,
					"content": "Benoit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "¡Ayúdenme!... No, no me ayuden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540820,
					"content": "¿De qué estás hablando, papá? ¿De qué va todo eso de ayúdenme pero no? Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "#Oh, son ustedes. No me extraña que papá l{F#a}{M#o}s saludara directamente. Después de todo, son conocid{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "... ¡No! No nos conocemos, ¡no nos conocemos!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540823,
					"content": "¿No? ¿Y cómo es posible que estuvieran justo aquí esperándote, papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "Incluso tuvieron la amabilidad de recoger el periódico por nosotros, y hasta fueron al Río Ceniciento para hablar con nuestro vecino, Snodgrass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "¡Creo que son muy cercanos! Y no me extraña. A papá siempre le han encantado los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "¡Y a mí también me encantan! Pero no soy tan generosa como mi padre. De todos, a quien más amo es a mi hija, pero ya no está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "¿Qué están tramando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Atos y yo somos los hijos de papá. Papá nos ama, y nosotros también a él. ¿No es obvio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Morticia, mira qué tiempo tan bueno hace hoy. Es un día perfecto para dar un paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540832,
					"content": "Sí que lo es, Atos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "¿Has visto el número de hoy de «El Pájaro de Vapor»? Hay algunas noticias interesantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540834,
					"content": "Aún no lo he visto, cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "Hay una sobre un desafortunado anciano que falleció. Al parecer, se encontró con unos ladrones y no había nadie con él para protegerlo. Acabó cayendo por un acantilado y murió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540836,
					"content": "¿En serio? Es terrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "Y hay otra sobre un comerciante que se ahogó. Parece ser que había bebido demasiado, se mareó y acabo ahogándose en un lago. Así, sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540838,
					"content": "¡Oh, no! ¡Qué mala suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "¡Y esta última, es muy interesante! Es sobre una persona entrometida. *Suspira*. Al parecer, se tomó la medicina equivocada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540840,
					"content": "Confundió veneno con su medicina y, después de tomarlo, murió entre terrible sufrimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540841,
					"content": "¡Por Los Siete! Sí que hay formas de morir. Cuéntame más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "¡Perdón! Lo siento, no volverá a ocurrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540843,
					"content": "¿Qué dices, papá? No te estamos culpando de nada. Llevas mucho rato andando, debes estar cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Atos, ¿por qué no volvemos y le leemos el periódico a papá? A fin de cuentas, se ha suscrito a un montón de periódicos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "Sí, ya hemos charlado suficiente. Es hora de regresar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540846,
					"content": "Volvamos, mi querido papá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "¿Por qué hacen esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "¿Te refieres a acompañar a nuestro padre a pasear? Es nuestro deber como hijos suyos. Si no, ¿cómo íbamos a devolverle el amor que nos ha dado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
}