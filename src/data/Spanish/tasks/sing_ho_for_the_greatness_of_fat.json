					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "Jeje, nada mal, pero aún no me has superado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650702,
					"content": "Yo siempre he mantenido esta complexión, pero nunca he dejado de entrenarme. Esos adictos al gimnasio tan insensatos no son rivales para mi agilidad y fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650703,
					"content": "¡Olvídate de tanto músculo y aprecia conmigo la maravillosa grasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516505",
							"3"
						],
						"stepId": 7516505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516506"
						],
						"stepId": 7516506
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "Nada mal, pero sinceramente... mi mejor marca es superior, y no lo digo por alardear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650802,
					"content": "Bueno, todo el mundo tiene algo en lo que destaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650803,
					"content": "¿Ahora me crees? Un guerrero con mi complexión no tiene por qué no ser ágil. ¡Por eso hay que comer bien y no intentar adelgazar sin razón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				}
			]
		},
		{
			"id": 7516509,
			"completionStepIds": [
				7516506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
