					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751651002
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751651002,
					"content": "¡Pruébalo y verás lo poderosa que puede ser una complexión grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
