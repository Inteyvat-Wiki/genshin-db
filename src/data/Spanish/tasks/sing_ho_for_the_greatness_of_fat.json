					"content": "Necesito un momento para prepararme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "#No hay problema. Vuelve cuando estés list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
