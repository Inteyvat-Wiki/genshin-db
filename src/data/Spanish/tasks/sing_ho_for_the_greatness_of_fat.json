				]
			},
			"dialogs": [
				{
					"id": 751650901,
					"content": "Illimani, ¡te veo más recio! ¡Felicidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650902,
					"content": "Jaja, gracias, Suriqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650903,
					"content": "¡Buenas noticias! He convencido a otra persona que quería adelgazar de que se una a nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650904,
					"content": "¡Oh, eso es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650905,
					"content": "¡Ah, eres tú! ¿Qué tal? ¿Has estado comiendo bien últimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650906,
					"content": "¡Me he dado un buen atracón!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "Muy bien, nunca está de más comer. Donde hay grasa, hay alegría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650910,
					"content": "#Escucha, Illimani, a est{F#a}{M#e} chic{F#a}{M#o} se le da muy bien romper vasijas. Casi alcanza mi mejor puntuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650911,
					"content": "A mí también me ha desafiado, y no lo ha hecho nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650912,
					"content": "¡Impresionante! No imaginaba que se te daría tan bien. ¡Te falta poco para superarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650913,
					"content": "Si gana un poco más de peso, puede que incluso nos supere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650914,
					"content": "#Humm, es probable. Desde mi punto de vista, sigues estando demasiado delgad{F#a}{M#o}, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650915,
					"content": "¡Tienes mi aprobación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650916,
					"content": "¡Y la mía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650917,
					"content": "Pero te sugiero que comas un poco más en cada comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650918,
					"content": "No te pongas a dieta ni te saltes comidas, o nos decepcionarás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650908,
					"content": "No he comido muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "¡Eso no está bien! ¡No hay nada más importante que comer bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Suriqui"
				}
			]
		},
