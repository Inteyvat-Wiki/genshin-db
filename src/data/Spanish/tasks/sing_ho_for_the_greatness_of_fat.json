			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "Valiente transeúnte... Sí, ¡tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "#Ay, estás muy delgad{F#a}{M#o}... ¿Estás comiendo bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "Mi guía, Paimon, se lo ha comido todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Sean cuales sean tus motivos o dificultades, ¡lo más importante es comer bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "Has entrado en Teteocán, así que supongo que ya habrás visto a los musculosos guerreros de la Comunidad de la Feracidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "Te daré un consejo porque tengo buen corazón: no confíes en esos tipos obsesionados con los músculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "La grasa que nos confieren los Arcontes es un regalo preciado. Renunciar a todos los deliciosos manjares y dejar atrás la grasa, todo por unos músculos llamativos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "Es la tontería más grande que he oído nunca. Incluso los jabalíes se compadecerían de alguien así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "Además, si hablamos de lo que se considera hermoso, esto de los músculos es cosa de hace unas décadas solamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Mi abuelo me contó que, cuando era joven, a la gente le gustaba los cuerpos algo más rellenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Así que ¡no hagas caso de lo que dice la gente ni te embarques en el desafortunado camino del adelgazamiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "Pero si llega el día en que elijas perder peso para ganar fuerza como mis parientes de la Comunidad de la Feracidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Te diré algo más: si hablamos de agilidad, los guerreros con un cuerpo ligeramente más grande pueden ser ágiles como un pez, pero en cuanto a fuerza se refiere, esos tipos tan delgados no pueden hacer nada contra nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Si necesitas pruebas, las vasijas de este campo de entrenamiento te servirán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Con mi envergadura, <color=#00E1FFFF>pasar a toda velocidad entre ellas sin romper ni una sola</color> sería pan comido, pero apuesto a que alguien más delgado no podría hacerlo con tanta agilidad. ¿Tú qué opinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Veo que estás intentando contener la risa... No pasa nada, ya sabía que no me creerías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Vamos, inténtalo. Pasa por el campo de entrenamiento lo más rápido que puedas <color=#00E1FFFF>sin romper ninguna vasija</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Veamos cómo te va, a ver si puedes superarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Vaya, ¿me estás invitando a comer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "No me refería a eso... Pero si tienes mucha hambre, tengo algo de carne asada en mi bolsa... En fin, dejemos esto para luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
