			"dialogs": [
				{
					"id": 761420301,
					"content": "Oye, Chernov, ¿estás bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 761420302,
					"content": "Aún puedo sostener la espada... Capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Chernov"
				},
				{
					"id": 761420303,
					"content": "Shonokóvich, Filaev... ¿Están bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 761420304,
					"content": "Arg... Creo que me rompí la pierna, pero por suerte sigo vivo. ¿Llevas la cuenta? ¿A cuántos maté?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Shonokóvich"
				},
				{
					"id": 761420305,
					"content": "¿C-cuántos monstruos hay? ¿Vamos a morir aquí, capitán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420306,
					"content": "¿Qué tonterías estás diciendo? ¡Por supuesto que saldremos de aquí sanos y salvos! No te preocupes, ¡seguro que el explorador ya avisó al viejo y que nuestros refuerzos ya están en camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 761420307,
					"content": "Ahí vienen otra vez. La Cacería salvaje no deja de aparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 761420308,
					"content": "Muy bien, tomen sus armas y lámparas. Nos espera una dura batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				}
			]
		},
