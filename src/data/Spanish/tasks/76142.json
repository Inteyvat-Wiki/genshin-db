			"dialogs": [
				{
					"id": 761420401,
					"content": "Filaev, no tengas miedo. Patoli y yo te sacaremos de aquí. ¡Mantén el ánimo y sostén tu espada como un verdadero Lamparero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 761420402,
					"content": "Yo... yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420403,
					"content": "¿Un plan? ¿Qué plan podría haber, Patoli? Si esto es el final, lucharé hasta el último momento aquí mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 761420404,
					"content": "Son el mejor escuadrón, y sea cual sea el resultado, ha sido un honor luchar a su lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 761420405,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420406
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420406,
					"content": "El honor es nuestro, capitán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420407,
					"content": "¡Vamos, prepárense para la defensa! ¡Que estos malditos sean testigos de la ira de los Corceles de la Ventisca!",
