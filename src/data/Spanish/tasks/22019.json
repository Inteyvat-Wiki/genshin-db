			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "Efectivamente, está enterrando lo que robó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190202,
					"content": "¡Pasemos a la acción!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "#Espera, viajer{F#a}{M#o}, aún no es el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190206,
					"content": "Un poco más... y... ahora sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190207,
					"content": "¡Eh, tú! ¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190208,
					"content": "¡Deja las cosas en el suelo y no te muevas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190209,
					"content": "¿C-cómo han...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190210,
					"content": "Malditos sean... Y ustedes, ¡no se queden ahí mirando! ¡Vamos! ¡Desháganse de estos tipos y marchémonos rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190211,
					"content": "Vaya un atrevido grupo de Ladrones de Tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190212,
					"content": "Andou, Amano, ¡ya estamos aquí para ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190213,
					"content": "Oh, ¡entonces son todo suyos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190214,
					"content": "#Viajer{F#a}{M#o}, ahora podemos pasar a la acción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190215,
					"content": "Cuántas molestias nos tuvimos que tomar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "La jefa dijo que había que hacerlo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190217,
					"content": "Bien, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190204,
					"content": "¿Vamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "Espera un poco, aún no es el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201903,
			"completionStepIds": [
				2201905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201905",
							"2"
						],
						"stepId": 2201905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "#Esta vez sí que lo atrapamos con todos sus objetos robados. Gracias, Ryuuji, y a ti también, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190302,
					"content": "Amano y yo nos llevaremos a estos Ladrones de Tesoros a la Comisión. El resto nos lo pueden dejar a nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190303,
					"content": "Qué buena es la detective Sango. Sabía perfectamente cómo encontrar a los ladrones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190304,
					"content": "Al fin y al cabo, es ella de quien estamos hablando. No se dejaría sobrepasar por un caso así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190305,
					"content": "Ryuuji, nosotros tenemos que volver a la Comisión. Cuando nos hayamos encargado de este tipo, nos pasaremos a saludar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190306,
					"content": "No se preocupen, y vayan con cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190307,
					"content": "#Viajer{F#a}{M#o}, vamos a informar a la jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201906",
							"2"
						],
						"stepId": 2201906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "Hola, jefa. Andou y Amano ya han llevado al ladrón a la Comisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190402,
					"content": "Oh, muy bien. Entonces el caso está resuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190403,
					"content": "#Viajer{F#a}{M#o}, tú también estás aquí. Hiciste muy buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190404,
					"content": "¿Ya se acabó todo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "Es normal que te sientas así. Después de todo, fueron Amano y Andou los que se llevaron al ladrón. Toma tu recompensa, tal vez así sí sientas que todo ha terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190407,
					"content": "¿Y a ti nadie te paga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "¿A mí? Ayudar a la Comisión a investigar el caso y conseguir que esta calle vuelva a la normalidad es mi mayor recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190412,
					"content": "Pero, sinceramente, siento que esta vez no he conseguido absolutamente nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190413,
					"content": "Ni he presenciado un nuevo método de cometer delitos ni he escuchado el razonamiento del delincuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190414,
					"content": "Tan solo se trataba de una forma de delinquir poco interesante y corriente. Menos mal que no invertimos mucho tiempo y esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190415,
					"content": "Detective Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "¿Qué ocurre? ¿Es la primera vez que ves a alguien tan interesado en el crimen como yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190419,
					"content": "Ese interés fue lo que hizo que me convirtiera en una detective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190420,
					"content": "¿Es que quieres cometer un delito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "#Elemental, querid{F#a}{M#o} viajer{F#a}{M#o}. Quiero cometer un delito perfecto, uno sin ningún fallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190422,
					"content": "Es una lástima que, en casi todos los crímenes, el delincuente siempre deja alguna huella. Eso hace que tarde o temprano se descubra la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190423,
					"content": "¿Y si el delito no lo ha cometido una persona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "¿Ves? Tú tampoco puedes evitar reflexionar sobre el crimen, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190427,
					"content": "#No es que te sientas intranquil{F#a}{M#o} por no saberlo, pero sí piensas en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190428,
					"content": "Yo también reflexiono mucho sobre el crimen. Por ejemplo, sobre los métodos para cometer delitos, las razones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190429,
					"content": "¿Por qué reflexionas sobre ello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Para mejorar mi método de investigación, claro está. Cada vez me llegan casos más complejos con los que hay que devanarse los sesos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190431,
					"content": "Pero ninguno puede llegar a considerarse un crimen perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190432,
					"content": "¿Alguna vez has visto un crimen perfecto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Sí, y hasta hoy en día aún no he averiguado quién es el culpable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190434,
					"content": "Pero estoy segura de que, si el crimen lo ha cometido una persona, habrá huellas. Es solo que... aún no las he encontrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190435,
					"content": "#Bueno, viajer{F#a}{M#o}, gracias por tu ayuda. Aquí tienes tu remuneración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190436,
					"content": "No te olvides de venir a saludarme cuando tengas tiempo. Y, si no lo tienes... bueno, no pasa nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190437,
					"content": "#Mi intuición me dice que volveremos a trabajar junt{F#as}{M#os} en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190424,
					"content": "¿Y si no existe un culpable?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "¿Qué tiene que hacer el delincuente para no dejar ninguna huella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Así que así son los detectives...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Tampoco se puede generalizar. En mi caso, es porque estoy muy interesada en el crimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190409,
					"content": "¿De verdad no quieres nada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Conseguí que se hiciera justicia. Aparte de eso, no necesito nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190411,
					"content": "Eso es lo que debería decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190405,
					"content": "No siento que el caso se haya cerrado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
