			"dialogs": [
				{
					"id": 220190601,
					"content": "Si salen ya, deberían poder atraparlo con todo el botín. Apresúrense, yo estaré esperando sus noticias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190602,
					"content": "#¿Eh? ¿Necesitas algo más, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190603,
					"content": "No pareces muy contenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Un caso poco interesante, un delincuente poco interesante y una técnica criminal que no es nada refinada, solo un poco astuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190605,
					"content": "Si tuviera que describir con una palabra este caso, sería “aburrido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190606,
					"content": "Pero en fin, después de todo, se sigue tratando de un caso que debemos resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190607,
					"content": "#¿Tú no vienes con nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Este caso está cerrado para mí. El resto se lo dejo a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190609,
					"content": "Además, con mi talento y mi forma física, sería un desastre si el delincuente me raptara y usara eso para extorsionarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190610,
					"content": "Me conozco muy bien, así que les dejo a ustedes la confrontación con ese tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		}
