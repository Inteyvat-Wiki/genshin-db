			"dialogs": [
				{
					"id": 150480801,
					"content": "Uff, el corazón me va a mil por hora... Creo que necesitaré un rato para recuperarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480802
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480802,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480803
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480803,
					"content": "¡Un aplauso para Bennett y el Asha! ¡Hacen un gran equipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480804,
					"content": "Especialmente la forma en la que trabajaron juntos al final. ¡Su vínculo tan especial marcó la diferencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480805,
					"content": "Juntos, pudieron derrotar a la mala suerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480807,
					"content": "#Te estoy muy agradecido, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480808,
					"content": "Si no hubieras creído en mí y no me hubieras ayudado a convencer al personal, nunca habría tenido la oportunidad de completar el reto, y mucho menos de afrontarlo junto al Asha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480809,
					"content": "Sr. Bennett, se ha completado la prueba final de seguridad, lo que significa que la Carrera del Asha ya está oficialmente lista para abrir. ¡Apreciamos mucho su ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480810,
					"content": "¿Has oído eso, Asha? ¡Lo conseguimos!",
