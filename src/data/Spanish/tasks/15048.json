						150480811
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480811,
					"content": "Recordaré siempre su nombre, Sr. Bennett, el valiente y bondadoso aventurero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480812,
					"content": "Aunque esta aventura aún no ha terminado, cada vez me cuesta más despedirme...",
