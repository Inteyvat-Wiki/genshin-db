						],
						"pointId": 11834
					}
				]
			},
			"dialogs": [
				{
					"id": 150480101,
					"content": "... No podemos dejar que asuma semejante riesgo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Pero eso no fue lo que dijo hace un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Lo siento mucho. Sé que no tenemos mucho tiempo, pero la seguridad de los visitantes es nuestra máxima prioridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "#{NICKNAME}, llegas justo a tiempo. Por favor, ¿puedes ayudarme a convencer a este caballero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Necesitan a alguien para probar la atracción. Conseguí demostrar mi experiencia de aventura y dejar claro que estaba dispuesto a aceptar cualquier riesgo. Todo iba tan bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Pero en cuanto oyó que había estado a punto de morir en el pasado varias veces, se negó completamente a que participara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Señor, aprecio mucho su entusiasmo, de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Pero si tiene tendencia a caerse a los ríos incluso cuando está cruzando por un puente de piedra, quizá sea mejor probar algo un poco más... ¿relajado? Por ejemplo, ¿qué tal si se tumba en una de esas tumbonas de playa de ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "*Suspira*, ¡p-pero es que soy un aventurero cualificado para la prueba! Es solo que... he tenido un poco de mala suerte en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "De verdad que quiero ayudar. Por favor, créame cuando le digo que puede confiar en mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "Doy fe de ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "#Bueno, si {F#la gran heroína salvadora}{M#el gran héroe salvador} de Natlan lo dice... ¿Qué le parece si su compañero Asha realiza la primera ronda de la prueba en su lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Puede observar desde un lado y familiarizarse con el recorrido. Si todo va bien, podrá unirse en la segunda ronda de la prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "¿Cómo lo ves, Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "¡Muy bien! ¡Cuento contigo, socio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Le aseguro que es de fiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
