						150480303
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480303,
					"content": "¡Bien hecho, Asha! ¡Me ha sorprendido lo atlético que eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480304
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480304,
					"content": "Ahora es el turno de Bennett, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480305,
					"content": "¡Sí! He hecho mi calentamiento y terminado mis estiramientos, así que estoy listo para la acción. ¡Confíen en mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480306,
					"content": "Ten cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480307
					]
				},
				{
					"id": 150480307,
					"content": "No te preocupes, lo tendré. ¡Gracias por preocuparte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
