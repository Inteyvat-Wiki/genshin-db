			"dialogs": [
				{
					"id": 150480601,
					"content": "Bien, solo un poco más. Mantén la calma ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480602,
					"content": "Espera, ¡¿qué?! ¿A dónde va la meta?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480603
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480603,
					"content": "Si es que... quién me manda hablar. ¿Puede que mi buena suerte se haya acabado?... No, no es momento de desanimarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480604,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480605
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480605,
					"content": "¡Claro!... ¡Siempre puedo seguir al Asha! Mientras sigamos conectados...",
					"roleType": "TALK_ROLE_NPC",
