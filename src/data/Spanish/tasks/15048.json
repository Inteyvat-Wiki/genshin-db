						150480404
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480404,
					"content": "¡Eres el mejor! Ahora tengo más confianza que antes. ¡Después de ti, entrenador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480405
