			"dialogs": [
				{
					"id": 210030111,
					"content": "*Suspira*, si tan solo enviaran a más personas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210030112,
					"content": "Yo mismo iría a despejar el área, pero me preocupa que si dejo mi puesto, los monstruos aprovecharán para acechar a los viajeros, así que en eso he pasado el tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210030113,
					"content": "¿Podrías ayudarme y deshacerte de esos monstruos? Me daría tiempo para resolver otros problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chiaoxi"
				}
			]
		},
		{
