			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "¿Qué debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033002,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "¿Quién eres? Todo el que pase por el puente debe ser examinado. Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033004,
					"content": "Por tus ropas excéntricas, estoy seguro de que no eres una mala persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033005,
					"content": "Verás, un maleante se vestiría de una forma más discreta, ¿no crees? No usaría ropa tan llamativa como la tuya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033015,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033006,
					"content": "Soy miembro de la Geoarmada, y estoy a cargo de esta zona. Este es el paso del Pantano Dihua, por lo que todo el mundo pasa por aquí, ya sean comerciantes o viajeros, así que me enviaron a vigilar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033007,
					"content": "El otro día descubrí que había unos monstruos al lado... Al parecer, ese grupo de monstruos estaban haciendo un campamento. Aunque no ha habido mucha actividad hasta ahora, tengo que echarles el ojo por cuestiones de seguridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033008,
					"content": "Yo mismo iría a despejar el área... Pero me preocupa que si dejo mi puesto, los monstruos aprovecharán para acechar a los viajeros, así que en eso he pasado el tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033009,
					"content": "Ya me deshice de esos monstruos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "¿Ya acabaste con ellos? ¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033011,
					"content": "Buen trabajo. De verdad lo siento. Se supone que es mi trabajo... Perdón por las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033012,
					"content": "*Suspira*, no sé qué piensan mis superiores. Siempre estoy solo, nunca envían a nadie más. ¿Cómo puedo hacerme cargo de todo esto yo solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033013,
					"content": "Cuando tenga una oportunidad, iré a reportarles la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210033014,
					"content": "Gracias. Toma, como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chiaoxi"
				}
			]
		},
