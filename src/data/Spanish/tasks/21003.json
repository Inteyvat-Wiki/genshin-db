				{
					"id": 210039903,
					"content": "Buen trabajo. De verdad lo siento. Se supone que es mi trabajo... Perdón por las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039904
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210039904,
					"content": "#Tampoco tienes que disimularlo. Estás completamente cubiert{F#a}{M#o} de polvo, seguramente esos monstruos te dieron pelea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039905
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210039905,
					"content": "*Suspira*, no sé qué piensan mis superiores. Siempre estoy solo, nunca envían a nadie más. ¿Cómo puedo hacerme cargo de todo esto yo solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039906
					],
					"speakerTitle": "Chiaoxi"
				},
				{
					"id": 210039906,
					"content": "Puede que solo sean dos puentes, pero mucha gente pasa por aquí todos los días. Si llegara a ocurrir un problema, sería un caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039907
					],
					"speakerTitle": "Chiaoxi"
				},
				{
