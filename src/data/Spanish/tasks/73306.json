			"trigger": {
				"objectNames": [
					"Tirzad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "... Oh, son ustedes. ¿Hay algo más que quieran discutir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Hablemos sobre Yebrael.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "... Dudé de él hasta el último momento. Soy despreciable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Ahora, solo puedo sentir gratitud hacia él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Siempre he sido muy indeciso, tanto en temas académicos como en mi vida. Pero se acabó. A partir de ahora, avanzaré con determinación por el camino que me marque, sin importar cuán difícil sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Es lo menos que puedo hacer para honrar su memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Hablemos sobre el Rey Deshret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "Estoy empezando a dudar de la veracidad de todos los artículos que leí hasta ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "Esa letanía... Me da una sensación extraña que no puedo identificar. Y luego está lo que dijo Samail... Tengo que estudiarlo a fondo cuando regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Por supuesto, mi tarea principal sigue siendo escribir mi tesis, tal como tenía planeado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Hablemos sobre Yeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "Ay... Me gustaría poder hacer algo por ella, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "No puedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "Y además, ella se niega a decir nada. Haría todo lo que estuviera en mi mano para ayudarla con cualquier cosa que pidiera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
