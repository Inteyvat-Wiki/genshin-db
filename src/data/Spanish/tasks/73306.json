					"Yeht",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Lo siento... Sigo sin poder controlar bien mis emociones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 730552602,
					"content": "No te disculpes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Eso... Todos sabemos que estás pasando por un momento muy difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730552604,
					"content": "Gracias... Espero que todo les vaya bien en sus viajes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 730552605,
					"content": "Oh... Paimon también espera que todo te vaya bien, Yeht... ¡Seguro que sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
