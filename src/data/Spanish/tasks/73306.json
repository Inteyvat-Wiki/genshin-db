				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "¿Dónde se habrán metido Omid y Mirsad? No me digas que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Están bien, solo es que... tienen sus propios planes y no seguirán en esto de las bestias de carga con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "¿Cómo? Nosotros dos no somos bastantes para encargarnos de todo. ¿Y ahora tenemos que contratar a más gente? Pero si casi nadie quiere venir a la Aldea Aaru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Olvídalo, mejor lo discutimos en otra ocasión. Al menos Cyrus ha vuelto sano y salvo. La próxima vez no dejaré que vaya a un lugar tan peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "¿Pero qué estás diciendo? Somos arrieros, ¿qué vamos a comer si nuestros animales no trabajan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "No podemos alimentarnos a base de aire. Y además, prueba a abrir la boca aquí, y lo único que te entrará será un buen puñado de arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Pero no podemos dejar que Cyrus corra peligro. Veo que tú estás bastante fuerte, ¿qué tal si llevas tú la mercancía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552708,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nachtigal"
				}
			]
		}
	]
