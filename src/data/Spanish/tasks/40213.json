			},
			"dialogs": [
				{
					"id": 402130101,
					"content": "¡Lo siento mucho! No puedo creer que se haya producido semejante negligencia... Permitir que forasteros ocuparan las instalaciones de la Oficina de Diseño... Me encargaré de investigarlo a fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130102
					],
					"speakerTitle": "Práporshchik"
				},
				{
					"id": 402130102,
					"content": "No hace falta que investigues nada. Reúne a tu equipo y retomen el control de esta instalación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130103
					],
					"speakerTitle": "Capitán porúchik"
				},
				{
					"id": 402130103,
					"content": "¿Que no hace falta...? ¿Es una orden de arriba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130104
					],
					"speakerTitle": "Práporshchik"
				},
				{
					"id": 402130104,
					"content": "He dicho que no hace falta. ¿Está claro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130105
					],
					"speakerTitle": "Capitán porúchik"
				},
				{
					"id": 402130105,
					"content": "¡Entendido, capitán porúchik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130106
					],
					"speakerTitle": "Práporshchik"
				},
				{
					"id": 402130106,
					"content": "¿Eh? ¿Cuándo llegaron ustedes aquí? Esta instalación pertenece a la Oficina de Diseño Experimental Kuuvahki. Si no trabajan aquí, retírense de inmediato.",
					"roleType": "TALK_ROLE_NPC",
