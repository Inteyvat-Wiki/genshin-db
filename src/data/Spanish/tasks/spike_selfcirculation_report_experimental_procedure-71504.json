				"points": []
			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#Oh, {NICKNAME}, llegas justo a tiempo. Acabamos de terminar los preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040202,
					"content": "Supongo que ese tipo de Sumeru ya te explicó cómo se usa el globo de aire caliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040203,
					"content": "¿A quién llamas “ese tipo de Sumeru”? Hosseini está aquí para ayudarnos con el fango oscuro. Es un erudito de Sumeru, ¡ten un poco más de respeto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040204,
					"content": "¡Oye, tú! Era una forma cariñosa de llamarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040205,
					"content": "Bueno. El globo ya puede usarse y el dispositivo para disipar el fango oscuro ya está listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}, si necesitas ayuda de la superestrella minera... *Ejem*... Olvídalo, no soy de mucha ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040207,
					"content": "Está bien que lo hayas comprendido por fin. Será mejor que descanses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040208,
					"content": "*Suspira*... Bueno, si quieres que comience a moverse, tan solo tienes que activar el globo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tu"
				}
			]
		},
