			"dialogs": [
				{
					"id": 730091301,
					"content": "#Que Araja pueda celebrar Festival Utsava es gracias a nara {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "A Araja le da lástima no poder ir de aventuras con ustedes, como Arama y demás, y tampoco poder ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "#Pero siempre serán bienvenid{F#as}{M#os} a este sueño. Si se cansan de mundo exterior, vengan a Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
