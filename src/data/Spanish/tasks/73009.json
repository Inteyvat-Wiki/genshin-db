					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091103,
					"content": "#Araja recuerda cómo aranara de esa época extrañaban {F#a él}{M#a ella} y amaban sus historias. Pero ahora que nara {NICKNAME} nos acompaña...",
					"roleType": "TALK_ROLE_NPC",
