				{
					"id": 730091501,
					"content": "Cuéntame más acerca del fruto vasoma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091502
					]
				},
				{
					"id": 730091502,
					"content": "Es fruto lleno de energía. Crece con recuerdos y sueños de tierra, y solo da fruto si aranara y nara trabajan juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091503
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091503,
					"content": "Podrán obtener fruto bija después de ofrecer frutos vasoma a Árbol Ashvattha. Es árbol enorme que plantó Rukkhadevata misma. Es origen de aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
