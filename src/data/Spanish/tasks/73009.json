			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana cuidará de ella. Es amiga a quien más quiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, ve a Vanarana y canta «Melodía de gran sueño». Luego pide que consigan fruto bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "No entendí absolutamente nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Igual que nubes entienden que tienen que dejar caer gotas de lluvia, y agua de lluvia entiende que tiene que caer sobre tierra. Semillas también entienden que deben brotar y crecer hasta convertirse en gran árbol que dará muchos frutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "D-de acuerdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, parece que no entiendes, pero no importa. Sabrás qué hacer cuando sea momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
