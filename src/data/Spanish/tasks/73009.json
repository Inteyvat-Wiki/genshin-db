				},
				{
					"id": 730091102,
					"content": "#Es lo que dejó nara Váruna. Era nara rubi{F#o}{M#a}, valiente y honest{F#o}{M#a}, igual que tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
