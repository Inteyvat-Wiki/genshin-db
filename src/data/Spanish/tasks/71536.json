			"dialogs": [
				{
					"id": 715360301,
					"content": "#Oh... Esta tarjeta de felicitación es muy bonita. Gracias, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360302,
					"content": "Después haré unas cuantas más como me has ensañado para los demás habitantes de la aldea. Seguro que se pondrán muy contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Candace"
				},
				{
