			},
			"dialogs": [
				{
					"id": 715360101,
					"content": "#¡{NICKNAME}, feliz Rito de la Linterna! Me contaron que ayudaste a Dehya a crear su felicitación. Es muy bonita, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "¿Ya terminaste lo que tenías que hacer en la aldea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Gracias a Dehya y los demás, ahora hay gente custodiando la aldea y puedo quedarme tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Intenta descansar mucho estos días.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Sí, lo haré. Dehya mencionó que quería visitar la Aldea Chiaoying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Dice que el paisaje de allí es hermoso y que tienen un té muy bueno. Podríamos llevarnos un poco para regalárselo a la gente de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Por eso quería seguir la tradición de Liyue y escribir algunas felicitaciones para acompañar los regalos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Pero Dehya se ha encargado de que no tengamos ni un solo hueco en la agenda, así que no voy muy bien de tiempo para prepararlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "Dehya me contó que se te da muy bien hacer felicitaciones... ¿Podrías echarme una mano con una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Claro, déjalo en mis manos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
