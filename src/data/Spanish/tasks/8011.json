				"points": []
			},
			"dialogs": [
				{
					"id": 80110501,
					"content": "Creo... que hemos llegado al final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110502
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110502,
					"content": "¡¿Qué es esa cosa?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(Amarrada con cadenas, pendiendo de la nada, con este aire tan siniestro... ¡Tal y como la estatua profanada que vimos en aquel entonces!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110504
					]
				},
				{
					"id": 80110504,
					"content": "(Conque guarda relación con la Orden del Abismo... Y estos Hilichurls también me recuerdan mucho a aquel Ladrón de Tesoros...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110505
					]
				},
				{
					"id": 80110505,
					"content": "Eide, este sitio me da mala espina. ¡Vámonos de aquí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "¿Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "Oh, preciado ser, ¿a qué viene tan intensa veneración? ¿Acaso es por miedo a lo desconocido? ¿O es poder lo que ansías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Sintetizar"
				},
				{
					"id": 80110509,
					"content": "(¿De quién es esa voz? ¿Viene de mi mente? ¿Y Eide no puede escucharla?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "Oh, preciado ser, ¿por qué te inclinas ante mí? Yo no soy un dios. Yo... no soy más que un pecador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Sintetizar"
				},
				{
					"id": 80110511,
					"content": "(Un pecador...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "Eres como una flor nacida del pecado que aún conserva su pureza... Conozco muy bien tu destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Sintetizar"
				},
				{
					"id": 80110513,
					"content": "Ya no tendrás que reprimir tu resentimiento, ya no tendrás que soportar todas esas mentiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Sintetizar"
				},
				{
					"id": 80110514,
					"content": "Adelante, trasciende. Ve más allá del destino que te fue concedido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Sintetizar"
				},
				{
					"id": 80110515,
					"content": "Y yo derramaré una lágrima cuando llegue el fin del tiempo... cuando contemple tu vida pasada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Sintetizar"
				},
				{
					"id": 80110516,
					"content": "(¿Quién eres? ¿Qué quieres decirme con todo esto?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Sintetizar"
				},
				{
					"id": 80110518,
					"content": "(La voz... desapareció...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "¡!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "... ¿Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "*Puff*... ¿Qué es lo que acaba de pasar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "En el instante en que vi esa cosa, mi mente se tranquilizó y me envolvió un sentimiento de veneración... o quizás de felicidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "¿Te encuentras bien ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "Sí, estoy bien. De hecho... me siento mucho mejor que antes de haber venido aquí. Qué raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Pasa algo raro en este sitio. Tenemos que irnos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Oh, ¿t-tú crees? Está bien, como tú digas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "Se marchan de la escalofriante cueva y regresan a casa de Eide.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 801106,
			"completionStepIds": [
				801111,
				801112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801111",
							"2"
						],
						"stepId": 801111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "¡Cariberto! Oh, menos mal... Todo sigue bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "¿Ya no es necesario orar ante la Estatua de Los Siete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "T-tengo la extraña sensación de que lo que acaba de pasar estaba predestinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "Todo esto ha sucedido cuando lo último que quería era postrarme ante la estatua de un dios. Es como si algo me hubiera llevado a hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "Dices que yo me postré ante esa cosa, ¿no será que... surte el mismo efecto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "Eso no tiene mucho sentido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "Tengo que intentarlo, cueste lo que cueste... Tú también lo dijiste, tenemos que intentarlo por todos los medios posibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Administran otra dosis de medicina al Hilichurl...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "¿Cariberto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110613,
					"content": "¿Pa... papá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110614,
					"content": "¡Ah! ¡Cariberto! Por los cielos, ¡no puedo creer que haya funcionado! Oh, Cariberto, hijo mío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "¿Quién lo habría imaginado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "¡¿Lo ves?! ¡Funcionó! ¡Cariberto recuperó el habla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "¿Dónde... está mamá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110619,
					"content": "Mamá... Cariberto, antes que nada, mírame. ¿Sabes quién soy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Sí... Eres mi papá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110621,
					"content": "Jaja, ¡sí! Jajajaja... Salvación, bendita salvación... Así que así es como se siente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "¿Cómo te encuentras, Cariberto? ¿Te has espabilado ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Sí... Siento como si hubiera dormido durante mucho tiempo. En mi sueño, me había escondido en una pequeña habitación. No me atrevía a salir, pero tampoco quería hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110624,
					"content": "Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110625,
					"content": "¡Mi cuerpo! ¿Qué me ha pasado? Este... ¿Este soy yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110626,
					"content": "Papá... ¡¿Qué me ha pasado?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "No temas, hijo mío. Es solo que... mientras dormías, nos adentramos en un mundo de fantasía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "En este mundo ya no existe nuestro hogar, Khaenri'ah, pero precisamente por eso tampoco existen ni un cielo rojo ni catástrofes apocalípticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "En este mundo, vivirás siendo un pequeño monstruito... pero estarás con tu papá para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "¿Estoy... muerto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110632,
					"content": "No, no, para nada. Mira, Cariberto, todavía tienes el pañuelo de tu madre atado al brazo. Eso es que ella sigue cuidando de ti y protegiéndote, así que ¿cómo vas a haber muerto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110634,
					"content": "¡Claro! Acabas de despertarte, así que esto debe de ser muy confuso para ti. Descansa aquí por ahora... Todo irá bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "Oh, y... tienes que prometerme una cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "Nunca te quites la máscara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "¿Me has entendido? Pase lo que pase, nunca te quites la máscara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "De acuerdo, papá... No me la quitaré, lo prometo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Cariberto"
				},
				{
					"id": 80110639,
					"content": "Padre e hijo hablan largo y tendido. Eide es un hombre nuevo después de esta experiencia.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "Desde aquel día, nunca antes me había sentido tan dichoso como ahora. No puedo creer que esto esté sucediendo de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Humm, sabía que nunca debería haber esperado nada de la Estatua de Los Siete. Hasta me postré ante ella... Nunca antes en mi vida me he sentido tan avergonzado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Un asesino siempre será un asesino... Qué iluso fui al creer que aquellos que conspiraron en nuestra contra querrían salvarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "En cambio, el dios que vimos en la cueva... ¡Ese sí que era un auténtico dios! No como Los Siete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "Ese misterioso poder era tan cautivador... ¡Seguro que ese fue el motivo por el que acabé arrodillándome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Humm, entonces... Si tras haberle pedido un deseo a un dios, ese deseo acaba cumpliéndose... se supone que tengo que... ¿rendirle culto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "No soy un entendido en este tema, pero... creo que tengo que venerar al dios que escuchó mis plegarias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "Pero ese no era un dios, Eide... Era un pecador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "¿Un pecador? Vamos, no digas tonterías. No sabes nada sobre ese dios, ¿cómo te atreves a blasfemar de esa manera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "Tú también presenciaste su poder divino. ¿Acaso Los Siete podrían hacer algo así? ¡Él debe de ser un dios más poderoso que ellos! ¿Y tú lo llamas “pecador”? ¡Qué absurdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "Da igual... Piensa lo que quieras, no doblegarás mi fe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "Iré a venerarlo, ya sea contigo o sin ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110655,
					"content": "No tienes remedio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
					"content": "(Esta experiencia ha afectado mucho a Eide... Puede que antes fuera un tanto inestable, pero esta devoción tan ferviente y repentina...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110658
					]
				},
				{
					"id": 80110658,
					"content": "(En fin, tendré que ir con él de todas formas. Recuerdo que había muchos monstruos por la zona, no puedo permitir que le hagan nada a Eide...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110656,
					"content": "Bien, hazlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110650,
					"content": "Era un pecador, no un dios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110642,
					"content": "Es sin duda increíble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110616,
					"content": "Ver para creer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110608,
					"content": "Si eso es lo que piensas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
