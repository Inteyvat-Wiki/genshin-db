			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110101,
					"content": "Ese... no es Cariberto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110102,
					"content": "No, ese no es...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "Cierto, Cariberto lleva un pañuelo. Fue un regalo que le hice a su madre. Ahora lo uso para distinguirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110105,
					"content": "Me está fallando la vista... ¿Cómo es posible que no haya reconocido a mi propio hijo? Uf, mi cuerpo ya no puede más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110106,
					"content": "Pero ese Hilichurl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "Sí... No parece muy interesado en nosotros, y su único propósito es caminar en esa dirección. ¿Qué habrá por allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110109,
					"content": "No lo sé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "... Cuanto más sepamos sobre los Hilichurls, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110110,
					"content": "Tendremos que averiguarlo nosotros mismos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "¿No crees que ese Hilichurl es un poco raro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "No lleva un pañuelo de seda en el brazo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801104",
							"2"
						],
						"stepId": 801104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "Qué lugar tan siniestro... ¿Siempre ha estado aquí? Nunca lo había visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "Mira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "Oh. Parece que están... adorando algo. Caminan y se arrodillan para postrarse ante algo. Da la impresión de que sienten verdadera devoción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "Nunca he visto nada parecido... ¿Qué rayos esconde este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "Solo hay una forma de averiguarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(El aire que se respira aquí... Este sitio tan espeluznante... ¿No será...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "¿Qué están haciendo esos Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
		{
			"id": 801103,
			"completionStepIds": [
				801106,
				801118,
				801119
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
