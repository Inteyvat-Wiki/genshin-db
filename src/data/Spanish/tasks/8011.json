			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "Alto, humanos. No tienen permiso para entrar aquí a investigar el destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Emisario del destino"
				},
				{
					"id": 80110302,
					"content": "(¿Un Emisario del Abismo? No puede ser... Nunca he visto a uno como este en la Orden del Abismo.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "¿Qué ocurre? ¿Acaso insisten en solicitar una audiencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Emisario del destino"
				},
				{
					"id": 80110304,
					"content": "... Como quieran. Los someteré a la prueba del destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emisario del destino"
				}
			]
		},
		{
			"id": 801104,
			"completionStepIds": [
				801108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801108",
							"2"
						],
						"stepId": 801108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110401,
					"content": "¿Quién era ese? Era... era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110402,
					"content": "... ¿Aterrador?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "Era un ser prácticamente perfecto. Me he quedado sin palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110405,
					"content": "... ¿Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "Tenía un aire misterioso y una energía peligrosa, pero elegante al mismo tiempo. Era verdaderamente cautivador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110407,
					"content": "Pero tú fuiste capaz de derrotarlo. Eres más fuerte de lo que había imaginado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110408,
					"content": "Tienes unos gustos muy particulares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Sigamos. A cada segundo que pasa, más curiosidad tengo y más emocionado estoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110409,
					"content": "Es solo que tengo experiencia peleando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "Ya me he encontrado con tipos como ese.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
		{
			"id": 801105,
			"completionStepIds": [
				801110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
