					],
					"speakerTitle": "Pápar"
				},
				{
					"id": 752510102,
					"content": "¡Guau! ¿Quién eres? ¿Cómo te has caído del árbol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510103,
					"content": "Soy Pápar, Hayne. ¿No dijimos que tomaríamos otra ronda? Hoy nos conoceremos como hermanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510104
					],
					"speakerTitle": "Pápar"
				},
				{
					"id": 752510104,
					"content": "Humm... ¿Eh?...",
