						752510105
					],
					"speakerTitle": "Pápar"
				},
				{
					"id": 752510105,
					"content": "¿Eh?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752510106
					]
				},
				{
					"id": 752510106,
					"content": "Hayne, ¿cómo es que te has convertido en dos personas? Una de ellas es alta, y la otra es bajita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510107
					],
					"speakerTitle": "Pápar"
				},
				{
					"id": 752510107,
					"content": "¡Oye! ¡Te estás confundiendo de persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510108,
					"content": "¿Eh? Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510109
					],
					"speakerTitle": "Pápar"
				},
				{
					"id": 752510109,
					"content": "¡Hayne! ¿Dónde estás? ¡Sigamos bebiendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510110
					],
					"speakerTitle": "Pápar"
				},
				{
					"id": 752510110,
					"content": "El borracho que cayó del árbol se marcha tambaleándose.",
