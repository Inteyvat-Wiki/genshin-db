					}
				]
			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "Queremos hablar contigo, Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "¿Has tomado ya una decisión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "Antes de eso, tengo conocimientos médicos, y me preguntaba si podría echarle un vistazo a tu abuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380204,
					"content": "No veo por qué no, aunque tenemos nuestros propios médicos, así que dudo que puedas decirnos algo que no sepamos ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "Necesitamos saber cómo está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380206,
					"content": "Síganme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "Bajen la voz, no lo molesten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tignari saca su equipo médico y realiza un examen médico básico a Bamún.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380210,
					"content": "Hablemos fuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380211,
					"content": "Bamún ha entrado en un coma profundo. Su situación es grave, aunque estoy seguro de que sus médicos ya han llegado a esa conclusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380212,
					"content": "Parece que sufrió una grave lesión en su juventud que se ha ido acentuando con los años de trabajo y la edad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380213,
					"content": "Lamentablemente, debo informarte de que he visto a otros pacientes en su misma condición y... no le queda mucho, unos días a lo sumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380214,
					"content": "... Ya lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "Tú eres su sucesor, ¿no es así? Se nota que sientes mucho respeto por él, pero su forma de pensar es completamente distinta. Tú tienes más preocupaciones, y tu enfoque es más realista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "Dime cuáles son tus condiciones y acabemos con esto mientras Bamún aún pueda presenciarlo. Sé que es algo que te importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "Sí, no hay tiempo que perder. Lo sabes mejor que nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "En realidad, ustedes dos se encuentran en situaciones muy similares. Cada uno tiene una opinión distinta de la persona que lo crio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380220,
					"content": "Sí, y además se trata de un conflicto de otra generación, pero son ustedes quienes tienen que tomar las decisiones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "Tienes razón. Ambos vemos este problema de forma muy distinta a la de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "Estoy de acuerdo, Cyno. Todo esto empezó con Hermanubis, así que pongámosle fin con una ceremonia que él mismo creó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "Cuenta la leyenda que Hermanubis luchó contra alguien cuando llegó a Tulaytulah. Él y sus dos compañeros lucharon durante varios días consecutivos, ganándose el corazón de la gente y reclutando a una gran cantidad de ambiciosos guerreros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "Aquel grupo de entusiastas se convirtieron más adelante en los primeros miembros del Templo del Silencio, mientras que aquella ceremonia se erigió como nuestro rito fundacional: el Rito del Duelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "Tiene mucho sentido. Me parece bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "Como recipiente de Hermanubis, tus lazos con el Templo del Silencio son profundos, así que te permitiré participar en este rito, junto con tus compañeros elegidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "Tres contra tres. Me parece bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380228,
					"content": "Sin embargo, tengo algunas condiciones. Como atacantes, deben ganar tres combates seguidos para ganar. Además, Cyno, tú y yo apostaremos nuestros fragmentos del Ba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "Dejar que Ciro se marchara con un fragmento del Ba fue un error que el abuelo cometió por compasión. Es un asunto controvertido que el Templo del Silencio debe abordar. No puedo hacer concesiones en este punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "No será necesario. Ambos pensamos igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "Si gano yo, el Templo del Silencio liberará a Ciro y dará por zanjada su disputa del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "Si ganas tú, te devolveré el poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "Trato hecho. Nos vemos mañana a las ocho de la noche en la sala ceremonial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
