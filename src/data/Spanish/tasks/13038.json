			},
			"dialogs": [
				{
					"id": 130380601,
					"content": "Llegados a este punto, no hay marcha atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380602,
					"content": "Nunca la ha habido. Desde el momento en el que el profesor se marchó, dar marcha atrás nunca ha sido una opción para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Tienes que ganar. Ya sea como Gran Juez o por ti mismo, necesitas ese poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380604,
					"content": "¡Sí! Y además, ¡este poder te ha acompañado durante tanto tiempo que seguro que ya te reconoce como su dueño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "Ya sea como Gran Juez o por mí mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "Sí, ahora que lo pienso... He tenido que superar muchas dificultades para controlar este poder y hacerlo mío. No todo el mundo podría haberlo hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "¡Eso, eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "No le des muchas vueltas. ¡Concéntrate en ganar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#Sí, {NICKNAME} y yo nunca perderemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tignari"
				},
				{
					"id": 130380611,
					"content": "Lo mismo digo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "El desierto fue el hogar de una antigua y gran civilización que, por diversas razones, se enemistó con la civilización de la selva. Como dijo Dehya, los prejuicios separan a la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Pero también deben haber factores personales. Siempre he creído que a Bamún le importan muchas más cosas de las que aparenta, y no creo que Sethos sea ningún villano. Tan solo hace lo que cree que es mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "... Mañana se decidirá todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Nosotros también te ayudaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
