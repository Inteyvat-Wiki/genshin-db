			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "Oh, ya están aquí. No hace falta pedir, ya lo hice yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "Los Tres Cuencos no es para los débiles, como las tabernas de Mondstadt. Aquí, el propietario se negará a servirte nada si pides cosas tan ridículas como un jugo de fruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Entonces, ¿por fin me invitará a beber algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "Te he pedido bolas de arroz glutinoso fermentadas en vino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "Ay... Debí esperarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "Si desean escuchar, queridos clientes, seguiré hablando de la historia de la Cámara de Jade de Ninguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 10160107,
					"content": "¡Guau! Aquí hay hasta cuentacuentos. ¡Qué ambiente tan bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "Este lugar es bien apreciado por sus excelentes vinos, así como su buen ambiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "Pero con “ambiente” me refiero a uno muy distinto del que se usa en la «Guía de viaje de Teyvat» para juzgar las tabernas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Como todos sabrán, por encima de Liyue hay un pabellón sobre las nubes, un palacio entre la niebla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 10160111,
					"content": "¿Saben qué significa “tener ojos que todo lo ven”? Esto, amigos míos: la obra maestra de la gran Ninguang, que une el Cielo y la Tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 10160112,
					"content": "Imaginen mirar hacia abajo desde la cubierta del palacio en un día con el clima despejado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 10160113,
					"content": "¡Admiren las gloriosas vistas de Liyue, que se extiende a lo largo y ancho de la tierra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 10160201,
					"content": "Estos no son más que unos trozos de papel y, sin embargo, sirven de guía para las decisiones de Ninguang. Tal es su valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 10160202,
					"content": "Agarrar uno o dos pedazos te dará un fragmento de su sabiduría, lo suficiente como para estar un paso o dos por delante de tus compañeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 10160203,
					"content": "Ninguang, el Equilibrio Celestial... Últimamente escucho mucho ese nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "Todo el mundo habla de ella en Liyue, los Fatui la odian, es posible que esté ocultando la Exuvia, y la vimos en el Rito del Descenso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Me pregunto qué clase de persona será.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "Por fin te encuentro, persona que regresa del Desfiladero Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "¿Quién anda ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "¡Paimon, corre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Esperen. No soy de la Geoarmada, ni tampoco vengo a reclamarles ningún botín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "Soy una emisaria de las Siete Estrellas de Liyue. Mi nombre es Ganyu, la secretaria del Pabellón Yuehai. Vine hasta aquí específicamente para verlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "¿Una emisaria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "Para ser exactos, soy la secretaria corporativa de las Siete Estrellas. Pero ahora mismo vengo en calidad de emisaria especial de la señorita Ninguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "¿Eres una enviada de Ninguang? Justamente estábamos hablando de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "Mis disculpas, ustedes que han regresado del Desfiladero Jueyun... Ahora mismo estoy muy ocupada y no puedo extenderles mi cortesía por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Pero les traigo una carta de la mismísima Ninguang, que les hace una invitación en calidad del Equilibrio Celestial de las Siete Estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Les invita a ese mismo palacio sobre el cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "¿Una carta de invitación, dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "Sí. Ninguang dijo esto exactamente:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "#“Invita a {NICKNAME} a que venga”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "#“Quiero conocerl{F#a}{M#o}”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "#“Cuando estemos en la Cámara de Jade, cortaré con {F#ella}{M#él} cada uno de estos hilos oscuros entrelazados”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "¿Secretaria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
