			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "Y así desapareció la emisaria que se hacía llamar Ganyu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161002,
					"content": "Pero hemos recibido una invitación de las Siete Estrellas de Liyue. ¡Paimon todavía no lo puede creer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161003,
					"content": "#¡{NICKNAME}, nos encontraremos con personas que tienen mucho dinero! ¡Tenemos que comportarnos excelentemente frente a ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161004,
					"content": "Yo siempre me comporto bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "Jaja... Ciertamente, una invitación a visitar la Cámara de Jade es un honor muy poco común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161007,
					"content": "Será mejor que vayan ahora mismo. Pero no olviden el Rito del Ascenso. Una vez que hayan concluido sus asuntos en la Cámara de Jade, encuéntrense conmigo en el Pantano Dihua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161008,
					"content": "¡No te preocupes, no lo olvidaremos! ¡Nos vemos en el Pantano Dihua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161005,
					"content": "Paimon, ¿estás tramando algo otra vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}