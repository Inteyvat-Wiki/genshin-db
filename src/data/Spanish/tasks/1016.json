			"dialogs": [
				{
					"id": 10160301,
					"content": "Ninguang... Ganyu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160302,
					"content": "Me pregunto dónde las encontraremos en medio de todas estas mareas oscuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
