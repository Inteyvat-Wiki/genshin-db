			"dialogs": [
				{
					"id": 751950201,
					"content": "Por los Arcontes... ¿Acaba de aparecer un alma bondadosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "Estaba pensando en hacer que un Tatankasaurio se pasara por aquí para que me ayudara a destrozar las rocas de esta tierra baldía. Así, si apareciera algún monstruo, también podría ayudarme con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Y resulta que, antes de que pudiera hacer algo, alguien ya me había ayudado a resolver el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Ah, todas las mañanas me levanto para ponerle fertilizante al árbol frutal que hay enfrente de mi casa. Llevo toda una vida haciendo este tipo de buenas acciones, ¡y este es el premio que los Arcontes me han otorgado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "#¡Alma bondadosa, mensajer{F#a}{M#o} de los dioses! Yo, Dutta, agradezco tu magnanimidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "Lo cierto es que no tengo mucha cosa, así que solo puedo entregarte unos pocos Moras y algún trasto inútil. Acepta esto, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
}