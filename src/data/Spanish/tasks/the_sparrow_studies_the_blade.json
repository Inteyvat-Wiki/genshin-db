			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Chue'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010501,
					"content": "¡Volviste! ¿Pudiste hacer lo que te pedí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010502,
					"content": "Aquí las tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "#Oh, con estas bastará. Amig{F#a}{M#o}, muchas gracias. Acepta este pequeño regalo a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010504,
					"content": "¿Eh? ¿Para qué son todas estas flores chingxin? Oh, ¿te duele la cabeza de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chue'er"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Chue'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "Sí, son para su dolor de cabeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "#De haberlo sabido, habría ido por hierbas medicinales para ti. ¿Por qué se lo pediste a {F#una}{M#un} extrañ{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010603,
					"content": "#Además, no sabemos nada de {F#ella}{M#él} ni de sus antecedentes, ¿y si...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010604,
					"content": "#Chue'er, basta. Nos ha sido de gran ayuda. No puedes hablar así de {F#ella}{M#él}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Gracias una vez más. Por favor, toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Sí, tómalo y sigue con tu camino, ¡no quiero que mi compañero esté pasando frío cuando le duele la cabeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010607,
					"content": "Sun Yu, vamos a un lugar donde no haga viento. Te haré un té dulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chue'er"
				}
			]
		},
		{
			"id": 2270107,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Chue'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "En realidad, estas hierbas son para tu garganta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "#*Ejem*, amig{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010703,
					"content": "¿Me estás diciendo que soy débil? ¿Que basta con un soplo de viento para resfriarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010704,
					"content": "Bueno, por suerte podremos usar estas flores chingxin para el dolor de cabeza de mi compañero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010705,
					"content": "Chue'er, escucha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010706,
					"content": "Vamos, tenemos que resguardarnos del viento y ponerte en algún lugar donde puedas poner los pies en alto. Te prepararé un té dulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010707,
					"content": "En cuanto a ti... Toma esto y apártate de mi vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chue'er"
				}
			]
		},
