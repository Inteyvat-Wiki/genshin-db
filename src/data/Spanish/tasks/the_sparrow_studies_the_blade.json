			"dialogs": [
				{
					"id": 227010101,
					"content": "#Alto, amig{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010102,
					"content": "A juzgar por tu porte relajado y tu rapidez, ambos somos practicantes de las artes marciales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "¿Qué quieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "¡Oye, más respeto cuando hables con él! ¿Entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010203,
					"content": "No te preocupes. En realidad, fui yo quien comenzó la conversación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "¡Hum! Más vale que no sea otro de esos oportunistas que viene al Desfiladero Jueyun en busca de la guía de los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010205,
					"content": "#Está bien, no te preocupes. ¿Por qué no descansas mientras hablo con mi amig{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "Sun Yu, ¿es que hay algo que no te atreves a decirme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010207,
					"content": "Oh, no, no. Solo le voy a hablar de cosas sin importancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "¡Hum! Seguramente hablarás de nuevo sobre el Clan Guhua... Bien, si no quieres que te escuche, los dejaré a solas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Chue'er"
				},
				{
					"id": 227010209,
					"content": "#Amig{F#a}{M#o}, ven por aquí. Hablemos con más tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
