				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Este parece un buen lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "¿Qué está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "*Suspira*, se trata de ella... Es Chue'er, mi compañera. Mientras entrenamos, somos inseparables, como uña y carne. Sus habilidades están casi a la par que las mías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Vinimos hasta aquí en busca de la guía de los Adeptus, pero el viaje ha sido duro, y ella habla por los codos... Hace poco, tuvo un resfriado que la dejó con un dolor de garganta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Veo que eres fuerte. Por eso, te pido humildemente que subas a lo alto de esta montaña. Busca tres flores chingxin para que preparare una infusión de agua caliente con la que aliviar el dolor de garganta de Chue'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "#Amig{F#a}{M#o}, tienes mi agradecimiento. Chue'er es muy vivaz, y no me atrevo a dejarla sola mientras busco medicinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "¿Pero por qué lo haces a sus espaldas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Veo que te interesa el tema. Chue'er tiene un espíritu luchador y se niega a aceptar que, en ocasiones, podría estar en desventaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Si le hubiera contado mi idea de buscar medicina para curarla, se habría negado rotundamente. Por eso no me queda más remedio que hablarlo a sus espaldas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Además, no me atrevo a dejarla sola mientras estoy fuera. Así que ¿podrías ayudarme, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
