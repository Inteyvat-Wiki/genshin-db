			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "Ah, he escuchado que algunos platos de Mondstadt, como el pollo asado con miel, el pescado a la parrilla de Mondstadt, la tostada del pescador y la sopa de marisco, están deliciosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "En fin, consígueme el que más satisfecho me deje. ¡Gracias por tu ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "Si como eso, al menos mi estómago no gruñirá durante el resto del día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
