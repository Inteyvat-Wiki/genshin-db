						222000505
					]
				},
				{
					"id": 222000505,
					"content": "Escuché que el Chef Mao del Restaurante Wanmin sabe cómo hacer estofado de perca de lomo negro. Podrías preguntarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000506
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000506,
					"content": "En cuanto a la sopa de loto y huevo, creo que el Herborista Gui conoce la receta. Trabaja en la Farmacia Bubu de la Terraza Yujing. Podrías ir a preguntarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000507
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000507,
					"content": "He escuchado a un comerciante decir que los panqueques de El Buen Cazador saben muy bien y las raciones son muy generosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000508
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000508,
					"content": "Y en cuanto a la brocheta de champiñones y pollo, no debe ser difícil de hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000509
					],
					"speakerTitle": "Yicheng"
				},
				{
