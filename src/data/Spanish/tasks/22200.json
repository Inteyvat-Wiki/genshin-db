						222000705
					]
				},
				{
					"id": 222000705,
					"content": "Puedes consultar con el Chef Mao del Restaurante Wanmin cómo hacer pescado mandarín agridulce y pollo al chile Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000706
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000706,
					"content": "He oído a los comerciantes de Mondstadt decir que El Buen Cazador tiene un plato que llaman “guisado de temporada”. Me pregunto cómo sabrá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000707
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000707,
					"content": "El huevo frito de Teyvat debería ser fácil de hacer, o eso pienso yo *GRR*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000708
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000708,
					"content": "*GRR*... Ah, de solo nombrar estos platos ya me dio más hambre... *GRR*",
