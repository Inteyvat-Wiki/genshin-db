			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "¡Hola! *GRR*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "¿En qué te puedo ayud...? *GRR*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "¿Perdón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "*Suspira*, mi estómago suena así cada vez que tengo hambre. Gruñe tan fuerte que ni siquiera puedo escuchar el sonido de mi propia voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "*GRR* Fui a la Farmacia Bubu, pero el médico me dijo que no estaba enfermo, que solo tenía hambre, así que mi *GRR* no tiene cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "El médico me dijo que comiera hasta llenarme... pero mi apetito es *GRR* mucho más grande que el de la mayoría de la gente. Si siempre tuviera que comer hasta saciarme, me temo que me arruinaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi dice que si no me lleno con las comidas principales, debería comer alguna cosa después para llenar ese hueco. Si no, todo esto podría llegar a afectar a mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "Hay una larga lista de platos con los que podría “llenar ese hueco”, pero no sé cuál satisfaría mejor mi apetito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "#Viajer{F#a}{M#o}, tú siempre estás viajando por la naturaleza. Seguro que sabes qué alimentos sacian más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "¿Podrías ayudarme a elegir el plato más delicioso y saciante de mi lista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "¿Qué te gustaría comer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Oh, hay muchas cosas que quiero probar... Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
