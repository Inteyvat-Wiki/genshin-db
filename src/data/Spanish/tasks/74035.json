					}
				]
			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "Buenos días, Sr. Iaune. ¿En qué puedo ayudarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350402,
					"content": "Buenos días, Srta. Cornelia. ¿No tendrá por casualidad alguna tecla de sobra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "¿Disculpe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350404,
					"content": "Mi máquina de escribir ha perdido una tecla, así que necesito una de repuesto. Si no tiene ninguna, tal vez podrían financiar la compra de una nueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "¿Financiar el importe de una tecla? Bueno, en teoría, no debería haber ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350406,
					"content": "Firme aquí, por favor. Luego, escriba “Financiación del coste de una tecla por problemas relacionados con una máquina de escribir”. Luego, firme aquí otra vez con su nombre y departamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350407,
					"content": "Bien, ¿y podré recibir la tecla hoy mismo? La necesito para seguir trabajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Sr. Iaune, ¿alguna vez ha solicitado la financiación de material antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350409,
					"content": "Creo que el proceso no es exactamente como usted lo imagina. Para llevar a cabo una financiación de este tipo, primero tenemos que redactar los informes de costes mensuales y luego presentarlos ante la Oficina Cardenalicia para que lo aprueben a final de mes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350410,
					"content": "El proceso está directamente relacionado con el pago de salarios de toda la Oficina Administrativa. Si la cantidad a financiar supera unos límites, la Oficina Cardenalicia necesita la aprobación directa de su señoría Neuvillette antes de poder llevar a cabo la compra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350427,
					"content": "Los reembolsos solo pueden procesarse de manera oficial una vez que el proceso de auditoría ya ha concluido y los documentos han sido debidamente sellados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350411,
					"content": "Si su señoría Neuvillette tuviera alguna duda con respecto al proceso de financiación, el empleado que ha solicitado la orden de compra tendría que presentar un informe por escrito justificando dicha orden... Precisamente estamos preparando en estos momentos el primer lote de solicitudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350412,
					"content": "¿Quieres decir que el hecho de que yo quiera pedir que se me compre una nueva tecla podría llegar a necesitar la firma de su señoría Neuvillette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Así es. Y me temo que el total de las órdenes de compra de este mes es considerable a estas alturas. Es muy probable que su señoría Neuvillette tenga que revisar una a una las peticiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350414,
					"content": "¿Neuvillette? ¿Ese no es el juez supremo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Pero si solo quiere una tecla nueva... ¿Por qué tiene que firmar el juez ese? Es un poco exagerado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "¿No hay otra solución?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Eso mismo pienso yo. Se trata solo de una tecla, no creo que sea necesario molestar a su señoría Neuvillette con algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "Bueno, sí que hay otras formas. Humm... Podría comprar usted mismo la tecla y luego presentar una solicitud de reembolso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350420,
					"content": "Una vez que se han procesado todas las órdenes de compra y se han sufragado todos los gastos, se le devolverá directamente el coste del producto adquirido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350421,
					"content": "¡Perfecto! Pues eso haré. De todas formas, una tecla no puede valer tanto. Creo que puedo permitírmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Bien, entonces firme aquí, por favor. Y escriba “Solicitud de reeembolso del coste de una tecla por problemas relacionados con una máquina de escribir”. ¿Piensa adquirirla en la tienda de Estelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350423,
					"content": "Pues sí, ¿por?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Bien, entonces le llevaré la solicitud al Sr. Roialte para que la firme. Después, deberá llevársela a la Srta. Estelle para que verifique la orden de compra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350425,
					"content": "Pero usted no se preocupe por eso. Vaya a comprar su tecla, yo me encargo del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350426,
					"content": "#¡Muchas gracias, de verdad! Es usted la mejor, Srta. Cornelia. ¡Vamos, viajer{F#a}{M#o}, a por mi tecla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Tiene que haber otra forma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
