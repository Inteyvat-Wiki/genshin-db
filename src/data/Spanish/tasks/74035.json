					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "#Ah, viajer{F#a}{M#o}, ¿de visita otra vez? ¿Quieres un café?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350202,
					"content": "Pues ya que lo mencionas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "¡Eso! Paimon también tiene curiosidad. Pero la última vez se armó una buena trifulca, así que Paimon no se atrevió a sacar el tema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350243,
					"content": "Ya pensaba que iban a echarme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "¿Que por qué? Jajaja, no tienes que preocuparte por eso. Si los guardias te han dejado pasar, ¿quiénes somos nosotros para echarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350206,
					"content": "#Ahí tienes otro ejemplo más de lo que es delegar la responsabilidad. Encantado, viajer{F#a}{M#o}, me llamo Semaine. Es un verdadero placer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350207,
					"content": "#Encantad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Semaine trabajaba antes como secretario en el tribunal de justicia. Aunque fue trasladado a la Oficina Administrativa debido a ciertos... asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350210,
					"content": "Sus ideas nos han permitido solucionar problemas que hasta ahora no habíamos podido resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350211,
					"content": "No exageres, Roialte. Simplemente ha aplicado mi experiencia laboral pasada y utilizado el valor de ciertos aspectos para tratar temas relacionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350212,
					"content": "En la práctica, suelo toparme con asuntos inestimables en el trascurso de mi jornada laboral. En esos casos, la maestría en el campo de las relaciones humanas del Roialte siempre es de gran ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350213,
					"content": "¿Y eso qué significa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "Para que lo entiendas, Semaine es muy hábil a la hora de considerar todos los aspectos de un asunto y hace que todo el mundo se sienta valorado. Es de gran utilidad a la hora de equilibrar la balanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350215,
					"content": "Y si directamente resulta imposible equilibrar la balanza, siempre puedo inclinarla en una dirección o la otra con “el peso de la palabra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350216,
					"content": "El trabajo de Iaune no es nada fácil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "¡Eso! Parece que se vaya a desplomar en cualquier momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350219,
					"content": "Antes o después, todos pasamos por el mismo trago. Si ayudara a Iaune a escribir el borrador, no aprendería nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350220,
					"content": "Tiene la cabeza y el corazón llenos de fantasías muy poco realistas en lo que a la Oficina Administrativa se refiere. Y eso está bien para los jóvenes, pero no para un trabajador de la Oficina Administrativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350221,
					"content": "Además, yo tampoco sabría cómo escribir un borrador así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350222,
					"content": "Eres bastante directo cuando quieres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "Bueno, dime, ¿qué te trae por aquí? Tal vez pueda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350224,
					"content": "Iaune aparece corriendo preso del pánico...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "¡Estoy acabado! Sr. Roialte, ¿tiene por ahí una tecla de máquina de escribir de sobra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350226,
					"content": "Estaba redactando de nuevo el borrador y me he percatado de que me falta una. Y me temo que no sé dónde habrá ido a parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350227,
					"content": "¿Has mirado por tu mesa? Tal vez se haya caído al suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350228,
					"content": "O tal vez esté entre las páginas de algún libro o entre tus documentos... ¿Has buscado en todos esos lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350229,
					"content": "O tal vez esté en el tintero, o se te haya colado por la manga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "¡O en el pelo o en la taza de té!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350231,
					"content": "He mirado por todas partes. Incluso he rebuscado en los bolsillos y dentro de los zapatos. No está, simplemente no está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350232,
					"content": "Bien, entonces deberías ir a ver a Cornelia. Ella es la encargada de todo lo que tiene que ver con la solicitud de recambios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350233,
					"content": "Tal vez debería comprar una yo mismo. No creo que le lleve mucho a Estelle hacer una nueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350234,
					"content": "Iaune, ¿por qué querrías poner Moras de tu bolsillo para algo así? Estamos hablando de material de oficina. Deberías presentar una solicitud ante Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350235,
					"content": "No es que me vaya a arruinar por comprar una tecla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350236,
					"content": "No es por los Moras. Estamos de nuevo ante un asunto de responsabilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350237,
					"content": "Es deber de la Oficina Administrativa hacer frente a los costes derivados del mantenimiento del material de la Oficina Administrativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350238,
					"content": "Si lo pagas de tu bolsillo y no presentas una factura para que te reembolsen el importe, cuando llegue el momento de la auditoría, nadie será capaz de explicar de dónde salió ese dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350239,
					"content": "¡Bien! ¡De acuerdo! Iré a ver a Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350240,
					"content": "Tanto lío solo para comprar una tecla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "Bueno, es lo normal aquí en la Oficina Administrativa. Vamos, vayamos a ver a Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350241,
					"content": "¿Cómo puede ser tan lioso comprar algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "¿No podrías echarle una mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "¿Y qué haces tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "¿Por qué a nadie le sorprende verme por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
			]
		},
		{
			"id": 7403503,
