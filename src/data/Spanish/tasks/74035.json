			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "#Ah, hola, viajer{F#a}{M#o}... Me alegro de verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350102,
					"content": "¿Cómo te va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "Sí, tienes muchas ojeras y te cuesta hablar. Deberías tomarte un descanso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350105,
					"content": "No puedo... Ayer me pasé toda la noche en planta escribiendo borradores y ninguno sirve. Así que todavía tengo que escribir otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350106,
					"content": "Si me necesitan para algún asunto oficial, voy a tener que pedirles que esperen un poco... Pueden pedirle una silla al Sr. Roialte para descansar. Tal vez incluso les prepare un café...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350107,
					"content": "Yo... seguiré escribiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350108,
					"content": "No, no. “Mis queridos compañeros” no es lo suficientemente formal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350103,
					"content": "No tienes buen aspecto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
			"completionStepIds": [
				7403504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
