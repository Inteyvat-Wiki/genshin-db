			"dialogs": [
				{
					"id": 740350301,
					"content": "Una tecla para la máquina de escribir... Semaine, ¿de verdad se puede reembolsar algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "No estoy muy seguro, la verdad. Pero si se puede solicitar una devolución de importes para una máquina de escribir, debería poder presentarse también para sus componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				}
			]
		},
		{
