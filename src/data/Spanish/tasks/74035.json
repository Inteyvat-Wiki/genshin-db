			"dialogs": [
				{
					"id": 740350601,
					"content": "¿Iaune? ¿Qué te pasa? Respira, hombre, respira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350602
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350602,
					"content": "¡Estelle! ¡Necesito una tecla para mi máquina de escribir! Dime que tienes una, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350603,
					"content": "Claro que tengo, pero cada máquina de escribir necesita unas teclas diferentes. Echa un vistazo a ver si ves una que te sirva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350604,
					"content": "Iaune empieza a rebuscar por la tienda a toda velocidad en busca de su tecla...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "¡Esta! ¡Esta servirá! Aquí tienes. ¡Gracias, Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350606,
					"content": "Oye, la última vez dijiste que iríamos a navegar juntos... ¡Oye! ¡Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
