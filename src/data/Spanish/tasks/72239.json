			},
			"dialogs": [
				{
					"id": 722390301,
					"content": "Ustedes... ¿Quiénes son? Su voz me resulta familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390302,
					"content": "#¿Eh? ¿Ya te olvidaste de nosotr{F#as}{M#os}? Oh, no... Estás peor de lo que Paimon pensaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390303,
					"content": "Gracias. ¿Nos conocemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390304,
					"content": "Sí, nos hemos conocido hace un momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "Ah, sí. Ya lo recuerdo. En este lugar, hasta el alma se desgasta. Mi pérdida de memoria también está cada vez peor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390307,
					"content": "Lo siento, yo... *Suspira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390308,
					"content": "¿Encontraron información útil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390309,
					"content": "¿Tu nombre es Supada no Hiko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "Supada no Hiko... Sí, eso, ¡correcto! Soy Espartaco, ¡el líder de la resistencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390313,
					"content": "Ooh, ¿entonces ambos son tu nombre? No se podía esperar menos de un gran líder, ¡hasta tienes dos nombres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390314,
					"content": "Gracias por devolverme mi nombre. Parece que también recordé otras cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390316,
					"content": "“Después del sol, surge la oscuridad, pero la auténtica luz se esconde en nuestros corazones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390317,
					"content": "¿Qué es eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "Es nuestro código de acceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390319,
					"content": "Ahora que recuperé mi nombre, mis recuerdos también están regresando. Este debería ser nuestro código de acceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390320,
					"content": "Ahora, déjenme que les diga dónde se esconden los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390321,
					"content": "¿Te gustaría que les dijera algo de tu parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "Déjenme pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390323,
					"content": "Díganles esto: nunca se rindan, la esperanza del reino de Byakuya está con ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390324,
					"content": "¿Quieres que los traigamos aquí para que te vean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "No, eso jamás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390326,
					"content": "Nuestra única ventaja es que, mientras el enemigo se encuentra a plena luz, nosotros nos hallamos bajo las sombras. Los corazones de la gente del reino de Byakuya están con nosotros, por lo que no podemos revelarnos tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390327,
					"content": "Además, no puedo recordar cada uno de sus nombres... Fíjense en que incluso olvidé el mío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390328,
					"content": "Por lo que, sí, díganles que nunca se rindan, que la esperanza del reino de Byakuya está con ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390329,
					"content": "¿Y si ya no están allí cuando lleguemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "No, eso no sucederá. Mientras los líderes corruptos que controlan al Hijo del Sol sigan presentes, ellos siempre permanecerán allí. La resistencia siempre perdurará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390331,
					"content": "Llévenles esta advertencia de mi parte: nunca se rindan, la esperanza del reino de Byakuya está con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390332,
					"content": "Eso debería ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390310,
					"content": "¿Tu nombre es Supada el Bandido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "Oh, ¡vamos! Me llamo Supada no Hiko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390305,
					"content": "Estábamos buscando tu identidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
			]
		},
