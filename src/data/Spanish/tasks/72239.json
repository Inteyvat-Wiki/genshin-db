				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "Después del sol, surge la oscuridad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "... pero la auténtica luz se esconde en nuestros corazones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "... Por poco lo olvido. Ha pasado tanto tiempo desde que escuché esa frase por última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "Dime, camarada, ¿quién te envía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "#¡¿El maestro Espartaco?! ¿El maestro l{F#as}{M#os} envía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "¡¿Dónde está?! Solo sé que lo capturaron los secuaces del Hijo del Sol durante la revuelta. Perdimos todo contacto con él después de eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "Lo encerraron en el altar del Corazón de la Serpiente y, a juzgar por cómo se presentan las cosas, no podrá salir. Por eso nos envió a buscarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Maldito sea ese Hijo del Sol..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "¿Qué instrucciones les dio el maestro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "Solo nos ordenó decirte unas palabras de su parte:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "“Nunca se rindan, niños. La esperanza del reino de Byakuya está con ustedes...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "¡Pe... Perdóneme! ¡Le hemos fallado, maestro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "El ejército de resistencia ya no existe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "Después de que capturaran al maestro, la columna vertebral del ejército de resistencia colapsó de forma estrepitosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Solo aquellos que habitualmente seguimos al maestro pudimos escapar, pues tuvimos la suerte de encontrarnos lejos del punto donde sucedieron los hechos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "Después, aquellos que lograron escapar huyeron hacia los escondites que habíamos preparado, con la esperanza de reunir nuestras fuerzas una vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "Tenemos estrategas excelentes, eruditos experimentados, taumaturgos brillantes y doctores de confianza entre nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "Guau, ¡qué personas tan prometedoras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "Eso es lo que pensábamos nosotros también. Creíamos que, con el tiempo, podríamos resucitar el movimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "Pero para todo eso se necesitan fondos... que no tenemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Al final, alguien propuso que vendiéramos condensados dragohueso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "¿Qué son los condensados dragohueso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "Es un maravilloso fruto que producen las flores dragohueso bajo circunstancias especiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Su fragancia puede relajar la mente y calmar los pensamientos ansiosos, haciendo desaparecer todas las preocupaciones. Por eso, puede alcanzar un precio muy elevado en el mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "¿En serio son tan místicos? ¿Seguro que no son una estafa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "Solo desearía que todo fuera una mentira... Por ingenuo, no percibí los peligros que había en ese camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "No sé de dónde salió la fórmula para crear el condensado dragohueso, pero sé que nos hizo ganar muchos fondos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Todo iba bien... Pero poco a poco me di cuenta de que algunos de mis compañeros, de repente, empezaron a evitar el conflicto y se negaron a luchar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "El número de personas aumentaba cada día, hasta el punto de que pidieron abandonar nuestras filas. No pude detenerlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "¿Cómo ocurrió eso? ¿Fue porque se ganó tanto dinero con los condensados que la mayoría de la gente perdió las ganas de seguir luchando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "¿Te refieres al encanto corruptor del dinero? No... Yo... No lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "Solo sé que cuando las personas oprimidas se sienten satisfechas con su vida, dejan de resistirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "Ese fue el principio del fin, y una vez comenzó, no hubo forma de detenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "A veces me pregunto si fueron esos tiranos quienes dejaron caer la fórmula en nuestras manos a propósito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "A veces me pregunto si fueron esos odiosos funcionarios los que se inventaron el alto valor de esos condensados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "*Suspira*, si el maestro estuviera aquí, seguro que habría sido capaz de controlar la situación. Incluso lo habría cortado de raíz desde el principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "Perdónanos, maestro... No pudimos convertirnos en esperanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "Siento mucho lo sucedido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "No puedo mirarle a la cara así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "De todas formas, les estoy agradecido por haberme traído noticias suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "No tengo nada más con qué agradecerles, así que si no les importa, déjenme contarles el secreto de los condensados dragohueso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "Solo pueden crearse usando el agua del Estanque Tokoyo, es decir, el agua del Lete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Tal vez puedan cambiarlo por algo de dinero, o guardarlo para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "#Aun así, sean cautelos{F#as}{M#os}, y mantengan su deseo de seguir adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "¿Te gustaría ver a tu maestro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(Hay dos líneas de texto en esta lápida. La primera está en la escritura del reino de Byakuya y es ininteligible.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Estela de piedra antigua"
				},
				{
					"id": 722392402,
					"content": "(La segunda línea está en lengua común, y dice lo siguiente:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Estela de piedra antigua"
				},
				{
					"id": 722392403,
					"content": "“Aquí yace Espartaco el Honrado, conocido ahora como Supada no Hiko. A continuación se incluye la letanía de sus crímenes. Léanla y tengan presente nuestra historia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Estela de piedra antigua"
				},
				{
					"id": 722392404,
					"content": "“Supada no Hiko, el famoso bandido, el cerebro detrás de grandes crímenes y el origen de la revuelta. Que su vista le sea arrebatada y su alma sea destruida en nombre de Oomikami de Tokoyo. Que lo encierren en las profundidades de una prisión, ahora, para siempre”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estela de piedra antigua"
				}
			]
		}
	]
}