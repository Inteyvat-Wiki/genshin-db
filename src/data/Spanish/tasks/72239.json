			},
			"dialogs": [
				{
					"id": 722391301,
					"content": "Oh... “Supada no Hiko”, “el bandido”... ¿Todos esos son sus nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391302,
					"content": "Ah, no, tal vez solo sea “Supada no Hiko”. ¡Es el nombre de ese hombre! ¡Vayamos a contárselo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7223918,
