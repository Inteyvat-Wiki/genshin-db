					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940501,
					"content": "#¡Vaya! Es el “compañer{F#a}{M#o}” de aquel comerciante extranjero que quedó atrapado en la cueva. Quién diría que lograría rescatarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "Aunque todos sabemos que el carnero perezoso solo te sigue para esparcir sus semillas en tierras lejanas. Ese señor no quiso escuchar ninguna explicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "#Me preocupaba este asunto, pero por suerte me encontré con un{F#a} aventurer{F#a}{M#o} tan amable como usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Este es un pequeño agradecimiento, espero que lo acepte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		}
	]
