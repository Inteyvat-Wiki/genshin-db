			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "¿Cómo voy a sacarlo de ahí? ¡Qué dolor de cabeza!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940102,
					"content": "¿Necesitas ayuda con algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "#¿Eh? Ah, eres {F#una aventurera}{M#un aventurero}, ¿verdad? Qué suerte tenerte aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940104,
					"content": "Verás, atravesando esta cueva había un camino que conducía al norte, pero se derrumbó hace poco debido a las alteraciones del kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940105,
					"content": "Por suerte no hubo víctimas, pero un comerciante extranjero dijo que su “compañero” quedó atrapado dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940106,
					"content": "Era un carnero perezoso que había conocido por la zona. Si llevas mucho tiempo por aquí, te darás cuenta de que estos carneros perezosos solo te siguen para que los ayudes a esparcir la semilla que llevan hasta lugares más lejanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940107,
					"content": "Pero por mucho que se lo expliquemos, ese señor no nos quiere hacer caso e insiste en que encontráramos la manera de rescatarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940108,
					"content": "Para reconectar el camino hacia las profundidades de la cueva, solo podemos usar estas flores tornajade. Lamentablemente, no conozco la magia de los Descendientes Lunaescarcha ni tengo mecanismos potentes de kuuvahki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940109,
					"content": "#Pero por suerte tú apareciste. Si eres {F#una aventurera}{M#un aventurero}, seguramente podrás encontrar la manera de sacar al carnero perezoso de ahí, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940110,
					"content": "¡Te doy las gracias de parte de ese señor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
