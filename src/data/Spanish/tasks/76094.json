					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "¡Excelente, sabía que encontrarías la solución!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "El carnero perezoso no puede sobrevivir en un ambiente sin kuuvahki, pero al menos podrá darle algo de consuelo a ese señor durante su estadía en Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Bueno, me retiro entonces. Esto es una pequeña muestra de mi gratitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
