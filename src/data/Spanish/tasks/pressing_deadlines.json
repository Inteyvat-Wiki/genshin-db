			"dialogs": [
				{
					"id": 710201001,
					"content": "Qué problema tan grande tengo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201002
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 710201002,
					"content": "La Recepcionista Zhao me dijo que te entregara esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710201003
					]
				},
				{
					"id": 710201003,
					"content": "¿Eh? ¡¿Necesita un informe de todos los barcos del puerto!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201004
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 710201004,
					"content": "Pues... De hecho, al principio, empecé a llevar la cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201005
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 710201005,
					"content": "Pero también está el informe de las mercancías importadas, los informes sobre los datos de la tripulación, y el informe de entrada y salida de extranjeros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201006
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 710201006,
					"content": "Hay demasiadas cosas que tener en cuenta... Informar de esto, registrar aquello... No puedo con todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Nervioso An"
				}
			]
		},
