			"dialogs": [
				{
					"id": 400315101,
					"content": "#¿Necesitas algo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315102,
						400315107,
						400315110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315102,
					"content": "Sobre la Red de la ubicuidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "Ah, eso. En un principio iba a dársela a Ryuuji para que la utilizase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315104,
					"content": "Al fin y al cabo, nuestro trabajo es bastante peligroso, ¿sabes? Ryuuji se hizo daño en varias ocasiones. Así que pensé: ¿cómo podría ampliar el alcance en el que capturamos criminales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315105,
					"content": "Leí numerosos libros antiguos y acabé diseñando esta red, incluso le encargué a una amiga que la construyera. Sin embargo, al final lo único que conseguimos fue atrapar algunos animalitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315106,
					"content": "Pero sea cual sea el caso, tú puedes hacer buen uso de ella, así que el esfuerzo no fue en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315107,
					"content": "¿Qué sucedió con Sanbongatana Kinpachi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "Así que quieres saber sobre eso... Esto es lo que pasó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315109,
					"content": "... ¿Sabes qué? Olvídalo. Ya que Ryuuji no quiere hablar sobre ese tema, me abstendré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315110,
					"content": "No hace falta. Ya me voy a ir yendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315111
					]
				},
				{
					"id": 400315111,
					"content": "Muy bien, ¡ve con cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
