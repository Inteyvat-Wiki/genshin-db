					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315204,
					"content": "Dicen que un perro cuyo nombre en clave era Inujin derrotó incontables monstruos que amenazaban Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315205,
					"content": "... Por supuesto, esto solo es una leyenda. Pero aun así, me pregunto si esa sombra misteriosa podría ser el perro ninja legendario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315206
					],
					"speakerTitle": "Ryuuji"
				},
