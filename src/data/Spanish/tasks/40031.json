			},
			"dialogs": [
				{
					"id": 400310801,
					"content": "Muchas gracias, han sido de gran ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310802,
					"content": "#¡Te lo dije! ¡{NICKNAME} es {F#la}{M#el} más fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310803,
					"content": "¿La cantidad de animales es la que esperabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310804,
					"content": "A ver... Vaya, todavía faltan algunos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310805,
					"content": "¿Eh? ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310806,
					"content": "Yo no diría que esto fue un fracaso. La sombra no nos noqueó y pudimos rescatar a un buen número de animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310807,
					"content": "Por tanto, estamos avanzando en la investigación, es solo que de momento nos hemos quedado sin pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310808,
					"content": "Seguiré investigando. Ustedes sigan con lo suyo por un tiempo y nos encontraremos en la Agencia de Detectives Bantan Sango cuando surja algo nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310809,
					"content": "Bueno, tampoco tenemos otra opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
