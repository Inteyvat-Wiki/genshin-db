				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "Según nuestras investigaciones más actuales, este debería ser el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310302,
					"content": "Humm, ciertamente hay un montón de animalitos por aquí. ¿Todos se perdieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310303,
					"content": "Y eso es... ¿un perro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310304,
					"content": "¿Hay un perro protegiendo este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310305,
					"content": "Oh, así que era eso. Vaya, qué situación tan embarazosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310306,
					"content": "¿Eh? ¿Por qué dices eso, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310307,
					"content": "Este perro es la “sombra” que me noqueó de repente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310308,
					"content": "No tengas vergüenza, tal vez era un perro muy fuerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "No hace falta que me consueles. Después de todo, me falta fuerza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310312,
					"content": "Aun así, ese porte tan arrogante y ese aire tan pretencioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310313,
					"content": "Humm... ¿No te recuerda a alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310314,
					"content": "Claro, la Casa de Té Komore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "¡Exacto! ¡Paimon también pensó en él! Al principio, hasta pensábamos que podía hablar. Una pena que no sea así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310317,
					"content": "¿Hablan del dueño de la Casa de Té Komore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310318,
					"content": "¿Lo conoces, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310319,
					"content": "En cierto modo, sí. La verdad es que sí se parecen, no deberíamos bajar la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310320,
					"content": "Taroumaru es conocido por ser muy amigable debido a su amplio trato con los humanos, pero de este perro no sabemos nada, así que les aconsejo que seamos cuidadosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310321,
					"content": "Humm, entendido, Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310322,
					"content": "Solo hablo por experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310323,
					"content": "Pero ¿por qué este perro querría reunir a todos estos animales y vigilar este sitio? Paimon no lo entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310324,
					"content": "Puede que necesitemos más pistas para averiguarlo. Por ahora, concentrémonos en rescatar a estos animales. Sus dueños están empezando a ponerse nerviosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310325,
					"content": "#Aquí es cuando entras tú, {NICKNAME}. Yo me encargaré de lo que ocurra después de que encuentres a los animales. Me aseguraré de que lleguen a sus casas lo más rápidamente posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310326,
					"content": "¿No quieres que ataquemos juntos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "Ni siquiera sabemos si podemos derrotar a este enemigo con un ataque en equipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310328,
					"content": "#De hecho, ¿tienes experiencia en ser sigilos{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310329,
					"content": "Una vez intenté robar Der Himmel, la Lira Sagrada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "Vaya... esa debió de ser una experiencia interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310333,
					"content": "En cualquier caso, deberíamos poder rescatar a los animales si evitamos al guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310334,
					"content": "He colocado algunos objetos para atraer su atención. Espero que te sirvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310335,
					"content": "Bien, vamos allá. Yo me quedaré aquí vigilando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310330,
					"content": "Conseguimos escapar durante el Rito del Descenso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "Una vez, seguimos a un funcionario en Ritou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "¡Taroumaru!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "Qué debilucho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "¡Oye! Seguro que el perro era muy fuerte. Paimon tampoco le habría ganado, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Paimon"
				}
			]
		},
