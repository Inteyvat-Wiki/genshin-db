	"talks": [
		{
			"id": 4003101,
			"completionStepIds": [
				4003101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003101",
							"2"
						],
						"stepId": 4003101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "#Hola, viajer{F#a}{M#o}, llegas justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310102,
					"content": "Oh, Paimon sabe por dónde va esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310103,
					"content": "Ya sé lo que vas a decir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "#No esperaba menos de {F#una}{M#un} aventurer{F#a}{M#o} tan experimentad{F#a}{M#o} como tú. Como bien dices, tenemos un encargo perfecto para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310106,
					"content": "La Agencia de Detectives Bantan Sango necesita personal, y pidieron que específicamente tú les ayudaras a investigar una “desaparición masiva de pequeños animales”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310107,
					"content": "¿Eh? ¿Solo unos cuantos animalitos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310108,
					"content": "#Oh, vamos, ¿de verdad necesitan la ayuda {F#de la}{M#del} gran {NICKNAME} para algo tan simple?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310109,
					"content": "#“{F#La}{M#El} gran {NICKNAME}” ha sido {F#repartidora}{M#repartidor} de comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "¿Bantan Sango no es el nombre de la agencia de detectives? ¿Por qué necesitan contratar aventureros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310114,
					"content": "Sango nos pidió que un aventurero con mucha experiencia acompañara a Ryuuji a investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310115,
					"content": "Y además... Humm, me pidió que dijera esto:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310116,
					"content": "“Han desaparecido las mascotas de mucha gente, lo cual nos ha generado muchos encargos a la vez. Habrá una generosa recompensa para quien resuelva este caso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310117,
					"content": "#Conque “una generosa recompensa”, ¿eh? Humm, ¿sabes qué, {NICKNAME}? Paimon cree que alguien tiene que rescatar a esos pobres animalitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310118,
					"content": "Además, tanto los encargos grandes como los pequeños nos sirven para mejorar, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310119,
					"content": "Qué fácil de convencer eres, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "Bueno, ¡vamos a buscar a Sango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310110,
					"content": "No pasa nada, he reparado carros en el pasado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "Te haré saber que fui yo quien derrotó a Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "¿Derrotar a Stormterror es algo simple para ti? Eso es... increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310104,
					"content": "Ahora dirás “tengo un nuevo encargo para ti”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "Muy bien, llegaron antes de lo que pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310203,
					"content": "¡Claro! Vinimos tan pronto como nos enteramos de lo de la recom... ¡de los animales desaparecidos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310204,
					"content": "#Bueno, ¿qué es lo que ocurre? No temas, ¡{NICKNAME} y yo ya estamos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310205,
					"content": "#Amb{F#as}{M#os} sabemos quién va a hacer el trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "¡Y Paimon te estará animando! Eso también cuenta, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310207,
					"content": "Tienen tanta energía como siempre. Bien, les explicaré qué pasa. Últimamente, hemos recibido un montón de encargos sobre animales desaparecidos y, por supuesto, debemos encontrarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310208,
					"content": "La mayoría son mascotas, por lo que no deberían haberse ido muy lejos por sí solas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310209,
					"content": "Hay muchos cuentos fantásticos en Inazuma, pero todo ocurre por una razón y todo se puede resolver mediante la lógica. Esto ha sido confirmado por nuestras investigaciones sobre el terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310210,
					"content": "Querrás decir “mis investigaciones sobre el terreno”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310211,
					"content": "Parece que Paimon también tendrá que animarte a ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310213,
					"content": "Gracias por la oferta, pero no es necesario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310214,
					"content": "Llevo varios días siguiendo a esos animales y, de hecho, encontré unos campamentos en la naturaleza. Algunos estaban protegidos por monstruos, lo cual tampoco es un gran problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310215,
					"content": "Sin embargo, justo cuando iba a liberar a uno de los animales de un campamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310216,
					"content": "... una sombra apareció de repente y le dejó fuera de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310217,
					"content": "Cuando desperté, el campamento estaba completamente vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310218,
					"content": "Qué mala suerte, Ryuuji. *Suspira*, ¿qué ha sido del Ryuuji que derrotó al criminal del caso “Sanbongatana Kinpachi” mientras rugía como la malvada oni Torachiyo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310219,
					"content": "Recuerdo que me sostuviste fuertemente mientras fingía estar muerta, y gritabas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310220,
					"content": "¡Pare, por favor! ¡Pare, he dicho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310221,
					"content": "Oh, ¡vamos! ¿Qué ocurrió después?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310222,
					"content": "Primero resolvamos el caso que nos ocupa, ¿de acuerdo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "#Como iba diciendo, la Agencia Bantan Sango necesita la ayuda de {F#una}{M#un} hábil aventurer{F#a}{M#o} como tú para rescatar a esos animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310228,
					"content": "Contigo ahí, tendremos un testigo aunque Ryuuji se desmaye de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310229,
					"content": "Pero, Sango, ¿por qué no vas tú misma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310230,
					"content": "No lo olvides: yo soy el cerebro de todo esto. Mi trabajo es usar la cabeza. Para mí, mi cuerpo no es más que un accesorio de mi mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310231,
					"content": "(Guau, ¡qué holgazana e insistente es!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310232,
					"content": "Pero no trabajarán gratis. Les pagaremos, tal y como acordamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310233,
					"content": "¡Eso es lo que Paimon quería escuchar! ¡Vamos, en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310234,
					"content": "*Suspira*, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "Un momento. Toma, llévate esto contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310237,
					"content": "Oh, perdona, pero... ¿qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310238,
					"content": "Es la <color=#00E1FFFF>Red de la ubicuidad</color>. Una amiga mía la hizo basándose en unos registros de la magia onmyoudou de Kamuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310239,
					"content": "No tiene el poder suficiente para capturar criminales, pero con un poco de puntería, debería poder capturar animales sin problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310240,
					"content": "Con ella, ¡recuperar a los animales desaparecidos debería ser pan comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310241,
					"content": "¡Yuju! ¡Facilito! Gracias, Sango, ¡eres la mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310242,
					"content": "Yo no diría que eso es “ser la mejor”. Considérenlo un “seguro para evitar el fracaso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310243,
					"content": "#Ryuuji, tú irás con ell{F#as}{M#os}, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310244,
					"content": "Por supuesto, jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310245,
					"content": "He descubierto más rastros de animales perdidos. Síganme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310246,
					"content": "¡Allá vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "Tengan cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310247,
					"content": "Gracias, Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "Te veo muy motivada, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "¡Eso! ¿Qué pasó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "#Oh, ¿estás interesad{F#a}{M#o} en uno de nuestros casos anteriores? Bueno, en aquel entonces, el policía usualmente amable llamado Kinpachi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310225,
					"content": "P-por favor, volvamos al tema en cuestión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310226,
					"content": "Claro, tienes razón. Perdón, Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
