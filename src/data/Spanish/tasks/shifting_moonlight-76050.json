					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "¡Pobrecito! Si es un diploceronte, ¡tiene un buen problema en el cuello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500312,
					"content": "Humm... Nunca antes he visto esa criatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500313,
