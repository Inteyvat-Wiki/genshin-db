			"dialogs": [
				{
					"id": 760500101,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500102,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Vaya, qué animado está el ambiente por aquí. ¡Cuántas kuuhenki bailando alrededor de Colombina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Eh, un momento... ¡No están bailando! Es como si estuvieran... ¡ahogándola con su adorabilidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "A... ¡Ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500106,
					"content": "Dame la mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Uf... Gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500108,
					"content": "¿Qué acaba de pasar? Las kuuhenki no suelen estar tan alteradas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500111,
					"content": "He estado jugando con las pequeñinas, y parece que se lo estaban pasando muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500112,
					"content": "¿Y después de jugar han empezado a dar vueltas a tu alrededor? Casi como si fueran cachorros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "Tal vez esa sea su forma de expresar agradecimiento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Aunque esta vez su gratitud ha caído sobre mí como una avalancha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500115,
					"content": "Eso dices, ¡pero sigues mimándolas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "¿Quieren probar ustedes dos también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500117,
					"content": "¿Lo que se siente al estar en el epicentro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Humm... Es posible. Pero tendrás que responder una pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500121,
					"content": "Está bien. Paimon quiere ver qué tipo de juego es y por qué les gusta tanto a las kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760500123,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500124,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500119,
					"content": "¿A jugar con las kuuhenki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
					"content": "Sí.",
