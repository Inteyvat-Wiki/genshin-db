				"objectNames": [
					"Bárbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "¿Te gusta este lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "¿Quieres conversar conmigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "¿Hay algo que quieras hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "Sí, ¡me encanta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901510,
					"content": "Un paisaje diferente al de Mondstadt, se siente muy nuevo para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901511,
					"content": "Aquí puedo cantar a pleno pulmón al ensayar sin tener que preocuparme por molestar a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901512,
					"content": "Tu voz no molestaría a nadie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "Genial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901514,
					"content": "Gracias por decir eso, pero yo... tengo que ser un poco más considerada con los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901515,
					"content": "De todos modos, me alegro de que me hayas invitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901517,
					"content": "Me alegro de que me hayas invitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901518,
					"content": "Me gustaría quedarme aquí un poco más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901520,
					"content": "¡De acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901521,
					"content": "Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901522,
					"content": "¿Por qué te ríes de repente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "#Ah, me acabo de dar cuenta de que hace mucho tiempo que no hablaba con {F#una amiga}{M#un amigo} con tanta facilidad como ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901525,
					"content": "Me siento muy feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901526,
					"content": "Supongo que eres fácil de complacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "Es porque siempre estás pensando en los demás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "Humm, ¿realmente crees eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901528,
					"content": "No parece tan malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901529,
					"content": "Si te sientes feliz con facilidad, tendrás mucha energía y entonces podrás transmitir el sentimiento de felicidad a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901531,
					"content": "Bueno, eso es natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901532,
					"content": "Siempre me cuidan todos y quiero responder a esas bondades con mi propio esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901533,
					"content": "Como era de esperarse de ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "Humm, no tienes que halagarme todo el tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901535,
					"content": "Las críticas... son lo que llevan a uno a mejorar, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901537,
					"content": "Ah, he estado practicando una nueva canción últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901538,
					"content": "Pero hay algunos detalles de los que aún no estoy segura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901539,
					"content": "¿El estribillo debe subir un tono en la repetición? ¿Hay partes del baile que podrían mejorar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901541,
					"content": "Te daré todo mi apoyo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "Será un honor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "Si no te molesta, me gustaría que vieras mi presentación y me dieras tus recomendaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901543,
					"content": "Gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901544,
					"content": "Humm... Si ves partes que no están listas, no te rías de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901545,
					"content": "Lo he pensado muchas veces, y solo ahora he reunido el valor para hacerlo frente a ti tan de cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901547,
					"content": "No lo haré, tranquila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "No sabría dónde esconderme si te ríes de mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901549,
					"content": "*Suspira*... bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901550,
					"content": "En ese caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 9901551,
					"content": "¡Que empiece el concierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bárbara"
				}
			]
		},
