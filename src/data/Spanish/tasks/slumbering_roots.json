			"dialogs": [
				{
					"id": 730170401,
					"content": "Raíces de gran árbol son buenas. Se puede escuchar húmeda respiración, como si alguien cantara mientras duerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Ehmm... Paimon sigue sin entender lo que dice Arakunti, pero bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "Qué espacio tan enorme... Aquí sí que hay un problema que cortar de raíz. Paimon tiene la sensación de que el ambiente de este lugar es muy distinto al de otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "¿Deberíamos buscar aquí las hojas que le dan energía a la máquina divina de Váruna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "Están aquí, pero no están aquí. Arakunti puede escuchar su voz, oler su aliento, ver sus venas... Paimon no va a ser capaz de encontrarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "¿Eh? ¿De qué estás hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Paimon no puede encontrarlas, pero ¿y yo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "#Nara {F#rubia}{M#rubio} puede ver melodía. Es como fría brisa nocturna, como lluvia repentina, como sueño que se rompe en mil pedazos en superficie de lago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Suena realmente impresionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#¡Paimon sabía que {NICKNAME} podría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Jeje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Jeje... ¡Oye! ¡{NICKNAME}, no copies la forma de hablar de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Que nara {NICKNAME} se convierta en Paimon... Eso da más miedo que bailar entre Marana y champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "No puedo ni imaginármelo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "¡Algo así nunca ocurrirá! Al menos, eso espera Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Oye, Arakunti, ¿no puedes hablar más claro? ¿Dónde podemos encontrar las hojas de la máquina divina de Váruna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "En sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Oh... Espera... ¿Por qué no dijiste eso desde el principio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Porque Paimon preguntó por qué, no dónde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Eh... Paimon cree que por fin entiende la forma de comunicarse de los aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti, ¿podrías decirnos dónde se encuentran exactamente cada una de las tres hojas que estamos buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Sí, podría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Ay... Arakunti solamente responde a las preguntas que se le formulen directamente... Muy bien: ¿dónde se encuentran esos tres lugares exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Por aquí, por ahí y por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Ajá... Espera, ¡no estás diciendo nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Paimon, qué fracaso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#¡Los fracasos de Paimon también son tus fracasos, {NICKNAME}! Las palabras de Arakunti no sirven de mucho... ¿cómo vamos a encontrar esas tres ubicaciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "Máquina divina de Váruna es lo más increíble que hemos construido aranara. Conexión entre ramas y hojas se puede ver, pero no se puede ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} puede ver a aranara y sus huellas, así que podrá encontrar camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "¡P-Paimon por fin lo entendió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Solo hay que seguir el rastro de los aranara para encontrarlos, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "*Solloza*, ¡al menos dale a Paimon la oportunidad de responder esta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
