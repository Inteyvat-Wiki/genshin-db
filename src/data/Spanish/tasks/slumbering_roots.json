			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171001,
					"content": "Sueños de agua, sueños secos... Ding-dong, tic-tac, cha-cha. Esa es canción de bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171002,
					"content": "#Nara {NICKNAME}, hojas están en sueño y rama está aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				}
			]
		},
		{
			"id": 7301712,
			"completionStepIds": [
				7301712
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301712",
							"2"
						],
						"stepId": 7301712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "¡Ya regresamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "Arakunti lo escuchó. Llantos se convirtieron en suave melodía, pero para que gran corriente converja con sonido, todavía hay que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "¡Necesitamos tu ayuda, Arakunti! Jeje, ¡ahora es tu turno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Arakunti lo sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "Oh, ¡perfecto entonces! Paimon espera que podamos reparar la máquina divina de Váruna pronto. Si no, la Floresta Apam se llenará de esporas... Con solo pensarlo, a Paimon le da... a... ¡Achís!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Paimon no puede creer que los aranara sean inmunes a las esporas... ¿Cómo es que no les afectan en absoluto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Aranara cocinamos champiñones. Hay muchas esporas, y son demasiado pequeñas como para atrapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "Cuando máquina divina de Váruna funcionaba, en bosque no había tantos champiñones, así que siempre que máquina esté bien, todo irá bien. Excepto Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Seguro que las cosas mejorarán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#¡Sí, Paimon y {NICKNAME} ayudarán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "También encontraremos la forma de lidiar con el Marana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Nara {NICKNAME}, ¿eres nara Váruna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "¿Eh? ¿A qué viene esa pregunta ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "#Arapandu dijo que nara Váruna era nara rubi{F#o}{M#a} y valiente. Ayudó a aranara a reparar máquina divina de Váruna, alejó lluvia y tierra negras y trajo de vuelta sol y luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Nara {NICKNAME} también ayuda a aranara a arreglar máquina divina de Váruna y también es rubi{F#a}{M#o} y valiente, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "#Pero... ¿{F#el}{M#la} nara Váruna no fue alguien de hace mucho tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Entonces, ¿nara Váruna no ha regresado a bosque y nara {NICKNAME} es nara totalmente distint{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "¿Nara que son distintos pueden tener melodías parecidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171219,
					"content": "Tal vez tengas razón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "#Arakunti nunca vio a nara Váruna, pero Arapandu habla mucho sobre {F#él}{M#ella}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171222,
					"content": "#Seguro que melodía de nara {NICKNAME} es igual que melodía de {F#él}{M#ella} y hace feliz a quien escucha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171223,
					"content": "#¡Claro! Paimon siempre es feliz cuando está con {NICKNAME}. Si algún día dejase a Paimon, igual que {F#el}{M#la} nara Váruna dejó el bosque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171224,
					"content": "Ohh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171225,
					"content": "#Arapandu nos espera en descansadero. Nara {NICKNAME}, ven con Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171226,
					"content": "Vámonos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "Sí. ¡Regresemos con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171228,
					"content": "Pero aún tenemos cosas que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "No pasa nada. Arakunti puede regresar solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171220,
					"content": "No lo sé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				}
			]
		}
	]
}