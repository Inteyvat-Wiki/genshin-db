			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tanyií"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "#¡Hola, amig{F#a}{M#o} desconocid{F#a}{M#o}! ¿Eres {F#una viajera}{M#un viajero} que pasaba por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380102,
					"content": "Siento ponerme en tu camino, pero... ¿podrías explicarme qué ha pasado aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380103,
					"content": "#Un placer. Yo soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "Y yo, Tanyií, un dastur de la Escuela de Etiología. Vine a ofrecer... apoyo educativo a la tribu Tanit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380105,
					"content": "Qué extraño. Supuestamente, debería ser aquí, pero ¿por qué tiene este aspecto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380106,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "¿Será por guerras intertribales? ¿O por disputas internas? Hum, interesante. Hace siglos que en el desierto no hay un conflicto capaz de destruir una tribu entera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380110,
					"content": "Además, he visto otros rastros de lo más ominosos. Te recomiendo que no vayas a investigar, o se te revolverán las tripas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380111,
					"content": "Tal vez los supervivientes trajeran hasta aquí la mayoría de las cosas que quedaron, pero no estoy seguro. En cualquier caso, es francamente inquietante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "*Suspira*, ¿cómo he podido encontrarme con algo así? Siento como si estuviera presenciando un evento histórico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380114,
					"content": "En fin... ¿echamos una partida de cartas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380115,
					"content": "Encontré unos mazos en esas tiendas de ahí, los limpié y ahora están como nuevos. Si te interesa, tal vez podríamos jugar un par de partidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tanyií"
				},
				{
					"id": 733380108,
					"content": "A lo mejor migraron a otro sitio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "¿Que migraron? No puede ser. Mira, las mercancías y las tiendas siguen en su lugar, hay cenizas de leña quemada y rastros de vida en las casas. Parece más como si un gran desastre hubiera interrumpido la vida de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanyií"
				}
			]
		},
