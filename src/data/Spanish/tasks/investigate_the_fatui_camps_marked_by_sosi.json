	"talks": [
		{
			"id": 7333007,
			"completionStepIds": [
				7333007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7333007",
							"2"
						],
						"stepId": 7333007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "¡Eh, tú, humano conspirador, más te vale marcharte de este lugar ahora mismo! El legado y los secretos de las pari no están a tu disposición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "¿Las pari? ¡Eres una pari! Jajaja, ¡esto sí que es toda una experiencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "#Vaya, y viene con {F#una joven delicada}{M#un joven flacucho} y su... ¿mascota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "¡Pero qué maleducado! ¡Soy su mejor amiga, no su mascota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "¿Su mejor amiga? Oh, claro, claro... Vaya, todo esto es realmente conmovedor. Desde que era pequeño, yo también quería tener un mejor amigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "#{F#Joven delicada}{M#Joven flacucho}, no necesitas dos mejores amigas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "¿Qué quieres decir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "Lo que quiero decir es que tener dos mejores amigas es... ¡demasiado avaricioso! Incluso para alguien como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "Y no puedo permitir tal injusticia, así que, por favor... entrégame a esa pari. Y no te preocupes, te pagaré generosamente por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "¡Insolente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Este Fatui no atiende a razones. ¡Es imposible hablar con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "En este mundo hay otras formas de hacer que alguien entre en razón aparte de con palabras. Mi Yasnapati, tú posees una gran inteligencia, seguro que sabes a qué me refiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "¡Paimon te entiende, Sorush! Es hora de darle una lección a este tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "¡Hum! ¿Quién te dio vela en este entierro, paliducha flotante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "No me importaría seguir teniéndolas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "¡¿Cómo?! No, no, no, ¡tu mejor amiga solo puede ser Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}