			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Príncipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "#¡Miau! (¡Miauravilloso! ¡Felicidades! Has superado el duelo de ascensión. ¡Ahora eres {F#una invocadora maestra}{M#un invocador maestro}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706680202,
					"content": "#Miau. (Ser {F#una invocadora maestra}{M#un invocador maestro} quiere decir que tu técnica ha mejorado la de muchos de los estudiosos de este juego. Solo aquellos que ponen gran empeño en ello podrían alcanzar este nivel.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706680203,
					"content": "(Ni que decir tiene que esos jugadores no llegarían nunca a comprender por qué invertimos tanto en algo que se considera un mero entretenimiento...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706680205,
					"content": "#¡Miau! (Me juego diez ratones a que tus oponentes se lo tomarán mucho más en serio cuando sepan que has alcanzado el nivel de {F#jugadora experta}{M#jugador experto}.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706680206,
					"content": "#(Puede incluso que algunos jugadores solo te permitan jugar contra ellos ahora que eres {F#una invocadora maestra}{M#un invocador maestro}... Y también hay tipos muy extraños en la taberna.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706680207,
					"content": "#Miau... (Así que ya sabes, {NICKNAME}...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706680208,
					"content": "(¡Que la juerga te acompañe!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Príncipe"
				}
			]
		},
