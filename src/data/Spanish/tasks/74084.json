			"dialogs": [
				{
					"id": 740840801,
					"content": "... ¡Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840802,
					"content": "Pahsiv, ¿qué haces aquí? Aléjate de ese Dragarto, ¡es muy peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840803,
					"content": "¡Amable Paimon, Pahsiv! Peligro, melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840804,
					"content": "Pahsiv extiende la mano y acaricia la cabeza del Dragarto enfurecido, que agacha la cabeza dócilmente.\\nAbre la boca, escupe una gota de agua cristalina, y entonces se gira para meterse de nuevo en el agua.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "¡Es la llave! ¡Estaba escondida dentro de la boca del Dragarto! ¿Cómo es posible que nos la haya entregado sin oponer resistencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840806,
					"content": "Cosa azul, cosa buena, llave, proteger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840807,
					"content": "¿Con “cosa azul” se refiere a ese Dragarto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "Pahsiv, ¿eres amiga de ese Dragarto? ¿Te está ayudando a proteger las llaves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840809,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840810,
					"content": "Cosa morada, arrebatar la llave... Cosa azul, desmayarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840811,
					"content": "¿C-cosa morada? ¿Y esa cosa quién es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840812,
					"content": "#Cosa morada, cosa mala... ¡Cosa azul, Paimon, {NICKNAME}, cosas buenas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840813,
					"content": "Humm... Paimon siente que intentas alabarnos, aunque sea de una forma un poco rara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840814,
					"content": "Cosa morada, muy mala, Erinias, muy melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840815,
					"content": "Quieres decir que... ¿la cosa morada es la que está amenazando la isla? Menos mal que ya tenemos las llaves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840816,
					"content": "#¡Paimon, {NICKNAME}, Pahsiv! Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840817,
					"content": "Llave, llave, llave, plaza, oeste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840818,
					"content": "Ya lo sabemos, no te apresures, Pahsiv. Ahora vamos a la plaza del oeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
