			"dialogs": [
				{
					"id": 740840605,
					"content": "¡Mira! ¡Hay un Dragarto al lado del altar! ¿Estará dormido? Vayamos con cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840601,
					"content": "¿Eh? ¿P-por qué no hay ninguna llave aquí? ¿Acaso ya habían activado este altar? ¿Será que alguien ya se llevó la llave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840602,
					"content": "Grr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "Dragarto dormitante"
				},
				{
					"id": 740840603,
					"content": "¡Oh no! ¡El Dragarto se ha despertado! ¡Corramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840604,
					"content": "El Dragarto que duerme junto al altar se despierta sacudiéndose, mostrando unos ojos que emanan furia y maldad...\\nSe apresuran a nadar hacia la orilla, pero él los persigue de cerca...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
