			},
			"dialogs": [
				{
					"id": 721971801,
					"content": "#{NICKNAME}, volviste. ¿Trajiste los cristales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721971802,
					"content": "Sí, los traje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "Están en camino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "Tómate tu tiempo. También puedes descansar aquí si quieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
		{
			"id": 7219719,
			"completionStepIds": [
				7219721
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7219721",
							"2"
						],
						"stepId": 7219721,
