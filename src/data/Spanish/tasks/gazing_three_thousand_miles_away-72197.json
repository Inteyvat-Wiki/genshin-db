				{
					"id": 721402301,
					"content": "#Hola, {NICKNAME}, ¡no esperaba volver a verte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "¡Tanto tiempo! ¿Cómo es el mundo fuera de la Isla Yashiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "Es mucho más próspero que mi hogar. Hay un montón de buena comida y cosas divertidas que hacer. Pero... No me gusta mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "A la gente de aquí parece como si les faltara algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Cuando vivíamos en la Isla Yashiori, Su Excelencia era una presencia distante pero tranquilizadora para nosotros... No nos importaba dónde estuviera, creíamos que estaba allí, observándonos, protegiéndonos, decidiendo cómo debíamos vivir nuestras vidas y en qué clase de personas debíamos convertirnos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Pero aquí, Su Excelencia está en todas partes y resulta algo opresivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "*Suspira*, no sé muy bien cómo explicarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "Aún lo estamos intentando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "Por cierto, ¿han encontrado algo relacionado con mi madre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402311,
					"content": "Gracias. Avísenme cuando tengan alguna novedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
