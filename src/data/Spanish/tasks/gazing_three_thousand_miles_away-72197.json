					"Chouji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#¡Hola, {NICKNAME}! ¿Cómo estás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401703,
					"content": "¡Paimon me robó la frase!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "Bien, ¿y tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401705,
					"content": "Paimon, quieres una comida extra, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "#¡Jaja, eres demasiado lent{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401707,
					"content": "Quiero decir... Tú eres la comida extra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "Por supuesto. ¡Siempre quiero una comida extra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401708,
					"content": "¡Eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401709,
					"content": "¡Ja,ja,ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401710,
					"content": "Está bien, está bien, dejen de pelear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401712,
					"content": "Dime, ¿cómo te puedo ayudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "Veré qué puedo hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "Estoy bien. Pero necesito otro favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401714,
					"content": "#Bueno, no es nada especial. Solo necesito que me ayudes a conseguir más cristales, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401716,
					"content": "Confío en ti, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "Créeme, te recompensaré por tu ayuda. Si confías en mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401718,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "Prometiste darme una explicación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401720,
					"content": "Sí, ¡seguimos sin saber para qué necesitas tanta médula cristalizada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401722,
					"content": "Pero el shogunato ha monopolizado el mercado del cristal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "Sabes que el cristal no es fácil de vender, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "Bueno, necesito dinero para viajar y encontrar a mi madre. Puedo cambiar el mineral por dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401725,
					"content": "Lo que haces es muy peligroso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "Me preocupa tu bienestar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "Lo sé. ¡Encontraré mi propio camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401727,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401728,
					"content": "#Chouji, somos amig{F#as}{M#os}, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401729,
					"content": "¿Quizás esta vez podamos ayudarte de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401731,
					"content": "Qué filosofía tan materialista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "Además, prometiste recompensarnos. Entonces, tenemos derecho a saber sobre las cosas que podrían ponerte en peligro y afectar nuestra recompensa, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401732,
					"content": "Paimon tiene razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401733,
					"content": "No colecciono cristales solo por el dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401734,
					"content": "He estado pensando... ¿Y si mamá y papá contrajeron la enfermedad causada por los tatarigami, como todos los demás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401735,
					"content": "Tal vez estos cristales puedan utilizarse para fabricar medicinas. Después de todo, crecieron de los huesos de la serpiente gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401736,
					"content": "Y el Sr. Yasumoto también mencionó que estos cristales pueden ser útiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401737,
					"content": "Pero no puedes estar seguro de que eso sea correcto, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401738,
					"content": "Tal vez no, pero no se me ocurre otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401739,
					"content": "Cuando encuentre a mamá, o quizá incluso a papá, los llevaré a Sumeru. Dicen que allí tienen la cura para esta extraña enfermedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401740,
					"content": "Por el momento, no puedo renunciar a la esperanza de encontrar un tratamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401742,
					"content": "Me extraña que me lo preguntes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "Espero que puedas hacer un buen uso de los cristales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "Bueno, ya he dicho bastante. ¿Aún quieren ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401744,
					"content": "¡Gracias! ¡No lo olvidaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
