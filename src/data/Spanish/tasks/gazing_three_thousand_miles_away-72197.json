				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chouji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "Con esto debe ser suficiente. ¡Ahora partiré a mi propia aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401903,
					"content": "¡Cuídate!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "¡Estamos en contacto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "Paimon sigue preocupada por este chico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401905,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401906,
					"content": "#¡Oye, Chouji, será mejor que tengas cuidado con lo que dices! Deberías sentirte afortunado de que nos conociste a {F#nosotras}{M#nosotros}... ¡Otro te hubiera dado una paliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401907,
					"content": "Además, en caso de que los malos quieran obtener información de ti, ¡asegúrate de no decirles la verdad! ¡Inventa una historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401909,
					"content": "Paimon se está convirtiendo en una abuelita regañona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "Y también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401911,
					"content": "Tengo fe en él.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "¡Cualquiera se preocuparía si un niño pequeño como él saliera solo a la aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401912,
					"content": "Claro que sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401913,
					"content": "#¡Jajajaja! ¡Gracias, gracias a l{F#as}{M#os} dos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401914,
					"content": "Espero que nos volvamos a encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401915,
					"content": "Promete a Paimon que te mantendrás a salvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401916,
					"content": "¡Estaré bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401917,
					"content": "A continuación me dirigiré a Tatarasuna, donde mamá trabajaba. Quizá alguien pueda decirme si ha estado allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401918,
					"content": "Y luego... Intentaré ir a la Isla Narukami y viajar a Snezhnaya en un barco mercante. Después de eso, veré cómo van las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401920,
					"content": "¿Tienes idea de lo que dices?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "¿Comprendes los riesgos que corres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401922,
					"content": "Si nadie se lanzara a la aventura por el hecho de no conocer todos los riesgos... Bueno, no habría aventureros en el mundo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401924,
					"content": "De acuerdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "Ten mucho cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "Uf, este chico es taaaan irritante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401926,
					"content": "Jajaja, ¡no se preocupen por mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401927,
					"content": "#¡Que tengan un buen viaje! Por cierto, {NICKNAME}, ¡espero que tú también puedas encontrar pronto a tu familia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401928,
					"content": "¡Sí! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
