			"dialogs": [
				{
					"id": 762100501,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100502
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100502,
					"content": "#Aunque no es exactamente caminar en el aire, su demostración me ha resultado de lo más inspiradora. Gracias por su ayuda, joven {M#héroe}{F#heroína}.",
					"roleType": "TALK_ROLE_NPC",
