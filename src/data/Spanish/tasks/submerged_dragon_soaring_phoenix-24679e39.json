			"dialogs": [
				{
					"id": 762100301,
					"content": "Observen, por favor. Esta es la “Formación Contemplaciruelos” de la Academia Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "#Joven {M#héroe}{F#heroína}, ¿podría pisar en orden los postes de piedra que le indique dentro del tiempo establecido para mostrarme su agilidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "Será como un paseo por el parque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Bueno, en realidad no vas a pasear, sino a saltar entre... En fin, da igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "#Bien, {M#joven héroe}{F#joven heroína}. Es hora de mostrar de lo que es capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "En realidad, Paimon, líder del Clan Paimon, también podría hacerlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "¡Paimon no puede hacerlo! Por mucho que lo piense... ¿Eh? Ahora que lo piensa bien, parece que sí que podría... Pero volar sería hacer trampa, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
