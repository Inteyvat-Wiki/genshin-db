				]
			},
			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#Joven héroe}{F#Joven heroína}, qué técnica más extraordinaria tiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Jeje, ¡pues claro! ¡{NICKNAME} es muy fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "#En ese caso, ¿podría mostrarme la esencia de las <color=#00E1FFFF>técnicas de salto</color>, joven {M#héroe}{F#heroína}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "Según los registros, los antiguos maestros de Guhua podían saltar muros y escalar murallas como si caminaran por tierra llana. Verdaderamente, poseían la habilidad de correr por los tejados y trepar paredes. A esto se le conoce como “técnicas de salto”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "¡Increíble!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Humm... ¿Y si lo intentamos? Al fin y al cabo, has escalado un montón de sitios buscando tesoros, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "Suena a un ladrón ágil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Jeje. Piénselo bien, {M#joven héroe}{F#joven heroína}. Si los ladrones pudieran escapar saltando muros, pero nosotros, los defensores de la justicia, no podemos hacer lo mismo, ¿no sería muy fácil para esos villanos escapar de nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
		{
			"id": 7621002,
			"completionStepIds": [
				7621005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
