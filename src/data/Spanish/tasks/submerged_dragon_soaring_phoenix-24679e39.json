						],
						"pointId": 910303079
					}
				]
			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "Impresionante. Estoy profundamente maravillado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "#En ese caso... tengo otra humilde petición que hacerle. Joven {M#héroe}{F#heroína}, ¿ha oído usted hablar de las <color=#00E1FFFF>técnicas caminanubes</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Cuenta la leyenda que nuestro antiguo gran Maestro Guhua logró ascender a los cielos entre destellos púrpuras y resplandores dorados, caminando por el aire como si pisara tierra firme, gracias a esta legendaria técnica secreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Suena un poco exagerado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "Sí, suena a que es mentira... Pero ahora que lo dices, ¿no podríamos conseguir algo parecido si usamos el planeador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "#¿Oh? Entonces, {M#joven héroe}{F#joven heroína}, ¿podría hacerme una demostración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Si pudiéramos usar el planeador...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
