				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "Es peligroso andar por aquí a solas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102102,
					"content": "No sabes con quién o con qué te encontrarás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102103,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "#Humm, te ves muy relajad{F#a}{M#o}. Hay un dicho que dice: “No puedes mantener tus zapatos secos si caminas por el río”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102106,
					"content": "Terminarás por encontrarte con algo en un lugar tan extraño y tenebroso como este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102107,
					"content": "Y lo que encuentres aquí puede convertirse en una pesadilla que te acompañará durante el resto de tu vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102108,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "#¿Eh? ¿Cómo puedes estar tan relajad{F#a}{M#o}? Normalmente la gente huye despavorida antes de que termine de hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102111,
					"content": "Pareces una persona común y corriente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Sí, pero una forma más sofisticada de hacer el papel de un fantasma es creando una atmósfera terrorífica que asuste a la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102113,
					"content": "En cuyo caso mi apariencia es irrelevante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102117,
					"content": "Además, nunca asustaría a alguien como tú que no cree en fantasmas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102118,
					"content": "Eso suena a que solo estás holgazaneando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "¡¿Qué dices?! ¡Hum! Iré a buscar a algún cobarde a quien asustar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102120,
					"content": "Deberías regresar a buscar a tu compañero, debe estar muerto de miedo en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102114,
					"content": "¿No tienes un disfraz o algo por el estilo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Sí, tengo uno, pero da mucho calor... Además, una forma más sofisticada de hacer el papel de un fantasma es creando una terrorífica atmósfera que asuste a la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102116,
					"content": "En cuyo caso mi apariencia es irrelevante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102109,
					"content": "Lo siento, pero no entendí... ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Hola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
