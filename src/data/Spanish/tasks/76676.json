			"dialogs": [
				{
					"id": 766760101,
					"content": "¡Bravo, bravo! El evento ha sido todo un éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760102
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 766760102,
					"content": "Muchos de nuestros amigos de Sumeru han aprendido el estilo de danza de Natlan. ¡Es posible que nuestra danza conquiste todo Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760103
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 766760103,
					"content": "Espero que en el futuro, nuestro intercambio de baile se vuelva frecuente, ¡con visitas entre ambos periódicamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760104
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 766760104,
					"content": "Entonces, ¿los saurios de Natlan también podrán hacer danzas con espadas como Los Eremitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760105,
						766760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760105,
					"content": "Y no nos olvidemos de las legendarias danzas de combate...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				},
				{
					"id": 766760107,
					"content": "¿Eh? ¿Acaso te refieres a... los movimientos intimidatorios que el Sr. Cimitarra usó para ahuyentar a esos Buitres Escarlatas Sacróseos cuando Ñusta lo conoció?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760108
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760108,
					"content": "¿El Sr. Cimitarra no les explicó el origen de esos movimientos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760109
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760109,
					"content": "Sí, nos dijo que esa danza se llamaba “El dúo de la Leona Ardiente y la Guardiana Garza Azul”, ¿verdad? ¡Es un nombre que combina elegancia y fuerza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760110
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 766760110,
					"content": "¡Ah! Esos dos nombres le suenan muy familiares a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760111,
						766760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760111,
					"content": "Me recuerdan a dos amigas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760113,
					"content": "#{NICKNAME} y Paimon probablemente ya se lo imaginaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760114
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760114,
					"content": "La zona donde encontraron a los Buitres Escarlatas Sacróseos está cerca de una ruta habitual de las caravanas de animales de carga de Las Alimañas Flamígeras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760115
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760115,
					"content": "Hace algún tiempo, cuando la caravana llevaba a Dehya y Candace de vuelta a la Aldea Aaru, se toparon con esos buitres escarlatas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760116
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760116,
					"content": "Al final, las dos, que habían salido sin hacer calentamientos ese día, desataron toda su energía contra esos buitres escarlatas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760117
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760117,
					"content": "Desde entonces, cada vez que los miembros de Las Alimañas Flamígeras imitan sus movimientos de combate, los buitres escarlatas huyen por su cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760118
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760118,
					"content": "Así que eso era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760119,
					"content": "¿Podemos decir que esos Buitres Escarlatas Sacróseos tuvieron mala suerte? Recibieron una doble paliza de Dehya y Candace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760120,
						766760121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760120,
					"content": "Ellos se lo buscaron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760122,
					"content": "¡Vaya! Me perdí la oportunidad de conocer a esas dos expertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760123
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 766760123,
					"content": "Cuando vaya a Sumeru, ¡por favor, preséntamelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760124
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 766760124,
					"content": "Quiero aprender sus técnicas de puñetazos, ¡especialmente ese ritmo que transmite potencia desde los pies hasta los muslos, de la cintura a la espalda, y luego a los brazos y puños!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760125
					],
					"speakerTitle": "Ñusta"
				},
				{
					"id": 766760125,
					"content": "¡Jaja, seguro que también brindarán hasta caer rendidas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760126
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760126,
					"content": "¡Mejor preparo algo para la resaca con antelación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760121,
					"content": "Dehya y Candace lo hicieron muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760112,
					"content": "Creo que ya puedo adivinar la historia completa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760106,
					"content": "Esas que ahuyentan a los buitres escarlatas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				}
			]
		}
	]
}