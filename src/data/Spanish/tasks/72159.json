					"nextDialogs": [
						721590402
					],
					"speakerTitle": "Masanori"
				},
				{
					"id": 721590402,
					"content": "Debí haberlo previsto. Tú continúas mejorando tu técnica, mientras que las restricciones de mi naturaleza impiden que yo siga adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590403
					],
					"speakerTitle": "Masanori"
				},
				{
					"id": 721590403,
					"content": "Aun así, si aprendes una nueva técnica, me gustaría verla.",
