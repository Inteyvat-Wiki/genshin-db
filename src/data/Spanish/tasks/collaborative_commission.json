			"dialogs": [
				{
					"id": 761290101,
					"content": "Jefa Néfer, Srta. Jahoda, gracias nuevamente por su ayuda al Gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "Es una colaboración, no hace falta que nos dé las gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290103,
					"content": "Sí, es cierto, pero aun así quiero agradecérselo por estar dispuesta a ayudar al Gremio con... las investigaciones más complejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarín"
				},
				{
					"id": 761290104,
					"content": "El Gremio de Aventureros también ha asignado bastante personal para ayudarnos en nuestro trabajo, es una situación donde todos ganamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290105,
					"content": "Espero que podamos seguir colaborando tan a gusto, Sr. Sarín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290106,
					"content": "No se preocupe, jefa Néfer, el Gremio de Aventureros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarín"
				},
				{
					"id": 761290107,
					"content": "Bueno, concretamente, el Gremio de Aventureros de Nod Krai es, sin duda alguna, un socio digno de confianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarín"
				},
				{
					"id": 761290108,
					"content": "Jaja, se nota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290109,
					"content": "(Muy bien, que la conversación fluya. Mi querida y preciosa jefa Nef, que no me mire, que no me mire, que no me mire...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, ¿por qué no dices nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290111,
					"content": "(¡Nooo! ¡Se dio cuenta! Pues que no mire el tablón de encargos, que no lo mire, que no lo mire...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "¿Eh? ¿Yo? ¡No tengo nada que decir! ¿Gracias por... darme el encargo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Pff, también debo agradecer su ayuda, Srta. Jahoda. Sin usted, los asuntos del Gremio se habrían acumulado como una montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarín"
				},
				{
					"id": 761290114,
					"content": "No hay de qué... Me pagan por esto, así que por supuesto que haré un buen trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(*Suspira*, seguro que ya se olvidó de todo lo que le enseñé...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290116,
					"content": "Ya que estamos aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290117,
					"content": "(¡Nooo! Estábamos teniendo tan buen rollo... ¡Olvídelo, jefa!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Sr. Sarín, ¿le importaría traernos el último lote de encargos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, elige un encargo, el que creas que hay que darle prioridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290120,
					"content": "Piénsalo bien y tómate tu tiempo, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761290121,
					"content": "S-sí, jefa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(¡Nooo!... ¡Estoy perdida!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
}