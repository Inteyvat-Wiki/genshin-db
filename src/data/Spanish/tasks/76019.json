			"dialogs": [
				{
					"id": 760190301,
					"content": "... Si van a matarme, hagan lo que quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190302,
					"content": "#Eh, ¡Ni Paimon ni {NICKNAME} hacemos esas cosas tan terribles! Nos basta con saber que no volverás a estafar a la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190303,
					"content": "Ni siquiera a alguien tan ingenuo como Vieri... ¿Eh? ¿Cuándo se ha escabullido? E-en fin... No engañes a la gente, aunque sean ingenuos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190304,
					"content": "Qué buen corazón tienen. *Suspira*, si hubiera encontrado gente tan buena como ustedes cuando estaba en Sumeru, tal vez no habría acabado así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190306,
					"content": "¿No sienten curiosidad por saber qué me pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190307,
					"content": "Mi intuición me dice que es mejor no saberlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "#Qué muchachit{F#a}{M#o} tan avispad{F#a}{M#o}... *Suspira*, hace mucho que no consigo un buen negocio. Tal vez sea la hora de cambiar de oficio. Al fin y al cabo, no quiero atraer la atención del Gremio Voynich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190310,
					"content": "¡Si hubieras llegado antes a esa conclusión, no habríamos tenido que darte una tunda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190311,
					"content": "Las decisiones que afectan a la vida vienen siempre en un punto de inflexión, ya sea bueno o malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190312,
					"content": "#Muchachit{F#a}{M#o}, chica voladora... Si algún día necesitan una oportunidad así, vengan a buscarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190313,
					"content": "¡S-será mejor que no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190314,
					"content": "Hidimbi deja la seda roja y se marcha haciendo un gesto con la mano...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 760190308,
					"content": "Te preguntaré por dos millones de Mora.",
					"roleType": "TALK_ROLE_PLAYER",
