					"speakerTitle": "Vieri"
				},
				{
					"id": 760190222,
					"content": "Un momento... ¿Hidimbi?... ¡Tú eres la mujer que estafó a Netochka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190223,
					"content": "Paimon solo quería enterarse de si conocían alguna pista del tesoro, ¡pero no esperaba encontrarse a una embaucadora como tú! ¡Y a un inútil!",
					"roleType": "TALK_ROLE_NPC",
