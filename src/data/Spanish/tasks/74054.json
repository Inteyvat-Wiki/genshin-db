			"dialogs": [
				{
					"id": 740540801,
					"content": "Mover la palanca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#¡Aah! ¿Qué haces, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540803,
					"content": "Mueves la palanca sin dudar.\\nAl instante siguiente, acompañada de un rugido desgarrador como un trueno, la torre entera comenzó a sacudirse violentamente, como si los cielos se desmoronaran y la tierra se partiera.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "Y... *plof*, la máquina escupe una pila de cinta perforada que cae justo en tu mano.\\nTodo vuelve a la mera tranquilidad.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "¿Eso es todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540806,
					"content": "Emm... Paimon no entiende ni jota de lo que pone, pero parece que es muy importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}, ¿nos quedamos con estas cintas? Puede que nos sirvan en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
