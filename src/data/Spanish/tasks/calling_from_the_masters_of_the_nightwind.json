						150240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240905,
					"content": "#¡Paimon acaba de ver un destello por allí! ¿Tú has visto algo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240906
					],
					"speakerTitle": "Paimon"
				},
				{
