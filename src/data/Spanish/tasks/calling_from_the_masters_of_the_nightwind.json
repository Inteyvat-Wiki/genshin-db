						],
						"pointId": 9383
					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "Uff... ¡Por fin salimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240702,
					"content": "#Parece que amb{F#a}{M#o}s poseen la capacidad de asumir esta misión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240703,
					"content": "¿Has logrado confirmar tu hipótesis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "Así es. Vieron muchos pergaminos de tela ahí dentro, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240705,
					"content": "La verdad es que sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240706,
					"content": "He estudiado meticulosamente esos pergaminos de tela legados por nuestros ancestros, y he descubierto que todos ellos poseen un color que no presentan los más comunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240707,
					"content": "Dicho color es tan misterioso que incluso yo debo recurrir a ciertos métodos especiales para confirmar su existencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240708,
					"content": "#Pero existe cierto tipo de personas que tienen la capacidad innata de reconocer este color. Precisamente esa era mi intención al ponerl{F#a}{M#o}s a prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240709,
					"content": "¿Quieres decir...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240710,
					"content": "El lugar en el que acaban de estar es una sala de exposición de tales pergaminos de tela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240711,
					"content": "Hace siglos, una gran chamana llamada Huitzilin restringió el acceso a la sala de exposición, por lo que si algún forastero entraba sin permiso, quedaría atrapado en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240712,
					"content": "Tal restricción sigue vigente hasta hoy en día. Puede que yo mismo no comprenda del todo su funcionamiento, pero sí he hallado la forma de activarla y desactivarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240713,
					"content": "Una vez atrapada dentro, si la persona no cuenta con ayuda del exterior, le será casi imposible escapar... A no ser que, al igual que la gran chamana, posea la capacidad de distinguir ese color.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240714,
					"content": "Creo que sé a qué te refieres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "Parece que tú también posees esa capacidad... Lo que quiere decir que el Anciano Iktomisaurio debe poder identificar a aquellos que la compartan, y es así como designa a los elegidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240717,
					"content": "¿Cuántos secretos más tienes que Paimon desconoce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240718,
					"content": "Pero, con esa habilidad o no, el hecho sigue siendo que no sabemos ni por dónde empezar a bordar un pergamino de tela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240719,
					"content": "No se preocupen por eso. Comparé la técnica, y bordar un pergamino de tela así no difiere demasiado de la elaboración de uno normal y corriente. La diferencia principal reside en los tintes y en la pigmentación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240720,
					"content": "Si mi hipótesis es correcta, la clave para crear este tipo de pergamino de tela está en la utilización de este tinte especial. Su obtención, no obstante, depende únicamente de ustedes dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240721,
					"content": "#En cuanto al proceso de pigmentación... una vez que tengan los tintes, no debería haber mayor problema. Yo l{F#a}{M#o}s guiaré cuando deban realizar dicha tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240722,
					"content": "¡Señor, sí, señor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240723,
					"content": "Bueno, aprovechen su habilidad para encontrar los tintes que necesitan. Mientras, haré que alguien prepare pergaminos de tela para probar los pigmentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240724,
					"content": "Primero fabricaremos algunas muestras para confirmar mi hipótesis. Si estoy en lo cierto, podremos empezar de forma oficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240725,
					"content": "Cuando hayan terminado, les entregaré una generosa recompensa para agradecerles su ayuda. ¿Qué les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240726,
					"content": "Un gran poder conlleva una gran responsabilidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "¡Sí! ¡Encima tendremos una recompensa! Por cierto, ¿la recompensa incluye algún manjar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240728,
					"content": "Este asunto es de suma importancia para nosotros los Augures Vientonocturno. Estoy dispuesto a entregarles una gran suma de dinero como muestra de gratitud, así que una buena comida no es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240729,
					"content": "¡Yuju! Por cierto, ¿dónde deberíamos ir a buscar los tintes? Paimon espera que no tengamos que recorrer toda Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240730,
					"content": "Claro que no, durante los preparativos previos, descubrí cierto lugar donde podría existir dicho pigmento, por lo que les he asignado un guía que los lleve hasta allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240731,
					"content": "#Si están list{F#a}{M#o}s, pueden partir enseguida. El guía l{F#a}{M#o}s estará esperando fuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240715,
					"content": "Ese color...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
