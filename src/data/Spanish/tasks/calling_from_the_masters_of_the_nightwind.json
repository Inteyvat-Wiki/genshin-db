					"content": "Puede que sea la forma de salir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240907
					]
				},
				{
					"id": 150240907,
					"content": "He visto algo que antes no podía ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240908
					]
