			"dialogs": [
				{
					"id": 150240101,
					"content": "¿Eh? ¡Parece que hay algo escondido detrás de la estatua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240102,
					"content": "¿Es una cría de Iktomisaurio? Qué adorable... Aunque a Paimon le gustaría saber por qué se ha quedado mirándonos así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240103,
					"content": "#¡{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240104,
					"content": "(¿Dónde estoy?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240105
					]
				},
				{
					"id": 150240105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240106
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240106,
					"content": "(¿Quién eres tú?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240107
					]
				},
				{
					"id": 150240107,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240108,
					"content": "Ay... ¿Cuánto tiempo ha pasado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240109,
					"content": "#{NICKNAME}, Paimon y esa cría de Iktomisaurio se quedaron mirándose fijamente y ¡Paimon acabó transportada a un lugar muy extraño donde vio a un Iktomisaurio gigante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240110,
					"content": "A mí también me ha pasado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "¿Cómo es eso posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240112,
					"content": "#{NICKNAME}, ¿qué pasa ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240113,
					"content": "Sigue ahí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "#¡Mira! Es esa cría de Iktomisaurio. Parece que quiere que lo sigamos. Como aventurer{F#a}{M#o}s que somos, ¡debemos llegar al fondo de este asunto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240116,
					"content": "¡Vamos, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "Parece que nos está llamando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				}
			]
		},
