				]
			},
			"dialogs": [
				{
					"id": 150240201,
					"content": "Paimon no sabe si los forasteros pueden acceder a este lugar... ¿Cómo es que la puerta se ha abierto sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240202,
					"content": "¡Guau! ¡Es el Iktomisaurio de antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240203,
					"content": "El que me llamó...",
