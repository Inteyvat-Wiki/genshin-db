			"dialogs": [
				{
					"id": 150240301,
					"content": "Hola, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240303,
					"content": "¿Puede entendernos? Parece un poco alelado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240304,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240305,
					"content": "¡Perdón! ¡Paimon no quería ofenderte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240306,
					"content": "¿Quién anda ahí? ¡No le falten el respeto a un anciano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240308,
					"content": "#Quiere decir que... Ya entiendo. Veo que he sido imprudente, pues ustedes son nuestr{F#a}{M#o}s invitad{F#a}{M#o}s. Debería darles una cálida bienvenida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240309,
					"content": "Permítanme que me presente oficialmente. Me llamo Caholom, y soy uno de los sacerdotes de los Augures Vientonocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240310,
					"content": "Este es el actual Gran Anciano Iktomisaurio, el ilustre Tlapopoctiztetl, el tótem viviente de los Augures Vientonocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240311,
					"content": "Qué nombre tan largo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240312,
					"content": "La gente de nuestra tribu suele referirse a él como “Anciano Tlapo”, así que ustedes también podrían llamarlo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240313,
					"content": "Qué manera tan especial de invitarnos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "Oh, hablan de la habilidad del anciano, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240315,
					"content": "El Anciano Tlapo ha vivido durante siglos. Ni siquiera un sacerdote como yo puede discernir los secretos que entraña, así que no se preocupen si sienten cierto grado de confusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240316,
					"content": "#Pero de algo sí estoy seguro: el Anciano Tlapo les ha asignado un importante cometido. Por eso, espero poder invitarl{F#a}{M#o}s a participar en una prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240317,
					"content": "¿Cometido? ¿Prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240318,
					"content": "Si les parece bien, síganme a ver al jefe de la tribu. Él podrá responder a sus preguntas mejor que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240319,
					"content": "Humm... Está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240320,
					"content": "Muy bien. Síganme, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240401,
					"content": "Al usar este pergamino de tela, podrán llegar directamente al Altar de Obsidiana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240402,
					"content": "No se alarmen, es solo uno de los muchos trucos místicos que usamos en la tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caholom"
				}
			]
		},
