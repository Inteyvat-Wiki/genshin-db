							9709.844
						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "¡Vaya! ¿Qué era eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240502,
					"content": "Es una de las tareas rutinarias de los sacerdotes. Intentamos comunicarnos con los espíritus de nuestros ancestros en busca de revelaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240503,
					"content": "El jefe se encuentra en ese lugar. Esperen aquí mientras le informo, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240504,
					"content": "Bueno, tal y como Paimon esperaba, los Augures Vientonocturno son una tribu de lo más misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240505,
					"content": "Ya he informado al jefe de la situación, por lo que ya pueden hablar con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240506,
					"content": "#¿Ustedes son l{F#a}{M#o}s elegid{F#a}{M#o}s para realizar el cometido? Yo soy Biram, el jefe actual de los Augures Vientonocturno. Sean bienvenid{F#a}{M#o}s y gracias por su paciencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240507,
					"content": "Qué alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240508,
					"content": "Llegué a este mundo con una estatura bastante inusual, pero no es causa de alarma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240509,
					"content": "¡Claro que no! Paimon solo estaba sorprendida y siente si te ha ofendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240510,
					"content": "¿Qué es ese cometido del que hablan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "#Caholom ya me ha explicado la situación en sí, por lo que entiendo que tengan dudas. Amb{F#a}{M#o}s vienen de fuera, así que es natural que no sepan lo que es un “cometido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240512,
					"content": "#En toda nuestra larga historia, los anteriores elegidos para realizar el “cometido” siempre han sido miembros de los Augures Vientonocturno. Esta es la primera vez que designan a un{F#a}{M#o}s foraster{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240513,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240514,
					"content": "Permítanme explicárselo. En los Augures Vientonocturno tenemos la inmemorial tradición de bordar pergaminos de tela en los que registramos la historia de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240515,
					"content": "Esto no solo se aplica a los sucesos de nuestra tribu, sino que también incluimos las leyendas y hazañas heroicas de las demás tribus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240516,
					"content": "Así ha sido durante los últimos mil años, y esa consideramos que es nuestra misión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240517,
					"content": "Aunque, en el caso de que se produzca un gran evento que sacuda toda Natlan, lo registramos en un pergamino de tela extremadamente especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240518,
					"content": "Un pergamino de tela así solo puede ser completado por aquellos designados por el Gran Anciano Iktomisaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240519,
					"content": "Cuando el Gran Anciano Iktomisaurio observa un cambio importante en las líneas ley, nos entrega un cometido y elige a aquellos que crearán dicho pergamino de tela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240520,
					"content": "¿Eso quiere decir que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240521,
					"content": "El actual Anciano Tlapo observó un cambio en las líneas ley hace mucho tiempo, pero no había designado a nadie hasta que ustedes llegaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240522,
					"content": "#Paimon ya entiende... Pero {NICKNAME} y Paimon no saben cómo bordar pergaminos de tela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240523,
					"content": "Eso no me sorprende lo más mínimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240524,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240525,
					"content": "En los doscientos años que el Anciano Tlapo lleva determinando quiénes son los elegidos de tal cometido, nunca ha seleccionado a nadie que entienda sobre el bordado de los pergaminos de tela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240526,
					"content": "¿Entonces nadie ha registrado los eventos importantes de los últimos doscientos años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240527,
					"content": "No, todas las personas designadas lograron llevar a cabo su cometido, aunque la mayoría afirmaron que no lo habían bordado ellos, sino que habían recibido un “obsequio de los espíritus”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240528,
					"content": "Eh... Ya decía Paimon que los Augures Vientonocturno son una tribu de lo más misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240529,
					"content": "Aunque, eso es lo que me inquieta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240530,
					"content": "Que una tarea tan importante como registrar los acontecimientos de la historia dependa de algo tan esotérico como recibir el “obsequio de los espíritus”... es preocupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240531,
					"content": "Eh, Paimon no se esperaba oír al jefe de los Augures Vientonocturno decir algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240532,
					"content": "Entiendo por qué piensan eso. Para ustedes, los Augures Vientonocturno irradian misterio por los cuatro costados, por lo que deben creer que sus habitantes admiran todo lo relacionado con los enigmas y lo arcano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240533,
					"content": "En efecto, yo represento una excepción. Aunque soy el jefe de los Augures Vientonocturno, mi postura es la de reformar todas estas tradiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240534,
					"content": "Yo me dedico a descifrar todo lo misterioso para poder establecer reglas concisas y salvaguardar el legado de nuestra tribu durante el mayor tiempo posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240535,
					"content": "Vaya, eso suena increíble... Entonces, ¿has logrado descifrar de qué se trata el “obsequio de los espíritus”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240536,
					"content": "No... Llevo mucho tiempo investigando el asunto, pero no he descubierto a qué se refiere dicho obsequio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240537,
					"content": "Los grandes acontecimientos que deben quedar registrados en un pergamino de tela así pueden contarse con los dedos de las manos, y el tiempo que pasa entre estos puede superar varias décadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240538,
					"content": "Cuando llega un nuevo cometido, la tribu suele haber cambiado de jefe. Por tanto, no hemos tenido la oportunidad de realizar una investigación más exhaustiva al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240539,
					"content": "Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240540,
					"content": "Puede que no tenga la visión completa del proceso, pero sí he logrado algún avance. Es solo que necesito que los elegidos me permitan poner a prueba mis suposiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240541,
					"content": "Por eso tenemos que aceptar una prueba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "#Exacto. Pero no tienen por qué preocuparse: dicha prueba solo tiene como objetivo verificar mi hipótesis, y no debería costarles demasiado, ni mucho menos ponerl{F#a}{M#o}s en peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240543,
					"content": "¿En qué consiste la prueba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "#Puedo llevarl{F#a}{M#o}s hasta el emplazamiento de la prueba para explicárselo allí. Pero esperen a que me quite el manto custodiaalmas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240545,
					"content": "Esta es una reliquia transmitida de generación en generación por los jefes de la tribu. Solo se me permite llevarla cuando dirijo las diferentes ceremonias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240546,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240547,
					"content": "Biram se despoja del manto de plumas y se lo entrega cuidadosamente a un sacerdote para que lo guarde.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "Vengan conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240549,
					"content": "¿Ven este pergamino de tela? Si lo tocan, accederán a un lugar secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240550,
					"content": "La prueba que van a aceptar trata de encontrar la manera de escapar de dicho lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240551,
					"content": "¿Solo es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240552,
					"content": "#Les aconsejo que no subestimen la prueba. Si no logran escapar, yo mismo l{F#a}{M#o}s ayudaré a regresar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240553,
					"content": "Pero de ser así, el cometido seguirá siendo un acertijo difícil de desentrañar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240554,
					"content": "Deja que lo intentemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "Está bien. Cuando quieran, toquen el pergamino de tela para comenzar la prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
		{
			"id": 1502406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502409",
							"2"
						],
						"stepId": 1502409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Biram"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150240601,
					"content": "#Si están preparad{F#a}{M#o}s, pueden empezar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
		{
