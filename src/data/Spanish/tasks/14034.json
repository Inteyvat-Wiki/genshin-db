			"dialogs": [
				{
					"id": 140340101,
					"content": "Finalmente, llegan a los alrededores de la igl{RUBY#[D]el sótano}esia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Papel de Clorinde"
				},
				{
					"id": 140340102,
					"content": "Hay una atmósfera siniestra a su alrededor, lo que les sugiere que el enemigo está cada vez más cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Papel de Clorinde"
				},
				{
					"id": 140340103,
					"content": "(Qué extraño... Me siento realmente incómoda... ¿Cómo lo hace?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "Ha llegado el momento del combate final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Papel de Clorinde"
				},
				{
					"id": 140340105,
					"content": "De acuerdo, en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Cazador Fantasmal"
				},
				{
					"id": 140340106,
					"content": "Florián, espera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340108,
					"content": "Espéranos fuera, no entres. El Devorador de Almas ya te poseyó una vez. Eso quiere decir que puede volver a adueñarse de tu conciencia con facilidad y controlar tu cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "Además, al estar tan cerca de él, podrías convertirte en cualquier cosa si vuelve a corromperte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "Precisamente por eso, yo soy quien debería ir delante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340111,
					"content": "... ¿Acaso piensas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Exacto, voy a atraerlo hacia mi cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340113,
					"content": "Eso es demasiado peligroso. En el peor de los casos, tendría que matarte. ¿Eres consciente de la gravedad de la situación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Lo entiendo. Si es que eso ocurre, ya saben lo que tienen que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340115,
					"content": "No dejará escapar a un cuerpo que se puede controlar fácilmente. Así no tendrán que considerar la posibilidad de que un compañero sea poseído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Clorinde, a diferencia de mí, eres una Cazadora Fantasmal franca y poderosa. Esto ha sido culpa mía, así que debería ser yo quien cargue con la responsabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340118,
					"content": "Mejor dicho... es mi deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340119,
					"content": "Tómalo como un duelo al que te desafío por mi propio honor. Por favor, no seas indulgente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340120,
					"content": "... Como quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Florián, como verduga del justiciazgo, acepto tu solicitud de duelo y te presento mis respetos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "... Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florián"
				},
				{
					"id": 140340123,
					"content": "Vámonos, es hora de ponerse manos a la obra. Dejemos que los monstruos vuelvan a temblar bajo las espadas de los Cazadores Fantasmales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
