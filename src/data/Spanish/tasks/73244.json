					"nextDialogs": [
						732441505
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441505,
					"content": "*Crin... Crin-crin*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441506
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441506,
					"content": "¿Benben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441507
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441507,
					"content": "Benben se conecta al condensador de conversión energética y extrae rápidamente la energía que contiene.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732441508
					]
				},
				{
					"id": 732441508,
					"content": "*Crin-Crin*... *Crin-Crin*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441509
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441509,
					"content": "¡Guau! ¡Benben ha resucitado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441510,
					"content": "¿Qué dices, Paimon? Benben simplemente se ha despertado de un largo sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441511
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441511,
					"content": "*Crin*... *Crin-Crin*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441512
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441512,
					"content": "Qué va, para nada me he preocupado. ¡Sabía que te ibas a despertar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441513
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441513,
					"content": "*Ejem*, “ya no pienso volver a dejarlo solo...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441514,
					"content": "¡Paimon, no me imites!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441515
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441515,
					"content": "*Crin-Crin*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441516
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441516,
					"content": "#¡Ah, sí! {NICKNAME}, Benben dice que muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441517
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441517,
					"content": "Aunque Benben estuviera inmóvil, parece que era consciente de todo lo que estaban haciendo por él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441518
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441518,
					"content": "No hace falta que nos des las gracias, Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441519
					]
				},
				{
					"id": 732441519,
					"content": "¡*Crin-crin*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441520
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441520,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441521
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441521,
					"content": "¿Qué pasa, Yeht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441522,
					"content": "Nada, que aunque Benben haya despertado, todavía necesita recuperarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441523
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441523,
					"content": "Claro. ¡Descansa mucho, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441524,
					"content": "*Crin-crin*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benben"
				}
			]
		},
