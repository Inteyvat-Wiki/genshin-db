			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "No puede ser... Cómo he podido haberme olvidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440102,
					"content": "Espero llegar a tiempo. Empezaré buscando alguna pista en su tienda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440103,
					"content": "¡Yeht! ¿Qué está pasando? ¿A dónde vas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440104,
					"content": "#Paimon y {NICKNAME}... Llegan justo cuando l{F#a}{M#o}s necesito. Tengo que encargarme de un asunto. Voy a ir... al lugar donde acampa Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440105,
					"content": "¿Aderfi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440106,
					"content": "¿No es ese traidor que colaboró con los Fatui? ¡Ah, Paimon ya sabe! ¡Quieres ir a hurgar en su tienda para ver si dejó algún tesoro interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440107,
					"content": "No, no me interesa en absoluto lo que dejó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440108,
					"content": "La tribu tiene sus propias reglas para tratar con las pertenencias de los traidores como Aderfi. ¡Arg!... Si no fuera por la tribu, no dudaría en prenderle fuego a todas las cosas de ese tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440109,
					"content": "Pero ahora necesito ir a su tienda porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440110,
					"content": "Es por Benben, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "¡Oh, es verdad! ¡Benben aún sigue donde Aderfi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440112,
					"content": "Yeht... ¡¿Cómo se te ocurrió dejarlo en manos de un tipo como ese?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440113,
					"content": "*Suspira*, p-pues en aquel momento no sabía que era un traidor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440114,
					"content": "El caso es que tengo que pasarme por su tienda cuanto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}, vayamos con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440116,
					"content": "No hay tiempo que perder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "Vamos, Paimon espera que Benben esté bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440117,
					"content": "¡En marcha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Miren, aquí hay algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440302,
					"content": "Pero más que notas de una evaluación, parece que es una carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440303,
					"content": "¿Una carta? ¿A ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440304,
					"content": "Pues según lo que dice la carta, Benben simplemente se quedó sin energía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440305,
					"content": "#Ahora que Paimon lo piensa, Benben nos ayudó a abrir las puertas del Mausoleo del Rey Deshret, a activar las autorizaciones... Realmente hizo mucho por nosotr{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440306,
					"content": "Pues sí... Nos olvidamos de que las criaturas mecánicas como Benben también se pueden cansar. Habrá gastado todas sus fuerzas en ayudarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440307,
					"content": "En la carta también se menciona algo sobre unos condensadores de conversión energética especiales, pero en la tienda no vi nada parecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440308,
					"content": "¿Será que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440309,
					"content": "¿... Están escondidos en alguna parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "No creo, si solo es para reparar a Benben, no le habría hecho falta esconderlos, los habría utilizado directamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440311,
					"content": "¡Ya sé! ¡Seguro que esta transacción aún no se ha llevado a cabo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440314,
					"content": "Aderfi no se llevó a Benben al lugar de la reunión, así que es lógico que aquí no haya ningún condensador de conversión energética... Ahora la pregunta es: ¿con quién hizo el trato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440315,
					"content": "Vaya, ¡qué pregunta más tonta acabo de hacer! Solo hay un tipo de personas que haría tratos con él fuera de la tribu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440316,
					"content": "¿Quiénes? ¿Los eruditos de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "¡Son los Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440320,
					"content": "¿Y qué hacemos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440321,
					"content": "Con los Fatui no hay manera de negociar. Solo tenemos que ir al lugar de la reunión, ¡y arrebatarles los condensadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440322,
					"content": "¡Eso! ¡Vamos por ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440323,
					"content": "#Pero tal y como está Benben... sería complicado llevárnoslo con nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440324,
					"content": "Y trasladarlo a otro lugar tampoco me parece seguro. Además, no pienso volver a dejarlo solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440325,
					"content": "#Hagamos esto. Nosotr{F#a}{M#o}s asaltaremos a los Fatui, ¡y tú te quedarás aquí con Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440326,
					"content": "¡Buena propuesta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "¡A asaltar a los Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440330,
					"content": "#{NICKNAME}, Paimon, me hubiese encantado ir yo misma, pero por el bien de Benben... ¡tendré que encargárselo a ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440331,
					"content": "Y... Sé que solo son unos cuantos Fatui, pero no bajen la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440332,
					"content": "#¡No te preocupes! ¡Puedes confiar en nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440333,
					"content": "De acuerdo. No quiero que Benben se quede en la tienda de ese traidor, así que lo llevaré a la mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440334,
					"content": "Cuando tengan los condensadores de conversión energética, ¡vengan a buscarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440328,
					"content": "¡Será pan comido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Jeje, ¡así se habla! Tampoco es que sea la primera vez que asaltamos a alguien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440318,
					"content": "¡Los Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "Exacto, ¿quiénes iban a ser si no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440312,
					"content": "¿... Aún no los consiguió?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "Ahh, ya sé a lo que te refieres. ¡Esta transacción aún no se ha llevado a cabo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Yeht"
				}
			]
		},
