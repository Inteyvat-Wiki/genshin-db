			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "Ay... De-detente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441702,
					"content": "Para, por favor. Me vas a dejar sin vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441703,
					"content": "Suena convincente cuando eres el que está recibiendo la paliza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "¡Habla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "¡Eso, habla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "Está bien, está bien. ¡Se lo contaré todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441707,
					"content": "¡Empezando por eso que tú ya sabes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "Hace mucho que hacemos tratos con Aderfi... Y-y parecía que la matriarca de los Tanit mostraba cierto favoritismo por Azariq... y por la muchacha nueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441709,
					"content": "Y no sé por qué, pero Azariq también ha desaparecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441710,
					"content": "Esa mujer es perversa. No tiene piedad de los que ya no son útiles para la tribu... Por eso, para conservar su estatus, Aderfi se puso en contacto con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441711,
					"content": "Nuestro trabajo en el desierto no iba muy bien, hasta que... hasta que llegamos a un acuerdo con Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441712,
					"content": "“Ya no son útiles para la tribu”... ¿Qué quieres decir con eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "No lo sé... ¡Te lo prometo! Son asuntos internos de la gente del desierto... Pero según mis conjeturas, es porque esa mujer no se fía de nosotros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441714,
					"content": "Por eso comenzó a distanciarse... Eso hizo que Aderfi, que solía mantener mucho contacto con nosotros, se sintiera inseguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441715,
					"content": "Nosotros podemos cortar lazos con esta maldita tribu en cualquier momento, pero a él lo seguirán utilizando a su antojo hasta que ya no sea útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441724,
					"content": "Es un tipo muy astuto. Se lleva las cosas que nos pide, pero nunca trae nada de lo que nosotros le pedimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441725,
					"content": "En fin, me dijeron que se metió en problemas. No sé exactamente en cuáles, pero supuse que podría ser una buena oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441726,
					"content": "¿Una oportunidad para qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "Asumimos que ya no íbamos a tener más negocios con él, así que le pedimos que nos trajera esa Creación Primigenia especial que mencionó varias veces en las cartas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441728,
					"content": "Si pudiéramos arrebatársela, al menos no nos iríamos con las manos vacías cuando abandonemos este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441729,
					"content": "¿Qué? ¿Ustedes también? Con razón Paimon no ha visto ni rastro de mercancías ni de esos condensadores de conversión energética.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "Un momento. ¿Cómo que “también”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441731,
					"content": "Pues lo que oyes, entréganos los condensadores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "¡No le digas a Paimon que te inventaste lo de los condensadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "No, son reales. Sin embargo, hay muchos, y como son objetos antiguos, no sabemos si alguno de ellos seguirá funcionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441735,
					"content": "¡Dinos dónde están!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Hoy estás muy imponente, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#¿Sí? Jeje... Ay, {NICKNAME}, no cambies de tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "Rapidito que no tenemos más tiempo. ¡¿Dónde están?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "... Están todos en una base no muy lejos de aquí. Aquí tienen la llave... Ya les conté todo lo que sabía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441740,
					"content": "¡Desaparece, grandullón!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "Está bien, está bien. Enseguida me voy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441741,
					"content": "¡No te quiero ver más por aquí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "#Hoy no debiste cruzarte con nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "¿En qué consiste su trabajo en el desierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "... Es confidencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441718,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#¿Ves? Ya hiciste enfadar a {NICKNAME}. Yo que tú, no {F#la}{M#lo} enojaría más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441720,
					"content": "Arg, está bien, está bien. No te enfades, por favor, te lo contaré todo. Aunque tampoco es que yo sepa mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441721,
					"content": "Nuestra misión es obtener información sobre la situación actual de las tribus que hay en el desierto y utilizar el comercio como cebo para ponerlas de nuestra parte... Queremos atraer la atención de los sabios, y así poder facilitar el trabajo de Los Once en la Ciudad de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441722,
					"content": "Además, el profesor Froderock sigue buscando especímenes en el desierto y nunca quiso obedecer las órdenes de El Doctor... A mi parecer, es por pura envidia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "Negociador Fatui"
				},
				{
					"id": 732441723,
					"content": "*Ejem*, me estoy yendo por las ramas... En resumen, Aderfi es nuestro contacto para esos negocios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Negociador Fatui"
				}
			]
		},
