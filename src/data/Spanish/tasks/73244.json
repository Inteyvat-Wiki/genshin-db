			"dialogs": [
				{
					"id": 732440801,
					"content": "¡Yeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440803,
					"content": "¿Cómo fue? ¿Se encuentran bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440802
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732440802,
					"content": "Sí, estupendamente. Mira, ¡aquí están los condensadores de conversión energética!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7324410,
			"completionStepIds": [
				7324419
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324419",
							"2"
						],
						"stepId": 7324419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yeht",
					"Benben"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "Mira, ¡es Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441002,
					"content": "Por suerte, no tuvo tiempo de llevarse a Benben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441003,
					"content": "Aquí todo sigue exactamente igual que antes, nada ha cambiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441004,
					"content": "¿De verdad creía que iba a ser capaz de derrocar a la matriarca y volver sano y salvo a su tienda? Qué estúpido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441005,
					"content": "Pero gracias a su estupidez, Benben está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441006,
					"content": "¿Que está bien? ¿No ves que...? ¡Benben, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441007,
					"content": "¿Cómo es posible?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Humm, está inmóvil en el suelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441010,
					"content": "¿Qué le ha pasado? La última vez que lo vimos estaba en perfecto estado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441011,
					"content": "Tras abandonar la Sala de la Coronación, Benben se fue debilitando poco a poco. Parecía como si alguno de sus componentes no funcionara correctamente, y el sonido de sus pitidos era cada vez menor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441012,
					"content": "Hasta que al final se quedó sin sonido e incluso dejó de moverse. Era como si hubiera perdido poco a poco la fuerza vital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441013,
					"content": "En aquel momento, nadie en la tribu era capaz de entender lo que le estaba pasando a Benben, excepto Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441014,
					"content": "Así que lo dejé en sus manos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441015,
					"content": "No puede ser... B-Benben no se quedará así para siempre, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441016,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441017,
					"content": "#Benben sigue aquí con nosotr{F#a}{M#o}s. Estoy segura de que encontraremos una manera de arreglarlo, antes o después...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441018,
					"content": "Pero ni siquiera sabemos por dónde empezar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441019,
					"content": "Humm, déjame pensar. Recuerdo que Aderfi me dijo que si no era nada grave, en unos días podría sacar conclusiones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441020,
					"content": "Sabiendo cómo es, si hubiera hecho algún examen preliminar, seguro que habría anotado las conclusiones. ¡Busquemos por aquí a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441021,
					"content": "#Si de verdad no es nada grave, ¡quizás hasta lo podamos solucionar {F#nosotras mismas}{M#nosotros mismos}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441008,
					"content": "Benben... ¿Qué le pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
		},
