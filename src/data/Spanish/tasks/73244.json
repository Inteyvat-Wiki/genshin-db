			"dialogs": [
				{
					"id": 732441901,
					"content": "Condensadores de conversión energética... Espero que con eso, Benben se pueda recuperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441902,
					"content": "Si les preocupa algo, mejor voy con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441903,
					"content": "Quédate aquí con Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "De acuerdo. Les espero aquí. ¡Tengan muchísimo cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yeht"
				},
				{
					"id": 732441904,
					"content": "#Nosotr{F#as}{M#os} volveremos en seguida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
