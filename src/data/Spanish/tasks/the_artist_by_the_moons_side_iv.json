			"dialogs": [
				{
					"id": 761200101,
					"content": "... Toma. Esto es para ti. Con esto ya he cumplido con mi parte, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200102,
					"content": "¡Eh, eso es un lienzo! Es como si... ¿Acaso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ah, llegan justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200104,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "¡Pero si es Maalaus, la gran pintora! ¡Cuánto tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "¿Para qué llegamos justo a tiempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Acabo de llevar a Maalaus a la luna a dar una vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200108,
					"content": "Qué envidia... Por como lo has dicho, suena como si no fuera más que visitar el jardín de al lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Pero ¿para qué fueron a la luna? ¿Buscaban inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "En cierta medida. Pero también fuimos a elegir un lugar para la exposición. ¿Se acuerdan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200111,
					"content": "¡Ah, Paimon se acuerda! ¡Es la exposición sobre la Diosa Lunar de la gran pintora Maalaus! No se olviden de invitarnos llegado el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Claro. Además, parece que Maalaus puede percibir ciertos sutiles cambios a su alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200113,
					"content": "Y me ha dicho que he cambiado mucho desde que regresé de la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200114,
					"content": "Por eso quería que la llevara allí, para ver si tenía algo de especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200115,
					"content": "¡Oh! Eso haría un gran artista, sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "¿Y había algo especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "No estoy muy segura. Llevé a Maalaus a muchos sitios, pero ninguno pareció dejarla satisfecha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200118,
					"content": "Bueno, hasta que la llevé cerca de tu nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200119,
					"content": "¿La nave?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Tras llevarla más cerca, descubrí que no estaba interesada en la nave en sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200122,
					"content": "¿Eh? ¿Entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Se ha puesto a volar a tu alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Jaja, eso hizo en ese momento también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200126,
					"content": "Sospecho que su interés nació de mi reacción al ver la nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200127,
					"content": "¿Tu... reacción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Sí, me recordó a cuando {NICKNAME} y yo estuvimos allí junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200129,
					"content": "#Nos sentamos sobre la nave mientras contemplábamos Teyvat. {F#Ella}{M#Él} descubrió la verdad sobre su pasado y yo hallé mi hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200130,
					"content": "Con solo pensarlo me invade una sensación de paz... o quizás, de felicidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200131,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Sí, tienes razón. No es algo que había sentido antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200133,
					"content": "Entonces, le conté a Maalaus nuestra historia, incluyendo lo que sucedió después de que llegáramos a la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200134,
					"content": "Después de eso, parecía muy complacida, como si hubiera encontrado la inspiración que tanto anhelaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200135,
					"content": "Ah... Entonces es hora de que la gran pintora se ponga manos a la obra, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Como no llevaron a Paimon a la luna, tiene mucha curiosidad por saber qué pintará Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "¿Qué tipo de materiales necesitará esta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Los de esta vez son bastante especiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200139,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus dice que quiere pinturas que sean solo nuestras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200141,
					"content": "¿Y eso qué significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "Creo que se refiere a las cosas que te recordarán a este viaje, sus frutos y la alegría que te ha traído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200143,
					"content": "No te preocupes, Maalaus solo quiere ver y sentir esos objetos. No usaría algo tan preciado para pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200144,
					"content": "¿Tú qué le diste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Polvo de la luna y la tarjeta que me dieron en la Noche Rezolunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761200146,
					"content": "#Oh, entonces debería ser algo que represente esta aventura, ¿no? Bueno, ¡tú eliges, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Bueno, eso sí que es especial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
