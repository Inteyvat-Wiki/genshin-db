				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isadora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Ay, ¿dónde lo habré puesto? ¡Qué mala suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020102,
					"content": "Arg, no creo que sea capaz de escribirlo otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020103,
					"content": "¿Se te ha perdido algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Pues sí, pero soy optimista, así que espero que solo se me haya perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020105,
					"content": "¿A eso llamas tú optimismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Bueno, es que resulta que es el informe de contabilidad semestral de los gastos de la oficina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020108,
					"content": "Debo entregárselo pronto a la Srta. Keiser, pero me he dado cuenta de que le faltan cinco páginas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020109,
					"content": "Da la casualidad de que esas cinco páginas se corresponden precisamente con el balance de cinco meses diferentes e incluyen una buena cantidad de gastos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020110,
					"content": "Me di cuenta de que faltaban durante la última evaluación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020111,
					"content": "Si en realidad no los hubiera perdido por accidente y no los hubiera preparado directamente... ¿cómo podría haber obtenido las cifras de los gastos totales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020112,
					"content": "Ay, ni me atrevo a pensarlo. Si de verdad me olvidé de escribirlos, la Srta. Cadme me hará desenterrar los balances de la última década y revisarlos uno por uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020113,
					"content": "Suena a que es un problema grave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "Y lo es. Si no los escribí o los he perdido, afectará a unos cuantos departamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020115,
					"content": "Esto es mala suerte y lo demás son tonterías... Me pasé toda la noche haciendo esos balances para presentarlos hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020116,
					"content": "Pero cuando pasaba por aquí, una cantidad ingente de gaviones purpuráureos me sobresaltó y dejé caer los papeles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020117,
					"content": "*Suspira*, es probable que se perdieran entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020118,
					"content": "Te ayudaré a buscarlos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "¿De verdad vas a ayudarme? ¡Genial! Vamos, busquemos por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020121,
					"content": "No es como si fueran documentos confidenciales ni nada de eso, así que no te preocupes si te los encuentras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020122,
					"content": "¡Ah, por cierto! También me crucé con Muirne por el camino. Incluso me ayudó a espantar a los gaviones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020123,
					"content": "Deberíamos preguntarle si ha visto mis documentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020119,
					"content": "#Busquémoslos junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "¿Acaso perder algo es algo bueno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
		{
