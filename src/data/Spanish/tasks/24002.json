				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "¡Ah, son estos! ¡Oh, los Arcontes me han sonreído! Están todos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "¿Por qué estabas haciendo las cuentas en el café?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "Bueno, es que necesito mucho café para sumar todos esos gastos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "Estos son todos y cada uno de los gastos que ha registrado el Palacio Mermonia. Si lo sumas, es casi la cantidad de trabajo de cinco personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "Pero el problema es que el resto de los miembros del equipo suelen estar ocupados con tareas de otros departamentos, en viajes de trabajo o visitas oficiales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "Así que al final siempre me toca encargarme de las cuentas yo sola. ¡Llevo días sin poder dormir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Y no solo me dejaron a cargo de la contabilidad, también me encargaron poner en orden las facturas. Estoy tan cansada que hasta he empezado a ver borroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "Al menos ha recuperado los documentos. Vamos, Srta. Isadora, la escoltaré de vuelta al Palacio Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "#Muchísimas gracias, Srta. Muirne. *Suspira*, creo que {F#la viajera}{M#el viajero} y usted son las únicas buenas personas que he conocido en los últimos meses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020410,
					"content": "La gente se pasa el día gritándome y metiéndome prisa para que haga mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020411,
					"content": "Bueno, debería dejar de quejarme ya. Volvamos, no quiero que la Srta. Keiser me regañe de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				}
			]
		}
	]
}