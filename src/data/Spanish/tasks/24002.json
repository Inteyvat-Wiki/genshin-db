			"dialogs": [
				{
					"id": 240020201,
					"content": "Srta. Isadora, ¿puedo ayudarla en algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020202,
					"content": "Lo cierto es que sí, tengo una pregunta para usted. ¿Recuerda la pila de papeles que llevaba esta mañana cuando nos vimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020203,
					"content": "Sí, claro. Fue cuando la asustaron los gaviones purpuráureos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020204,
					"content": "¡Sí, exacto! Cuando por fin se marcharon, me fui a toda prisa a la oficina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020205,
					"content": "¿Recuerda haber visto algún documento por el suelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020206,
					"content": "Humm, la verdad es que no. Estaba bastante ocupada entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020207,
					"content": "Pero si le urge encontrarlos, siempre podemos volver a trazar el camino por el que fue esta mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020208,
					"content": "¿Eh? ¿De verdad no le importa? No me gustaría importunarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020209,
					"content": "Bueno, buscar documentos es una tarea mucho más sencilla que las que me atañen en el Palacio Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020210,
					"content": "Me parece recordar que llevaba organizados los documentos en pilas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020211,
					"content": "Así es, buena memoria. Hay que asegurar la precisión de los balances durante la evaluación de gastos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020212,
					"content": "Tenemos que listar todos los cargos del Palacio Mermonia, desde los grandes gastos como las reparaciones de la fachada hasta los más pequeños como el cambio del cerrojo de un cajón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020213,
					"content": "Como siempre acaban siendo demasiados, prefiero atar los gastos de cada mes en una pila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020214,
					"content": "Entonces no hay posibilidad de que una hoja haya salido volando, ¿no? Si se hubiera perdido algo, se habría perdido una pila entera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020215,
					"content": "Bueno, no hace mucho que pasó en dirección a la oficina, pongámonos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				}
			]
		},
