			"dialogs": [
				{
					"id": 190551701,
					"content": "Y ella se fue a ver a Yae Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "Eso es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551802,
					"content": "Se fue a la Comisión Kanjou a reunirse con Yae Miko. De cara al público dijeron que se trataba de una sesión de reseñas, pero el contenido de la reunión iba más allá de todo eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551803,
					"content": "Tan pronto como regresó, tomamos medidas para incentivar el comercio, y en la Isla Narukami se empezó a impulsar rápidamente la creación de un nuevo proyecto de ley arancelaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551804,
					"content": "Entonces, ¿qué piensas tú? ¿Crees que Su Excelencia sabe sobre esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
