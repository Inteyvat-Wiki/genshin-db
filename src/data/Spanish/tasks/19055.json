			},
			"dialogs": [
				{
					"id": 190550901,
					"content": "Todoroki, las mercancías ya llegaron, están listas para la inspección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190550902,
					"content": "Bien, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190550903,
					"content": "Oigan, es Todo... ¡Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190550904,
					"content": "¡Shh! No hagas ruido. Hay que seguirlo a escondidas y ver a dónde nos lleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shikanoin Heizou"
				}
			]
		},
		{
			"id": 1905510,
			"completionStepIds": [
				1905504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
