			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tokuda",
					"Todoroki",
					"Masashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "Tu información era correcta. Cuando llegamos, los Nobushi aún estaban en el quinto sueño, jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "Los capturamos a todos y trajimos las mercancías de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Les daré un vistazo. Humm... Todo parece correcto, bien hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "No fue nada. Gracias a los esfuerzos de tu caravana, el precio del grano en la aldea ahora es más bajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "Cierto, y quién iba a pensar que las heridas de guerra tendrían un efecto tan persistente en nuestros cuerpos. Pero por suerte, también trajiste medicamentos que nos salvaron la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Las cosas van mejor gracias al apoyo de los de arriba. Por cierto, ¿cómo va el inventario de la aldea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Asegúrense de confirmarlo esta noche. Tengo que partir mañana por la mañana después de ir al Santuario Sangonomiya a recibir instrucciones del General Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "No se preocupe. Ya preparamos la lista. Solo síganos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
