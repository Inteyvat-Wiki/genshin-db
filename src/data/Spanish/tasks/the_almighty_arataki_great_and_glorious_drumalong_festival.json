			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mamoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726847201,
					"content": "Soy Mamoru, el responsable de ambientación del Gran Festival de Tambores de Arataki. ¿Necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847202,
					"content": "¿Que a qué me dedico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847203,
					"content": "Bueno, la tarea del responsable de ambientación es crear una atmósfera agradable para que los visitantes disfruten al máximo del festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847204,
					"content": "Y bien, ¿estás disfrutando al máximo del festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847205,
					"content": "No, en absoluto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "Por favor... ¡No digas eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847208,
					"content": "¡¿Cómo puedes ser tan cruel?! Es como si me hubieran pegado un puñetazo en el estómago. Si así es como te sientes, mi trabajo no tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847209,
					"content": "Tú eres colega del jefe. Por favor, muestra algo de apoyo por la causa. Te lo suplico, ¡dilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847210,
					"content": "¿Que diga qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "Ya sabes, “Me estoy divirtiendo al máximo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847212,
					"content": "Me estoy divirtiendo al máximo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "¡Qué bien! ¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847214,
					"content": "¡Es el mejor reconocimiento del mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847218,
					"content": "¡Vamos, colegas! ¡Más música, más baile! ¡Que la fiesta no pare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847215,
					"content": "Me estoy divirtiendo tanto... tanto que... Lo siento, no me sale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "Vaya... Pues nada. Yo seguiré esforzándome. Todos los miembros de la Banda de Arataki lo están haciendo, así que no puedo rendirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847217,
					"content": "¡Por muy duro que sea el golpe, no me rendiré! ¡Eso es lo que dice el jefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847206,
					"content": "Ni de lejos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
	]
}