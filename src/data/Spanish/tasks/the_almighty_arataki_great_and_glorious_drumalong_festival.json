			"trigger": {
				"objectNames": [
					"Akira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726847101,
					"content": "Soy Akira, el registrador de comentarios del Gran Festival de Tambores de Arataki. ¿Tienes algún comentario que quieras hacernos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847102,
						726847103,
						726847104
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847102,
					"content": "Creo que no está nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847105,
					"content": "Muy bien. Gracias por tus comentarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847106
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847106,
					"content": "¿Eh? ¿Todavía tienes preguntas? Pues yo no tengo nada más que contarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847107
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847107,
					"content": "Humm... El jefe me dijo que mi trabajo consistía únicamente en decir “¿Tienes algún comentario que quieras hacernos?” y “Gracias por tus comentarios”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847108,
					"content": "Bueno, y si los participantes insisten en saber cuándo se atenderá a sus comentarios, también tenía que decir: “le daremos una contestación a la mayor brevedad posible”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847109
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847109,
					"content": "El jefe dijo que eso es lo que decían en los festivales a los que había ido. Seguro que tiene mucha experiencia en la materia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847110
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847110,
					"content": "Aunque a Shinobu le parecía un poco fingido, así que me dio este cuaderno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847111
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847111,
					"content": "Mira, hasta he anotado tu valoración. Cuando vuelva Shinobu, se la enseñaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847103,
					"content": "No está mal, pero creo que no es nada del otro mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847104,
					"content": "Podría ser mejor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				}
			]
		},
		{
			"id": 7268434,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
