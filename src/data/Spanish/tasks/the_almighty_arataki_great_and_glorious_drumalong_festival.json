			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirohiko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840501,
					"content": "¿En qué puedo ayudarles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840502
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840502,
					"content": "Estamos buscando a la Banda de Arataki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "Ah, sí... Supongo que también están aquí por el Sublime y Glorioso Blablabla de Arataki, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840504,
					"content": "¿“También”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "Sí, la Srta. Kujou Sara de la Comisión Tenryou y Yoimiya de Pirotecnia Naganohara vinieron también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840506,
					"content": "Yoimiya los vio preparando el lugar cuando vino a entregar unos fuegos artificiales. Supongo que le entró la curiosidad y fue a ver de qué se trataba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840507,
					"content": "En cuanto a por qué vino la Srta. Kujou Sara, de eso no estoy seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840508,
					"content": "#Guau, ¿otras personas llegaron antes que nosotr{F#as}{M#os}? Eso es una buena señal, {NICKNAME}, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840509,
					"content": "¿Y dónde está ahora la Banda de Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840510,
					"content": "Por desgracia, ya que no había ningún otro espacio disponible en la isla en ese momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840511,
					"content": "... tuvimos que ubicarlos en una pequeña llanura de marea al noroeste de la isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840512,
					"content": "Si lo hubieran solicitado con más antelación, les habríamos cedido una ubicación mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840513,
					"content": "Si se dirigen hacia el noroeste, los verán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirohiko"
				}
			]
		},
		{
			"id": 7268406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268406",
							"2"
						],
						"stepId": 7268406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "¡Jajaja! ¡Colegas! ¡Por fin llegaron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840602,
					"content": "Justo me estaba preguntando cuándo aparecerías, y entonces, ¡bum!, aquí estás. Me alegro de verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840603,
					"content": "Miren este sitio. ¿Qué dicen? ¿No es un sitio magnífico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840604,
					"content": "Está rodeado por el mar, el aire es fresco, no hay ruido ni contaminación de la ciudad y las vistas son simplemente espectaculares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840605,
					"content": "El lugar está situado detrás de la Isla Amakane, donde podemos disfrutar de acceso exclusivo al festival y a equipamiento de primera categoría del centro cultural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840606,
					"content": "Con excelentes conexiones de transporte por mar y tierra, es realmente fácil llegar allá donde se necesite, ya sea a pie o en barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840607,
					"content": "La verdad es que este sitio no está nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "En cuanto puse el ojo en este sitio, ¡sabía que era para nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840610,
					"content": "En ese instante, el mundo cambió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840611,
					"content": "¡Un aplauso para el jefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840612,
					"content": "Está claro que llegaron aquí porque la Comisión Tenryou los mandó a este sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840613,
					"content": "*Ejem*... Bueno, vayamos al grano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840614,
					"content": "#¡L{F#as}{M#os} invité aquí para asistir al Sublime y Glorioso Gran Festival de Tambores de Arataki! Un festival de gran prestigio, por si no lo sabían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840615,
					"content": "El jefe dijo que el primer objetivo del festival es promocionar la Banda de Arataki para reclutar nuevos miembros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840616,
					"content": "El segundo, ¡celebrar la graduación de Shinobu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840617,
					"content": "Y por último, pero no menos importante, compensar todos los eventos que dijimos que haríamos pero que cancelamos por falta de fondos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840618,
					"content": "Tres festivales en uno, ¡guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840619,
					"content": "Akira... Es mejor no volver a mencionar ese último punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840620,
					"content": "¿Y dónde está Shinobu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "Lo que pasa con los festivales es que hay que salir a promocionarlos a los cuatro vientos si se pretende atraer una buena multitud. Así que Kuki se fue a repartir panfletos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840622,
					"content": "¡Oye! Se supone que Shinobu debería ser la estrella del evento, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840623,
					"content": "¿Cómo es posible que ella esté deslomándose por ahí mientras tú te quedas aquí parado sin hacer nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840624,
					"content": "Oye, yo también me estoy esforzando, ¡para que lo sepas! ¡Yo estoy... recibiendo a los invitados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840625,
					"content": "En realidad el jefe acaba de volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840626,
					"content": "Dijo que estaba esperando a que llegaran en cualquier momento, así que regresó para darles la bienvenida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840627,
					"content": "Antes de eso, estuvo fuera junto con Shinobu dejándose el pellejo para atraer a más gente al festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840628,
					"content": "Solo cumplía con mi cometido. Ni más ni menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840629,
					"content": "Guau, el toreritto este por fin se puso a trabajar. Paimon está gratamente sorprendida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840630,
					"content": "Hum, y a mí me sorprende que una minicalavanda flotante se preste a poner sobrenombres tan infantiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Bueno, colega, ¿tienes alguna pregunta sobre el festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840608,
					"content": "Tan optimistas como siempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
		{
			"id": 7268407,
			"completionStepIds": [
				7268407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
