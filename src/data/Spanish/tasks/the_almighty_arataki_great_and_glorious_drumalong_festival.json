			"dialogs": [
				{
					"id": 726840654,
					"content": "Nos dijeron que Kujou Sara también estaba por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840655
					]
				},
				{
					"id": 726840655,
					"content": "¿Eh? ¿Te refieres a esa tengu tan tonta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840656
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840656,
					"content": "Pues sí, tuve que enviarle una invitación a regañadientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840657
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840657,
					"content": "Es una desagradecida. ¿Sabes lo que hizo? Se plantó aquí con un cartel con un montón de tonterías explicativas y advertencias para los visitantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840658
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840658,
					"content": "Incluso nos prohibió tocarlo. Es una abusona, solo sabe meterse con la Banda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840659
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840659,
					"content": "¡Un día le voy a dar una buena paliza a esa tengu, a plena luz del día y delante de todo el mundo! ¡Le daré su merecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Bueno, colega, ¿tienes alguna pregunta sobre el festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
