			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Genta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840701,
					"content": "#Soy Genta, el recepcionista del Gran Festival de Tambores de Arataki. ¿Estás preparad{F#a}{M#o} para el espectáculo de tambores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840702
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840702,
					"content": "Por cierto, hay algo sobre este tambor que el jefe olvidó explicarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840703,
					"content": "Nosotros no entendemos mucho de instrumentos, así que a lo mejor deberías afinarlo un poco antes de empezar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840704
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840704,
					"content": "Así el sonido será más nítido y agradable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840705
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840705,
					"content": "Vamos, inténtalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Genta"
				}
			]
		},
		{
			"id": 7268430,
			"completionStepIds": [
				7268406
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268406",
							"2"
						],
						"stepId": 7268406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840632,
					"content": "¿Qué se puede hacer en el festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "¡Jajaja! ¡Pues un montón de cosas geniales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840634,
					"content": "¿Ves esa colina de ahí? Es la Colina del Canto. Cuando subas a la cima, podrás admirar las vistas del mar y ¡cantar a todo pulmón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840635,
					"content": "Y esta fogata es perfecta para asar calavandas, tanto de las normales como de la variedad más pequeña, voladora y molesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840636,
					"content": "Estas cajas disponen de mucho espacio para jugar a Invocación de los Sabios o para hacer batallas de escaradiablos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840637,
					"content": "Vaya, no se te ha pasado nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840638,
					"content": "#Aunque, claro está, la guinda del festival es el espectáculo de tambores. Contémplenlo ustedes {F#mismas}{M#mismos}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840639,
					"content": "Que quede entre tú y yo, he conseguido este pequeño tesoro a través de un proveedor supersecreto. Dicen que perteneció a un hechicero onmyouji, ¡y que su precio puede alcanzar los ocho millones de Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840640,
					"content": "#Gracias a mi irresistible atractivo y que la vendedora dijo que el destino nos había reunido, me hizo un descuento y me lo dejó por solo 800{NON_BREAK_SPACE}000 Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840641,
					"content": "¿Y te lo rebajó de ocho millones a ochocientos mil así como así? A Paimon le suena a estafa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840642,
					"content": "¡Pues claro! Era un truco superviejo, ¡razón por la que no funcionó conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840643,
					"content": "Un vistazo y ya había visto el golpe que tenía en un lado. Decía a gritos “producto defectuoso”. ¡Y todavía me dice que “es el destino”! ¡Por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840644,
					"content": "#Así que seguí regateando y lo conseguí por solo 80{NON_BREAK_SPACE}000 Moras. ¡Jajaja! ¡Toda una ganga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840645,
					"content": "Paimon diría que fue más bien un atraco a mano armada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840646,
					"content": "#Ahora que Paimon lo piensa, es sorprendente que alguien como tú pudiera permitirse pagar 80{NON_BREAK_SPACE}000 Moras. Bien por ti, toreritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840647,
					"content": "#¡Pff! 80{NON_BREAK_SPACE}000 Moras no es más que una propina. ¡¿Por quién me tomas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840648,
					"content": "#Bueno, yo puse 20{NON_BREAK_SPACE}000 de mi bolsillo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840649,
					"content": "Y yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840650,
					"content": "#¿Eh? Oye, jefe, ¿y yo por qué tuve que poner 30{NON_BREAK_SPACE}000?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840651,
					"content": "O sea que, 20 más 20 más 30 son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840652,
					"content": "#¡Ah! ¡De verdad eres un ladrón de poca monta! ¡Así que les sacaste a tus compañeros los 80{NON_BREAK_SPACE}000 Moras y tú no pusiste ni un mísero Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840653,
					"content": "#¡*Ejem*! ¿Es que no sabes sumar, renacuaja? Yo también puse mi parte... ¡Los últimos 10{NON_BREAK_SPACE}000 Moras fueron míos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840665,
					"content": "Bueno, basta de cháchara. Miren qué hora es, tengo que volver con Kuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840666,
					"content": "¡Esto acaba de empezar, muchachos! ¡Aún tenemos que atraer a un montón de personas para que el festival sea un éxito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840667,
					"content": "#Toma, quédate con este tambor. Si te sientes inspirad{F#a}{M#o} durante el espectáculo de tambores, ve a buscar a Genta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840668,
					"content": "¡Nos vemos, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
