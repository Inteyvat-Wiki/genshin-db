				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kimura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840301,
					"content": "¿Hay algo en lo que pueda ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840302,
					"content": "¿No se supone que va a haber un festival muy pronto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "¿Qué? ¿Un festival? No he oído hablar de ningún festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840304,
					"content": "#¿Pueden ser más específic{F#as}{M#os}? ¿De qué festival hablan exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840305,
					"content": "Se llama el Sublime...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "¿El Sublime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840307,
					"content": "El Sublime y Glorioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "¡Es el Sublime y Glorioso Gran Festival de Tambores de Arataki, organizado por la Banda de Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840310,
					"content": "¡Oh! ¿Te refieres a la misma Banda de Arataki que causó un gran revuelo en el Festival Irodori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840311,
					"content": "Así que te refieres a ese festival sin autorización, sin profesionalidad y sin oficialidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840312,
					"content": "¿Qué? No, no, no, te equivocas. ¡Se trata del Sublime y Glorioso Gran Festival de Tambores de Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840313,
					"content": "Bueno, no repitas más el nombre. Creo que sé de qué va todo esto, así que déjenme ponerles al corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840314,
					"content": "Hace unos días vi por aquí a algunos miembros de la Banda de Arataki. Estaban dejando pilas de cosas horrendas por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840315,
					"content": "Su líder dijo que iban a organizar un festival más grande que el Festival Irodori. Supongo que ese es el festival del que hablan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840316,
					"content": "Les hice unas preguntas y descubrí que no tenían ni los permisos necesarios ni el contrato de alquiler y, ¡sorpresa!, tampoco habían registrado el evento en la comisaría de policía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840317,
					"content": "Si eso no se define como sin autorización, sin profesionalidad y sin oficialidad, entonces no sé cómo llamarlo. Siguiendo las normas, tuvimos que obligarles a cancelar el evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840318,
					"content": "¿Cómo? ¡¿Lo cancelaron?! Deja que Paimon adivine, ¿luego los arrestaron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840319,
					"content": "En realidad, no. Ya que no tenían experiencia previa organizando eventos y se molestaron en preparar un plan de emergencia, solo les dimos una advertencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840320,
					"content": "¿Un plan de emergencia? Hum, eso es bastante responsable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840321,
					"content": "Bueno, si están buscando a la Banda de Arataki, pueden encontrarlos en la Isla Amakane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840322,
					"content": "Es un lugar designado por la Comisión Yashiro para utilizarse en todo tipo de festivales, grandes o pequeños. Se estableció para fomentar los eventos comunitarios culturales. El proceso de solicitud es mucho más sencillo allí, y también menos costoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840323,
					"content": "Se lo comentamos a la Banda de Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840324,
					"content": "Si todavía pretenden llevar a cabo su evento, esa será su mejor opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840325,
					"content": "#Hum... Todo esto comienza a parecer imposible, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840326,
					"content": "Pero, ya que llegamos hasta aquí, deberíamos ir a echar un vistazo en la Isla Amakane, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840308,
					"content": "El Sublime y Glorioso Gran Festival...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
		},
