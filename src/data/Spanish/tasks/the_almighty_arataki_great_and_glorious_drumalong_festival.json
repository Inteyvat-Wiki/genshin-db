			},
			"dialogs": [
				{
					"id": 726840660,
					"content": "Yoimiya también vino, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840661
					]
				},
				{
					"id": 726840661,
					"content": "¿La dueña de Pirotecnia Naganohara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840662
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840662,
					"content": "¡Esa sí que es genial! Se enteró de la celebración de nuestro festival porque justamente venía a la Isla Amakane para realizar una entrega de fuegos artificiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840663
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840663,
					"content": "Le gustó tanto el festival que nos deseó lo mejor. ¡Y nos prometió que nos traería fuegos artificiales la próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840664
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840664,
					"content": "Parece que la Banda de Arataki y Pirotecnia Naganohara van a llevarse muy bien a partir de ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Bueno, colega, ¿tienes alguna pregunta sobre el festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 7268433,
