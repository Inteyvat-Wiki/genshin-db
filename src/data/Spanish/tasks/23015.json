				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. García",
					"Lutong",
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "¡Para! ¡No me cuentes más! ¡Seguiré haciendo engranajes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150302,
					"content": "Pero si aún no he terminado de explicar todo el funcionamiento de mi máquina contable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230150303,
					"content": "Ya tienes los pedazos de hierro, ¿verdad? Bueno, pues me pongo a trabajar. ¡No me molestes más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150304,
					"content": "Ahangar blande su martillo y golpea con tanta fuerza que el Sr. García no tiene más remedio que hacerse a un lado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "Dejemos que el Sr. Ahangar haga su trabajo. Toma, tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150306,
					"content": "Mucha suerte con la máquina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "#Muchas gracias por tus buenos deseos, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150308,
					"content": "Aunque, por precaución, mantendré una actitud moderadamente pesimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150309,
					"content": "El Sr. García es, sin lugar a dudas, un genio de la ingeniería mecánica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150310,
					"content": "Pero si quieres mi opinión, creo que para crear una máquina así hace falta mucho más que ser un genio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
