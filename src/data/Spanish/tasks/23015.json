			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. García",
					"Ahangar",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Este rodamiento no encaja con el resto. Sus dimensiones son demasiado grandes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230150102,
					"content": "El anterior era muy pequeño y este es demasiado grande. ¡A este paso me voy a quedar sin minerales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150103,
					"content": "Lo cierto es que también estamos agotando nuestros fondos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150104,
					"content": "¿Por qué discuten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Este caballero me pidió que fabricara un montón de tubos y engranajes de hierro, y cada uno con especificaciones distintas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150106,
					"content": "El problema es que, al fabricar tantos componentes, ¡he agotado casi todos los pedazos de hierro que tenía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150107,
					"content": "Y aun así dice que no son suficientes, que necesita más engranajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150108,
					"content": "Si me permitiera explicarle de nuevo mi objetivo, seguro que podríamos llegar a un entendimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230150109,
					"content": "¿De qué va todo esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Será mejor dejar que el Sr. García se lo explique al Sr. Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150111,
					"content": "#Viajer{F#a}{M#o}, yo... Bueno, el Sr. García quiere pedirte un favor. ¿Podrías reunir algunos pedazos de hierro para nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150112,
					"content": "Bueno, ahora no estoy haciendo nada, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "Nos hemos topado con algunos contratiempos que ya habíamos previsto. El Sr. García está intentando solucionarlos en este preciso momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150115,
					"content": "Si tienes alguna duda, te aconsejo que le preguntes directamente al Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150116,
					"content": "Creo que aparte del propio Sr. García, nadie más sería capaz de comprender el funcionamiento de esa máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150117,
					"content": "Pero antes de nada, consigue esos pedazos de hierro, te lo ruego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150113,
					"content": "¿Cómo van las mejoras de la máquina contable?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
		{
			"id": 2301502,
			"completionStepIds": [],
