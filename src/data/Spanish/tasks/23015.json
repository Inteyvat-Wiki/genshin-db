			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar",
					"Sr. García"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "¿Pero para qué quieres tantos engranajes y tubos? ¿Vas a construir una casa de hierro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "¡Precisamente! Eso es lo que voy a hacer, una casa llena de engranajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230155003,
					"content": "Al área que almacena una parte de los engranajes la llamaré almacén, mientras que el resto de los rodamientos y engranajes compondrán la base numérica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230155004,
					"content": "Los engranajes del almacén se usan para almacenar y registrar números, y los de la base numérica, para realizar cálculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230155005,
					"content": "Lo entenderá mejor si se lo dibujo. ¿Tiene papel? ¿No? No importa, lo dibujaré sobre mi ropa. Así lo entenderá mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230155006,
					"content": "¿Me deja ese carboncillo? Muy amable, gracias. Mire, fíjese en esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				}
			]
		}
	]
}