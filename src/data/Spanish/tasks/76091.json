					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"¿?"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Le entregas el cuaderno y las hojas sueltas que encontraste...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Veamos... ¡Sí! Es esto. Muchas gracias. Aquí hay bastantes pruebas de crímenes de los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910205,
					"content": "... ¿Pruebas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Mira todas esas instalaciones que construyeron en la Isla Paha y las máquinas que trajeron... Ese lugar solía ser el hogar de muchos animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910207,
					"content": "Acabo de volver del Salar Rosáceo. ¡Seguramente es por las máquinas de los Fatui que las medusas de allí están agonizando!... Tengo que hacer que todos se enteren de esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910208,
					"content": "¿Eh? ¿Te refieres a Gelatina de Valbaya y las demás? Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "Relatas tu experiencia en el Salar Rosáceo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "Parece que ya es muy tarde... Pero, pase lo que pase, hay que dejar constancia de esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910211,
					"content": "Les dejo estas notas a ustedes. Tengo que volver rápido para organizar el contenido de las otras notas y escribir un artículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910213,
					"content": "Por cierto, si van a contárselo a alguien, asegúrense de decir que fue Semión, es decir, yo, quien se lo dijo. Después de todo, llevará tiempo escribir el artículo y publicarlo en el periódico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910214,
					"content": "¡Muchas gracias por todo! ¡Nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				}
			]
		},
