			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"¿?"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "¡Es un hada voladora! Mis notas... Los Fatui se llevaron mis notas importantes. ¿Podrías ayudarme a recuperarlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910102,
					"content": "Paimon no es un hada... pero quizá pueda ser de ayuda. Por cierto, ¿por qué se llevarían los Fatui las notas de un niño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Tal vez temen que revele el contenido de las notas al público... Si me ayudan a recuperarlas, les contaré el secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 760910105,
					"content": "Ya hablaremos de eso después. Por favor, ayúdenme a <color=#00E1FFFF>recuperar mi cuaderno</color> primero. Es posible que haya algunas <color=#00E1FFFF>páginas sueltas</color> por ahí, en la zona donde están los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
			"beginWay": "TALK_BEGIN_AUTO",
