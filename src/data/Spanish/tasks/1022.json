			]
		},
		{
			"id": 102206,
			"completionStepIds": [
				102206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102206",
							"2"
						],
						"stepId": 102206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "¡Esos no eran lirios de cristal! ¡Un lirio de cristal no atacaría a las personas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220602,
					"content": "Qué flores tan agresivas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "Esos monstruos se llaman “Megaflora”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220604,
					"content": "¿Eh? Fascinante, estos pétalos se ven muy interesantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220605,
					"content": "Las Megafloras utilizaron los lirios de cristal como disfraz, y fueron enterrados juntos durante mucho tiempo. Ahora se han convertido en hierbas medicinales con un efecto muy potente. Recojamos lo que podamos de estos pétalos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220606,
					"content": "¿Eso es algo bueno? ¿Nos servirán para el Rito del Ascenso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220607,
					"content": "Lamentablemente, no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220608,
					"content": "Oh, ¿por qué no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220609,
					"content": "Disculpen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220610,
					"content": "¿Están buscando lirios de cristal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220611,
					"content": "¡Ah, eres tú! Eh... ¡Oh, no! ¡Olvidé su nombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220612,
					"content": "Saludos, Ganyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "#Hola, viajer{F#a}{M#o}. Me sorprende que aún recuerdes mi nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220617,
					"content": "Lo que me recuerda, ¿qué tal su visita a la Cámara de Jade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220618,
					"content": "¡Habríamos perdido menos tiempo si nos hubieras dicho cómo llegar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220619,
					"content": "¡Oh! ¿No les dije el camino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220620,
					"content": "¡No, encontramos el camino por nuestra cuenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220621,
					"content": "Quizás olvidaste mencionarlo porque todo el mundo sabe llegar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "Oh, ya veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220624,
					"content": "(Oh, oh, olvidé decírselo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220625,
					"content": "¿Eh? A Ganyu le pasa algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220626,
					"content": "Incluso está actuando diferente de la primera vez que nos encontramos... ¿Dónde está su actitud seria ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220627,
					"content": "Bueno, en ese momento fui como emisaria del Equilibrio Celestial, pero ahora simplemente estoy de paseo para ver flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220628,
					"content": "¿Viniste hasta aquí para ver flores? ¿Por qué no las ves en los jardines de la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220629,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220630,
					"content": "La Terraza Yujing es donde Rex Lapis se separó de este mundo. No me atrevo a pasear por esos jardines solitarios, no lo soportaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220631,
					"content": "Estos días, cuando trabajo cerca de la Terraza Yujing, prefiero cerrar las ventanas para no ver los jardines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220632,
					"content": "Oh... Lo siento, no debimos haberlo mencionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220633,
					"content": "No, está bien. Fui impulsiva al expresar así mis emociones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220634,
					"content": "Cuando la Guerra de los Arcontes terminó, los primeros Siete Arcontes se reunían en Liyue a beber con Rex Lapis. Pero cinco de ellos murieron antes que Rex Lapis, lo que supuso un gran cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220635,
					"content": "Eso significa que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "Sí. Ahora que el espíritu de Rex Lapis ha regresado a los cielos, el único que queda de Los Siete originales es Barbatos, el Arconte de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220666,
					"content": "Los otros cinco, incluido la Shogun Raiden de Inazuma, ya no son amigos, como lo fueron hace dos mil años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220637,
					"content": "De Los Siete Arcontes actuales, la más joven es la Arconte Dendro de Sumeru. Tiene solo quinientos años, mientras que Rex Lapis tenía más de seis mil años cuando murió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220638,
					"content": "Eso significa que Liyue ha sido gobernado por Rex Lapis desde el momento en que se fundó por primera vez hace 3700 años. La ciudad nunca ha tenido que despedirse de su deidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220639,
					"content": "Entonces, ¿qué opinas de esta “despedida”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220640,
					"content": "¿Eh? ¡Qué pregunta tan repentina! Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220641,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220642,
					"content": "Como mortal, nunca me había atrevido a imaginar un Liyue sin Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220643,
					"content": "Pero como Adeptus... Creo que llegaré a aceptar la realidad. Puesto que Rex Lapis falleció, la era del contrato de Liyue con los Arcontes y Adeptus ha llegado a su fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220644,
					"content": "¿Eh? ¿Acabas de decir “como Adeptus”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220645,
					"content": "Sí... Soy una mezcla de humana y Chilin. La sangre de Adeptus fluye por mis venas. Luché por Rex Lapis y la ciudad de Liyue durante la Guerra de los Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220646,
					"content": "Cuando terminó la guerra, firmé un contrato con Rex Lapis y asumí el cargo de secretaria para las Siete Estrellas. Desde entonces, he cumplido con ese deber hasta el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220647,
					"content": "¡Eso explica por qué tienes cuernos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "*Ejem*, dejemos esa conversación para otro momento. ¿Dijiste que estás buscando lirios de cristal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220650,
					"content": "Sé dónde puedes encontrarlos salvajes. Mira, acabo de recoger uno yo misma. Es tuyo, si así lo quieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220651,
					"content": "No podemos rechazarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220652,
					"content": "¿Eh? Entonces, ¿tú también cantaste una canción antes de recoger el lirio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220653,
					"content": "Sí. Conozco bien esa tradición. De hecho, le canté una balada local de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220654,
					"content": "¡Guau, sabes mucho! ¡Gracias, Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220655,
					"content": "Al contrario, soy yo quien está agradecida con ustedes. De no ser por este encuentro casual, no podría haber contribuido a la despedida de nuestro señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220656,
					"content": "Si me disculpan, debo volver a mi trabajo. Buena suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220657,
					"content": "Y con esto casi terminamos nuestros preparativos para el Rito del Ascenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220658,
					"content": "Dejé la tarea de recoger lirios de cristal para el final porque imaginé que sería sencillo, y así ha sido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220659,
					"content": "Zhongli debería abrir su propia floristería.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "Sí, Paimon puede imaginarlo perfectamente abriendo su propio negocio en Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220661,
					"content": "¡Jaja! Ya he tenido suficientes negocios en mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220662,
					"content": "Comenzar uno siempre es difícil al principio y requiere mucho esfuerzo. Además, cuando el negocio ya marcha viento en popa, el estrés también es motivo de desgaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220663,
					"content": "Se necesita tiempo para dar un paso atrás y reflexionar sobre ello. Si no, el desgaste emocional puede llegar a un punto sin retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220664,
					"content": "¡Guau! ¡Parece que Zhongli lo ha visto todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220665,
					"content": "Bien, creo que es hora de que regresemos a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220648,
					"content": "¡Ahora entiendo por qué te olvidas de contarnos las cosas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "Supongo que fue nuestra culpa por no preguntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "Saludos, Yangu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "¡¿Yangu?! ¿Quién es esa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220616,
					"content": "Olvidaste mi nombre por completo, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				}
			]
		},
		{
			"id": 102208,
			"completionStepIds": [
				102208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102208",
							"2"
						],
						"stepId": 102208,
