			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220201,
					"content": "¡Cuántos talismanes! Y también hay algunos papeles en blanco, ¿para qué son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220202,
						10220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220202,
					"content": "Parece que copiaron en ellos el patrón del Talismán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				},
				{
					"id": 10220204,
					"content": "¡Paimon ha visto este patrón antes! ¿Pero dónde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220205,
					"content": "Oh, ¡Paimon lo recuerda! Es igual que el Sello del Permiso que te dio Nobile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220206,
					"content": "Humm, pero ¿cómo podría una reliquia de los Adeptus terminar en manos de alguien como Nobile? Es muy sospechoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220207,
					"content": "No es solo una reliquia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220208
					]
				},
				{
					"id": 10220208,
					"content": "Oh, es cierto. Preservadora de Nubes dijo que cuando el Rey Geo creó el Sello del Permiso, su propósito no era que fuese una reliquia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220209,
					"content": "Talismanes como ese fueron utilizados en la Guerra de los Arcontes para canalizar poderes divinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220210,
					"content": "Quizás los Fatui están copiando el Sello del Permiso con la esperanza de lograr un efecto similar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220211,
					"content": "Poder canalizar un poder divino en la batalla... Suena demasiado peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220212,
						10220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220212,
					"content": "No hay duda de que los Fatui están tramando algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220214,
					"content": "#Esto se está complicando... A partir de ahora, hay que ser más precavid{F#as}{M#os} con Nobile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220215,
					"content": "Bueno, basta de perder el tiempo aquí. Tenemos que encontrarnos con Zhongli pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220216,
					"content": "La última parada de nuestro recorrido de preparación para el Rito del Ascenso es... ¡el Pantano Dihua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220217,
					"content": "¡Vámonos! ¡Paimon odia llegar tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220213,
					"content": "Este documento podría ser parte de un plan mucho más grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220203,
					"content": "Quizás están tratando de reproducir uno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				}
			]
		},
		{
			"id": 102203,
			"completionStepIds": [
				102203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102203",
							"2"
						],
						"stepId": 102203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220301,
					"content": "Justo a tiempo, llegué hace unos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220302,
					"content": "¿Disfrutaste de tu visita a la Cámara de Jade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220303
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220303,
					"content": "¡Es enorme! ¡Y hermosa! Y lujosa... ¡Paimon nunca había visto un lugar tan sofisticado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220304,
					"content": "En efecto. Es insuperable en toda Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220305,
					"content": "¿Cómo les fue con Ninguang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220306,
					"content": "Es super-rica y muy generosa. ¡Paimon piensa que es muy amable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220307,
					"content": "La amabilidad es el arma de las personas de negocios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220308
					]
				},
				{
					"id": 10220308,
					"content": "#Humm... Su opinión de Ninguang es muy diferente de la de Paimon. {NICKNAME} cree que aunque el Equilibrio Terrenal tiene menos tacto, es más fiable que ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220309,
					"content": "Oh, así que también te reuniste con Keching. ¿Qué les dijo ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220310,
					"content": "Dijo: “El tiempo de los Adeptus ha llegado a su fin. Si las Siete Estrellas de Liyue se niegan a encarar esta verdad, ¿qué futuro hay para Liyue?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220311,
					"content": "Jaja, una falta de respeto hacia los dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220312
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220312,
					"content": "De hecho, a diferencia de la audaz Keching, Ninguang es más bien una empresaria tradicional, aunque ambas son miembros de las Siete Estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220313,
					"content": "Aunque es amable, no hay forma de saber a ciencia cierta sus verdaderas intenciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220314,
						10220315
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220314,
					"content": "Ninguang es muy lista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				},
				{
					"id": 10220316,
					"content": "Sí, se ha valido por sí misma para ascender a su posición actual. Ninguna persona común podría lograrlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220317,
					"content": "Se dice que ella está detrás de la constante expansión de la Cámara de Jade, que esa es la segunda cosa más importante para ella. Aunque alguna vez renunciara a su posición de Equilibrio Celestial, nunca abandonaría la Cámara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220318
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220318,
					"content": "¿La Cámara de Jade está en segundo lugar? Entonces, ¿qué es lo más importante para ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220319,
					"content": "El Mora, ¡por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220320,
						10220321
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220320,
					"content": "Eso tiene sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220322,
					"content": "De lo único que habló Ninguang fue de los Fatui. Dijo que, tras el asesinato de Rex Lapis, los Fatui se entrometieron en los asuntos de Liyue y no se puede confiar en ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220323,
					"content": "Así son los Fatui. No me sorprende en lo más mínimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220324
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220324,
					"content": "Y ahora están tratando de reproducir el Sello del Permiso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220325
					]
				},
				{
					"id": 10220325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220326
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220326,
					"content": "No importa lo que estén planeando, debes tener cuidado con ellos. No bajes la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220327
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220327,
					"content": "Entonces, ¿hay algo que necesitemos para el Rito del Ascenso en el Pantano Dihua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220328,
					"content": "Sí. Hoy vamos a recoger lirios de cristal salvajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220329
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220329,
					"content": "¿Lirios de cristal? ¿Pero para qué vinimos hasta aquí? ¿No hay suficientes en la Terraza Yujing? Incluso la Aldea Chingtsé tiene lirios de cristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220330,
					"content": "Por cierto, Paimon recuerda haber visto a Madam Ping cuidando unas flores. ¡Podríamos preguntarle a ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220331,
					"content": "No, esas flores crecen en jardines. No nos servirán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220332
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220332,
					"content": "El Pantano Dihua solía estar lleno de lirios de cristal. Es una flor alegre a la que le gusta escuchar el canto de los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220333
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220333,
					"content": "Antes de la Guerra de los Arcontes, el Pantano Dihua era una tierra seca y fértil. La guerra causó deslizamientos de tierra e inundó la zona, convirtiéndola en el pantano que ven ahora. Casi todos los lirios de cristal desaparecieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220334
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220334,
					"content": "Dentro de la ciudad hay especímenes cultivados por los humanos, pero muy pocas personas saben que todavía se pueden encontrar lirios de cristal en la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220335
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220335,
					"content": "La fragancia de los lirios de cristal salvajes es más fuerte. Si queremos seguir la verdadera tradición del Rito del Ascenso, debemos moler lirios silvestres y colocar el polvo en un incensario con incienso eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220336
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220336,
					"content": "Pero necesitaré tu ayuda para recoger estas flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220337,
						10220339
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220337,
					"content": "¿Necesitas que las recoja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220338
					]
				},
				{
					"id": 10220338,
					"content": "No, necesito que les cantes. Cantarle a las flores las hará más fragantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220341,
					"content": "#Humm, {NICKNAME}, ¿cantas bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220342,
						10220343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220342,
					"content": "Bueno... más o menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220344,
					"content": "¿De verdad? ¿Por qué Paimon no te cree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220345,
					"content": "Solo hay una forma de saberlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220346
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220343,
					"content": "#¡Soy {F#toda una}{M#todo un} profesional!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220339,
					"content": "¿Necesitas... que cante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220340
					]
				},
				{
					"id": 10220340,
					"content": "Correcto. Tu canto sacará la fragancia más fuerte de las flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220321,
					"content": "¿Por qué no me sorprende?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220315,
					"content": "Ninguang es muy ambiciosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				}
			]
		},
		{
			"id": 102204,
			"completionStepIds": [
				102204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
