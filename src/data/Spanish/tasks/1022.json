			},
			"dialogs": [
				{
					"id": 10220401,
					"content": "#¡Es hora de cantar! ¡Cuando estés list{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220402,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220403
					]
				},
				{
					"id": 10220403,
					"content": "♪... ♪♪♪♪... ♪♪♪♪... ♪... ♪",
