				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "Ah, usted debe ser el asesor de la Funeraria El Camino, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220802,
					"content": "Ahora, la Geoarmada está observando todos nuestros movimientos. Estos son tiempos desesperados, no debemos actuar precipitadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220803,
					"content": "¿Tiempos desesperados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220804,
					"content": "Los Adeptus del Desfiladero Jueyun ya están de camino, pero no creo que vengan con buenas intenciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220805,
					"content": "¿Pretenden hacer uso de la fuerza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220806,
					"content": "Es lo más probable. He oído que algunos miembros de las Siete Estrellas se les adelantaron... para tratar de retener a los Adeptus fuera de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220807,
					"content": "Sin embargo, ambas partes son muy obstinadas, y llegaron a un punto muerto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220808,
					"content": "Parece inevitable, dada la situación actual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220809,
					"content": "Los Adeptus no reconocen a las Siete Estrellas, solo reconocen los contratos con el Arconte Geo. Si recurren al uso de la fuerza, Liyue no podrá detenerlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220810,
					"content": "Ciertamente, las Siete Estrellas de Liyue no se rendirán tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220811,
					"content": "Humm... todo el mundo sabe lo obstinados que son. ¡Por eso los mortales y los Adeptus están ahora al borde del conflicto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220812,
					"content": "¿Y ahora qué? ¿Cómo es que los Fatui se convirtieron en el blanco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220813,
					"content": "*Suspira*, esto es obra de Ninguang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220814,
					"content": "Después de todo, ella fue la que proclamó: “En estos tiempos tumultuosos, la Geoarmada debe frenar las acciones de los Fatui”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220815,
					"content": "¡Ja! ¿Ahora quieren vigilarnos? ¡Típico de las Siete Estrellas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220816,
					"content": "De todos modos, Sr. Zhongli, usted es uno de los socios más cercanos a Nobile. Sus responsabilidades también son las nuestras. No deje que nadie le pille desprevenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220817,
					"content": "Parece que las cosas están a punto de estallar en Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220818,
					"content": "¿Qué podemos hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "#¿Pretendes utilizar tu posición neutral para hacer de intermediari{F#a}{M#o} entre ambas partes? ¿O usarás tu espada para equilibrar la balanza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220821,
					"content": "Me temo que no es una elección tan sencilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220822,
					"content": "Por cierto, Sr. Zhongli, hemos oído que la Funeraria El Camino también se ha visto envuelta en todo esto. ¡Actualmente las autoridades están en sus puertas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "Félix"
				},
				{
					"id": 10220823,
					"content": "Las cosas van de mal en peor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220824,
					"content": "Me temo que debo irme para arreglar los asuntos en la Funeraria El Camino. Espero que la directora Hu Tao haya podido mantener las cosas bajo control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220825,
					"content": "#Piensa bien en tu próximo movimiento, {NICKNAME}. Para prevenir una explosión, puede ser más prudente buscar primero “el detonante”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220827,
					"content": "Uf... Tener conexiones con los Fatui es como tener una espada de doble filo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220828,
					"content": "¿Qué quiso decir Zhongli con “buscar el detonante”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220829,
					"content": "Nobile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "¡Oh, Paimon lo entiende! Si hay alguien que quiere ver la ciudad arder, definitivamente es él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220833,
					"content": "¡Debe estar esperando el momento en que nadie esté mirando para hacer algo malo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220834,
					"content": "Pero ¿dónde podríamos encontrarlo en estos momentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220835,
					"content": "¿A dónde iría en un momento como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220836,
					"content": "Ven conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "Solo hay un lugar al que podría ir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220830,
					"content": "El chico pelirrojo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220831,
					"content": "El chico rico que pagó todo por nosotros hasta ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220819,
					"content": "No podemos quedarnos de brazos cruzados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				}
			]
		}
	]
}