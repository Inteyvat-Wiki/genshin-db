	"talks": [
		{
			"id": 7310401,
			"completionStepIds": [
				7310401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310401",
							"2"
						],
						"stepId": 7310401,
						"stateName": "QUEST_STATE_UNFINISHED"
