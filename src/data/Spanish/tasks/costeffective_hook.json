				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "¡Écheme una mano, por favor! ¡Me vendría muy bien su ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "No puedo, y fin de la discusión. Por favor, váyase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Vaya, ¿por qué discuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "#Oye, foraster{F#a}{M#o}, ¿podrías ayudarme a convencer a esta señorita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "Lleva todo el día pegada a mí porque dice que necesita mi ayuda para sacar del mar unas antigüedades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "Pero eso no solo espantaría a mis peces, sino que me robaría demasiado tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Señorita, ¿por qué tanta prisa? ¿Acaso planea hacerse rica con esas antigüedades?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "Para nada, Sr. Kayvan. Soy Helbet, colaboradora de la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "Esas antigüedades son unas reliquias que reunió la Academia para investigarlas, y yo estoy a cargo de su cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "El barco de carga que las transportaba ayer tuvo un pequeño accidente. Algunas cayeron al agua y fueron arrastradas río abajo por la corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "¡Entonces, vaya a buscar un equipo profesional de rescate acuático! ¿Qué espera de un simple pescador como yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "No tengo tiempo para ir a buscar a un equipo profesional. Sr. Kayvan, escuché que, con su anzuelo infalible, pesca objetos perdidos casi todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "Además, como siempre está pescando por esta cuenca, pensé que no sería molestia pedirle que me ayudara a atrapar esas reliquias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "Se ve que estás desesperada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "*Ejem*, Srta. Helbet, lamento por lo que ha pasado, pero yo solo soy un pescador común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "Mi caña es para pescar peces, y eso es lo único que puedo atrapar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "Pero si no has atrapado ni un solo pez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "*Ejem*, todo mi entrenamiento es para capturar peces. Nunca se me ha ocurrido que podría usar mis habilidades para atrapar otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "Por eso, creo que es mejor que le pida ayuda a otra persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "¿Qué? Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "Bueno, está bien. No le pediré que me haga el favor de atrapar las reliquias con su caña, pero necesito que vaya a pescar a otro lugar, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "Es como si... ¡como si le estuviera pagando por pescar! Por favor, ¡se lo ruego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Pero qué... Escuchen, ¡soy un pescador! ¡Un pescador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "No veo ningún problema en que cambies de sitio para pescar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "¡Se lo ruego, por favor! Mire, aquí tengo preparado su pago, solo falta que usted ponga de su parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "#Pero qué terc{F#as}{M#os}... De acuerdo, digamos que acepto su petición, ¿a dónde quiere que vaya a pescar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "¡Muchísimas gracias! ¡Sígame, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "#Igual que antes, viajer{F#a}{M#o}, ayúdame a buscar material para cebo, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Veamos... El material especial de esta vez es menta, pero tiene que ser menta de un lugar al que suelo ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "Te marcaré en el mapa la localización aproximada. Cuento contigo. Ya discutiremos la compensación que corresponda cuando la traigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "La Srta. Helbet y yo estaremos en el punto de pesca. Nos vemos ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Si eres pescador, podrías pescar cualquier cosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Es cierto que Kayvan es muy bueno pescando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "¡Yo solo lanzo mi caña de pescar para pescar peces! ¡¿Entienden?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
