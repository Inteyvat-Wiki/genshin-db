			},
			"dialogs": [
				{
					"id": 731040701,
					"content": "Bien, comencemos con la segunda ronda de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040702
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040702,
					"content": "Necesito concentrarme, así que no hagan ruido, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040703
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040703,
					"content": "Kayvan se concentra para pescar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040704
					]
				},
				{
					"id": 731040704,
					"content": "¡Ah! ¡M-miren! ¡Son un montón de Slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040705
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040705,
					"content": "¡¿Qué?! ¡Jamás me había ocurrido algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040706,
						731040707
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040706,
					"content": "¡Yo me encargo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				},
				{
					"id": 731040708,
					"content": "¿Por qué nos tiene que pasar de todo justo cuando el Sr. Kayvan está pescando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040707,
					"content": "Tú sigue pescando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				}
			]
		},
		{
			"id": 7310409,
			"completionStepIds": [
				7310409
