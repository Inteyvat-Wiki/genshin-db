			},
			"dialogs": [
				{
					"id": 731041201,
					"content": "Todo bien hasta ahora. Llegó el momento de la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041202
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041202,
					"content": "Uf... Ya van tres veces y nada. ¡Vengan a mí, peces! ¡Déjenme atrapar aunque sea al más pequeño de ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041203,
					"content": "Kayvan prepara el cebo y comienza a pescar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041204
					]
				},
				{
					"id": 731041204,
					"content": "Poco después, saca un tercer paquete mojado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041205
					]
				},
				{
					"id": 731041205,
					"content": "Mírelo usted, yo paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041206
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041206,
					"content": "¡Bien! Veamos... se ve bien, está intacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041207
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041207,
					"content": "¡Es perfecto, Sr. Kayvan! ¡Lo ha vuelto a conseguir con su anzuelo infalible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041208
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041208,
					"content": "Jaja, bueno... Si así puede completar su misión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041209
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041209,
					"content": "Paimon no puede creerlo, con solo tres intentos ya pescamos las tres reliquias. Eso sí, ni un solo pez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041210,
						731041211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041210,
					"content": "Eso es lo que hace al Sr. Kayvan tan increíble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				},
				{
					"id": 731041212,
					"content": "¡Oye! ¡Nunca fue mi intención pescar reliquias! ¡Lo único que quería era atrapar un buen pez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041213
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041213,
					"content": "Además, aunque tuviera unas pésimas habilidades de pesca, no tuviera fuerza para lanzar la caña y demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041214
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041214,
					"content": "... He pescado tantas veces en mi vida que, aunque fuera por suerte, tendría que haber pescado algún pez, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041215
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041215,
					"content": "¡Pero no! ¡No he pescado ni un solo pez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041216
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041216,
					"content": "Humm... Ahora que lo dices, sí que es algo extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "Eh... Sr. Kayvan, si le interesa, puedo presentarle a un erudito especializado en pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "Él ha sido partícipe de los diseños más populares de cebos y cañas de pescar que hay en el mercado a día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "No sé por qué no ha pescado ni un pez, pero... preguntarle a un experto nunca está de más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "Quién sabe, tal vez al erudito también le interese conversar con usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "¿Se refiere a que le interesará saber por qué pesco de todo menos peces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "Bueno, tiene razón. Puedo aprovechar esta oportunidad para saber cuál es el problema con mi técnica de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "¡Así es! Entonces, le hablaré a mi amigo de usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "¿Está segura de que un ratón de biblioteca va a saber algo de pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041225,
					"content": "#Oh, ¡casi lo olvidaba! Gracias por tu ayuda, viajer{F#a}{M#o}. Por favor, acepta esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041211,
					"content": "Es único en su clase, supongo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				}
			]
		},
