		{
			"id": 7310404,
			"completionStepIds": [
				7310404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310404",
							"2"
						],
						"stepId": 7310404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "¡Qué rapidez! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040402,
					"content": "Dese prisa, por favor. De lo contrario, las reliquias... Digo, los peces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040403,
					"content": "Para eso se requiere calma. Primero hay que sentir el ritmo del agua y, al lanzar la caña, uno tiene que estar tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040404,
					"content": "Veamos si podemos pescar algún pez grande por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040405,
					"content": "Kayvan crea el cebo y empieza a pescar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "Tras un buen rato, Kayvan pesca un paquete mojado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040407
					]
				},
				{
					"id": 731040407,
					"content": "¿Qué es esto?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040408
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040408,
					"content": "Es... ¡A ver, a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040409,
					"content": "¡Sí! ¡Es una de las reliquias que cayeron al agua! Está intacta, y al parecer no hay ninguna criatura marina en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040410,
					"content": "¡Increíble! ¡Hasta es capaz de pescar reliquias! ¡Ahora entiendo el porqué del nombre “anzuelo infalible”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040411,
					"content": "¿Se supone que eso es un cumplido? Porque a mí no me lo parece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "Bien, ya tenemos la primera reliquia. Ahora nuestro siguiente objetivo está... al oeste, no muy lejos de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040413,
					"content": "*Suspira*, vamos ya. Me gustaría terminar con esto cuanto antes para poder volver a pescar tranquilamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040414,
					"content": "No hay problema, ¡sígame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040415,
					"content": "#Viajer{F#a}{M#o}, ahora el material especial para el cebo será un fruto harra. Mi sexto sentido me dice que será lo mejor para esta ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040416
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040416,
					"content": "Conozco el lugar con los mejores frutos harra de por aquí. Te mostraré la ubicación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040417,
					"content": "En marcha. Nos veremos en el siguiente punto de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
