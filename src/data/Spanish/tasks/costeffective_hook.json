					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040901,
					"content": "¡Son ustedes increíbles! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040902
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040902,
					"content": "Cuando recuperemos todas las reliquias, solicitaré un poco más de dinero para recompensarles por toda su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040903
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040903,
					"content": "Creía que no era capaz de atrapar un pez de verdad, ¿cierto, Srta. Helbet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040904
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040904,
					"content": "¡Pues mire! ¡Algo grande ha picado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040905
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040905,
					"content": "Kayvan tira de la caña con fuerza...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040906
					]
				},
				{
					"id": 731040906,
					"content": "¿Y ahora qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040907
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040907,
					"content": "¡Guau! ¡Es otro de los paquetes con reliquias! ¡Excelente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040908
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040908,
					"content": "¡No pensé que todo iría tan bien! Recuperamos dos reliquias en un santiamén. ¡Es usted un gran pescador, Sr. Kayvan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040909
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040909,
					"content": "Hablé demasiado pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040910
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040910,
					"content": "Todos los días puedes pescar peces, pero no reliquias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040911
					]
				},
				{
					"id": 731040911,
					"content": "¡Pero si no he pescado ni un solo pez hasta ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040912
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040912,
					"content": "Mira el lado positivo: ¡recuperamos las reliquias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040913,
					"content": "Nuestro último punto de pesca está... cerca de la Aldea Vimara. Esa zona es mucho más segura, apresurémonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040914
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040914,
					"content": "Sí, sí, como sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040915
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040915,
					"content": "Esto es muy extraño. O mi técnica de pesca falló, o no estoy usando el cebo correcto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040916
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040916,
					"content": "#Olvídenlo. Viajer{F#a}{M#o}, esta vez necesito que vayas por unas duraznolivas frescas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040917
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040917,
					"content": "Ya que es el último sitio, usaré mi cebo especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040918
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040918,
					"content": "#Viajer{F#a}{M#o}, lo dejo en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
