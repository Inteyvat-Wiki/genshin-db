			"dialogs": [
				{
					"id": 733420101,
					"content": "Guau, ¡Sorush es la mejor! Ha revitalizado todo en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733420102,
					"content": "El poder de las pari es maravilloso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733420103
					]
				},
				{
					"id": 733420103,
					"content": "Cualquier cosa les impresiona. Con mi poder, salvar una flor shuniata es una tarea de lo más sencilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420104
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420104,
					"content": "Estas flores no son más que otras víctimas de la oscura corrosión que se está expandiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420105,
					"content": "Ningún otro estanque floral ha logrado sobrevivir. Seguro que Sefana está muy agitada ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420106,
					"content": "Por cómo hablas de ella, Sefana debe de ser una pari muy trabajadora que cuida muy bien de las flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733420107,
					"content": "#¿Qué tal si la ayudamos, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733420108,
					"content": "Bueno, supongo que lo puedo considerar como un pequeño entretenimiento en mi obra magna. En ese caso, mi Yasnapati, por favor, presta atención a este tipo de flores shuniata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420109,
					"content": "Te avisaré si las veo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733420110
					]
				},
				{
					"id": 733420110,
					"content": "#¡Sí! ¡Salvemos junt{F#a}{M#o}s a estas flores tan bonitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
