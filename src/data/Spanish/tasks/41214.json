				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "#¡Estamos de vuelta! ¡Somos nosotr{F#as}{M#os} de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140102,
					"content": "#Viajer{F#a}{M#o}, Paimon, bienvenid{F#as}{M#os} de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140103,
					"content": "Paimon ya está acostumbrada a encontrarse con Albedo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140104,
					"content": "Hice lo que pediste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "Muchas gracias. Sabía que podía contar contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140107,
					"content": "¿De verdad cuentas conmigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "Naturalmente, fuiste crucial para mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140109,
					"content": "Jeje, Paimon se alegra de escuchar eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140110,
					"content": "Nunca olvidaré tu amabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140111,
					"content": "Te devuelvo la espada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "Debería ser lo suficientemente poderosa, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140113,
					"content": "Más o menos. ¿Cómo la sientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140114,
					"content": "Igual que antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "Bueno, no hay efectos secundarios, ni corrupción ni veneno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140116,
					"content": "Parece que... he estado en lo cierto todo este tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140117,
					"content": "¿Te crees un profeta o qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140118,
					"content": "¿Qué te parece la espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140119,
					"content": "Es una buena arma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "¿Ah, sí? Independientemente de eso, ha alcanzado el estado deseado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140122,
					"content": "¿Por qué sostienes la espada? Albedo, ¿qué estás haciendo? ¡N-no hagas una tontería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140123,
					"content": "Quiero extraer la fuerza vital purificada de su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140124,
					"content": "¿Puede existir esa fuerza fuera de la espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140125,
					"content": "Lo que es imposible para algunos, está a mi alcance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140126,
					"content": "... Listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140127,
					"content": "Vaya, esa energía parece una bola de luz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140128,
					"content": "¡Ah! ¡La pusiste en una botella misteriosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140129,
					"content": "Puede ser que esta espada no sea un arma divina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140130,
					"content": "... pero será un buen recuerdo. Espero que pueda ser de alguna ayuda durante sus viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140131,
					"content": "¿De verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "La necesitaba para fines investigativos. Ya obtuve los resultados del experimento. Esta espada debe pertenecerle a alguien que sepa usarla, es decir, a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140134,
					"content": "Gracias por ayudarme a completar esta investigación. Entonces, nos vemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140135,
					"content": "La fuerza vital de ese dragón resuena en mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140136,
					"content": "No porque él sea un dragón, sino por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140137,
					"content": "Rhinedottir... Maestra... ¿Es esta tu creación, el dragón gigante Durin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140139,
					"content": "¿De verdad fue buena idea nuestro encuentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140132,
					"content": "¿Ya no la necesitas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "No me sirve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "Hice lo que querías, como prometí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}