			"dialogs": [
				{
					"id": 230220101,
					"content": "Si aumentamos la fuerza aquí, habría que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Ese diseño es prácticamente igual al anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230220103,
					"content": "¿Sigues trabajando en el diseño?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "#Ah, eres tú, viajer{F#a}{M#o}. Así es, Chishan y yo hemos discutido algunos aspectos clave de diseño desde la última prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Después de... una acalorada discusión, estamos preparados para probar un nuevo diseño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Pero hemos tenido algunos desacuerdos sobre los materiales a utilizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "¡Aunque, por una vez, he hecho caso a Chishan! Lo cual me ha costado un buen puñado de Moras en compras de materiales de calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "Pero yo no puedo cargar tanto peso, y Chishan tampoco es tan fuerte, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Te ayudaré a cargarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Sabía que podía contar contigo. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "Chishan escogió los materiales, así que no debería haber ningún problema esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "Y también he preparado una buena recompensa para ti. Después de toda la ayuda que nos has prestado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "Está bien, vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
