			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330201,
					"content": "#¡Listo! Gracias, viajer{F#a}{M#o}. El encargo fue viento en popa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330202,
					"content": "Pero... ¿todos los encargos son como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330203,
					"content": "Hay otros tipos de encargos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "#No te oyes muy entusiasmad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200330207,
					"content": "Ya veo... ¡Está bien! ¡Entonces tendré que seguir esforzándome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330208,
					"content": "Cuando tenga suficiente dinero, ¡me llevaré a mi hermano y a mis padres de viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330209,
					"content": "Mi hermano siempre ha querido viajar, pero... como yo estaba enferma, tuvo que quedarse a cuidarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330210,
					"content": "Ahora ya me siento mejor, ¡y ya me convertí en una aventurera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330211,
					"content": "Jeje, es hora de cumplir los sueños de mi hermano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330205,
					"content": "Pronto lo entenderás...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "Oye, no pongas esa cara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
