	"talks": [
		{
			"id": 2003301,
			"completionStepIds": [
				2003301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003301",
							"2"
						],
						"stepId": 2003301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "#¡Viajer{F#a}{M#o}, mira! ¿Qué te parece mi ropa? ¿Me veo bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330102,
					"content": "¿Esa ropa? No me digas que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "¡Así es! Aprobé el examen del Gremio de Aventureros, ¡oficialmente ya soy una aventurera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330104,
					"content": "¡Luces bien!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Jeje, gracias. Intenté convencer a mi hermano de que también lo intentara, pero se negó rotundamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330107,
					"content": "No me interesa la aventura... Además, ¿quién va a cuidar de mamá y papá si los dos somos aventureros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330108,
					"content": "Entonces podemos llevarlos con nosotros, ¡y viajar todos juntos por el mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330109,
					"content": "*Suspira*... Está bien, ahora que eres una aventurera, haz lo que tengas que hacer. Yo me encargaré de la casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330110,
					"content": "¡Pero ten cuidado! No vayas a lastimarte o esforzarte de más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330111,
					"content": "¡Lo sé, lo sé! Ya me voy, ¡tengo que completar un encargo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330112,
					"content": "#Viajer{F#a}{M#o}, ¿quieres acompañarme? Todavía tengo muchas preguntas sobre aventureros que quiero hacerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330113,
					"content": "Sí, claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Bien, veamos... El encargo de hoy es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330116,
					"content": "¡Escoltar un globo de carga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330114,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "¡Felicidades!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
		{
			"id": 2003302,
			"completionStepIds": [
				2003304
