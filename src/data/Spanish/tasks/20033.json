			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330301,
					"content": "#Viajer{F#a}{M#o}, por favor, cuida de Anna. La emoción se le ha subido a la cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330302,
					"content": "¿No quieres que sea una aventurera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330304,
					"content": "Respeto los deseos de mi hermana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330305,
					"content": "Ahora que se recuperó de su enfermedad, tiene la oportunidad de perseguir sus sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330306,
					"content": "Como su hermano, yo... la apoyaré incondicionalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330307,
					"content": "Es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
}