			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "*Suspira*... no me digan que la dejé en la cima de la montaña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170102,
					"content": "Abuela, ¿qué hace en un lugar así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "#¡Ay! ¿Qué hacen ustedes dos jovencit{F#as}{M#os} en un lugar como este? ¡Qué gran coincidencia! Allá arriba soplan vientos muy fuertes, con tan poca ropa se congelarán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170104,
					"content": "Vengo de ver a un viejo amigo en la Montaña Hulao. Después de hablar largo y tendido sobre cosas del pasado, decidí regresar a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170105,
					"content": "Pero de repente, a mitad del camino descubrí que perdí algo. Tal vez se me cayó en la Montaña Hulao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170106,
					"content": "Caminé por horas, pero la senda está repleta de pilas de ámbar, y mis rodillas ya no tienen fuerzas para una segunda vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170107,
					"content": "#Jovencit{F#as}{M#os}, ¿pueden ayudarle a esta anciana a encontrar lo que perdió en la Montaña Hulao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170108,
					"content": "¿Quién es tu amigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "*Suspira*, ese que vive en la Montaña Hulao. Estoy segura que lo han visto. Su ámbar es un verdadero dolor de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170110,
					"content": "También es culpa de mi mala memoria, olvidé poner esa caja en la tetera. Hay tantas cosas dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170111,
					"content": "¿Qué se le cayó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "Es una caja. *Suspira*, tengo tan mala memoria... si la hubiera guardado en mi tetera, habría evitado todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170113,
					"content": "Pero si de verdad se me cayó esa caja en la Montaña Hulao, estoy casi segura que debió quedar encerrada en una de esas pilas de ámbar. Son fáciles de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170114,
					"content": "#Jovencit{F#as}{M#os}, ¿pueden subir a la Montaña Hulao y buscar en esos montones de ámbar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170115,
					"content": "Por cierto, deben tener cuidado. Esas formaciones de ámbar han existido por años, ¿quién sabe qué resguardan en su interior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 2211703,
			"completionStepIds": [
				2211703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
