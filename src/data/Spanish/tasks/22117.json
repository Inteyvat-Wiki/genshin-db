			"dialogs": [
				{
					"id": 221170401,
					"content": "¡Deberían arroparse mejor! Estarán en apuros si pescan un resfriado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170402,
					"content": "Sobre el ámbar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "Son obra de mi viejo amigo. Me dice que es para protegerse de monstruos y bandidos de la montaña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170404,
					"content": "Ahí han estado desde tiempos inmemoriales, así que algunos montones de ámbar resguardan cosas muy extrañas en su interior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170405,
					"content": "Ese ámbar es realmente desagradable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170406,
					"content": "¿Cómo está la tetera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Oh, tengo que darles las gracias. Al fin quedó como nueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170408,
					"content": "De hecho, la razón por la que vine a recoger esa cosa fue para darle lustro a mi tetera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170409,
					"content": "Una vez que esté impecable y en perfecto estado, finalmente podré traer a mis invitados a tomar el té de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		}
	]
