			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "¡Deberían arroparse mejor! Estarán en apuros si pescan un resfriado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170302,
					"content": "Madam, ¿es esto lo que se le cayó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Déjame ver... ¡Sí, es esto! De verdad se me cayó en la montaña. Mi memoria no me falla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170304,
					"content": "No vale la pena ver su interior. Tiene objetos poco interesantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170305,
					"content": "Esto es para ustedes. Gracias por ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170306,
					"content": "Antes de que lo olvide, pondré la caja en mi tetera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		},
