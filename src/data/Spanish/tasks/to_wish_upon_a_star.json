			"dialogs": [
				{
					"id": 750210701,
					"content": "¡Guau! Es increíble, ¡encontraron todos los fragmentos de estrella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "Suelo ayudar a mamá Coco y conseguí ahorrar bastante dinero, les ofrezco todos estos Moras para comprar esos fragmentos de estrella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "¿Fragmentos de estrella? ¿Sabes para qué sirven? Bueno, antes de todo, ¿por qué estás solo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "... Me llaman Orqo. También pueden llamarme así, aunque hoy en día, el nombre no es más que un apodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "Estoy aquí para reunir los fragmentos de estrella, ¿vieron esa roca grande de abajo? Es una estrella que cayó del cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "Si uno le devuelve los fragmentos perdidos, podrá recuperar el poder perdido. Por favor, ayúdenme, realmente necesito los fragmentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Suena muy sospechoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Bueno, es una pista. ¿Qué tal si lo intentamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Volviendo al tema, eso de los fragmentos de estrella y el poder perdido... a Paimon le suena a argumento de novela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "¿Nunca escucharon «La historia de Qoyllor y Ukuku»? Pues se la contaré. Mi padre me la contó tantas veces que ya me la aprendí de memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "Pero, primero, ¡bajemos a echar un vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "Llegan frente a la estrella caída con Orqo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "Vamos, coloquen los fragmentos de estrella en su lugar. Guau... ¿Qué poder se despertará en mí? Quizá pueda volar por los cielos... jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "¿En serio? Pues razón de más para no dártelos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Solo es un niño, no le hagas sufrir, anda. Además, no sabemos si lo que dice es verdad o no. ¿Qué tal si probamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
