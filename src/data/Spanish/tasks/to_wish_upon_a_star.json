				]
			},
			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}, ¿sentiste algún poder misterioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "No ha sucedido nada con la gran roca, ni ha brillado ni se ha partido. Tampoco hubo temblores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "¿Acaso el conjuro estaba mal? Para Paimon sonaba bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Ya nos ha pasado en algunas ruinas. Si recordábamos mal la contraseña o algún código secreto, los mecanismos no reaccionaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Qué raro... Alguien me lo contó y dijo que si lo hacía así, podría liberar mi poder oculto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "Esa persona se tapó los ojos y emitió unos gritos de dolor tras pronunciar el conjuro. Después de eso, ¡obtuvo una vista mística que podía determinar el valor de las gemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "¡Guau! ¡Es increíble!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "¿Eh? Pues a Paimon le parece muy sospechoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "¡Por fin te encuentro, pequeño renacuajo! ¿Qué haces ahí? ¡Tu padre no te podía localizar por ninguna parte y está muy preocupado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211312,
					"content": "Ya le dije que regresaría a la hora de comer, ¿por qué te lo tiene que contar todo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "#¿Encima protestas? Vamos, sube, que suban {F#las chicas}{M#los chicos} que están a tu lado también. ¡A saber qué peligro puede haber allí abajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211314,
					"content": "Suben a la superficie y explicas la situación...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "#*Suspira*, todo lo que les contó eran fantasías de niños. Siento que hayan acabado involucrad{F#a}{M#o}s en un malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211316,
					"content": "Este niño es bastante travieso porque creció sin su mamá a su lado y su papá tiene problemas de vista. No ha tenido a nadie que lo educara como es debido. Como vecina, intento echar una mano, pero tampoco puedo estar en todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211317,
					"content": "Vaya, ¡Paimon sabía que no habría algo tan rentable como conseguir un poder misterioso por solo reunir fragmentos de piedras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "No soy travieso, lo hago por papá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "¿Pero cómo eres tan cabezota? ¡Ya podrías escuchar a tus mayores! Esta vez volviste sano y salvo, pero ¿qué pasa si algún día te ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211320,
					"content": "En fin, haz el favor de comportarte y ven conmigo a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211321,
					"content": "#De acuerdo, pero antes de eso... {NICKNAME} y Paimon, estos son los Moras que les prometí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Tómenlos, es importante que aprenda a cumplir su palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211323,
					"content": "Bueno, entonces no los vamos a rechazar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "Sí, además, quizá les pida más favores en el futuro. Esta vez fracasé, pero eso no significa que no lo consiga la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Este niño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mamá Coco"
				},
				{
					"id": 750211327,
					"content": "#Mamá Coco, vamos, que papá está esperando. {NICKNAME} y Paimon, gracias. ¡Hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Estos síntomas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
