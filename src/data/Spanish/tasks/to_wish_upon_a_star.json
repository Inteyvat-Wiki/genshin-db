			},
			"dialogs": [
				{
					"id": 750210501,
					"content": "Esto sería todo, ¿verdad? ¡El encargo de esta vez parece más fácil de lo que Paimon pensaba! Pero ¿realmente sucederá el milagro? Paimon tiene dudas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "¿Tú también quieres despertar poderes ocultos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "Claro que sí, si Paimon tuviera el poder de encontrar cofres de tesoro o una fuerza sobrenatural para acabar con los monstruos de un golpe, ¡eso nos facilitaría muchas cosas! ¿No crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "¡Necesito más podeeeer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "¡Muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "Vamos, coloquen los fragmentos de estrella en su lugar. Guau... ¿Qué poder se despertará en mí? Quizá pueda volar por los cielos... jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "¡Ya tengo mucho poder, no necesito más!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "¿Eh? ¿Pero no dicen que la búsqueda de poder no acaba nunca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
