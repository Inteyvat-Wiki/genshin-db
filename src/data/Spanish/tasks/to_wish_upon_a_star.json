				]
			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "Uff... Yo solo no habría podido bajar, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "¿Esta es una estrella caída del cielo? Si Paimon la observa de cerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "¡Aah! ¡Siento que un poder misterioso emana de mi cuerpo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "¿Qué? ¿En serio? Espera, ¡si aún no hemos encontrado los fragmentos...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "Hablando de eso, ¿de verdad que aquí están las pistas? Paimon está muy perdida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "¿Qué hacemos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Supongo que tendremos que usar la fuerza. Quizá <color=#00E1FFFF>golpeándola con la fuerza de un Tepetlisaurio</color> descubramos dónde se localizan los fragmentos perdidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "Mi padre me dijo que la mayoría de los problemas se pueden resolver con la fuerza. Pero mi poder aún no se ha despertado y tampoco tengo mi propio saurio... Así que dependo de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Qué roca más extraña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "En efecto, es muy especial... ¿Es que acaso Paimon es muy lenta? Paimon no siente ningún poder misterioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
