			"dialogs": [
				{
					"id": 750210101,
					"content": "Oye, ¿qué estás haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "¡Aah! ¡Qué susto! ¿Qué habrías hecho si me llego a caer? Mis poderes ocultos aún no han despertado, ¿sabes? Ahora mismo no soy más que un niño indefenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Ah, Paimon lo siente, no era su intención asustarte... ¿Dijiste poderes ocultos? ¿Algo así como una habilidad superpoderosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Y yo qué sé. Por algo está oculto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "Tienes toda la razón del mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Dejemos este tema, ¿pueden ayudarme a encontrar fragmentos de estrella? Suelo ayudar a mamá Coco y conseguí ahorrar todos estos Moras. Se los pueden quedar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Ya que nos quieres pedir un favor, es justo que nos digas primero tu nombre. Mira, Paimon es Paimon, y {M#él}{F#ella} es {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "Los nombres de ahora son solo un apodo... Todos me llaman Orqo, así que me pueden llamar por ese nombre. Entonces, ¿me ayudarán con los fragmentos de estrella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Humm... ¿Qué es eso? A Paimon no le suena fácil de conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "Son fragmentos de estrellas que se desprendieron durante la caída. Si los encuentro y los coloco en su sitio original, podré recuperar el poder que una vez perdí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "Miren, allí abajo hay una estrella que cayó del cielo. Si bajamos podremos encontrar pistas de los fragmentos. ¡Ayúdenme! Porfi, porfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "De acueeerdo, te ayudaremos esta vez. Aunque eso de los fragmentos de estrella y el poder perdido... a Paimon le suena a argumento de novela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "¿Nunca escucharon «La historia de Qoyllor y Ukuku»? Pues se la contaré. Mi padre me la contó tantas veces que ya me la aprendí de memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Pero, primero, ¡bajemos a echar un vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "No te falta razón, chico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
