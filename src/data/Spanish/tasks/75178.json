			"dialogs": [
				{
					"id": 751780901,
					"content": "#Hola, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751780902,
					"content": "¿Por qué estás tan decaída?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "En realidad... me da la sensación de que la temperatura del agua es un poco más fría de lo normal. Creo que me metí en un buen lío. ¿Qué voy a decir cuando regrese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751780905,
					"content": "Tranquila, dale un poco más de tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "De acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				},
				{
					"id": 751780903,
					"content": "Me tengo que ir, adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#Eh... Ve con cuidado, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				}
			]
		},
