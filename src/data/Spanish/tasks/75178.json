							-2478.337,
							257.8,
							10471.95
						],
						"pointId": 10893
					}
				]
			},
			"dialogs": [
				{
					"id": 751780101,
					"content": "¡Hola! Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#¡Cuánta intensidad, cuánta fuerza! ¡Así que ustedes son {F#las}{M#los} legendari{F#a}{M#o}s {NICKNAME} y Paimon! Acaso... ¿han venido hasta aquí para competir por el título del más fuerte de la Comunidad de la Feracidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "¿El título del más fuerte de la Comunidad de la Feracidad? ¿No es esto un Desafío del Audaz normal y corriente? ¡Si hay un montón de gente haciendo cola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "Jajaja, ellos no pueden compararse con ustedes. Ya sabrán que para hacerse con el título del más fuerte, se debe vencer al más fuerte. La gente normal no tiene esa capacidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "¡Qué bien que hayan venido! Aunque, tristemente y por desgracia, no han llegado en un momento oportuno. El gran maestro ahora mismo no tiene tiempo para ocuparse de asuntos mundanos, así que me temo que, por ahora, no podrán enfrentarse a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "¿Y dónde está ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "¿Eh? ¿Es que quieres retarlo? Qué coraje... Está bien, te diré dónde se encuentra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "Siguiendo ese camino duro y escarpado del entrenamiento, verán unas tierras ricas en esas “aguas de la intensidad”. Puede que ahí encuentren al adversario más fuerte que están buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "Esperaremos entonces a que vuelva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "Exactamente, la intensidad es atraída por la intensidad. Los más fuertes se encontrarán, por lo que esperar no es una mala opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
