				]
			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "¡Qué “fría”! ¡¿Cómo puede estar tan “fría”?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780702,
					"content": "¿Qué? ¿Cómo que “qué fría”? ¿Acaso no te encuentras en unas aguas termales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "No, no, ¡no es suficiente! Para ser el más fuerte de toda la Comunidad de la Feracidad, no, de toda Natlan, ¡esta “intensidad” no es suficiente ni de lejos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780704,
					"content": "¿Eh?... ¿Por qué te has vuelto a sentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "Porque la “intensidad” no es suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "¿Qué quiere decir eso de la “intensidad”? ¿Es Paimon la única que no se está enterando de nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Oh, ustedes deben de ser {F#las famosas aventureras}{M#los famosos aventureros} {NICKNAME} y Paimon. ¡Estamos salvados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "Un momento, ¿qu-qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "Les voy a ser sincero. Según lo que dice el maestro, está recorriendo un camino para convertirse en el más fuerte y, para ello, se está entrenando en las aguas termales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "¿Que se está entrenando? ¿En unas aguas termales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "S-sí... Tampoco es que me lo crea del todo. La idea le vino de un libro de artes marciales llamado «El camino de los manantiales ardientes».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "El libro dice que si te entrenas siguiendo las directrices del camino de los manantiales ardientes, llegará un día en el que podrás <color=#00E1FFFF>hacer que el agua helada hierva</color> con tu propia “intensidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "¡Y eso no es todo! Este libro también habla de multitud de personas de gran poder. ¡Algunas de ellas son capaces de partir una montaña en una sola noche y sin ayuda de ninguna herramienta! ¡Y otras pueden transformar piedras en gemas con sus propias manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#¡Paimon no sabía que hubiera artes marciales tan extraordinarias en el mundo! Si tú también pudieras aprender algo así, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "Guau, parece sacado de una novela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Quizá piensen que es ridículo, pero este libro se trata de un tesoro que mi maestro logró encontrar en las colecciones de los Augures Vientonocturno, y lo que es más importante, él cree completamente en su poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "Para poner en práctica el camino de los manantiales ardientes, el maestro seleccionó estas aguas termales... No, mejor dejémoslo en “aguas” a secas, porque están heladas. ¡Su objetivo es convertir estas aguas heladas en aguas termales con nada más que su pura “intensidad”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "¡E-es verdad!... ¡Estas aguas termales no están nada calientes! Pero... Si alguien se queda a remojo aquí, Paimon cree que acabará enfermando por muy fuerte que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "¡Y aunque no lo hiciera! Esto no puede seguir así. El Desafío del Audaz lleva varios días suspendido, y están todos esperando a que regrese el maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Pero él insiste en que tirar la toalla a mitad de camino es un acto de poca “intensidad”, así que dijo que no se marcharía hasta que hiciera hervir el agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "El encargado tampoco pudo encontrar la razón por la que las aguas termales se habían enfriado. *Suspira*, ojalá hubiera aquí un aventurero experimentado... Ya tenía la recompensa preparada y todo. Mira, todo esto para quien consiga solucionar el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Deberías pedir ayuda al Pueblo de los Manantiales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "(No te apresures a rechazar la oferta. Veamos cuánto ofrece.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "*Ejem*, no te preocupes, encontraremos la forma de volver a calentar estas aguas termales. No nos quedaremos de brazos cruzados mientras enferma de frío. Al fin y al cabo, los buenos aventureros siempre están dispuestos a ayudar a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Ay, ¡muchas gracias, de verdad! Cuento con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Quédate aquí esperando. ¡Lo solucionaremos enseguida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "¿Crees que me voy a dejar convencer por esa recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "No te lo creerás, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "Porque si se queda de pie tendrá más frío.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Aah, ¡con razón estaba temblando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
