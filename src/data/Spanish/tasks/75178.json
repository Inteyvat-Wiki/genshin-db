			"trigger": {
				"objectNames": [
					"Yoleehe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "¡Que alguien nos ayude! ¡Se ha desmayado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Oh, no, ¡parece que el maestro se ha desmayado! ¡Vamos a ayudarlo, {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Por lo visto, el maestro solo se había desmayado del calor y su vida no corría ningún peligro. Con su ayuda, Yoleehe se lleva al maestro inconsciente...\\nParece ser que el maestro necesita aprender a tolerar mejor la “intensidad”...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7517803,
