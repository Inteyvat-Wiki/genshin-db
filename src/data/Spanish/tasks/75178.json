			},
			"dialogs": [
				{
					"id": 751781401,
					"content": "¿Eh? ¿Una cría de Koholasaurio? ¿Qué hace aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "¡Ki'o-ki'o! ¡Aquí estabas! Si seguían sin aparecer, me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781403,
					"content": "¿Y si se hubieran lastimado? No lo vuelvan a hacer, *solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781404,
					"content": "N-no llores... ¿No ves que el pequeño está perfectamente? ¡Mira qué alegre está!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Sí... Tranquila, estoy bien. Ah, se me olvidó presentarme. Soy Linaha, del Pueblo de los Manantiales, y estoy aquí a cargo de cuidar de las crías de Koholasaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781407,
					"content": "¿Tú solita? ¡Increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "Qué va... Si fuera tan increíble como tú, seguro que no los perdería de vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781409,
					"content": "Estaba pensando que podrían haber ido todos a jugar cerca de los orificios, y resulta que tenía razón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781410,
					"content": "Así que las aguas termales se habían enfriado porque los Koholasaurios habían bloqueado los orificios de flogisto. ¡Con razón el encargado no se había dado cuenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "P-Paimon, la verdad es que... aún hay dos Koholosaurios que no encuentro. Imagino que también se habrán escondido en los orificios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781412,
					"content": "¡No te preocupes! Cuando vayamos a ajustar la temperatura del agua, ¡nos encargaremos de buscarlos y traerlos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "¿De verdad? ¡Bieeen! ¡Paimon es la mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781414,
					"content": "¡Jaja, por supuesto! ¡Después de todo, Paimon es una aventurera legendaria! ¡Un pequeño desafío como este resulta pan comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "¡Guau! ¡Paimon, eres increíble! ¡Quiero ser como tú cuando crezca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 751781416,
					"content": "¡Paimon, cuánto te admiro! ¡Eres la mejor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
				{
					"id": 751781418,
					"content": "(Harás quedar bien a Paimon delante de los demás, ¿a que sí? Paimon te promete que te dejará a ti lo más rico de la cena. Porfa, porfa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781419,
					"content": "*Ejem*, en fin, ¡pongámonos en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781417,
					"content": "La próxima pelea la dejaré en tus manos, oh, gran aventurera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				}
			]
		},
