			"dialogs": [
				{
					"id": 751781001,
					"content": "Humm... Le prometimos que íbamos a ayudar, pero... ¿por dónde deberíamos empezar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781002,
						751781005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781002,
					"content": "¿Y si usamos el maravilloso flogisto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "¡Imposible! ¡El área es demasiado grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781009,
					"content": "*Suspira*, ¿no hay ninguna solución más factible?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781010,
					"content": "¿Grrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#¡Espera! ¡No corras, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "Debería haber mucho magma en el volcán...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Ah, Paimon ya sabe en qué estás pensando. Quieres que el pequeñín excave un agujero y dejar que el magma del volcán caliente el agua, ¿es eso? Qué buena idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "¡Grrr, grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#¡Ni hablar! ¡Eso es poner en riesgo la vida de las personas! ¡Deja de gastarle bromas, {NICKNAME}, que {REALNAME[ID(2)|SHOWHOST(true)]} se lo cree todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				}
			]
		},
