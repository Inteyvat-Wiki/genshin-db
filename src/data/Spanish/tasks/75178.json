			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Loshts"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "#Guerrer{F#a}{M#o} de tierras lejanas, ¿cómo te va todo? ¿Ya encontraste al más fuerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780502,
					"content": "¿Dónde se encuentra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Subiendo por la ladera de la montaña, te encontrarás con unas tierras ricas en esas “aguas de la intensidad”. Allí puede que encuentres pistas del más fuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780503,
					"content": "Todavía estoy en ello...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "¡Estupendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
