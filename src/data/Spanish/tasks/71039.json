				"points": []
			},
			"dialogs": [
				{
					"id": 710390101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390102,
						710390103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390102,
					"content": "¡Hola, Jinwu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "¡¿...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390105,
					"content": "¡Ah! ¡Qué susto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390106,
					"content": "Lo... Lo siento. Si estás buscando a Zhichiong... Ya se marchó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390107,
					"content": "¿Adónde fue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "No lo sé... Me despisté un momento y ya no estaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390112,
					"content": "Intenté hablar con ella... Pero insistió en marcharse. No pude hacer nada para que se quedara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390113,
					"content": "*Suspira*... Espero que sepa lo que está haciendo. De verdad que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390114,
					"content": "Espero que así sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390115,
					"content": "Deberíamos decírselo a Muning para que envíe un equipo de rescate de inmediato. ¡Cuanto antes la encuentren, mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390116,
					"content": "#Iremos nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "De verdad... ¡Zhichiong desapareció de nuevo! ¡Volvamos a la superficie a buscar a Muning!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390117,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "¿Cómo estaba cuando se fue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390111,
					"content": "Khedive la examinó. Dijo que es grave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390103,
					"content": "¿Cómo estás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103903",
							"2"
						],
						"stepId": 7103903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "¿Eh? ¿Zhichiong no ha venido contigo? Ha llegado una carta de recomendación del Ministerio de Asuntos Civiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390202,
					"content": "El mapa que le dibujó al Salón Huishan les fue de gran ayuda. El Ministerio de Asuntos Civiles quiere contratarla como... Espera, déjame ver... Asesora. Así podrá disfrutar de las ventajas de un trabajo formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390203,
					"content": "¡Bien por Zhichiong! Parece que corretear de un lado para otro al final le ha servido para algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390204,
					"content": "Se ha marchado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "¿Qué? ¿Se ha marchado? Pero los de la Geoarmada no me han avisado de nadie que haya abandonado la Sima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390206,
					"content": "Zhichiong ha dejado el equipo de espeleología.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "¿Ah, sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390208,
					"content": "¡Espera un momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390209,
					"content": "Dices... ¿Dices que Zhichiong ha abandonado el equipo de espeleología?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390210,
					"content": "¿Lo ha dejado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390211,
					"content": "¡Pues sí! ¿Qué parte es la que no entiendes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390212,
					"content": "Entiendo. Enviaré un grupo de rescate de inmediato. Si sigue en la Sima, la encontraremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390213,
					"content": "Da igual si anda por ahí haciendo alguna de las suyas o si se ha marchado por otro motivo... Tenemos que encontrarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390214,
					"content": "En su estado actual, abandonar el equipo e irse por su propia cuenta es una locura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390215,
					"content": "¿Puedo ayudar en algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "Lo siento, esta vez no te molestaré... Es hora de que yo también me haga cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390233,
					"content": "Estaré por aquí si me necesitan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "¡Eso, eso! ¡Paimon también! No podemos dejar que te encargues de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390235,
					"content": "#¡Estaremos atent{F#as}{M#os}! Tal vez nos la encontremos por el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390217,
					"content": "Sobre Zhichiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "Es una muchacha inquieta pero, a pesar de todo, somos amigos. Sé que no soy demasiado amigable... pero no puedo olvidar a mis amigos así como así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390219,
					"content": "Ha resultado herida no sé ni cuántas veces ya, hasta casi pierde la vida en el camino... Todo por ese gran sueño suyo de ser aventurera. Y ahora que parecía que había sentado cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390220,
					"content": "Tenía la esperanza de que hubiese abandonado esos sueños irreales suyos. Roald... Stanley... Con ellos las cosas no fueron precisamente de color de rosa, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390221,
					"content": "*Suspira*, nunca lo imaginé... Tal vez no debí pedirte que vinieras a la Sima. Si no lo hubiera hecho, Zhichiong no estaría en esta situación nuevamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390222,
					"content": "Pero sus esfuerzos dieron frutos al final.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "¿Frutos? Si lo dices así, suena un poco egoísta. El mapa subterráneo que dibujó de todo el área sí que nos vino muy bien, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390224,
					"content": "Darle más importancia a algo tan ilusorio como un sueño antes que a tu propia vida es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390225,
					"content": "Soy incapaz de comprenderlo. Tampoco puedo imaginar cómo alguien se pondría a sí mismo en peligro por razones como esa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390232,
					"content": "Así que yo me encargaré de buscarla... Bueno, el equipo de rescate de la Geoarmada se encargará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390226,
					"content": "Pero supongo que es su elección.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "¿Su elección? ¡Es una excusa! Está cavando su propia tumba, ¿o es que no te das cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390228,
					"content": "Jaja, lo siento. He sido un poco duro al decir eso. Pero... pero Zhichiong debería tener más paciencia, sobre todo cuando se trata de algo a lo que las personas comunes y corrientes no podemos enfrentarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390229,
					"content": "En treinta... quizá incluso veinte años, ¡podríamos tener equipos de exploración subterráneos más seguros! Entonces, no tendría que preocuparse por hacer expediciones para elaborar mapas del subsuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390230,
					"content": "Pero no quiere esperar... ¡Quiere triunfar a lo grande cuando todavía es muy joven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390231,
					"content": "Mira que es descuidada... Como amigo, no puedo mirar hacia otro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Muning"
				}
			]
		}
	]
}