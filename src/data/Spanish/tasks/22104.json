			"dialogs": [
				{
					"id": 221040101,
					"content": "¿Qué debo hacer?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "¿Eh? Lo siento, ¿desde cuándo está ahí parado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040104,
					"content": "Lo que pasa es que cada vez hay más monstruos en los alrededores. Mi esposo siempre insiste que nunca se atreverían a entrar a la posada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040105,
					"content": "Pero me preocupa que vaya él solo a hacerse cargo de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040106,
					"content": "Si tiene tiempo, ¿puede echarle un ojo a los alrededores de la posada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040107,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "Gracias por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040113,
					"content": "En fin, confío en usted. A su regreso le daré una pequeña recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040108,
					"content": "¿Qué hace una posada en un lugar como este?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "Oh, solo somos una simple posada un poco apartada del camino y con muchos huéspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040111,
					"content": "Para los viajeros que merodean afuera siempre es un alivio tener un lugar donde comer y dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040112,
					"content": "Eso es lo que pensamos mi esposo y yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
