			},
			"dialogs": [
				{
					"id": 705450101,
					"content": "Miau, ¡miau, miau! ¡Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "¡Miau, miau! ¡Miau, miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Gruñidos"
				},
				{
					"id": 705450103,
					"content": "Humm... Paimon opina que Gruñidos y Amber tienen razón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "¿En serio? Qué cosas me cuentas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Claro, tienes toda la razón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "Paimon tampoco comprende nada, ¡pero Paimon sabe que Gruñidos y Amber llegaron a algún acuerdo mutuo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#¡Hola, {NICKNAME} y Paimon! Me alegro de ver{F#las}{M#los}, precisamente l{F#a}{M#o}s estaba buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "Valerina me dijo que estaban ayudando con la gestión del Palacio Peludino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#¡{NICKNAME}, eres increíble! ¡Acabas de volver a Mondstadt y ya nos estás ayudando un montón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "#Después de todo, soy {F#una}{M#un} Caballer{F#a}{M#o} Honorari{F#a}{M#o}, hago todo tipo de trabajos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Hablando de eso, Paimon quiere saber de qué hablaban Amber y Gruñidos, parecían estar teniendo una conversación muy interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Miau, ¿miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Gruñidos"
				},
				{
					"id": 705450115,
					"content": "Ah... Le estaba preguntando a Gruñidos qué tiempo haría hoy y si iba a llover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "¿Eh? ¿Los gatos tienen esa habilidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Jaja, la Srta. Lisa me lo contó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "La Srta. Lisa leyó en un libro que los gatos son sensibles a la humedad y que por eso la detestan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Por eso, si de repente sienten un aumento de humedad en el aire, se ponen inquietos, se frotan la cara y lamen su pelaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Cuando los gatos hacen eso, puede significar que se acerca una fuerte lluvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "¡Qué curioso! ¡A la cama no te irás sin saber una cosa más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}, a partir de ahora, podríamos observar más a los gatos durante nuestras aventuras, ¡así evitaríamos empaparnos con las lluvias repentinas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Sí, ¡es buena idea!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Venía a consultar algo con la Srta. Valerina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "Hace un momento estaba conversando con esta gatita. Se me ha acercado y se ha tumbado junto a mí soltando un bostezo. ¡¿No les parece adorable?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Ya que se mostró tan cariñosa conmigo, yo también debería demostrarle mi aprecio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "Entonces, recordé lo que me dijo la Srta. Lisa y le pregunté a Gruñidos sobre el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Pero Gruñidos no para de frotarse la cara, mover la cola y hacerme cosquillas en la mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "*Suspira*, así que no sé si va a llover en los próximos días...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "¡Pero si yo ya estoy siempre pendiente de ellos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "Proteger a los gatos de Mondstadt también es uno de mis deberes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "Espera, hay algo que no he terminado de entender...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}