			"dialogs": [
				{
					"id": 700730401,
					"content": "Bien, no te molesto más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730402
					]
				},
				{
					"id": 700730402,
					"content": "Ve donde desees, pues la seta no necesita protección.",
