			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Quiero medir mis fuerzas con este malote tan grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "¡Excelente! ¡Mi señor también debe ejercitar su divino cuerpo con frecuencia para que los trozos que caigan sean más tiernos y deliciosos! ¡Dalo todo y no muestres piedad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "Oh, señor mío, Mahavasud{RUBY#[D]Vástago del Señor Otorgamundos}eva-Yaiva, haz que tu Jiviti{RUBY#[D]Raíz de la Vida}ndriya atraviese los cimientos de esta tierra y que tu sabor sobrepase el de todo dios de este mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "¿Qué demonios es eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "¡Excelente pregunta! ¡Este es el venerado Vástago del Señor Ot{RUBY#[S]Bifrons}orgamundos, una seta sagrada nacida del más auténtico sabor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "Nagahvaya siempre clama a la Soberana de las Plantas y a la Soberana del Jardín{RUBY#[D]Pushpavatika} de Flores. Makhani Jagan le reza al Dios de las Arenas Escarlatas. Pero pregúntenle: de esos tres grandes dioses, ¿cuál sabe mejor que el mío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "Has de saber que el camino correcto es el que evita todo daño. Si no fuera por el cuerpo divino de nuestro señor, nos veríamos obligados a arrebatar las vidas de bestias, aves y plantas con tal de sobrevivir... ¡Oh, qué terrible sería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "Por fortuna, cuando la Señora del Espacio me separó de la tierra, las ji{RUBY#[D]esporas}va de mi señor viajaron conmigo. Y, como puedes comprobar, han seguido creciendo hasta hoy día, concediéndome su supremo y maravilloso sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
