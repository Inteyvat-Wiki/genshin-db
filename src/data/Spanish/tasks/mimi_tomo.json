				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "#Viajer{F#a}{M#o}, ¡por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240102,
					"content": "Perdón por robarte tu tiempo. Una pregunta, ¿te interesaría aceptar un nuevo encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240103,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "Verás, según los últimos informes del gremio, se han visto muchos Hilichurls en el campo obstaculizando las rutas comerciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240106,
					"content": "Ya enviamos muchos aventureros para hacerse cargo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240107,
					"content": "... según ellos mismos, entre todos esos Hilichurls siempre hay uno extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240108,
					"content": "Pensamos que ese Hilichurl extraño podría estar relacionado con estos incidentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240114,
					"content": "Necesitamos que alguien capture o, al menos, expulse a ese Hilichurl extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240109,
					"content": "#Viajer{F#a}{M#o}, ¿te gustaría aceptar este encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240110,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "Gracias. ¡Ya marqué la ubicación en tu mapa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240113,
					"content": "En todos estos lugares ha habido avistamientos de Hilichurls, así que, por favor, empieza por ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240115,
					"content": "Si lo encuentras, por favor, ten mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240111,
					"content": "Lo tendré en cuenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "¿Qué tipo de encargo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
						],
						"stepId": 7002404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "Menos mal que vinimos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "Uf, por poco... Menos mal que vinieron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240204,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240205,
					"content": "Todo estaba yendo muy bien, ¿con qué frase me habré equivocado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240206,
					"content": "En cualquier caso, gracias por salvarme a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240207,
					"content": "Pareces bastante triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240208,
					"content": "Bueno, ustedes también vieron lo que acaba de ocurrir, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240223,
					"content": "Es que es demasiado peligroso que vaya yo sola a hablar con ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240210,
					"content": "Ajá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "¿Necesitas ayuda con algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "Pero no dejaré pasar esta oportunidad de comunicarme con los Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240212,
					"content": "De seguir así, me temo que tendré que posponer la compilación de mi diccionario una vez más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240213,
					"content": "Puedo ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "Agradecería mucho que alguien pudiera ayudarme a confirmar la precisión de algunos aspectos de mi libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240214,
					"content": "¿D-de verdad? ¡Genial! Entonces, ¡llévense este libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240215,
					"content": "Guau... Sí que se volvió mandona de repente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240217,
					"content": "¿Solo en teoría?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "Si te encuentras con alguna barrera lingüística, puedes solucionarlo buscando la palabra que necesites. Al menos, en teoría debería ser así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240218,
					"content": "Es decir, ¡que ni siquiera tú sabes lo que has escrito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240219,
					"content": "¡Eso es justo lo que preguntaría un novato! Si una investigación científica no se prueba en la vida real, ¿cómo vas a saber si su lógica es correcta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240225,
					"content": "*Suspira*, bueno, no creo que lo entiendas aunque intente explicártelo. En fin, muchas gracias por haberme salvado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240221,
					"content": "Claro, ¡bienvenida al equipo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "Bueno, ya que estás aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "Si no les importa, ¿podría ir con ustedes a conversar con los Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "Ella Musk"
				}
			]
		}
	]
}