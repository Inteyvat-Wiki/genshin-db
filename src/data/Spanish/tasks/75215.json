			"dialogs": [
				{
					"id": 752150301,
					"content": "Reclutar nuevos miembros no es difícil, pero después de un tiempo, mucha gente busca excusas para no venir, o directamente dejan de presentarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "La entrenadora ha ideado muchas formas para motivarlos. El desafío del bloque es una de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "Pero, al final, algunos acabaron lanzándose contra el bloque grande con fuerza para obtener una mejor puntuación, con lo que resultaron heridos. Eso hizo que el número de gente que faltaba aumentara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
