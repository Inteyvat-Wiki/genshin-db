			"dialogs": [
				{
					"id": 402270201,
					"content": "Llevan a Aino y a Ineffa hasta el recinto.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Humm... Este parece un buen lugar para la plataforma de la demostración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270203,
					"content": "Este robot nuevo tiene una pinta muy interesante, Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270204,
					"content": "#Jeje. ¡Vengan y pruébenlo cuando quieran! ¡L{F#a}{M#o}s dejará boquiabiert{F#a}{M#o}s, no hay duda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270205,
					"content": "Gracias por la ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270206,
					"content": "¡No ha sido nada! Oh, y para el registro... ¿Serán solo ustedes dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270207,
					"content": "Humm... Yo participaré, pero no será necesario que Aino se registre. No le gusta estar rodeada de demasiada gente, así que, cuando comience la exposición, volverá al taller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270208,
					"content": "Tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
