			},
			"dialogs": [
				{
					"id": 402270101,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270102,
					"content": "¡Hola, Aino e Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270103,
					"content": "#Hola, {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270104,
					"content": "Estamos ayudando a Néfer con un encargo para la exposición y hemos oído que el Taller de Krumkake Cling-clang también participará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270105,
					"content": "Así es. Aino está realizando la última ronda de ajustes de su Robodefensor Pim-pam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270106,
					"content": "Robodefensor Pim... Oh, ¿se trata de la mercancía del taller para la exposición?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270107,
					"content": "Sí. Los topos y otras pequeñas criaturas suelen robar de nuestro taller, así que Aino diseñó un robot defensivo basándose en ellos para proteger el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270108,
					"content": "Tras probarlo, resultó muy efectivo, así que decidió mejorarlo y prepararlo para la exposición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270109,
					"content": "Un momento, ¿Aino va a comerciar con uno de sus robots?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270110,
					"content": "No exactamente. Aino rara vez vende sus productos finalizados, con excepción de algunos pedidos especiales. Con lo que comerciará en la exposición es con el plano del diseño, no con el producto acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270111,
					"content": "Oh... Entonces, ¿están listas para ir al lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270112,
					"content": "Jahoda nos ha pedido que aceleremos un poco el proceso. Les ha guardado un lugar muy bueno y le preocupa que la gente empiece a hacer preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270113,
					"content": "¡Ya le dije que tenía que acabar con los ajustes primero! ¡Si nos sigue metiendo prisa, no tendré nada con lo que comerciar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270114,
					"content": "Vaya, Paimon nunca había visto a Aino tan seria antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270115,
					"content": "El taller está pasando por un periodo de escasez de fondos. Aino tiene la esperanza de que la exposición mejore nuestra situación financiera, así que está siendo más meticulosa que de costumbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270116,
					"content": "¿A dónde ha ido a parar el dinero? ¿Lo han gastado en algún tipo de investigación cara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270117,
					"content": "No. Los fondos que escasean son los dispuestos para los postres. Hemos registrado 47 casos en los que los excesos de compras de postres han llevado a la escasez de fondos de investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270118,
					"content": "Por tanto, he decidido separar los presupuestos de investigación y postres. Aino tiene terminantemente prohibido transferir dinero de un fondo a otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270119,
					"content": "Y hace poco se terminó el presupuesto entero para postres del mes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270120,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "¡Bueno, ya está listo! ¡Robodefensor Pim-pam, haz que me sienta orgullosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270123,
					"content": "Parece que ya podemos ponernos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270121,
					"content": "¿Por qué no me sorprende?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
