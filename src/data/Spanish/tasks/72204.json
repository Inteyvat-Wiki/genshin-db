			"dialogs": [
				{
					"id": 722040601,
					"content": "Ya veo... ¿Dices que llevaba consigo... esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040602
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040602,
					"content": "¿Qué tienes en mente...? ¿Qué piensas hacer con esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
			"id": 7220407,
			"completionStepIds": [
				7220404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220404",
