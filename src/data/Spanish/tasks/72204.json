					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040201,
					"content": "Bueno, basta. Dejen... a esta anciana... descansar... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040202,
					"content": "Pero tengan cuidado... No vayan... muy lejos... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
			"id": 7220403,
			"completionStepIds": [
				7220402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
