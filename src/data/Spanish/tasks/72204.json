			"dialogs": [
				{
					"id": 722040401,
					"content": "En fin, vayan a jugar... No iré a ningún lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "Los pétalos... Los pétalos... ¿Cómo es tu pueblo natal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
			"id": 7220405,
			"completionStepIds": [
				7220403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220403",
