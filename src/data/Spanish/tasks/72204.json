				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Kito, Kina... ¿Ya están aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040102,
					"content": "En serio, no puedo seguirles el paso de un lado a otro con estas piernas... ¿Qué será de mí si se encuentran con algún peligro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040103,
					"content": "¿Está bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "¡Ay! Qué cosas dicen... Pero después de todo son tan jóvenes. Si siguen diciendo cosas así, terminarán por herir el corazón de esta anciana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040106,
					"content": "En fin, ya que están aquí, ¿por qué no le hacen compañía a la abuela en lugar de corretear por ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040107,
					"content": "Lo siento, yo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "¿En dónde me quedé la última vez? Ah, cierto... Cuando el abuelo de su abuelo aún era pequeño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040110,
					"content": "Más allá del mar de niebla había una isla. En ella vivía el clan Sumari. Su matriarca era una mujer con apariencia de zorro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040111,
					"content": "Se jactaban de que sus tierras estaban repletas de flores del color del trueno. El clan Sumari se había establecido en medio de las montañas y las praderas y llevaba una vida apacible y despreocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040112,
					"content": "Y entonces... *Zzz*... Esas flores... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040113,
					"content": "*Ejem*... Más allá de la niebla... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040114,
					"content": "¿Se encuentra bien, abuela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "Ay... ¿Kito? ¿Kina? ¿Ya se van? *Suspira*... Lo siento... esta anciana otra vez se quedó dormida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040117,
					"content": "Antes de que se vayan, no olviden esto... Su abuela las ha estado guardando todo este tiempo... Estas flores preciosas provienen del otro lado del mar de niebla. No las vayan a perder, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040115,
					"content": "(Es mejor no molestarla...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Creo que se equivocó de persona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
		{
			"id": 7220402,
