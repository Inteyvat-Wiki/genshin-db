					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Hola, hola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "*Suspira*... Lo siento, la cabeza de esta anciana ya no piensa con claridad... ¿Quién eres tú? ¿Nos conocemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "#Nunca había escuchado ese nombre... ¿Eres {F#una forastera}{M#un forastero}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "Qué extraño... Es de lo más extraño... Nadie puede pasear por la isla a sus anchas sin el consentimiento de la gran Ave del Trueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "Hace tiempo que el Ave del Trueno se fue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "Al verte, haces que me acuerde de mi pobre esposo... Pero ahora ni siquiera recuerdo su apariencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "Aún éramos jóvenes, y estábamos llenos de ilusiones ingenuas... Pero algunas personas simplemente no crecen, por más tiempo que se pase con ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "Y entonces me dejó. Construyó una balsa con la intención de cruzar el mar e ir a esa isla desconocida... Dijo que quería cazar con libertad, y recolectar esas flores tan bonitas que nunca antes había visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "Desde pequeño siempre fue así... pero nunca creció.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Eventualmente, el hijo del sacerdote lo encontró en la playa... Yacía ahí, tan silencioso como las caracolas, y más pálido que la propia arena... En sus manos aún sujetaba estos pétalos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "El sacerdote lloró y me dijo que el barco de sus ancestros lo había rechazado, y que a partir de entonces su alma vagaría por aquellas tierras lejanas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "Justo en aquel entonces acababa de dar a luz a nuestro hijo... ¿Qué explicación podía darle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Y después... mi hijo también tuvo hijos, a quienes despedí en la barca plateada... Y mientras tanto, yo sigo aquí, en esta isla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Ahora los únicos que me preocupan son Kito y Kina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Puede llamarme {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
