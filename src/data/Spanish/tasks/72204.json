			"dialogs": [
				{
					"id": 722040901,
					"content": "#Ah, viniste... ¡Kito! ¡Kina! ¡Vengan a saludar a nuestr{F#a}{M#o} invitad{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040902
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040902,
					"content": "No sé a dónde corrieron. *Suspira*, lo siento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040903
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040903,
					"content": "Por cierto, ¿cómo te llamabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040904,
						722040905
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040904,
					"content": "#{NICKNAME}. Saludos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				},
				{
					"id": 722040906,
					"content": "Oh... Yo... estaba a punto de irme, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040907,
					"content": "¿Irse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Ese barquero ha estado viniendo a convencerme de ir con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040909,
					"content": "Siempre viene en silencio, vistiendo un abrigo de piel dorado, pantalones dorados y una corona de hilos de oro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040910,
					"content": "Tal y como mamá, Kito y Kina me habían contado, viene a llevarnos en esa barca plateada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040911,
					"content": "Nos lleva a través de un arroyo destellante, como si estuviéramos en un sueño... En ese sueño, el campo está libre de niebla, y en él hay un pabellón dorado... En su interior hay setenta cunas, y setenta cunas más. Todas ellas se mecen y se mecen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040912,
					"content": "Dormiremos plácidamente en ellas hasta convertirnos en partículas de luz. Y entonces... nos transformaremos en el sueño de los niños de la tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040913,
					"content": "Guau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Ese barquero dijo que venía de parte de Kito y Kina para darme esto. Jeje, esos niños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040916,
					"content": "Aún no es la hora... Aún no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040914,
					"content": "¿Está diciendo que...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
					"content": "#Soy {NICKNAME}, ¿lo olvidó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				}
			]
		},
