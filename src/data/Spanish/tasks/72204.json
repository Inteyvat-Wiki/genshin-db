						722041202
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722041202,
					"content": "Entonces, quiere decir que ya se cansaron de jugar, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722041203
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722041203,
					"content": "No lo entiendo del todo, pero supongo que sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722041204
					]
				},
				{
					"id": 722041204,
					"content": "#Gracias, foraster{F#a}{M#o}... Adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722041205
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722041205,
					"content": "Barquero, por favor, llévame contigo a ese bosque de cipreses de plata y ese río de ensueño...",
