			"dialogs": [
				{
					"id": 60110701,
					"content": "Interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110702
					],
					"speakerTitle": "Cazador de la Luna"
				},
				{
					"id": 60110702,
					"content": "Ya que me has seguido hasta aquí, ¿por qué no muestras tu cara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110703
					],
					"speakerTitle": "Cazador de la Luna"
				},
				{
