				]
			},
			"dialogs": [
				{
					"id": 60110501,
					"content": "Jefa, eh... ¿Recuerda eso... sobre lo que quería saber su opinión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110502,
					"content": "En una escala del 1 al 10, ¿cuánto debería esforzarse la Cámara de Secretos en el caso de que volviéramos a trabajar con los demás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110503,
					"content": "Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110504,
					"content": "¿Un 1? ¿Eso no es muy poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110505,
					"content": "Intenta adivinarlo otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110506,
					"content": "¡¿Cero?! Pero ¿eso no sería como poner el nombre de nuestra marca y no hacer nada más? ¡Para eso, mejor no trabajar juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110507,
					"content": "*Suspira*, Jahoda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110508,
					"content": "Lo que quería decir es que no hay ni un mínimo ni un máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110509,
					"content": "¡Oooh! Es usted la mejor, jefa. Siempre adelantándose a todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110510,
					"content": "Un momento, eso no es una respuesta. ¡Vamos, jefa, dígame un número!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
