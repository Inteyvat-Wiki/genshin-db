			"dialogs": [
				{
					"id": 60110401,
					"content": "Krumkake terminado. Por favor, cómalo mientras esté caliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110402,
					"content": "Gracias por tomarte esto tan en serio, Ineffa. Que este manjar sea testigo de nuestra amistad y que dure mucho tiempo a pesar del paso de los años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110403,
					"content": "Entendido. No obstante, el periodo de consumo de krumkake es relativamente corto, alrededor de una semana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110404,
					"content": "Bueno, no me refería a eso exactamente... ¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110405,
					"content": "Oh, parece que hay algunos visitantes escondidos por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110406,
					"content": "Deben de haber seguido el aroma del krumkake. No pasa nada, pueden acercarse. Ineffa es amiga nuestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110407,
					"content": "Correcto. De hecho, puedo elaborar una tortilla de cereales según las preferencias de cada uno y desmenuzarla en raciones para compartir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110409,
					"content": "¿Qué dicen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110410,
					"content": "Están... hablando de dónde vives. Quieren volver a casa contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
