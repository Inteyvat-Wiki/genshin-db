			"dialogs": [
				{
					"id": 60111101,
					"content": "#Oh, qué bueno verte por aquí, {NICKNAME}. Tras la batalla, pensé que necesitaba algunas reparaciones y mantenimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111102,
					"content": "Gracias por mantenerme el secreto a pesar de saberlo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111103,
					"content": "Antes no te pregunté cómo pueden los demás Lampareros percibir tu lámpara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "Es porque no quería meterme en problemas con el starshiná. Si no pudieran detectarla, mis superiores me habrían encasquetado una lámpara normal de soldado ratnik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111106,
					"content": "Imagínate un soldado ratnik con dos lámparas... Sería una cosa rarísima, ¡y muy poco agradable estéticamente! Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111104,
					"content": "Oye, ¿cómo es que otros Lampareros pueden detectar tu lámpara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
			]
		}
	]
