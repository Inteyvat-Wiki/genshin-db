			"dialogs": [
				{
					"id": 60110101,
					"content": "Todos se reúnen para contar lo ocurrido en cada lado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "Por suerte, pudimos minimizar los daños causados. Solo algunos habitantes resultaron heridos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110103,
					"content": "Pero ahora el Cazador de la Luna ha obtenido su forma completa y no sabemos nada sobre su objetivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110104,
					"content": "Es como si hubiéramos puesto en libertad a un Qucusaurio muy agresivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110105,
					"content": "Lo siento, ¿no saben cómo son los Qucusaurios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110106,
					"content": "P-Paimon sabe a qué te refieres, pero incluso tu analogía se queda corta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110107,
					"content": "Dijo que este mundo ya no le importaba en absoluto. Puede que de momento no tenga ningún motivo para luchar contra nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110108,
					"content": "Si su objetivo hubiera sido vengarse, no habríamos tenido nada que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110109,
					"content": "¿Aún estoy a tiempo de presentar mi dimisión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110110,
					"content": "¡Era broma, jefa, era broma! ¡Sé que ya no hay vuelta atrás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110111,
					"content": "Y, encima, mi cañón, del que tan orgullosa estoy, no sirvió de nada... ¡Hum! ¡Voy a desmontarlo ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110112,
					"content": "No es culpa tuya, Aino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "Sí, no tienes por qué estar triste. El cañón aún es de mucha utilidad para los ataques normales de la Cacería salvaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110115,
					"content": "Flins, tendrás que ir con los Lampareros para ayudar con las secuelas de lo ocurrido. No te preocupes, ya les he explicado todo, estás a salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110116,
					"content": "Muchas gracias por eso y por ayudarnos a llegar más fácilmente a la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110117,
					"content": "Si hubieras querido mostrarte más en público, no habrías estado solo y en apuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60110118,
					"content": "Jeje, entendido. Lo pensaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110119,
					"content": "Supongo que ese será uno de los beneficios de tomar el puesto del sargento mayor Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110120,
					"content": "¿Eh? ¿Es que te van a ascender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110121,
					"content": "Está bromeando, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "¿En serio? Arg, ¿cómo es que Paimon es la única que no se había dado cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110123,
					"content": "#{NICKNAME}, si tienes tiempo, ¿querrías venir conmigo un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110124,
					"content": "Hay cierto caballero del que me gustaría despedirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110113,
					"content": "El cañón no tiene la culpa, Aino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
		{
			"id": 601102,
