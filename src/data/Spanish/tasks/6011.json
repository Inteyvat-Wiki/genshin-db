						"position": [
							1677.138,
							277.701,
							9397.254
						],
						"pointId": 11783
					},
					{
						"sceneId": 3,
						"position": [
							1678.174,
							277.675,
							9396.496
						],
						"pointId": 13093
					}
				]
			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "¡Colombina! ¿Qué estás haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "¿Eh? ¿No me recomendaron que saliera a dar una vuelta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110603,
					"content": "Bueno, sí, pero ¿no te da miedo que te vean los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "A Sandrone no le interesa capturarme, y los demás Fatui no correrían el riesgo de hacerlo. Tienen problemas más graves de los que encargarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110605,
					"content": "(¿Se estará refiriendo a Rerir? Al fin y al cabo, ahora mismo él es una amenaza para todas las personas que viven en Nod Krai.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "Bueno, siempre es bueno salir a dar un paseo. ¿Cómo te sientes? ¿Te gusta la Villa Nasha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Pues... El flujo del kuuvahki es algo caótico y noto que la gente está intranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110608,
					"content": "Sin embargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110609,
					"content": "¿Sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "¿La comida a la que me “invitaron” la vez pasada la compraron aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110611,
					"content": "(¡¿Eso es lo que le importaba?! ¿Ha venido solo porque quería comer carne frita con bayas?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "Podemos llevarte a comerla si quieres. Hay muchas cosas deliciosas por aquí que no se pueden comer en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "#Estás muy callad{F#a}{M#o}. ¿Tienes alguna pregunta que te esté rondando la mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110614,
					"content": "¿Qué va a pasar con Rerir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Me temo que no pude averiguar nada sobre sus planes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110616,
					"content": "Ahora que ha obtenido una forma física, no debemos subestimar su poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110617,
					"content": "Pero ese poder suyo alberga una obsesión que roza la demencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110618,
					"content": "Lo que no sé es si el objeto de esa obsesión son las lunas u otra cosa distinta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110619,
					"content": "Tal vez entender eso sea la clave para enfrentarse a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110620,
					"content": "Háblame de los Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "Sandrone lleva un estilo de vida poco disciplinado; Dottore siempre está mandando a los demás; y Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110622,
					"content": "Ah, ¿no era eso lo que querías saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110623,
					"content": "Has estado en la Oficina de Diseño Experimental, ¿verdad? Esa... “arma” tendrá un papel clave en el plan de la Zarina. O, al menos, eso es lo que he oído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110624,
					"content": "¿Que cuál es ese plan, me preguntas? No es algo que me interese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110625,
					"content": "¿Sabes algo más sobre mi nave?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "Si quieres, podría buscar en la médula lunar de la Luna Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110627,
					"content": "Pero, después de la anterior vez que lo intentamos, sospecho que alguien escondió tu nave deliberadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110628,
					"content": "Quizá haya alguien que no quiere que ni tú ni nadie más conozca la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110629,
					"content": "Pero dudo que existan muchas personas capaces de hacer algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110630,
					"content": "No tengo más preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "Yo... aún quiero volver a la luna que me pertenece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 60110632,
					"content": "Ese es el lugar en el que están enterradas las respuestas... Ese es... mi “hogar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
