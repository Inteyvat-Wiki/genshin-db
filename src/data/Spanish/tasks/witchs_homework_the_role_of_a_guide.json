					}
				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "¿Ya te marchas? ¡Eh, Barbie! ¿No te olvidas de algo? ¿No tenías un montón de cosas que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "¿... darme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "¿Hemos llegado en mal momento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "Para nada, han llegado más o menos cuando Barbie lo predijo... Aunque, si les soy sincera, pensé que aparecerían un poco después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "De todas formas... ¿por qué no comen algo antes de ponernos a hablar de negocios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "¿La profecía de Barbeloth también indicó que tendríamos hambre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "¡No, no es eso! Tan solo tengo un oído muy bueno y he oído cómo le rugía el estómago a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "*Gru, gru*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "#¡Ah! E-el estómago de Paimon ruge también por {NICKNAME}. L{F#a}{M#o}s dos tenemos hambre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "¿Cómo iba a saber que ese lugar se quedaría sin carne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "#Tranquil{F#a}{M#o}s, una bruja jamás dejaría que sus invitados pasaran hambre después de un viaje tan largo. Vengan, ya les tengo preparadas galletas y pasteles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "Paimon y tú disfrutan alegremente de las galletas y los pasteles mientras le dan sorbos al té. Extrañamente, por mucho que coman o beban, la tetera permanece medio llena y siempre encuentran una galleta o un trozo de pastel nuevo en el plato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "P-Paimon va a reventar... Coma lo que coma, siempre hay más en el plato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "¿Así es la hora del té de las brujas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "Sí. Para la hora del té, la mesa debe estar bien surtida de postres y bebidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Aunque, ciertamente, atiborrarse de comida no es digno de la elegancia de una bruja. Por eso, normalmente, la tetera está solo medio llena y solo aparece una galleta o un trocito de pastel en cada plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "¡Paimon ya no puede comer más! Va a reventar de verdad... ¿Podemos hablar ya del asunto? *Eructa*... Vaya, ¡Paimon lo siente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "Está bien. Supongo que han venido para entregarme la “lección” que Barbie profetizó para mí, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "Así que ya lo sabías...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "No, hace un momento estaba hablando con Barbie de otro asunto. Me dijo que, debido al enorme cambio de la luna, su hidromancia ha sufrido alteraciones, así que debe regresar a meditar en soledad por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "Durante su retiro, yo me encargaré de supervisar las lecciones de los demás y, de paso, también la ayudaré a registrar la siguiente ronda en el diccionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "¿Eh? ¿Se puede cambiar tan fácilmente a la persona al mando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Nicole nunca decepciona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "¡Les aseguro que yo no quería hacerlo! Pero antes de que Barbie y Alice me lo dijeran, ya habían inscrito mi “lección especial” en el diccionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "Aunque me encantaría borrar todo esto y seguir observando el mundo tranquilamente, Alice está ocupada manteniendo las fronteras de Teyvat y Barbie se ha retirado a cultivar su hidromancia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia no se ha molestado en volver y ya podemos olvidarnos de Rhinedottir... Las demás brujas tienen sus propios asuntos de los que ocuparse, así que el deber de supervisar las lecciones recae en mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "Vaya, no sabía que el Aquelarre estuviera tan ocupado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "Sí, ni siquiera recuerdo cuánto tiempo ha pasado desde la última vez que celebramos una hora del té como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "En fin, en cuanto complete esta lección especial, mi historia quedará oficialmente inscrita en el diccionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "Después, podré observar y guiar a los demás más seriamente... Así que díganme cuál es la lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "Oh, y ya que no cuenta como profecía, pues es solamente una historia que Barbie y Alice se inventaron apresuradamente hace diez minutos, me sorprendería mucho si pudieran encontrar información útil en el diccionario que tienen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "Tienes razón, Nicole. Le echamos un vistazo antes de venir y no había ninguna instrucción detallada. Solo dos frases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "“Nicole cumplirá con su deber”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "Está bien. La primera parte seguramente la escribió Barbie, pero esa última frase tiene que haberla añadido Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Bueno, empecemos con la lección. Déjenme pensar por dónde deberíamos comenzar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Un momento, ¿ya sabes lo que quieren que hagas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Oh, Barbie me explicó de pasada de qué iba la lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "Básicamente, tengo que ir a ciertas ubicaciones de la lección, asegurarme de que todo va bien y llevar a cabo cierta investigación de campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Eh, ¿así sin más? ¡No parece para nada una profecía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Bueno, como pueden ver, yo me tomo las palabras de Barbie como un tipo de profecía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "Además, cuando Barbie escribió esta lección para mí, lo único que hizo fue ir a la última página de la historia y contarme el final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "¿Eso no cuenta como arruinar el final?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "Bueno, pero eso es básicamente lo que hacen las profecías, ¿no? En fin, basta de cháchara. Síganme. Vamos a... humm, sí, me parece un lugar tan bueno como cualquier otro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "¿Así sin más? Un momento, ¿cómo vamos a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "En un abrir y cerrar de ojos, se encuentran al borde de un precipicio...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "¿Significa eso que he venido para nada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "¡En absoluto! Esta lección tenía que ser transmitida por ti, ese paso era de suma importancia. Existen ciertas formalidades que deben llevarse a cabo para que la lección cuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "Ya hablaremos de eso en otro momento. Síganme. Vamos a... humm, sí, me parece un lugar tan bueno como cualquier otro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "Yo no lo entiendo del todo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "“¡No dejará que trabajes gratis!”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "Eso es todo lo que pone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "Ahora que lo has mencionado, es cierto que son bastantes miembros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "¡Eres capaz de todo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "Entonces, ¿Barbeloth justo estaba...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "Deberíamos traer a Varesa la próxima vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "¿Te refieres a esa chica de la Comunidad de la Feracidad de Natlan que come muchísimo? Alice me ha hablado de ella. Es una jovencita fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "Imagino que si se presentara a uno de nuestros encuentros, tendríamos que poner tres... no, tal vez siete platos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "Engullimos la ensalada, pero es como si no hubiéramos comido nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "¿Incluso algo como el hambre puede ser profetizado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "Tal vez deberíamos volver más tarde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
