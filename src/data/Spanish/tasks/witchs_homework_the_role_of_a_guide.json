			"dialogs": [
				{
					"id": 761590301,
					"content": "¿Este es el Reino de los Lobos? No parece muy adecuado para una lección...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590302,
					"content": "Este es el Pedestal de los Seelies más cercano a donde vamos. No se preocupen, no estamos muy lejos del punto de partida de la lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590303,
					"content": "#¡Aaah! ¡¿De dónde han salido esos lobos?! Eh... ¡No vamos a hacerles daño, somos amig{F#a}{M#o}s de Razor!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590305,
						761590306
					],
					"speakerTitle": "Manada de lobos"
				},
				{
					"id": 761590305,
					"content": "Los lobos se han marchado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "¿Aún no ha llegado ese niño? Tal vez hemos vuelto a venir demasiado pronto. No se preocupen, siempre y cuando permanezca junto a su Lupical, podrá contra cualquier adversario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "Manada de lobos"
				},
				{
					"id": 761590309,
					"content": "¿Por qué vuelven? ¿Nos han oído hablando? Si Razor estuviera aquí, podría decirnos qué quieren...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590310,
					"content": "Sí, pero también tendría que entender mucho más que eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590311,
					"content": "Este lugar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "Cierto. Ese niño ya resultó victorioso en la batalla que estaba destinado a luchar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590314,
					"content": "Creo que siempre y cuando permanezca junto a su Lupical, podrá contra cualquier adversario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "Manada de lobos"
				},
				{
					"id": 761590316,
					"content": "Seguro que su Lupical opina lo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590317,
					"content": "¡Muy bien! Ya hemos terminado con este lugar. No me vendría mal un descansito. Vámonos, es hora de volver a tomar una taza de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590318,
					"content": "¡Guau! ¿Cuándo ha aparecido esta puerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590319,
					"content": "Y hay una nota...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "Parece la letra de Alice. Echémosle un vistazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590322,
					"content": "“¡Gracias por ayudar con las lecciones! ¡Ahora entra en la casa y tómate un té calentito!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590323,
					"content": "“P.D.: ¡Te espera una sorpresa tras esta puerta!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590324,
					"content": "¿Volver a casa? Un momento, ya decía yo que esta puerta me resultaba familiar. ¿No dará a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590325,
					"content": "#Nicole abre la puerta y l{F#a}{M#o}s guía con paso firme hacia dentro. Enseguida, se encuentran en el interior de una habitación...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "Este estilo... ¿Por qué me resulta familiar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "Razor y yo luchamos aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "¿Acaso quien tiene que ocuparse de la lección de aquí es...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
			]
		},
