			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "Gracias. Con eso será suficiente. Ahora, espera un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680402,
					"content": "Con esto está bien. Lleva esta tortilla de papas de Mondstadt a Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "No vuelvas a hacer este tipo de cosas, por favor. No merece la pena malgastar energía en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "Espero que tengas en cuenta lo que te digo. No nos decepciones a Timmie y a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "*Suspira*, si todo el mundo recordara lo que tiene que hacer, la hermana Victoria no estaría tan ocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2006805,
