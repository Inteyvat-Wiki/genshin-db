			"dialogs": [
				{
					"id": 200680501,
					"content": "Rápido, dale esta tortilla de papas a Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680502,
					"content": "La “mamá” a la que se refiere Timmie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "Soy yo. Suelo cuidar a niños que necesitan ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680504,
					"content": "Timmie es el niño que más tiempo llevo cuidando. Por eso, al final acabó llamándome “mamá Grace”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680505,
					"content": "Pero, en realidad, no soy su familia de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680506,
					"content": "¿Por qué se enojó tanto Timmie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "¿De verdad me preguntas eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680508,
					"content": "Ese niño apenas tiene amigos y familia en la ciudad. Aparte de Nora y Glory, su única compañía son los animalitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680509,
					"content": "Además, esas palomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680510
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680510,
					"content": "No es nada, déjalo. Llévale esta tortilla de papas a Timmie, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
