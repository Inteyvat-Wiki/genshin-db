			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "Está por allá. Observémoslo desde aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360402,
					"content": "Humm... Veamos... Conozco muy bien al Gerente Xiao, así que no me tomará mucho tiempo escribir su deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360403,
					"content": "Dime qué te parece:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360404,
					"content": "“Ese viejo apestoso no tiene para nada un buen temperamento...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360405,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "“... aunque bajo esa fría fachada tiene un buen corazón”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360408,
					"content": "... ¿Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "Y ahora, un título... “En realidad, es bueno”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360411,
					"content": "¿Qué te parece? Creo que le queda bien. Aunque en apariencia el Gerente Xiao es un gruñón, en realidad es buena persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360412,
					"content": "¿Hay otras alternativas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "Ah, tenía otra idea, pero no sé cómo escribir la continuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360414,
					"content": "¿Y si me ayudas a pensar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360415,
					"content": "La primera frase es: “Los jóvenes vienen y se enfrentan a su mirada imponente...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360416,
					"content": "“... sopla el viento mientras duerme plácidamente, y sus ronquidos resuenan en las montañas”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "Nada mal. Y ahora, el título...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360418,
					"content": "Oh... “Pacífico como una montaña durmiente”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "¡Guau! ¿Lo ves? Tienes el don de la palabra. Es un buen título.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360420,
					"content": "Bien, entonces escribiré esos versos en la linterna. Dame un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360421,
					"content": "Listo. Démosle esta linterna celeste al Gerente Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360409,
					"content": "No sigas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "¡Oye, espera!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
			"id": 4133605,
