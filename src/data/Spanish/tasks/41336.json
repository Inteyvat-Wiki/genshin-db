			"trigger": {
				"objectNames": [
					"Gerente Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "Ah, eres tú, Linling. ¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Gerente Xiao"
				},
				{
					"id": 413360502,
					"content": "#Me pidió que escribiera un mensaje. {F#La viajera}{M#El viajero} y yo lo hemos terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360503,
					"content": "Ya está escrito en la linterna celeste. Tome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360504,
					"content": "Gracias, déjame verlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Gerente Xiao"
				},
				{
					"id": 413360505,
					"content": "“Los jóvenes vienen y se enfrentan a su mirada imponente... sopla el viento mientras duerme plácidamente, y sus ronquidos resuenan en las montañas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Gerente Xiao"
				},
				{
					"id": 413360506,
					"content": "“Pacífico como una montaña durmiente”... Jeje, nada mal. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "Gerente Xiao"
				},
				{
					"id": 413360507,
					"content": "No hay de qué. También tenía otro poema en mente, puedo recitarlo para ust...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360508,
					"content": "¡Vamos a buscar a la siguiente persona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "Ah, cierto. De acuerdo... Bien, ahora vayamos con Degui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360511,
					"content": "El poema para Degui es una obra maestra, te lo enseñaré luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360509,
					"content": "¡Hay otras linternas que repartir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				}
			]
		},
