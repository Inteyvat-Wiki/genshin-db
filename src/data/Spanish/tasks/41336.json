					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "Humm... Debería ir por un poco de inspiración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "Le estoy ayudando a la gente a escribir mensajes apropiados en las linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360104,
					"content": "Durante el Rito de la Linterna, todo el mundo quiere liberar linternas celestes, ¿cierto? Y tienen que escribir en ellas mensajes de buena suerte y cosas así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360105,
					"content": "Para ir más acorde con la temporada, hay quienes quieren que sus mensajes y deseos estén escritos con... ¿cómo decirlo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360106,
					"content": "... con un “aire poético”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360107,
					"content": "Así que Bibo, el Gerente Xiao y Degui me pidieron que les ayudara a escribir mensajes más “literarios” en sus linternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360108,
					"content": "Pero no se me ocurre nada quedándome aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360109,
					"content": "Por eso, estaba pensando en preparar las linternas celestes primero y, después, ir a observarlos para escribir un mensaje personalizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360110,
					"content": "Pero ¿cómo voy a hacer las linternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360111,
					"content": "Déjame ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "¿Lo dices en serio? Entonces, te agradecería si pudieras hacer tres linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360114,
					"content": "Después iremos a hacer investigación de campo y obtener un poco de inspiración para los mensajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360115,
					"content": "Jeje, ya tengo unas ideas en mente, solo tengo que buscar un poco de inspiración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360112,
					"content": "#Soy expert{F#a}{M#o} en fabricación de linternas celestes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
