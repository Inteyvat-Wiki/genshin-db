					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "Déjenmelo a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740202,
					"content": "Saludos, hermana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740203,
					"content": "Que el dios Anemo le bendiga, joven bardo. ¿En qué le puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740204,
					"content": "Tengo un secreto que puede salvar a Mondstadt del peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740205,
					"content": "¿Oh? ¡Debe ser una bendición del dios Anemo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740206,
					"content": "Creo que debería informar de esto a los Caballeros de Favonius. ¿Por qué vino a mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740207,
					"content": "¡Jaja, porque usted, querida hermana, puede ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740208,
					"content": "Me gustaría tomar prestada la Lira Sagrada. Con ella, podría ayudar a que Stormterror...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740209,
					"content": "Retírense, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740210,
					"content": "¿Perdón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740211,
					"content": "Aunque ese dragón sea malvado, si la Gran Maestra Intendente tomó una decisión, no hay nada en este mundo que pueda oponerse a ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740212,
					"content": "Es inaceptable. ¡De esa forma Stormterror morirá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740213,
					"content": "Esa bestia tonta traicionó al Viento del Este. ¡Ni el dios Anemo se lo perdonaría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740214,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740215,
					"content": "Por favor, ¡se lo pido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740216,
					"content": "He dicho que no. Lo siento, bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740217,
					"content": "(Qué extraño... Por alguna razón me siento un poco mal por haberme rehusado a ayudar a este niño tan inocente...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740218,
					"content": "Humm... Supongo que entonces no me queda de otra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740219,
					"content": "¡No puedo esconderlo más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740220,
					"content": "Mis fieles discípulos, ¡regocíjense! ¡El propio dios Anemo, <color=#00E1FFFF>Barbatos</color>, ha descendido de los cielos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740221,
					"content": "Sorprendidos, ¿eh? ¿No quieren llorar de emoción? ¿Qué se siente al ver al dios que tanto veneran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740222,
					"content": "Si no necesitan nada más, regresaré a mis labores administrativas de la Catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740223,
					"content": "¡Espere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
