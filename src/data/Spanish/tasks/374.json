			},
			"dialogs": [
				{
					"id": 3740301,
					"content": "¿Qué? Ni siquiera pestañeó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "Pero ya obtuve lo que quería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "Al menos no negó que la Lira Sagrada se encuentra resguardada en la Catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#{NICKNAME}, ya que eres {F#una novata}{M#un novato} de los Caballeros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "¿Quisieras intentarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 37404,
