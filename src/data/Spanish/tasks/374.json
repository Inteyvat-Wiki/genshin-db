			"dialogs": [
				{
					"id": 3740401,
					"content": "Que Barbatos le bendiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740402,
					"content": "Hola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "¡Ah! Usted es el nuevo miembro de los Caballeros, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740406,
					"content": "¿A qué se debe su visita? ¿Alguna tarea de la Gran Maestra Intendente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740411,
					"content": "Los Caballeros de Favonius se ven en la necesidad de requisar la Lira Sagrada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740413,
					"content": "No es que no confíe en usted, pero hace poco un extraño bardo también preguntó por la Lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740414,
					"content": "Solamente decía disparates. Incluso se atrevió a decir que era el mismo Barbatos. Seguro que tramaba algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740415,
					"content": "Hay reglas con respecto al uso de la Lira Sagrada. Actualmente, solo puede ser utilizada durante el Ludi Harpastum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740416,
					"content": "Además, se necesitan las autorizaciones de la Gran Maestra Intendente, el senescal y el Representante de la Comunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740417,
					"content": "Así que, ¿me permite ver la autorización de los Caballeros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740418,
					"content": "La Gran Maestra no mencionó nada de eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "Se necesita un documento firmado. Sin él, no hay mucho que pueda hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740423,
					"content": "Ahora, si me permiten. Tengo muchas cosas que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gettlinde"
				},
				{
					"id": 3740419,
					"content": "Lo siento, olvidé traerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "Paimon se la comió en el camino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740404,
					"content": "#Soy {NICKNAME}, {F#la Caballera Honoraria}{M#el Caballero Honorario} de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "#L{F#a}{M#o} conozco. Es quien salvó Mondstadt junto con Amber el otro día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gettlinde"
				}
			]
		},
