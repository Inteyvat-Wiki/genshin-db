			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li el Martillo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "Esa linterna celeste era de parte de Siyu, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420603,
					"content": "¿Lo escuchaste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Es más que obvio, no hace falta ser adivino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420606,
					"content": "El año pasado ocurrió lo mismo. Se fue a dar una vuelta y cuando regresó se pasó la noche entera clavando clavos en el casco de un barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420607,
					"content": "Sé por qué lo hace, pero, aun así... *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420608,
					"content": "#Viajer{F#a}{M#o}, ¿puedo pedirte un favor? No es bueno que se torture a sí mismo en días festivos como estos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420609,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "*Suspira*... Perdón por las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420611,
					"content": "Supongo que estará trabajando en el barco... Apresúrate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420612,
					"content": "Dentro de poco iré a comprar comida. Cuando lo hayan resuelto, vengan a comer conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420604,
					"content": "¿Cómo lo sabes?",
					"roleType": "TALK_ROLE_PLAYER",
