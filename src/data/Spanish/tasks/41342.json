			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Siyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "Supongo que debería enviarle una linterna celeste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420102,
					"content": "¿A quién?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "#Ah, eres tú, viajer{F#a}{M#o}. El asunto es este: de pequeño, Wang el Llave inglesa siempre cuidaba de mí, y siempre estaba ahí para ayudarme. Era como un hermano para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420104,
					"content": "Pero ahora, en una festividad tan importante, se la pasa trabajando todo el día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420105,
					"content": "Me gustaría regalarle una linterna celeste. Jeje, jugamos y crecimos juntos, así que sé que de pequeño le encantaba verlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420106,
					"content": "#Estoy segura de que se pondrá contento si le regalo una. Viajer{F#a}{M#o}, ¿puedes entregarle esta linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420107,
					"content": "¿Por qué no vas tú misma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "Me gustaría ir yo misma, pero tengo muchas cosas que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420110,
					"content": "Tengo que salir a hacer unas compras, y mi esposo está ocupado con unas cosas del hogar, así que tengo que volver pronto a ayudarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420111,
					"content": "Bueno, dejo en tus manos la linterna celeste. Cuando tenga un poco de tiempo, mi esposo y yo iremos a ver a Llave inglesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420112,
					"content": "Espero que para entonces ya no esté ocupado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420108,
					"content": "Sería mejor si fueras tú...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
			"id": 4134202,
			"completionStepIds": [
				4134202
			],
