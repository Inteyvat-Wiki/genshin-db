			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang el Llave inglesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "Humm... Sí, estas me sirven. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413421203,
					"content": "Ah, también hay unas cosas con las que necesitaría tu ayuda... ¿Puedes ir al muelle a hacer inventario de los nuevos suministros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413421204,
					"content": "Son tres montones de cajas que hay en el muelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413421205,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "Gracias. *Suspira*, debo apresurarme para terminar con el trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang el Llave inglesa"
				}
			]
		},
