					"Li el Martillo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420901,
					"content": "Perdón por hacerte esperar. Está todo listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420902,
					"content": "¿Qué? ¿Terminaste todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420903,
					"content": "#Sí, todo. No fue nada. Además, con ayuda de est{F#a}{M#e} viajer{F#a}{M#o}, pude terminar sin problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420904,
					"content": "En serio... *Suspira*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420905,
					"content": "Bueno, bueno, es una fecha importante, no te pongas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420906,
					"content": "De acuerdo, como tú digas. ¿Ya tienes lista la linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420907,
					"content": "¡Oh, no, la linterna celeste! ¡La olvidé por completo! En serio, tengo tan mala memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420908,
					"content": "Está bien, está bien. Es solo una linterna, ¿cierto? No es el fin del mundo si no la libero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420909,
					"content": "¡Vamos, déjate de tonterías! ¿No vas a liberar una linterna en una fecha tan importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420910,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ayudar a mi amigo a hacer una linterna celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "Li el Martillo"
				},
				{
					"id": 413420911,
					"content": "Cuenten conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "Gracias, estaremos aquí esperándote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li el Martillo"
				}
			]
		},
