				{
					"id": 413421001,
					"content": "Hemos perdido demasiado el tiempo y he retrasado mucho mi trabajo, así que debo trabajar más duro aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421002
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413421002,
					"content": "¿De verdad estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421003
					]
				},
				{
					"id": 413421003,
					"content": "¡Ja! ¡Qué tonterías dices! No es nada, estoy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421004
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413421004,
					"content": "Tengo que terminar rápido mi trabajo. Hablemos después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421005
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413421005,
					"content": "Puedo ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421006
					]
				},
				{
					"id": 413421006,
					"content": "¿Eh? ¡Genial! Entonces, ayúdame a traer unas cuantas tablas.",
					"roleType": "TALK_ROLE_NPC",
