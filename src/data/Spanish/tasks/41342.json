			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang el Llave inglesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420401,
					"content": "#¿Eh? Oh, viajer{F#a}{M#o}, ¿me estabas buscando? Estoy un poco ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420402,
					"content": "Siyu envía esta linterna celeste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4134205,
			"completionStepIds": [
				4134205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134205",
							"2"
						],
						"stepId": 4134205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang el Llave inglesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "¿Siyu? ¿Me envió... una linterna celeste? ¡Déjame ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420502,
					"content": "¡Jajaja! Así que escribió mi deseo en la linterna. Desde que era pequeño, siempre quise que este deseo se cumpliera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420503,
					"content": "En un abrir y cerrar de ojos, han pasado tantos años. El tiempo vuela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420504,
					"content": "Pero ¿por qué te envió a ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420505,
					"content": "Tiene cosas que hacer en casa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "Ah, ya veo... Bueno, está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420508,
					"content": "Parece que le está yendo bien. Es lo que importa... Jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420509,
					"content": "Qué bueno... Lo siento... Tengo que irme, todavía tengo mucho trabajo que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang el Llave inglesa"
				},
				{
					"id": 413420506,
					"content": "Dijo que tiene que ayudar a su esposo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
		{
			"id": 4134206,
			"completionStepIds": [
				4134206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
