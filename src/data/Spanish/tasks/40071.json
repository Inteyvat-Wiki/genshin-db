				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "¡Oh! ¡Regresamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711502,
					"content": "Espera, ¿por qué hemos regresado? ¡No hemos terminado el cuento aún!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711503,
					"content": "Es una sensación tan desagradable como la de comprar un manual de astrología falso o darte cuenta de que olvidaste el monedero en medio de una cena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711504,
					"content": "¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711505,
					"content": "¡Ah!... ¡Qué horror!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711506,
					"content": "Las dos se ven devastadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711507,
					"content": "Si les digo la verdad, a mí tampoco me gusta leer libros que te dejan con la intriga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711508,
					"content": "Jaja, a nadie le gusta. Bien, entremos de nuevo en la ilusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711509,
					"content": "¡Buena idea! ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711510,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711511,
					"content": "El libro esta aquí, pero no funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711512,
					"content": "¡Qué extraño! Hace un momento pudimos entrar, pero ya no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711513,
					"content": "¿Por qué? ¡¿Por qué no nos dejan terminar de leer el libro?! ¡Es una tortura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711514,
					"content": "Humm... Tal vez ya llegamos al final del libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711515,
					"content": "El libro que vimos antes de salir de la ilusión ya estaba en la última página. Creo que «El himno del Reino Sagrado» está dividido en varios tomos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711516,
					"content": "Es como una de esas estrategias baratas para vender novelas ligeras... “Si quieres saber el desenlace, ¡compra el siguiente tomo!”. ¡Puaj!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711517,
					"content": "¡Hum! ¡Tengo que leer el final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711518,
					"content": "Oh... Oh, sí, el final. Todos se mueren por saber el final del libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711519,
					"content": "¿Eh? ¿Quién anda ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711520,
					"content": "Oh, oh, ¡por Los Siete, me vio! Mantente quieto, mantente erguido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711521,
					"content": "¿Y tú eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711522,
					"content": "Soy Arnold el “pídeme direcciones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711523,
					"content": "¡Qué nombre tan descriptivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711524,
					"content": "Déjame preguntarte algo, Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711525,
					"content": "¡Me llamo Arnold el “pídeme direcciones”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711526,
					"content": "De acuerdo. Arnold el “pídeme direcciones”, ¡déjame preguntarte algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711527,
					"content": "¡Adelante, señorita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711528,
					"content": "¿Hay más tomos de «El himno del Reino Sagrado»? ¿En dónde los puedo encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711529,
					"content": "¡Oh! Le preguntas a la persona adecuada. «El himno del Reino Sagrado» es un escrito sacro del Reino de la Noche Eterna. Consta de tres tomos, los otros dos están resguardados en dos sitios de gran altura en el castillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711530,
					"content": "Si quieren encontrar el segundo tomo, deben ascender a lo alto de la torre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711531,
					"content": "¿La torre? ¿Te refieres a esa de ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711532,
					"content": "Efectivamente, es la torre donde se almacenan los escritos sagrados. Si buscan con cuidado en la cueva de allá, encontrarán un pasadizo secreto que les permitirá llegar en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711533,
					"content": "Muy bien. Gracias, Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711534,
					"content": "¡Me llamo Arnold el “pídeme direcciones”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711535,
					"content": "¿Alguna otra pregunta, hermosa dama? ¿Tal vez quiera saber sobre mi situación amorosa o mis ingresos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711536,
					"content": "¡Nop! ¡Adiós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711537,
					"content": "No le presten atención al cuervo. Hay un pasaje secreto en esa cueva que conduce a la parte superior de la torre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711538,
					"content": "¡Oh! Hermosa dama, ¿de verdad que no le intereso? Compartí con usted los secretos del Reino de la Noche Eterna solo por su esplendorosa belleza. ¡Señorita! ¡Espere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		}
	]
}