				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "Parece que llegamos a un callejón sin salida. Solo hay un libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711302,
					"content": "Creo que lo que acabamos de oír es el cuento del libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711303,
					"content": "Entonces el Reino Sagrado del título del libro se refiere al Reino de la Noche Eterna. Este libro es sobre las alabanzas a la Princesa desde el punto de vista de su pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711304,
					"content": "Algo así como una autobiografía...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "Ya estamos en la última página del libro, pero no parece que el cuento haya terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711306,
					"content": "¿Y el resto? ¡Paimon quiere saber qué pasa después!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711307,
					"content": "Supongo que tendremos que seguir explorando. En cuanto al libro... Ahora que lo hemos terminado, podemos cerrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
