			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narrador",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "“Aunque el pueblo ha olvidado la verdad, los eruditos saben que la Princesa Fischl von Luftschloss Narfidort vino al mundo durante la era del caos, unos seiscientos años antes de la Era de los Santos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Narrador"
				},
				{
					"id": 400710302,
					"content": "¿Qué? ¿Un narrador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710303,
					"content": "Así que estamos dentro del libro, ¿eh? Y hasta hay un narrador que cuenta la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710304,
					"content": "Oh, no, el camino está bloqueado, no podemos pasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710305,
					"content": "Ahí hay un mecanismo que parece como si estuviera esperando a que nos acerquemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710306,
					"content": "¿Es impresión de Paimon o parece que las cosas en este lugar están colocadas con una intención?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710307,
					"content": "Después de todo, estamos en el Reino Sagrado, ¿qué esperabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710308,
					"content": "Sí, todo es tan descarado que pide a gritos que le presten atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710309,
					"content": "Así es Fischl, siempre tan franca... Miren este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007110,
			"completionStepIds": [
				4007110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007110",
							"2"
						],
						"stepId": 4007110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"León",
					"Mona",
					"Xinyan",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "¡Por favor, que alguien me ayude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "León"
				},
				{
					"id": 400711002,
					"content": "¿Eh? ¿No es una estatua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711003,
					"content": "¡No digas eso, por favor! Me llamo León, y soy un caballero del Reino de la Noche Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "León"
				},
				{
					"id": 400711004,
					"content": "¿Un caballero? Pues no lo pareces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711005,
					"content": "¿No? Bueno, no importa. En cualquier caso, no hablen mal de Don Ozvaldo. Fue él mismo quien designó y distribuyó las armaduras de los Caballeros Cuervo Noctívago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "León"
				},
				{
					"id": 400711006,
					"content": "¿Don Ozvaldo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME}, seguramente ya lo sabías. El nombre completo de Oz es Ozvaldo Hrafnavines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711008,
					"content": "Lo sé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "Así que “Megistus” era lo fácil de pronunciar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711011,
					"content": "Estoy totalmente de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711012,
					"content": "Jajaja... Así que todos están de acuerdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711013,
					"content": "Queridos amigos, en realidad no es mi intención interrumpir su charla tan animada, pero me temo que no les han informado de que la puerta de enfrente está cerrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "León"
				},
				{
					"id": 400711014,
					"content": "Ciertamente, no lo sabíamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711015,
					"content": "Si fueran tan amables como para rescatarme, estaré encantado de enseñarles a abrirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "León"
				},
				{
					"id": 400711016,
					"content": "Supongo que entonces tendremos que rescatarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711009,
					"content": "Ahora lo sé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
