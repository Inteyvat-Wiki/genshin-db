			"dialogs": [
				{
					"id": 740090201,
					"content": "#Estimad{F#a}{M#o}s {NICKNAME} y Paimon, hola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090202,
					"content": "Miren, esta es la base que Virgile ha estado usando últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090203,
					"content": "Qué raro, ¿cómo es que Virgile aún no ha llegado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Hombre con pinta de malo"
				},
				{
					"id": 740090204,
					"content": "Si no vuelve, no creo que pueda resistirme a beber todo este sinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Hombre con pinta de peligroso"
				},
				{
					"id": 740090205,
					"content": "¡A callar! ¿Sabes lo que ha costado traer toda esta mercancía? Si la estropeamos, Virgile no tendrá ninguna compasión con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Hombre con pinta de deshonesto"
				},
				{
					"id": 740090206,
					"content": "Qué lástima, parece que Virgile aún no está aquí, pero podemos empezar “charlando” con ellos, *guiño, guiño*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090207,
					"content": "Humm, a Paimon no le parece que tengan muchas ganas de charlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090208,
					"content": "Yo creo que podemos hacerles cambiar de parecer. ¿Qué opinas tú, querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090209,
					"content": "Creo que no habrá problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090210,
					"content": "¡¿Cómo que no habrá problema?! Paimon tiene la sensación de que van a recurrir a las manos en cuanto nos vean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090211,
					"content": "Ay, ¡estás en todo, querida Paimon! Lo cierto es que sería muy desafortunado que algo así sucediera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090212,
					"content": "Sí, desafortunado para ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
