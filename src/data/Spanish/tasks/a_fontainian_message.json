				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Qué coincidencia, ¡qué coincidencia! ¿No crees, mi querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090103,
					"content": "Hola, ¿quiénes son ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Oh, pero qué modales los míos, empezando una conversación sin nisiquiera presentarme. Soy Sonny, “Guante Blanco” para los amigos, y este es Luca el Pescador, conocido en ciertos círculos sociales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "¡Hola! Paimon es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Lo sé, Paimon es Paimon, y {F#esta jovencita rubia}{M#este jovencito rubio} es {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "¿Eh? ¿Nos conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "#¡Por supuesto! Es solo que, antes del día de hoy, l{F#a}{M#o}s conocía de la misma forma en que conozco a su señoría Neuvillette: unilateralmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "No es de extrañar que algún pajarito me diga algo en cuanto dos personalidades tan importantes como ustedes pisan Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "#¿Tan famos{F#a}{M#o}s somos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "#¡Mírate, qué modest{F#a}{M#o} eres! Se podría decir que, para algunas personas, tu llegada a Fontaine es como si de repente apareciera una bomba en el gran escenario de la Epíclesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "En el buen sentido, claro. ¿No crees, mi querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "¿Qué buen sentido tiene eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Oh, bueno... Es cierto que no se me da muy bien la retórica... ¿Cómo lo expresarías tú, querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "Diría: “Su llegada es como un espectáculo de magia de Lyney y Lynette: una actuación explosiva en la que lo imposible se vuelve posible y que da lugar a bombazos informativos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090116,
					"content": "¡Qué gran orador! ¿Ves? A mí nunca se me habría ocurrido algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "Claro, claro... Paimon los entiende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Oye, ¿y por qué te llamas Guante Blanco si no llevas ningún guante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Vaya, una pregunta complicada. ¿Cómo puedo explicarlo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Imagina que llevas un guante blanco. Al tocar algo sucio, se manchará, ¿cierto? Bueno, pues mi labor es encontrar esas cosas sucias y deshacerme de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Ajá... O sea, ¿que eres barrendero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "Efectivamente, querida Paimon. Vaya, no se me había ocurrido una mejor manera de sintetizar la naturaleza de mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "¡Así que lo limpias que están las calles de la Corte de Fontaine es gracias a ti, Sonny!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Jajaja, qué aduladora eres, Paimon. Pero sí, se podría decir que es como dices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "Pero espera... ¿Para limpiar necesitas un cuchillo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Es una herramienta muy útil para deshacerse de algunos residuos más exigentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "¡Paimon lo entiende! Entonces, ¿Luca se llama “el Pescador” porque es muy bueno pescando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Bueno, no es exactamente por eso. Sabes que en Fontaine hay todo tipo de especies piscícolas, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "Pues la habilidad de Luca es enseñar a la gente a llevarse bien y pacíficamente con toda esa diversidad piscícola. ¿No es así, mi querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090131,
					"content": "¿Eh? Paimon no lo entiende muy bien... Pero a ver, ¿entonces...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Ay, querida Paimon, cómo te gusta hacer preguntas, y además, ¡unas muy complicadas y fascinantes! Me encantaría poder conversar largo y tendido sobre ello alguna vez para responderlas todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Paimon, ya está bien de preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "¿Pero qué ha hecho Paimon? Arg, está bien... Bueno, Sonny, Luca, ¿querían pedirnos algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Pues verán, nos fascina el mundo del buceo, ya que en las aguas de Fontaine habitan una infinidad de riquezas, tanto naturales como legadas por nuestros ancestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "He oído que hace poco conociste a un amigo con el que fuiste de buceo, y que se te da tan bien bucear que ni siquiera necesitaste un equipamiento especial. Tú también lo has oído, ¿no es así, mi querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090139,
					"content": "Qué chismoso. Preguntas por Virgile, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Sí, precisamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Virgile... ¡Ese tipejo! Arg, solo de pensar en él, ¡Paimon ya echa humo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Paimon y tú explican lo ocurrido con Virgile.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "Ya veo, ya veo... Gracias por contárnoslo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "No hay de qué. Paimon nunca olvidará a ese tipo, ¡hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "#Estoy muy agradecido por su franqueza a la hora de contarnos su encuentro con Virgile, pero aún más por el hecho de que no sean amig{F#a}{M#o}s suy{F#a}{M#o}s. De lo contrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "Digamos que habría ciertos inconvenientes entre ustedes y nosotros. ¿No crees, querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "#No creo que pudiéramos derrotarl{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090148,
					"content": "Yo tampoco, ciertamente. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "¿Pero de qué hablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Son los enemigos de Virgile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "¡Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#Tus palabras me duelen, {F#estimada jovencita}{M#estimado jovencito}. Yo no tengo enemigos, pero sí muchos amigos, y Virgile es uno de ellos. Es solo que... *suspira*, mi querido Virgile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#No nos queda más remedio que “charlar” con él. *Guiño, guiño*, ¿me entiendes, querid{F#a}{M#o} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "Naturalmente, también lo hago para que pueda darles una explicación a ustedes dos. Si no, sería una descortesía de su parte, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Humm, Paimon no lo ha entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "Él es Guante Blanco. No necesitas saber nada más, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Pero eso Paimon ya lo sabía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Ya hemos hecho el trabajo de localizar la base de Virgile y sus... secuaces. ¿Qué les parece si nos reunimos todos allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "#¿Por qué insistes en que vayamos nosotr{F#a}{M#o}s también?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#Pero, oh, mi estimad{F#a}{M#o} {NICKNAME}, las ofensas que Virgile cometió contra ti fueron tan atroces que Luca y yo no podíamos adoptar medidas sin antes avisarte... Eso habría sido una falta de decoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090164,
					"content": "¿Lo ves? Luca está de acuerdo conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "¡Hum! ¡Paimon también lo va a poner en su lugar para que se disculpe por lo que nos hizo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Jajaja, qué buena eres, querida Paimon. Bien, nos encontraremos en el lugar que les comenté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "Está bien, vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Es mejor que no lo entiendas, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#En este mundo, entenderlo absolutamente todo sería demasiado aburrido, ¿cierto, {F#estimada jovencita}{M#estimado jovencito}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "¿Querían pedirnos algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
