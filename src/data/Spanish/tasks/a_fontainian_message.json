			"dialogs": [
				{
					"id": 740090301,
					"content": "Escúchenme, por favor... Todo esto ha sido un malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "Virgile"
				},
				{
					"id": 740090302,
					"content": "Sr. Sonny... la única razón por la que nos metimos en este negocio fue porque oímos que podía ser muy rentable, y como los de arriba no se ponían de acuerdo, pensamos que... Pensamos que podríamos ganar dinero antes, y luego entregar a la organización todo lo recaudado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "Virgile"
				},
				{
					"id": 740090303,
					"content": "¡Pero bueno! ¡Está ignorando por completo a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090304,
					"content": "No tengo absolutamente ninguna queja sobre la organización... Pero esas personas me engañaron, por eso hice aquella tontería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgile"
				},
				{
					"id": 740090305,
					"content": "#Maravilloso, sencillamente maravilloso. Tu reputación te precede, {NICKNAME}. ¿No lo crees tú también, querido Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090306,
					"content": "Sí, es muy fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090307,
					"content": "Sr. Sonny, Luca... por favor, si aún recuerdan algo de nuestra amistad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "Virgile"
				},
				{
					"id": 740090308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090309,
					"content": "¡Aaaah! ¡No, por favor, no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "Virgile"
				},
				{
					"id": 740090310,
					"content": "#Luca, ¿olvidaste que ahora tenemos invitad{F#a}{M#o}s? No podemos cometer acciones indecorosas que puedan defraudarl{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090311,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090312,
					"content": "¡Hum! ¿Te das cuenta ahora de tus errores, Virgile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090313,
					"content": "Sí, lo sé, fue culpa mía, fue culpa mía... Por favor, perdónenme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "Virgile"
				},
				{
					"id": 740090314,
					"content": "¡Más te vale tenerlo bien claro para no volver a hacerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090315,
					"content": "#Estimad{F#a}{M#o}s {NICKNAME} y Paimon, les juro por mi reputación como Sonny Guante Blanco, por mi padre y por mi hijo, que nuestro querido Virgile no volverá a cometer acciones similares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090316,
					"content": "Vámonos, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "Sonny, Luca, gracias a ambos. ¡Parece que en Fontaine hay más gente buena que mala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090321,
					"content": "#Adiós. Espero que en el futuro podamos volver a colaborar, mis estimad{F#a}{M#o}s {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090322,
					"content": "Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Virgile"
				},
				{
					"id": 740090317,
					"content": "¿Qué piensan hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#En este mundo, entenderlo absolutamente todo sería demasiado aburrido, ¿cierto, {F#estimada jovencita}{M#estimado jovencito}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090319,
					"content": "Si te pica la curiosidad, te diré que vamos a... charlar con él. No queremos robarles más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "Sonny"
				}
			]
		},
