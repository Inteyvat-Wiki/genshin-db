			"dialogs": [
				{
					"id": 400661701,
					"content": "Paimon sabía que te volveríamos a encontrar atrapado aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661702,
					"content": "Jaja, parece que esa es la norma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661703,
					"content": "Volvimos a entrar en el laberinto de la ilusión, pero esta vez los lugares eran diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661704,
					"content": "Le cuentas a Kazuha lo ocurrido esta vez...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "El ambiente era más lúgubre y el lugar estaba decorado de forma muy humilde... Sí, tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661706,
					"content": "Lo que vieron fue al clan Kaedehara en declive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661707,
					"content": "Tú también estabas en la ilusión, pero parecías diferente de ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661708,
					"content": "Efectivamente, puedo confirmarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400661709,
					"content": "En comparación con el Don Kazuha frente a nosotros, en la ilusión que vimos se veía desorientado y cargando con un pesado destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400661710,
					"content": "Así es. Su destino parecía muy pesado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400661711,
					"content": "Eso demuestra que he crecido y madurado. Siento mucho que hayan tenido que ver esa versión de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661712,
					"content": "Tras abandonar Inazuma, viví la vida de un errante durante mucho tiempo. Aunque no fue algo malo, ya que aprendí mucho de esa experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661713,
					"content": "Ojalá yo también hubiera podido ver ese yo del pasado. Seguro que, al verme, él lo habría comprendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661714,
					"content": "La vida es un largo camino, por eso tengo que seguir viajando por el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
