			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kaedehara Kageharu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "¡Lo siento, pero no lo entiendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661102,
					"content": "Kazuha, ¿has olvidado nuestra promesa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661103,
					"content": "¿De verdad quiere renunciar a todo? Aunque nuestra relación no esté en el mejor punto... usted sabe que estoy a su lado. ¿Hay algo que pueda hacer para ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661104,
					"content": "Con mi edad, usted ya ayudaba al abuelo. ¿Es que no soy lo suficientemente bueno? ¿Lo he decepcionado? O es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661105,
					"content": "¡Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661106,
					"content": "*Suspira*... Ahora te estás culpando a ti mismo... Por eso he fracasado como padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661107,
					"content": "El clan Kaedehara lleva pagando por sus errores del pasado desde la generación de tu bisabuelo. Y todavía ahora seguimos sin recuperarnos de lo ocurrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661108,
					"content": "Aunque seamos una familia de herreros, no tienes por qué que dedicar tu vida a la forja de espadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661109,
					"content": "Si un animal herido quiere librarse del cepo, deberá sacrificar la pata que tiene atrapada. Por muy terrible que te parezca, quedarse en esa trampa tiene consecuencias mucho peores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661110,
					"content": "Bueno, ya es suficiente por hoy, Kazuha. Como líder del clan, no he conseguido restaurar nuestro honor. Nunca me culpaste a pesar de no haberte dado la vida que te merecías y me siento agradecido por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661111,
					"content": "El sufrimiento de todas estas generaciones... Es hora de ponerle fin. A partir de hoy, vivirás sin esa carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661112,
					"content": "No te preocupes, yo asumiré las culpas por abandonar el negocio familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661113,
					"content": "No lo haga, padre. No debería culparse por no poder cargar con la mala reputación de nuestro apellido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661114,
					"content": "Aunque ese día llegue, permítame compartir la carga con usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661115,
					"content": "Espere y verá. Algún día, yo seré el líder del clan Kaedehara y, llegado el momento, me haré cargo de todos estos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
