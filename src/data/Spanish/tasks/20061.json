						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Ojalá se porten bien a partir de ahora y entreguen las cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "No puedo estar todo el día detrás de ellas. En fin... creo que con lo que has hecho bastará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "Gracias por tu esfuerzo. Toma esto como agradecimiento. Ven a visitarme cuando quieras mandar un mensaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
