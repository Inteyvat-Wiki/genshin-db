			"dialogs": [
				{
					"id": 200610501,
					"content": "Sobre las palomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610502
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610502,
					"content": "¡Oye! ¿Qué estás haciendo? ¡Son palomas mensajeras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610503,
					"content": "En serio... ¿qué te pasa? ¡Todavía tengo muchas cartas que enviar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610504,
						200610506
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610504,
					"content": "Lo siento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610505
					]
				},
				{
					"id": 200610505,
					"content": "¿Crees que lo vas a arreglar con una simple disculpa? ¿Es eso lo que hacen los Caballeros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610508,
					"content": "Tú has cometido el error, así que tendrás que cargar con las consecuencias. Ya que tienes el cerebro de un pájaro, ¡igual podrías ser mi nueva paloma mensajera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610506,
					"content": "Esas palomas son muy duras de roer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "¡Persíguelas con una sartén! ¡Ya verás cómo huyen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				}
			]
		},
