			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "¡Qué costumbres tan románticas! Esto sí que es digno de investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000102,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "#Oh, viajer{F#a}{M#o}, eres tú. ¿Viniste a la biblioteca porque a ti también te interesan las canciones románticas de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000104,
					"content": "Las cosas que están escritas las podemos leer en cualquier momento, pero la historia que sucede a nuestro alrededor es muy fácil perdérsela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000105,
					"content": "La gente de Mondstadt tiene muchas costumbres especiales en el romántico y alegre Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000106,
					"content": "¿Cómo son esas costumbres? ¿Cuál es su trasfondo histórico? Todas estas cosas son un material perfecto de investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000107,
					"content": "Justamente estoy escribiendo un informe de investigación sobre esos temas, pero no bastará con solo texto escrito. ¿Podrías ayudarme a tomar algún retrato del paisaje del Festival de las Flores de Viento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000108,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "#Gracias por ayudarme con mi investigación académica, viajer{F#a}{M#o}. Me aseguraré de que tu nombre aparezca en el informe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000113,
					"content": "Lo que más vale la pena registrar son las <color=#00E1FFFF>flores colgantes de la fuente de la plaza</color>, la <color=#00E1FFFF>estatua decorada con flores frente a la Catedral</color> y la <color=#00E1FFFF>dueña de la floristería trabajando en su tienda</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000115,
					"content": "Por favor, ayúdame a guardar una imagen de estos lugares. Tráeme tus mejores retratos cuando los tengas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000110,
					"content": "Podrías ir tú mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "No, no, no. No puedo irme ahora. Acabo de redactar el borrador del informe. Si me voy ahora, perderé el hilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000112,
					"content": "#Lo siento, pero necesito tu ayuda, viajer{F#a}{M#o}. Aunque no será mucho, te prepararé una buena recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				}
			]
		},
		{
