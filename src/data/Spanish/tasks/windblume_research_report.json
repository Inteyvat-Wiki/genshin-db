			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "¿Ya tienes los retratos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000602,
					"content": "Sí, ya están todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "Oh, no están nada mal, seguro que podré usarlos para mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000604,
					"content": "Al ver estos paisajes tan bellos, no puedo evitar acordarme de las festividades de Sumeru, mi hogar de nacimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000605,
					"content": "¿Qué festividades hay en Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "Oh, tal vez no lo sepas, pero todos los años celebramos el Festival Sabzeruz para conmemorar el nacimiento de la Reina Menor Kusanali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000607,
					"content": "Pero en cuanto a la atmósfera, tiene algunas diferencias con el Festival de las Flores de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000608,
					"content": "Ahora que lo pienso, este año no asistí al Sabzeruz. *Suspira*, ha pasado tanto tiempo que no sé ni cómo estará la Academia de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000609,
					"content": "Creo que me estoy desviando del tema. En fin, muchas gracias por tu ayuda. Toma, esta es tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				}
			]
		}
	]
