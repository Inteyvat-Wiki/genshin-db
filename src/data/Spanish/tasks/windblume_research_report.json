				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "#Bienvenid{F#a}{M#o} a El Lenguaje de las Flores. ¿En qué te puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000402,
					"content": "Sayid me pidió que tomara un retrato aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Oh, claro. El Festival de las Flores de Viento es único de Mondstadt. Supongo que en Sumeru no lo celebran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000404,
					"content": "¿Quieres tomar una imagen de mis flores y de mí? No hay problema. Sayid tiene muy buenas ideas, supongo que por eso es un erudito, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
