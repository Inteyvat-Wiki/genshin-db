				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "Lo siento, tengo algo que hacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "No te preocupes, de todos modos solo estamos aquí pasando el tiempo. ¡Ven a buscarnos cuando estés libre o quieras desfogarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605602",
							"2"
						],
						"stepId": 7605602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "Lo siento, jefe... Nos he avergonzado a todos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560402,
					"content": "Oye, solo estamos pasando el rato. No importa si pierdes. Bielov, descansa un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560403,
					"content": "#¡Eres muy ágil, amig{F#a}{M#o}! Me llamo Terho. ¡Un placer conocerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560404,
					"content": "#Me llamo {NICKNAME}. ¡Un placer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "Se nota que tienes mucha experiencia en combate, así que tendremos que ponernos serios. Lo de antes no cuenta. ¡Tengamos otro duelo! ¡Es tu turno, Incali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560406,
					"content": "El jefe solo se acuerda de mí cuando hay problemas... En fin, qué le vamos a hacer. Bien, entonces, ¡comencemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Incali"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605603",
							"2"
						],
						"stepId": 7605603,
						"stateName": "QUEST_STATE_UNFINISHED"
