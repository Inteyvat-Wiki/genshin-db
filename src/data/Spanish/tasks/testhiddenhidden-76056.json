					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "#¡No puedo creer que haya perdido contra {F#una}{M#un} viajer{F#a}{M#o} de paso... tres veces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "No, no, tú y yo perdimos dos veces cada uno. El jefe solo perdió una vez, menos mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#¡Ja! Una derrota es una derrota, ¡no sirve de nada darle vueltas! ¡{NICKNAME} es realmente fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "Ustedes dos ni siquiera pueden vencerme a mí en un combate normal. ¿Ahora ven lo que es un verdadero guerrero? Todavía les falta mucho entrenamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "En cuanto a mí... ¡Parece que tendré que considerar jubilarme pronto! Me pregunto si el campo de entrenamiento de Vaino todavía estará contratando personal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
