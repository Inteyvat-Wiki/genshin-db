				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "#N-no puedo creerlo... ¡Perdí contra {F#una}{M#un} simple transeúnte! ¿Cómo... cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560502,
					"content": "Oh, no puedo creer que haya derrotado a Incali... Me confié demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560503,
					"content": "#No es su culpa, jefe. Después de todo, ¿quién podría imaginar que {F#una}{M#un} adversari{F#a}{M#o} tan poderos{F#a}{M#o} pasaría casualmente por aquí?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560504,
					"content": "¡Jefe! No podemos dejar que se vayan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560505,
					"content": "¿Eh? ¿No estaban solamente pasando el rato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "No nos malinterpreten. Incali solo quiere decir que no podemos rendirnos así sin más. Después de todo, somos unos respetables cazadores de tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, te desafío a un duelo formal. Esta vez no será un simple entrenamiento, ¿qué te parece si luchamos con todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560508,
					"content": "Entonces, me enfrentaré a los tres a la vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "Bien. Entonces, ¡no nos contendremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
