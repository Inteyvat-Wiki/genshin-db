					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560101,
					"content": "#¡Ey, amig{F#a}{M#o}! ¿No te parece aburrido pelear sol{F#a}{M#o} en el campo de entrenamiento? Pareces bastante hábil, ¿qué te parece si intercambiamos algunos golpes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605602,
			"completionStepIds": [
				7605601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "Algunos, y los que quieras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "#¡Jaja, qué emoción! ¡Sin duda los enfrentamientos entre personas son los más emocionantes! Oye, Bielov, ¿por qué no empiezas tú intercambiando unos golpes con nuestr{F#a}{M#o} amig{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560205,
					"content": "#¡De acuerdo, jefe! ¡L{F#a}{M#o} derrotaré en tres movimientos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bielov"
				}
			]
		},
		{
			"id": 7605603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
