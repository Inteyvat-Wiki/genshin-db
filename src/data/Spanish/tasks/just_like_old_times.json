			"dialogs": [
				{
					"id": 761840101,
					"content": "Vaya, esto es digno de recordar. Nunca pensé que llegaría el día en que me invitaras a una de tus horas del té, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840102,
					"content": "Quizás si hubieras mejorado tus modales, te habría invitado a venir antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840103,
					"content": "Estoy de acuerdo. Quizá también te ayudaría dejar de retar a la gente a duelos todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761840104,
					"content": "Hablas exactamente igual que mis hermanos y hermanas mayores. No puedo evitarlo. Cuando mi maestra me entrenaba en la naturaleza, los modales no eran precisamente una prioridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840105,
					"content": "Bueno, da igual. No es habitual que podamos vernos, así que relajémonos y disfrutemos del momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840106,
					"content": "¿Eh? ¿Esta es tu última creación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840107,
					"content": "Se llama Fagio. Es una Facilitadora Automatizada Generalista Interactiva y Omnitarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840108,
					"content": "¿Eso significa que Pulonia está en un punto completamente irreparable? Lo siento mucho, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840109,
					"content": "No pasa nada, yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840110,
					"content": "Es una lástima saber que nunca tendré la oportunidad de enfrentarme a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840111,
					"content": "Claro que sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840112,
					"content": "Pulonia parecía fuerte, pero este Fagio, por otro lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840113,
					"content": "¿Estabas a punto de decir que parece débil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840114,
					"content": "Eh... Jaja, no, no. Es solo que no parece tan fuerte como Pulonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840115,
					"content": "*Tch*, Pulonia fue diseñado para realizar mediciones y cálculos. Me aseguré de no afectar su capacidad de procesamiento al darle habilidades de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840116,
					"content": "Pero Fagio no necesita procesar fórmulas complejas. Toda su potencia de cálculo puede destinarse a su módulo de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840117,
					"content": "Entonces... ¿eso significa que en realidad es más fuerte que Pulonia? ¿Es eso siquiera posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840118,
					"content": "No estarás satisfecho hasta que la veas en acción, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840119,
					"content": "Que quede claro: no voy a pagar ninguna reparación si se rompe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840120,
					"content": "Y yo no voy a pagar tu factura del médico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840121,
					"content": "(*Suspira*... sabía que esto iba a pasar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761840122,
					"content": "(*Ñam, ñam*...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
