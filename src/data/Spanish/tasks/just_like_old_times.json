			"dialogs": [
				{
					"id": 761840301,
					"content": "En general, estas horas del té no están nada mal. Si hubiera sabido que eran tan divertidas, habría ido a una antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840302,
					"content": "(Quedémonos sentados así un rato más.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "¡Está bien, hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 761840303,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				}
			]
		}
	]
