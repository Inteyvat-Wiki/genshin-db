				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Nara rubi{F#a}{M#o}, Araminali sabe que nara buen{F#a}{M#o} ayudará a aranara. ¡Así que Araminali dará cofre a nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
