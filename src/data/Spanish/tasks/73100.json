				{
					"id": 731000601,
					"content": "#¡Araminali todavía no está preparado! Cofre todavía no está lleno. Nara {NICKNAME} y Paimon pueden “pasar rato” mientras tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000602,
					"content": "Humm, no. Sería mejor que fueran a “darse una vuelta”. Puede que así encuentren aranara que necesitan ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310007,
