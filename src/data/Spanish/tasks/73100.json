			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#Araminali está lleno, pero cofre tiene hambre. Hambre no es nada buena. Nara {NICKNAME} y Paimon recorrieron largo camino, seguro que tienen mucha hambre. Tienen que comer muchos champiñones para recuperar energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		}
	]
