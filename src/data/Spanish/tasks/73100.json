			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Nara {NICKNAME}, ¿quieres abrir cofre? Pero en bosque aún hay muchos aranara que necesitan ayuda, si nara rubi{F#a}{M#o} pudiera ayudar a esos aranara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "¡Entonces Araminali preparará cofre bien repleto! ¡Cofre lleno a rebosar con tesoros enviados por Aranimba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
