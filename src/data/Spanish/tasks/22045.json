			"dialogs": [
				{
					"id": 220450301,
					"content": "¿Eh? ¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450302,
					"content": "Tomando imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "#... ¿Y eso qué es? Qué rar{F#a}{M#o} eres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450304,
					"content": "Bueno, da igual. Haz lo que quieras, pero no ensucies el santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 2204504,
			"completionStepIds": [
