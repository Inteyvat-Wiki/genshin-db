					"Ogura Mio"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "Así no hay forma de hacer negocios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "¿Hay algún problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Ah, lo siento. Solo estaba pensando en mis cosas. ¿Estás aquí para comprar ropa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "Las sedas de alta calidad de Liyue siguen agotadas, pero todavía nos quedan los últimos kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "¿Solías importar material de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Sí. Antes, a menudo podíamos conseguir seda de alta gama de Liyue, como las que el Gremio de Comerciantes de Feiyun fabrica con flores de seda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Pero con la situación actual de Inazuma, no podemos importar esa clase de seda desde hace un tiempo. Tuvimos que depender de nuestras existencias disponibles para seguir trabajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Cada rollo de seda que usamos es uno más que no vamos a recuperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "En un principio, pensaba diseñar algunos novedosos patrones de kimonos por mi cuenta, o usar algunos tintes nuevos para hacer telas nuevas y atraer clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Pero no se me ocurrió nada que se pudiese considerar tinte “nuevo”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "#Teniendo en cuenta tus numerosos viajes, viajer{F#a}{M#o}, tengo la certeza de que viste muchas cosas. ¿Encontraste algún tinte que pudieses considerar una “novedad”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Sí, he visto bastantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "¿Ah, sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "Si no te importa, por favor, ayúdame a ampliar mis horizontes. Consígueme algunos materiales básicos con los que pueda fabricar nuevos tintes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Yo me encargaré del pago, ¡muchas gracias de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "¿Solo necesitas tintes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "En estas circunstancias, creo que es lo único que puedo hacer en este momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "Si te enteras de algunos materiales básicos que se puedan usar para fabricar tintes nuevos, tráemelos. Yo me encargaré de pagártelo como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
