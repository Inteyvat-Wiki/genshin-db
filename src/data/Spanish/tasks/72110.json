			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "¿Por qué abandonaría el gimnasio para convertirme en el instructor del Sr. Kujou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100102,
					"content": "Yanagiha y Okazaki, así como Mifune... ¿por qué me abandonaron...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "... Ahora, la espada de Iwakura Kouin es lo único que falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "¿La Espada Amenoma Luminosa del Destino ancestral de la familia Iwakura? Cuando te adoptaron a ti y a Kunihiko, mientras el maestro Eiin estaba distraído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "Nos han expulsado, ya no tienes que llamarlo maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Pero, Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "Cuando pones en la balanza el afecto contra la justicia, un verdadero espadachín solo puede recorrer el camino de la justicia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Ya que lo dijo el maestro, significa que no quería expulsarnos, pero no tenía otra opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "Por supuesto que no quería hacerlo, pero como ya había decidido convertirse en la espada de la Shogun, según el Decreto de captura de Visiones, solo podemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Solo podemos elegir nuestro propio camino de justicia. Después de todo, un verdadero espadachín solo puede recorrer el camino de la justicia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Pero la propia justicia del maestro cayó derrotada al final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "Así es. No solo Kunihiko, sino también los demás, incluido Iwakura Kouin. Debemos vengarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Esa es la justicia de los discípulos expulsados, como nosotros mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "Esa debe ser también la bendición del maestro. El primer enemigo acaba de acudir a nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Tienes razón. Tú debes ser {NICKNAME}. He oído hablar de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "#En el mundo de los espadachines, la sangre solo se puede limpiar con sangre. Asumo que debes estar {F#preparada}{M#preparado} para enfrentarte al antiguo estilo Iwakura Menkyo Kaiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
