						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "¿Por qué abandonaría el gimnasio para convertirme en el instructor del Sr. Kujou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100302,
					"content": "Yanagiha y Okazaki, así como Mifune... ¿por qué me abandonaron...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100303,
					"content": "Ya visité a los discípulos de Iwakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "¿Ah, sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100305,
					"content": "¿Todavía quedan personas que dicen ser de Iwakura? Su maestro era tan incompetente, después de todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100306,
					"content": "Yo soy Iwakura Kouzou, instructor de combate con espadas de este lugar. ¿Y tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100307,
					"content": "#Me llamo {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba... ¿Los viste? ¿Y los hermanos Okazaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100309,
					"content": "Y también Katayama. Siempre le gustó ponerle nombre a los duelos antes de que comenzaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100310,
					"content": "Porque “si me convierto en un verdadero maestro espadachín en el futuro, entonces todos estos duelos pasarán a ser historia”. Jajaja. Qué tontería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100311,
					"content": "Ah, sí, y también Shimada, quien se pasó las eras Eiin y Kouin entrenando e incluso así no consiguió progresar más allá del rango Shoden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100312,
					"content": "Tuvieron que huir porque no podían comprender el poder del Decreto de captura de Visiones de la todopoderosa Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100313,
					"content": "Extraño los viejos tiempos de enseñarles a empuñar una espada. ¿Por qué cerré el gimnasio y me uní al ejército?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, ¿se mostraron habilidosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100315,
					"content": "Es una pena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "De verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100318,
					"content": "#Entonces, {NICKNAME} ¿quién es tu maestro? ¿Domon? ¿Shousen? ¿O quizás la propia Narukami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100319,
					"content": "Soy más bien autodidacta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Ya veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100321,
					"content": "#Parece que el estilo Iwakura se ha deteriorado estando a mi cargo. Ninguno de mis alumnos pudo derrotar a {F#una espadachina}{M#un espadachín} autodidacta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Ahora ya lo entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100324,
					"content": "Sea cual sea tu escuela de aprendizaje del arte de la espada, no importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100325,
					"content": "Parece que el estilo Iwakura se ha deteriorado estando a mi cargo. Ninguno de mis alumnos pudo derrotar a una persona que no está dispuesta a revelar el nombre de su escuela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100326,
					"content": "No soy más que un maestro incompetente del estilo Iwakura. Mi nombre de espadachín es Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100327,
					"content": "Aunque ya no recuerdo la técnica de espada secreta y le entregaron mi Visión a la todopoderosa Shogun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100328,
					"content": "... Si me preguntaras si aún deseo vengar a aquellos discípulos míos que no soportaron ver mi decadencia y acabaron siguiendo el camino de los fantasmas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100329,
					"content": "... Y que, por su incompetencia, perdieron contra ti, entonces te diría que aún conservo algo de esa pasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100330,
					"content": "Este lugar es muy pequeño. Temo que no puedas demostrar tus habilidades con la espada. Sígueme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100316,
					"content": "Aprendí bastante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				}
			]
		}
	]
}