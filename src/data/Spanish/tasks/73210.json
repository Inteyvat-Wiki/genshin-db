			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Paimon se pregunta qué tipo de tesoro encontraremos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "#El mueble está abarrotado de ficheros. Ojean los títulos, pero parece que no hay nada más que registros e historiales médicos.\\nCierran los cajones decepcionad{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Paimon pensaba que habría algo interesante aquí... ¡Incluso los barriles y las cajas contienen cosas más fascinantes que esto! Al menos tienen repollos o carne de ave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "¿Eh? ¿Qué es eso? Parece que se ha caído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Deja que Paimon lo vea... Quizá sea una pista de algún tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Eso de la eleazar suena aterrador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "¿Y qué pone en ese otro documento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "¡Paimon no entiende ni papa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Yo tampoco lo entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Lo único que Paimon entiende es eso de “La voz divina me guía”... ¿Tú crees que aquí aparecen voces misteriosas que guían a la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Podría venir del agua subterránea o de la actividad de criaturas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "#¡Así es! ¿Quién sabe? ¡Podría haber ruinas subterráneas aquí abajo! ¡Estemos atent{F#a}{M#o}s a cualquier sonido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "Quizá sea mejor que no lo entiendas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "¿Eh? ¿Tú sí que lo has entendido? Lo único que Paimon entiende es eso de “La voz divina me guía”... ¿Tú crees que aquí aparecen voces misteriosas que guían a la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}