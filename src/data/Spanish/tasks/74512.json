			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fréjus",
					"Chênée"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "#Según los datos del experimento, el invento ha sido todo un éxito. Gracias a l{F#as}{M#os} dos por ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120102,
					"content": "¡Sí, muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120103,
					"content": "¿Ves? Te dije que todo saldría bien. Después de todo, eres un genio en este campo. Una torreta con control remoto es pan comido para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120104,
					"content": "S-sí, supongo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120105,
					"content": "Vamos, ¡aprovechemos el tiempo para hacer un nuevo invento! ¡Se me ha ocurrido una idea muy interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120106,
					"content": "¿Qué idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120107,
					"content": "¿Qué tal un submarino que pueda volar por el cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120108,
					"content": "Ehmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120109,
					"content": "¿O una supertaladradora que pueda excavar hasta lo más profundo posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120110,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120111,
					"content": "Paimon cree que lo está haciendo a propósito para molestar a Fréjus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Seguro que es difícil inventar algo así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "Pero, Fréjus, tú rechazaste tres veces al Instituto de Ciencias de Fontaine, seguro que puedes crear cosas que el instituto no puede, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120114,
					"content": "Por supuesto. Solo que... es un poco complicado, pero no supondría gran cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120115,
					"content": "Ay, ¿sabes qué? De repente perdí el interés por esas cosas. Volar por el cielo o adentrarse en la tierra suena aburrido. Además, en el cielo haría mucho frío y bajo la tierra no hay nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120116,
					"content": "Sí, me pasa lo mismo que a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120117,
					"content": "Entonces, ¿puedes inventar algo que se pueda usar en la vida cotidiana? Mira, me gusta quedarme en la cama por la mañana, ¿podrías hacer un horno que prepare automáticamente el desayuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120118,
					"content": "Eso suena más factible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "Lo de antes era a propósito, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "De acuerdo, déjame pensar en su diseño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745120121,
					"content": "Genial. Entonces, trato hecho, ¿eh? Si al final no lo consigues, ¡tendrás que encargarte de todos mis desayunos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745120122,
					"content": "Pero ¿qué petición es esa?... Bueno, no te preocupes, ese tipo de inventos no son nada para mí. A fin de cuentas, soy un genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréjus"
				}
			]
		},
