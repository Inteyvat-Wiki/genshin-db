			"dialogs": [
				{
					"id": 700800101,
					"content": "Tras haber estado entre la línea de la vida y la muerte, lo cierto es que lo que más extraño es el sabor de la cerveza. Incluso mi maestro y el Rey Deshret vendrían después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800102
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800102,
					"content": "Ah, no sabía que disfrutabas tanto de la bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800103
					],
					"speakerTitle": "Kshama"
				},
				{
					"id": 700800103,
					"content": "Bueno, cuando llevábamos ladrillos al Mausoleo del Rey Deshret, solíamos recibir dos jarras enormes de cerveza al día gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800104
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800104,
					"content": "Hablando de eso, ¿se encontraba Maukie entre aquellos que han sido restaurados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800105
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800105,
					"content": "No. Sospecho que los de arriba pretenden lidiar con él por desobedecer las normas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800106
					],
					"speakerTitle": "Vitruvio"
				},
				{
					"id": 700800106,
					"content": "Me pregunto si le habrá servido la nota que le pedí que trajera en secreto.",
					"roleType": "TALK_ROLE_NPC",
