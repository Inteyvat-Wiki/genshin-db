			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Tus habilidades son simplemente de otro mundo. He sufrido una derrota aplastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "Has luchado muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Damas y caballeros, este emocionante enfrentamiento nos ha dejado un campeón del Torneo Doctrina Marcial de Lucha de Espadas. Con todos ustedes, ¡{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "#Mañana tendrá lugar el duelo de exhibición. {NICKNAME} y la Srta. Kamisato se enfrentarán al contrincante especial de la Shogun Raiden, el espadachín autómata llamado Oni Espadaheroico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "¡Nos vemos mañana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "#Fue un duelo increíble, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "#¡Felicidades, viajer{F#a}{M#o}! ¡Te has ganado a pulso el título de {F#campeona}{M#campeón}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Paimon no se esperaba que el rival de mañana fuera ese Oni Espadaheroico. A Paimon le recuerda al oni tan molesto que nos encontramos en la Isla Yashiori. Paimon te pondrá una velita para que te dé suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "#No te preocupes, Paimon. El rival enviado por la Arconte será poderoso, pero también se permite el uso de Visiones. Si trabajamos junt{F#a}{M#o}s, seremos invencibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "Solo tenemos que prestar atención a sus movimientos y encontrar el momento más adecuado para atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Jeje, ¡Paimon está más tranquila después de oír eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Bueno, no puedo garantizar la victoria, pero haremos todo lo que podamos. ¡Aunque solo sea para que el público presencie un enfrentamiento sobrecogedor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Ganaremos, ¡ya verás, Ayaka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "#Vaya, parece que están más que preparad{F#a}{M#o}s para la lucha. Aunque les recomiendo que descansen bien esta noche y repongan energías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "Además, mañana podremos ver el traje de exhibición de Ayaka, jeje. Ayaka vestida como la gente de Fontaine... ¡Paimon se muere de ganas de verlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Eh, bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "¡Yo también me muero de ganas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "#¿Qué? ¿Tú también, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Jeje, señorita, debería aprovechar ahora que nadie la mira para aceptar la oferta. Si no fuera porque tengo asuntos que atender, a mí también me habría gustado ir a verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "De acuerdo, entonces acepto la oferta. Te espero mañana a la entrada de la Hacienda Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "¿Te gustaría que viniese a recogerte mañana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "¡Será un combate digno de recordar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Vaya, pero si son ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "¡Ah! ¡Pero si es Hirotonto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "#{NICKNAME} ya te dio una paliza hace un par de días, y se ha hecho con el primer puesto. ¡Trágate tus palabras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "#Jaja, tranquila, no estoy aquí para causar problemas. Solo quería disculparme. Perdí contra ti con todas las de la ley, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "Tu técnica con la espada es fuera de lo común. Cada golpe que asestas es preciso y medido. Eso dice mucho de tu carácter. Erré en mi juicio y te ofrezco mis más sinceras disculpas si mi discurso o mis acciones te causaron pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "No te preocupes, está todo olvidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Supongo que han venido a recoger a la Srta. Kamisato. Está vistiéndose en estos momentos, no debería tardar mucho más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "#Viajer{F#a}{M#o}, antes de que la señorita salga, tengo una petición para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "¿De qué se trata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "La señorita no le ha hablado a ninguno de los sirvientes acerca del combate de exhibición, pero ha dedicado largas horas cada día a su preparación sin importar lo ocupada que estuviera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "Esa es la clase de persona que la señorita es. Es trabajadora y tenaz. Puede que solo sea un combate de exhibición y que lo importante no sea el resultado, pero ella no dejará de dar lo mejor de sí misma a cada instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "Soy su sirviente y deposito mi confianza en ella ciegamente, pero aun así espero que puedas apoyarla y protegerla durante el combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "No te preocupes, lo haré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "Bien, entonces dejo a la señorita en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "¡Esa debe ser Ayaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Guau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "#¿Eh? ¿Qué ocurre? ¿Por qué están tan callad{F#a}{M#o}s? ¿Hay algo malo con el vestido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "¡Para nada! Ayaka, estás... ¡Estás preciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Es perfecto para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "¿Verdad? ¡Pareces una joven llena de energía que acaba de bajar de un barco procedente de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "¿D-de verdad lo creen? Creía que sería demasiado... No sé si es apropiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Así que me alegra mucho saber que les gusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Paimon está segura de que todos se llevarán una gran sorpresa al verte, Ayaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "#¡Muchas gracias, Paimon! ¿Y bien? Deberíamos irnos ya, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "#Señorita, viajer{F#a}{M#o}, les deseo la mayor de las suertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "Es un vestido muy hermoso. Es perfecto para la ocasión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "¡Eso! Y ahora que Paimon se fija, ¡hasta tiene grabado el emblema de la familia Kamisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Así es, Onodera hizo que alguien de la hacienda lo incluyera en el diseño hace un par de días. Al parecer fue una sugerencia que alguien escribió junto con su voto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "El vestido está muy bien hecho y es más ligero de lo que esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "Disfruté mucho durante nuestro enfrentamiento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
