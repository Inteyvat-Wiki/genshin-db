			"dialogs": [
				{
					"id": 736880301,
					"content": "#¡Mira eso! ¡Son la Srta. Kamisato y {F#la}{M#el} viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "Ya había visto el vestido en alguna que otra ilustración, pero ver a la Srta. Kamisato con él le da un carácter único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "Mereció la pena el madrugón para estar en primera fila. ¡Me muero de ganas de que empiece el combate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "¡Tal y como esperaba! ¡Ayaka es la comidilla del lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Damas y caballeros, les rogamos guarden silencio durante unos instantes. El combate de exhibición de Doctrina marcial está a punto de comenzar. Por favor, procedan a la arena en orden y ocupen sus respectivos asientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "#Srta. Kamisato, viajer{F#a}{M#o}, acompáñenme, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "#¿Estás preparad{F#a}{M#o}, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "Como nunca antes. ¡En marcha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Bien. Hagámoslo lo mejor posible. Es un honor luchar a tu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Necesito tiempo para prepararme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "#No te preocupes, no hay prisa. Tómate todo el tiempo que necesites. Ven a verme cuando estés preparad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#¡{NICKNAME}, Ayaka! ¡Estamos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "¡Ha sido un combate extraordinario! Yo no sé mucho sobre el arte de la lucha con espada, pero la tensión se palpaba en el aire. El corazón me latía a mil por hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "Ese Oni no dejaba de hacer ¡*chas*! y ¡*waaash*! por todas partes, pero parecía que ustedes pudieran leer sus movimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "#{NICKNAME}, Ayaka, enhorabuena por la victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "Vaya, ¡hola, Sara! ¿Tú también has venido a ver el combate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "La Shogun me encargó que viniera a vigilar el evento. Han demostrado una coordinación y un porte dignos de elogio. No solo han sido más que capaces de demostrarle al público el verdadero arte de la lucha con espada, yo misma también he aprendido mucho a lo largo del combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Me halagas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Soy consciente de lo ocupados que han debido estar estos días preparando el torneo. Sin duda, Doctrina marcial no podría haber tenido un mejor broche final. La Shogun valora enormemente sus esfuerzos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "He de volver a Tenshukaku para informar a la Shogun de lo que ha pasado en el combate. Si me disculpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "¿Y qué piensan hacer ahora? Si están libres, podríamos ir al Restaurante Uyuu a celebrar la victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "#¡A Paimon le gusta como piensas! ¡Estábamos tan concentrad{F#as}{M#os} en la competición que hace ya tiempo que no disfrutamos de una comida como los Arcontes mandan! ¡A comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "¿Qué te pasa, Ayaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Ah, no es nada. Es que la realidad de lo ocurrido está empezando a calar ahora. Kujou Sara ha dicho que había aprendido mucho del combate. Y lo cierto es que yo también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Puede que el público no se haya dado cuenta, pero hubo un par de momentos en los que habría estado en problemas si no hubiera contado con tu apoyo para desviar los ataques del enemigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "No lo habría logrado de no tenerte a mi lado. Tal y como sospechaba, no puedo compararme contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "Tú también has sido clave en muchos momentos, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "¿Lo dices en serio? Al oírte decir eso me han dado ganas de luchar contra ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "Si te soy sincera, tengo ganas medirme contigo desde el día en que nos conocimos. Y hoy por fin he podido cumplir ese sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "Podemos cruzar espadas siempre que quieras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Muy bien, pero hasta entonces, cuida bien de tu espada, ¿entendido? Si llegara a robártela un día de estos, tu vida estaría en mis manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Jeje, siempre he querido decir eso... ¿Ha sonado raro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Muy propio de la Srta. Orith.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "¡Oye! ¿Por qué tardan tanto? ¿De qué están hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "Solo estaba comentando que un combate serviría para demostrar quién es mejor en el arte de la lucha con espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "#Vaya, te lo tomas muy en serio cuando de luchar se trata, Ayaka. ¿Pero no se supone que son amig{F#a}{M#o}s? ¿Por qué quieren combatir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "#Precisamente porque somos amig{F#a}{M#o}s. Así podemos aprender {F#la una de la otra}{M#el uno del otro}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Humm, sí, Paimon cree que tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "#{NICKNAME}, ¿te importaría no contarle a nadie lo que he dicho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "¿Eh? ¿Qué dices, Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Oh, no es nada, no te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "Ha sido adorable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Eres demasiado humilde, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
