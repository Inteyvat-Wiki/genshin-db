			"dialogs": [
				{
					"id": 401489801,
					"content": "Cuando termine de comer tendré que volver al puerto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489802
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401489802,
					"content": "Díganme la verdad, ¿por qué vinieron a Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489803
					]
				},
				{
					"id": 401489803,
					"content": "Eh... pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401489804,
					"content": "Ya lo explico yo. Hace poco, el jefe encontró un trabajo como marinero, por eso pudo viajar hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401489805,
					"content": "Una vez que el barco llegó al puerto, el jefe tenía algo de tiempo libre para hacer lo que quisiera, así que lo aprovechó para pasar un rato con el Gran Maestre Hanakado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489806
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401489806,
					"content": "Que conste que solo es porque estaba cerca, ¿eh?",
