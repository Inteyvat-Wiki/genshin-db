			"dialogs": [
				{
					"id": 401489501,
					"content": "Alguien que no come tofu... Nunca me lo habría imaginado. Yo me ocupo de los aperitivos, tú encárgate del plato principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
