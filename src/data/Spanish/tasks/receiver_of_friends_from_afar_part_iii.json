					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401489502,
					"content": "Yo también puedo ayudar. Tranquilos, estoy calificada, me saqué la titulación de cocina de Liyue.",
					"roleType": "TALK_ROLE_NPC",
