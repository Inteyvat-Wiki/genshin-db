			},
			"dialogs": [
				{
					"id": 401480101,
					"content": "#Buenos días, {NICKNAME}. Es hora de encender la hornilla para recibir a los clientes. ¡Gracias de nuevo por tu ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480102,
					"content": "Con la experiencia de estos días, vas adquiriendo práctica con la cocina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "#Muy bien, ¡cada día te pareces más a {F#una jefa}{M#un jefe} de cocina! Jeje, da igual qué tipo de cliente venga, ¡tú sabes arreglártelas perfectamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480104,
					"content": "¡Alto ahí! Siempre que dices eso, ¡nos traes problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480105,
					"content": "Ey, ¡eso no es verdad! Esa no es mi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480106,
					"content": "¡Jajajajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480107,
					"content": "¡Hermano! ¡No sabía que también estabas en Liyue! Arg, ¿cómo se decía? Si los dos somos de Inazuma, ¿somos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480108,
					"content": "Compatriotas, jefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480109,
					"content": "¡Eso, eso! Compatriotas. ¡Tenemos que cuidarnos los unos a los otros cuando estamos tan lejos de casa! ¿Verdad, Ayato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480110,
					"content": "Jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480111,
					"content": "¡Toreritto! ¡¿Otra vez tú?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480112,
					"content": "¿Eh? Es la mini... ¡Onicalavanda Perforacielos y mi colega del alma! Hoy debe de ser mi día de suerte, ¡cuántos viejos amigos reunidos en el mismo sitio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480113,
					"content": "¿No dijiste la otra vez que ibas a ahorrar dinero en Inazuma? ¿Cómo es que has vuelto a Liyue tan pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480114,
					"content": "Jaja, eso puede esperar. Me llueven los Moras en cuanto digo que estoy buscando trabajo. Pero eso no es importante. Ahora mismo, tengo algo más urgente de lo que ocuparme: ¡tengo antojo de un buen banquete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480115,
					"content": "... Ah, y de paso vengo a ver cómo le está yendo al Gran Maestre Hanakado en Liyue y eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480116,
					"content": "(A juzgar por la cara de Shinobu, parece que me está diciendo que no pregunte más.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "¿Y tú, Ayato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "Hace poco, escuché que en Liyue habían organizado un torneo de escaradiablos. Así que vine en cuanto pude... pero, al parecer, ya es demasiado tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480119,
					"content": "¿Qué? ¿Te lo perdiste? ¡Qué lástima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480120,
					"content": "Ya, pero lo bueno es que me he encontrado contigo, así que tú me lo podrás contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480121,
					"content": "Jaja, ¡por supuesto que sí, hermano! Pero te lo cuento mientras vamos comiendo... Por cierto, ¿dónde está el chef? ¡Que venga ya, que mis amigos tienen hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480122,
					"content": "#Yo soy {F#la}{M#el} chef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480124,
					"content": "Toreritto quiere hacerse el hospitalario e invitarnos a comer. ¡No podemos dejarle mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480125,
					"content": "... Pero el jefe de cocina es otra persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "Ah... Jaja, qué bueno, colega. Pues dale, que venga el chef supremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480127,
					"content": "Paimon y tú van a la cocina y le cuentan la situación al Sonriente Yanxiao...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "Eh... ¿Qué les pongo? Si es para recibir a invitados importantes, les puedo recomendar: joyas del palacio, cuerdas y flautas o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480129,
					"content": "Jefe, el presupuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480130,
					"content": "Sí, claro, emm... ¿Tienen algo más...? Emm... ¿asequible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480131,
					"content": "¿Asequible? Eh... pues tenemos “felicidad satisfactoria”. Un plato con un rico aroma a estofado, acompañado de proporciones suculentas que hacen la experiencia aún más satisfactoria. Es, sin duda, la mejor opción para sacar partido a sus Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480132,
					"content": "¿“Felicidad satisfactoria”? Me gusta cómo suena. ¡Pues ese mismo! Nos ahorraremos la parte ostentosa, ¡aquí todos somos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480133,
					"content": "Buena elección, Itto. A mí tampoco me gustan mucho los platos demasiado ostentosos. Supongo que por eso a veces nos entendemos. ¿Verdad, “hermano”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480134,
					"content": "¿Hermano?... ¡Ah, claro, claro, hermano! ¡Eres mi hermano del alma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480135,
					"content": "¿Pero de qué están hablando? En fin, mientras ustedes sean felices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
