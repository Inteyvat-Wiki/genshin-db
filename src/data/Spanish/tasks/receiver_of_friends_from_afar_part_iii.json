						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "A-aquí está la comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "¡Guau! Conque esto es “felicidad satisfactoria”. ¡Qué trozos tan grandes, me encantan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "Vamos, colegas, tomen asiento. Aquí todos somos amigos, ¡no se controlen! ¡Que aprovecheeeee! Allá voy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "*Ejem*, jefe, debemos respetar las costumbres locales. Según la etiqueta de Liyue, hay que dejar que los invitados se sirvan primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "¿Me estás hablando de etiqueta? Kuki... ¿eso no era lo que más odiabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "#Ahora que he terminado de cocinar, también cuento como invitad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "¿Eh? ¿Tú también, colega?... Aaah, ya sé, es porque huele demasiado bien y por eso todos quieren ser los primeros, ¿verdad? Bueeeno, está bien. Es que tenía tanta hambre que... bueno, da igual, ¡yo seré el último entonces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "Tú, Paimon, Ayato y Shinobu se sirven y dejan muy poca “carne” en el plato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "Ah, ya veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "¡Por fin es mi turno! ¡Quiero el trozo más grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "¡Espera, no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "¿Qué pasa? ¿Y ahora qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "Te toca, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Eh... Está bien... ¡A Paimon se le olvidó explicarles el origen de este plato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "¿El origen? Vamos, a nadie le importa eso. Da igual de dónde venga, ¡lo importante es que va a acabar en mi panza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Eh... es que... saltarse la historia de su origen es como... ¡como ir de viaje sin que te guíen! Confía en Paimon, disfrutarás mucho más de la experiencia después de oírla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "#Paimon tiene razón. Al igual que cada té debe disfrutarse de una forma u otra, si no conocemos la historia que se esconde detrás, ¿no nos estaremos perdiendo algo que nos ha preparado {F#la}{M#el} chef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "#¿{F#La}{M#El} chef? Ah, ¿mi colega? Entonces prestaré atención. A ver, cuéntame. Soy todo oídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "¡Así, sí! Empecemos primero con los ingredientes que contiene... Espera, mejor con la historia de la Posada Wangshu... lo cual se remonta a la del Pantano Dihua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#({NICKNAME}, ¡ahora es el momento!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(¡De acuerdo!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Mientras Paimon distrae a Itto, Shinobu y tú empiezan a devorar el plato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "La historia del Pantano Dihua me ha llegado al corazoncito... Qué difícil debió ser esa época. “Felicidad satisfactoria”, eso es, debemos estar satisfechos con la felicidad que tenemos ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(¡Rayos! Paimon no puede mencionar nada sobre el tofu... ¿Cómo nos hemos salido tanto del tema? Uff, bueno, por suerte ya queda poco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "(Vamos a reventar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "¡Aaah! ¡Kuki, colega! ¿Cuándo se zamparon lo que quedaba? Oigan, ¡guárdenme algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "¡Ya está, se acabó la espera! ¡Me toca comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "¡Espere! Jefe, en realidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "Un momento, Itto. Tengo una pequeña petición si fueras tan amable de considerarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "Salí de viaje con demasiada prisa y no pude traer a nadie de mi familia. Todos han oído hablar mucho de ti y son grandes admiradores de la Banda de Arataki, así que se sentirán tristes al saber que se perdieron esta oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "Pero si pudieras ceder esa “felicidad satisfactoria” que queda para que me la lleve a casa, seguro que estarán encantadísimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Eh... No sé si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Jefe, estaría bien que se sacrificara por sus amigos. Es una virtud muy valorada en Liyue... Además, ya comió bastante pescado a la parrilla mientras esperábamos el plato principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "Incluyendo mi parte y la de Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "¿Qué? ¿Me comí su parte? Rayos... Me dejé llevar demasiado con esa historia, ¿verdad?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "*Ejem*, entonces... ¡Mándales saludos de mi parte, hermano! Jefe, ¿nos podemos llevar el resto a casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "Paimon, se te ha olvidado algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "¿Y si me sirvo yo primero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
