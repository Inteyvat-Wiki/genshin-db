			"dialogs": [
				{
					"id": 401480401,
					"content": "Qué amigo más especial tienes... Pero “felicidad satisfactoria” no es muy difícil de preparar, así que este pedido no debería causarnos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480402
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480402,
					"content": "Por cierto, ¿por qué se llama “felicidad satisfactoria”? La carne está cortada en proporciones grandes y suculentas, ¡pero Paimon no cree que este estofado sea lo suficientemente satisfactorio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480403,
					"content": "Eh... he dicho que tiene aroma a estofado, pero nunca he dicho que se trate de carne. No se dejen engañar por su aspecto: en realidad es tofu con aspecto y sabor a carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480404
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480404,
					"content": "¡¿Tofu?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480405
					]
				},
				{
					"id": 401480405,
					"content": "¡Un momento! El tofu está hecho de frijoles... ¡Toreritto no puede comer eso! Tenemos que decirles que pidan otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480406,
					"content": "¿Qué está pasando? ¿Soy yo o me parece haber oído la palabra “tofu”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480407
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480407,
					"content": "Espera, ¿se puede saber por qué has entrado? Solo el personal permitido puede entrar a la cocina... *Suspira*, no importa. ¿Podrías pedirle a tu jefe que pida otra cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480408
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 401480408,
					"content": "¡Jaja! ¡Nadie entiende a mi hermano Ayato como yo! Por la presente, ¡declaro que “felicidad satisfactoria” será un símbolo eterno de nuestra amistad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480409
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480409,
					"content": "¡Eh! ¿Dónde está la comida? ¡Dense prisa, que me estoy quedando sin relatos que contar de Titán Carmesí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480410
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480410,
					"content": "Como pueden ver, me temo que va a ser difícil cambiar ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480411
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480411,
					"content": "Arg, ya se le está subiendo a la cabeza... Aunque se lo dijéramos, seguro que preferiría comerse los frijoles antes que quedar mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480412,
						401480413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480412,
					"content": "Llevemos unos aperitivos antes de servir el plato principal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				},
				{
					"id": 401480414,
					"content": "Me parece bien. Me aseguraré de que se llene el estómago con eso. Para el resto, tendremos que improvisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480413,
					"content": "¿Qué tal si servimos un par de aperitivos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				}
			]
		},
