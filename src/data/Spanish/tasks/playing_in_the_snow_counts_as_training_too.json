			"dialogs": [
				{
					"id": 706910101,
					"content": "#¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}! ¡Aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "¡He hecho nuevas amigas! ¿Quieres jugar con nosotras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "Me enseñaron un nuevo juego llamado “Rastros en la nieve”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "Las reglas son fáciles. ¡Se trata de un escondite muy especial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Guau, Klee, Yaoyao y Sayu, ¡se han hecho amigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "#A juzgar por el nombre que tiene y que es un juego del escondite, ¿tal vez sea una versión mejorada de Cazadores y rebeldes? ¡Seguro que nos divertiremos mucho jugando junt{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "¡Bieeen, el escondite!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "¡Achís!... En el campamento ya no hace tanto frío, pero sigo teniendo mucho sueño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#¿Eh? ¿Estoy teniendo alucinaciones? ¿Son {NICKNAME} y Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Tus ojos no te engañan. {NICKNAME} y Paimon realmente están aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "¡Yaoyao y Sayu! ¿Les apetece jugar al escondite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "#¡Vamos, si nos movemos y jugamos junt{F#as}{M#os}, no tendremos sueño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "¿No dijo también la Srta. Aoi que te vendría bien pasar más tiempo en las montañas nevadas para perfeccionar tus habilidades?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Eh... ¡no puedo creer que se hayan acordado de eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Está bien... Si pierdo contra ellos, o incluso contra el superperro ninja, ¡seguro que se pondrán más estrictos y será mucho más difícil echarme siestas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "Realmente voy a tener que ponerme las pilas en este viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "No te preocupes, he preparado un guiso de carne con verduras. Esta vez le puse chile de Jueyun y pimienta molida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Come un poco antes de empezar y te prometo que no pasarás frío durante todo el juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "¡Genial! ¡Me comeré un cuenco entero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "¡Paimon también quiere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Muy bien, ¡pues en un rato comenzaremos nuestro escondite en Espinadragón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "¡Jeje! Como toda Espinadragón está cubierta de nieve, ¡a Paimon no la van a encontrar cuando se esconda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "#¡Hola, Yaoyao y Sayu! ¿Quieren jugar al escondite con nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "¡A ver quiénes son las nuevas amigas de Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}