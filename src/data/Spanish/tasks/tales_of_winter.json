			"dialogs": [
				{
					"id": 206000501,
					"content": "No lo olvides, el trofeo que busco es de un Mitachurl. Cuando lo tengas, ven conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000502,
					"content": "¿Que qué aspecto tiene? Es... un cuerno. ¿A qué esperas? Tráemelo cuando lo tengas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
