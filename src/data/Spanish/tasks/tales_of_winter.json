			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000601,
					"content": "¿Lo trajiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000602,
					"content": "Sí, aquí está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Déjame echar un vistazo... Bueno, es aceptable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "Bien, te contaré algo sobre los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000605,
					"content": "Los Fatui venimos del Palacio Zapoliarni. Obedecemos órdenes de su majestad la Zarina, y actuamos según su voluntad, la cual difundimos por todo el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000606,
					"content": "Los que han demostrado ser los más fuertes han sido nombrados por la Zarina como Los Once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000607,
					"content": "Comparados con un soldado insignificante como yo, Los Once son unas eminencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000608,
					"content": "#Si te unes a los Fatui y demuestras tu fuerza, quizás puedas ser elegid{F#a}{M#o} por uno de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000609,
					"content": "Después de eso, solo te queda subir y subir más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000610,
					"content": "¿Yo? No creo que llegue a ser uno de los elegidos. Vine hasta aquí a hacer un pequeño encargo de Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000611,
					"content": "Pero si tuviera que escoger, preferiría servir a Capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
