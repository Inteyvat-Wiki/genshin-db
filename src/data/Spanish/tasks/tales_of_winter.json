			"dialogs": [
				{
					"id": 206000801,
					"content": "¿Lo trajiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000802,
					"content": "Sí, lo traje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000803
					]
				},
				{
					"id": 206000803,
					"content": "Déjame ver... Ah, no se puede encontrar nada de valor en un lugar tan atrasado como este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000804,
					"content": "De acuerdo, te hablaré de los Engaños. Déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000805,
					"content": "Los Engaños son tesoros de increíble poder otorgados personalmente por su majestad la Zarina. La fe o las Visiones son simples juguetes comparadas con los Engaños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000806,
					"content": "Aun así, no todos son capaces de controlarlos. Aparte de Los Once, muy pocos Fatui poseen uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000807,
					"content": "Para un mortal común como yo, un Engaño es mucho más fácil de conseguir que una Visión, que solo puede obtenerse por la gracia de los dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000808
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000808,
					"content": "Ja, veo que tampoco tienes una Visión. ¿Y si te unes a los Fatui? Quizás así consigas un Engaño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000809,
					"content": "Eso es todo lo que puedo decir sobre los Engaños. Los Caballeros de Favonius son muy quisquillosos con estas cosas, así que es mejor no atraer su atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
