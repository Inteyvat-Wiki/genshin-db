			"dialogs": [
				{
					"id": 206001001,
					"content": "¿Lo trajiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001002
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001002,
					"content": "Sí, lo traje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Vaya, no está nada mal. Eres muy hábil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001004,
					"content": "Así que quieres saber más sobre la Zarina, ¿eh? Humm, ¿por dónde empezar?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001005,
					"content": "Si tuviera que describirla en pocas palabras, diría que la Zarina es nuestra diosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001006,
					"content": "Y no lo digo en sentido metafórico, lo digo literalmente. La Zarina es la Arconte Cryo, una de Los Siete que dominan el destino de los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001007,
					"content": "Pero para nosotros, los Fatui, el estatus de Su Majestad va más allá que el de una diosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001008,
					"content": "¿Por qué? No lo entenderías, o mejor dicho, es algo que va más allá de tu comprensión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001009,
					"content": "Si quieres comprenderlo, únete a nosotros. Cuando lo hagas, entenderás por qué su majestad la Zarina es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001010,
					"content": "*Ejem*, eso es todo lo que te puedo contar. Esa monja de allí me está mirando otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		}
