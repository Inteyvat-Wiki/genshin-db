			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Una, dos... Humm, tres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "Humm... Una... dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "Vaya, aquí hay un tipo de una tribu de lo más extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "#Ustedes son l{F#a}{M#o}s extrañ{F#a}{M#o}s aquí, foraster{F#a}{M#o}s. Jejeje. Este no es lugar para gente como ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "¿Es un lugar prohibido?... ¿O algún sitio sagrado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "Para nada. Es solo un lugar que descubrí por casualidad... Un lugar donde hay tesoros ocultos. Humm, vengan aquí, acérquense. ¿Pueden oír esta piedra especial?... la “Roca de los Tesoros”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "El sonido que procede de su interior es como un suave zumbido que asciende y desciende, casi... casi como el sonido de una respiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "Qué duro es ser una piedra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Hablamos solo de respirar, ¿qué tiene eso de duro? No...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "Las... ¿Las rocas también respiran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "No solo eso... Si pones la oreja sobre su superficie, podrás escuchar su ritmo, el sonido de la fricción de la roca bajo su dura piel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "Jeje, es verdaderamente un sonido hermoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "Además... si la alimentas con piedras pequeñas, generará rocas mejores y más hermosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "Jeje, increíble, ¿verdad? Miren estas gemas... Una, dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "Así que eso estabas contando cuando llegamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "Sí, además puedo sentir que esta Roca de los Tesoros se ha vuelto mucho más poderosa tras consumir las otras piedras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "¡Qué milagro más increíble! Ah, la Roca de los Tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "Eso no parece muy fiable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "#Jejeje, ya sabía yo que un{F#a}{M#o}s foraster{F#a}{M#o}s como ustedes no se fiarían de mí. Pero nadie lo cree hasta que lo prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "Yo también me di cuenta por casualidad después de colocar algunos minerales al lado de la Roca de los Tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "Hablando de eso, ¡hagan una prueba! Se fiarán en cuanto lo intenten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "Justamente se ha tragado ya todas las piedras de alrededor, así que tiene que consumir piedras nuevas... Pero yo no puedo ir a buscarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "¿Eh? ¿Y eso por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "¡Claro que no puedo! ¡Tengo que quedarme aquí vigilando la Roca de los Tesoros! ¿Qué haría yo si le diera por hundirse en la tierra cuando yo no esté?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "Llevo mucho tiempo aquí vigilando... Ya se ha tragado todas las piedras que traje conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "P-podrían traerme piedras nuevas para que se las dé de comer. ¡Así tendrán la prueba que buscan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "Humm, suena a timo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#¿Qué hacemos, {NICKNAME}? ¿Quieres intentarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "Bueno, si solo son rocas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "Jeje, entonces tráiganme piedras... La Roca de los Tesoros hará brotar unas mejores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "¿En serio? Parece una estafa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "Yo también respiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "Eso, ¿qué tiene de especial respirar?... Humm, ¿por qué estamos hablando de eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
