					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "Humm, es cierto que ha generado piedras mejores. Aunque es la segunda vez que ocurre, Paimon sigue pensando que es muy extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910502,
					"content": "#Jejeje, cuántas sospechas tienen est{F#a}{M#o}s foraster{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Después de esto por fin lograrán comprender... el poder de la Roca de los Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Aaah, gracias a las piedras que han traído, el poder de la Roca de los Tesoros ha crecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "¿Quién sabe el poder que llegará a tener?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Sí, ahora que lo dices, Paimon también siente curiosidad por averiguarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Paimon se pregunta por qué con solo alimentarla con otras piedras, es capaz de generar unas mejores. Tal vez... ¿podríamos abrirla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910508,
					"content": "¿Qué... qué estás diciendo? ¡No pienso permitirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910509,
					"content": "Si... Si quieren abrir la Roca de los Tesoros, tendrán que pasar por encima de mi cadáver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910510,
					"content": "Eh... Solo era una idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910511,
					"content": "Humm, bueno, teniendo en cuenta que antes trajeron piedras para la Roca de los Tesoros... lo dejaré pasar esta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910512,
					"content": "E-está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910513,
					"content": "Ya... Jeje, ya puedo sentirlo. Si alimentamos a la Roca de los Tesoros con piedras de gran calidad, estoy seguro de que producirá algo increíble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910514,
					"content": "#Viajer{F#a}{M#o}s de tierras lejanas, una vez oí decir a un mercader extranjero que en el desierto existe una piedra brillante especial que esconde un poder impresionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910515,
					"content": "Se llamaba... Sí, se llamaba trishiraíta. S-si logran traerme esa piedra y se la entregamos a la Roca de los Tesoros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910516,
					"content": "Se-seguro que logrará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910517,
					"content": "#Eh, ¿tú qué piensas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910518,
					"content": "¡Vamos a probarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Sí, Paimon quiere saber qué ocurrirá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910520,
					"content": "S-si traen la trishiraíta... Con un pedazo bastaría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
