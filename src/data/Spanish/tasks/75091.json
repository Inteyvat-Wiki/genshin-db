			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "¡Guau! Paimon no esperaba que aparecieran de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910302,
					"content": "La Roca de los Tesoros es increíble... Un momento, no las habrás colocado tú encima, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910303,
					"content": "... Jejeje, ¿cómo haría algo tan estúpido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910304,
					"content": "Gracias a las piedras que le han entregado, la Roca de los Tesoros ha ganado más vitalidad. ¿No lo oyen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910305,
					"content": "Ese sonido parece el retumbar del magma bajo la tierra. Es como... Oh, como los latidos del corazón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910306,
					"content": "Sabía que lo que debía hacer era alimentarla con otras piedras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910307,
					"content": "Eh, Paimon no oye nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910308,
					"content": "#¿Tú lo oyes, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910309,
					"content": "A mí me parece una roca normal y corriente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "Sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910313,
					"content": "#Jeje, foraster{F#a}{M#o}s... Oh, distinguid{F#a}{M#o}s foraster{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910314,
					"content": "Busquen más piedras si pueden. Piedras mejores, más hermosas... Confíen en el poder de la Roca de los Tesoros, no les defraudará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910315,
					"content": "Puedo sentirlo... Puedo percibir que esto también es bueno para ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910316,
					"content": "Tengo el presentimiento de que estamos cayendo en una trampa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910317,
					"content": "#{NICKNAME}, ¿tú que crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910318,
					"content": "Si al final conseguimos mejores piedras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "Merecería la pena intentarlo, es cierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910320,
					"content": "Jeje, entonces entréguenme piedras aún mejores que la última vez... Con mejores piedras, estoy seguro de que el poder de la Roca de los Tesoros crecerá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910311,
					"content": "¡La Roca de los Tesoros está gritando! ¡Aaaaaah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "¡No es posible! ¡No intentes asustar de nuevo a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				}
