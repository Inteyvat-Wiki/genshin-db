					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910201,
					"content": "Humm... Deben tener paciencia. Cuando... cuando esté todo en calma, alimentaré a la Roca de los Tesoros con estas piedras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910202,
					"content": "Denle un poco más de tiempo, jeje... y generará mejores piedras, jeje... Una... Una, dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
