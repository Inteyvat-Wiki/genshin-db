				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "Creo que ya hicimos suficiente, y Amano y Andou nos ayudarán para que el ladrón de la ciudad lo sepa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "¿Cuántas veces más tendremos que hacer esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Ya queda muy poco. En cuanto la jefa esté lista, podremos poner fin a este caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "#Esta es tu recompensa por esta vez, viajer{F#a}{M#o}. Gracias por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "La jefa decidió la cantidad que pagarte. Creo que es suficiente. Acéptala, seguramente en el futuro volveremos a necesitarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
