			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪ Rosa, rosita del jardín, haz que mis deseos se cumplan al fin ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "¿Eh? ¿Siguen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "¿Por qué vive aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Jeje, al fin y al cabo soy un viejo loco y los viejos locos hacen cosas sin sentido. La gente no suele hacer preguntas si piensan que has perdido la cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "Siempre quise salir de la aldea y hacer algo con mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Incluso poco después de casarme me planteé la posibilidad de unirme a Los Eremitas, pero no podía dejar a mi esposa y largarme por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Una vez conocí a un comerciante ambulante y quise seguir sus pasos, pero no tenía Mora para hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Pasados los años, mi esposa falleció y ya nada me retenía aquí, pero era demasiado mayor para irme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "He esperado tanto tiempo que he perdido la oportunidad de hacer muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Al final me di cuenta de que no encajaba en la aldea, ni en ningún otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "Por eso me mudé a las afueras de la aldea. Aquí me siento mucho más a gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "Y así he pasado las últimas décadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "Me gustaría que las vieran cuando florezcan. Supongo que aún tardarán un día o dos. ¿Volverán a verme entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Claro que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Bien, muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪ Rosa, rosita del jardín, haz que mis deseos se cumplan al fin ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "Sobre el viejo fantasma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Solo la gente de fuera preguntaría por el viejo fantasma. Todos los niños de la aldea lo conocen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Cuando un niño se porta mal, sus padres lo asustan diciéndole: “¿Lo oyes? Es el viejo fantasma que viene a llevarte”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "Los niños no saben quién es el viejo fantasma, pero están acostumbrados a que la gente use su nombre para asustarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "Yo conocí al viejo fantasma cuando era pequeño. Es verdad que detestaba a los niños, pero no daba miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Por algún motivo la gente empezó a llamarlo viejo fantasma. Supongo que era la gente que le criticaba por la espalda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "¿No era tu amigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "A mí me gustaba jugar cerca de su jardín cuando era pequeño. Y él siempre me ahuyentaba con una azada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Seguro que pensaba que era otro mocoso malcriado. No creo que se acordara de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "Puede que él no supiera quién era yo, pero yo nunca me olvidé de él y su pequeño jardín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "Así que supongo que puedo considerarle un amigo, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Por eso quiero cultivar estas flores. Quiero recrear el jardín de mis recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320601,
