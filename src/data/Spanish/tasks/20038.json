			"dialogs": [
				{
					"id": 200380201,
					"content": "¿Has terminado de limpiar las Estatuas de Los Siete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380202
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380202,
					"content": "Todavía no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380203
					]
				},
				{
					"id": 200380203,
					"content": "Ya veo. Bueno, no hay prisa, tómate tu tiempo.",
