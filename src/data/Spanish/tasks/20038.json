				{
					"id": 200380301,
					"content": "¿Has terminado de limpiar las Estatuas de Los Siete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380302
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380303
					]
				},
				{
					"id": 200380303,
					"content": "¡Bendito seas! Que Barbatos te proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380304
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380304,
					"content": "Toma, es mi regalo para ti. Tal vez necesite de tu ayuda en el futuro.",
					"roleType": "TALK_ROLE_NPC",
