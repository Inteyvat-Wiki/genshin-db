			"dialogs": [
				{
					"id": 761140101,
					"content": "Esta vez hay que investigar el caso de... ¿un ermitaño de comportamiento extraño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "¿La gente ermitaña no es rarita de por sí? Cualquier cosa que haga alguien que ha decidido vivir recluido en las montañas puede resultar extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "Sí, pero todo cambio tiene una razón de ser, la cual puede ser tanto interna como externa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761140104,
					"content": "Además, el hecho de que haya desaparecido un comerciante ambulante es preocupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761140105,
					"content": "¿Eh? Pero es que esa zona es muy peligrosa, jefa... Todo el mundo sabe que por allí hay muchas posibilidades de que te asalten y te roben o de que te ataque algún monstruo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Pues, si todo el mundo lo sabe, el comerciante ambulante que suele pasar por ahí debería haber tenido un plan de contingencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761140107,
					"content": "En fin, debe de haber alguna razón por la que ese comerciante haya desaparecido de repente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, tendrás que ir personalmente a visitar a ese ermitaño de comportamiento extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761140109,
					"content": "Será un viaje largo, así que recuerda no desviarte del camino principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761140110,
					"content": "¡Entendido, jefa! Seguro que será pan comido, ¡yo me encargo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
