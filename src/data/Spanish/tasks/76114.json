			"dialogs": [
				{
					"id": 761140301,
					"content": "(¿Eh? ¿Qué es esto? Parece algo que no se ha terminado de quemar por completo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(Había oído que el Sr. Derwent acoge a aventureros heridos... Esto de aquí debe de ser un incidente reciente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Pero ¿por qué querría quemar esto?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
