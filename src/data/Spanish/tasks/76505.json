			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME} y Paimon, ¡qué coincidencia! Escuché que se iban a Nod Krai, ¡pero no esperaba toparme con ustedes tan pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "¡Varesa! ¿Qué haces aquí? ¡Paimon pensó que estaba teniendo alucinaciones! ¿Estás aquí de viaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Jeje, algo así. Vine a comprar maquinaria agrícola para el huerto de mi casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Mi papá me dijo que en Nod Krai hay herramientas buenísimas que permiten que las frutas crezcan superbién y me pueden ahorran esfuerzo. Así tengo más tiempo para dormir... ¡y entrenar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "Nada más llegar, me encontré con montañas de comida exquisita que nunca había visto en Natlan. Estos días, entre trabajo y trabajo, apenas he hecho otra cosa que comer y beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "Sin darme cuenta, ya casi es hora de volver. Aún no me quiero ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Así que tengo que aprovechar el tiempo que me queda para pasear bien a gusto, probar todo lo que no he comido y ver todo lo que no he visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#¿Y ustedes qué tal? Déjenme adivinar... ¿{F#nuestra heroína}{M#nuestro héroe} invencible {NICKNAME} está haciendo justicia por estas tierras nuevas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "Estamos dando vueltas para ver si hay algo que valga la pena capturar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "#Jeje, ¡l{F#as}{M#os} entiendo! Cuando llegas a una nueva nación, todo parece nuevo y maravilloso. ¡Dan ganas de capturar cada rincón con el Daguerrotipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "Ahora que lo dices... ¡Ay! ¡Debería haber tomado imágenes de todos los platos ricos que probé aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "Así, cuando regrese a Natlan, tal vez Atolli podría intentar recrear estos platos basándose en las imágenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "Podrías convertirte en una daguerrógrafa gastronómica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "¿En serio? Una daguerrógrafa gastronómica... ¡Suena genial! ¡Me la pasaría comiendo cosas ricas y sacando imágenes que dejen a todos con hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Antes de eso, ¿podría tomarte una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "¿Eh? ¿A mí? ¿De verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "¿M-mi pelo está bien? ¿No tengo salsa en la boca, verdad? ¡Ay, si hubiera sabido que nos veríamos hoy, me habría puesto los accesorios que compré en el mercado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "¡Estás perfecta tal y como estás!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "¡De acuerdo! E-entonces... ¡lo dejo en sus manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Quiero capturar tu sonrisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "¿Te parece si te tomo una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "Estamos buscando inspiración para tomar imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
