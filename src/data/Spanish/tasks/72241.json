			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410201,
					"content": "#Ah, {F#viajera}{M#viajero} de tierras foráneas, eres tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410202,
					"content": "Gracias a tu persona, mi alma se ha recompuesto y ahora soy capaz de recordarlo todo. Es increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410203,
					"content": "Quizás ya sabes que, en tiempos remotos, una gran oscuridad atormentaba el reino de Byakuya y que aquellos que vivían aquí tenían que enfrentarse a los temibles dragones de las profundidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410204,
					"content": "En aquel entonces, dirigí la construcción del Dainichi Mikoshi y así el reino de Byakuya se hizo con un ciclo de día y noche. Eso es justo lo que significa el nombre de “Byakuya”: día y noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410205,
					"content": "En el pasado, se dijo: “Ahora que se ha construido el Dainichi Mikoshi, aunque esta tierra se halle sumida en la noche infinita, al menos podremos distinguir el negro del blanco”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410206,
					"content": "Qué humillante que, antes de que los restos de mi alma se reunieran, ni siquiera pude recordar el día en el que la gente se aglomeró alrededor del Dainichi Mikoshi una vez construido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410207
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410207,
					"content": "Ese debería haber sido mi recuerdo más entrañable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410208,
					"content": "Es una pena que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410209
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410209,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410210,
					"content": "Tras la construcción del Dainichi Mikoshi, los dragones de las profundidades fueron derrotados porque no estaban acostumbrados a la luz. Así, el pueblo recuperó la paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410211
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410211,
					"content": "Pero justo cuando la paz volvió a reinar... Ah, el corazón humano es difícil de comprender. ¿Quién iba a imaginar que alimentarían una intención tan malvada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410212,
					"content": "#Oh, viajer{F#a}{M#o} procedente de otro mundo, estoy seguro de que sabes lo voraces que pueden llegar a ser los villanos por conseguir un mísero ápice de riquezas y poder... ¡Más de lo que jamás hubieran merecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410213
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410213,
					"content": "Utilizaron a la gente, hicieron que adorara al Dainichi Mikoshi y la hicieron caer en la estupidez de creer en un objeto superficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410214
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410214,
					"content": "Al final, incluso proclamaron el gobierno del Hijo del{RUBY#[D]Faetón} Sol sobre el reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410215
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410215,
					"content": "¿El Hijo del Sol?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410216
					]
				},
				{
					"id": 722410216,
					"content": "El mismo. Siempre debe haber un infante que sea elegido como Hijo del Sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410217
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410217,
					"content": "Por supuesto, un niño de esa edad nunca sería capaz de entender el mundo. No sería apropiado para gobernar. Solo servía como marioneta, manipulada por aquellos que controlaban sus hilos detrás del telón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410218
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410218,
					"content": "Yo me opuse a eso, pero el Hijo del Sol, que estaba bajo su control, me acusó de alta traición y me encerraron aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410219
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410219,
					"content": "Ah, el Hijo del Sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410220,
					"content": "¿Pero no se percataría algún día el Hijo del Sol de que lo estaban utilizando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410221,
					"content": "Y por eso mismo, ningún Hijo del Sol logró alcanzar la madurez. Al fin y al cabo, los adultos no son tan fáciles de manipular como los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410222
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410222,
					"content": "“El venerado Hijo del Sol, en el ritual de su nacimiento, cabalgará sobre Pegaso hacia el festín del sol”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410223,
						722410224
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410223,
					"content": "¿Quieres decir que...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				},
				{
					"id": 722410225,
					"content": "Sí. Llevaban a los Hijos del Sol al santuario que hay dentro del Dainichi Mikoshi, vestidos como quienes asisten alegremente a un rito de nacimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410226
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410226,
					"content": "Los objetos que aquí se esconden están relacionados con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410227
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410227,
					"content": "Esta es la Brida divina que demuestra que un niño es el Hijo del Sol. Yo la escondí aquí, pensando que algún día podría mostrársela al pueblo como advertencia... Pero supongo que un acto como ese no tiene sentido a día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410228
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410228,
					"content": "#Ah, {F#viajera}{M#viajero}... No fui capaz de proteger ni a esos niños ni a nuestra nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410229
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410229,
					"content": "Soy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410230
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410230,
					"content": "Aberaku, ¡el creador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410231
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410231,
					"content": "Organicé la construcción del Dainichi Mikoshi. Fui yo quien alzó un espejo brillante en mitad de la noche infinita y se creyó un genio por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410232
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410232,
					"content": "¡Y cuánto talento tenía! ¡Cuán habilidoso era!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410233
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410233,
					"content": "Soñaba con que el Dainichi Mikoshi fuera capaz de acabar con la oscuridad, pero no sabía que en realidad eran la avaricia y el deseo de los corazones humanos los que constituían la noche infinita que todo lo devoraba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410234
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410234,
					"content": "#{F#Forastera}{M#Forastero} de tierras remotas, dejaré a partir de ahora la Brida divina en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410235
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410235,
					"content": "Esta Brida divina es el testimonio de nuestra ridícula historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410236
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410236,
					"content": "Guárdala bien... Bueno, no, haz lo que quieras con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410237
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410237,
					"content": "Es demasiado valiosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410238
					]
				},
				{
					"id": 722410238,
					"content": "¡Ja! No, su valor quedó reducido a la insignificancia. Que haya recuperado mi integridad y sea capaz de entregártela no puede ser otra cosa que el destino. Y, por eso mismo, debe considerarse como un final digno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410239
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410239,
					"content": "Ah... Cuánto talento... Cuánta destreza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410224,
					"content": "Entonces, en uno de sus cumpleaños...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				}
			]
		},
		{
			"id": 7224103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410301,
					"content": "Por favor, completa las ofrendas en el Desfiladero, el Templo de la Noche Infinita y el Corazón de la Serpiente. Así, mi alma se reunificará y podré ayudarles a abrir el acceso al Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				}
			]
		},
		{
			"id": 7224104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410401,
					"content": "Ya hicimos las ofrendas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410402,
					"content": "El señor espíritu dijo que las ofrendas podrían abrir el camino de acceso al Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410403,
					"content": "#¡Vayamos a echar un vistazo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
