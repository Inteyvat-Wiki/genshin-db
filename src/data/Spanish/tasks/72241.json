			]
		},
		{
			"id": 7224106,
			"completionStepIds": [
				7224108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224108",
							"2"
						],
						"stepId": 7224108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "Soy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410602,
					"content": "Aberaku, ¡el creador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410603,
					"content": "Y... humm, ¿Paimon es Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410604,
					"content": "¿Estamos presentándonos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "Bueno, ya que empezó él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410606,
					"content": "Paimon supone que es por cortesía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410607,
					"content": "No tiene importancia. De hecho, soy yo quien les faltó al respeto. Viniendo de un lugar tan lejano, no debí haberles recibido en este estado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410608,
					"content": "#No es nada, no nos importó. ¿Cierto, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410613,
					"content": "Pero ¿qué hace alguien como tú en un lugar como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410614,
					"content": "Yo... soy el creador de Helios, y este lugar es... donde descansaré el resto de la eternidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410615,
					"content": "Me dormí en un lugar oscuro y frío para no despertar más... ¿Cómo pude morir así? Yo, ¡el creador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410616,
					"content": "¿El creador de Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410617,
					"content": "¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410618,
					"content": "Ah, claro... Helios es como llamo a mi creación en privado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410619,
					"content": "Quizás ustedes lo desconozcan, pero la gente del reino de Byakuya lo llama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410620,
					"content": "Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410621,
					"content": "Helios es el Dainichi Mikoshi, el carro del sol que transporta a Hipe{RUBY#[S]la luz de Byakuya}rión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410622,
					"content": "¿Entonces eres el creador del Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "Así es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410625,
					"content": "#Oh, {F#forastera}{M#forastero}. Me pusieron bajo arresto domiciliario y me encarcelaron por haberlo creado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410626,
					"content": "Después de mi muerte, mi alma se esparció por el reino de Byakuya y muchos de mis recuerdos se perdieron en esa dispersión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410627,
					"content": "Recuerdo que había algo muy importante... algo muy importante en lo alto del Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410628,
					"content": "Pero no recuerdo qué era. Oh, viandante de tierras recónditas... ¿Podrías ayudarme a recuperar mis ropas, mi corona y mis huesos que se colocaron en tres lugares diferentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410629,
					"content": "Se encuentran en el Desfiladero, en el Templo de la Noche Infinita y en el Corazón de la Serpiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410630,
					"content": "#Ofrécelos en los tres altares y mi alma conseguirá reunificarse... Y así, podré ayudarl{F#as}{M#os} a abrir el acceso al Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410631,
					"content": "Entonces podrán adentrarse en el Dainichi Mikoshi, en los espacios cerrados y escondidos por el velo de la noche infinita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410623,
					"content": "¿Y tú eres quien lo creó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "Somos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "#... Ya veo. Así que son {F#unas viajeras}{M#unos viajeros} que proceden de tierras lejanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410611,
					"content": "#Lo único que lamento es haberl{F#as}{M#os} recibido en tan mal estado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410612,
					"content": "¡Eso no es un problema para Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224112",
							"2"
						],
						"stepId": 7224112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410701,
					"content": "Por favor, completa las ofrendas en el Desfiladero, el Templo de la Noche Infinita y el Corazón de la Serpiente. Así, mi alma se reunificará y podré ayudarles a abrir el acceso al Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				}
			]
		},
		{
			"id": 7224108,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410801,
					"content": "#Ah, {F#viajera}{M#viajero} de tierras foráneas, eres tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410802
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410802,
					"content": "Gracias a tu persona, mi alma se ha recompuesto y ahora soy capaz de recordarlo todo. Es increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410803
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410803,
					"content": "Quizás ya sabes que, en tiempos remotos, una gran oscuridad atormentaba el reino de Byakuya y que aquellos que vivían aquí tenían que enfrentarse a los temibles dragones de las profundidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410804
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410804,
					"content": "En aquel entonces, dirigí la construcción del Dainichi Mikoshi y así el reino de Byakuya se hizo con un ciclo de día y noche. Eso es justo lo que significa el nombre de “Byakuya”: día y noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410805
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410805,
					"content": "En el pasado, se dijo: “Ahora que se ha construido el Dainichi Mikoshi, aunque esta tierra se halle sumida en la noche infinita, al menos podremos distinguir el negro del blanco”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410806
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410806,
					"content": "Qué humillante que, antes de que los restos de mi alma se reunieran, ni siquiera pude recordar el día en el que la gente se aglomeró alrededor del Dainichi Mikoshi una vez construido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410807
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410807,
					"content": "Ese debería haber sido mi recuerdo más entrañable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410808
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410808,
					"content": "Es una pena que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410809
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410809,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410810,
					"content": "Tras la construcción del Dainichi Mikoshi, los dragones de las profundidades fueron derrotados porque no estaban acostumbrados a la luz. Así, el pueblo recuperó la paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410811
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410811,
					"content": "Pero justo cuando la paz volvió a reinar... Ah, el corazón humano es difícil de comprender. ¿Quién iba a imaginar que alimentarían una intención tan malvada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410812
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410812,
					"content": "#Oh, viajer{F#a}{M#o} procedente de otro mundo, estoy seguro de que sabes lo voraces que pueden llegar a ser los villanos por conseguir un mísero ápice de riquezas y poder... ¡Más de lo que jamás hubieran merecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410813
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410813,
					"content": "Utilizaron a la gente, hicieron que adorara al Dainichi Mikoshi y la hicieron caer en la estupidez de creer en un objeto superficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410814
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410814,
					"content": "Al final, incluso proclamaron el gobierno del Hijo del{RUBY#[D]Faetón} Sol sobre el reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410815
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410815,
					"content": "¿El Hijo del Sol?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410816
					]
				},
				{
					"id": 722410816,
					"content": "El mismo. Siempre debe haber un infante que sea elegido como Hijo del Sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410817
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410817,
					"content": "Por supuesto, un niño de esa edad nunca sería capaz de entender el mundo. No sería apropiado para gobernar. Solo servía como marioneta, manipulada por aquellos que controlaban sus hilos detrás del telón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410818
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410818,
					"content": "Yo me opuse a eso, pero el Hijo del Sol, que estaba bajo su control, me acusó de alta traición y me encerraron aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410819
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410819,
					"content": "Ah, el Hijo del Sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410820,
					"content": "¿Pero no se percataría algún día el Hijo del Sol de que lo estaban utilizando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410821,
					"content": "Y por eso mismo, ningún Hijo del Sol logró alcanzar la madurez. Al fin y al cabo, los adultos no son tan fáciles de manipular como los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410822
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410822,
					"content": "“El venerado Hijo del Sol, en el ritual de su nacimiento, cabalgará sobre Pegaso hacia el festín del sol”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410823,
						722410824
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410823,
					"content": "¿Quieres decir que...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				},
				{
					"id": 722410825,
					"content": "Sí. Llevaban a los Hijos del Sol al santuario que hay dentro del Dainichi Mikoshi, vestidos como quienes asisten alegremente a un rito de nacimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410826
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410826,
					"content": "Los objetos que aquí se esconden están relacionados con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410827
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410827,
					"content": "Esta es la Brida divina que demuestra que un niño es el Hijo del Sol. Yo la escondí aquí, pensando que algún día podría mostrársela al pueblo como advertencia... Pero supongo que un acto como ese no tiene sentido a día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410828
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410828,
					"content": "#Ah, {F#viajera}{M#viajero}... No fui capaz de proteger ni a esos niños ni a nuestra nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410829
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410829,
					"content": "Soy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410830
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410830,
					"content": "Aberaku, ¡el creador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410831
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410831,
					"content": "Organicé la construcción del Dainichi Mikoshi. Fui yo quien alzó un espejo brillante en mitad de la noche infinita y se creyó un genio por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410832
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410832,
					"content": "¡Y cuánto talento tenía! ¡Cuán habilidoso era!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410833
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410833,
					"content": "Soñaba con que el Dainichi Mikoshi fuera capaz de acabar con la oscuridad, pero no sabía que en realidad eran la avaricia y el deseo de los corazones humanos los que constituían la noche infinita que todo lo devoraba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410834
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410834,
					"content": "#{F#Forastera}{M#Forastero} de tierras remotas, dejaré a partir de ahora la Brida divina en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410835
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410835,
					"content": "Esta Brida divina es el testimonio de nuestra ridícula historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410836
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410836,
					"content": "Guárdala bien... Bueno, no, haz lo que quieras con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410837
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410837,
					"content": "Es demasiado valiosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410838
					]
				},
				{
					"id": 722410838,
					"content": "¡Ja! No, su valor quedó reducido a la insignificancia. Que haya recuperado mi integridad y sea capaz de entregártela no puede ser otra cosa que el destino. Y, por eso mismo, debe considerarse como un final digno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410839
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410839,
					"content": "Ah... Cuánto talento... Cuánta destreza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410824,
					"content": "Entonces, en uno de sus cumpleaños...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				}
			]
		},
