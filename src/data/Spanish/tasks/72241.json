				},
				{
					"id": 722410502,
					"content": "El señor espíritu dijo que las ofrendas podrían abrir el camino de acceso al Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410503
					],
