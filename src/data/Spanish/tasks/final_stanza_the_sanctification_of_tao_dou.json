					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "La crisis se ha resuelto, pero ¿por qué seguís con esa cara tan larga, Equilibrio Celestial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870502,
					"content": "#Hemos logrado resolver el asunto gracias a la directora Hu Tao y a {NICKNAME}, pero seguimos sin conocer las causas del problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401870503,
					"content": "Capitana, tú siempre tienes información de primera, así que debes saber que en Natlan también ha ocurrido un incidente similar con las líneas ley y lo relacionado con los vivos y los muertos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401870504,
					"content": "Estaba pensando... ¿Podría haber alguna relación oculta entre ambos eventos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401870505,
					"content": "De ser así, no puede haber sucedido solamente en Liyue y Natlan. Le pediré a mis socios que estén atentos a rumores similares provenientes de otras naciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870506,
					"content": "Pero, por ahora, os recomiendo que os centréis en disfrutar de las fiestas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870507,
					"content": "Jeje, tienes razón. ¿Tanto me parezco a Keching, que no sabe desconectar del trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401870508,
					"content": "¿Y qué hacéis aún con esa vieja horquilla? ¿No os dije que usarais mi remuneración para compraros una nueva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870509,
					"content": "Necesitaba que me lo confirmaras otra vez antes de tocar tu dinero. A lo mejor solo estabas de broma y luego pensabas echármelo en cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401870510,
					"content": "Jajajaja, ay, mujer... ¿Es que queréis que os elija yo la horquilla? Está bien, vamos, os acompañaré a los puestos de la feria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870511,
					"content": "Ay, ¿desde cuándo te has vuelto tan buena leyéndome la mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401870512,
					"content": "Jaja, no entremos en eso ahora. ¿Venís o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870513,
					"content": "¿Por qué no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				}
			]
		},
