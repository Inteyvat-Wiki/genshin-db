						],
						"stepId": 4018708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xianyun"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1145.934,
							349.309,
							1570.267
						],
						"pointId": 10625
					}
				]
			},
			"dialogs": [
				{
					"id": 401870701,
					"content": "La muchacha de la Funeraria El Camino es realmente impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870702,
					"content": "El hecho de que Rex Lapis decidiera trabajar en tal lugar como asesor despertó mi interés por ella, pero solo ahora he acabado de entender el porqué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870703,
					"content": "En todo caso, es toda una novedad escuchar tal elogio de tu parte, Preservadora de Nubes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 401870704,
					"content": "¿Cómo que una novedad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870705,
					"content": "En el pasado, habrías dicho algo como: “Esa muchacha tiene cierto talento, sí, pero nada que nuestras Shenhe y Ganyu no fueran capaces de hacer en las mismas circunstancias”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "Moldeador de Montañas"
				},
				{
					"id": 401870706,
					"content": "¡Hum! ¿Acaso me tomas por alguien tan altiva? Si la muchacha ha demostrado una gran virtud, ¿por qué no iba a merecer mis elogios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870707,
					"content": "Jejeje, por supuesto que los merece. Llevo viviendo un largo tiempo en la ciudad de Liyue y conozco bien la Funeraria El Camino. Sus directores han demostrado una gran heroicidad generación tras generación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 401870708,
					"content": "Caminante Errante tiene razón. El dios Tao Dou de antaño no era amigo ni enemigo mío, pero... si no sintiera gran predilección por todos los seres vivos y no se hubiera ofrecido para la purificación que apaciguó al más allá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 401870709,
					"content": "Ni siquiera ocho Adeptus, y muchos menos los Ocho Adeptos, habrían tenido nada que hacer. Cuando se convirtió en la frontera, seguramente no llegó a pensar que los mortales podrían preservarla hasta el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 401870710,
					"content": "Volviendo al tema, admito que aún no conozco siquiera el nombre de esa muchacha de la Funeraria El Camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "Moldeador de Montañas"
				},
				{
					"id": 401870711,
					"content": "La directora se llama Hu Tao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870712,
					"content": "Hu... ¿Como “mariposa” en nuestra lengua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 401870713,
					"content": "No, como “traviesa empedernida”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870714,
					"content": "Entonces, “Tao” debe venir también de “travesura”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 401870715,
					"content": "En realidad, es el mismo “Tao” que el de “Tao Dou”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870716,
					"content": "Oh, entonces “Hu” de “mariposa” y “Tao” de Tao Dou. Es un buen nombre, no cabe duda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "Moldeador de Montañas"
				},
				{
					"id": 401870717,
					"content": "No, ¡es el “Hu” de “traviesa empedernida”, el de “atosigadora incansable” y el de “glotona sin fondo”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870718,
					"content": "Solo intentaba animar el ambiente un poco. ¿Qué pasa? ¿Ella sí puede ser traviesa y yo no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "Moldeador de Montañas"
				},
				{
					"id": 401870719,
					"content": "Oh, ¿acaso has cambiado de nombre? ¿Ahora eres Moldeador de Travesuras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870720,
					"content": "Jeje, dejemos esto y tomemos una taza de té. Estos son brotes espirituales traídos por Rex Lapis de Chingtsé, una variedad bien inusual. No podemos dejar pasar esta oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 401870721,
					"content": "Espero que el año que viene también podamos beber juntos un buen té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 401870722,
					"content": "Lo haremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
