				]
			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "#Aquel día, deberías haber acompañado a {NICKNAME} a la frontera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870402,
					"content": "#Sé que estabas preocupado, Gran Cazador de Demonios, pero si surgía algún problema del que {NICKNAME} no pudiera ocuparse, yo no sería más que un estorbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870403,
					"content": "Además, Ninguang cambió de planes y me envió a la Sima. No puedo estar en dos sitios al mismo tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870404,
					"content": "Si no estás satisfecho con la decisión, te recomiendo ir a la Terraza Yujing uno de estos días y dejar una queja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870405,
					"content": "Ja, ¿quejarme al Equilibrio Celestial de su desequilibrio celestial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870406,
					"content": "Estaba pensando... El Equilibrio Terrenal no le teme a la confrontación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870407,
					"content": "Da igual, al final todos están a salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870408,
					"content": "Qué buen sitio es la Posada Wangshu, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870409,
					"content": "Toda Liyue lo es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870410,
					"content": "Jaja, tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870411,
					"content": "Jefe, otra de camarones en rocío con salsa picante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870413,
					"content": "Y un plato de tofu de almendras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
