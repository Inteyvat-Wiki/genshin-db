			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-655,
							221,
							243
						],
						"pointId": 10621
					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#¡Eh! ¡{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870102,
					"content": "¡Xiangling! ¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870103,
					"content": "#Jaja, ¿qué va a ocurrir? ¡Pues que tenemos que comer junt{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870104,
					"content": "¿Al fin vamos a comer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "¡Sí! Ya tienen tiempo libre, ¿verdad? No pueden seguir posponiéndolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870106,
					"content": "#¡La que nunca tiene tiempo es Hu Tao, no nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870107,
					"content": "¡Cree que solo por ser la directora de la funeraria ya puede hacer lo que quiera! Es como si solo se dignara a vernos si estamos todos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870108,
					"content": "Pero no se preocupen, esta vez acordamos que no aceptaríamos más excusas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870109,
					"content": "#Oh, ¿hablas de alguien más aparte de nosotr{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870110,
					"content": "#Jeje, sí, de Xingchiu. Tenía muchas ganas de reunirse con nosotr{F#a}{M#o}s para comer, pero con todo el asunto de su bisabuelo, no había podido hacerlo antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870111,
					"content": "Su bisabuelo despertó de repente la noche del Rito de la Linterna. No pueden imaginar lo contento que se puso... Bueno, la cosa es que por fin quedó libre, así que nos vimos enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870112,
					"content": "¡Vaya! ¿El señor se encuentra bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870113,
					"content": "Sí, el médico fue a visitarlo y está fresco como una rosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870114,
					"content": "Xingchiu me dijo que su bisabuelo no ha parado de comer desde que despertó. Tiene un apetito insaciable, como Paimon. Su familia está empezando a preocuparse, pues no quieren que vuelva a enfermar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870115,
					"content": "¿Por qué lo dices como si parecerse a Paimon no fuera algo bueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870116,
					"content": "Claro que es bueno, tu apetito representa la actitud optimista con la que te tomas la vida: “¡Entreguémonos a yantar mientras podamos, y no dejemos vacío el cuenco dorado frente a la luna!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870117,
					"content": "¡Cuánta razón tienes, Xiangling! ¡Si Paimon ha llegado hasta donde está hoy es precisamente gracias a esa filosofía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870118,
					"content": "¿En serio? Yo no lo tengo tan claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "¡Que sí, que sí! ¡Entreguémonos a yantar mientras podamos, y no...! ¿Cómo seguía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870120,
					"content": "Jaja, Paimon, guárdate esa filosofía para la mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870121,
					"content": "Jeje, ¡sin problema! Entonces, ¿a dónde vamos a comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870122,
					"content": "Al Puerto Yilong esta noche. Xingchiu y los demás siguen allí. Por cierto, Hu Tao dijo que habría una invitada muy especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870123,
					"content": "¿Quién?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "Lo sabrán esta noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870125,
					"content": "¡Ah! Paimon cree que puede adivinar quién es. Jeje, pero no piensa decirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870126,
					"content": "Yo también lo he adivinado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "¿Eh? ¿Quién crees que es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870128,
					"content": "No te lo voy a decir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "Humm, ¡pues ya veremos esta noche quién acierta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4018703,
