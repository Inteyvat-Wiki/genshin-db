			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yun Jin"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.683,
							343.151,
							2388.574
						],
						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "Si tuviera que decir quién era el más fuerte, me decantaría por Descifravientos. Al fin y al cabo, él fue el fundador de la adivinación Chimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870302,
					"content": "¡Sí! Yo también voto por mi antecesor. ¡Y también por Alargéntea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870303,
					"content": "Entonces, yo elijo a los Dos Sabios de Lianshan. Los que viven una vida solitaria siempre terminan siendo los más fuertes. Bueno, al menos así es en las novelas, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870304,
					"content": "Si se tratara de una novela de artes marciales, yo también tomaría la misma decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 401870305,
					"content": "Pero, por desgracia, he leído «El bosque de bambú a la luz de la luna», así que pienso que la más poderosa era la Yegua Blanca de los Tres Inmortales de Tao Dou. Seguro que guarda algún secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 401870306,
					"content": "¿Eh? ¿Nadie elige al Pescador Yunlai? Incluso el Equilibrio Terrenal dice que su estilo con la espada procede de las técnicas con la caña de pescar del Pescador Yunlai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870307,
					"content": "Es cierto... pero no es un personaje que resulte muy vistoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870308,
					"content": "Humm... Pero no es raro que un pescador sea mucho más de lo que aparenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 401870309,
					"content": "¡Je, todos ustedes se equivocan! Está claro que los más poderosos eran el Viejo Wuwang y la Mariposa Solitaria. Si no fuera por ellos, hoy no existiría la Funeraria El Camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870310,
					"content": "Eso es verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870311,
					"content": "¡Vaya, ya están todos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870312,
					"content": "#Por fin llegan, {NICKNAME} y Paimon. ¡Bienvenid{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870313,
					"content": "¡Guau! ¡Hu Tao, tu sombrero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870314,
					"content": "Qué perspicaz eres, Paimon. Sí, le he puesto otra ramita de ciruelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870315,
					"content": "#Oh... Así, tú y {NICKNAME} van a juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870316,
					"content": "Pero volviendo al tema, ¿qué están haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870317,
					"content": "Estábamos discutiendo sobre cuál de los Ocho Adeptos era el más fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870318,
					"content": "Jajaja, pero cada uno tiene a su preferido, así que nunca llegaremos a una conclusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870319,
					"content": "Sí, a no ser que tuviéramos esos lentes de las novelas ligeras con los que puede verse el poder de cada uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870320,
					"content": "Jaja, ¿es que Xingchiu te ha enganchado a las novelas ligeras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870321,
					"content": "#Bienvenid{F#a}{M#o}, {NICKNAME}. Dicen que Hu Tao y tú lograron completar un peligroso ritual y que, gracias a eso, mi bisabuelo ha recuperado la salud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 401870322,
					"content": "No tengo palabras para expresar mi agradecimiento. A partir de hoy, el Gremio de Comerciantes de Feiyun estará a su disposición para cualquier problema que tengan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 401870323,
					"content": "Los demás también pusieron de su parte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "Sí, lo sé. Mi padre y mi hermano les harán una visita a todos y cada uno de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "Xingchiu"
				},
				{
					"id": 401870325,
					"content": "No ha sido nada, Xingchiu. Pero si quieres darme las gracias, puedes admitir que los más poderosos eran el Viejo Wuwang y la Mariposa Solitaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870326,
					"content": "¡Ay, déjense de ese debate sin fin! Ahora que estamos todos aquí, podemos empezar a comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870327,
					"content": "Vamos, Paimon, ha llegado el momento de que nos demuestres tu filosofía de vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870328,
					"content": "¿C-cómo? Eh... Dejen que Paimon lo recuerde... Era algo así como... ¡Entreguémonos a yantar mientras podamos, y no...! ¿Y no qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870329,
					"content": "Y no dejemos vacío el cuenco dorado frente a la luna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "Ah, sí, eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870331,
					"content": "Vaya, Paimon, ¿ni siquiera eres capaz de recitar uno tus propios principios vitales? Tienes que tener cuidado con eso, o te traerá mala suerte y obstáculos en la vida. ¡Ánimo, dilo una vez más, que tú puedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870332,
					"content": "¡Entreguémonos a yantar mientras podamos, y no dejemos vacío el cuenco dorado frente a la luna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870333,
					"content": "¡Así, sí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "Jeje, bueno, ¿empezamos ya a comer o qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870335,
					"content": "¿Has olvidado ya a nuestra invitada especial, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870336,
					"content": "¡Oh, es cierto! Paimon ya lo recuerda. En realidad, Paimon ya había adivinado antes de quién se trata, pero no va a decirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870337,
					"content": "¿Eh? No pareces muy convencida, Paimon. Eso es que no tienes ni idea, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870338,
					"content": "#¡Ay, Paimon sí que lo sabe! Es... ¡Ayuda a Paimon, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870339,
					"content": "Es Yun Jin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "¡Exacto! Es nuestra querida Yun Jin. Parece que tú tampoco has olvidado lo que dijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870341,
					"content": "Miren, Yun Jin se ha subido al escenario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870342,
					"content": "¡Guau! ¿No es esa la directora de la Compañía de Ópera Yun-Han?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "Lixing"
				},
				{
					"id": 401870343,
					"content": "¡Qué afortunados somos! ¿Quién iba a decirnos que la maestra Yun vendría al Puerto Yilong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "Jiewu"
				},
				{
					"id": 401870344,
					"content": "Saludos a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870345,
					"content": "Esta noche volveré a cantar la «Purificación del Tao Dou» para todos aquellos que no pudieron asistir a la celebración del Rito de la Linterna. Siento que el escenario no sea tan impactante como el de aquella noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870346,
					"content": "¡Guau, Yun Jin va a cantar para todos los que se perdieron su actuación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870347,
					"content": "¡Shhh! Que ya va a empezar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870356,
					"content": "Piensa en las incoherencias sobre el Tao Dou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870348,
					"content": "Entre notas discordantes y trágicos destinos, que las almas de los dos mundos oigan mi llamado genuino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870349,
					"content": "Qué delirante debe ser, con huesos y sangre la llama encender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870350,
					"content": "Las sombras de la guerra se irán desvaneciendo, mas los relatos de la salvación sobrevivirán al paso del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870351,
					"content": "Los pecados se pagan cuando la sangre es derramada, y ante las reglas de la vida y la muerte no se puede hacer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870352,
					"content": "Las leyes celestiales siempre son certeras, mas los deseos egoístas a la ruina llevan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870353,
					"content": "Tras prometer que derrotarían al mal, los Ocho Adeptos decidieron al Tao Dou atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870354,
					"content": "Aunque el cuerpo y el alma estén deteriorados, los sueños perdurarán a lo largo de los años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870355,
					"content": "Para formar un nuevo nido las golondrinas retornarán, y las lágrimas y las ramas ese día conmemorarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yun Jin"
				}
			]
		},
