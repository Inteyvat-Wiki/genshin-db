			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Príncipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "#¡Miau! (¡Miauravilloso! ¡Felicidades! Has superado el duelo de ascensión. ¡Ahora eres {F#una invocadora experta}{M#un invocador experto}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706670202,
					"content": "(Ahora podrás desafiar a más jugadores aún. Por cierto, ya podías hacerlo antes, pero me gustaría recordarte que tienes derecho a publicar duelos en el tablón de invitaciones.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706670203,
					"content": "Miau... (Así, todo el que quiera enfrentarse a ti, podrá hacerlo. Un duelo contra un oponente totalmente desconocido siempre resulta de lo más emocionante, ¿no crees?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706670204,
					"content": "(Después de todo, un duelo también es una buena excusa para pasar tiempo juntos, ¿no te parece?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706680204,
					"content": "#¡Miau! (Oh, miau, me fui tras un gato. A lo que íbamos. Ahora eres {F#una invocadora experta}{M#un invocador experto}, {NICKNAME}. Lo que significa que te has ganado el derecho a comprar algunas cartas de aspecto increíble.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706670205,
					"content": "#(No olvides por qué empezaste a jugar a Invocación de los Sabios, {NICKNAME}, y ¡que la juerga te acompañe!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Príncipe"
				}
			]
		},
