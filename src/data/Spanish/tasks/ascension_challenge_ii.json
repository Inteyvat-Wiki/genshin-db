			"dialogs": [
				{
					"id": 706660101,
					"content": "¡Vine a participar en el duelo de ascensión!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#Miau... (¿Humm? ¿Así que vienes para participar en el duelo de ascensión? Veamos... Veo que cumples con los requisitos, {NICKNAME}. Muy bien...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "Príncipe"
				},
				{
					"id": 706660103,
					"content": "(Le diré a Shuyun que prepare el duelo para ti. Ve con cuidado...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Príncipe"
				}
			]
		},
		{
			"id": 7066702,
			"completionStepIds": [
				7066703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
