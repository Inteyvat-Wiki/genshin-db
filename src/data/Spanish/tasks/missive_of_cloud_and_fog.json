				"points": []
			},
			"dialogs": [
				{
					"id": 414111501,
					"content": "Venti debe haber llegado ya. ¡Entremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111502,
					"content": "#¡Deténganse! Ciudadan{F#a}{M#o}s, ¿qué noble empresa l{F#as}{M#os} trae aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111503
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111503,
					"content": "¿Está Kaeya? Tenemos que verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111504,
					"content": "¿El Capitán Kaeya? Está de servicio en la oficina de la Gran Maestra Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111505
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111505,
					"content": "¿Eh? ¿Por qué está en la oficina de Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111506,
					"content": "Somos los Caballeros de Favonius quienes organizamos la celebración del Festival de las Flores de Viento. Durante el festival, la Maestra Jean sale a patrullar personalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111507
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111507,
					"content": "El Capitán Kaeya se hace cargo de las tareas administrativas durante este tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111508
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111508,
					"content": "¿En serio?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
