			},
			"dialogs": [
				{
					"id": 414111001,
					"content": "¡Hermana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111002
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111002,
					"content": "¡Quieta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111003
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111003,
					"content": "¡Rosaria! Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111004
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111004,
					"content": "Cálmate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111005
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111005,
					"content": "Acabo de ver a Jean. Estaba con Lisa. No le pasa nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111006
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111006,
					"content": "¡Ah! ¿De verdad? ¿Estás segura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111007
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111007,
					"content": "¡Uf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111008
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111008,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111009
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111009,
					"content": "La carta. Dámela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111010
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111010,
					"content": "Aquí está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111011
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111011,
					"content": "Si la carta no se refiere a Jean... ¿qué puede ser entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111012
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111012,
					"content": "¿De veras crees que enterrarían a Jean? ¡Qué horror!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111013,
					"content": "Hermana, ¿tiene alguna pista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111014
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111014,
					"content": "Según el mapa, la zona marcada parece estar cerca del Viñedo del Amanecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111015
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111015,
					"content": "Esa área es campo abierto, así que enterrar algo allí... Humm, ¿qué podría ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111016
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111016,
					"content": "¡Guau! ¡Te diste cuenta con solo un vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111017,
					"content": "Pero... ¿El Viñedo del Amanecer? Ese no es el lugar que teníamos en mente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111018,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111019
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111019,
					"content": "Bárbara, en vez de dejar que tu imaginación te torture, deberías armarte de valor y enfrentarte a este problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111020
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111020,
					"content": "Sí, tienes razón. Es solo que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111021
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111021,
					"content": "Jeje, ¿tienes miedo? ¡Por eso vamos a ir contigo! ¿Qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111022,
					"content": "¿Eh? Son muy amables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111023
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111023,
					"content": "¿Y usted, hermana? ¿Viene con nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111024,
					"content": "No... Es obvio que no es nada grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111025
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111025,
					"content": "¿Eh? ¿Qué quiere decir eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111026,
					"content": "Nada. Vayan ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111027
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111027,
					"content": "Bárbara, ¿te encuentras mejor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111028
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111028,
					"content": "¡Sí! Estoy... estoy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111029
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111029,
					"content": "Rosaria tiene razón. En lugar de quedarme asustada, es mejor aprender las tácticas del enemigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111030
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111030,
					"content": "¡Eso es! ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111031,
					"content": "Muchas gracias a todos. Vayamos a la ubicación a ver qué encontramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111032
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111032,
					"content": "¡Vamos, Bárbara! ¡Ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141113,
			"completionStepIds": [
				4141113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141113",
							"2"
						],
						"stepId": 4141113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bárbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111302,
					"content": "¿Qué es esto? ¡Rápido, abrámoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111303,
					"content": "Yo... yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111304,
					"content": "Interesante... una caja tan exquisita. ¿Qué estará haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111305,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414111306,
					"content": "¡Oh, es una hermosa guirnalda de margaritas voladoras! ¡Y muchas estrellas de papel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111307,
					"content": "¿Es una broma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "Parece que el “culpable” es simplemente uno de los admiradores de Bárbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111310,
					"content": "¡Hay una nota! ¿Qué pone? Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111311,
					"content": "“Lamento tener que llamar tu atención de esta forma. Por favor, acepta esta flor de viento como prueba de mi sincera admiración por tu virtud y tu dulzura”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111312,
					"content": "¿Eh? ¿Entonces la intimidación era mentira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111313,
					"content": "Ya sea para los dioses o para alguien especial, las flores deben ofrecerse con sinceridad. Es la ceremonia más importante del Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111314,
					"content": "Flores de amor y bendiciones, enviadas en una ocasión tan especial... Hay que hacer todos los esfuerzos posibles para que sea espectacular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111315,
					"content": "Si dejamos a un lado la metodología tan cuestionable, aquí tenemos un regalo muy considerado y sincero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111316,
					"content": "¿Eh? Eso es ridículo... A Paimon le parece que es cosa de alguien a quien le falta un tornillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111317,
					"content": "Jajaja, tal vez tengas razón. Creo que tengo un sospechoso que encaja con esa descripción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111318,
					"content": "¿Sí? ¿Quién?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111319,
					"content": "(Creo que yo también sé quién es.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "¡Shh! No lo digas aún. A ver si Paimon lo adivina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111321,
					"content": "¿Eh? ¡Eres tan molesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111308,
					"content": "¿Es una forma de llamar tu atención?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
			"id": 4141114,
			"completionStepIds": [
				4141114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141114",
							"2"
						],
						"stepId": 4141114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "*Suspira*... No sé qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111402,
					"content": "#¿Eres Nimrod? Kaeya nos dijo que lo necesitabas para algo, pero él no puede venir en estos momentos. ¡Nosotr{F#a}{M#o}s te ayudaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111403,
					"content": "#¿Eh? Oh, viajer{F#a}{M#o}, no me di cuenta que eras tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111404,
					"content": "Resulta que quiero regalarle algo a mi esposa por el Festival de las Flores de Viento, pero no se me ocurre ninguna idea y quería pedirle su opinión a Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111405,
					"content": "Ay... me temo que bebo demasiado. Siempre estoy en la taberna y a mi mujer no le gusta nada, así que siempre estamos discutiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111406,
					"content": "Es decir, que eres un borracho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111407,
					"content": "¡Yo te entiendo, no me importa beber un trago o dos! En fin, no soy quién para juzgar, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111408,
					"content": "Ya lo sé, y mi esposa tiene razón. Por eso quiero compensarla de alguna manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111409,
					"content": "#Viajer{F#a}{M#o}, ¿podrían ayudarme a reunir algunos materiales? Quiero hacer el regalo con mis propias manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111410,
					"content": "Tendría que haberlo hecho ya, pero apenas he podido mantenerme sobrio estos últimos días. Luego me quedé dormido y, cuando desperté... ¡el festival ya había comenzado! Si tengo que hacerlo todo yo solo, no acabaré nunca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111411,
					"content": "Este tipo es un desastre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111412,
					"content": "Los solteros de Mondstadt nunca se atreverían a pedir la ayuda de otros durante el festival. ¡Tienes suerte de estar casado, Nimrod!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111413,
					"content": "Sí, tienen razón... Siento que tengan que verme haciendo el ridículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111414,
					"content": "*Suspira*, lo hecho hecho está. Bueno, ¿qué necesitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111415,
					"content": "Yo buscaré madera aquí en la ciudad y necesitaré plantas para ponerlas dentro. Pero esas plantas solo crecen en el campo, ¿podrían ir por ellas? Necesito dos lucettas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111416,
					"content": "Lucettas y madera... ¿qué vas a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111417,
					"content": "Quiero construir una casita de madera y ponerle dentro flores luminosas y mueblecitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111418,
					"content": "¡Qué regalo tan bonito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111419,
					"content": "Una pequeña muestra de mi amor, jeje. Cuando nos conocimos, le hacía regalos fabricados a mano todo el tiempo y le encantaban. Hasta decía que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111420,
					"content": "¡Oh! *Ejem*, discúlpenme. Dejemos los asuntos del pasado. ¡Gracias por su ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111421,
					"content": "#Qué afortunado eres de tener dos ayudantes tan buen{F#as}{M#os} como nosotr{F#as}{M#os}, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111422,
					"content": "¡Vayamos a reunir esos materiales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141115,
			"completionStepIds": [
				4141115
