		},
		{
			"id": 4141103,
			"completionStepIds": [
				4141103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141103",
							"2"
						],
						"stepId": 4141103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110301,
					"content": "¡Muchísimas gracias! Con esto podré ponerme manos a la obra enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110302,
					"content": "¡Recuerda que un regalo no lo arregla todo! ¡Tienes que portarte mejor con tu esposa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110303,
					"content": "¡Sí, lo haré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110304,
					"content": "Pero espero que le guste este regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110305,
					"content": "¡No te preocupes! Todo el mundo aprecia un regalo hecho con amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110306,
					"content": "¡Esfuérzate! ¡No malgastes los materiales que tanto nos costó reunir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141105,
			"completionStepIds": [
				4141105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141105",
							"2"
						],
						"stepId": 4141105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110501,
					"content": "¡Ya estamos de vuelta! ¿Ya escribiste tu tarea, Kaeya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110502,
					"content": "¡Es hora de entregarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110503,
					"content": "¡Bienvenidos de nuevo! Ya estoy terminando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110504,
					"content": "¡Deprisa, déjame ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110505,
					"content": "Aquí está. ¡No se rían!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110506,
					"content": "Humm... ¿Oh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110507,
					"content": "Bardo de pacotilla, ¿qué opinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110508,
					"content": "Kaeya, ¿puedo leerlo en voz alta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110509,
					"content": "Adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110510,
					"content": "*Ejem, ejem*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110511,
					"content": "“‘Mi muhe ye’,\\nasí los Hilichurls dicen ‘te amo’\\nmientras de flores te ofrecen un ramo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110512,
					"content": "¿Eh? ¿¿Eh??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110513,
					"content": "Ya está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110514,
					"content": "¿¿Ya está??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110515,
					"content": "Coherente y directo al grano. Además, creo que la longitud es la adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110516,
					"content": "¿Qué? ¿Acaso estás escribiendo un manual de frases en hilichurlio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110517,
					"content": "¡Qué ridículo! ¿Dónde está el romance?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				},
				{
					"id": 414110519,
					"content": "¡Jajaja! Ya saben, un poema tiene que reflejar el estilo de su autor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110520
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110520,
					"content": "Creo que no te lo tomaste en serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110521,
					"content": "Un momento, ¿Kaeya sabe hilichurlio? Qué extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110522,
					"content": "¡Jaja! ¡No subestimes los conocimientos del Capitán de Caballería de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110523
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110523,
					"content": "Bueno, ahora... ¡vamos por la tarea del siguiente estudiante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110524
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110524,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110525
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110525,
					"content": "#Acabo de ver a una persona sospechosa. Debo ir a investigar. Viajer{F#a}{M#o}, hay una cosa más que tengo que pedirte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110526,
					"content": "La Iglesia nos solicitó una licencia de caza. ¿Podrías llevar estos documentos a la Catedral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110527,
					"content": "*Suspira*, otra vez haciendo mandados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110518,
					"content": "¡Muy bien! Has aprendido mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				}
			]
		},
		{
			"id": 4141107,
			"completionStepIds": [
				4141107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141107",
							"2"
