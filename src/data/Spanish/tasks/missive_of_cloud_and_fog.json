				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110701,
					"content": "Lisa, tenemos que establecer algunas normas. Si atrapamos a algún borracho que estuviera causando problemas, no podemos electrocutarlo, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110702
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110702,
					"content": "Oh, Jean, no me malinterpretes. Ese hombre ebrio al que viste la otra vez me estaba rogando que lo electrocutara. A veces me pregunto si algunas personas disfrutan de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110703
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110703,
					"content": "¡Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110704
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110704,
					"content": "*Suspira*, está bien, si insistes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110705
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110705,
					"content": "¡Jean! ¡Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110706,
					"content": "Saludos, señoritas. ¡Cuánto tiempo sin vernos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110707,
					"content": "¿Qué están haciendo aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110708
					]
				},
				{
					"id": 414110708,
					"content": "Mucho tiempo, sí. Como pueden ver, Lisa y yo estamos de servicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110709
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110709,
					"content": "Oh, cariño, ¡eres tú! ¡Y tus amigos! ¿Vieron a alguien extraño cuando venían hacia aquí? Si descubren algo sospechoso, repórtenlo inmediatamente a los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110710
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110710,
					"content": "¡Paimon no sabía que las bibliotecarias también tienen que patrullar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110711,
					"content": "Normalmente no, pero es el Festival de las Flores de Viento y todo el mundo tiene que arrimar el hombro... incluso el simple personal administrativo como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110712,
					"content": "Lisa, el “simple personal administrativo” no domina el poder Electro como tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110713,
					"content": "Pero no se alarmen, yo vigilaré a Lisa. Por mucho que le guste separar peleas a chispazos y electrocutar a los borrachos hasta que pidan clemencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110714,
					"content": "Jean, si no te gusta, prometo que no lo haré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110715
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110715,
					"content": "¿De verdad? Muy bien. De lo contrario, tendré que reconsiderar si quiero ir a patrullar con una bibliotecaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110716,
					"content": "¡Paimon no sabía que patrullar era tan emocionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141108,
