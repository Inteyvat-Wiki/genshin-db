			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110101,
					"content": "¡Hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110102,
					"content": "#¡Viajer{F#a}{M#o}! ¡Paimon! ¡Ya están aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110103,
					"content": "¡Justo estaba pensando en ustedes dos! ¡Qué coincidencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110104,
					"content": "¿Ya terminaste tu tarea, Kaeya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110105,
					"content": "Siento decepcionarte... ¡Aún no he empezado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110106,
					"content": "Los estudiantes que no entregan a tiempo sus tareas no son precisamente buenos estudiantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110107,
					"content": "¿Y qué excusa tienes para no haberla hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110108,
					"content": "Bueno, como pueden ver, estoy ayudando a la Maestra Jean con varios asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110109,
					"content": "Durante el festival, el ambiente en Mondstadt es muy animado y hay muchísimas cosas que hacer. He estado ocupado durante mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110110,
					"content": "#Viajer{F#a}{M#o}, ¿podría pedirte un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110111,
					"content": "Un amigo borracho me pidió que lo ayudara con algo, pero no tengo tiempo. ¿Podrías ocuparte tú de ese asunto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110112,
					"content": "¿Un amigo borracho? ¿De esos que conoces de la taberna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110113,
					"content": "Exacto. En ocasiones voy a la taberna después del trabajo para tomar unos tragos. Así he conocido a mucha gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110114,
					"content": "Este amigo se llama Nimrod. Suele estar en los alrededores de la taberna y seguro que ahora mismo está disponible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110115,
					"content": "Gracias por tu ayuda. Yo me quedaré a hacer mi tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110116,
					"content": "Buena suerte, Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "Consideraré esto como parte de mi experiencia en el festival.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
