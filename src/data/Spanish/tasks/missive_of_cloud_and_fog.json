			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bárbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110801,
					"content": "¡Bárbara! Kaeya nos envió para entregarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110802,
					"content": "¿Cómo se atreven? ¡Esto es intimidación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110803
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110803,
					"content": "¿Cómo pueden hacer esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110804
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414110804,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110805,
					"content": "¿Qué ocurrió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110806
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110806,
					"content": "R-recibí una carta *snif*. Decía que... que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110807
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414110807,
					"content": "Déjamelo a mí. Acabo de volver de una expedición y, como de costumbre, vine a la Catedral para que las hermanas me curaran. Entonces, vi a Bárbara corriendo por todas partes y con la cara pálida. En la mano tenía una carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110808,
					"content": "Es la primera vez que recibo una carta así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110809
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414110809,
					"content": "¿Puedo leerla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110810
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110810,
					"content": "“Mi querida Bárbara: Tu bien más preciado, y que yo te robé, está enterrado bajo tierra”. Humm... ¿es un intento de intimidarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110811
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110811,
					"content": "¡Es horrible! ¿Será una broma pesada? Si es eso, no tenemos que preocuparnos. Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110812
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110812,
					"content": "... ¿Y si es de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110813
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414110813,
					"content": "Hay un mapa dibujado en el reverso. Parece que es fuera de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110814,
					"content": "Se llevó tu bien más preciado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110815
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110815,
					"content": "Y lo enterró...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110816
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110816,
					"content": "Esa ubicación del mapa me resulta familiar. Seguro que he estado ahí antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110817
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110817,
					"content": "Entonces, ¿qué es lo que más aprecias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110818
					]
				},
				{
					"id": 414110818,
					"content": "Ahora mismo no puedo pensar con claridad, nada tiene sentido... ¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110819
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414110819,
					"content": "Lo estoy recordando... lo estoy recordando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110820
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110820,
					"content": "Mi bien más preciado... ¿N-no será...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110821
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 414110821,
					"content": "¡Bárbara, espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110822,
					"content": "¡Ah, lo tengo! ¡Es el Templo de los Mil Vientos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110823
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110823,
					"content": "¡Oye, Bennett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110824
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110824,
					"content": "¿Cómo pueden irse así? ¡Sigámoslos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141110,
