			},
			"dialogs": [
				{
					"id": 206030501,
					"content": "¿Ya volvieron? Vaya, entonces supongo que no es nada grave, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "Todavía hay muchos monstruos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "¿Cómo? ¿Que todavía hay monstruos, y que son aún más numerosos que antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Qué extraño. ¿No derrotamos ya a ese grupo tan grande que atacó Mondstadt antes? ¿Cómo es que siguen merodeando por la zona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "¿Qué estarán tramando?... Tengo que reunir otra vez a los aventureros y volver a publicar los encargos. No podemos tomar a la ligera este problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Investigar la actividad de los monstruos en secreto es la especialidad del Gremio de Aventureros. ¡Es hora de demostrar lo que valemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Ah, cierto. Acepta esto como agradecimiento por tu trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
	]
