			"dialogs": [
				{
					"id": 745260401,
					"content": "#Oh, hola, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Hola, Nilou. ¿Estás practicando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "No, para nada. Estaba pensando en un nuevo baile inspirado en las orquídeas padishá después de la lluvia, cuando las gotas de rocío aún cuelgan de sus pétalos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Aunque por ahora solo tengo los primeros trazos, muchos de los pasos todavía no son lo suficientemente elegantes. Siento que aún le falta algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Suena hermoso con solo escucharlo. ¿Le darías una oportunidad a mi Daguerrotipo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "¿Ahora? Pero, como te dije antes, todavía no domino muy bien estos pasos de baile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "El ensayo también es parte del arte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Ya lo entiendo. Entonces expresaré mis sentimientos a través de la danza... Espero que puedas capturar con el Daguerrotipo el momento en que la orquídea florezca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "La imperfección también es una forma de arte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Una escena hermosa, ¿me dejarías tomarte una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "¿Te he interrumpido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
