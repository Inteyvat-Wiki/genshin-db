			},
			"dialogs": [
				{
					"id": 150470101,
					"content": "¡Aquí están! Parece que el personal de este lugar ha tenido que ausentarse un rato, ¡pero ya he averiguado cómo se juega a...! Quiero decir, ¡cómo completar las pruebas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Genial. ¡Enséñanos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "Básicamente, una persona maneja el bote mientras la otra envía señales al empleado saurio. Trabajando en equipo, el objetivo es guiar el bote a salvo hasta su destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Así que tengo bastante confianza, porque cuando se trata de trabajar en equipo, {NICKNAME} y yo lo hacemos a la perfección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "¿De verdad? Porque cuando se trata de navegar, la gente que habla mucho suele acabar volcando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "¡Eh, Paimon, no digas esas cosas! ¡Da mala suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Está bien, está bien... Entonces, Paimon les desea... que naveguen sin problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Jeje, seguro que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "La verdad es que me apetece montar en bote. ¡Estoy tan acostumbrada a los retos tan duros del surf que será divertido cambiar de aires!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "#Yo también estoy un poco hart{F#a}{M#o} del Rompeolas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "¿Ves? ¡Estamos en perfecta sintonía! ¡Eso tiene que ser una prueba de nuestro vínculo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "¡Estoy deseando hinchar mi pecitraje de baño y subirme de un brinco al bote!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "Yo me encargaré de enviar las señales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
