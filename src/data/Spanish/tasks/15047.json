			"dialogs": [
				{
					"id": 150470501,
					"content": "Regresas tras transferir el alma a un Iktomisaurio...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "¡Mualani, ya estamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470503,
					"content": "¡...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#¡Oh, hola! ¡Y qué adorable es el saurio que traes contigo! Por cierto, ¿dónde está {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470505,
					"content": "#Eh... Andaba algo revuelt{F#a}{M#o} del estómago, así que tuvo que ir al baño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470506,
					"content": "(En serio, Paimon, qué excusa tan cutre. Bueno, no importa. Mientras Mualani se lo crea...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "¡...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "¡Pero qué simpático eres! ¿Quieres probar un cornihongo luminoso? ¡Toma un poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470509,
					"content": "(Un sabor curioso, desde luego. Espeso, jugoso y sorprendentemente delicioso para ser un hongo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "¡...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
					"content": "Jaja, ¡me alegra que te guste! Toma, son todos tuyos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470512
					],
					"speakerTitle": "Mualani"
				},
				{
