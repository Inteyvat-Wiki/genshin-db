			},
			"dialogs": [
				{
					"id": 741510901,
					"content": "Hay algo raro con esa pareja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "Paimon también lo cree. Uno de ellos habla muchísimo, y la otra prácticamente no abre la boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510903,
					"content": "El momento en el que aparecieron fue muy oportuno como para ser una coincidencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "Te refieres a que aparecieron justo cuando Benoit quería contratar a alguien para que lo cuidase, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510905,
					"content": "Euphrasie dijo que quiso contratar a alguien hace medio año, y en solo ese tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510906,
					"content": "Esa pareja se ha convertido en sus hijos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
					"id": 741510907,
					"content": "Tienes razón, todo fue demasiado intencional. Ahora que Paimon lo piensa, ¡esta pareja es muy sospechosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
