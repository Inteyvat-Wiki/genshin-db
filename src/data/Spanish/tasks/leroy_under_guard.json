				{
					"id": 741511201,
					"content": "Eso es todo lo que se me ocurre por ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511202
					]
				},
				{
					"id": 741511202,
					"content": "#{NICKNAME}, ¿crees que Benoit podría estar en peligro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511203,
					"content": "Podría ser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511204
					]
				},
				{
					"id": 741511204,
					"content": "A Paimon le da mala espina todo esto. ¿Deberíamos informar de ello a la Oficina Judicial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511205,
						741511206,
						741511207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511205,
					"content": "No tenemos pruebas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511208,
					"content": "Es cierto, tienes razón. Pero, a fin de cuentas, solo queremos ayudarlo, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511209,
					"content": "Moli nos pidió que le dijéramos a Benoit que sus dulces son deliciosos, y le dimos nuestra palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511210,
					"content": "Y nuestra palabra se tiene que cumplir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511211
					]
				},
				{
					"id": 741511211,
					"content": "Jeje, ¡Paimon sabe que siempre cumples tus promesas! Y también sabe que tienes buena cabeza. Bueno, ¿qué hacemos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511212,
					"content": "Vayamos a investigar un poco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511213
					]
				},
				{
					"id": 741511213,
					"content": "Sí, ¡tenemos que llegar al fondo de este asunto! Humm... ¿Y qué deberíamos investigar exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511214,
						741511215,
						741511216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511214,
					"content": "La identidad de esa pareja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511217,
					"content": "#¡Sí! ¡Prepárense! ¡La detective Paimon y {NICKNAME} van a revelar la verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511215,
					"content": "Los objetivos de esa pareja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511216,
					"content": "Qué piensa Benoit de ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511206,
					"content": "Todavía no hemos sacado nada en claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511207,
