			"dialogs": [
				{
					"id": 741510501,
					"content": "Atos, el hombre que vieron anteriormente, abre la puerta y sale de la casa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "¿Ustedes de nuevo? ¿Qué narices quieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510503,
					"content": "#¿Está Benoit en casa? Hemos oído que no se encuentra bien, así que estamos un poco preocupad{F#a}{M#o}s por su salud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510504,
					"content": "Está en casa, pero no se encuentra en condiciones de recibir invitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510505,
					"content": "¿Podemos preguntar qué le pasa? Podría pedirle ayuda a mis padres y traerle algunas medicinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510506,
					"content": "No es necesario, compraremos las medicinas necesarias nosotros mismos, y tampoco es que le falte medicina alguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510507,
					"content": "Solo nos preocupa su salud, no tienes por qué ser tan frío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510508,
					"content": "(¡Atos no quiere que veamos a Benoit!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510509,
					"content": "(Esto ya no es ser frío, es ser un témpano de hielo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "Se preocupan demasiado por asuntos que no les concierne. Bueno, ¿alguna cosa más? Si no, me vuelvo para dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510512,
					"content": "Espera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510514,
					"content": "¿De verdad Benoit está enfermo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Por supuesto que lo está, y es muy grave. Morticia y yo estamos pensando en una solución. No es necesario que se preocupe nadie más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510518,
					"content": "¿Por qué hay tanto alboroto afuera, Atos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510519,
					"content": "#No es nada, Morticia. Solo son un{F#a}{M#o}s niñ{F#a}{M#o}s que quieren ver a tu padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510520,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510521,
					"content": "Mira que te gusta relacionarte con niños, papá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510522,
					"content": "Bueno, dado que han venido a verte, ¿por qué no sales a saludar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510523,
					"content": "... Me gustaría... ¿Puedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510524,
					"content": "Claro, papá. Lo que tú quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510525,
					"content": "Se abre la puerta y Benoit sale lentamente de casa.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "#Ah, son ustedes, pequeñ{F#a}{M#o}s. ¿Han vuelto por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510527,
					"content": "¿Se encuentra bien, Sr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510528,
					"content": "¿Yo? *Cof, cof*... Bueno, he estado mejor, pero no se preocupen. Estoy haciendo todo lo posible por recuperarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510529,
					"content": "Mi hija y mi yerno me están cuidando mucho, así que todo está bien. Si quieren, pueden volver a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510530,
					"content": "¿Seguro que estás bien, Benoit? Si sientes que te estás forzando de más, deberías volver adentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510531,
					"content": "Benoit se da cuenta de que Atos le está dirigiendo una mirada, así que regresa en silencio por la puerta.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "#¿Y bien? Ya lo han visto con sus propios ojos. Mi suegro no está nada bien. ¿Content{F#a}{M#o}s? Si no quieren nada más, me vuelvo adentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510533,
					"content": "#Nosotr{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510534,
					"content": "#Atos l{F#a}{M#o}s ignora.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "Bueno, al menos esta vez hemos podido hablar un poco con el Sr. Leroy. *Suspira*, espero que se mejore pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510536,
					"content": "Parece que he causado problemas a otras personas, Paimon. No es lo que pretendía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510537,
					"content": "¡No pienses eso! ¡No has causado ningún problema! De hecho, si le preguntas a Paimon, ¡Paimon cree que el problema es ese tipo, Atos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510538,
					"content": "¡Hum! Él siempre es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510539,
					"content": "Deberías ir a casa, Moli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#¿Eh? {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510542,
					"content": "Sí, debería volver ya. A mis papás no les gusta que venga por aquí. Si se enteran de lo que he hecho hoy, seguro que se enfadarían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510543,
					"content": "No sé si volveré a ver al Sr. Leroy, pero quería decirle que sus dulces estaban riquísimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510544,
					"content": "Si lo ven cuando esté mejor, ¿podrían decírselo de mi parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510545,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "¡Y Paimon también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510548,
					"content": "#¡Bien! ¡Gracias, Paimon y {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510549,
					"content": "Me tengo que ir ya. ¡Hasta la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510550,
					"content": "#¿Qué piensas, {NICKNAME}? Tenías cara de querer decir algo todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510551,
					"content": "Vayamos a un lado a hablar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Sí, vayamos a otro sitio a hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510552,
					"content": "Mejor no hablar demasiado alto por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "Te lo prometo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "Paimon y yo también nos vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "¿Por qué no quieres que veamos a Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "#¿Y por qué debería permitir que un{F#a}{M#o}s complet{F#a}{M#o}s desconocid{F#a}{M#o}s vean a mi padre? Ya se lo he dicho antes: no está en condiciones de recibir a nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510510,
					"content": "(Cómo ha bajado la temperatura en un momento...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
