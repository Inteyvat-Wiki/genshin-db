			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Paimon, {NICKNAME}, ya he dado de comer a la gata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510302,
					"content": "Bien, llamemos a la puerta y vayamos a ver al Sr. Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "Aunque estoy un poco preocupada. ¿Y si no sale? Últimamente, las veces que he venido no he hablado con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510304,
					"content": "Antes de que llegaran, llamé a la puerta, pero nada más asomarse, ese yerno malvado lo volvió a meter en casa de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510305,
					"content": "Entonces, me dio unas golosinas y me dijo que volviera con mis padres. Después de eso, cerró la puerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510306,
					"content": "Con lo amable que es Benoit, ¿por qué su familia es tan fría?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Su yerno dijo que el Sr. Leroy estaba enfermo y no podía verme, pero a mí me parecía que estaba bien, ¿por qué no podía hablar conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510308,
					"content": "La verdad es que estoy más preocupada por el Sr. Leroy que por mis tareas de clase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510309,
					"content": "Si está enfermo, seguro que lo está pasando mal. Mi mamá dice que la gente malita necesita que la cuiden y la mimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510310,
					"content": "¿Podrían acompañarme a preguntar a ese yerno qué enfermedad tiene el Sr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510311,
					"content": "Tal vez haya comido demasiados pasteles o no se haya tapado bien cuando dormía. ¡Yo podría preguntar a mis padres qué hay que hacer en esos casos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510312,
					"content": "#Llamemos a la puerta junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "Sí, es solo que... me da un poco de miedo ese yerno. ¿Podrían ayudarme a hablar con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510315,
					"content": "No tengas miedo, Moli. Te ayudaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Tenemos un trato, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
