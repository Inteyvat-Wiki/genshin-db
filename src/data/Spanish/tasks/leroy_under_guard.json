				"points": []
			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "¿Cómo estás durmiendo últimamente, Benoit? ¿Todavía tienes insomnio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500502,
					"content": "Estoy mucho mejor. Últimamente, prácticamente no he tenido pesadillas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500503,
					"content": "(La conversación de la familia Leroy se hace más difícil de oír.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Llamar una vez"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
						],
						"stepId": 7415101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415104",
							"3"
						],
						"stepId": 7415104,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "¡Oh, han venido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510102,
					"content": "#Paimon es Paimon, y {F#ella}{M#él} es {NICKNAME}. ¡Puedes llamarnos por nuestros nombres a partir de ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "¿Has venido a ver a Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Sí, pero no he podido hablar con él... Por eso, no podré escribir mi redacción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510105,
					"content": "¿Tu redacción? ¡Ah, Paimon se acuerda! Estabas haciendo buenas acciones para hacer tus deberes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "¡No es eso! El Sr. Benoit me cae muy bien. Él es muy... ¡dulce! Sí, dulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510107,
					"content": "Uh, ¿qué clase de descripción es esa? Quieres decir que es cercano y amigable, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "Bueno, Paimon, ¿podrías ayudarme? Si no, no podré hacer mi tarea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510109,
					"content": "Mi tutora dijo que mi redacción sobre dar de comer a la gata del Sr. Leroy era muy “‘anténtica’ y genuina de principio a fin” y me pidió que escribiera otra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510110,
					"content": "¿“Anténtica”? Querrás decir auténtica. Pero bueno, Paimon te entiende, y no le extraña que hayas venido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Aunque sea mi tarea, ¡el Sr. Leroy me cae muy bien! Me dijo que saludara a mis padres de su parte, y eso hice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510112,
					"content": "Papá y mamá se disgustaron cuando oyeron su nombre y no querían que viniera, no sé por qué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510113,
					"content": "Bueno, si lo que necesitas es material para escribir una redacción, solo tienes que hacer como la última vez y dar de comer a la gata, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "Con eso solo tendría para escribir una línea. Es demasiado poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510115,
					"content": "Te acompañaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "#Sí, como hemos hecho anteriormente. Tú das de comer a la gata y nosotr{F#a}{M#o}s limpiamos la entrada y la parte trasera de la casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "Y cuando terminemos, llamamos a la puerta y hablamos con Benoit. Eso será suficiente contenido para escribir, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "¡Sí! ¡Podemos hacer eso! Eres muy lista, Paimon. ¡Voy a dar de comer a la gata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moli"
				}
			]
		},
		{
			"id": 7415103,
