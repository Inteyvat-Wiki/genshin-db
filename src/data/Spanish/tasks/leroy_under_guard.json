			"dialogs": [
				{
					"id": 741511101,
					"content": "La actitud de esta pareja hacia la gente que no conoce es muy sospechosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511102
					]
				},
				{
					"id": 741511102,
					"content": "Exacto. Fueron amables al principio, pero en seguida se han vuelto muy agresivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511103,
					"content": "#Solo han sido amables con nosotr{F#a}{M#o}s cuando su padre estaba presente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511104
					]
				},
				{
					"id": 741511104,
					"content": "Humm... Deja que Paimon haga memoria. Sí, cuando nos conocimos, nos pidió que no volviéramos más justo después de que Benoit entrara en la casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511105,
					"content": "Están fingiendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511106
					]
				},
				{
					"id": 741511106,
					"content": "¿Pero por qué fingirían ser amigables delante de su padre? Tiene que haber una razón para ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
