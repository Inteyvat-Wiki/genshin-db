			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "Oh, ¿qué hace aquí ese Hilichurl? ¿Está descansando? No parece agresivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160202,
					"content": "¿Por qué está aquí escondido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160203,
					"content": "Ay, lo despertaste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160204,
					"content": "¿Eh? Vaya, se fue... ¿Tan temible es nuestra fama en Natlan que hasta los Hilichurls nos tienen miedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160205,
					"content": "Mira, hay algo en el suelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "¿Te refieres a eso brillante? A lo mejor se le cayó cuando echó a correr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160207,
					"content": "Humm... Paimon supone que pensó que había encontrado un tesoro y quería esconderlo aquí, pero no esperaba que lo descubriéramos tan rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160208,
					"content": "A ver, Paimon va a echarle un vistazo, aunque a juzgar por la inteligencia de los Hilichurls, probablemente no sea nada de gran valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160209,
					"content": "¡...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#¿Qué pasa, {NICKNAME}? ¿Por qué estás tan seri{F#a}{M#o} de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160211,
					"content": "¿No es una llave normal y corriente? Aunque tiene un diseño bastante peculiar, no parece típico de Natlan... Humm, ¿de qué nación será?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160212,
					"content": "Es... la llave para abrir la cámara de hibernación de la nave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "¿La cámara de hibernación de la nave? ¿Qué cámara? ¿Qué nave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160215,
					"content": "Espera, ¡¿la nave?! ¿T-te refieres a la nave en la que llegaste a Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160216,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "#¡¿Y cómo es que estaba aquí?! ¿Estás segur{F#a}{M#o} de que no se te acaba de caer a ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160218,
					"content": "La mía la tengo aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "Vaya, pues son idénticas... Pero, si esta llave no es tuya, ¿entonces es de...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160221,
					"content": "Solo hay dos llaves como esta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "#Tal y como Paimon pensaba... Paimon supone que de verdad eres {F#una}{M#un} extraterrestre... No, {F#una Descendida}{M#un Descendido}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160224,
					"content": "Bueno, sabiendo eso, lo que debió de ocurrir es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160225,
					"content": "#El Hilichurl encontró la llave y la escondió porque tu herman{F#o}{M#a} la perdió por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160226,
					"content": "#Lo que significa que tu herman{F#o}{M#a} estuvo aquí hace poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160227,
					"content": "Y eso nos lleva a la Orden del Abismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#Sí... Quién nos iba a decir que ayudar a Iansán a patrullar nos llevaría a un descubrimiento tan importante, e incluso a encontrar una pista sobre tu herman{F#o}{M#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160230,
					"content": "¿Deberíamos seguir buscando pistas por aquí o deberíamos ir a la Comunidad de la Feracidad a buscar a Iansán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160231,
					"content": "¡Ah, aquí están! Buen trabajo, veo que se han esforzado mucho patrullando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160232,
					"content": "¡Iansán! ¿Qué haces aquí? ¿No dijimos que nos reuniríamos en la Comunidad de la Feracidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160233,
					"content": "Justo cuando estábamos pensando en ir a verte, ¡descubrimos algo superimportante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160234,
					"content": "Pues... venía a informarles de que ya no tienen que patrullar. El concurso de culturismo se ha cancelado. En un momento vendrá un equipo de patrulla para tomarles el relevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160235,
					"content": "¿Eh? ¿Y eso? ¿Ha pasado algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160236,
					"content": "La Orden del Abismo ha atacado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160237,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160238,
					"content": "No pensé que mis sospechas fueran a confirmarse tan rápido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#(Parece que {F#Éter}{M#Lumina} vuelve a estar en acción.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#(Esta vez tengo que encontrar una oportunidad para hablar con {F#él}{M#ella}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "Había oído hablar de la Orden del Abismo, pero nunca había visto una operación suya de esta escala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160242,
					"content": "Es como si... fueran a declarar la guerra a toda Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160243,
					"content": "¿Cómo pretende una orden declararle la guerra a la Nación de la Guerra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160244,
					"content": "La Orden del Abismo suele actuar en las sombras. Es la primera vez que nos enfrentamos a una situación así... ¿Qué querrán hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160245,
					"content": "Basándome en sus ataques a la Comunidad de la Feracidad, yo tampoco lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160246,
					"content": "Mi tribu debería poder defenderse sola por el momento, así que tengo pensado ir a la Arena Sacrofuego a hablar con Mavuika. Después de todo, ella tiene acceso a la información de todos los rincones de la nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160247,
					"content": "#¿Por qué no vienes conmigo, {NICKNAME}? La gente se sentirá más segura si {F#la heroína}{M#el héroe} de Natlan está con nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160248,
					"content": "Yo también quiero saber qué está pasando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "#Perfecto, pues vamos junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160249,
					"content": "Sé algunas cosas sobre la Orden del Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "Y eso quiere decir que la Orden del Abismo también ha pasado por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#Una de estas llaves es mía, y la otra es de mi herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "La mía siempre la he llevado conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "No lo puedo creer. Es la llave de la cámara de hibernación de la nave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
		{
			"id": 801603,
			"completionStepIds": [
				801603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
