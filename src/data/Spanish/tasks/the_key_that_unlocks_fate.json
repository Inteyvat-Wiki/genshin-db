			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iansán"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2649.083,
							279.082,
							10084.27
						],
						"pointId": 351500003
					}
				]
			},
			"dialogs": [
				{
					"id": 80160101,
					"content": "Vaya, qué coincidencia. Tum{RUBY#[S]esperanza}aini, Paimon, no esperaba encontrarme con ustedes por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160102
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160102,
					"content": "¡Oh! ¡Hola, entrenadora Iansán! ¿Qué haces aquí sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160103,
					"content": "P-para que quede claro, Paimon no vino a entrenar. Por ahora, Paimon no está interesada en tus clases para perder peso y ponerse musculosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160104,
					"content": "Jajaja, lo sé, lo sé. Además, no soy una entrenadora malvada, siempre respeto la voluntad de mis estudiantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160105
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160105,
					"content": "Aun así... un poco de entrenamiento aeróbico moderado no te haría mal. Por ejemplo, podrías patrullar por mí durante un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160106,
						80160107
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160106,
					"content": "Más que entrenar, eso sería echarte una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				},
				{
					"id": 80160108,
					"content": "Es broma, pero tienes razón. Estoy buscando algo de ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160109
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160109,
					"content": "La Comunidad de la Feracidad está organizando un concurso de culturismo, y hay tantas personas que han dejado el ejercicio para última hora que falta gente para patrullar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160110
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160110,
					"content": "¿Por eso estás patrullando? ¿Tú no necesitas ninguna preparación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160111,
					"content": "No, no la necesito. Por un lado, considero que solo es posible estar en buena forma si se tiene un estilo de vida autodisciplinado y no dejas las cosas para última hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160112
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160112,
					"content": "Y por otro lado... Como ya se imaginarán, no puedo participar en la mayoría de categorías de peso normales, y en las que sí puedo participar, no tengo rival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160113
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160113,
					"content": "Tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160114,
					"content": "¿Por qué miras a Paimon? ¡Paimon no quiere ser tu rival! ¡Ni en sueños estamos en la misma categoría de peso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160115,
					"content": "#Vamos, {NICKNAME}, ayudémosla a patrullar. ¡Paimon no quiere que Iansán la arrastre a competir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160116,
					"content": "Jajaja, mira qué bien, con una mirada bastó para ponerte a trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160117,
						80160118
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160117,
					"content": "Está bien, lo haré por ti, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160119,
					"content": "#Muchas gracias a l{F#as}{M#os} dos. Es una tarea de patrulla rutinaria, solo tienen que asegurarse de que no haya nada fuera de lo normal por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160120
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160120,
					"content": "Yo echaré un vistazo por el otro lado. Nos vemos más tarde en la Comunidad de la Feracidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160121
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160121,
					"content": "#¡Sí, entrenadora! Déjanoslo a nosotr{F#a}{M#o}s, se nos da muy bien pasear y patrullar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160118,
					"content": "Está bien, lo haré por ti, Iansán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160107,
					"content": "Tú lo que quieres es que te echemos una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				}
			]
		},
		{
			"id": 801602,
			"completionStepIds": [
				801602
			],
