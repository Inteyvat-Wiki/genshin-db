				{
					"id": 80161001,
					"content": "#Tranquil{F#a}{M#o}, tú siempre serás {F#nuestra heroína}{M#nuestro héroe}. Jamás se me ocurriría culparte por los actos de tu herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80161002
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80161002,
