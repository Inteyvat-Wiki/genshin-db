			"dialogs": [
				{
					"id": 80160401,
					"content": "*Fiu*, mucho mejor. ¡Así sí que sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160402,
					"content": "Abu Itztli, de haber sabido que estabas aquí, habría reconsiderado enviar refuerzos a los Augures Vientonocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160403,
					"content": "¡La Orden del Abismo es la que debería reconsiderar si les compensa atacarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160404,
					"content": "Según mi experiencia, deberían tener una base de operaciones en el lugar desde el que vienen a atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160405,
					"content": "¿Qué tal si aprovechamos nuestra ventaja para destruir su base? Eso frenará sus futuras operaciones de ataque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160406,
					"content": "¿Ha habido una batalla aquí? ¿Necesitan ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "Sutura"
				},
				{
					"id": 80160407,
					"content": "¡Los guerreros de los Augures Vientonocturno están aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160408,
					"content": "Como no hace demasiado tiempo de la batalla contra el Abismo, estamos acostumbrados a trabajar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160409,
					"content": "La moral de la gente está alta, ¡aprovechemos para acabar con su base!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansán"
				}
			]
		},
		{
			"id": 801605,
			"completionStepIds": [
				801605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
