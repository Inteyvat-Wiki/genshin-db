			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citlalí"
				],
				"points": [
					{
						"sceneId": 20265,
						"position": [
							-1758.462,
							181.021,
							9843.676
						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160501,
					"content": "¡Miren, es Citlalí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160502,
					"content": "#Vaya, no pensé que fuera a verl{F#a}{M#o}s por aquí. ¿Han venido a ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160503
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160503,
					"content": "¿Cómo va todo? Mavuika nos dijo que viniéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160504
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160504,
					"content": "Si has salido de casa, Paimon supone que las cosas no deben pintar nada bien en los Augures Vientonocturno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160505,
					"content": "Más que no pintar bien... son una molestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160506
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160506,
					"content": "He oído que somos la tribu que más está siendo atacada. Maldición, ¿por quiénes nos toman? ¿Creen que somos unos debiluchos o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160507
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160507,
					"content": "Cuanto más lo pensaba, más me enfadaba, y cuanto más me enfadaba, menos podía concentrarme en leer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160508
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160508,
					"content": "Así que eso fue lo que enfureció a la abu Itztli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160509,
					"content": "“Orden del Abismo”... Qué nombre de tan poco gusto. Suena al típico truco barato que usaría un escritor de novelas de poca monta para ponerle nombre a la facción villana y que los lectores lo identificaran de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160510
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160510,
					"content": "#Oye, que se está metiendo con los gustos de tu herman{F#o}{M#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160511,
						80160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160511,
					"content": "Bueno, es que yo también opino lo mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				},
				{
					"id": 80160513,
					"content": "#Perdón, ¿cómo has dicho? ¿Que {F#el hermano}{M#la hermana} de {NICKNAME} es de la Orden del Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160514
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160514,
					"content": "(Sé que me dejé llevar por la ira, pero tal vez haya sido demasiado dura...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160515
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160515,
					"content": "Tendrán que dejar la charla para después. Tenemos compañía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160516
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160516,
					"content": "¡Genial! Es la oportunidad perfecta para desahogarme, y además ha roto con la incomodidad del ambiente. ¡Así no tendré que pensar en cómo redirigir la conversación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160517
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 80160517,
					"content": "Eso último no hacía falta que lo dijeras en alto, Citlalí... En fin, ¡a darles una lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160512,
					"content": "Yo en su lugar habría cambiado el nombre hace mucho tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
			]
		},
