						],
						"pointId": 74
					}
				]
			},
			"dialogs": [
				{
					"id": 80160301,
					"content": "¡Mavuika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160302
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160302,
					"content": "#Oh, por fin llegaste, Iansán. Justo iba a enviar a alguien para que te buscara, pero veo que {NICKNAME} está contigo, así que mejor aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160303
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160303,
					"content": "¿Cómo está la situación? ¿Cuáles son las noticias más recientes de los mensajeros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160304
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160304,
					"content": "La Orden del Abismo ha aparecido en varias partes de Natlan al mismo tiempo. Creo que no cabe duda de que este es un ataque premeditado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160305
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160305,
					"content": "La cantidad de enemigos también es considerable. Si no hubieran renunciado a su habitual secretismo para lanzar este ataque, seguiríamos sin saber el verdadero alcance de la Orden del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160306
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160306,
					"content": "Quieres decir que... ¿la Orden entera está participando en este ataque? Pero ¿cuál es su objetivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160307
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160307,
					"content": "Eso me gustaría saber a mí también. La Orden del Abismo nunca ha estado muy activa en Natlan, ni tampoco hemos luchado nunca contra ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160308
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160308,
					"content": "No será para vengarse de Natlan por haber derrotado al Abismo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160309
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160309,
					"content": "Por muy increíble que suene eso, viniendo de ellos, a Paimon no le extrañaría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160310,
					"content": "Aún es pronto para sacar conclusiones. Por el momento, deberíamos seguir observando cómo se desarrollan las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160311
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160311,
					"content": "¿Cómo va la batalla? ¿Hay muchas víctimas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160312,
					"content": "Aunque la Orden del Abismo nos esté atando con todas sus fuerzas, se enfrentan a nuestros valientes guerreros, quienes no hace mucho salieron victoriosos de una guerra contra el propio Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160313
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160313,
					"content": "Así es, por no mencionar que nosotros somos una nación entera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160314
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160314,
					"content": "Comparado con el auténtico Abismo, la Orden supone una amenaza mucho menor. Para empezar, ellos no podrán reponer sus fuerzas constantemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160315
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160315,
					"content": "Aun así, sigue siendo una guerra, así que debemos tomárnoslo en serio y minimizar las bajas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160316
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160316,
					"content": "#Las tribus se están organizando para defenderse. {NICKNAME}, esto podría considerarse un asunto interno de Natlan. Puedes quedarte conmigo en la Arena Sacrofuego y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160317
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160317,
					"content": "No, esto me concierne a mí también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160318
					]
				},
				{
					"id": 80160318,
					"content": "¿Eh? ¿A qué te refieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160319,
						80160320
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160319,
					"content": "#{F#El}{M#La} actual líder de la Orden del Abismo es mi herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				},
				{
					"id": 80160321,
					"content": "Sí, es verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160322,
					"content": "Vaya... nunca lo habría imaginado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160323
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160323,
					"content": "En ese caso, ¿sabes cuál es su objetivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160324
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160324,
					"content": "Eso es lo que quiero averiguar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160325
					]
				},
				{
					"id": 80160325,
					"content": "Ahora mismo no es que se lleven muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160326,
					"content": "#{NICKNAME} lleva mucho tiempo queriendo encontrar a su herman{F#o}{M#a} para averiguar qué le pasó, pero {F#él}{M#ella} siempre l{F#a}{M#o} rehúye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160327,
					"content": "Ya veo, una pelea entre hermanos... Es algo muy común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160328
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160328,
					"content": "Sí, tienes razón, pero... ¡va mucho más allá de una simple pelea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160329,
					"content": "Supongo que no se podía esperar menos de dos personas como ustedes. Que con una discusión de hermanos puedan cambiar el destino del mundo entero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160330
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160330,
					"content": "#Entonces, para que me aclare, ahora mismo estás de nuestro lado y no sabes qué es lo que quiere tu herman{F#o}{M#a}, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160331,
						80160332
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160331,
					"content": "Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160333,
					"content": "#Jajaja, me alegro de oír eso. Cuando hablaste de tu herman{F#o}{M#a}, me preocupaba que eso nos pusiera en una situación complicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160334
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160334,
					"content": "Según nuestra información, la Orden del Abismo parece haber concentrado sus fuerzas en los Augures Vientonocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160335
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160335,
					"content": "Si no quieres quedarte aquí conmigo, te recomiendo que vayas a echarles una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160336
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160336,
					"content": "Eso haré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160337
					]
				},
				{
					"id": 80160337,
					"content": "Pues voy contigo. La Comunidad de la Feracidad puede defenderse por sí sola. Deberíamos enviar refuerzos a donde más se necesiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160338
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 80160338,
					"content": "Gracias. Avísenme si necesitan ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160332,
					"content": "Sí, pero yo más que nadie quiero darle una buena lección a la Orden del Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160320,
					"content": "#Mi herman{F#o}{M#a} es quien lidera la Orden del Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				}
			]
		},
