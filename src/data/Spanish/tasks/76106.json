			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "¿Es eso todo de lo que son capaces los grandiosos Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "#Pero ¿cómo son tan insolentes los novatos de hoy en día?... Un momento, ¡tú no eres un{F#a} nuev{F#a}{M#o} recluta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "#¡Estabas intentando infiltrarte en nuestro equipo con engaños! Te he descubierto, ¿eh? ¡Atrápenl{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
