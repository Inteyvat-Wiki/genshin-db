	"talks": [
		{
			"id": 2401504,
			"completionStepIds": [
				2401504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401504",
							"2"
						],
						"stepId": 2401504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "No, no... Si quito el juego de luces y sombras, ¿qué hago con las capas de pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150402,
					"content": "El poder de expresión del color no basta... Tampoco hay suficiente contraste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150403,
					"content": "¡Ah! Solo he quitado algunos elementos y ya es un auténtico desastre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150404,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "Ah, hola. Me alegro de verte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150407,
					"content": "Perdona, estaba analizando los problemas de la obra. Estaba tan absorto que me he puesto a pasear sin darme cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150408,
					"content": "Tal vez no te pase, pero yo no me puedo estar quieto cuando medito sobre algún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150409,
					"content": "Cuanto más tiempo paso sentado pensando en algún problema, más me frustro. Por eso me gusta pasear mientras pienso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150410,
					"content": "Mis piernas me llevan allá donde quieren mientras yo reflexiono. El caso es no quedarme quieto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150411,
					"content": "Lo cierto es que lo hago mucho. Lo siento si te he preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150412,
					"content": "¿Has llegado a alguna conclusión?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "Me temo que estoy en el punto de partida. No sé qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150415,
					"content": "Si elimino los efectos lumínicos, la imagen carece de capas suficientes, pero si difumino los contornos, los objetos carecen de estructuración que los sujete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150416,
					"content": "Si elimino cualquier elemento, toda la imagen se vendrá abajo y al final no será más que basura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150417,
					"content": "Estoy hablando conmigo mismo, no le des demasiadas vueltas. Seguiré pensando cómo resolver el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150418,
					"content": "Lo primero será volver y buscar mi caballete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150413,
					"content": "¿Y qué tal la reflexión?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "Por un momento he pensado que estabas en peligro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "Uff, gracias, muchas gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150602,
					"content": "Menos mal. Yo estaba aquí pintando tan tranquilo ¡y de pronto me han rodeado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150603,
					"content": "Atacaban el caballete como si quieran devorarlo o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150604,
					"content": "No podía permitir que lo rompieran, así que eché a correr con él en brazos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150605,
					"content": "Aunque no tardaron en alcanzarme. Gracias a Los Siete, has aparecido tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150606,
					"content": "¿Qué le pasa al cuadro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "#¡Ya me gustaría saberlo a mí! Lo único que hago es pintar con Néctar de Megaflora. ¿No te acuerdas? Tú mism{F#a}{M#o} me ayudaste a recolectarlo la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150609,
					"content": "... ¿Crees que es el Néctar de Megaflora lo que los atrae? No, no puede ser. ¡Pero si no huele a nada después de mezclarlo con las pinturas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150610,
					"content": "No me atrevo a cambiar la técnica para fabricar pigmentos, así que tendré que pensar en alguna otra solución...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150611,
					"content": "*Ejem*, he llegado a pensar que la Megaflora podía percibir la belleza de mi obra y por eso quería venir a verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150607,
					"content": "¿Qué has hecho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}