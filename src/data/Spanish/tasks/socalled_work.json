			},
			"dialogs": [
				{
					"id": 221140701,
					"content": "Yo soy solo un barrilero muy poco hábil y sin material con el que trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140702,
					"content": "¿Cómo que un “barrilero”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Ah, me refiero a que soy como un barril. Ahora me falta un tablón para estar completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140704,
					"content": "Pero el tablón que tengo no es de buena calidad. Si lo utilizara, la calidad del barril disminuiría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140705,
					"content": "Sin embargo, si quisiera buscar ahora ese tablón, no sé cuándo terminaría de hacer el barril.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140706,
					"content": "Estoy cada vez más cerca de entregar ese barril como mercancía, pero hasta entonces, me quedaré con la opción menos dañina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140707,
					"content": "*Suspira*, me pregunto cuántos barrileros más como yo habrá en el mundo con este dilema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140708,
					"content": "Con respecto al trabajo de Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "¿Su trabajo? Ah, la otra vez les pidió que contaran los barcos, ¿cierto? Sí, eso lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140710,
					"content": "¿Por qué te sorprendes tanto? Mientras los resultados sean buenos, a mí no me importa su modo de trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140711,
					"content": "Además, la recompensa que les dio la pagó de su propio bolsillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140712,
					"content": "Sin embargo, el hecho de que informara de los datos sin antes comprobarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140713,
					"content": "Esa actitud tan irresponsable es lo que me enojó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Nervioso An"
				}
			]
		},
