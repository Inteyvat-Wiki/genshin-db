			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Nervioso An"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "*Suspira*, no lo sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140202,
					"content": "Háblame de Linling.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "¿Eh? ¿Me preguntas por Linling? Oh, pues ella... A ver cómo lo digo... No está hecha para este trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140204,
					"content": "Para ser concretos, los datos que reportó tienen errores muy graves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140205,
					"content": "De esta semana, solo son correctos los datos de uno o dos días. Estarían mejor incluso si alguien los hubiera contado mirando a simple vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140206,
					"content": "Con esa actitud, ¿cómo voy a estar tranquilo encargándole este trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140207,
					"content": "Solo se trata de contar barcos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "En lo que respecta al trabajo, nunca se puede decir “solo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140209,
					"content": "Si a un barril le falta tan solo un tablón de madera, la calidad del barril completo se verá afectada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140210,
					"content": "Con el trabajo ocurre lo mismo. Cualquier negligencia hará que el trabajo entero no sirva de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140211,
					"content": "Igual sucede con el trabajo de contar barcos. Si se cuentan mal, el trabajo que se hace en el puerto tampoco será válido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140212,
					"content": "Y eso, a su vez, traería terribles consecuencias. Incluso aunque alguien arreglara la situación, no podemos recuperar el tiempo perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140213,
					"content": "¿Ahora lo entiendes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140214,
					"content": "S-sí, ya lo entiendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "No obstante, nos falta personal en el puerto, así que no, no la despediré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140216,
					"content": "Ya sabes... Es mejor que falte un tablón del barril antes que falte el barril entero, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140217,
					"content": "El responsable de comprobar las mercancías no pudo venir. Díganle a Linling que puede ir a ayudar por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140218,
					"content": "Si no se equivoca con este trabajo, podrá volver a su puesto de contar barcos cuando vuelva el responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140224,
					"content": "Será como una prueba y una oportunidad que le estoy dando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140225,
					"content": "Entréguenle esta lista de mercancías a Linling. Que las examine y marque cada una con un símbolo de “comprobado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140226,
					"content": "Y díganle que no se duerma en los laureles. Si vuelve a equivocarse con este trabajo, no habrá más oportunidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140219,
					"content": "Se lo diré a Linling.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "¿Qué piensan decirle? ¿Que está despedida? No, de momento no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140221,
					"content": "Nos falta mucho personal en el puerto. Ya sabes... Es mejor que falte un tablón del barril antes que falte el barril entero, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140222,
					"content": "El responsable de comprobar las mercancías no pudo venir. Díganle a Linling que puede ir a ayudar por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "El Nervioso An"
				},
				{
					"id": 221140223,
					"content": "Si no se equivoca con este trabajo, podrá volver a su puesto de contar barcos cuando vuelva el responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "El Nervioso An"
				}
			]
		},
		{
			"id": 2211403,
			"completionStepIds": [
				2211403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211403",
							"2"
						],
						"stepId": 2211403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "Ay... ¿Qué voy a hacer con el trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140302,
					"content": "El Nervioso An dijo que te da una oportunidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "¿En serio? ¡Qué bien, qué bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "¿Eh? ¿Comprobar la mercancía? Ay, eso... eso no lo he hecho nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "Pero si vuelvo a equivocarme, estaré acabada. No puede ser, debo prepararme bien para esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "Buscaré los criterios de comprobación de mercancías... Y también el formato correcto para escribirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "¿Podrían ayudarme a contar la mercancía? Primero contrasten con las facturas y recibos que la cantidad es la correcta. Yo me encargaré de examinarla más detenidamente después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "¡Muchas gracias! Yo me quedaré aquí haciendo otros preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "Esta vez no puedo equivocarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "#Déjanoslo a nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "No, esta vez no. Comprobar la mercancía es mucho más complicado que contar barcos. Yo soy quien debo hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "Así que ustedes confirmen la cantidad de mercancía que hay y luego yo la compruebo con más detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211405",
							"2"
						],
						"stepId": 2211405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "¿Ya lo comprobaron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "Ya está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "¡Perfecto! Yo casi acabo. Luego iré a comprobar otra vez toda la mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "¡Por cierto! Acepta esto como agradecimiento. Luego comprobaré la mercancía. Esta vez no puedo equivocarme bajo ningún concepto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "¿No habrás perdido el tiempo escribiendo un poema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "¡Por supuesto que no! Yo también sé cuáles son mis prioridades, y ahora no es momento de escribir poesía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "No puedo escribir más poemas. Tengo que trabajar muy duro a partir de ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "El trabajo es lo más importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Lo sé, pero hacer lo mismo todos los días año tras año acaba aburriendo un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "Además, este trabajo tan tedioso no tiene ningún valor, y a nadie le importa. No puedo evitar distraerme con otras cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "*Suspira*, aunque el Nervioso An siempre dice cosas como “todo trabajo tiene su valor” o “todo trabajo es decisivo”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "Si realmente fuera así, ¿por qué todo el mundo es tan selectivo con el trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "Hay que ser responsable con el trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Pocas veces te pedí ayuda. La mayor parte del tiempo soy yo quien lo hace todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "Ya sé que hay que ser responsable, pero cuantas más cosas hay que hacer en el trabajo, más procrastino. Por eso te pedí ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "Y cuando no estoy ocupada, busco por todas partes cosas que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "Bah, ¡si tú nunca has trabajado! No creo que entiendas lo que te digo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "¿Por qué quieres escribir poesía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "¿Por qué me preguntas esto de repente? Humm... ¿Por qué crees que trabajan las personas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "En mi opinión, es bastante aburrido si solo es “trabajar por trabajar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "No sé, todo el mundo debería tener un sueño, ¿no crees? Uno muy distinto al de un trabajo tedioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "Así podrás relajarte un poco en medio de todo el cansancio, el agotamiento y las ganas de abandonar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "Pero esa es solo mi opinión. No sé lo que piensan los aventureros al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "Después de todo, ellos se ganan la vida haciendo realidad su sueño, aunque yo pienso que siempre es bueno que haya algo que te restrinja un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Jajaja. Pero no me tomes a mí como ejemplo. Los sueños, sueños son, y con el trabajo hay que ser realistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
