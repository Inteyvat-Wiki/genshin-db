			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mualani",
					"Kinich",
					"Ahau",
					"Kachina",
					"Citlalí"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "¡La Arconte Pyro es increíble! Y también supervaliente. ¡Tuvo un enfrentamiento cara a cara con el Maestro Ixbalanqué!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270102,
					"content": "No seas tan modesta, tú habrías hecho lo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270103,
					"content": "Ja, ¿y quién no? Yo lo habría hecho sin dudar. ¿Y tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "Ahau"
				},
				{
					"id": 50270104,
					"content": "Yo... ¡Yo no me habría atrevido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50270105,
					"content": "Como guerreros, luchar está en nuestra naturaleza. Si se te presentara la oportunidad, estoy seguro de que tu instinto te diría que la aprovecharas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270106,
					"content": "*Suspira*, cuánta energía tiene la juventud... Saben que estamos hablando del Maestro Ixbalanqué, ¿verdad? ¡Nuestro más grandioso ancestro! ¿Tanto les gusta pelearse con sus mayores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 50270107,
					"content": "Abu Citlalí, ¡luchemos en alguna otra ocasión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270108,
					"content": "No, me niego a hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlalí"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mausau",
					"Ororon",
					"Iansán"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "Oye, ¿en qué tipo de verdura crees que me convertiré? ¿En una roja o en una verde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270202,
					"content": "Pues... Tengo el presentimiento de que te convertirás en una cebolla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270203,
					"content": "¿Una cebolla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270204,
					"content": "Sí. Alguien que no parece nada del otro mundo, pero que te hace llorar a mares cuando lo atacas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270205,
					"content": "¿En serio? En ese caso, sería superfuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270206,
					"content": "¿Pero qué conversación tan absurda es esta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 50270207,
					"content": "Las cebollas son superfuertes. Un amigo mío estaba cortando cebollas cuando llegué a su casa. Entonces, él se puso a llorar, los saurios se pusieron a llorar y, al final, todos los seres vivos que había en su casa se pusieron a llorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270208,
					"content": "¿Y tú? ¿Tú no lloraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 50270209,
					"content": "Yo también estaba allí, pero me protegí los ojos con un manto justo a tiempo. Como Cacucu e Ifá no podían verme, pensaron que yo también lloraba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270210,
					"content": "¡Yo también quiero ser una cebolla y hacer llorar a la gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270211,
					"content": "Estoy seguro de que así será.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270212,
					"content": "Estoy deseando interrumpirles, pero no tengo ni idea de qué decir para detener esta conversación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 50270213,
					"content": "Iansán, tú eres... un pequeño champiñón. Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270214,
					"content": "¡Nadie te ha preguntado qué soy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 50270215,
					"content": "Aunque... ¿un champiñón, dices? Bueno, no está mal. Son duros, fuertes y llenos de vitalidad. Me gustan los champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "Iansán"
				},
				{
					"id": 50270216,
					"content": "Entonces, ¡debes de ser una chica con mucha vitalidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270217,
					"content": "Lo es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270218,
					"content": "Sí, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansán"
				}
			]
		}
	]
}