				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "¿Eh? Esta carta... parece que la dejó Collei. Echémosle un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340602,
					"content": "¿Pero por qué no ha vuelto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "Quizás fue de nuevo a trabajar con Tignari. Siempre están muy ocupados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340604,
					"content": "Vamos, lee la carta. Parece que Collei presionaba realmente fuerte la pluma mientras escribía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340605,
					"content": "#“{NICKNAME} y Paimon, gracias por ayudarme a cuidar de mi flor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340606,
					"content": "“Últimamente tengo tanto que hacer en el bosque que me olvido de cuidarla”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340607,
					"content": "“Gracias de nuevo por su ayuda. Cuando tenga tiempo, ¡vayamos a la tienda del Sr. Jahangir a comer barco de papa!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340608,
					"content": "¡Vaya, Collei nos está invitando a cenar! Paimon lo anotará para no olvidarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340609,
					"content": "Paimon se pregunta en qué estará trabajando Collei para estar tan ocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340610,
					"content": "Paimon solo espera que duerma lo suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
