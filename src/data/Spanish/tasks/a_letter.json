					}
				]
			},
			"dialogs": [
				{
					"id": 741270401,
					"content": "Dios mío... ¡cuánta altura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270402,
					"content": "¿Te refieres al nivel académico del Instituto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "No, no, estoy hablando de la altura de este sitio, aunque el nivel académico del Instituto también solía ser elevado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270404,
					"content": "Sin embargo ahora... Ay, ¿quién hubiera imaginado que el Instituto sufriría tantas desgracias? No sé si la reconstrucción resultará exitosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270405,
					"content": "La última parada es el Departamento Externo de Auditoría del Instituto de Ciencias de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270406,
					"content": "Es impresionante que seas capaz de decir todo eso de una sola vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "Gracias por tus elogios. Pero ¿dónde está ese lugar? Nunca vi una oficina así en el Instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270408,
					"content": "¿Es el departamento que está a cargo Desnos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "#¡Eso es! ¡Exacto! ¿También conoces ese lugar? Eres toda una fuente de conocimientos, se nota que eres {M#un investigador}{F#una investigadora} sénior del Instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270410,
					"content": "¡Paimon acaba de recordarlo! ¿Es el departamento de las ruinas? Si eso cuenta como departamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270411,
					"content": "Quizás el Sr. Desnos omitió los sufijos por ahora para facilitar su comprensión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270412,
					"content": "Por favor, guíame, necesito ver al Sr. Desnos y recoger algunos documentos. Después de eso, podré volver a la Oficina Administrativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270413,
					"content": "Hoy ha ido todo bastante bien, enseguida podré volver a descansar. La forma de hacer las cosas en el Instituto de Ciencias de Fontaine es efectivamente muy diferente a... *Ejem*, no dije nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
