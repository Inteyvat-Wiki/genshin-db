				]
			},
			"dialogs": [
				{
					"id": 741270301,
					"content": "¿Este es el Salón Académico del Instituto de Ciencias de Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "Reconozco que el edificio parece un salón, pero ¿dónde está la parte académica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "La parte académica está en la mente de los investigadores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Bueno, por suerte hoy no vine aquí para estudiar. En resumidas cuentas, el edificio se mantuvo... íntegro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "Integridad es lo único que le queda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "¡Ejem! Bueno, vamos a dar un paseo por aquí. Creo que será un buen lugar para tomar una imagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "Voy a buscar un buen ángulo de antemano para que el Sr. Roialte luego no me pille desprevenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME}, ¿puedes tomar algunas fotos por mí? Me dijeron que eres muy {M#bueno}{F#buena} con la daguerrotipia, seguro que podrás hacerlo mejor que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270310,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "No en los ladrillos que componen el edificio, claramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
		{
			"id": 7412704,
