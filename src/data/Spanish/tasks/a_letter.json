						],
						"pointId": 6053
					}
				]
			},
			"dialogs": [
				{
					"id": 741270501,
					"content": "Por Los Siete, que esos Mecabots no vuelvan a causar problemas, por favor. ¿Iaune? ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270502
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270502,
					"content": "El Sr. Roialte me envió aquí para hacer una inspección, así que aproveché para visitarle y traerle un poco de café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270503,
					"content": "Debo decir que las condiciones de trabajo aquí... son bastante duras. Pensé que este departamento al menos tendría una sala decente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270504
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270504,
					"content": "Querido Iaune, gracias por el café. Respecto a las condiciones de trabajo... estoy satisfecho. Echa un vistazo a tu alrededor, al menos aquí hay un techo que no se vino abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270505
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270505,
					"content": "¿Sigues a cargo de la auditoría de calidad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270506
					]
				},
				{
					"id": 741270506,
					"content": "#¡{NICKNAME}！ O mejor dicho, {M#investigador}{F#investigadora} sénior, es un placer verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270507
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "Iaune, ¿por qué tienes esa cara de preocupación? ¿Qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270508
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270508,
					"content": "*Suspira*. Verá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270509
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270509,
					"content": "Iaune contó lo sucedido con una expresión angustia en su rostro...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270510
					]
				},
				{
					"id": 741270510,
					"content": "¿Eh? ¿Es esa carta algún tipo de documento secreto importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270511
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270511,
					"content": "No realmente, por lo general, estas cartas solo contienen cosas como “entendido”, “no hay problema” o “no sé”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270512
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270512,
					"content": "A lo sumo, se llevan copias a otros departamentos para que todos tengan conocimiento del asunto en cuestión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270513
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270513,
					"content": "Entiendo, entonces es por eso que yo también recibí esta carta. ¿Es esta la que estás buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270514
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270514,
					"content": "¡¿Qué?! ¡El Sr. Choiseul me dijo que aún no la había enviado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270515
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270515,
					"content": "Supongo que quería decir que las cartas para los externos no habían sido enviadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270516
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270516,
					"content": "Este tipo nunca lo dice todo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270517
					]
				},
				{
					"id": 741270517,
					"content": "Los del Instituto de Ciencias de Fontaine siguen siendo expertos en poner a la gente de mal humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270518,
					"content": "Viendo tu expresión, debe ser esto lo que estás buscando, ya la he leído varias veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270519
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270519,
					"content": "Es exactamente igual a lo que estabas buscando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270520
					]
				},
				{
					"id": 741270520,
					"content": "#¡Ajá, {NICKNAME}, qué observad{M#or}{F#ora} eres! Iaune, seguro que el Sr. Choiseul envió cartas idénticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270521
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270521,
					"content": "¿Por qué no, simplemente, tomas este documento y te lo llevas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270522
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270522,
					"content": "¿Eh? Espera, si Iaune se lleva el documento, tú te quedarás sin él, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270523,
					"content": "Jajaja, mira cuál es mi posición aquí, a nadie le importará si accidentalmente pierdo una insignificante carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270524,
						741270525
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270524,
					"content": "Parece una buena idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				},
				{
					"id": 741270526,
					"content": "Ves, no voy a tomarme tu café sin darte nada a cambio, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270527
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270527,
					"content": "No, señor, no puedo hacer eso, iría contra las normas. Tengo que esperar a recibir la carta de manera oficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270528
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270528,
					"content": "Por Los Siete... ¡Iaune! Sé un poquito más flexible, no seas cabeza dura. ¿Por qué te complicas la vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270529
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270529,
					"content": "¿Quién sabe cuándo tendrás esa carta en tus manos? Cuanto antes la tengas, antes podrás empezar a trabajar y resolver esos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270530
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270530,
					"content": "No, señor, agradezco su amabilidad, pero no puedo saltarme las normas. Mi deber me obliga a hacerlo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270531
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270531,
					"content": "#{NICKNAME}, Sr. Desnos, y también Paimon. He de irme. El Sr. Roialte aún espera mi informe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270532,
					"content": "Iaune se aleja con pasos pesados.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270533
					]
				},
				{
					"id": 741270533,
					"content": "Qué bobo que es Iaune. No puedo creer que sea tan testarudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270534
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270534,
					"content": "Todos tratamos de encontrar la forma de hacer las cosas un poco más fáciles, pero él sigue torturándose de manera innecesaria. No era para tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270535,
						741270536
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270535,
					"content": "Así es su forma de ser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270537,
					"content": "Es admirable... y aterrador. No es de extrañar que no tenga demasiados amigos en la Oficina Administrativa, el Sr. Roialte y el Sr. Semaine son los únicos que están a su lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270538
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270538,
					"content": "#Yo también soy su amig{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270539
					]
				},
				{
					"id": 741270539,
					"content": "¡Paimon también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270540,
					"content": "Jajaja, me alegro. Les pido que lo visiten a menudo y charlen con él, siento que Iaune está cada día más deprimido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270541
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270541,
					"content": "Encontraré una solución para el tema de la carta. Dentro de un rato iré a hablar con el Sr. Choiseul para pedirle que me permita entregarle la carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270542
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270542,
					"content": "Si acepta, se la daré a Iaune lo más rápido posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270543
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270543,
					"content": "¡Ay, tener un amigo tan tonto es agotador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270536,
					"content": "Así es Iaune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270525,
					"content": "Entonces, ¿el problema está resuelto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				}
			]
		},
