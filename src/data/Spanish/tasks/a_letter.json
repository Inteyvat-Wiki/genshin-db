							4471.684,
							541.04,
							3851.864
						],
						"pointId": 6040
					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Ehm... ¿esto es el Parque Conmemorativo de Marianne? No se parece en nada a un parque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "El Sr. Roialte debe estar muy decepcionado, tenía pensado dar un discurso en este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "Con este entorno, será difícil dar un discurso... ni siquiera hay ningún edificio pintoresco... No creo que podamos tomarnos una imagen grupal aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "Puedes llevarte algunos Mecabots como recuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "#Jaja, qué {M#gracioso}{F#graciosa} eres. En la Oficina Administrativa no hay sitio para guardar ese tipo de cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "Además, aunque me los llevara, tendría que valorarlos, registrarlos, clasificarlos y luego guardarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "¡Oye! Solo estamos bromeando, ¡no te tomes el trabajo tan en serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "Hablando de registros... todavía no tengo los documentos. El Sr. Roialte se pondrá a suspirar de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "¿Choiseul te está complicando las cosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Tampoco es eso. Es cierto que... mi solicitud va en contra de las normas, es normal que él no esté de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "La cosa es así. El Instituto está preparando los trabajos para su reconstrucción, ¿verdad? Bueno, pues algunos de los suministros y la asignación de personal deben ser coordinados a través de la Oficina Administrativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "Ellos valoran mucho este asunto, así que pidieron que el Sr. Roialte forme un equipo de inspección para que viniéramos a examinar el área del Instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Entonces, el Sr. Roialte se quedó en la Oficina para reunir a los miembros del equipo, mientras que yo vine al Instituto para coordinar la recepción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "Y casualmente, el Instituto necesitaba enviar una carta a la Oficina Administrativa. Así que pensé que, ya que estaba aquí, yo mismo podría llevar la carta de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "Pero el Sr. Choiseul dijo que eso iba en contra de las normas y no podía dármela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "¿Normas? ¿Qué normas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "¿Hay reglas hasta para recoger un documento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "¡Oh, no! ¿Todo eso de estampar sellos, firmar cosas por todas partes, y escuchar a la gente hablar sin parar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "En pocas palabras, la mayoría de las comunicaciones oficiales en la Oficina Administrativa deben realizarse a través del sistema de mensajería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "¿Qué? Entonces, ¿qué pasa si el departamento que quiere enviar la carta está justo al otro lado de la calle, o puerta con puerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "... Aun así, deben usar el sistema de mensajería. De ese modo se asegura la trazabilidad de todas las comunicaciones oficiales dentro de la Oficina Administrativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "Cuántas molestias para una carta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "Supongo que están acostumbrados a todo esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Bueno, no importa. Vayamos al siguiente lugar, déjame ver la nota que me dejó el Sr. Roialte. Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "El lugar es... el Salón Académico del Instituto de Ciencias de Fontaine. Qué extraño, no vi ningún edificio con este letrero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "Sé dónde está, sígueme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "¡Qué suerte contar contigo! Siempre tan confiable, ¿qué sería de mí si no me acompañaras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Entonces, vayamos rápido, quién sabe si habrá más Mecabots descontrolados por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "¿De qué hablabas con Choiseul?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
		{
			"id": 7412703,
