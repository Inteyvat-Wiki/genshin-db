				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "... Como mencioné antes, estimado funcionario administrativo, esas son las normas, no hay más opciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270102,
					"content": "El Sr. Roialte envió una lista con los documentos necesarios, los tengo aquí preparados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270103,
					"content": "Pero no puedes venir aquí, sin más, a recoger los documentos. Eso no se ajusta a las normas de mensajería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270104,
					"content": "¿Eh? ¡Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Hola, Iaune. Jeje, se te ve en buena forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270108,
					"content": "Lo mismo digo. Se debe en gran parte a la ayuda del Sr. Roialte y el Sr. Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270109,
					"content": "#¿Eh? Iaune, ¿conoces a {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270110,
					"content": "#Por supuesto, {NICKNAME} me ayudó mucho antes. Si no fuera por {M#él}{F#ella}, seguro que ya habría dejado de trabajar en la Oficina Administrativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270111,
					"content": "#¿En serio? {NICKNAME}, no es de extrañar que seas {M#nuestro investigador}{F#nuestra investigadora} sénior honorífic{F#a}{M#o} en el Instituto de Ciencias de Fontaine, ¡jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270112,
					"content": "#Soy {M#bueno}{F#buena} proporcionando apoyo emocional.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "Sea como sea, si no fuera por tu apoyo, seguro que... no podría haber seguido adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270115,
					"content": "#¿El Sr. Choiseul acaba de decir que eres {M#un investigador}{F#una investigadora} sénior del Instituto de Ciencias de Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270116,
					"content": "Sí, y hasta tengo un certificado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "¡Y también un retrato! Paimon también aparece en el retrato, lástima que Paimon no tenga ningún certificado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270118,
					"content": "#Así es, para honrar los logros de {NICKNAME}, le otorgamos el título de {F#investigadora}{M#investigador} sénior honorífic{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270119,
					"content": "#En cuanto a esos logros... Mejor que {NICKNAME} te lo cuente en persona, volvamos al asunto que nos atañe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270120,
					"content": "No puedo darte el documento ahora, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270121,
					"content": "Pero antes mencionaste que querías que un investigador te guiara para tomar imágenes cerca del Instituto de Ciencias de Fontaine. ¡Con eso no hay ningún problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270122,
					"content": "#Creo que {NICKNAME} es {M#perfecto}{F#perfecta} para ese trabajo, conoce muy bien los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270123,
					"content": "#¿Qué piensas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270124,
					"content": "No hay problema, yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "Qué amable eres, me quedo más tranquilo sabiendo que estás tú a mi lado. De camino hacia aquí, vi un tremendo descontrol de Mecabots y monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270127,
					"content": "Pero tomar imágenes no es lo más importante. En serio, Sr. Choiseul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270128,
					"content": "Iaune, me gustaría ayudarte, pero las reglas son las reglas, no hay nada que yo pueda hacer. Solo soy un administrador que sella documentos a diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270129,
					"content": "Está bien, está bien. Hablaré de nuevo con el Sr. Roialte sobre esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270130,
					"content": "Adiós, Sr. Choiseul, que tenga un buen día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270131,
					"content": "Gracias, te deseo un buen día en el Instituto de Ciencias de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270132,
					"content": "#{NICKNAME}, confío en que me puedas guiar. Vayamos primero al Parque Conmemorativo de Marianne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270125,
					"content": "#Estaré {M#encantado}{F#encantada} de ayudar a Iaune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "Solo arreglé una Autoselladora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "En seguida te puedo llevar de vuelta en planeador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#¡{NICKNAME}！ ¡Me alegra mucho verte por aquí, qué coincidencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 7412702,
