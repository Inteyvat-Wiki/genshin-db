				]
			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#¿Xilonen? ¿También están {NICKNAME} y Paimon? Hola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060202,
					"content": "¿Ororon? ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060203,
					"content": "¿Ya estás mejor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "La abu me dio una bebida muy amarga y me obligó a descansar varios días. Ya me siento mucho mejor. Gracias por preocuparte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060205,
					"content": "¡Hola, Ororon! ¿También estás aquí para ayudar a Xilonen a cazar flogistabejas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060206,
					"content": "#¿Cazar flogistabejas? ¡Ah! Así que fueron ustedes l{F#as}{M#os} que se llevaron a Superdulce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060207,
					"content": "Y a Megadulce y Extradulce... Por eso habían desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060208,
					"content": "¿Eh? ¿Esos son los nombres de las flogistabejas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060209,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060210,
					"content": "Es para distinguirlas mejor. No voy a juzgarlas porque a mi parecer son todas geniales, aunque no produzcan miel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060211,
					"content": "Entonces... ¿estás cuidando de esas flogistabejas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060212,
					"content": "En realidad, no interfiero mucho en sus vidas. Simplemente vivimos en el mismo territorio y nos llevamos bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060213,
					"content": "Uf... Lo siento, no lo sabía. Como han sido contaminadas por el Abismo, han afectado a la tribu, así que tenía que encargarme de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060214,
					"content": "Eso, eso... No les hemos hecho daño, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060215,
					"content": "#Ah, muy bien. No pasa nada, tranquil{F#as}{M#os}. De hecho, a eso venía, a resolver el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060216,
					"content": "Pero hay algo que me gustaría rectificar. Las flogistabejas son pequeñas criaturas muy inteligentes. No se han visto contaminadas por el poder del Abismo, sino que lo han consumido por voluntad propia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060217,
					"content": "¿Cómo? ¿Por voluntad propia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060218,
					"content": "Así es. Solo consumen un poco cada vez, pero ese pequeño consumo hace que se hinchen mucho, sin llegar a ser letal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060219,
					"content": "Después, vuelan a un lugar muy lejano para producir una perla de flogisto contaminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060220,
					"content": "La cubierta de la perla puede aislar cierta contaminación, lo que gradualmente separa el poder del Abismo de su hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060221,
					"content": "Aunque sea necesario hacerlo muchas veces, son muy pacientes. Y si hay que hacerlo de poco a poco como trabajan las hormigas, se hace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060222,
					"content": "Oh... Así que estaban protegiendo su hogar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060223,
					"content": "Con que ellas también saben que estas tierras están siendo invadidas. No me lo esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060224,
					"content": "Sí, ¡Superdulce y compañía están luchando muy duro! Son realmente unas flogistabejas muy capaces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060225,
					"content": "Con razón Natlan es la Nación de la Guerra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "Espera, Ororon, ¿cómo has llegado hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060227,
					"content": "Ah, porque les di de comer un fruto paralizante, el cual no tardan en excretar, ya que no lo pueden digerir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060228,
					"content": "Al caer al suelo, las semillas germinan y crecen hasta convertirse en pequeños arbustos con frutos. Así, solo basta con seguir dichos arbustos para encontrarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060229,
					"content": "Después, recojo las perlas que producen y las guío de vuelta con los frutos paralizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060230,
					"content": "Pero parece que me han ayudado con eso y sin haberles hecho daño. Se lo agradezco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060231,
					"content": "Con que esa era la historia. Paimon se estaba devanando los sesos, pensando si había algún complot detrás de esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060232,
					"content": "¿Eh? ¿Les hice perder el tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060233,
					"content": "¡Claro que no! ¡No te preocupes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060234,
					"content": "Ororon, nos aseguraremos de devolverte las flogistabejas depuradoras de la contaminación sanas y salvas. No te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060235
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060235,
					"content": "Estupendo. Son criaturas que valen mucho y hay que tratarlas bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060236
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060236,
					"content": "#Bueno, ya que el problema está resuelto, me despido. Están invitad{F#as}{M#os} a visitar mi casa cuando quieran. Les presentaré a más amigos míos. ¡Nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060237
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060237,
					"content": "Lo espero con ansias. Nos vemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060238
					]
				},
				{
					"id": 755060238,
					"content": "*Fiu*... No esperaba que las cosas fueran así. Ororon es todo un experto en crear “sorpresas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060239
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060239,
					"content": "#Y muchas gracias a ustedes también, {NICKNAME} y Paimon. De lo contrario, este trayectito habría sido muy aburrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060240
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060240,
					"content": "Tomen esto. Es una perla de flogistabeja pura. Acéptenla sin remordimientos, no es muy cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060241
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060241,
					"content": "Tómenla como un recuerdo de esas pequeñas guerreras que luchan por Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		}
	]
}