				]
			},
			"dialogs": [
				{
					"id": 755060101,
					"content": "Oh, hola. Ya llegaron. Esta es la última zona de aparición de esas flogistabejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060102,
					"content": "Solo hay que atrapar las que hay aquí y ya está, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060103,
					"content": "Sí. No pasa nada si se nos escapa alguna. Ya me ocuparé de ellas en cuanto tenga tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060104,
					"content": "Me han llegado noticias de la tribu de que la condición de los pacientes ha mejorado en los últimos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060105,
					"content": "¡Qué buena noticia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060106,
					"content": "Es una pena que la conspiración de la que hablaba Paimon no haya sucedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060107,
					"content": "Parece que las bayas crecieron de forma natural en las zonas donde se reúnen las flogistabejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060108,
					"content": "Eh... Paimon no estaba insinuando que fueran los Fatui o los Ladrones de Tesoros ni nada por el estilo... ¡Solo quería demostrar la precaución que tendría cualquier guía calificada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060109,
					"content": "Espero que estés siempre tan alerta, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "Jeje, ¡claro que sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060111,
					"content": "Muy bien, ¡concentrémonos en la última misión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060112,
					"content": "¡De acuerdo! ¡Escuadrón Cazabejas al ataque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
