			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermín"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "Parece que alguien ha oído ruidos desde el interior...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "Hola, ¿hay algo en lo que pueda ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 732330503,
					"content": "Sobre la maceta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "¿Es un regalo de Raef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 732330505,
					"content": "¿Una maceta de flores? ¿De verdad? Gracias por traérmela de su parte. ¡Me encanta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 732330506,
					"content": "Pero ¿seré capaz de cuidar bien de ellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 732330507,
					"content": "¿Es que nunca has cultivado flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "Bueno, es que no se me da muy bien la jardinería. El resto de las plantas que cultivé se echaron a perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 732330509,
					"content": "Y seguro que estas flores son aún más delicadas. Si se me marchitan también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 732330510,
					"content": "No, no y no. Son mis flores y tengo que cuidar bien de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "Nermín"
				},
				{
					"id": 732330511,
					"content": "Seguro que la abuela Kulsum sabe cómo resolver este problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermín"
				}
			]
		},
		{
			"id": 7323306,
