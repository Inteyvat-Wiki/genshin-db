				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "#¡Lo has traído todo! Mil gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330402,
					"content": "¿Estás intentando abrir una floristería?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "*Ejem*, es que pensé que si compraba todo de golpe, me ahorraría un par de viajes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330405,
					"content": "¿Por qué no descansas un rato? Yo todavía tengo que plantar las semillas y fertilizarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330406,
					"content": "Raef comienza a plantar las semillas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "¡Ya está! Con esto bastará. Así Nermín solamente tendrá que regar la maceta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330408,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme otra vez y llevarle esta maceta a Nermín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330409,
					"content": "¿Por qué no vas tú mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "Tengo que vigilar esta intersección. Si llega un cargamento de comida o una caravana, tengo que pedirle a alguien de la aldea que venga a recogerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330411,
					"content": "Además, como hace tanto calor aquí, si tardo mucho, los productos se echarán a perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330412,
					"content": "#Te lo pido, viajer{F#a}{M#o}. Nermín no vive lejos y solo tienes que llevarle esta maceta. Ya pensaré en cómo llevar yo el resto de cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330403,
					"content": "¿Para qué has comprado tantas cosas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
