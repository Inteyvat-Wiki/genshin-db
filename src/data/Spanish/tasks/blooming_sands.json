				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "#Viajer{F#a}{M#o}, ya estás de vuelta. Me has ayudado tanto... ¿Qué dijo Nermín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Le preocupaba no poder cuidar bien de las flores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Humm, yo le echaré una mano. Y si no, le preguntaremos a alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "Si no sale bien, pues... Buscaré otra cosa que pueda cuidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "#En fin... Muchas gracias por ayudarme, viajer{F#a}{M#o}. Aquí tienes la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "Yo mismo le llevaré el resto de las cosas a Nermín más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "¡Espera! ¿Dónde están las instrucciones de todas estas herramientas? ¡Yo no tengo ni idea de jardinería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "¿Es la primera vez que le regalas flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Tampoco es eso. Le he comprado plantas en otras ocasiones, pero ya estaban crecidas. Para cuando llegaron a la aldea, se habían marchitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "Por eso he pensado que sería buena idea comprarle una maceta que pueda cultivar ella misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
		},
