					"speakerTitle": "Raef"
				}
			]
		},
		{
			"id": 7323304,
			"completionStepIds": [
				7323307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323307",
							"2"
						],
						"stepId": 7323307,
