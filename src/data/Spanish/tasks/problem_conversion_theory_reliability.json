			"trigger": {
				"objectNames": [
					"Rafiq",
					"Chishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "No creo que podamos ahorrar mucho en los materiales de esta parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230200102,
					"content": "No te preocupes, esa parte será lo suficientemente fuerte. Repasé los cálculos varias veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200103,
					"content": "*Suspira*, ya te he dicho que los problemas no se pueden calcular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230200104,
					"content": "¿Por qué están discutiendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "Ah, eres tú. Estamos discutiendo algunos problemas de diseño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200106,
					"content": "Hice muchos cálculos para asegurarme de que cada zona sea lo suficientemente resistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200107,
					"content": "Pero Chishan insiste en que esas zonas carecen de suficiente resistencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200108,
					"content": "Esa resistencia de la que hablas es meramente teórica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230200109,
					"content": "Cuando el barco esté en el agua tendrá que soportar una presión mucho mayor a la de tus cálculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230200110,
					"content": "Entiendo tu razonamiento, pero tienes que entender que mi presupuesto es limitado. Además...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200111,
					"content": "¡Si sigo comprando materiales, no podré pagar ni la quilla del barco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200112,
					"content": "Así que, por ahora, vamos a seguir mis planos. Ya tengo todos los materiales preparados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200113,
					"content": "#Viajer{F#a}{M#o}, ¿te importaría ayudarme a llevar algunos materiales de vuelta? No puedo cargar con ellos yo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200114,
					"content": "Claro, deja que te ayude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "Entonces, lo dejo en tus manos. Yo todavía tengo que terminar estos cálculos. Iré a por el resto de los materiales cuando acabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200115,
					"content": "¿Chishan también sabe construir barcos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "Claro que sí, a veces calcula las cosas incluso más rápido que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200117,
					"content": "No sé por qué trabaja de camarera aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Rafiq"
				}
			]
		},
