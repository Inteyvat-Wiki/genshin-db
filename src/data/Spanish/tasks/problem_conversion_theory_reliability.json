			"dialogs": [
				{
					"id": 230200501,
					"content": "#¡Guau! Muchas gracias, viajer{F#a}{M#o}. Aquí tienes la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "Vaya, estos materiales pesan mucho más de lo que esperaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "Empezaré a construirlo lo antes posible. No debería tardar mucho. Espero que podamos probarlo en el agua muy pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "Cuando llegue el momento, será mejor que prepares el chaleco salvavidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Chishan"
				},
				{
					"id": 230200505,
					"content": "Jaja, no te preocupes. Confía en mí, seguro que todo va bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
