			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Colombina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2155.005,
							109.349,
							11195.66
						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520202,
					"content": "¿Qué tal está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Me ha hecho recordar un pasado muy lejano, cuando vivía junto a los Descendientes Lunaescarcha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520204,
					"content": "Solían preparar una bebida con hojas de menta frescas, especias y bayas secas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520205,
					"content": "Cada vez que pasaba junto a una ventana, podía percibir el ligero aroma a hierba que provenía de la casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520206,
					"content": "¿Y después? ¿Lo probaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "Lo intenté, pero nunca lo conseguí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520208,
					"content": "¿Eh? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "Cuando una “diosa” dice de pronto: “¿Podría probar el té que has preparado?”... nadie se atreve a ofrecerle el “té rústico” que han hecho en casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520210,
					"content": "Ah, Paimon puede entenderlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "Cuando por fin llegaba a mis manos, ya se había convertido en una “ofrenda a la diosa”, con envoltura ornamental y todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520212,
					"content": "No es que no supiera bien, pero... le faltaba algo comparado con el que podía oler desde la ventana... la calidez del hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520213,
					"content": "Ahora podrás beber tantos como quieras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520215,
					"content": "Está delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520216,
					"content": "... Aunque no conocía la técnica de añadirle leche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520217,
					"content": "Es una receta de Mondstadt. Ellos suelen añadirle leche, crema batida y azúcar al té.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "Qué novedoso... ¡No está mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520219,
					"content": "¡Uff, menos mal que te gusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Sí, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760520221,
					"content": "Parece que la luz de la luna no es lo único que puede reflejar el pasado. El aroma de una bebida también es capaz de evocar paisajes de tiempos lejanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
		{
