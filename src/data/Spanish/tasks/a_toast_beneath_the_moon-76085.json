			"dialogs": [
				{
					"id": 760850601,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850602
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850602,
					"content": "Esta bebida está deliciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850603,
					"content": "Es la bebida que más me ha gustado hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850604,
					"content": "¡Guau! ¡Por fin una bebida que le gusta a Colombina! Paimon se ha emocionado y todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Eh... ¿Lo siento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850606,
					"content": "Resumiendo: que no tenga un sabor amargo muy evidente, no usar nunca jugo de frutas directamente, y puede tener leche, pero mejor si no la tiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850608,
					"content": "Así que esa es la receta para hacer una bebida ligera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Es bueno que hayamos descubierto un patrón. Así sabremos cómo preparar la bebida la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "¿La próxima vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850611,
					"content": "#¡Claro! Somos amig{F#a}{M#o}s, ¿no? Si alguna vez quieres beber, ¡solo tiene que decírnoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Espera, ¿por eso no te terminas la bebida? ¿No es porque piensas que es la última que tomarás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850614,
					"content": "Puedes estar tranquila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760850616,
					"content": "Gracias por su amabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
