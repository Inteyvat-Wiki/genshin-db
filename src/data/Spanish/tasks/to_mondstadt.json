				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010501,
					"content": "¡Hum! ¿Y bien? ¿Cumplí con tus expectativas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010502,
					"content": "Tus habilidades de combate son increíbles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "Tales cosas son elementales para una astróloga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010505,
					"content": "Las mentiras no sirven de nada ante la astrología: el destino y la verdad están escritos en las estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010506,
					"content": "Aunque interpretar los detalles puede llevar más tiempo, soy capaz de entender la clave de una cuestión de un solo vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010507,
					"content": "Pero has tenido unas cuantas malas predicciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010508,
					"content": "Eso se debe a que las estrellas de Teyvat solo pueden mostrar el destino y las verdades de “este mundo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010509,
					"content": "Todo lo relacionado contigo es como una niebla. Ni siquiera yo puedo ver a través de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010510,
					"content": "Por eso debo conocer a esa sucesora. Si unimos nuestro conocimiento, podré obtener una nueva visión de tu destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010511,
					"content": "¡Qué emoción!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "¡Ja! En cualquier caso, no pierdes nada haciendo este viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010514,
					"content": "Muy bien, ya descansé lo suficiente. ¡Terminemos con este viaje a <color=#00E1FFFF>Mondstadt</color> de una vez por todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010515,
					"content": "*Suspira*, si tan solo tuviéramos un transporte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010516,
					"content": "¡Pensé que no estabas cansada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010512,
					"content": "Prefiero no hacerme muchas ilusiones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "Lo impresionante es que supiste que eran bandidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
