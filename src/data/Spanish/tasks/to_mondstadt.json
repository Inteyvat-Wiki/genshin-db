			"dialogs": [
				{
					"id": 105011501,
					"content": "Este aroma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011502,
						105011504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011502,
					"content": "Tómalo como una guarnición para tus fideos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011503
					]
				},
				{
					"id": 105011503,
					"content": "No pensé que fuera tan exquisito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011506,
					"content": "#De acuerdo... Si mi discípul{F#a}{M#o} lo hizo con tanto esmero, haré un esfuerzo por probarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011507,
					"content": "¡Oh! ¡Oh! ¡Sabe genial! ¡Es lo mejor que he comido en mucho tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011508,
					"content": "#Que diga... *Ejem*, no creí que mi discípul{F#a}{M#o} fuera buen{F#a}{M#o} cocinando. Tu maestra está orgullosa de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011509,
					"content": "Tienes que comer bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011511,
					"content": "Ya veo que no es mentira cuando dicen que los manjares de Liyue son deliciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011512,
					"content": "Visto así, gastar tantos Moras en comer hasta merece la pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011513,
					"content": "Bueno, ya comimos y bebimos a nuestro antojo, deberíamos irnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "Si seguimos en dirección al norte, llegaremos a la <color=#00E1FFFF>Puerta de Piedra</color> y habremos entrado en el territorio de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011515,
					"content": "¿Qué misterios nos aguardan por descubrir? Jeje, no puedo esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011510,
					"content": "No disimules. Estás disfrutando de la comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011504,
					"content": "Lo hice especialmente para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011505
					]
				},
				{
					"id": 105011505,
					"content": "¡¿Qué dijiste?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				}
			]
