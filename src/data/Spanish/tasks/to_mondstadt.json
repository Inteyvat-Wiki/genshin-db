			"dialogs": [
				{
					"id": 105011201,
					"content": "Es todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011202
					]
				},
				{
					"id": 105011202,
					"content": "¡¿Todo eso?! ¡Somos tres... no, dos personas y media! ¡Es demasiado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011203,
					"content": "Oye, ¿a qué te refieres con “dos personas y media”? Además, ¡Paimon todavía no ha pedido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011204,
					"content": "¡Pescado mandarín agridulce, pollo al chile Jueyun y un estofado de gemas, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011205,
					"content": "Por supuesto. ¿Algo más que quiera pedir, señorita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011206
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011206,
					"content": "¿Y-yo? ¿Cuánto es la cuenta hasta ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011207,
					"content": "Veamos... veinte mil Moras, más o menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011208
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011208,
					"content": "Oh... Entonces... Solo un plato de fideos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011209,
					"content": "De acuerdo. Un plato de fideos. Esperen un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011210,
					"content": "Paimon ha estado pensando en algo mientras comíamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011211,
					"content": "¿Por qué ella pidió solo un plato de fideos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011212
					]
				},
				{
					"id": 105011212,
					"content": "¿Acaso... no tiene dinero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011213,
					"content": "¡Te escuché! ¡Les dije que yo pagaría la cuenta! ¡No es una cuestión de dinero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011214,
					"content": "Un astrólogo debe concentrarse en el estudio del cielo. Si nos distrajéramos por cosas materiales, afectaría nuestras previsiones astrológicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011215,
					"content": "Especialmente cuando se usa el Mora para satisfacer necesidades fisiológicas. Es repugnante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011216,
					"content": "*Grrr*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011217,
					"content": "... y peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011218,
					"content": "Entonces, ¿no comer de los platos que pedimos también es parte de la dignidad de una astróloga? Paimon no entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011219,
					"content": "#Pero no está bien que solo nosotr{F#as}{M#os} comamos y bebamos hasta reventar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011220,
