						105011102
					]
				},
				{
					"id": 105011102,
					"content": "Este es uno de los platos favoritos de nuestros clientes más antiguos. brotes de bambú con carne de cerdo y jamón hervidos. El resultado es una sopa espesa y aromática.",
					"roleType": "TALK_ROLE_NPC",
