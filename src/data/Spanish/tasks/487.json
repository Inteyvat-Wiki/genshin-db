				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4871001,
					"content": "¡Príncipe! Buen chico, ese es mi Príncipe, sabía que regresarías a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871002,
					"content": "¡Ah! Después de tanto buscarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871003,
					"content": "Oh, Príncipe, ¿cómo pudiste abandonarme así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871004,
					"content": "Parece que esos dos necesitan algo de tiempo a solas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871005,
					"content": "Mírate... ¿Príncipe te llevó a una persecución absurda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871006,
					"content": "Jaja... Anímate, aunque no lo atrapaste, está de vuelta gracias a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871007,
					"content": "¡Y todavía tiene las cuerdas de hierro astrales con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871008,
					"content": "¡Me atrevo a decir que una actuación privada interpretada con estas mismas cuerdas no bastaría para mostrar mi gratitud! ¡Jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871009,
					"content": "¿Una qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871010,
					"content": "*Achís*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871011,
					"content": "*Cof*, jaja... Disculpa, a esta distancia mi alergia a los gatos parece empeorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871012,
					"content": "Oh, ahora entiendo por qué no fuiste a buscar tus cuerdas por ti mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871013,
					"content": "Jeje, de todos modos, gracias por la ayuda, me iré ahora... ¡Achú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 48711,
			"completionStepIds": [
				48711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
