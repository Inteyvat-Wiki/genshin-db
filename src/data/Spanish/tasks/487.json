		},
		{
			"id": 48705,
			"completionStepIds": [
				48706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48706",
							"2"
						],
						"stepId": 48706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870501,
					"content": "Guau, Príncipe tiene sentidos muy agudos. Se asusta con cualquier cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "#Mira a ver si puedes acercarte a él agachad{F#a}{M#o} <color=#00E1FFFF>desde atrás</color>. De esa manera, tus pasos serán más silenciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "Debe ser difícil no poder volar, jiji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "Si no encuentras a Príncipe, ¿por qué no lo atraes con un poco de <color=#00E1FFFF>pescado</color>? A los gatos les encanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "Si te has quedado sin <color=#00E1FFFF>pescado</color>, ve a buscar más al lago. ¡Vamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48710,
			"completionStepIds": [
				48703,
				48710,
				48713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
