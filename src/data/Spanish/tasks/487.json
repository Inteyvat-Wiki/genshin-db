				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4871201,
					"content": "¡Demonios! Se ha escapado de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4871202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871202,
					"content": "¿Pero a dónde va? Humm, me pregunto si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48713,
			"completionStepIds": [
