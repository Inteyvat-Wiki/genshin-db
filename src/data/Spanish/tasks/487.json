				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4871101,
					"content": "¿Dónde has estado buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4871102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871102,
					"content": "Príncipe debe estar en algún lugar del distrito comercial. Es un gato negro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
		{
			"id": 48712,
			"completionStepIds": [
				48712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48712",
							"2"
						],
						"stepId": 48712,
						"stateName": "QUEST_STATE_UNFINISHED"
