			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870101,
					"content": "... Así que el gato que desapareció es tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "¡Venti! ¿Viniste a ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "¿Yo? ¿Ayudarte? ¡Por el contrario, soy yo quien necesita ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Pero acabo de verte hablando con Margaret sobre Príncipe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "¡Ajá! ¡Entonces, Príncipe es el nombre del demonio felino que robó mis <color=#00E1FFFF>cuerdas de hierro astral</color> de repuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Aunque me alegra el corazón ver que el espíritu libre de la ciudad de Mondstadt está vivo en criaturas grandes y pequeñas... ¡Es un poco audaz de su parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870108,
					"content": "¡Lo dices como una madre mimando a su hijo malcriado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870107,
					"content": "¡Jaja, Príncipe es un pequeño bribón travieso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870109,
					"content": "Te pareces mucho a Barbatos, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Ajá, una comparación bastante acertada, diría yo... ¡Ejem! ¡Ahora, veamos si conseguimos que su alteza mimada, el Príncipe Bribón de Mondstadt, nos reciba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "Tengo una actuación esta noche y, sin mis cuerdas de repuesto, mi audiencia quedará decepcionada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "¿Qué haría un gato con las cuerdas de la lira de Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "¡Todos saben que los gatos se vuelven locos al ver un hilo de lo que sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "Las cuerdas de la lira están hechas de hierro astral que contiene energía Anemo. Eso las hace extremadamente duraderas, así que normalmente las enrollo en una bola para cargarlas más fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "¡Es un pequeño truco que aprendes en el oficio de bardo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "¿Las cuerdas contienen energía Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#¡Eso nos ayudará! ¡{NICKNAME}, es hora de que uses tu <color=#00E1FFFF>Visión Elemental</color> de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Seguramente hay algunas huellas elementales o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870120,
					"content": "Gracias a todos. Príncipe debería estar por el distrito comercial o en el área residencial. Es un gato blanco y negro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Por cierto, toma este <color=#00E1FFFF>pescado</color>, es la comida favorita del pequeño Príncipe. Quizás te ayude a encontrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
