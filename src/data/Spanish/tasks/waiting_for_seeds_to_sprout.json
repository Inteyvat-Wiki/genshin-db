			"dialogs": [
				{
					"id": 750360801,
					"content": "¡Brota, brota, pequeña semilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360802,
					"content": "¡Florece, florece, con flores bonitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360803,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360804,
					"content": "Humm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#{NICKNAME}, la energía del flogisto se agotó, así que seguro que fue absorbida. Pero... ¿por qué no hay ninguna reacción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360806,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Quizá la semilla necesite tiempo para crecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "¿Eso crees? La verdad es que tienes razón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360809,
					"content": "Los dientes de león solo necesitan un pequeño soplido para dividirse en innumerables miniparaguas blancos, los ganchos de lobo solo necesitan colgarse del cuerpo de un lobo para llegar hasta lugares lejanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360810,
					"content": "¡Las semillas son muy resistentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360815,
					"content": "Pues dejémosla tranquila por ahora, ¡ya vendremos a verla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360816,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Quizá la semilla solo se haya asustado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "¿D-de verdad? ¡Es posible! Paimon tiene que ser más paciente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360813,
					"content": "#La semilla fue desenterrada de nuevo por {REALNAME[ID(2)|SHOWHOST(true)]}, sus nutrientes fueron robados por insectos voladores y además fue perturbada por los monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360814,
					"content": "Seguro que, para una semilla enterrada, oír a alguien pelear en un campo de flores da tanto miedo como oír tormentas y truenos. Por eso se esconde silenciosamente en la tierra, sin atreverse a moverse... ¡Sí! Debe de ser eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				}
			]
		},
