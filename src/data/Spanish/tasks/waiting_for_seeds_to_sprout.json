			"dialogs": [
				{
					"id": 750360201,
					"content": "#¿Qué cavas ahí, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360202,
					"content": "Oh, ¿encontraste algún tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360203,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360204,
					"content": "Humm, deja que Paimon lo vea... Parece que es una semilla. Es raro que se pueda encontrar algo así en unas tierras tan estériles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360205,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360206,
					"content": "Aunque no parece muy valiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360207,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360208,
						750360209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360208,
					"content": "Las semillas albergan infinitas posibilidades.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				},
				{
					"id": 750360210,
					"content": "Pero este lugar lleva mucho tiempo abandonado y la tierra está muy seca, ¿seguro que esta semilla no está muerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360211,
					"content": "Gruuu... ¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360212,
					"content": "¿Estás triste? Bueno, no se sabe. Después de todo, hay semillas que no producen fruto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360213,
					"content": "De todas formas, la plantaremos y a ver qué pasará. A lo mejor no ha brotado hasta ahora porque estaba en un agujero mal cavado y no tenía suficientes nutrientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360214,
					"content": "Plantémosla bien esta vez, ¡quizá dé fruto! Jeje, ¿qué obtendremos? ¿Mahís gigante? Humm... ¡Cacahuatles fragantes también estaría bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360215,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360216
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360216,
					"content": "Tal vez sea una Megaflora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360217
					]
				},
				{
					"id": 750360217,
					"content": "¡No seas aguafiestas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360218,
					"content": "Por cierto, ¿qué tipo de nutrientes necesitarían las plantas de Natlan? Da igual, ¡vamos a plantarla primero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360209,
					"content": "¡Puede que de la semilla crezca algo increíble!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				}
			]
		},
