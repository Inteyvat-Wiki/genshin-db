			"dialogs": [
				{
					"id": 750360401,
					"content": "¡Esta profundidad estará bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360402,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360403
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360403,
					"content": "A ver, si Paimon tuviera que destacar algo de Natlan que no tienen las demás naciones... ¡Sería el flogisto! ¿Quizás funcione nutrir la semilla con flogisto? ¡Vamos a probarlo!",
