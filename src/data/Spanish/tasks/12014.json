			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Creo que me quedaré aquí un poco más. Para mí, el espectáculo aún no ha terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "Aunque, si quieres charlar, estaré encantada de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "¿Qué harás después?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Matsuzaka y los demás siguen esperándome para que vayamos a cazar al Gran Tejón Mujina. Soy como una hermana mayor para ellos, así que no puedo incumplir mi palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Además, quiero preguntarle a todo el mundo qué les parecieron los fuegos artificiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "Y en los próximos días, también me gustaría agradecer a todos por su apoyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "#Eso l{F#as}{M#os} incluye a Paimon y a ti, por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "¿Son caros los fuegos artificiales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Para ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "¡los haré gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "#Después de todo, insistí en regalarles algunos. Por no mencionar que l{F#as}{M#os} llevé conmigo y les causé todo tipo de problemas por el camino. Jeje, no me sentiría bien si les cobrara Mora por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "¿Estás segura? Me da un poco de vergüenza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#No pasa nada. Mira, ¿qué tal si hacemos un trato? Cuando encuentres a tu herman{F#o}{M#a}, dile que venga a Pirotecnia Naganohara para satisfacer todas sus necesidades de pirotecnia. Así, conseguiré otro cliente. ¿Te parece justo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "#Además, me gustaría conocer{F#lo}{M#la}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "¿Y si la Comisión Tenryou te causa más problemas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "¡Volveré a darles una patada en el trasero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "Jajaja, estoy bromeando. ¿No recuerdas que mi familia tiene bastante trato con las Comisiones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "Lo tenemos bastante fácil. En el peor de los casos, tendríamos que disculparnos, sonreír y pagar una multa. No sería el fin del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "Sin embargo, ustedes deberían tener más cuidado. Sin los mismos contactos, no pueden permitirse ser tan imprudentes como yo, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}