				"points": []
			},
			"dialogs": [
				{
					"id": 740360101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360102,
						740360103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360102,
					"content": "¿Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				},
				{
					"id": 740360104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360105,
					"content": "¡Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360106
					]
				},
				{
					"id": 740360106,
					"content": "¡Ah! ¿Qué? ¿Qué pasa? Sí, he acabado. ¡Por fin he acabado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360107,
					"content": "¡Te estoy hablando! ¿Has terminado ya con el borrador?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360108
					]
				},
				{
					"id": 740360108,
					"content": "Ah, hola. Creo... Creo que estaba dormitando, lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360109,
					"content": "El Sr. Roialte y el Sr. Semaine se quedaron conmigo hasta las tantas. Si he podido terminar el borrador, ha sido gracias a su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360110,
					"content": "Pero tenía tanto sueño que decidí echarme un pequeño sueñecito. No pensaba que dormiría tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360111,
					"content": "Tengo que ir a ver al Sr. Tales para que firme el borrador con el sello oficial de la Oficina Administrativa. Luego, tendré que llevárselo al Sr. Difor para que lo selle él también y así pueden empezar a imprimir la propuesta... ¡Y después habré acabado por fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360112,
						740360113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360112,
					"content": "No suena demasiado complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360114,
					"content": "Esperemos. Además, he oído que el departamento del Sr. Tales ha adquirido recientemente un nuevo modelo de selladora mecánica. Por lo visto es tanto cómoda como confidencial, así que están preparando su implantación en toda la Oficina Administrativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360115,
					"content": "Mira, el Sr. Roialte me ha dado la llave y todo. Cada departamento tiene una llave para poder activar la máquina... Suena a asunto oficial, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360116,
					"content": "¿Por qué no descansas un poco más? No parece ni que seas capaz de caminar en condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360117,
					"content": "De todas formas solo necesitas un par de sellos y está la cosa esa que sella, ¿no? No hay prisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360118,
					"content": "No, no, no puedo permitirme más retrasos. Vamos, en marcha. Además, es solo un par de sellos, no debería llevarnos mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360113,
					"content": "Al menos esta vez no debería ser tan lioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360103,
					"content": "¿Has acabado ya el borrador?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				}
			]
		},
		{
			"id": 7403602,
