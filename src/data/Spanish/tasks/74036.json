			},
			"dialogs": [
				{
					"id": 740360201,
					"content": "Sr. Tales, ¿puedo sellar ya los documentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360202,
					"content": "Claro que sí, chico. ¿Traes la llave? Firma aquí, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360203
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360203,
					"content": "Pensaba que ya no hacía falta firmar ahora que tenemos la máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360204,
					"content": "Bueno, verás... Es que hace falta que alguien opere la máquina, así que todavía hace falta firmar. Ya sabes, a modo de garantía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360205
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360205,
					"content": "Aunque sí que es muy útil para asegurar la confidencialidad. Ni siquiera se enciende si no se usa una llave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360206
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360206,
					"content": "Pon la propuesta ahí y asegúrate de que está bien alineada. Luego, mete la llave en su ranura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360207
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360207,
					"content": "¿Esta es la gran máquina esa que sella? A Paimon le parece una máquina muy normalita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360208,
					"content": "¿Así? Y ahora, giro la llave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360209
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360209,
					"content": "¡Un momento! No te muevas, quiero inmortalizar el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360210,
						740360211
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360210,
					"content": "¿No había problemas con las filtraciones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				},
				{
					"id": 740360212,
					"content": "Cuando recibimos la máquina, el Sr. Carsix dejó muy claro que debíamos capturar una imagen de todo aquel que la usara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360253
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360253,
					"content": "A ver, si cambio el ángulo no saldrá el documento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360213
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360213,
					"content": "Últimamente se rumorea que van a publicar una propuesta sobre una nueva normativa del uso de Daguerrotipos dentro de la Oficina Administrativa para evitar filtraciones. No me gustaría ser el ejemplo de esta propuesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360214
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360214,
					"content": "#{NICKNAME}, deberíamos esperar fuera. Si salimos en la imagen también, podrían meternos en problemas con todo eso de las filtraciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360255,
					"content": "Tales saca una imagen con mucho cuidado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360215
					]
				},
				{
					"id": 740360215,
					"content": "Bien, ya puedes encender la máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360216
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360216,
					"content": "¿Eh? ¿Por qué no se enciende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360217,
					"content": "No puede ser, justo acabo de repararla. ¿Se ha roto otra vez? Bueno, calma, deja que le eche un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360218
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360218,
					"content": "Tales analiza la máquina a fondo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360219
					]
				},
				{
					"id": 740360219,
					"content": "Qué raro, no encuentro el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360220
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360220,
					"content": "¿Y si pruebas otra vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360221
					]
				},
				{
					"id": 740360221,
					"content": "Bien, allá voy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360222
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360222,
					"content": "Iaune saca la llave y lo vuelve a intentar, pero la máquina no enciende...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360223
					]
				},
				{
					"id": 740360223,
					"content": "¡No funciona, Sr. Tales! ¡Piense en algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360224
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360224,
					"content": "A lo mejor no has colocado los documentos debidamente. Tienen que encajar con las marcas para activar el mecanismo oculto que hay dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360225
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360225,
					"content": "¿Qué tendrá que ver eso con que la máquina no encienda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360226
					]
				},
				{
					"id": 740360226,
					"content": "Pues claro que tiene que ver. Si no están bien colocados, ¿cómo va a saber la máquina que tiene que sellar un documento? Se supone que es automática, ¡yo no la estoy tocando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360227
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360227,
					"content": "Por Los Siete... Bien, ¡está bien! Volveré a colocar los documentos bien alineados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360228
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360228,
					"content": "Iaune saca los documentos y vuelve a colocarlos en su sitio, pero la máquina no se enciende...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360229
					]
				},
				{
					"id": 740360229,
					"content": "¡Que no funciona! Sigue sin moverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360230
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360230,
					"content": "No lo entiendo. La última vez, bastó con una palmadita para que arrancara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360231
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360231,
					"content": "Pues dale otra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360232
					]
				},
				{
					"id": 740360232,
					"content": "Bien, probaré con eso... Es eso o tirarnos al suelo de rodillas y pedirle ayuda a los dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360233
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360233,
					"content": "Cierto, siempre podemos rezar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360234
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360234,
					"content": "(Le das una palmadita a la máquina.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360235
					]
				},
				{
					"id": 740360235,
					"content": "(La máquina no responde.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360236,
					"content": "(Le das otra palmada con más fuerza.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360237
					]
				},
				{
					"id": 740360237,
					"content": "(Parece que esta máquina es tan vaga que ni se molesta en quejarse por los golpes.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360238
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360238,
					"content": "(Le pegas un buen guantazo con la mano abierta.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360239
					]
				},
				{
					"id": 740360239,
					"content": "(La máquina deja escapar un chirriante quejido mecánico que te recuerda a una persona que acaba de tirarse de la cama para abajo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360240
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360240,
					"content": "¡Guau! Eso no ha sonado nada bien. ¿Es que se ha roto del todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360241,
					"content": "(... Luego, como si por fin hubiera encontrado las zapatillas de dentro de la casa y la bata, la luz se enciende y la máquina comienza a funcionar de nuevo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360242
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360242,
					"content": "Por fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360243,
					"content": "Aunque suena a que está en las últimas, la máquina se pone manos a la obra. Bajo la atenta mirada de todos los presentes, la máquina estampa el sello en el borrador a la velocidad de una tortuga ondulada. El sello, tras dar su primer paso sobre el papel, parece tambalearse sobre el documento, antes de serpentear lentamente y por último, posarse para descansar. Finalmente, la máquina se estremece y empieza a retraer lentamente el sello...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360244
					]
				},
				{
					"id": 740360244,
					"content": "¡Te dije que funcionaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360245
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360245,
					"content": "Pues yo no entiendo qué tiene de genial esta máquina. Pueden llamarla automática, pero es más lenta que el caballo del malo. Creo que sería más rápido hacerlo a mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360246
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360246,
					"content": "Pero es perfecta para tratar documentos confidenciales. Fíjate, no hay forma de sacar el sello de ahí, así que nadie puede usarlo para fines privados sin autorización.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360247
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360247,
					"content": "¿A qué viene ese aire de orgullo? ¿Qué pasa si la máquina se rompe y el Sr. Carsix no está aquí? ¿Cómo se van a sellar las cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360248
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360248,
					"content": "Pues... tampoco habría problema. Tengo una llave de repuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360249
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360249,
					"content": "¿Para abrir la máquina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360250
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360250,
					"content": "No, para abrir la puerta del despacho del Sr.Carsix. Él tiene una copia del sello guardada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360251
					],
					"speakerTitle": "Tales"
				},
				{
					"id": 740360251,
					"content": "#... Viajer{F#a}{M#o}, nos vamos. Tenemos que grapar el borrador para entregarle al Sr. Difor una propuesta en condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360252
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360252,
					"content": "No veo la hora de acabar con todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360211,
					"content": "¿Y para qué quieres inmortalizarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				}
			]
		},
		{
