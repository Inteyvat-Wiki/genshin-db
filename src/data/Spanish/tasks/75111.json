			},
			"dialogs": [
				{
					"id": 751111501,
					"content": "¿Eh? Es la factura del pedido que envié, sí. No había imaginado que tendría tan mala suerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111502
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111502,
					"content": "Volveré a preparar otra factura en un rato. Por suerte no es nada urgente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111503
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111503,
					"content": "Gracias por devolverme la carta. Anda, ven a beber algo, que estás sudando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chanca"
				}
			]
		},
