				"objectNames": [
					"Mikika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "Esto parece... el paquete que enviamos a Acat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110202,
					"content": "... El embalaje está destrozado. Si volvemos a enviarlo, el paquete entero podría quedar dañado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110203,
					"content": "Aún tengo que organizar los paquetes de la tienda. ¿Podrías ayudarme tú a entregárselo a Acat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110204,
					"content": "Es la dueña de la tienda “Pigmentos Frida” en la Arena Sacrofuego. El letrero de su establecimiento es muy llamativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikika"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
