				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "Joyería Muhuru... ¿Imix? ¡Qué mal! Me da a mí que este es un recibo que ha enviado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110402,
					"content": "Si se pierde este paquete, la Srta. Cheven no dejará que la pobre niña lo olvide jamás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110403,
					"content": "Aún tengo que organizar los paquetes de la tienda. ¿Podrías ayudarme tú a devolvérselo a Imix?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110404,
					"content": "La Joyería Muhuru está en la tribu de los Vástagos del Eco. ¡No tiene pérdida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikika"
				}
			]
		},
