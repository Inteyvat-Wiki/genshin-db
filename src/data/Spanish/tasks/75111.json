			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mikika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Esta carta... Parece la letra de Chanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110302,
					"content": "... Debe de ser la factura de otro pedido. El embalaje está destrozado, no podemos enviar la carta en este estado... Tendremos que devolver la carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110303,
					"content": "Aún tengo que organizar los paquetes de la tienda. ¿Podrías encargarte tú de devolverle la carta a Chanca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110304,
					"content": "Es la dueña del establecimiento “Posada de la Lasitud” en la Arena Sacrofuego. La encontrarás muy fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikika"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
