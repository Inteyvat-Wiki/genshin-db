			"dialogs": [
				{
					"id": 751110501,
					"content": "... Parece que esta carta la envió la Srta. Tirda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110502,
					"content": "¿Acaso quería enviarla a su tribu? Aunque... el exterior de la carta está en un estado deplorable. Sería mejor devolvérsela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110503,
					"content": "Aún tengo que organizar los paquetes de la tienda. ¿Podrías encargarte tú de devolverle la carta a la Srta. Tirda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 751110504,
					"content": "Ella actúa en el Ocaso Dorado. La encontrarás fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikika"
