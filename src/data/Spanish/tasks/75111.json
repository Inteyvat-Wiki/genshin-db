			"dialogs": [
				{
					"id": 751111401,
					"content": "Ah, pues sí que es mi paquete. Alguien en los Vástagos del Eco quería comprar pigmentos, aunque no dejó muy claro qué colores quería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "Por eso le envié este paquete con muestras de varios pigmentos. Así la próxima vez que quisiera comprar mis productos, tendría una mejor idea sobre los colores que necesita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Tendré que reenviarlo rápidamente, antes de que se le ocurra venir con alguna otra idea estupenda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Acepta esto, por favor. Gracias por devolverme el paquete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
