					"nextDialogs": [
						100031303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100031303,
					"content": "¿Oh? ¿Qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031304
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 100031304,
					"content": "¡¿Qué?! ¡¿De dónde ha salido todo este Mora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031305
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 100031305,
					"content": "Eh... Bueno, la cosa es que... ¡Ah, sí! El Sr. Noveno admira verdaderamente tu trabajo, así que ha decidido financiar tu trayectoria como escritor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100031306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100031306,
					"content": "¿Cómo? Así que imaginar que era el Sr. Noveno acabó funcionando... ¡No puedo creerlo!",
