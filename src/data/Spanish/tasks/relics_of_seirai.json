			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Fujiwara Toshiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "G-gracias... ¡Uf! Y pensar que esos tipos querían asaltarme mientras estaba desprevenida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620102,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "Me llamo Fujiwara Toshiko, y vine a... Ehmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620105,
					"content": "Bueno, no importa. Ya que me rescataron, no hace daño si se lo cuento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620106,
					"content": "En realidad, vine a buscar un tesoro que mis ancestros dejaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620107,
					"content": "¡U-un tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721620108,
					"content": "¿Lo encontraste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "¡Jajaja! ¡Por supuesto! Seguí las pistas para llegar a la ubicación del tesoro, y encontré una forma de entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620110,
					"content": "Pero justo cuando iba a activar el interruptor y entrar, esos monstruos me emboscaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620111,
					"content": "Estoy en deuda con ustedes por haberlos ahuyentado. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620112,
					"content": "Me da vergüenza pedirlo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620113,
					"content": "¿Me protegerían por un tiempo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620114,
					"content": "Todavía tengo que encontrar ese tesoro, pero no creo que pueda lidiar con todos esos monstruos yo sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620115,
					"content": "Si así lo desean... ¡compartiré una parte del tesoro con ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620116,
					"content": "¿De verdad hay un tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "¡Seguro que sí! ¡Confíen en mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620119,
					"content": "Incluso encontré el interruptor con el que podemos entrar al lugar del tesoro. Está justo ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620120,
					"content": "Sin embargo, parece que el mecanismo no se activa directamente. Necesita un método especial para activarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620121,
					"content": "Tengo conmigo un mapa que me dejaron mis ancestros. Contiene pistas sobre cómo hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620122,
					"content": "Es solo que... no he averiguado cómo. Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620123,
					"content": "Tomen, ¿por qué no le echan un vistazo? Quizás puedan resolverlo ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620124,
					"content": "*Suspira*... ¿Cómo se supone que debo resolver este acertijo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620117,
					"content": "¿De verdad puedes encontrarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
