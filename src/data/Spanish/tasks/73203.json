						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "¡Muchas gracias, de verdad! Me haría tan feliz ver rosas de Sumeru en medio de este erial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030302,
					"content": "Mientras hablas con Sabah, nuevas hojas comienzan a brotar...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "Las hojas se abren y revelan unos enormes capullos.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "Poco a poco, los capullos se abren, floreciendo hasta convertirse en hermosas rosas de Sumeru.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Sabah recoge una rosa y se la entrega a Paimon y a ti.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "Ay, Sabah, si solo tienes unas pocas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030307,
					"content": "No importa. Después de todo lo que me han ayudado, esta flor les pertenece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030308,
					"content": "No fue nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "Un jardín de rosas es impresionante, pero una rosa también es bella por sí misma. Siempre me fascinaron las rosas, incluso cuando era una erudita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030311,
					"content": "¿Qué? ¿Eras una erudita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030312,
					"content": "Ah, claro, no se lo había dicho. Yo no soy de la Aldea Aaru. Antes vivía en la Academia, pero acabé en este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030313,
					"content": "Ya decía Paimon que Sabah hablaba muy cultamente, como los eruditos de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030314,
					"content": "Las plantaste porque querías seguir investigando sobre el tema, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030315,
					"content": "No exactamente. Los eruditos no cultivamos nuestro interés por nuestros objetos de estudio solo para investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030316,
					"content": "Lo hice porque verdaderamente adoro este mundo y quiero contribuir al ciclo de la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030317,
					"content": "Antes me dedicaba a investigar el impacto de la orografía de Sumeru en la evolución de las rosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030318,
					"content": "Piénsalo, si el medio ambiente en Sumeru no se hubiera desarrollado como lo hizo, ¿cómo habrían evolucionado las rosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030319,
					"content": "¿Se habrían convertido en plantas trepadoras? En ese caso, la Academia hubiera estado cubierta de rosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030320,
					"content": "¿Formarían racimos de flores? ¡Como un ramo natural! ¡Eso sí que sería increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030321,
					"content": "Incluso serían de diversos colores. Blancas, rojas, doradas... Una nueva especie en toda regla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030322,
					"content": "Aunque eso es muy difícil, claro. Ya casi no se descubren nuevas especies como hacían antes los eruditos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030323,
					"content": "Lo que quiero decir es que una sola rosa posee un gran potencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030324,
					"content": "Explorar todas las posibilidades es todo un disfrute. Cuando todavía era una erudita, me encantaba recoger muestras cada día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030325,
					"content": "Ahora que lo pienso, era tan inocente y feliz en aquel entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030326,
					"content": "Por eso me gustaría que la aceptaran. No estoy perdiendo una rosa, la estoy compartiendo gratamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030327,
					"content": "Si quieren agradecérmelo, siempre pueden volver a visitarme y traerme más rosas de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030328,
					"content": "Es agradable hablar con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030329,
					"content": "No importa lo que diga, ustedes nunca me juzgan por ello ni me interrumpen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030330,
					"content": "También les he preparado un par de obsequios más. A mí ya no me sirven, pero puede que a ustedes sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030331,
					"content": "Vendremos a visitarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Eso espero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030309,
					"content": "Fue un placer ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
		{
			"id": 7320304,
