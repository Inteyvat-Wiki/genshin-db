			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "¡Han vuelto tal y como prometieron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030102,
					"content": "He preparado pollo con mantequilla, deberían quedarse a cenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030103,
					"content": "¡Pollo a la mantequilla! ¡Paimon se va a comer el pollo entero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030104,
					"content": "Paimon, eso no está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "Oh... Paimon lo siente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030107,
					"content": "No te preocupes, no tienen que ser tan formales. Es natural que te guste comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030108,
					"content": "Les calentaré un par de raciones para que se las lleven. Es lo mínimo que puedo hacer para agradecerles su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030109,
					"content": "¡Eres muy amable, Sabah! ¡Seguro que tus flores serán las más bonitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030110,
					"content": "Eso espero. Últimamente estoy teniendo mucho cuidado de fertilizar la tierra y parece que están creciendo bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030111,
					"content": "El problema es que crecen muy lento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030112,
					"content": "En términos generales, si la semilla es buena, ya deberían haber florecido. Pero llevan tanto tiempo aletargadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030113,
					"content": "Tal vez el problema sea la falta de nutrientes del terreno. Tal vez tenga que volver a usar fertilizante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030114,
					"content": "Deberías fertilizar más la tierra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Entonces, ¿te importaría hacerlo tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030117,
					"content": "No hay problema, será pan comido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030115,
					"content": "Podemos probar con energía Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Lo siento, Paimon siempre es así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
