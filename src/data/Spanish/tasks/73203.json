				"points": []
			},
			"dialogs": [
				{
					"id": 732030401,
					"content": "No tienes una Visión como tal, pero eres capaz de controlar el elemento Dendro. Eres una persona fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030402,
					"content": "Algunos dicen que hay personas capaces de dominar los elementos sin poseer una Visión, pero pensaba que los rumores eran infundados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030403,
					"content": "Eres una buena persona, ¡así que no te dejes corromper por tu poder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		}
	]
}