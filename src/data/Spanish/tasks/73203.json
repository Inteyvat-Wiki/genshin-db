			"trigger": {
				"objectNames": [
					"Sabah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "Si no fuera por ustedes, creo que jamás tendría la oportunidad de ver las rosas florecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930502,
					"content": "Debería haberme traído mis libros conmigo, no las semillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930503,
					"content": "¿Eh? ¿Es que no eres de por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "#¿Sorprendid{F#a}{M#o}s? Jaja, supongo que eso significa que me he adaptado bastante bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930505,
					"content": "Cuando llegué aquí, no me acostumbraba a nada, ni la comida, ni el ambiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930506,
					"content": "Pero supongo que con el tiempo lo he ido asimilando todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930507,
					"content": "Aunque eso no quiere decir que esté satisfecha con el entorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930508,
					"content": "Supongo que simplemente no se puede hacer que las flores de la Ciudad de Sumeru germinen aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930509,
					"content": "¿Eres una erudita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "Bueno... Lo fui, una vez, pero ya no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930511,
					"content": "Dije algo que alguien de mi nivel no debería haber dicho y aprendí algo que no debería haber aprendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930512,
					"content": "Violé uno de los tabús de la Academia y me expulsaron por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930513,
					"content": "¿Qué fue lo que dijiste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "La curiosidad es vital para el aprendizaje, pero... también mató al gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930515,
					"content": "Yo lo aprendí demasiado tarde, cuando ya me habían exiliado a este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930516,
					"content": "Así que por su propia seguridad, no entraré en más detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930517,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "*Ejem*, bueno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930535,
					"content": "Pensaba que los aventureros se limitaban a hacer el trabajo lo antes posible para seguir con su camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930536,
					"content": "No sabía que había aventureros tan habladores como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930537,
					"content": "Lo cierto es que no tengo la oportunidad de hablar con mucha gente aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930538,
					"content": "Si tienes tiempo, ¿podrías pasarte mañana y fertilizarlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930539,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "#Bien, l{F#a}{M#e}s estaré esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930519,
					"content": "¿Por qué quieres cultivar rosas de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "Tal vez no lo sepas, pero son muy versátiles. Tienen una gran cantidad de usos y aplicaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930521,
					"content": "Son comestibles, se usan en remedios medicinales, como obsequios y también se venden a buen precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930522,
					"content": "Y esas solo son sus principales aplicaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930523,
					"content": "Pero las rosas de Sumeru no siempre han sido tal y como las conocemos ahora. Tanto las hojas, como los pétalos y los tallos han tenido formas muy diferentes a lo largo del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930524,
					"content": "Creo que los cambios orográficos fueron los que propiciaron esos cambios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930525,
					"content": "Podemos trazar un esquema orográfico e histórico si rastreamos esos cambios a lo largo de su evolución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930526,
					"content": "#Aunque todo esto requiere de un largo proceso de investigación y compartir dicha información con simples aventurer{F#a}{M#o}s también podría suponer una violación de las normas de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930527,
					"content": "Si les interesa la evolución botánica, deberían pasarse por la Academia. Allí cuentan con más recursos al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930528,
					"content": "¿Eso quiere decir que estás llevando a cabo una investigación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "Ya no soy investigadora, no puedo llevar a cabo investigaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930530,
					"content": "#¿Por qué quieren saberlo? Son realmente curios{F#a}{M#o}s, ¿saben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930531,
					"content": "Solía cultivar rosas de Sumeru en mi antigua residencia. Eran preciosas y me gustaba contemplarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930532,
					"content": "Si es posible, me gustaría volver a verlas cada día, tal y como hacía entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930533,
					"content": "Eso, lo hago solo por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 731930534,
					"content": "Lo entiendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
