			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neuvillette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "Y es un placer compartir recuerdos del pasado con usted, Srta. Guillotin, mientras disfrutamos de esta maravillosa taza de agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Quedémonos sentados así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510204,
					"content": "Muy bien. Adondequiera que vaya, le deseo un buen viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
}