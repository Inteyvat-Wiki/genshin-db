				]
			},
			"dialogs": [
				{
					"id": 742510101,
					"content": "Muchas gracias por la invitación, Srta. Guillotin. ¿Supongo que esta agua pura la ha preparado especialmente para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510102,
					"content": "No es nada. Es un honor para mí que su señoría Neuvillette, el juez supremo de Fontaine, haya sacado tiempo de su apretada agenda para acompañarme a tomar una taza de... agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510103,
					"content": "¿Tienen los Fatui algún asunto oficial que desee tratar conmigo, Srta. Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510104,
					"content": "Para nada. Se trata de una visita estrictamente personal. Y no hace falta que sea tan formal. Solo quería preguntarle por un viejo conocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510105,
					"content": "Un viejo conocido... Ah, ¿se refiere al Sr. Alain Guillotin, el grandioso rey de la mecánica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510106,
					"content": "Exacto. ¿Qué tipo de persona era? He oído que fue subordinado suyo cuando aún era joven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510107,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510108,
					"content": "El Sr. Guillotin era un joven serio y sensato. Incluso después de que le concedieran el título de Caballero Blanco Patrio, nunca mostró ni una pizca de arrogancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510109,
					"content": "Pasaba la mayor parte del tiempo estudiando máquinas. El mundo fuera de su pequeña realidad le interesaba muy poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510110,
					"content": "¿Así que ya era así de joven? Me pregunto si era más maduro de lo que le correspondía por su edad o si simplemente desconocía cómo funcionaba el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510111,
					"content": "Sin embargo... cambió radicalmente tras perder a su familia y a sus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510112,
					"content": "La Torre de la Gestalt... Y también Elynas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510113,
					"content": "Así es. Cuando él y yo firmamos la orden de registro de la Torre de la Gestalt, parecía como si... no supiera qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510114,
					"content": "Fue el distanciamiento y la indiferencia del pasado lo que provocó todo eso. Seguro que él también se sentía culpable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510115,
					"content": "Mhm. A partir de entonces, se volvió aún más reservado y nuestras conversaciones se hicieron menos frecuentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510116,
					"content": "En la ceremonia en la que se le concedió el título de “rey de la mecánica”, lo único que dijo fue:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510117,
					"content": "“Una vida tranquila y humilde es un camino más seguro hacia la felicidad que la búsqueda ciega de una perfección sin fin”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510118,
					"content": "Je... Y así fue exactamente como vivió en sus últimos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510119,
					"content": "Supongo que no lo decía solo para la gente. Se lo decía a sí mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510120,
					"content": "¿Y qué opina usted de todo esto, Srta. Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510121,
					"content": "¿Yo? Hum. No voy a juzgar la epifanía que tuvo ni su forma de vida, igual que él nunca me dijo cómo debía vivir la mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510122,
					"content": "Pero no tengo ninguna intención de seguir sus pasos ni de imitar sus ideales. Yo soy yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510123,
					"content": "Je... Gracias. Me ha ayudado a comprenderlo mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510124,
					"content": "De nada. Es un placer compartir historias del pasado con alguien de su familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
