				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "El Dragón del Este, la Leona del Sur, el Lobo del Norte, el Halcón del Oeste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081402,
					"content": "Ellos son los protectores de los Cuatro Vientos de Mondstadt, y están relacionados con Barbatos, el Arconte Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081403,
					"content": "Dvalin... ese es el verdadero nombre de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081404,
					"content": "Alguna vez, antes de que la gente le pusiera ese sobrenombre, fue el Dragón del Este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081405,
					"content": "Es por eso que Dvalin solo puede canalizar tres de los Cuatro Vientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081406,
					"content": "Porque desde el principio se ha ido consumiendo a sí mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081407,
					"content": "¿Por qué haría algo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "Supongo que por odio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081410,
					"content": "¿Odio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081411,
					"content": "Odio hacia Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081412,
					"content": "Impulsado por el odio, se volvió más poderoso que el propio viento y, así, se convirtió en Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081413,
					"content": "Pero ¿por qué uno de los Cuatro Vientos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081414,
					"content": "... odiaría la ciudad que debía proteger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081415,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081416,
					"content": "Como habitante de Mondstadt, es difícil hablar del tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081417,
					"content": "#Toma, puedes leerlo por ti mism{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081408,
					"content": "¿Qué lo motivó a hacerlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
