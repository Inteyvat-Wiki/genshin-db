			"dialogs": [
				{
					"id": 3081301,
					"content": "Incluso estando aquí fuera, puedo sentir una perturbación en el flujo elemental ahí dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081302,
					"content": "Restauremos este templo a su estado normal para que pueda estar tranquila.",
					"roleType": "TALK_ROLE_NPC",
