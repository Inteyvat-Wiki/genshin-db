			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rolf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "#¡Aléjate, compañer{F#a}{M#o}! Este lugar es muy peligroso. Si aparece la Cacería salvaje, no me quedarán fuerzas para protegerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "¿Cómo sabes que va a aparecer la Cacería salvaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "Como Lamparero que soy, es mi responsabilidad enfrentarme a la calamidad de la Cacería salvaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "¿Ves esa piedra sellomarea de al lado? Si quiero asegurarme de que la Cacería salvaje ha sido erradicada, tendré que vigilarla durante tres días y tres noches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "¿Piedra sellomarea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "La piedra sellomarea es un sello que colocamos los Lampareros para disipar el miasma de la Cacería salvaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "Aunque no sé muy bien cómo funciona, normalmente, el miasma que permanece en los sitios donde apareció la Cacería salvaje puede volver a atraer a los monstruos fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "Por ese motivo, cuando conseguimos repeler la Cacería salvaje, colocamos estas piedras sellomarea. Así, si vuelve a aparecer la Cacería salvaje en las inmediaciones, estas pueden protegernos durante el combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "Yo no le temo a la Cacería salvaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "No sé de dónde sacas esa confianza, pero te advierto de que la Cacería salvaje no es algo que se pueda tomar a la ligera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Hazme caso, si encuentras un lugar con una piedra sellomarea, lo mejor será que extremes precauciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "Bien, no te molesto más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Está bien, cuídate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
