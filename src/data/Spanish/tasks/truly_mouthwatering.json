					{
						"sceneId": 3,
						"position": [
							2904.566,
							441.616,
							4182.956
						],
						"pointId": 5746
					}
				]
			},
			"dialogs": [
				{
					"id": 741210701,
					"content": "... ¿Cómo? ¿Entonces nunca quisieron matarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210702,
					"content": "*Suspira*, ustedes no se pierden ningún detalle. Es cierto, ¡fui yo quien rompió la máquina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210703,
					"content": "Pero ¿por qué la rompiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210704,
					"content": "Obviamente fue porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210705,
					"content": "Hace mucho tiempo, solía vivir una vida muy infeliz. No había día en el que no me sintiera un desgraciado. Entonces conocí a un buen hombre que me dio a beber una bebida saludable que me ayudaría a recuperar la vitalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210706,
					"content": "Él me trataba muy bien, así que quise devolverle el favor. Con el tiempo, ¡llegó mi oportunidad de agradecerle lo que hizo por mí! Me pidió que ayudara a unos peces gordos que él mismo me presentó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210707,
					"content": "Yo me ocupaba de algunos trabajos manuales, como recoger componentes mecánicos del Instituto de Ciencias de Fontaine. A cambio, me recompensaban con buenas sumas de dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210708,
					"content": "¿Ese trabajo está tan bien pagado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210709,
					"content": "¿A que es sorprendente? Esta vez me pidieron que encontrase una máquina extraña y que se la entregase. ¡Así podía matar dos pájaros de un tiro! ¡Podría ganar dinero y devolverle el favor a ese hombre! ¿Cómo no iba a esforzarme por conseguirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210710,
					"content": "Pero esos tipos malvados... Quizá sea porque les disgustaba verme esforzándome en mi trabajo y dando un cambio radical a mi vida, ¡pero se opusieron y me advirtieron que no debería llevarme esos componentes tan sofisticados para mis jefes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210711,
					"content": "¡Pero no podía permitir que se salieran con la suya! ¡No solo cumplí con mi misión, sino que además protesté contra sus atrocidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210712,
					"content": "Y al final, como han dicho, me dieron una buena lección...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210713,
					"content": "Oh, pobrecito... Pero ¿en serio ganas tanto con este trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210714,
					"content": "Por supuesto. Es por eso que no quería decirles los motivos de mi protesta. Pero dado que ustedes me salvaron la vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210715,
					"content": "En realidad, tu vida no estaba en peligro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "#Yo también pensé que no podría engañarl{F#a}{M#o}s a ustedes, por lo que es mejor que les cuente la verdad. Podríamos tomarlo como una especie de colaboración especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210717,
					"content": "Alguien ha colocado esas extrañas máquinas dentro y fuera del agua. Son fáciles de detectar, pues emiten una luz muy peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210718,
					"content": "Acaben con ellas y entréguenme los núcleos que conservan en su interior. Hay un total de <color=#00E1FFFF>7 máquinas</color>. Cuando hayamos terminado, la mitad de la recompensa será para ustedes y la otra mitad para mí. ¿Trato hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210719,
					"content": "Suena a un buen plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "Oh, ¿pero qué es lo que hacen estas máquinas exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210725,
					"content": "Destrozan el entorno. Son máquinas supernocivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210726,
					"content": "¿Y cómo lo destrozan exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210727,
					"content": "¿Y yo qué voy a saber? Yo no soy un investigador del Instituto de Ciencias de Fontaine. ¡Si han provocado anomalías, debe de ser porque dañan el entorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210728,
					"content": "Hum... La verdad es que tiene razón. Cada vez que nos encontramos algún fenómeno extraño en la naturaleza durante nuestro viaje suele ser porque ha sucedido algo extraño que tenemos que resolver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210729,
					"content": "#{NICKNAME}, ¡vayamos a ayudar a Henri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210730,
					"content": "Jaja, muy bien. ¡Pues así lo acordamos! ¡<color=#00E1FFFF>Tráiganme los 7 núcleos</color> y nos repartiremos la recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210721,
					"content": "¿Qué es lo que hacen estas máquinas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "El 70% de la recompensa es para mí, y un 20% debe ser pagado por adelantado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "... *Suspira*, está bien. Pero no puedo entregarte la parte que pides por adelantado. ¡Tengo que esperar a reunir lo que me piden para poder hacer cuentas con el jefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210724,
					"content": "Oh, ¿pero qué es lo que hacen estas máquinas exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				}
			]
		},
