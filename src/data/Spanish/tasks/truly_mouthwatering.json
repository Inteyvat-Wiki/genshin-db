			"dialogs": [
				{
					"id": 741210601,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210602,
					"content": "Ay... Yo no... Solo es un tratamiento de belleza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210603,
					"content": "¡Vaya! ¿Ustedes cuándo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210604,
					"content": "Estamos paseando. Pasear es una forma de hacer ejercicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210605,
					"content": "El ejercicio implica movimiento. Nosotros nos movimos hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210606,
					"content": "¿Lo han hecho ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "Y qué pasa si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210608,
					"content": "#Hunter, ya me acuerdo... Míral{F#a}{M#e} bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210610,
					"content": "#Es {F#la tipa}{M#el tipo} que mencionaron. Será mejor que no l{F#a}{M#o} provoquemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210611,
					"content": "#Sí, es {F#ella}{M#él}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210612,
					"content": "¿De qué están hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210613,
					"content": "No estamos hablando de nada, solo estamos paseando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210614,
					"content": "Eso es. Solo estamos paseando. Si eso es todo, entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210615,
					"content": "Continuaremos paseando hacia otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210616,
					"content": "¿Eh? ¿Ya no piensan hacer conmigo algo horripilante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210617,
					"content": "Creo que ya has aprendido la lección. ¿Sabes a lo que me refiero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210618,
					"content": "¿Qué lección?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Ninguna. Estaba refiriéndome al pollo a la parrilla, es un auténtico peligro. El pollo a la parrilla atrae extrañas criaturas. Sin duda se trata de una lección valiosa. Nos vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210620,
					"content": "Pero... el pollo a la parrilla es... Debord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210621,
					"content": "¡Olvídate del pollo a la parrilla! Sigamos paseando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210622,
					"content": "“A la próxima le pedimos a Sonny que nos invite a comer pollo a la parrilla”, exclama Turner mientras se marcha junto a Hunter.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "¡Gracias! ¡Muchas gracias! ¡Sabía que ustedes comprenderían lo que estaba tratando de decir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210624,
					"content": "#Entonces es justo como ha mencionado {NICKNAME}... ¡Rápido! ¡Desenterremos a Henri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210625,
					"content": "#Pero para eso se necesita mucha energía... ¡Así que el pollo a la parrilla será para nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210626,
					"content": "¿AH? Rayos... Supongo que no tengo otra alternativa... ¡Está bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210627,
					"content": "Invierten un buen rato en desenterrar a Henri de la arena y lo liberan de un barril que no saben por qué motivo llevaba alrededor de su cuerpo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "Paimon y tú comienzan a degustar el pollo a la parrilla.\\nParece que Henri también quería comer, pero tal y como prometió, lo reservó para que ustedes repusieran fuerzas.\\nNo obstante, tras ver la expresión hambrienta de Henri, Paimon decide repartir el pollo con él también.\\nLa piel del pollo asado, crujiente y deliciosa, desprende un sabroso aroma a grasa. ¡Este pollo es todo un manjar!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
