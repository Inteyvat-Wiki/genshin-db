			},
			"dialogs": [
				{
					"id": 741210801,
					"content": "¡Libertad, dulce libertad! Aunque no sabe tan bien como el pollo a la parrilla, ¡también es superdulce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210802
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210802,
					"content": "... Entonces, ¿qué quiere decir lo que pone en ese cartel que sostienes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210803,
					"content": "¿Hum? Oh, eso. Aquí dice “protesta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210804
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210804,
					"content": "¿Y contra qué protestas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210805
					]
				},
				{
					"id": 741210805,
					"content": "Oh, ¿cómo explicarlo?... Esos tipos me enterraron en la arena para que no tuviera que trabajar demasiado, ¡así que protesto contra ello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210806
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210806,
					"content": "¿Ah? ¿Y por qué va a haber alguien que no quiera que trabajes demasiado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210807,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210808
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210808,
					"content": "¿Pueden guardarme un secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210809
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210809,
					"content": "¡Sí! ¡Por supuesto que sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210810,
					"content": "Entonces yo también me comprometí a guardar el secreto. No se lo puedo contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210811
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210811,
					"content": "¡OYE! ¡Será posible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210812,
					"content": "Mejor hablemos de otra cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210813
					]
				},
				{
					"id": 741210813,
					"content": "Bueno... Entonces, ¿nos vas a contar qué hacías con este barril puesto? ¿Vestirse con un cubo es también una forma de protesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210814,
					"content": "¿Ah? Pues yo tampoco lo sé... Antes de que me enterrasen, me vistieron con este barril, ¡qué mal gusto para la moda tienen algunos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210815
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210815,
					"content": "¿Y por qué crees que te enterraron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210816,
					"content": "¡Porque son personas terribles! ¡Me atraparon sin ningún motivo y me enterraron en la arena! ¡Esos tipos querían matarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210817
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210817,
					"content": "¿Seguro que fue sin motivo aparente?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210818
					]
				},
				{
					"id": 741210818,
					"content": "¡P-por supuesto! ¡¿Te parece poco?! ¡Me han enterrado en la arena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210819
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210819,
					"content": "Si no quisieran matarme, ¿por qué me enterrarían en la arena?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210820
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210820,
					"content": "#Oh, tiene sentido lo que dice... {NICKNAME}, ¿tú qué piensas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
