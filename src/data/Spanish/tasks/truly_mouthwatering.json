						],
						"pointId": 5964
					}
				]
			},
			"dialogs": [
				{
					"id": 741210101,
					"content": "#¡Gracias, gracias! ¡Mil gracias! ¡Ustedes son mis salvador{F#a}{M#e}s! ¡Les juro como que me llamo Henri que nunca olvidaré lo que han hecho por mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210102,
					"content": "No hay de qué. Lo que a Paimon le da curiosidad es cómo acabaste en una situación como esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210103,
					"content": "*Suspira*, esos cangrejos debieron de venir atraídos por el aroma del pollo a la parrilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210104,
					"content": "Paimon también llegó aquí siguiendo el rastro del olor a pollo a la parrilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210105,
					"content": "¡Pero los cangrejos no son como tú! Esos cangrejos estaban pensando si comerme primero a mí o al pollo. Me horroriza pensar que podrían haberse decantado por la opción de carne fresca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210106,
					"content": "En realidad tiene sentido... La carne, cuanto más fresca, mejor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "*Suspira*... Paimon estaba preguntando por ti, Henri, ¡no por los cangrejos! ¿No te parece raro que alguien acabe enterrado en el suelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210108,
					"content": "¿Necesitas ayuda o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210111,
					"content": "Por supuesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210112,
					"content": "#Eh... ¡No! ¡Quiet{F#a}{M#o}s! ¡No necesito que me desentierren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210113,
					"content": "#Bueno, bueno, como quieras, ¡ya lo hemos captado! ¡A Paimon no le grites! Andando, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210114,
					"content": "Un momento, esperen... Hay algo que podrían hacer por mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210115,
					"content": "¿Eh? ¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210116,
					"content": "Yo... *Suspira*... *EJEM*... Lo que pasa es que... ¡Escúchenme bien! ¡Esto es un tratamiento de belleza que yo mismo he inventado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210117,
					"content": "¿No te acaba de decir Paimon que no le grites? ¡Qué tipo tan escandaloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210118,
					"content": "¡Tómense en serio lo que les estoy diciendo! ¡Les aseguro que soy una persona perfectamente cuerda que ha decidido probar un tratamiento basado en la ciencia que trae beneficios para la salud y la apariencia física! ¡Y por eso me enterré aquí yo mismo sin ayuda de nadie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210119,
					"content": "¿A qué esperan para largarse de aquí? ¿No ven que me están tapando el sol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210120,
					"content": "Eh... Pues nada, nos vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210121,
					"content": "Pero ya que insisten tanto, ¡no tendré más remedio que explicarles de qué se trata mi ingenioso tratamiento de belleza! ¡Escúchenme bien! *Ejem*, resulta que los gusanos y otras formas de vida que conviven en la arena son capaces de limpiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210122,
					"content": "(Por los Arcontes, cuánto grita este tipo... Pero ¡¿qué le pasa?! Paimon no entiende nada...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210123,
					"content": "#(Decir que este tipo es raro... es quedarse cort{F#a}{M#o}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "(Totalmente de acuerdo. ¿Se te ocurre algo?...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210125,
					"content": "(Veamos qué nos encontramos por los alrededores.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "¿Eh? ¿Ya se van?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210127,
					"content": "Vamos a ver qué hay por esta zona, enseguida volvemos por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210128,
					"content": "¡Bien! ¡Váyanse corriendo entonces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210109,
					"content": "Yo también me pregunto qué haces ahí enterrado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "¡Eso es! ¿No quieres que te ayudemos a salir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
