			"dialogs": [
				{
					"id": 741210301,
					"content": "¡Holi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210303
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210304
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210304,
					"content": "¡Oigan! ¡Está feo eso de ignorar a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210305,
					"content": "... Hola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210306,
					"content": "Qué buen tiempo hace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210307,
					"content": "¿Conocen al tipo ese de allí?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "¿Qué tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210309,
					"content": "No sabemos de qué tipo nos hablas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210310,
					"content": "Nosotros solo estamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210311,
					"content": "... De paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210312,
					"content": "Eso. Nosotros solo estamos aquí de paseo. Somos dos personas normales y corrientes dando un paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210313,
					"content": "Qué buen tiempo hace. El tiempo perfecto para dar un paseo, ¿no le parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210314,
					"content": "Pasear es una actividad común, algo que hace todo el mundo. Seguro que usted lo comprende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210315,
					"content": "Eh... ¿Pero qué diantres están diciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210316,
					"content": "¿No escucharon a alguien pidiendo ayuda? Allí hay un tipo enterrado en la arena, por poco se lo comen los cangrejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210317,
					"content": "Oh, ¿nos está diciendo que eso ha sucedido precisamente en el lugar donde nosotros estamos paseando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210318,
					"content": "Ha sucedido con este tiempo tan magnífico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210319,
					"content": "Si esos cangrejos lo hubieran devorado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210320,
					"content": "Habría sido una escena muy cómica. Oh, quería decir... dramática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210321,
					"content": "Qué pena que nosotros no vayamos a permitir que eso suceda. Quiero decir que... no podemos permitirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210322,
					"content": "Si nos lo encontráramos mientras damos nuestro paseo, puede estar seguro de que lo impediríamos. Eso si nos lo encontráramos, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210323,
					"content": "¿Qué están haciendo ustedes aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "Dando un paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210325,
					"content": "Ya le hemos dicho que estamos dando un paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210326,
					"content": "¿De verdad no han visto nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210327,
					"content": "Nada de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210328,
					"content": "#En absoluto. Solo hemos visto a un par de tip{F#a}{M#o}s que han interrumpido nuestro delicioso paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210329,
					"content": "Pasear es un asunto muy... personal. No nos gusta que interrumpan nuestros paseos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210330,
					"content": "Les aconsejamos que ustedes busquen también un lugar donde pasear. La Fontana Lucine es una buena opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210331,
					"content": "Este es el lugar donde paseamos nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210332,
					"content": "Así que nos gustaría que nadie nos molestase. Adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Turner"
				}
			]
		},
