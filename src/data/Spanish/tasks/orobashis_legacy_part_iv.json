					"nextDialogs": [
						721340102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721340102,
					"content": "Ay, mi investigación aún está lejos de dar sus frutos. O quizás estoy pensando demasiado y las ruinas del Bastión Mumei en realidad no tienen nada que ver con los altares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721340103,
						721340104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721340103,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721340105
					]
				},
				{
					"id": 721340105,
					"content": "¡Es el Bastión Mumei! ¡Está emergiendo del agua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721340106
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721340106,
					"content": "¡No podemos desaprovechar esta oportunidad! Vayamos a investigar.",
