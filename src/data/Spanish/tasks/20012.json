				"points": []
			},
			"dialogs": [
				{
					"id": 200120201,
					"content": "#Gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "La Asustadiza Myrana"
				},
				{
					"id": 200120202,
					"content": "*Suspira*, primero los monstruos y ahora este obstáculo... Ya hay bastante caos en mi casa como para salir y encontrarme con esto. ¡Y yo que pensaba que podría escapar de todo por un tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "La Asustadiza Myrana"
				},
				{
					"id": 200120203,
					"content": "Lo siento, pero ¿hay alguna posibilidad de que puedas deshacerte de este obstáculo por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "La Asustadiza Myrana"
				},
				{
					"id": 200120204,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "¡Gracias! Espero que mis dos hijos sean tan amables como tú cuando sean mayores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Asustadiza Myrana"
				},
				{
					"id": 200120205,
					"content": "#Lo siento, estoy un poco ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "Por favor... Te prometo que no te llevará mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Asustadiza Myrana"
				}
			]
		},
