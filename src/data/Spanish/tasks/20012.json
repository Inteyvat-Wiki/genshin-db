			},
			"dialogs": [
				{
					"id": 200120301,
					"content": "#Muchas gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "La Asustadiza Myrana"
				},
				{
					"id": 200120302,
					"content": "Pero no le digas a nadie que me metí en un aprieto, o mi esposo no dejará de sermonearme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "La Asustadiza Myrana"
				},
				{
					"id": 200120303,
					"content": "No me mires así... ¡Espera a casarte y verás! Pasear sola es un gran lujo cuando vives con alguien más. Tienes que aprovecharlo al máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "La Asustadiza Myrana"
				},
				{
					"id": 200120304,
					"content": "Ten esto. Recogí algunas mientras estaba fuera. ¡Es mucho más barato cocinar que comer en El Buen Cazador! Tienes que ahorrar si quieres sobrevivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Asustadiza Myrana"
				}
			]
		}
