				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "Ay... ¿Cómo es que pesa tanto esta caja...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "#Qué alegría verte de nuevo, investigad{F#ora}{M#or} sénior. Qué vergüenza... Es que... creo que me lastimé la espalda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "Hace un momento me dispuse a trasladar una caja para organizar todos los expedientes que contenía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "Y... no esperaba que fuese tan pesada, así que cuando la agarré, no me coloqué bien, y acabé soportando todo el peso con la parte inferior de la espalda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Y ahora... Me da la impresión de que se me va a romper... ¡Qué dolor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "¿Quieres que te lleve en brazos a ver a un médico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "No, no es necesario... No es la primera vez que me lastimo la espalda, solo necesito descansar un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "¿Pero cuántos expedientes hay ahí dentro? Sí que pesa la caja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "Pues tienen que ser... muchos, muchos expedientes. Creo que en la institución se promovía la doctrina de “dejar un rastro documental”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "En términos simples, lo que significa es que para todos los asuntos de investigación del Instituto se debe dejar una prueba de procesamiento en papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Como consecuencia de la implantación de esta doctrina, el consumo de papel de todo el Instituto de Ciencias se multiplicó directamente por cinco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "Además, dada la inmensa cantidad de documentos, cada departamento tuvo que crear un puesto de “responsable de compilación bibliográfica”, para administrar específicamente cada archivo en su categoría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "¿Entonces todo tiene que quedar por escrito en papel? Qué complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "Es inaudito. Al final, este estilo de trabajar acabó desapareciendo y solo se practica a pequeña escala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "#Pero no hablemos sobre eso. Investigad{F#ora}{M#or} sénior, ¿podrías trasladar mi caja de expedientes? Aunque me duele mucho la espalda, tengo que organizar los papeles que contiene enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Tómate un descanso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "No pasa nada, para organizar los papeles solo tengo que usar las manos, no la espalda. No te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Puedo llamar a alguien para que venga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
