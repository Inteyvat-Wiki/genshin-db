			"dialogs": [
				{
					"id": 738020101,
					"content": "#¡Ad astra abyssosque! ¡Bienvenid{F#a}{M#o} al Gremio de Aventureros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020102,
					"content": "Hola, Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738020103,
					"content": "Hola, Katheryne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "Hola, parece que se encuentran muy bien el día de hoy. ¿Vienen para aceptar un encargo o por otro asunto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020105,
					"content": "¿Eh? ¿Por qué me miran fijamente? ¿Hay algo que quieran preguntarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020106,
					"content": "¡No!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "#Veo que eres {F#una}{M#un} aventurer{F#a}{M#o} con mucha experiencia, ¿me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020109,
					"content": "Sí, algo así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "Entonces, ya deben conocer el funcionamiento del Gremio de Aventureros. No entraré en detalles para no quitarles mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020111,
					"content": "Si tienes cualquier duda sobre los asuntos del gremio, puedes preguntarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020112,
					"content": "#Intenta completar todos los encargos que puedas en la Ciudad de Sumeru. {F#Una}{M#Un} aventurer{F#a}{M#o} tan formidable como tú nos es de mucha ayuda a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020113,
					"content": "Eso es todo de mi parte. ¡Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020107,
					"content": "S-solo queríamos aceptar algún encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
