				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "*Suspira*, ¿qué debería hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030102,
					"content": "¿Tuviste algún problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "Desde que comenzó el Festival de las Flores de Viento, siempre hay gente que viene aquí a ofrendar todo tipo de flores al Arconte Anemo. Pero, en cuanto sopla el viento, los pétalos de las flores se dispersan por toda la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030104,
					"content": "Hemos hecho un gran esfuerzo en limpiar estas flores marchitas. Puedo hacerme cargo de las flores y hojas de la plaza, pero no puedo hacer nada con las que están en las azoteas y los muros de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030105,
					"content": "Especialmente con estas rodillas. Van de mal en peor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030106,
					"content": "Puedo ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "¿Quieres ayudar? Genial. Esos montones de pétalos marchitos son fáciles de identificar. Deberías poder verlos mejor una vez que subas a un tejado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
		{
