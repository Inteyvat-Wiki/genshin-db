				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "Lo siento mucho, creo que no lo he visto. Si lo hubiera visto, lo recordaría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030602,
					"content": "¿En serio? Es que le encantan los pétalos. Pensé que vendría hasta aquí siguiéndolos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030603,
					"content": "¿Están buscando a un gato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "¡Miau!... ¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Gato perdido"
				},
				{
					"id": 700030605,
					"content": "¿Es... Mariposa? ¡Oh, así que eres tú! ¿Dónde has estado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030606,
					"content": "Subió a la muralla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "Tal y como pensaba... Muchas gracias. A Mariposa siempre le ha gustado perseguir pétalos, y eso es un dolor de cabeza particularmente durante el Festival de las Flores de Viento, con pétalos flotando por toda la ciudad. Afortunadamente estabas tú para ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030608,
					"content": "La próxima vez que vengas a la taberna Cola de Gato, yo invito. Una bebida sin alcohol, por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030609,
					"content": "Ah, otra vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Jeje. Bueno, gracias por todo. Hasta luego y feliz Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030612,
					"content": "Nunca pensé que hasta los gatos se sentirían atraídos por los pétalos. El Festival de las Flores de Viento siempre está a reventar de gente. Por suerte, lo encontraste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030613,
					"content": "Si me hubieras pedido que escalara para rescatarlo, me temo que mis rodillas habrían flaqueado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030614,
					"content": "Perdón por las molestias. Acepta esta recompensa en agradecimiento, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030610,
					"content": "Mejor lo dejamos para otra ocasión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}