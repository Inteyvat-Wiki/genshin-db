			"dialogs": [
				{
					"id": 700030201,
					"content": "Ay... Escalones, tejados, subir, bajar... No sé cuántos años más podrán aguantar mis rodillas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
