			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310301,
					"content": "¡Oh, no era necesario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310302,
					"content": "Esta es una muestra de gratitud del Gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310303,
					"content": "Recibimos muchos encargos todos los días, y sin el esfuerzo de todos y cada uno de los aventureros, nos sería imposible hacerlos todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310304,
					"content": "Si completas suficientes encargos cada día, serás elegible para obtener una recompensa especial de mi parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310305,
					"content": "Tu Manual del aventurero mantiene un registro de la cantidad de encargos que has completado cada día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310306,
					"content": "No olvides recoger tu recompensa diaria los días que completes suficientes misiones. Las recompensas son limitadas, así que se perderá si no la recoges a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310307,
					"content": "Bueno. Gracias por la explicación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "#Eres más que bienvenid{F#a}{M#o}. Después de todo, eres tú quien me está ayudando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310312,
					"content": "Y ten en cuenta que ayudar a un compañero aventurero a completar un encargo también cuenta para su elegibilidad para una recompensa diaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310313,
					"content": "Los alentamos a que trabajen activamente con sus compañeros aventureros. ¡Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310309,
					"content": "¿Solo una recompensa por día?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "Tal como están las cosas actualmente, sí... Mis disculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310311,
					"content": "Pero ten la seguridad de que constantemente estamos presionando al Cuartel General para asegurarnos de que todos nuestros aventureros reciban una compensación justa y adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
