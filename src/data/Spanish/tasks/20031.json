					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "#Nos encontramos de nuevo, ávid{F#a}{M#o} aventurer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "¿Cómo vas con tus aventuras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "Me siento como pez en el agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "Ese es el espíritu. ¡Sigue así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "Parece que ahora tienes una gran experiencia en tu haber. Es hora de presentarte el trabajo formal del Gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "El Gremio recibe <color=#00E1FFFF>encargos</color> diarios de todos los rincones del mundo, y los asigna a los aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "Estos encargos son la principal fuente de compensación para nuestros aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "¿Qué tipo de encargos son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "¡Hay de todo! Cualquier cosa, desde hacer un mandado para un ciudadano hasta vencer monstruos. Algunos son de libro de texto, otros son extremadamente peligrosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "#Pero no confíes en mi palabra. Deberías averiguarlo por ti mism{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "Aquí puedes encontrar los detalles de los encargos de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "Por favor, ven a informarme cuando acabes. Habrá una generosa recompensa esperándote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "¡Déjamelo a mí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Excelente. Sabía que podía contar contigo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#Espero tu regreso con impaciencia, {NICKNAME}. ¡Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "¿De cuánta generosidad estamos hablando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "¡La paciencia es una virtud! Lo descubrirás pronto. Estoy segura de que no te decepcionará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "En realidad, ir de aventura es un trabajo bastante agotador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "Siempre es así cuando comienzas. Prepararse adecuadamente antes de una aventura puede ayudar a que todo salga mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
