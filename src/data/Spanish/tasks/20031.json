					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#¡Buen trabajo, {NICKNAME}! Excelente desempeño para ser tu primera vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "El que hizo el encargo me pidió que te diera las gracias en su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "Y, como prometí, aquí está tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003103,
			"completionStepIds": [
				2003104,
				2003107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
