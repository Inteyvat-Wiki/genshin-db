			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#Escuché algo cerca de la vid, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310402,
					"content": "Se dice que has completado un <color=#00E1FFFF>encargo del Gremio</color>. El solicitante envía su agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310403,
					"content": "¿Qué encargo del Gremio? Refresca mi memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310404,
					"content": "Ayudaste a alguien necesitado mientras estabas en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310405,
					"content": "De hecho, la mayoría de los que conocerás han solicitado ayuda del Gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310408,
					"content": "Déjame explicarte el sistema del Gremio con un poco más de detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310409,
					"content": "El Gremio recibe encargos diarios de todos los rincones del mundo, y los asigna a los aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310410,
					"content": "Estos encargos son la principal fuente de compensación para nuestros aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310411,
					"content": "Sobre el tema de la compensación, debo mencionar que el Gremio ha preparado algo para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310406,
					"content": "Solo estaba siendo un buen samaritano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310407,
					"content": "#Y eso es exactamente lo que te convierte en nuestr{F#a}{M#o} nuev{F#a}{M#o} ávid{F#a}{M#o} aventurer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
