							2684.435
						],
						"pointId": 330400551
					}
				]
			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "Están hasta la noche reuniendo más información de los habitantes de la Aldea Vimara...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "#Así que fue ese encargo el que l{F#a}{M#o}s trajo hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200124,
					"content": "Alguien que solo parece existir en la memoria... Sin duda, es muy interesante. Yo tampoco creo que se trate de un simple caso de desaparición, pero tampoco puedo afirmar que esté relacionado con la Orden del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200125,
					"content": "Parece que la única pista que tenemos es el aumento de la actividad de los Hilichurls, y tampoco es que eso signifique mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200126,
					"content": "Bueno, pues entonces es la hora de las respuestas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "#¡Eso! Esa misteriosa voz que {NICKNAME} escuchó en los recuerdos de su herman{F#o}{M#a}... La que dijo ser un “pecador”, ¿quién era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200129,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}, ¿acaso crees que... tu herman{F#o}{M#a} te ha traicionado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200131,
					"content": "#Quiero creer en {F#él}{M#ella}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "Humm... Percibo vacilación en tus palabras. Supongo que, después de todo, aún no sabes la verdad sobre lo que ocurrió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200134,
					"content": "Todavía no se han hecho un daño irreparable, así que aún están a tiempo de reconciliarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200135,
					"content": "No como ese pecador del que tanto quieren saber... Su situación es distinta. Él y los demás pecadores traicionaron tanto a su nación como a mí hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200136,
					"content": "Él es... Vedrfolnir “el Profeta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200137,
					"content": "No me gusta hablar de ello, pero... es familiar mío: mi hermano mayor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200138,
					"content": "¿Esa persona era tu hermano, Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200139,
					"content": "¿Qué ocurrió entre ustedes dos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "En total hubo cinco pecadores. Eran los Cinco Grandes Pecadores de Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200142,
					"content": "Hroptatyr “el Sabio”, Vedrfolnir “el Profeta”, Rhinedottir, también conocida como “Oro”, Surtalogi “el Caballero Protervo” y Rerir “el Cazador de la Luna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200143,
					"content": "Por mucho que se erosione mi memoria, nunca olvidaré esos nombres, porque algún día... me vengaré de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200144,
					"content": "¡Ya habíamos oído muchos de esos nombres! Rhinedottir es la creadora de Albedo, y Surtalogi es el maestro de Skirk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200145,
					"content": "Y el que nos acaba de decir, Vedrfolnir, el hermano de Dain... Si la voz de aquel pecador era la suya, ¡entonces él fue quien llevó a Clotario a crear la Orden del Abismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200146,
					"content": "Todo está misteriosamente conectado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "(En ese caso, ¿las placas proféticas que encontramos en aquellas ruinas de Fontaine eran obra de Vedrfolnir?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "Fueron personas muy admiradas en Khaenri'ah, así como la esperanza de la nación. Destacaban en sus respectivos campos y eran los mejores entre sus compañeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200149,
					"content": "El plan original era que yo también debería haber sido una de las seis personas que detuvieran la catástrofe y evitaran que el Rey Vinster hiciera temblar los cimientos del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200150,
					"content": "Sin embargo, en el fondo codiciaban algo más. No pudieron resistirse a la llamada del Abismo, por lo que se repartieron entre sí un poder capaz de destruir el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200151,
					"content": "Así, se convirtieron en pecadores, pero también en seres trascendentales que poseían el poder suficiente para acabar con el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200152,
					"content": "Cuando ocurrió la catástrofe de Khaenri'ah, ninguno de ellos defendió su nación y ninguno hizo nada para evitar la tragedia. Es por eso que nunca podré perdonarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200153,
					"content": "#Y ahí es donde entra mi herman{F#o}{M#a}, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "Así es. Si no los detenemos, llegará el día en que también traicionen al mundo entero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200156,
					"content": "Debe de ser muy duro para ti hablar de esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "No te preocupes. Como ya dije, nunca he tenido la intención de ocultarte nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200159,
					"content": "Bueno, Dain, ¿qué has estado investigando en todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200160,
					"content": "He seguido investigando todo lo relacionado con el Telar del Destino. Ya ha pasado mucho tiempo desde que comenzó la operación inicial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200161,
					"content": "Al obtener el ojo del primer Labrador del mundo, detuvimos parte del plan que tenían en aquel momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200162,
					"content": "Ah, Paimon lo recuerda. Querían usarlo para corromper a Osial y convertirlo en un dios o algo así, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200163,
					"content": "Sí, pero... es evidente que aquello solo era un experimento técnico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200164,
					"content": "Aunque no pudieron hacerse con el ojo del Labrador, lo cual era parte indispensable de su plan, se saltaron la fase experimental y encontraron otra forma de seguir adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200165,
					"content": "Hay muchos indicios que confirman esta hipótesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200166,
					"content": "¿Y qué podemos hacer? Aún estamos a tiempo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200167,
					"content": "La prioridad es... averiguar para qué sirve el Telar del Destino y, así, desentrañar el verdadero objetivo de la Orden del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200168,
					"content": "Por lo que he podido averiguar hasta ahora, sospecho que el Telar del Destino está relacionado con las líneas ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200169,
					"content": "¿Las líneas ley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200170,
					"content": "#{NICKNAME}, si pudiste ver los recuerdos de tu herman{F#o}{M#a}, fue debido a la inestabilidad de las líneas ley de aquella zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200171,
					"content": "Según mis últimas investigaciones, la presencia de la Orden del Abismo en una zona suele ir acompañada de problemas en las líneas ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200172,
					"content": "Y por las líneas ley de Teyvat... fluyen recuerdos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "Espera, entonces nuestro encargo en la Aldea Vimara y la persona que solo existe en la memoria de la gente... ¿Podría estar relacionado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200174,
					"content": "(Los recuerdos, las líneas ley, el Telar del Destino... y alguien que solo existe en la memoria de la gente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "(¿Cuál es la relación entre todo esto?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "Es posible. Mañana me uniré a su investigación. El caso de esta persona podría ser la clave para resolver estos misterios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200177,
					"content": "Pues si vamos a hacer equipo con Dain de nuevo, ¡necesitaremos recuperar tantas fuerzas como podamos! Mañana podríamos ir a un sitio más lejano a investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200401,
					"content": "*Bosteza*, Paimon usó demasiado su cerebro ayer y ahora tiene mucho sueño... Todo por culpa de Dain y sus asuntos complicados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200402,
					"content": "Yo tampoco he dormido muy bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "Vamos con Dain. Hoy hay muchas cosas que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200403,
					"content": "Tengo la cabeza hecha un lío.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "Gracias por contarnos todo esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "#Y entonces, mi herman{F#o}{M#a} estableció contacto con {F#el tuyo}{M#tu hermano}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "¿Qué pasó realmente en Khaenri'ah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "En cierto modo, sí, lo creo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "¿Qué hay de la información que prometiste contarme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
