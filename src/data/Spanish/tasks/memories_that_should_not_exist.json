			"dialogs": [
				{
					"id": 80200501,
					"content": "Parece que ya no podemos avanzar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200502,
					"content": "¡Cuidado! ¡Siento la presencia del Abismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "Dainsleif"
