			"dialogs": [
				{
					"id": 80200101,
					"content": "Un momento... Ese de ahí es... ¡Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200102,
					"content": "Oh, son ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200103,
					"content": "¿Es amigo suyo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80200104,
					"content": "Bueno, yo voy a ver cómo están el jefe Amadhiah y los demás en la aldea. ¡Nos vemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Atosa"
				},
				{
					"id": 80200105,
					"content": "¡Adiós, Atosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200106,
					"content": "¡Oye, tú! ¿Por qué siempre tienes que salir de la nada? ¿Es que tu propósito en la vida es asustarnos cada vez que apareces o qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200107,
					"content": "Nuestros caminos se cruzarán siempre que estén yendo tras la Orden del Abismo. No es algo que tenga que ver con mis intenciones personales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200108,
					"content": "Entonces, ¿estás aquí siguiendo a la Orden del Abismo? Eso explicaría por qué estabas luchando contra esos monstruos hace un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200109,
					"content": "Efectivamente. Un momento, ¿es que ustedes no están aquí por lo mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200110,
					"content": "Sí, también estamos siguiéndolos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "Bueno, aunque te haya costado entenderlo, seguro que ya te has dado cuenta de que aquí ocurre algo extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200113,
					"content": "Estoy convencido de que la Orden del Abismo está planeando hacer algo por esta zona, o peor aún... su plan podría estar ya en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200114,
					"content": "¿Crees que la Orden del Abismo está detrás de la actividad de los Hilichurls en la zona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200115,
					"content": "Tal y como están las cosas, dudo mucho que ese sea su objetivo principal. Como mucho, será una consecuencia del plan que tengan entre manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200116,
					"content": "Aun así, es algo que afecta a la Aldea Vimara. Paimon cree que deberíamos quedarnos un poco más para proteger a los aldeanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200117,
					"content": "La mejor forma de protegerlos es averiguar qué es lo que trama la Orden del Abismo. Solo así evitaremos futuras tragedias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200118,
					"content": "Veamos si los aldeanos nos cuentan algo más. Ya hablaremos tú y yo más tarde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "Nunca he tenido la intención de ocultarte nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200121,
					"content": "#Tranquil{F#a}{M#o}. Tenemos mucho tiempo para hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200119,
					"content": "Te recuerdo que aún me debes muchas respuestas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "La verdad es que nos los encontramos por casualidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
