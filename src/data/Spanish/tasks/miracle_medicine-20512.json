					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "Estas recetas son cada vez más extrañas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "¿Cómo está Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "¡Ah, eres tú! Tal vez no me creas, pero Anna dice que realmente está mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "¿Será que aquella medicina sí funcionó, después de todo? Ni yo me lo puedo creer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Pero aunque así sea, prefiero probarla yo primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "Para la receta de esta vez... Déjame ver... ¿Me ayudarías a encontrar un condensado de Slime Hydro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Comparado con la vez anterior, eso es incluso normal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "¿De verdad? A mí me parece aún más raro esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Pero es más fácil de encontrar. Pregunté a alguien dónde encontrarlo, y me dijo que se puede conseguir al derrotar un Slime Gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "También escuché a Jack decir que, para atraer a un Slime Gigante, primero hay que eliminar a los pequeños sin parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Yo no soy tan bueno peleando, así que, ¿podrías hacerlo tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "No te preocupes. Seguro que esta medicina será comestible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "¿Cómo lo sabes? ¿Tú ya la probaste? Oye, ¿por qué no dices nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Bueno, no importa. Los Slime Hydro son más fáciles de encontrar. Pregunté por el condensado y me dijeron que se puede encontrar al derrotar Slimes Gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "También escuché a Jack decir que, para atraer a un Slime Gigante, primero hay que eliminar a los pequeños sin parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Yo no soy tan bueno peleando, así que, ¿podrías hacerlo tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "No hay problema. Yo sé dónde están.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "¡Guau! ¡Sí que eres de fiar! Veo que sabes muy bien cómo hacer frente a los Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Entonces, ¿podrías ayudarme? Encontrarás condensado al derrotar Slimes Gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "También escuché a Jack decir que, para atraer a un Slime Gigante, primero hay que eliminar a los pequeños sin parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "Pues bien, te deseo la mejor de las suertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
