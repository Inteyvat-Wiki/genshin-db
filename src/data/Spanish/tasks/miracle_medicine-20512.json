			"dialogs": [
				{
					"id": 205120301,
					"content": "¿Encontraste lo que te pedí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "Oh... Sí, parece bastante... condensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120304,
					"content": "¿De verdad sirve para hacer medicina? Cuando la haga, la probaré primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120305,
					"content": "Si me ocurriera algo, ¿podrías encargarte de que Anna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120306,
					"content": "... estuviera a salvo con la hermana Grace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120307,
					"content": "Después, dile que fui a trabajar a un lugar muy lejos. ¿Lo harías? Es mi último deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120308,
					"content": "Por supuesto, pero no saques conclusiones precipitadas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "Es porque esta medicina me da un poco de miedo. En fin, acepta esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120310,
					"content": "¡Y no olvides mi deseo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
