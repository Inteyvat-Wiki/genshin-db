			"dialogs": [
				{
					"id": 790750401,
					"content": "¡Chauvigné! Ha-has venido... Escúchame, en ningún momento me enfadé contigo, ni tampoco quise abandonarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "Lo que me preocupaba... era que no quisieras seguir siendo mi amigo. Algunos aventureros cambian, así que no sabía si tú también lo harías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "Le pedí un deseo a la diosa, pero... como no encontré un regalo apropiado, no me respondió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "¡Panuelle, no digas eso! Si hay algo que siempre será verdad, es que siempre seré tu amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750405,
					"content": "Te pido perdón por pensar solamente en mí mismo y no haber escuchado lo que tenías que decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750406,
					"content": "Pensé... pensé que no querrías verme en esta forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750407,
					"content": "¡Malentendido solucionado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "¡Sí! Paimon pensó que tenían algún asunto imposible de resolver, que estaban superenfadados y que no querían ni escuchar al otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "Era un asunto complicado, pero se resolvió.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "#Gracias, amig{F#a}{M#o}s. De no ser por ustedes, aún estaría ahí plantado, sin querer moverme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750412,
					"content": "Pero ahora, por fin puedo contarle a Panuelle lo que siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750413,
					"content": "Siempre estuve dispuesto a escucharte, Chauvigné. En serio, me da igual que vayas de viaje o seas una flor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "#Por cierto, querid{F#a}{M#o}s amig{F#a}{M#o}s, tomen esto. Lo recogí específicamente para dárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "#Que la diosa l{F#a}{M#o}s bendiga, que nunca tengan que discutir con un amigo, y que siempre haya alguien dispuesto a escuchar cómo se sienten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "Por suerte pudieron solucionar el malentendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				}
			]
		}
