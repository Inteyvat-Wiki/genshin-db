				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "*Fiu*, por fin paró el viento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Escúchanos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "De acuerdo, escucharé lo que tienen que decir, pero antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750305,
					"content": "#¡Miren lo sorprendid{F#a}{M#o}s que están! Seguro que se mueren por preguntar “¿Cómo puede hablar una flor?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750306,
					"content": "O... “¿Cómo te convertiste en una flor?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750307,
					"content": "¿Son cosas que te pregunta mucho la gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "Mucha gente me lo pregunta fuera, pero cuando vuelvo... nadie lo hace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750309,
					"content": "¿Con “fuera” te refieres a fuera de este mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Según me han dicho, adoptaste esta forma cuando regresaste de un viaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "Pues tus fuentes son correctas. Te lo dijo Panuelle, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750312,
					"content": "Así es, me convertí en esto cuando estaba de viaje, jeje. Pero usando las palabras de Rozel... era un cambio que yo mismo quise hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750313,
					"content": "Paimon entiende que quisieras cambiar, pero ¿convertirte en una flor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "¿Es porque te gustan mucho las plantas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "No, solo quería... encontrar mi lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750317,
					"content": "Conocí a muchas personas fuera de este mundo: chefs, jardineros, profesores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750318,
					"content": "Casi todos ellos habían encontrado un lugar en el que se sentían a gusto, y así es como encontraron una estabilidad en sus vidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750319,
					"content": "Pero ¿yo? Yo solo sé viajar, y nunca había pensado en encontrar mi propio lugar estable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750320,
					"content": "Esta maceta es tu lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "Así es. Captas las cosas muy rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750322,
					"content": "Al ser una flor en una maceta, tengo en todo momento un lugar en el que sentirme a gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750323,
					"content": "Sin embargo... *Suspira*, si ya tengo una maceta, es decir, mi propio lugar, ¿para qué voy a ir de viaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750324,
					"content": "Pero, al mismo tiempo, soy un aventurero. Si no viajo, ¿qué otra cosa puedo hacer que tenga valor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750325,
					"content": "No lo entiendo. Cuanto más mundo conozco, menos entiendo qué es más importante: mi lugar o mis viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750326,
					"content": "Y cuanto más lo pienso, más me duele la cabeza. Cada vez que Panuelle quiere hablar conmigo, evito sus preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750327,
					"content": "Temo que se haga una idea equivocada. Le encanta viajar, pero ¿empezará a odiarlo cuando vea en qué me he convertido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750328,
					"content": "Aun así, Panuelle es mi amigo. Siempre lo será. Tengo que ser sincero con él, pero ya respondí mil veces a todas sus preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750329,
					"content": "Ya le dije incluso que me convertí en una flor porque quería encontrar un lugar en el que sentirme a gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750330,
					"content": "A lo mejor mi respuesta le entristeció, o tal vez... no le guste cómo soy ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750331,
					"content": "Poco a poco nos fuimos distanciando, pero como soy una flor, no puedo ir hasta donde está él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750332,
					"content": "Aunque tal vez sea lo mejor. Seguro que Panuelle no quiere verme y está enfadado conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750333,
					"content": "Ooooh, Paimon ya lo entiende. Tanto tú como él piensan que el otro está enfadado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "Y por eso no quieren verse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "¿Cómo? ¿D-dices que Panuelle no está enfadado conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750336,
					"content": "Están exactamente en la misma situación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Le cuentan a Chauvigné lo que piensa Panuelle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Cielos, ¿cómo pude pensar eso?... Nunca quise verlo tan triste. El simple hecho de pensar en ello me parte el corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750340,
					"content": "#¡Querid{F#a}{M#o}s amig{F#a}{M#o}s, por favor, llévenme con ustedes! Se lo ruego, ¡tengo que ver a Panuelle! ¡No puedo esperar ni un segundo más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "Chauvigné"
				},
				{
					"id": 790750341,
					"content": "¡Así se habla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#Esa es justo la respuesta que esperábamos. ¡{NICKNAME}, en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
