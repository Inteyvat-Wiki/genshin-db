					}
				]
			},
			"dialogs": [
				{
					"id": 790750101,
					"content": "¿En qué está pensando Chauvigné? *Suspira*, estoy seguro de que no quiere hablar conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750102,
					"content": "¿Qué pasa con Chauvigné?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "#Oh, hola, amig{F#a}{M#o}s. Lo siento... Chauvigné sigue enfadado conmigo y no quiere dirigirme la palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750104,
					"content": "*Suspira*, ahí abajo no llegan ni el viento ni el sol. ¿Qué pasa si se marchita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750105,
					"content": "Bueno, si solo es una flor en una maceta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750106,
					"content": "Podemos traértelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "Ya lo he intentado, pero estaba tan enfurruñado que no pude ni acercarme a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750108,
					"content": "Del enfado que tenía, ¡empezó a hacer aspavientos y me hizo salir volando de allí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750109,
					"content": "Espera, ¿cómo pudo hacerte salir volando solo por hacer aspavientos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750110,
					"content": "Porque eran unos aspavientos muy fuertes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "A lo mejor le molestó que dijera que no iba a viajar con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750113,
					"content": "#Querid{F#a}{M#o}s amig{F#a}{M#o}s, ¿les importaría ir a ver a Chauvigné? Quizá con ustedes sí atienda a razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750114,
					"content": "Claro, lo intentaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "#Hemos viajado a tantos sitios y conocido a tantas personas distintas que seguro que a nosotr{F#a}{M#o}s sí nos hace caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750116,
					"content": "¡Maravilloso! Chauvigné está en la cueva que hay bajo esta isla, pueden ir a buscarlo por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750117,
					"content": "Yo... me quedaré aquí barriendo para prepararle un lugar adecuado en el que le dé el sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750111,
					"content": "Pues sí que debía estar enfadado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
