			"dialogs": [
				{
					"id": 790750201,
					"content": "Yo... me quedaré aquí barriendo para prepararle un lugar adecuado en el que le dé el sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "#Amig{F#a}{M#o}s, cuento con ustedes para hacer que Chauvigné atienda a razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "Si voy yo, es muy posible que me mande callar y se enfade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				}
			]
		},
		{
