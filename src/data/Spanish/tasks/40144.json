			"dialogs": [
				{
					"id": 401440701,
					"content": "#¡Saludos, Caballer{F#a}{M#o} Honorari{F#a}{M#o} {NICKNAME} y escudera Paimon! ¡Aquí Freda, Caballera de la Compañía de Logística! ¡Es un honor poder conocerl{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "¡Vaya, parece que la reputación de Paimon ya es conocida por todos! Pero ¿de qué escudera hablas? ¡Paimon es su compañera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Oh, mis disculpas. Parece que usé sin querer un término perteneciente a las novelas populares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "Podría decirse que sus hazañas son prácticamente una leyenda. Qué envidia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "A mí también me encantaría convertirme en una caballera errante y explorar cada rincón en busca de nuevas aventuras. Una vida así debe de ser muy interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Quizás se presente esa oportunidad algún día.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "¡Sí, eso mismo espero yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Bueno, sea como sea, vamos a ocuparnos del trabajo que tenemos entre manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "La Gran Maestra Intendente me indicó que les prestara todo el apoyo necesario para que el negocio vaya bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "Si necesitan algo, no duden en pedírmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Me gustaría obtener nuevos suministros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "Hemos recibido un nuevo lote de suministros recientemente. Comprueben si hay algo que necesitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440715,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "¡Que vayan bien los negocios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440708,
					"content": "En realidad, es más duro de lo que parece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "Eso creo yo. Los aventureros de las novelas siempre están enfrentándose a multitud de peligros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				}
			]
