					}
				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "#Oh, son ustedes, querid{F#a}{M#o}s. ¿A qué debo el placer de su visita hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "¿Han venido con la intención de leer algún libro... o para verme a mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Hemos venido a verte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "#Jeje, tan considerad{F#a}{M#o}s como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "Pero, por desgracia, hoy no me viene muy bien. Justo estaba ocupándome de un asuntillo, por lo que no podré sentarme a tomar té con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "¡Guau! ¿Lisa tomándose en serio el trabajo? ¡Paimon no puede creerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Tienes razón. La última vez que estuve tan inmersa en el estudio fue cuando estaba en la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "Hacía mucho que no tenía que concentrarme así... Es agotador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "¿Acaso estás escribiendo una tesis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Jeje, ya que tienen tanto interés, ¿les gustaría participar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "¿Querrían revivir conmigo los recuerdos de mi época de estudiante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "¡No intentes encasquetarnos tu trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#¿No quieres entonces, {NICKNAME}? Sería una oportunidad única de trabajar junto a mí... Y habría una generosa recompensa, claro está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "Somos todo oídos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Bueno, ya deberían saber que los Caballeros siempre han estado investigando sobre el campo de la alquimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Pero la mayor parte de dichas investigaciones se han llevado a cabo en laboratorios, por lo que el pueblo llano sabe bien poco sobre la alquimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "Como resultado, las investigaciones en las que tanto capital hemos invertido no han tenido un impacto lo suficientemente amplio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Por tanto, Jean pretende popularizar los beneficios de la alquimia entre la gente. En la fase actual, esto significa dar a conocer las pociones alquímicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "Por eso, además de los asuntos de la biblioteca, también debo ayudar a supervisar el suministro de pociones de los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "Por no decir que el estudio de las pociones era una de mis antiguas áreas de investigación, así que, para Jean, no hay nadie mejor que yo para este trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Pero si queremos hallar el equilibrio entre las necesidades diarias de la gente, hemos de ajustar ligeramente los ingredientes alquímicos. Los métodos de preparación también deben simplificarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "Y así es como, poco a poco, un proyecto que parecía sencillo en un principio, ha terminado convirtiéndose en algo mucho más complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "#Entonces, ¿necesitas nuestra ayuda en la investigación? Pero nosotr{F#a}{M#o}s no sabemos mucho sobre la teoría de la alquimia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Jeje, no es eso. Ya tengo pensado el trabajo perfecto para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "Aunque la investigación sobre las técnicas de elaboración avanza a un ritmo estable, si no recopilamos las opiniones del público sobre su uso, no lograremos averiguar si podemos satisfacer las necesidades de todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Pero si vamos a desarrollar pociones al mismo tiempo que recopilamos datos sobre su recibimiento, necesitaremos un método más eficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "La solución que he hallado es abrir una tienda de pociones alquímicas. Así podremos elaborar las pociones a la vez que obtenemos un mayor entendimiento sobre las necesidades diarias de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "¡Oh! Así mataríamos dos pájaros de un tiro... ¡Siempre se te ocurren buenas ideas, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#Pues claro. Y todos sabemos que este trabajo le queda como anillo al dedo {F#a la}{M#al} mejor entre los Caballeros... ¡{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "Cuando estudiaba en la Academia de Sumeru, los pupilos también nos ayudábamos los unos a los otros con nuestras investigaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "#¿Acaso no les gustaría saber lo que se siente al vivir una experiencia tan rebosante de vitalidad, querid{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Suena muy bien, pero lo que realmente quieres es holgazanear, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Está bien, hagámoslo por Lisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Jeje, sabía que podía confiar en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "Cuando hayas terminado el trabajo, te recompensaré personalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Los preparativos iniciales de la tienda ya han sido completados. De lo demás hablaremos cuando nos encontremos allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "Me lo tomaré como un reto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "¡Cuánto entusiasmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Cuéntanos primero de qué se trata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "¿Acaso estás trabajando en algún proyecto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Solo pasábamos por aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "¿Y pensaron en venir a charlar conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
