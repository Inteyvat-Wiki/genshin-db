			"dialogs": [
				{
					"id": 401440401,
					"content": "Bien, ya han vendido su primer lote de pociones. ¡Es un buen comienzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "Para saber qué pociones elaborar, pueden consultar las noticias del mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "Anticiparse a las necesidades de la gente según los sucesos más recientes es una habilidad imprescindible para gestionar un negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Oh, eso suena un poco complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Jeje... No se preocupen, he tenido la consideración de recopilar las noticias de mercado más recientes para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "¿Y bien? ¿Se les ha ocurrido ya cuál será la próxima poción que vendamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Entonces, intenten cultivar nuevos ingredientes. Estas hierbas han sido procesadas con técnicas de bioalquimia, por lo que poseen diferentes efectos y propiedades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "La poción resultante variará según los distintos tipos de hierbas usados. Puedes probar diferentes combinaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "¡Está bien! Prueben a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
