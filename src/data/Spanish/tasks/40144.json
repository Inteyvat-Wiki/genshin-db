			"dialogs": [
				{
					"id": 401440601,
					"content": "Parece que ya se han familiarizado con el proceso de cultivo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "Ah, ya llegó la enviada de la Compañía de Logística. Ella es quien nos proporcionará suministros de forma periódica. Vayan a hablar con ella, ¿quieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440603,
					"content": "#Después, podrán decidir qué hacer ustedes mism{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440604,
					"content": "¿Y de qué te encargarás tú, Lisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "#¡Eso! ¿Cómo es que de pronto solo somos nosotr{F#a}{M#o}s l{F#a}{M#o}s que tenemos cosas que hacer?... ¿Y tus tareas, qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440606,
					"content": "¿Yo? Mi trabajo es asegurarme de que dominen las técnicas de gestión y alquimia, cariño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440607,
					"content": "#Yo siempre estaré aquí para apoyarl{F#a}{M#o}s. ¡Mucho ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440608,
					"content": "Paimon ya se olía que esto acabaría así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
