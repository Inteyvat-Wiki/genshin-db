			"dialogs": [
				{
					"id": 727380101,
					"content": "Sí, eso servirá. Solo hace falta hacer un poco de limpieza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380102,
					"content": "#¡Ah! Qué coincidencia, jovencit{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380103,
					"content": "Qué coincidencia... ¿por qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "Mírate. Se nota que estás pensando: “Uf, me va a mandar a hacer algún incordio de recado otra vez, ¿verdad?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380106,
					"content": "No te preocupes, iba a decirte que hemos terminado de renovar el santuario y nos disponemos a poner en marcha un nuevo servicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380107,
					"content": "No he tenido tiempo de anunciarlo oficialmente, pero aquí estás tú. Qué coincidencia, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380108,
					"content": "¿Ves la caja de ofrendas que tengo al lado? En el futuro, este será un lugar para pedir deseos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380109,
					"content": "¿No tienes ya papeles de la fortuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "Eso es diferente. El papel de la fortuna es para adivinar el futuro, mientras que esto... es para pedir deseos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380111,
					"content": "Tan solo cierra los ojos y pide un deseo. Escríbelo en una placa de oración, cuélgala en el estante de los deseos, y tal vez tu deseo se haga realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380112,
					"content": "¿Puedo pedir lo que quiera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "Por supuesto. Pero qué deseos se hacen realidad depende de los espíritus divinos que velan por nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380114,
					"content": "Como Suma Sacerdotisa, lo único que puedo hacer por ti es ayudarte con asuntos mundanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380115,
					"content": "No me importaría hacer nuevos amigos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "Si eso es lo que quieres, entonces inténtalo. Toma este papelito de la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380118,
					"content": "Me sobró cuando terminé de escribir los papelitos de la fortuna. Puedes llevártelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380119,
					"content": "Primero, escribe tu deseo. Puede que así sea más probable que se haga realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380120,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "#¿Cuándo te he mentido? Vamos, jovencit{F#a}{M#o}, pide tu deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380122,
					"content": "Recuerda que debes escribir tu deseo en el papel de la fortuna, pegarlo en la placa de oración y colgarla en el estante de los deseos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380123,
					"content": "Después, se cumplirá tu deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380124,
					"content": "Sí, con solemnidad. Eso es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380125,
					"content": "¿De verdad funciona?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "#Muy bien, jovencit{F#a}{M#o}, volvamos a lo nuestro. Recuerda mantener los oídos atentos y los ojos bien abiertos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380127,
					"content": "Al fin y al cabo, la persona que buscas podría estar sentada frente a unos fideos, tomándose un buen cuenco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380116,
					"content": "No estaría mal ver a mis viejos amigos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "Un momento, ¿a dónde quieres llegar?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}