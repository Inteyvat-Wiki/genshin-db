					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "Ya casi es la hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150102,
					"content": "#Oh, bienvenid{F#a}{M#o}, ¿tiene algún problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150103,
					"content": "Oh, ya veo... así que no está en un apuro y solo venía a mirar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150104,
					"content": "Se encuentra en la Agencia de Detectives Bantan Sango, un lugar como otro cualquiera. Yo... soy una detective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150105,
					"content": "¿Cómo se llama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "Mi nombre es Sango y soy la jefa de esta agencia de detectives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150107,
					"content": "Bueno, aunque somos una agencia... en realidad, solo somos dos detectives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150113,
					"content": "¿Es tu primera vez en una agencia de detectives?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150108,
					"content": "¿Qué hace un detective?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "Oh, esa es una buena pregunta. Para la mayoría de las personas, el oficio del detective es sin duda uno muy especial y misterioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150110,
					"content": "Pero, para mí, esta es una profesión común y corriente con la que haces cosas por dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150111,
					"content": "Las cosas que hacemos a veces no son muy corrientes, y nuestros clientes también pueden ser muy especiales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150112,
					"content": "... pero, al fin y al cabo, su fin sigue siendo el de hacer cosas por dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201504",
							"2"
						],
						"stepId": 2201504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "#Vaya, vaya, ¿así que tú eres {F#la}{M#el} ayudante de la jefa Sango?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150206,
					"content": "¿Sabías que iba a venir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "Qué va, pero la jefa dijo que vendría alguien a ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150208,
					"content": "Eh, ¿qué están haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150209,
					"content": "#¿Son Ladron{F#as}{M#es} de Tesoros? ¿Qué hacen tan cerca de la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150210,
					"content": "#Ryuuji, ¿qué haces aquí? ¿Y con est{F#a}{M#e} foraster{F#a}{M#o} tan sospechos{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150211,
					"content": "¿Te refieres a mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "#¿Acaso ves a otr{F#a}{M#o} foraster{F#a}{M#o} aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150215,
					"content": "#Vamos, déjal{F#a}{M#o} en paz. Y por cierto, Ryuuji, ¿qué estás haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150216,
					"content": "#Solo le he seguido el rastro {F#a la sospechosa}{M#al sospechoso}, tal y como la jefa dijo que hiciera. Pero veo que lo que he encontrado es {F#una Ladrona}{M#un Ladrón} de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150217,
					"content": "#{F#Esta viajera}{M#Este viajero} es {F#la}{M#el} ayudante de la detective Sango y me acaba de ayudar a derrotar a unos Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150218,
					"content": "Oh... Pero entonces, ¿qué hacían unos Ladrones de Tesoros por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150219,
					"content": "Ryuuji, eso que has dicho de perseguir a alguien sospechoso... Espera, ¿has perseguido a unos Ladrones de Tesoros desde la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150220,
					"content": "Así es. La detective Sango estaba investigando un caso de robos en serie, así que, siguiendo sus hipótesis, estuve buscando por toda la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150221,
					"content": "Entonces, vi a alguien sospechoso en Hanamizaka, así que lo interrogué un poco e inmediatamente se marchó muy nervioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150222,
					"content": "Lo seguí hasta fuera de la ciudad y... bueno, ya saben el resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150223,
					"content": "Guau... Ryuuji, ¿desde cuándo hablas tanto? Antes no eras tan hablador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150224,
					"content": "Te has vuelto muy elocuente desde que empezaste a ayudar a Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150225,
					"content": "¿Qué hacen ustedes aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "#Andou dijo que había {F#una}{M#un} foraster{F#a}{M#o} sospechos{F#a}{M#o} caminando a sus anchas por la ciudad, así que quiso seguirl{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150227,
					"content": "#Por eso te seguimos nosotros dos hasta aquí. Lo que no imaginé es que tú fueras {F#la}{M#el} ayudante de Sango. Perdón por el malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150232,
					"content": "Ryuuji, ¿entonces dices que encontraste al sospechoso en la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150233,
					"content": "Efectivamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150234,
					"content": "No me puedo creer que esos maleantes se atrevieran a poner un pie en la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150235,
					"content": "Eso es lo que ocurrió. Pero siendo solo nosotros dos... solo nosotros dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150236,
					"content": "(Parece como si no supiera cómo seguir la frase...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "Siendo solo nosotros dos, solo podríamos expulsar a uno o dos Ladrones de Tesoros. Para expulsarlos a todos, necesitaríamos la ayuda de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150239,
					"content": "Si quieren ver las pruebas, pueden buscar a mi jefa en la ciudad. Ella les explicará todo con más detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150240,
					"content": "Ya veo... Entonces, Amano, vamos a buscar a Sango. Si de verdad hay Ladrones de Tesoros alborotando en la ciudad, no podemos ignorarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150241,
					"content": "¡Sí! Bien, vayamos con Sango. Ryuuji, ustedes también deberían volver ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150242,
					"content": "... Uff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150243,
					"content": "Es hora de irse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150244,
					"content": "Eso que acabas de decir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "Es lo que dijo la jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150246,
					"content": "Ya está todo arreglado. En marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150237,
					"content": "(¿Se ha olvidado de lo que iba a decir?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "¿Ustedes también estaban siguiendo a alguien sospechoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "Sí... pero ese alguien, en realidad, eras tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150230,
					"content": "#Andou dijo que había {F#una}{M#un} foraster{F#a}{M#o} sospechos{F#a}{M#o} caminando a sus anchas por la ciudad, así que quiso seguirl{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150231,
					"content": "#Por eso te seguimos nosotros dos hasta aquí. Lo que no imaginé es que tú fueras {F#la}{M#el} ayudante de Sango. Perdón por el malentendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150213,
					"content": "#Soy {F#la}{M#el} ayudante de Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "#¿{F#La}{M#El} ayudante de Sango? Eso suena aún más sospechoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				}
			]
		},
		{
			"id": 2201503,
			"completionStepIds": [
				2201505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201505",
							"2"
						],
						"stepId": 2201505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "Señorita Sango, ¿es cierto lo que acaba de decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150302,
					"content": "¿De verdad son esos desgraciados de los Ladrones de Tesoros los responsables de los robos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150303,
					"content": "Elemental, querido Andou. Con su intuición y las pruebas que les acabo de mostrar, ya deberían tener un veredicto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150304,
					"content": "Esos Ladrones de Tesoros... ¡qué osados! ¿Se atreven a ignorarnos así sin más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150305,
					"content": "¡Amano, vámonos! Informemos de este caso a nuestros superiores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150306,
					"content": "Tienen que reforzar las patrullas. No podemos permitir que estos oportunistas desgraciados hagan nada malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150307,
					"content": "Señorita Sango, ¿podríamos quedarnos con estas pruebas para convencer a nuestros superiores de que tienen que tomar medidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150308,
					"content": "Claro, llévenselas. Después de todo, los detectives no podemos encargarnos de los Ladrones de Tesoros. Necesitamos la ayuda de la Comisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150309,
					"content": "¡No se preocupe! Le aseguramos que ninguno de esos alborotadores se saldrá con la suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150310,
					"content": "Muchas gracias a los dos. Ya casi están hechos todos los preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150311,
					"content": "¿Qué preparativos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "Estos dos guardias de la Comisión han sido dos ayudantes muy valiosos en este caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150316,
					"content": "Si consiguen que se refuercen las patrullas, los Ladrones de Tesoros tendrán que estar mucho más alerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150317,
					"content": "Ryuuji, peleaste contra ellos en el lugar al que te dije que fueras, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150318,
					"content": "#Así es. Esos alborotadores no fueron rivales para est{F#a}{M#e} viajer{F#a}{M#o} y para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150319,
					"content": "Me alegro. Creo que ya han hecho más que suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150320,
					"content": "El siguiente paso es esperar a la oportunidad perfecta para atraparlos con las manos en la masa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150321,
					"content": "#Muchas gracias por tu ayuda, viajer{F#a}{M#o}. Esta es tu remuneración. Por favor, acéptala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150322,
					"content": "Tengo la sensación de no haber ayudado demasiado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "#¡No, no, no! Al ser {F#una forastera}{M#un forastero}, atrajiste la atención de Andou y, junto con Amano, se encontraron con Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150324,
					"content": "Gracias a ti, ellos se dieron cuenta de la amenaza de los Ladrones de Tesoros y, como solo podía ser lógico, las patrullas en la ciudad se reforzaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150325,
					"content": "Todo esto no lo podría haber conseguido si no fuera por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150326,
					"content": "Al hacer que los guardias vieran por sí mismos el problema con los Ladrones de Tesoros, el efecto fue mayor que si solo se lo hubiera contado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150327,
					"content": "En fin, acepta esta recompensa. Es posible que en un futuro vuelva a necesitar tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150313,
					"content": "¿Qué vas a hacer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "Soy detective, así que mi deber ahora es concluir este caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150315,
					"content": "Estos dos guardias de la Comisión han sido dos ayudantes muy valiosos en este caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201505,
