					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150701,
					"content": "Bueno, conozco a una asesora legal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "¿Asesora legal? Oh... He oído que es muy difícil tratar con los que se dedican a esa profesión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150703,
					"content": "Creo que se les da muy bien complicar las cosas simples, crear normas a partir de cosas difíciles y convertir en contratos esas normas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150704,
					"content": "A ser posible, no me gustaría encontrarme nunca con alguien así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201508,
			"completionStepIds": [
				2201501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
							"2"
						],
						"stepId": 2201501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "#A juzgar por tu expresión, te veo interesad{F#a}{M#o} en las agencias de detectives, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "¿Yo también podría ser detective?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "¿Quieres ser detective? Bueno, eso es algo bastante complicado. Que no te engañen todas esas historias de las novelas negras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150804,
					"content": "En la vida real, cuando un detective investiga un caso, no existen tales cosas como persecuciones peligrosas y emocionantes o decisiones de vida o muerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "Lo que sí hacemos es leer pilas y pilas de documentos, caminar por caminos montañosos embarrados y tratar con sospechosos que se niegan a confesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "Dicho así, no creo que lo entiendas... Pero da la casualidad de que tengo un pequeño asunto del que encargarme. ¿Qué te parecería experimentar en primera persona el trabajo de un detective?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "Mi ayudante se llama Ryuuji. Hace poco salió en busca de pistas, pero aún no ha vuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "Siendo la hora que es, ya debería haber encontrado alguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150817,
					"content": "¿Podrías ir a buscarlo y volver con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150818,
					"content": "¿Me encontraré con algún peligro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Ya le expliqué a él todo lo que necesitaba saber. Aunque tengan algún imprevisto, sabrá cómo solucionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "Lo que me preocupa es si podrá encontrar lo que busco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "Bien, entonces cuento contigo para esto. Tendré preparada tu remuneración para cuando vuelvas. Tómate esto como... una manera de experimentar en primera persona el trabajo de un detective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "¿Me encontraré con algún imprevisto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "No creo. Ya le expliqué todo lo que necesitaba saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150823,
					"content": "Aunque se encuentren con un imprevisto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150824,
					"content": "... él sabrá cómo solucionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150825,
					"content": "Lo que me preocupa es si podrá encontrar lo que busco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150807,
					"content": "Me parecería un poco problemático...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "Claro. Los detectives somos expertos en solucionar problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150809,
					"content": "Las persecuciones peligrosas y emocionantes y las decisiones de vida o muerte son un engaño de las novelas negras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150810,
					"content": "Lo que sí hacemos es leer pilas y pilas de documentos, caminar por caminos montañosos embarrados y tratar con sospechosos que se niegan a confesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150811,
					"content": "Lo que sí es verdad de las novelas es que los detectives solemos tener todo tipo de ayudantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150812,
					"content": "Entonces, ¿tú también tienes un ayudante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "Claro. Pero mi ayudante está ocupado ahora mismo, así que necesito a otra persona que me ayude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150814,
					"content": "Si quieres, ¿podrías echarme una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				}
			]
		},
