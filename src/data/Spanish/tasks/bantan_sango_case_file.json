			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150601,
					"content": "Nunca vi una en Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150602
					]
				},
				{
					"id": 220150602,
					"content": "#Elemental, querid{F#a}{M#o} viajer{F#a}{M#o}. No creo que Liyue necesite detectives. He oído hablar de cuánto respetan los contratos por esas tierras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150603,
					"content": "Además, allí tienen a la eficaz y omnipresente Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150604,
					"content": "Aunque tuvieran agencias de detectives, tendrían tan poco trabajo que el negocio se iría a la quiebra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
