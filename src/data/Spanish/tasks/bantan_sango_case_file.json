			"dialogs": [
				{
					"id": 220150501,
					"content": "Nunca vi una en Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "¿Mondstadt?... Oh, ¿te refieres a la ciudad de Mondstadt? He oído hablar sobre ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150503,
					"content": "Las dos cosas más típicas de Mondstadt son, primero, el vino y, segundo, la libertad, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150504,
					"content": "Ambas cosas se complementan la una con la otra, ¿no crees? Jajaja. Si en Mondstadt hubiera detectives, seguramente les iría muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
