						710501405
					]
				},
				{
					"id": 710501405,
					"content": "¡Mira que eres bromista! Darte más dinero sería caer muy bajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "#¿No te sentirías insultad{F#a}{M#o} si lo hiciera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "Toma, esta carta es para ti. Si alguna vez vas a Sumeru y te encuentras con algún tipo de problema o necesitas ayuda, llévala a Purbiruni.",
