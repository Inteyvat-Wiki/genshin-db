				}
			]
		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "¡Jaja! Es un mineral, parece que te lo tomaste muy en serio cuando dije “roca”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Para los antepasados de Liyue, el mineral jugó un papel esencial, pero no solo en la fundición. En sus inicios, estos minerales tenían una función muy importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "Cuando los antepasados llegaron aquí y comenzaron a cavar, construyeron un horno de piedra, el cual encendían al chocar dos rocas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Con el fuego puedes cocinar, y con los platos y la barriga calientes, puedes trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "Todo esto proviene de la roca. Ese es el obsequio del Rey Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "Es por ello que en algunos libros antiguos, el Rey Geo también es nombrado “el Patrono de las hornillas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Cuando se abre un restaurante o una tienda de licores, la gente viene a hacer una ofrenda con incienso al Rey Geo, y pedirle que su horno nunca se apague, y que el negocio sea próspero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "La próxima vez que comas en algún restaurante de Liyue, no olvides agradecer al Rey Geo con unas cuantas palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "¿Lo recogiste en la naturaleza? Debe haberte tomado mucho esfuerzo. Hiciste un buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Como podrás darte cuenta, hoy día Liyue es enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Pero hasta las ciudades más grandes fueron construidas ladrillo por ladrillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "Cuando nuestros antepasados llegaron a estas tierras, no había tal cosa como un “Liyue”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Fue con sudor y valentía que trabajaron estas tierras poco a poco para construir esta gran ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "También sabrás que hay montañas escarpadas cerca de Liyue que son difíciles de cultivar. Pero las plantas aún crecen tenazmente entre las rocas de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Estas plantas útiles han sido de gran ayuda a quienes se aventuraron al exterior. La gente cree que estas plantas son un obsequio del Rey Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "En Liyue siempre puedes escuchar historias de las luchas de los primeros pobladores. Hasta el día de hoy, algunos aventureros que salieron de Liyue todavía están obsesionados por estas historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Además de heredar el espíritu obstinado de los primeros pobladores, los habitantes de Liyue aún hoy veneran al Rey Geo como “el Patrono de los pioneros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Ser aventureros fuertes y duros como la roca, esto es lo que piden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "¿Eh? ¿De dónde sacaste esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "Escuché que solo puedes encontrar este objeto en la Terraza Yujing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Parece que tú también estás interesado en escuchar las historias del Rey Geo, si hasta trajiste esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "Este lirio de cristal es la esencia de los orígenes de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "¿No lo entiendes? Piensa, ¿cuál es la particularidad de este lirio de cristal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "Ciertamente, es precioso, muy precioso. Puede venderse a un precio muy generoso, podrías llenarte los bolsillos de Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "El nombre “Mora” se deriva de otro nombre del Rey Geo: “Morax”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "Por lo tanto, el Rey Geo también es “el Patrono de la riqueza” para muchos. No importa qué tan exitoso sea, todo comerciante de Liyue sacará algo de tiempo para ofrecerle incienso al Rey Geo antes de hacer negocios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Porque el Rey Geo es la persona más rica del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Me atrevo a decir que incluso es el más rico de Los Siete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230013,
