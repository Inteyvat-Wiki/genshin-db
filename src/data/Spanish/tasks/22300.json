				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "#Por lo que veo tú también eres {F#una}{M#un} gourmet. La comida en Liyue es deliciosa. Deberías probarla si tienes oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "¿Qué tiene esto que ver con el Rey Geo? ¡Más de lo que crees! Tal vez hayas notado pancartas en muchos de los restaurantes en Liyue. Esas pancartas son para publicitar las largas historias de los restaurantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "Cuando les pides pruebas, los dueños dirán que en tal día de tal mes de tal año, el Rey Geo pidió tal plato, y le encantó tal sopa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "No importa si son ciertas o no, pero podrás darte cuenta que el Rey Geo ha estado en Liyue desde hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Algunos de los antiguos eruditos que estudian la historia de Liyue dirán que el Rey Geo es “la persona más vieja de este mundo”, y lo veneran como “el Patrono de la historia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "¿Cuánto tiempo ha estado el Rey Geo en este mundo? Quizás nadie lo sepa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
