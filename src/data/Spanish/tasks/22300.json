			"dialogs": [
				{
					"id": 223008001,
					"content": "Oh, perdí la noción del tiempo, te he contado tantas historias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008002,
					"content": "¿Y bien? ¿Ya crees tener una mejor comprensión sobre el Rey Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008003,
					"content": "Ahora entiendo un poco mejor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "Bueno, pero esa es solo una parte de la historia del Rey Geo. Visítame la próxima vez que quieras escuchar más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008005,
					"content": "¿Eh? ¿Has organizado tantas notas...? Vaya que disfrutas de mis historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008006,
					"content": "Bien, ¿qué tal si me dejas estas notas y escribo más historias en mi tiempo libre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008007,
					"content": "Luego reuniré todas esas pequeñas historias de las notas y las organizaré en una más completa, para dártela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008008,
					"content": "Pero hay muchas historias de Rex Lapis... Creo que me tomará tiempo organizarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008009,
					"content": "Por el momento, esto es para ti. Gracias por escuchar mis historias.",
					"roleType": "TALK_ROLE_NPC",
