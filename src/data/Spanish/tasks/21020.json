			"dialogs": [
				{
					"id": 210200001,
					"content": "“... Así es la codicia. Lo quieres todo y no sabes cuándo parar. Si hubiera parado al encontrar el tesoro oculto en esta cripta y no hubiera insistido en ir a esa estúpida hoguera de los deseos, nunca habría activado el mecanismo ni me hubiera atrapado aquí a merced de ese horrible monstruo. Ahora no puedo salir”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210200002
					],
					"speakerTitle": "Carta rasgada"
				},
				{
					"id": 210200002,
					"content": "“Quien sea que tenga lo necesario para deshacerse de él, vaya y pida un deseo en esa hoguera. Te deseo suerte... jeje”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carta rasgada"
				}
			]
		},
