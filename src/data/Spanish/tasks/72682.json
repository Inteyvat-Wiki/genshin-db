			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "#Hola, {F#rubia forastera}{M#rubio forastero}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820102,
					"content": "Nos volvemos a ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "Humm, tu cabello rubio me resulta familiar... ¿Eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820105,
					"content": "¡Ah, sí! ¡Eres ese torbellino dorado tan llamativo de «El club del combate» anterior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820106,
					"content": "¿T-torbellino dorado...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "La vez anterior, vi cómo los participantes hacían gala de sus habilidades desde una esquina del gimnasio mientras buscaba inspiración en las escenas de combate más emocionantes. Y ahí estabas tú, arrasando con los oponentes cual torbellino dorado, esparciendo hierbajos a su paso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820108,
					"content": "Puedes ahorrarte los cumplidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "Bueno, recientemente, algunas personas organizaron otra edición de «El club del combate».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820114,
					"content": "Recuérdame, ¿qué es «El club del combate»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "Es un torneo gratuito donde la gente participa en un intenso combate para celebrar o simplemente para eliminar su mala suerte. Es un festival donde tanto artistas marciales como monstruos dejan sus quejas de lado y se olvidan de sus identidades para poder disfrutar la auténtica emoción del combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820116,
					"content": "Dicen que aquellos que destaquen de la mayoría obtendrán todo tipo de tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820117,
					"content": "Pero las identidades de los organizadores y patrocinadores todavía son un misterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820119,
					"content": "Sea como sea, este no es un tema que se deba discutir en público. Sígueme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820118,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "... ¿Y qué más, qué más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "#*Ejem*... “Los espectadores más expertos en el arte de la espada seguramente se dieron cuenta: {F#la rubia forastera}{M#el rubio forastero} desencadenó el Supertifón Kouranka, una técnica rotundamente prohibida incluso en las artes marciales más antiguas!”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820111,
					"content": "¿?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "Después de inspirarme con tu maravilloso combate, escribí esta historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820103,
					"content": "¿Tienes un encargo para mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268202",
							"2"
						],
						"stepId": 7268202,
						"stateName": "QUEST_STATE_UNFINISHED"
