			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820201,
					"content": "Llegamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820202,
					"content": "Una vez que atravesemos esta puerta, estaremos en el lugar del torneo para celebrarlo una vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820203,
					"content": "¡Qué emoción!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "Las reglas no deben haber cambiado mucho. Monstruos, aventureros y guerreros de todo el mundo que comparten un mismo espíritu de combate saciarán su sed de una efervescente batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820206,
					"content": "Como la última vez, podrán participar en batallas con compañeros que tengan intereses similares. Al fin y al cabo, cuantos más sean, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820207,
					"content": "Estoy deseando ver qué puedes mostrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820208,
					"content": "¿Tampoco participarás esta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "¿Yo? Participaré como espectador y te animaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820210,
					"content": "#Al fin y al cabo, yo aspiro a escribir la novela más impactante de todas, no a convertirme en {F#una guerrera}{M#un guerrero} galante como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820211,
					"content": "... Y mi instinto me dice que vas a ser la estrella más brillante en la arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820212,
					"content": "Se hará lo que se pueda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "Sí, estoy seguro de que una vez más nos mostrarás tu danza con espada más resplandeciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820213,
					"content": "Espera y verás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "Vaya, qué fastidio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
}