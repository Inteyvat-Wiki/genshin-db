			},
			"dialogs": [
				{
					"id": 790290101,
					"content": "¿Qué hace una estatua aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290102,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290103,
					"content": "Hola. ¿Qué haces aquí, suspirando en la entrada de esta cueva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290112,
					"content": "Verás, es que yo ahora vivo aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290113,
					"content": "¡Paimon no se puede creer que vivas en un sitio así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290114,
					"content": "¡No tuve otro remedio! Esa compañía de teatro llegó un día de pronto y empezaron a montar escándalo a todas horas. Así no hay quien duerma... Por eso vine aquí, se está un poco más tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290104,
					"content": "Pero un montón de Hilichurls aparecieron de la nada y me arrebataron mi refugio. ¡Por eso tuve que quedarme aquí fuera a la intemperie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290105,
					"content": "*Suspira*, me prometí a mí mismo que si me encontraba con alguien que pudiera ayudarme, se lo diría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290106,
					"content": "¿Decirle qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290107,
					"content": "¡Le diría a esa persona que viniese conmigo a buscar el legendario tesoro pirata! Aunque yo solo tenga una cuarta parte de pista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290108,
					"content": "¿Una cuarta parte de pista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290109,
					"content": "Ustedes tienen pinta de buscar tesoros. Hagamos esto, si me ayudan a deshacerme de los Hilichurls, compartiré la pista con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290110,
					"content": "Dicen que si encuentras las cuatro pistas, ¡podrás hacerte con el tesoro que los piratas enterraron aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Capitán Cuervo Noctívago"
				},
				{
					"id": 790290111,
					"content": "¡Trato hecho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
