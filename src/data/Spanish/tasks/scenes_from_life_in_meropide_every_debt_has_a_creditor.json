				{
					"id": 740640501,
					"content": "Ya les dije que tengo otros asuntos que atender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640502
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640502,
					"content": "Todas las cosas tienen un orden de llegada, hay que respetarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640503
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640503,
					"content": "Uff, qué mal. Había quedado con mi hermana para cenar. Si esto no se arregla, me iré de todas formas a la hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
