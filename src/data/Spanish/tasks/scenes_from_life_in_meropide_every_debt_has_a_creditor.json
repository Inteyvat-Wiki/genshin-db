			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maupoil",
					"Galvaryet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640201,
					"content": "Si atrapamos a una Foca Abotargada y le pedimos que escupa en las marcas, ¿servirá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640202,
					"content": "¿Me estás hablando en serio? ¿Tienes mucha presión últimamente? ¿Estás bien de la cabeza? ¿Es porque hay demasiado trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640203,
					"content": "Estoy perfectamente. Solo me daba curiosidad ver a una Foca Abotargada escupiendo saliva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640204,
					"content": "Será mejor que te tomes unas vacaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				}
			]
		},
		{
			"id": 7406403,
			"completionStepIds": [
				7406403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406403",
							"2"
						],
						"stepId": 7406403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clynes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "¿Eh? ¿No es Clynes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640302,
					"content": "Hola, Clynes. Cuánto tiempo sin verte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "Humm... Si Clynes está aquí... ¿Eso no quiere decir que fuiste tú quien dejaste esas marcas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640306,
					"content": "*Suspira*, ¿por qué son ustedes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640307,
					"content": "¿De qué hablan? No me estoy enterando de nada. ¿Y si le preguntan a otro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640308,
					"content": "Paimon, nos hemos equivocado de persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#¿Ah, sí? Espera... {NICKNAME}, ¡no te dejes engañar! ¡Aquí no hay nadie excepto él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640312,
					"content": "Está bien, me rindo. He sido yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640313,
					"content": "Ay, yo pensaba que conseguiría convocar a un viejo amigo, no me esperaba que fueran ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640314,
					"content": "¿A un viejo amigo? ¿Con esas marcas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640315,
					"content": "Sí. El mensaje codificado es una técnica inventada por Butor. No hay muchas personas del Instituto de Ciencias de Fontaine que sepan descifrarlo. Y yo tuve la suerte de aprenderlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640316,
					"content": "Lo malo es que falleció muy temprano y esta tecnología no era muy reconocida por los superiores. Así que pensé que si alguien era capaz de descifrarlo, seguro que tendremos muchos temas en común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640317,
					"content": "Ah, no quería decir que con ustedes no tengo nada de lo que hablar, es solo que prefiero los temas de mi interés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640318,
					"content": "No te fuerces, es verdad que no sé de qué hablarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "#Qué franc{F#a}{M#o}. Antes tenía un amigo que era igual de honesto que tú y esto le causó muchos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640320,
					"content": "Ahora que lo pienso, éramos tan felices en aquel entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640325,
					"content": "Por cierto, ¿solo venían a buscarme por eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640326,
					"content": "¡Casi se nos olvida! Galvaryet y Maupoil nos pidieron que encontremos quién fue la persona que dejó esas marcas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640327,
					"content": "Entrégate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "¡Entrégate! Si te niegas, no tendremos piedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640329,
					"content": "*Suspira*... ¿De verdad que no lo podemos hablar más? No quiero caer en manos de Maupoil, y menos de Galvaryet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640330,
					"content": "¿Hay alguna posibilidad de que hagan la vista gorda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640331,
					"content": "Pero Maupoil ha dicho que en el Fuerte Merópide está prohibido pintar en las paredes. Hay que respetar las normas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640332,
					"content": "Tengan piedad, no hay mucha diferencia entre el mensaje codificado y otras letras de la pared. Solo son decoraciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640333,
					"content": "#Hagamos esto, vuelvo con ustedes, pero no me denuncien. Aunque claro, esto dependerá de {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640334,
					"content": "Si me ayudan y me libran de las garras de Galvaryet, yo estoy dispuesto a agradecerles con una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640335,
					"content": "Dejo mi destino en sus manos, pongámonos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640321,
					"content": "Lo siento mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "Jaja, no te pongas así que no sé qué decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640323,
					"content": "Si lo sé, normalmente en este momento tendría que decir algo como “cuéntame también una de las historias que han vivido”, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640324,
					"content": "En esto, quiero ser fiel a mí mismo. No quiero enterarme de más historias nuevas, solo quiero que alguien recuerde el pasado conmigo. Así que el que tiene que pedir perdón soy yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640310,
					"content": "¿Crees que aquí hay alguna otra persona más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "¡Exacto! ¡Deja de engañarnos con tu falsa actuación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640304,
					"content": "Confiesa, lo has hecho tú, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640305
					]
				},
				{
					"id": 740640305,
					"content": "Eso, ¡confiesa! Has sido tú, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7406404,
			"completionStepIds": [
