			"dialogs": [
				{
					"id": 740640401,
					"content": "Trajeron a Clynes, pero... ¿han encontrado al culpable de todo esto? ¿O tienen alguna pista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640402
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640402,
					"content": "Ehmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640403,
						740640413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640403,
					"content": "Fue Clynes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640404
					]
				},
				{
					"id": 740640404,
					"content": "Ya me lo imaginaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640405
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640405,
					"content": "*Suspira*, ya tenía en mente todo lo que quería decir. Ahora ya no puedo hacer nada, hagan lo que quieran conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640406
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640406,
					"content": "Las reglas son las reglas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640407,
					"content": "En comparación con tu castigo, me preocupa más cómo limpiar estas marcas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640408
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640408,
					"content": "¿Les interesa la técnica del mensaje codificado? Me puede tomar un poco de tiempo explicárselo. Siéntense y les cuento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640409
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640409,
					"content": "No, no me interesan los detalles. Solo dime cómo deshacerme de esas marcas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640410
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640410,
					"content": "Es una larga historia, ya que he usado un lacado y una técnica muy especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640411,
					"content": "Tengo mucho trabajo, sé breve... Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640412
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640412,
					"content": "#No les hagan caso. {NICKNAME}, Paimon, esta es la recompensa que les prometí. Gracias por su trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640413,
					"content": "Esto requiere de un profesional. Que lo vea Clynes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640414
					]
				},
				{
					"id": 740640414,
					"content": "Clynes, ¿este es el mensaje especial que mencionaste la otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640415
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640415,
					"content": "Deja que lo vea... Humm... Fíjate, se parece a un engranaje, y de este tamaño solo podría ser del Instituto de Ciencias de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640416
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640416,
					"content": "Del Instituto de Ciencias de Fontaine... Tú también vienes de ahí. La relación es evidente, confiésalo, has sido tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640417
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640417,
					"content": "No tiene por qué, si algún día tuviera el honor de comer con la señorita Galvana en el Bistró Debord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640418
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640418,
					"content": "Si sigues soñando, no me importaría despertarte. Y si crees que mis puños son demasiado cariñosos, a Roussimoff tampoco le importaría ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640419
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640419,
					"content": "Relájate, tan solo estaba poniendo un ejemplo. ¡Un ejemplo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640420
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640420,
					"content": "¿De qué estaba hablando? *Ejem*... En fin, que yo y Galvana salgamos juntas del Fuerte Merópide no quiere decir que tengamos alguna relación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640421
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640421,
					"content": "Como ves, no tiene sentido. La relación que tengo yo con esas marcas, es la misma que tengo con Galvana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640422
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640422,
					"content": "Está bien, me has convencido, pero solo la parte de que no tienes ninguna relación con mi hermana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640423
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640423,
					"content": "Es decir, no te ha convencido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640424
					]
				},
				{
					"id": 740640424,
					"content": "Ya hemos dicho todo lo que teníamos decir. ¡Ahora depende de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640425,
					"content": "*Suspira*, de todos modos, gracias. La recompensa que acordamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640426
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640426,
					"content": "#¡Es verdad! {NICKNAME} y Paimon, casi se me olvida darles la recompensa. Aunque sigamos sin saber quién lo hizo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640427
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640427,
					"content": "Pero ¡seguro que Clynes sabe alguna forma de limpiar esas marcas! Lo dejo en manos de Galvaryet y Clynes. Me voy ya, que tengo otros asuntos que atender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		},
