			"dialogs": [
				{
					"id": 751240301,
					"content": "Ay, es el momento perfecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "Había estado trabajando en esto durante muchísimo tiempo, pero con la ayuda de ustedes dos, ¡conseguí terminarlo tan rápido!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Mírenlas, todas las aves fluyecorriente con su cuerpo rechoncho y tambaleante dentro de los flotadores... Esta escena es tan conmovedora que se me saltan las lágrimas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "¿Tan conmovedora es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "A veces gente como yo nos pasamos la vida persiguiendo algo que los demás no pueden entender o incluso consideran absurdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Pero estoy seguro de que si sigo tomando más imágenes preciosas de las aves fluyecorriente, ¡cada vez habrá más gente que se enamore de ellas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "¡Seguro que sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "Gracias por su ayuda. Les doy esto como muestra de mi agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
