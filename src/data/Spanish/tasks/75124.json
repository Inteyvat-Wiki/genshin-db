							200.16,
							10051.38
						],
						"pointId": 10424
					},
					{
						"sceneId": 3,
						"position": [
							-1640.835,
							200.051,
							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "*Suspira*, se han salido otra vez. Solo queda una dentro del flotador... ¿Qué hago ahora?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "¿Cuánto tiempo me va a llevar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Guau, Paimon no se puede creer que haya alguien aquí tomando imágenes de... ¿las aves fluyecorriente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Bueno, es que son muy adorables...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "Sí, me encanta cuando tambalean al caminar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "¡Sí! Cuando andan son aún más adorables. Y cuando se hinchan y se convierten en una bola, Paimon se siente tan feliz de verlas flotando en el agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "Pues tiene razón esta señorita de pelo plateado y brillante. El creador de las aves fluyecorriente merece todos los elogios del mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "¡Es un verdadero genio! Uy, perdonen que no me haya presentado, soy un daguerrógrafo aficionado de las aves fluyecorriente. Mi nombre es Jonvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Hola, Paimon es Paimon, y est{F#a}{M#e} es {NICKNAME}. ¿Por qué estabas suspirando, Jonvelle? Aquí tienes a muchas aves fluyecorriente a la vista, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "Es una larga historia... pero se la resumiré. Hay un montón de daguerrógrafos aficionados a estas aves como yo, y todo el mundo quiere tomar la mejor imagen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "Así que el otro día se me ocurrió una magnífica idea: ¡tomar una imagen en la que todas las aves fluyecorriente estén dentro de un flotador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "¿Qué sentido tendría eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Ahí está la gracia, que no tendría sentido alguno. Las aves fluyecorriente saben nadar, pero aun así usarían un flotador, jajaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "¡Es tan absurdo como ganar Moras gastando Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Les estás poniendo una carga muy pesada a las pobres aves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "Esto es lo que se conoce como la daguerrotipia surrealista: encontrar un significado más profundo que trasciende de la imagen... Pero me encontré con un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "Las aves fluyecorriente de la vida real no llevan flotadores encima. Así que no he podido conseguir una toma de la imagen que quiero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Es una toma “surrealista” después de todo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Pero parece que todo lo que hay que hacer es ponerles un flotador, ¿no? {NICKNAME}, como amantes de las aves fluyecorriente que somos, ¡le tenemos que echar una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "¡Vamooos! ¡Hay que ayudarse mutuamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "¡Eso es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "¿De verdad me van a ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Jeje, ¡solo si después nos regalas unas bonitas imágenes de este tema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "¡S-se lo dejo en sus manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "Yo soy más fan de los esciúridos voladores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "¡No seas aguafiestas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "Desde luego que a mí no se me ocurriría...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Las aves fluyecorriente que obviamente son capaces de flotar sobre el agua, pero aun así llevan un flotador de natación. Algo así crearía en escena un exceso de significados superpuestos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "Y, en verdad, estaría reflejando los temas del “uso excesivo” y del “desperdicio”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "En realidad, me gustan más los esciúridos voladores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "También son muy adorables, pero ¿que te gusten más que las aves fluyecorriente? ¡Cómo se te ocurre decir algo tan cruel delante de su cara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
