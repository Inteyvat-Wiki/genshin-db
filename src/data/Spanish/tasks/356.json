			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "Permítanme presentarles la ciudad del viento, de los dientes de león, de la música bucólica, la Capital de la Libertad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560102,
					"content": "#Viajer{F#as}{M#os} bajo la protección de los Caballeros de Favonius, ¡bienvenid{F#as}{M#os} a Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560103,
					"content": "¡Al fin! ¡Ya no tendremos que acampar fuera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560104,
					"content": "Aunque los habitantes no parecen muy felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560105,
					"content": "Es porque recientemente Stormterror ha sacudido la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560106,
					"content": "¡Pero no hay nada de que preocuparse, siempre y cuando Jean esté con nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560107,
					"content": "¿Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560108,
					"content": "Jean, la Gran Maestra Intendente de los Caballeros de Favonius y protectora de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560109,
					"content": "Con Jean de nuestro lado, ni siquiera una calamidad como Stormterror es rival para nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560110,
					"content": "(Al parecer, es toda una celebridad...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#Por cierto, antes de que vayamos a la Sede de los Caballeros de Favonius, tengo un pequeño regalo para {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560113,
					"content": "Es una recompensa por ayudarme a eliminar el campamento de Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560114,
					"content": "¡Oye! ¿Y qué hay para Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560115,
					"content": "Pues... porque es algo que tú no necesitas, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560116,
					"content": "Pero esta noche te invito a probar asado a la miel, una especialidad de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560117,
					"content": "¡Asado a la miel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560118,
					"content": "Síganme, vamos a la <color=#00E1FFFF>parte alta</color> de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560111,
					"content": "(Espero que sepa algo sobre el dios Anemo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
