			"dialogs": [
				{
					"id": 3560401,
					"content": "Pues bien, el obsequio que te quería dar es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560402,
					"content": "¡Un <color=#00E1FFFF>planeador</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560403,
					"content": "Los caballeros exploradores lo usamos para navegar el viento. A la gente de Mondstadt también le gusta usarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560404,
					"content": "¡Te traje aquí a propósito para que pudieras probarlo inmediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560405,
					"content": "¡Te veo muy entusiasmada con este planeador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560406,
					"content": "Es porque Mondstadt lleva consigo el espíritu del viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560407,
					"content": "Muy bien, ¡basta de charla! ¡Vamos a probarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560408,
					"content": "Aunque es fácil de controlar, pon atención a mis instrucciones:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
