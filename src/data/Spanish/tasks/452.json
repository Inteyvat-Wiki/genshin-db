			},
			"dialogs": [
				{
					"id": 4520201,
					"content": "¡Miren! Algo ocurre ahí adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520202,
					"content": "No es una manada de lobos... parece que son Hilichurls los que atacan las caravanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520203,
					"content": "Oh... Vaya novedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520204,
					"content": "En fin, ¡basta de hablar! ¡Vamos a ayudarles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
