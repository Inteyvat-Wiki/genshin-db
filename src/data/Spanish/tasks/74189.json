			"dialogs": [
				{
					"id": 741890501,
					"content": "Un momento, por favor. ¿Te gustaría saber un secreto relacionado con el tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890502,
					"content": "¿Qué secreto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "#Tiene que ver con el tesoro y con la llave para abrir la puerta que lo alberga. ¿Qué te parece? ¿Estás interesad{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890504,
					"content": "¿Quieres que vaya a derrotar algún monstruo otra vez?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "¡Para nada! En la taberna nunca se le da órdenes a los clientes. Al menos... nosotros no lo haremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890507,
					"content": "¿Ves esta “pieza de artillería naval” que tengo al lado y la pila de piedras que hay frente a ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890508,
					"content": "Si activas el cañón y disparas contra las piedras, el tesoro que se esconde detrás de las piedras será tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890509,
					"content": "¿A quién se le ocurrió ese nombre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "Fue al timonel. También fue él quien lo encontró en no sé dónde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890511,
					"content": "Dime la verdad. ¿Le faltan piezas a este cañón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "Te equivocas. Las piezas del cañón están intactas y dispone de energía suficiente. Hago el mantenimiento todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890514,
					"content": "Pero antes de poder activar este cañón, me gustaría hacerte algunas preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890515,
					"content": "... A decir verdad, esto es lo que exige el timonel. Dice que así puede dar algo que hacer a los clientes que visitan la taberna, lo que les hace beber más despacio y quedarse en la taberna durante más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890516,
					"content": "#No estoy segur{F#a}{M#o} de esto, pero adelante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "La primera pregunta es: ¿Cuántas mesas hay en nuestra taberna, el Timón Oxidado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890518,
					"content": "La segunda pregunta es: ¿Cuántos empleados hay en nuestra taberna, el Timón Oxidado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890519,
					"content": "La tercera pregunta es: ¿Qué cosa no se sirve en nuestra taberna, el Timón Oxidado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890520,
					"content": "En fin, si responde correctamente a estas tres preguntas, podrá activar el cañón, romper las piedras y obtener el tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890521,
					"content": "¿Y después de que obtenga el tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "... Después de eso, esperaré hasta el momento adecuado para colocar otro tesoro en la cueva y luego cubrir la entrada con piedras otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890523,
					"content": "Luego, esperaré a que llegue el próximo cliente para activar el cañón y obtener el tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890524,
					"content": "Cuánto trabajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "#Bien, vaya a buscar las respuestas a esas preguntas. L{F#a}{M#o} espero aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890525,
					"content": "¡Tu jefe abusa de ti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "No lo niego, pero todavía no he encontrado una forma de apuntar este cañón al timonel sin que él se dé cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890527,
					"content": "Además, disparar imprudentemente dañaría a otros clientes en la taberna, lo cual no está dentro de mi ética.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Premingeat"
				},
				{
					"id": 741890512,
					"content": "No me engañes. ¿Le hace falta energía a este cañón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "¿Me estás pidiendo buscar algo de nuevo?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
