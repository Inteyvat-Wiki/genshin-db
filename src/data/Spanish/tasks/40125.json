			"dialogs": [
				{
					"id": 401251101,
					"content": "¿Te llevarás la concha de vuelta, Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "Creo que sería mejor dejarla aquí, con Idía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "En la Isla Watatsumi ya hay una nueva reliquia, y los deseos de la gente se están cumpliendo poco a poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "¿Por qué no dejar que la concha se quede aquí, protegiendo el Espejismo y velando por los sueños de sus visitantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
