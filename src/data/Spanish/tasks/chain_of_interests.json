				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno",
					"Bahari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "¡Guau! ¡Parece que Cyno atrapó a alguien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100702,
					"content": "¡Así que tú eres el tipo malo detrás de todo esto! ¡Desembucha! ¡Dile a Paimon todo lo que sabes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100703,
					"content": "¿Este tipo sabe algo sobre el contrabando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "No salí de inmediato cuando llegó. Me quedé observando un rato a escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100706,
					"content": "No parece ser la mente maestra, pero sí creo que es uno de los comerciantes más importantes. ¿O me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100707,
					"content": "Buen ojo, Cyno. Te mereces tu reputación... No habría sido tan avaricioso de haber sabido que todavía andabas por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100708,
					"content": "¿Avaricioso? ¿Qué quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100709,
					"content": "Cuando supimos que estabas en camino, todos los comerciantes de conocimiento encapsulado huyeron de inmediato. Por supuesto, no tuvieron tiempo de recoger toda la mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100710,
					"content": "Ya que se quedaron aquí sin dueño, pensé en aprovechar la oportunidad para regresar y llevarme lo que pudiera. Ya sabes, vender mercancía que te ha salido gratis es muy buen negocio, pero... *Suspira*, no tiene caso hablar de eso ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100711,
					"content": "Debes saber quién está fabricando y vendiendo el conocimiento encapsulado, ¿no? ¿Nos lo vas a decir por las buenas o por las malas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100712,
					"content": "Por las buenas. Pero antes de eso, quizás deberíamos hablar en otro lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100713,
					"content": "Si alguien me ve aquí hablando con ustedes, mi familia y yo estaríamos en grave peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100714,
					"content": "Está bien. ¿A dónde quieres ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100715,
					"content": "¿Qué les parece mi casa, en la Aldea Aaru? Estaremos seguros ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100716,
					"content": "#De acuerdo, en marcha. {NICKNAME}, ya puedes deshacerte del localizador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100704,
					"content": "¿Es alguien con un papel destacado en la subasta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Simín",
					"Bahari",
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "¡Papá! ¡Regresaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Simín"
				},
				{
					"id": 130100802,
					"content": "Oh, ¿tenemos invitados? Hola a todos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Simín"
				},
				{
					"id": 130100803,
					"content": "Esta es mi hija, Simín. Es un poco tímida con los desconocidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100804,
					"content": "Cariño, ve a jugar un rato. Papá tiene unos asuntos que atender con estos invitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100805,
					"content": "Oh... Está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Simín"
				},
				{
					"id": 130100806,
					"content": "#El nombre de Cyno es muy conocido en nuestro negocio. ¿Cómo debo llamarl{F#as}{M#os} a ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100807,
					"content": "#¡A Paimon la puedes llamar Paimon, y {F#ella}{M#él} es {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100808,
					"content": "Siendo sincero, no pensé que el solitario Cyno tuviera compañeros de trabajo. Por eso supuse que habías decidido marcharte con las manos vacías cuando vi al localizador alejarse, Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100809,
					"content": "Pero a pesar de que me hayan atrapado, debo avisarles de abandonar ahora que pueden... No sigan con la investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100810,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100811,
					"content": "Ya sea en la fabricación, venta o distribución del conocimiento encapsulado hay involucradas decenas, si no cientos de personas. Todos están juntos en este negocio por los enormes beneficios que les aporta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100812,
					"content": "Todos harán lo imposible por proteger este negocio que hemos construido con tanto esfuerzo. Intentar acabar con él será una larga y difícil batalla, incluso para ti, Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100813,
					"content": "E incluso si lo lograran, nadie se lo agradecerá. Tal vez solo consigan sentirse culpables... ¿Por qué están tan empecinados con acabar con nuestro negocio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100814,
					"content": "Cada quien tiene sus propias convicciones para hacer lo que hace. No tengo por qué explicar las mías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100815,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100816,
					"content": "Papá, te preparé algo de té... Y también para los invitados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Simín"
				},
				{
					"id": 130100817,
					"content": "Oh, cierto. Casi olvido servirles té a nuestros invitados. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100818,
					"content": "No es nada. Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Simín"
				},
				{
					"id": 130100819,
					"content": "El té que tenemos en casa es bastante amargo, por lo que le puse algo de azúcar para que supiese mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Simín"
				},
				{
					"id": 130100820,
					"content": "Buena chica. ¿Nos queda azúcar? Si no, compraré más la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100821,
					"content": "Sí... Bueno, voy a descansar un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Simín"
				},
				{
					"id": 130100822,
					"content": "¿No dijiste que todos en este negocio obtenían enormes beneficios? No parece que sea tu caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100823,
					"content": "... De hecho, quería hablar de eso precisamente con ustedes. Quisiera pedirles un favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100824,
					"content": "Mi hija nació con una enfermedad crónica, así que su corazón y pulmones son bastante débiles. La más moderada actividad física basta para que se desmaye, incluso puede poner en riesgo su vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100825,
					"content": "Por eso casi no tiene amigos con quienes jugar, y se pasa casi todo el día encerrada en su cuarto. Además, tiene que tomar muchas medicinas, y no son precisamente baratas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100826,
					"content": "Pero yo solo era un pequeño comerciante. Me levantaba temprano y viajaba por todos lados para ganar algo de Mora, pero nunca era suficiente. Solo podía ver cómo su salud se deterioraba día tras día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100827,
					"content": "Hasta que alguien se acercó a mí y me propuso una forma de ganar dinero de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100828,
					"content": "¿Vendiendo conocimiento encapsulado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100829,
					"content": "Correcto. Con todos los Moras ganados pude por fin costear el tratamiento médico de mi hija. Nada me hizo más feliz que ver a mi hija ponerse mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100830,
					"content": "Hay muchos otros como yo. Para ustedes, contrabandear con conocimiento encapsulado podrá parecer un crimen imperdonable, pero para nosotros es la única manera de sobrevivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100831,
					"content": "Les he querido contar todo esto para que lo comprendan y cambien de parecer. Por favor, Cyno, no te metas en esto. Danos una oportunidad de sobrevivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100832,
					"content": "Oh, no... Esto quiere decir que si impedimos que venda conocimiento encapsulado, su hija...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100833,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100835,
					"content": "Tengo que saber la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100836,
					"content": "Puedo encontrar a alguien que ayude con el tratamiento de tu hija, pero no puedo ignorar el contrabando de conocimiento encapsulado. Son dos cosas completamente distintas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100837,
					"content": "*Suspira*. Sabía que dirías algo así, pero tener tu palabra de que ayudarás a mi hija es suficiente para mí. Si estás tan decidido a llegar al fondo de esto, ve a la parte trasera de mi casa a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100838,
					"content": "Ahí hay algunos productos que recibí hace poco. En cuanto los veas, entenderás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100839,
					"content": "Vas a la parte trasera de la casa con Cyno...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "¡Guau! ¡Hay un montón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100841,
					"content": "Sí, todas las cápsulas están cuidadosamente empaquetadas y apiladas. Y pensar que esto solo es el lote de un comerciante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100842,
					"content": "Ningún fabricante pequeño podría producir esta enorme cantidad de producto. ¿De verdad tendrá algo que ver la Academia en todo esto? No es posible que tal volumen de mercancía eluda el proceso de inspección...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100843,
					"content": "¡Miren! Estas cápsulas de conocimiento parecen distintas de las que hemos visto. ¿Contendrán conocimiento sobre la Corte de la Desolación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100844,
					"content": "Lo más seguro es que sí. Esperen, ¿qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100845,
					"content": "Nunca había visto ese tipo de marca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "Sí, es un sello de la matra. Indica que esta mercancía ha pasado la inspección de la matra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100848,
					"content": "Empecé a sospechar que alguien de la Academia podría estar involucrado cuando encontré el localizador. Pero seguía siendo un misterio cómo podían sacar tanto conocimiento encapsulado de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100849,
					"content": "Ahora todo encaja. Con ese sello, la mercancía puede entrar y salir libremente de la Academia sin necesidad de una segunda inspección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100850,
					"content": "Humm, con razón no querían que siguiera indagando. Resulta que hay un matra detrás de todo esto. Incluso a mí me cuesta creerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100851,
					"content": "Podría ser un malentendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}, ¿puedo pedirte un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100853,
					"content": "Ya que todo este conocimiento encapsulado viene de la Academia, es muy probable que el conocimiento sobre la Corte de la Desolación provenga de documentos de investigación guardados en la misma Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100854,
					"content": "Si conseguimos entrar en la sala de archivos, podremos averiguar quién accedió a dichos documentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100855,
					"content": "Pero yo no puedo aparecer de repente por la Academia en mi situación actual, solo levantaría sospechas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100856,
					"content": "Así que necesito que tú compruebes los registros. Le escribiré una carta a Nabil para que te lleve a los archivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100857,
					"content": "¡Déjalo en nuestras manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100858,
					"content": "Yo seguiré trabajando en el caso mientras tanto. Aunque nuestra pista principal nos dirige a la Academia, es obvio que debe haber también alguien de gran poder de fuera de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100859,
					"content": "Podemos conseguir de Bahari más información sobre otros comerciantes. Me quedaré aquí a hacer algunos preparativos. Vengan a buscarme si descubren algo más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100846,
					"content": "Cyno, ¿sabes qué es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
