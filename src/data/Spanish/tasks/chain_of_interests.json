					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101002,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "¡Genial! ¡Descansemos un poco y volvamos a buscar a Cyno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101006,
					"content": "Se sientan a descansar un rato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "Paimon cree que ya es hora de que volvamos a la subasta a ver que ha pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101008,
					"content": "Quién sabe, quizá Cyno haya descubierto alguna pista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101004,
					"content": "Caminemos un poco más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "¿Caminar más? Pero Paimon ya no puede flotar ni un poco más... ¡Mejor descansemos aquí un poco!",
					"roleType": "TALK_ROLE_NPC",
