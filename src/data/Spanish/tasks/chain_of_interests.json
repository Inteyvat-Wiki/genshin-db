			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "Qué calor... Ojalá hubiera un lugar con sombra para refrescarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100202,
					"content": "Quizás deberíamos tomarnos un descanso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "Todavía nos queda mucho camino por delante, así que aguanten un poco más. Además, este lugar no es muy adecuado para descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100204,
					"content": "*Uff*... Está bien. Pero Cyno, ¿tú no tienes calor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100205,
					"content": "Claro que sí, pero ya estoy acostumbrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100206,
					"content": "¿Cuál es tu secreto? Paimon siente que va a derretirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100207,
					"content": "Solo mantente concentrada y usa tu fuerza de voluntad. Te sentirás más cansada en el momento en que empieces a ceder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100208,
					"content": "Solo piensa en el paso siguiente y no dejes que tu cerebro piense que tu cuerpo ha llegado a su límite. Debemos llegar a un lugar seguro antes de poder relajarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100209,
					"content": "Bueno, si tú lo dices. ¿Pero dónde hay un lugar más seguro? Paimon piensa que este lugar es perfectamente seguro para descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100210,
					"content": "Solo mira alrededor, es todo arena y desierto. Ni un monstruo en millas a la redonda... ¡Ah! ¿De dónde salieron esos escorpiones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100211,
					"content": "Cuidado, noto algo raro en ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "Uff... Paimon no pensó que nos encontraríamos escorpiones aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100402,
					"content": "Esos no eran escorpiones comunes y corrientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100403,
					"content": "Si se fijan, tienen números grabados en las pinzas. Alguien los crio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100404,
					"content": "Te refieres a que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "Alguien no quiere que aparezcamos en la subasta. Por eso mandaron a los escorpiones para detenernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100406,
					"content": "El desierto nos rodea por todos lados. Si nos eliminaran aquí, nadie se enteraría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100407,
					"content": "¡Qué lugar tan peligroso! Menos mal que no bajamos la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100408,
					"content": "Pero aquí hay gato encerrado... Si no hay caminos en el desierto, ¿cómo saben dónde estamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100409,
					"content": "#No te muevas, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100410,
					"content": "Aquí está la respuesta... Te pusieron esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100411,
					"content": "¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100412,
					"content": "Es un localizador miniaturizado desarrollado en la Escuela de Tecnología. Con esto pueden saber tu ubicación aproximada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100413,
					"content": "Pero este dispositivo no recibió la licencia para su producción en masa. ¿De dónde lo habrán sacado? ¿Será que alguien de la Escuela de Tecnología está involucrado? Humm, pero eso no parece probable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100414,
					"content": "#¡Guau, Paimon no sabía que existían estas cosas! ¿Por qué se lo habrán puesto a {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100415,
					"content": "Probablemente se lo pusieron durante la pelea con los mercenarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100416,
					"content": "Lo siento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "Fue una pelea caótica. Es normal que no te hayas dado cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100419,
					"content": "Menos mal que lo encontraste, Cyno. ¡Deshagámonos de él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100420,
					"content": "Humm, no... Déjatelo puesto de momento. Tal vez nos sea útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100421,
					"content": "Sigamos nuestro camino a la subasta. Podría ser peligroso quedarnos aquí más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100417,
					"content": "Ni siquiera me di cuenta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "Qué raro... ¿Es aquí la subasta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "No hay nadie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Pues sí, no hay ni un alma... ¿Se estarán tomando un descanso o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "No perdimos tiempo en dirigirnos aquí después de derrotar a esos mercenarios. No debería haberles dado tiempo de avisar de nuestra llegada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "Y aun así, sabían que veníamos. Alguien debe haber estado vigilando el localizador y avisó a los demás para que ahuecaran el ala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "Ay, ¿y ahora qué hacemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "Busquemos por la zona. No pueden haber tenido tiempo de llevarse todas las cápsulas de conocimiento. Debería haber alguna pista por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "De acuerdo, ¡echemos un buen vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
