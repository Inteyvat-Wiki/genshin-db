						130100612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100612,
					"content": "Solo unas cápsulas de conocimiento comunes y corrientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Puede que no hubiese demasiadas cápsulas de conocimiento con información sobre la Corte de la Desolación, y las pocas que había se las llevaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100614,
					"content": "#No pasa nada, tengo otra idea. {NICKNAME}, Paimon, regresen por donde vinimos, yo aguardaré aquí escondido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100615,
					"content": "Vuelvan a reunirse aquí conmigo en un rato. Seguro que así conseguiremos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100616,
					"content": "Por eso querías que siguiera llevando el localizador...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Se marcharon a toda prisa sin poder llevarse toda la mercancía. No creo que la dejen aquí tirada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Regresarán por ella cuando piensen que nos hemos ido de aquí. Solo tenemos que alejar el localizador lo suficiente como para que piensen que es seguro volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "#¡Paimon lo entiende! ¡Nosotr{F#as}{M#os} haremos de señuelos y los engañaremos para que salgan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "Bien, entonces nos vamos. Dejamos este lugar a tu cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100621,
					"content": "#Tranquil{F#as}{M#os}. Si se atreven a regresar, me aseguraré de que se queden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
