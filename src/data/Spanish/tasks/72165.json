						721650405
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650405,
					"content": "El santuario en ruinas al este está cubierto por una aura de mal augurio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650406
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650406,
					"content": "Guau... Suena aterrador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650407,
					"content": "Sin embargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650408
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650408,
					"content": "Aquellos que sean valientes y conquisten tales presagios recibirán una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650409
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650409,
					"content": "Suena a algo que ya ha dicho antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650410
					]
				},
				{
					"id": 721650410,
