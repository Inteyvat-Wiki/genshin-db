				"points": []
			},
			"dialogs": [
				{
					"id": 721650101,
					"content": "Ah, ya volvieron. ¿Hay algo que pueda hacer por ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650102,
					"content": "¡Adivine mi futuro, por favor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#¡Paimon también quiere saber cuál es la suerte de {NICKNAME} el día de hoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650104,
					"content": "Humm... De acuerdo al patrón de las hojas de las adivinas abisales... Hoy tendrás buena suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650105,
					"content": "Encontrarán su buena suerte en el punto más alto de la Isla Watatsumi, en el antiguo lugar de adoración a los dioses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650106,
					"content": "Humm... ¿Cómo es que Paimon no ve nada de eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650107,
					"content": "Jeje, es lo que llaman “conocimiento ancestral”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650108,
					"content": "¡Suena a que solo quieres impresionar a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
