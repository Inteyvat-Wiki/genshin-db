					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650305
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650305,
					"content": "Un Seelie Electro muy amable guiará tu camino cerca de un estanque profundo en el centro de la Isla Watatsumi, justo debajo del Santuario Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650306,
					"content": "¡Guau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650307,
					"content": "Debe ser verdad. Estas lecturas siempre han sido precisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650308
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650308,
					"content": "Humm... Mientras más lo repites, más le parece sospechoso a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650309,
					"content": "No le preste atención a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650310
					]
				},
				{
					"id": 721650310,
					"content": "Jeje, está bien, está bien. Ah, la juventud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650311
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650311,
					"content": "#Un momento, ¿qué quisiste decir con eso, {NICKNAME}?",
