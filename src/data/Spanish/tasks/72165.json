				{
					"id": 721650507,
					"content": "En las ruinas al noreste, en la antigua ciudad que se yergue solitaria en medio del mar, los restos de un espíritu en pena guiarán tu camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650508
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650508,
					"content": "Sin embargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650509
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650509,
					"content": "Deberás abrirle una gran puerta y ayudarle a regresar a su lecho de reposo para obtener la recompensa del destino.",
