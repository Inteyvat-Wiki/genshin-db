					"nextDialogs": [
						721650510
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650510,
					"content": "Eso... es muy confuso. Algo sobre una ciudad antigua y un lecho, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650511,
					"content": "Jaja. Está bien, yo estaré aquí. Si no pueden resolverlo, pueden venir a preguntarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650512
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650512,
					"content": "¡Oye! ¿Está diciendo que Paimon no es lo suficientemente lista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
