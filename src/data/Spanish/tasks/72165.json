			"dialogs": [
				{
					"id": 721650201,
					"content": "#Ah, ¿cómo están, jovencit{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650202,
					"content": "¡Adivine mi futuro, por favor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "Jeje, ¿cuál será tu suerte esta ocasión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650204,
					"content": "Las adivinas abisales dicen que... tendrás mala suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650205,
					"content": "Tendrás un encuentro desafortunado en una cueva al sur de la Isla Watatsumi... Un nido de bandidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650206,
					"content": "¡Oh! ¡Qué mala suerte! Deberíamos evitar ir a un lugar así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650207,
					"content": "Jeje, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650208,
					"content": "Superar la mala suerte puede traerles abundancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650209,
					"content": "¿Abundancia? ¿Quiere decir... un tesoro? Es un tesoro, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650210,
					"content": "No dije eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650211,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650212,
					"content": "... pero tampoco lo negué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650213,
					"content": "¡Oiga! ¿Por qué es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
