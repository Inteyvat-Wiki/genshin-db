			"dialogs": [
				{
					"id": 140030101,
					"content": "Lo siento, Charlotte, mi hermana y yo estamos muy ocupados hoy, así que no estamos aceptando entrevistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030102,
					"content": "No se preocupe, Sr. Lyney. ¡Por favor, solo será un minuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030103,
					"content": "¿Qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030104,
					"content": "Estuve toda la noche escribiendo una columna sobre el fantasma Comadreja para que se publicara en el periódico de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030105,
					"content": "Pero, de madrugada, me enteré de que Jemma, la prometida de César, ¡contactó con la Guardia para confesar que ella era la verdadera fantasma Comadreja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030106,
					"content": "¡¿Tan rápido?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030107,
					"content": "*Ejem, ejem*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030108,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030109,
					"content": "Demasiado tarde, Lyney.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030110,
					"content": "Jaja, ¿“tan rápido”, dice? Parece que alguien ya sabe algo al respecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030111,
					"content": "¡Ayyy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030112,
					"content": "Ya sabía yo que no me equivocaba, ¡estaban ocultándome cosas! Seguro que su espectáculo de ayer por la noche tiene algo que ver con el hecho de que Jemma se haya entregado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030113,
					"content": "Tal vez la bondad afloró en ella al recordar los momentos que pasó con César mientras veía el número de escapismo de altura mágico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030114,
					"content": "Ah, claro, claro... Espere, ¡no! Si tan fácil ha sido, ¿cómo es que no se ha entregado en estos diez años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030115,
					"content": "Pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030116,
					"content": "(Charlotte tiene su espíritu periodístico a flor de piel. Será mejor que se me ocurra una manera de cambiar de tema...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "¡Ahora me acuerdo! Después del espectáculo, no vi ni a Jemma ni a ustedes por ningún lado. ¿Qué pasó en ese momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030118,
					"content": "¡Hora de una entrevista espontánea! ¿A dónde fueron cuando terminó el espectáculo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030119,
					"content": "#Estábamos con Lyney en el cementerio. ¡Hizo un número de magia solo para nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030120,
					"content": "Por cierto, gracias a lo que nos dijiste, ahora Lyney usa rosarcoíris en sus trucos de magia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030121,
					"content": "*Ejem, ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030122,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030123,
					"content": "#No recuerdo que mi hermano me haya regalado alguna vez una rosarcoíris... Lyney, ¿quiere eso decir que ell{F#a}{M#o}s son más importantes que yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030124,
					"content": "¡Para nada! Yo.. eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030125,
					"content": "¿P-pero por qué reaccionas así? ¿Paimon ha vuelto a decir algo malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030126,
					"content": "#Esto se está poniendo un poco raro... {NICKNAME}, ¿qué hacemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030127,
					"content": "*Suspira*, se ve que hoy no es buen día para hacer una entrevista. Bueno, volveré en otro momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030128,
					"content": "Disculpen mi insistencia, pero no puedo quedarme de brazos cruzados ante semejante noticia. El caso de Jemma ya ha causado mucho revuelo, ¡y no pienso parar hasta llegar al fondo de todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030129,
					"content": "Al parecer, le dijo a la Guardia que su último deseo era volver a ver a Lorenzo. *Tch*, aquí hay toda una red de intrincadas relaciones... Y eso me da mucha curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030130,
					"content": "Bueno, yo me voy. Pueden seguir hablando de sus cosas. ¡Adiós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030131,
					"content": "Eh... Lynette, en realidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030132,
					"content": "No pasa nada, no me enfadé. Solo dije eso para desviar su atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030133,
					"content": "¿En serio? Ay, ¡qué susto le diste a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030134,
					"content": "Uff, hasta yo casi me lo creo... Menos mal que nuestra actuación no falló, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030135,
					"content": "Por favor, cuiden bien de esa rosarcoíris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030136,
					"content": "Si la pierden, me pondré triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		}
	]
}