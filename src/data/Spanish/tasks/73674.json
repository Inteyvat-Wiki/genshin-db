			"dialogs": [
				{
					"id": 736740301,
					"content": "Tú me trajiste aquí, ¿no? Entonces, haz algo útil y muévete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740302
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740302,
					"content": "Ah, si no te quieres mover, entonces quédate quieto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740303,
						736740304
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740303,
					"content": "¿Ulman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				},
				{
					"id": 736740305,
					"content": "#¿Viajer{F#a}{M#o}? Oh, ¡cuánto tiempo sin verte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740306
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740306,
					"content": "¿Sigues recorriendo el mundo? He oído muchas historias fascinantes sobre ti. Realmente eres alguien increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740307
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740307,
					"content": "Jeje, ¿de qué asuntos tienes que encargarte en Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740308,
						736740310
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740308,
					"content": "Mejor vayamos al grano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740309
					]
				},
				{
					"id": 736740309,
					"content": "#Bien, hablemos de cosas serias. Viajer{F#a}{M#o}, ¿qué te parece si colaboramos de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740313,
					"content": "La tierra de Sumeru está sembrada de tesoros. Hay Moras por todos lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740314
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740314,
					"content": "Yo... Todavía atraigo a muchos Seelies, incluidos los Seelies cazatesoros que tan bien conocemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740315
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740315,
					"content": "Hagamos como la última vez. Tú te encargas de buscar los tesoros con los Seelies y yo me encargo de prepararte una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740316
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740316,
					"content": "¡Si unimos fuerzas, estoy seguro de que volveremos a ganar mucho dinero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740317,
						736740321
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740317,
					"content": "¿Sigues buscando Taeles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740318
					]
				},
				{
					"id": 736740318,
					"content": "No, busco algo más valioso que los Taeles, busco Taeles antiguos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740319
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740319,
					"content": "¿No es prácticamente lo mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740320
					]
				},
				{
					"id": 736740320,
					"content": "No lo creas. Estos valen muchos más Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740326,
					"content": "Está decidido. ¡Volveremos a unir fuerzas y ganaremos mucho dinero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740321,
					"content": "¿No puedes buscar a otra persona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740322
					]
				},
				{
					"id": 736740322,
					"content": "Bueno... Siempre haces equipo con quien conoces mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740323
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740323,
					"content": "Además, somos amigos, y naturalmente te he tomado en consideración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740324
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740324,
					"content": "La última vez que nos vimos, no eras tan adulador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740325
					]
				},
				{
					"id": 736740325,
					"content": "Jeje, tengo que serlo para persuadir a los compradores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740310,
					"content": "Antes que nada, me encargaré de ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740311
					]
				},
				{
					"id": 736740311,
					"content": "Jaja, mejor no. No soy lo suficientemente fuerte para recibir tus golpes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740312
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740312,
					"content": "#En serio, viajer{F#a}{M#o}, colaboremos juntos otra vez, ¿qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740304,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				}
			]
		}
	]
}