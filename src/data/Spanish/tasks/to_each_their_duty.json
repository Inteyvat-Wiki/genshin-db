			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Will"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220401,
					"content": "¿Eh? Hola, ¿quieres algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220402,
					"content": "¿Eres consciente de lo que está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "Sí, por eso vinimos hasta aquí, para ver los meteoritos. No te preocupes, volveremos tan pronto como los hayamos visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220404,
					"content": "También se pueden ver desde la ciudad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "Pero, entonces, tendríamos que subir a algún sitio muy alto. Lo intenté varias veces, pero los guardias siempre me regañaban y decían que bajara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220406,
					"content": "Por eso vine hasta aquí con Jill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220407,
					"content": "El guardia de allí puede ayudarlos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "¿Ayudarnos? ¿Quieres decir que puede llevarnos a un lugar alto de la ciudad para ver los meteoritos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220409,
					"content": "¿En serio? Pero parece tan extraño y gruñón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220410,
					"content": "Traje el comunicado con órdenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "¿En serio? A ver... Guau, es cierto, es el comunicado con órdenes de los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220412,
					"content": "Con esto, ese señor nos podrá llevar a ver los meteoritos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220413,
					"content": "Jeje, seguro que ver los meteoritos desde la ciudad es lo mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220414,
					"content": "Entonces, ¿podrías hablar tú con ese señor? Yo hablaré con Jill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220415,
					"content": "¡Qué ganas tengo de ver los meteoritos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will"
				}
			]
		},
		{
			"id": 4112205,
			"completionStepIds": [
				4112205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112205",
							"2"
						],
						"stepId": 4112205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "¿Cómo te fue? ¿Los convenciste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220502,
					"content": "Creo que sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "¿De verdad? ¡Genial! Muchas gracias. Espera... ¿Qué quieres decir con “creo”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220504,
					"content": "Tendrás que ayudar para una cosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "¿Ayudar? ¿A qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220506,
					"content": "¿Eh? ¿Quieres que los lleve al punto más alto de Mondstadt para ver los meteoritos? ¡Eso es muy peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220507,
					"content": "¡Solo son unos niños! Primero tendré que informar de ello en la Sede de los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220508,
					"content": "P-pero... tengo un comunicado con órdenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "El comunicado no sirve para eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220510,
					"content": "Bueno, olvídalo. Mientras podamos llevar a esos dos niños de regreso a la ciudad... Ya encontraré la manera de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220511,
					"content": "¿De verdad lo harás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "Por supuesto. Lo haré porque soy un caballero y... un adulto responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220513,
					"content": "Si hacemos una promesa, debemos cumplirla como sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220514,
					"content": "Gracias por tu ayuda. Déjame el resto a mí, los llevaré a la ciudad en breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220515,
					"content": "Después, averiguaré cómo llevarlos al punto más alto de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
		{
			"id": 4112206,
