					"nextDialogs": [
						411220802
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220802,
					"content": "Ya despejé esta zona, ¿y tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220803
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220803,
					"content": "La mía también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220804
					]
				},
				{
					"id": 411220804,
					"content": "Jaja, eres muy hábil, ¿eh? Muchas gracias por tu ayuda. No creo que esos monstruos regresen por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220805
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220805,
					"content": "Pero todavía no puedo regresar. Aparte de esos monstruos, aún hay más deambulando por las Montañas Portatormentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220806
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220806,
					"content": "Quiero seguir reuniendo información por aquí. Si veo a alguien en apuros, podré rescatarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220807
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220807,
					"content": "Después de todo, no todo el mundo sabe todavía que no se debe salir de la ciudad en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220808
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220808,
					"content": "Bien. Por favor, informa de mi situación a Huffman. Estoy seguro de que lo entenderá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				}
			]
