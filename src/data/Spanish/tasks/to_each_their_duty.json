			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "*Suspira*, supongo que no tenemos alternativa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "Oh, eres tú. Verás... ¿Has visto los meteoritos que cayeron del cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220104,
					"content": "Aunque tuvimos suerte de que ninguno cayera en la ciudad, las cosas afuera son un caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220105,
					"content": "Entre las personas que vinieron a la ciudad en busca de refugio y las que cayeron inconscientes de repente, aquí ya no damos abasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220106,
					"content": "Me gustaría traer de vuelta a todos los caballeros que están fuera de la ciudad para que podamos solucionar los problemas de dentro primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220107,
					"content": "Actualmente, están dispersos por el campo, y no tenemos personal suficiente para salir a buscarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220108,
					"content": "¿Podrías ayudarnos? Toma este comunicado con órdenes y muéstraselo cuando los veas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
