				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jill"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "¿Eh? ¿Pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220302,
					"content": "¿Eres consciente de lo que está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "Sí, claro que sé lo de los meteoritos. Pero es que... no hemos visto cómo se ven cuando caen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220304,
					"content": "Will dijo que conocía un lugar desde donde verlos bien, así que vinimos hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220305,
					"content": "También se pueden ver desde la ciudad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "Pero, entonces, tendríamos que subir a un lugar muy alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220307,
					"content": "Y no creo que los guardias nos dejen hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220308,
					"content": "Ese señor de allí está dispuesto a ayudarlos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "¿Eh? ¿Te refieres a ese señor tan raro de allí? La última vez que vino a hablar con nosotros, me pareció muy desagradable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220310,
					"content": "Lo único que decía es que volviéramos a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220311,
					"content": "Aunque si accediera a llevarnos a un lugar alto para ver los meteoritos... creo que podríamos regresar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220312,
					"content": "Será mejor que hables con Will. Después de todo, todo esto fue idea suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jill"
				}
			]
		},
		{
			"id": 4112204,
			"completionStepIds": [
				4112204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
