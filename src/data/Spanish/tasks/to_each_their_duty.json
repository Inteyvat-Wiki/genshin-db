			},
			"dialogs": [
				{
					"id": 411220601,
					"content": "Hola. ¿Necesitas ayuda con algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220602,
					"content": "Traje un comunicado con órdenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "¿Un comunicado con órdenes? Déjame ver... Ah, ¿son instrucciones para volver a la ciudad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220604,
					"content": "Mis disculpas, pero tendré que cumplir con esas órdenes más tarde, ya que todavía tengo cosas importantes que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220605,
					"content": "Parece como si a los monstruos de por aquí les hubieran afectado los meteoritos. Se han vuelto mucho más violentos y peligrosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220606,
					"content": "Tengo que eliminarlos para garantizar la seguridad de esta área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220607,
					"content": "Pero si no hay nadie por aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "Precisamente por eso puedo luchar contra esos monstruos libremente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220609,
					"content": "Este es un asunto muy importante. No puedo irme sin antes ocuparme de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220610,
					"content": "Yo te ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "Genial, gracias. Hay varias zonas con monstruos por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220613,
					"content": "Dividámonos y eliminemos los monstruos de nuestras respectivas áreas. Nos encontraremos aquí cuando hayamos terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220611,
					"content": "Luchemos juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
