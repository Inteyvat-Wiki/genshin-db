			"dialogs": [
				{
					"id": 760580101,
					"content": "Nunca había visto un hurón ladrón tan blanco... ¿Estará enfermo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Macey"
				},
				{
					"id": 760580102,
					"content": "¡Pero si se mueve de maravilla! Hace un momento intentó robarle comida a Jurva. No tiene pinta de estar enfermo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Tal vez sea una especie muy rara. A lo mejor Linnéa lo sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "¡Eh! ¡Es el ladrón de los ahorros de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "El hurón ladrón intenta escapar, pero los tres niños lo atrapan con rapidez. Después de forcejear un poco, se da por vencido y aprovechas para contarles lo que te ha pasado...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Así que ya tiene historial. En ese caso, hay que darle una lección. Si comete errores, debe asumir las consecuencias. Así son las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Pero... es solo un animalito. No sabe lo que hace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Macey"
				},
				{
					"id": 760580108,
					"content": "Con que devuelva los Moras de Paimon, basta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "En cualquier caso, lo primero es recuperar los Moras que robó. Total, ni siquiera puede gastarlos, así que deberían estar todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "¡Qué bien! Jeje... ¡El tesoro de Paimon vuelve a estar a salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "Si pudiera quedármelo... Cuando Helka regrese, podríamos enseñarle este hurón ladrón tan raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Macey"
				},
				{
					"id": 760580113,
					"content": "¿Eh? ¡Pero si no hace nada! Robar no cuenta como trabajo. Si no trabaja, ¿por qué debería comer gratis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "Ya, ya, tranquilos... Lo decidimos después con Katya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Incluso los animalitos tienen que aprender que el mundo es duro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
