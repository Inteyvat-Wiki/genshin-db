				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Komaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500101,
					"content": "#Hola, jovencit{F#a}{M#o}, a juzgar por tu apariencia, vienes de fuera, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500102,
						721500103
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500102,
					"content": "Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				},
				{
					"id": 721500104,
					"content": "#Debes de ser {F#una viajera}{M#un viajero} que ha recorrido todos los rincones, ¿cierto? Me pregunto si tienes tiempo para detenerte a descansar. De paso puedo adivinar tu futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500105,
					"content": "¿Eh? ¿Adivinar el futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500106,
						721500107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500106,
					"content": "¿Adivinación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500108,
					"content": "#Jaja, pueden estar tranquil{F#as}{M#os}. Lo siento, quizás fue un poco precipitado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500109
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500109,
					"content": "#Lo que quiero decir es que el altar de Watatsumi en el Pueblo Bourou es muy eficaz con sus predicciones, así que quería invitarl{F#as}{M#os} a una sesión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500110
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500110,
					"content": "No quise decir que su futuro peligraba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500111
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500111,
					"content": "¿Cómo creen que nuestro futuro puede ser afectado por una simple predicción? Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500112
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500112,
					"content": "Así que es solo una adivinación... ¡No hace falta preocuparnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500113,
					"content": "¿Cuesta algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500114
					]
				},
				{
					"id": 721500114,
					"content": "Jeje, para nada. No cobraríamos por una cosa así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500115
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500115,
					"content": "Para los protectores del altar, pedir dinero a cambio de cumplir sus aspiraciones traería desasosiego al alma de Omikami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500116
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500116,
					"content": "Después de todo, como mortales, ¿quiénes somos para usar las aspiraciones de los demás en beneficio propio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500117
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500117,
					"content": "Humm... Tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500118,
					"content": "Entonces, ¿les interesaría saber qué les depara el futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500119
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500119,
					"content": "Podemos intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500120
					]
				},
				{
					"id": 721500120,
					"content": "Jeje, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500121
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500121,
					"content": "La situación es inestable en los alrededores, y los jóvenes salen del pueblo para trabajar. Es una gran felicidad para esta anciana que una persona joven venga a visitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500122
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500122,
					"content": "#Aún más extraño es ver a {F#una forastera}{M#un forastero} que muestre respeto por las tradiciones de la Isla Watatsumi. Es realmente sorprendente, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500123
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500123,
					"content": "Bueno, basta de charla. Hablemos del futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500124
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500124,
					"content": "Antes de comenzar, si no les importa, ¿puedo pedirles un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500125
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500125,
					"content": "¿Qué cosa? Es dinero, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500126,
					"content": "Jeje... No se trata de dinero. Escúchenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500127
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500127,
					"content": "La efectividad del altar del Pueblo Bourou proviene de la adivina abisal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500128
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500128,
					"content": "Como su propia nombre indica, este tipo de planta crecía en un principio en la zona abisal del mar... es decir, el origen de nuestros ancestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500129
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500129,
					"content": "Miles de años atrás, los primeros pobladores de nuestra aldea trajeron estas plantas a tierra desde las profundidades del océano, y las cultivaron con mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500130
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500130,
					"content": "El cuidado de la adivina abisal prosperó por generaciones a pesar de la guerra, el desastre, o incluso el sacrificio de Omikami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500131
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500131,
					"content": "Es una planta que crece en el fondo del agua, así que necesita una fuente de agua constante para subsistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500132
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500132,
					"content": "Y ya que es una planta que vivía en un entorno oscuro, emite un brillo fluorescente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500133
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500133,
					"content": "Es decir, que de acuerdo a la frecuencia del destello y su intensidad, podemos determinar si las aspiraciones de las personas se harán realidad. Los secretos de la planta se encuentran ocultos en el origen del agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500134
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500134,
					"content": "Jeje, las miko más jóvenes dudan de la certeza de sus predicciones. Ellas piensan que las tradiciones populares son solo supersticiones y patrañas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500135
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500135,
					"content": "Ellas prefieren teorías con una explicación más sencilla por encima de la tradición oral, que termina por convertirse en mito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500136
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500136,
					"content": "Pero... el conocimiento ancestral contiene la sabiduría de generaciones y generaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500137
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500137,
					"content": "Quizás con ese conocimiento no podemos sacar conclusiones inmediatas, pero con él no podemos pasar por alto la inexorable verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500138
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500138,
					"content": "¿El origen del agua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500139
					]
				},
				{
					"id": 721500139,
					"content": "¿A qué te refieres? ¡Oh! Disculpa, a mi edad, una no puede evitar desvariar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500140
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500140,
					"content": "Para nutrir a la adivina abisal, se requiere agua de la fuente de las ofrendas del santuario, ya que esa agua contiene “aspiraciones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500141
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500141,
					"content": "¿El agua puede contener algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500142,
					"content": "Jeje, así es. Cada ofrenda que los feligreses depositan se mezcla en sus aguas, como la miel diluida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500143
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500143,
					"content": "Las personas no pueden verlo con sus ojos, pero pueden percibirlo en el tono del agua y en su dulzor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500144
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500144,
					"content": "Recuerdos, fe... todo sigue el mismo principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500145
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500145,
					"content": "Por cierto, si van a recoger agua de la fuente, deben tener cuidado... El poder de las aspiraciones se disipa una vez que se alejan de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500146
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500146,
					"content": "... Tal y como los sueños se disuelven con el paso del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500147
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500147,
					"content": "Puedo notar cómo se desvanecen las aspiraciones con solo sentir el cambio en su textura y componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500148
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500148,
					"content": "Guau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500149,
					"content": "Oh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500150
					]
				},
				{
					"id": 721500150,
					"content": "Jeje, lo siento, me desvié del tema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500151
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500151,
					"content": "En pocas palabras, después de que vayan a recoger agua, no pierdan mucho el tiempo y vengan directamente aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500152
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500152,
					"content": "De lo contrario, el poder de las aspiraciones menguará, y los nutrientes para la adivina abisal no serán suficientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500153
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500153,
					"content": "Una vez que lo hayan hecho, vengan conmigo. Hay un paso adicional para nutrir a la adivina abisal e incrementar su capacidad de adivinación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500154
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500154,
					"content": "¡Qué dolor de cabeza! ¿No pueden ayudarte las miko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500155,
					"content": "*Suspira*, es inútil discutir con las miko más jóvenes. Cada vez que escuchan esta leyenda antigua, reaccionan con desprecio. Pocas de ellas están dispuestas a echarme una mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500156
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500156,
					"content": "No puedo evitar sentirme desalentada al ver que el brillo de las adivinas abisales disminuye con el paso de los días...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500157
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500157,
					"content": "Parece un serio problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500158,
					"content": "Puedo entender las objeciones de las miko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500159
					]
				},
				{
					"id": 721500159,
					"content": "Entonces, ¿podrían ayudar a esta anciana y traer un poco de agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500160
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500160,
					"content": "Le ayudaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500161
					]
				},
				{
					"id": 721500161,
					"content": "Entonces, lo dejo en sus manos. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500107,
					"content": "¿Hay algún peligro en mi futuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500103,
					"content": "Hola, abuela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				}
			]
		},
		{
			"id": 7215002,
			"completionStepIds": [
				7215004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215003",
							"3"
						],
						"stepId": 7215003,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215004",
							"2"
						],
						"stepId": 7215004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Komaki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500201,
					"content": "Ah, han vuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500202,
					"content": "Trajimos lo que pidió.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "¡Agua pura y fresca de la fuente de las ofrendas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500204,
					"content": "Estoy muy agradecida con ustedes. Iré a darle esta agua a la adivina abisal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500205,
					"content": "¿En dónde me quedé la última vez? Ah, sí, falta un paso adicional para aumentar el brillo de la adivina abisal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500206,
					"content": "Las hojas y ramas de la adivina abisal solo pueden crecer en las profundidades del océano, ricas en energía Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500207,
					"content": "En pocas palabras... Al norte de aquí hay una caverna cuyas aguas tienen propiedades Hydro muy parecidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500208,
					"content": "Además, su concentración es distinta dependiendo de la zona de la caverna. De todas ellas, la concentración más ideal de energía Hydro se encuentra en las aguas más brillantes y transparentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500209,
					"content": "Suponiendo que se tornara turbia por la perturbación de alguna criatura, por ejemplo, se arruinaría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500210,
					"content": "*Suspira*, ya estoy muy vieja, no sé si me doy a entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500211,
					"content": "Lo sabrán cuando lo vean en su debido momento, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500212,
					"content": "Esa caverna tiene una relación muy estrecha con los ancestros del Pueblo Bourou... Es una pena que, debido a las guerras recientes, pocos jóvenes acepten ir a recoger agua para nutrir a las adivinas abisales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500213,
					"content": "Ay... Hablando de los jóvenes, cómo desearía que volvieran a salvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500214,
					"content": "#Volviendo al tema, si van a recoger agua, tengan mucho cuidado, jovencit{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500215,
					"content": "¡Está bien, no se preocupe, abuela Komaki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500216,
					"content": "Tendremos cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "Bien, bien... Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500217,
					"content": "Puede estar tranquila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				}
			]
		},
		{
			"id": 7215003,
			"completionStepIds": [
				7215007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215006",
							"3"
						],
						"stepId": 7215006,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215007",
							"2"
						],
						"stepId": 7215007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Komaki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500301,
					"content": "Oh, son ustedes. Vengan, descansen un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500302
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500302,
					"content": "Abuela Komaki, ¡trajimos el agua tal y como nos lo pidió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500303,
					"content": "Esta es el “agua ideal” de la que hablaba, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500304
					]
				},
				{
					"id": 721500304,
					"content": "#Nada mal. Con esto es suficiente. Gracias a amb{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500305
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500305,
					"content": "Jeje, mucho mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500306,
					"content": "A juzgar por el resplandor de las adivinas abisales... el panorama de los próximos años será próspero y lleno de paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500307,
					"content": "¿Eh? ¿Cómo lo sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500308,
					"content": "El color de las adivinas abisales siempre ha dependido de su humedad y de los nutrientes que obtiene de los deseos de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500309,
					"content": "El aura que emite es precisamente la manifestación de esas aspiraciones. Si las aspiraciones son nobles, la luz será más brillante, y el futuro será más prometedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500310,
					"content": "Después de todo, las aspiraciones colectivas son para un mañana mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500311,
					"content": "Si todo el mundo aspira a mejorar las condiciones de vida actuales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500312,
					"content": "Incluso algo tan terrible como las secuelas de una guerra parecerá más pequeño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500313,
					"content": "Humm... ¿Entonces eso afecta a la capacidad de predicción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500314,
					"content": "Por supuesto... Esto es a lo que me refiero con la sabiduría de los ancianos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500315,
					"content": "Las aspiraciones son el motor que impulsa a las personas a actuar, y los frutos de este impulso son, a su vez, una forma de validación de estas aspiraciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500316,
					"content": "Si volviéramos a garantizar la paz, y si protegiéramos la esperanza de las tinieblas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500317,
					"content": "Las predicciones de la adivina abisal siempre serían precisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500318,
					"content": "Parece una predicción a medias tintas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "#Jeje... Son muy comprensiv{F#as}{M#os}, jovencit{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500321,
					"content": "Hablando de eso, el poder de las aspiraciones en el agua dura unos cuantos días. Si quieren otra adivinación, pueden venir cuando quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500319,
					"content": "Tiene sentido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
		},
		{
			"id": 7215004,
			"completionStepIds": [
				7215001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215001",
							"2"
						],
						"stepId": 7215001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214901",
							"3"
						],
						"stepId": 7214901,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Komaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500401,
					"content": "#Hola, jovencit{F#a}{M#o}, a juzgar por tu apariencia, vienes de fuera, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500402,
						721500403
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500402,
					"content": "Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				},
				{
					"id": 721500404,
					"content": "#Debes de ser {F#una viajera}{M#un viajero} que ha recorrido todos los rincones, ¿cierto? Me pregunto si tienes tiempo para detenerte a descansar. De paso puedo adivinar tu futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500405
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500405,
					"content": "¿Eh? ¿Adivinar el futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500406,
						721500407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500406,
					"content": "¿Adivinación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500408,
					"content": "#Jaja, pueden estar tranquil{F#as}{M#os}. Lo siento, quizás fue un poco precipitado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500409
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500409,
					"content": "#Lo que quiero decir es que el altar de Watatsumi en el Pueblo Bourou es muy eficaz con sus predicciones, así que quería invitarl{F#as}{M#os} a una sesión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500410
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500410,
					"content": "No quise decir que su futuro peligraba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500411
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500411,
					"content": "¿Cómo creen que nuestro futuro puede ser afectado por una simple predicción? Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500412
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500412,
					"content": "Así que es solo una adivinación... ¡No hace falta preocuparnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500413,
					"content": "¿Cuesta algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500414
					]
				},
				{
					"id": 721500414,
					"content": "Jeje, para nada. No cobraríamos por una cosa así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500415
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500415,
					"content": "Para los protectores del altar, pedir dinero a cambio de cumplir sus aspiraciones traería desasosiego al alma de Omikami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500416
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500416,
					"content": "Después de todo, como mortales, ¿quiénes somos para usar las aspiraciones de los demás en beneficio propio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500417
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500417,
					"content": "Humm... Tiene sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500418,
					"content": "Entonces, ¿les interesaría saber qué les depara el futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500419
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500419,
					"content": "Podemos intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500420
					]
				},
				{
					"id": 721500420,
					"content": "Jeje, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500421
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500421,
					"content": "La situación es inestable en los alrededores, y los jóvenes salen del pueblo para trabajar. Es una gran felicidad para esta anciana que una persona joven venga a visitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500422
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500422,
					"content": "#Aún más extraño es ver a {F#una forastera}{M#un forastero} que muestre respeto por las tradiciones de la Isla Watatsumi. Es realmente sorprendente, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500423
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500423,
					"content": "Bueno, basta de charla. Hablemos del futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500424
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500424,
					"content": "Antes de comenzar, si no les importa, ¿puedo pedirles un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500425
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500425,
					"content": "¿Qué cosa? Es dinero, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500426,
					"content": "Jeje... No se trata de dinero. Escúchenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500427
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500427,
					"content": "La efectividad del altar del Pueblo Bourou proviene de la adivina abisal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500428
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500428,
					"content": "Como su propia nombre indica, este tipo de planta crecía en un principio en la zona abisal del mar... es decir, el origen de nuestros ancestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500429
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500429,
					"content": "Miles de años atrás, los primeros pobladores de nuestra aldea trajeron estas plantas a tierra desde las profundidades del océano, y las cultivaron con mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500430
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500430,
					"content": "El cuidado de la adivina abisal prosperó por generaciones a pesar de la guerra, el desastre, o incluso el sacrificio de Omikami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500431
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500431,
					"content": "Es una planta que crece en el fondo del agua, así que necesita una fuente de agua constante para subsistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500432
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500432,
					"content": "Y ya que es una planta que vivía en un entorno oscuro, emite un brillo fluorescente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500433
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500433,
					"content": "Es decir, que de acuerdo a la frecuencia del destello y su intensidad, podemos determinar si las aspiraciones de las personas se harán realidad. Los secretos de la planta se encuentran ocultos en el origen del agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500434
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500434,
					"content": "Jeje, las miko más jóvenes dudan de la certeza de sus predicciones. Ellas piensan que las tradiciones populares son solo supersticiones y patrañas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500435
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500435,
					"content": "Ellas prefieren teorías con una explicación más sencilla por encima de la tradición oral, que termina por convertirse en mito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500436
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500436,
					"content": "Pero... el conocimiento ancestral contiene la sabiduría de generaciones y generaciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500437
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500437,
					"content": "Quizás con ese conocimiento no podemos sacar conclusiones inmediatas, pero con él no podemos pasar por alto la inexorable verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500438
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500438,
					"content": "¿El origen del agua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500439
					]
				},
				{
					"id": 721500439,
					"content": "¿A qué te refieres? ¡Oh! Disculpa, a mi edad, una no puede evitar desvariar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500440
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500440,
					"content": "Para nutrir a la adivina abisal, se requiere agua de la fuente de las ofrendas del santuario, ya que esa agua contiene “aspiraciones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500441
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500441,
					"content": "¿El agua puede contener algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500442,
					"content": "Jeje, así es. Cada ofrenda que los feligreses depositan se mezcla en sus aguas, como la miel diluida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500443
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500443,
					"content": "Las personas no pueden verlo con sus ojos, pero pueden percibirlo en el tono del agua y en su dulzor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500444
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500444,
					"content": "Recuerdos, fe... todo sigue el mismo principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500445
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500445,
					"content": "Por cierto, si van a recoger agua de la fuente, deben tener cuidado... El poder de las aspiraciones se disipa una vez que se alejan de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500446
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500446,
					"content": "... Tal y como los sueños se disuelven con el paso del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500447
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500447,
					"content": "Puedo notar cómo se desvanecen las aspiraciones con solo sentir el cambio en su textura y componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500448
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500448,
					"content": "Guau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500449,
					"content": "Oh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500450
					]
				},
				{
					"id": 721500450,
					"content": "Jeje, lo siento, me desvié del tema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500451
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500451,
					"content": "En pocas palabras, después de que vayan a recoger agua, no pierdan mucho el tiempo y vengan directamente aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500452
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500452,
					"content": "De lo contrario, el poder de las aspiraciones menguará, y los nutrientes para la adivina abisal no serán suficientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500453
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500453,
					"content": "Una vez que lo hayan hecho, vengan conmigo. Hay un paso adicional para nutrir a la adivina abisal e incrementar su capacidad de adivinación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500454
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500454,
					"content": "¡Qué dolor de cabeza! ¿No pueden ayudarte las miko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500455,
					"content": "*Suspira*, es inútil discutir con las miko más jóvenes. Cada vez que escuchan esta leyenda antigua, reaccionan con desprecio. Pocas de ellas están dispuestas a echarme una mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500456
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500456,
					"content": "¿Se refiere a Tsuyuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500457
					]
				},
				{
					"id": 721500457,
					"content": "Es cierto, ¡esa miko del Santuario Sangonomiya no tiene ningún respeto por los ancianos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500458,
					"content": "Ah, ¿así que la conocen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500459
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500459,
					"content": "Jeje... Ella es muy capaz, es solo que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500460
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500460,
					"content": "Jeje... No hablemos más del tema. Llegará el día en el que los jóvenes valorarán la importancia de las leyendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500461
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500461,
					"content": "Ehmm... ¿A qué se refiere? Paimon no entiende nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500462,
					"content": "No puedo evitar sentirme desalentada al ver que el brillo de las adivinas abisales disminuye con el paso de los días...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500463
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500463,
					"content": "Parece un serio problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500464
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500464,
					"content": "Puedo entender las objeciones de las miko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500465
					]
				},
				{
					"id": 721500465,
					"content": "Entonces, ¿podrían ayudar a esta anciana y traer un poco de agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500466
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500466,
					"content": "Le ayudaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500467
					]
				},
				{
					"id": 721500467,
					"content": "Entonces, lo dejo en sus manos. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500407,
					"content": "¿Hay algún peligro en mi futuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500403,
					"content": "Hola, abuela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				}
			]
		},
