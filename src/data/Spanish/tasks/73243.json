			"dialogs": [
				{
					"id": 732432401,
					"content": "“Este tablón de mensajes es solo para comunicaciones internas de la Academia. Se prohíbe publicar aquí información falsa o ilegal”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
					],
