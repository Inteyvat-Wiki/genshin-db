	"talks": [
		{
			"id": 7324301,
			"completionStepIds": [
				7324301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324301",
							"2"
						],
						"stepId": 7324301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Todas las notificaciones de la Academia de Sumeru han sido trasladadas al conmutador Akasha. El actual tablón de anuncios está reservado únicamente para la comunicación entre profesores y estudiantes. ¡No se permiten mensajes externos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "“¡Por un ambiente académico más agradable y para que todos puedan escribir sus tesis con una gran sonrisa!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430202,
					"content": "“¡Apoyemos a Vikram como el próximo Gran Archivista!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430203,
					"content": "“¡Te invitamos a unirte al ‘Club de Amigos de Vikram’, donde podrás conocerlo en persona!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "“Nunca olvides las tres virtudes y los seis pecados de la Academia de Sumeru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430302,
					"content": "“Hablar con franqueza, pensar con sabiduría y actuar con integridad. Son las virtudes que todo erudito debe cultivar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430303,
					"content": "“Tres virtudes que Rifaet practica desde hace décadas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430304,
					"content": "“Bienvenidos al Club de Lectura Fravashi, donde nos encomendamos hacia la sabiduría y el futuro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "“Miembros del Club de Lectura Fravashi, admiro su compromiso con la sabiduría”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430402,
					"content": "“Sin embargo, he oído que más de la mitad de los artículos académicos de Rifaet los escribió otra persona”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430403,
					"content": "“Es por eso que permanece tan discreto a pesar de sus muchos logros académicos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430404,
					"content": "“En un tablón de anuncios no se deben publicar argumentos extensos como si fuera un libro, ni debe usarse para atacar a otras personas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430405,
					"content": "“¡Todos esos comentarios los escribieron por envidia!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430406,
					"content": "“Además, escuché que Vikram se ganó el corazón de muchas chicas gracias a su elocuencia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430407,
					"content": "“Estas chicas ni siquiera saben que está casado. ¿Qué? ¿También estás celoso de su popularidad con las mujeres?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430408,
					"content": "“Están prohibidos los ataques injustificados y malintencionados contra los eruditos de la Academia de Sumeru. Las personas que sigan esparciendo rumores serán investigadas por la matra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "“El tablón de anuncios aún no forma parte del conmutador Akasha, por lo que sus entradas se pueden leer directamente”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430502,
					"content": "“Está estrictamente prohibido el intercambio de información por otro medio que no sea este tablón de anuncios. La transparencia es tarea de todos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "“Nos gustaría recordar a los estudiantes que deben mantener la disciplina dentro y fuera de la Academia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430602,
					"content": "“La tarea principal de la Academia de Sumeru es gestionar de manera centralizada el conocimiento. No pierdas la oportunidad de estudiar con nosotros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "“Recientemente, se han dado casos de robo de varias cápsulas de conocimiento. Una vez que haya concluido la investigación, se ofrecerá información detallada a los profesores y estudiantes a través del Akasha antes del Día del Jñagarbha”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430702,
					"content": "“Se anima a los profesores a mejorar la comunicación con los estudiantes para evitar que sufran demasiado estrés durante la realización de la tesis”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "“Se dice que la Academia está promocionando el uso del conmutador Akasha, pero a mi parecer, no lo suficiente. Gran parte del trabajo de muchos oficiales se ha vuelto ineficiente y, en algunos aspectos, incluso ha empeorado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430802,
					"content": "“Imagina poder asignar las tareas por el Akasha y hacer que gestione directamente las transacciones”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430803,
					"content": "“En ese momento, podremos despedir al menos a la mitad de los oficiales”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430804,
					"content": "“Tienes razón. Creo que tal vez por eso no podemos hacerlo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "“Como todos sabemos, el deber de los eruditos es profundizar en el conocimiento. Sin embargo, la actual Academia de Sumeru está demasiado ocupada con tareas administrativas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430902,
					"content": "“Hoy día, después de terminar sus estudios, muchos estudiantes se ven obligados a interrumpir sus investigaciones y son enviados a otro lugar a trabajar como oficiales. ¿No se desvía esto del propósito original de la Academia?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430903,
					"content": "“¿No se solucionó ese problema hace mucho tiempo con los conmutadores?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732430904,
					"content": "“Mientras que la gente se queda atrapada en las supersticiones, solo nosotros nos acercamos a la verdad. ¿Cómo podríamos despreocuparnos del deber de iluminar al mundo? ¡Si no hacemos nada, Sumeru será un caos!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "“Como estudiante de intercambio, podía sentir la grandeza de la Reina Mayor Rukkhadevata todos los días en la Academia de Sumeru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431002,
					"content": "“Cuando estaba en Mondstadt, tuve que consultar muchos libros para resolver una simple pregunta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431003,
					"content": "“Pero con el conmutador Akasha, puedes obtener la información necesaria en el momento preciso. Creo que no hay mejor creación en el mundo que el conmutador”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "“Los fondos asignados anualmente por la Academia a la Facultad Kshahrewar no han aumentado desde la época del Profesor Kavikavus”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431102,
					"content": "“Los superiores dicen que, para tener una vida estable y pacífica, hay que controlar estrictamente el desarrollo y la investigación tecnológica, así como su popularización. Si realmente es así, ¿entonces, para qué existe el conmutador Akasha?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431103,
					"content": "“Si no fuera por el apoyo financiero de los comerciantes, como el de la magnate Sangemah Bay, ¡la Escuela de Tecnología habría desaparecido hace mucho tiempo!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "“Confío completamente en los sabios y tutores. Sin embargo, ¿la Academia de Sumeru hoy en día no depende demasiado del Akasha?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431202,
					"content": "“Es evidente que la capacidad académica de los eruditos que enviamos afuera ha disminuido después de que nos acostumbráramos a usar el conmutador Akasha. Creo que es necesario restringir el acceso al conmutador a los nuevos estudiantes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431203,
					"content": "“¿Cómo puedes decir eso? ¿No sabes que las escuelas que se escondieron en el desierto y no pudieron recibir el conmutador se volvieron ignorantes y empezaron a tragar serpientes venenosas vivas para adquirir sabiduría?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431204,
					"content": "“Después de que la Reina Mayor Rukkhadevata partiera de este mundo, el Akasha aseguró la pureza de nuestro conocimiento”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "El seminario de botánica de esta semana, presentado por el guarda forestal Tignari, tendrá lugar en el Jardín Dhyai, como de costumbre. Puede inscribirse quien quiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431302,
					"content": "¡Cualquiera puede participar siempre y cuando esté interesado en las plantas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431303,
					"content": "Lo sentimos. Debido al aforo limitado, la Academia de Sumeru ha decidido restringir la asistencia solo a estudiantes y guardabosques de la Escuela de Biología.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "“¿Alguien ha leído la última novela publicada por la Editorial Yae? Es de un autor de Sumeru llamado... Pursina, o algo así. Es de la Escuela de Biología”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431402,
					"content": "“Humm... Si hubiera entrado en la Facultad Amurta, podría hacer turismo todos los días y tendría tiempo para escribir novelas. Pero ahora estoy en la Haravatat y todos los días tengo que leer documentos y escribir tesis, sin posibilidad de explorar el mundo exterior”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431403,
					"content": "“¿Qué? ¿Alguien ha publicado una novela en la Editorial Yae antes que yo? Esto dañará mi reputación como escritor de novelas cortas...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "“Ciertamente, hacer negocios no tiene nada que ver con lo que se describe en los libros. Me arrepiento de no haberme quedado en el Gran Bazar a hacer negocios”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431502,
					"content": "“Ahora ni puedo escribir la tesis ni tengo dinero”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431503,
					"content": "“Si las cosas continúan así, tendré que dejar de estudiar para unirme a Los Eremitas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "“No tengo prejuicios con la gente del desierto, pero creo que el puesto de Gran Juez debería ocuparlo un erudito renombrado y respetado, especialmente porque los problemas académicos no se pueden resolver peleando”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431602,
					"content": "“Jeje, todo era mucho mejor cuando estaba a cargo la Escuela de Iluminacionismo. Al menos no favorecían a ninguna escuela. ¿De verdad crees que nadie conoce la verdad tras los índices de sus publicaciones?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431603,
					"content": "“¡Oye, tú! ¡El de la Escuela de Tecnología! Será mejor que tengas alguna prueba o se lo contaré a la matra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "“Puedo aceptar que haya estudiantes extranjeros, pero permitirles acceder al Akasha es otra cosa”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431702,
					"content": "“Sin mencionar que los forasteros podrían utilizar el Akasha para fines indeseados. Quién sabe cómo podría afectar la fuga de conocimiento al comercio exterior de Sumeru”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431703,
					"content": "“Es raro encontrar eruditos preocupados por la economía...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431704,
					"content": "“Es por eso que dicen que los de la Escuela de Semiótica se lo tienen muy creído. ¡No estaría aquí si no quisiera aprender a sintetizar mejores pinturas!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "“Hace tiempo que no veo a ese enano del desierto. Supongo que podemos relajarnos un poco”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431802,
					"content": "“No sé que mosca les ha picado a los supervisores, pero no me dejaron aprobar el examen del curso pasado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431803,
					"content": "“Recuerdo que aquel no fue un examen que se pudiera aprobar solo con la asistencia, así que no culpes a los demás por no haber estudiado. Y aunque la matra anda escasa de personal, ten cuidado con lo que dices”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431804,
					"content": "“¿Qué matra ni qué matra? Todo lo que hacen es alardear de su autoridad. Espera, el Akasha me ha enviado un mensaje...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431805,
					"content": "“Parece que deberíamos tener más cuidado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324319",
							"2"
						],
						"stepId": 7324319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "“... Sobre la investigación de Zandik... dastur... Causa de la muerte... posible asesinato...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431902,
					"content": "“... Zandik... después de ser expulsado... Sobre la eleazar... Pero faltan pruebas...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431903,
					"content": "“... Los registros desaparecieron repentinamente... Año desconocido... Comienza la propagación de la eleazar...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431904,
					"content": "“... Antes de su desaparición... La leyenda de Váruna... se obsesionaron con...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732431905,
					"content": "“El contenido que hay a continuación está completamente distorsionado y no puede distinguirse ni una sola palabra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
