			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "“Después de leer el «Catálogo estelar» del grandioso sabio Tabari, me di cuenta de que todo, ya sea la guerra de los Arcontes o el colapso de antiguas civilizaciones, es una proyección de los movimientos de las estrellas en el mundo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732432002,
					"content": "“Lo único que dura para siempre es el cielo infinito que hay sobre nosotros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732432003,
					"content": "“¡Vaya! Esta investigación está llena de palabras sin sentido. Entonces, ¿resulta que la investigación de la Escuela de Iluminacionismo consiste en entremezclar los eventos pasados?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732432004,
					"content": "“De verdad espero que aprendan a tratar las preguntas desde una perspectiva histórica en lugar de mirar las estrellas y especular sobre dioses todo el día”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Tablón de mensajes"
				},
				{
					"id": 732432005,
					"content": "“¡Qué sabrás tú de las leyes del universo! No me extraña que a todos los de la Vahumana les llamen ratones de biblioteca”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de mensajes"
				}
			]
		},
		{
