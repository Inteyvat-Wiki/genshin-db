			},
			"dialogs": [
				{
					"id": 150170401,
					"content": "Eh... Hay un Tepetlisaurio ahí arriba, aunque Paimon no sabe si será el de Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170402,
					"content": "Al menos, no parece que esté en peligro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "Humm... No, no, espera. Vinimos aquí a buscar a Tlazolli, pero no está por ningún lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170405,
					"content": "#¡Eeey! ¡{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170406,
					"content": "Es Cheven. ¿Por qué estará gritando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170407,
					"content": "Hay alguien a su lado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "¡Vengan, rápido! ¡Tlazolli está aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170409,
					"content": "¿Eh? ¿Acabamos de llegar y Tlazolli ya ha vuelto? Qué coincidencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170410,
					"content": "Bueno, vamos abajo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "¿Eh? ¿Por qué ese Tepetlisaurio nos está siguiendo...? ¡Eh, oye! ¡No corras, que nos vas a dar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170414,
					"content": "Bajan la montaña junto al Tepetlisaurio...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "Iengu, ven aquí. ¿Ya estás haciendo travesuras otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170416,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170417,
					"content": "Buen saurio. ¿Tienes hambre? Lo siento... Te prepararé algo rico más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170418,
					"content": "Vamos, vete a jugar. En un rato iré a buscarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170419,
					"content": "¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170420,
					"content": "#Lo siento. L{F#a}{M#o}s estaba esperando en casa cuando Nechca... Bueno, se escabulló y salió a escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170421,
					"content": "#Cuando la encontré, me dijo que solo quería hacerle un regalo a nuestr{F#a}{M#o}s invitad{F#a}{M#o}s, así que salió a buscar unas cuantas flores bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170422,
					"content": "Iba recogiendo flores mientras caminaba, pero acabó perdiéndose... Menos mal que conseguí encontrarla a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170423,
					"content": "¿Está bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "Cheven nos dijo que hacía poco que había empezado a recuperarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170425,
					"content": "Aún está bastante débil. Se ha llevado un buen susto, y también ha estado expuesta al frío, así que ahora tiene un poco de fiebre. Acaba de tomarse la medicina y de irse a dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170426,
					"content": "No es nada grave, con descansar una noche debería recuperarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170427,
					"content": "Sin embargo... me temo que no va a poder reunirse con ustedes hoy. Lamento que hayan venido hasta aquí en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170428,
					"content": "Oh, ¡no te preocupes! Cheven nos contó que la enfermedad de Nechca era muy grave y que había tenido problemas para recuperarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170429,
					"content": "Por eso quisimos pasarnos a ver cómo estaba. En cualquier caso, tiene que cuidarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170430,
					"content": "¿Se ha recuperado ya de su anterior enfermedad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "... Bueno, al menos ahora puede hablar conmigo y seguir con su día con normalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170432,
					"content": "Eso ya es un gran avance. No puedo pedir nada más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170437,
					"content": "¡Oye, oye! ¿A qué vienen esos ánimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170438,
					"content": "Le agradecemos que intentara darnos la bienvenida con flores. En fin, Tlazolli, sobre lo que te decía antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170439,
					"content": "¡Ah! ¡El regalo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "¡Sííí! ¿Qué clase de regalo es? ¿Podrías decírnoslo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170442,
					"content": "Es un grabado cristalígneo. Lo hice del mineral más puro y es prácticamente inerosionable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170443,
					"content": "Las técnicas utilizadas para su elaboración tienen sus raíces en la artesanía de los nombres antiguos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170444,
					"content": "Entonces, ¿es algo así como una versión simplificada de un nombre antiguo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "Oye, no digas eso... o podrías atraer la ira de las Wayob hacia mí. Simplemente he utilizado las técnicas pertinentes en algunos minerales para crear este cristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170446,
					"content": "La primera vez que hice uno, no pensé que pudiera servir para algo práctico aparte de quedar bonito y ser resistente a la erosión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170447,
					"content": "Pero entonces, Cheven sugirió utilizar estos cristales para hacer unos “accesorios” únicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170448,
					"content": "Grabados cristalígneos realizados por una artesana de nombres antiguos, inscritos con nombres que nunca se borran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170449,
					"content": "¿Qué les parece? ¿No les dan ganas de comprarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170450,
					"content": "Después de esa descripción, a Paimon le parece que debe tratarse de un objeto muy especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170451,
					"content": "Se te da bien hacer negocios...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "Jaja, los grabados cristalígneos de Tlazolli son muy especiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170454,
					"content": "El boca a boca no siempre es fiable. A medida que se transmite la información, esta se va perdiendo u olvidando. Puede que incluso empiecen a difundirse falsedades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170455,
					"content": "Pero una vez inscritas las palabras en estos cristales, ¡perdurarán a través de los siglos, claras e imposibles de distorsionar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170456,
					"content": "Es un regalo de lo más adecuado, tanto si quieres dárselo a un amigo, un amante, o como si quieres legárselo a algún familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170457,
					"content": "¿Me lo estás intentando vender?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#¡Sí! ¡Paimon ya estaba sacando sus Moras! Oye, {NICKNAME}, ¿y si compramos uno y grabamos nuestros nombres en él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170459,
					"content": "#Y así, cuando encuentres a tu {F#hermano}{M#hermana}, podemos hacer que grabe su nombre también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170462,
					"content": "Así, nuestros nombres podrán estar uno al lado del otro para siempre. Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170463,
					"content": "Parece que Paimon ya está enganchada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "#Vamos, no seas modest{F#a}{M#o}. Me salvaste a mí y al regalo de Nechca. Este es un pequeño precio a pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170465,
					"content": "Cheven, ¿no te dije que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170466,
					"content": "Y tú tampoco puedes negarte. ¡Es un gran regalo, Tlazolli! Sé cuánto trabajo cuesta hacer uno de esos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170467,
					"content": "#Gracias, Cheven, y a ti también, {NICKNAME}. Lo tendré listo lo antes posible. Cuando llegue el momento, les pediré que inscriban sus nombres personalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170468,
					"content": "Creo que Nechca debería estar bien para entonces. Seguro que se alegrará de que la visiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170469,
					"content": "Las cosas buenas se disfrutan más en compañía...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "#¿No te estás adelantando? Esas cosas podrían ser bastante caras... ¿Estás segur{F#a}{M#o} de que tenemos suficientes fondos para el viaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170471,
					"content": "Espera un segundo... Esto no será parte de un plan para hacernos gastar todos nuestros Moras, ¿verdad, Cheven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170472,
					"content": "Puede ser, nunca se sabe... Parece que tienen ahorros de sobra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170473,
					"content": "#¡Aaah! ¡No, no! ¡Tenemos que tener cuidado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170474,
					"content": "Jajaja, pueden hablarlo entre ustedes si lo desean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170475,
					"content": "¡Gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170476,
					"content": "¡¿Eh?! ¡Aquí viene otra vez! ¡Rápido, que alguien lo detenga! ¡Paimon no quiere ser embestida de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170477,
					"content": "¡Buen chico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170479,
					"content": "Y también, si no te importa, Tlazolli, me gustaría que me ayudaras a reparar mi grabado cristalígneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170480,
					"content": "Se me cayó la última vez que me atacaron y tanto la cuerda como el enganche se rompieron. Por eso no he podido llevarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170481,
					"content": "Intenté arreglarlo yo misma, pero no lo conseguí. ¿Podrías ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170482,
					"content": "No te preocupes, déjamelo a mí. Lo dejaré como nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170483,
					"content": "Y gracias, Cheven, por estar dispuesta a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170484,
					"content": "No te preocupes, Tlazolli. Mientras Nechca mejore, yo soy feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170485,
					"content": "Sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170486,
					"content": "Vamos, Iengu, ¡pórtate bien! Te daré de comer más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170487,
					"content": "Una vez que el grabado esté completo, haré que Cheven se ponga en contacto contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170488,
					"content": "Tal vez incluso podamos hacerlo coincidir con el cumpleaños de Nechca y montar una buena fiesta, ¿qué les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170489,
					"content": "Jeje, ¡seguro que hay mucha comida deliciosa! ¡Asistiremos con los estómagos listos para la fiesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170490,
					"content": "Hasta la próxima, Tlazolli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170491,
					"content": "Hasta entonces, cuídense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "Hasta la próxima. Cuídense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170494,
					"content": "#Seguro que a Nechca le encantará conocerl{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170492,
					"content": "Espero que tu hija se recupere pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "Deberíamos comprar algunos regalos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "Suena a que es algo demasiado valioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "Estás a punto de convencerme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#Sí, no estaría mal comprar uno y grabar nuestros nombres. Y así, cuando encuentres a tu {F#hermano}{M#hermana}, podemos hacer que grabe su nombre también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170452,
					"content": "No esperaba menos de la dueña de tu propia tienda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "¡Regalito, regalito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "Teniendo en cuenta que fue capaz de salir corriendo, parece que está bastante bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "Sí, y corre especialmente rápido cuando intento que se coma las verduras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170435,
					"content": "Salta por encima de las sillas, se esconde debajo de las mesas... Va de un lado a otro por toda la casa y no consigo atraparla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170436,
					"content": "Así que, viendo cómo está ahora... Estoy muy satisfecha. No puedo pedir más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170411,
					"content": "Pues sí que es toda una coincidencia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "En fin, bajemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170403,
					"content": "¿Habrá subido él solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
			]
		},
		{
			"id": 1501706,
