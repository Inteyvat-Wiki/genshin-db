			},
			"dialogs": [
				{
					"id": 150170201,
					"content": "Hemos llegado. Una casa impresionante, ¿verdad? Un momento, voy a llamar a la puerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "#¡Tlazolli, abre! ¡He venido con ell{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "... ¿Tlazolli? ¿Estás en casa? ¡Abreee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Qué extraño... La puerta está cerrada con llave, pero ella no debería haber salido a esta hora del día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "¿Nechca? ¿Estás en casa? Abre la puerta. Soy yo, Cheven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "(Nadie responde...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Es muy extraño. Se lo había dicho a Tlazolli... ¿Acaso ha tenido que llevarse a Nechca urgentemente a recoger su medicina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "¿Eh? ¿Qué es eso de ahí? Parece un pequeño nido de Tepetlisaurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "En efecto. Tlazolli tiene un compañero Tepetlisaurio. Si mal no recuerdo, se llamaba... Iengu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Cuando aún se dedicaba a la forja, solía pedirle a Iengu que la ayudara a excavar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Pero desde que Nechca enfermó, Tlazolli no ha vuelto a dejar a Iengu excavar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Un momento. ¿Pero qué...? ¡Esto está hecho un desastre! Y tampoco veo a Iengu por ningún lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "¡Eh! ¡Y miren todas esas cajas rotas! No habrá pasado algo malo... ¿Verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Acerquémonos a ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Espera aquí, Cheven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "Oh... Está bien. Yo... ¡buscaré un lugar en el que esconderme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "¿Es que la boca de Imix ha sido bendecida por las Wayob? Siempre que me dice que no vaya a lugares peligrosos, acabo encontrándome con algún peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "¿Quieres que eche la puerta abajo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "¿Les habrá pasado algo? O tal vez la enfermedad de Nechca... Ay, Paimon no quiere ni pensarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "No pienses en eso. Ayer, cuando vine, las dos estaban bien. Nechca estaba durmiendo plácidamente en su dormitorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
