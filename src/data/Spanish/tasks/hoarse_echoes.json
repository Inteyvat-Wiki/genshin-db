			"dialogs": [
				{
					"id": 150170101,
					"content": "#¡Oh! Llegan temprano. Parece que están ansios{F#a}{M#o}s por recibir su regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "Vinimos a visitar a Tlazolli y a Nechca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "¡Sí! Nechca está malita, y Tlazolli tuvo que renunciar a un trabajo muy importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "Aunque las cosas les estén yendo algo mejor, quién sabe si lograrán recuperar el ánimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Jajaja. Ya le he pedido a alguien que se pase por allí y avise a Tlazolli de que vamos. Seguramente ya habrá hecho todos los preparativos necesarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Así que, en marcha. ¿Te importa vigilar la tienda, Imix? Volveré enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "Sí, me pregunto qué será ese regalo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Paimon también se lo pregunta... pero también hemos venido para ver cómo se encuentra Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Después de haber estado tan enferma, quién sabe cómo estará ahora. Y luego está Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "Es difícil saber cómo se sentirá tras renunciar a un trabajo tan importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
