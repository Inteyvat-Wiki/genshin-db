			"dialogs": [
				{
					"id": 761250201,
					"content": "(Tal y como esperaba, Colombina no está aquí.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "¿Será que de verdad ha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250203,
					"content": "(Entró en la puerta de la luna, un lugar tras el que nadie sabe qué hay, y que despedazó incluso al poderoso Cazador de la Luna...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(Si hubiera podido...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "¿Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250207
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250207,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250208,
					"content": "Ah, son ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250209,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250210
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250210,
					"content": "¿Ustedes también están esperando a que regrese Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250212,
					"content": "Vaya, tú también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250214,
					"content": "Vamos, no estés tan triste. Arriba esos ánimos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250215,
					"content": "Si todos estamos tristes, será como si... como si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250216,
					"content": "Paimon no quiere ni pensar en ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250217,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "(No puedo dejar que el sentimiento de culpa tome el control de mis emociones.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "(Colombina no se sacrificó para que las cosas acabaran así, y además...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "Yo... aún no me he rendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "Ni Colombina ni ninguno de sus amigos se darían por vencidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "Dennos un poco más de tiempo. No puedo prometerles nada, pero haré todo lo que esté en mi mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250224,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250225,
					"content": "¿Nos... están dando ánimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250226,
					"content": "Sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
				},
				{
					"id": 761250227,
					"content": "Gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250228,
					"content": "¿Quieren que nos quedemos a hacer algo con ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250229,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250230,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250231,
					"content": "Parece que a esta kuuhenki... le gusta tocar la lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250232,
					"content": "Esta kuuhenki... parece un poco intranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250233,
					"content": "Oye, ¿y si tocas algo? Tal vez escuchar una melodía familiar le ayude a relajarse un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250234,
					"content": "Una melodía familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "Tocaré la canción que Colombina suele cantar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "Se durmieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250237,
					"content": "Paimon supone que llevaban un tiempo sin descansar como es debido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250238,
					"content": "Shhh, vayámonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761250240,
					"content": "¡Sandrone! ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250241,
					"content": "¿Acaso no puedo salir para despejarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761250242,
					"content": "No ha vuelto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "Ya me lo imaginaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761250244,
					"content": "Todo milagro tiene un precio, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761250245,
					"content": "#¿A dónde vas? Paimon quiere decir... ya que nos hemos encontrado, podríamos ir junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250246,
					"content": "Mejor no. Hoy no estoy de humor, así que no tengo nada bonito que decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761250247,
					"content": "Además, lo último que necesita este lugar es consuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
