			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mao",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390201,
					"content": "Azulina, Azulina, ¡no terminaste la historia que me empezaste a contar la otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390202
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390202,
					"content": "Lo sé, pero he cambiado de idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390203
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390203,
					"content": "¿Qué quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390204
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390204,
					"content": "Dejaré en tus manos el final de esa historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390205
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390205,
					"content": "¿Qué? ¡Qué tramposa eres, Azulina! Quedamos en que yo te iba a contar una historia si tú me contabas otra. ¿Por qué ahora me toca contar las dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390206
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390206,
					"content": "Porque no soy más que una bestia tonta a la que no se le ocurre un buen final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390207
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390207,
					"content": "Se me ocurre un final triste y trágico que no hará feliz a nadie. Por eso quiero que tú cuentes el final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390208
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390208,
					"content": "¡Tramposa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390209
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390209,
					"content": "No puedo negarlo. Como compensación, te llevaré a un lugar secreto del Monte Lingmeng que tiene unas vistas espectaculares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390210
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390211
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390211,
					"content": "No me mires con esa cara. Te concederé el privilegio de subirte a mi espalda durante... cinco minutos. Bueno, diez si quieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390212
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390212,
					"content": "Bueno... trato hecho. Déjame pensar cómo puede terminar la historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mao"
				}
			]
		},
		{
			"id": 7113903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
