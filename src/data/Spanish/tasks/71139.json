				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390602,
					"content": "Lingyuan, ¿por qué me miras así? ¿Tengo algo encima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390603,
					"content": "Solo estoy pensando en... No, en nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390604,
					"content": "Aunque tú y Serpiente me lo pidan, no me transformaré en humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390605,
					"content": "Jaja, bueno, tampoco te lo he pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390606,
					"content": "Olvídalo. Vamos, ¿no querías echar un vistazo al jardín de té?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				}
			]
		},
		{
			"id": 7113907,
