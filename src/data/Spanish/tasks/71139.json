			},
			"dialogs": [
				{
					"id": 711390801,
					"content": "¡Fujin! ¡Enhorabuena por haber recuperado tu forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390802
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390802,
					"content": "¡Ya se lo oí decir a Azulina! Aunque no paraba de decir “estaba mejor antes” y “no sé por qué ha vuelto a su forma humana” y cosas así, ¡se notaba que Azulina también estaba contenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390803
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390803,
					"content": "#Parece que a Fujin le gusta el té, así que voy a aprender a hacer pastelillos de té con el Sr. Lu. Cuando aprenda a hacerlos, ¡haré los pastelillos de té más deliciosos para Fujin y {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390804
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390804,
					"content": "Jeje, gracias, Mao. A cambio... Sí, te contaré algunas historias sobre el pasado del Lingyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				}
			]
		},
