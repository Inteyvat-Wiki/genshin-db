							1621.245,
							338.875,
							2414.79
						],
						"pointId": 311500192
					}
				]
			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "¿Eh? Lingyuan, ¿eres tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390303,
					"content": "Ay, perdón. ¿Estabas cazando? ¿Te hemos molestado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390304,
					"content": "No, no me han molestado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390305,
					"content": "Ehmm... Entonces, ¿estabas pensando? ¿En qué? ¿En comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390306,
					"content": "No es lo que tú piensas, solo estoy... reflexionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390307,
					"content": "Reflexionando... ¡Un momento! ¡¿Qué has dicho primero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390308,
					"content": "#Estoy pensando en la pregunta que me hizo {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390309,
					"content": "“Si la actividad humana fuera una parte de las leyes de la naturaleza... ¿qué pensarías de los humanos?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390310,
					"content": "Desde que Fujin y Serpiente se marcharon, ha pasado demasiado tiempo desde la última vez que tuve contacto con los humanos que se juntan en asentamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390311,
					"content": "¿Qué hay de Mao? ¡Él es humano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390312,
					"content": "#Mao no forma parte de ningún asentamiento, pero pertenece a los humanos que los construyeron. {NICKNAME} y tú construyeron su amistad como compañer{F#as}{M#os} de viaje, pero tú no le perteneces. Esa es la diferencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390313,
					"content": "¿Crees que Mao no es parte del orden social?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "Aún no. La mayoría de los niños humanos son así hasta que en ellos cala por completo ese orden, igual que la naturaleza misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390317,
					"content": "Hace mucho que no tengo contacto con humanos que se juntan en asentamientos, quizás por odio, quizás por miedo, o quizás por ambas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390318,
					"content": "¿Es porque ocuparon un terreno que pertenece a la naturaleza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "No lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390321,
					"content": "Tal vez no exista una diferencia clara entre ellos y nosotros, pero aún no estoy segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390322,
					"content": "Un joven humano convive conmigo, y un joven ser de mi especie convive con los humanos por curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390323,
					"content": "¿Un joven ser de tu especie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390324,
					"content": "Sí, se encontró con unos humanos que estaban viviendo en las montañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390325,
					"content": "Por tanto, aún no puedo contestar a tu pregunta. Necesito seguir observando a los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390326,
					"content": "Hay muchas cosas que no entiendo, pero intentaré poner de mi parte hasta que pueda darte una respuesta, tal y como te he prometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390319,
					"content": "¿Es porque Fujin se sacrificó por ellos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "No sé yo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "¡Oye! ¡No digas cosas raras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113904",
							"2"
						],
						"stepId": 7113904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mao",
					"Hautemontagne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "Después de escucharte, siento que no hay mucha diferencia entre las historias de la ópera de Fontaine y las que tenemos aquí, en el Valle Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390402,
					"content": "Los caballeros, las brujas, los guerreros y los dragones malvados se matan entre sí, y al final, ¡todos mueren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390403,
					"content": "¡Lo más importante es el proceso, y no el final! ¡No todas las tragedias pueden verse como un espectáculo de artes marciales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390404,
					"content": "Por cierto, Montaña, ¡esos gólems de “Remunia” de los que me hablaste suenan muy interesantes! ¿Son más grande que Azulina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390405,
					"content": "¿Eh? ¿Azulina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390406,
					"content": "Ah, cierto, aún no te he contado lo de Azulina... Hagamos un trato, ¡tú me cuentas lo de los gólems de “Remunia”, y yo te cuento lo de Azulina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mao"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "¡Vaya! Sin darnos apenas cuenta, ¡acumulamos un montón de poder adéptico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390502,
					"content": "Gracias a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "Según lo que dijo antes Fujin, todo ese poder adéptico está destinado al Jade votivo. De esta manera, en el año que viene, ¡deberían tener una rica cosecha en la Aldea Chiaoying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390506,
					"content": "Cuando llegue el momento, Paimon le pedirá a Luo que le prepare un sinfín de manjares. Como por ejemplo... pastelitos de té, pichones, redondo braseado, cerdo char siu, y también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390507,
					"content": "¡Ah! ¡Y té de Chenyu! A ver, que Paimon tiene que anotarlo todo bien... ¡Eh! ¿Quién está ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390508,
					"content": "¿F-Fujin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390509,
					"content": "Ay, disculpen... ¿Les asusté?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390510,
					"content": "¡Pudiste volver a tu forma humana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390511,
					"content": "Así es. *Ejem*, ¿no les dije que no era nada grave? Solo con un poquito de descanso, puedo volver a adoptar la apariencia que más me guste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390512,
					"content": "Quiero darles las gracias por recuperar tanto poder adéptico para el Jade votivo durante mi recuperación. Cuando llegue la cosecha del año que viene, ustedes serán quienes más hayan contribuido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390513,
					"content": "#Jeje, como {F#joven ama}{M#joven amo} que soy, ¡no fue nada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "Por cierto, Fujin, ahora que ya recuperaste tu forma humana y no tienes por qué estar aquí atrapada en este lugar tan oscuro, ¿hay algo que quieras hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390516,
					"content": "Ah... Pues aún no pensé en nada específico. Quizás lo primero sea darme un paseo por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390517,
					"content": "Darle un buen sorbo al té, escuchar la ópera, observar a la gente de hoy en día... Oh, al decir lo de “hoy en día” parezco una de esas viejas testarudas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390518,
					"content": "Pero realmente me gusta hablar de “hoy en día”. Ahora se pueden hacer cosas que no se podían hacer en el pasado. Lo que no conseguí hace unos años podré conseguirlo hoy en día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390519,
					"content": "Y después me gustaría ir a visitar la Congregación de Guili, ver Liyue, conocer a la maravillosa gente de la que escuché hablar, y ver a Herbóloga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390520,
					"content": "¿Quieres que te acompañe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "Sí, Fujin. Paimon recuerda que una vez dijiste que no podías estar demasiado tiempo separada del agua, o que solo podrían llevarte a un lugar lejano metida en una tetera adéptica, o algo por el estilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390522,
					"content": "#Jaja... Bueno, gracias por recordar todo eso y por estar dispuest{F#as}{M#os} a ayudarme. No obstante, por el momento me gustaría quedarme en el Valle Chenyu una temporada más para disfrutar del paisaje de mi hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390523,
					"content": "En cuanto a los viajes lejanos, veamos... ¿Y si espero a que Mao crezca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390524,
					"content": "¡Eso sería esperar demasiado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390525,
					"content": "¡Estoy bromeando! En cualquier caso, de momento voy a quedarme aquí. Además, quiero ver si logro convencer a Lingyuan de que me acompañe de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390526,
					"content": "#¡Ah, sí, {NICKNAME}! Una cosa más antes de que se vayan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390527,
					"content": "Tanto Lingyuan como yo te hemos causado demasiadas molestias. Y como ya recuperé una parte de mi poder adéptico, querría ofrecerte mis bendiciones para protegerte en tus próximos viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390528,
					"content": "Jeje, ¡listo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390529,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#Bueno, una vez más... muchas gracias, {NICKNAME} y Paimon, por todo lo que han hecho por mí y por el Valle Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390530,
					"content": "No he notado ningún cambio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "Bueno, es que la “bendición” no es algo que pueda reconocerse a simple vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390514,
					"content": "Me alegra ser de ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#Pues claro, soy {F#la joven ama}{M#el joven amo}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "¡Ey! ¡Deja de hablar así, que ya hemos pasado página!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
