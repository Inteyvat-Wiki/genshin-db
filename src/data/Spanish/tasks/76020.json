							2190.965,
							200.227,
							8784.622
						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "Qué extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "¿Lo vieron? Ese árbol se iluminó de repente, y aparecieron esas cositas... lástima que no sean peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Entonces, ¿esa cosa del medio es su raíz? Paimon no sabe cómo funciona esto, pero está brillando. Ahora se ve mucho mejor que cuando estaba apagado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Le cuentas lo que sucedió...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "Resulta difícil de creer... pero sé que no tienen razón para inventarse algo así. Parece que todo lo que me dijo mi compañero de pesca, que es medio Descendiente Lunaescarcha, era cierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "Pero bueno, ¿y qué? Solo son fantasmas del pasado. No importa qué canciones canten o qué digan, eso no impide que los vivos pesquemos peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "#Por cierto, ustedes también son cazador{F#a}{M#e}s de tesoros, ¿no? Eso que acaban de encontrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "¿Esto es una <color=#00E1FFFF>Insignia del conocedor</color>? Parece una simple pluma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Según me contó un comerciante conocido, si reúnes cinco <color=#00E1FFFF>Insignias del conocedor</color>, podrás encontrar el supuesto Gran Tesoro que está enterrado al este de la luna y al oeste del sol... No sé si será verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200710,
					"content": "Pero muchos cazadores de tesoros se lo creyeron y ahora todos corren desesperados tras ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200711,
					"content": "¡E-es un tesoro al fin y al cabo! Si fuera Paimon, también iría tras él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200712,
					"content": "Si fuera veinte años más joven, yo también... Bueno, no, aun así la pesca seguiría siendo lo más importante para mí. Aunque... hoy me voy de nuevo con las manos vacías, en fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}