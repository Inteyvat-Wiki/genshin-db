						],
						"pointId": 13689
					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "¡Guau! Aquí hay muchas de esas cositas brillantes que vimos antes. Por cierto, ¿dónde estamos exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "¿No habremos llegado justo debajo de ese árbol extraño? Y esas cosas verdes del centro... ¿qué serán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
