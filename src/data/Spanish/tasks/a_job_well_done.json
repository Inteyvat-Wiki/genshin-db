			"dialogs": [
				{
					"id": 401540101,
					"content": "Continúas a cargo de la tienda de alquimia. Gracias a todo el esfuerzo, las ventas se disparan más allá de cualquier expectativa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "#Vaya, no esperaba que el negocio prosperara hasta tal punto en tan poco tiempo, querid{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "¿No serán unos genios de los negocios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "Bueno, tú has ayudado mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "Jeje, siempre tan humilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "#Con todo lo que has conseguido, ya podrías mostrarte un poco más orgullos{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "Si pudiera hacer que se quedaran a mi lado como ayudantes, podría tomarme unas vacaciones el doble de largas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "#En este periodo, hemos logrado recopilar suficientes datos de ventas. Gracias por la ayuda y el esfuerzo de amb{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "#Aunque claro, si estuvieran dispuest{F#a}{M#o}s a seguir ayudando con la tienda, me pondría muy contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "En cualquier caso, tengo que redactar un informe para Jean, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#¡{NICKNAME}, Paimon! ¡Cuánto tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "¡Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "#¡Estás aquí! Justo iba a volver a la sede a buscarte tras terminar aquí con mis querid{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "Sí, los Caballeros ya me han puesto al tanto de la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#No sabía que habías vuelto a pedirle ayuda a {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "#Bueno, este tipo de tarea tan importante requiere sofisticación, y nunca puede faltar {F#una buena compañera}{M#un buen compañero} capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "¿Ves? Yo sola nunca hubiera logrado resultados así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Eso es cierto. Lo que han conseguido aquí es sorprendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "#Había pensado en venir a verl{F#a}{M#o}s tras terminar de planificar otros asuntos, pero no he tenido tiempo hasta ahora... Quería expresarles mi agradecimiento personalmente, al menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "Sabemos que siempre nos has apoyado, Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "Sí, la verdad es que me quedo más tranquila sabiendo que contamos con miembros tan excelentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Jeje. Entonces, ¿podré tomarme unas vacaciones cuando termine todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "Últimamente he estado perdiendo un poco de pelo con tanto estrés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Sin problema. Te agradezco el arduo trabajo que has realizado aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Como te veía en la biblioteca todos los días, pensé que podrías necesitar algo de emoción, y por eso decidí asignarte una tarea en la que tus talentos pudieran brillar más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Pero puede que haya sido demasiada presión de golpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#En realidad no ha sido para tanto. Conté con el apoyo de los Caballeros, y nuestr{F#a}{M#o} capaz {NICKNAME} me ha quitado de encima una buena carga de trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "Además, ha sido divertido volver a investigar. De vez en cuando, no viene mal recordar los viejos tiempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "Me alegra oír eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#Gracias una vez más por tu ayuda, {NICKNAME}. Aquí tienes una pequeña recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "Eso me recuerda que yo también te he preparado un detalle. Espero que te guste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "Estos son los frutos del esfuerzo de todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "Parece que hemos dado con la clave del éxito casi sin darnos cuenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Sí. Tienen una capacidad de aprendizaje impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}