					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732561003,
					"content": "Habrá que ir a ver en la sala de control donde están los relés. De todos modos hay que pasar por allí para llegar al campo de pruebas.",
