					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562401,
					"content": "#Como cabía esperar de la noble emisaria y su Yasnapati, ni los mecanismos del pueblo de Dahri ni los demonios dev han podido detenerl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562402
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562402,
					"content": "¿Eh? ¿Desde cuándo estás aquí, Naseyuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562403,
					"content": "¡He estado todo el rato admirando desde una distancia segura sus impresionantes dotes de lucha! Me acerqué en cuanto vi que obtuvieron el himno de la jvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562404
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562404,
					"content": "Muchas gracias por su esfuerzo. Será mejor que yo guarde los himnos, así por lo menos sentiré que he contribuido en algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562405
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562405,
					"content": "Lo sentimos, pero tú no has ayudado en nada. Además, Zurvan nos dijo que no debíamos darle los himnos a nadie a la ligera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562406,
					"content": "Aun así, yo me he instruido en esos himnos. Si me dejan que los estudie, podría averiguar algo útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562407
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562407,
					"content": "Por ejemplo, por qué estaban escondidos en estas ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562408
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562408,
					"content": "Ahora no es el momento para historias, Nasuraia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562409
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562409,
					"content": "Cierto, ahora lo que tenemos que hacer es ir corriendo a donde está la siguiente jvarena grandota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562410,
					"content": "Siempre tendremos tiempo de escuchar tus historias cuando hayamos reunido todos los himnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562411,
					"content": "Bueno... Está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naseyuna"
				}
			]
		},
