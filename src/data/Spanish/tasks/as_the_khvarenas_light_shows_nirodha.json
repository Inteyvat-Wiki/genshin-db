			"dialogs": [
				{
					"id": 732561201,
					"content": "Efectivamente, el problema estaba en estos relés. No les llega la energía enviada por los núcleos. Tenemos que encontrar la forma de conectarlos todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732561202,
					"content": "Y para colmo, estos relés están bloqueados por culpa de la cristalización. Pero como en estas ruinas no se ha usado la energía de la ponzoña, deben de haber pasado desapercibidas para la jvarena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732561203,
					"content": "La única explicación posible es que los sellase alguien capaz de manipular la energía jvarena. ¿Qué estaría tratando de ocultar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732561204,
					"content": "Eso puede esperar a luego. Ahora lo que más nos apremia es conseguir energía jvarena para eliminar los cristales cenizos que bloquean los relés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732561205,
					"content": "Humm... Por aquí cerca debería haber algún nucleoespectro con energía jvarena. Supongo que puede notarlo, ¿no es así, noble emisaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732561206,
					"content": "Ah... ¡Hum! Por supuesto, ¿acaso dudas del gran poder de esta guardiana floral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "Nunca me atrevería. Entonces, si tiene la bondad de indicarnos el camino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732561208,
					"content": "Tenemos que encontrar el nucleoespectro, eliminar con él los cristales cenizos, y manipular los mezcladores para conectar los relés entre sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naseyuna"
				}
			]
