			"dialogs": [
				{
					"id": 732560601,
					"content": "Parece que por fin hemos llegado al corazón de las ruinas. Ya que soy quien más versado está sobre las ruinas de Dahri, permítanme que les explique.",
					"roleType": "TALK_ROLE_NPC",
