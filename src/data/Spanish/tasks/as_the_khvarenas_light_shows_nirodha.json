			"dialogs": [
				{
					"id": 732562701,
					"content": "Justo como decían las notas... ¿Eh? ¿Cómo es que volvieron tan rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562702,
					"content": "Por sus expresiones, deben haber conseguido el bloque de energía que necesitamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562703,
					"content": "Ya he inspeccionado los núcleos de energía y están en buen estado. Solo tenemos que insertar el bloque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732562704,
					"content": "Si me hacen el favor...",
