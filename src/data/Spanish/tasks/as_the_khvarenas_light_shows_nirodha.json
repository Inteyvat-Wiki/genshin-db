		},
		{
			"id": 7325604,
			"completionStepIds": [
				7325604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325604",
							"2"
						],
						"stepId": 7325604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naseyuna",
					"Sorush",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "¡Miren! ¡Hemos llegado a las puertas del destino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560402,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "¡Eh! ¡Que solo es una puerta como cualquier otra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560404,
					"content": "*Ejem*, lo que quería decir es que podremos acceder a las ruinas si abrimos la compuerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560405,
					"content": "¡El corazón se me acelera solo de pensar en pisar por primera vez las ruinas de Dahri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560406,
					"content": "¿Sí? Viendo lo seguro que estabas antes, cualquiera diría que ya habías explorado muchas ruinas de estas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560407,
					"content": "Je, tras estudiar este ejemplar de «Notas de investigación de René» escrito por un gran erudito de la antigüedad, ¡conozco las ruinas tan bien como si las hubiese explorado en persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560408,
					"content": "¿«Notas de investigación de René»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "¿No lo conocen? Creía que solo los que estamos enclaustrados en el desierto como yo desconocíamos a este gran erudito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560410,
					"content": "En estas notas hay copiados numerosos registros dejados por el pueblo de Dahri. Según el autor, obtuvo el conocimiento para “trascender la mortalidad” en estas mismas ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560411,
					"content": "¡Cuanto más oye, menos creíble le parece a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560412,
					"content": "Dejemos esto a un lado por ahora. Lo importante es que podremos proceder sin impedimentos por estas ruinas mientras tenga estas notas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560413,
					"content": "#¡Compruébenlo ustedes mism{F#as}{M#os} si no me creen! Por ejemplo, ¿cómo resolvía este mecanismo?... ¡Ajá, lo encontré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Naseyuna"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>“Girar los engranajes hasta que se muestren los tres símbolos distintos. Luego, conectar el rectángulo con el símbolo triangular por su base sin cambiar dicho triángulo”.</color> Sigan estas instrucciones que les he dicho y verán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naseyuna"
				}
			]
		},
