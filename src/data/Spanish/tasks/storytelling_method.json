			"dialogs": [
				{
					"id": 728120201,
					"content": "Muy bien, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "Nunca he estado tan cansado. ¿Esta historia siempre fue tan complicada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "Eso te pasa cuando no decides las cosas con anticipación. Sin técnicas narrativas, los demás elementos chocan entre sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "Cuando eso ocurre, acabas perdiendo el control de la trama por completo. Te sentirías agotado sin importar lo que estuvieras escribiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "#*Suspira*, de acuerdo, de acuerdo... No me quedan fuerzas para discutir contigo. Viajer{F#a}{M#o}, gracias por tu... juicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "Creo que aprendí mucho con esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Toma esto como una muestra de mi agradecimiento. Seguiré escribiendo en breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120208,
					"content": "Humm, ¿las técnicas narrativas o la trama? ¿Qué es más importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
