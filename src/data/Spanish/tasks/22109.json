				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "Todavía nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "Ustedes de nuevo... Al parecer las misiones del gremio son cada vez más relajadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090104,
					"content": "Si les interesa, ¿aceptarían otra solicitud personal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090105,
					"content": "En la Llanura Guili hay un montón de Hilichurls con arcos y flechas que están acechando a los viajeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090106,
					"content": "Son solo Hilichurls, pero son muchos y están en un lugar estratégico. Los aventureros comunes y corrientes no son capaces de derrotarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090107,
					"content": "¿Podrías ocuparte tú de ellos? Cuando termines, te daré una generosa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090108,
					"content": "Por cierto, si encuentras algo relacionado con una espada, no olvides traérmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090109,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "#No sé si eres muy ingenu{F#a}{M#o} o muy valiente por aceptar mi encargo así sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090112,
					"content": "#Pero estoy segura de que eres {F#toda una aventurera}{M#todo un aventurero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090115,
					"content": "Bien, basta de charla. Ve a encargarte de esos monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090110,
					"content": "¿Qué relación tienen los Hilichurls con las espadas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "No es nada. Solo tienes que prestar un poco de atención. Si encuentras algo, tráemelo. Si no lo encuentras, no pasa nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090114,
					"content": "El objetivo de este encargo es exterminar a los Hilichurls. Cuando termines, te daré una recompensa, como de costumbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				}
			]
		},
