			"dialogs": [
				{
					"id": 221090301,
					"content": "¿Y bien? ¿Los exterminaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090302,
					"content": "Ya me deshice de ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Bien hecho, ¿no te dieron problemas esos Hilichurls? Solo pregunto por curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090304,
					"content": "¿Todavía no has encontrado nada relacionado con una espada? Como esperaba, de nuevo con las manos vacías...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090305,
					"content": "De acuerdo, toma tu recompensa. Buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090306,
					"content": "¿Por qué tanto interés en una espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "Bueno, supongo que no pasa nada si te lo cuento. Se llama “Cuchilla Oculta”, es el sable de mi hermano mayor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090308,
					"content": "Pero cuando mi hermano falleció, no llevaba la espada consigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090309,
					"content": "Algo debió ocurrir para que perdiera el arma que siempre portaba. No logro entenderlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090310,
					"content": "Pero hasta ahora no he hallado ni pistas, ni la espada, y sigo sin saber con qué se encontró mi hermano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090311,
					"content": "Bueno, basta de charla, toma tu recompensa. Puedes ocuparte de tus asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
