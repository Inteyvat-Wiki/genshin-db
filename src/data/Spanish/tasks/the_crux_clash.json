						],
						"stepId": 200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "#¡Jaja! ¡Sabía que no me equivocaba al presentaros como {F#la favorita}{M#el favorito}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010302,
					"content": "#¿Habéis visto, Kazuha? {NICKNAME} ha ganado sin despeinarse y sin sudar ni una gota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010303,
					"content": "Impresionante. Pero me di cuenta de que parecía moderarse, como si no quisiera herir a su oponente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010304,
					"content": "#He presenciado muchas batallas, grandes y pequeñas. Me basta con ver la pelea de hoy para saber que {NICKNAME} posee una fuerza extraordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010305,
					"content": "#Vamos, todos saben que poseéis un vocabulario muy amplio... ¿No podéis dedicarle unos elogios {F#a la campeona}{M#al campeón}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010306,
					"content": "De acuerdo, pensaré en las palabras adecuadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010307,
					"content": "Peleaste muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010308,
					"content": "Humm... Pensé que querríais demostrar vuestras dotes poéticas, pero supongo que no debo presionaros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010309,
					"content": "#¿Sabéis? Muchos participantes se han sorprendido de que {F#la heroína}{M#el héroe} de Liyue se inscribiera en el torneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010310,
					"content": "Se han inscrito muchos más participantes que otras veces, y entre ellos hay luchadores muy afamados. Estoy segura de que muchos de ellos quieren medir sus fuerzas con vos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010311,
					"content": "#No sabía que fuera tan conocid{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "#¡Jeje! Bueno, como todos os consideran {F#la candidata}{M#el candidato} con más posibilidades, creo que yo también debería comenzar a trataros así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010314,
					"content": "Por un lado, no quiero que desperdiciéis vuestra energía luchando contra rivales de bajo nivel en las primeras fases. Por otro, debéis ansiar enfrentaros a alguien que esté a vuestra altura, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010315,
					"content": "¡Así que os enviaré directamente a las semifinales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010316,
					"content": "¿Eh? Pero si acabamos de empezar en la fase clasificatoria... ¿No es un poco extraño ir directamente a las semifinales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010317,
					"content": "Así es la Capitana Beidou. No podrán persuadirla para que cambie de opinión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010318,
					"content": "De todas formas, con su nivel, habrían llegado a las semifinales igualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010319,
					"content": "Paimon está de acuerdo con eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010320,
					"content": "Bien, yo continuaré viendo las peleas del torneo. Si hay más participantes con potencial, quiero saber quiénes son y qué habilidades tienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010321,
					"content": "¡Ya estamos aquí! ¡El auténtico espectáculo comienza ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010322,
					"content": "Jeje, parece que la Capitana tiene muchas esperanzas puestas en el torneo. No la había visto tan animada en mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010323,
					"content": "Tu oponente ha peleado en muchas rondas hasta llegar a las semifinales. Es un guerrero curtido en batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010324,
					"content": "Tal vez no sea tan fuerte como tú, pero ten cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010325,
					"content": "Lo tendré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "#Muy bien, pues muéstrame que estás list{F#a}{M#o} para la tormenta que se avecina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010328,
					"content": "¡Ya basta de palabrería! El público está esperando. Buscad al miembro de la tripulación que os inscribió para que os conduzca a la arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010326,
					"content": "No he olvidado mi objetivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "No sé por qué tanto alboroto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
		{
			"id": 200106,
			"completionStepIds": [
				200106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
