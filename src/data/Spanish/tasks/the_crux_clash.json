				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011101,
					"content": "Ahora que estamos solos, iré directo al grano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011102,
					"content": "En realidad, tú tienes mucha experiencia controlando los elementos. Y no solo uno, sino varios, ¿no es cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011103,
						20011104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011103,
					"content": "Así que ya lo sabes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "Paimon notó que querías decirnos algo desde el primer momento que nos vimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011106,
					"content": "Sí. Si los demás participantes hubieran oído hablar de tus habilidades elementales, habría creado malentendidos no deseados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011107,
					"content": "Si no me equivoco, a ti también te preocupa eso, dada tu reticencia a utilizar habilidades elementales en el fragor del combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011108,
					"content": "Sí, pero ¿cómo lo sabes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "Jeje, cuando digo que veo u oigo algo en ti, no es una forma poética de hablar. Lo digo en el sentido más real de la palabra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011110,
					"content": "Desde que era pequeño, he sido muy sensible a las indicaciones de la naturaleza. Puedo escuchar la respiración del viento y los susurros de las hojas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011111,
					"content": "En tu cuerpo oigo este tipo de cosas, nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011112,
					"content": "No tiene ningún sentido, pero Paimon te cree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011113,
					"content": "Mis humildes habilidades no son nada comparadas con tus increíbles hazañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011114,
					"content": "Que un humano pueda controlar los elementos sin una Visión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011115,
					"content": "Por no mencionar tu olor tan complejo. Es como el de una criatura misteriosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011116,
					"content": "¡Ey, no nos juzgues por nuestro olor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011117,
					"content": "¿Podrías contarme cómo obtuviste tus habilidades con varios elementos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011118,
					"content": "La verdad es que no lo sé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "Humm, extraordinario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011121,
					"content": "Entonces, ¿me permitirías la osadía de preguntarte cómo aprendiste a canalizar la energía elemental y utilizarla en el combate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011122,
					"content": "Fue gracias a los conocimientos de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "Jeje, ¡en absoluto! Lo único que hizo Paimon fue contarte lo primero que se le vino a la cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011125,
					"content": "#Ha sido un largo viaje en el que han ocurrido muchas cosas. De algún modo, {NICKNAME} ha aprendido de forma natural a usar los elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011126,
					"content": "Sinceramente, ni siquiera Paimon sabe cómo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011127,
					"content": "Quizás estos asuntos difíciles de entender son la esencia de los dioses y las Visiones que otorgan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011128,
					"content": "No obstante, me gustaría ver con mis propios ojos cómo dominas los elementos. Quizás me revele algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011129,
					"content": "Por supuesto, yo también compartiré contigo todo lo que he aprendido. Así será un intercambio justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011130,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "Ahora probemos tus habilidades, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011131,
					"content": "Por fin una batalla real.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "Fue gracias a la compañía de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "Lo único que hice fue tocar una Estatua de Los Siete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "Ahora entiendo que no quisieras hablar allí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
		{
			"id": 200113,
