			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rongshi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "Estoy sudando a raudales, ¡qué bien se siente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010602,
					"content": "#Enhorabuena. Fui derrotado por {F#la}{M#el} mejor. Debo entrenar más duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010603,
					"content": "Tú también luchaste muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "¡Sí! Por un momento, Paimon estuvo un poco preocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010606,
					"content": "Si tuvieras una Visión, seguro que serías uno de los más fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010607,
					"content": "Cuando era pequeño, quería una Visión. La gente decía que, si eres lo suficientemente fuerte, podrías conseguir una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010608,
					"content": "Pero nunca obtuve una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010609,
					"content": "Al final, perdí el interés. No puedes depender de una Visión como sí puedes depender de tu propio cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010610,
					"content": "Ya he vencido a portadores de Visión en el pasado. Los dioses les dieron su poder, pero no los envidio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010611,
					"content": "¿Eh? ¿Quieres decir que no te inscribiste para obtener la Visión sin dueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010612,
					"content": "No. Solo quería competir contra otros luchadores para ver quién era el más fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010613,
					"content": "Solo al ser derrotado puedes entender tus debilidades y aprender de ellas. Por eso estoy contento con el resultado de hoy. Rara vez tengo el placer de experimentar la derrota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010614,
					"content": "Guau... ¡así es como habla alguien fuerte de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010615,
					"content": "Si en el futuro tienes tiempo, ven a luchar conmigo de nuevo. La próxima vez seré más fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010616,
					"content": "Yo también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "Por cierto, ¿sabes quién más ha llegado a la final? ¿Será alguien aún más fuerte que tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010618,
					"content": "No sé si será tan fuerte como yo... Pero, por lo que he oído, es increíblemente rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010619,
					"content": "Así que no te confíes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010604,
					"content": "Tienes potencial para ser el campeón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				}
			]
		},
		{
