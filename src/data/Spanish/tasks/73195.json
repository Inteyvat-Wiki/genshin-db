			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "“Desde que me convertí en guarda forestal, he pasado tanto tiempo en el bosque que he sentido la necesidad de conversar hasta con los pájaros crepusculares”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951302,
					"content": "“Si tan solo pudiera entender lo que dicen, no me aburriría tanto como ahora”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
