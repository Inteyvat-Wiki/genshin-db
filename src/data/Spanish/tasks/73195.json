			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "“Escuché que el diván antes solía hablar en nombre de los ciudadanos, pero ahora solo obedece ciegamente a los oficiales de la Academia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951602,
					"content": "“Al igual que el visir, su palabra no tiene ningún valor. Solo sirve cuando los oficiales de la Academia quieren librarse de sus responsabilidades”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951603,
					"content": "La orientación que la Academia otorga a todos los órganos administrativos se basa en las enseñanzas de la Reina Mayor Rukkhadevata. Absténgase de cualquier difamación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319517,
			"completionStepIds": [
				7319517
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
