				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "Si en el bosque se encuentra a alguien con la mirada perdida o murmurando, son eruditos en la “fase del retiro delirante”. Por favor, no los moleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951502,
					"content": "Si le causan algún problema, informe a un oficial de la Academia para ayudarle a resolverlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319516,
