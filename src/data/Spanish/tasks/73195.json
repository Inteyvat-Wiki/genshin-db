			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "“¿Alguien conoce a un buen cuentacuentos? Alguien que sepa contar la misma historia una y otra vez”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951002,
					"content": "“Un espantoso espíritu me persigue. Dice que si no le cuento la misma historia todos los días acabará conmigo. Llevo un mes así, la cabeza no deja de darme vueltas, ¡ya no aguanto esta tortura!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951003,
					"content": "“Es muy extraño lo que estás viviendo pero creo saber de alguien que podría ayudarte, un cuentacuentos llamado Madah. Puedes encontrarlo en el Café Puspa”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "“Después de visitar tantos lugares y ver un sinfín de interpretaciones, puedo asegurar que la señorita Nilou es la mejor bailarina en todo Teyvat. Esos eruditos pedantes de la Academia no solo no saben apreciarla, sino que además la critican todos los días. Es un insulto al arte”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951102,
					"content": "“De acuerdo a mi experiencia en Mondstadt, lo que debemos hacer es organizar un club de admiradores para la señorita Nilou, así esos ignorantes del arte no se atreverán a molestarla de nuevo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951103,
					"content": "“¿Un club de admiradores?... ¿Es algún tipo de costumbre en Mondstadt? Pero... una obra es perfecta gracias al esfuerzo conjunto de todos sus integrantes, no sería justo centrarnos en una sola persona”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951104,
					"content": "“Además, creo que el arte en sí debería ser suficiente para crear vínculos entre las personas. Me alegra que hayas disfrutado la danza de la señorita Nilou”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951105,
					"content": "“Una letra tan elegante solo puede pertenecer a una señorita. Es un placer conocer a alguien que comparte mi interés por la danza. ¿Te gustaría salir conmigo alguna vez?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951106,
					"content": "“Disculpa, estoy muy ocupada. Si necesitas algo, por favor, habla con mi representante”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951107,
					"content": "“Parece que este muchacho ha sido rechazado. El último mensaje lo debe haber escrito un hombre... Tal vez el guardaespaldas de una joven adinerada”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "“Se venden lámparas mágicas de genios. Coloque su pago aquí. Un solo Mora puede hacer sus sueños realidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951202,
					"content": "“Se venden lámparas mágicas capaces de cumplir deseos. Un solo Mora puede hacer cualquier sueño realidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951203,
					"content": "“Soy un genio. Solo deme un Mora y cumpliré todos sus deseos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951204,
					"content": "“La Ciudadela Regzar se encuentra investigando la reciente ola de estafas. Por favor, no se alarmen, que no cunda el pánico”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951205,
					"content": "“Las víctimas que tengan alguna duda pueden realizar cualquier consulta por tan solo un Mora”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319513",
							"2"
						],
						"stepId": 7319513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
