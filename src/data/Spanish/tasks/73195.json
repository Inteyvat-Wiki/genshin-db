			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951701,
					"content": "“La ciudad del conocimiento nos pertenece, igual que la jungla de la ignorancia. Lo que rebosa del preciado árbol son los restos del reino de los sueños perdidos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
