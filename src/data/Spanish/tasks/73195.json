			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "“Recuerdo que había una mercenaria muy buena a la que llamaban ‘Leona Ardiente’ o algo así”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951402,
					"content": "“Solía contratarla para protegerme en mis viajes de negocios. Nunca tuve miedo de encontrarme con ladrones de tesoros o con la Geoarmada. Hice una fortuna gracias a ella”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951403,
					"content": "“Pero últimamente parece que no está aceptando encargos. Además, he oído que cada vez hay más monstruos en el camino a Liyue... A este paso tendré que guardar mi dinero en Transacciones Kalimi”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951404,
					"content": "“Parece que tus negocios no son legales... Pero bueno, sobre la Leona Ardiente, escuché que hace poco aceptó un gran encargo de los Homayani. Tendrás que esperar bastante tiempo si quieres contratarla”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951405,
					"content": "“Por otro lado, déjame darte un consejo. Si tienes dinero, ¡no lo inviertas en Transacciones Kalimi! ¡Comprar cien alfombras es mejor inversión que eso!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731951406,
					"content": "“¡Esta persona tiene razón! Mejor compra cien alfombras, nuestra tienda vende las mejores. ¡Te explicaré al detalle cómo usar cada una de ellas!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
