			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "El gran visir ha creado este tablón de anuncios para publicar los asuntos más relevantes de la Ciudad de Sumeru. En caso de tener alguna duda sobre ellos, pueden publicar sus preguntas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "“Aviso: buscamos aventureros expertos que puedan hacerse cargo de un caracal patilludo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950202,
					"content": "El mensaje del aviso está manchado con tinta. Al lado hay una frase escrita con letra torcida e infantil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950203,
					"content": "“¡El Caracal Rajá solo quiere jugar!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "“Si después de comer hongos ve hadas bailando por ahí, no se preocupe, es una reacción totalmente normal”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950302,
					"content": "“Sin embargo, si además de esto, las plantas comienzan a hablarle, comuníquese de inmediato con el guardabosques más cercano y solicite ayuda”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "“Debido a causas desconocidas, las zonas marchitas del bosque han comenzado a crecer tanto en cantidad como en superficie”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950402,
					"content": "“Además de marchitar la vegetación de las áreas afectadas, las zonas marchitas son sumamente letales para los animales e incluso para las personas. Los guardas forestales las han calificado de ‘áreas contaminadas’. Por su seguridad, no se acerquen a ellas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950403,
					"content": "“En caso de encontrar nuevas zonas marchitas en el bosque, comuníquese con el guardabosques más cercano y deje que un profesional se encargue”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Durante recientes inspecciones, la matra ha descubierto múltiples casos de comercio ilegal de conocimiento encapsulado en diferentes bazares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950502,
					"content": "El comercio de conocimiento encapsulado está prohibido por la Academia de Sumeru. Aquellos que sean descubiertos realizando esta práctica serán severamente castigados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950503,
					"content": "La Academia de Sumeru no se hace responsable de las posibles consecuencias del uso ilegal de conocimiento encapsulado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "“Se acerca nuevamente el Festival anual Sabzeruz. El Gran Bazar organizará una gran celebración al igual que el año pasado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950602,
					"content": "“Para animar aún más el festival, este año la señorita ha preparado unos fondos especiales para todos los comerciantes que participen”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950603,
					"content": "“¡Celebremos juntos el cumpleaños de la Reina Menor Kusanali!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "“Nuestra hija salió y no ha vuelto. Si ve a una joven de cabello castaño con una blusa morada y una falda larga de color azul, comuníquese con la familia Homayani. Su ayuda será bien agradecida”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950702,
					"content": "“Si eres tú, hija mía, la que está leyendo este anuncio, por favor comunícate con nosotros lo antes posible. Tus padres estamos muy preocupados por ti”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "“¡Ha vuelto! ¡Nuestro señor al-Ahmar ha vuelto!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950802,
					"content": "“¡El día de su regreso aquellos con hojas en la cabeza recibirán su castigo!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950803,
					"content": "Esta es información falsa y estamos investigando su origen. Todos los asuntos considerados de suma importancia, dentro y fuera de Sumeru, serán publicados en el Akasha. Por favor, no confíe en los rumores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "“¿Te encuentras en apuros? La todopoderosa magnate Sangemah Bay está aquí para resolver todos tus problemas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950902,
					"content": "“Solo necesitas unos cuantos Moras, ¡y listo! ¡Problema resuelto!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950903,
					"content": "“¡No lo pienses más! Mi información de contacto es...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731950904,
					"content": "El gran visir ha creado este tablón de anuncios para regular las prácticas comerciales. Por favor, no coloquen ningún tipo de publicidad aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319510,
			"completionStepIds": [
				7319510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
