			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "¡Qué imagen tan buena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610202,
					"content": "¡Jajaja! Kichiboushi muy lindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610203,
					"content": "Este tanuki... ¡Deja de echarte flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610204,
					"content": "Oh, Paimon... ¿Qué magia utilizar Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610205,
					"content": "¡Los Adeptus son muy poderosos! Deja que Paimon piense en un ejemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610206,
					"content": "Empecemos por los ámbares que vemos por aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "¿Qué ser ámbares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610208,
					"content": "¡Oh! Paimon recuerda que Moldeador de Montañas tiene flores que producen ámbar y atrapan en su interior todos los males que nos atormenten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610209,
					"content": "¡Mordedor ser alucinante! Protege Liyue y aprisiona cosas malas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610210,
					"content": "Hace mucho tiempo, los Cuatro Oni de Ogata, muy perversos, llegaron al bosque para sembrar caos y amenazar a pobres tanuki. Entonces, Ioroi transformarse en oficial y darles comida de tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610211,
					"content": "Después, Ioroi y rey Otogi encerrarlos en papel, y ya no poder salir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610212,
					"content": "Vaya con la historia, con razón Ioroi se asustó en cuanto vio la imagen de Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610213,
					"content": "Ioroi no ser Adeptus, no proteger Liyue. Pero proteger bosque, proteger a tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610214,
					"content": "Cada persona tiene cosas distintas que defender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610216,
					"content": "Cuando seas mayor lo comprenderás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "Por eso, Kichiboushi, tienes que entrenar mucho, ¡y te convertirás en un supertanuki invencible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610218,
					"content": "¡Sí! ¡Tanuki más famoso del mundo, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610219,
					"content": "¡Paimon se pregunta cómo sería Ioroi antes de que lo sellaran! Seguro que era muy divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610220,
					"content": "Ah, Paimon acaba de recordar que algunos Ladrones de Tesoros quedaron atrapados en los ámbares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610221,
					"content": "#Hasta pensaron que éramos {F#mensajeras}{M#mensajeros} de los Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "Parece como si hubieran pasado siglos desde aquello... Pero en realidad sucedió hace no mucho, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610223,
					"content": "¿Humm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610224,
					"content": "Bueno, después de que llegáramos a Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610225,
					"content": "#“El Rito del Descenso es una celebración anual. ¡Muajajaja! Yo, {NICKNAME}, me pondré las botas con toda esa comida deliciosa. ¡Vamos, Paimon, marchando!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610226,
					"content": "“¡Hasta hay ofrendas! ¡Paimon flotará para allá ahora mismo!”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "¿?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610228,
					"content": "Será mejor que no sigamos así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610230,
					"content": "Explicas de forma sencilla lo que ocurrió en Liyue hasta que fuiste a Minlin a buscar a los Adeptus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#... Y entonces, {NICKNAME} y Paimon fueron al Pabellón Liuli a darse un festín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610232,
					"content": "Mordedor ser alucinante, ¡y Estafadora también! ¡Hasta hacen casas que se mueven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610233,
					"content": "¡Y Estafa... Preservadora de Nubes también disfruta mucho de la comida! Tuvimos que preparar muchos platos deliciosos antes de poder verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610234,
					"content": "Glotona, como Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610235,
					"content": "En ese aspecto son igualitas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "¡Eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610238,
					"content": "¿Paimon ser Adeptus? Paimon muy poderosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610239,
					"content": "Guau, tengo sentimientos encontrados. Aunque Kichiboushi elogió a Paimon, Paimon no se siente muy alabada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610240,
					"content": "Pero no, ¡Paimon no es una Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610241,
					"content": "¡Kichiboushi querer jugar con Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610242,
					"content": "Los Adeptus no aparecen así porque sí... Pero podemos dar una vuelta por aquí, es un lugar muy interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610243,
					"content": "¡Kichiboushi va!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610236,
					"content": "Además, las dos vuelan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
