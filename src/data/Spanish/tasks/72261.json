			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kichiboushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610401,
					"content": "¡Menos mal que te encontramos! ¿Estás bien, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610402,
					"content": "*Solloza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610403,
					"content": "No te preocupes, no pasó nada. ¡Pero a la próxima no corras a lo loco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610404,
					"content": "Pareces su hermana mayor, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Paimon es mayor que Kichiboushi, ¡por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610406,
					"content": "Pues a simple vista no lo parece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "¡Eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610412,
					"content": "#Ay... Gracias, {NICKNAME}. Gracias, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610413,
					"content": "¡Kichiboushi creer que sellaban otra vez! Mucho miedo, pero entonces escuchar voz de Paimon y ya no miedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610414,
					"content": "Ah, sí, Ioroi nos contó una vez que algunos pequeños tanuki también fueron sellados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610415,
					"content": "Dentro de ámbar, mucho miedo... Muy oscuro, no ver nada, ni hablar ni moverse. ¡No poder hacer buum buum! Como convertirse en piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610416,
					"content": "Ioroi ser de piedra, pero muy poderoso. Poder ver y hablar, pero no mover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610417,
					"content": "¿Quieres ayudar a Ioroi, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Sí. Después, ayudar otros tanuki de piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610419,
					"content": "#Pero ahora estás con nosotr{F#as}{M#os}, Kichiboushi. ¡No dejaremos que te sellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610422,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610423,
					"content": "¡Pero tienes que portarte bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610424,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610425,
					"content": "¡Buen tanuki! Y ahora, deberíamos dejarlo aquí por hoy. Kichiboushi debe estar cansado, ¿a que sí? ¡Ya es hora de mimir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610426,
					"content": "¡Kichiboushi no tener sueño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610427,
					"content": "Ay, qué fastidio. Si no te portas bien, Paimon no sabe a dónde llevarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610428,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610429
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610429,
					"content": "Kichiboushi admite de mala gana que está cansado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "Ay, es como un niño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610431,
					"content": "Y cada vez se te dan mejor los niños, ¿eh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "¿Ah, sí? Bueno, al fin y al cabo Paimon ha practicado contigo durante todo nuestro viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610433,
					"content": "#¿En serio crees que soy como {F#una niña}{M#un niño}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
					"content": "¡No! Paimon se refiere a que conocimos a muchos niños durante nuestra travesía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610437,
					"content": "#Paimon aprendió muchas cosas en este viaje que hicimos {F#juntas}{M#juntos}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610438,
					"content": "Esta vez aprendimos que... los tanuki y los Adeptus no tienen por qué llevarse bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610439,
					"content": "Ahora tendremos que pensar en nuestro siguiente destino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610435,
					"content": "#Es cierto que hicimos de {F#niñeras}{M#niñeros} en múltiples ocasiones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Sí, hemos cuidado de muchos niños, como la Pequeña Ming o Changchang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610420,
					"content": "#Sí, nosotr{F#as}{M#os} te protegeremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610421
					]
				},
				{
					"id": 722610421,
					"content": "¡Eso! ¡No permitiremos que te sellen, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610408,
					"content": "Pareces su madre, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610409
					]
				},
				{
					"id": 722610409,
					"content": "¡Eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610410,
					"content": "Pareces su abuela, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610411
					]
				},
				{
					"id": 722610411,
					"content": "#“{NICKNAME}, come un poquito más, {F#mujer}{M#hombre}, que tienes que crecer. ¡A este paso te va a pasar como a Sayu!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				}
			]
