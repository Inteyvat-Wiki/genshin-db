				"points": []
			},
			"dialogs": [
				{
					"id": 722610101,
					"content": "¡Eh! ¡Moldeador de Montañas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610102,
					"content": "¡Eh! ¡Mordedor de Montañas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610104,
					"content": "Humm, parece que ese Adeptus no está en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610105,
					"content": "No puedes hablarle así a un Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "Paimon, ¿qué ser Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610107,
					"content": "Hum... Son unas personas muy especiales... ¿O unos animales muy especiales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610108,
					"content": "¿Como Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610109,
					"content": "¡No, no! Los Adeptus tienen poderes fascinantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610110,
					"content": "¿Y también hacen buum buum? ¡Entonces Kichiboushi también ser Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610111,
					"content": "¡Que no, Kichiboushi! Los Adeptus son más viejos, tienen prestigio y, eeeh... ¡majestuosidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610112,
					"content": "Oh, ya sé... Entonces Kichiboushi no ser Adeptus. ¡Pero Ioroi sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610113,
					"content": "Uf... ¡Paimon ya está cansada de explicarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610114,
					"content": "Los Adeptus son unos seres antiguos que protegen Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Kichiboushi ya comprende. Ioroi proteger Bosque Chinju, por eso, ¡no ser Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610116,
					"content": "Bueno, no exactamente, pero si lo quieres entender así, ¡qué remedio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610117,
					"content": "Pero, para una vez que vamos a la morada de un Adeptus, ¡tenemos que capturar una imagen aquí! Kichiboushi, ¡di calavanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610118,
					"content": "¡Ooh! ¡Kichiboushi ser el mejor posando! Calavandaaaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722610119,
					"content": "¡Muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
