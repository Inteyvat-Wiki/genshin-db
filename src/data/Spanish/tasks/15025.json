			"dialogs": [
				{
					"id": 150250101,
					"content": "#¿Ustedes dos son l{F#a}{M#o}s elegid{F#a}{M#o}s por el Anciano Tlapo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "¿Quién eres tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "#Soy el guía designado por el jefe para ayudarl{F#a}{M#o}s, pueden llamarme Toltec. El mensajero del jefe ya me ha explicado la situación al detalle. Vengan conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
