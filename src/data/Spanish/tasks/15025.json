			"dialogs": [
				{
					"id": 150251801,
					"content": "Las pintadas que dejaron los antepasados de los Augures Vientonocturno son verdaderas obras de arte, pero las que hemos visto hasta el momento no parecen contar una historia completa.",
					"roleType": "TALK_ROLE_NPC",
