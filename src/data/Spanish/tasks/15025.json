					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "#{NICKNAME}, Paimon recuerda que ya entramos aquí antes, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "#Nosotr{F#a}{M#o}s somos l{F#a}{M#o}s elegid{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "Lo más extraño es que, tras terminar sus obras, nuestros ancestros no levantaron las restricciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Después de que esta cueva fuera sellada, solo ha entrado la gran chamana Huitzilin... hace doscientos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Según ella, esas pintadas narraban la historia de un héroe llamado Kuntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "Ah, discúlpenme, me fascina el arte de las pintadas y creo que me estoy yendo por las ramas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "#¿No quieres venir con nosotr{F#a}{M#o}s a verlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "No puedo. Hace un tiempo intenté adentrarme en la caverna, pero las restricciones no me dejaron seguir avanzando. No logré levantar la barrera ni con la ayuda de mi compañero Iktomisaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Puede que esa restricción sea una prueba de los ancestros para que solo aquellos que la superen puedan disfrutar de sus obras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "#Pero no se preocupen por mí. No podría seguirl{F#a}{M#o}s ni aunque ese motivo no fuera de peso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "#Yo no poseo la misma osadía que el jefe para poner en duda nuestras tradiciones. Si solo aquellos seleccionados por el Gran Anciano Iktomisaurio pueden realizar esta misión, temo que pudiera pasar algo malo si l{F#a}{M#o}s acompañara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Está bien... ¡Intentaremos no tardar demasiado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
