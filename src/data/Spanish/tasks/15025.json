			"dialogs": [
				{
					"id": 150250401,
					"content": "¡Este debe ser el lugar! El fruto del que hablaba Toltec debería ser como los de la pared, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250402,
					"content": "Paimon ni se fijó en eso la última vez que vinimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250403,
					"content": "Pero ¿cuál deberíamos tomar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250404,
					"content": "Seguro que guarda relación con la habilidad de la que nos habló el jefe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250405
					]
				},
				{
