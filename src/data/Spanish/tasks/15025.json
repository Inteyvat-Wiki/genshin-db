					"nextDialogs": [
						150251804
					]
				},
				{
					"id": 150251804,
					"content": "Paimon lo ha dicho por decir. Toltec nos está esperando fuera, ¿no deberíamos darnos prisa en regresar con los tintes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				},
				{
