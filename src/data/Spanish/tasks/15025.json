			"dialogs": [
				{
					"id": 150250801,
					"content": "¡Gracias por esperarnos! Hemos traído los tintes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250802,
					"content": "#Sabía que conseguirían salvar las restricciones, ¡al fin y al cabo son l{F#a}{M#o}s elegid{F#a}{M#o}s del Gran Anciano Iktomisaurio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250803
					],
					"speakerTitle": "Toltec"
