						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Miren, esta es una de las obras que nos dejaron nuestros ancestros. La que debemos completar es similar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250702,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250703,
					"content": "La figura de la pintura es la legendaria chamana Huitzilin de los Augures Vientonocturno. Vivió hace doscientos años, y también fue elegida por el Gran Anciano Iktomisaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250704,
					"content": "Su dominio sobre las técnicas secretas de los colores no tenía igual, por lo que completó su misión con honores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250705,
					"content": "El pergamino de tela que tienen ante ustedes registra sus propias hazañas, y es muy probable que también sea obra suya. La calidad del mismo hace palidecer incluso a otros pergaminos similares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250706,
					"content": "Es una verdadera pena que, tras su muerte, los elegidos se hayan visto obligados a depositar su esperanza en el “obsequio de los espíritus”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250707,
					"content": "Quieres volver a rescatar su legado, ¿no es cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "#Precisamente, {NICKNAME}. Aunque debo hacer un pequeño apunte. Quienes vamos a rescatar su legado somos nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250709,
					"content": "¡Sí! ¡Paimon está empezando a emocionarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250710,
					"content": "Trae las muestras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250711,
					"content": "Una mujer de los Augures Vientonocturno trae los pergaminos de tela de prueba.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "#{NICKNAME}, aunque la técnica para tintar los pergaminos de tela es bastante complicada, confío en que podrás dominarla. Solo tendrás que seguir mis indicaciones al pie de la letra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250713,
					"content": "No hay problema. Empecemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "Las muestras ya tienen un patrón dibujado, puedes usarlo para saber dónde va cada color. Para que el tinte logre penetrar el pergamino de tela se necesita tiempo, así que debes tener paciencia para evitar mezclar los colores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250715,
					"content": "Teñir la tela según las instrucciones",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Muy bien. La tela ha absorbido el tinte sin problema y los patrones se ven con claridad. Ahora, usa el resto del tinte especial para crear el color peculiar que buscamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250717,
					"content": "¡Bien, el último paso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250718,
					"content": "Usar el resto del tinte",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Humm... ¿Lo hemos conseguido? Paimon no ve nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250720,
					"content": "No hemos logrado recrear el color... El proceso no ha resultado exitoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250721,
					"content": "¿Es culpa de mi técnica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "No, posees un gran sentido de la percepción; lograste dominar las técnicas de pigmentación con maestría. Aunque lo hubiera intentado yo mismo, el resultado habría seguido siendo el mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250723,
					"content": "¿Entonces cuál es el problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250724,
					"content": "Podría tratarse de la técnica de bordado, o tal vez el proceso de pigmentación no es el mismo que el de los pergaminos de tela comunes... Aún no he descifrado este enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250725,
					"content": "Sentimos no haber podido ayudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250726,
					"content": "#Soy yo quien debería disculparse. L{F#a}{M#o}s he hecho embarcarse en esta tarea en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250727,
					"content": "La recompensa que les prometí sigue en pie, pero espero de corazón que no abandonen este cometido. Continuaré mi investigación y me pondré en contacto con ustedes en cuanto dé con una nueva pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250728,
					"content": "#No te preocupes, ¡ni Paimon ni {NICKNAME} piensan tirar la toalla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250729,
					"content": "Aunque... Paimon tiene una pregunta. Si es tan difícil hacer uno de estos pergaminos de tela, ¿por qué no empiezan a registrar la historia por escrito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250730,
					"content": "Siempre has deseado cambiar cómo funcionan algunas cosas, ¿no? Podrías empezar por esto. Además, al dejar constancia por escrito de la historia, podrían entrar en más detalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250731,
					"content": "Parece que han malinterpretado mi posición. No pasa nada, responderé a sus preguntas, pero primero quiero que me acompañen a un lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150250732,
					"content": "Eh... Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
