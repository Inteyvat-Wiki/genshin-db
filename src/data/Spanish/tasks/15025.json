			"dialogs": [
				{
					"id": 150251001,
					"content": "¿Qué les parece este paisaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251002,
					"content": "¡Es hermoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251003,
					"content": "Miren un poco más lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251004,
					"content": "Vaya, esas pintadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251005,
					"content": "Desde la fundación de los Augures Vientonocturno, estos colores nos han acompañado durante más de mil años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251006,
					"content": "Es cierto que me gustaría reformar ciertas costumbres para dotar de una nueva vitalidad a nuestra tribu. Pero si tengo algo claro, es que hay ciertas cosas a las que no podemos dar la espalda si queremos mantener los cimientos de los Augures Vientonocturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251007,
					"content": "Una de esas cosas es la manera en la que contamos la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251008,
					"content": "Paimon cree que lo entiende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251009,
					"content": "Desde los inicios, mi tribu le ha dado color a la historia, y puedo sentir que este no es un legado del que debamos desistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251010,
					"content": "Por tanto, debo encontrar la manera de elaborar ese pergamino de tela, cueste lo que cueste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251011,
					"content": "Disculpa, Paimon se tomó demasiadas libertades antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251012,
					"content": "No pasa nada, agradezco que puedan entenderme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				},
				{
					"id": 150251013,
					"content": "No solo eso, ¡vamos a ayudarte a terminarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "Entonces espero que la próxima vez que nos veamos, podamos continuar este legado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Jefe de los Augures Vientonocturno"
				}
			]
		},
