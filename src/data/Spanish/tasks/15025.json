			"dialogs": [
				{
					"id": 150251201,
					"content": "Paimon recuerda que la última vez que vinimos ya vimos todas las pintadas de la cueva. ¡Los ancestros de los Augures Vientonocturno crearon una verdadera obra de arte!",
					"roleType": "TALK_ROLE_NPC",
