			"dialogs": [
				{
					"id": 150251501,
					"content": "¿Los tintes están escondidos en esta cueva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251502,
					"content": "#Yo solo puedo traerl{F#a}{M#o}s hasta aquí. Únicamente los elegidos del cometido pueden seguir adentrándose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251503
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251503,
					"content": "¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251504,
					"content": "Permítanme explicárselo. Se dice que en esta caverna crecen unos frutos muy peculiares. Su jugo puede usarse para confeccionar un tinte de gran calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251505
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251505,
					"content": "Hace muchos años, algunos de nuestros ancestros quisieron crear una serie de pintadas magníficas. Eligieron esta caverna como taller, tal vez por la facilidad que presentaba para elaborar tintes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251506
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251506,
					"content": "Sin embargo, como no querían que los demás vieran sus obras inacabadas, colocaron algunas restricciones en el interior de la cueva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251507
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251507,
					"content": "Parece que solo aquellos con un dominio sin igual de los colores podrían sortear dichas restricciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251508
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251508,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
