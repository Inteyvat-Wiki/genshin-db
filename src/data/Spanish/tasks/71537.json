			"dialogs": [
				{
					"id": 715370101,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, ¡qué alegría verte aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370102,
					"content": "¿Estás haciendo una felicitación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Sí, vine a Liyue a pasar las vacaciones, y estoy comprando regalos para dárselos a los Caballeros de Favonius cuando regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "Me han contado que en el Rito de la Linterna, la gente de Liyue tiene la costumbre de escribir felicitaciones para acompañar los regalos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "Por eso quise seguir la costumbre y preparar algunas felicitaciones bonitas, pero no acaban de salirme bien haga lo que haga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "#Caballer{F#a}{M#o} Honorari{F#a}{M#o}, ¿sabes cómo hacer una felicitación bonita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370107,
					"content": "Claro, puedes contar conmigo.",
