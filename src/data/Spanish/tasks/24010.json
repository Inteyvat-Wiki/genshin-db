			},
			"dialogs": [
				{
					"id": 240100401,
					"content": "#Ah, viajer{F#a}{M#o}, ¿ya tienes lo que necesitaba? ¿Qué has traído? ¿La paleta de pinturas o el Néctar de Megaflora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
