			},
			"dialogs": [
				{
					"id": 240100301,
					"content": "No podemos dejarnos arrastrar por las formas concretas... Deberíamos extraer la belleza y plasmarla en la obra con medios más simbólicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100302,
					"content": "No, no, así no sirve. Esta composición es demasiado deliberada...",
					"roleType": "TALK_ROLE_NPC",
