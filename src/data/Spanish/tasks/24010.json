			"dialogs": [
				{
					"id": 240100501,
					"content": "¡Gracias! Con estas pinturas tendré para un buen tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100502
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100502,
					"content": "No las vayas a derramar por el agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100503
					]
				},
				{
					"id": 240100503,
					"content": "¿Qué? Jajajaja, resulta que mi técnica pictórica consiste más o menos en eso mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100504
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100504,
					"content": "La diferencia es que yo pongo la pintura directamente sobre el lienzo y luego utilizo una espátula para darles el toque final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100505
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100505,
					"content": "Gracias por tu ayuda. Con estas pinturas, podré continuar mi obra. ¡Ven a verme siempre que tengas tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100506
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100506,
					"content": "Después de todo, si mi trabajo va viento en popa, es gracias a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100507
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100507,
					"content": "#Espero que seas {F#la primera}{M#el primero} en poder contemplar mi obra cuando esté lista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
