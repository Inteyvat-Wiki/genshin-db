			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "Buenos días, ¿qué se les ofrece hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100202,
					"content": "Vengo a recoger los pigmentos de Depierris.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "Ah, vienes a recogerlos por él, ¿no? Los tengo justo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100204,
					"content": "Pues sí que se le acaban enseguida. Cualquiera diría que los tira al mar directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100205,
					"content": "Bueno, aquí los tienen. Gracias por llevárselos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boucicaut"
				}
			]
		},
