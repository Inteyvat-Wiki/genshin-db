					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Gracias, con esto bastará. Luego los plantaré en macetas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400505,
					"content": "Las pondré junto al resto de flores que me ayudaste a recoger antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Como agradecimiento, toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Ahora tengo que plantar las flores en las macetas... Y también las semillas de diente de león.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
