			"dialogs": [
				{
					"id": 207400401,
					"content": "En cuanto a las flores que me pediste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "¿Ya las recogiste todas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400403,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "¡Qué frescas son! Muchas gracias. Las pondré afuera para que atraigan más clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400405,
					"content": "Por cierto, quería pedirte otra cosita... Cuando hizo tanto viento, los dientes de león de la tienda se volaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400406,
					"content": "Aunque el hecho de que las semillas de diente de león se las llevara el viento no es algo malo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400407,
					"content": "Es un poco extraño que en la floristería de Mondstadt no tengamos dientes de león.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400408,
					"content": "Los dientes de león no se pueden recoger sin más y traerlos. Hay que plantarlos desde el principio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400409,
					"content": "Así que ¿podrías ayudarme a conseguir un lote de semillas de diente de león?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400410,
					"content": "¡Yo me encargo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "Muchas gracias. Si mal no recuerdo, justo fuera de la ciudad hay muchos dientes de león.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400412,
					"content": "¿Por dónde debería empezar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "Justo fuera de la ciudad hay muchos dientes de león. Allí deberías encontrarlos sin problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
