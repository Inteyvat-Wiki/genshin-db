				]
			},
			"dialogs": [
				{
					"id": 731850501,
					"content": "Ese animal no parece estar de buen humor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850502,
					"content": "¡Mira esas pezuñas! Seguro que es muy fuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850503,
					"content": "Podría dejar por los suelos a cualquiera con un golpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850504,
					"content": "Paimon, dale la comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "¡No! ¡Ve tú! ¡Rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850506,
					"content": "Aquí tienes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "No pretendo ofenderte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "El animal de carga se acaba la comida lentamente. Parece de mejor humor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "Parece que no se ha enfadado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850509,
					"content": "Llevémoslo de vuelta. Cuidado, no te vaya a dar un golpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850511,
					"content": "Acompañas al animal de carga de vuelta con Elber...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "Menos mal, ya pensaba que había perdido a mi animal de carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850513,
					"content": "#Gracias viajer{F#a}{M#o}, no sé ni cómo agradecértelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850514
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850514,
					"content": "Debería comprobar su estado físico cuanto antes. Espero que no se haya hecho daño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850515
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850515,
					"content": "#Viajer{F#a}{M#o}, por favor, ayúdame a encontrar al otro animal de carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850516
					],
					"speakerTitle": "Elber"
				}
			]
		},
