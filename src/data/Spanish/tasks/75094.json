			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "Es increíble que hubiera sucedido algo así... Milchi y la persona que dejó estas notas, ambos eran tan valientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260602,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "Este es... ¡es el huevo de saurio en hibernación que se mencionaba en las notas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260604,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, quieres que lo incubemos con la incubadora, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260605,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "#Humm, parece que el huevo está en buen estado, y también tenemos el manual de la incubadora. {NICKNAME}, ¿por qué no lo intentamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260607,
						751260608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260607,
					"content": "Aunque no es seguro que funcione, vale la pena intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				},
				{
					"id": 751260609,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260608,
					"content": "¡El pequeñín va a tener un nuevo amigo! ¡Qué bien!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				}
			]
		}
	]
}