		{
			"id": 7509406,
			"completionStepIds": [
				7509406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7509406",
							"2"
						],
						"stepId": 7509406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "*Uff*... ¡Qué miedo tuvo Paimon! Ese monstruo nos atacó de repente, ¡menos mal que somos superfuertes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940602,
					"content": "Tú te encargas para la próxima, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "¿Qué? No, no, no, ¡Paimon no podría! ¡Paimon se niega a combatir con monstruos tan terroríficos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940606,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "#{NICKNAME}, mira, parece que está muy preocupado. Vamos, ¡tenemos que encontrar la forma de incubar el huevo de saurio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940608,
					"content": "Activar la incubadora",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "La incubadora empieza a funcionar...\\nLo único que queda es esperar...\\nSin embargo, después de un buen rato, el huevo de saurio sigue sin inmutarse...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "¿Grr... grr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "Qué raro, parece que no hay reacción. ¿Acaso hicimos algo mal? ¿Qué tal si lo intentamos de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940612,
					"content": "Intentémoslo de nuevo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "Activan la incubadora según las instrucciones...\\nNo obstante, como la última vez, el huevo de saurio se mantiene intacto...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "*Solloza*... ¿Cuánto tiempo tendremos que esperar? Los ojos de Paimon están a punto de cerrarse... También está mareada... Y tiene mucha hambre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940615,
					"content": "Gr... grr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "¿Eh? ¡Oh! ¡Un momento! ¡Parece que se movió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940617,
					"content": "¿Esperamos un poco más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "Después de un largo rato...\\nEl huevo de saurio sigue como antes, sin mostrar ningún cambio, y no hay señal alguna de que vaya a salir del cascarón.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "Sigue inmóvil... ¿No será que la incubadora está rota? ¡Pero si tiene las luces encendidas! ¿Acaso el problema está en el huevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940620,
					"content": "... Bueno, no podemos seguir esperando así... ¿Y si nos llevamos el huevo de saurio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940621,
					"content": "Aunque tengas mucha hambre, no vayas a pensar en comerte el huevo de saurio, ¿de acuerdo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "¡Grr! ¡Grr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#¡Claro que no! ¡Y no le des a {REALNAME[ID(2)|SHOWHOST(true)]} ideas raras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940626,
					"content": "Pequeñín, lo que Paimon intenta decir es que... si el problema está en el huevo, entonces podría ser que nunca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940634,
					"content": "Grr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#No te pongas triste, {REALNAME[ID(2)|SHOWHOST(true)]}, no hay nada que podamos hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940636,
					"content": "Quizás el entorno no es el adecuado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "¡S-sí, tienes razón! ¡Tal vez el saurio del huevo piensa que la Natlan de ahora no es igual a la de antes y que no es apropiada para ser su hogar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940639,
					"content": "Después de todo, siempre estuvo escondido aquí, ¿no? ¡No sabe lo maravilloso que es el mundo de fuera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940640,
					"content": "Así que, ¡llevémoslo y cuidémoslo bien! ¡Le contaremos historias todos los días sobre bonitos paisajes, aventuras espectaculares, y toda esa gente simpática que nos hemos encontrado en el camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940641,
					"content": "En resumen, ¡le diremos lo genial que es la Natlan de ahora! ¡Cuando sienta la emoción, seguro que sale del cascarón por sí mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940642,
					"content": "... Grr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "Tal vez el propio saurio piense que aún no es el momento adecuado para nacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, ¿qué opinas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "¿Grr... grr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "No lo hizo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#¿Eh? Pero... si hace un momento... ¿acaso fue ilusión de Paimon? No, no puede ser, {REALNAME[ID(2)|SHOWHOST(true)]}, ¿tú lo viste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940629,
					"content": "¿Grr... grr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#Vaya... ¿tú tampoco? Entonces, ¿realmente fue imaginación de Paimon? ¿Qué hacemos, {NICKNAME}? ¿Seguimos esperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940631,
					"content": "O es que... ¿el problema está en el huevo? Pe-pero si el problema de verdad es el huevo, ¿eso significa que nunca saldrá un saurio de él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940632,
					"content": "El problema debe ser el huevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "¿Eh? Entonces... ¿podría no nacer nunca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940604,
					"content": "Hum, no fue nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "¡Eso! Paimon pensaba que sería muy fuerte por lo aterrador que se veía, pero resulta que no era gran cosa. ¡Hasta nuestro pequeñín pega más fuerte que él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
