			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "Humm... Parece una tumba de los Lampareros. ¿Será de los soldados ratnik que vimos en el cañón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650102,
					"content": "Aparecían y desaparecían de repente, en un instante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650103,
					"content": "Bueno, Paimon no lo entiende. ¡La próxima vez que vayamos a Piramida, preguntemos por ahí! Tal vez haya alguien que sepa algo sobre esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patolichev"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "Hola, soy Patolichev, encargado de suministros de los Lampareros. ¿En qué puedo ayudarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650202,
					"content": "¿Patolichev de los Corceles de la Ventisca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "Corceles de la Ventisca... Ah, te refieres a aquellas sombras extrañas que vimos antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650204,
					"content": "#Sí, {M#señor}{F#señorita}, ese fue el escuadrón al que pertenecí. Solo con escuchar el nombre me pongo nostálgico... pero nunca imaginé que lo escucharía de usted. ¿Cómo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650205,
					"content": "Estuvimos al pie del Barranco Kipumäki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "¡Así es! Acabamos con la Cacería salvaje que apareció por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650207,
					"content": "Y también vimos a los soldados ratnik de los Corceles de la Ventisca... O mejor dicho, las sombras que dejaron tras la batalla contra la Cacería salvaje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650210,
					"content": "No pensé que fuera verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650211,
					"content": "¡Claro que es verdad! ¡Lo vimos con nuestros propios ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650212,
					"content": "Ah... En estos años, de vez en cuando me decían que veían las sombras de mis camaradas caídos en el Barranco Kipumäki. Por eso voy allí de vez en cuando... y de paso, visito sus tumbas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650213,
					"content": "Pero nunca los he visto, ni una sola vez. Ha pasado tanto tiempo, y ya empiezo a creer que son solo mentiras piadosas para consolarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650214,
					"content": "Y, sin embargo, los vieron con sus propios ojos... ¿Por qué cuando yo voy, ellos nunca salen a verme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650215,
					"content": "Tal vez aún no sea el momento de encontrarse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "Tal vez... pero sé que están ahí. Aunque sea solo un recuerdo, una ilusión fugaz, para mí sería más que suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650219,
					"content": "#En fin, gracias por contármelo, {M#señor}{F#señorita}. Significa muchísimo para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650220,
					"content": "Gracias a ellos puedo estar aquí ahora, aunque desearía volver a estar junto a ellos al pie del Barranco Kipumäki, luchando codo a codo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650221,
					"content": "... Algún día. Algún día los volveré a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650217,
					"content": "Quizás no quieren que revivas recuerdos dolorosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "*Suspira*... ¿Cómo podrían ser dolorosos aquellos días que pasé luchando junto a ellos hasta el final?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650208,
					"content": "Vimos a los soldados ratnik de los Corceles de la Ventisca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "Exacto, y aunque solo quedan algunas sombras, aquellas siguen mostrando su lucha contra la Cacería salvaje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}