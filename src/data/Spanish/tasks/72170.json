					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700201,
					"content": "#Viajer{F#a}{M#o}, ¿ya tienes las algas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700202,
					"content": "¡Estas son! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Bueno, es hora de hacer ese plato que llaman... onigiri, ¿no? Escuché que es un plato bastante fácil de hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Muy bien, espera mientras preparo la comida. Va a tardar un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7217003,
			"completionStepIds": [
				7217004
			],
