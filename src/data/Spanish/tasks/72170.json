					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700502
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700502,
					"content": "Más que recolectar algas, esto es arrancarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700503
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700503,
					"content": "Si usáramos un cuchillo pequeño, las sacaríamos todas muy rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
