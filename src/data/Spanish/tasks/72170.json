			"dialogs": [
				{
					"id": 721700701,
					"content": "Parece que esa área de ahí abajo está inundada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700702
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700702,
					"content": "Sí, y las marcas de agua son bastante perceptibles. Este lugar estuvo inundado hace poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700703,
					"content": "¿Pero por qué se iría el agua de repente?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700704,
					"content": "Uf, este sitio está lleno de agua. Se me van a calar los zapatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "Bueno, olvídalo. Recojamos algunas algas lo más rápidamente posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700706,
					"content": "¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "#¿Eh? ¡Vaya! Nos volvemos a encontrar, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "Bajamos a recoger algunas algas para hacer una comida llamada “onigiri”, pero fue bastante difícil... Ahora tengo los zapatos empapados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "#Pero no hablemos de eso. Viajer{F#a}{M#o}, ¿podrías ayudarnos a conseguir unas pocas algas más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700710,
					"content": "Parece que el área de más abajo se inundó no hace mucho tiempo y, aunque ya no hay tanta agua, quién sabe cuando volverá a inundarse otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700711,
					"content": "Creo que lo mejor sería recolectar lo más rápido posible algunas algas más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700712,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "#Contamos contigo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700714,
					"content": "Cuando tengas todas las algas, tráemelas, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700715,
					"content": "¿Por qué no las recogen en el mar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "Podríamos hacerlo, pero las algas del mar no son tan frescas. Siempre falta algo de sabor cuando hacemos algún plato con ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700717,
					"content": "#La calidad de las algas debería ser mucho mejor en este sitio. Pero necesitaremos tu ayuda, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700718,
					"content": "Cuando tengas todas las algas, tráemelas, por favor.",
					"roleType": "TALK_ROLE_NPC",
