			"dialogs": [
				{
					"id": 721700401,
					"content": "¿Tendremos que bucear para recolectarlas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700402
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700402,
					"content": "¿No podemos ir a otro sitio? ¿De verdad tienen que ser estas algas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700403
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700403,
					"content": "¿Por qué tiene que estar ese mecanismo dentro de la barrera otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
