				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060101,
					"content": "Hola, cariño. Qué bueno verte por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060102,
					"content": "Ciertamente, no solemos reunirnos en un sitio como este, pero como dijo Lisa, me alegro de verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060103,
					"content": "¿Eh? ¿A qué te refieres con “un sitio como este”? Una taberna me parece un lugar estupendo para relajarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060104,
					"content": "No tienes idea del esfuerzo que tuve que hacer para despegar a la Gran Maestra Intendente de su escritorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060105,
					"content": "No hemos pasado más que unos minutos aquí y ya tiene una expresión de preocupación en la cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060106,
					"content": "*Suspira*, Lisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060107,
					"content": "Bueno, los Caballeros de Favonius tienen muchas cosas que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "Bueno, cuando se trata de la Gran Maestra Intendente, ¡es comprensible que tenga muchas preocupaciones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060109,
					"content": "Pero ¿cómo dice el dicho? Ah, sí: “ya que estamos aquí”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060110,
					"content": "#Dejen que {NICKNAME} prepare unas bebidas para ustedes. ¡Se sentirán mucho mejor al tomarlas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060111,
					"content": "Considérenlo una forma de relajación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "Para ser sincera, Jean es la única persona que conozco a la que hay que enseñarle a descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060113,
					"content": "Cariño, prepárame una copa de Poema de amor. Tamaño mediano y con un extra de dulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060114,
					"content": "¿Qué hay de ti, Jean? ¿Qué te apetece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060115,
					"content": "Yo... solo tomaré un café. Mediano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060116,
					"content": "Pero Jean, tú bebes café todo el tiempo. ¿No te gustaría probar otra cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060117,
					"content": "Gracias, pero no. Quiero algo que me mantenga despierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060118,
					"content": "¡Se las traeré enseguida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 7050602,
			"completionStepIds": [
				7050604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
