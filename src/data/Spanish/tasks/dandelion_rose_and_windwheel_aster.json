			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa",
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "Ah... El dulzor justo. Nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060202,
					"content": "El café es fuerte e intenso, con la cantidad justa de amargor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060203,
					"content": "Con que estén satisfechas es suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "En realidad, entiendo a lo que te refieres, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060205,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060206,
					"content": "He estado pensando acerca de mis debilidades. Hay muchos aspectos en los que puedo mejorar, como en materia de productividad y gestión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060207,
					"content": "Me preocupa que la presión que recae sobre mí haya comenzado a afectarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060208,
					"content": "Creo que aún no lo entiendes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060210,
					"content": "#Jeje, ¿ves? {F#Ella}{M#Él} lo sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060211,
					"content": "Como te vi cansada, pensé en traerte a disfrutar de una bebida y pasar un momento agradable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060212,
					"content": "Pero sigues pensando en el trabajo incluso aquí, en la taberna. Eso es lo preocupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060213,
					"content": "De seguir con tanto estrés, terminarás por colapsar tarde o temprano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060214,
					"content": "Exacto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#Oh... ¿Tú también estás de acuerdo con Lisa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060216,
					"content": "Hummm... Entonces, ¿mi mayor reto es aprender a relajarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060217,
					"content": "Citando un proverbio de Liyue, “todo tiene un equilibrio”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "¡Sí! Trabaja, diviértete más y descansa aún más. ¡Paimon cree que las dos necesitan descansar más de lo que se imaginan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060219,
					"content": "Una extraña forma de decirlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060221,
					"content": "Está bien, l-lo entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060222,
					"content": "#Gracias a tod{F#as}{M#os}. Ahora sé que en este lugar se sirven bebidas tanto para el cuerpo como para la mente. ¿Por eso a Kaeya y a ti les gusta tanto venir a la taberna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060223,
					"content": "Sí y no. Depende de quién esté haciendo las bebidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060224,
					"content": "#Por cierto, Jean no habría cambiado de opinión sin tu ayuda. Eres buen{F#a}{M#o} con las palabras, cariño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060225,
					"content": "No fue nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "Jeje, nos vemos en otra ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060228,
					"content": "Si puedo, valoraré la opción de venir aquí para relajarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060229,
					"content": "Genial. ¡Cuídense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060226,
					"content": "Me alegra haber sido de ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}