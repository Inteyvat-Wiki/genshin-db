			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "Lanza recta y hacia delante... ¡Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310102,
					"content": "Vine para entrenar otra vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "Ah, eres tú. ¿Aceptaste mi encargo otra vez? ¡Te lo agradezco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310104,
					"content": "Es estupendo tener a alguien tan formidable como tú para practicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310105,
					"content": "Tu habilidad con la lanza mejoró mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Jaja... No es para tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310107,
					"content": "Por lo que sé, una de las razones por las que se inventó la lanza fue porque permite a alguien que no sabe manejar un arma, como yo, luchar con facilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310108,
					"content": "Después de todo, esta arma es larga y afilada. Aunque su portador no sepa cómo utilizarla, será fuerte con el simple hecho de clavársela al enemigo y atacar con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310109,
					"content": "Sin embargo, según esta regla... En realidad, creo que el humilde rastrillo de campo con sus tres puntas afiladas tiene mayor poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310110,
					"content": "¿Aún no tienes tu arma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "Sí, la recuperé, pero eso no significa que mi entrenamiento haya terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310112,
					"content": "Aunque me he encontrado con un Samurái Kairagi, eso no quiere decir que no me vaya a encontrar con enemigos aún más fuertes en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310113,
					"content": "Nunca dejaré que mi arma vuelva a caer en manos del enemigo para que se profane mi honor como samurái. Ese es el camino del samurái que deseo seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
