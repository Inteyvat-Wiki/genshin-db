			"dialogs": [
				{
					"id": 4260101,
					"content": "Vamos a descansar un rato. ¿Tienes algún plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260102,
					"content": "Estaba pensando hacer una misión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "¡Eso es fácil! Solamente tienes que presionar sobre el signo de exclamación en la esquina superior izquierda de la pantalla y podrás ver las misiones que has aceptado hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260104,
					"content": "Algunas misiones son muy difíciles, así que no podrás completarlas hasta que tengas el nivel suficiente para la misión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260117,
					"content": "¿Algo más que quieras saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260105,
					"content": "Tal vez deba explorar los alrededores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "Algunas áreas son más peligrosas que otras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260107,
					"content": "Al principio es mejor entrenar en áreas fáciles, para que no te hagan polvo cada dos por tres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260108,
					"content": "Alfry, del Gremio de Aventureros, conoce Teyvat como la palma de su mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260109,
					"content": "Vive en el centro de Mondstadt, no muy lejos de la calle comercial. Deberías ir a preguntarle qué áreas son las más adecuadas para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260110,
					"content": "Quisiera ser más fuerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "Pues no puedes volverte más fuerte sin armas útiles o artefactos raros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260112,
					"content": "Escuché que hay muchos de ellos en las mazmorras, pero son lugares muy peligrosos. Probablemente salgas lastimado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260113,
					"content": "Pero si te da miedo la aventura, siempre puedes comprarlos en Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260114,
					"content": "Tanto las armas como los artefactos se pueden fortalecer y ascender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260115,
					"content": "#Pero el resto lo tendrás que averiguar tú mism{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260116,
					"content": "Por cierto, tu propio nivel también es importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260118,
					"content": "Es todo. Voy a pensar qué hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
