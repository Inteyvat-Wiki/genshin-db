					"content": "¡Genial! Pues a darle al molinillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240133102,
					"content": "Comienzan a preparar el café...",
