					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "¡Guau! Huele que da gusto. Vamos a llevárselo a Iaune a ver si se anima un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
