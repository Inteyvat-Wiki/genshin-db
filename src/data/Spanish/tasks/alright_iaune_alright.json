					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "¿D-de verdad me has preparado un café? Ay, siento que te hayas tenido que tomar las molestias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130402,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "Guau... ¡Este café está buenísimo! Es mucho mejor que el que he probado en la Oficina Administrativa. De hecho, está en otro nivel completamente distinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130405,
					"content": "Seguro que si pudiera tomarme una taza de este café cada día, no me arrastraría por ahí como un fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130406,
					"content": "Gracias por el café. Volveré al trabajo cuando me lo termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130407,
					"content": "¡Ánimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "¡Lo intentaré! Necesito mejorar todavía más para poder defenderme por mí mismo como hace el Sr. Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130410,
					"content": "*Suspira*, solo me preocupa todo lo que tenga que aguantar antes de ese momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130408,
					"content": "¡Anímate!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Vamos, pruébalo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
