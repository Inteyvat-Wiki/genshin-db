				"points": []
			},
			"dialogs": [
				{
					"id": 735180101,
					"content": "Los dispositivos de recarga están funcionando mejor... Como dijiste, el entorno elemental de esta zona está volviendo a la normalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180102,
					"content": "Los gusanos de arena afectados también deberían tranquilizarse transcurrido un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180103,
					"content": "Sí, todo gracias a tu pequeño. Volvamos a informar de lo ocurrido y regresemos a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180104,
					"content": "Es nuestro pequeño, Shriya. No he olvidado ni por un instante que este es nuestro proyecto en común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180105,
					"content": "Aunque durante ese año hayamos tenido nuestras diferencias, sin ti, esto no habría sido posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180106,
					"content": "¿Qué... mosca te ha picado? ¿Dices esto porque quieres que diga cosas buenas sobre ti en mi informe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180107,
					"content": "Bueno, es que de repente he sentido que lo que hemos pasado en estos días es muy parecido a lo que vivimos aquel año. Hubo muchas discusiones y golpes, pero al final lo solucionamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180108,
					"content": "Y reconozcamos que, al final, tu solución era más eficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180109,
					"content": "Yo... eh... no es para tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180110,
					"content": "De hecho, también tenías razón en lo que dijiste. De no haber probado el cañón gusicida, no habría podido obtener estos datos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180111
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180111,
					"content": "“Para arreglar una máquina, puede que solo sea necesario cambiar una pieza. Sin embargo, el verdadero reto está en encontrar esa pieza...”. Ahora empiezo a comprender las palabras de mi mentor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180112,
					"content": "Me alegro de que estés aquí, Shriya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180113,
					"content": "Eh... lo mismo digo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180114,
					"content": "#¿Qué está pasando? ¿Ahora estos dos son como uña y carne? {NICKNAME}, esto es muy extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180115,
						735180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735180115,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				},
				{
					"id": 735180117,
					"content": "¡*Ejem*! Al principio de nuestro proyecto de graduación, nuestra relación solía ser bastante tensa porque no éramos muy maduros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180118
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180118,
					"content": "Sí. En retrospectiva, no fue nada particularmente grave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180119
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180119,
					"content": "Esto... la próxima vez... ¿qué te parece si tomamos algo en el café? Podríamos discutir cómo escribir el informe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180116,
					"content": "Déjalo estar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				}
			]
		}
	]
}