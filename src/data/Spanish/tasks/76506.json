			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#¡Pero si son {NICKNAME} y Paimon! Qué sorpresa encontrarl{F#as}{M#os} por aquí. ¡Debe de ser una señal de buena suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "¡Dori! ¿Qué haces sola aquí? ¿Vas a montar un puesto para vender cosas? Pero... ¿y tus productos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Lamentablemente, hoy la famosísima comerciante itinerante Dori se ha tomado el día libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Estoy pasando un día común y corriente, relajado y sin preocupaciones como los lugareños de este paraíso al que llaman Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Guau, no puede ser que no estés vendiendo cosas ni ganando Moras. ¡Esto es más raro que caiga un chaparrón en el desierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Hum, aunque esté de vacaciones, mis tiendas y mis diligentes empleados siguen generando Moras para mí sin parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Mientras los números de mi cuenta sigan subiendo, no hay nada de lo que tenga que preocuparme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Por cierto, ¿acaso tienen algún problema? Ya sé que estoy de descanso, pero no me negaría a atender a un negocio que se me presente así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "Estamos dando vueltas para ver si hay algo que valga la pena capturar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "Aah, quieren capturar los paisajes únicos de Nod Krai, ¿no es así? ¡Entonces están preguntando a la persona indicada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Puede que no conozca este lugar tan bien como los lugareños, ¡pero en cuanto a sitios pintorescos para tomar imágenes, tengo muchísimos que recomendarles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "#Puesto que son mis amig{F#as}{M#os}, yo misma les haré de guía y les haré un superdescuento especial de amigos: ¡tan solo 50 000 Moras por todo el día! ¿Qué opinan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "No le extraña a Paimon, es Dori. Siempre sabe cómo sacar dinero de nuestros bolsillos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "Vaaamos, todo lo hago por mis clientes más importantes. ¡Solo quiero que tengan los recuerdos más felices e inolvidables de Nod Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Bueno, si tanto nos quieres ayudar, déjanos tomarte una imagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "¿Eh? ¿A mí? Humm, es una propuesta interesante. Pero ojo, las imágenes que tomes no se pueden usar con fines comerciales. ¡Mis derechos de imagen valen una fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Tranquila, solo queremos capturar una imagen de nuestra vieja amiga, ¡es solo un recuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Está bien. Ya que es una petición de {NICKNAME}, haré una excepción y seré su modelo. Eso sí, quiero salir elegante y espléndida, ¡es lo único que pido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Humm, como título podríamos poner: “¡Las vacaciones paradisíacas de la magnate Sangemah Bay, Dori!”. ¿Qué les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Ya que te ofreces, ¿podría tomarte una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "Estamos buscando inspiración para tomar imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
