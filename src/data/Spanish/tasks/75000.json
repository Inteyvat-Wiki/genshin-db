			"dialogs": [
				{
					"id": 750000901,
					"content": "#¿{REALNAME[ID(2)|SHOWHOST(true)]}? Muy bien, pequeñín, pues a partir de ahora, ¡te llamarás {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000902,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000903
					]
				},
				{
					"id": 750000903,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#¡Parece que le gusta mucho! Paimon espera que, cuando estemos en Natlan, podamos resolver este misterio tuyo... Y también averiguar cómo fue {NICKNAME} capaz de meterse en el cuerpo de ese saurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Por cierto, {NICKNAME}, no te pasó nada cuando te convertiste en saurio, ¿verdad? ¿No te sientes mal ni nada de eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Me dio un poco de saurofobia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "¿Qué saurofobia ni qué ocho cuartos? ¿Aún tienes humor para bromas? ¡La próxima vez, Paimon no te preguntará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Por cierto, {NICKNAME}, Paimon no sabía que la gente de Natlan podía convertirse en saurio... Es cuando menos extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "Por Los Siete, acabamos de llegar a Natlan y mira todas las cosas que han pasado... Bueno, ahora el problema es cómo salir de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "¿Eh? ¿Sabes cómo salir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "Fue genial transformarse en saurio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "Bueno, pero mejor que hayas vuelto a la normalidad. No sería bueno que un día te transformaras en saurio y no pudieras recuperar tu cuerpo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				}
			]
		},
