			"dialogs": [
				{
					"id": 750000601,
					"content": "¿Estás bien, pequeñín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000602,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000603
					],
					"speakerTitle": "¿Pequeñín?"
				},
				{
					"id": 750000603,
					"content": "V-vaya, parece que no se encuentra muy bien. ¿Es tu cola? ¿Te heriste la cola al caerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000604,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000605
					],
					"speakerTitle": "¿Pequeñín?"
				},
				{
					"id": 750000605,
					"content": "Deberíamos vendársela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000606
					]
				},
				{
					"id": 750000606,
					"content": "Jeje, ¡pues déjaselo a Paimon! Tu inventario está lleno de cosas, así que tardaríamos demasiado en buscar unas vendas en él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000607,
					"content": "¡Usemos este pañuelo del miniinventario de emergencia de Paimon para vendarle la cola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000608,
					"content": "¿Dónde has guardado ese inventario hasta ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000609
					]
				},
				{
					"id": 750000609,
					"content": "¡Ja! Pues en un lugar difícil de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000610,
					"content": "Bueno, ¿quieres el pañuelo o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000611,
					"content": "Sí, claro. Gracias, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000612
					]
				},
				{
					"id": 750000612,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000613
					],
					"speakerTitle": "¿Pequeñín?"
				},
				{
					"id": 750000613,
					"content": "No te muevas, pequeñín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000614,
					"content": "#Jeje, mira, {NICKNAME}, está siendo muy obediente, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000615,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000616,
					"content": "Así debería estar bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000617
					]
				},
				{
					"id": 750000617,
					"content": "¿Qué tal, pequeñín? ¿Mejor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000618,
					"content": "Grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000619,
					"content": "Bueno, parece que estás mejor. Qué alivio... Pero ¿se puede saber por qué estabas ahí atrapado? Y ¿qué hacían aquí esos Sabuesos Acechadores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000620,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000621,
					"content": "¿Tú tampoco lo sabes? Bueno, aunque lo supieras, no entenderíamos qué quieres decir con tus “grrr”. En fin, pequeñín, ya te hemos salvado, puedes volver a tu casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000622,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000623,
					"content": "¿No sabes dónde está tu casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000624,
					"content": "¿Y tu familia? Espera, ¿no le digas a Paimon que ese grandote de antes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000625,
					"content": "#¿Qué hacemos, {NICKNAME}? No podemos dejarlo aquí solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000626,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000627
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000627,
					"content": "#De momento puede venir con nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000628
					]
				},
				{
					"id": 750000628,
					"content": "De acuerdo. A lo mejor encontramos a su familia cuando lleguemos a Natlan, aunque... Paimon no cree haber visto nunca a nadie como él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000629,
					"content": "#Elegid{F#a}{M#o} de los dragones... ¿Querrá eso decir que...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000630
					]
				},
				{
					"id": 750000630,
					"content": "¿Eh? ¿Dices que alguien te dijo eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000631,
					"content": "Si Paimon no recuerda mal, alguien nos dijo que Natlan es la Nación de los Saurios, ¿verdad? Entonces, este pequeñín es... ¿un saurio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000632,
					"content": "Grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000633
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000633,
					"content": "La verdad es que se parece mucho a un Dragarto. Él también tiene... dos patas y una cola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000634,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000635,
					"content": "#No debería haber problema si viene con nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000636
					]
				},
				{
					"id": 750000636,
					"content": "#Preguntémosle si quiere venir con nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000637
					]
				},
				{
					"id": 750000637,
					"content": "Sí. Pequeñín, ¿te gustaría acompañarnos en nuestro viaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000638,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000639
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000639,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000640
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000640,
					"content": "#Jeje, ¡parece que está de acuerdo! Por cierto, Paimon es Paimon, y {F#ella}{M#él} es {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000641,
					"content": "¿Mmm? Grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000642
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000642,
					"content": "Ah, claro, tú también necesitas un nombre. A ver, deja que Paimon piense... Como eres negro y amarillo, a Paimon le recuerdas a una tortilla de papas. Ya está, ¡te llamarás “Tortipapa”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000643
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000643,
					"content": "Gruuu... Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000644,
						750000646
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000644,
					"content": "Con ese nombre, solo sería bien recibido en El Buen Cazador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000645
					]
				},
				{
					"id": 750000645,
					"content": "¿Crees que a nadie más le gustaría?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000647,
					"content": "Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000648
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000648,
					"content": "#¿Quieres que {NICKNAME} te ponga un nombre? Bueno, como quieras, pero que sepas que tiene unos gustos muy particulares a la hora de dar nombres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000649,
						750000650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000649,
					"content": "Pero si mis nombres siempre son normales, no como los tuyos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000650,
					"content": "Pobre criatura, las desgracias que le habría tocado vivir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000646,
					"content": "Ni siquiera a él parece gustarle ese nombre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000647
					]
				}
			]
		},
