			"dialogs": [
				{
					"id": 761410501,
					"content": "Puedo entender que quieran quedarse un poco más. Después de todo, este paisaje solo existe en mis recuerdos... No lo encontrarán en ningún otro lugar.",
					"roleType": "TALK_ROLE_NPC",
