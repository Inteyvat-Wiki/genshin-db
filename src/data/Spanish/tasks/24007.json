				]
			},
			"dialogs": [
				{
					"id": 240070501,
					"content": "Veamos... Podemos usar este engranaje y si abrimos este cojinete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "¿Para qué necesitan los componentes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Quiero hacer una marioneta. Lo cierto es que me estuve formando al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Cuando aprenda, ¡construiré un Mecabot gigante y le daré a mi padre una gran sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "He leído muchos libros en la habitación de mi padre y he seguido las instrucciones que dictaban para construir algunos componentes sencillos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "¡Estoy segura de que seré capaz de construir un Mecabot si sigo esforzándome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Pero no puedo estudiar estas cosas en la ciudad o mis padres se enterarían de inmediato, y si se enteran ya no será una sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "Por eso esta es ahora la nueva base de investigación mecánica de Lovi. Y yo soy su ayudante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "¡Menos cháchara y más trabajo, ayudante! Empecemos hoy por crear un brazo mecánico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "¡A sus órdenes, señora! ¡Qué comience la investigación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		}
