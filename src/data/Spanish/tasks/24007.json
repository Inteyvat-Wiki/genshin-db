			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 240070401,
					"content": "¿Eh? Son ropas viejas... Ya casi ni tienen color.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070402,
					"content": "¿Habrá venido alguien por aquí antes que nosotros? No hay ni un solo componente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
