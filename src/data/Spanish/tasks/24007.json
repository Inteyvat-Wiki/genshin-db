			"dialogs": [
				{
					"id": 240070201,
					"content": "Aquí solo hay algunas tablas rotas, pero nada de componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070202
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070202,
					"content": "Qué raro. Juraría que había unos cuantos engranajes en el agua ayer mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400703,
			"completionStepIds": [
				2400703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400703",
							"2"
						],
						"stepId": 2400703,
