					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 240070301,
					"content": "¡Lo encontré! Mira, este engranaje está en bastante buen estado. Incluso hay un cojinete entero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070302
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070302,
					"content": "¡Genial! Estos servirán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
			"id": 2400704,
			"completionStepIds": [
