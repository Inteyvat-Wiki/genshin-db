					}
				]
			},
			"dialogs": [
				{
					"id": 761000701,
					"content": "¡A un lado! ¡Muévete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Jeje... ¿A qué viene tanta prisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000703,
					"content": "De todos modos... morirán igualmente... Pero algunos... lo harán un poco antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000704,
					"content": "Este se quejaba de no haber muerto en aquel entonces... hace tres años... Ahora... le concederé su deseo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000705,
					"content": "... ¿Björn? ¡¿Qué le has hecho?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Era demasiado débil... Los debiluchos... los inútiles... los insectos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000707,
					"content": "... solo sirven para morir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000708,
					"content": "¡No te atrevas a insultarlo! ¡No es para nada débil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Oh... Para ti... era fuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000710,
					"content": "Pero... los fuertes también mueren...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000711,
					"content": "Pensé que tú... lo entenderías mejor que nadie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000712,
					"content": "Los que eran más fuertes que tú... murieron, ¿cierto? Murieron todos hace tres años... y hace diez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000713,
					"content": "... ¡Cállate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Sí... El único débil aquí... eres tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000715,
					"content": "Si no... ¿por qué iba a ser que siempre... siempre... tú eres el único que sobrevive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000716,
					"content": "... Huiste del campo de batalla, ¿cierto? Como un cobarde que se aferra a la vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Voz del monstruo"
				},
				{
					"id": 761000717,
					"content": "¡Illuga, no hagas caso a sus tonterías!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "¡Ya basta! ¡Ha llegado tu hora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#... ¡{NICKNAME}! ¡Acabemos con esto rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
