			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "... ¿Cómo se encuentra Björn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001602,
					"content": "Está malherido... Nos atacaron por sorpresa y, para protegernos, él... *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001603,
					"content": "El campo de batalla es demasiado peligroso y no podrá aguantar que lo movamos en la condición en la que está. No nos queda más remedio que tratarlo aquí, pero con los recursos que tenemos ahora mismo, es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001604,
					"content": "Capitán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001605,
					"content": "¡Björn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001606,
					"content": "... Lo siento... No he podido completar la misión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001607,
					"content": "Has hecho un trabajo fantástico. Hemos podido mantener la posición y todos están a salvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001608,
					"content": "¿De verdad?... Lo he logrado... Eso está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001609,
					"content": "Intenta no hablar, concéntrate en recuperarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001610,
					"content": "Si no lo digo ahora... no tendré otra oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001611,
					"content": "... ¡Es una orden de tu capitán! No permitiré que digas cosas como esa. Estarás bien... seguro que estarás bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001612,
					"content": "Je... Está bien, a la orden... No volveré a decirlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001613,
					"content": "Pero... cuando vea a Veyde... podré mirarlo a la cara sin remordimientos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001614,
					"content": "Solía decir... que los Lampareros somos como la hierba invernal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001615,
					"content": "Cuando nos enfrentamos a la Cacería salvaje... cada uno de nosotros es frágil... como los pétalos de una hierba invernal. Nos marchitamos tan fácilmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001616,
					"content": "Pero... Mientras queden hojas... mientras las raíces sigan aferrándose firmemente a la tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001617,
					"content": "Cuando llegue la siguiente estación... y la siguiente... las flores siempre regresarán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001618,
					"content": "No fallaremos... ¿Verdad... capitán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001619,
					"content": "... Sí, ¡no vamos a fallar! ¡Acabaré con ese monstruo con mis propias manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001620,
					"content": "... Tú eres el más fuerte de todos nosotros... Confío en ti... capitán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001621,
					"content": "... Tranquilo, Björn, cumpliré mi promesa. Ahora intenta descansar... Cuando te recuperes, todo estará bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001622,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "Björn"
				},
				{
					"id": 761001623,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001624,
					"content": "#{NICKNAME}, Paimon, debemos irnos. Aún no hemos terminado la misión. No podemos quedarnos aquí más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001625,
					"content": "Illuga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761001626,
					"content": "Debemos seguir avanzando, por Björn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "Venceremos a nuestro enemigo y nos haremos con la victoria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "... Sí. ¡Sigamos adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}