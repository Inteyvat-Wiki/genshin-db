				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "¿Eh? ¿Dónde está Colombina? Paimon no la encuentra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Aquí estoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540103,
					"content": "¡Guau! ¿Qué haces en un lugar tan alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Suban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540105,
					"content": "¿Qué querrá que hagamos esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "¿Recuerdan cuando fuimos a recoger piedras la otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540107,
					"content": "¿La otra vez? Oh, te refieres a ese mineral que brillaba tras absorber kuuvahki, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Sí. Después de aquella ocasión, las kuuhenki siguieron recolectando unas pocas, así que he organizado las piedras y las he dividido en dos tipos según si presentan un color claro u oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540109,
					"content": "¿Un color claro u oscuro? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Para jugar a las “damas lunares”, claro está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540111,
					"content": "¿Cómo? ¿Qu-qué son las “damas lunares”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "¿Nunca han jugado?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540113,
					"content": "No...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Ya veo... Antes, cuando veía a los niños de los Descendientes Lunaescarcha dibujando las casillas en el suelo, me moría de ganas por jugar. Pero nadie quería acompañarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540115,
					"content": "¿Cuáles son las reglas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Eh... Será más fácil si te lo explico así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540117,
					"content": "¡Vaya! I-increíble... ¿Cómo lo has hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Tan solo he usado el kuuvahki... ¿Ustedes no pueden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540119,
					"content": "#Paimon cree que deberías rebajar tus expectativas. Nosotr{F#a}{M#o}s no somos Dios{F#a}{M#e}s Lunares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Está bien. Este es el tablero. Podría decirse que es el “cielo nocturno” del juego. Las fichas que tenemos en las manos representan las “lunas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540121,
					"content": "Los dos jugadores se turnan para colocar las “lunas” en el “cielo nocturno”, y quien logre formar una línea primero con tres lunas, gana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540122,
					"content": "¡Oh, entonces es solo el juego en el que tienes que formar una línea con tres piezas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "Así que ese juego se llama “damas lunares” en Nod Krai... Suena muy auténtico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Sí, pero las “lunas” deben ir rotando y no puedes tener más de tres en el “cielo” al mismo tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540125,
					"content": "Así que, cuando en el “cielo nocturno” hay un determinado número de “lunas”, la que se alzó primero desaparece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540126,
					"content": "Eso... tiene bastante sentido... Pero también hace que el juego sea más difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Así es. ¿Quieren probar? Yo también estaría jugando por primera vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540128,
					"content": "(Parece que tiene muchas ganas...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Jeje, ¡entonces Paimon hará de árbitra! Pero ten cuidado, ¡{NICKNAME} es muy list{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
