			"dialogs": [
				{
					"id": 760540301,
					"content": "¿Así?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540302,
					"content": "Humm, tengo que pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540304,
					"content": "La luna... La luna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540305,
					"content": "¿Qué tal aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540306,
					"content": "Esta vez he ganado yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540307,
					"content": "He conectado las tres lunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540308,
					"content": "Sí, debería poder ganar así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540309,
					"content": "Humm... La luna se alza y se pone en un ciclo sin fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540310,
					"content": "Nuestras lunas se niegan a ser eclipsadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540311,
					"content": "¿Acaso... vamos a empatar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540312,
					"content": "Parece que te gusta pensar bien en tus decisiones. No importa, tenemos tiempo de sobra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540313,
					"content": "¿Has olvidado cómo colocar las “lunas” en el “cielo nocturno”? ¿Necesitas que te ayude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540314,
					"content": "¿Es que no te gusta este juego? A mí me parece muy entretenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540315,
					"content": "Oh, ¿me estás mirando a mí? Puedo sentirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540316,
					"content": "¿Acaso crees que encontrarás la respuesta en mi cara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540317,
					"content": "El tablero está ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540318,
					"content": "Humm, tus “lunas” te han traído la victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540319,
					"content": "El cielo nocturno te pertenece a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540320,
					"content": "Ah... Parece que me he equivocado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540321,
					"content": "Pasas un buen rato jugando junto a Colombina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Gracias, me lo he pasado muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540323,
					"content": "Si quieres, puedes venir a hacerme compañía en otra ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760540324,
					"content": "Ten, toma esto como una muestra de dicha promesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		}
	]
}