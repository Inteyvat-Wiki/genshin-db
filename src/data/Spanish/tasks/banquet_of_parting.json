			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "¿Descender de la montaña? ¿Es una orden de la Suma Sacerdotisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310202,
					"content": "Sí, Miko dijo que el ritual que va a llevar a cabo dentro de poco es peligroso para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310203,
					"content": "Ya veo... Voy a evacuar a todo el mundo de inmediato. ¿Y ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310204,
					"content": "#Nos haremos cargo de un par de cosas más. Una vez que hayamos terminado, volveremos y haremos el ritual junt{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310205,
					"content": "Es que queremos asegurarnos de que ella también esté a salvo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Parece que la Suma Sacerdotisa confía mucho en ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310208,
					"content": "Nunca antes ha permitido que nadie la acompañe cuando lleva a cabo este tipo de rituales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310209,
					"content": "Gracias por su ayuda con el ritual y... buena suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310210,
					"content": "No te preocupes. Somos mucho más fuertes de lo que parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310206,
					"content": "Es que queremos ver a los youkai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon",
					"Okazaki Rikuto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "#Ah, mis {F#pequeñas amigas}{M#pequeños amigos}. Ahí están.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310402,
					"content": "#Miko... ¿Qué está pasando? ¿Comenzaste a comer sin nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310403,
					"content": "Sí, claro. Después de todo, ustedes invitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310404,
					"content": "De solo pensar en que puedo comer los platos más caros y beber los mejores licores, todo gratis... no pude esperar más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310405,
					"content": "#Oiga, señor, ¿ve a {F#esas}{M#esos} dos de ahí? Recuérdel{F#as}{M#os}. Ell{F#as}{M#os} son {F#las}{M#los} que van a pagar la cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310406,
					"content": "¡Muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "Okazaki Rikuto"
				},
				{
					"id": 120310407,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310408,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "¿Qué les pasa? Vengan, siéntense aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310410,
					"content": "Tienen que probar este pescado. Solo se encuentra en los alrededores de la Isla Seirai. Lo trajeron esta noche a Inazuma y todavía estaba vivo hasta hace un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310411,
					"content": "¿O prefieres probar este? Lo sé, lo sé, normalmente no bebería un licor tan caro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310412,
					"content": "Si no bebes alcohol, no hay problema. Hay diferentes tipos de jugos de frutas, de todos los precios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310413,
					"content": "*Grr*... ¡Miko, cruzaste la línea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310414,
					"content": "#¡La última vez que estuvimos aquí trabajando en la novela, solo pediste unas brochetas para nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310415,
					"content": "¿Eh? Qué raro. No lo recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310416,
					"content": "Paimon sí que lo recuerda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "Sí, ¿y qué? Ustedes prometieron invitarme a comer, ¿no? Además, soy una invitada de honor, ¿no creen que deberían invitarme a algo que esté a la altura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310419,
					"content": "Miko, esta comida es muy cara. ¿No te preocupa que no podamos pagarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310420,
					"content": "#Jeje, no se preocupen. Seguro que podrán pagarla... La novela que escribim{F#as}{M#os} juntos se está imprimiendo otra vez. A ustedes les corresponde una buena paga por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310421,
					"content": "¡¿Qu-qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310422,
					"content": "#¡Rayos! {NICKNAME}, ¡Miko nos engañó! ¡Todo este tiempo estuvo detrás de nuestro dinero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310423,
					"content": "No debimos bajar la guardia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Jaja, deberían ver sus caras en este momento. ¡Qué gracioso! ¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310426,
					"content": "Por cierto, como ningún deseo se hizo realidad durante la noche sin luna, las novelas con conjuros ya no son populares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310427,
					"content": "#Tendrás que pensar en nuevas ideas para el próximo capítulo de «Las increíbles aventuras {F#de la viajera}{M#del viajero}».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310428,
					"content": "La fecha límite se acerca... Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310424,
					"content": "Caímos en la trampa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "Brochetas y tofu frito, nada más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
