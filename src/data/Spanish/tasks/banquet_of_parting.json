					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "#Oh, hola, al fin llegaron, mis pequeñ{F#as}{M#os} ayudantes. Justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Hum, como si tuviéramos otra alternativa. Solo queremos que nos paguen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Miko, ¿qué necesitas que hagamos para el “desfile de los cien monstruos”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "Además, para que quede claro, ni siquiera sabemos qué significa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "Suena aterrador pero, en pocas palabras, el desfile de los cien monstruos es cuando los youkai se reúnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Antiguamente, en las reuniones de youkai, una vez que todos habían bebido lo suficiente, utilizaban sus poderes para elevarse al cielo. Eran tantos que sus siluetas cubrían la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Pero ahora, los recuerdos youkai que se escapan de las líneas ley son débiles. No pueden volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "Así que haré un ritual de invocación para que todos puedan reunirse en un solo lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Cuando llegue el momento, se reunirán en el cielo sobre el Gran Santuario Narukami. Una vez que agoten su energía, su corazón quedará satisfecho y volverán al lugar al que pertenecen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Ya veo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "En realidad, todos los preparativos para el ritual ya se hicieron con antelación. ¿Recuerdan el conjuro y la parte que añadí a la novela, donde se menciona la “noche sin luna”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Oh, sí, algo sobre recitar «Los conjuros secretos de la Srta. Kitsune» durante una “noche sin luna”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Exacto. De hecho, no es ningún conjuro para conceder deseos, sino para ayudar a calmar los recuerdos de las líneas ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "Cuando llegue el momento, hay que darles un empujón para que encuentren el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "¿Qué necesitas que haga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Pronto comenzaré con los preparativos del ritual. Llegado el momento necesitaré que hagas dos cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "Primero, diles a las miko que abandonen la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Durante el desfile de los cien monstruos, un gran número de recuerdos youkai flotará en el aire sobre el Gran Santuario Narukami. Que las miko del santuario se marchen evitará que alguien pueda ser poseído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Después, comenzaré el ritual, y los recuerdos empezarán a agruparse. Esto tomará tiempo. Necesito que estés al pie de la Montaña Yougou cuando suceda para que vigiles qué hacen los monstruos que se encuentran cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "Los recuerdos normalmente se dispersan y no suponen una gran amenaza, pero cuando su energía se concentra, es probable que perturbe a los monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Podrían considerarlo como una oportunidad para intentar subir la montaña. Necesito que los detengan para que eso no ocurra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "Bien, entendido. ¿Y después?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Humm... Bueno, si en ese momento quieren venir al santuario y ver de cerca a los youkai, no podría decirles que no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#Muy bien, {NICKNAME}, ¡vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
				1203102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
