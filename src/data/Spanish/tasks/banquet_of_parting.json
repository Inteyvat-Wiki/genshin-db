				},
				{
					"id": 120311902,
					"content": "No pensé que realmente llegaría la noche sin luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311903
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311903,
					"content": "Sí, ¡esa noche aparecieron unas nubes negras sobre la Montaña Yougou!",
