			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "#Hola, viajer{F#a}{M#o}, nos encontramos de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140102,
					"content": "¿Necesitas ayuda con algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "¿Recuerdas la comida que te prometí la última vez? Me estoy preparando para cocinarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140106,
					"content": "Para hacer un buen plato tenemos que buscar ingredientes frescos por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140107,
					"content": "Ya los encontré todos y ahora estoy pensando cómo preparar la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140108,
					"content": "¿Dónde están Julie y Parvaneh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Parvaneh dijo que tenía que seguir buscando ingredientes para preparar ese “condimento multiusos” que quiere hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140110,
					"content": "Y se llevó a Julie con ella. Dijo que no se alejarían mucho de la ciudad y que no nos preocupáramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140111,
					"content": "Pero yo necesito que me ayudes. Aunque he encontrado muchos ingredientes de Inazuma, no tengo ninguna inspiración especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140112,
					"content": "Mira, tengo algas, hongos marinos y estos... pétalos de cerezo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140113,
					"content": "Aunque todos son ingredientes frescos, no sé cómo prepararlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140114,
					"content": "Pensaba pedirle ayuda a un chef local pero, si lo hago, el plato resultante será una de las comidas típicas de Inazuma y no algo original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140115,
					"content": "Así que lo que quiero es preparar un plato con ingredientes de Inazuma pensando como un chef de Liyue. De esta forma, a lo mejor consigo inventar un nuevo plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140116,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ir a Liyue y consultarlo con el Chef Mao del Restaurante Wanmin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140117,
					"content": "¡Yo me encargo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Muchas gracias. Estaré aquí esperándote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140124,
					"content": "Espero que tenga alguna buena idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140119,
					"content": "¿Quieres conseguir ese “bum”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "¿“Bum”? ¿Eso qué es? ¿Te refieres a la sensación de sorpresa que proporciona al comensal la buena comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140121,
					"content": "Si encuentras una receta que pueda dar esa sensación, mucho mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140122,
					"content": "Pero yo no conozco a nadie capaz de inventar un plato así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140123,
					"content": "Así que primero ve a buscar al Chef Mao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140104,
					"content": "¿Me invitarás a comer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Jajaja, por supuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "#¿Eh? Viajer{F#a}{M#o}, ¿qué haces aquí? ¿Quieres algo de comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140202,
					"content": "Quiero preguntarte algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Así que Xudong ha ido a Inazuma para aprender platos nuevos... Es muy perseverante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140204,
					"content": "¿Lo conoces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "Podría decirse que sí. Competimos el uno contra el otro, y el resultado fue muy ajustado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140206,
					"content": "Él solía decir que quería conseguir un gran logro y viajar por todo el mundo... No pensé que realmente lo haría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140207,
					"content": "Pero parece que se ha encontrado con un obstáculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140208,
					"content": "¿Sabes cómo resolver su problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "No estoy seguro, pero puedo intentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140214,
					"content": "Algas, hongos marinos... ¿Qué era lo otro? ¿Pétalos de cerezo? Qué ingredientes tan raros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140215,
					"content": "Pero si solo nos concentramos en las algas y los hongos marinos, creo que se puede hacer un plato. Aunque se necesitan otros ingredientes adicionales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140216,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ir a buscar chile de Jueyun y carne de ave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140217,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "¡Muchas gracias! Tráemelos cuando los tengas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140219,
					"content": "Son ingredientes clásicos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Jajaja, claro, este tipo de ingredientes son los más fiables. Tráemelos cuando los consigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140221,
					"content": "Pero, la verdad, no sé qué hacer con esos pétalos de cerezo. ¿Cómo los usarán los chefs de Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140210,
					"content": "Tal vez Xiangling pueda resolver su problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "Xiangling... Sí, sus platos siempre son muy creativos. Quizás ella tenga la solución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140212,
					"content": "Pero ahora no está aquí, se fue a la Aldea Chingtsé a recoger bambú. Si quieres verla, tomará un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140213,
					"content": "Pero Xudong debe estar esperando la respuesta con urgencia. Primero intentaré ayudarlo yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				}
			]
		},
