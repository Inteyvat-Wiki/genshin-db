			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "Con esto bastará. Espera un momento, voy a ver qué hago con estos ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140402,
					"content": "Ya está. Humm, creo que no se diferencia mucho de los platos que cocino normalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140403,
					"content": "Llévaselo a Xudong. Espero que le sirva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
