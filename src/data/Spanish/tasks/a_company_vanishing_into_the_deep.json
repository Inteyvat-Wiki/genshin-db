	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "Uf... Siento pararte si tenías prisa. Soy el serzhant Anton Melnikov, comandante intendente de la Novena Compañía. Puedes llamarme Anton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "Y estos son Danilov, Temur, Radomir... y, eh, Romanski... Bueno, él no está aquí ahora mismo... Está... en el campamento médico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Romanski ya no está, y tampoco el campamento médico... Antoha, Romanski se nos ha ido esta mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620104,
					"content": "Danilov, te lo he dicho muchas veces. Ahora soy el comandante de la compañía. ¡Tienes que llamarme “serzhant Anton”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "¡Ja! ¿Comandante? ¿Serzhant? ¿Pero quién te crees que eres? Desde que el capitán porúchik desapareció, no has dejado de darte aires de superioridad. ¡No me hagas reír!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Ya basta, Temur... El hambre te nubla el juicio. Ahorra energías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "Es “comandante intendente” Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620149,
					"content": "Comandante intendente... ¡No me hagas reír! ¿Por qué iba a seguir las órdenes de ese falso comandante que no sabe lo que hace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Temur, ya te lo he dicho. Es el hambre el que habla. ¡A lo mejor debería darte un par de golpes para que se te pase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "¡Ven, ven si te atreves! Pero ten cuidado, ¡no vaya a ser yo el que te los de a ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "¡Magnífico! O sea que ahora no solo hemos perdido las raciones de comida, también hemos perdido el juicio y la sensatez. ¡Perfecto! Y mientras tanto, aquí seguimos malgastando las pocas energías que nos quedan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620108,
					"content": "¡*Ejem*! ¡Silencio! ¿Es que quieren tener pelea o qué? Si quieren pelearse, ¡háganlo de una vez! ¡Vayan y peleen contra esas cosas que salen del fango oscuro! ¡Vayan ahora que se están muriendo de hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "Si queremos sobrevivir y salir de aquí cuanto antes, ¡tenemos que mantenernos unidos! No quiero volver a repetirlo, ¿entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Uno, dos, tres, repitan conmigo: Si no yo, ¡¿quién?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "Si no yo, ¿quién?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620112,
					"content": "Si no yo, ¿quién?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "#Eh, jaja... Verás, amig{F#a}{M#o}, no estamos precisamente... en las mejores condiciones para una batalla, jaja. Últimamente... hemos tenido algún que otro problemilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Humm... ¡“Algún que otro problemilla”, dice! Cada vez suenas más como el capitán porúchik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Ahora que el capitán porúchik no está, ¡yo soy el comandante! Así que ¿por qué no te callas un rato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "#Lo siento, amig{F#a}{M#o}, pero necesitamos tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
