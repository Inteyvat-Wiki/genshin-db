					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "¡Fantástico! ¡Nuestro nuevo comandante ahora suplica como un perrito...! ¡Qué humillación! Ahí va la poca dignidad que nos quedaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "¿Por qué no te callas de una vez? ¿O es que te alimentas de sarcasmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620124,
					"content": "“¡Únete a nuestras filas! ¡Hagamos que la tierra tiemble a nuestro paso! Tú que marcharás con nosotros hacia la estrella polar en la noche blanca, nunca te fallaremos...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "¡Que alguien haga que se calle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Uf... Puede que sean de los malos, pero así muertos de hambre están que dan pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "No te voy a engañar... No estamos en condiciones de luchar. Solo queremos algo de comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106218,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
