				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620128,
					"content": "¿Y?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "Después nos iremos y no volverás a vernos. Te doy mi palabra... como Capitán de la Novena Compañía. Te lo prometo por el honor de nuestros ancestros que defendieron Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620132,
					"content": "*Suspira*... Hambrientos y patéticos. Damos pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620133,
					"content": "Déjalo ya. Ni que tú estuvieras mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620134,
					"content": "Cuando llegamos éramos 64. ¡¿Y ahora?! Ahora solo quedamos cuatro muertos de hambre. ¿Qué crees que vamos a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620135,
					"content": "¡Vaya! ¿Y cómo es que han acabado así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620136,
					"content": "Eso no es lo importante ahora mismo... Si no comemos pronto, me temo que los cuatro últimos miembros de la Novena Compañía caeremos muy pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
