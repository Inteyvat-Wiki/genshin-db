			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "Dime qué planes tienen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "A ver cómo te lo explico. Puede que tengas dudas sobre nuestros motivos, pero estamos aquí con el único propósito de investigar el desastre que tuvo lugar en la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "¿Qué desastre? Paimon no sabe de qué estás hablando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "Aquel desastre que tuvo lugar hace 500 años no es más que la punta del iceberg. La guerra contra la calamidad oscura nunca terminó y este es uno de los campos de batalla en los que se libra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "*Suspira*, el serzhant comandante está tan hambriento que ha perdido la cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620144,
					"content": "Siempre le ha gustado hablar, pero nunca antes le había oído decir semejantes tonterías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Da igual... Lo que dice Antoha no es tan descabellado. Quiere decir que ustedes, la gente de Liyue, no son nuestros enemigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "Al menos no para la Novena Compañía, ni en esta ocasión... Aunque no sé si nuestros compatriotas derrotados pensarían lo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "Les ayudaré como un gesto de bondad, pero que no sirva de precedente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "¡G-gracias! Nunca lo olvidaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
