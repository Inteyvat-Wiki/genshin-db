			},
			"dialogs": [
				{
					"id": 710620202,
					"content": "Por favor, considere nuestra petición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620201,
					"content": "Aquí tienen la comida que querían.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anton",
					"Danilov",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Son unos débiles. ¡Un par de golpes y ya los tienes por los suelos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "¡Paren! ¡Por Los Siete, basta ya! Solo queremos algo de comida, ¡después podrán pedirnos lo que quieran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620703,
					"content": "Humm... Parece que ya no soportan más el hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Dime qué planes tienen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "A ver cómo te lo explico. Puede que tengas dudas sobre nuestros motivos, pero estamos aquí con el único propósito de investigar el desastre que tuvo lugar en la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620707,
					"content": "¿Qué desastre? Paimon no sabe de qué estás hablando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "Aquel desastre que tuvo lugar hace 500 años no es más que la punta del iceberg. La guerra contra la calamidad oscura nunca terminó y este es uno de los campos de batalla en los que se libra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620709,
					"content": "*Suspira*, el serzhant comandante está tan hambriento que ha perdido la cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620710,
					"content": "Siempre le ha gustado hablar, pero nunca antes le había oído decir semejantes tonterías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Da igual... Lo que dice Antoha no es tan descabellado... Ustedes, la gente de Liyue, no son nuestros enemigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "Al menos no en esta ocasión... Aunque no sé si nuestros compatriotas derrotados pensarían lo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620713,
					"content": "Bueno... Les ayudaré, pero que no sirva de precedente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "¿Cómo sé que puedo fiarme de ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Danilov",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "*Suspira*... Lo siento mucho, algún problema que otro con la cadena de mando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620902,
					"content": "¡¿Algún problema que otro?! ¡Somos unos traidores! ¡Estamos aquí de brazos cruzados mientras le dan una buena tunda a nuestros compatriotas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620903,
					"content": "¿Y qué sugieres que hagamos? ¿Deberíamos dejar que nos den una paliza y se lleven toda la comida? ¿Por qué no cierras esa gran bocaza tuya de una vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Antoha, no le quites hierro al asunto. La cadena de mando se ha ido al garete. ¡Por completo! Todos nuestros Capitanes y superiores están desaparecidos o han caído... No nos queda otra opción, tenemos que retirarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "Pero muchos de nuestros hombres no quieren retirarse... Prefieren seguir luchando hasta que caiga el último de nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620906,
					"content": "Que caiga de hambre querrás decir, ¿no? De acuerdo con el contrato de colaboración, los de arriba tenían que proveernos de suministros, pero no hemos tenido noticias suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danilov"
				},
				{
					"id": 710620907,
					"content": "Somos leales a los Fatui y a Los Once, pero no estúpidos... Cualquiera con dos dedos de frente sabría que lo más sensato es retirarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "Entonces, ¿qué planean hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Humm... Sé que esto no es asunto tuyo. No te detendré si quieres irte, pero estamos realmente desesperados y nos vendría bien una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620910,
					"content": "Tengo que pensarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Bueno... Ten cuidado por el camino. El resto de mis compatriotas podrían no ser tan afables como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620913,
					"content": "No debería compartir contigo esta información, pero... hay un puesto de reabastecimiento cerca de la superficie. Todos nuestros suministros pasan por ahí y a veces también recibimos órdenes de nuestros altos mandos allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620914,
					"content": "Mandamos a algunos hombres por comida, pero todavía no han vuelto... No puedo arriesgarme a perder a nadie más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620915,
					"content": "Además, nadie ha bajado tampoco en mucho tiempo... Me gustaría que comprobaras cómo está la situación allí arriba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620916,
					"content": "Deja que lo piense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "Siento mucho pedírtelo, pero necesito saber qué está ocurriendo en la superficie... No puedo tomar decisiones a ciegas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620919,
					"content": "¡Bueno, ya, estás confundiendo a Paimon con tantos discursitos! ¡Iremos a echar un vistazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "Te ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "¿Qué necesitas que haga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
