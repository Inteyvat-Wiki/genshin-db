			"dialogs": [
				{
					"id": 721380501,
					"content": "Uf, el corazón se me va a salir del pecho. ¡Gracias por salvarme! No lo olvidaré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380502,
					"content": "Esto entra dentro de lo normal. Los seres contaminados por los tatarigami se ven atraídos de forma inconsciente por las fuentes que emanan un aura siniestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380503,
					"content": "Como la medicina emite una gran cantidad de energía de los tatarigami, era de esperar que se sintieran atraídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380504,
					"content": "Ahora ya sé más o menos cómo modificar la fórmula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380505,
					"content": "Pero ya he malgastado una parte de las hierbas frescas, así que necesito más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#Cuando estés explorando, {NICKNAME}, presta especial atención a las hierbas medicinales de la isla, y déjalas en la cesta de bambú que hay frente a esta casa por la mañana temprano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "Te pagaré tu recompensa completa, pero me temo que tendrás que esperar un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "Si tienes otras cosas que hacer, no te molestes. Ya encontraré a alguien más que pueda ayudarme a recolectar las hierbas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380508,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#Volveremos a vernos, {NICKNAME}. Espero que tu viaje por la Isla Yashiori vaya bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380509,
					"content": "Lo tendré en cuenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
