			"dialogs": [
				{
					"id": 721380401,
					"content": "#Gracias, {NICKNAME}. Lamento si te causé algunas molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380402,
					"content": "No, en absoluto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "Utilicé las hierbas que recolectaste para formular una nueva medicina, pero aún no tengo con quien probarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380405,
					"content": "#¿Y si tú, {NICKNAME}...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380406,
					"content": "Dímelo sin rodeos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#¿Y si compruebas tú mism{F#a}{M#o} los efectos de la medicina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380408,
					"content": "La naturaleza de este nuevo remedio es muy inestable y es imposible predecir cuál puede ser el peor escenario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380409,
					"content": "Así que quiero que haya alguien para presenciar mi éxito... O encargarse de las consecuencias del fracaso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380410,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "No digas eso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				}
			]
		},
