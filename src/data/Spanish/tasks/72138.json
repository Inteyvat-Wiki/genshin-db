	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "¡Ey! ¡No soy nadie sospechoso, solo soy el médico de este lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "¡Si no me creen, vengan conmigo a mi casa! ¡Pueden llevarse cualquier cosa que necesiten, pero no me hagan daño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "¡O llévenme a ver al general Kujou! ¡Él me conoce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Creo que te confundes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "¿Eh? Un momento, ustedes no parecen ser del ejército del shogunato... Ni tampoco de Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "#¿Son... extranjer{F#as}{M#os}? ¿Cómo pueden haber llegado hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Bueno, no importa. Lo mejor será que se marchen cuanto antes. La Isla Yashiori es muy peligrosa en la actualidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Hasta el momento, no hay signos de que la energía de los tatarigami vaya a disiparse, y la Comisión Tenryou tampoco parece tener intención de retirar sus tropas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "Esta isla ya no es apropiada para vivir, y mucho menos para hacer turismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "Si estás huyendo de la Comisión, lo mejor es que sigas hacia el oeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "La Comisión Tenryou no ve con buenos ojos a los fugitivos, pero quizás los piratas te acojan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "¿Qué ha ocurrido en la isla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "Ay... Puedes verlo con tus propios ojos. ¡Los de la ciudad y la gente de Sangonomiya no nos han traído nada bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "Primero, hubo una explosión en Tatarasuna que tiñó de colores extraños el cielo de esa noche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Muchos de mis parientes y amigos perdieron su trabajo y no tenían ropa que ponerse ni nada que llevarse a la boca. Mucha gente sufrió heridas graves en el camino a casa, fue algo horrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "Y muchos otros... no regresaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "Luego, los de Sangonomiya destruyeron el altar que reprimía los huesos de la gran serpiente, la energía de los tatarigami se esparció y todos los isleños murieron o huyeron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "La extraña enfermedad provocada por los tatarigami sigue extendiéndose. La mayoría de los residentes están muy enfermos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "Creo que solo es cuestión de tiempo antes de que se extienda hasta ambos campamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "¿Qué es este sitio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Este lugar era de donde se extraía la mayoría del mineral necesario para forjar las espadas de acero de jade de Inazuma. Mientras hubiera mineral, podíamos apañarnos y no teníamos que preocuparnos por las restricciones de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "Y ahora... En la isla no queda mucha gente con vida. Me refiero a gente como yo, que aún pueda hablar de forma comprensible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "¿Por qué no te vas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "¿Crees que no quiero? El hijo del Comisionado Tenryou me envió una invitación. Creo que ahora está supervisando la batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "“Eres médico, no eres como las personas corrientes. Quedarse en la isla es muy peligroso, ¿no quieres venir a ser el médico de mi ejército? Puedo recomendarte directamente a mi padre”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "Eso es lo que dijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Antes de la guerra, curar al Comisionado de la Isla Narukami hubiera sido un honor con el que yo, un humilde médico de pueblo, ni siquiera podría haber soñado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Pero ahora... Piénsalo, el Comisionado tiene muchos médicos a su servicio, pero la Isla Yashiori... Soy el único médico con el que pueden contar los enfermos de por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "Por eso no puedo irme ni dedicarme exclusivamente a atender a un bando. Mi única enemiga es la energía de los tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "¿Hay algo en lo que pueda ayudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "No... Bueno, sí, podrías ayudarme con algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "Necesito unas hierbas especiales para hacer una medicina e intentar curar la extraña enfermedad que provoca la energía de los tatarigami. No sé si funcionará, pero tengo que intentarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "No obstante, esas hierbas han sido contaminadas por los tatarigami y, además, la mayoría crecen en lugares peligrosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "Separados por los ríos y el mar, perseguidos por monstruos, y con una presencia tan intensa de los tatarigami en esta zona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Teniendo en cuenta mi valor y mis habilidades, creo que no sería capaz de conseguirlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "Además, como médico, no me atrevo a correr tantos riesgos para ir a recolectar hierbas, así que solo puedo utilizar tratamientos conservadores que llevan mucho tiempo... Hace mucho que no experimento con nuevos remedios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "#Foraster{F#a}{M#o}, veo que tienes un planeador. Debes ser {F#una}{M#un} viajer{F#a}{M#o} con mucha experiencia, por lo que esos niveles de peligro serán pan comido para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "¿Podrías ayudarme a recolectar las hierbas adecuadas en estos lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "Cuando las tengas, reúnete conmigo aquí. No te preocupes por la recompensa, aún tengo algunos fondos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Aunque es un encargo de alguien a quien no conoces, espero que lo consideres. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "De paso, deseo que tengas un buen viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Pareces muy desanimado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Qué sospechoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
