			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "Estas condiciones hacen que sobrevivir la naturaleza sea todo un reto, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200202,
					"content": "Por favor, busca refugio en la ciudad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "¿Buscar refugio? Oh, no te preocupes por mí. Siempre estoy alerta de mi entorno. Estaré bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200204,
					"content": "#Por cierto, ¿por qué sigues aquí? Deberías regresar a Mondstadt, podrías ser golpead{F#a}{M#o} por uno de esos meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200205,
					"content": "Entonces, ¿qué hay de la gente merodeando por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "¿La gente merodeando en la naturaleza? Hay muchos de ellos, ¿por qué lo preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200207,
					"content": "Para que busquen refugio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "Oh, ya veo... En realidad, el Gremio envió encargos para eso. Yo misma avisé a muchas personas de los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200209,
					"content": "Las más cercanas a la ciudad entraron en busca de refugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200210,
					"content": "#Pero no hemos podido conseguir tantos aventureros debido a la escasez de personal, así que todavía hay muchas personas que no han sido notificadas. Si estás dispuest{F#a}{M#o} a ayudar, sería genial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200215,
					"content": "Dame un momento, déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200216,
					"content": "¡Ah, lo tengo! Creo que Patxa y Doolan todavía están en el Templo de los Mil Vientos. Intenté advertirles, pero insistieron en continuar su investigación allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200217,
					"content": "También está Vind, quien se quedó en Punto Portatormentas todo este tiempo. El Gremio me pidió que la buscara varias veces, pero no pude encontrarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200218,
					"content": "Esas son todas las personas que se me vienen a la mente por ahora. Supongo que puedes empezar con ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200219,
					"content": "En cuanto a mí, inspeccionaré de nuevo el área y notificaré a cualquier persona que encuentre una vez que haya terminado de hacer algo de comida y otros preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200220,
					"content": "Esperemos que no hayan huido muy lejos, o será difícil regresar a la ciudad, aunque los encontremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200211,
					"content": "La hermana Grace está muy preocupada por ellas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "¿Grace? Así que estás aquí por ella... En realidad, el Gremio envió encargos para eso. Yo misma avisé a muchas personas de los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200213,
					"content": "Las más cercanas a la ciudad entraron en busca de refugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200214,
					"content": "#Pero no hemos podido conseguir tantos aventureros debido a la escasez de personal, así que todavía hay muchas personas que no han sido notificadas. Si estás dispuest{F#a}{M#o} a ayudar, sería genial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				}
			]
		},
		{
