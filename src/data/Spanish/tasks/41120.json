			"dialogs": [
				{
					"id": 411200401,
					"content": "#¿Oh? ¿Qué te trae por aquí, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200402,
					"content": "¿Dónde has estado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "Oh, lo siento. Estaba caminando, mirando el océano, así que probablemente no soy tan fácil de encontrar... ¿Sucede algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200404,
					"content": "Dirígete a Mondstadt a buscar refugio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "¿Buscar refugio? Ah, te refieres a esos meteoritos. Entiendo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200406,
					"content": "¡C-cuidado! ¡Unos monstruos se avecinan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4112006,
			"completionStepIds": [
				4112006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
