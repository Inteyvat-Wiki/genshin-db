			},
			"dialogs": [
				{
					"id": 411200801,
					"content": "¡Ah! Tú... Oh, no eres un monstruo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200802
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200802,
					"content": "Disculpa, deberías buscar un refugio en Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200803
					]
				},
				{
					"id": 411200803,
					"content": "Yo... ¡sé que debería! Pero estoy aquí avisando a la gente de que busque refugio también. Quizás di unas vueltas de más, pero aun así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200804
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200804,
					"content": "Entonces, ¿por qué te escondes aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200805
					]
				},
				{
					"id": 411200805,
					"content": "¡Estoy descansando! ¿Qu-qué tiene de malo? ¡No te preocupes por mí! Regresa a Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200806
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200806,
					"content": "Meteoritos y monstruos... ¿Qué tiene en la cabeza la gente que se aventura afuera en momentos así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200807
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200807,
					"content": "¿Hay otras personas afuera en este momento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200808
					]
				},
				{
					"id": 411200808,
					"content": "En realidad, estaba buscando a Vind... Me refiero a esa monja que siempre se ve en Punto Portatormentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200809
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200809,
					"content": "Busqué en toda la zona, pero no pude encontrarla, así que fui a otro lugar para probar suerte allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200810
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200810,
					"content": "Pero un grupo de monstruos enfurecidos me descubrió. Apenas pude escapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200811
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200811,
					"content": "Di vueltas a diestra y siniestra por todo el camino de regreso a Punto Portatormentas, pero no había señales de Vind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200812,
					"content": "Solo espero que esa monja ya esté de vuelta en Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200813
					],
					"speakerTitle": "El Miedoso Schuster"
				},
				{
					"id": 411200813,
					"content": "Muy bien, me dirijo de regreso a la ciudad. Tú también deberías volver. No es el momento de dar un paseo al aire libre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Miedoso Schuster"
				}
			]
		},
