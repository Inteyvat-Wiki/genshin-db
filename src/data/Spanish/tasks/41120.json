			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "Uf... Gracias, estuvo muy cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200602,
					"content": "Y por eso te pedí que buscaras refugio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "Lo siento, pero no puedo volver ahora. Estos meteoritos son bastante extraños por sí mismos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200604,
					"content": "En momentos como este, no sería sorprendente que una tormenta volviera a agitar los mares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200605,
					"content": "Debo quedarme a vigilar. Si ocurre una tormenta, debo poder advertir a la ciudad de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200606,
					"content": "Aun así, gracias por informarme. Tendré más cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 4112007,
			"completionStepIds": [
				4112007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112007",
							"2"
						],
						"stepId": 4112007,
						"stateName": "QUEST_STATE_UNFINISHED"
