			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "No es momento de investigar, ¡deberíamos encontrar un lugar para refugiarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200302,
					"content": "Lo dije antes y lo diré de nuevo. No dejaré pasar esta oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 411200303,
					"content": "Disculpen, deberían buscar refugio en Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "¿De nuevo? Este no es el momento de buscar refugio. Estos meteoritos son una oportunidad de explorar el Templo de los Mil Vientos a mayor profundidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 411200305,
					"content": "¿Explorar a mayor profundidad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "Patxa dice que si un meteorito golpea el Templo de los Mil Vientos, podremos seguir el camino hacia las cámaras internas... O cualquier otra cosa que pueda haber ahí abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200307,
					"content": "Pero solo es una ilusión vana. Si un meteorito impactara en el templo, no podríamos escapar a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200308,
					"content": "Deberíamos refugiarnos en alguna parte. Y si un meteorito impactara en el Templo de los Mil Vientos y abriera un camino más allá, ¿no podríamos regresar más tarde y explorar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200309,
					"content": "Pero, ¿y si alguien llega antes que nosotros? Si quieres volver, ve tú. Yo esperare aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 411200310,
					"content": "#Pero... De acuerdo. Lo siento, viajer{F#a}{M#o}, pero creo que los dos nos quedaremos aquí un rato más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200311,
					"content": "No te preocupes. Si hay algún peligro, yo... me las arreglaré yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200312,
					"content": "Oh, cierto, había una persona llamada Schuster que pasó por aquí antes. Se veía muy asustado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200313,
					"content": "Me pidió un sorbo de agua antes de decirme que tenía que llegar a Mondstadt y salir corriendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200314,
					"content": "Pero no corría en dirección a la ciudad, sino hacia Punto Portatormentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200315,
					"content": "Quizás, en medio del susto se equivocó de camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200316,
					"content": "Deberías dirigirte para allá y buscarlo cerca de Punto Portatormentas. No puedo imaginar lo que podría pasar si se encontrara con algunos monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200317,
					"content": "Me quedaré a acompañar a Patxa, y si algo llegara a ocurrir... me las arreglaré yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
		{
