	"talks": [
		{
			"id": 2201101,
			"completionStepIds": [
				2201101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201101",
							"2"
						],
						"stepId": 2201101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "Por Los Siete... ¿Quién habrá sido el responsable de que este rumor se haya extendido tanto?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110102,
					"content": "¿De qué rumor hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "Es sobre los papeles de la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110104,
					"content": "¿Sabes qué son los papeles de la fortuna? En pocas palabras, son un método de predicción del futuro con pequeños palos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110105,
					"content": "Dependiendo del palillo que escojas, obtendrás un breve mensaje acerca de tu futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110106,
					"content": "Evidentemente, lo mejor es obtener un buen mensaje, así que cuando alguien obtiene uno malo, lo deja en el santuario y reza para repeler la mala suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110107,
					"content": "El caso es que alguien empezó un rumor diciendo que, si lanzas tu papel con un mensaje de mala fortuna a la copa de un árbol, los espíritus te ayudarán a ahuyentar las desgracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110108,
					"content": "Y también dijo que, cuanto más alto sea el lugar en el que caiga el papelito, más rápido te llegará la buena suerte y más rápido se desvanecerá la mala. ¡Qué tontería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110109,
					"content": "Ahora el rumor ha llegado al límite de lo absurdo y la gente no solo lanza sus papelitos de la fortuna en lo alto de los árboles, ¡sino también sus Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110110,
					"content": "Y, además, afirman que si los Moras caen en la copa del árbol es porque los dioses han aceptado tus plegarias, y no solo harán tus deseos realidad, sino que te traerán suerte durante un año entero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110111,
					"content": "¿Y eso es cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "¡Claro que no! Dejando de lado la cuestión de si los dioses escuchan las plegarias o no, lo de lanzar Moras ya es ridículo. ¿Acaso no son todos los Moras iguales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110113,
					"content": "¿Es que quieren que la Arconte recoja cada moneda una por una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110116,
					"content": "Entiendo que todos quieren rezar para tener buena suerte, pero... no van a conseguir nada lanzando cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110117,
					"content": "Además, el viento se lleva tanto los papelitos como los demás objetos, así que hay cosas tiradas por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110118,
					"content": "Ya he intentado recoger todas esas cosas de los árboles, pero como no estoy en buena forma, no consigo limpiar nada y tardo mucho tiempo en bajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110119,
					"content": "#Tampoco puedo dejar las cosas como están... Viajer{F#a}{M#o}, ¿me ayudarías a limpiar el tejado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110120,
					"content": "Claro, cuenta conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "#Muchas gracias, viajer{F#a}{M#o}. Si encuentras algún papelito en el tejado, tráemelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110122,
					"content": "¿Qué hago con los papelitos que encuentre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "Humm... Según la señorita Hotomi, los papelitos son la fortuna que ha obtenido la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110124,
					"content": "No estaría bien que nos deshiciéramos de ellos así como así, así que los que recojas los pondré en el lugar que les corresponde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110125,
					"content": "*Suspira*, si todo el mundo hubiera seguido las reglas desde el principio, esto no habría ocurrido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110126,
					"content": "#Muchas gracias, viajer{F#a}{M#o}. Si encuentras algún papelito en el tejado, tráemelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110114,
					"content": "¿Por qué no le dices esto a la gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "Hay tanta gente haciendo lo mismo que nunca acabaría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				}
			]
		},
		{
			"id": 2201102,
			"completionStepIds": [
				2201105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
