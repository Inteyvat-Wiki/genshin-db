					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480602
					]
				},
				{
					"id": 722480602,
					"content": "Entonces quedo a la espera de tus nuevas.",
					"roleType": "TALK_ROLE_NPC",
