					"nextDialogs": [
						722480502
					]
				},
				{
					"id": 722480502,
					"content": "Entonces, te deseo... la victoria en toda batalla que encuentres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				}
			]
		},
