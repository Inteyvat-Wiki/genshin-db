			"completionStepIds": [
				7224804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224804",
							"2"
						],
						"stepId": 7224804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "Ah, ojalá el reino de Byakuya tuviera guerreros como tú. De esa forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480202,
					"content": "*Suspira*, si esto queda resuelto, todos mis deseos se habrán cumplido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480203,
					"content": "Asegúrate de guardar bien estas ofrendas que contienen mis pensamientos en el lugar donde me tuvieron arrestado. Tenemos que hacerlo para poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480204,
					"content": "¿Para poder?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480205,
					"content": "Para... para poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480206,
					"content": "Uf, no hay manera de hablar con este tipo, su espíritu está aturdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}, llevémonos sus ofrendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480208,
					"content": "Pero ¿dónde estará ese sitio tan alto en el que lo encerraron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224805",
							"2"
						],
						"stepId": 7224805,
						"stateName": "QUEST_STATE_UNFINISHED"
