						],
						"pointId": 6679
					}
				]
			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#¡Oye, amig{F#a}{M#o}! ¡Sí, sí! ¡Tú! ¡Ven aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660202,
					"content": "#¿Eh? ¿Nos llamas a nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "#Oh, amigos míos, al verlos supe que eran nuev{M#os}{F#as}. Todavía no están familiarizad{M#os}{F#as} con el Fuerte Merópide, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660204,
					"content": "¡Les felicito por haberse encontrado conmigo hoy! Soy el “residente” más amable del Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660205,
					"content": "Permítanme guiarles por el Fuerte Merópide para que se familiaricen con el sitio. Es evidente que todo esto es “gratis”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660206,
					"content": "#En realidad, ya estoy bastante familiarizad{M#o}{F#a} con el lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "*Suspira*... No digas eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660208,
					"content": "Quizás creas que lo conoces bien, pero con mi visita guiada estoy seguro de que te darás cuenta de escenas totalmente diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660209,
					"content": "¿Es un golpe de suerte? ¿Y gratuito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Por supuesto, como dije, soy el “residente” más amable del Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660211,
					"content": "Humm, Paimon cree que hay algo raro en esta persona. ¿Por qué ha sido tan amable desde el principio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "#¡Jaja! Amig{M#os}{F#as} mí{M#os}{F#as}, no deben pensar tanto. Será mejor que lo hablen entre ustedes dos. Yo estaré esperando aquí a que tomen una decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660213,
					"content": "Cuando hayan tomado una decisión, búsquenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hombre extraño"
				}
			]
		},
