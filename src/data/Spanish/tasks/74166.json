			"dialogs": [
				{
					"id": 741660601,
					"content": "Este es... el ascensor que lleva al Área de Producción del Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660602,
					"content": "¿Aquí también hay alguna leyenda urbana extraña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "No. Lo que pasa es que no me gusta en absoluto este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660604,
					"content": "¿Y eso? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660605,
					"content": "Porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660606,
					"content": "¿Porque...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "¡Porque no quiero trabajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660608,
					"content": "Terminé aquí solo porque no quería trabajar. Robé un pedazo de pan porque tenía hambre y me condenaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660609,
					"content": "Pero ¿por qué en el Fuerte Merópide también tengo que trabajar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660610,
					"content": "“¡Todo trabajo me puede vencer!” Este es mi lema de vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660611,
					"content": "¡Vaya! Parece que este lugar no le sienta bien la cabeza. Deberíamos darnos prisa e ir al siguiente lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
