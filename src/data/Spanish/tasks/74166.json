			"dialogs": [
				{
					"id": 741660301,
					"content": "¿Qué tal? ¿Ya se decidieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660302,
					"content": "¡Acordamos que es absolutamente gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Oh, por supuesto. Seguro que es “gratis”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660304,
					"content": "Vengan, vengan. Síganme para conocer el Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hombre extraño"
				}
			]
		},
