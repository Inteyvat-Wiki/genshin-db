			"dialogs": [
				{
					"id": 741660701,
					"content": "#Bien, amig{M#os}{F#as}, al final llegamos a mi lugar favorito: ¡la Arena de “A Bocajarro”! ¡Es un paraíso que nos pertenece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660702
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660702,
					"content": "... ¿Realmente es tan bueno este sitio? Paimon siente que es muy diferente de lo que le habían dicho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660703,
					"content": "Claro que sí, no le des importancia a los rumores. Son solo la superficie del iceberg. Es para evitar que se revele información. Vengan, aquí tengo un formulario de consentimiento. Solo tienen que firmarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660704
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660704,
					"content": "¡Ey! ¡Tú! Otra vez tratando de engañar a la gente para que firmen el formulario de consentimiento y que participen en la competición. ¡Esta vez no te dejaré escapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660705
					],
					"speakerTitle": "Celadora"
				},
				{
					"id": 741660705,
					"content": "Tienen mucha suerte de que los hayamos encontrado antes de que les obligaran a firmar este formulario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660706
					],
					"speakerTitle": "Celadora"
				},
				{
					"id": 741660706,
					"content": "No le hagan caso. Él y la organización que está detrás embaucan a personas que no saben nada para que participen en peligrosas competiciones y así poder aprovecharse de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660707
					],
					"speakerTitle": "Celadora"
				},
				{
					"id": 741660707,
					"content": "¡No digas tonterías! No he engañado a nadie. Todos son mis amigos y les recomendé que se inscribieran voluntariamente en la competición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660708
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660708,
					"content": "¡Basta ya! Hay un lugar más adecuado para que hables. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660709
					],
					"speakerTitle": "Celadora"
				},
				{
					"id": 741660709,
					"content": "La celadora se lleva a la persona extraña.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741660710
					]
				},
