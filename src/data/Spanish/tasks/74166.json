				]
			},
			"dialogs": [
				{
					"id": 741660401,
					"content": "Este es el Comedor Crediticio del Fuerte Merópide, donde cada persona cada día puede obtener una comida del comedor gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660402,
					"content": "El único problema es que lo que comerás es cosa del destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660403,
					"content": "Humm, ¿eso es todo? Cualquiera que venga aquí el primer día se podría enterar, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Paciencia, tengo aquí una información confidencial. Dicen que cuando recoges tu comida de comedor, solo necesitas decirle a Bran una palabra clave para recibir una comida misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660405,
					"content": "Oh, ¿de verdad? ¿Cuál es la palabra mágica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Lo siento, no la sé. ¿Qué tal si lo exploramos más tarde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660407,
					"content": "¡Esa es la frase de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "No le des importancia a esos detalles. Nuestra próxima parada es la Compañía Tricupón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hombre extraño"
				}
			]
		},
