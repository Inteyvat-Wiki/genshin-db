			},
			"dialogs": [
				{
					"id": 741660501,
					"content": "Aquí está la Compañía Tricupón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660502,
					"content": "¿Eh? ¿Esa es toda la presentación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "¿No lo asocian eso con algo? Si se habla de teatro, ¡significa drama! Si se habla de drama, ¡significa romance! Y si se habla de romance, ¡significa amor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660504,
					"content": "Según la leyenda urbana, si vienes todos los días a ver las actuaciones, encontrarás el amor de tu vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660505,
					"content": "¿Existe tal leyenda? Entonces, ¿no deberían estar todos aquí reunidos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "No te equivocas, pero hay un requisito: no debes ser un prisionero ni un celador del Fuerte Merópide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Hombre extraño"
				},
				{
					"id": 741660507,
					"content": "Entonces, ¡de esa manera prácticamente nadie podría encontrar el amor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Quizá eso sea parte del problema. De todos modos, sigamos adelante hacia nuestro próximo objetivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hombre extraño"
				}
			]
		},
