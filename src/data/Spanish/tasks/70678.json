						"position": [
							39.722,
							0.239,
							21.347
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 706780301,
					"content": "Guaaaau, ¡bravo! Otra actuación espléndida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780302
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780302,
					"content": "¿Quieren aprender nuevas técnicas teatrales para hacer movimientos imponentes o elegantes? Pues como muestra de mi amistad, pueden intercambiar las Medallas de juguete que obtengan de los cofres por técnicas nuevas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780303
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780303,
					"content": "La amistad es algo genial, ¿verdad? Solo con decir la palabra, ya siento mucho calorcito tanto en el corazón como en la barriga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780304,
						706780306
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780304,
					"content": "Pues sí, la amistad es algo bueno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780305
					]
				},
				{
					"id": 706780305,
					"content": "¡Paimon también lo cree! Aunque eso de sentir calorcito en la barriga... A Paimon le preocupa un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780308,
					"content": "En fin, volviendo al tema... ¿Las Medallas de juguete no son simplemente eso: juguetes? ¿Qué valor tienen para cambiarlas por otras cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780309,
					"content": "Si creen en ello, las Medallas de juguete pueden ser incluso más valiosas que el oro. Esa es la magia de la imaginación, o al menos eso dijo la Srta. Bruja, porque yo no entiendo de esas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780310
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780310,
					"content": "Conocer técnicas teatrales es un deseo que se le pide a la Srta. Bruja, así que mientras ella lo considere un intercambio justo, no habrá problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780311
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780311,
					"content": "Humm, por alguna razón, Paimon está un poco preocupada... ¿Estas cosas no suelen pasar también en los cuentos? Ya sabes, le pides un deseo a una bruja a cambio de un precio imposible de pagar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780312,
					"content": "Oh, no, no se confundan, no hay de que preocuparse. En primer lugar, en tu ejemplo estás hablando de una bruja malvada, y en segundo lugar, ¿el precio no son las Medallas de juguete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780313
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780313,
					"content": "¿E-en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780314,
					"content": "¡Claro! Y además... el que le pide deseos a la bruja soy yo, así que ¡el precio lo pago yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780315,
						706780316
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780315,
					"content": "¿Y te enorgulleces de ello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780317,
					"content": "Bueno, valdrá la pena porque me gustan mucho tus actuaciones. Me pregunto cuántas páginas en blanco le quedarán aún al libro y cuántos capítulos darán para escribir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780318
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780318,
					"content": "En fin, no se preocupen. Aunque ahora todas las páginas estén escritas, ¡más adelante se añadirán nuevas páginas en blanco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780319
					],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780319,
					"content": "No puedo esperar al día en que todas ellas estén escritas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lobezno"
				},
				{
					"id": 706780316,
					"content": "Vaya, ahora me da vergüenza y todo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780306,
					"content": "¿Calorcito en la barriga? Vaya, se me ocurre algo para eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780307
					]
				},
				{
					"id": 706780307,
					"content": "Oye, Paimon es tu mejor amiga, ¡no una comida de emergencia que quite el ardor de estómago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
