			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "#¡Arama y nara rubi{F#a}{M#o}, hola! ¡Vaya, qué alt{F#a}{M#o} eres! En cambio, pájaro plateado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "¿Eh? ¿Cómo que pájaro plateado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Cómo decirlo... Arakavi cree que cabrías perfectamente en hueco de árbol muy estrecho. ¡Qué suerte y práctico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Bueno, siguiendo costumbres de nara, primero debería presentar. Hola, nara {NICKNAME} y Paimon. Este es Arakavi. Bien, ahora estrechen manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "#Desconcertad{F#a}{M#o}, estrechas suavemente la mano con Arakavi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "#Interesante. Arakavi ha oído muchas historias sobre nara, pero es primera vez que toca a un{F#a}{M#o}. ¡Qué extraña sensación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "#Ha pasado mucho tiempo desde que nara nos visita. Muchas semillas crecieron hasta convertir en árboles y muchas historias convirtieron en leyendas. Dicen que últim{F#o}{M#a} nara en venir fue muy buen{F#o}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Nara {NICKNAME} también es buen{F#a}{M#o}, fuerte y valiente, como retoño que brota de muro de piedra. Además, han venido para ayudar a Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Oh, Arana... Hace tiempo que no nos vemos. Arakavi espera que todo vaya bien, y que pequeños nara de Aldea Vimara también estén bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "¿Conoces a los niños de la Aldea Vimara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "¡Claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "¡Todos conocemos! Cuando Arana regresó, contó historias sobre pequeños nara. Por eso, nara Iotham, nara Bahram y nara Rhana son nuestros amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "No creo que eso cuente como conocerlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "Entonces, ¿qué cuenta como “conocerse”? ¿Presentar y estrechar mano, como nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "Arama entiende lo que Paimon quiere decir. Nara también tienen que comer y buscar tesoros juntos para conocerse, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "No es tan fácil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Mientras conozcamos historias de demás, nos conoceremos. Porque mundo de aranara es mundo de canciones y sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Arakavi tiene razón. Para aranara, escuchar canción que hable de nara {NICKNAME} o soñar con nara {NICKNAME} ya es suficiente para conocer a {F#ella}{M#él}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "#Paimon cree que podemos dejar de lado todos estos conceptos... ¡Porque ya somos amig{F#as}{M#os} de los aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "#¡Muy {F#buenas amigas}{M#buenos amigos}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama y Arakavi"
				},
				{
					"id": 730810325,
					"content": "#¡Muy {F#buenas amigas}{M#buenos amigos}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Sí. Vamos a celebrar el Festival Utsava, ¡así que debes estar listo, Arakavi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "Cierto. ¿Lo dicen por fruto bija? Arakavi ha enviado a Arayasa, Aradasa y Arasudraka a buscar Confluencia Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Con lo perspicaz que eres, Paimon se pregunta por qué no sabes dónde está la Confluencia esa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Confluencia Ashvattha es lugar extremadamente sagrado. No solemos ir allí para que árboles vasara puedan dormir y soñar tranquilamente hasta que recuerdos converjan con Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "Bosque se acuerda de todo. Cosas buenas no se desvanecerán, y sufrimiento se convertirá en algo hermoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "#En resumen, Arayasa, Aradasa y Arasudraka están buscando Confluencia Ashvattha en exterior. Arama, ve con ell{F#as}{M#os} para ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#Arama lo hará. Nara {NICKNAME}, Paimon, si encuentran con nosotros en bosque, ¡vamos juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Muy bien. ¡Arakavi está encantado de conocer a nara {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "Sí, hablemos de lo importante primero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Humm, cómo decirlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "#Paimon y yo comemos y buscamos tesoros junt{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "#¡Sí! No solo nos conocemos, ¡también somos mejores amig{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Nara {NICKNAME} y Paimon, ¡son increíbles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
