					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200710101,
					"content": "¿Qué hay de las flores que había en Espinadragón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710102,
					"content": "Solo pude recuperar una caja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "¿No pudiste recuperar todas las flores? Oh, bueno... Teniendo en cuenta cómo es esa montaña, debe ser difícil recolectar materiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710104,
					"content": "Pero con este puñado no es suficiente para compararlas, solo me queda esperar a otra oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710105,
					"content": "Hiciste un buen trabajo, así que preparé una recompensa para ti. Quizás vuelva a molestarte en otra ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007102,
			"completionStepIds": [
				2007109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
