				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "¡Jajaja! ¡Jajajaja! ¡¡¡Jajajajaja!!! Ay, no puedo respirar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010202,
					"content": "¡Jajaja! ¡Estoy llorando de risa! Ay, mi querida Chikapu, ¡ojalá estuvieras aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010203,
					"content": "#Estoy enojad{F#a}{M#o}, ¿sabes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "Jajaja, perdón, perdón... No te enojes. Verás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010206,
					"content": "A mi esposa y a mí nos gustaba gastar bromas a la gente. ¡Nuestras bromas no tenían parangón! Y la gente también se divertía con ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010207,
					"content": "Pero mi esposa enfermó y murió mucho antes de lo esperado... Así que me pidió que hiciera algo frente a su tumba, o si no, su espíritu no se marcharía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010208,
					"content": "Todo era para cumplir con su última voluntad. ¿Qué tal? Nada mal, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010209,
					"content": "No me hace ni pizca de gracia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "*Tch, tch*, estos forasteros... ¡Qué aburridos son!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010213,
					"content": "#Ni siquiera quisiste ver mi truco de la verruga que echa agua, qué aburrid{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010214,
					"content": "Adiós, ¡yo me voy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010210,
					"content": "¡Por poco haces que nos maten!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "No me creo ni una palabra de lo que dices.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "¿Se puede saber qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
