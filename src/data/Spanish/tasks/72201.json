				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "*Suspira*, transeúntes, se lo ruego, tengan piedad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "#Gracias por estar dispuest{F#a}{M#o} a escuchar las penas de un anciano... *Suspira*, ven, acércate, te lo contaré todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "En esta vida, jamás he tenido un día de buena suerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "El día en que nací, el sacerdote que oficiaba la ceremonia de nacimiento volcó una lámpara de aceite en un descuido y quemó el largo cabello de mi madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Después de aquello, contraje una extraña enfermedad de la piel y, en otra ocasión, me caí de la cuna y me rompí seis costillas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Cuando era un poco mayor, un día mi primo casi se ahogó con un champiñón, y cuando mi padre fue a salvarlo, me golpeó con una pala en la cabeza por accidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "En otra ocasión, un pelícano se comió a mi querido pinzón, y entonces un jabalí embistió al pelícano hacia un precipicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "Después, en otro descuido, la chica que me gustaba sacrificó a un sacerdote como ofrenda al Ave del Trueno, por lo que fue expulsada de la isla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "Cuando era adulto, mi abuela falleció porque yo era muy feo y deprimente, y entonces mi abuelo también se fue con ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "Y luego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "Bueno, seguro que toda tu familia te apoyaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "Ah, hablando de familia... En mi ceremonia de mayoría de edad, un médico me dijo que tal vez no podría tener hijos porque me había salido un... Espera, que te lo muestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "¡No hace falta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "*Suspira*, escucha lo último que tengo que decir, te lo ruego. Que sea lo último que hagas por este pobre anciano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Está bien, dime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Cuando enterré a mi esposa hace poco, mi anillo de oro se cayó a su tumba y se quedó allí enterrado con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "Era lo único que me quedaba... Pero no me atrevo a desenterrarla de nuevo, eso enfurecería a su espíritu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "#A ver si lo entiendo, ¿quieres que sea {F#una}{M#un} asaltatumbas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "#Vamos, eres {F#una forastera}{M#un forastero}, hagas lo que hagas, no será raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "Ah, no, no era eso lo que quería decir. Lo que digo es que los forasteros no pueden enfurecer a los espíritus locales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Ve al Santuario Chirai. La tumba de mi esposa está al lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "De acuerdo, pero no hables de cosas raras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "¡Es demasiada información!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
		{
			"id": 7220102,
			"completionStepIds": [
				7220103
