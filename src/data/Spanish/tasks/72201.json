	"talks": [
		{
			"id": 7220101,
			"completionStepIds": [
				7220101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220101",
							"2"
						],
						"stepId": 7220101,
						"stateName": "QUEST_STATE_UNFINISHED"
