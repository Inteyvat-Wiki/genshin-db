			"dialogs": [
				{
					"id": 3061001,
					"content": "¡Uf! ¡Qué cansancio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061002,
					"content": "Pero al menos le hemos quitado un peso de encima a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061003,
					"content": "En el pasado podíamos defender la ciudad y mantenerla a salvo",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061004,
					"content": "gracias a Jean, básicamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061005,
					"content": "Pero ahora que Stormterror ataca la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061006,
					"content": "“Los vientos cambiaron, por lo que nuestra estrategia también debe cambiar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061007,
					"content": "Suena muy filosófico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "Es algo que a Lisa le gusta decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061010,
					"content": "Como iba diciendo, sobre los Cuatro Vientos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061011,
					"content": "Si quieren saber más sobre su historia, pregúntenle a Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061012,
					"content": "¡No es porque yo sea mala en historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061013,
					"content": "Una bibliotecaria se supone que debe saber más que una Caballera Exploradora, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061008,
					"content": "¿Lo inventaste tú misma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
