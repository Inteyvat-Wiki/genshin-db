			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bárbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "#¡{F#Caballera Honoraria}{M#Caballero Honorario}! ¿Cómo les ha ido últimamente? ¿Necesitan algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020102,
					"content": "Ah... Antes que nada, debo aclarar que, si lo que buscan es que les prestemos otra vez a Der Himmel, la Lira Sagrada, no será posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020103,
					"content": "(Parece que todavía no se ha dado cuenta de que solo es una ilusión.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020104,
					"content": "Venimos a preguntar algo. Bárbara, ¿has escuchado algo acerca del primer “Labrador” del mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020105,
					"content": "¿Eh? ¿Qué es eso? ¿Qué hace un “Labrador”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020106,
					"content": "Oh, no los conoces... Otra pregunta: ¿alguna vez ha perdido la Iglesia una Estatua de Los Siete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020107,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020108,
					"content": "¿Vinieron a preguntar sobre esa historia antigua? Bueno, como sucedió hace tanto tiempo, ya casi nadie la menciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020109,
					"content": "Hace mucho tiempo, sí hubo una Estatua de Los Siete que desapareció una noche sin dejar rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020110,
					"content": "Casi todos los miembros de la Iglesia participaron en la búsqueda, pero nunca la encontraron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020111,
					"content": "En los registros de la Iglesia, este incidente se llama “La Estatua de Los Siete desaparecida”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020112,
					"content": "Humm... Claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020113,
					"content": "¿Eh? ¿Lo sabías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020114,
					"content": "Ah, no, nada. ¿Hay más pistas? Eh... Paimon quiso decir... ¿Hay más historias extrañas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020115,
					"content": "(Disculpa, Bárbara, pero todavía no podemos contarte sobre la estatua que vimos... Lo acordamos así por tu propio bien...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020116,
					"content": "¿Otras historias extrañas? No estoy segura. Déjame recordar qué otras hay en los registros de la Iglesia... ¿“La furia del tirano”? No, eso es de otra época, no tiene relación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020117,
					"content": "¿“La furia del tirano”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020118,
					"content": "Oh, este suceso hace alusión a una época en la que la antigua Mondstadt, lo que ahora se conoce como la Guarida de Stormterror, estaba envuelta en un gran peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020119,
					"content": "Hace muchos años, hubo un tiempo en el que todo aquel que intentara acercarse a ellas atraía unas bolas de fuego que caían del cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020120,
					"content": "¿Bolas de fuego que caían del cielo? ¡Qué horror!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020121,
					"content": "La gente de ese entonces creía que se trataba de una maldición impuesta por el Dios de la Tempestad, así que llamaban a esa lluvia “la furia del tirano”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020122,
					"content": "Este fenómeno continuó así durante un año. Nadie pudo resolverlo, así que fue disminuyendo por sí mismo hasta desaparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020123,
					"content": "Eso también suena muy extraño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "Cierto. Más adelante, la Iglesia decidió que las sospechas contra el tirano eran infundadas. Por sentido común, el Dios de la Tempestad no dispararía bolas de fuego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020126,
					"content": "Tal vez pudo haber sido causado por otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020127,
					"content": "En fin, es posible que este asunto y el de la estatua desaparecida no estén relacionados, pero no se me ocurren otros incidentes extraños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020128,
					"content": "No te preocupes. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020129,
					"content": "Ahí está de nuevo esa molesta palabra, “gracias”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020130,
					"content": "Oh, eres tú, Rosaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020131,
					"content": "Si buscas a los Caballeros de Favonius, me temo que están ocupados con esos monstruos otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020132,
					"content": "¿“Esos monstruos”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020133,
					"content": "Esos monstruos que intentaron atacar Mondstadt durante el incidente de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020134,
					"content": "¡¿No era la Orden del Abismo?! ¿Están actuando de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020135,
					"content": "Sí. Están reuniéndose en el <color=#00E1FFFF>Reino de los Lobos</color> e inquietando a las bestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020136,
					"content": "¿No será que la Orden del Abismo tiene al espíritu de Boreas en la mira? Pero no se me ocurre con qué fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020137,
					"content": "La Maestra Jean ya se dirige al <color=#00E1FFFF>Reino de los Lobos</color>, yo también tengo que empezar a actuar detrás del telón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020138,
					"content": "¡E-entonces, yo también quiero ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020139,
					"content": "La Maestra Jean indicó que tú debías quedarte en la Iglesia para continuar tu buen trabajo con el clero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020140,
					"content": "P-pero tú también eres miembro del clero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020141,
					"content": "No te preocupes, yo también iré a ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "#¡Sí, nosotr{F#as}{M#os} también iremos a darle una mano a Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020143,
					"content": "#Oh... Está bien. Si {F#la Caballera Honoraria}{M#el Caballero Honorario} las acompaña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020144,
					"content": "#Pero deben tener cuidado. Que el Arconte Anemo l{F#as}{M#os} proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 80020124,
					"content": "Quizás no estaba relacionado con el tirano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "Uf... ¡Sí que había muchos enemigos por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020202,
					"content": "Mientras más nos acercamos al objetivo, más enemigos aparecen. Típico de la Orden del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020203,
					"content": "Debemos encontrar rápido a Boreas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "¡Sí! ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020205,
					"content": "Yo... no puedo seguir avanzando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020206,
					"content": "¿Ah? ¿Por qué? ¿Le tienes miedo a los animales peludos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020207,
					"content": "Seguramente no sea eso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "No tiene nada que ver con los lobos. Es porque Boreas era un dios antiguo. Sin embargo, ahora sirve a Los Siete voluntariamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020210,
					"content": "No estoy de acuerdo con su forma de actuar y prefiero no cruzarme con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020211,
					"content": "Además, agradarle a la gente es lo tuyo, para mí es más difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020212,
					"content": "¿Odias tanto a Los Siete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "No puedes esperar nada de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020216,
					"content": "Es mi opinión personal, pero un consejo: mantén siempre la guardia cuando haya dioses a tu alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020217,
					"content": "No les des toda tu confianza, pero tampoco puedes irte al otro extremo... No intentes derrocarlos o matarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020218,
					"content": "Ni siquiera aunque se trate de tu archienemigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020219,
					"content": "No confiar en ellos y no matarlos... Qué complicado consejo. ¿Dain odia a Los Siete o los está protegiendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020220,
					"content": "¿Por qué tu opinión es tan contradictoria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020222,
					"content": "No cometeré los mismos errores que mis ancestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020223,
					"content": "Permítanme contarles una última cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020224,
					"content": "¿Eh? ¿Una cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020225,
					"content": "Que Khaenri'ah haya sido destruido por los dioses es precisamente lo que motiva a la Orden del Abismo a buscar la destrucción de las naciones protegidas por Los Siete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020226,
					"content": "Basta de conversación, pongámonos manos a la obra. Yo me encargaré del resto de miembros de la Orden del Abismo de esta área. Traten de que su visita a Boreas sea breve. Cuando terminen, encuéntrenme en la entrada del Reino de los Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020227,
					"content": "Oh... Ya se fue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020228,
					"content": "Qué persona más extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020229,
					"content": "Creo que lo entiendo un poco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "Sí, es cierto. Tú tampoco bajas la guardia ante dioses desconocidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020231,
					"content": "En Liyue, durante el Rito del Descenso, tomaste una decisión muy parecida a la que Dain hubiera tomado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020232,
					"content": "A falta de confianza, es mejor evitar la situación que negociar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "*Suspira*... No es nada fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020234,
					"content": "#¡{F#Caballera Honoraria}{M#Caballero Honorario}, Paimon! ¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020235,
					"content": "¡Oh, Maestra Jean! ¡Qué suerte haberte encontrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020236,
					"content": "La hermana Rosaria nos dijo que estaban aquí peleando contra la Orden del Abismo y vinimos a apoyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020237,
					"content": "Gracias, su ayuda es más que bienvenida. Esta ofensiva es muy extraña. La Orden del Abismo ha rodeado el Reino de los Lobos. Justo estaba pensando en enviar más caballeros para combatir contra ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020238,
					"content": "#Ahora estoy haciendo un reconocimiento por el Reino de los Lobos... No pensé encontrarl{F#as}{M#os} aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020239,
					"content": "La hermana Rosaria dijo que su objetivo puede ser Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020240,
					"content": "Pero... ¿qué importancia tiene Boreas para la Orden del Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020241,
					"content": "Solo les gusta causar problemas, para eso no necesitan una razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020242,
					"content": "La Orden del Abismo fue tras Dvalin, a Paimon no le sorprende que vayan a molestar a otro amigo del Arconte Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020243,
					"content": "Humm, es cierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020244,
					"content": "De cualquier modo, no importa que la razón de esta amenaza esté clara o no, yo solucionaré las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020245,
					"content": "#{F#Caballera Honoraria}{M#Caballero Honorario}, por favor, ve a ver si Boreas corre peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020246,
					"content": "El espíritu de este dios... no suele prestarle atención a la gente. Pero tengo entendido que tú lo has visto. Así que, quizás, lo mejor es que vayas tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020247,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "#Bien, ten cuidado. Dejo este asunto en tus manos, {F#Caballera Honoraria}{M#Caballero Honorario} de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020214,
					"content": "Se nota que socializar no es lo tuyo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "No tengo problema en interactuar con la gente, pero con los dioses... es otro tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020208,
					"content": "¿Acaso no son lindos los animales peludos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
			"completionStepIds": [
				800211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
