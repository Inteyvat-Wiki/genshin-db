				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020301,
					"content": "¡Tú... no bienvenido aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020302,
					"content": "Jajaja... Así que ese viejo lobo está criando cachorros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Emisario del Abismo"
				},
				{
					"id": 80020303,
					"content": "¿Y se hace llamar guardián? Claramente, sus garras han perdido filo desde sus días de gloria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Emisario del Abismo"
				},
				{
					"id": 80020304,
					"content": "Si te unes a nosotros, podemos restaurar los poderes divinos que una vez poseíste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Emisario del Abismo"
				},
				{
					"id": 80020305,
					"content": "Mientes... ¡Mientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020306,
					"content": "¿Qué es este ritual? ¡Parece que está sufriendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020307,
					"content": "Oh, no... ¡¿Es lo mismo que usaron para corromper la mente de Dvalin?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020308,
					"content": "Lobos no rendirse. Pero... esto no poder continuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020309,
					"content": "Yo detendré esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "No importa cuántas veces lo intenten, siempre será inútil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emisario del Abismo"
				},
				{
					"id": 80020310,
					"content": "Segundo asalto contra el Emisario del Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "Una estatua enorme, una grandiosa catedral. Es evidente que la gente de Mondstadt invirtió una cantidad inconmensurable de recursos y energía para su construcción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020402,
					"content": "¿Pero era consciente de esto el Arconte Anemo al recibir tales regalos? ¿Y cuánto les retribuyó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020403,
					"content": "Pero la fe no pide nada a cambio, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020404,
					"content": "Humm, mientras el dios tenga la conciencia limpia, yo no soy quién para recriminarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020405,
					"content": "¡Shhh! Ya vamos a llegar a la Catedral, ahí no son bienvenidas las críticas al Arconte Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020406,
					"content": "Y, en realidad, el Arconte Anemo... Ah, nada, olvídalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020407,
					"content": "Oh, yo nunca dije que entraría a la Catedral. Les dejo a ustedes que hablen con las hermanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020408,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020409,
					"content": "Pero nos hemos estado encargando de todo juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "#Eres {F#la Caballera Honoraria}{M#el Caballero Honorario} de Mondstadt, plenamente confiable. No tendrán reparos en hacerte partícipe de este tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020412,
					"content": "Lo sospechoso sería que yo me presentara junto a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020413,
					"content": "¿Porque no te conocen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Exacto. Además, tal y como dijo nuestra pequeña amiga... Se me podría escapar algo malo sobre la Iglesia en cualquier momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020416,
					"content": "Cuando un no creyente pisa suelo sagrado, las cosas no terminan bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020417,
					"content": "Los dioses nunca me han favorecido en el pasado, y es muy probable que no lo hagan tampoco en el presente ni en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020418,
					"content": "Bueno, ya dije más que suficiente. Mientras conversamos, la Orden del Abismo continúa avanzando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020419,
					"content": "#Oh, en ese caso, vamos a preguntar, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020420,
					"content": "Algo más. Será mejor que no le cuenten a nadie de la Iglesia de Favonius sobre la estatua profanada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020421,
					"content": "Ellos no podrán simplemente ignorarlo, pero, si actúan precipitadamente, alertarán al enemigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020422,
					"content": "Además, las cosas nunca terminan bien cuando alguien se involucra en los asuntos del Abismo. No importa quién sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020414,
					"content": "¿Crees que no serás bienvenido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "¿No tienes curiosidad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
