			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020601,
					"content": "#Vayan a la Iglesia a averiguar, yo estaré aquí esperándo{F#las}{M#los}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800207,
			"completionStepIds": [
				800208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800208",
							"2"
						],
						"stepId": 800208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Boreas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "¡Hum! Lograron interrumpir el ritual. Qué suerte la suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "Emisario del Abismo"
				},
				{
					"id": 80020702,
					"content": "No imaginé que un viejo espíritu tendría tanta fuerza de voluntad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "Emisario del Abismo"
				},
				{
					"id": 80020703,
					"content": "No importa. Es solo un pequeño imprevisto que no afectará nuestro plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "Emisario del Abismo"
				},
				{
					"id": 80020704,
					"content": "Desapareció otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020705,
					"content": "Al menos lo detuvimos a tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "Gracias. Ustedes llegar a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020708,
					"content": "Lupical humano... Lamento presentarme ante ustedes en este estado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020709,
					"content": "Aun así, el Emisario del Abismo subestimó mi fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020710,
					"content": "Rey Lobo nunca negarse a prueba. Pero forastero que da miedo no respetar reglas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020711,
					"content": "Y yo no ver trampa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020712,
					"content": "Entonces, ¿el Emisario del Abismo hizo los preparativos para corromper su mente y, luego, lo atrajo con el pretexto de retarlo a una prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020713,
					"content": "No es tu culpa, Razor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#Gracias, {NICKNAME}. Mis garras necesitar más afiladas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020716,
					"content": "¿Ustedes olfatean peligro y venir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020717,
					"content": "No, escuchamos que pasaría algo peligroso. ¡La nariz de Paimon ni siquiera sabe a qué huele el peligro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020718,
					"content": "Además de venir a ayudar, también veníamos a averiguar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020719,
					"content": "Disculpe, Sr. Dios Lobo, ¿usted sabe algo acerca del primer Labrador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020720,
					"content": "No presto atención a las invenciones de los humanos. No sé nada sobre esos “Labradores”. Sin embargo, hay una máquina humana que nunca olvidaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020721,
					"content": "Irrumpió en mi campo de pruebas por equivocación y creí que quería retarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020722,
					"content": "Pero no tenía consciencia, solo quería pelear. Fue diseñada de pies a cabeza como una máquina de masacre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020723,
					"content": "Finalmente, le hice un gran daño con uno de mis ataques. Y, antes de caer, se fue del campo de pruebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020724,
					"content": "Humm... Por como suena, no podemos descartar que haya sido el primer Labrador, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020725,
					"content": "¿Podía girar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "Sí, podía girar. Saltaba muy alto y lanzaba bolas de fuego. Aunque su poder no podía compararse con el de un dios, era más fuerte que muchos portadores de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020730,
					"content": "¿Bolas de fuego?... Eh... ¿No hemos escuchado eso hace poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020731,
					"content": "De cualquier forma, esta información prueba que el primer Labrador llegó a Mondstadt, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020732,
					"content": "Suena como si el primero hubiese sido mucho más fuerte que los posteriores Guardianes de las Ruinas producidos en masa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020733,
					"content": "Pero, por esta historia, parece que fue dañado en el campo de pruebas de los lobos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020734,
					"content": "No sé... Pero ¿hemos ayudado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020735,
					"content": "Sí, fueron de gran ayuda. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020736,
					"content": "Debemos continuar investigando un asunto superimportante. Puede que el Emisario se haya ido, pero la Orden del Abismo sigue atacando. ¡Cuídense mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020737,
					"content": "Sí, puedo oler... gran peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020738,
					"content": "Ustedes también, con cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020727,
					"content": "¿Podía disparar misiles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "¿“Misiles”? No conozco esa palabra extraña... Como dije, no presto atención a las invenciones humanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020729,
					"content": "Podía girar, saltar muy alto y lanzar bolas de fuego. No era tan fuerte como un dios, pero sí más fuerte que muchos portadores de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020714,
					"content": "No te desanimes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "Sí que huyó rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}