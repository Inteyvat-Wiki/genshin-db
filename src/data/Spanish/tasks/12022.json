				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220401,
					"content": "Kokomi, ¿es este el libro que querías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220402,
					"content": "Humm, no estoy segura... ¿Podrían leer un poco en voz alta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220403,
					"content": "Actúa según el plan, y planifica según la situación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "¡Ah, sí, ese es! Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220406,
					"content": "¿Kokomi? Kokomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220407,
					"content": "#¡Se quedó dormida! ¿Qué hacemos, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220408,
					"content": "¡Esta noche es la fiesta de la victoria! Por no mencionar que las conversaciones de paz están a la vuelta de la esquina. Tiene tanto que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220409,
					"content": "Dejémosla descansar un rato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "#¿Segur{F#a}{M#o} que es una buena idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220411,
					"content": "Humm, se ve agotada. Paimon supone que todavía queda tiempo. Muy bien, hagámosle compañía mientras descansa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220412,
					"content": "Evitar el desastre... Proteger la paz a toda costa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220413,
					"content": "La guerra ha terminado... Las cosas están mejorando lentamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220414,
					"content": "¿Lo ven...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220415,
					"content": "Ehmm... ¿Eh? ¿Qué hora es? ¿Me quedé dormida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220416,
					"content": "Sí, ¡dormiste por mucho tiempo! ¡Es casi la hora de la fiesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220417,
					"content": "¡No puedo creer que sea tan tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220418,
					"content": "*Suspira*, no dormía tan plácidamente desde hace mucho, creo que serán unos tres puntos enteros de energía. Debe ser suficiente para aguantar las conversaciones de paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220419,
					"content": "#Gracias, {NICKNAME}. Bueno, será mejor que vayamos para allá, ya es casi la hora de encender la hoguera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220420,
					"content": "¡Bien, Kokomi recuperó toda su energía! ¡Bienvenida de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220421,
					"content": "Vamos a despertarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "Sí, al fin y al cabo dijo que quería terminar todo antes de que comience la fiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220423,
					"content": "¡Kokomi, despierta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220424,
					"content": "¿Eh...? ¿Me quedé dormida? ¿Qué hora es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220425,
					"content": "¡Debemos ponernos en marcha! ¡Ya casi es la hora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220426,
					"content": "¿De verdad? ¿Ya es tan tarde? Creo que no estoy recargada del todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220427,
					"content": "Te compraré un nuevo libro de estrategia militar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "¿De verdad? ¡Sí! ¡Quiero el último volumen del Arte de la guerra de Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220429,
					"content": "La Editorial Yae lo publicó el mes pasado, pero no he tenido la oportunidad de comprarlo... Ahora no puedes echarte atrás, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220430,
					"content": "Ja, eso realmente la animó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220431,
					"content": "Muy bien, ¡vamos a la fiesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220404,
					"content": "Ataca en el punto débil del enemigo, emerge en su punto ciego...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				}
			]
		},
