					"speakerTitle": "Paimon"
				},
				{
					"id": 120220502,
					"content": "¿Así que Kokomi tiene tiempo para ocuparse de ellas incluso cuando está descansando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220503,
					"content": "“Informe de flujo de Moras de los eventos de Sangonomiya”, “Informe anual de la producción pesquera”, “Desglose de los gastos mensuales de mantenimiento de la Isla Watatsumi”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220504,
					"content": "Esto es mucho trabajo para una sola persona, además de todas las directrices que tiene que escribir y las personas con las que tiene que reunirse a diario. No es de extrañar que se agote de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220505,
					"content": "Busquemos ese libro y ayudémosla a recuperar las fuerzas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
