			"dialogs": [
				{
					"id": 120220701,
					"content": "¿Estás buscando a Su Excelencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Me temo que no está aquí en este momento. No sé a dónde fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Qué extraño... ¿Deberíamos dejarlo para otro momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "No necesariamente. Si no recuerdo mal, Su Excelencia ha tomado disposiciones especiales para este tipo de situaciones en sus Directrices generales de actuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Déjenme ver... Ah, sí, la número 98. <color=#00E1FFFF>“Si un visitante de lejos viene a verme, y si mi paradero es desconocido, indíquenle que se dirija hacia el sur hasta llegar a un árbol de follaje púrpura”</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "La nota a pie de página estipula que esto solo se aplica cuando Su Excelencia no ha hecho ninguna comunicación sobre su paradero antes de desaparecer, e incluso entonces solo cuando el visitante en cuestión es de categoría vip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Por lo que a mí respecta, ustedes dos cumplen todos los requisitos. Llevo estas directrices conmigo en todo momento, así que estoy seguro de que es el curso de acción correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "¡Kokomi realmente piensa en todo! Muy bien, encontremos el lugar que describió y echemos un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
