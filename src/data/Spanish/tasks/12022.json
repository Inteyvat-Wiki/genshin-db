			"dialogs": [
				{
					"id": 120220301,
					"content": "#Mira, {NICKNAME}. ¿Quizás este es el libro que quería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220302,
					"content": "#“{F#La capitana}{M#El capitán} del Escuadrón Pez Espada n.º 2 regresó hoy. Energía +4...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220303,
					"content": "Eh... Eso es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220304,
						120220305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220304,
					"content": "No vimos nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				},
				{
					"id": 120220306,
					"content": "Devuélvanmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220307,
					"content": "Parece que ese no era... Sigamos buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220305,
					"content": "Lo abrió Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
