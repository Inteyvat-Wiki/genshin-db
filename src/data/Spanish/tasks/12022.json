			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "¿Eh? ¿Kokomi no ha llegado aún?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "Qué raro. No parece ser de las que llegan tarde. Esperemos un poco más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "¿Cómo es que todavía no está aquí? ¿Crees que podría estar en problemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Vamos a preguntarle a ese soldado de allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "¿Estás buscando a Su Excelencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Me temo que no está aquí en este momento. No sé a dónde fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Qué extraño... ¿Deberíamos dejarlo para otro momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "No necesariamente. Si no recuerdo mal, Su Excelencia ha tomado disposiciones especiales para este tipo de situaciones en sus Directrices generales de actuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Déjenme ver... Ah, sí, la número 98. <color=#00E1FFFF>“Si un visitante de lejos viene a verme, y si mi paradero es desconocido, indíquenle que se dirija hacia el sur hasta llegar a un árbol de follaje púrpura”</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "La nota a pie de página estipula que esto solo se aplica cuando Su Excelencia no ha hecho ninguna comunicación sobre su paradero antes de desaparecer, e incluso entonces solo cuando el visitante en cuestión es de categoría vip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Por lo que a mí respecta, ustedes dos cumplen todos los requisitos. Llevo estas directrices conmigo en todo momento, así que estoy seguro de que es el curso de acción correcto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "¡Kokomi realmente piensa en todo! Muy bien, encontremos el lugar que describió y echemos un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "¡Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "¡Así que aquí es donde estabas! Íbamos a reunirnos y preparar las cosas para la fiesta de la victoria de hoy, ¿qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Oh... Son ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "Discúlpenme... No me siento muy bien hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "¡Oh, no! ¿Estás enferma? ¡Vamos a buscar un médico ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "No, no es nada de eso... Es solo que mi energía está completamente agotada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "¿Te quedaste sin energía? ¡Oh, no! Es decir, ¡¿cómo un Guardián de las Ruinas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "No, es solo una forma de hablar. Me avergüenza admitirlo, pero no siempre puedo ser la persona infinitamente capaz que aparento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Todo el mundo te pedía tantas cosas ayer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Oh... ¿lo notaste? Supongo que no he dominado la habilidad de ocultar cómo me siento. Seguiré trabajando en ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Para ser sincera, no estoy hecha para ser líder. Al principio, mi sueño era estudiar estrategia militar y quizás convertirme en asesora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "Comunicarme constantemente con la gente, tratar de mantener su moral, tener que leer entre líneas, asegurarme de que todos reciben el reconocimiento que merecen... Es un trabajo muy duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Se supone que tienes que hacer que la gente se sienta bien solo por estar en tu presencia, y al mismo tiempo imponer respeto... No es algo natural para mí. A decir verdad, es algo que nunca quise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Pero, debido a mi linaje, iba a terminar siendo la Sacerdotisa Divina tarde o temprano. Me guste o no, es como debe ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "Así que siempre que me siento abrumada, vengo aquí para leer y relajarme un rato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "No te preocupes, no afecta a mi trabajo. Dejé los preparativos de la fiesta de la victoria en manos de otra persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Tengo que dar un discurso esta noche, y no debo dar a las tropas motivos para sospechar que algo anda mal. Pusimos mucho esfuerzo en conseguir la paz, y quiero que se sientan tranquilos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "¿Hay algo que podamos hacer para ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "Debería recuperar mis fuerzas pronto si aguanto el trabajo un poco más. *Suspira*, si hubiera alguna forma de escuchar una buena lectura sobre estrategia militar, estoy segura de que eso aceleraría el proceso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "Estaba leyendo un libro la última vez que vine aquí, pero solo llegué a la mitad. ¿Dónde lo puse... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "¡Lo encontraremos por ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "Y luego te lo leeremos en voz alta, para que te recuperes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "¿Harían eso por mí? Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "Jeje... Qué suerte que hayan vuelto a la Isla Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Noté que era un trabajo arduo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
