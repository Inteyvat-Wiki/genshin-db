						"rawParams": [
							"102305",
							"2"
						],
						"stepId": 102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nobile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230501,
					"content": "*Puf*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230502
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230502,
					"content": "¡Mira! Ha vuelto a su aspecto original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230546
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230546,
					"content": "Bueno, calmémonos un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230503
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230503,
					"content": "Uf... La carga del Legado del mal le pasó factura a mi cuerpo. No tuve tiempo ni de pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230504
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230504,
					"content": "Pensándolo bien, tienen menos posibilidades que yo de adelantarse para conseguir la Gnosis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230505
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230505,
					"content": "No tenían ninguna conexión con ella, así que no deben tener relación con su desaparición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230506
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230506,
					"content": "¡Así es! ¡Intentamos decirte que no la tomamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230507,
					"content": "Eres mucho más fuerte de lo que pensó Signora. ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230508,
						10230509
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230508,
					"content": "(Porque estamos reuniendo los poderes de los siete elementos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				},
				{
					"id": 10230510,
					"content": "Ya sabes la respuesta, ¿no? Puedo verlo en tu cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230511
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230511,
					"content": "Pero si quieres guardar tu secreto, supongo que tendré que contener mi curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230512
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230512,
					"content": "Esta batalla ha sido bastante satisfactoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230513
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230513,
					"content": "Cualquier persona que aspire a ser más fuerte, como yo, es mi amiga, aunque esa amistad solo se pueda demostrar en una batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230514
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230514,
					"content": "Qué forma más rara de hacer amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230515,
					"content": "Lamentablemente, debo poner fin a esta conversación. El deber me llama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230516
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230516,
					"content": "Dado que nadie tomó la Gnosis, debemos buscar de nuevo desde el principio. Quizás nunca hubo una Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230517
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230517,
					"content": "Incluso es posible que la Exuvia fuera solo una especie de distracción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230518
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230518,
					"content": "¿Qué? Quieres decir que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230519,
						10230520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230519,
					"content": "¿Rex Lapis todavía vive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230521,
					"content": "Me temo que sí. Interesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230522
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230522,
					"content": "Parece que el dios de la capital del comercio también sabe actuar fuera de los límites de los contratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230523
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230523,
					"content": "De ser así, debemos poner en marcha nuestro plan B.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230524
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230524,
					"content": "¿Plan B?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230525,
					"content": "Esperaba que nunca llegara a esto, porque los débiles se verán arrastrados en el proceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230526
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230526,
					"content": "A decir verdad, el mundo pertenece a los que buscamos ser más fuertes. Raramente me relaciono por voluntad propia con los débiles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230527
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230527,
					"content": "Desafortunadamente, no puedo ser muy quisquilloso con los métodos de Los Once. Al final, todos los niños acaban acostumbrándose a comer verdura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230528
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230528,
					"content": "Entonces, ¿qué piensas hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230529,
					"content": "Despertaré al dios que yace en su letargo en las profundidades del Bosque de Piedra Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230530
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230530,
					"content": "¡¿Un dios?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230531,
					"content": "<color=#00E1FFFF>Osial, el Señor del Vórtice</color>, derrotado en la Guerra de los Arcontes por Morax, el Arconte Geo, y quien fue sometido en las profundidades del mar por sus lanzas de piedra desde entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230532
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230532,
					"content": "Si un dios antiguo fuera liberado en Liyue, desprotegida y sin el amparo de su dios protector...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230533
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230533,
					"content": "¿Crees que el astuto Rex Lapis se mantendría al margen mientras ve cómo todo se destruye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230534
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230534,
					"content": "Pero... ¡la Guerra de los Arcontes terminó hace dos mil años! ¿Cómo podría un dios antiguo aparecer en un mundo que ahora gobiernan Los Siete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230535,
					"content": "¡Es muy sencillo! Ya he hecho los preparativos para despertarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230536,
					"content": "¡Ah! ¡Son Sellos del Permiso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230537,
					"content": "¡Oh, lo recuerdo! Sabíamos que los Fatui lo estaban investigando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230538,
						10230539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230538,
					"content": "Lo he visto con mis propios ojos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230540,
					"content": "En efecto. El que te dieron fue solo el resultado de esa investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230541
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230541,
					"content": "Con el poder concentrado de todos estos Sellos del Permiso, aunado al poder de Los Once otorgado por la Zarina... retirar las lanzas del Arconte Geo será un juego de niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230544
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230544,
					"content": "Usar los poderes de dioses antiguos en tal situación no me interesa y está en contra de mis principios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230545
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230545,
					"content": "Pero si eso obliga no solo al Arconte Geo, sino también a ti a actuar... Hace que las cosas sean un poco más intrigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230539,
					"content": "No solo eso, estás tratando de duplicarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230520,
					"content": "¿Los restos eran falsos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230509,
					"content": "(Es porque estamos restaurando mi poder original...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				}
			]
		}
	]
}