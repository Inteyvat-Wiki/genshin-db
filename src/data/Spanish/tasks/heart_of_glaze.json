			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230301,
					"content": "¡Guau! ¿Esta es la <color=#00E1FFFF>Casa Dorada</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230302,
					"content": "De por sí el exterior se veía hermoso, ¡no imaginé que el interior fuera así de lujoso! ¡Y lleno de Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230303,
					"content": "Aquí es donde se acuña todo el Mora de Teyvat, después de todo. No se darán cuenta si faltan algunos Moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230304,
					"content": "#Si mueves un dedo, ¡estamos acabad{F#as}{M#os}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "Oh, entonces es una trampa. Qué astutos... ¡Qué bueno que Paimon te trajo aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230307,
					"content": "Pero aunque no podamos llevarnos ningún Mora, podemos mirar más de cerca, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230308,
					"content": "#O mejor aún, ¡podemos tomar una siesta cubiert{F#as}{M#os} por una montaña de Moras! ¡Es como un sueño hecho realidad! Jejeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230309,
					"content": "Será mejor que primero inspeccionemos la Exuvia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "¡Tienes razón! ¡De vuelta al asunto en cuestión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230312,
					"content": "Está tranquilo... Demasiado tranquilo. Seguramente alguien debe estar protegiendo algo tan importante como la Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230313,
					"content": "#¿Eh? ¡{NICKNAME}, mira! ¡Qué pasó aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230314,
					"content": "¡Es la Geoarmada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "¡Parecen haber perdido el conocimiento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "Oh, oh. ¡Paimon huele problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230317,
					"content": "¡Rápido! ¡Tenemos que asegurarnos de que la Exuvia esté bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230310,
					"content": "Tengo un extraño presentimiento sobre este lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230305,
					"content": "Si fuera tan fácil, habrían vaciado este lugar hace mucho tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				}
			]
		},
		{
			"id": 102305,
			"completionStepIds": [
				102305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
