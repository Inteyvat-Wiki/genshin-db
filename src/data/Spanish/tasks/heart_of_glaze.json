			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230201,
					"content": "Ya cumplieron su tarea como “guías”, ¿qué hacen aquí todavía? ¿No han tenido suficientes problemas por un día?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230202
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230202,
					"content": "¿Eh? ¿Quién está ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230203,
					"content": "Si fueras un Fatui, la propia Zarina te daría una generosa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230204
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230204,
					"content": "Pero desafortunadamente, no son más que un hato de incompetentes, y están en mi camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230205,
						10230208
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230205,
					"content": "¿Cómo llegaste hasta aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230206
					]
				},
				{
					"id": 10230206,
					"content": "Humm, ¿por dónde empezar? Nunca me ha gustado tomar el camino largo, pero ¿quién iba a imaginar que el Arconte Geo moriría misteriosamente justo cuando llegué a Liyue, y que ocultarían la Exuvia en el acto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230207
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230207,
					"content": "Si no fuera por esa ceremonia del Rito del Ascenso que organizaste, habría sido un dolor de cabeza reunir más información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230211,
					"content": "Detener la acuñación del Mora, esconder la Exuvia... Las Siete Estrellas están haciendo todo lo que está en sus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230212
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230212,
					"content": "¡¿Así que tu plan era tomar la Gnosis de la Exuvia desde el principio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230213,
					"content": "Como uno de Los Once, es mi deber llevar a cabo la voluntad de la Zarina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230214
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230214,
					"content": "Ella obtendrá lo que desea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230215,
						10230216
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230215,
					"content": "No lo permitiré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230217,
					"content": "¡Ja! No necesito tu permiso. De todos modos, no hay nada que puedas hacer para detenerme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230218
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230218,
					"content": "La hora de la negociación y la diplomacia ya terminó. Aunque personalmente podría prescindir de tales métodos, estoy dispuesto a hacer lo que la Zarina considere conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230219
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230219,
					"content": "Y a continuación, mi parte favorita, algo simple, pero que podemos disfrutar juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230220
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230220,
					"content": "La batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230221
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230221,
					"content": "¿Batalla? Entonces eres de los que les gusta buscar problemas, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230222,
					"content": "Jaja, algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230223
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230223,
					"content": "Cuando Signora ofendió a las deidades fuera de la Catedral de Mondstadt, abandonó rápidamente la escena en cuanto cumplió su misión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230224
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230224,
					"content": "En lugar de una confrontación directa contigo, eligió confiar en la nieve y el hielo para escapar. Además, no quería que los caballeros llegaran a la escena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230225
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230225,
					"content": "Cuando se enfrenta a un oponente digno, prioriza su misión, evalúa el resultado de la pelea, y determina las consecuencias de sus actos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230226
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230226,
					"content": "Pero en cuanto a mí, el mayor placer de ser uno de Los Once radica en cruzar espadas con oponentes fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230227
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230227,
					"content": "¡No dejaremos que vuelva a suceder lo mismo que en Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230228,
					"content": "#Entonces, ¿tienen la intención de pelear conmigo? Bueno. No te mataré, viajer{F#a}{M#o}. Solo jugaré contigo para sentir la emoción de la batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230229
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230229,
					"content": "Nunca podrás vencerme, ni siquiera en sueños. Disfruta de la emoción de la batalla. Sabes a lo que me refiero, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230230
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230230,
					"content": "¿Que nunca podré vencerte? Eso ya lo veremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230231
					]
				},
				{
					"id": 10230231,
					"content": "¡Jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230232
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230232,
					"content": "¿Así que también quieres jugar? ¡Que así sea, pero no me decepciones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230216,
					"content": "No dejaré que te acerques a la Exuvia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230208,
					"content": "Veo que llegué justo en el momento indicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230209
					]
				},
				{
					"id": 10230209,
					"content": "Aunque les estoy profundamente agradecido por ayudarme a encontrar este lugar sin apenas esfuerzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230210
					],
					"speakerTitle": "Nobile"
				},
				{
					"id": 10230210,
					"content": "¿No crees que tratar de detenerme ahora sería un esfuerzo inútil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "Nobile"
				}
			]
		},
		{
			"id": 102303,
			"completionStepIds": [
				102303
