			"dialogs": [
				{
					"id": 701430101,
					"content": "¿Qué tal es ir de aventuras en Espinadragón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430102
					]
				},
				{
					"id": 701430102,
					"content": "#Si de verdad quieres ir a Espinadragón, debes asegurarte de estar bien preparad{F#a}{M#o}. No subestimes los peligros en la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701430103,
					"content": "Espinadragón no tendrá clemencia ante aventureros imprudentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7014302,
			"completionStepIds": [
				7014302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
