			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "#Hola, viajer{F#a}{M#o}. ¿Cómo va todo en tus viajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430202,
					"content": "Bastante bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "#Sí, he escuchado sobre tus hazañas. De seguir así, pronto te convertirás en {F#una aventurera famosa}{M#un aventurero famoso}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430204,
					"content": "#En cuanto a las actividades del Gremio, si estás interesad{F#a}{M#o}, tengo un informe de aventuras que me gustaría compartir contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430205,
					"content": "#¿Otro encargo? Soy tod{F#a}{M#o} oídos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "#Jaja, por la forma en que lo dices, ya estás excepcionalmente familiarizad{F#a}{M#o} con la forma en la que el Gremio funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430207,
					"content": "Sin embargo, esta vez no tengo un encargo para ti, sino que simplemente tengo un informe de aventuras para compartir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430208,
					"content": "Es acerca de Espinadragón, la montaña nevada cerca de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430209,
					"content": "El Gremio estableció un campamento y ha designado a varios aventureros allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430210,
					"content": "Marqué la ubicación en tu mapa. Cuando llegues, busca a una aventurera llamada Iris. Ella te informará sobre la situación de la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430211,
					"content": "Eso es todo de mi parte. ¡Feliz aventura! ¡Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
