				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610401,
					"content": "#Gracias, {NICKNAME}. Gracias, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610402,
					"content": "Aunque sea incómodo, hay que hablar con franqueza, los seres de dos pies tienen un dicho: “Si se ayuda, se debe ayudar hasta el final”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610403,
					"content": "Estás diciendo que necesitas ayuda con algo más, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "¿Los dichos de los humanos también se aplican a los hongos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "#Realmente eres dign{F#a}{M#o} del título de sabi{F#a}{M#o} entre los seres de dos pies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "Es lógico que nos ayudemos unos a otros como seres vivos que disfrutan de la generosidad de la tierra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Por favor, acepta esta bendición de la sabiduría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "Obtuviste la bendición de la sabiduría.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Oh... ¿Qué es esta cosa que parece tan sospechosa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Todavía puedo sentir mucha maldad en el aire, pero no tengo forma de saber de dónde proviene. Explora a lo largo de la corriente y seguramente encontrarás algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "Utiliza la bendición de la sabiduría sobre la fuente de energía maligna. Los míos podrán encargarse por sí solos del problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "La fuente de la energía maligna... No es algo que se pueda dejar de lado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "... Cierto, ¿por qué tú no te haces cargo de eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME} conoce el humor mejor que Paimon. Yo no tengo pies, tú sí los tienes. Naturalmente, el trabajo que necesita pies lo hacen los que tienen pies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610415,
					"content": "Además, tengo una misión más importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610416,
					"content": "¿Una misión más importante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "Necesité demasiada energía para hablar contigo y con Paimon. Ahora debo descansar para acumular energía y luchar contra el mal. Así podré darle sombra a mi pueblo y desarrollarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610418,
					"content": "#Bendiciones, {NICKNAME}, bendiciones, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610419,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610420,
					"content": "¡Oye, Champi! ¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, parece que Champi se durmió, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "¿De dónde salió ese fango oscuro? ¿Es eso lo que Champi llama energía maligna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
