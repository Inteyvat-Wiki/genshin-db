	"talks": [
		{
			"id": 2300502,
			"completionStepIds": [
				2300502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
