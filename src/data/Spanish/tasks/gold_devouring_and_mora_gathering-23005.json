				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "Humm, no está nada mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "Veo que has hecho una fortuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "#Oh, ¡hola, viajer{F#a}{M#o}! Gracias a ti, pude obtener una pequeña ganancia. Parece que el plato de oro de esta vez ha sido todo un éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "Aunque lo cierto es que no es mucho más de lo que gano normalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "Así no es como debería funcionar el plato de oro. ¿Será que me equivoqué de plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "#Viajer{F#a}{M#o}, vamos a intentarlo otra vez. ¿Podrías ayudarme a escoger el plato de oro una vez más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "Las reglas son las mismas. Ayúdame a elegir entre <color=#00E1FFFF>carne de Mora</color>, <color=#00E1FFFF>pollo a la mantequilla</color> y <color=#00E1FFFF>torre de Ludi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300503",
							"2"
						],
						"stepId": 2300503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2300503"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "La última vez obtuve pequeñas ganancias, ¡pero esta vez seguro que me lleno de dinero! <color=#00E1FFFF>Carne de Mora</color>, <color=#00E1FFFF>pollo a la mantequilla</color> y <color=#00E1FFFF>torre de Ludi</color>. ¿Qué te parecen? ¿Cuál elegirías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300504",
							"2"
						],
						"stepId": 2300504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "Pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050402,
					"content": "¡Hola, Hatim! ¿Cómo estás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050403,
					"content": "Ah... Son ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050404,
					"content": "*Suspira*, supongo que por mi aspecto malhumorado ya se imaginan lo que ha pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050405,
					"content": "No les voy a mentir. Me estoy quedando sin Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050406,
					"content": "Qué extraño... ¿Por qué no funciona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050407,
					"content": "Aunque, pensándolo bien, tengo mis sospechas de que quizá sea una señal de que los precios están a punto de despegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050408,
					"content": "Igual que las personas tienen que flexionar las rodillas para saltar más alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050409,
					"content": "Pues lo mismo pasa con los intercambios. El mercado tiene que tocar fondo antes de poder ir hacia arriba, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050410,
					"content": "¡O sea, que ahora es el mejor momento para hacerse con grandes gangas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050411,
					"content": "A lo mejor todavía no ha tocado fondo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "Para nada. Estoy convencido de que es una oportunidad única. No dejaré pasar la oportunidad de hacerme rico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050414,
					"content": "¡Así, por fin seré digno del título de el acaudalado Hatim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050415,
					"content": "#¿Y bien? ¿Me ayudas otra vez,{F#amiga mía}{M#amigo mío}? ¡Elige otro plato de oro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050416,
					"content": "¿Siguen siendo los tres platos de antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050417,
					"content": "Humm... ¡No! Si se trata de buscar gangas, ¡necesito un plato aún más especial que me traiga buena suerte de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050418,
					"content": "He oído hablar de un hombre en Mondstadt muy rico. Por lo visto tiene un negocio relacionado con el vino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050419,
					"content": "¿Te refieres a...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "¿... Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050421,
					"content": "¿Y cómo es que le conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050422,
					"content": "Jajaja, si conozco la torre de Ludi, ¿cómo no voy a conocerlo a él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050423,
					"content": "Abrió una taberna donde vende una bebida de calidad llamada sidra de manzana. Si me bebo una de esas, ¡seguro de yo también podré disfrutar de la buena fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050424,
					"content": "¡Por favor, prepárame una sidra de manzana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050412,
					"content": "Agacharte antes de saltar te puede dar calambres en las piernas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
