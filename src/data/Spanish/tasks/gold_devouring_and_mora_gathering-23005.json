					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050601,
					"content": "¿Esta es la sidra de manzana de aquel hombre acaudalado, no? Mmm, tiene un aroma extraordinario que despeja la mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "¡Muy bien! ¡Con esto conseguiré dar un giro al mercado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "¡Nunca olvidaré lo mucho que me ayudaron! ¡Nos vemos luego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
