			"dialogs": [
				{
					"id": 413570301,
					"content": "¿Y bien? ¿Cómo va la búsqueda de tesoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570302,
					"content": "Ya los encontré todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "#¿Todos? Vaya, eres buen{F#a}{M#o} buscando tesoros. Mucha gente ni siquiera puede girar las linternas de la forma correcta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570304,
					"content": "Ya que encontraste todos los tesoros... Toma esto como premio. ¡Feliz Rito de la Linterna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				}
			]
		},
