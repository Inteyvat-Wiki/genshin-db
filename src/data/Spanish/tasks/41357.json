							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "Guau, lo entendiste rápido. Bien, ahora que conoces lo básico, ya puedes intentar jugarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570202,
					"content": "¿Es muy difícil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "No, no. ¿No entendiste cómo girar las linternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570204,
					"content": "Cuando juegues, lo único que tienes que hacer es girar las tres linternas para que lo que proyecten en el biombo muestre una imagen completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570212,
					"content": "Antes de nada, te explicaré la imagen que debes conseguir, pero eres tú quien debe averiguar cómo girar las linternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570205,
					"content": "¿Qué pasa cuando completo la imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "Tal vez habrás notado que el biombo tiene pintado un mapa de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570207,
					"content": "Al alinear las imágenes y proyectarlas en el mapa, encontrarás un tesoro preparado especialmente por el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570208,
					"content": "El gremio hizo un gran trabajo colocando los tesoros en su sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570213,
					"content": "Los cofres son idénticos a estos frente a mí. Cuando sepas la ubicación, podrás encontrarlos sin problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570209,
					"content": "La imagen de hoy está lista. Es un <color=#00E1FFFF>lirio de cristal</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570210,
					"content": "Ah, por cierto, otra cosa más. Las imágenes de las linternas giratorias solo se ven claramente de noche. Es mejor que vengas más tarde a intentarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570211,
					"content": "Además, el Gremio de Aventureros encargó la elaboración de estas linternas a un experto. Son realmente hermosas, así que sería una pena no apreciarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				}
			]
		},
