				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "#¡Bienvenid{F#a}{M#o}! ¿Quieres intentar el juego de las linternas giratorias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570102,
					"content": "¿Linternas gira... qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "Linternas giratorias. ¿Qué dices? ¿Quieres probar? Es muy simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570104,
					"content": "¿Ves ese biombo de ahí? ¿Y estas linternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570105,
					"content": "Mandé a hacer estas linternas personalizadas. Al encenderlas, proyectan todo tipo de imágenes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570106,
					"content": "Si giran las tres linternas en la dirección correcta, las tres imágenes se combinarán para proyectar una imagen completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 413570107,
					"content": "Humm... Quizás no me expliqué bien. De acuerdo, ¿qué tal si hacemos esto? Primero prueba girando las linternas y, una vez que te hayas familiarizado con su funcionamiento, te contaré más detalles del juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
