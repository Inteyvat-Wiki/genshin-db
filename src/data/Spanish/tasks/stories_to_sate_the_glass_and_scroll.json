			"dialogs": [
				{
					"id": 700740501,
					"content": "¡Oigan! Han asustado a todas... las palomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740502,
					"content": "... ¿G-Gran Maestro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740503,
					"content": "¿Oh? ¿No es el pequeño Timmie? ¡Parece que has crecido bastante! ¿Has estado comiendo bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740504,
					"content": "¡S-sí! ¡Siempre recuerdo lo que me dijo! Para convertirme en todo un hombre, ¡tengo que comer bien! ¡Y entrenar mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740505,
					"content": "La actitud de este chico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "Bueno, es normal... Paimon cree que no hay ni un solo niño en toda la ciudad que no admire a la leyenda de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740508,
					"content": "Siento haber asustado a tus palomas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740509,
					"content": "Justo quería preguntarte, ¿hay alguna forma de acercarse a las palomas sin asustarlas... y que además se mantengan contentas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740510,
					"content": "Humm... Normalmente me acerco a ellas con cuidado y luego les echo comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740511,
					"content": "... ¡Ah, sí! ¡Eso es! ¿Tienes más comida contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740512,
					"content": "Tengo bastante comida... Pero... Gran Maestro... Eh... ¿Ustedes van a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740513,
					"content": "¡Tranquilo! Te lo prometo. Solo vamos a pedirles prestadas algunas plumas. ¡Es una promesa entre adultos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740514,
					"content": "Ah... ¡Está bien! ¡Gracias, Gran Maestro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740506,
					"content": "¡Ha cambiado un montón!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
