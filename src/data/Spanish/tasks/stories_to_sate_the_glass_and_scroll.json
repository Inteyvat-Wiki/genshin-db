			"dialogs": [
				{
					"id": 700740101,
					"content": "Ahora que Paimon lo piensa, si Varka fue quien inició la “conferencia” con las brujas, ¿cómo es que no nos hemos fijado en su tarea en todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740102,
					"content": "A ver, deja que Paimon busque... Varka, Varka... ¿Eh? ¿Cómo es que está en blanco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740103,
					"content": "¿Y si vamos a preguntarle directamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "Tienes razón... Si queremos encontrarlo, Paimon cree que sería más fácil buscarlo en una taberna o un restaurante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740105,
					"content": "¿Tampoco está aquí? Parece que tendré que arreglármelas yo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740106,
					"content": "¡Mira quién está ahí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "¡Eh! ¡Varka! Queríamos preguntarte sobre la “tarea”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740108,
					"content": "#¿Oh? ¡Caballer{F#a}{M#o} Honorari{F#a}{M#o} y Paimon! ¿Tarea...? ¿Por qué preguntan por eso de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740109,
					"content": "El Aquelarre les preparó tareas a todos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "Tarea... tarea... Ah, ¿no mencionó Alice algo sobre eso en algún momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740112,
					"content": "... ¡¿Pero no es una tarea que surgió por una de tus conferencias?! Bueno, da igual... Mejor dinos por qué tu tarea está completamente en blanco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740113,
					"content": "Humm, me temo que mi tarea era demasiado pesada para ese cuadernillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740114,
					"content": "Ahora sí que me has dado curiosidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "Consiste en... preparar el mejor licor de todo Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740117,
					"content": "... ¡¿Eso qué tiene de pesado?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740118,
					"content": "No subestimes esta tarea. Esta nueva cicatriz en mi brazo me la hice mientras conseguía la receta de ese licor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740119,
					"content": "¡Me tuve que adentrar en un dominio sumido en el caos y luchar contra los monstruos más feroces y despiadados...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740120,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "#¡Ahora solo faltan tres materiales especiales para alcanzar el éxito! Caballer{F#a}{M#o} Honorari{F#a}{M#o}, Paimon, ¿estarían dispuest{F#a}{M#o}s a echarme una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740122,
					"content": "Bueno, ya que solo faltan tres... Paimon va a confiar en ti, ¡así que te ayudaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740123,
					"content": "Bien, los materiales que faltan por conseguir son: “virutas de madera despedazada por los caballeros”, “plumas de paloma caídas con júbilo” y “sopa medicinal hecha en un gran caldero”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740124,
					"content": "¡Oye, eso no es preparar un cóctel! ¡Suena más bien a que estuvieras preparando una poción mágica extraña o algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740125,
					"content": "Eh... Bueno, mira, al fin y al cabo es una tarea de las brujas, ¡jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740126,
					"content": "Para reproducir la receta a la perfección, los tres ingredientes deben cumplir estrictamente con los requisitos. Primero, vayamos al lugar donde podemos conseguir las “virutas de madera”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740115,
					"content": "¿De qué tarea se trata? Cuenta, cuenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "¿Por qué tu tarea del Aquelarre está en blanco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
