			"dialogs": [
				{
					"id": 700740401,
					"content": "¡Increíble! Así que se hace así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740402,
					"content": "... ¡Para! ¡A Paimon le van a salir callos en las orejas de escuchar esas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740403,
					"content": "Humm... Estas virutas de madera... Tanto la forma como la textura son muy parecidas... ¡y la calidad es excelente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740404,
					"content": "¿Cómo se mide la calidad de unas virutas de madera...? Bueno, si estás contento, Paimon también. El siguiente ingrediente era... ¿“Plumas de paloma caídas con júbilo”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
