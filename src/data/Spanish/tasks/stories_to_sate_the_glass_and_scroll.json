			"dialogs": [
				{
					"id": 700740201,
					"content": "... Así que este es el lugar indicado para conseguir las virutas de madera despedazada por los caballeros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740202,
					"content": "#¡Ah! ¡Gran Maestro! ¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}! ¿Ustedes también vinieron a entrenar hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740203,
					"content": "Esforzarse por alcanzar un objetivo... Sí, eso también es una forma de entrenamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740204,
					"content": "Ya son muy fuertes, y aun así buscan mejorar... ¡Entrenen todo lo que quieran! ¡Yo estaré aquí al lado tomando notas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
