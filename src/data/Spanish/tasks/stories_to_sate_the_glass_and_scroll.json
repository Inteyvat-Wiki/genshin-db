			"dialogs": [
				{
					"id": 700740801,
					"content": "*Curru, curru*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "Paloma"
				},
				{
					"id": 700740802,
					"content": "¡Las plumas! ¡Las tengo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740803,
					"content": "Por fin las tenemos... Esta tarea está siendo mucho más difícil de lo que Paimon pensaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740804,
					"content": "Ya solo falta la última... “Sopa medicinal hecha en un gran caldero”. Si no me equivoco, eso está en el Valle Dadaupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740805,
					"content": "¡Voy para allá! ¡Dense prisa y síganme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740806,
					"content": "Oye... ¿No crees que está demasiado emocionado? ¿Cómo puede correr más rápido que una paloma asustada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740807,
					"content": "Supongo que es de esperar de alguien tan libre como el viento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "... ¡Ese señor borracho...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740810,
					"content": "¿Eh? ¿Quién anda ahí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740812,
					"content": "¿Diona? ¿Qué haces aquí? Y escondiéndote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740813,
					"content": "Yo... solo salí a recoger unas frutas, pero de repente me encontré con ese tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740814,
					"content": "Últimamente no para de insistirme con que le prepare de nuevo la bebida de la otra vez... Me tiene tan harta que no me queda más remedio que esconderme de él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740815,
					"content": "¿Qué pasa con la bebida de la otra vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "¿No volvió hace poco con una fuerza expedicionaria? Pues fueron a la taberna Cola de Gato a celebrarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740817,
					"content": "¿La taberna Cola de Gato? Paimon pensaba que lo celebrarían en la sede de los Caballeros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740818,
					"content": "Yo pensaba que irían a El Obsequio del Ángel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "Eh... Ya fueron a todas. La taberna Cola de Gato es la tercera parada. Piensan beber una ronda en cada taberna de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740820,
					"content": "... Paimon sospecha que cuando vuelva la próxima fuerza expedicionaria, van a usar esa excusa para beber más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740821,
					"content": "No me cabe duda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "... ¡En fin! ¡Ya no soporto ver a esos viejos borrachos! ¡Solo quiero preparar la bebida más asquerosa y repugnante para que espabilen de una vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740823,
					"content": "Pero tu condición...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "Sí, por eso al principio le pedí a Príncipe que lo preparara por mí... ¿Quién iba a pensar que esos tipos, en cuanto se emborracharon, iban a querer burlarse de él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740826,
					"content": "... Así que el Príncipe huyó antes de terminar de mezclar y, de paso, ¡le dio un buen zarpazo a ese borracho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740827,
					"content": "(La cicatriz que mencionó Varka... No será que...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "¡Me tuve que adentrar en un dom{RUBY#[D]taberna}inio sumido en el caos y luchar contra los mons{RUBY#[D]Príncipe}truos más feroces y despiadados...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740829,
					"content": "... Vi que casi había terminado de preparar la bebida, y pensé que solo faltaba un poco, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740830,
					"content": "Así que lo terminaste tú misma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "Sí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740832,
					"content": "Una pregunta más, por curiosidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "Humm, pues virutas de madera de la armadura de un caballero, plumas de paloma que encontré en el bosque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740835,
					"content": "Y el último ingrediente, que originalmente iba a usar para curar la resaca... es una sopa de hierbas de los Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740836,
					"content": "#{NICKNAME}... ¿Crees que como Varka acaba de volver... puede que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740837,
					"content": "... Nadie le haya dicho que solo Diona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "¡Este tipo... va a armar un lío enorme! ¡Rápido, hay que detenerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740838,
					"content": "¡Es capaz de preparar una bebida con estos materiales!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "¿Qué le añadiste exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "Pero si todo lo que preparas se vuelve delicioso, ¿no es así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "Las ganas de beber no caben en él.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
		{
			"id": 7007409,
