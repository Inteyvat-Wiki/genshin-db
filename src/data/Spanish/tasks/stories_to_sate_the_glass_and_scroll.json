			"dialogs": [
				{
					"id": 700740301,
					"content": "¡Les dejo el campo de entrenamiento a ustedes! Poder presenciar en persona el estilo de dos maestros de élite... ¡valdría la pena aunque tuviera que esperar tres días más!",
					"roleType": "TALK_ROLE_NPC",
