						],
						"pointId": 15600
					}
				]
			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "Increíble... ¿Desde cuándo los Hilichurls se han vuelto tan amigables?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740902,
					"content": "¡Ella! ¿Has visto a Varka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740903,
					"content": "Sí, hace un momento dijo que iba a pedirles prestada una olla a los Hilichurls... Y en cuanto lo vieron, se apresuraron a cedérsela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740904,
					"content": "No intercambiaron muchas palabras, así que ¿cómo pudo ser tan fácil? ¿Acaso el Gran Maestro domina algún tipo de lenguaje corporal de los Hilichurls que desconozco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740905,
					"content": "No creo que eso cuente como comunicación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "¡Eso no es lo importante! ¿Dónde está Varka ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740908,
					"content": "Miren, ahí está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740909,
					"content": "¡Por fin... está listo! ¡El mejor licor de todo Teyvat! Y ahora mismo... ¡está en mis manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740910,
					"content": "¡Varka...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "¿Oh? ¿Por fin llegaron? Esos Hilichurls resultaron ser bastante razonables, así que la preparación de la bebida avanzó más rápido de lo esperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740912,
					"content": "¡Ahora es el momento de la degustación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740913,
					"content": "¡Espera! ¡No te lo bebas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "¿Eh? ¿Quieren probar el primer sorbo? Jeje... ¡El honor del primer trago es algo que jamás cederé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740915,
					"content": "¡No es eso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "¡No se preocupen! Les dejaré un poquito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740917,
					"content": "*Glup*... *Glup*... ¡Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740918,
					"content": "¿Eh? Me siento... un poco... mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740919,
					"content": "¡Varka! ¿Estás bien? ¿Varka? ¡¡Varkaaa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740920,
					"content": "... ¡Gran Maestro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "¡Oye! Derrotamos a un demonio, ¡¿y ahora te vas a dejar caer en un sitio como este?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740923,
					"content": "Ah... Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740924,
					"content": "... Por un momento me pareció ver a todos los antiguos Caballeros de Boreas delante de mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740925,
					"content": "No sé si preguntarte que cómo pudiste caer aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "Déjame digerir esto un momento... Tanto esa copa de hace un rato como esta dolorosa lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740928,
					"content": "Le explicas a Varka la bendición de Diona de “preparar siempre licores deliciosos”...\\nTan solo por pasar por sus manos, los ingredientes más extraños se convierten en licores exquisitos...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "Ah, ya veo... Entonces el ingrediente que faltaba era en realidad la bendición del hada de la fuente... Jaja, ¡eso sí que no me lo esperaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740930,
					"content": "¡Oye! ¡No pongas esa carita de inocente como si no hubiera pasado nada! ¡Todavía nos debes una explicación por habernos mentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740931,
					"content": "Perdón, perdón... De verdad creía que no había ningún problema con la receta. Pensaba contárselo todo cuando la probáramos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740932,
					"content": "Pero supongo que ahora... ya no les apetece probarla, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740933,
					"content": "Mejor dejémoslo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "#Humm... Entonces, les debo una por la bebida de esta vez. Cuando regresemos, l{F#a}{M#o}s invito a comer en El Buen Cazador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740936,
					"content": "¿Invitarnos? ¡Eso ya le gusta más a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740937,
					"content": "Qué fácil es comprarte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "Humm... Lleva un buen rato pasándolo fatal por culpa de esa bebida. ¿No crees que ya aprendió la lección?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740939,
					"content": "*Suspira*, me lo he buscado yo solito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740940,
					"content": "Pero tu tarea en blanco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "Jaja, pensaba guardármelo como historia para contar con unas copas, pero parece que ahora solo puedo contarla bajo el viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740943,
					"content": "... ¿Diseñar una serie de “tareas” para todos en Mondstadt? Es una buena idea. ¿Podría tener una yo también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740944,
					"content": "Je, tu tarea, “cambiar el destino reflejado en el astrolabio”, ya la completaste cuando decidiste emprender tu travesía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alice"
				},
				{
					"id": 700740941,
					"content": "¿Qué pasó exactamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "#Ni loc{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "O cómo puedes seguir en pie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "¡¿Qué estás haciendo, Gran Maestro?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "Al menos no con palabras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
