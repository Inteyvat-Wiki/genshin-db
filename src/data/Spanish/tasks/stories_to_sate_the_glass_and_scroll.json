					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740602
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740602,
					"content": "#Cuando aparezcan las palomas, acércate a ellas sigilosamente y esparce la comida... Pero no les hagas daño, ¿eh? ¿Estás list{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
