			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying'er",
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716600101,
					"content": "¡Han vuelto! ¿Qué tal los efectos de la poción hieloardiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600102,
						716600105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600102,
					"content": "Estaría bien si pudiéramos usarla fuera del dominio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600103
					]
				},
				{
					"id": 716600103,
					"content": "¡Exacto! ¡Eso sería perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600104,
					"content": "¿Eh? No es una mala idea, ¡cuéntenme más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600108,
					"content": "Le explicas a Timaeus los detalles del experimento...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600109
					]
				},
				{
					"id": 716600109,
					"content": "¡Es tal y como predijo, Srta. Ying'er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600110
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600110,
					"content": "Ya sé cómo debo mejorar la poción hieloardiente. Debemos controlar la sustancia sublimada dentro de cierta área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600111,
					"content": "Tal vez... si revertimos las propiedades de los dientes de león y hacemos un suplemento especial, podríamos hacer que el flujo del viento afectara a la poción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600112,
					"content": "Es solo que... es una propuesta sin precedentes. No será nada fácil y necesitaremos una gran cantidad de pruebas para comprobar su viabilidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600113,
					"content": "¡Paimon no entiende ni jota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600114,
					"content": "Aunque Paimon tiene el presentimiento de que las recomendaciones de la Srta. Ying'er son importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600115,
					"content": "Oh, pero si no he dado ninguna predicción tan detallada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600116
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600116,
					"content": "Qué alquimista tan diligente. ¿Intentas leerme la mente... o solo intentas complacerme con halagos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600117
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600117,
					"content": "¡Y-yo solo elogiaba sus conocimientos académicos! ¡Es todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600118,
					"content": "De acuerdo, de acuerdo. Será mejor que te esfuerces. ¿Quién sabe? Es posible que tengas que utilizar otras fuentes de conocimiento en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600119
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600119,
					"content": "En caso de que tus experimentos tengan éxito, no olvides pasar a avisarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600120
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600120,
					"content": "¡Por supuesto! ¡Escogeré las muestras de mejor calidad y se las enviaré como souvenir, Srta. Ying'er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600121
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600121,
					"content": "Si tiene tiempo libre, podría acompañarnos al Restaurante Wanmin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600122
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600122,
					"content": "Dejemos el “intercambio académico” aquí. Todavía tengo muchos asuntos pendientes en Aroma Primaveral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600123
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600123,
					"content": "Si tengo tiempo, con gusto los acompañaré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600124
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600124,
					"content": "¡Hasta la próxima!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600125
					]
				},
				{
					"id": 716600125,
					"content": "¡Gracias, Ying'er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600126,
					"content": "Ying'er se marcha...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600127
					]
				},
				{
					"id": 716600127,
					"content": "*Suspira*, al final no fui capaz de decirlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600128,
					"content": "Pero le he robado demasiado tiempo a la Srta. Ying'er, así que no debería causarle más molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600129
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600129,
					"content": "Tranquilízate, Timaeus. Es mejor esperar a la oportunidad adecuada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600130
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600130,
					"content": "¿Qué tanto murmuras, Timaeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600131,
					"content": "¡N-no, nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600132
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600132,
					"content": "¡Gracias por su ayuda durante todo este tiempo! Como prometí, les invitaré a comer en el Restaurante Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600133
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600133,
					"content": "Casi lo olvidaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600134
					]
				},
				{
					"id": 716600134,
					"content": "¡Eso es! ¡Rápido, a darnos un festín!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600135,
					"content": "Disfrutan de un gran festín en el Restaurante Wanmin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600136
					]
				},
				{
					"id": 716600136,
					"content": "Ay... ¡Paimon comió a reventar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600137,
					"content": "¡Paimon cree que el tema de tu investigación es muy interesante, Timaeus! Si vuelves a Liyue, ¡no olvides avisarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600138,
						716600139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600138,
					"content": "¿De verdad te interesa la investigación, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600140,
					"content": "¡¿Cómo puedes decir eso?! ¡Paimon también tiene espíritu investigador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600141,
					"content": "#En fin, ¡gracias a amb{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600142
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600142,
					"content": "Cuando vuelva a Mondstadt, me dedicaré de lleno a la poción hieloardiente. Me temo que no tendré tiempo para volver a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600143
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600143,
					"content": "Tendré que pedirles que le envíen una carta de mi parte a la Srta. Ying'er. No tuve tiempo de darle las gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600144
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600144,
					"content": "¿Eh? Pero si hablaron por tanto tiempo, ¿por qué no le diste las gracias personalmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600145,
					"content": "*Ejem*, es porque... la conversación con la Srta. Ying'er fue muy especial... ¡Sí, eso es! Así que es mejor pensar mis palabras con detenimiento y escribirlas que decir lo primero que se me venga a la mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600146
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600146,
					"content": "En fin, el tiempo apremia. Volvamos a Mondstadt. ¡No puedo esperar a crear la muestra perfecta de la poción hieloardiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600147
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600147,
					"content": "¿Es imaginación de Paimon, o Timaeus actúa raro después de conocer a Ying'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600148,
					"content": "Es de lo más extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600139,
					"content": "Solo piensas en comer a expensas de Timaeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600105,
					"content": "Aún tiene margen de mejora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600106
					]
				},
				{
					"id": 716600106,
					"content": "Sí, por ejemplo... ¡Sería genial que pudiera usarse fuera del dominio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600107,
					"content": "Estoy discutiendo este asunto con Ying'er. Quiero saber todos los detalles del experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}