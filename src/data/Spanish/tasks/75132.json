			},
			"dialogs": [
				{
					"id": 751320601,
					"content": "#Oh, guerrer{F#a}{M#o} de tierras lejanas... puedo sentir... todo lo que has hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320602,
					"content": "#Qué grande eres, guerrer{F#a}{M#o}. La fuerza corroída ha regresado al Reino de la Noche y puedo sentir la alegría de las almas noctámbulas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320603,
					"content": "... Toma esto como recompensa, ya que el que consigue grandes logros merece ser recompensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				}
			]
		}
	]
