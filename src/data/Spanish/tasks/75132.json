			"dialogs": [
				{
					"id": 751320101,
					"content": "#Oh... guerrer{F#a}{M#o} de tierras lejanas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320102,
					"content": "Por favor, escucha mis palabras. Soy el cuervo nocturno que guía el camino, así como un recuerdo de los poemas de la Señora de la Noche... o quizás tan solo uno de los millones de pensamientos a la luz de la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320103,
					"content": "Debido a que el río de los espíritus que fluye bajo tierra está hecho un desastre, solo soy capaz de hablarte por medio de esta imagen para advertirte que tengas cuidado con los enemigos de la oscuridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320104,
					"content": "Es aquí donde ese espejo roto reflejó una vez la luz, pero ahora el humo negro se ha extendido por tres áreas. Por favor, recuerda bien:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320105,
					"content": "El primer lugar se encuentra al este, donde han emergido poco a poco las sombras que se escondían en las pintadas de los héroes legendarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320106,
					"content": "El segundo lugar se encuentra al oeste, donde sobre el mar misterioso se manifiesta la encarnación de la oscuridad que imita la voz de la Señora de la Noche, como si de un loro molesto se tratara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320107,
					"content": "El tercer lugar se encuentra bajo el acantilado, donde la niebla incolora que debería haberse extinguido cubre toda la Ciudad de las Cenizas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				},
				{
					"id": 751320108,
					"content": "#Guerrer{F#a}{M#o} de tierras lejanas, tienes que ir con cautela... Ten cuidado con los enemigos de la oscuridad y con los que destruyen todo a su paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Voluntad de la pintada misteriosa"
				}
			]
		},
