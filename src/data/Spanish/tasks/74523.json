				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "#En este viento... puedo sentir el sabor salado de la marea, el aroma a madera de los barcos mercantes a lo lejos, y también... la presencia de {F#una vieja amiga}{M#un viejo amigo}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#{NICKNAME}, ¿cómo estás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Kazuha, cuánto tiempo sin vernos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "La Flota Crux Meridianam ha atracado en Inazuma para reabastecerse. Como rara vez tengo la oportunidad de visitar mi tierra natal, quise dar un paseo, contemplar una vez más los paisajes de mi hogar y escuchar el susurro del viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "El viento de Ritou siempre es más bullicioso que en otros lugares, mezclándose con despedidas y reencuentros, esperanzas y confusiones... Es un lugar donde se pueden escuchar muchas historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "¿Me dejarías tomarte una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Jeje, todo en este mundo tiene su forma, incluso el viento. Sin embargo, la forma de este solo se puede vislumbrar en el instante en que las hojas caen, las olas se levantan o cuando agitan las ropas de un viajero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "Espero que, a través de mi silueta, puedas capturar la forma efímera del viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Bien, voy a empezar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "De acuerdo, te invito a componer un poema con los versos de este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Solo siente el viento, como lo hiciste antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Me gustaría capturar el viento de este momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
