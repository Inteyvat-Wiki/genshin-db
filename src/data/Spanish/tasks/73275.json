			"dialogs": [
				{
					"id": 732750501,
					"content": "Quiero saber más sobre la balada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "#Oh, ¿te acuerdas de esa canción? Bueno, eso hace otr{F#a}{M#o} joven que la recuerda. ¡Jeje! ¡Bien, bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "♪ Rosa, rosita del jardín, haz que mis deseos se cumplan al fin. Una rosa dorada que canta mientras que de entre fragmentos se alza ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "♪ No hay tierra que me dé sustento, pero esta melodía será mi aliento. La música cargará con mi destino, algún día cumpliré mi sino ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "♪ Desafiarán a la eternidad, sobrevivirán a mi exigua mortalidad... ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
