			"dialogs": [
				{
					"id": 732750102,
					"content": "Las rosas doradas germinaron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "¿Puedo saber de dónde sacaste esas semillas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "De un lugar lejano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "¿En serio? Así que, después de todo, las semillas que Shafaqat esparció por todo lo largo y ancho del desierto llegaron hasta aquí, a pesar de lo escabroso del camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Debemos cuidar de estos brotes. Pienso dejárselos a Sabah. Cuando yo me vaya, estas flores serán suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "#Gracias, jovencit{F#a}{M#o}. No tengo mucho pero, por favor, acepta estas frutas y flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
