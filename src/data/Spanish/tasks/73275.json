				},
				{
					"id": 732750307,
					"content": "Debemos cuidar de estos brotes. Pienso dejárselos a Sabah. Cuando yo me vaya, estas flores serán suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Gracias por ayudar a este anciano, incluso sin pedir nada. Sin embargo, no podría conciliar el sueño si no te doy algo a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Este brote echó raíces. Sabah me sugirió dártelo. Incluso lo puso en un envoltorio muy bonito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Tómalo como un recuerdo. Que seas tenaz como este brote y nunca pierdas la fe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
