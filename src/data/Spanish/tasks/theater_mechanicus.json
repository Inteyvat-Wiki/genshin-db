				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "¡Vengan a probar suerte en la Arena mecánica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560102,
					"content": "¿Qué es esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "#¡Oh, bienvenid{M#o}{F#a}! Este es un nuevo juego que acabo de recibir de Liyue. ¡Se llama Arena mecánica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560104,
					"content": "Básicamente, es un juego de mesa. Fue inventado en Liyue por la Srta. Ruijin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560105,
					"content": "Cómo explicarlo... Según la Srta. Ruijin, soy una de los representantes del juego en el extranjero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560111,
					"content": "Después de obtener... humm... el derecho de representación, la Srta. Ruijin envió todo el conjunto de Arena mecánica, junto con la propuesta de negocio correspondiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560112,
					"content": "Aunque cuando llegó, el juego fue confiscado por el Buró de Asuntos Extranjeros. Conseguí obtenerlo después de un largo tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560113,
					"content": "¿Por qué lo confiscaron?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "No pasan por alto nada que venga del extranjero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560115,
					"content": "Olvídalo, eso ya no importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560116,
					"content": "¿Ves estas piezas dispuestas sobre la mesa aquí? Todas ellas son elementos importantes en la Arena mecánica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560117,
					"content": "¿No te recuerda mucho a Liyue? Jajaja, todo lo hice específicamente según las instrucciones de la carta de la Srta. Ruijin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560118,
					"content": "Hasta encargué especialmente que hicieran la mesa similar... y costó una fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560119,
					"content": "Además, en esta Arena mecánica he añadido una forma totalmente nueva de jugar, como sugirió la Srta. Ruijin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560120,
					"content": "Bueno... no creo que lo entiendas solo con escucharlo, así que prueba primero una partida. Al jugar, lo entenderás enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560121,
					"content": "Quiero probar la Arena mecánica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "No hay problema, diviértete. ¡Esta nueva Arena mecánica no te decepcionará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560123,
					"content": "Tengo otras cosas que hacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "Bueno, ven a jugar cuando tengas tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560106,
					"content": "¿Cómo es que aquí también hay Arena mecánica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "#Bienvenid{M#o}{F#a}... ¿Eh? ¿Conoces la Arena mecánica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560108,
					"content": "Ah... ya veo. Debes haber jugado en Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560109,
					"content": "La Srta. Ruijin y yo estuvimos hablando de que la promoción que hizo para el Rito de la Linterna... parece que funcionó bastante bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560110,
					"content": "¿Cómo decirlo? Según ella, soy representante de la Arena mecánica para la región de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				}
			]
		}
	]
}