						],
						"pointId": 14110
					}
				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "Oh... ¿Jahoda? ¿Qué hace aquí? Emm... ¿acaso se encuentra libre la jefa Néfer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260202,
					"content": "(Lo sabía, quiere ver a la jefa Nef... Hum, algo tan simple como esto puedo resolverlo yo sola.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260203,
					"content": "No se preocupe, la jefa me envió precisamente para ayudarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260204,
					"content": "¿Eh? ¿Qu-qué está diciendo? ¿Acaso la jefa Néfer ya...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260205,
					"content": "Siempre ha querido visitar a los Descendientes Lunaescarcha, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260206,
					"content": "Por eso quiere ganarse primero la confianza de Lyylikki para que lo lleve con los Descendientes Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260207,
					"content": "¡¿Qué?! ¿La jefa Néfer ya lo sabe? Ay, pero si no se lo he contado a nadie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260208,
					"content": "(¡Este es el momento de decir esa frase tan genial de la jefa Nef! ¿Cómo era...? Humm... ¡Ah!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260209,
					"content": "Jeje, Sr. Tzompanco, cuando uno guarda un secreto, también tiene que aprender a ocultar ese hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260210,
					"content": "De lo contrario, tarde o temprano, el muro que construyó en su interior empezará a tener grietas por donde entrará el viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260211,
					"content": "*Suspira*, en mis tierras nunca fui bueno escondiendo mis pensamientos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260212,
					"content": "(¡Me salió la frase! Valió la pena toda esa práctica, jejejeje...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260213,
					"content": "Bueno, ya que conoce mi intención, ¿sería tan amable de presentármela? Soy un forastero aquí, y no quisiera incomodar a la Srta. Lyylikki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260214,
					"content": "No se preocupe, Lyylikki es muy amable. No importa si es forastero o incluso si no es humano, lo acogerá con calidez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260215,
					"content": "¿Eh? ¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260216,
					"content": "Pero de todos modos, irrumpir sin aviso sería una descortesía... Emm... Si se diera el caso de que usted la conociera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260217,
					"content": "Por supuesto que la conozco. Justo ahora deben de haber terminado de repartir la comida. Vamos a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260218,
					"content": "Por cierto, la jefa dijo que esta vez no le cobraremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260219,
					"content": "¡Muchas gracias! Voy a preparar mis cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tzompanco"
				}
			]
		}
	]
}