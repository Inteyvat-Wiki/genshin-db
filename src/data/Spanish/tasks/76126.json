				]
			},
			"dialogs": [
				{
					"id": 761260101,
					"content": "¿Jahoda? Y... Sr. Tzompanco, ¿en qué puedo ayudarles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260102,
					"content": "Yo... eh... pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260103,
					"content": "Quiere visitar el campamento de los Descendientes Lunaescarcha, pero le da vergüenza y necesita tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260104,
					"content": "¡Sí! Eso es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260105,
					"content": "Muy buenas, Srta. Lyylikki. Un gusto conocerla. Eh... ¡este es un fósil que traje desde Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260106,
					"content": "Gracias, pero... Sr. Tzompanco, yo ya lo conozco. No necesita ser tan formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260107,
					"content": "¿Eh? ¿Me reconoce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260108,
					"content": "Siempre ha estado allí cuando yo repartía la comida, ¿no es así? Se quedaba mirando de cerca, dando vueltas, pero nunca se ponía en la fila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260109,
					"content": "Pensé que quería una ración pero le daba vergüenza acercarse, así que guardé una para usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260110,
					"content": "Pero nunca vino a recogerla. De todas formas, si hoy no se presentaba, también iba a mandar a alguien para preguntarle si necesitaba ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260111,
					"content": "Eh... mil disculpas. En realidad estaba pensado en cómo saludarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260112,
					"content": "Entonces, Srta. Lyylikki, ¿podría visitar a los Descendientes Lunaescarcha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260113,
					"content": "Claro. En el campamento también acogemos algunos visitantes forasteros. ¿Le importaría decirme el propósito de su visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260114,
					"content": "Tomar unas cuantas imágenes y algunas notas y, si es posible... ¡preguntar a alguien por las leyendas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260115,
					"content": "Soy miembro de la Asociación de Arqueología Sáurica de Natlan. Si puedo recopilar datos útiles para mi investigación, ¡sería perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260116,
					"content": "Oh, así que quiere leer libros. Déjeme pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260117,
					"content": "Bueno, veo que se están llevando perfectamente. Daré entonces por terminado este encargo. Tengo que regresar para avisar a mi jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260118,
					"content": "¡Mil gracias, Srta. Jahoda! Le pagaré de todos modos. No puedo dejar que haga todo esto sin nada a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260119,
					"content": "Y, por favor, no olvide darle las gracias a la jefa Néfer de mi parte cuando la vea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Tzompanco"
				},
				{
					"id": 761260120,
					"content": "Por supuesto, por supuesto. Me retiro entonces, que disfruten de la charla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
