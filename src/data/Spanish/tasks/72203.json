			"dialogs": [
				{
					"id": 722030501,
					"content": "Jaja, ¡me encontraste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "¿Sabes? Te echaré de menos, pero... vine esta vez a despedirme. El hombre de dorado dice que tenemos que irnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "¡Pero no te preocupes por mí! A donde voy, hay un montón de personas con quienes jugar. Me gustaría que pudieras venir tú también, pero el hombre de dorado dice que aún no es el momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "¡No hay problema! Te esperaré allí... Y si no puedo esperar, ¡me convertiré en partículas de luz y te buscaré en tus sueños!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Buen viaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Sí. Fue divertido jugar contigo. ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "Ya no estaré sola. Genial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonno"
				}
			]
