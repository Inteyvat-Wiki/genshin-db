					"nextDialogs": [
						746560103
					],
					"speakerTitle": "Isménor"
				},
				{
					"id": 746560103,
					"content": "La estatua es un poema taciturno, no intentes apreciarla con el estómago vacío. Me lo dijo un verdugo del justiciazgo durante el último duelo de su vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "Isménor"
				},
				{
					"id": 746560106,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "Todavía no las tengo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "Me aconsejaron que preparara unos Moras como agradecimiento. Supongo que debería dártelos cuando me traigas las burburanjas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
