			"dialogs": [
				{
					"id": 760220101,
					"content": "Resistirse es inútil y solo acabarás sangrando... ¡Deja tu Mora y vete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220102
					],
					"speakerTitle": "Samurái furioso"
				},
				{
					"id": 760220102,
					"content": "¡Socorro! ¡Auxilio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220103
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220103,
					"content": "Oh, no... ¡Tenemos que ir a ayudarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
