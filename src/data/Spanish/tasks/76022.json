						],
						"pointId": 13301
					}
				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "¡Eh, tú, tipo duro! ¿Qué crees que estás haciendo? ¡Detente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora... ¡No, no! Tú mataste a Murasaki... ¡Muere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Samurái furioso"
				},
				{
					"id": 760220203,
					"content": "#¡Aaah! ¡Cuidado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602203,
			"completionStepIds": [
				7602203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7602203",
