						"stepId": 7602203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Peco"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "¡Ay, ay, ay! ¡Gracias por salvarme! Soy Peco, un comerciante ambulante. Si alguna vez tienen la oportunidad de ver mis artículos, ¡les haré el mejor descuento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "Pero qué mala suerte he tenido hoy... Tenía que encontrarme con esa leyenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "¿Leyenda? ¿Tan famoso es ese tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "No por nada bueno. Había oído hablar de él de boca de otros comerciantes... Ellos también se llevaron un buen susto, y por eso no atraviesan esta ruta, pero yo no acababa de creérmelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "Parece que eres muy valiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "Los comerciantes ambulantes como yo lo hemos visto ya todo. Además, a veces nos reunimos para contarnos nuestras historias, por lo que es fácil exagerar un tanto los hechos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "Pero bueno... Se llama “Gonpachi”, y cuentan los rumores que se metió en problemas en Inazuma y tuvo que huir hasta aquí junto a su amante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "Entonces, esa “Murasaki” de la que hablaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#¡Cierto! Antes, cuando luchaba con {NICKNAME}, no paraba de mascullar ese nombre de esa forma tan extraña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Una vez que te sales del camino de la rectitud, es difícil volver a encontrarlo, incluso en un lugar nuevo. Si no consigues un trabajo honrado, acabarás donde empezaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "Si estuviera solo él, no habría problema, pero ganarse la vida con la espada... Bueno, nunca sabes cuándo acabarás metiéndote con la persona equivocada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "Dicen que así fue cómo su amante perdió la vida... Sea como sea, desde aquel entonces, ¡ha enloquecido por completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "*Suspira*... Eso de dedicarse a robar Mora está muy mal hecho, pero con solo pensar en el tipo de persona que se ha vuelto ahora... Paimon no puede evitar compadecerse de él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "¿Ves, Paimon? No puedes perseguir el Mora con tanto ahínco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "¡Oye! ¡Eso no es lo importante de la historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "#Bueno, no l{F#a}{M#o}s entretendré más. Por favor, acepten esto como muestra de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "¿Qué harías si te robaran un día, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#¡Jeje, pero si tú estás siempre a mi lado! ¡Tú eres {F#la protectora}{M#el protector} de mi Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}