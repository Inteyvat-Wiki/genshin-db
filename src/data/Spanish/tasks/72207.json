				{
					"id": 722070301,
					"content": "Jaja... Así que ahí está el tesoro de mi hermano. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070302
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070302,
					"content": "No podremos ir juntos a la tierra de los sueños, pero me convertiré en una partícula de luz y te encontraré. Eso es seguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070303
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070303,
					"content": "¿Puedes seguir soñando, aun cuando eres un alma errante en tierras extrañas?",
