				"points": []
			},
			"dialogs": [
				{
					"id": 722070101,
					"content": "No es suficiente... Aún no es suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070102,
					"content": "El tesoro de mi hermano mayor está en las caracolas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070103,
					"content": "Caracolas, caracolas... Están dispersas por doquier. Están dispersas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070104,
					"content": "Es el tesoro de mi hermano... No puedo irme aún...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070105,
					"content": "¿Dijiste “tesoro”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Mi hermano fue a un lugar más allá de la niebla. El sacerdote se puso furioso y dijo que el alma de mi hermano no volvería jamás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070108,
					"content": "Pero mi hermano dijo: “Allá hay flores muy bonitas y un mar de perlas... papá también está allá, remando y agitando los brazos, y nuestra hermanita lo acompaña”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070109,
					"content": "Mi hermano dejó el tesoro y nunca más volvió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070106,
					"content": "Cuéntame sobre tu hermano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
