					}
				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "¡Ya basta! ¡Me rindo! ¡Me rindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411302,
					"content": "V-vinieron en busca de estas cintas, ¿verdad? ¡Se las daré todas! Pero ¡dejen de hacerme daño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411303,
					"content": "El comandante Fatui entrega obedientemente todos los datos de la investigación.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Broglie, ¿con esto ya lo tenemos todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411305,
					"content": "Ehmm... Supongo que sí... Sí, ¡con esto ya lo tenemos todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411306,
					"content": "Bueno, y ahora lo importante es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411307,
					"content": "¿Qué pretenden obtener a cambio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Eso, ¡queremos una explicación! ¿Qué pretenden hacer ocupando estos observatorios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411310,
					"content": "Trabajar menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411311,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411312,
					"content": "Me llamo Malinovski, y soy el capitán del 34.º equipo independiente de reconocimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411313,
					"content": "Cuando nos enviaron a Fontaine, todos vivíamos felices y no teníamos misiones complicadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411315,
					"content": "Ah. ¿Y qué tiene que ver eso con que ocupes los observatorios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411316,
					"content": "No me esperaba que, hace unos meses, debido a unos cambios de personal, ¡los de Snezhnaya me asignaran a un tipo llamado Shumilov como nuevo subalterno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411317,
					"content": "¿Shumilov? Ah, es el capitán que vimos en el Observatorio Crepes Suzette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411318,
					"content": "¡Sí! ¡No soporto a ese tipo! Pero no hay forma de deshacerse de él, así que lo único que puedo hacer es buscar excusas para salir a hacer misiones y evitar estar a su lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411319,
					"content": "Un momento, le estás haciendo un lío a Paimon... Ese tipo llamado Shumilov, ¿es tu subalterno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411320,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411321,
					"content": "Entonces eres su superior, ¿no? ¡¿Por qué un superior tiene que hacer caso a su subordinado?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411322,
					"content": "Sí, lo es, pero ese tipo despreciable siempre pone una cara muy seria obligando a los demás a esforzarse en el trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411323,
					"content": "Sus argumentos son irrefutables, y yo no puedo decir enfrente de todos que en realidad lo que queremos es holgazanear, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411324,
					"content": "Y bueno, de casualidad, vi unas torres muy extrañas no muy lejos de aquí, así que dije que iríamos a investigarlas, y luego falsifiqué la carta de la Oficina Administrativa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411325,
					"content": "¡Hum, así que la falsificación fue cosa suya! Ahora que Paimon lo piensa, ¡es imposible que la Oficina Administrativa les confiara el observatorio de observación hidrológica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411326,
					"content": "Broglie, ¿hay algo más que quieras preguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411327,
					"content": "Humm... Ya veo, solo querían ocupar nuestros observatorios para holgazanear... Mejor dicho, solo querían buscar un momento de paz en este mundo tan ajetreado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411328,
					"content": "Entonces, ¿cómo les fue la estancia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411329,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411330,
					"content": "Fue una estancia... ¿cómoda? El paisaje de alrededor es muy hermoso y suelo sentirme muy bien después de echarme una siesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411331,
					"content": "¿A que sí? Especialmente al despertarte y descubrir que no tienes nada urgente que hacer ni a nadie vigilándote. Tan solo tienes que disfrutar del sol y la brisa de la tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411332,
					"content": "Es como despertarte de un sueño para introducirte en otro en el que no tienes ninguna preocupación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411333,
					"content": "¡Jaja, eso sí que es vida, señor! Lamentablemente, supongo que aún no probó el té negro de la Galería Vasari que se vende por tiempo limitado. Si tiene la oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411334,
					"content": "Un momento, ¡¿por qué de repente se pusieron a charlar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411335,
					"content": "En fin, síguenos. ¡Es hora de que el Instituto de Ciencias de Fontaine se entere de tus crímenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411336,
					"content": "Puff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411337,
					"content": "¡U-un momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411338,
					"content": "#¡Mis benefacto{F#ras}{M#res}! Este señor en realidad no causó ningún problema a nuestra investigación hidrológica, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411339,
					"content": "Objetivamente hablando, este señor incluso nos ayudó a reunir parte de los datos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411340,
					"content": "Además, ¡lo único que quiere es holgazanear y vivir una vida tranquila y feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411341,
					"content": "¡E-eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411342,
					"content": "No. Por muy convencidos que lo digan, ¡eso no es algo de lo que enorgullecerse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411343,
					"content": "#¡Por favor, {M#señor}{F#señorita} de buen corazón! Por favor, sea piados{F#a}{M#o} y no se lo tenga en cuenta por esta vez, ¡hágalo por el avance de la ciencia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411344,
					"content": "¿Y qué tiene que ver eso con el avance de la ciencia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "G-gracias señor, ¡y a ustedes dos también! ¡Prometo que no volveré a hacer algo así! ¡A partir de ahora haré todo lo posible para holgazanear valiéndome solo de mis habilidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740411347,
					"content": "¡Eso es! ¡Lo más importante es tener determinación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411348,
					"content": "¡No te motives sin venir a cuento en un sitio así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411349,
					"content": "El comandante Fatui se marcha agradecido...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "¡Bien! Ahora que el problema está solucionado, debería ir a preparar estos datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411351,
					"content": "¡Muchísimas gracias! ¡Por favor, acepten esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411352,
					"content": "¿D-de verdad está solucionado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411353,
					"content": "¿Sabes qué? Da igual. El observatorio está funcionando de nuevo y los escuadrones Fatui ya se retiraron. Digamos que con esto el tema queda zanjado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411345,
					"content": "Bueno, si tú lo dices...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				}
			]
		},
