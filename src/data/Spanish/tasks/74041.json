				]
			},
			"dialogs": [
				{
					"id": 740410101,
					"content": "¡Broglie, ya tenemos los datos de los dos observatorios que nos pediste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "¡¿De verdad?! ¡Qué bien! A ver que los vea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "Aquí tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Entregas las cintas perforadas a Broglie...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "¡Ah, sí, sí! ¡Esto es! Ustedes son los ángeles que me mandaron los Arcontes para salvarme de esta miseria y devolverme una vida feliz y relajada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "¡No hace falta exagerar tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "#En fin, no hay tiempo que perder. Amable {M#señor}{F#señorita}, voy a buscar a la jefa ahora mismo para pedirle la llave de la central. ¡Espéreme un momento, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "Ay, pero mira que... ¡Date prisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Poco después, Broglie vuelve emocionado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#¡{M#Señor}{F#Señorita}, ya tengo la llave! ¡Ahora solo tenemos que ir a la central y organizar un poco estos datos para recuperar mi trabajo de observación hidrológica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Teniendo en cuenta la situación del Observatorio Golosinas de Frutas y el Observatorio Crepes Suzette, es posible que en la central también haya esos señores de Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "Así que... ¡por favor, acompáñenme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Está bien, pero ¡no te olvides de nuestra recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "¿Hace falta que también vayamos nosotros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "¿Y nuestra recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "Esto... No te preocupes. Si la jefa aprueba la restauración de la investigación hidrológica original, ¡te aseguro que se te recompensará como es debido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "¡Fenomenal! Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
