					"content": "Si juntamos todos los datos recopilados, supongo que se podría obtener un buen resultado... ¡La restauración de la observación hidrológica está a la vuelta de la esquina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410603,
					"content": "Oh. ¡Genial, entonces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410604,
					"content": "¿Eh? Tengo la sensación de que faltan parte de los datos... ¿Serán imaginaciones mías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410605,
					"content": "¡¿Por qué hablas con tan poca certeza?! ¡¿Acaso no eres tú quien está a cargo de esos datos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410608,
					"content": "¿...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "... Ay, lo siento, me equivoqué de habitación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Malinovski"
				},
				{
					"id": 740410610,
					"content": "El comandante Fatui se marcha a una velocidad sorprendente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "U-un momento, ¿qué acaba de pasar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410612,
					"content": "Qué velocidad, era incluso más rápido que un Dragarto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "¡Ahora no es momento de preocuparse por eso! ¡Ese tipo era un Fatui! ¡¿Qué hacía aquí?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410615,
					"content": "#¡{NICKNAME}, tenemos que alcanzarlo para que nos lo aclare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410613,
					"content": "Qué tipo tan ágil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
		{
