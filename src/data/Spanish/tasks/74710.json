			"dialogs": [
				{
					"id": 747100101,
					"content": "Humm... Pececitos de buena conducta que nadan de aquí para allá en tanques espaciosos y cuidadosamente decorados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100102,
					"content": "Ciertamente es una escena preciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100103,
					"content": "¡Por eso nuestro acuario es tan popular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100104,
					"content": "Ojalá se comportaran así de bien en mar abierto... Así, la gente podría bucear y adentrarse más profundamente en la belleza del mundo natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100105,
					"content": "De todas formas, gracias a su ayuda, he logrado llegar al fondo del asunto y entender por qué esos peces estaban tan agitados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100106,
					"content": "A lo largo de los años ha habido muchísimos naufragios, e incluso algunos sinvergüenzas tirando residuos ilegalmente al mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100107,
					"content": "Una enorme cantidad de basura artificial ha caído al fondo del mar, acumulándose y destruyendo los hábitats naturales. Eso es lo que ha provocado que los peces se vuelvan cada vez más agresivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100108,
					"content": "Ya había un grupo de buceadores que había aceptado un encargo para limpiar toda esa basura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100109,
					"content": "Pero parece que voy a tener que darles un empujoncito para que se pongan las pilas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100110,
					"content": "Me da a mí que esto va a tardar un tiempo en resolverse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "Sí. Mientras tanto, sigamos con nuestro trabajo trayendo la mayor cantidad posible de pececillos agresivos para ayudarlos a relajarse y recuperarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100113,
					"content": "Aislar a los pacientes de un entorno dañino es un paso importante en el camino hacia la recuperación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100114,
					"content": "#¡Entendido! ¡Déjalo en nuestras manos! Estaremos atent{F#a}{M#o}s a cualquier nuevo paciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100111,
					"content": "Ya imagino que un trabajo así no podrá terminarse rápidamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
