				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021001,
					"content": "El último día del Rito de la Linterna habrá mucha gente que asistirá para ver el lanzamiento de la Linterna Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021002,
					"content": "Alguien sospechoso merodeando en un lugar tan peligroso... no es una buena señal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021003,
					"content": "¿Qué estaba haciendo con los materiales para la linterna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021401,
					"content": "¡Tenemos que ir con las autoridades! ¡Rápido, vamos al Ministerio de Asuntos Civiles de Liyue a reportarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021406,
					"content": "¿Por qué estás tan preocupada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "Pues, es que... ¡todo Liyue ha trabajado muy duro! ¡No podemos permitir que alguien lo arruine todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021408,
					"content": "Di la verdad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "No hay nada como el chop suey de Zhongyuan cerca del puerto. Con solo probar un bocado se vuelve inolvidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021410,
					"content": "¿Te pagan por promocionarlos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "Jejeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
