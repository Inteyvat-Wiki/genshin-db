			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "¡Oh, son ustedes! ¡Gracias por su aportación de materiales para el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020202,
					"content": "Hoy, tengo otro asunto que discutir con ustedes. Esta vez no se trata de una donación, es más bien una compra. ¿Les interesa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020203,
					"content": "¿Quieres decir que no es gratis? ¡Por supuesto que nos interesa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020204,
					"content": "¡Jaja! Entonces el trabajo es todo suyo. Les cuento los detalles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020205,
					"content": "Para los arreglos del festival, necesitamos dos tipos de plaustrita especiales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020206,
					"content": "Una se llama azurita. A veces se puede encontrar en la parte norte de la Cordillera Tianheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020207,
					"content": "Los arbustos que echan raíces sobre yacimientos de azurita dan un fruto llamado floti floti, cuyas semillas flotan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020208,
					"content": "La otra piedra se llama bermellonita. Es muy peligrosa para la gente común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020209,
					"content": "Los antiguos Cazadores de las Ruinas de la Llanura Guili perdieron su habilidad para volar, así que utilizan bermellonita para propulsarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020210,
					"content": "¡Entendido! Entonces, necesitamos azurita y una bermellonita, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020211,
					"content": "(En realidad, solo son plaustritas rojas y azules... esos nombres tan elegantes se los dieron los comerciantes a propósito...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020212,
					"content": "Así es. Les pido que traigan unas cuantas piedras de cada una. ¡Ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixin"
				}
			]
		},
		{
			"id": 4000205,
			"completionStepIds": [
				4000205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
