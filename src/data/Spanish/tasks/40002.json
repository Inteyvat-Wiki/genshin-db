			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021501,
					"content": "¡Espera! Este es el Ministerio de Asuntos Generales de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021502,
					"content": "Estamos aquí para denunciar a una persona sospechosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "¡Vimos a alguien sospechoso en el lugar donde recolectan materiales inflamables para la linterna mingxiao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021504,
					"content": "¡No deben permitir que desaparezca el puesto de chop suey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021505,
					"content": "Oh, suena muy grave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021506,
					"content": "¡Lo mismo piensa Paimon! La gastronomía de Liyue es el alma de la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021507,
					"content": "Eh... Creo que esa no es la parte grave de la situación, pero no estás del todo equivocada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021508,
					"content": "Gracias por los detalles. Le transmitiré la información a mis superiores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021509,
					"content": "Gracias por el aviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021510
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021510,
					"content": "Pero, pero... ¡tienen que tomarlo en serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
