			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "¡Guau! Estas muestras de Azurita y Vermellonita son de excelente calidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020502,
					"content": "¡Muchas gracias! Tengan su recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020503,
					"content": "¡Cada esfuerzo que hagan ayudará a que el Rito de la Linterna sea más brillante y colorido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020504,
					"content": "Por cierto, ya que están de visita en Liyue para el festival, no dejen de ver los cambios de la linterna mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020505,
					"content": "Conforme progrese su elaboración, el sitio de construcción en el muelle tendrá más y más vistas dignas de ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020506,
					"content": "#Suena interesante, {NICKNAME}, ¿vamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000214,
			"completionStepIds": [
