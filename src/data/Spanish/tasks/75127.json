				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "Tú también has venido a tomar imágenes, ¿no? Siempre hay viajeros extranjeros que quieren tomar imágenes aquí. Después de todo, la isla flotante en el mar es un paisaje maravilloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270102,
					"content": "Es una pena que antes no tuviera un Daguerrotipo. Este me lo consiguió un comerciante extranjero que conozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270103,
					"content": "#¿Te apetece tomar una imagen? Pero tienes que hacerla tú mism{F#a}{M#o}, a mí no se me da muy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270104,
					"content": "Qué raro, la niebla sobre el mar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "#¿Niebla? ¿De qué estás hablando, amig{F#a}{M#o}? Los vientos del mar de aquí siempre son muy fuertes. ¿Dónde está la niebla que dices?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270106,
					"content": "Nunca en la vida he visto que haya niebla sobre este mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270107,
					"content": "¿No estarás confundiendo este lugar con los lugares llenos de niebla bajo la Meseta Tezcatepetonco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270108,
					"content": "Puede ser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "#Jaja, yo diría que estás demasiado nervios{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270110,
					"content": "Ya que has venido a Natlan, necesitas relajarte un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakau"
				}
			]
		}
	]
