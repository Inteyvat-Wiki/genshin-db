			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "Soy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490302,
					"content": "Aberaku, ¡el creador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490303,
					"content": "Hum, ¿qué es eso de Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490304,
					"content": "¿Es algo impresionante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490305,
					"content": "¡Por supuesto! Fui yo quien lideró la construcción del Helios con la fuerza de un reino entero bajo mi mando, y así pudimos resistir a los dragones de las profundidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490306,
					"content": "¡Este hecho insuperable no podría haberlo hecho nadie más que yo y solo yo en todo el reino de Byakuya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490307,
					"content": "Eeeh... Paimon supone que es algo digno de admirar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490308,
					"content": "Pero entonces, ¿por qué una persona tan venerable acabó aquí encerrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490309,
					"content": "Me... me traicionaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490310,
					"content": "Cuando el reino del cielo cayó en las profundidades sin fin, el pueblo fue atacado por los dragones de las profundidades. Y entonces... sí, comencé a construir el Helios para salvarnos a todos de nuestro destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490311,
					"content": "Pero... ¡esos codiciosos! En el momento en que sus vidas ya no corrían peligro, comenzaron a engañar y a mentir. Y al final, colocaron a unos niños en el trono. ¡Ridículo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490312,
					"content": "¡Incluso yo fui objeto de sus planes y me dejaron en la cárcel para que me pudriera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490313,
					"content": "¡Malditos desgraciados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490314,
					"content": "Ah, sí, tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490315,
					"content": "¿Yo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "Sí, tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490320,
					"content": "¡Solo puedes ser tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490321,
					"content": "Antes, mis vestiduras sagradas estaban aquí, pero se han deteriorado con el paso de los años y ya no se pueden usar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490322,
					"content": "Pero si puedes pasar la prueba, te entregaré las ofrendas en las que he depositado mis pensamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490323,
					"content": "Espero que... lo consigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490324,
					"content": "#Es un asunto peligroso. Avísame cuando estés list{F#a}{M#o} para comenzar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490317,
					"content": "¡Paimon, te hablan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "No, te está mirando a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490319,
					"content": "(Con una mirada muy intimidante.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
