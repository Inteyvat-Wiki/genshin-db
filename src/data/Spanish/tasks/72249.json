			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "¡I-increíble! No tengo dudas de que eres capaz de hacer esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490202,
					"content": "Por favor, se lo ruego, lleven estas ofrendas... Las ofrendas... Tienen que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490203,
					"content": "Tienen que llevarlas a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490204,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490205,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490206,
					"content": "Oh, no, cada vez es más difícil comprender lo que dice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490207,
					"content": "Llévenlas al lugar designado... Unan las partes de mi alma para poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490208,
					"content": "¿Hola? ¿Señor espíritu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490209,
					"content": "Para... para poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490210,
					"content": "¿Para poder qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490211,
					"content": "Para poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490212,
					"content": "Uf, ¡no hay manera de entender a este señor! Parece que tenemos que llevar estas ofrendas a alguna parte, es lo único que Paimon entendió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490213,
					"content": "Estas ofrendas llevan mucho tiempo aquí. ¿Habrá algo comestible entre ellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490214,
					"content": "Mejor no te comas las ofrendas, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "¡Eh! Paimon no se come cualquier cosa, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490216,
					"content": "#Bueno, llevémonos las ofrendas, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224903,
