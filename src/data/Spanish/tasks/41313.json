			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "¿Y bien? ¿Ya resolvieron sus asuntos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130202,
					"content": "Sí, es solo que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "Bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130204,
					"content": "¿De verdad no irás a ver la linterna mingxiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "No, ya lo había mencionado, no me gustan los lugares abarrotados. Especialmente en esta época del año.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130206,
					"content": "La linterna mingxiao de este año está inspirada en Guía de los Cielos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "Sí, es un ciervo muy impresionante. ¿Vamos a verlo juntos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130208,
					"content": "Guía de los Cielos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130209,
					"content": "Sigue siendo una simple linterna mingxiao. Una creación efímera de los humanos no significa nada para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130210,
					"content": "Si lo que quieren es ver un espectáculo fugaz, les sugiero que vayan a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "Parece que Xiao y ustedes se volvieron a encargar de un asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130302,
					"content": "Se corrió la voz y la noticia llegó hasta nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130303,
					"content": "Sin embargo, ya va a terminar un Rito de la Linterna más, y él sigue sin querer ir a verlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130304,
					"content": "*Suspira*... Han pasado tantos años, y nunca lo he visto ir al Rito de la Linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130305,
					"content": "Diría que es más fácil llevarle el Rito de la Linterna a él que lo contrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130306,
					"content": "Llevarle el festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130307,
					"content": "¡Qué buena idea!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "¡Sí! Si Xiao no quiere ir al Rito de la Linterna, ¡traigámosle el Rito de la Linterna a él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130309,
					"content": "¿Perdón? Solo estaba bromeando. ¿Cómo piensan “traerle el Rito de la Linterna”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130310,
					"content": "Cuando paseábamos por el festival, aprendimos a hacer linternas celestes. Además, encontramos un puesto de comida con platos típicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130311,
					"content": "Muchos platos deliciosos, hermosas linternas celestes y... humm.. ¡Los héroes del pasado y sus antiguos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130312,
					"content": "De eso se trata el festival, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130313,
					"content": "Nada mal, pero ¿dónde podríamos organizarlo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130314,
					"content": "Si es así, déjenme pensar... Necesitamos un lugar espacioso donde también pueda instalar un puesto de comida. Quizás en la <color=#00E1FFFF>planta baja</color> de la posada haya espacio suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130315,
					"content": "Vamos abajo a escoger un lugar. Tengo una idea de cómo es el puesto de comida que quieren poner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130316,
					"content": "Humm... Debe haber algún estilo de referencia, déjenme pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "Aquí no está mal. Humm... Y está suficientemente alejado de los transeúntes. Parece una opción adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130702,
					"content": "Ya tenemos nuestro lugar, ahora tenemos que construir un puesto adecuado. Después de pensarlo, creo que tengo una idea de cómo hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130703,
					"content": "Espérenme un momento. Tengo que pensar por dónde empezar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130704,
					"content": "¡Listo! No es perfecto, pero cumple con su cometido. ¿Qué piensan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130705,
					"content": "¡Creo que tienes un don para la carpintería!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "¡Bah! No es gran cosa, es una simple artesanía que aprendí hace muchos años. Hay muchas cosas que ya no recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130707,
					"content": "Ya tenemos nuestro puesto. Aproveché para agregarle unas linternas celestes. Se ve bien, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130708,
					"content": "¿También sabes hacer linternas celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "Por supuesto. En Liyue, toda la gente de mi generación sabemos hacer linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130710,
					"content": "Cierto, cuando de festividades se trata, no puede faltar un gran festín. ¿Qué quisieran para el menú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130711,
					"content": "¡Tofu de almendras, de eso no hay duda! Hace tiempo, se lo ofrecimos a Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130712,
					"content": "También pez tigre a la parrilla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "Así que tofu de almendras y pez tigre a la parrilla... ¡Una combinación de sabores muy interesante! Le pediré al Sonriente Yanxiao que los prepare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130714,
					"content": "Da la casualidad de que la posada contaba con todos los ingredientes, así que debería tener listos los platos muy pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130715,
					"content": "Es hora de que suban por nuestro invitado de honor. Cuando bajen, los platos ya estarán servidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131308,
