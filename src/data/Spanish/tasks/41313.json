			"dialogs": [
				{
					"id": 413135201,
					"content": "¿Qué tal? Yanxiao no es un chef cualquiera, ¿o sí? Cuando terminemos de comer, deberían ir a la ciudad. Creo que llegarán justo a tiempo para el lanzamiento de la linterna mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413135202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413135202,
					"content": "No puedo creer que lograste convencerlo para que nos acompañara a comer. ¡Es la primera vez! Y eso que lo conozco desde hace muchos años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
