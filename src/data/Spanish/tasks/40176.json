			"dialogs": [
				{
					"id": 401730501,
					"content": "#¿Eh? ¿Necesitas algo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730502,
					"content": "Voy a devolverle la espada ceremonial al jefe, pero dejaré todo lo demás en el campamento por ahora. No dudes en usarlo como gustes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730503,
					"content": "Humm... Tengo el último volumen de «Crónicas del espejismo» por aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730505,
					"content": "Junto con una edición especial de «Los misteriosos casos de la Srta. Orith»...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "¡¿QU-QUÉÉÉ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730507,
					"content": "#¿Quieres que los leamos junt{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730509,
					"content": "#(¿Qué es esto? ¿Qué está pasando? ¿Cómo sabe que me gustan esos libros? No me digas que... ¿{NICKNAME} ha estado investigando mis intereses?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730510,
					"content": "(No, eso es ridículo. No seas tonta... Apuesto a que Ororon me vendió. Ese mocoso...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730511,
					"content": "#(Pero... ¿{NICKNAME} recuerda mis intereses? Bueno, tampoco pasaría nada si no los recordara, no es que sea nada importante...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730512,
					"content": "(¡Lo importante es el hecho de que me esté haciendo esta invitación! ¿Qué debería hacer? ¡¿Qué le digo?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730513,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 401730514,
					"content": "Claro, por qué no. Debería estar libre en un rato, te aviso cuando no esté ocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlalí"
				}
			]
		}
	]
