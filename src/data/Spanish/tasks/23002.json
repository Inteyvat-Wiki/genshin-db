			"dialogs": [
				{
					"id": 230020201,
					"content": "¿Cómo les fue? ¿Consiguieron los champiñones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanbei"
				}
			]
		},
		{
			"id": 2300203,
			"completionStepIds": [
				2300205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300205",
							"2"
						],
						"stepId": 2300205,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_LESS_THAN",
						"rawParams": [
							"101955",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Genial, con esto será suficiente. Estos champiñones tienen un aspecto estupendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Tome, aquí tiene su pago. Muchas gracias por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "¿Esto es antes o después de impuestos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
					]
				},
				{
					"id": 230020304,
					"content": "Después, por supuesto. No se preocupe, no le obligaría a volver a Inazuma solo para pagar impuestos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020305
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020305,
					"content": "Lo que no sé es si la política fiscal del shogunato ha cambiado recientemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020306
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020306,
					"content": "Ah, será mejor que saque tiempo para escribirle a Yousuke...",
					"roleType": "TALK_ROLE_NPC",
