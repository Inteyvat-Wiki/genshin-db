			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "La calidad de los champiñones de esta tienda no está nada mal. Lo anotaré en mi lista de la compra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020102,
					"content": "¿Hanbei? Ese nombre le resulta muy familiar a Paimon. Seguro que lo ha escuchado antes en algún lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020103,
					"content": "Podría ser aquel hombre de Tatarasuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "¡Ah! Es el que estuvo holgazaneando y causó todo ese desastre en la Fragua Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020106,
					"content": "Se supone que vino aquí a ejercer de agregado extranjero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "Entonces, es cierto que está aquí en Sumeru. Paimon pensó que eso del agregado extranjero no eran más que patrañas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020109,
					"content": "¿Eh? Pelo rubio... y una pequeña cosa que flota a su lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020110,
					"content": "#¿No será usted {F#la viajera}{M#el viajero}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020111,
					"content": "Así es, soy yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Jeje... Así que es usted de verdad. Yousuke le mencionó en una carta. Dijo que el Sr. Xavier y usted repararon la Fragua Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020115,
					"content": "Estoy muy avergonzado. Estaba ocupado con todo el papeleo mientras usted y el Sr. Xavier se encargaban de reparar la Fragua Mikage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020116,
					"content": "¿Acaso el papeleo es más importante que la Fragua Mikage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "¡Deberías revisar tus prioridades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020118,
					"content": "Ahí se equivoca. ¿Cómo va a salir bien la reparación de la Fragua Mikage si no se lleva a cabo correctamente el trabajo burocrático?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020119,
					"content": "Verán, hay que evacuar las zonas colindantes, preparar los materiales para la reparación, movilizar al personal, coordinar las necesidades de producción de todos los participantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020120,
					"content": "Sin organizar correctamente todo el papeleo, habría sido un verdadero desastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020121,
					"content": "Tal y como dijo Toranosuke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "Sí, hace honor a su reputación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020123,
					"content": "¿Toranosuke? Precisamente él es de esas personas que no se ocupan en absoluto de las cuestiones burocráticas. ¡Trabajar con él siempre me supone una gran cantidad de trabajo extra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020124,
					"content": "Bueno, ya no estoy a cargo de la Fragua Mikage. Ahora trabajo de agregado extranjero en Sumeru. Me encargo de dirigir el comercio de champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020125,
					"content": "#Bueno, viajer{F#a}{M#o}, por lo que Yousuke me contó sobre usted, debe ser una persona realmente confiable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020126,
					"content": "Si no le importa, ¿podría hacerme un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020127,
					"content": "Estoy buscando un proveedor de champiñones fiable a largo plazo. He investigado a un buen puñado de ellos por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020128,
					"content": "Las muestras de champiñones que me presentaron eran excelentes, pero solo usan producto de calidad para las muestras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020129,
					"content": "Por eso creo que es importante ir directamente a la zona de producción para ver los champiñones, valorar su calidad y decidir si comerciar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020130,
					"content": "El problema es que, como resulta evidente, carezco de experiencia de campo. Me temo que si entro solo en el bosque podría correr grave peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020131,
					"content": "Por eso me gustaría pedirle que vaya al bosque por mí, recoja unos cuantos champiñones y me los traiga. ¿Qué le parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020132,
					"content": "Bueno, podría hacerlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "¿Eso es un sí? ¡Excelente! No se preocupe por el papeleo. Ya lo tengo todo preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020135,
					"content": "Aquí está el contrato de empleo, y esto de aquí es el desglose de sus honorarios. Por aquí está el formulario de consentimiento y el acuerdo de confidencialidad y... ¡Claro! El mapa de las zonas de producción de champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020136,
					"content": "Tras analizar meticulosamente todos los documentos con Hanbei, el cansancio se hace presente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Muy bien. Ya debería estar al tanto de toda la documentación pertinente. Ahora la remitiré al shogunato y, cuando reciba contestación, le plantearé la propuesta formal de empleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020138,
					"content": "Pero hasta entonces, pagaré sus honorarios de mi propio bolsillo. La adquisición de los champiñones no podría soportar más demora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020139,
					"content": "Por supuesto, también presentaré ese papeleo al shogunato. No olvide que tiene que declarar los impuestos correspondiente de sus honorarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020140,
					"content": "¡Me voy ya por los champiñones!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "¿Eh? Bueno, de acuerdo. Lo dejo en sus manos entonces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020142,
					"content": "No vamos a meternos en problemas otra vez, ¿verdad? A Paimon le preocupa un poco todo esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020143,
					"content": "No pasará, si lo mantenemos vigilado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "¿Eso crees? Bueno, Paimon supone que tiene sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020147,
					"content": "¿Eh? Cualquiera diría que no confía en mí. No se preocupe, preparé todo con sumo cuidado. No permitiré que tenga problemas burocráticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020148,
					"content": "No nos referíamos a eso... En fin, nos vamos ya a buscar esos champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020145,
					"content": "Quiero ser testigo de los nuevos problemas que cause este tipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "¡Pero bueno! Si causa otro problema, ¡no tenemos a nadie que nos ayude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020133,
					"content": "Primero hablemos del pago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "Esta es Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Eso. ¡Paimon es Paimon, no pequeña cosa que flota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020107,
					"content": "Se supone que vino aquí a comerciar con champiñones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "El que mencionaron Toranosuke y Yousuke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
		{
