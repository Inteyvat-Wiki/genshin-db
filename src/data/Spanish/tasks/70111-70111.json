				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "#Distinguid{F#a}{M#o} viajer{F#a}{M#o}, le ruego que se detenga un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "Dejando de lado los pormenores, hay algo que quisiera pedirle. Hace unos días, el excelentísimo Yu Huangyi de Liyue me envió un tesoro de extraordinaria rareza, pero aún no ha llegado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "Sospecho que el guardián de este lugar se ha apropiado de él. Si llegara a encontrar el tesoro que mencionó el excelentísimo Yu Huangyi, ¿podría hacerme el favor de recuperarlo? Le recompensaré como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "¡Hemos vuelto! A ver, ¿es este el “tesoro” del que hablabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "¡Oh! ¡Les estoy muy agradecido, de verdad! ¡Muchas gracias por su ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Entonces, sin más demora, procederé a abrirlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "¡¿E-esto es...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "¡Aaah! ¡¿Esa cosa no estará a punto de explotar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "El excelentísimo Yu Huangyi nunca me haría daño... ¡¿Acaso el guardián lo encontró y lo transformó en una bomba?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "Me avergüenza admitirlo, pero no tengo ni idea de cómo desactivar una bomba... No me queda otra opción más que... ¡lanzarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "¡No hay de que preocuparse! ¡Recuerdo que cierta persona de la nobleza de Hiperbórea explicó una vez cómo debía lanzarse una bomba sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "“Hay que contar hasta tres, ni más ni menos. No contarás hasta cuatro, ni tampoco hasta dos, y qué decir de contar hasta cinco. Cuando el número al que cuentes sea tres...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "¡Ya basta de tanta cháchara! ¡Si no la lanzas ya, te va a explotar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7011103,
