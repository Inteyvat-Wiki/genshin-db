			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma obsesionado con la comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "#Oye, novat{F#a}{M#o}, así no se hace la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330102,
					"content": "La comida que estamos haciendo es para los soldados ratnik de la isla, así que tenemos que cocinar según sus preferencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330103,
					"content": "Esta comida está para tirarse a la basura. Primero, porque no controlaste bien el fuego, y segundo, porque no cumple con nuestros estándares alimenticios. Tienes que corregir ambas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330104,
					"content": "No te va a quedar más remedio que seguir practicando. Puedes empezar cocinando comida local, como el perrito caliente de Nod Krai. Cuando hayas terminado, ven a mostrármelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma obsesionado con la comida"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
