			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma obsesionado con la comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "La salchicha del perrito caliente no está mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330202,
					"content": "Si trabajaras en un restaurante de fuera, este nivel sería suficiente para ser sous-chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330203,
					"content": "El problema es que tenemos que hacer comida para todos los soldados ratnik de la isla, así que lo importante no es el grado de sofisticación, sino la cantidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330204,
					"content": "El pan tiene que ser más grueso. Ahora mismo no tenemos muchas verduras, así que podrías añadir algo más de carne aparte de la salchicha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330205,
					"content": "Aún tienes que practicar. La próxima vez que vengas, harás carne frita con bayas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma obsesionado con la comida"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma obsesionado con la comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "El corte de la carne es perfecto y, además, está bien cocinada. Muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330302,
					"content": "Aun así, te advierto de algo: al hacer carne frita, es muy importante escoger una buena guarnición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330303,
					"content": "Es fácil llenarse rápido al comer carne, por eso se acompaña con bayas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330304,
					"content": "En esta isla, estamos a cargo de la alimentación y la salud de todo el mundo, así que debemos prestar especial atención a la proporción de carne y verduras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330305,
					"content": "Este plato de carne frita tiene poca guarnición. No sirve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330306,
					"content": "Aún tienes que practicar. La próxima vez que vengas, harás pollo asado con lakkas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma obsesionado con la comida"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
