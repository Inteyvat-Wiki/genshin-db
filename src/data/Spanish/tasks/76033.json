			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma obsesionado con la comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "La carne de pollo es deliciosa y tiene suficiente guarnición. Me estás poniendo difícil ser quisquilloso, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330402,
					"content": "En fin, tampoco es que mi intención fuera encontrar los errores de los novatos como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330403,
					"content": "Yo solo soy un cocinero, así que me limito a hacer bien mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330404,
					"content": "Y por eso, estoy preparado por si la Cacería salvaje viene en algún momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Fantasma obsesionado con la comida"
				},
				{
					"id": 760330405,
					"content": "La única pena es que no pude entregarles la comida preparada a tiempo... así que acabó desparramada... desparramada por todas partes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma obsesionado con la comida"
				}
			]
		}
	]
}