				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "¡Debo hacerlo! Debo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "¿Eh? ¿Quién eres tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "Acepté tu encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "Oh, te refieres al pedido de un compañero de entrenamiento. Así es, yo lo publiqué. Quiero encontrar a alguien que se convierta en mi compañero de entrenamiento de artes marciales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "¿Así que fuiste tú quien lo aceptó? Creo que nunca te he visto en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "Lo siento, no pretendo cuestionar tu fuerza. Pero no estoy seguro de cómo son tus habilidades en las artes marciales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "He derrotado a un dragón gigante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Jajaja... ¿En serio? En realidad, tengo más curiosidad por saber dónde encontraste uno. Solo he oído hablar de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "No te preocupes, soy muy hábil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Jaja. De todos modos, las palabras no prueban nada. Pongamos las palabras a prueba con nuestras manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "Con mucho gusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "¿Por qué publicaste ese encargo de forma anónima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "Bueno, en realidad es por algo de lo que... no estoy orgulloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "*Ejem*, ya que lo aceptaste, te diré la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Salí en una misión con varios guardias. En el camino de regreso, nos encontramos con un grupo de Samuráis Kairagi preparado para asaltar una caravana de comerciantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Nos apresuramos para rescatar la caravana. Al principio, llevábamos la ventaja y se retiraron rápidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Pero cuando estábamos a punto de tomar un descanso, otro grupo de Samuráis Kairagi apareció de la nada, y parecía haber un líder entre ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Antes de que mis camaradas y yo pudiéramos reaccionar, ya estaban encima de nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Sin la ventaja, solo podíamos intentar hacer retroceder a los Samuráis Kairagi mientras escoltábamos a los comerciantes de vuelta a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "Y cuando estaba luchando contra su líder... Me quitó el arma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Después la levantó y se rio de mí. Qué humillación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "¿Qué pasó con los comerciantes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Nos encontramos con otros guardias que patrullaban mientras nos retirábamos, así que esos Samuráis Kairagi también se retiraron después de verlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "Escoltamos a esos comerciantes a la ciudad, pero sus mercancías... *Suspira*, todo por culpa de mi falta de habilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Al regresar, me entregaron otra arma. Pero todavía no puedo superar lo que pasó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "Por eso publiqué ese encargo, con la esperanza de perfeccionar mis habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Una vez que sea lo suficientemente poderoso, derrotaré yo mismo a ese Samurái Kairagi y recuperaré mi arma para limpiar mi nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "Fui testigo de la caída de un dios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Eh, ¿de qué hablas? Quieres decir que participaste en el Rito del Descenso de Liyue, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Jajaja, según tu lógica, mucha gente de Liyue fue “testigo de la caída de un dios” también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2202902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
