				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "¡Puf! Eres... eres formidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Aprendí mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Estoy bien, solo necesito recuperar el aliento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "#Pero, en efecto, eres tan poderos{F#a}{M#o} que hasta podría creerme lo de que derrotaste a un dragón gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "P-pero es verdad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Jajaja... Te creo, te creo. Gracias por entrenar conmigo. Recordaré lo que aprendí en este enfrentamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "#Si no te importa, ven a practicar conmigo más a menudo. Teniendo como compañer{F#a}{M#o} a {F#una}{M#un} guerrer{F#a}{M#o} tan fuerte como tú... Estoy seguro de que pronto conseguiré lo que busco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "¿“Lo que buscas”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Ejem... Es solo un pequeño deseo que tengo en mente. Gracias por tu ayuda. Por favor, acepta esto como pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Ahora necesito tomar un descanso. Tus movimientos fueron muy poderosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Lo siento, no me controlé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
