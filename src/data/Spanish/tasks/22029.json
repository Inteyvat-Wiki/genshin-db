			"dialogs": [
				{
					"id": 220290201,
					"content": "Entonces, ¿ahora te estabas conteniendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290202,
					"content": "No te preocupes por mi orgullo. Atácame con lo que tengas. Debo... ¡debo hacerme más fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
