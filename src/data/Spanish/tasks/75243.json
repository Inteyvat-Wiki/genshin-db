			"dialogs": [
				{
					"id": 752430101,
					"content": "¡Ay! ¡Muchas gracias por ahuyentar a esos Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430102,
					"content": "Esos tipos aparecieron de la nada y, sin decir una palabra, ¡le echaron el guante a mi bolso! ¡Son unos ladrones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430103,
					"content": "¡Menos mal que los detuvo! Si no, habría perdido una fortuna... ¡Por favor, acepte esto como agradecimiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430104,
					"content": "Ah, casi me olvido de las presentaciones. Este es el Parque Alpaca Multicolor, donde nuestros visitantes podrán ver alpacas de carga domesticadas. Además, tenemos muchos juguetes relacionados a la venta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430105,
					"content": "Pero esos tipos asustaron a mis empleados y a mis clientes, así que tengo que ocuparme de ello lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430106,
					"content": "Si usted también quiere ver el Parque Alpaca, por favor, vuelva mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
