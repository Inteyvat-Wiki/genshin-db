			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"La Curiosa Patxa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "¡No hay tal cosa como un plan perfecto cuando estás en una aventura! ¿Cómo vas a progresar si sigues pensando así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410102,
					"content": "Si el plan no es perfecto, ¡entonces debemos estar preparados para cualquier imprevisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "¿De qué están discutiendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Soy una investigadora de ruinas antiguas y deseo emprender una investigación de campo en el Templo de los Mil Vientos. Pero no soy tan buena cuando de pelear se trata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410105,
					"content": "El Sr. Doolan es un aventurero, y se ha encargado de hacer todos los arreglos necesarios para la investigación del templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410106,
					"content": "Ahora bien, no pretendo criticar a Doolan de ninguna manera, y sé que esos Guardianes de las Ruinas pueden ser una verdadera molestia... Pero él insiste en diseñar un plan de aventura hasta el último detalle, para lo cual convoca reunión tras reunión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410107,
					"content": "Hemos hecho inspecciones, investigaciones y enmiendas, seguidas de investigaciones complementarias, investigaciones adicionales y una segunda ronda de enmiendas... ¡Ah, ya no puedo más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410108,
					"content": "Y ahora dice que encontró nueva evidencia de monstruos acampando al lado del templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410109,
					"content": "Te lo ruego, deshazte de ellos, ¿quieres? Solo para tranquilizarlo, aunque no nos sirva para entrar al templo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410110,
					"content": "Creo que sé qué tiene que ocurrir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Ocuparé tu lugar con gusto en las reuniones con Doolan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Aprecio el gesto, créeme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "La Curiosa Patxa"
				},
				{
					"id": 200410113,
					"content": "... ¡Te darás cuenta que esos monstruos son mucho menos estresantes que una de sus reuniones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Curiosa Patxa"
				}
			]
		},
