						"rawParams": [
							"7106408",
							"3"
						],
						"stepId": 7106408,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(Una pequeña estela de piedra, el texto grabado dice así:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Estela de piedra"
				},
				{
					"id": 710640202,
					"content": "“Perdí la movilidad de todos mis miembros durante la batalla en la Sima, así que solo puedo describirlo con palabras y pedir a otro que lo grabe y registre aquí.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Estela de piedra"
				},
				{
					"id": 710640203,
					"content": "“Sobreviví a esa batalla feroz, pero pensar en todos los compañeros que perdí me priva del sueño cada noche. Ahora que mi cuerpo se encuentra indispuesto, me odio por no poder seguir su camino.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Estela de piedra"
				},
				{
					"id": 710640204,
					"content": "“Mi intento por quitarme la vida fue infructuoso, ya que Rex Lapis se enteró de ello y me lo reprochó. Así, de repente, abrí los ojos.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Estela de piedra"
				},
				{
					"id": 710640205,
					"content": "“¡Ay! El casco y la armadura que me otorgó Rex Lapis me son inservibles. Si se quedan aquí conmigo, solo acumularán polvo. Si alguien está destinado a pasar por aquí, puede quedárselos.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Estela de piedra"
				},
				{
					"id": 710640206,
					"content": "“A todos ustedes les digo: ya no nos queda nada en esta vida, pero espero que volvamos a ser compañeros la próxima vez. ¡Brindemos de nuevo por la hermandad que juramos, y defendamos juntos a Liyue de sus enemigos!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estela de piedra"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "¡No esperaba que de verdad lo encontraras! Así que... ¿este es el tesoro de la Geoarmada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "No sabemos lo que hay dentro, pero... estoy seguro de que el soldado que dejó el tesoro estará muy contento de que lo hayas encontrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "Hace ya quinientos años de aquella batalla encarnizada en la que murieron tantos inocentes. Recordarlo hace que uno se pregunte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "¿Crees que, en aquel momento, alguno de los cientos de valientes que siguieron a Rex Lapis a la batalla pensó que formaría parte de la historia por aquel acontecimiento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "¿Crees que sintieron dudas a la hora de cumplir con su deber? Al fin y al cabo, se trataba de gente normal y corriente que no tenía una Visión. Tuvieron que confiar en un dios que nunca antes se había fijado en ellos y entregar sus vidas por una causa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "Lo hicieron porque Rex Lapis se mantuvo a su lado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "Sí, tienes razón. Con una Visión o sin ella... La gente siempre da lo mejor de sí para alcanzar un futuro mejor. Esa es su motivación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "Nosotros también somos así. Lo que nos mueve no son los recuerdos de un pasado mejor, ni siquiera el ahora... Lo que nos mueve es ayudarnos los unos a los otros para poder dejar huella juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "Tal vez el día de mañana también levanten una placa en nuestro nombre aquí en la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "Este lugar está lleno de minas y túneles excavados con el sudor de muchas generaciones de mineros. Es un claro símbolo de nuestro esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "Igual que este monumento, que seguirá aquí dentro de cien... no, mil años como prueba irrefutable del sacrificio de todos aquellos que lucharon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "Jeje, aunque yo no estaré aquí para verlo... Espero que cuando llegue el momento alguien se acerque a este lugar para brindar por nosotros, los mineros, y nuestro arduo trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "Fueron leales a sus decisiones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
