			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana",
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "#¡Espera, espera! Esto está a la venta. ¡No puedes tocarlo si no lo compras! Eh... Tú. Sí, tú, {F#la}{M#el} del pelo rubio. No te vayas, deja que te vea bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "Humm... Ciertamente, tienes el cabello brillante como el sol y los ojos tan profundos como el Reino de la Noche. Me parece que llegarás a ser alguien de gran importancia. No, estoy segura de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "#Ven, acércate. Tengo un montón de ornamentos de jade maravillosos, y cada uno contiene su propia melodía. ¡Algo así encaja perfectamente con un{F#a} {F#heroína}{M#héroe} como tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "#Se trata de tesoros de un valor incalculable. Para cualquier otro, el precio sería de al menos diez millones de Moras, pero como veo que estás destinad{F#a}{M#o} a ser su dueñ{F#a}{M#o}, te haré un descuento del 90%. ¿Qué te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "¡Guau! ¿Un 90%? ¡Vaya ganga! Un momento... ¡Aun así es más de un millón de Moras! ¿No es demasiado caro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "*Suspira*, no puedo hacer más. Es prácticamente el precio de coste. Los pequeños comerciantes como yo no tenemos mucha opción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "No deberías hacer eso para ganar dinero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "Ah, así que me escuchaste. Jaja, es que tengo la costumbre de hablar conmigo misma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "*Suspira*, ya que me descubrieron, no tengo más remedio que confesarles la verdad. En realidad, encontré estos ornamentos de jade por accidente. No valen tanto como les dije.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "Pero no hay nada que pueda hacer. Como ya saben, no tenemos presupuesto. Ni siquiera podemos permitirnos pagar a alguien para que nos ayude a recuperar los datos de las boyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "¡Pues que no los recuperen! En cualquier caso, es mejor que andar engañando a la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "Eso no es una opción... Otras organizaciones podrían dejar de operar si se quedan sin fondos, pero nosotros hacemos el trabajo de observación volcánica de forma voluntaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "Colocamos esas boyas para recopilar datos sobre la temperatura del agua y, así, poder detectar la actividad del volcán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "El volcán parece cada vez más inestable, así que tenemos que recuperar las boyas lo antes posible para evitar peores consecuencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Como estoy herida, no puedo romper las boyas, y mucho menos recuperar los datos de su interior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#{NICKNAME}, ¿qué tal si la ayudamos? El volcán es una amenaza para todos, así que deberíamos hacer algo al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "¿D-de verdad? Si me ayudan con esto, ¡les regalaré estos ornamentos de jade a cambio! Pueden tomarlos como su recompensa. ¿Qué les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "No sé por qué me suena a mí algo de un millón de Moras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "No te preocupes. Puede que no sea mucho, pero además de eso, recibirás una recompensa adicional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Jeje, ¡en realidad con eso bastará! Al fin y al cabo, lo estamos haciendo por todos los que viven en las inmediaciones del volcán. Puedes dejarlo en nuestras manos, no te preocupes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Comencemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "Necesito un momento para prepararme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "Claro, podemos empezar cuando quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "Oh... ¿Solo eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "¿No dijiste que un ayudante vale un millón de Moras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"2"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Uf... Qué alivio. Parece que la situación con el volcán no es tan catastrófica como imaginábamos. Ahora podremos dormir bien esta noche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "Tengo que darles las gracias. Si no me hubieran ayudado, no habría podido resolver la situación tan fácilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "¡Acepten esta recompensa como agradecimiento... y como disculpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "¡Jeje! Si insistes... ¡la aceptaremos con gusto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "¿Qué planeas hacer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "Todavía tengo unas mercancías que no he podido vender. Las operaciones normales deberían volver a encarrilar nuestras finanzas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Jaja, claro está, como ya no nos encontramos en una situación de emergencia, les garantizo que haré negocios de forma honesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
