				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Diez, veinte... He vendido tantos que ya no debería tener problemas de dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "¿No vas a intentar ganar más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "#Jaja, nada de eso, ¡lo he dejado! Si no hubieran sido tan comprensiv{F#a}{M#o}s y no me hubieran ayudado, me habría metido en problemas con esos jades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "Además, no tiene sentido obsesionarse con el dinero. Para mí, ganar dinero es solo una afición, lo verdaderamente vital es observar el volcán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "Siempre puedes ganar más dinero, pero si, por un descuido nuestro, no llegáramos a alertar de una erupción volcánica, perderíamos mucho más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "¿La Cámara Asamblearia no les otorga ningún tipo de financiación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "No hemos realizado ninguna solicitud. Después de todo, la Cámara Asamblearia y los jefes ya están hasta el cuello de trabajo. ¿Cómo íbamos a darles más asuntos de los que preocuparse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "Mis compañeros de viaje y yo somos muy distintos. Por lo general, nuestro grupo viaja por todo el mundo mientras gana dinero por el camino. Ya estamos acostumbrados a esa vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Observar el volcán mientras viajamos no es nada difícil. ¡Igual que ustedes ayudan a los necesitados que se encuentran por el camino, es pan comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "¡Vayan con cuidado! ¡Volveremos a encontrarnos si el destino quiere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
