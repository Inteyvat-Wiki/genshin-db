	"talks": [
		{
			"id": 2250101,
			"completionStepIds": [
				2250101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"2"
						],
						"stepId": 2250101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Humm... No, este verso no sirve. *Suspira*, de verdad, tengo que ir a ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "#Saludos, mi nombre es Chingzhou, {F#señorita}{M#caballero}. Me atrevo a decir que soy un poeta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010104,
					"content": "Por azar del destino, tuve inspiración para componer un verso, pero últimamente me he quedado corto de palabras para continuarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010105,
					"content": "En días recientes, los cielos han estado extraños, y varios meteoritos han caído llameantes a la tierra. En verdad, es una visión poco frecuente en este mundo mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010106,
					"content": "Así que se me ocurrió que, si pudiera ver esos meteoritos de cerca, podría encontrar un poco de inspiración y poder encauzar mi torrente de ideas para los siguientes versos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010107,
					"content": "N-no creo que sea adecuado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "¿Que no es adecuado? ¿Con base en qué lo dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 2250102,
			"completionStepIds": [
				2250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"3"
						],
						"stepId": 2250101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"2"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "¿A qué se refiere usted con “no adecuado”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010202,
					"content": "Esos meteoritos te noquearán con solo tocarlos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "Oh, he escuchado rumores al respecto, pero no hay perjuicio alguno si uno fuera a verlos guardando la distancia, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010204,
					"content": "¿Prometes que no los tocarás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "D-de acuerdo... contendré mis impulsos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 2250103,
			"completionStepIds": [
				2250103
