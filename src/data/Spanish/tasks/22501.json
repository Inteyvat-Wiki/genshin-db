				{
					"id": 225010501,
					"content": "Hay monstruos cerca de los meteoritos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010502
					]
				},
				{
					"id": 225010502,
					"content": "¡Jaja! Ciertamente. Yo también he recorrido las cuatro direcciones de Liyue, y tenido encuentros con bestias feroces. Si el camino fuese peligroso, una escolta debe ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
