			"dialogs": [
				{
					"id": 225010401,
					"content": "¿No puedes escribir poemas estando aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010402
					]
				},
				{
					"id": 225010402,
					"content": "Me temo que no es posible. Si viviese enclaustrado en la comodidad de mi hogar, ¿qué cosa fuera sino un traidor de los aplausos, o un servidor de pasado en copa nueva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
