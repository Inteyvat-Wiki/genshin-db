				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010601,
					"content": "No todo lo que escribes tiene que ser impactante, ¿sabes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010602
					]
				},
				{
					"id": 225010602,
					"content": "Hay un poco de verdad en lo que dices. Los versos más bellos son producto de la inspiración divina o manos hábiles que son guiadas por un hado extraño. Aun así, este verso me ha traído desasosiego por mucho tiempo. Debo continuarlo a como dé lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
