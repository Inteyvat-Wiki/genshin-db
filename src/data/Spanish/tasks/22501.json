					"nextDialogs": [
						225011405
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225011405,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011406
					]
				},
				{
					"id": 225011406,
