					"content": "¿Estás seguro que puedes asumir el riesgo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010902
					]
				},
				{
					"id": 225010902,
					"content": "Naturalmente, llevaré una escolta conmigo, por si acaso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010903
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010903,
					"content": "Es un poco difícil encontrar escoltas estos días.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010904
					]
				},
				{
					"id": 225010904,
					"content": "Tiene usted razón, ciertamente es un dilema que no había tomado en cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
