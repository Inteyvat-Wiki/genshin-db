					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011201,
					"content": "He rumiado lo que usted dijo por mucho tiempo, y tiene razón en preocuparse por mí. No debería arriesgarme más de la cuenta al buscar esos meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225011202,
					"content": "Bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "Además, un golpe de inspiración no garantiza buena poesía. La grandeza de un poeta se ve en los detalles más pequeños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225011204,
					"content": "También podemos escribir un buen verso sobre objetos mundanos, como una flor, pero hay un sinfín de poemas que elogian a la flora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225011205,
					"content": "#Dicen que la gente de fuera puede ver mejor lo que ocurre, ¿cierto? Entonces, viajer{F#a}{M#o}, ¿de qué tipo de flor cree que deba componer mi poema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 2250113,
