			},
			"dialogs": [
				{
					"id": 225010301,
					"content": "Hay mejores formas de ver los meteoritos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010302
					]
				},
				{
					"id": 225010302,
					"content": "¿Mejores formas? Oh, posiblemente tenga razón. Si solo contemplase la flama, pero ignorase aquello a su alrededor, sería un poco descuidado de mi parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 2250104,
