					"nextDialogs": [
						225011002
					]
				},
				{
					"id": 225011002,
					"content": "¡Jaja! No pretendo fanfarronear si digo que yo, Chingzhou, quizás carezca de talento, pero aun así he escrito muchos versos populares. No se preocupe por mí.",
					"roleType": "TALK_ROLE_NPC",
