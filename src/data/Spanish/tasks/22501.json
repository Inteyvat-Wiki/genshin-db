			"dialogs": [
				{
					"id": 225010801,
					"content": "Pero, si llegaras a perder el conocimiento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010802
					]
				},
				{
					"id": 225010802,
					"content": "No se preocupe por eso, tendré el mayor de los cuidados. Si los meteoritos me indujeran a un letargo, me pregunto, ¿con qué soñará la gente que está inconsciente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010803
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 225010803,
					"content": "Ciertamente, es intrigante... *Ejem*, es mera especulación. No se preocupe, yo no me expondría al peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
