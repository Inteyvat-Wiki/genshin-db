			"dialogs": [
				{
					"id": 411410101,
					"content": "Yo lo entregaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411410102
					]
				},
				{
					"id": 411410102,
					"content": "Sí, date prisa, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410103
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411410103,
					"content": "Y, por favor, <color=#00E1FFFF>evita a los monstruos a toda costa. Si te afectan con un elemento o te golpean, la comida se echará a perder</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410104
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411410104,
					"content": "Si eso pasa, el cliente no la aceptará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410105
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411410105,
					"content": "Bien, date prisa. No hagas esperar mucho al cliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
