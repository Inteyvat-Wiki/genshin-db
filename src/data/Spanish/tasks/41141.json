			"dialogs": [
				{
					"id": 411410301,
					"content": "Escuché que alguien hizo un pedido especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411410302
					]
				},
				{
					"id": 411410302,
					"content": "¡Hum! Está bien... Una huésped llamada Linguan se alojó aquí. Pidió una ración de tofu de almendras hace un rato y, después de pagar, dijo que quería que se la llevasen al norte del Pantano Dihua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410303
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 411410303,
					"content": "Estamos muy ocupados en la posada y no tengo tiempo para entregar la comida yo mismo. Si pudieras ayudarme, te lo agradecería. Te lo compensaré justamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
