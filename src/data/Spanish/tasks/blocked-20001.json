			"dialogs": [
				{
					"id": 200010901,
					"content": "Gracias por ahuyentar a esos sujetos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010902,
					"content": "Gracias a Los Siete que viniste. *Suspira*, pero estoy atrapado aquí mientras este obstáculo siga en pie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010903,
					"content": "Si esto sigue así por más tiempo, toda la fruta se irá a la basura... Después de pasar tanto tiempo recogiéndola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010904,
					"content": "¿Puedes hacerte cargo del obstáculo por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010905,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "Maravilloso. ¡No puedo agradecerles lo suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010906,
					"content": "#Lo siento, estoy un poco ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "¿Oh, en serio? Pensé que si ayudas a alguien, lo haces hasta el final... En fin, eres la única esperanza que tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
