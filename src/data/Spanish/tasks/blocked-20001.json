			"dialogs": [
				{
					"id": 200011001,
					"content": "#Muchas gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011002,
					"content": "Mi plan era recoger fruta aquí y luego venderla en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011003,
					"content": "No contaba con que me detuviera un obstáculo en el camino... y luego ellos me tendieron una trampa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011004,
					"content": "Bien, voy a volver a la ciudad de Mondstadt. ¡Pasa por la tienda si alguna vez estás en la ciudad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011005,
					"content": "Toma esto como agradecimiento. Siempre encontrarás fruta fresca conmigo, ¡incluso Beatrix viene a molestarme todos los días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
