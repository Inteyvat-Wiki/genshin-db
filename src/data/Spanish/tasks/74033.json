			"dialogs": [
				{
					"id": 740330101,
					"content": "Desde que cerraron el túnel de geoda, aquí casi no viene nadie. Los dispositivos que hay aquí tampoco están hechos para gente inexperta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "Como ocurrió esta vez con una persona que movió la válvula de accionamiento cuando no debía y encerró sin querer a su compañero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "En fin, usemos primero la válvula para abrir paso hacia el <color=#00E1FFFF>depósito de reservas n.º 1</color>. Si luego les invitan a beber algo, será mejor que lo rechacen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "¿Quién invita? ¿Y por qué lo íbamos a rechazar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Ya lo verás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
			"id": 7403304,
			"completionStepIds": [
				7403304
