			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Preservadora de Nubes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "Me pregunto si este dispositivo podrá hacer postres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010102,
					"content": "¿Qué vas a hacer esta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "#Llegas justo a tiempo, viajer{F#a}{M#o}. Acabo de decidir qué haré a continuación: un “pudín”, así lo llaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010104,
					"content": "Tuve que consultar muchas recetas populares últimamente para decidirme a hacer este pudín. Dicen que es suave y sabroso, ideal para un postre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010105,
					"content": "También he hecho algunos cambios y mejoras a la receta original...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010106,
					"content": "... Y he añadido arroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010107,
					"content": "Por supuesto, debo ponerle un nombre a este nuevo plato. Se llamará “pudín de arroz”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010108,
					"content": "Suena a que será muy satisfactorio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "La calidad del arroz es muy importante en este plato. Tras activar la cocinadora mecánica suprema, le ordené que buscara arroz de buena calidad. La búsqueda me trajo hasta aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010110,
					"content": "#Viajer{F#a}{M#o}, ya que estás aquí, ¿me ayudarás a recolectar el arroz? La cocinadora indica que debe estar por aquí cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010111,
					"content": "¿Otra vez yo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "Tengo que estar vigilando la cocinadora, y no puedo estar en dos sitios a la vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010114,
					"content": "#Como tú eres inteligente y habilidos{F#a}{M#o}, eres {F#una}{M#un} ayudante perfect{F#a}{M#o}. Hazme este favor, y te daré pudín de arroz también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010115,
					"content": "Bien. Pongo este encargo en tus cuidadosas manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010116,
					"content": "Cocinadora mecánica suprema... ¡actívate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010117,
					"content": "#Viajer{F#a}{M#o}, ya he activado la cocinadora. Sigue el rastro que ha creado y vuelve con el arroz que necesito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 705010112,
					"content": "Pero si tú puedes volar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "¡Muchas gracias! ¡Me salvaron la vida! Soy Brunn, un comerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010202,
					"content": "*Suspira*, qué mala suerte. Solo estaba transportando unas mercancías...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010203,
					"content": "Pero no pensé que los monstruos me atacarían a mitad de camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010204,
					"content": "Empecé a correr, no tenía tiempo para preocuparme por los productos o para saber hacia dónde me dirigía... Así que, al final, acabé aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010205,
					"content": "Al llegar aquí pensé que ya me los había quitado de encima. Por eso quise bajarme y revisar la mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010206,
					"content": "Pero volvieron a aparecer de repente... Gracias por su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010207,
					"content": "¿Qué mercancías estás transportando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "Llevo una carga de ingredientes, arroz y cosas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010209,
					"content": "Parece que este es el arroz que la Adeptus quería, pero no queda mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705010210,
					"content": "¿Puedes vendernos un poco de arroz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "¿Quieren comprar arroz? No es que no quiera venderlo, pero... la mayoría de las cosas se cayeron del carro mientras escapaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010212,
					"content": "Esos monstruos deben habérselas llevado a su campamento como botín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010213,
					"content": "¡Qué lío! ¿Cómo recuperaré esos productos? Si no lo consigo, perderé muchísimo dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010214,
					"content": "#Viajer{F#a}{M#o}, veo que eres muy hábil. ¿Puedes ayudarme a recuperarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010215,
					"content": "Si me ayudas, ¡te daré todo el arroz que quieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010216,
					"content": "Yo me encargaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "¡Muchísimas gracias! Entonces, cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010220,
					"content": "Llévate mi globo de transporte y coloca las mercancías en él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010221,
					"content": "#Lo dejo en tus manos, viajer{F#a}{M#o}. Te estaré esperando aquí. Cuando tengas las mercancías, tráelas de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010218,
					"content": "No creo que pueda cargar con tantas cosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "No pasa nada, tengo una solución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050107",
							"2"
						],
						"stepId": 7050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "¿Trajiste las mercancías? ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010302,
					"content": "Querías arroz, ¿verdad? Espera un momento, escogeré el de mejor calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010303
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010303,
					"content": "¡Ya está! Este arroz es para ti, debe ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010304
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010304,
					"content": "#Gracias de nuevo, viajer{F#a}{M#o}. Me pondré en camino otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010305
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010305,
					"content": "Espero no encontrarme con más monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				}
			]
		},
