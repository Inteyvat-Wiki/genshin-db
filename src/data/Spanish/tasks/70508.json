			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ninguang",
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080203,
					"content": "¿Y bien? ¿Qu-qué tal está? ¡Este silencio está poniendo nerviosa a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080204,
					"content": "Mmm... el agridulce sabor de la nostalgia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080205,
					"content": "¿Os referís al sabor de pasar de ser una andrajosa a ser una niña rica? Pardiez, no sabía que eso era un sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080206,
					"content": "Jeje. Es principalmente agrio, con un toque dulce y que te deja un agradable regusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080207,
					"content": "Qué interesante... ¿Es como el sabor de empezar un pequeño negocio para luego descubrir que vender fruta no os va a sacar de pobre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080208,
					"content": "No hace falta que entres en los detalles. El pasado es el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080209,
					"content": "¡Jaja! ¿Quién habría imaginado que el “noble” Equilibrio Celestial fue una frutera callejera en el pasado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080210,
					"content": "Aunque, por otro lado, supongo que muy pocos saben que yo vengo de un modesto pueblo pesquero, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080211,
					"content": "No necesariamente. En mi opinión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080212,
					"content": "... Diría que la Capitana Beidou tiene una mirada capaz de perforar el océano. Eres una pionera que va en busca de la aventura y eres capaz de domar el viento y las olas. Son claras señales de alguien que creció en el mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080213,
					"content": "Eh, no estaréis burlándoos de mí, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080214,
					"content": "Vamos, no serviría de nada ser sarcástica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080215,
					"content": "Sé lo mordaz que podéis ser con vuestras palabras. Hoy invito yo, conque recordad no pasaros de la raya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080216,
					"content": "Muy bien, entonces me gustaría tomar un par de copas más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080217,
					"content": "¿Otra copa para la señorita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "¡A su servicio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "#¡Ya oíste a la señorita, cantiner{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080220,
					"content": "¡Esto va viento en popa! ¡Otra ronda para mí también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080234,
					"content": "Rellenas las copas de ambas...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "El jugo de frutas de Mondstadt es difícil de superar. Ojalá pudiera tomarlo todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080222,
					"content": "Que me aspen, ¿habláis en serio? No me digáis que vais a abrir una ruta de venta de solsettias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080223,
					"content": "Humm, es una propuesta interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080224,
					"content": "¿Lo decís en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080225,
					"content": "Solo bromeaba. Ya hay toda una industria para eso, no necesitan que yo me inmiscuya en sus negocios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080226,
					"content": "#Gracias por las bebidas de hoy, viajer{F#a}{M#o}. Si alguna vez buscas un trabajo cómodo, me encantaría tenerte como mi cantiner{F#a}{M#o} privad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080227,
					"content": "#También sois bienvenid{F#a}{M#o} al Alcor. A la tripulación le encanta beber, así que podríais venir a disfrutar de un banquete. Os aseguro que os divertiréis mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080228,
					"content": "#Capitana Beidou, ¿estás compitiendo contra mí para cazar talentos? Ahórrate las molestias. Puedes venir a la Cámara de Jade cuando quieras para que {F#la viajera}{M#el viajero} te prepare una bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080229,
					"content": "(Qué popular soy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "¿Es imaginación de Paimon o eso sonó como si fueras de su propiedad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080231,
					"content": "Cuando pueda, iré a visitarlas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "No se preocupen, seguro que las visitaré a las dos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}