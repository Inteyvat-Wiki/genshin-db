			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Ninguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#¡Ah del barco! {NICKNAME}, llegáis justo a tiempo, ¿queréis echar un trago con nosotras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080102,
					"content": "#Viajer{F#a}{M#o}, qué grata sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080103,
					"content": "¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "Un momento, ¿vinieron juntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080105,
					"content": "Ninguang decidió de manera improvisada que quería unas vacaciones, así que acabamos viajando por estos lares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080106,
					"content": "Supongo que tenemos una idea distinta de lo que son las vacaciones. Apenas hemos subido unas pocas montañas antes de poner pie aquí. Niña mimada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080107,
					"content": "Vamos, no hay por qué herir los sentimientos de los demás. Además, escogí este lugar precisamente porque sé lo mucho que te gusta beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080108,
					"content": "La Capitana ha visto mucho mundo, por eso no está tan emocionada con esta pequeña taberna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080109,
					"content": "Bah, me sirve. Bueno, a esta invito yo, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080110,
					"content": "#¿Beidou invita? Ehmm, ¿eso nos incluye a nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080111,
					"content": "#Creo que nosotr{F#as}{M#os} somos {F#las cantineras}{M#los cantineros}, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "Ah, cierto. Jeje, Paimon lo siente... Es la costumbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080113,
					"content": "¿Qué desean tomar, distinguidas clientas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "Para mí una copa pequeña de Savia de abedul, con un ligero toque agrio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 705080115,
					"content": "Una copa grande de Crepúsculo, por favor. ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080116,
					"content": "¡Entendido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
			"completionStepIds": [
				7050804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
