			"dialogs": [
				{
					"id": 747060101,
					"content": "... ¿Y este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747060102,
					"content": "Sigo sintiendo que le falta algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "¿Colombina? ¿Furina? ¿Qué están haciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "La directora Furina y yo estamos... ¿decidiendo el elenco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747060105,
					"content": "¡Qué manera tan maravillosa de decirlo! Pero los “actores” que estamos buscando... ¡resulta que son peces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "¿Los peces pueden actuar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Ya no es tan raro ver animales actores hoy en día. Queremos seleccionar a un pececito carismático con la actitud necesaria que aparezca de fondo para crear cierta atmósfera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Pero creo que ya hemos visto todos los peces del acuario y ninguno encaja con lo que buscamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#¿Deberíamos pedirles ayuda a {NICKNAME} y a Paimon? A ell{F#a}{M#o}s se les da muy bien resolver problemas complicados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747060110,
					"content": "#A Paimon le alegra que tengan tanta fe en nosotr{F#a}{M#o}s, pero... el asunto del elenco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "Tal vez podríamos encontrar más peces.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "¡Buena idea! Al fin y al cabo, ustedes son los que tienen experiencia gestionando acuarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "¿Estás diciendo que deberíamos buscar ese tipo de talento cuando salgamos a nadar? A Paimon no le parece mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "¡Trato hecho! Ya les explicaré después qué tipo de pez estamos buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "Entonces, ¿ahora son cazatalentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747060117,
					"content": "Desde que has empezado a pasar tiempo con Furina, has aprendido un montón de palabrerío del gremio, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Tal vez podríamos buscar a los candidatos bajo el agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
