			"dialogs": [
				{
					"id": 760440301,
					"content": "Solo queda una última cacería recompensada en el Buque Insignia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440302,
					"content": "#Parece que todo ha sido gracias a {NICKNAME}, pero ni siquiera {F#ella}{M#él} ha podido hacer algo con esta última.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760440303,
					"content": "Al fin y al cabo, no hay ninguna pista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440304,
					"content": "Aunque el hecho de que no haya nada escrito no significa que no exista información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440305,
					"content": "¿Averiguaste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760440306,
					"content": "Iré a preguntar a Leszek. Perteneciendo a la Cámara de Secretos, seguro que consigo algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440307,
					"content": "En ese caso, lo dejo en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760440308,
					"content": "Claro, ¡no se preocupe, jefa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
