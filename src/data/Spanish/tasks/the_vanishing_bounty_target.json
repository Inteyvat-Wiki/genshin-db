			"dialogs": [
				{
					"id": 760440101,
					"content": "Entre las cacerías del Buque Insignia hay una de lo más complicado que, encima, apenas tiene pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440102,
					"content": "Hace poco me enteré de que hirió a algunas personas en el norte de la Isla Lempo, pero ahora no hay ni rastro ni noticias de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440103,
					"content": "Todo el mundo deja un rastro tras de sí, e incluso si lo borrara, dejará uno nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760440104,
					"content": "Además, el hecho de que las pistas no estén por escrito no significa que no tengan la información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760440105,
					"content": "Tiene razón. Entonces, iré a preguntar a Leszek. Perteneciendo a la Cámara de Secretos, seguro que consigo algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440106,
					"content": "En ese caso, lo dejo en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760440107,
					"content": "Claro, ¡no se preocupe, jefa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
