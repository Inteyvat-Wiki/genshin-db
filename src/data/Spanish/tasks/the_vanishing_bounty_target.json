							10.74
						],
						"pointId": 146
					}
				]
			},
			"dialogs": [
				{
					"id": 760440201,
					"content": "La información sobre los objetivos con recompensa está en el tablón. Puedes preguntarme si quieres, pero las recompensas no son negociables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440202
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440202,
					"content": "¿Qué puedes contarme sobre los objetivos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440203,
					"content": "En el tablón hay cuatro objetivos, pero solo tres con pistas. El que está acusado de fraude y tiene recompensa puesta es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440204
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440204,
					"content": "¡Eh, eh! Puedes usar esa maniobra de distracción con los cazadores de tesoros novatos, pero ¿conmigo? Sabes perfectamente lo que quiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440205,
					"content": "¿La Cámara de Secretos se va a involucrar en ello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440206
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440206,
					"content": "Eso dependerá de lo que quiera la jefa. Un momento, ¿desde cuándo eres tú el que hace las preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440207,
					"content": "Bueno, Hark Mandibularrota sigue sin aparecer. ¿No será por lo ambiguas que son sus pistas? Mira, ni siquiera hay una descripción de su aspecto físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440208,
					"content": "Si un cazador de tesoros ni siquiera sabe eso, entonces no es rival para Hark, así que ¿por qué hacerles perder el tiempo? ¿Por qué hacer que den su vida en vano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440209
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440209,
					"content": "Bueno, entonces, ¿qué otro rasgo distintivo tiene aparte de la cicatriz de su barbilla? Y más te vale decirme algo que no sepa nadie más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440210,
					"content": "Algo que no sepa nadie más, ¿eh? Te refieres a... ¿la marca que tiene en la espalda, por ejemplo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440211
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440211,
					"content": "¡Sí, exacto! Ja, ¡así que de verdad tiene una marca! Pero espera, ¿tú cómo sabes eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440212
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440212,
					"content": "No lo sé, y tampoco sé si tiene una marca o no. Además, aunque la tuviera, ¿cómo piensas comprobarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440213
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440213,
					"content": "T-tienes razón... *Suspira*, ¿de verdad no tienes ninguna información exclusiva para mí? Vamos, ya nos conocemos desde hace tiempo, ¿no puedes darme nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440214,
					"content": "Tras revelar su verdadera naturaleza en la Villa Nasha, Hark huyó al norte de la Isla Lempo para seguir haciendo de las suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440215
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440215,
					"content": "Eso ya lo sabía, listillo. He oído cosas al respecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440216,
					"content": "Pero, espera, ¿no era que no se sabía nada de él? Si fue más al norte, podría ir a Piramida, pero Snezhnogrado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440217,
					"content": "(¿Podré soportar el frío de las llanuras nevadas?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440218,
					"content": "No, no, aún está en la Isla Lempo, solo que no sé dónde exactamente. Eso es información exclusiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440219
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440219,
					"content": "¿Y cómo estás tan seguro de ello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440220
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440220,
					"content": "Eso es secreto comercial. El precio por saberlo se deberá abonar aparte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440221
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440221,
					"content": "*Tch*, qué tacaño... *Suspira*, ¿un hombre fornido con una cicatriz en la barbilla? En la Isla Lempo tiras una piedra y salen diez de esos, ¿cómo quieres que lo encuentre solo con esa información?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440222
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440222,
					"content": "Como ya nos conocemos desde hace tiempo, te daré un consejo: no te fijes solamente en la cicatriz de la barbilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440223
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440223,
					"content": "¿Quieres decir que puede ocultarse la cicatriz a voluntad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440224,
					"content": "Ya veo... Se llama “Mandibularrota” por esa cicatriz suya tan característica, lo que significa que, si no la tuviera, sería idéntico a otros hombres fornidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440225,
					"content": "Visto así, solo tengo que encontrar a un hombre fornido que se esté tapando la barbilla... Supongo que es una pista nueva. Muy bien, volveré cuando haya hecho algún progreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440226
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440226,
					"content": "Entonces, quedo a la espera de tus noticias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
