				"points": []
			},
			"dialogs": [
				{
					"id": 730420601,
					"content": "#¡Nos divertimos mucho! ¡Arakanta se divirtió mucho jugando con {M#nara rubio}{F#nara rubia}! Además, ¡nara es tan rápid{F#a}{M#o} y fuerte que de verdad parece un caracal patilludo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "Es divertido jugar con otros aranara y con caracal patilludo, ¡pero es todavía más divertido jugar con nuevos amigos, con amigos nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "¿Por qué el caracal patilludo tiene que perseguir a los aranara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Caracal patilludo y aranara son amigos, y amigos juegan juntos. Pero Arakanta descubrió que nara temen a caracales patilludos. Así que Arakanta ideó nuevo juego para Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "#Gracias, nara. ¡Para nara rubi{F#a}{M#o}, flor de aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
