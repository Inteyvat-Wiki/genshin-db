			"dialogs": [
				{
					"id": 730420101,
					"content": "#Nara rubi{F#a}{M#o}, Arakanta escuchó muchas historias sobre {NICKNAME}. Eres {F#buena}{M#buen} nara. ¿Quieres jugar con Arakanta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "#¡El juego de Arakanta es simple y divertido! Nara {NICKNAME}, Arakanta te explicará reglas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "Arakanta creará muchas partículas Dendro, que serán aranara escondidos dentro de círculo. ¡Y nara será enorme y feroz caracal patilludo que persigue a aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "Si caracal patilludo consigue atrapar a aranara en poco tiempo, entonces, ¡nara habrá ganado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "#¿Y bien? ¿Nara {NICKNAME} está dispuest{F#a}{M#o} a jugar con Arakanta ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
