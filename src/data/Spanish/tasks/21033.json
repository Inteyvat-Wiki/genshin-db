			"dialogs": [
				{
					"id": 210330403,
					"content": "La empuñadura... parece intacta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "¿Será parte de la Cuchilla Oculta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Tengo que examinarla en detalle para estar segura. Por cierto, casi se me olvida pero... lo cierto es que llevo ya tiempo buscando fragmentos por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "En la ciudad, en la naturaleza, incluso he conseguido fragmentos de algunos aventureros... Pensé que así encontraría alguna pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Pero ni rastro de la Cuchilla Oculta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Bueno, no importa. Ya sabes lo que dicen en Liyue, “querer es poder”. Seguiré buscando hasta que la encuentre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "Ah, sí, aquí tienes el pago por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
