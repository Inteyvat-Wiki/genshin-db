			"dialogs": [
				{
					"id": 210330101,
					"content": "Espero que esto sirva de algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "¿Sigues buscando la espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "#¿Eh? ¡Ah, hola, viajer{F#a}{M#o}! Así es, sigo con la búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "Aunque, para ser sincera, no he encontrado ninguna pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Es lo que hay, supongo. Buscar una espada en Liyue es como buscar una aguja en un pajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Algunos dicen que la espada que busco fue destruida por un monstruo tiempo atrás. Pero aun así, al menos quedarían algunos fragmentos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "#Ah, perdona, estoy divagando. Te he marcado la localización en el mapa. Y una vez más, gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "Espero que la espada no esté rota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
