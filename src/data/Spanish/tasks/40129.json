					}
				]
			},
			"dialogs": [
				{
					"id": 401290901,
					"content": "¿Estas son las ruinas bajo el agua que encontró Fréminet? Aunque son bonitas, no son como Paimon se las había imaginado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "Recuerda que esto no son unas ruinas, ¡es el Reino de los Nixies!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Ah, sí, Paimon lo sabe, pero... se esperaba ver un mundo de fantasía como el de la historia. Ya sabes, las casitas multicolor de los nixies, el puente con forma de arcoíris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "Disculpen... Yo también pretendía colocar algunas decoraciones, pero no tuve tiempo para hacerlo todo yo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290905,
					"content": "¡No pasa nada! ¡Ya es momento de activar el modo fantasía!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "#¡Guaaau! {NICKNAME}, ¡qué rápido te metes en la historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#{NICKNAME} ya ha captado la esencia de todo esto. Ahora solo queda que Paimon se acostumbre también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290908,
					"content": "Hum, ni se les ocurra subestimar a Paimon. ¡Paimon también es capaz de hacerlo! Miren, ¡Paimon ya ha activado el modo fantasía también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "*Ejem*... ¡Jóvenes aventureros! Les habla Paimon, la diosa guardiana de este reino. ¡Expliquen el motivo por el que han irrumpido en estos lares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290911,
					"content": "Somos los compañeros del príncipe Thelxie, mi diosa. Vinimos a estas tierras para ayudarlo a recuperar su gloria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290912,
					"content": "Oh... ¡Conque se trata de recuperar su gloria! La diosa que tienen ante ustedes posee una gloria de oro, y de plata, y de bronce. ¿Cuál de ellas ha perdido el príncipe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290914,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290915,
					"content": "Pss... ¿Se te olvidó tu personaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "¡En absoluto! ¡Esta es una prueba de su diosa Paimon! Y ya he comprobado lo que necesitaba... Puedo percibir que ustedes no tienen ni una pizca de avariciosos, ¡son merecedores del respeto de los demás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Y por eso mismo, acepten la recompensa que su diosa les ofrece: ¡las glorias de oro, de plata y de bronce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "Y en cuanto al príncipe... ¡Su diosa le dotará de una gloria iridiscente adicional para que siempre abunde luz en su futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "¿-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290920,
					"content": "Gracias, diosa, por todas sus bendiciones. Siento cómo el poder crece a través de todo mi cuerpo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290921,
					"content": "Y-yo también... ¿Es esta la inspiración divina que mencionaron en la leyenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290922,
					"content": "Oh, diosa Paimon, ¡gracias por bendecirnos con tu inspiración!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Jeje, *ejem*... Aventureros, ¡ahora deberán derrotar a todas esas bestias que invadieron nuestro reino! ¡Les aseguro que aquí encontrarán aquello que tanto buscan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
