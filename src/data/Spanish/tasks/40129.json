			"dialogs": [
				{
					"id": 401290601,
					"content": "*Fiu*, ¡por fin se ha acabado! Ahora que ya derrotamos a esos terribles monstruos, ya podemos recuperar el Reino de los Nixies, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "Sí, y ya ha llegado el momento de asistir a la ceremonia de coronación de Thelxie... Lo único es que... yo pensé que nos llevaría más tiempo adentrarnos en las profundidades de las ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290603,
					"content": "Mea culpa, debí haberle pedido a Fréminet que se trajera una corona también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290604,
					"content": "#¡¿Has subestimado la fuerza de Paimon y {F#la diosa}{M#el dios} {NICKNAME}?! ¡Nosotr{F#a}{M#o}s podemos despejar ese nido de monstruos en un abrir y cerrar de ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "No pasa nada, Zuria. Podemos regresar cuando tenga la corona lista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290606,
					"content": "Les estoy muy agradecida a todos, y también a Thelxie, mi niño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290608,
					"content": "¡Paimon no se esperaba que Thelxie fuera tan bueno peleando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "Es como un verdadero príncipe, no hay obstáculo que pueda frenarle en su camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290610,
					"content": "Bien dicho, Fréminet, ¡yo también lo creo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290611,
					"content": "#Regresemos al campamento. {NICKNAME} tendrá que encargarse de obtener los materiales por el camino, pues tengo que acabar esa corona cuanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290612,
					"content": "¡Así podemos terminar de dibujar nuestro viaje y añadir la parte en la que recuperamos la corona del Reino de los Nixies! ¡«Las fantásticas aventuras de Thelxie» quedará actualizado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4012908,
