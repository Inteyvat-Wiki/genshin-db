			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "... *Suspira*, estoy más que listo para volver a la ciudad de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "#¡Oh, viajer{F#a}{M#o}! ¡Hola! ¿Puedo pedirte un favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Como podrás ver, soy parte de los Caballeros, y estoy de patrulla en este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Le dije a mi novia que le enviaría una carta pronto, solo para hacerle saber que estoy sano y salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "De repente me surgieron otros asuntos y lo olvidé por completo... ¿Podrías entregarle esta <color=#00E1FFFF>carta</color> por mí? Su nombre es <color=#00E1FFFF>Glory</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "Un momento... ¿Glory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "La chica ciega... La que recolecta semillas de diente de león...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "¡Ajá! ¡Tú debes ser Godwin! Glory nos habló de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "¿Qué? ¿Cómo conocen a Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "Ella nos pidió un favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "¿Dices que les pidió un favor? Espero que no haya sido nada peligroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Solamente nos pidió que le consiguiéramos algunas semillas de diente de león, eso es todo. Dijo que al soltarlas al viento, te transmitirían los deseos de su corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "Semillas de diente de león, ¿eh? Típico de Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Pero ella dijo que estabas en algún lugar lejos de Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Sí, bueno, ese era el plan... Déjame contártelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "¿Has oído hablar de la vez que el Gran Maestro dejó Mondstadt y se llevó a cuatro de cada cinco caballeros con él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "Pues bueno, yo fui uno de los asignados a esa expedición. Pero desafortunadamente, justo cuando nos estábamos preparando para partir, me di cuenta de que había perdido el recuerdo que Glory me dio. Cuando al fin lo encontré, ya se habían ido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "Todavía no sé cómo alcanzarlos, y mientras tanto he estado dando vueltas por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "No puedo volver a la ciudad de Mondstadt. No puedo imaginar lo que los Caballeros pensarían de mí si volviera con el rabo entre las piernas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "Además... Le prometí a Glory que le enviaría cartas y regalos de todo el mundo. ¡Dije que le mostraría el mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Si se enterara de que nunca salí de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "Claro, no quieres quedar en ridículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Por favor, envía esta <color=#00E1FFFF>carta</color> a <color=#00E1FFFF>Glory</color> por mí. Apuesto que está muy preocupada por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "#¡No puedo agradecerte lo suficiente, viajer{F#a}{M#o}! Pero te pido que guardes en secreto todo lo que acabo de decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "¿Por qué no probar la línea directa del diente de león?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Hay muchas cosas que quiero decirle a Glory, mucho más de lo que un puñado de semillas de diente de león podrían llevar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Gracias por llevarle mi carta. Y recuerda, ¡ni una palabra de esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
