			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370501,
					"content": "¿Entregaste mi carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370502,
					"content": "Glory envía sus mejores deseos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "¡Uf!... Al menos no está enojada conmigo después de ese largo silencio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370504,
					"content": "¿Cómo conoces el puerto de Liyue cuando has estado dando vueltas por Mondstadt todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370505,
					"content": "Ah, sí... Todas mis historias están basadas en cosas que el Gran Maestro me ha contado. Ha estado en todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370506,
					"content": "De todos modos, gracias de nuevo. Has sido de gran ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370507,
					"content": "Toma estas semillas de diente de león. Las elegí yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370508,
					"content": "La próxima vez que Glory te pida más semillas de diente de león, agradecería que la ayudaras de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		}
	]
}