					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Mira, puse varias capas de ropa en su interior para acolcharlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070204,
					"content": "Soy una erudita experta, ¿cómo podría cometer un error de principiante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070205,
					"content": "Bien, lo dejo en tus manos. No hay mucho que yo pueda hacer contra un grupo de monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
