			"dialogs": [
				{
					"id": 220070101,
					"content": "¿Dónde demonios estará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Esto fue lo que ocurrió: mientras estaba inspeccionando el exterior de las ruinas, unos monstruos me atacaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070104,
					"content": "En medio de la confusión, dejé caer la reliquia que había recuperado mientras escapaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070105,
					"content": "Regresé después de que esos monstruos se fueran, pero no encontré la reliquia por ningún lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070106,
					"content": "La he buscado todo el día, pero nada... ¿Quizás uno de esos monstruos se la llevó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070107,
					"content": "¿Puedes ayudarme a buscarla? Si la encuentras, guárdala en esta caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
