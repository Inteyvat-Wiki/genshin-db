				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Otro día tranquilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090102,
					"content": "Oh, están aquí. Neko durmió muy bien ayer, después de que limpiaran el santuario. Miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090103,
					"content": "Esos dos humanos verdes también vinieron ayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090104,
					"content": "Pero, aparte de ellos, ningún humano más vino a orar al santuario... Qué extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090105,
					"content": "No obstante, esos dos humanos verdes parecían bastante interesados en ese estante de madera de allí, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090106,
					"content": "Neko recuerda que Hibiki dijo que esos trozos pequeños de madera se llaman “placas de oración”, y el estante es el “estante de los deseos”. Parece que mucha gente viene al santuario por ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090107,
					"content": "Humm... ¿Eso quiere decir que a los humanos les gusta la madera? Muchos visitantes cuelgan trozos de madera en el estante después de ofrecer Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090108,
					"content": "Creo que no se trata de la madera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "¿Entonces por qué lo hacen? ¿Les gusta colgar cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090110,
					"content": "Tampoco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Bueno, sea como sea, el estante está roto y quedan muy pocos trozos de madera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090113,
					"content": "Neko no sabe para qué los quieren los humanos, pero el santuario debe tener estas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090114,
					"content": "Seguro que el motivo por el que nadie viene es porque el estante está roto y no quedan trozos de madera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090115,
					"content": "Por tanto, Neko tiene que pedirles que arreglen ese estante de madera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090116,
					"content": "#Nosotr{F#as}{M#os} nos encargaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Tenemos algunos materiales que nos sobraron tras reparar el baúl de ofrendas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "Neko no está segura... ¿Por qué les gusta tanto la madera a los humanos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090119,
					"content": "Eh... No importa, Paimon recuerda que aún nos quedan algunos materiales. Echemos un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "Sea como sea, Neko dejará que se ocupen de este asunto. Neko tiene que encargarse de muchas otras cosas en el santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090129,
					"content": "Cuando tanto el baúl como el estante estén reparados, el número de visitantes debería aumentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090121,
					"content": "¿Cuánto tiempo lleva el estante sin repararse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Mucho. Se rompió antes que el baúl, y el baúl llevaba siglos así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090123,
					"content": "Así que no tienes ni idea, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Jeje. Neko no lleva la cuenta de cuántas veces el sol sale o se pone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090125,
					"content": "Bueno, tenemos algunos materiales que nos sobraron tras reparar el baúl de ofrendas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090126,
					"content": "Neko no está segura... ¿Por qué les gusta tanto la madera a los humanos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090127,
					"content": "Eh... No importa, Paimon recuerda que aún nos quedan algunos materiales. Echemos un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090128,
					"content": "Sea como sea, Neko dejará que se ocupen de este asunto. Neko tiene que encargarse de muchas otras cosas en el santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090111,
					"content": "No importa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
