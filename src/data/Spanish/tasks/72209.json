				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "#Hola, viajer{F#a}{M#o}. ¿En qué puedo ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090402,
					"content": "El estante de los deseos ya está reparado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "¿Sí? ¿Lo reparaste tú? Qué buen corazón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090404,
					"content": "Me lo encargó la Suma Sacerdotisa suplente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "¿La señorita Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090406,
					"content": "¿Acaso se fijó en nuestros movimientos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090407,
					"content": "Algo así...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "Etsuko, ¡vamos a donde está el estante de los deseos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090410,
					"content": "Primero el baúl de ofrendas, ahora el estante de los deseos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090411,
					"content": "Esa Suma Sacerdotisa suplente se está tomando muy en serio lo de arreglar el santuario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090412,
					"content": "Pero todos los residentes de los alrededores emigraron hace tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090413,
					"content": "Para decirlo en pocas palabras, nadie más aparte de nosotros va a ir a orar al santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090414,
					"content": "¿Qué estás intentando decir, Etsuko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090415,
					"content": "¿Sabe eso la Suma Sacerdotisa suplente? ¿Por qué quiere reparar el santuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090416,
					"content": "No importa, estoy dando rienda suelta a mis sospechas. Vamos a donde el estante de los deseos, no hay problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
