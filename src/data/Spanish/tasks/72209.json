			"dialogs": [
				{
					"id": 722090201,
					"content": "Parece que ese estante lleva roto mucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "#Hola, viajer{F#a}{M#o}. Etsuko y yo estamos investigando los alrededores de este santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Aunque las instalaciones del santuario llevan mucho tiempo en ruinas, son muy completas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "Los habitantes de los pueblos de los alrededores deben haber venido aquí a orar. Supongo que el hecho de que esté en ruinas se debe al abandono del Pueblo Koseki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
