					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "¡Miau, miau! Ese estante de madera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090302,
					"content": "Ya está reparado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "¡Miauravilloso! Ahora el santuario se ve mucho mejor. ¡Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090304,
					"content": "Ahora vayan y díganles a esos dos humanos verdes que el estante está reparado y que ya pueden colgar trozos de madera en él. También pueden traer a más gente para que visiten el santuario y llenen el baúl de Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090305,
					"content": "¿Por qué no se lo dices tú misma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "¡No! Ese... ese humano alto y verde da mucho miedo. ¡Es capaz de leer la mente de los gatos! Neko no es rival para sus ojos perspicaces... ¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090307,
					"content": "Eso sin mencionar que se emociona demasiado cada vez que habla con Neko... Miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7220904,
