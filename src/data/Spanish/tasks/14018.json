			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "Creo que he dudado demasiado de mí misma. Será mejor que me anime para ser la presidenta que todos necesitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180902,
					"content": "Ahora que me pongo a recodarlo, me avergüenzo mucho de cómo actué antes. Jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180903,
					"content": "¿Qué te parece el regalo de la gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "Todo el mundo anhela algo que a los demás les parece trivial, pero que ellos mismos nunca podrán conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180905,
					"content": "En mi caso, ese algo es un retrato familiar. Es lo que más envidio de los demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180906,
					"content": "Nunca pensé que podría obtenerlo de esta forma. Supongo que tampoco soy tan desafortunada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180907,
					"content": "¿Qué podrías contarme sobre tu madre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "Justo antes estaba pensando que, si el único deseo de mi madre era que yo tuviera una vida feliz, entonces tenía unas expectativas muy altas... Me parecen tan difíciles de alcanzar como las de mi padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180909,
					"content": "A pesar de que tenían personalidades muy diferentes, ambos guardaban un profundo respeto el uno por el otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180910,
					"content": "El ferribús era un enorme proyecto pensado para el beneficios de toda Fontaine. Si hubieran pensado solo en el beneficio de la familia, habría sido una decisión demasiado egoísta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180911,
					"content": "Por eso mi madre nunca se opuso a mi padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180912,
					"content": "¿A qué vino eso de que si creo de corazón que eres mi socia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "Guau, ¡¿qué haces aprendiendo mis palabras de memoria?! No empieces con eso, ¡no, no! ¡Que me da mucha vergüenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180914,
					"content": "Olvídalo, ¡olvídalo! Ah, no, espera... Tampoco estaría bien que lo olvidaras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180915,
					"content": "Pero guárdalo bien guardado en tu corazón. ¡Y no lo vuelvas a mencionar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
	]
}