			"dialogs": [
				{
					"id": 230170301,
					"content": "¡Vaya! Con estas debería ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230170302,
					"content": "Por favor, acepta esta recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230170303,
					"content": "Oye, ¿por qué me miras así? Me estás poniendo nervioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230170304,
					"content": "*Ejem*, tengo mucho trabajo. Me voy ya...",
