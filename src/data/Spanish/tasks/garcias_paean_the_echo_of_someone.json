					"Kaia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "¿Eh? ¿Tienes alguna pregunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "¿Cómo conociste al Sr. García?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "#Qué pregunta tan directa. Típico de {F#una aventurera}{M#un aventurero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Conocí al Sr. García porque el director de la compañía en la que trabajo lo contrató para llevar las cuentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Jajaja, si te soy sincera, nunca había conocido a alguien que fuera tan diferente a los miembros del grupo de teatro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Nosotros tocamos música, bailamos, bebemos y cantamos, pero el Sr. García solo se dedica a hacer cálculos con Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Una vez vi que llevaba unos dibujos muy raros pintados en la ropa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "Me pareció muy curioso, así que le pregunté al respecto. Me dijo que eran los diseños de su máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "Dijo que se los había dibujado en la ropa para explicarle a alguien el funcionamiento. Por lo visto, no tenía papel a mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Usó un pedazo de carbón para dibujar los bocetos y poder explicárselo mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Su ropa mal lavada y su máquina suelen ser tema recurrente en nuestras conversaciones, así que la mayor parte del tiempo él habla y yo escucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "Jeje, es un poco raro, pero... también resulta encantador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
