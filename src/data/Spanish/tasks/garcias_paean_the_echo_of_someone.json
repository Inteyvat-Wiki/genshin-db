	"talks": [
		{
			"id": 2301701,
			"completionStepIds": [
				2301701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301701",
							"2"
						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. García",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "#¡Viajer{F#a}{M#o}! Llegas justo a tiempo. Kaia y yo acabamos de terminar de tomarnos un café y ya íbamos a ponernos a trabajar otra vez. Te presento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230170102,
					"content": "¿Esta es la persona de la que me hablaste? Mucho gusto, me llamo Kaia. Soy... Soy bailarina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Hola, el Sr. García me habló de ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Jeje, ¿ah, sí? Es bueno saberlo. Pensé que no hablaba de otra cosa que no fuera su querida máquina y su querido Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Puede excluirme de esto, señorita. Estoy seguro de que el Sr. García también se alegrará de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "De ninguna manera. Si no fuera por ti, el Sr. García no tendría ni un Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "En eso he de discrepar, Srta. Kaia. Estoy convencido de que el Sr. García ahorraría lo suficiente para al menos un par de cafés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "¡Para tres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230170110,
					"content": "Nunca dejará de sorprenderme la agilidad de su empatía, Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "#¡B-bueno, hablemos de lo que importa! Viajer{F#a}{M#o}, sigo buscando más insignias de las que llevan los Ladrones de Tesoros. Si encuentras algunas, podrías vendérmelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230170112,
					"content": "Últimamente he ganado algo de Mora, así que no te preocupes, te pagaré su precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				}
			]
		},
		{
