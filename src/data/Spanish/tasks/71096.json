			"dialogs": [
				{
					"id": 710960101,
					"content": "¿Encontraron las rocas ancestrales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960102,
					"content": "Aquí están.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "Tres más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960202,
					"content": "#Con mucha gratitud recibo estas rocas ancestrales de parte de dos ciudadan{F#as}{M#os} de vocación ciudadana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960203,
					"content": "No esperaba que encontraran tres de ellas tan rápido. Y son de mejor calidad que las que he visto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960204,
					"content": "*Suspira*... Me recuerdan a la roca antigua que yo tenía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960205,
					"content": "¿Tú tenías una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960206,
					"content": "#¿Entonces por qué nos haces buscar a nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "Me refería a una que TENÍA.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960209,
					"content": "Mi padre se encargó una vez de un lote de minerales en el Salón Shenglu. Entre los restos había una pequeña roca ancestral de baja calidad, así que me la regaló como juguete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960210,
					"content": "Por aquel entonces discutíamos todo el tiempo. Yo era un holgazán y, para empeorar las cosas, pasaba la mayor parte del tiempo en el Salón de Té Yanshang. Por eso, terminé con una gran deuda, y estaba desesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960211,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960212,
					"content": "Eso no suena nada bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "Bueno, ¿quién no ha hecho una o dos tonterías de joven? De todos modos, estaba perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960214,
					"content": "Alguien reconoció mi roca ancestral y me ofreció un buen precio. Una piedra a cambio de algo de Moras para salir del problema que me traía entre manos era un intercambio justo, en mi opinión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960215,
					"content": "Pero mi padre sacó el tema el otro día preguntando dónde había puesto la roca que me dio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960216,
					"content": "Todo lo que pude decirle fue: “Era solo una roca. Hace tiempo que la perdí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960217,
					"content": "Y, a pesar de todo, no pude evitar preguntarme qué habría pasado si no hubiera vendido la piedra. Habría podido mostrársela cuando la mencionó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960218,
					"content": "... Olvídalo. Ahora es inútil preguntarse qué habría pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960219,
					"content": "Al menos volvió el hijo pródigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960220,
					"content": "Tienes razón... Es solo que aún me queda mucho camino por recorrer para poder saldar mi deuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960221,
					"content": "Me fui por las ramas. Si encuentras más, por favor, tráemelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960222,
					"content": "¿Todavía no son suficientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "Dame tres más. Tres más deberían ser suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960225,
					"content": "Las rocas ancestrales son un mineral raro. Si el Salón Huishan quiere más, dudo mucho que pueda encontrarlas aquí en la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960223,
					"content": "¿Cuántas necesitas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "Vamos, primero entrega la tuya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}