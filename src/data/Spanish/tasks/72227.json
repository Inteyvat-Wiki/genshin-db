				"points": []
			},
			"dialogs": [
				{
					"id": 722270201,
					"content": "#¡Quiero crecer rápido y convertirme en un aventurero como tú, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
		{
			"id": 7222703,
			"completionStepIds": [
				7222705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7222705",
							"2"
						],
						"stepId": 7222705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "¡Terminamos aquí también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270302,
					"content": "¡Increíble! Así que eso es lo que puede hacer un verdadero aventurero, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270303,
					"content": "Bueno, antes han venido otros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270304,
					"content": "#¡Pero ninguno se compara con {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270305,
					"content": "¿Otros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270306,
					"content": "Sí, venían en busca de los maushiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270307,
					"content": "Será que Sumida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "Pero Paimon no entiende qué son exactamente los maushiro. Solo hemos oído que son un instrumento tradicional de aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270310,
					"content": "Sí, son cosas que emiten sonidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270311,
					"content": "Es difícil ver en esta niebla, así que usamos los maushiro para decir a los demás dónde estamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270312,
					"content": "Al fin y al cabo, ¡es mejor que gritar! Así no te duele la garganta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270313,
					"content": "Es cierto que no se ve nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270314,
					"content": "¿Verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270315,
					"content": "Papá... El Abuelo Mata dijo que los maushiro pueden ayudar a las almas de aquellos que se perdieron en la niebla a encontrar el camino de vuelta a casa, así que son muy importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270316,
					"content": "¿Eh? ¿Tan importantes son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270317,
					"content": "No me extraña que los necesiten en la ceremonia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "¡Estoy seguro de que les encantará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270319,
					"content": "¡Adelántense! Todavía quiero quedarme bajo el árbol por un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270320,
					"content": "¿Estarás bien? Podría haber monstruos por ahí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270321,
					"content": "No pasa nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270308,
					"content": "No es de extrañar que Katheryne lo haya considerado difícil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
