			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "El mercado está muy mal... Tal vez debería ahorrar más dinero para alquilar un puesto en la Villa Nasha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450113,
					"content": "¿Hay algo bueno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "Son pequeñas curiosidades que conseguí en Natlan, siéntete libre de echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450102,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "#¡Vaya, {F#una clienta}{M#un cliente}! Hola, me llamo Kuzmich, soy un comerciante itinerante de Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450104,
					"content": "Bueno, en realidad solo hago pequeños negocios en el camino para cubrir los gastos de mis viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450105,
					"content": "Sin embargo, cuando pasé por Natlan, la gente de allí era tan amable que me dejé llevar y... Ahora, si no vendo toda esta mercancía, ¡ni siquiera tendré dinero para el billete de regreso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450106,
					"content": "¿Vas a volver a Snezhnaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "Sí, en cuanto venda esta mercancía, compraré un billete de tren y regresaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450108,
					"content": "Allí no deja de nevar y está cubierto de hielo por todos lados, y lo único que se puede hacer es quedarse en la ciudad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450109,
					"content": "Sin embargo, después de pasar tanto tiempo afuera, extraño los días en que podía dormir un día entero en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450110,
					"content": "No creo que haya muchos negocios aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "Pero si quiero alquilar un puesto en la ciudad, tendré que pedir un préstamo al Banco del Reino del Norte, y dicen que la sucursal de la Villa Nasha no tiene muy buena reputación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450112,
					"content": "Bueno, al menos este lugar está bastante concurrido. Siempre y cuando la gente pase por aquí, la mercancía se venderá, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450115,
					"content": "Lo siento, tengo que irme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "Ay, ¿te vas? ¿No quieres echar un vistazo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614503",
							"2"
						],
						"stepId": 7614503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "¡Vaya! ¡No esperaba poder venderlo todo! Parece que tengo buen ojo para los negocios, después de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450302,
					"content": "A continuación, les pediré a los Lampareros que me guíen a través de la Ciénaga Sombrapesadilla. Después de eso, no debería haber más obstáculos en el camino hacia el norte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450303,
					"content": "Tal vez encuentre alguna oportunidad de negocio en el camino de regreso... Bueno, me despido por ahora. Nos volveremos a ver si el destino quiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "¡Qué coincidencia encontrarnos de nuevo! ¿Te gustaría comprar algo? Mi mercancía apenas se vende... Por favor, ayúdame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450407,
					"content": "Veamos qué tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "Son artículos típicos de la zona. No te preocupes, te daré el mejor precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450402,
					"content": "¿Por qué te reabasteciste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "Bueno... Supongo que los negocios son así. Siempre hay que aprovechar la ocasión, ¿no? Pues me encontré con una buena oportunidad en Piramida, había una mercancía que necesitaban vender con urgencia y me la dejaron a buen precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450404,
					"content": "En ese momento, me emocioné y olvidé que debía volver a casa. Lo compré todo, y como ves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450405,
					"content": "Ahora sabes por qué querían venderla con urgencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "Ay, no te burles de mí. ¿Te gustaría echar un vistazo? Tal vez haya algo que te pueda servir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450409,
					"content": "Lo siento, tengo que irme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "¿No quieres echar otro vistazo? ¡Seguro que hay algo que necesitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614506",
							"2"
						],
						"stepId": 7614506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "¡Genial! Por fin vendí toda la mercancía. La estrategia de vender bajando el precio fue la correcta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450602,
					"content": "Debería partir hacia Snezhnaya ahora, pero apenas he ganado lo suficiente para el viaje. Salí sin un Mora, y no quiero regresar así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450603,
					"content": "*Suspira*. Bueno, gracias por apoyar mi negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "¡Vaya, qué curioso es el destino! Mira con quién me encuentro. ¿Quieres echar un vistazo? Esta vez tengo muchas cosas buenas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450709,
					"content": "A ver qué tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "Oye, todo esto es equipamiento obsoleto de los Fatui. No lo podrás encontrar en ningún otro lugar, ¡así que toma lo que quieras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450702,
					"content": "¿No has vuelto a Snezhnaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "Para serte sincero, toda mi familia está en Novokitezhgrado y trabaja en las minas. Son más tercos que un domovói, y cuando les dije que quería salir a hacer negocios, se opusieron rotundamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450704,
					"content": "Así que antes de partir, me jacté de que volvería con una fortuna... No esperaba que, al final, apenas pudiera cubrir los gatos del viaje de regreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450705,
					"content": "Ya no tengo opción de ganar una fortuna, pero ojalá pueda ganar algo para no regresar con las manos vacías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450706,
					"content": "¿Qué haces en territorio Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "¿Qué insinúas? Soy un ciudadano ejemplar de Snezhnaya. Me siento como en casa cuando veo a los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450708,
					"content": "Todo lo que tengo aquí son piezas de equipamiento obsoletas de los Fatui. Me pidieron específicamente que me encargara de ellas. ¡No encontrarás algo así en ningún otro lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450711,
					"content": "No, gracias. Me voy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "Qué lástima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614509",
							"2"
						],
						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "¡Muchísimas gracias! Gracias a ti, no tendré que regresar con las manos vacías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450902,
					"content": "Esta vez me despido de verdad. Con tantas cosas que compraste, podemos considerarnos amigos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450903,
					"content": "Si alguna vez vas a Snezhnaya, ve a buscarme a Novokitezhgrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		}
	]
}