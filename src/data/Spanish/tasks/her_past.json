				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(¿Colombina no está aquí?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "¿Me buscaban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350103,
					"content": "¡Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Qué susto, Colombina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "Sentí tu presencia y quise ver si podía acercarme a ti desde detrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350107,
					"content": "Sí que tienes tiempo libre, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Oh, ¿eso les parece? Antes tampoco es que tuviera poco. Cuando estaba con los Fatui, apenas tenía nada que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350109,
					"content": "Lo único que necesitaba la Zarina era el poder de la Diosa Lunar. No me enviaron para robar una Gnosis ni nada de eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350110,
					"content": "¿Y qué solías hacer con tanto tiempo libre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Pasear, contemplar la luna, a veces cantar... Pero empecé a cantar menos desde que Sandrone me lo prohibió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350112,
					"content": "¿Eh? ¿No le gustaba cómo cantabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "No, no es eso. Me dijo que cantaba bien, pero como hacía poco que me había unido a los Fatui, mencionó que los demás se pondrían nerviosos si me escuchaban cantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350114,
					"content": "Según ella, era posible que quienes no estaban al tanto de la situación creyeran que estaba usando... un poder o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350115,
					"content": "Aaah, Paimon ya lo entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "También me dio otra razón: que, como ella se ponía a investigar de noche, si yo cantaba por el día, estaría interrumpiendo sus horas de sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350117,
					"content": "(¡Seguro que esa era la razón principal!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Así que, al final, acabé cantando solamente por la noche en la puerta de Sandrone, pero aun así, ella me seguía echando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "¿Te llevabas bien con los demás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "¿“Llevarse bien”?... Humm, cuando nos conocimos, Arlecchino parecía querer llevarse bien conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350122,
					"content": "Siempre aparecía detrás de mí sin que me diera cuenta, igual que yo he hecho antes. Creo que dijo que estaba... “poniéndome a prueba” o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350123,
					"content": "Intenté jugar a lo mismo con ella, pero siempre se giraba cuando yo aún estaba lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350124,
					"content": "La cosa siguió así hasta que, un día, no tuve más remedio que usar el kuuvahki para darle un susto desde detrás. Después de eso, dejó de jugar conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350125,
					"content": "(Paimon cree que Arlecchino nunca vio eso como un juego...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Dottore siempre me pedía ayuda para sus investigaciones sobre el poder del mundo de la luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350127,
					"content": "Al principio acepté, pero acabó siendo un aburrimiento. Que si “usa el kuuvahki para golpear esto”, “usa el kuuvahki para manejar esto otro”... Dejé de ayudarlo después de un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350128,
					"content": "Te veo de buen humor hoy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Bueno... Aunque tuve que abandonar mi hogar, también conservo recuerdos felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350131,
					"content": "Arlecchino y Sandrone siempre me han tratado muy bien, y también...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350133,
					"content": "(Esa cara... ¿Se ha acordado de alguien?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Dame la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350135,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Me he acordado de que Rosalyne... me enseñó a siempre darle las gracias a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350138,
					"content": "Gracias por haberme escuchado hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350139,
					"content": "No es nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Esto es... ¿la gracia de la Diosa Lunar?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Eso es todo por hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760350142,
					"content": "¡¿Tan de repente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Shh, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "Está bien, tienes razón. La dejaremos tranquila por hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Creo que está recordando el pasado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "¿Para qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Has hablado mucho del pasado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "¿Tenías que aparecer por la espalda?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}