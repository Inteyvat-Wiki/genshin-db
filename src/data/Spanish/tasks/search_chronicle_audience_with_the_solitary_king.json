			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "Al final hemos acabado aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820102,
					"content": "¿Y tu sueño de la infancia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "Ahora que soy adulto, he comprendido por fin por qué los guardas forestales pusieron esa cara en aquel momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820104,
					"content": "*Ejem*, no importa. ¡Al menos lo hemos intentado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820105,
					"content": "También he aprendido que no se debe traer un fruto de Regisvid Pyro sin procesar cerca de un Espantohongo Plumaverde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820106,
					"content": "Cuando empezó a percibir el olor a quemado, ya era demasiado tarde... Casi me ahoga con todas las esporas que soltó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820107,
					"content": "Muchas veces se me olvida que los Hongos son una especie completamente diferente a los micóqueros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820108,
					"content": "Oh, claro, los Hongos son seres fúngicos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820109,
					"content": "Eso es. Quedan bastante bien en la sopa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820110,
					"content": "En fin, volvamos al tema del objetivo de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820111,
					"content": "Aún no he pensado en cómo cocinarlos... ¡Ah! Te refieres a las interacciones. Perdón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820112,
					"content": "No sé si ustedes han oído la historia de los dos Engendros Fontamarinos soberanos. Dicha historia cuenta que el Corcel de Mar Perlamilenario es una criatura orgullosa y noble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820113,
					"content": "Por contraste, el Emperador Piroacorazado parece un personaje cruel. Poderoso, pero brutal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820114,
					"content": "Paimon pensaba que elegirías el desafío más difícil. Como antes dijiste que si ibas a contar una historia, el oponente tenía que ser digno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820115,
					"content": "El Emperador Piroacorazado es fuerte, sí, pero es solo un Cangrejo Acorazado... ¡El Corcel de Mar Perlamilenario es un caballito de mar capaz de volar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820116,
					"content": "Si un caballito de mar puede volar, ¿no debería llamarse caballito de cielo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "¿Eso es lo que te preocupa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820119,
					"content": "Si pudiera montarme en el Corcel de Mar Perlamilenario aunque solo fuera una vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820120,
					"content": "Está bien. Parece que quieres llegar al fondo de todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820121,
					"content": "#Ya que estamos aquí, no podemos irnos con las manos vacías. Si están preparad{F#a}{M#o}s, podemos ponernos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820122,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "Ahora no tengo tiempo, hasta luego.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "No hay problema. Aquí estaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820118,
					"content": "Para mí, los dos son lo mismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}