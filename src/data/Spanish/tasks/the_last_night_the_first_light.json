			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "¡Estamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "Me alegro de que hayan podido volver. ¿Cómo está la situación por el Barranco Kipumäki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Le explican brevemente lo ocurrido...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Tal y como pensaba... Incluso puede verse claramente desde aquí: el Pilar de Embla ha caído bajo el control del Abismo... y de ese demonio inmortal al que llaman “Profesor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Aun así, las cosas están tranquilas. Solo puedo suponer que la Srta. Alia sigue luchando para mantenerlos a raya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "Está resistiendo por nosotros. No podemos desaprovechar la oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "Gracias a Flins y los demás, los preparativos están casi completos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "Y ahora que has traído la Espada Espiral, la Flecha de Terpikeraunas está lista por fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Eh... ¿Qué es la “Flecha de Terpikeraunas”? ¿Es otra reliquia superpoderosa, como la Mecha de Plata y la Espada Espiral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Jaja, las supera a ambas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Hace quinientos años, el Forjador de Lámparas no tenía la fuerza suficiente como para derrotar al demonio inmortal, por lo que lo selló bajo el Barranco Kipumäki. Pero no vaciló en ningún momento. Junto con la primera Cantalunas, siguieron adelante con la esperanza de una victoria futura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Forjaron este arco y esta flecha con técnicas ancestrales, para que cuando llegara el día de acabar con el demonio inmortal, estuvieran listos. Desde entonces, las generaciones sucesivas de Lampareros los hemos protegido hasta el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Ahora, por fin ha llegado el momento de que cumplan su destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Guau... ¡Eso suena increíble! ¿Cómo son? ¿Podemos verlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "No digas tonterías, ya los han visto. De hecho, estamos en el interior de la Flecha de Terpikeraunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "N-No estarás pensando en dispararnos con eso... ¿verdad? ¡¿Verdad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Este gran salón de hidromiel fue construido para albergar la Flecha de Terpikeraunas. La Espada Espiral que recuperaron es la punta de la flecha que le faltaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Una vez que la Espada Espiral esté en su lugar, la Flecha de Terpikeraunas estará lista para ser disparada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "¡Pero esto es un horno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "Sí, es un horno, pero también sirve como mecanismo para dar forma a la Espada Espiral y convertirla en una punta de flecha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Debemos actuar antes de que eclosione el Huevo del Cataclismo. Hemos heredado este arco y esta flecha justo para este momento... ¡para ponerle fin a la amenaza de una vez por todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "Mientras preparas el tiro, es probable que ese demonio inmortal intente resistirse con uñas y dientes, pero haga lo que haga, nosotros lo detendremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "Dejo en sus manos la pesada carga del lanzamiento de la Flecha de Terpikeraunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "¿Van a dispararme junto con la flecha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#Entonces {NICKNAME} es nuestra arma definitiva... ¡No puede ser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
