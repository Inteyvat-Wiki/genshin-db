			"dialogs": [
				{
					"id": 761010201,
					"content": "¡Illuga! ¡Por fin! ¡El starshiná Nikita te ha estado buscando por todas partes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 761010202,
					"content": "¿Eh? ¿El starshiná... Nikita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#Un momento, {NICKNAME}, Nikita... ¿no era el anciano que nos pidió buscar la Mecha de Plata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010204,
					"content": "¿No dijo que no era más que un soldado ratnik normal y corriente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010205,
					"content": "Sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Ah, el viejo... *Suspira*, seguramente fue una broma de las suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010208,
					"content": "Ya hablaremos de eso después. Por ahora, vayamos a informarle de la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010206,
