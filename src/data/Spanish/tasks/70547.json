			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Valerina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "#Oh, ¡no me puedo creer que estén aquí {F#la salvadora}{M#el salvador} de gatitos y la encantadora de gatos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "¿Eh? ¿Qué acabas de llamarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "Me suenan esos nombres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Humm... ¿Nos conocemos de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "¡Jaja! ¡La encantadora de gatos todavía me recuerda! ¡Eres todo un éxito, Valerina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Ya habrá tiempo para ponernos al día. ¿Quieren probar el nuevo juego que he patrocinado? ¡Me tuvo feliz toda una semana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "¡Se llama “La explosiva contienda de los Dodocos”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "Guau, ¡cuántos Dodocos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "Todos me resultan familiares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "#Salvado{F#ra}{M#r} de gatitos... *Ejem*, quiero decir, ¡admirable y radiante Caballer{F#a}{M#o} Honorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "Este muñeco de Dodoco está inspirado en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#¡Es verdad! ¡La combinación de colores y estos pequeños detalles provienen de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "En el juego, el Dodoco Chispeante, el Dodoco Radiante, el Dodoco Caballero y el Dodoco Mágico deberán unir fuerzas y usar bombas para derrotar a enemigos nunca antes vistos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "Yo solo me encargo del patrocinio y la operación del juego, así que no conozco los detalles del desarrollo ni sé cómo son en realidad los enemigos en los que se basaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "Pero estoy segura de que, si algún día tuvieran que enfrentarlos en la vida real, ¡los Dodoco podrán vencerlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "¡Claro que sí! Ningún monstruo puede con Klee y sus compañeros Dodoco. ¡Estamos de acuerdo contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "¡Probémoslo a ver!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Jeje, estoy segura de que también les va a encantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "¡Un nuevo juego de Dodoco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Creo que ya veo en quién se inspiraron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Es la primera vez que lo escucho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}