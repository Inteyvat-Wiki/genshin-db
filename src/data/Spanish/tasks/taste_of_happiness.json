					"nextDialogs": [
						730390802
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390802,
					"content": "#Pero Arachatora no es bueno controlando fuego... Nara {NICKNAME}, ¿puedes venir a ver?",
