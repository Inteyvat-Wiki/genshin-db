			"dialogs": [
				{
					"id": 730391101,
					"content": "¡La sopa vegetariana de rábano está lista! ¡Los aranara ya deberían haber terminado también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7303912,
			"completionStepIds": [
				7303908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303908",
							"2"
						],
						"stepId": 7303908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapacati",
					"Arachatora",
					"Arasaka",
					"Arapas",
					"Arafala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#Sí, deben consultar con {NICKNAME}, si no, los platos les acabarán saliendo como antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391201,
					"content": "Enseñan a los aranara a preparar los platos según el método mejorado que pensó Paimon.\\nUna vez listos, los degustan juntos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "¿Cómo está? ¡Es una delicia nara auténtica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391203,
					"content": "#Humm... Aunque Arapacati propuso que nara {NICKNAME} guiara a sus hermanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391204,
					"content": "Esta comida nara es... ¿es sabor de felicidad para nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391205,
					"content": "Felicidad se escapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730391206,
					"content": "Está claro que agua de Vanarana es agua más rica... ¿Cómo puede haber salido algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730391207,
					"content": "Bueno, al menos maravillosas frutas frescas siguen igual de ricas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "Arafala"
				},
				{
					"id": 730391208,
					"content": "¿Eh? ¿Cómo? ¿Los aranara creen que sabe mal? Paimon cree que está riquísimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391209,
					"content": "Aunque Arapacati no sabe qué es “saber mal”... Esto, humm... tiene sabor “impactante”. Es como si corrieses demasiado rápido y chocases contra tronco de árbol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391210,
					"content": "¡Guau! Esto... Seguro que es un choque entre las culturas nara y aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391211,
					"content": "#Pero hermanos, ¡fueron muy groseros! Deberían estar agradecidos con nara {NICKNAME}. ¡Cómo pueden hablar así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391212,
					"content": "*Solloza*... Perdón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391213,
					"content": "¡No! ¡Tienes que decir gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391214,
					"content": "#Gracias, nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391215,
					"content": "#Pero... ¡importante es que nara {NICKNAME} y Paimon hayan disfrutado de comida! No hagan caso a ellos. Si nuestros amigos nara están contentos, nosotros también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391216,
					"content": "#Sin embargo, nara {NICKNAME} y nara Váruna son completamente diferentes. Entonces, nara Váruna nos habló mucho sobre su herman{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391217,
					"content": "#Pero nara {NICKNAME}, tú hablas muy poco. ¿No te encuentras bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391218,
					"content": "#Humm... {NICKNAME}, ¿por qué no dices algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391219,
					"content": "Gracias por preocuparte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "¿De verdad? Mejor así. Bueno, gracias a ustedes dos. Acepten estas flores, son regalo de Arapacati y sus hermanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391223,
					"content": "¡Arapacati espera que encuentren más sabor de felicidad en Vanarana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391220,
					"content": "(Permanecer en silencio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#... Bueno, ¡no te preocupes, Arapacati! ¡A {NICKNAME} no le pasa nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "Paimon"
				}
			]
		},
