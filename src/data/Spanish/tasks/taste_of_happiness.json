			"dialogs": [
				{
					"id": 730390101,
					"content": "Hermanos de Arapacati ya han reflexionado sobre su comportamiento. Festival Utsava son días de alegría, así que Arapacati no debería enfadarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Cierto. Arapacati, no te enfades. Son días de alegría, ¡así que no puede faltar sabor de felicidad cuando celebremos esta fiesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "Es momento de mostrar resultados después de practicar cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Ya está todo listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Arafala"
				},
				{
					"id": 730390105,
					"content": "¡Yuju! ¡El banquete del Festival Utsava! Paimon llevaba mucho tiempo esperándolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "¡Yuju! ¡El banquete del Festival Utsava!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Con agua más rica de Vanarana se prepara mejor sopa. Seguro que gusta a nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#Hermanos, si quieren ofrecer a nara {NICKNAME} y Paimon sabor de felicidad, deberían dejar que guíen a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "Solo así se pueden hacer platos que satisfagan a nara. Esa es “etiqueta” para recibir a “invitados”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Nara {NICKNAME}, ¿te importaría enseñar a ellos a cocinar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "Será mejor no tener unas expectativas muy altas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
