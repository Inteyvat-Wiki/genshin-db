			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101011001,
					"content": "#¿Oh? ¡Han vuelto! Ya les registré como {F#administradoras}{M#administradores} de la biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011002
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011002,
					"content": "¡Gracias, señorita Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011003,
					"content": "Um... Creo que estamos olvidando algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011004,
						101011005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011004,
					"content": "¡La «Guía de viaje de Teyvat»!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011007
					]
				},
				{
					"id": 101011007,
					"content": "Ese libro que está en el estante de allá... ¿no es la <color=#00E1FFFF>«Guía de viaje de Teyvat»</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011008,
					"content": "¡Y hay muchos ejemplares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011009,
					"content": "Jeje... De hecho, la <color=#00E1FFFF>«Guía de viaje de Teyvat»</color> es una revista periódica, no forma parte de la colección formal de la biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011010
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011010,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011011,
					"content": "Tomen una copia. Considérenlo como una recompensa por ser los ayudantes de Lisa el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011012
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011012,
					"content": "Su compañía hizo que mi trabajo fuera un poco menos tedioso de lo normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011013
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011013,
					"content": "¡Hum! ¡La «Guía de viaje de Teyvat» solo era un señuelo para hacernos trabajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011014,
					"content": "No pensé que algo tan rutinario nos llevaría tan lejos de la ciudad, y mucho menos a unas ruinas subterráneas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011015
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011015,
					"content": "Como compensación por las molestias, llévense estos recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011016
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011016,
					"content": "#¡Vaya! ¡Lisa compró algunos recuerdos para nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011017,
					"content": "Pensaba dártelos en nuestra próxima cita, pero... Ya discutiremos qué haremos la próxima vez cuando llegue el momento. ¡Espero que estés tan impaciente como yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011018
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011018,
					"content": "*Bosteza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011005,
					"content": "¡La recompensa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011006
					]
				},
				{
					"id": 101011006,
					"content": "#¡Qué {F#codiciosa}{M#codicioso} eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011007
					],
					"speakerTitle": "Lisa"
				}
			]
		},
