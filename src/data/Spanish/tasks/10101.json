				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "¿De verdad hay alguien que viva en las <color=#00E1FFFF>ruinas</color>? La gente de Mondstadt de verdad tiene hábitos muy extraños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010702,
					"content": "No juzgues tan a la ligera los hábitos hogareños de los ciudadanos de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010703,
					"content": "Es mucho más probable que sea obra de alborotadores poco amigables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010704,
					"content": "¿Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "Un Hilichurl no robaría un libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010706,
					"content": "Para ellos, la única función de un libro es como combustible para la hoguera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010712,
					"content": "Es más probable que sea la <color=#00E1FFFF>Orden del Abismo</color>. Después de todo, de alguna forma pueden escabullirse como fantasmas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010713,
					"content": "Además, la entrada tiene un sello elemental. Parece ser el resultado de la magia de un Mago del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010714,
					"content": "¿Un sello? ¿Cómo lo rompemos? ¿Crees que tome mucho tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010715,
					"content": "No se preocupen. Si creen que con un simple truco de magia pueden detenerme, ¡piénsenlo dos veces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010716,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010717,
					"content": "Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010718,
					"content": "Guau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010719,
					"content": "Así que esta es Lisa en acción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010707,
					"content": "¿La Orden del Abismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "¡Me leíste el pensamiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010709,
					"content": "¿El Gremio de Aventureros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "Puedo imaginarme al Gremio de Aventureros escarbando en las ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010711,
					"content": "Pero no creo que sean el tipo de personas que toman los objetos personales de otros... O al menos, no de los vivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "¡Es <color=#00E1FFFF>«La Princesa de las Nieves y los seis enanos»</color>! Recuerdo el nombre. Debe ser este libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010802,
					"content": "¡Ese es! Afortunadamente está intacto. De lo contrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010803,
					"content": "¿De lo contrario? ¿Hay algún castigo peor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010804,
					"content": "Jeje... Podría haberle hecho beber alguna de mis pociones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010805,
					"content": "¡Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010806,
					"content": "Pero bueno, este no es uno de los libros de la sección restringida, así que cualquiera puede pedirlo prestado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010807,
					"content": "Excepto por la marca que hice, no hay fluctuaciones elementales anormales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010808,
					"content": "Es cierto... se ve como un libro de cuentos de hadas común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010809,
					"content": "¿Por qué querría la Orden del Abismo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "(Todo esto me parece muy misterioso...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "Como bibliotecaria, hasta aquí concluyen mis responsabilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010812,
					"content": "Si tienes tanta curiosidad por este libro, ¿por qué no lo pides prestado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010813,
					"content": "¿Cuándo tengo que devolverlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "¡Por favor, no me castigues si lo devuelvo tarde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "#Para ti no hay fecha de devolución. En lugar de registrarte como {F#usuaria}{M#usuario}, te registraré como {F#administradora}{M#administrador} de la biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010816,
					"content": "#Son los beneficios de ser {F#una ciudadana}{M#un ciudadano} de fiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010817,
					"content": "¿Beneficios? A mí me parece más una manera de evitar responsabilidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010818,
					"content": "¿Perdón? ¿Tienes alguna queja sobre mi forma de trabajar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010819,
					"content": "¡No! ¡Para nada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010820
					]
				},
				{
					"id": 101010820,
					"content": "¡Atesoraré este libro como mi propia vida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010821
					]
				},
				{
					"id": 101010821,
					"content": "Bien. Eres una persona razonable. Cómo me gustaría que trabajaras a mi lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010822
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010822,
					"content": "Mi trabajo por hoy ha terminado. Con su permiso, me retiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010823
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010823,
					"content": "No olvides pasar por la biblioteca para registrarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
