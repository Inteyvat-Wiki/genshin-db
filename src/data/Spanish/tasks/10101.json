			},
			"dialogs": [
				{
					"id": 101011201,
					"content": "¿Cómo llegaron hasta aquí? Era el escondite perfecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011202
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011202,
					"content": "No me interesa dónde se escondan los Magos del Abismo. Solo quiero mi libro de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011203,
					"content": "Dime, ¿cómo tienes tiempo para ocultar tu guarida y sellarla, pero no puedes devolver un libro a tiempo, como se debe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011204,
					"content": "¡Qué falta de respeto al trabajo de otros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011205,
					"content": "¿Solo quieren... <color=#00E1FFFF>el libro</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011206
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011206,
					"content": "No pensé que en Mondstadt hubiera gente que comprendiera el secreto de este libro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011207
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011207,
					"content": "¿Quién demonios eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011208
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011208,
					"content": "La bibliotecaria de Mondstadt, aunque creo que a estas alturas es demasiado obvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011209,
					"content": "Devuelve el libro. Es mi última advertencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011210,
					"content": "¡Hum! Así que no piensas revelar tu verdadera identidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011211
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011211,
					"content": "En ese caso, me temo que no puedo devolverles el libro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011212
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011212,
					"content": "Ya que contiene “el secreto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011213
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011213,
					"content": "¡¿Eh?! Espera... ¿Qué estás haciendo? ¡Es demasiado poder elemental!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011214
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011214,
					"content": "¡AH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011215,
						101011216
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 101011215,
					"content": "¡Qué fuerte!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				},
				{
					"id": 101011217,
					"content": "¡Hum! Los chicos malos que no hacen lo que se les dice merecen un pequeño castigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011218,
						101011219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011218,
					"content": "Ni siquiera lo dejaste terminar de hablar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011220,
					"content": "A eso me refiero cuando digo que es un trabajo engorroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011221,
					"content": "Ahora tenemos que encontrar ese libro. Tiene que estar por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011219,
					"content": "No me parece que sea un “pequeño” castigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011216,
					"content": "¡Qué miedo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				}
			]
