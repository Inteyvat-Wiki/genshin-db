			"dialogs": [
				{
					"id": 721740701,
					"content": "Al niño que recolecta caracolas en la costa, ¡a bordo! Tu hermano dejó atrás las almas de sus antecesores para buscar un hogar más allá del mar. Olvídate de él, olvida el dolor de su partida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barquero"
