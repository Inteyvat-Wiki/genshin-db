			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barquero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "Del río el lado cercano, ¡je! El ciprés de plata pintado, ¡jo! El ajenjo plateado reposa en el suelo, las piedras argentadas reflejan el cielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740102,
					"content": "Disculpa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "#Oh... ¿{F#Una invitada}{M#Un invitado}? ¿Quiere subir a bordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740105,
					"content": "#Oh, veamos... Parecen foraster{F#as}{M#os}. No, así no puede ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740106,
					"content": "¿Perdón?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "La reluciente barca plateada navega suavemente hacia la luna, pero no está lista para ti, no. No abordes, pues mancharás la cubierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740109,
					"content": "Ah... La niebla ha estado dispersa por mucho tiempo. ¿Quién falta por embarcar? La dama de los pabellones dorados estará furiosa. Sí, muy furiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740110,
					"content": "¿Un barco? ¿Dónde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Jeje. Ah, la barca plateada, vástago del sol y la montaña. Todos deben regresar a casa, al recinto dorado sobre la luna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740112,
					"content": "Pero ¡oh, qué lástima! Algunos niños se extraviaron y no han abordado aún. La dama enfurecerá. Oh, sí, estará de lo más furiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740113,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "¡Sube a bordo, sube a bordo! No te desvíes de nuevo, no te apegues al pasado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721740114,
					"content": "¿Me escuchas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "¿De qué hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
