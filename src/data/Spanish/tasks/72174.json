			"dialogs": [
				{
					"id": 721741001,
					"content": "Todos están aquí. ¡Jojo! La tripulación está completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741002
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721741002,
					"content": "#Gracias, noble foraster{F#a}{M#o}. Al fin zarparemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741003
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721741003,
					"content": "En el extremo lejano del río, ¡ja! Hay un roble dorado, ¡jo! Un tapiz de artemisas doradas, rocas de oro yacen en el suelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741004
					],
					"speakerTitle": "Barquero"
				},
				{
					"id": 721741004,
					"content": "Paisajes de los más bellos hasta donde la vista alcanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barquero"
				}
			]
		},
