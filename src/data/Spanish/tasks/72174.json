			"dialogs": [
				{
					"id": 721740601,
					"content": "Aquellos que a lo nuevo y a lo viejo se quieren aferrar, a los pabellones áureos de la luna deben regresar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
