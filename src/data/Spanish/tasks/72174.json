			"dialogs": [
				{
					"id": 721740401,
					"content": "Oh, sí, hay otro que muy rápido ha crecido, pero aún tiene alma de niño... Solo quiere divertirse y jugar, pero se olvidó completamente de abordar...",
					"roleType": "TALK_ROLE_NPC",
