			"dialogs": [
				{
					"id": 721740501,
					"content": "La luna plateada y radiante, ¡ah! Los corazones plateados y relucientes, ¡oh! Protectores de aquellos perdidos en valles y crestas, los guían a través de la niebla en la floresta... ¡Todos a bordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barquero"
				}
			]
		},
