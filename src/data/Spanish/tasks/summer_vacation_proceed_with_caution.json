			},
			"dialogs": [
				{
					"id": 400110601,
					"content": "¡Tengan cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110602
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110602,
					"content": "¿Eh? ¿Es una persona muy, muy alta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110603,
					"content": "Parece humano, pero hay algo raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110604
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110604,
					"content": "¡Rey Dodo, te estoy viendo! Puedes, ehmm, arb... arbi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110605
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110605,
					"content": "¡Arbitrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110606,
					"content": "¡Eso es! ¡Puedes arbitrarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110607
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110607,
					"content": "¿Eh? ¿Qué está diciendo esta niña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110608,
					"content": "Claramente no entiende el significado de esa palabra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110609
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110609,
					"content": "¡Oye, Rey Dodo! ¿Por qué me ignoras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110610
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110610,
					"content": "¿Es porque tardé demasiado y te hice enojar? Entonces... ¡lo siento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110611
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110611,
					"content": "¿Y ahora se disculpa? Eso sí que no me lo esperaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110612
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110612,
					"content": "¡Hola! ¡Rey Dodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110613
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110613,
					"content": "Parece que no está interesado en Klee para nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110614
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110614,
					"content": "Es una especie de máquina humanoide. No reacciona... Debe estar rota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110615
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110615,
					"content": "¿La reconoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110616
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110616,
					"content": "No, es solo una hipótesis. No cuadra con el resto de la isla... Mira su ropa, parece que vino de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110617
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110617,
					"content": "¿Inazuma? ¿Pero eso no está muy lejos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110618,
					"content": "¿Entonces viene de fuera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110619
					]
				},
				{
					"id": 400110619,
					"content": "Eso parece. Esta zona del mar es independiente y no limita con ninguna nación, así que ciertamente está fuera de su hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110620
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110620,
					"content": "Pero dada la situación actual de Inazuma, ¿cómo podría ocurrir algo así?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110621
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110621,
					"content": "Una máquina abandonada... ¡Qué extraño! ¿Alguien la habrá traído hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110622,
					"content": "¡Oh, no! ¡El Rey Dodo ya no se mueve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110623,
					"content": "Klee, tal vez el Rey Dodo esté cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110624,
					"content": "Cierto, cierto, probablemente esté dormido. Te ha esperado muy pacientemente y entonces... *Bosteza*, ¡hora de la siesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110625,
					"content": "Vayamos con Klee a jugar a otro lado y regresemos una vez que el Rey Dodo despierte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110626,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110627,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110628,
					"content": "Humm... No, ¡ahora lo entiendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110629,
					"content": "Este no es el Rey Dodo. El verdadero Rey Dodo está en otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110630,
					"content": "¿Eh? ¿Eso crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110631,
					"content": "No me rendiré. Rey Dodo, ¡espera y verás! ¡Te encontraremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110632,
					"content": "Y ahí va de nuevo... Tiene mucha energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110633,
					"content": "¡Klee, espéranos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bárbara"
				}
			]
		},
		{
			"id": 4001107,
