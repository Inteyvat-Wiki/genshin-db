	"talks": [
		{
			"id": 4001101,
			"completionStepIds": [
				4001101
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001101",
							"2"
						],
						"stepId": 4001101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Jean",
					"Bárbara",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "Ah... El clima es tan agradable. Paimon cree que todo esto es un sueño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110102,
					"content": "¡Buenos días! ¡Guau! ¡¿Qué pasó con su ropa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110103,
					"content": "Jeje... ¿Cómo nos vemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110104,
					"content": "¡Es nuestra ropa de verano! No vinimos a divertirnos... ¡pero no podemos dejar pasar la playa y el mar en verano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110105,
					"content": "N-no se ve extraño, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110106,
					"content": "Una ropa tan elegante y ligera definitivamente no va conmigo... *Ejem*, lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110107,
					"content": "¡En absoluto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "#¿De verdad? Gracias, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110110,
					"content": "Pero es algo inesperado que la Maestra Jean haya preparado algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110111,
					"content": "Oh, no, mi hermana mayor nunca haría algo así por su cuenta. Lisa y yo lo elegimos por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110112,
					"content": "Decir “hermana mayor” y ni siquiera darse cuenta... ¡Bárbara ya está embriagada del espíritu veraniego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110113,
					"content": "Hay una larga historia detrás de esta ropa de verano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110114,
					"content": "Yo pensaba que la bolsa de Lisa era para casos de emergencias. ¡Quién hubiera pensado que contendría esta ropa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110115,
					"content": "Y luego están todos estos accesorios... Definitivamente es obra de Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110116,
					"content": "Los Caballeros de Favonius siempre me empujan a que me tome unos días libres. Supongo que me esfuerzo demasiado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110117,
					"content": "#¡Vengan tod{F#as}{M#os}! ¡Por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110118,
					"content": "¡Esa es la voz de Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110119,
					"content": "¡Hay algo raro aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110120,
					"content": "¿Eh? ¿Qué pasa? ¿A qué te refieres con “algo raro”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110121,
					"content": "¡Miren! ¡El océano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110122,
					"content": "¿Lo ven? ¡Hay algo extraño flotando en el agua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110123,
					"content": "Es un objeto delgado... Parece ser una boya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110124,
					"content": "Pero no vimos nada cuando llegamos aquí ayer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110125,
					"content": "¡Debe ser obra del Rey Dodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110126,
					"content": "Dispositivos extraños que aparecen de la noche a la mañana... Hay algo extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110127,
					"content": "Si no ha aparecido, ¿significa que cambió de opinión? O quizás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110128,
					"content": "¡Quizás estas boyas son una pista y está esperando a que yo lo encuentre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110129,
					"content": "¿Con qué intención habrán puesto estas boyas de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110130,
					"content": "Acerquémonos a ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "Tienes razón. No averiguaremos nada si nos quedamos en la orilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110132,
					"content": "¿Creen que podemos ir sin problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110133,
					"content": "Lo mejor sería acercarse a las boyas e inspeccionarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110134,
					"content": "#No sabemos qué nos espera en el mar, así que, por si acaso, estén preparad{F#as}{M#os} para una pelea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110135,
					"content": "#Cuando estén list{F#as}{M#os}, reunámonos aquí para dirigirnos al barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110136,
					"content": "¡Como era de esperarse de la Maestra Jean!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "P-para nada, solo cumplo con mi deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110139,
					"content": "Bien, dejo en sus manos los preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110137,
					"content": "Se puede confiar en ella incluso cuando lleva ropa de verano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "¡Te ves maravillosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001109",
							"2"
						],
						"stepId": 4001109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "¿Cuál es el significado de esas boyas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110202,
					"content": "¿Qué piensas de este archipiélago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "Estas islas están apartadas del mundo exterior, como un dominio secreto creado por la propia naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110204,
					"content": "La carta nos guio a este lugar y llegamos con la ayuda de Venti y Dvalin... Es demasiada coincidencia. No puedo evitar sentirme preocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110205,
					"content": "#Pero la razón por la que estoy aquí es para protegerl{F#as}{M#os} a tod{F#as}{M#os}. Sea lo que sea, me enfrentaré a ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110206,
					"content": "¿Qué te parece el vestido veraniego?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110207
					]
				},
				{
					"id": 400110207,
					"content": "Ah... ¿El vestido? E-es una sorpresa que Lisa preparó para mí. Supongo que fue idea de Bárbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110208,
					"content": "Bárbara no paraba de decir que no siempre podemos venir a la playa y que deberíamos ponernos ropa más veraniega para la ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110209,
					"content": "Es solo que no estoy acostumbrada a este estilo de ropa... *Suspira*, solo espero no verme muy extraña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
