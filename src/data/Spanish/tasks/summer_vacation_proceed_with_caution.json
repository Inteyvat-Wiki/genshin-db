					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110701,
					"content": "#¡Caballer{F#a}{M#o} Honorari{F#a}{M#o}, mira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110702
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110702,
					"content": "¿Eh? ¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110703,
					"content": "Mira estas piedras apiladas y estas flores pequeñas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110704,
					"content": "Es como un memorial para alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110705,
						400110706
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110705,
					"content": "Eres muy perspicaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				},
				{
					"id": 400110707,
					"content": "Oye, haces que me sonroje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110708
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110708,
					"content": "Pero lo único que hay alrededor es esa máquina con ropa de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110709,
					"content": "¿Quizás sea un memorial para la máquina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110710
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110710,
					"content": "Quizás llevó a cabo una hazaña digna de un homenaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110711
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110712
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110712,
					"content": "Hasta ahora, todo lo que hemos visto aquí indica que alguna vez hubo presencia humana en estas aguas. Aun así, no es suficiente como para poder inferir qué tipo de civilización fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110713,
					"content": "Además, todavía no hemos visto a otras personas o lápidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110714,
					"content": "Maestra Jean, ¿puedo ir allá a echar un vistazo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110715
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110715,
					"content": "Sí, ¡pero ten cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110716,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110717
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110717,
					"content": "¿Cuántos secretos esconden estas islas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110718
					]
				},
				{
					"id": 400110718,
					"content": "#Klee es demasiado joven para tener un sentido del peligro. Viajer{F#a}{M#o}, debemos estar alerta ante cualquier riesgo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110719
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110719,
					"content": "Honestamente, al principio pensé que esa carta era solo una broma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110720
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110720,
					"content": "#Nosotr{F#as}{M#os} también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110721,
					"content": "Yo también lo creí, pero ¿quién enviaría una carta de broma a una niña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110722
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110722,
					"content": "Una carta que nos conduce a un archipiélago desolado para activar mecanismos... Es muy extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110723
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110723,
					"content": "Hace que me pregunte si no es una especie de trampa que fue planeada con mucha anticipación. No podemos bajar la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110724
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110724,
					"content": "¡Señorita Bárbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110725
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110725,
					"content": "¿Qué pasa, Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110726
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110726,
					"content": "¿Crees que el Rey Dodo no quiere verme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110727
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110727,
					"content": "¿Por qué no querría verte, Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110728
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110728,
					"content": "Dodoco me ama, y yo amo a Dodoco, así que el Rey Dodo nunca podrá separarnos. Por eso el Rey Dodo no quiere vernos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110729
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110729,
					"content": "*Snif*, no quiero que nos separe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110730
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110730,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110731
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110731,
					"content": "Oye, Klee, ¿sabes qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110732
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110732,
					"content": "¡Es un Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110733
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110733,
					"content": "Escuché a mi hermana... que diga, a la Maestra Jean decir que siempre has querido jugar con un Harpastum, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110734
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110734,
					"content": "¡Sí! ¡Justamente estaba pensando en el Ludi Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110735
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110735,
					"content": "Hice este Harpastum especialmente para ti. Ahora todos los días pueden ser Ludi Harpastum, ¡jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110736
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110736,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110737
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110737,
					"content": "Qué bondadosa es la Diaconisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110738
					]
				},
				{
					"id": 400110738,
					"content": "¡Así que anímate, Klee! Cuando encontremos al Rey Dodo, te ayudaremos a convencerlo para que Dodoco y tú se queden juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110739
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110739,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110740
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110740,
					"content": "Redoblemos nuestros esfuerzos. Tenemos que encontrarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110741
					]
				},
				{
					"id": 400110741,
					"content": "¡Sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110742
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110742,
					"content": "#Déjanoslo a nosotr{F#as}{M#os}, Klee. Ese “Rey Bobo” no puede esconderse para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110743,
					"content": "Aunque nos tome mil años y lo tengamos que buscar en todos los rincones... Ehmm... ¡Lo encontraremos, sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110744,
					"content": "Mientras tanto, ¡echemos un vistazo a la zona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110706,
					"content": "¡Esa es la intuición de una Diaconisa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				}
			]
		},
