				"points": []
			},
			"dialogs": [
				{
					"id": 400110401,
					"content": "Humm, necesito traer bombas saltarinas, a Dodoco... ¡y a mí misma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110406,
						400110402
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110406,
					"content": "¿Alguna idea sobre las boyas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110407
					]
				},
				{
					"id": 400110407,
					"content": "¡El Rey Dodo debió colocarlas en el océano! ¡Es un tipo malo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110408
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110408,
					"content": "¡Pero me enfrentaré a él con valentía y haré lo que sea por Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110409,
					"content": "#Gracias por ayudarme, Caballer{F#a}{M#o} Honorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110402,
					"content": "¿Qué te parece el verano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110403
					]
				},
				{
					"id": 400110403,
					"content": "¡Me encanta el verano! Pero no solo el verano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110404
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110404,
					"content": "También me gusta el otoño. ¡Ah, sí, y me encantan la primavera y el invierno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110405
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110405,
					"content": "Aunque el invierno es muy frío, tengo mis bombas saltarinas. Si siento frío, solo hago estallar algo y listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 4001105,
