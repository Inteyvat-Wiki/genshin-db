			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Bárbara",
					"Klee",
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110501,
					"content": "¿Qué está pasando? ¡Esta parte del océano es demasiado misteriosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110502,
					"content": "¡La tierra surgió desde el agua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110503
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110503,
					"content": "¡Rey Dodo! ¡Rey Dodo! ¡Te atraparé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110504,
					"content": "Parece que Klee está llena de energía, como de costumbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110505,
					"content": "Antes de que el suelo comenzara a temblar, creo que oí el ruido de una maquinaria. Tal vez haya una inmensa estructura mecánica debajo de esta región del océano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110506
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110506,
					"content": "Si todo el archipiélago está situado sobre una estructura mecánica, pueden activarla para levantar cada isla de las profundidades del agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110507
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110507,
					"content": "Suena demasiado increíble... ¿Será el poder de Barbatos, el Arconte Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110508
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110508,
					"content": "Humm, es poco probable. Paimon tiene la sensación de que esto es algo preparado deliberadamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110509,
					"content": "Es increíble, lo mires como lo mires. Usar una carta para atraernos y desafiarnos con mecanismos así... Ese tal Rey Dodo no es un aficionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110510,
					"content": "Estoy de acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110511
					]
				},
				{
					"id": 400110511,
					"content": "Ay... Adiós a nuestro ambiente vacacional...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110512
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110513
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110513,
					"content": "Entonces haré todo lo posible para mantenerme en guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110514
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110514,
					"content": "¡Guau! ¡La Maestra Jean se ve impresionante cuando tiene tal determinación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110515,
					"content": "#Paimon y yo también seremos cuidados{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110516
					]
				},
				{
					"id": 400110516,
					"content": "Gracias por su comprensión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110517
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110517,
					"content": "¡Lo encontré! ¡Es el Rey Dodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110518,
					"content": "¡Está en esa isla! Jeje, ¡te encontré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110519
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110519,
					"content": "Querías que viniera a buscarte, ¡así que allá voy! Bombas saltarinas, ¡prepárense! ¡En marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110520
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110520,
					"content": "¿Eso es... <color=#00E1FFFF>una plataforma en medio del océano</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110521
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110521,
					"content": "Algo apareció. Podemos echar un vistazo más de cerca, pero estén alertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
