			"dialogs": [
				{
					"id": 400110301,
					"content": "¿Eh? ¿Hay algo en lo que pueda ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110302,
						400110306
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110302,
					"content": "¿Qué piensas de este archipiélago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110303
					]
				},
				{
					"id": 400110303,
					"content": "¡Solo puedo decir que el océano aquí es hermoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110304
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110304,
					"content": "Mar y sol, ¡es un sueño veraniego hecho realidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110305
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110305,
					"content": "¡Me encantaría dar un concierto frente al océano! ¡Sería genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110306,
					"content": "Sobre tu vestido veraniego...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110307
					]
				},
				{
					"id": 400110307,
					"content": "¿Qué te parece? Nada mal, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110308
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110308,
					"content": "Quería sorprender a todo el mundo, así que elegí esta ropa para combinar con la atmósfera de la isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110309
					],
					"speakerTitle": "Bárbara"
				},
				{
					"id": 400110309,
					"content": "¡Ah! ¡No se preocupen! Puede que sea ropa de verano, ¡pero pueden contar conmigo para lo que sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bárbara"
				}
			]
		},
		{
			"id": 4001104,
