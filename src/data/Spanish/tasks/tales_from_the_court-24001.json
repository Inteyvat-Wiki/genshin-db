			"dialogs": [
				{
					"id": 240010301,
					"content": "Mira, ahí está. Parece que está perfectamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "Me pregunto si la Srta. Staelle se dará cuenta algún día de que a los perros no le interesan ni las óperas ni las novelas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Volvamos, probablemente esté muy alterada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blathine"
