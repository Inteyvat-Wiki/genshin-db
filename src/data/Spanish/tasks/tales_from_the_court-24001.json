						],
						"pointId": 4419
					}
				]
			},
			"dialogs": [
				{
					"id": 240010101,
					"content": "¡Por favor, ayúdeme! ¡Estaba tan concentrada en la trama de la novela que no me he dado cuenta de que Barea no está!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010102,
					"content": "¿Está segura de que no está atado a su asiento en la Ópera? ¿O tal vez lo dejó en el baño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010103,
					"content": "Ya he buscado en todos esos sitios. Incluso he buscado debajo de las butacas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010104,
					"content": "Solo de pensar en que alguien ha podido llevarse a mi pequeño Barea. Tal vez se haya prendado otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010105,
					"content": "Srta. Staelle, estoy bastante segura de que Barea no cometería el mismo error por segunda vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010106,
					"content": "Pero es que es tan pequeño... Dicen que los bebés cometen los mismos errores una y otra vez. ¿Quién sabe? Puede que hasta se divierta con ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010107,
					"content": "Estoy bastante segura de que Barea no es tan pequeño como usted piensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010108,
					"content": "¿Quién es el tal Barea ese?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "Se trata del perro de la Srta. Staelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010111,
					"content": "Es mi familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010112,
					"content": "Sí, eso, su familia. Ha desaparecido, así que quiere que le ayude a encontrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010113,
					"content": "... Srta. Staelle, ya hemos registrado toda la zona. Me temo que Barea debe haberse escapado a la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010114,
					"content": "¡Pues vayamos a por él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010115,
					"content": "Me temo que tengo que pedirle que permanezca en la ciudad. Con esa falda, no sería capaz de atrapar a Barea incluso aunque lo encontrara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010116,
					"content": "¡Tonterías! ¡Estoy segura de que Barea saltaría a mis brazos sin pensarlo si me ve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010117,
					"content": "Entonces supongo que no nos ha debido escuchar mientras lo buscábamos por toda la Ópera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010118,
					"content": "Bueno, me temo que no podré ayudarle yo sola a recuperar a Barea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010119,
					"content": "No puedo abandonar mi puesto durante tanto tiempo, y tampoco podría pedirle a ninguno de mis compañeros que lo hiciera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010120,
					"content": "#Viajer{F#a}{M#o}, ¿te importaría echarnos una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010121,
					"content": "Sí, claro, sin problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "#Bien, problema resuelto. Vayamos a buscar a Barea junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010125,
					"content": "Teniendo en cuenta su peso y vitalidad, no creo que haya ido muy lejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010126,
					"content": "¡Barea es un cachorro de lo más sano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010127,
					"content": "Bueno, si se refiere a mentalmente sano, estoy totalmente de acuerdo con usted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010128,
					"content": "Deberíamos irnos ya. Si Barea se encariña demasiado con la naturaleza, a lo mejor se marcha más lejos incluso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010129,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010122,
					"content": "¿La policía también tiene que ocuparse de estos asuntos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "Si los ciudadanos de la Corte de Fontaine me piden ayuda, no veo motivo alguno para no prestársela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010109,
					"content": "¿Puedo ayudarlas en algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
