			"dialogs": [
				{
					"id": 240010501,
					"content": "¿Será que a Barea no le gusta mi nueva novela? *Suspira*, no lo entiendo, todos piensan que es muy buena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010502,
					"content": "Tal vez debería leerle un pasaje más entretenido la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
