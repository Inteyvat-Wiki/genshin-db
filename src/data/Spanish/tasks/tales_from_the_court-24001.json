			"dialogs": [
				{
					"id": 240010401,
					"content": "¡Barea! ¡Mi pequeño bebé! ¿Dónde te habías metido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Había buscado un lugar tranquilo donde tumbarse a descansar. Creo que necesitaba unas vacaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "¡Estaba tan preocupada! Muchísimas gracias, oficial Blathine. ¡Me aseguraré de incluirla en mi próxima novela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Se lo agradezco, pero sería mejor que se ahorrara la tinta. No creo que a nadie le interese el día a día de una policía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "Entonces tendré que darle un punto de dramatismo. ¡Ya verá, será de lo más interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Esa promesa es todo el drama que puedo soportar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "¡Aún tengo que pensar en un gran final! Veamos, ¿a quién debería ponerle de compañero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
		},
