			"dialogs": [
				{
					"id": 706570101,
					"content": "Hola, soy Lizz, de los Caballeros de Favonius. Creo que también debes haberte enterado de que, durante el Festival de las Flores de Viento, ¡Mondstadt organiza todo tipo de actividades divertidas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570102,
					"content": "Algo he oído...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "Mi trabajo es recibir a los visitantes que llegan a Mondstadt y asegurarme de que cada uno disfrute del festival por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570105,
					"content": "Como los lugares donde se llevan a cabo las actividades no están necesariamente en la ciudad, si no viene alguien a presentarlas, se perderían muchos juegos maravillosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570106,
					"content": "¡Ahora te quiero recomendar Tiro al blanco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570107,
					"content": "#Como su nombre indica, tienes que disparar a objetivos en el cielo. Si eres rápid{F#a}{M#o} y precis{F#a}{M#o}, ¡conseguirás una alta puntuación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570108,
					"content": "Suena muy interesante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "#No te preocupes. Marcaré la ubicación en tu mapa y, cuando vayas a probarlo tú mism{F#a}{M#o}, verás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570111,
					"content": "Hay premios de distinto valor según la puntuación que obtengas. Así que, aunque solo lo intentes o vayas por la máxima puntuación, ¡de todas formas te divertirás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570112,
					"content": "Ahora despertaste mi interés.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "Sí, está bien. ¡Primero ve a intentarlo! Si quieres saber sobre otras actividades, ¡ven a buscarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570115,
					"content": "¡Que te diviertas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570113,
					"content": "Gracias por tu explicación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "Parece un poco difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "Nunca había oído de eso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				}
			]
		}
	]
