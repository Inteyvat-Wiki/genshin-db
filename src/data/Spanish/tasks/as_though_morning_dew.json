						],
						"stepId": 303201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#Bienvenidos de nuevo, {NICKNAME}, Paimon y Scaramuccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320102,
					"content": "¡Uf! Parece que vengamos de un viaje al fin del mundo. Paimon está agotada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "¿No te gusta ese nombre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320105,
					"content": "Me da lo mismo. Solo estaba pensando que tal vez debería cambiar de nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "¿Ya no quieres que te llamen Scaramuccia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "Ahora que he descubierto lo que Dottore hizo, no quiero llevar un nombre que me relacione de ninguna manera con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "No tengo intención de volver con los Fatui, y tampoco creo que ellos me recibieran. Lo ocurrido ha afectado a muchas personas. Es posible que ya ni recuerden al sexto de Los Once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "¿Quiere decir eso que vas a abandonar los Fatui de una vez por todas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320110,
					"content": "Digamos que es una retirada estratégica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "Es tal y como dijiste, Reina Menor Kusanali. Puede parecer inútil, pero no carece de significado. Al menos logré que muchos me olvidaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Pero eso no quiere decir que tu pasado haya desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320114,
					"content": "Evidentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "Al final no pudiste alcanzar aquello por lo que tanto sacrificaste... Espero que lo entiendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320116,
					"content": "Cambiar el mundo, el pasado o el destino de otros no es tarea sencilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320117,
					"content": "Lo que pretendías alcanzar era la aniquilación, pero eso no es más que una fantasía. Incluso si desaparecieras de este mundo, no quiere decir que todo vaya de acuerdo a tus deseos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320118,
					"content": "Lo sé... Jaja, es ridículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "¿Te arrepientes de haber hecho todo eso para... tan poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320120,
					"content": "Incluso si mi existencia careciera de completo significado, no habría nada que lamentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Reina Menor Kusanali, dejaste la información a propósito en el Irminsul, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Así es, me tomé las molestias necesarias para que pudieras descubrir la información de la manera más natural posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320123,
					"content": "¿Para qué tantas molestias? ¿Intentas ganarte mi favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "Si te soy sincera, tu experiencia te convierte en un gran aliado para Sumeru y para mí. Ganarme tu favor era en efecto parte de mi plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320125,
					"content": "Pero antes, quería que supieras la verdad de tu pasado. Si hubiera querido usarte sin más, no habría sido distinta a El Doctor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320126,
					"content": "... Eres muy astuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Supongo que es una de mis virtudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320128,
					"content": "Ser de utilidad a los demás es lo que da sentido a mi vida. Así que, si para volver a tener un propósito he de afrontar los pecados cometidos, así lo haré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "Nahida no piensa eso de ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "#Cierto, casi olvido que ustedes son l{F#a}{M#o}s buen{F#a}{M#o}s. Creen en la justicia y esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Lamento que mi forma de ver las cosas difiera de la suya, pero para mí no fue un engaño. Los más sabios líderes merecen los mejores discípulos... Puedo vivir con eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Me alegra que pienses eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}, en el futuro seguiré investigando el Irminsul en profundidad para intentar descubrir sus secretos más ocultos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320134,
					"content": "#Espero encontrar información sobre tu herman{F#o}{M#a} en el Irminsul. Yo también siento curiosidad por lo que ocurrió antes y después de aquello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320135,
					"content": "Gracias, Nahida. Espero que puedas encontrar algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Haré todo lo que pueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "¿Qué quieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "¿Por qué fuiste a Inazuma cuando me lancé a las corrientes de información del Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "Quería saber qué había cambiado a causa de ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "Así que fue así como descubriste lo que había cambiado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "Fueran cuales fueran los motivos, me has hecho un gran favor y haré todo lo que pueda por compensártelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "No lo hice para que me debieras un favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "Dar y recibir es la única relación natural entre dos individuos. Algún día estaremos en paz, no lo olvides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Eso no es así. La relación entre dos personas no es una hoja de papel cuyo contenido pueda borrarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320147,
					"content": "Estoy convencida de que en el fondo ya lo sabes. Las personas que una vez estuvieron a tu lado no desaparecen sin más como gotas de agua que se evaporan. No se puede simplemente “quedar en paz”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320148,
					"content": "Hay cosas que nunca vuelven y cosas que nunca cambian, y precisamente por eso existen las emociones en el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320149,
					"content": "Todo lo que sientes es real y duradero. Aquello de lo que careces no te hará completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320150,
					"content": "Ser humano significa ser imperfecto. Tú decides si quieres serlo o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Pero no hay humanos sin corazón, ¿me equivoco? De todas formas, abandoné la idea de convertirme en humano hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Puede que no tengas corazón, pero eres perfectamente capaz de comprender el dolor. Lo que estás haciendo es enterrar tus emociones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320154,
					"content": "El pasado ya está escrito, pero aún puedes recorrer el futuro. Siempre que haya un largo futuro por delante, algún día el pasado no será más que una pequeña rama entre la inmensidad del bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320155,
					"content": "Tengo la sensación de que ya has planeado mi futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Me gustaría que le dieras una oportunidad a Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "Todo esto ha sido muy confuso, así que Paimon no sabe ni qué decir, pero... deberías hacerle caso a Nahida. ¡Si no, todo esto no habrá servido de nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320158,
					"content": "#... Supongo que no me queda más remedio que ayudarl{F#a}{M#o}s a partir de ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Me alegra que aceptes mi propuesta. Tal vez deberías elegir un nuevo nombre para celebrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320160,
					"content": "¡Eso es! ¡Paimon está deseando darte un nuevo nombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320161,
					"content": "¿Y eso por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Porque... ¡Porque sigues sin gustarle ni un pelo a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320163,
					"content": "Bah, entonces lo mejor será que no volvamos a vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "“Un nombre es el primer regalo de una nueva vida”. No lo habrás dicho en voz alta, pero sé lo que estás pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320165,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#{NICKNAME} y Paimon te han ayudado mucho. Si no se te ocurre nada, siempre puedes pedirles consejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320167,
					"content": "#¿Quieres que decidamos nosotr{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "No, ni hablar del peluquín. ¡La especialidad de Paimon son los apodos! Si se trata de un nombre, ¡Paimon te cede los honores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320144,
					"content": "Cualquiera diría que intentaba chantajearte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303203",
							"2"
						],
						"stepId": 303203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sawada",
					"Aqaba",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "¡Ya lo tengo! Puedo concluir la novela con algunas palabras de Mikoshi Nagamasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320302,
					"content": "¿Lo dices porque todos los demás murieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "Aqaba"
				},
				{
					"id": 30320303,
					"content": "Pues sí. Dicen que Mikoshi Nagamasa murió a una avanzada edad. Me parece el personaje perfecto para narrar el epílogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320304,
					"content": "“Las oscuras nubes que se cernían en el horizonte se habían disipado, pero su sombra aún ensombrecería el corazón de Mikoshi Nagamasa durante los años venideros”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320305,
					"content": "“Un día, cuando su cuerpo ya había envejecido, Nagamasa tuvo un sueño. La noche en que la preciada Hoja Tatara de Nagamasa fuera forjada, la gente se regocijó, y pintó, cantó y bebió para celebrarlo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320306,
					"content": "“Aquellas expresiones de júbilo se fundirían en los ardientes fuegos de la forja y del calor emanarían nubes rojas que correrían hasta el sol para acompañar a Mikoshi Nagamasa en el que sería su último amanecer”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320307,
					"content": "“La vida es un camino demasiado extenso como para ser narrado. El periplo de recorrer cada paso no es sino nuestro sino”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320308,
					"content": "Je.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
			"completionStepIds": [
				303204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303204",
							"2"
						],
						"stepId": 303204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320401,
					"content": "¿Lo ves? Ahora tienes un nombre propio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320402
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320402,
					"content": "¿Y el apodo? ¿O es que ya terminaron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320403
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320403,
					"content": "¡Aaah! ¡Paimon está pensando, no seas impaciente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320404,
					"content": "Tómate todo el tiempo que quieras. No tendré que volver a verte hasta que te lo hayas pensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320405
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320405,
					"content": "¿Qué vas a hacer ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320406
					]
				},
				{
					"id": 30320406,
					"content": "Haré que todos aquellos que me engañaron y me utilizaron paguen por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320407
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320407,
					"content": "¿Te refieres a los Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320408,
					"content": "A El Doctor, al menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320409
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320409,
					"content": "Ahora que tu postura ha cambiado, también lo hará tu futuro. Pero no ocurrirá de inmediato, necesitarás tiempo para adecuarte a ello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320411
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320411,
					"content": "Hay algo más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320412
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320412,
					"content": "Todavía quedan algunos descendientes de las Cinco Escuelas de Raiden en Inazuma. Algunos de ellos sabrán, o deberían estar al tanto al menos, de mi relación con las Cinco Escuelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320413
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320413,
					"content": "No tengo pensado abandonar Sumeru por el momento, así que si te cruzaras con ellos, por favor, diles que yo fui el responsable de la caída de las Cinco Escuelas de Raiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320414
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320414,
					"content": "Incluso aunque esos recuerdos hayan sido borrados de este mundo, se merecen saber la verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320415
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320415,
					"content": "Muy bien... La decisión es tuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320416
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320416,
					"content": "¿Eh? Pero si hacemos eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320417,
					"content": "No importa. Pueden atravesarme el pecho con sus espadas si así lo desean. Así es como las cosas deberían haber sido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320418,
						30320422
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320418,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320419
					]
				},
				{
					"id": 30320419,
					"content": "¿A qué viene esa cara? No te preocupes, sé lo que hago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320420
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320420,
					"content": "Ese día aún está por llegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320421
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320421,
					"content": "Bien, eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320425,
					"content": "Volveremos a vernos, Diosa de la Sabiduría, y a ustedes también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320426
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320426,
					"content": "Se ha ido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320427,
					"content": "Con todo lo que ha tenido que afrontar hoy, le parecerá que ha vivido una vida entera en un mero instante. Necesitará tiempo para calmarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320428,
					"content": "Sí, es cierto. Aunque ahora ya no parece tan aterrador, ¿no les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320429,
					"content": "Por lo menos ha acabado todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320430
					]
				},
				{
					"id": 30320430,
					"content": "¿Podemos ir a comer algo ahora? ¡Paimon se muere de hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320431,
					"content": "#Gracias a l{F#a}{M#o}s dos. Espero que puedan descansar un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320422,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320423
					]
				},
				{
					"id": 30320423,
					"content": "Ja, ¿nada de tonterías esta vez? Así me gusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320424
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320424,
					"content": "Suficiente por hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303205,
			"completionStepIds": [
				303205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303205",
							"2"
						],
						"stepId": 303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amane",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "¡Uf! ¡Ya era hora de tomarse un descansito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "Basta con que pares un minuto, para que el cansancio y el hambre te alcancen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Descansa, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "¡Guau, yupi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "¿Eh? Ese jarrón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "¿Qué le pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "¿Lo habrá roto el servicio de limpieza? Aunque Paimon no recuerda que hubiera servicio de limpieza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(La noche que pasamos aquí, Paimon se asustó por algo que hizo Scaramuccia y lo rompió.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(Pero Scaramuccia borró su existencia. Si ha cambiado el transcurso de la historia... ¿por qué sigue el jarrón roto?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "#Pareces confus{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "Sé por lo que has pasado. Cargar con el peso de lo que tú sabes confundiría a cualquiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "#¿Eh? ¿Es que alguien se está comunicando con nosotr{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "Es una lástima, pero el destino de Teyvat no se puede cambiar con tanta facilidad. Tal vez los dioses pudieran hacerlo, pero nadie más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "Cuando un animalillo se golpea contra un árbol, lo sacude, pero no es capaz de derribarlo. Así es el destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "Lo mismo pasa con el jarrón. Ya sea culpa de un gato o de un ave, el hecho es que el jarrón está roto, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "¿Q-quién eres? ¿Cómo sabes todo eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "El pasado no cambia, pero los corazones de los mortales, sí. Confía en lo que ves, pues solo eso es cierto. Lo que no ves no es sino una ilusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "La voz ha desaparecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "¿De quién era esa voz? ¿Quién se cree que es para aparecer así de la nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320523,
					"content": "(¿Que confíe en lo que veo? ¿Se refería a mis recuerdos?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "Bueno, el caso es que el jarrón sigue ahí tirado. ¿Debería Paimon pedir a alguien que lo recoja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "Paimon"
				},
