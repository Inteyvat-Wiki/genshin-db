			},
			"dialogs": [
				{
					"id": 790000401,
					"content": "¡Lo encontramos! ¡El tesoro, el tesoro! ¿Qué habrá dentro?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000402,
					"content": "¿Eh? Tiene una especie de candado... Y es un candado con contraseña... Solo sabiendo la contraseña podremos abrirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000403,
					"content": "Quizás podamos abrirlo con un golpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "¡Espera! Si lo golpeas, ¡quizás arruines lo que sea que haya adentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000406,
					"content": "Mejor pensemos en una forma de abrirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000410,
					"content": "Es obvio que este cofre tiene en su interior la reliquia familiar. Además, el tipo de candado requiere una contraseña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000411,
					"content": "En otras palabras, sea quien sea que haya cerrado este cofre debió haber dejado una contraseña fácil de recordar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000412,
					"content": "Parece que nuestra única esperanza son esas caracolas que conservan sonidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000413,
					"content": "Escuchemos una vez más las caracolas. Esperemos que contengan pistas acerca de la contraseña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000404,
					"content": "Pensemos en cómo abrirlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "Pero no hay estelas de piedra, murales, hojas de papel, grabados o cuadernos ni nada por el estilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000408,
					"content": "Y tampoco hay eruditos, ladrones de tesoros o aventureros a la vista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "Tienes razón. Humm... Paimon nunca había visto una prueba así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
