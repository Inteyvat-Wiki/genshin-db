			"trigger": {
				"objectNames": [
					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "¡Estás aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930102,
					"content": "En el poema de ayer, Lenne escribió acerca de que le gustaría haberme conocido antes. Así que, naturalmente, hoy quiero dedicarle un poema yo a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930103,
					"content": "¡Es un honor para mí recibir ese regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930104,
					"content": "Aunque ya soy un anciano, últimamente he entablado amistad con mucha gente de Mondstadt y ahora siento un gran interés por la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930105,
					"content": "En este poema he querido imitar el estilo poético de los bardos de Mondstadt y en algunos versos menciono algunos de sus paisajes más emblemáticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930106,
					"content": "Es una pena que nunca haya visitado Mondstadt. ¿Podrías capturar algunas <color=#00E1FFFF>imágenes de objetos típicos de Mondstadt</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930107,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "Jaja, muchas gracias. Necesitaré cuatro imágenes, igual que ayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
