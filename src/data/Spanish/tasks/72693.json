			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lenne",
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "El poema de Ootomo rompe con los estándares de la poesía tradicional de Inazuma y, aun así, está escrito con un estilo clásico, con el que evoca toda una serie de recuerdos inolvidables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930602,
					"content": "Lo que intenta transmitir es que, a pesar de que Mondstadt e Inazuma parecen ser naciones completamente diferentes, tienen en común su gran belleza. Al igual que nosotros dos, que abandonamos nuestras identidades y nos unificamos bajo la figura del poeta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930603,
					"content": "Aunque Lenne todavía es joven, ha sido capaz de captar los sentimientos detrás de los versos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930604,
					"content": "Antes me negaba a creer en la amistad intergeneracional, pero hoy me he dado cuenta de que es algo realmente posible y maravilloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930605,
					"content": "#Y luego estás tú, {F#una jovencita}{M#un jovencito} de gustos exquisitos. Debe de ser el destino lo que hizo que los tres coincidiéramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930606,
					"content": "Efectivamente. Las dificultades que he encontrado en el camino a Inazuma no son lo importante. Estoy seguro de que, aunque vuelva a Mondstadt, recordaría cada rama y cada hoja de Inazuma durante el resto de mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930607,
					"content": "Y todo gracias a las imágenes que nos has traído. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930608,
					"content": "Espero que podamos volver a vernos alguna vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930609,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
