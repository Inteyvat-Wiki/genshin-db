					"content": "¿Acaso aquí es donde se juntan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250103,
					"content": "¡Grrr! ¿Gruuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#¡Parece que estás muy emocionado, {REALNAME[ID(2)|SHOWHOST(true)]}! Estás contento de ver a tantos como tú, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250105,
					"content": "¿Grrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#Ah, ¿quieres ir a jugar con ellos? {NICKNAME}, ahora que lo piensa Paimon, es verdad que {REALNAME[ID(2)|SHOWHOST(true)]} no suele estar con los suyos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250107,
					"content": "Está bien, pero tienes que tener cuidado, ¿eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#Paimon sigue algo preocupada, pero bueno, busquemos un lugar donde sentarnos para comer y charlar mientras esperamos a {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250111,
					"content": "#Tú y Paimon encuentran un buen lugar para descansar y esperan a que {REALNAME[ID(2)|SHOWHOST(true)]} termine de jugar con sus compañeros.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "Sin embargo, llevan mucho tiempo esperando...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#Qué raro. {REALNAME[ID(2)|SHOWHOST(true)]} aún no ha vuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250114,
					"content": "¿No le habrá pasado algo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250115,
					"content": "¿Quizá se lo esté pasando tan bien que se le olvidó la hora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "#Si es así, tendremos que hablar con {REALNAME[ID(2)|SHOWHOST(true)]}. ¡Se está haciendo de noche y no hay ni rastro de él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250117,
					"content": "Uff, vamos a buscarlo ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250108,
					"content": "¡Vuelve pronto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
