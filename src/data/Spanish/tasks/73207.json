			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "¿A qué escuela pertenecías?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "Jaja, ¡podría hablarte de eso durante días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030607,
					"content": "Pertenecía a la Escuela de Biología. Me especialicé en evolución botánica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030608,
					"content": "Para llevar a cabo mi trabajo necesitaba nuevas muestras constantemente. Las muestras del pasado son fundamentales para estudiar la evolución de las plantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030609,
					"content": "Pero ya no hay muchas disponibles y la Academia también tiene unos recursos limitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030610,
					"content": "Aunque la situación no era ideal, la Academia no dejaba de presionarnos para obtener nuevos resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030611,
					"content": "Algunos se limitaban a presentar antiguos artículos a los que añadían o modificaban algo. Pero eso no está bien, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030612,
					"content": "Si pudiéramos profundizar en el aspecto histórico y obtener nuevas muestras, sería muy fácil obtener resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030613,
					"content": "También sería de gran utilidad incorporar algunas fuentes que la Escuela de Biología no termina de aceptar. Pero eso supondría competir con la Escuela de Etiología y la Escuela de Semiótica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030614,
					"content": "Yo no tenía experiencia en esos ámbitos y los materiales eran realmente complicados, por no hablar de que los demás investigadores no deseaban colaborar en el proyecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030615,
					"content": "Pero estoy segura de que si todos pusieran de su parte, podríamos resolver muchas hipótesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030616,
					"content": "Es una pena que nadie haga nada al respecto. Aunque los eruditos de la Escuela de Etiología y la Escuela de Semiótica tienen posturas un tanto... peculiares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030617,
					"content": "Tuve que prestar especial atención a mis artículos para que no hubiera malentendidos o interpretaciones erróneas del contenido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030618,
					"content": "Antes de que me expulsaran, estaba debatiendo algunos asuntos con un erudito de la Escuela de Semiótica. Pero ahora ni siquiera puedo terminar aquella discusión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030625,
					"content": "Ay... Ya hablé demasiado. Pero me siento bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030626,
					"content": "No tengo amigos aquí, así que a veces me siento un poco sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030629,
					"content": "No hay muchos en la aldea a los que les interese la jardinería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030630,
					"content": "Bueno, hay un señor al norte de aquí que cultiva una parcela de flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030631,
					"content": "Fui a verlo una vez, pero es un señor un tanto extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030632,
					"content": "Estaba plantando piedras, pero no dejaba de decir que eran flores. Al final, me echó de allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030633,
					"content": "Debe sentirse solo, viviendo apartado de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030634,
					"content": "Ya que me has ayudado a mí... tal vez puedas ayudarle a él también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030635,
					"content": "Si tienen tiempo, deberían visitarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		},
