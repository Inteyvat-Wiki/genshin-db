			"dialogs": [
				{
					"id": 732060402,
					"content": "Sobre Affan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "¿Eh? ¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732060404,
					"content": "Le cuentas a Sabah los problemas de Affan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "Ya veo, así que han venido a pedirme ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732060406,
					"content": "Les estoy muy agradecida por pensar que yo podría solucionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732060407,
					"content": "Pero no es que yo sepa mucho sobre cultivos y tampoco tengo mucha experiencia. No sé si podré ser de utilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732060408,
					"content": "Aun así, haré todo lo que pueda. Además, tengo mucha curiosidad por esa nueva variedad de rosas de las que hablan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732060409,
					"content": "Iré a visitar al Sr. Affan en cuanto pueda. Vayan a buscarme allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		},
		{
			"id": 7320606,
			"completionStepIds": [
				7320706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"3"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7320701",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "Lo siento mucho, Shafaqat. No he sido capaz de cumplir tus deseos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060602,
					"content": "¿Quién es Shafaqat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "¿No querían saber quién era el viejo fantasma? Pues, obviamente, ese no era su verdadero nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060604,
					"content": "Los mayores lo llamaban Shafaqat. Decían que se marchó de la Ciudad de Sumeru cuando era joven y vino a la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060605,
					"content": "Construyó su casa aquí, y aquí se quedó durante décadas. Casi nunca salía de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060606,
					"content": "Yo no le conocí de joven, pero la gente decía que solía adorar a los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060607,
					"content": "Cultivó y plantó muchas flores y árboles en la entrada de su casa. A los niños les encantaba pedirle dátiles y escucharle contar historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060608,
					"content": "Para cuando yo le conocí, ya era un señor mayor al que llamaban viejo fantasma y odiaba a los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060621,
					"content": "Debe haber otra manera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "¿Y qué otra manera podría haber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060623,
					"content": "Shafaqat murió en paz hace ya mucho tiempo. Si todavía siguiera vivo, le preguntaría a él mismo cómo cultivar las rosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060624,
					"content": "¿A quién podría preguntarle ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060625,
					"content": "#Nosotr{F#a}{M#o}s conocemos a una investigadora de la Escuela de Biología llamada Sabah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "¿Te refieres a esa forastera? ¿Crees que podrá ayudarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060627,
					"content": "Creo que una vez se pasó por aquí y también la espanté. No estoy seguro de que quiera ayudarme ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060628,
					"content": "Merece la pena intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "#Eres {F#una buena chica}{M#un buen chico}. Incluso si no consigues ayuda, te agradezco que lo intentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060609,
					"content": "¿Por qué está tan empeñado en cultivar flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "A veces, a los visitantes no les queda más remedio que asentarse en la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060611,
					"content": "Algunos no terminan de acostumbrarse por más que lo intenten, así que acaban pasando solos el resto de sus días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060612,
					"content": "Quizás el viejo Shafaqat fuera uno de ellos. Con el tiempo la gente se acostumbró a su forma de ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060613,
					"content": "Pero yo no quiero acostumbrarme a ese tipo de cosas. Creo que lo que le pasó fue una verdadera lástima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060614,
					"content": "Si hubieran visto su jardín en aquella época, les habría encantado. Había todo tipo de flores de colores y árboles de todos los tamaños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060615,
					"content": "La persona que cultivó aquel precioso jardín se marchó de este mundo sin pena ni gloria. Y lo único que recuerda la gente de él es que era un viejo gruñón que solía ahuyentar a los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060616,
					"content": "No me quedaré de brazos cruzados. Él escribió en sus notas que quería llenar todo el jardín con estas flores y eso es lo que haré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060617,
					"content": "Ya estoy viejo, así que no me importa lo que otros piensen de mí. Mi vida habrá merecido la pena si hago esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060618,
					"content": "Así que limpié la casa y ordené la montaña de cuadernos que dejó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060619,
					"content": "Podría prestarles un par de cuadernos si les interesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060620,
					"content": "Los dejé <color=#00E1FFFF>frente a la casa</color>. Pensé que no le vendría mal ver la luz del sol después de tanto tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320701,
			"completionStepIds": [
				7320701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320701",
							"2"
						],
						"stepId": 7320701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "¡Han vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070102,
					"content": "Así que esta es la muchacha de la que me hablaron. Creo que no fui muy amable con ella hace poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070103,
					"content": "Realmente soy un viejo loco y cascarrabias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070104,
					"content": "Bueno, lo que importa es que ahora está siendo amable. No se preocupe por eso, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070105,
					"content": "¿Han germinado ya las flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "Por desgracia, el Sr. Affan y yo acabamos de comprobarlo y siguen sin germinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070107,
					"content": "Por lo que he podido observar, las semillas se han petrificado. Hay dos motivos para ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070108,
					"content": "Uno, que se hayan secado con el paso del tiempo hasta petrificarse y ya no sean capaz de madurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070109,
					"content": "Llegados a ese punto, las semillas no serán capaces de germinar. Aunque parece lo menos probable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070110,
					"content": "La petrificación requiere de un largo periodo de tiempo y las semillas no reúnen esas condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070111,
					"content": "Dos, que estas semillas tengan una gran afinidad con el elemento Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070112,
					"content": "Eso supondría que tienen la capacidad de reunir partículas Geo que les permitan crear una especie de caparazón a su alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070113,
					"content": "Si eso es cierto, las semillas podrían almacenarse durante décadas sin ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070114,
					"content": "Paimon no lo comprende. ¿Estás diciendo que las semillas se han convertido en piedras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070115,
					"content": "Si son piedras, entonces sí que no hay esperanza. No se puede cultivar una rosa dorada a partir de una piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070116,
					"content": "¿Rosas doradas? ¿De esas que se mencionan en la canción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070117,
					"content": "Ah, claro, puede que no lo sepan, pero en la aldea hay una canción que ha pasado de generación en generación sobre una rosa. La popularizó Shafaqat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070118,
					"content": "Él mismo le enseñó la melodía a la generación de mis padres y ellos se la enseñaron a sus hijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070119,
					"content": "Algunos de mis contemporáneos ni siquiera han oído la canción, así que cuando nosotros ya no estemos aquí, la canción se perderá tal y como hizo él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070120,
					"content": "♪ Rosa, rosita del jardín, haz que mis deseos se cumplan al fin ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070121,
					"content": "♪ Una rosa dorada que canta mientras que de entre fragmentos se alza ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070122,
					"content": "¡Eso es! ¡Podemos hacer que las rocas florezcan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070123,
					"content": "¿En qué estás pensando, Sabah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "Tal y como dice la canción, si rompemos la carcasa de piedra, las flores podrán brotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070125,
					"content": "Normalmente, se crea un ambiente ideal para que la planta sea capaz de romper la semilla por sí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070126,
					"content": "Pero en este caso, la carcasa exterior es demasiado dura para que el brote pueda romperla. Tenemos que facilitar el proceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070127,
					"content": "¿Le parece bien, Sr. Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070128,
					"content": "¿Quieres abrir las semillas a la fuerza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070129,
					"content": "Bueno, no las vamos a destrozar ni nada de eso, solo vamos a ablandar un poco la cubierta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}, ¿te ves capaz de hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070131,
					"content": "Al final siempre me toca a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "Ten mucho cuidado durante el proceso. Primero tendrás que utilizar <color=#00E1FFFF>Ataques Bruscos</color> para romper la carcasa y luego utilizar el <color=#00E1FFFF>elemento Dendro</color> para revitalizar las semillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070132,
					"content": "Claro que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "Esperan en silencio durante un rato hasta que los brotes comienzan a surgir de la tierra lentamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "¡Guau, el método de Sabah ha funcionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070302,
					"content": "¡Al fin están germinando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070303,
					"content": "Parece que podrá cumplir con el sueño del Sr. Shafaqat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070304,
					"content": "Sr. Affan, me dijo que este es un tipo de rosa que él mismo cultivó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070305,
					"content": "Si fue capaz de crear una nueva variedad de rosas, ¿se trataba de un erudito exiliado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070306,
					"content": "Así es. Fue exiliado a esta aldea y vivió en esta casa toda su vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070307,
					"content": "Ya veo. Supongo que ese es el futuro que nos espera a todos los exiliados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070308,
					"content": "Cultivar una nueva variedad de planta parece algo que solo un investigador de primera podría hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070309,
					"content": "Es una verdadera pena que alguien así fuera desterrado de la Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070310,
					"content": "Sabah, parece que estés pensando en tu propio futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070311,
					"content": "Anímate, Sabah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Eso, muchacha. Todavía tienes mucha vida por delante, podrás hacer muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070313,
					"content": "No te dejes llevar por la agonía. No quiero ni oír hablar de un segundo fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070317,
					"content": "Tienen razón. No debería sumirme en la tristeza en un momento tan feliz como este. Hablemos de otra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070318,
					"content": "Las rosas doradas han germinado, pero todavía tienen que florecer. Me gustaría observarlas durante el proceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070319,
					"content": "A mí también.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Tal vez tengamos que esperar un poco. Aún tienen que absorber nutrientes. Pero seguro que al final acaban floreciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732070314,
					"content": "(No sé cómo podemos animarla...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "No estés triste. Al final consiguió dejar esta rosa como legado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070316,
					"content": "Ahora serán un recuerdo del paso de Shafaqat por este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				}
			]
		},
