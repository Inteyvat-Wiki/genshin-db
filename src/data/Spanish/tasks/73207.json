			"dialogs": [
				{
					"id": 732030619,
					"content": "¿Cómo es la vida en la Aldea Aaru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "No está mal. Tengo comida y alojamiento. Mis necesidades básicas están cubiertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030621,
					"content": "Soy una exiliada, así que ni siquiera me planteo la posibilidad de tener materiales y libros a mi disposición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030622,
					"content": "Los eruditos exiliados de la Academia siempre han acabado aquí y, aunque no tiene ni punto de comparación con la Ciudad de Sumeru, al menos se respira cierto ambiente académico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030623,
					"content": "No soy ni la primera ni la última exiliada que pisa este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030624,
					"content": "No queda más remedio que acostumbrarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabah"
