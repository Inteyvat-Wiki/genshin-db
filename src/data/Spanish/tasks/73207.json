			},
			"dialogs": [
				{
					"id": 732030701,
					"content": "¿Vienen a charlar un rato? Hace tiempo que me apetece hablar con alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		},
		{
			"id": 7320308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
