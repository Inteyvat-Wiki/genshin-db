			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "Echaba de menos el poder contemplarlas. Déjenme agradecérselo. Acepten esto a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900202,
					"content": "Son semillas que no pueden crecer aquí. Si tienen una parcelita de tierra donde plantarlas, seguro que crecen fuertes y hermosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900203,
					"content": "Ay... Ya hablé demasiado. Pero me siento bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900204,
					"content": "No tengo amigos aquí, así que a veces me siento un poco sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900207,
					"content": "No hay muchos en la aldea a los que les interese la jardinería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900208,
					"content": "Bueno, hay un señor al norte de aquí que cultiva una parcela de flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900209,
					"content": "Fui a verlo una vez, pero es un señor un tanto extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900210,
					"content": "Estaba plantando piedras, pero no dejaba de decir que eran flores. Al final, me echó de allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900211,
					"content": "Debe sentirse solo, viviendo apartado de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900212,
					"content": "Ya que me has ayudado a mí... tal vez puedas ayudarle a él también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732900213,
					"content": "Si tienen tiempo, deberían visitarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		}
	]
