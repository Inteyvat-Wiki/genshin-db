			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "♪ Rosa, rosita del jardín, haz que mis deseos se cumplan al fin ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070502,
					"content": "♪ Una rosa dorada que canta mientras que de entre fragmentos se alza ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070503,
					"content": "♪ Y continuó cantando: ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070504,
					"content": "♪ No hay tierra que me dé sustento, pero esta melodía será mi aliento ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070505,
					"content": "♪ La música cargará con mi destino, algún día cumpliré mi sino ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070506,
					"content": "♪ Desafiarán a la eternidad, sobrevivirán a mi exigua mortalidad ♪”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070507,
					"content": "Esa es la canción que Shafaqat nos enseñó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
