				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030602,
					"content": "#Yo mism{F#a}{M#o} recogí esta rosa de Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "Echaba de menos el poder contemplarlas. Déjenme agradecérselo. Acepten esto a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "Sabah"
				},
				{
					"id": 732030604,
					"content": "Son semillas que no pueden crecer aquí. Si tienen una parcelita de tierra donde plantarlas, seguro que crecen fuertes y hermosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabah"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
