			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "¿Por qué no se ha llevado un poco de comida caliente?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "¿Comida caliente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Ah, me refiero a Iris, la exploradora. Fue a la montaña y creo que no se ha llevado comida caliente con ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Quiere organizar una expedición a las profundidades de la montaña con un equipo de exploradores, pero primero piensa ir ella sola, acampar por un tiempo y observar las condiciones antes de hacer un plan definitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "Su campamento no está lejos de aquí, así que llevarle algunos suministros no debería ser un problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Aun así, acampar en la montaña, en medio de la nieve... Creo que un plato caliente le daría la energía extra que necesita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "Solo que no me atrevo a adentrarme en la montaña yo mismo... Oye, ¿tú podrías entregarle a Iris este guisado de temporada por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Acabo de preparar este plato. Sigue estando caliente, así que más vale que te apresures y se lo entregues a Iris lo antes posible. Con este clima, si se enfría la comida, no servirá de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Pero si ocurriera algún accidente con la comida, vuelve y te prepararé un plato nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "¿Dónde puedo encontrarla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Dijo que su campamento estaba en la ladera camino a la cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "Es una aventurera experimentada y precavida. No creo que se haya alejado del campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
