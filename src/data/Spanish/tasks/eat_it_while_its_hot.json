			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Este guisado de temporada es para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Oh, debes venir de parte de Harris. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "Más vale que no me acostumbre a comida tan deliciosa, o después no podré acostumbrarme a comer raciones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Jaja, estoy bromeando. Como aventurera, sé cuándo hay que ajustarse el cinturón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "¿Seguirás adentrándote en la montaña?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Por supuesto, este campamento es solo una parada. Cuando vea la oportunidad, intentaré acampar más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "Cuando llegue ese momento, no habrá comida ni bebida caliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "Pero no seguiré avanzando despreocupadamente. Después de investigar un poco más, regresaré al campamento principal, haré un plan de acción y tomaré una decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Gracias por traerme la comida hasta aquí. Toma esto como compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
