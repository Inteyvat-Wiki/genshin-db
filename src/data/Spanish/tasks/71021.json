						710210102,
						710210106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210102,
					"content": "Usa el planeador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "Bueno, da igual. Después de ir a la Academia de Sumeru, estuve todo el año sin hacer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210104,
					"content": "Además, apenas usé el planeador mientras estaba en la Academia. Seguro que ya no sé volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210105,
					"content": "Si usara el planeador, seguramente me caería al agua a medio camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210106,
					"content": "Alquila un bote.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "Eso creo que haré. Recuerdo que en el Puerto de Dornman se podían alquilar botes, pero es que está tan lejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210108,
					"content": "No sé cuánto tiempo tardaría en llegar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210109,
					"content": "Y tampoco puedo fabricar mi propio bote porque en la Academia de Sumeru no nos enseñaron a hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
