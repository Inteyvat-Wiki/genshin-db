			},
			"dialogs": [
				{
					"id": 200430601,
					"content": "¿Has hablado con Quinn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Sí. Dice que deberías descansar un poco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "Hoy no hay nada que hacer en la tienda de Quinn, ve a casa y descansa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "¿En serio?... *Suspira*, parece que debería encontrar algo más que hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "¿Qué? ¿No vas a tomarte el día para descansar? ¡Aprovecha ahora que puedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Detente por un momento y siente lo que sucede a tu alrededor. Son los vientos del señor Barbatos trabajando duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "Por eso, los que hemos sido bendecidos por él no debemos holgazanear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "En cuanto a ti... ¿Qué has estado haciendo? ¿Por qué estás sudando tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "#Parece que tú también estás muy ocupad{F#a}{M#o}. Pero supongo que eso no tiene nada de malo. Cuanto más trabajamos, más sudamos y con mayor intensidad sentimos los vientos de Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Ten, toma esta botella de leche. Bébetela y vuelve a lo que estés haciendo, porque en este mundo siempre hay trabajo que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
