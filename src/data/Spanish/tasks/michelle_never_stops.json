				"points": []
			},
			"dialogs": [
				{
					"id": 200430401,
					"content": "¿Encontraste <color=#00E1FFFF>solsettias</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430402,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "Debe haber un montón de <color=#00E1FFFF>solsettias</color> en las afueras de la ciudad. Por favor, necesito quedarme aquí. ¿Puedes ir rápido a recoger algunas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
		{
			"id": 2004305,
			"completionStepIds": [
				2004304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
