			"trigger": {
				"objectNames": [
					"Vaino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "#¿Y si la próxima vez diseño una batalla por equipos? ¿O tal vez un combate podría ser divertido? ¡Oh, son ustedes! ¡Bienvenid{F#as}{M#os} al campo de entrenamiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "¿Qué tal va el campo de entrenamiento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Cada vez vienen más personas, y todo es gracias a ustedes. ¡Y claro, también gracias al esfuerzo de los niños y de la Sociedad Oculta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Me di cuenta de que el campo de entrenamiento es ideal para reuniones. Cuando te reencuentras con amigos que no ves hace años, a veces no sabes qué decir, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "¿Cómo va el asunto de la Sociedad Oculta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Ah... todavía no he encontrado un mejor material para sus madrigueras que los objetivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "Los niños y yo hemos probado muchos materiales, pero los objetivos parecen ser sus favoritos. Por ahora, no nos queda más remedio que hacer transacciones con ellos para recuperarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Aunque, poco a poco hemos aprendido a calcular el valor de sus tesoros, y hemos ganado bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Hasta la próxima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "¡Sí, vengan cuando quieran! Y recuerden, ¡para ustedes siempre será gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
		{
