			"dialogs": [
				{
					"id": 718202101,
					"content": "¿Y bien? ¿Encontraste a Bohuan? ¿Qué dijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202102
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202102,
					"content": "Aceptó, pero dijo que vendría en un rato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718202103
					]
				},
				{
					"id": 718202103,
					"content": "Perfecto. Hace un momento estuve con Chingzhou, pero parecía preocupado. Dijo que tenía que estar a solas para encontrar inspiración y se fue a caminar por los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202104
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202104,
					"content": "#Gracias por tu ayuda, viajer{F#a}{M#o}. Voy a esperar a Bohuan aquí para hablar de algunos detalles con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202105,
					"content": "Luego regresaré a Liyue una vez más para encargarme de algunas tareas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202106,
					"content": "Supongo que, por un tiempo, tendré que ir y venir continuamente entre la Posada Wangshu y Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202107,
					"content": "Una vez que haya terminado esas tareas, podremos ir a la Aldea Chingtsé. Si te interesa, podríamos encontrarnos allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202108,
					"content": "*Suspira*, espero terminar pronto todo lo que tengo por hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				}
			]
