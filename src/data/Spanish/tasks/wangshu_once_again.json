			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "Siempre con la misma historia en cada Rito de la Linterna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200202,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "Es sobre la posada. Muchas personas vuelven a sus casas durante el Rito de la Linterna y no nos alcanza la mano de obra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200204,
					"content": "Tenemos que atender a los clientes, decorar la posada y preparar algunas cosas para el festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200205,
					"content": "Además, tampoco podemos dejar de lado las cosas del día a día... El Sonriente Yanxiao no da abasto para todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200206,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200207,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "Muchas gracias. Puedes encontrar al Sonriente Yanxiao en la cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200209,
					"content": "Yo todavía tengo que encargarme de unas cosas por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "¡¿Quién es?! Solo el personal puede... Oh, eres tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718200302,
					"content": "¿Necesitas algo? Si quieres pedir algo, tomará un tiempo. Ahora tengo mucho que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718200303,
					"content": "Vine a ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "¿Vienes a ayudar? ¡Qué bien! Justo ahora tengo una montaña de cosas por hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718200306,
					"content": "Primero, ve abajo y trae los ingredientes que acaban de llegar, los necesito con urgencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718200307,
					"content": "Y de paso, cuelga estas linternas celestes en los dos árboles de la entrada de la posada... El gerente lleva mucho tiempo quejándose de eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718200304,
					"content": "¿Hay algo en lo que te pueda ayudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "¿Y bien? ¿Ya te hiciste cargo de todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 718201502,
					"content": "Todo listo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Gracias, me has ayudado mucho. Debo apresurarme para terminar de hacer estos platos, o los clientes perderán la paciencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "¡Regresaste! ¿Qué tal fue con Yanxiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201602,
					"content": "Ahora todo debería estar más tranquilo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "Me alegro. Gracias por la ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201604,
					"content": "Aquí tampoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201605,
					"content": "¿Eh? ¿Wangya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "#¿Viajer{F#a}{M#o}? Qué casualidad, no esperaba encontrarte aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201608,
					"content": "Se podría decir que estoy entregando linternas... ¿Conoces la Aldea Chingtsé? Está lejos de la ciudad, y la mayoría de sus habitantes son ancianos y niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201609,
					"content": "Así que, cada año, durante el Rito de la Linterna, el Ministerio de Asuntos Civiles asigna a alguien para llevarles algunos suministros para el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201610,
					"content": "Ya enviamos el primer lote, pero quisiera hacer algo más por la aldea para que tenga un ambiente más festivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201611,
					"content": "Así que invité al poeta Chingzhou, y dijo que prepararía unos acertijos para jugar con los niños de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201612,
					"content": "Chingzhou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "Ese poeta debería estar a la altura de esta tarea. También quiero buscar a Bohuan. Su caligrafía es muy buena, sería genial si pudiera ayudar a las personas mayores de la aldea a escribir en las linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201615,
					"content": "Pero no puedo encontrarlo por ningún lado. Escuché que vino al Pantano Dihua en busca de inspiración, así que vine a buscarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201616,
					"content": "Quizás la jefa lo sepa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "¿Bohuan? Déjame pensar... Sí, vino a la posada hace poco. Dijo que iba a buscar no sé qué por aquí cerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201619,
					"content": "Pero como hay tantos monstruos en el lugar al que se fue, ahora ni siquiera estoy segura de que siga por allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201620,
					"content": "Ya veo... Pero ya acordé con Chingzhou que en un rato nos encontraríamos aquí, en la Posada Wangshu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201621,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarme a buscar a Bohuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201622,
					"content": "Sí, claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "Entonces, cuento contigo. Yo esperaré aquí a que Chingzhou venga, todavía tengo algunas cosas que hablar con él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201624,
					"content": "¡Uff! Las tareas no se acaban...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201617,
					"content": "¿Sabes qué le pasó a Bohuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(Humm... ¿No había acordado con Vermeer que...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "¿Viniste a entregar linternas celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182019",
							"2"
						],
						"stepId": 7182019,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bohuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Gracias, gracias. *Suspira*... Es mi culpa por ser tan descuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201902,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "Vine a buscar inspiración. Como estamos en el Rito de la Linterna, me gustaría regalarle a mis amigos cercanos unos bellos versos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201904,
					"content": "Así que vine a dar un paseo por aquí para buscar algunos materiales con los que hacer una tinta especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201905,
					"content": "Nunca pensé que me encontraría con un montón de monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201906,
					"content": "Wangya dijo que quería pedirte algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Así que quiere que vaya a la Aldea Chingtsé a escribir unos versos... Está bien, déjamelo a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201908,
					"content": "La Aldea Chingtsé... Según recuerdo, ahí viven muchos ancianos... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201909,
					"content": "Hagamos una cosa: primero, ayúdame a recolectar un fragmento de cor lapis y una flor chingxin para preparar un poco de tinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201910,
					"content": "¿Se puede preparar tinta... con eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Jajaja, veo que no lo sabías. Cuando se agrega polvo de cor lapis a la tinta, esta escribe con un leve tono dorado. Es un color que representa la buena suerte durante este festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201912,
					"content": "El néctar de la flor chingxin le da a la tinta una deliciosa fragancia. Si se prepara bien, estos dos olores sacan lo mejor el uno del otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201913,
					"content": "Vaya, no tenía ni idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "No es nada comparado con lo que están dispuestos a hacer los grandes expertos para fabricar su tinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201916,
					"content": "Esta vez tratemos de hacerlo lo más sencillo posible. Una vez que hayas recolectado lo que te pedí, tráemelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201917,
					"content": "Ah... Necesito tomar un respiro. Ese incidente fue demasiado para mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201914,
					"content": "Suena muy engorroso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
