			"dialogs": [
				{
					"id": 411270501,
					"content": "¿Ocurrió algo mientras volvías aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "¿Mientras volvía? Pues... No sé, no me acuerdo muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270503,
					"content": "¡Ah, sí! Me encontré con un gran grupo de Slimes Electro cerca del <color=#00E1FFFF>Templo de los Mil Vientos</color>. Me atacaron, y ahí fue cuando se me cayó la caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270504,
					"content": "Por suerte, fui rápido y la recogí, pero... como regresé corriendo a toda prisa, la volví a perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270505
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270505,
					"content": "Si los Slimes Electro tocaron la caja, debería haber alguna <color=#00E1FFFF>marca elemental</color> en ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270506
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270506,
					"content": "Así que podrías intentar seguir las marcas Electro que encuentres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270507
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270507,
					"content": "Cuando encuentres la caja, ven a devolvérmela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
