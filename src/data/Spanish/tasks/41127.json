			"dialogs": [
				{
					"id": 411270201,
					"content": "¿Qué? ¿Necesitas algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270202,
					"content": "Es un poco difícil buscar algo sin ninguna pista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "Oh, bueno... Entonces espera, deja que intente recordar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270204,
					"content": "No, no recuerdo nada más. La caja tampoco tiene nada de especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270205,
					"content": "Entonces, deja que te haga algunas preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "De acuerdo. ¿Qué quieres saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
