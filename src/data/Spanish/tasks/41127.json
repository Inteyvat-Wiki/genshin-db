			"dialogs": [
				{
					"id": 411270401,
					"content": "¿Qué hay en la caja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "Eso no es asunto tuyo. No es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270403,
					"content": "¡Oye! ¡No me mires así, como si fuera sospechoso! ¡No soy una mala persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270404,
					"content": "Pero eres un Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "Ah, y como soy Fatui, ¿tengo que ser sospechoso? Eso no tiene ningún sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270406,
					"content": "Bueno, ve a echar un vistazo. <color=#00E1FFFF>Si no encuentras nada, ven a verme</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270407,
					"content": "Tal vez pueda recordar algo más...",
					"roleType": "TALK_ROLE_NPC",
