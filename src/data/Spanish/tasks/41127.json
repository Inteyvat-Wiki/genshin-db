			"dialogs": [
				{
					"id": 411270301,
					"content": "¿Qué fuiste a hacer fuera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Oye, no me mires como si fuera alguien sospechoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270303,
					"content": "¡Solo salí a dar una vuelta y tomar el fresco! Regresé tan pronto como empezaron a caer meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270304,
					"content": "Bueno, ve a echar un vistazo. <color=#00E1FFFF>Si no encuentras nada, ven a verme</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270305,
					"content": "Tal vez pueda recordar algo más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
