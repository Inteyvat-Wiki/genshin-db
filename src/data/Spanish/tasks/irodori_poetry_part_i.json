					"nextDialogs": [
						726910302
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910302,
					"content": "Ya las tenemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "¡Espléndido! Muchas gracias. A ver... ¡Oh! ¡Nunca he visto nada parecido! Y... ¡esta imagen es maravillosa! Esta también es espléndida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910304,
					"content": "#Amig{F#a}{M#o}, ¡estas imágenes son una auténtica inspiración! Mil gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910305,
					"content": "He intentado escribir algunos versos diferentes inspirándome en las imágenes que me trajeron. Pero todavía no sé qué verso utilizar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910306,
					"content": "Siento curiosidad por saber cuál utilizarías tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
