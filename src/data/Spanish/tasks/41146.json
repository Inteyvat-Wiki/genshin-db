				{
					"id": 411460101,
					"content": "Iré a entregarlo ahora mismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411460102
					]
				},
				{
					"id": 411460102,
					"content": "Muchas gracias. Ese sitio está muy lejos, y no tenemos personal suficiente para llevárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460103,
					"content": "Por cierto, ten cuidado cuando lo entregues. <color=#00E1FFFF>No corras muy rápido ni uses el Planeador, y ni hablar de escalar</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460104,
					"content": "Si recibe demasiados golpes en el camino, la salsa de carne y la pasta podrían deshacerse... y, si eso sucede, no creo que el cliente lo acepte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
