			"dialogs": [
				{
					"id": 735200101,
					"content": "¿Han decidido comprar mi información?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Humm... Paimon tiene un poco de curiosidad por la información exclusiva de la que hablas, ¡pero primero necesitamos saber el precio! Si es exagerado, olvídalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "¡El precio para ustedes será de tan solo un millón de Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "¡Qué caro! ¡Olvídalo! ¡Con un millón de Moras se puede comprar un montón de comida deliciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Un momento, déjame ver... ¡Vaya! La pequeña Paimon es mi clienta número 1001 de hoy. ¡Solo por eso, la información valorada en un millón de Moras será tuya gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "¡¿Eh?! ¡Paimon no sabía que tenía tanta suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Espera, no será un truco para gastar más, ¿verdad? Algo así como que la primera frase es gratis y la segunda tiene un precio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "¡Si no lo quieres, no hay problema! Siguiente cliente, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "No, no, no. ¡Paimon no ha dicho nada! ¡Cuéntanoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "¡Muy bien! ¡Parte uno de la información exclusiva de Dori! ¿Recuerdan la corona de la sabiduría?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Paimon recuerda que solo el campeón tiene derecho a portar la corona. ¡Parece ser muy valiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Así es, la corona que Sachin donó a la Academia de Sumeru es una antigüedad muy valiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Sin embargo, tras haberla recibido en donación, ¡la Academia de Sumeru perdió una vez esa corona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "¿Eh? ¿Cómo es que no hemos escuchado hablar de eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Jeje... Si lo supiera todo el mundo, ¿seguiría siendo información exclusiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Además, esta información no carece de fundamentos, pues también cuento con un testigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "Hay un joven llamado Kashmer al sur, si les interesa, pueden ir a preguntarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "La contraseña es “aquello de hace veinte años”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
