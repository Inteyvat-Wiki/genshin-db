					"Kashmer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "Aquello de hace veinte años.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "... Supongo que no debí habérselo contado a nadie. La vez pasada bebí demasiado y hablé más de la cuenta, y ahora no para de venir gente a preguntarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200205,
					"content": "Ya que tienen curiosidad, se lo contaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200206,
					"content": "Hace veinte años yo no era más que un niño de seis años, así que no recuerdo con claridad lo que ocurrió en aquel entonces. Pero hace poco leí un diario que escribí de pequeño que me hizo recordar vagamente lo ocurrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200207,
					"content": "Ese año también se celebró el Campeonato Interescolar, que constó de tres rondas, la última de las cuales se celebró fuera de la ciudad. Le rogué a mi madre que me llevara a verlo, pero como se negó, me escapé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200208,
					"content": "Y entonces, ¿qué pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200209,
					"content": "Me perdí fuera de la ciudad. Estaba en medio de la nada y no había nadie. Cada vez estaba más asustado y empecé a llorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200210,
					"content": "Fue entonces cuando vi unas extrañas criaturas... No recuerdo qué aspecto tenían. Solo recuerdo que al verlas dejé de llorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200211,
					"content": "Extrañas criaturas... podrían ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200212,
					"content": "(Los aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Esas criaturas me llevaron al lugar de la competición. Por desgracia, cuando llegamos ya era demasiado tarde y ya había terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200214,
					"content": "Justo entonces, cuando estaba desanimado, vi a una de esas extrañas criaturas arrastrando lentamente una corona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200215,
					"content": "La corona era preciosa. Brillaba a la luz de la luna, y no pude evitar seguirla. Vi a la pequeña criatura esconder la corona en el agujero de un árbol antes de desaparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200216,
					"content": "Quería ir a tocar la corona. Pero justo en ese momento oí a lo lejos la voz de mi madre. Resulta que se había dado cuenta de que había desaparecido y pidió ayuda a los vecinos para encontrarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200217,
					"content": "Nunca llegué a tocar la corona... hasta que crecí y vi la corona de la sabiduría en el Campeonato Interescolar. En ese momento, me di cuenta de que parecía ser la misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200218,
					"content": "Bueno... ¿Y recuerdas dónde quedó esa corona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200219,
					"content": "Probablemente acabara en el Bosque Avidya, pero he ido a buscar varias veces y no he encontrado nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200220,
					"content": "Nadie me creería aunque se lo contara. Desafortunadamente, ni siquiera yo lo recuerdo con claridad. Quizá fuera un sueño que tuve de niño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200221,
					"content": "#Humm... {NICKNAME}, ¿vamos a echar un vistazo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
