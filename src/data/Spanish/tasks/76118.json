			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180102,
					"content": "¿Es solo Paimon, o tú también percibes un olor delicioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180104,
					"content": "¡Colombina se está dando un banquete ella sola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180106,
					"content": "Parece que alguien lo está pasando en grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "¿Les gustaría comer un poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180108,
					"content": "No, no, come tú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Qué raro verte comer aquí... ¿Saliste fuera para comprar todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Me lo trajo Lauma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180111,
					"content": "Vaya, qué bien te cuida, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "Con la condición de que no me vaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180113,
					"content": "¡¿Cómo?! ¿No es eso un soborno para que aceptes un arresto domiciliario? ¡Y ni siquiera es tan bueno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "También me trajo algunos libros interesantes y juguetes de lo más exquisito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180115,
					"content": "Ahora suena como si fuera una madre que tiene que irse de viaje de negocios y dejar a su hija en casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "¿Lauma te ha explicado por qué lo hace?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Solo me dijo que no saliera por el momento y que evitara especialmente a los Descendientes Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180118,
					"content": "Les pregunté a los animales que vinieron a traerme la comida, pero Lauma les ordenó mantener silencio, y eso hicieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180119,
					"content": "Vaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Si tuviera que adivinar, diría que está preparando algo que guarda relación conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180121,
					"content": "No se preocupen, quedarme aquí no me resulta aburrido. La comida está deliciosa, es justo lo que quería. No poder salir no es ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180122,
					"content": "Y si los Descendientes Lunaescarcha realmente están preparando algo... Bueno, más razón para no interrumpirlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180123,
					"content": "¿Quieres que vayamos a preguntar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Sí, a Paimon también le ha entrado la curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "#Pueden hacerlo, pero deberían estar preparad{F#a}{M#o}s para la respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180126,
					"content": "Seguramente sepa que van a venir a verme, así que no creo que les diga nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		},
