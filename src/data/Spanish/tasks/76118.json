					{
						"sceneId": 3,
						"position": [
							1803.217,
							240.145,
							10366.37
						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "¡¿Que quieren restaurar la estatua de Kuutar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180302,
					"content": "Exacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180303,
					"content": "Ya no es la Kuu{RUBY#[S]Doncella Lunar}tar sin alas que solo podía contemplar en solitario la luna de más allá del cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180304,
					"content": "Fuimos testigos de cómo desplegó sus alas, y sabemos que ha recuperado la libertad de vivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180305,
					"content": "Por lo tanto, es justo que la estatua también sea restaurada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180306,
					"content": "¡Esa sí que es una buena idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180307,
					"content": "¿Ya lo has hablado con los Descendientes Lunaescarcha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "Sí. Les hablé del sacrificio de la Diosa Lunar y de su retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180309,
					"content": "Y también de cómo nos enfrentamos a la fuerza que contamina este mundo bajo la guía de esa luz gentil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180310,
					"content": "Como todos estaban tan extasiados con su retorno, aproveché la oportunidad para transmitirles los pensamientos de Colombina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180311,
					"content": "Que quería vernos como una familia, y que le gustaría que nosotros la tratáramos de la misma forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180312,
					"content": "¿Y qué dijeron?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180314,
					"content": "Nuestra señora la Diosa Lunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Zirnytsia"
				},
				{
					"id": 761180315,
					"content": "¿No estaríamos... excediéndonos al considerarla como parte de la familia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Lauha"
				},
				{
					"id": 761180316,
					"content": "Tengo fe en que eso es lo que Colombina verdaderamente desea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180317,
					"content": "(¡La Cantalunas se ha referido a nuestra señora la Diosa Lunar directamente como “Colombina”!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Kunegunda"
				},
				{
					"id": 761180318,
					"content": "Espero que aún recuerden las palabras que pronuncié no hace mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180319,
					"content": "“El camino debe pavimentarse con la verdad, y debemos hacerlo nosotros mismos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180320,
					"content": "No les exigiré que tomen la misma decisión que yo, pero sí que tengo algo que me gustaría que escucharan hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180321,
					"content": "“Si deseamos que la luz de la luna permanezca con nosotros, deberemos primero abrir las puertas que se mantuvieron antes cerradas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180322,
					"content": "... Bueno, eso fue lo que pasó. Considerando todo lo ocurrido durante los últimos días, las cosas han salido mejor de lo que pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180323,
					"content": "Srta. Lauma, ha llegado un nuevo lote de piedra al almacén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 761180324,
					"content": "Muy bien, iré enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180325,
					"content": "¿Podrían mantener en secreto lo que les he contado y han visto por ahora? Me gustaría que fuera una sorpresa para Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180326,
					"content": "Paimon sabe que tienes buenas intenciones, pero está claro que a ti y a los demás les encantan las sorpresas... incluida a la Diosa Lunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180327,
					"content": "Mis labios están sellados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "Eh, Lauma, Paimon quería preguntar sobre su soborno... Esto, Paimon quiere decir... ¿No tendrán alguna vianda de la luna de sobra por ahí, verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180329,
					"content": "Sí, claro. Vengan, dejen que les prepare un poco. Ah, y hay otro asunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
