					"nextDialogs": [
						761180507
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180507,
					"content": "Ese par de alas hace que parezca más completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180508,
					"content": "Ese es el regalo que queremos darte los Descendientes Lunaescarcha, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "Para celebrar a nuestra diosa, que ahora puede volar con libertad y cuyos dedos pueden por fin rozar el lugar al que llama “hogar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "... La antigua Colombina solo recordaría la confusión que sintió al nacer al contemplar esta estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180511,
					"content": "Pero ahora, lo que siento es la calidez del hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180512,
					"content": "Tal vez, al igual que esta estatua, he elegido quedarme aquí a pesar de que ahora tengo alas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180513,
					"content": "... Gracias a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180514,
					"content": "Te hemos preparado otro regalo, pero tendrán que caminar un poco más conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "¿Eh? ¿Hay otra sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "Mis compañeros y yo hemos organizado un sencillo banquete de bienvenida en el bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "A partir de ahora, este también será tu hogar, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Cuando eches de menos tu hogar, podrás quedarte aquí y disfrutar de nuestra hospitalidad, por sencilla que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "Por supuesto, eso haré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180520,
					"content": "Fíjense... Ha salido la luna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "En marcha, pues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
