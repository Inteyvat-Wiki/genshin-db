			},
			"dialogs": [
				{
					"id": 761180401,
					"content": "Ah, ya están de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180402,
					"content": "¿Sabes qué, Colombina? ¡Tenías razón, Lauma no nos dijo nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "Aunque parece estar bastante ocupada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "Así que te haremos compañía durante los próximos días. ¡Tú solo relájate y mantén esas expectativas bien altas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "¿Expectativas de... qué exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180406,
					"content": "#¡Arg!... N-nada, ¡nosotr{F#a}{M#o}s no sabemos nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "#Jeje... Está bien, entonces me centraré primero en tener expectativas de estos días que pasemos junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180408,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 761180409,
					"content": "¡Ah, ya viene la comida! Eh... ¿Dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 761180411,
					"content": "Dice que ha llegado el momento. ¿Saben a qué se refiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180412,
					"content": "Aaaah, Paimon ya lo entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Colombina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "¿Sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180415,
					"content": "Normalmente llevas un velo sobre los ojos, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Sí, ¿qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180417,
					"content": "Y aun así puedes usar el kuuvahki para ver el mundo exterior, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "Así es. De hecho, puedo percibir las cosas con más claridad de esa manera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180419,
					"content": "Bueno... Entonces, ¿podríamos pedirte que intentaras no percibir esos cambios fuera por el momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "¿Para que sea una sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761180421,
					"content": "Parece que ya has adivinado lo que se traen entre manos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Está bien. Entonces, ¿podrías llevarme de la mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
