			"dialogs": [
				{
					"id": 750230201,
					"content": "#¡Mira, {NICKNAME}! Aquí hay un Daguerrotipo y unos decorados de escenario. ¿Crees que será un lugar de rodaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230202,
					"content": "Pero estas casas son tan pequeñas... ¡Te hacen ver gigante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230203,
					"content": "Mmm... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230204,
						750230207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230204,
					"content": "Qué diminutos los humanos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230205
					]
				},
				{
					"id": 750230207,
					"content": "Están bien para el tamaño de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230208
					]
				},
				{
					"id": 750230205,
					"content": "Grrr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230206,
					"content": "#Jeje, ahora sí que somos megafamos{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230208,
					"content": "¿En serio? Paimon no quiere vivir en esas casas, ni siquiera tendría espacio para estirarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230239,
					"content": "Un tipo de Natlan se une a la conversación con total naturalidad...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230209
					]
				},
				{
					"id": 750230209,
					"content": "¡Ey, hola! ¿A ustedes también les interesa la kinografía? Ay, ¡pues ayúdenme a poner de moda este nuevo arte de la kinografía en toda Natlan! ¡Mi nombre es Akatanga, encantado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230210
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230210,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230211,
					"content": "#¡Qué contento te has puesto, {REALNAME[ID(2)|SHOWHOST(true)]}! ¿Acaso te interesa la kinografía que quiere rodar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230212,
					"content": "¡Grrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230213,
					"content": "¡Qué buen ojo tienes, pequeñín! Sinceramente, ¡todo esto está montado para que un Tepetlisaurio se convierta en una superestrella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230214
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230214,
					"content": "Pero por desgracia, mi amiga se llevó al Tepetlisaurio. Tuvimos una gran discusión porque teníamos ideas diferentes y al final se llevó a mi actor más importante... *Suspira*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230215
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230215,
					"content": "No debí trabajar con amigos. No solo he fracasado en el proyecto, sino que también he perdido a una amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230216
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230216,
					"content": "Pero no pasa nada. Ahora ha venido a mí un Tepetlisaurio. Mira lo animado que está, ¡seguro que será todo un éxito y se convertirá en una celebridad de la noche a la mañana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230217
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230217,
					"content": "¿Qué les parece? Si me ayudan a terminar esta auténtica obra acrónica, ¡se lo agradeceré generosamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230218,
						750230219
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230218,
					"content": "#Si a {REALNAME[ID(2)|SHOWHOST(true)]} le interesa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230221
					]
				},
				{
					"id": 750230219,
					"content": "Suena a una estafa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230220
					]
				},
				{
					"id": 750230220,
					"content": "Bueno, puede que no se haga famoso de la noche a la mañana, pero al menos recibirán una remuneración por su ayuda. Así no pierden nada, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230221
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230221,
					"content": "Podemos ayudarte pero aún no sabemos de qué trata la kinografía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230222,
					"content": "La idea que tengo es la siguiente:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230223
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230223,
					"content": "*Bzzz*. *Boing, boing, boing, boing*. La luz blanca deslumbrante se desvanece y en la tribu aparece un visitante perfectamente redondo pero con una parte puntiaguda. *Brzz, brzz*. Tras quedarse un rato en la hierba, empieza a oler a quemado. “¡Ah! Es el emisario de Xibalbá”, toda la tribu estaba aterrada. *Boing, boing, boing, boing*. “¡Viene a por nosotros! ¡Esa criatura sin dientes ni colmillos quiere devorar nuestra tribu!”.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230224
					]
				},
				{
					"id": 750230224,
					"content": "#Justo cuando el villano estaba a punto de entrar en la guarida de la tribu... *Pam, pam*. ¡Un héroe que llevaba un pañuelo rojo atado en la cola aparece de la nada! “¿De dónde ha salido?”. Sus garras más duras que la obsidiana pueden romper cualquier piedra, pero la piel de su enemigo era tan elástica que parecía más rígida que la roca. “La probabilidad de que {REALNAME[ID(2)|SHOWHOST(true)]} salga victorioso es...”.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230225
					]
				},
				{
					"id": 750230225,
					"content": "“¡GRRR!”. Más que un rugido de furia, era un grito estridente. Incluso estremeció a la malvada criatura sin colmillos. Tras la tremenda llama que escupió, se oye un estruendo ensordecedor, seguido de una ola de calor más ardiente que el flogisto líquido. La malvada criatura sin colmillos se desvanece. “¡Quema! ¡Quema!”. Las repercusiones del ataque arrasan con la tribu que ha sobrevivido.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230226
					]
				},
				{
					"id": 750230226,
					"content": "El héroe que llevaba un pañuelo rojo atado en la cola se había marchado sin dejar rastro, al igual que nadie supo cómo había llegado.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750230227,
					"content": "¿Qué tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230228
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230228,
					"content": "¡Grrr! ¡Grrr, grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230229,
						750230231
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230229,
					"content": "¡Quería ver obras como estas! ¡Es fabulosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230230
					]
				},
				{
					"id": 750230231,
					"content": "Qué obra más... especial. Me cuesta un poco entenderlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230232
					]
				},
				{
					"id": 750230230,
					"content": "¡Lo sabía! ¡Sabía que a alguien le gustaría este estilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230232,
					"content": "Ah, es que escuché a gente de fuera decir que la diferenciación es una buena estrategia para competir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230233,
					"content": "#Paimon no entiende mucho de esto, pero con que a {REALNAME[ID(2)|SHOWHOST(true)]} le guste, está bien. ¿Qué es lo que tenemos que hacer exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230234,
					"content": "Es bastante sencillo. El primer paso es colocar los atrezos. Tienen que <color=#00E1FFFF>poner el barril y el Cebo Elemental en un lugar adecuado</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230235
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230235,
					"content": "El barril está para sorprender, mejor que quede en el <color=#00E1FFFF>centro de la escena</color>, pero sin tapar al protagonista ni el decorado de las casas. El Cebo Elemental quedaría mejor en la <color=#00E1FFFF>dirección de la entrada del antagonista</color>, es decir, al costado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230236
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230236,
					"content": "#Cuando todos los actores hayan llegado, tendrían que estar preparad{F#as}{M#os}. {REALNAME[ID(2)|SHOWHOST(true)]}, el héroe que lleva un pañuelo rojo atado a la cola, ¡entra en escena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230237
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230237,
					"content": "Cuando la trama lo requiera, ustedes <color=#00E1FFFF>guiarán al antagonista hasta el barril</color>. Después, se marcharán de inmediato y <color=#00E1FFFF>destruirán el barril</color> desde una distancia segura. ¡Eso sería todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230238
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230238,
					"content": "¡Me muero por ver cómo quedará la obra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
