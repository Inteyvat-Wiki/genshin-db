					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akatanga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750230301,
					"content": "¿Necesitas que te repita los pasos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230302,
					"content": "Dímelo otra vez, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "Primero tienen que colocar los atrezos. El barril lo tienen que colocar en el <color=#00E1FFFF>centro de la escena, pero que no tape al protagonista ni los decorados</color>, y el Cebo Elemental en la <color=#00E1FFFF>dirección que en la que aparece el antagonista</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230304,
					"content": "Después, cuando llegue el momento, tienen que <color=#00E1FFFF>guiar al actor hacia el barril</color>, alejarse hasta una distancia segura y <color=#00E1FFFF>destruir el barril</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230305,
					"content": "No hace falta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "Lo dejo en sus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
