			"dialogs": [
				{
					"id": 750230701,
					"content": "¡Grrr! ¡Grrr, grrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "De acueeerdo, sé paciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230703,
					"content": "La verdad es que me asusté por el pequeñín. Para que todo fuera más realista, puede que me haya pasado un poco con los explosivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230704,
					"content": "... ¿Un poco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "Gruuu... Grrr, grrr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "En fin, con esta experiencia, sabremos cómo hacerlo mejor para la próxima. Muchas gracias por su ayuda. ¡Veamos cómo quedó la kinografía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230709,
					"content": "Para su sorpresa, en la kinografía no estaba ni el héroe que llevaba un pañuelo rojo atado en la cola, ni el malvado enemigo que hacía *brzz, brzz*, ni escenas de explosión que te dejaban sin aliento, sino la cara cambiante de Akatanga...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "¿Me convertí en el protagonista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230711,
					"content": "Felicitaciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "¡Algo va mal! Acaso es el Daguerrotipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230714,
					"content": "La verdad es que es la primera vez que uso un Daguerrotipo, ¿acaso me equivoqué y lo usé del revés?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230715,
					"content": "Qué gracioso. ¡Todo nuestro esfuerzo ha sido en vano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230716,
					"content": "Gruuu... Gruuuuuu... Grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} también estaba deseando verlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230718,
					"content": "Lo siento, lo siento, ¡fue culpa mía! Consideremos lo de antes como un ensayo. Ahora va la kinografía de verdad. ¡Me esforzaré al máximo para que sea la mejor kinografía que se haya visto nunca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230719,
					"content": "Gruuu... ¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "Ay, con lo ilusionado que estás, Paimon dará por hecho que estás de acuerdo. Esperemos que esta vez no haya ningún contratiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230721,
					"content": "Siguen el mismo procedimiento que antes y al fin obtienen el resultado deseado...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "¡Impresionante! ¡Ha salido perfecto! Tengo que decir que ha superado mis expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230723,
					"content": "Fue como coser y cantar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "Además de la recompensa acordada, les daré esta imagen como recuerdo. *Suspira*, debo decir que es una de mis obras maestras y por supuesto, no habría sido posible sin su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230726,
					"content": "#¡Guau! ¡Mira qué poderoso te ves, {REALNAME[ID(2)|SHOWHOST(true)]}! ¡Sales guapísimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230727,
					"content": "¡Grrr! ¡Grrr, grrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} también está de acuerdo, jeje. Pues todos contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230724,
					"content": "¿Dónde está nuestra remuneración, director?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "¿Sabes usar un Daguerrotipo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "Hasta a mí me pareció peligroso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
					"id": 750230707,
					"content": "¡Eso! ¿Y si alguien se lastima o se prende un incendio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
