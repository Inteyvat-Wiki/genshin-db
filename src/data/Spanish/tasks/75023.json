			"dialogs": [
				{
					"id": 750231201,
					"content": "Oye, ¡el antagonista que te has buscado no es un profesional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750231202,
					"content": "¡Shh! ¡Silencio! ¡Vamos a empezar el rodaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231203
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231203,
					"content": "“Es imperdonable... Descansen en paz, amigos. Oh, qué tragedia... No puedo evitar que se me caigan las lágrimas al ver cómo la t{RUBY#[D]hermanos}ribu fue derrotada”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231204
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231204,
					"content": "“Pero ahora no es el momento de llorar. Hoy me enfrentaré al emisario{RUBY#[D]Xólotl} quemado y me vengaré de una vez por todas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231205
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231205,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231206
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231206,
					"content": "El rostro de la fiera sin dientes ni colmillos no mostraba ninguna expresión, parecía tan indiferente y sosegado como las famosas calavandas de aquellas tierras lejanas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231207
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231207,
					"content": "¿Que cómo era? Pues un rostro de una crueldad tan despiadada que tras engullir unos tatacos con extra de picante volcánico, se mostraría indiferente. Era verdaderamente aterrador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231208
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231208,
					"content": "“¡Juro que esta vez te morirás del arrepentimiento!”, dijo la gran bestia que llevaba un pañuelo rojo atado a su cola mientras escupía su “Poderosa bola de fuego asada” que había practicado mil veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231209
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231209,
					"content": "¡Ahora es el momento! ¡Guíen al Slime Electro hacia el barril y destrúyanlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231210
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231210,
					"content": "¿Ahora? ¿Esa tal “Poderosa bola de fuego asada” saldrá de ese barril?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750231211,
					"content": "Paimon siente que algo va mal... Pero bueno, lo haremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
