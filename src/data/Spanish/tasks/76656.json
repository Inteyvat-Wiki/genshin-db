			"dialogs": [
				{
					"id": 766562001,
					"content": "#Hola, {NICKNAME} y Paimon. Gracias a su ayuda, he terminado los ajustes de los robots que encontraron la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562002
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562002,
					"content": "¡Oh, ya están todos aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562003,
					"content": "Por ahora no he encontrado ningún nuevo error, pero sí se me ha ocurrido una nueva idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562004
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562004,
					"content": "#{NICKNAME}, cuando vayan a buscar los otros robots, ¿podrían fijarse en cualquier comportamiento peculiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562005,
					"content": "¿De qué tipo de comportamiento hablas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562006,
					"content": "Tal vez... ¿interacciones entre ellos? Quizás sea más evidente cuando hayamos encontrado suficientes robots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562007
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562007,
					"content": "Oh... ¡Déjalo en nuestras manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562008,
					"content": "¡Se lo agradezco mucho! Ahora les marcaré la siguiente zona en el mapa.",
