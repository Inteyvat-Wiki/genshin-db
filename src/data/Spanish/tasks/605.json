			"dialogs": [
				{
					"id": 6050201,
					"content": "Hicieron un buen trabajo con la defensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050202,
					"content": "Nosotros nos encargamos del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050203,
					"content": "Capitán Kaeya, Swan está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6050204,
					"content": "¡Oye! Yo estoy perfectamente, eres tú el que tiene la pierna mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050205,
					"content": "Swan, Lawrence, vayan a la Iglesia de Favonius a que los curen. No se sobreesfuercen, nosotros nos encargamos de esta zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050206,
					"content": "Pero, Sr. Diluc, ¿usted no había dejado los Caballeros de Favonius hace mucho tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050207,
					"content": "Sí, pero ellos no son los únicos que pueden defender esta puerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050208,
					"content": "El Sr. Diluc... tan amable como siempre. Si un ciudadano quiere ayudar, ¿quiénes somos nosotros para decirle que no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050209,
					"content": "Entendido. ¡Muchas gracias por su ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050210,
					"content": "Sí, gracias, de verdad. Estaremos de vuelta pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6051104,
					"content": "Ahora que tengo un poco de tiempo, voy a aprovechar para hacer unas pociones y dárselas a los soldados. ¡Seguro que les serán de ayuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 6051105,
					"content": "Bien pensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051106,
					"content": "Aun así, ten cuidado. No creo que pase nada, pero si te encuentras en un apuro, huye hacia un lugar seguro de inmediato y no te preocupes por el frente de batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051107,
					"content": "¡Sí, entendido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sacarosa"
				}
			]
		},
