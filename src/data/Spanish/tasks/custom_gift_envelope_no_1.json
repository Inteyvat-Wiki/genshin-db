			"dialogs": [
				{
					"id": 715330101,
					"content": "... Humm, creo que así tampoco... Estas felicitaciones son demasiado complicadas de hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Mika, ¿estás preparando una felicitación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#¿{NICKNAME}? ¡Qué casualidad verte por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "¿Viniste a Liyue a celebrar el Rito de la Linterna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "¿Eh? No, no, vine para entregar una carta. Que sea ahora el Rito de la Linterna es solo una casualidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Antes de venir, la Caballera Klee me dijo que le haría mucha ilusión recibir una felicitación del Rito de la Linterna... Por eso he querido comprar una de paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Pero no pensaba que tendría que prepararla yo mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "Llevo mucho rato con esto, pero siempre me sale una felicitación un poco rara... y no sabría decir dónde está el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}, tú que has visto de todo... ¿podrías darme algún consejo sobre cómo preparar una felicitación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Déjame pensarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
