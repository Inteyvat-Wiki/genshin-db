							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Han venido en el momento adecuado, ¡échenme una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "¿Nos acabas de leer la mente? ¡Alucino!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Justo Galvaryet nos había enviado para ayudarte, ¿cómo lo has sabido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "Ah, porque solo ustedes ofrecen ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "... Cierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "El trabajo es muy fácil. Las terminales de investigación requieren que dos personas hagan la operación al mismo tiempo. Ya introduje los comandos, lo único que tienen que hacer es ir a mover la palanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "Casi se me olvida, el almacenador de energía está por aquí cerca. Instálenlo primero antes de activarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "Me gustaría asegurarme también de que no son matadores mecánicos o algo por el estilo, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "Bueno, depende de qué es para ti un matador mecánico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "¿Por qué lo preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "Una vez le pedí ayuda a Galvana y en cuanto aparté la mirada por un momento, se había cargado la terminal. Le pregunté qué es lo que había pasado, pero le era imposible explicarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "Hasta que su hermana me contó que no hay creación mecánica que pueda salir viva de sus manos durante más de medio día. Yo diría que hasta el propio Alain Guillotin le miraría con ojos de desamparo si estuviera aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "Además, los costes de reparación corrieron de mi cuenta. Si sucede lo mismo con ustedes, entonces en vez de ganar Cupones crediticios, tendré que pagarles por trabajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "#¡Vaya! Paimon no sabía que había ocurrido algo así. Tranquilo, ¡no seremos como ella! ¡Confía en nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "Pues lo dejo en sus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "Si la terminal de investigación me ataca, entonces lo soy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "Pero no trabajamos gratis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Luego le pido a Galvaryet que les solicite una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "¿Eh? Ella nos dijo que te la pidamos a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "¿Ah, sí? Pues nada. Solicitar algo de presupuesto aquí es más complicado que en el Instituto de Ciencias de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
		{
			"id": 7403003,
