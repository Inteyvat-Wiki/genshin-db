					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "Son muy hábiles. Si estuviéramos en un lugar como este, me habría gustado contratarles como ayudantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300402,
					"content": "Jaja, no es nada. Por cierto, ¿para qué es este dispositivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300403,
					"content": "Antes, había una grieta que conducía hacia el exterior y esa salida necesitaba ser vigilada por alguien. Ahora, con el dispositivo de cierre, no necesitaremos más personal para hacer ese trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300404,
					"content": "Esta tecnología no es nada nuevo en Fontaine, pero para contribuir algo, hice algunas modificaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300405,
					"content": "El que están viendo ahora no es la versión más completa, ese está en el túnel de geoda. *Ejem*, creo que estoy hablando mucho. Olvídenlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300406,
					"content": "El túnel de geoda también tiene salida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "#Sí, ¡qué list{F#a}{M#o}! Pero si lo piensas un poco más, esas palabras te las podrías haber guardado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300411,
					"content": "En fin, el problema ya está resuelto. Galvana no tiene que venir a vigilar más aquí y yo puedo descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300412,
					"content": "Casi se me olvida, esta es su recompensa. Gracias por su trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300408,
					"content": "¿La versión completa es más potente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "Pues claro, esa tiene más componentes. ¿Por qué preguntas tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300410,
					"content": "#Si quieren saber más sobre la versión completa, pueden probarlo. Pero si l{F#a}{M#o}s atrapan, ¡no digan que les he incitado yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
}