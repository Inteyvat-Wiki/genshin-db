	"talks": [
		{
			"id": 102402,
			"completionStepIds": [
				102402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102402",
							"2"
						],
						"stepId": 102402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "*Puf, puf*, Paimon está muerta de cansancio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "De no ser porque al salir de la Casa Dorada vimos la Cámara de Jade pasar sobre nuestras cabezas, no sabría ni dónde estamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "*Puf*, ¿llegamos a tiempo? ¿El Señor del Vórtice está todavía en el mar? No destruyó Liyue, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "¿Qué están haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "¿Eh?... ¡Espera, es el Adeptus! ¿Qué haces en la Cámara de Jade? Paimon pensó que estabas marchando contra las Siete Estrellas... ¿Se acabó la pelea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "Ante una calamidad de tal magnitud, los Adeptus y las Siete Estrellas han acordado dejar de lado sus diferencias de momento y unirse contra este enemigo común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10240207,
					"content": "¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Escultor de la Luna"
				},
				{
					"id": 10240208,
					"content": "Oh, ya veo ... Entonces, ¿cómo planean defender a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "Guau... De solo ver al Señor del Vórtice desde lejos, Paimon tiene un mal presentimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "No solo tú. Los nuevos reclutas de la Geoarmada están aterrorizados. Al parecer, los mortales no pueden aguantar ver a un dios antiguo amenazante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10240211,
					"content": "¡Por eso mismo debemos detener a ese monstruo antes de que se acerque más a Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keching"
				},
				{
					"id": 10240212,
					"content": "¿Así que la Guerra de los Arcontes se libró hace dos mil años contra enemigos como ese? Eso sí que da miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "Entonces, ¿el poder de las Siete Estrellas, la Geoarmada y los Adeptus será suficiente para detener a ese dios marino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "Lo hemos estado discutiendo, y francamente... es poco probable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10240216,
					"content": "¡¿Qué?! P-pero se supone que todos ustedes son los guardianes de Liyue. ¡Debe haber una forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "Solo hay una forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10240218,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "La Balista Guizhong atrajo la atención de las Siete Estrellas, quienes la inspeccionaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10240220,
					"content": "El destino quiso que sus constructores, los Adeptus, estuviéramos aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10240221,
					"content": "¿Qué podrían aprender los mortales de los mecanismos de los Adeptus? Pero basta con unas modificaciones en la ballesta para convertirla en un arma formidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Preservadora de Nubes"
				},
				{
					"id": 10240222,
					"content": "Jeje... Supongo que deberíamos estar agradecidos por esta bendición de los Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10240223,
					"content": "Que así sea, usaremos la Balista Guizhong mejorada para luchar contra ese dios. Todos los Adeptus aquí deberán prestar su fuerza para manejarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 10240224,
					"content": "No tenemos tiempo que perder, ¡es ahora o nunca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				}
			]
		},
		{
			"id": 102408,
