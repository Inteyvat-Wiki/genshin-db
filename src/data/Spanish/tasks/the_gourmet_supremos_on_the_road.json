			"trigger": {
				"objectNames": [
					"¿?",
					"Julie",
					"Parvaneh",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "¿Qué puedo hacer por ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000202,
					"content": "Disculpa, ¿tú quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Soy Kamei Munehisa y estoy de paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000204,
					"content": "Guau... Este tipo se viste como un samurái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "¿U-un samurái? ¿Es un samurái del shogunato? Escuché que la postura del shogunato hacia los forasteros es un poco... sutil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000207,
					"content": "No se preocupen. Dejé el shogunato. Ya no soy un samurái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000208,
					"content": "A menudo vengo aquí en busca de comida. Pero hoy, noté que había monstruos deambulando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000209,
					"content": "Se han llevado toda la comida de este lugar, así que tuve que derrotarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000210,
					"content": "¿Sueles venir aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Por lo general, no hay muchos monstruos por aquí. A menudo vengo para recolectar frutas o cazar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000217,
					"content": "Bueno, eso es todo lo que tengo que decir. Después de derrotar a esos monstruos, los demás no se atreverán a venir por un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000218,
					"content": "Si también buscan comida, pueden buscar por aquí. Solo recolecté lo que necesito. Debería quedar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000219,
					"content": "Bueno, adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000220,
					"content": "¿Se fue así sin más? Se comporta exactamente como un samurái del que oí hablar antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "¿Pero qué quiere decir que dejó el shogunato? Los samuráis que dejan el shogunato son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "Son como los enemigos con los que nos hemos topado antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Sí, también escuché que algunos samuráis que abandonaron el shogunato vagan y roban a la gente en las calles para ganarse la vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Aunque no parece un mal tipo, será mejor que estemos atentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "Muy bien, muy bien. ¿No estamos aquí para buscar ingredientes? Pero a juzgar por la situación actual, será mejor que no vayamos muy lejos, por si se pone peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "#Est{F#a}{M#e} viajer{F#a}{M#o} nos acompañó durante mucho tiempo. Debe estar cansad{F#a}{M#o}. Cocinemos algo aquí, descansemos un poco y luego volvamos a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "El tipo dijo que aún quedan ingredientes, ¿no? Echemos un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Como los Samurái Kairagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "¿Tú los derrotaste a todos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Sí, son solo monstruos ordinarios, nada difícil de lidiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000214,
					"content": "¿Por qué buscas comida en la naturaleza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 728000216,
					"content": "Tengo mis propias razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "¿?"
				}
			]
		},
		{
			"id": 7280003,
