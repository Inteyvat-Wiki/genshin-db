			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Julie",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Iba a buscar algunos ingredientes frescos... En fin, esto servirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "Lo siento. Quería cocinar un buen plato para ti, pero ahora supongo que tendremos que conformarnos con esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "Está bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "Gracias por acompañarnos. “No hay problema” no es una respuesta aceptable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "Lo recordaré y te invitaré una buena comida la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "¿Está lista la sopa, Julie? Recuerda no dejar que Parvaneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "No, no, ¡deja la sopa en paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "Está bien. Estoy sazonando esta sopa según mi receta mejorada. Solo estoy añadiendo un poco de condimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "No entiendo tu receta mejorada. ¡Detente! ¡Xudong, Xudong, rápido, ven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "¡Parvaneh! ¡Oye! ¿Qué clase de condimento extraño estás poniendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "¿Condimento extraño? ¡Esta es mi salsa especial! ¡Este es el resultado de mi investigación de tesis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "¡No quiero algo así! ¡Comamos algo ordinario hoy! ¡Julie, detenla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "¡Hum! ¿Y tú qué sabes? Está bien, haré algunos ajustes. Haré un condimento multiusos que hará cualquier plato delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "Un condimento multiusos... ¿De verdad existe algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "Nadie lo ha logrado, por eso lo voy a hacer yo. ¡Les mostraré a esos incrédulos engreídos de la Academia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000318,
					"content": "Jaja... Bueno, espero ese día con ansias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000319,
					"content": "#Por cierto, viajer{F#a}{M#o}, gracias por ir y venir con nosotros todo este tiempo. Te lo agradezco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000320,
					"content": "Te prepararé comida para llevar. Hay que tener suficiente comida cuando uno se aventura por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000321,
					"content": "La próxima vez que nos encontremos, te invitaré un buen plato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000306,
					"content": "Te buscaré para que me cocines un festín a la próxima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "Jaja, de acuerdo. Te tomo la palabra. Me aseguraré de invitarte a comer algo delicioso la próxima vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}