			"dialogs": [
				{
					"id": 120230501,
					"content": "La Isla Watatsumi está finalmente en paz, y todo gracias a Su Excelencia, Sangonomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "¿Pasó algo últimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "¿Últimamente? Humm, déjame pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Bueno, lo más importante para nosotros es que por fin podemos volver a salir al mar a pescar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Durante el enfrentamiento, el mar estaba lleno de barcos de guerra. Teníamos que conformarnos con los pocos peces y camarones que podíamos conseguir cerca de la costa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Cuando la pesca no era buena, todos pasábamos hambre. Los pobres niños lloraban sin parar, pero no había nada que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "Nos íbamos a la cama hambrientos y dábamos vueltas toda la noche, tratando de mantener la calma hasta la mañana. Al menos las cosas están mejorando ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "#He oído que eres {F#la capitana}{M#el capitán} del Escuadrón Pez Espada n.º 2, ¿cierto? Bueno, gracias por tu servicio. ¡Toma, ten un pescado! Lo acabo de capturar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "No, no podemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "¡Vamos, tómalo! Sin ti, probablemente seguiríamos pasando hambre esta noche. Su Excelencia siempre nos enseña a devolver la amabilidad con gratitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Está bien, gracias. Vamos, {NICKNAME} hablemos con los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
