				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "Parece que todo está en su lugar para la fiesta, pero todavía tengo que dar un discurso rápido antes de que comiencen las celebraciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Oh... ¿Cuánta energía se necesita para eso? ¿Crees que tienes suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "No te preocupes, tengo de sobra. Gracias a ustedes dos, me recuperé más rápido que de costumbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "¡Genial! Te estaremos animando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "¡Sean todos bienvenidos! Hoy es el día en que celebramos nuestra victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Recientemente, nuestra guerra con el ejército de la Shogun llegó a su fin, y finalmente presenciamos la abolición del Decreto de captura de Visiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "Ninguno de nosotros sabe cómo será la Inazuma del futuro, pero mañana me reuniré con la Comisión Tenryou para las conversaciones de paz. Les doy mi palabra de que me esforzaré por conseguir la paz para la Isla Watatsumi de una vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Gracias a todos por sus valientes esfuerzos todo este tiempo. Solo a través de su esfuerzo hemos sido capaces de prevalecer en esta difícil guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "Este festín se celebra en honor a todos y cada uno de ustedes. Espero que todos puedan relajarse y disfrutar de la victoria que tanto nos costó conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "¡¡Hurra!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "Parece que todo salió bien esta noche, me alegro mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#La gente suele ser más abierta cuando está de buen humor. ¿Puedo pedirte que te des una vuelta para ver qué información puedes reunir, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "Todavía no tengo más pistas sobre la posible alianza entre la Comisión Tenryou y los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "Me preocupa que pueda ocurrir algo en las conversaciones de paz de mañana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "De acuerdo, iremos a preguntar por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202302,
			"completionStepIds": [
				1202303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
