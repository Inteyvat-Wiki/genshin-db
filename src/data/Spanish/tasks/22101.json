			"dialogs": [
				{
					"id": 221010101,
					"content": "Esto no tiene fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "Abrir una posada en este lugar no es nada fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010104,
					"content": "Será mi imaginación, pero recientemente hay más monstruos en los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010105,
					"content": "No se acercan a la posada, pero temo por nuestros huéspedes. Ni siquiera la Geoarmada puede protegernos en todo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010106,
					"content": "Si tiene tiempo, ¿puede echarle un ojo a los alrededores y hacerse cargo de los monstruos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010107,
					"content": "Yo me hago cargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "¡Jaja! ¡Me gusta su franqueza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010113,
					"content": "#Perdón por involucrarl{F#a}{M#o} en este lío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010114,
					"content": "No se preocupe, cuando termine, le daré una buena recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010115,
					"content": "Le estoy agradecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010108,
					"content": "¿Qué hace una posada en un lugar como este?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "Sí, debimos haber sabido en qué nos estábamos metiendo cuando elegimos esta ubicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010111,
					"content": "Pero sin esta posada, ¿dónde pasarían la noche los viajeros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010112,
					"content": "Es agotador, pero alguien tiene que hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
