			"dialogs": [
				{
					"id": 221010201,
					"content": "¿Y bien? ¿Se deshizo de los monstruos de alrededor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010202,
					"content": "Aún no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "No hay prisa. Como mucho, esos monstruos molestan a los viajeros que están de paso. No se atreverían a entrar a la posada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "Y aunque cuatro o cinco tuvieran el valor de entrar, yo podría lidiar con ellos. Los huéspedes pueden estar tranquilos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "¡Jaja! Para gestionar una posada en un lugar como este hay que saber pelear, no es nada fuera de lo común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
