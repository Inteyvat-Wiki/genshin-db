			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mikika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Qué panda de insensatos... ¡Han vuelto a perder un montón de paquetes! Ya les avisé de que tenían que concentrarse durante el reparto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350102,
					"content": "¿Ha ocurrido algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Algunos de los mensajeros se niegan a hacerme caso y han perdido los paquetes que debían enviar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350104,
					"content": "*Suspira*, ¿es que no se dan cuenta de que están dañando la reputación de los Retoños Arbóreos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350105,
					"content": "Si se dedican a los envíos, que lo hagan bien. Si les toca atravesar una pendiente, que la bajen como una persona normal y no se pongan a juguetear como críos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350106,
					"content": "Se lo he repetido mil veces, pero esos jóvenes no me hacen ni caso. Solo buscan pasarlo bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350107,
					"content": "*Suspira*, ahora tendré que mandar a alguien a recuperar los paquetes. A ver, ¿quién tendrá tiempo ahora?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350108,
					"content": "Yo podría ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "#¿Tú... estarías dispuest{F#a}{M#o} a ayudarme? Eso sería increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350110,
					"content": "No podré encontrar a nadie que me ayude en un buen rato y, si voy yo mismo, no quedará nadie que pueda vigilar la Casa Comunal de Mensajería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350117,
					"content": "No te preocupes, tampoco pretendo que busques una aguja en un pajar. Conozco las rutas que suelen tomar esos muchachos, así que puedo adivinar el lugar aproximado donde perdieron esos paquetes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350118,
					"content": "Marcaré en el mapa los lugares en los que probablemente perdieron los paquetes. ¡Cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350111,
					"content": "¿Son muy grandes esos paquetes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "No. Pero precisamente por eso son más difíciles de encontrar. *Suspira*, qué panda de descuidados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350113,
					"content": "#... Si tienes tiempo, ¿estarías dispuest{F#a}{M#o} a ayudarme a recuperar esos paquetes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350114,
					"content": "No tenemos suficiente personal en la Casa Comunal de Mensajería ahora mismo. Si voy yo mismo, no quedará nadie para vigilar el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350115,
					"content": "Claro, sin problema. Yo me ocupo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "¡Genial! ¡Muchas gracias, de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Mikika"
				}
			]
		},
