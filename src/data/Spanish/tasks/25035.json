			"dialogs": [
				{
					"id": 250350801,
					"content": "Dos... tres... Están todos. Perfecto, has encontrado todos los paquetes perdidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350802,
					"content": "... Un momento, ¿no tenía que enviar Tundama este paquete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Mikika"
				},
				{
					"id": 250350803,
					"content": "Aquí tienes la recompensa. Gracias por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Mikika"
				},
				{
