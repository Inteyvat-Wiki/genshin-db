							-137.177,
							452.96,
							10019.38
						],
						"pointId": 8646
					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "Paimon no se esperaba que Coco nos fuera a traer a un lugar como este. Esta extraña fortaleza es como el lugar en el que te conocimos, Bona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330102,
					"content": "Miren, hasta hay un mural idéntico, aunque... humm... Este no lo han borrado, ¿será porque está en un sitio muy alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}, ¡mira! Parece el rey pitón del que nos habló Bona. ¡Y parece un tipo muy malo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330104,
					"content": "Así es, este es el rey pitón Och-Kan. Cuenta la leyenda que, para construir el Tonatiuh, oprimió a su pueblo y llamó la atención del Abismo, lo que condujo a su muerte y a la caída de su reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330105,
					"content": "Pero bueno, solo es una leyenda. Al fin y al cabo, hasta los cuentacuentos de mi tribu tienen toda clase de versiones en cuanto a cuál fue el final del rey pitón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330106,
					"content": "¡A lo mejor hasta se encuentra deambulando por el Tonatiuh y alimentándose de tesoros! ¡O quizás el dragón malvado que no para de interponerse en nuestro camino sea su espíritu resentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330107,
					"content": "Gluuu, ñiii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330108,
					"content": "Ay, qué miedo. ¡No digas esas cosas, que hasta Coco tiene miedo ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330109,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} tiene pinta de estar deseando hacer algo desde que derrotamos al dragón. ¿Será que está haciendo una competición de aventuras con Coco sin que nos demos cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330111,
					"content": "Bueno, volviendo al tema, ¿dónde está ese altar que tenemos que encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330112,
					"content": "Si Coco está en lo correcto, está aquí abajo... Espera, ¿abajo? Pensé que estaría en un sitio aún más alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330113,
					"content": "¿Se habrá equivocado en algo? No creo que el Altar del Fuego Primigenio esté escondido en el corazón de la montaña. Si no, la montaña tendría que derrumbarse para que pudiéramos llegar hasta el cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330114,
					"content": "¿Habrá algún método de teletransportación especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "#Oye, cuando estábamos abajo, nos juraste que sabías lo que hacías, pero ¿y ahora qué? Además, nosotr{F#a}{M#o}s no entendemos lo que dice Coco, así que dependemos completamente de ti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330116,
					"content": "Gluuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330117,
					"content": "¡Grrr! ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, ¿sabes algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330119,
					"content": "Paimon, creo que entiendo lo que quiere decir. ¡Dice que la lógica convencional no nos servirá de nada en esta aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330120,
					"content": "¡Otra vez te inventas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330121,
					"content": "¡Que no! Mira, haya lo que haya ahí abajo, creo que vale la pena ir a investigar. Además, es parte de la aventura, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330122,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} sí que está entusiasmado... Bueno, está bien, investiguemos cómo podemos bajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
