			"dialogs": [
				{
					"id": 751330301,
					"content": "#¡Se ha abierto! ¡Y todo gracias a que {REALNAME[ID(2)|SHOWHOST(true)]} encontró el mecanismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, eres el mejor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Pero tampoco nos confiemos. ¡Seguro que aún nos esperan muchos retos en el camino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Ahora que hemos abierto una entrada, tenemos que bajar y averiguar de qué va todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Estoy de acuerdo, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "Ñiii... ¡Ñiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330308,
					"content": "Coco, ¿no quieres hacerlo? ¿Es que tienes miedo? No podemos acobardarnos ahora, ¡a nuestra aventura aún le falta para terminar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "Gluuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330310,
					"content": "Bona, tampoco fuerces a Coco de esa manera... Mírale, se ve que tiene miedo. ¿Y si es porque ahí abajo hay algo superpeligroso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "¡Qué miedo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Eh, {NICKNAME}, ¿a qué viene ese miedo ahora? ¡Vamos, sé como {REALNAME[ID(2)|SHOWHOST(true)]} y muestra un poco de entusiasmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "Estoy deseando ver qué nos espera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "#¡Qué entusiasmad{F#a}{M#o} estás tú también, {NICKNAME}! Aunque, la verdad, Paimon no cree que ahí abajo haya nadie que sea rival para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "#No hay de que preocuparse, tenemos con nosotr{F#a}{M#o}s a un saurio muy valiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "Grrr... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Si Coco tiene tanto miedo, puede quedarse aquí. Ay, no... No podemos dejarlo solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "En fin, qué remedio... De acuerdo, Coco y yo nos quedaremos aquí, y para demostrarles que pueden confiar en mí, tomen, les doy la pirofosforita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330319,
					"content": "Sea lo que sea que encuentren, por favor, ¡tienen que volver conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330320,
					"content": "Jamás abandonaríamos a una compañera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330321
					]
				},
				{
