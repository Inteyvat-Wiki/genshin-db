	"talks": [
		{
			"id": 1201702,
			"completionStepIds": [
				1201702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201702",
							"2"
						],
						"stepId": 1201702,
