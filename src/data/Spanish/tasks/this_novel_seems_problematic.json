				"objectNames": [
					"Yuzu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "Hola, ¿qué se les ofrece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Disculpe, ¿ha leído «El espíritu marcial»?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "¿Eh? Sí, lo he leído. Antes me gustaba mucho, pero últimamente... ¿Cómo explicarlo? El argumento se ha vuelto un poco extraño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "Cada vez que se enfrenta a un enemigo, al protagonista de repente le aparece un nuevo poder que justamente sirve para vencerlo y acaba con él en un instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "Una de las razones principales por las que me gustaba «El espíritu marcial» era que el protagonista tenía que usar la cabeza para derrotar a sus enemigos. Pero ahora... me da una sensación de pereza por parte del autor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Además, el protagonista solo usa una vez la mayoría de sus poderes. No tiene mucho sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "No sé qué tendrá pensado hacer el autor de la novela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "*Ejem*, mejor vayamos a preguntar a otras personas, esto debe ser una excepción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201304,
