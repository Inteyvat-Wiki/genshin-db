						220130602
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130602,
					"content": "¿Qué te pasa? ¿Te ha comido la lengua el gato? ¿Qué dijeron los lectores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "Junkichi... Al fin te has enfrentado a la opinión de los lectores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "Jamás lo hubiera imaginado... ¿Cómo puede ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Acaso mis ideas... Mi forma de escribir... ¿No atraen a la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "¡Te lo dije! ¡Simplemente añadir nuevos poderes todo el rato es un método arriesgado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130607,
					"content": "Incluso si momentáneamente obtienes nuevos seguidores, se cansan pronto y se aburren el doble que antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "Esa es mi experiencia después de muchos años en este campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130609,
					"content": "E-está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130610,
					"content": "Lo bueno es que aún estamos a tiempo de enderezar el rumbo. Ya no podemos cambiar las opiniones de los capítulos anteriores, pero al menos tendremos más seguridad en los siguientes capítulos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130611,
					"content": "#Gracias, viajer{F#a}{M#o}. Junkichi necesitaba que le ayudaran a comprender sus errores. Si hubiera seguido como siempre, habría organizado un lío aún mayor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130612,
					"content": "Muchas gracias por tu ayuda. Esta recompensa es para ti.",
					"roleType": "TALK_ROLE_NPC",
