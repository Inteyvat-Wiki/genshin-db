			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "¿Has leído los comentarios de los lectores o no? ¡Últimamente las valoraciones son pésimas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "¡Que no cunda el pánico! Solo es el silencio antes de la explosión de popularidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "¡Cuando escriba la historia clave, nuestra reputación dará un giro de 180 grados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "¡Habrán cancelado tu novela antes de que llegue ese día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "¿Qué está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "#Ah, hola, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Tras obtener inspiración la última vez, Junkichi le ha vuelto a dar al protagonista de «El espíritu marcial» varios poderes muy exagerados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "La Editorial Yae ha recibido una gran cantidad de comentarios negativos. Los lectores no entienden de dónde salieron estos poderes y opinan que el autor escribe lo primero que le viene a la cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "¡Esos comentarios son completamente subjetivos! Si sigo escribiendo al ritmo actual, lo comprenderán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Y por eso, antes de que a los lectores les dé tiempo a comprenderlo, se habrá cancelado tu novela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "¡Ya es suficiente! Recuerdo que por aquí cerca debe haber varias personas que han leído «El espíritu marcial»...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Si crees que tu idea gustará a los lectores... ¡Ve y pregúntaselo directamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "#¡Pues iré! ¡Seguro que me comprenderán! Viajer{F#a}{M#o}, ¿puedes acompañarme y actuar como testigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "#Sí, eso suena bien. Lleva {F#a la viajera}{M#al viajero} contigo. Así no podrás negar lo que digan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "Cuenten conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "De acuerdo, pues iremos ahora mismo. ¡Estoy seguro de que los lectores me comprenderán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "Pero ¿cuántas cosas has añadido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Eh... Solo unas pocas, de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "¿Unas pocas? ¡Si sigues así, el protagonista pronto tendrá más poderes que todos los personajes que han aparecido en la historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "*Ejem*, mejor vayámonos ya. ¡Estoy convencido de que los lectores me entenderán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
