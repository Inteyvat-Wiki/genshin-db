			"dialogs": [
				{
					"id": 752460384,
					"content": "#Tú eres {F#la}{M#el} mayor, así que empiezas tú, abuel{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460385,
					"content": "Acepto con gusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#¡Guau! ¡La competición se pone interesante! ¡{NICKNAME} realiza un movimiento experto y su caña sale del agua! Ha picado un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460302,
					"content": "Eh... Un... ¿Un Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460303,
					"content": "Impresionante... Acaba de empezar y ya ha pescado algo completamente inesperado. Esto es todo un desafío al sistema de puntuación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460304,
					"content": "#¡No esperaba menos de ti, abuel{F#a}{M#o}! Si nadie logra pescar algo aún más increíble, ¡parece que ya tenemos {F#a la campeona}{M#al campeón}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460305,
					"content": "¡Gracias, dignos oponentes! ¡Gracias, querido público! Tal y como ha dicho mi nieto, confío en que la victoria será mía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#¡Un comienzo impresionante para {NICKNAME}! ¡Será difícil que sus dos oponentes puedan superarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460307,
					"content": "¡Tu turno, Ifá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460308,
					"content": "¡Ánimo, colega! ¡Yo te echo una pata, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460309,
					"content": "Lo siento, Cacucu, pero no es el momento de trabajar en equipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460310,
					"content": "Cálmense, colegas... Un momento, ¡tengo uno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460311,
					"content": "Ifá tira de la caña con todas sus fuerzas. Parece que ha picado un pez grande.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "Sin embargo, lo que sale del agua es...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "Eh... El contendiente Ifá ha pescado un Koholasaurio... ¿y un acuibara que va detrás? Paimon no tiene ni idea de qué es todo esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460314,
					"content": "Increíble, siempre has tenido un gran recibimiento entre los animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460315,
					"content": "No, algo le pasa en la cola al Koholasaurio... ¿Acaso se le quedó atrapada entre las piedras del fondo y este acuibara intentaba ayudarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460316,
					"content": "O puede que el acuibara esté intentando comerse la cola del Koholasaurio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460317,
					"content": "¿Cómo va a ser eso, colega? Cacucu, ¿por qué no le preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460318,
					"content": "Sí, sí... ¡Correcto, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460319,
					"content": "¿Ves? Había acertado... No, eso no es lo que importa ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460320,
					"content": "Ifá examina rápidamente la cola del Koholasaurio. Por suerte, no es más que un rasguño superficial y no es nada grave.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "Tras desinfectar la herida y aplicarle un ungüento, el Koholasaurio y el acuibara se marchan juntos.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "Una nueva amistad. Parece que hoy también es su día de suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460323,
					"content": "¿“También”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460324,
					"content": "Sí, tengo el presentimiento de que voy a ganar. ¡Ahora me toca a mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460325,
					"content": "¡Yo te echo una pata, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460326,
					"content": "¿Dónde habrá aprendido eso?... Estás intentando darnos ánimos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460327,
					"content": "¡Cacucu es el animador jefe de la pesca!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "Esto es un combate, así que deberíamos llamarlo “animador jefe de lucha”. Así suena más grandioso... ¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460329,
					"content": "¡¿Qué es eso?! ¡Apártense, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460330,
					"content": "¡Otro acuibara! Aunque este parece diferente... ¿No decían que son de carácter noble? Entonces, ¿por qué ha cargado contra nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460331,
					"content": "Seguro que está luchando por algo importante... Sí, puedo sentirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460332,
					"content": "O... tal vez no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460333,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "Acuibara"
				},
				{
					"id": 752460334,
					"content": "Me parece que es con nosotros con quienes está enfadado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460335,
					"content": "¡Hola, querido coleguita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460336,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "Acuibara"
				},
				{
					"id": 752460337,
					"content": "¡Jaja! ¡Genial, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460338,
					"content": "¿Qu-qué está pasando? ¿Acaso Cacucu está intentando convencerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460339,
					"content": "Seguramente lo esté tranquilizando. No lo subestimen, Cacucu es todo un experto en lo que se refiere a calmar a los pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460340,
					"content": "Ah... Pero ¿podrá hacerlo con ese vocabulario tan limitado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460341,
					"content": "De todas formas, no puede comunicarse con un acuibara usando las palabras de los humanos, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460342,
					"content": "¡Oh, es verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460343,
					"content": "En una ocasión como esta, debemos confiar en nuestro colega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460344,
					"content": "Además, a mi parecer, si hablamos de comunicación, el tono pesa más que las palabras cuando se trata de persuasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460345,
					"content": "Por ejemplo, ahora, si digo “Hola”, significa que estoy alegre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460346,
					"content": "Pero si digo “Hola...”, es que siento frustración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460347,
					"content": "Y “¡Hola!” significa que estoy enfadado, lo que quiere decir que hay peligro inminente y que es mejor alejarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460348,
					"content": "Paimon no puede negar que tenga sentido, pero no acaba de entenderlo bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460349,
					"content": "Entendido. Gracias por tus enseñanzas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "¿En serio? ¡Qué bien! Yo suelo comunicarme así con las abejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460351,
					"content": "“Las abejas empleadas”, ¿recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460352,
					"content": "También hay abejas que no quieren ser empleadas. Yo las comprendo y respeto su decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460353,
					"content": "¿Y no puedes usar un poco de esa comprensión conmigo? Porque yo ya no sé cómo hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460354,
					"content": "¿De verdad? Porque yo creo que ahora deberías estar muy orgulloso. Mira ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460355,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "Acuibara"
				},
				{
					"id": 752460356,
					"content": "¡Jaja! ¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460357,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "Acuibara"
				},
				{
					"id": 752460358,
					"content": "¡Eh, eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460359,
					"content": "Parece que se entienden bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460360,
					"content": "Podré estar orgulloso, pero... ¿Eh? ¡Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460361,
					"content": "No te preocupes, tengo una idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460362,
					"content": "Hola, Rey Acuibara. ¿Te apetece comer algo? Estas galletas están recién hechas, las ha preparado Ifá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460363,
					"content": "Ruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "Acuibara"
				},
				{
					"id": 752460364,
					"content": "¿Rey Acuibara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460365,
					"content": "¡Se las ha comido! ¡Y parece la mar de contento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460366,
					"content": "¡Ay, ay, ay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460367,
					"content": "Por cierto, ¿no recuerdan que estábamos en una competición de pesca? ¡Esto está a punto de convertirse en un zoológico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460368,
					"content": "¿Y no es eso genial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "Paimon supone que sí... Entonces, el ganador de la competición es Ororon, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460371,
					"content": "Porque ha pescado a ese... Rey Acuibara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460372,
					"content": "Es un nombre muy apropiado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "Está bien, que gane Ororon. De todas formas, nadie ha logrado pescar un pez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460374,
					"content": "¡Jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460375,
					"content": "¡Genial, así me quedo yo con el hidromiel! Aunque ya era mío...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460376,
					"content": "Ya, pero también eres afortunado por poder quedártelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460377,
					"content": "Tienes razón, además hemos conseguido una recompensa extra. Miren, parece que el Rey Acuibara nos ha traído un regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460378,
					"content": "¿Un huevo de regalo reluciente y una imagen? El lugar de la imagen me resulta ligeramente familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460379,
					"content": "¿Acaso el Rey Acuibara nos está indicando que quiere que vayamos a ese lugar? Parece algún tipo de pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460380,
					"content": "No perdemos nada intentándolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "A mí también me lo parece. Podemos comprobar qué hay en ese lugar cuando tengamos tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460382,
					"content": "Espero que el Rey Acuibara nos tenga preparado algo increíble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "Sí, podría haber algo... Deberíamos ir bien preparados, por si acaso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460369,
					"content": "La cosa está muy animada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				}
			]
		}
	]
}