			"dialogs": [
				{
					"id": 752460101,
					"content": "#¡Mira, {NICKNAME}! ¡Ahí hay gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "¿Eh? Me resultan familiares...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "¡Ororon e Ifá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#Yo conozco esas voces... Son {F#la abuela}{M#el abuelo} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "¡Oh, colegas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "¡Cuánto tiempo! Veo que ustedes también han venido al resort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460107,
					"content": "Chasca mencionó que estaban trabajando aquí, ¡pero Paimon no imaginó que nos encontraríamos de repente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "Sí, el ambiente de este lugar es muy agradable. Parece que todos se lo están pasando en grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460109,
					"content": "Jeje, ¡Paimon espera que a este lugar le vaya viento en popa y que atraiga a más visitantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "¿Qué tal ustedes? ¿Todo bien con el trabajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Nada mal. Los empleados saurios y las abejas que nos han encargado cuidar se encuentran sanos y llenos de vitalidad. Por eso tenemos tiempo de dar un paseo por el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460112,
					"content": "... Empleadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "¿Cómo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460114,
					"content": "Las abejas empleadas. Los empleados saurios y las abejas empleadas. Te faltó esa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "¡Claro, colega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "*Suspira*... Lo siento. Bueno, le doy las gracias a todos los empleados y, claro está, al Sr. Ororon que se preocupa por ellos de forma tan... proactiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460117,
					"content": "Hemos llegado con unos días de antelación para luchar por una causa importante. Eso es una recompensa en sí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "Esta es la primera vez que este colega recibe una invitación tan formal, así que no te extrañará que esté tan... comprometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460119,
					"content": "Mostrar entusiasmo es algo bueno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#¿Ves? {F#La}{M#El} abuel{F#a}{M#o} también está de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Todos los días son importantes, pues nuestro trabajo diario consiste en luchar por lo que verdaderamente nos importa. Eso me lo enseñó Cacucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "¡Jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "Pero... Paimon diría que están pescando. ¿Acaso la pesca también cuenta como algo importante por lo que luchar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "¿Tú te estás escuchando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "Sí que es importante, porque fue un amigo quien nos dio la sugerencia. Se trata de un aventurero famoso de Mondstadt muy afortunado. Hacerle caso no puede traer nada malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(Ah... ¿Será Bennett?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "Ese colega le dio vueltas a una rama que acabó apuntando a este estanque. Ororon dijo que era mejor seguir a la suerte cuando te encuentra, y por eso vinimos a pescar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460128,
					"content": "Un momento, un momento... Aunque eso tuviera sentido, ¡el estanque está completamente rodeado de acuibaras! ¿Cómo pueden pescar aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Eso no es un problema. Los acuibaras son criaturas nobles y nada fieras, así que no necesitamos estar en constante alerta. Además, la abu me enseñó que si la vida te da agua, hay que pescar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "La abu también dice que cuando la vida te da comida, se debe comer, y que cuando la vida te da limones, haces limonada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460131,
					"content": "#Exacto, salvo porque ahora somos nosotros los que les estamos dando limones a ustedes. {M#Abuelo}{F#Abuela}, Paimon, ya que están aquí, ¿por qué no vienen con nosotros a pescar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "Quien pesque al pez más grande, se llevará una jarra del hidromiel de Ororon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460133,
					"content": "¡¿Cómo no lo has dicho antes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Jeje, parece que no saben a quién han provocado... ¡Ante un desafío, nunca nos rendimos! ¡{NICKNAME} será un{F#a} rival dign{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "¡Que comience el duelo, colegas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "¡Ese es el espíritu! Está bien, me apunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifá"
				},
				{
					"id": 752460137,
					"content": "¡Manos a las cañas, nieto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "Muy bien. El ganador se llevará todos los peces y el hidromiel de las empleadas abejas. ¡Es todo o nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
