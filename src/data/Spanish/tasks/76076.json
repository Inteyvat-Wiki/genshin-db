			"dialogs": [
				{
					"id": 760761101,
					"content": "#Hola, amig{F#a}{M#o}. Me alegro de volver a verte entre las tumbas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761102,
					"content": "Le describes a Flins las “lámparas del juramento” y las misteriosas inscripciones que había en ellas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "“Los vientos se despiertan y las hojas revolotean”... Es el juramento que hacen las personas al unirse a los Lampareros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761104,
					"content": "Los Lampareros siempre llevamos nuestra propia lámpara, y solo la descuidamos cuando no nos queda más remedio que hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761105,
					"content": "Me temo que una lámpara sin dueño es señal de infortunio; una tragedia que me llena de pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761106,
					"content": "Sin embargo, desde el momento en que hicieron su juramento, sabían que ese sería su inexorable destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761107,
					"content": "Si hay algo que podamos hacer por ellos, es recordar los juramentos que hicieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761108,
					"content": "“Portar lámparas encendidas con esperanza eterna”... Ese era su mayor deseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		}
	]
}