			"trigger": {
				"objectNames": [
					"Laila"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "Hemos conseguido mucha información relevante. Revisémosla e intentemos organizarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530802,
					"content": "Algunas cosas están muy claras, pero otras no tienen sentido alguno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530803,
					"content": "Deberíamos de ser capaces de averiguar más detalles sobre su identidad y su localización.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "Sí, déjame pensar y ver qué puedo hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530805,
					"content": "(Cálmate, Laila, aunque la información sea un caos, tú puedes hacerlo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530806,
					"content": "(Primero, intenta averiguar la identidad del Seelie basándote en las pruebas que tienes.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530807,
					"content": "(Después, analizamos dónde ha sido visto y por qué motivos... y, por último, lo ponemos todo junto...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530808,
					"content": "(De esta forma, deberíamos de poder predecir sus movimientos. Muy bien, intentémoslo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Laila"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Laila"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "Creo que lo tengo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530902,
					"content": "Cuéntame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "Primero, basándonos en la información que nos dio Katayún, podemos asumir que el Seelie es un estudiante de la Facultad Rtawahist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530904,
					"content": "Cualquier otra posibilidad puede ser descartada porque sería imposible tener acceso a esos dos libros sin pasar por la bibliotecaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530905,
					"content": "Después, dejando de lado sus habilidades excepcionales, todos los avistamientos tuvieron lugar en ubicaciones que la Academia ha recomendado oficialmente para la observación astrológica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530906,
					"content": "En otras palabras, probablemente esté realizando algún tipo de investigación cuya naturaleza es muy similar a la mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530907,
					"content": "La pregunta que planteé no era nada simple, pero obtuve una respuesta al día siguiente, lo cual implica que está familiarizado con áreas de conocimiento similares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530908,
					"content": "Así que, basándonos en estas hipótesis, todo lo que tendríamos que hacer es ir a esperarlo al siguiente punto de observación astrológica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530909,
					"content": "Qué bien razonado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "Ah, qu-qué va... De hecho, he estado barajando otras alternativas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530912,
					"content": "Pero eso no importa ahora. Vamos. Aunque tengamos algunas pistas, es difícil asegurar que vayamos a descubrir algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530913,
					"content": "Te lo contaré todo si al final el Seelie no aparece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Laila"
				},
				{
					"id": 191530910,
					"content": "Con esas capacidades de deducción, terminar tu tesis debería ser pan comido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}