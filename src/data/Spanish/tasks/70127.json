			"dialogs": [
				{
					"id": 701270101,
					"content": "“Si estás leyendo este mensaje, espero que seas a quien estoy esperando”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701270102,
					"content": "“He perdido la cuenta de qué numero de carta es esta. ¿Hasta dónde deambulará, y a qué costa llegará?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701270103,
					"content": "“Si alguna vez nos volvemos a encontrar, háblame una vez más sobre la ciudad montañosa de piedra y las tormentas nevadas del norte, o cuéntame sobre los dientes de león y el vino”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701270104,
					"content": "“Esperaré tu respuesta, como siempre he hecho”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Botella a la deriva"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
