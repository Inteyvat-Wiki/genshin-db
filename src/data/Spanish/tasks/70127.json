			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "“Si estás leyendo este mensaje, espero que seas a quien estoy esperando”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701270202,
					"content": "“Alguna vez creímos que la guerra era algo que solo sucedía en las leyendas y cuentos de hadas. Pero ahora, todos y cada uno de nosotros temblamos bajo la furia atronadora de Su Excelencia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701270203,
					"content": "“La playa a la que solíamos ir ha sido cerrada, pero aun así, encontré la forma de sacar esta carta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701270204,
					"content": "“No te preocupes, no es tu culpa. Para alguien como yo, que una vez fue de aventuras contigo, esto es solo una trivialidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Botella a la deriva"
				},
				{
					"id": 701270205,
					"content": "“Esperaré tu respuesta, incluso si escribes una sola palabra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Botella a la deriva"
				}
			]
		}
	]
