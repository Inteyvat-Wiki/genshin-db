					"Noelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "#Oh, ¡hola, Caballer{F#a}{M#o} Honorari{F#a}{M#o}! ¿Viene a buscar a la Maestra Jean? O tal vez... ¿hay algo en lo que pueda ayudarl{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "Estoy dando una vuelta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Estoy haciendo la limpieza rutinaria en la oficina de los Caballeros de Favonius. Ya casi he terminado de quitar el polvo, ahora solo me falta organizar los archivos antiguos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Esos documentos se han estado acumulando por mucho tiempo. Creo que si los archivo por categorías, será mucho más fácil para todos consultarlos después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Además, uno puede aprender mucho organizando estos registros de nuestros predecesores. Para mí, ¡es también una forma de entrenamiento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "Sigues siendo tan confiable y dedicada como siempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "Es mi deber. Además, tanto usted como los Caballeros de Favonius no dejan de progresar, y yo quiero alcanzarlos lo antes posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "Tu determinación merece ser recordada, Noelle. ¿Qué tal si te tomo una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "¿Eh? ¿A mí? ¡C-claro! Pero acabo de terminar de limpiar y estoy cubierta de polvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "¡Es precisamente a esta Noelle tan trabajadora a quien quiero recordar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "¡E-es demasiado pronto para llamarme “Caballera”! Pero si es lo que desea... ¡Será mi honor, aunque no esté arreglada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "¡Tómela cuando crea que sea el momento decisivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "¡Este es el “momento decisivo” de la Caballera Criada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "Eres fascinante, Noelle. ¡Déjame tomarte una imagen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "¿En qué andas ocupada últimamente, Noelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
