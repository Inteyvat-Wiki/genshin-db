				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800101,
					"content": "(Atrapemos al villano de la Aldea Vimara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800102
					]
				},
				{
					"id": 730800102,
					"content": "¡Hola, Alphonse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800103,
					"content": "#Son ustedes. ¿Qué ocurre, {NICKNAME}? Si están buscando a Rhana, ya se fue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800104
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800104,
					"content": "Queremos conversar contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800105
					]
				},
				{
					"id": 730800105,
					"content": "Sobre el villano que se esconde en la Aldea Vimara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800106
					]
				},
				{
					"id": 730800106,
					"content": "#Después de todo, {NICKNAME} le prometió a Rhana que se haría cargo de los villanos y por eso se sintió tranquila de viajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800107,
					"content": "Ya veo, entiendo. No tengo ni idea de qué están hablando pero no duden en preguntar lo que quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800108
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800108,
					"content": "Primero, analicemos la situación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800109
					]
				},
				{
					"id": 730800109,
					"content": "Veamos, ¿quién fue el primer niño que desapareció de la Aldea Vimara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800110,
						730800111,
						730800113,
						730800116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800110,
					"content": "Sudabeh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800119
					]
				},
				{
					"id": 730800119,
					"content": "Sí, Paimon ahora lo recuerda, ¡fue Sudabeh! Ella había oído sobre una hierba que podía mejorar la vista del Abuelo Amadhiah y se escabulló al bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800120,
					"content": "Así es. Estábamos tan preocupados que organizamos un equipo de búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800121
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800121,
					"content": "¡Oh, Paimon lo recuerda! ¡Rhana dijo que tú lo organizaste! Y que llevaste curri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800122,
					"content": "¿Quién le habló a Sudabeh sobre la hierba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800123
					]
				},
				{
					"id": 730800123,
					"content": "... Fui yo. Sudabeh es buena y se preocupa por el Abuelo Amadhiah. Una vez, hablando con ella, recuerdo haber mencionado el tema, pero también le dije que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800124
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800124,
					"content": "¡Paimon sabe! Sudabeh dijo que le aconsejaste no andar sola por el bosque. Ella se preocupa mucho por el Abuelo Amadhiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800125,
					"content": "¿Tienen más preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800126
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800126,
					"content": "Hum... ¿Quién fue el segundo en desaparecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800127,
						730800128,
						730800130,
						730800132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800127,
					"content": "Kavus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800135
					]
				},
				{
					"id": 730800135,
					"content": "Kavus dijo que iba al bosque a hablar con una amiga sobre la desaparición de su hermana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800136
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800136,
					"content": "Sí, eso fue lo que Kavus mencionó cuando le contamos la historia. Alphonse, ¿sabes quién era su amiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800138
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800138,
					"content": "¿Cómo podría saberlo? No encontré a Kavus ni a su amiga en el bosque. Y, como sabes, cuando regresó no recordaba nada, al igual que Sudabeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800139
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800139,
					"content": "¿Alguna otra pregunta? Después de eso, ningún otro niño desapareció.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800140
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800140,
					"content": "Paimon, pregunta algo más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800141
					]
				},
				{
					"id": 730800141,
					"content": "¿Eh? Bueno, *ejem*... Se supone que Iotham era el siguiente en desaparecer. Pero nosotros y Rhana lo encontramos y lo ayudamos a volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800142,
					"content": "¿Cómo pasó eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800143
					]
				},
				{
					"id": 730800143,
					"content": "Humm... Si Paimon mal no recuerda, dijo que escuchó a Alphonse decir que había unos champiñones enormes en las cuevas del bosque y quiso recolectarlos para Rhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800144,
					"content": "Entonces, un Fatui malo lo siguió y se asustó tanto que salió corriendo y terminó atrapado en la zona marchita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800145,
					"content": "¿Qué? ¿Estuvo en la zona marchita? ¡Eso es muy peligroso! ¿Cómo pudo pasar algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800146
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800146,
					"content": "#Esperen, si estuvo en la zona marchita, ¿cómo logró volver? Incluso {NICKNAME}, que puede dominar los elementos sin una Visión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800147
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800147,
					"content": "(Humm... ¿Deberíamos contarle a Alphonse sobre Arana?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800148,
						730800149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800148,
					"content": "(Sí, no hay problema.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800150,
					"content": "Alphonse, sabemos que es difícil de creer, pero en el bosque hay unas criaturas llamadas aranara. Son amigos de Iotham y los demás, por eso los aranara lo ayudaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800151,
					"content": "Aranara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800152
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800152,
					"content": "¡Pero los Fatui son realmente despreciables por meterse con unos niños!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800154
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800154,
					"content": "Hum, todavía no sabemos quién es el villano de la Aldea Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800155,
					"content": "Paimon, creo que alguien nos está observando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800156
					]
				},
				{
					"id": 730800156,
					"content": "¿Eh? ¿Dónde? ¿No será el villano que estamos buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800157,
					"content": "Ve a comprobarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800158
					]
				},
				{
					"id": 730800158,
					"content": "¿Paimon sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800159,
						730800160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800159,
					"content": "Si pasa algo, solo grita y yo iré enseguida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800161,
					"content": "#Hum, está bien. No es justo dejar todo en manos de {NICKNAME}. ¡Paimon se encargará de esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800162,
					"content": "Paimon se marcha entusiasmada.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730800163
					]
				},
				{
					"id": 730800163,
					"content": "¿Para qué molestarse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800164,
						730800165
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800164,
					"content": "Sería más feliz si no lo supiera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800166,
					"content": "Hablemos en otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800165,
					"content": "Es mejor no contarle algunas cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800160,
					"content": "Tú puedes volar y eres pequeña. Perfecta para explorar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800149,
					"content": "(Hay que contarle.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800128,
					"content": "Sudabeh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800129
					]
				},
				{
					"id": 730800129,
					"content": "No, no, ¿no acabamos de hablar de Sudabeh? Paimon recuerda que fue su hermano... Se llamaba Kavus, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800130,
					"content": "Iotham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800131
					]
				},
				{
					"id": 730800131,
					"content": "#Paimon no cree que sea correcto... Nosotr{F#as}{M#os} ayudamos a Iotham cuando se perdió. El segundo debe haber sido el hermano mayor de Sudabeh, Kavus, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800132,
					"content": "Changchang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800133
					]
				},
				{
					"id": 730800133,
					"content": "Espera, ¿Changchang no está en Liyue? ¿Qué tiene que ver esto con Changchang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800134,
					"content": "#¿Estás bien, {NICKNAME}? Paimon recuerda que el segundo niño fue el hermano mayor de Sudabeh. Se llamaba Kavus, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800111,
					"content": "Kavus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800112
					]
				},
				{
					"id": 730800112,
					"content": "Fue Sudabeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800113,
					"content": "Iotham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800114
					]
				},
				{
					"id": 730800114,
					"content": "¡No! Iotham fue el último en desaparecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800115,
					"content": "Fue Sudabeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonse"
				},
				{
					"id": 730800116,
					"content": "Timmie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800117
					]
				},
				{
					"id": 730800117,
					"content": "¿Timmie? No, ¡Timmie no tiene nada que ver en esto! ¿Él no está en Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800118,
					"content": "¿Quién es Timmie? Sudabeh fue la primera en desaparecer, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonse"
				}
			]
		},
