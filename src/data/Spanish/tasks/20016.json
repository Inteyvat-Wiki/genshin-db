			"dialogs": [
				{
					"id": 200160101,
					"content": "¿Alguien pidió comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "#¡Viajer{F#a}{M#o}! Llegas justo a tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Lo siento, sé que debes tener hambre, pero ¿podrías hacer algo por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "Ha habido un aumento constante en el volumen de pedidos de entrega recientemente. Tiendo a dividirlos por región y luego etiquetar cada plato con el nombre de la persona que lo pidió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Pero perdí la etiqueta de esta <color=#00E1FFFF>sopa de marisco</color>. Solo sé que es para alguien de Aguaclara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "¿Podrías llevar esta <color=#00E1FFFF>sopa de marisco</color> a Aguaclara y averiguar quién la pidió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Si tanto insistes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "¡Te aseguro que a tu regreso habrá comida abundante esperándote!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "¡Cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Solo vine a comer. ¡Muero de hambre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Una vez que hayas hecho lo que te pedí, ¡te invitaré algo del menú especial de El Buen Cazador! Es lo menos que puedo hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
