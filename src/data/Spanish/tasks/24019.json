			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Sanseacabó. Espero que se conformen con eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Estoy alimentando a los gaviones. Creo que ya han comido lo suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "¿Así que ahora te llevas bien con ellos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "¿Esta vez no han intentado robarte las papas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Pues no. Normalmente alguien viene a darles de comer, así que estos de color púrpura no parecen tener mucho interés en mis papas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "¿Eh? ¿Pero no decías que si te alejabas mucho del trabajo, podrías perderte algo importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Jajaja, hoy no tengo que preocuparme por esas cosas. Es mi día libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Aquí no hay compañeros que quieran parlotear sobre trabajo o malvados gaviones que quieran robarme mis papas... Es un lugar perfecto para descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "Estos gaviones son muy amistosos, ni han intentado robarme las papas fritas, ni han venido en bandada contra mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Los he alimentado yo mismo un par de veces, así que ya me conocen. Incluso si fuera y les acariciara las plumas, no creo que se resistieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "Incluso se los podría catalogar de señores en comparación con aquel horrible grupo del Palacio Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "Hasta podrían reemplazarnos en el trabajo si aprendieran a teclear en una máquina de escribir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "No veo yo a los gaviones trabajando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Bueno, al menos no harían las cosas más difíciles. Además, todos sabemos que hay cosas que los gaviones simplemente no saben hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "#Bueno, olvidemos eso por un momento. ¿Quieres hacerte amig{F#a}{M#o} de estos amigables señores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Ya ha empezado a llamarlos señores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "No creo que sea educado acercarme a ellos sin más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "No te preocupes, son muy amables. Aunque deberías evitar tocarles las plumas directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Toma, he preparado algo de pescado. Bastará con que lo dejes en el recipiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Y relájate, estos señores son muy comprensivos. Si los alimentas, empezarán a cogerte cariño enseguida. No te preguntarán de dónde viene el pescado ni cómo ha sido preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "¿Algún consejo antes de que lo intente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Ninguno en particular. Aunque deberías evitar tocarles las plumas directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Los gaviones no entienden nuestro idioma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Yo no estaría tan seguro. A lo mejor solo se están haciendo los locos. Tal vez su vida sea más fácil fingiendo que no nos entienden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
