						"pointId": 5568
					}
				]
			},
			"dialogs": [
				{
					"id": 240190301,
					"content": "¿Y bien? ¿Son o no son un grupo de educados señores? No tienen nada que ver con los del Palacio Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "Sí, han mantenido la etiqueta en todo momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "¿Verdad que sí? Aquí sentado me siento muy relajado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Imagínate que eres un gavión purpuráureo. Alguien viene a darte de comer cada día, así que solo tienes que preocuparte de tomar el sol y pensar en el sentido de la vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "*Suspira*, ¿por qué yo tuve que nacer funcionario administrativo en lugar de gavión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401908,
