			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "¡¿P-por qué lo has hecho?! Estos gaviones son buenos, ¡no se parecen en nada a las del Palacio Mermonia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Lo siento, fue un accidente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "*Suspira*, ni siquiera me ha dado tiempo a detenerte. ¿Por qué lo has hecho? ¿Es que te han atacado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "En fin, ahora ya no están, los has asustado. Volveré en un par de días con más comida para disculparme con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
