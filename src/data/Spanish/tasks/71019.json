			"dialogs": [
				{
					"id": 710190201,
					"content": "Hay una gran piedra sobre esa enorme maceta. Paimon cree que es una “rocalla”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "Pero ¿no suelen colocarse en jardines o patios? ¿Por qué la han puesto aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "¿Eh? Hay algo extraño en la parte superior de esta rocalla. Parece una marca de algún tipo... Paimon está confusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Bueno, ya que estamos de viaje, busquemos montañas que se parezcan a esta rocalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "Sería genial si encontráramos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
