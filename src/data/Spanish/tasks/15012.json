			"dialogs": [
				{
					"id": 150120501,
					"content": "Los monstruos me hicieron entrar en pánico y acabé yendo por un camino estrecho para evitarlos. No esperaba acabar topándome con esos bandidos... Menos mal que llegaron a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "¿Y llevabas esos cristales contigo mientras corrías? ¿Por qué no los tiraste si eran tan peligrosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Deseché muchos, créeme. De hecho, todo lo que queda es el trozo más puro del lote. Estoy decidida a traerlo de vuelta pase lo que pase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "Tengo que hacerlo por Tlazolli, y por la pobre y pequeña Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "¿Quiénes son ellas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "Ah, cierto, es normal que no las conozcas. Tlazolli... fue una vez artesana de nombres antiguos, y Nechca es su hija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "Cheven"
				}
			]
		},
