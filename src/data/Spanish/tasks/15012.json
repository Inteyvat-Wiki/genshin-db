			"dialogs": [
				{
					"id": 150120101,
					"content": "A-aún no ha regresado... ¿Le habrá ocurrido algo a la maestra Cheven?... *Snif, snif*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "Esa niña de allí está llorando. ¿Qué habrá pasado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "#{NICKNAME}, vayamos a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Hola, pequeña. ¿Qué te pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "*Snif*... Es... es la maestra Cheven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "D-dijo que iba a recoger unos cristales volcánicos... Pero aún no ha regresado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "Se lo conté a los guardias, pero me dijeron que ahora mismo no tienen personal suficiente y que el terreno es muy peligroso por allí, con muchos monstruos y tipos malos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Tienen que terminar los preparativos antes de intentar rescatarla... ¡Pero para entonces podría ser demasiado tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "#No te preocupes. Nosotr{F#a}{M#o}s nos encargamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "#¿Estás dispuest{F#a}{M#o} a ayudarme? ¡Bieeen! Un momento, te haré un dibujo del camino por el que se fueron los guardias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Dijeron que la maestra Cheven podría haber hecho una parada por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Puede que haya tenido que pasar cerca de la Sombraguja. Si es así, entonces ella... *Snif*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "¡Te lo ruego! ¡Ayúdame a encontrarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "#Parece que tendremos que ser l{F#a}{M#o}s {F#heroínas}{M#héroes} una vez más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
