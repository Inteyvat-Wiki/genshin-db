			"dialogs": [
				{
					"id": 150120401,
					"content": "Guau, qué manera de salir corriendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "A eso se le llama “ser consciente de la situación”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "#*Suspira*... Muchas gracias a l{F#a}{M#o}s dos. De no ser por ustedes, habría acabado cayendo montaña abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#Salvada por un{F#a}{M#o}s viajer{F#a}{M#o}s de paso... Hoy es mi día de suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Ah, disculpen, no me he presentado. Soy Cheven, una artesana de piedras preciosas con muy mala suerte. Bueno, hasta ahora, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "Imix nos pidió que viniéramos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Esa niña... *Suspira*, parece que he vuelto a preocuparla. Cuando salí de la tienda, pensé que volvería en dos días como mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Pero yo tampoco esperaba encontrarme con una veta nueva de cristal volcánico cerca de la Sombraguja... Y de una pureza y cantidad sin igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "Desenterré un montón y me disponía a volver, pero el flogisto de los cristales atrajo a los monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "#Supongo que ser famos{F#a}{M#o} tiene sus ventajas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
