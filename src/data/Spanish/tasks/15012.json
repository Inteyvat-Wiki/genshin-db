					"speakerTitle": "Cheven"
				},
				{
					"id": 150120827,
					"content": "En cuanto al regalo en sí... Mañana Tlazolli en persona les dirá de qué se trata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120823,
					"content": "¿Podría tratarse de un nombre antiguo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120824
					]
				},
				{
					"id": 150120824,
					"content": "¡Claro que no! La Arconte Pyro ya contactó con Xilonen para que la ayudara con ese asunto. ¡No hay necesidad de complicar las cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120825,
					"content": "Con un buen regalito normal tenemos suficiente, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120813,
