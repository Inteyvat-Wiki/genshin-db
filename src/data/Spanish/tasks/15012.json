			"dialogs": [
				{
					"id": 150120601,
					"content": "Pero bueno, supongo que habrás visto cómo está la zona de los alrededores, ¿verdad? Hace un tiempo, una Sombraguja colgaba desde lo alto, hasta que un día, de repente, cayó al suelo ocasionando un enorme cráter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120602
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120602,
					"content": "La veta que encontré estaba cerca del exterior y a duras penas sobrevivió, pero los monstruos de la zona se asustaron, y ahora hay monstruos enloquecidos por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
