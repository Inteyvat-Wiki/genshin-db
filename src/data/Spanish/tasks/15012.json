			"dialogs": [
				{
					"id": 150121301,
					"content": "Recuerdo que Xilonen también se dedica a eso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121302
					]
				},
				{
					"id": 150121302,
					"content": "Oh, ¿conocen a Xilonen? Jaja, si mencionas ese nombre delante de Tlazolli, el sol se pondrá antes de que termine de hacerle cumplidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121303
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121303,
					"content": "“La persona que más ha estudiado los nombres antiguos”, “el futuro de nuestra tribu”, “la artesana suprema”... Apuesto a que oirás esto y más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121304
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121304,
					"content": "Aunque Tlazolli no lo diga, sé que añora los días en que elaboraba nombres antiguos. Nunca lo reconocerá... pero se le nota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				}
			]
		},
