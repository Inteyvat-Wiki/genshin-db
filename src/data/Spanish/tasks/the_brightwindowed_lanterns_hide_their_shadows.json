			"dialogs": [
				{
					"id": 400400101,
					"content": "¡Vengan, acérquense a echar un vistazo! ¡Sean bienvenidos a ver la linterna de sombras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400102
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400102,
					"content": "¿“Linterna de sombras”? Paimon nunca ha escuchado hablar de eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400400103,
					"content": "Parece que ustedes dos tienen ganas de divertirse. ¿Les gustaría echar un vistazo a mi nuevo invento, la “linterna de sombras”? ¡Es muy interesante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400104
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400104,
					"content": "Funciona de manera muy simple. Solo tienen que girar los objetos dentro de la linterna y hacer que sus sombras se fusionen de cierta manera para revelar una imagen increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400106
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400106,
					"content": "Si te interesa, puedes intentarlo. Este es el dispositivo. Vamos, pruébalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400107
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400107,
					"content": "Espero que la linterna de sombras te muestre imágenes fantásticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400108
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400108,
					"content": "Suena muy divertido, ¡Paimon también quiere intentarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
