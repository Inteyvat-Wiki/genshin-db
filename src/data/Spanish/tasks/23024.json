			"dialogs": [
				{
					"id": 230240201,
					"content": "Inclínense para verla más de cerca. De esta manera, podrán apreciar los detalles con toda claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240202
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240202,
					"content": "Observas atentamente la rosa aún cerrada junto a los dos agricultores...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240203
					]
				},
				{
					"id": 230240203,
					"content": "Paimon no ve ningún cambio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240204,
						230240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240204,
					"content": "No veo ningún indicio de que se vaya a abrir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				},
				{
					"id": 230240206,
					"content": "¡Ay!... Quizás a la rosa le dé un poco de vergüenza florecer delante de ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240207,
					"content": "Pero según su patrón normal de crecimiento, debería florecer mañana a más tardar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240208,
					"content": "#Viajer{F#a}{M#o}, ¡vuelve mañana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240205,
					"content": "No siento las piernas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				}
			]
		},
