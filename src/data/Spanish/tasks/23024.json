			"dialogs": [
				{
					"id": 230240401,
					"content": "#Viajer{F#a}{M#o}, llegan en el mejor momento, ¡la rosa floreció por fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240402,
					"content": "Gracias a tu ayuda, esta rosa tiene el mejor aspecto que he visto nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240403
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240403,
					"content": "Muchas gracias, de verdad. Por favor, acepta esta pequeña muestra de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240404
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240404,
					"content": "¡Enhorabuena!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240405
					]
				},
				{
					"id": 230240405,
					"content": "¡La rosa floreció! ¡Qué alegría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "¡Menos mal! Ahora podremos enviar a tiempo el pedido del bimaristán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240407,
					"content": "Espero que esta rosa les sirva de ayuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
