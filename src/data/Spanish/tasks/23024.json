			},
			"dialogs": [
				{
					"id": 230240701,
					"content": "#Viajer{F#a}{M#o}, llegas en el mejor momento, ¡la rosa se abrió por fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240702
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240702,
					"content": "Gracias a tu ayuda, esta rosa tiene el mejor aspecto que he visto nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240703
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240703,
					"content": "¡Seguro que los médicos del bimaristán estarán encantados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240704
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240704,
					"content": "No hay tiempo que perder, la transplantaré en un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240705
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240705,
					"content": "Espera... ¿Qué fue eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240706
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240706,
					"content": "En el huerto estalla una gran conmoción...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240707
					]
				},
				{
					"id": 230240707,
					"content": "¡Por Los Siete! ¡Es una Megaflora! ¡¿Qué hace aquí?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240708,
					"content": "¡Maldición! ¡El huerto! ¡Quiere destruirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240709,
						230240710
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240709,
					"content": "¡Déjenmela a mí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				},
				{
					"id": 230240711,
					"content": "Eh... ¿Eh? ¿Cómo es que esa Megaflora escapó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240712,
					"content": "¿Cómo...? ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240713
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240713,
					"content": "Esta rosa es nuestra planta medicinal más importante... ¡¿Cómo pudo convertirse en un monstruo y salir huyendo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240714,
						230240715
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240714,
					"content": "No es que se haya convertido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240716,
					"content": "Quieres decir que... ¿la rosa crecía tan lenta por culpa de esa Megaflora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240717
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240717,
					"content": "Ahora que lo pienso, cuando abonamos sin resultado aparente... Cuando regamos usando el doble de agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240718
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240718,
					"content": "¡¿Lo que en realidad hicimos todo el tiempo fue cuidar de esa Megaflora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240719
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240719,
					"content": "Rayos... ¿Cómo logró mezclarse con las otras flores? ¡No nos dimos cuenta de nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240720
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240720,
					"content": "#A veces también consiguen engañarnos a nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240721
					]
				},
				{
					"id": 230240721,
					"content": "¡Ay! ¡Qué mala suerte hemos tenido! Todos los cultivos de alrededor quedaron destruidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240722
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240722,
					"content": "Tendremos que ir al bimaristán a explicar lo ocurrido y plantar nuevas rosas lo antes posible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240715,
					"content": "Puede que desde un principio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240710,
					"content": "¡Retírense!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
