				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "#Bienaventurad{F#as}{M#os}, por fin llegó el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900102,
					"content": "Ya dominan lo fundamental para elaborar su propio arreglo floral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900103,
					"content": "Y ahora, ha llegado el momento de que se enfrenten al auténtico reto del ikebana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900104,
					"content": "Espera, ¿ya dominamos lo más fundamental?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900105,
					"content": "Auténtico reto... ¡Paimon supone que te refieres al acertijo más complicado de todos! De pronto, Paimon tiene miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900106,
					"content": "P-pero todavía llevamos poco tiempo con el ikebana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "Es cierto que preparar los arreglos florales requiere mucha práctica, y también se necesita auténtico esmero e inspiración para diseñarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900108,
					"content": "En cuanto a esto último, han mostrado un talento sorprendente, no necesitan más acertijos para practicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900109,
					"content": "#Como amb{F#as}{M#os} están en un viaje increíble y han visto cosas que yo ni siquiera puedo imaginar, tal vez tengan esa capacidad extraordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900110,
					"content": "¿D-de verdad lo crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900111,
					"content": "Ahora que Paimon se para a pensarlo, la verdad es que hemos ido a muchos lugares... Nuestro viaje nos ha dado mucha inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900112,
					"content": "Ahora que Paimon lo piensa, tal vez hayamos consumido demasiada inspiración a lo largo de nuestro viaje para aprender bien el arte del ikebana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900113,
					"content": "Aún tenemos mucho viaje por delante, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "¡Tienes razón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900116,
					"content": "¡Gracias, Srta. Fushizome! Si no fuera por tus enseñanzas, ¡no habríamos descubierto que tenemos esta habilidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900117,
					"content": "Son muy amables. Bien, concluyamos esto con el arreglo floral más bello de todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900118,
					"content": "¡Dinos el acertijo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "El acertijo de hoy será...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900120,
					"content": "“Ramas como un arcoíris, estrellas multicolores”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900121,
					"content": "¡Espero con ansias su magnífico arreglo floral!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900122,
					"content": "Tengo cosas que hacer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "No hay problema, el ikebana precisa tener la mente serena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900124,
					"content": "Esperaré a que se ocupen de sus asuntos primordiales y se liberen de sus problemas. Así, podrán elaborar sus arreglos florales con más eficacia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900114,
					"content": "Ya obtendremos más inspiración.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
