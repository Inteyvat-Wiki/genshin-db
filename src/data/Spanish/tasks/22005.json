				{
					"id": 220050301,
					"content": "¿Lo encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050302
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050302,
					"content": "¿Es este?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050303
					]
				},
				{
					"id": 220050303,
					"content": "Veamos... no, no es ese. Este es mucho más ligero. Contenga lo que contenga, no es lo que busco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050304
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050304,
					"content": "De todos modos, buen trabajo. Seguiré buscando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050305
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050305,
					"content": "¿Dónde se habrá caído?",
					"roleType": "TALK_ROLE_NPC",
