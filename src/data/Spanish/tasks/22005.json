					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "¿Dónde estará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "¡Ah! ¿De dónde saliste? ¿Y por qué te acercas con tanto sigilo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "¿Que quién soy? Soy una... erudita. Estoy investigando la arquitectura antigua y las ruinas de la Llanura Guili. Puedes llamarme Bao'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "Pero estaba tan emocionada que perdí un paquete en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "#Dentro hay un valioso tesor... que diga, una reliquia. ¿Estarías dispuest{F#a}{M#o} a ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "¡Perfecto! Debió caerse cerca de aquí... o un poco más lejos. En fin, presta atención al buscarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "¿Qué tipo de paquete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "Es una caja cuadrada, como cualquier paquete común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "La puse en un paquete porque... ¡Porque así es más fácil de llevar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "Además, recubrí su interior con ropa para evitar que la reliquia se dañara. Por favor, apresúrate a encontrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "¿Qué tipo de reliquia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "En pocas palabras, se trata de una reliquia muy valiosa. *Suspira*, en fin, aunque te lo explicase, no lo entenderías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "Solo una persona como yo puede estimar su valor, así que, por favor, apresúrate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
