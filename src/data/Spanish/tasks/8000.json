				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "Parece... una persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000202,
					"content": "¿Será el Maestro Ladrón?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000203,
					"content": "¿Por qué está en esa postura? ¿Está rezando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000204,
					"content": "¡¿...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000205,
					"content": "Esa... Esa es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000206,
					"content": "¡Una Estatua de Los Siete!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "¿Por-por qué han colgado la Estatua de Los Siete boca abajo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000209,
					"content": "Además, las manos de la estatua... Paimon recuerda que normalmente sostienen un orbe, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000210,
					"content": "Pero... esta estatua... ¿qué está sosteniendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000211,
					"content": "Oh... Paimon tiene un muy mal presentimiento sobre esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000212,
					"content": "Y ese Maestro Ladrón no se ha movido ni un centímetro... ¿Cre-crees que ya está...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000213,
					"content": "¿Hola? ¿Se encuentra bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000214,
					"content": "(No mueve ni un músculo, ni se oye el sonido de su respiración.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					]
				},
				{
					"id": 80000215,
					"content": "... Está... Está muerto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000216,
					"content": "#{NICKNAME}, Paimon tiene un muy mal presentimiento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000217,
						80000218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000217,
					"content": "Este lugar es horrible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000219
					]
				},
				{
					"id": 80000219,
					"content": "¡Salgamos rápido de aquí! Hay que contárselo a Ganyu y a Lan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000220,
					"content": "¡Ahh! ¡¿Y ahora qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000218,
