				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "#Hola, querid{F#as}{M#os} amig{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110102,
					"content": "Ustedes son... ¿de la Guardia? ¿Nos buscan por algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110103,
					"content": "Jaja, intenten adivinarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110104,
					"content": "¿Acaso es porque saltamos por los tejados de la ciudad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "¡No puedo creer que hicieran tal cosa! No se apresuren en hacer declaraciones, ahora mismo registraré sus delitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110107,
					"content": "¡Era una pregunta trampa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110108,
					"content": "No se preocupen, estoy bromeando. Bueno, creo que deberíamos presentarnos. Yo soy Chênée y este es mi superior, Fréjus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110109,
					"content": "Recientemente, Fréjus inventó algo nuevo y quería que alguien lo probara, ¿les interesa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110110,
					"content": "¿Un invento nuevo? Paimon quiere saber de qué se trata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110111,
					"content": "Es una torreta que se puede controlar a distancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110112,
					"content": "Miren, las torretas antiguas necesitan a una persona que las maneje de cerca, lo que significa que si el enemigo apunta la torreta, estaríamos acabados. No obstante, si conseguimos controlar la torreta a distancia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110113,
					"content": "La cantidad de heridos disminuiría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110114,
					"content": "¡Así es! ¡No saben lo increíble que es Fréjus! ¡Hasta rechazó tres veces la invitación del Instituto de Ciencias de Fontaine! Y este invento... ¡No puedo creer que haya podido hacer algo tan increíble como si nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110115,
					"content": "¿Que rechazó tres veces al Instituto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110117,
					"content": "¡Así es! Le ofrecieron tres veces una generosa remuneración por su talento para llevar a cabo investigaciones de alto nivel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110118,
					"content": "Pero a Fréjus le encanta el trabajo en la Guardia, por eso se quedó aquí. ¡Es realmente conmovedor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110119,
					"content": "Aun así, ¡Fréjus no desperdicia su talento y de vez en cuando inventa cosas para resolver nuestros problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110120,
					"content": "¡Suena increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110121,
					"content": "Ejem. No es para tanto. Chênée, ¿recuerdas lo que te he estado enseñando? La gente inteligente valora más la humildad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110122,
					"content": "¡Sí, Fréjus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110123,
					"content": "En resumen, queremos pedirles el favor de evaluar la viabilidad de esta torreta de control remoto. El lugar y las dianas están ya preparados. En cuanto a la recompensa, seremos generosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110124,
					"content": "En ese caso, han dado con las personas adecuadas, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110125,
					"content": "#{NICKNAME} y Paimon han visto todo tipo de cosas durante sus viajes. ¡Somos l{F#as}{M#os} más indicad{F#as}{M#os} para comprobar si el invento funciona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110126,
					"content": "¡Confío en Fréjus y en ustedes! ¡Ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "Chênée"
				},
				{
					"id": 745110127,
					"content": "Bueno... Pasen por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréjus"
				},
				{
					"id": 745110105,
					"content": "¿Acaso es porque luchamos con espadas en la ciudad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}