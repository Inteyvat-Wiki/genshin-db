			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "Aprendes rápido. Esta bebida no está nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020302,
					"content": "¡Paimon está de acuerdo! ¡Tiene un sabor impresionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020303,
					"content": "Sin embargo, solo fue una práctica. En la vida real, algunos clientes tienen ciertas peticiones específicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020304,
					"content": "Algunos prefieren un sabor más fuerte, otros lo prefieren más agrio, los hay de todos los gustos. La clave está en ajustar los ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020305,
					"content": "¡Paimon quiere un vaso supermegagrande de Piñón caramelizado extradulce! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020306,
					"content": "Bueno, eso es todo. Aun así, además de dominar las técnicas de coctelería, un excelente cantinero debe ser diestro en el arte de la conversación con los clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020307,
					"content": "¡Déjamelo a mí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "Está bien. En ese caso, dejo la barra en sus manos. Si tienen algún problema, no duden en venir a buscarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020310,
					"content": "Uff... ¡Y con eso concluye la clase! ¿Eh? ¿Y el Piñón caramelizado de Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020311,
					"content": "¿Lo decías en serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "#Soy expert{F#a}{M#o} en conversar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
