				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Luka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "#¡Hola! Tú debes ser {F#la aclamada viajera}{M#el aclamado viajero}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020102,
					"content": "#{F#La misma}{M#El mismo}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "¡Oye! ¡No te olvides de la renombrada Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020105,
					"content": "Jeje... Verán, esta es la situación: El Obsequio del Ángel será anfitriona de la “Semana de entrenamiento para cantineros” y me preguntaba si te interesaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020106,
					"content": "En pocas palabras, tendrás acceso a todos nuestros ingredientes para preparar cócteles... o cualquier otra bebida de tu elección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020107,
					"content": "Siempre y cuando no desperdicies los ingredientes, puedes disfrutar ilimitadamente de las bebidas que hagas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020108,
					"content": "¡Bebidas ilimitadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020109,
					"content": "Además, si los clientes están satisfechos, recibirán una cuantiosa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020110,
					"content": "¡Guau, incluso hay recompensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020111,
					"content": "Paimon está más que convencida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "¿En dónde hay que firmar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020113,
					"content": "En realidad, a pesar de que dije que es un “entrenamiento”, la asistencia no es obligatoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020114,
					"content": "Tampoco tienen por qué decidirse aquí y ahora. Pueden intentarlo primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020115,
					"content": "#¿Qué dicen? ¿Están interesad{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020103,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050203",
							"2"
						],
						"stepId": 7050203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "Ah, son ustedes dos. ¿Qué les gustaría beber hoy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020202,
					"content": "Hola, Charles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "#¡Oye, Charles! ¡En realidad vinimos a hacer de cantiner{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020204,
					"content": "#¿Conque cantiner{F#as}{M#os}, eh? Ya veo que Luka l{F#as}{M#os} reclutó. Ese muchacho es bueno haciendo eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020205,
					"content": "#Viajer{F#a}{M#o}, no tengo duda de tu habilidad, pero la coctelería es todo un arte, así que no te lo puedes tomar a la ligera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020206,
					"content": "Ya sean las cantidades de los ingredientes o la técnica al mezclar, todos estos elementos pueden afectar al resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020207,
					"content": "#No te preocupes, {F#ella}{M#él} es {F#una estupenda cocinera}{M#un estupendo cocinero}. ¡La gastronomía y la coctelería tienen muchas cosas en común!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020208,
					"content": "Está bien, si tanto insisten. Un último detalle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020209,
					"content": "En un evento anterior, un practicante mezcló tres licores como Barbatos le dio a entender. Un solo vaso de ese mejunje fue suficiente para noquear a uno de nuestros clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020210,
					"content": "A partir de entonces, decidimos restringir el uso de licores a los novatos. Espero que lo comprendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020211,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Bien, eso es todo lo que tengo que decir. Ya aprenderás las técnicas sobre la marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
