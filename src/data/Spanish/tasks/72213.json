			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Miau miau miau, ¿pasa algo? No se preocupen, Neko preparará una “enumeración” adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "Es “remuneración”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "No importa. La cuestión es que las herramientas del humano de las piedras... quiero decir, del Sr. Ooshima, se rompieron, pero le dimos los materiales que necesitaba para repararlas, así que no debería haber ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "¿Miau? ¿Dijiste “problema”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Eso es bueno. Neko está ansiosa por ver esa estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130610,
					"content": "Hibiki dijo que, una vez que hicieran la estatua a semejanza de Neko, algo bueno ocurriría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130611,
					"content": "¡Neko no puede esperar! ¿Qué es lo que ocurrirá? Tal vez Hibiki regrese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130608,
					"content": "No hay ningún problema, todo va bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "¿Cuánto le pagarás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130604
					]
				},
				{
					"id": 722130604,
					"content": "¿Eh? ¿Cómo que “cuánto”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130605
					],
					"speakerTitle": "Neko"
				}
			]
		}
	]
