				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Perfecto, creo que con esto bastará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "Iré a buscar un lugar adecuado para construir un horno y, luego, comenzaré a fabricar mis herramientas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Avisa a la Srta. Sacerdotisa, por favor. Yo estaré aquí recogiendo las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
