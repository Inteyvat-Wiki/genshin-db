			"dialogs": [
				{
					"id": 766530201,
					"content": "¿Dónde me he equivocado? Si solo cuento con conocimientos teóricos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "No hace falta confirmar este pedido... Ginette, ingeniera de Fontaine... ¡Este es el que más me interesa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "¡Por fin estás aquí! Entonces aún hay esperanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "#Hola, podría decirse que somos l{F#a}{M#o}s ayudantes de Aino. ¿En qué podemos ayudarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Ha diseñado un robot que puede comunicarse a larga distancia gracias al kuuvahki. ¡Es muy divertido! Pero como tenía muchísimos fallos, ha tenido que acudir a mí para que lo reparara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "Me da vergüenza admitir que la mera curiosidad no trae consigo resultados. Al final, todo depende de la práctica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "#No parece nada difícil. ¡Nosotr{F#as}{M#os} nos encargaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "Me da cosa decirlo, pero... me gustaría modificar el pedido. Mientras esperaba su respuesta, como no tenía nada más que hacer, eh... volví a meterme en un lío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "Me preguntaba si el problema se resolvería con un cambio de entorno, así que realicé más pruebas en áreas con concentraciones diferentes de kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "Pero al final los errores se repitieron... y acabé perdiendo a los robots. Entonces... ¿podrían ayudarme a recuperarlos además de arreglar los fallos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "¿Los perdiste a todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Si requieren un pago adicional, ¡encontraré la manera de reunir el dinero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Humm... Habrá varias formas de dar con ellos. Como funcionan con kuuvahki, habrán dejado patrones kuuvahki por donde pasaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Les prepararé un dispositivo especial para reunir patrones kuuvahki. Cuando tengan los suficientes, podrán rastrear a los robots que los dejaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Humm... Bueno, ¡suena divertido! En ese caso, no te cobraré ningún pago adicional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "¿En serio? ¡Muchísimas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}