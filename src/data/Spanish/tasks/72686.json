					"Yasuhiko Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "¿Cómo te llamas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860102,
					"content": "#Hola, soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "#Bien, lo recordaré. ¿Te atreves a poner en juego tu honor como guerrer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860104,
					"content": "¿Eh? Qué propuesta tan repentina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "#¿Eh? ¿Acaso no eres {F#una gran guerrera}{M#un gran guerrero} que ha venido a participar en un combate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860107,
					"content": "No sé de qué me estás hablando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "Disculpa, ¿no has oído hablar de los duelos de espadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860109,
					"content": "¿Cómo puede ser? Pero si hasta puse un anuncio y todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860110,
					"content": "¿Dónde lo pusiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860111,
					"content": "Ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860112,
					"content": "¡Ponerlo aquí no sirve de nada! Si lo anuncias así, ¿cómo esperas que vengan participantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860113,
					"content": "¡Hum! Es porque los de la Comisión Yashiro me dijeron que el Festival Irodori no era lugar para fomentar la violencia y no debía organizar el duelo en Ritou. Incluso me prohibieron pegar allí el anuncio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860114,
					"content": "Por eso no he tenido más remedio que organizarlo aquí y poner el anuncio en esta zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860115,
					"content": "Aunque lo cierto es que ya hay cuatro luchadores inscritos. Si te apuntas tú, ya serían cinco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860116,
					"content": "#Es un milagro que alguien se haya apuntado. Por cierto, {NICKNAME}, ¿para qué vinimos aquí exactamente? Paimon no lo recuerda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860117,
					"content": "#Yo creo que el hecho de que hayas llegado a esta pequeña isla sin motivo alguno demuestra que eres {F#una fornida luchadora}{M#un fornido luchador}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860118,
					"content": "Aquellos que sienten pasión por las artes marciales tienden a atraerse los unos a los otros. Todo el mundo lo sabe. No hay razón para desconfiar de mis palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860119,
					"content": "Cuando dices “todo el mundo”, ¿a qué mundo te refieres exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860120,
					"content": "Jeje, bueno, ¿quieres participar o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860121,
					"content": "Si consigues derrotar a los otros cuatro participantes, recibirás una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860122,
					"content": "Deja que lo piense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "Bueno, piénsalo bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860105,
					"content": "Me temo que no, ¡adiós!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}