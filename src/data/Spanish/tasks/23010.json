			"dialogs": [
				{
					"id": 230100301,
					"content": "Oh, qué menta tan buena. Espera un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100302,
					"content": "Jafar saca el resto de los ingredientes y se pone a cocinar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "Mira, he preparado esta sopa de menta y frijoles con los ingredientes que me trajiste. Pruébala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100304,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "De nada. Disfruta del plato, que está muy rico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100306,
					"content": "Cuando disfruto de una buena comida, me gusta dejar de lado todas esas extenuantes tareas e investigaciones que me rondan por la cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100307,
					"content": "Despejo mi mente y dejo que fluya en silencio como por un riachuelo en calma... Es mi forma de descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100308,
					"content": "Bueno, prueba este delicioso plato, por favor. Quizás te ayude a descansar la mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
		},
