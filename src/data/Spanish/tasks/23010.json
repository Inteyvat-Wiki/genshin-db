					"nextDialogs": [
						230100810
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100810,
					"content": "Andar corriendo de un lado a otro es algo normal en la vida, sin duda. Pero como dice el dicho: “Un corazón tranquilo es mejor que una bolsa llena de Moras”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100811,
					"content": "Por muchas cosas que tengas que hacer, siempre debes darte algo de tiempo para descansar.",
