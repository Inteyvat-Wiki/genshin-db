				{
					"id": 730310305,
					"content": "¡Qué bien!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310307
					]
				},
				{
					"id": 730310307,
					"content": "#No, están alegres porque tienen nuev{F#as}{M#os} amig{F#as}{M#os}. Aunque Aranakin, Aranaga y Aragaru ya no se acuerden, el bosque se acuerda de todo. Nunca se perderá historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310308
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310308,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310309,
					"content": "Festival Utsava está casi listo. ¡Arama no puede esperar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310310,
						730310311
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310310,
					"content": "Me pregunto cómo estará Rhana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#¿Sabes?, deberíamos ir a ver cómo está Rhana, {NICKNAME}. ¡Quizás esté mejor ahora! Si es así, ¡podemos traerla aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310316,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "Arama también ira a ver luego a Arana. ¡Vayan ustedes primero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310321,
					"content": "#¡Hasta luego, nara {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310317,
					"content": "Eso espero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "No tengo muchas esperanzas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310311,
					"content": "Yo también lo espero con ansias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "¡Sí! ¿Cómo será este festival comparado con los de otros lugares?¡Paimon está muy emocionada de poder celebrarlo con sus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310314,
					"content": "... ¡Si tan solo Rhana estuviese aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310306,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310307
					]
				}
			]
		},
