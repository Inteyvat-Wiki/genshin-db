			"dialogs": [
				{
					"id": 730310101,
					"content": "Araja, Arama, ¡regresamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310102,
					"content": "#¡Qué alegría verl{F#as}{M#os} de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#¡Ah, volvieron! Todos hablaban de que nara {NICKNAME} es grande y fuerte, y de que ayudó mucho. Están muy contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#¡Qué alegría tener a alguien que te ayude con el trabajo duro! ¿Verdad, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "¡Una verdadera alegría!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "#No, están alegres porque tienen nuev{F#as}{M#os} amig{F#as}{M#os}. Aunque Aranakin, Aranaga y Aragaru ya no se acuerden, el bosque se acuerda de todo. Nunca se perderá historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "Festival Utsava está casi listo. ¡Solo necesitamos algo de tiempo más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Sí, todo gracias a ayuda de nara {NICKNAME} y de Paimon. Araja tiene muchas ganas de que comience Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310106,
					"content": "¿Ah, sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
