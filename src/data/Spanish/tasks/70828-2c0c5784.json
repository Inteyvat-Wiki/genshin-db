				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "#¡Ah, tú eres {F#la}{M#el} aventurer{F#a}{M#o} rubi{F#a}{M#o}! ¡Espera un momento, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "No, no es eso. Solo quería preguntar si, por casualidad, tienes una antología de poemas de amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Mira, soy una barda increíble, tal vez la mejor de Mondstadt después del mismísimo Barbatos. ¡Soy impresionante, de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Pero ese Linus... ¡Ese molesto bardo nunca quiere admitir que yo soy mejor! ¡No deja de aparecer para recitarme poemas! Sea como sea, está intentando provocarme, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "¿Y lo peor de todo? Todos los poemas son de amor... ¡Y yo nunca he escrito sobre ese tema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Así que he decidido encargarme personalmente del asunto. ¡Escribiré un poema de amor tan épico que Mondstadt no lo olvidará nunca! ¡Así se enterará de lo que es el talento de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Aunque... como he dedicado todo mi tiempo a este gran arte, no he tenido la oportunidad de vivir el amor por mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "Así que, si tuvieras por casualidad una antología de poemas de amor, podrías vendérmela. Solo necesito echarle un vistazo. Cuando haya terminado, la inspiración vendrá a mí. Con un talento como el mío, ¡es prácticamente inevitable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "Me temo que no puedo ser de ayuda. Tengo otros asuntos de los que ocuparme, adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "¡No, no, no pretendía que me ayudaras! Al fin y al cabo, si todo el mundo le pidiera ayuda a un desconocido cada vez que pasara algo, ¡nadie querría salir de casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "*Ejem*... Solo quería preguntar si, por casualidad, tienes una antología de poemas de amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
