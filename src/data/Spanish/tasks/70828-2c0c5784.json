				{
					"id": 708280601,
					"content": "#¡Oh, aventurer{F#a}{M#o} de cabello dorado! ¿Me has traído poemas de amor capaces de inspirar a un genio como yo?",
					"roleType": "TALK_ROLE_NPC",
