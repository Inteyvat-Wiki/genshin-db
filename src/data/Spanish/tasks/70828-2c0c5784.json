			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "Entregarle «La canción de Ai Janum»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "¡Vaya, qué libro tan hermoso! A ver qué dice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "“... No hay trono sin serpientes, no hay rosa sin espinas. Bebe de la amargura hasta la última gota, Ferigees, y con esos dulces ojos tuyos, prométeme...”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "... Eh, ¿cómo se lee esto de aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "#Bueno, ¡eso es demasiado profundo para mí! ¡Hasta se me ha hecho un lío la lengua! Me lo llevaré a casa y lo leeré cuidadosamente más tarde... ¡Gracias, aventurer{F#a}{M#o} de cabello dorado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
						"rawParams": [
							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "Entregarle «Revelaciones del amor divino»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Oh, ¡ya había oído hablar de esto antes! Es una antología de poesía de la Iglesia, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "A ver... “Su alma es un campo en llamas del que emana una canción candente que entrega al viento. Entre las estrellas, la luna y el resplandeciente sol, incluso mi propia luz arde bajo su brillo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "¿Qué clase de poesía es esa? Es un tanto inquietante... Está claro que la Iglesia de Favonius no sabe mucho sobre lírica. ¿Cómo van a aparecer juntos el sol, la luna y las estrellas? ¡Sí, claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "#Bueno, eso es todo, ¡ya me siento más segura de mí misma! Si ese es el nivel de la poesía de este libro, yo puedo hacerlo mejor. Te lo compro. ¡Gracias, aventurer{F#a}{M#o} de cabello dorado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
