			"dialogs": [
				{
					"id": 708280401,
					"content": "Entregarle «El sueño de Rhonabouillet»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Oh, ¡una antología de poesía de Fontaine! A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "Viajan al pasado... La corte de los Caballeros Aguapura... ¿Se enamora de una criada nada más verla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "¡Pfft, qué risa! ¿Viajas al pasado y lo único que se te ocurre es enamorarte de alguien de la edad de tus antepasados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "Bueno, al fin y al cabo, es un poema de amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "#Ja, ya lo entiendo. El amor hace que la gente pierda la razón. Me lo llevaré a casa y lo leeré cuidadosamente más tarde... ¡Gracias, aventurer{F#a}{M#o} de cabello dorado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
