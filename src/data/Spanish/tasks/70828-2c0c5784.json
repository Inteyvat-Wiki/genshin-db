					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#Jaja, ¡gracias, aventurer{F#a}{M#o} de cabello dorado! ¡Eres mi {F#heroína}{M#héroe}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "Ya puedo sentir cómo brota en mí la inspiración, como los vientos de la Guarida de Stormterror, el miasma del Valle Chenyu, y los truenos de la Isla Seirai. Está a punto de estallar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "¡Eso suena peligroso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "¡Jeje, espera y verás! ¡Iré a escribir todas esas ideas ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Los poemas pretenciosos de Linus no tendrán nada que hacer contra los míos. Cuando acabe mi obra de arte, ¡las tabernas de todo Teyvat aclamarán mi nombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082806,
