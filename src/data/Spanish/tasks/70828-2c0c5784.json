			"dialogs": [
				{
					"id": 708280701,
					"content": "Entregarle «Brisa en el bosque»",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280702
					]
				},
				{
					"id": 708280702,
					"content": "Jaja, ¿«Brisa en el bosque»? ¿Por qué clase de barda me tomas? ¿Pensabas que no lo conocería? ¡Lo he releído más veces de las que puedas imaginar! ¿No tienes nada más nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
