						230041207
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041207,
					"content": "*Suspira*, el problema es que ahora se han vuelto un poco perezosas y no quieren moverse. Ya no comen otra cosa que no sea raciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041208
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041208,
					"content": "Claro, se lo dan todo hecho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041209,
						230041210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041209,
					"content": "¡Qué rico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041211,
					"content": "¿Quién ha dicho nada del sabor? ¿Y a qué viene esa cara? No vas a tener oportunidad de probarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041212,
					"content": "¡En todo caso, será Paimon quien las pruebe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041213,
					"content": "Pareces tener mucha confianza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041214
					]
				},
				{
					"id": 230041214,
					"content": "Seguro que olvidé las raciones en el campamento cuando fui a recoger hierbas medicinales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041215
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041215,
					"content": "Pero yo no puedo ir a buscarlas. Tengo que quedarme a cuidar de mis pequeñas. Si me fuera y salieran a comer sin permiso, podrían asustar a alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041216
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041216,
					"content": "#Viajer{F#a}{M#o}, ¿te importaría ir al campamento a buscar las raciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041217,
						230041220,
						230041222
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041217,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041218
					]
				},
				{
					"id": 230041218,
					"content": "Muchas gracias. Si fuera yo, a saber qué harían mis pequeñas en mi ausencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041219
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041219,
					"content": "Si les diera por adentrarse en el bosque, sí que tendría un gran problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041225,
					"content": "#Muy bien. Pues lo dejo en tus manos, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041226
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041226,
					"content": "Marqué en el mapa los campamentos en los que estuve. Puedes empezar por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041220,
					"content": "No habrá más serpientes, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041221
					]
				},
				{
					"id": 230041221,
					"content": "No, no las habrá. Monté los campamentos lejos de las guaridas de las serpientes para evitarme problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041222,
					"content": "¿Tienes varios campamentos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041223
					]
				},
				{
					"id": 230041223,
					"content": "Sí. Monté varios campamentos cuando vivía en la selva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041224
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041224,
					"content": "Aunque ya no vivo allí, me gusta ir a buscar hierbas medicinales y descansar un poco en los campamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041210,
					"content": "¡Suena delicioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041203,
					"content": "Si Changsheng te escuchara, se enfadaría.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				}
			]
		},
