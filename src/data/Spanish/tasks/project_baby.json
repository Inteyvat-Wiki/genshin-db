					"content": "¡Sí! Entonces sí que la dejé en el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040802
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040802,
					"content": "Sobre el campamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040803
					]
				},
				{
					"id": 230040803,
					"content": "¿Será cosa de los animales salvajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040804,
					"content": "Ahora que lo mencionas, parece que las raciones atraen a Hongos y aves. Ya me ocurrió antes. No sería de extrañar que atrajesen también a otros animales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Tal vez debería ponerlas a la venta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040806,
					"content": "Si me van bien los negocios, podría ganar mucho más de lo que gano con los espectáculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040807
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040807,
					"content": "Oh, ya estoy divagando otra vez, jaja. Muchas gracias por tu ayuda. Toma, la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
