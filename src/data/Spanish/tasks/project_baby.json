						230040602
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040602,
					"content": "¿Cómo es que no estaba en el campamento, sino en el árbol de al lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040603,
					"content": "Puede que los pájaros se la hayan llevado para sus reservas de alimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040604
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040604,
					"content": "¿Tanto les gusta esta comida a los animales? Quizás debería empezar a venderla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040605
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040605,
					"content": "¡Ejem! Basta de cháchara. Esto es para ustedes. Gracias por ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
