			"dialogs": [
				{
					"id": 230040901,
					"content": "¡Sí! Entonces sí que la dejé en el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040902
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040902,
					"content": "¿Por qué montaste el campamento en medio de un zarzal? ¿Es que no tienes miedo de pincharte mientras duermes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040903,
					"content": "Pues no. Antes salía mucho de acampada. Se me da bastante bien montar campamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040904
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040904,
					"content": "Cuando monté aquel campamento, no había tantas plantas de esas por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040905
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040905,
					"content": "¿Llevas mucho tiempo sin adentrarte en el bosque?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040906
					]
				},
				{
					"id": 230040906,
					"content": "Lo cierto es que sí, aunque no sé exactamente cuánto... No lo recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040907
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040907,
					"content": "Jejeje... Si tuviese que montar un campamento ahora, seguro que me haría falta un poco de práctica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040908,
					"content": "La mayor parte de los campamentos que monté están abandonados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040909,
					"content": "¿Qué tipo de vida llevaría si me hubiese quedado en el bosque?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040910,
					"content": "Perdón. Estoy hablando de más. Toma, el pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
