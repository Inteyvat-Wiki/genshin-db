			"dialogs": [
				{
					"id": 230040701,
					"content": "¡Sí! Entonces sí que la dejé en el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040702,
					"content": "Estaba enterrada bajo las rocas. Parece que hubo un derrumbamiento en el campamento. Todo estaba desperdigado. Tuvimos que buscar por todas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040703,
					"content": "¿Ah, sí? ¿Cómo pudo haber un derrumbe allí? Siempre fue un lugar seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040704,
					"content": "Ahora que lo dices, es verdad que se escuchaban sonidos extraños por la noche y que alguna criatura que otra se acercaba más de la cuenta al campamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040705,
					"content": "Mis serpientes estaban siempre alerta y me despertaban cada vez. Pero cuando salía a ver qué pasaba, ya no había nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040706,
					"content": "En fin, estoy divagando. Gracias por la ayuda. Tengan, aquí está la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
