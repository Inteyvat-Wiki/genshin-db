			},
			"dialogs": [
				{
					"id": 230042401,
					"content": "¡Ah! ¡Pero si es la torre que le hice a las pequeñas! ¡Qué recuerdos, jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "¿Una torre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "Es un juguete para que las serpientes puedan trepar por él. Así no las tengo encima todo el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Gracias por recuperarlo. Toma, acepta esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "¿Así es como la diseñé entonces? ¡Qué buenos recuerdos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		}
	]
