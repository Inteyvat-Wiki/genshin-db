					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "¿Eh? ¿Una perla? ¡Qué cosas! ¿Dónde la encontraron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Dentro de un tarro en el campamento. ¿La dejaste tú allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "Es un objeto que solía usar en las actuaciones. Yo tocaba la flauta, y las pequeñas se colocaban la perla sobre la cabeza y bailaban al ritmo de la música, estirándose hacia arriba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "Pero hace mucho que no incluimos ese número en los espectáculos porque no daba demasiado dinero. Ni siquiera me había dado cuenta de que la había perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "En fin, muchas gracias por devolvérmela. Esto es para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
