			"dialogs": [
				{
					"id": 230040501,
					"content": "¡Sí! Entonces sí que la dejé en el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040502
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040502,
					"content": "Cuando llegamos, había algunos Hongos intentando llevárselas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040503,
					"content": "#¿Hongos, dices? Puaj. Me alegro de no haber ido yo. Te lo agradezco, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040504
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040504,
					"content": "Muchas gracias por ayudarme. Toma, tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040505
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040505,
					"content": "¡A comer, mis pequeñas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
