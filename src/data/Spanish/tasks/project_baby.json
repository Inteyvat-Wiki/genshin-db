					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "¿Eh? Pero si son los gorros. Jajaja, hace tiempo le hice estos gorritos a las serpientes. Supongo que los dejé allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "Los hice porque pensé que a los niños les gustarían y vendrían a ver el espectáculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "El rojo para Jori, el verde para Amum, el amarillo para Gana y el azul para Drak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "¡Qué adorable! ¡El espectáculo debe ser un éxito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "Al principio fue bien, pero en cuanto las serpientes abrían la boca, los niños se ponían a llorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "Bueno, no importa... Tengan esta recompensa como muestra de mi agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
