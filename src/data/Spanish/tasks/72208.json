				{
					"id": 722080201,
					"content": "¡Gracias! Al fin puedo subir al bote con tranquilidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080202,
					"content": "¿A dónde se dirige ese bote?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "#A la tierra dorada, la tierra de ensueño. Un reino sin niebla... Nos volveremos a ver en nuestros sueños, amig{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				}
			]
		},
