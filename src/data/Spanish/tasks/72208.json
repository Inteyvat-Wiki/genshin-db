			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "#Jeje, no eres mal{F#a}{M#o} para la pesca, pero todavía puedes mejorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080102,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "Oh, lo siento, lo siento... Siempre me olvido de saludar y termino asustando a la gente... Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080105,
					"content": "Parece que lo disfrutas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "No puedo evitarlo. De vez en cuando es divertido darle un susto a los niños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080107,
					"content": "*Ejem*, volvamos al tema de la pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080108,
					"content": "¿Lo dices en serio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "Es un poco vergonzoso decirlo, pero la situación es esta... Mientras estaba pescando, se me cayó el amuleto que me dio Makiri. En su interior está su alma, así como la bendición de la gran Ave del Trueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080111,
					"content": "No podré soportarlo si, al subir al bote, ella se entera de que perdí algo tan importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080112,
					"content": "El barquero dorado dijo que mandaría a alguien para que me ayudara a buscarlo, pero hasta ahora no hay ni rastro de él... ¡Así que, ahora que estás aquí, tú podrías ayudarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080113,
					"content": "Pensé que eras una persona confiable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "Mi sitio habitual para pescar está por allá, pero mis recuerdos son cada vez más borrosos, así que deberás echarme una mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080116,
					"content": "Después de todo, es un recuerdo de los viejos tiempos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "¿Eh? ¿Qué dijiste? ¿Así es como los forasteros buscan las cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080119,
					"content": "*Suspira*... Como sea, siempre y cuando puedas encontrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080120,
					"content": "¿Cómo debería buscarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "Ehm... ¿Usando una caña de pescar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080122,
					"content": "... Si tú lo dices.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "#¡La gran Ave del Trueno y los antepasados te protegerán! ¡Te lo pido, amig{F#a}{M#o} foraster{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080117,
					"content": "Deberías poder encontrarlo si usas una pluma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "No tienes remedio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "Al oeste de la Llanura Autake hay un islote frente a tres cascadas... Es en el mar, justo en la costa al oeste del islote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080109,
					"content": "¿Cómo puedes seguir pensando en pescar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "¡Primero saluda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
