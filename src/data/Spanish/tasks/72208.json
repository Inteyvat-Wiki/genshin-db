					"content": "Sigo en ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080403
					]
				},
				{
					"id": 722080403,
					"content": "#Ya veo. No hay prisa, te pido que vayas con cuidado, amig{F#a}{M#o} foraster{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
