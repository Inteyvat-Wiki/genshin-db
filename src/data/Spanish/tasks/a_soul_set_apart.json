			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030201,
					"content": "¿A-acaso es...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030202,
					"content": "#¡Herman{F#o}{M#a}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "¡Al fin te encuentro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "E-espera, acaba de bloquear el ataque contra el Emisario del Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030207,
					"content": "#Tu herman{F#o}{M#a} y el Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030208,
					"content": "#{NICKNAME}, ¿por qué estás con Dain?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "¿Qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(Hemos estado separados por tanto tiempo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030214,
					"content": "#¿Tu herman{F#o}{M#a} conoce a Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030216,
					"content": "#Nos encontramos otra vez, {F#Éter}{M#Lumina}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030217,
					"content": "#¡¿Qu-qué está pasando aquí?! ¡Dain también l{F#o}{M#a} conoce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030218,
					"content": "#{NICKNAME}, no deberías estar con ese hombre.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "Es mi enemigo.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{F#Éter}{M#Lumina}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030221,
					"content": "¡Un momento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "Es algo que debo decir. No traten de detenerme. No traten de detener al Abismo.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "Ese hombre, Dainsleif, era el “Espadachín del Crepúsculo”, uno de los guardias reales de la última dinastía de Khaenri'ah. Y hace quinientos años no pudo evitar su destrucción.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "Lo maldijeron con la inmortalidad para que vagara eternamente por el mundo... mientras observa a las personas que debía proteger convertirse en monstruos del Abismo.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "¡¿Estás diciendo que Dain es de Khaenri'ah?! ¡¿El mismo Khaenri'ah que fue destruido hace quinientos años?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030228,
					"content": "Y dijiste que la gente se convirtió en monstruos... ¡¿Eso significa que la Orden del Abismo no solo está relacionada con Khaenri'ah, sino que son sus mismos habitantes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030229,
					"content": "Además, Paimon está confundida con eso que dijiste de que Dain es tu enemigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030230,
					"content": "#Antes que nada, ¡ven conmigo, {F#Éter}{M#Lumina}! ¡Regresemos a casa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "Nuestro hogar...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "Claro. Nuestro hogar es donde sea que estemos juntos.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "Pero no puedo ir contigo al siguiente mundo a encontrar un nuevo hogar... Al menos, no por ahora.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "Mi guerra con el Orden Celestial no terminará hasta que el Abismo engulla los tronos.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "¿Guerra con... el Orden Celestial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#Escúchame, {NICKNAME}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "#Yo ya he viajado por este mundo una vez. Cuando llegues al final de tu viaje, como lo hice yo, verás por ti mism{F#a}{M#o} la verdadera naturaleza de este mundo.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "Luego me cuentas todo esto. ¡Volvamos a nuestro hogar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#¡Deja de decir cosas que no entiendo, {F#Éter}{M#Lumina}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(¿Por qué preguntas algo tan irrelevante?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "¿Estás preguntando... sobre Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "¡Vámonos de aquí! ¡Esto es muy peligroso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
		{
			"id": 800303,
