				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "Se fueron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030602,
					"content": "#Oh... {NICKNAME}, no te desanimes... ¡Volveremos a encontrarl{F#o}{M#a}! Mira el lado positivo, ¡al menos esta vez encontramos pistas muy útiles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030603,
					"content": "#No... no estoy desanimad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "#¿En serio? ¿Estás segur{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "#Al menos ahora, aparte de Los Siete, Dain también es una pista clave para encontrar a tu herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030608,
					"content": "#Cuando lleguemos a Inazuma, también debemos estar atent{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "Cierto. Paimon no entendió muy bien lo que dijeron. ¿Tú lo entendiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030611,
					"content": "Más o menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Oh... Entonces será mejor que repasemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030614,
					"content": "#En primer lugar, el Emisario del Abismo llamó {F#“Príncipe”}{M#“Princesa”} a tu herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "#Parece que tu herman{F#o}{M#a} dirige la Orden del Abismo e incluso el Emisario del Abismo le obedece... Pero no sabemos con seguridad si es {F#el}{M#la} líder de la organización.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "#Además, tu herman{F#o}{M#a} dijo que quiere “engullir los tronos” y que estaba en guerra con el Orden Celestial. ¿Qué significa eso? ¿Acaso quiere destruir a Los Siete y arrasar las Siete Naciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "¿Qué más?... Parece que los monstruos de la Orden del Abismo son en lo que se convirtió la gente de Khaenri'ah cuando su nación fue destruida. ¡Esta historia da miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "¡Y Dain también es de Khaenri'ah! Presenció su destrucción hace quinientos años. Pero no se convirtió en un monstruo y ahora lucha contra la Orden del Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "#Por eso tu herman{F#o}{M#a} dijo que Dain es su enemigo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Pero... si los monstruos de la Orden del Abismo son las mismas personas que Dain protegió hace mucho tiempo, ¿por qué ahora la Orden del Abismo es su enemiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "#Además, llevamos todo este tiempo buscando a tu herman{F#o}{M#a} y resulta que está del lado de la Orden del Abismo. ¿Qué está pasando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Muchas preguntas, pocas respuestas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Humm... Tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "#¡No te desanimes, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "¡Nuestro viaje aún no ha terminado! ¡Tenemos que ponernos en marcha! Es hora de salir de este horrible lugar y volver a la superficie, donde brilla el sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "#Si tu herman{F#o}{M#a} quiere que llegues al final de tu viaje... ¡Demuéstrale lo que vales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "#¡Vamos, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Darle vueltas en la cabeza no sirve de nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#Estaba concentrad{F#a}{M#o} en mi herman{F#o}{M#a} y no presté atención.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Ahora se nos ha añadido un objetivo más de viaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
