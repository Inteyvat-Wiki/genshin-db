			"dialogs": [
				{
					"id": 220420301,
					"content": "Ya regresaste. ¿Ya comieron esos bribones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Bien, bien. Tienes el agradecimiento de Neko. Sin tu ayuda, esos mininos habrían jugado y jugado... y luego se habrían quedado con hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420304,
					"content": "*Suspira*, qué desobedientes son. ¿Cómo van a recibir a la gente que viene al santuario de esta manera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
