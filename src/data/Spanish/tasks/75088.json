			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "¡Vaya, pero si eres tú! Muchas gracias por los fragmentos de inscripción iridiscente que me trajiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880602,
					"content": "Aunque son parecidos al grabado de flogisto, voy un poco lento descifrándolos. La verdad es que está siendo más complicado de lo que pensé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880603,
					"content": "Pero bueno, ya no hay vuelta atrás, así que seguro que lo conseguiré, ¡jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		}
	]
}