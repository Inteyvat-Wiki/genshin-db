			"dialogs": [
				{
					"id": 750880101,
					"content": "¿Qué tal? ¿Ya encontraron los fragmentos de la inscripción iridiscente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "Jaja, ¡fantástico! Por fin podré descifrar el significado de los patrones dorados de la inscripción iridiscente... Y entonces, ¡la recompensa será mía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880202,
					"content": "Pero si fracaso, entonces me quedaré sin fondos. ¡Mi vida depende de esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880203,
					"content": "Ah, antes de que se me olvide, aquí tienen su pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "Si consigo suficientes muestras, tal vez pueda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880302,
					"content": "Mira, hay un tipo extraño que está murmurando cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880303,
					"content": "En Natlan hay muchas personas como yo, así que tal vez los “extraños” sean más bien ustedes. En fin, si no necesitan nada, por favor, no me molesten, que voy a seguir con mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880304,
					"content": "Mis gastos de este mes se han pasado de presupuesto. Ahora solo me queda resolver algún problema de investigación de la asociación para compensarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880305,
					"content": "Ah, ¿que a la gente le pagan por investigar? Paimon pensaba que lo hacían por amor al arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880306,
					"content": "Claro que pagan, al menos en la Asociación de Arqueología Sáurica. Poner recompensas es la mejor forma de incentivar el estudio de todo tipo de temas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880307,
					"content": "Mi desafío en esta ocasión consiste en descifrar una inscripción iridiscente. Dicen que nadie lo ha conseguido nunca y que dan un dineral por ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880308,
					"content": "El problema es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880309,
					"content": "¿Sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880310,
					"content": "Para hacerlo, primero necesito reunir cierta cantidad de fragmentos de inscripción iridiscente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880311,
					"content": "Humm, ¿qué les parece si hacemos un trato? Si me traen suficientes fragmentos, les daré una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880312,
					"content": "#Tienen pinta de ser {F#unas aventureras}{M#unos aventureros} con mucha experiencia, así que seguro que suelen aceptar encargos como este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880313,
					"content": "#Por nosotr{F#a}{M#o}s, no hay problema, pero... ¿no era que habías gastado demasiado este mes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880314,
					"content": "Como ya me he pasado de presupuesto, da igual si gasto más o menos Moras. No se preocupen, tendrán sus Moras siempre y cuando me traigan esos fragmentos para que pueda descifrar la inscripción iridiscente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880315,
					"content": "De acuerdo, pero no podemos prometerte nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "Me servirá mientras me traigan fragmentos auténticos. Lo cual me recuerda que este mes, un traficante me vendió unos objetos falsos de las ruinas fuentenigma. ¡Me enfurezco solo de pensarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880318,
					"content": "Ese canalla me estafó una buena suma de Moras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880319,
					"content": "Oooh, conque esa fue la razón por la que te pasaste de presupuesto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880320,
					"content": "Sí, ¡así que usaré los fragmentos de la inscripción iridiscente para revertir esta situación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880321,
					"content": "¡Cuento con ustedes para ello! Por favor, vengan a verme si los encuentran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880322,
					"content": "Tampoco necesito tantos, con tres... No, ¡con cuatro me basta! Si me traen más, me temo que no podré pagárselos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880316,
					"content": "Lo haremos, pero no sabemos si los fragmentos que recojamos te servirán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
		{
			"id": 7508806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
