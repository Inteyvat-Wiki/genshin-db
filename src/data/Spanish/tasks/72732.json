				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "Banda de Arataki, ¡estoy aquí para el combate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "Musculator 33"
				},
				{
					"id": 727320102,
					"content": "¿Eh? ¿Es que el Gran Maestre Hanakado ha vuelto a enviar a otro niño para hacerme frente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320103,
					"content": "¿No será que se está quedando sin minisecuaces? Porque esta parece una enana en toda regla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320104,
					"content": "... No vengo por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "Musculator 33"
				},
				{
					"id": 727320105,
					"content": "Chucho ladrador, poco mordedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "Musculator 33"
				},
				{
					"id": 727320106,
					"content": "#Pero, por otra parte, {F#la rubia esta}{M#el rubio ese}... Parece {F#una}{M#un} oponente dign{F#a}{M#o} para mí. Supongo que es {F#la verdadera}{M#el verdadero} líder de la Banda de Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "Musculator 33"
				},
				{
					"id": 727320107,
					"content": "#Jajaja, eso es lo que Paimon llama tener buen ojo. ¡Sigue, sigue, seguro que a {NICKNAME} no le molestan los cumplidos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320108,
					"content": "¡Qué cantidad de tonterías!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320109,
					"content": "#Mi colega es {F#una tipa dura}{M#un tipo duro}, pero solo está aquí para apoyar, así que no te confundas, niña. Solo ha habido y hay un líder de la Banda de Arataki, ¡y ese soy yo, el ónico e inimitable Arataki Itto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320110,
					"content": "#¿Entonces puedo ascender de Mano del Rey a {F#reina}{M#rey} de la Banda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "#¡Oye, pues no es mala idea! La Banda de Arataki no es la más fuerte del mundo, pero estaría bien ser {F#la}{M#el} líder de una banda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320113,
					"content": "Toreritto, si te parece bien, ¡a Paimon le gustaría llamarse “Arataki por tres días Paimon” o “Paimon, líder temporal de la Banda de Arataki”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320114,
					"content": "¡Oye, oye, oye! ¡No se dejen engañar así por la rival! ¿Es que no lo ven? ¡Intenta sembrar discordia como parte de su malvado plan! ¡Buuu, tramposaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320115,
					"content": "¡Esperen a que derrote a su jefe, y vendrá corriendo a decir que se arrepiente de lo que dijo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320116,
					"content": "¡Deja de decir tonterías! No podrían interesarme menos los asuntos de la Banda de Arataki. ¡Solo quiero un oponente poderoso al que enfrentarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "Musculator 33"
				},
				{
					"id": 727320117,
					"content": "#¡Veamos si {F#la rubia}{M#el rubio} es tan {F#buena}{M#bueno} como dicen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musculator 33"
				},
				{
					"id": 727320111,
					"content": "#Podrías dejarme ser {F#la}{M#el} líder unos días.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}