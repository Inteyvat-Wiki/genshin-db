			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mao",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270901,
					"content": "Azulina, Azulina, ¡no terminaste la historia que me empezaste a contar la otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270902
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270902,
					"content": "Lo sé, pero he cambiado de idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270903
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270903,
					"content": "¿Qué quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270904
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270904,
					"content": "Dejaré en tus manos el final de esa historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270905
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270905,
					"content": "¿Qué? ¡Qué tramposa eres, Azulina! Quedamos en que yo te iba a contar una historia si tú me contabas otra. ¿Por qué ahora me toca contar las dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270906
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270906,
					"content": "Porque no soy más que una bestia tonta a la que no se le ocurre un buen final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270907
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270907,
					"content": "Se me ocurre un final triste y trágico que no hará feliz a nadie. Por eso quiero que tú cuentes el final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270908,
					"content": "¡Tramposa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270909
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711270909,
					"content": "No puedo negarlo. Como compensación, te llevaré a un lugar secreto del Monte Lingmeng que tiene unas vistas espectaculares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270910
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270911
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270911,
					"content": "No me mires con esa cara. Te concederé el privilegio de subirte a mi espalda durante... cinco minutos. Bueno, diez si quieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270912
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270912,
					"content": "Bueno... trato hecho. Déjame pensar cómo puede terminar la historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mao"
				}
			]
		},
		{
			"id": 7112710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112710",
							"2"
						],
						"stepId": 7112710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271001,
					"content": "¿Eh? Lingyuan, ¿eres tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271002,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271003
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271003,
					"content": "Ay, perdón. ¿Estabas cazando? ¿Te hemos molestado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271004,
					"content": "No, no me han molestado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271005
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271005,
					"content": "Ehmm... Entonces, ¿estabas pensando? ¿En qué? ¿En comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271006,
					"content": "No es lo que tú piensas, solo estoy... reflexionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271007
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271007,
					"content": "Reflexionando... ¡Un momento! ¡¿Qué has dicho primero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271008,
					"content": "#Estoy pensando en la pregunta que me hizo {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271009
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271009,
					"content": "“Si la actividad humana fuera una parte de las leyes de la naturaleza... ¿qué pensarías de los humanos?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271010
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271010,
					"content": "Desde que Fujin y Serpiente se marcharon, ha pasado demasiado tiempo desde la última vez que tuve contacto con los humanos que se juntan en asentamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271011
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271011,
					"content": "¿Qué hay de Mao? ¡Él es humano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271012,
					"content": "#Mao no forma parte de ningún asentamiento, pero pertenece a los humanos que los construyeron. {NICKNAME} y tú construyeron su amistad como compañer{F#as}{M#os} de viaje, pero tú no le perteneces. Esa es la diferencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271013,
						711271015
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271013,
					"content": "¿Crees que Mao no es parte del orden social?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271014
					]
				},
				{
					"id": 711271014,
					"content": "Aún no. La mayoría de los niños humanos son así hasta que en ellos cala por completo ese orden, igual que la naturaleza misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271017,
					"content": "Hace mucho que no tengo contacto con humanos que se juntan en asentamientos, quizás por odio, quizás por miedo, o quizás por ambas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271018,
						711271019
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271018,
					"content": "¿Es porque ocuparon un terreno que pertenece a la naturaleza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271020,
					"content": "No lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271021
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271021,
					"content": "Tal vez no exista una diferencia clara entre ellos y nosotros, pero aún no estoy segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271022
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271022,
					"content": "Un joven humano convive conmigo, y un joven ser de mi especie convive con los humanos por curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271023
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271023,
					"content": "¿Un joven ser de tu especie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271024,
					"content": "Sí, se encontró con unos humanos que estaban viviendo en las montañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271025
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271025,
					"content": "Por tanto, aún no puedo contestar a tu pregunta. Necesito seguir observando a los humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271026
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271026,
					"content": "Hay muchas cosas que no entiendo, pero intentaré poner de mi parte hasta que pueda darte una respuesta, tal y como te he prometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271019,
