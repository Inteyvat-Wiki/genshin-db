				]
			},
			"dialogs": [
				{
					"id": 711270501,
					"content": "#¿Eh? {NICKNAME}, Paimon y Lingyuan, ¿qué hacen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270502,
					"content": "¿Escuchan eso? ¡Es la voz de Fujin! A Paimon le parece que viene de abajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270503,
					"content": "#Estoy preocupad{F#a}{M#o} por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "Sí, nos preocupa cómo estás, por eso vinimos sin avisar... Bueno, al principio, tú también nos trajiste aquí sin avisar, ¡así que ahora estamos en paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270509,
					"content": "¿Eh? ¡Ah, lo siento! ¡Se me olvidó desactivar el sello de la entrada cuando regresé! Han venido a verme y yo aquí, causándoles molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270510,
					"content": "No es nada, pero Paimon quiere saber por qué te has escondido en este... Humm... charco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270511,
					"content": "Bueno... Es que, como aún no puedo recuperar la forma que más me gusta, siempre me ven como una carpa y me siento un poco... avergonzada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270512,
					"content": "Pero si ya te hemos visto muchas veces así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "Jaja, antes podía transformarme cuando quería en humana, pero pensaba que sería más cómodo moverme como una carpa. Pero ahora que no tengo más opción, me siento un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270515,
					"content": "Vaya... Paimon no entiende esta obsesión rara tuya, pero ¡nos alegra verte sana y salva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270516,
					"content": "No obstante, según Lingyuan, tu poder no se ha agotado, sino que se ha dispersado entre los ríos y bosques del Valle Chenyu. Por eso estás tan débil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270517,
					"content": "¡Paimon tiene una idea! Si recolectamos el poder adéptico como hicimos en la Vaguada Yaodie con las carpas doradas, ¿te recuperarás, Fujin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270518,
					"content": "Bueno... Teóricamente sería así, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270519,
					"content": "¿Sí? Entonces, si encontramos más de esas carpas, ¡las traeremos de vuelta para que te recuperes lo antes posible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270520,
					"content": "¡No quiero causarles tantas molestias! Mi poder no está agotado al extremo, solo necesito descansar un poco aquí y podré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270521,
					"content": "No es ninguna molestia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "#Estaremos atent{F#as}{M#os} en caso de que nos encontremos con una.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "Agradezco su ayuda, pero no deseo ser una carga adicional para ustedes. Ya han hecho mucho por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270524,
					"content": "Si encuentran más poder adéptico disperso en su camino, pueden recogerlo y traerlo al Jade votivo de este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270525,
					"content": "Aunque ya hemos revitalizado el agua y la tierra, si infunden el Jade votivo de poder adéptico, el Valle Chenyu prosperará aún más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270526,
					"content": "¿Y qué hay de ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270527,
					"content": "Ya les dije que solo necesito descansar aquí durante un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME} y Paimon, muchísimas gracias por venir a verme. Me han alegrado el día, ya que desde que Herbóloga se marchó, es la primera vez que tengo una visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270529,
					"content": "Gracias a ti también, Lingyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270530,
					"content": "Yo no he hecho nada especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270531,
					"content": "#Bueno, menos modestia, ¿no? Considera esto como mi agradecimiento por haberme traído a {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270532,
					"content": "#Sé que puedo ser insistente, pero permítanme agradecerles una última vez. {NICKNAME}, Paimon, gracias por todo lo que han hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270513,
					"content": "No es necesario que te escondas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "Lingyuan está muy preocupada por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "No, yo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270508,
					"content": "Mira, Lingyuan está tan preocupada que no sabe qué decir, por eso vinimos sin avisar... Bueno, al principio, tú también nos trajiste aquí sin avisar, ¡así que ahora estamos en paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7112709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112709",
