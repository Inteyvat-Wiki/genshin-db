					"content": "Solo estoy pensando en... No, en nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271204
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271204,
					"content": "Aunque tú y Serpiente me lo pidan, no me transformaré en humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271205
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271205,
					"content": "Jaja, bueno, tampoco te lo he pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271206
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711271206,
					"content": "Olvídalo. Vamos, ¿no querías echar un vistazo al jardín de té?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				}
			]
		},
