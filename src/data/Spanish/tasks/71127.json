	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "Oye, ¿este es el mundo interior creado por Fujin? No se parece en nada a otros que hemos visto antes. A Paimon le parece que este es más... ¿realista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270302,
					"content": "Paimon no ve mecanismos raros ni puentes transparentes que floten en el aire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270303,
					"content": "Lo siento mucho... Me daba mucha vergüenza y no me expliqué bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270304,
					"content": "No soy capaz de crear un espacio nuevo como los Adeptus del sur. Los Jardines Carpacaída no son un mundo interior, como mucho son una cueva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270305,
					"content": "Sea lo que sea, ¡es una morada adéptica! Solo que Paimon se pregunta cuándo recuperarás tu forma humana, Fujin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270306,
					"content": "El poder que había acumulado se dispersó por estas tierras, así que le llevará un tiempo recuperar su forma humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270307,
					"content": "A mí me pasó lo mismo cuando agoté todo mi poder. Tras la muerte de nuestra maestra, pasé innumerables inviernos viendo cómo caía la nieve y se derretía hasta que por fin recuperé mi forma humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270308,
					"content": "Paimon no sabía nada sobre eso... Espera, ¿qué has dicho? ¿Tú también tienes forma humana, Lingyuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270309,
					"content": "¡Claro que sí! Ustedes no lo saben, pero cuando estábamos en el Monte Yaojun, el aspecto de Lingyuan era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270310,
					"content": "Fujin, no hace falta mencionarlo. Ese tema no tiene nada que ver con lo que estamos hablando ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270311,
					"content": "Ah, ¿sí? ¿Y qué me dices de aquella vez en el festival cuando te comiste demasiados pastelitos de té y terminaste llorando ante Herbóloga, suplicando que te preparara un té para adelgazar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270312,
					"content": "¿Y de esa vez en la ceremonia cuando te emborrachaste y le preguntaste a un jabalí quién era más hermosa, tú o Herbóloga? ¿Quieres que siga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270313,
					"content": "¡Fujin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270314,
					"content": "¡Vaya! ¡Ahora Paimon tiene curiosidad por saber cómo es la forma humana de Lingyuan! ¿Será tan azul como ahora? Humm, ¿o tal vez un poco más pálida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270315,
					"content": "¡Yo también tengo curiosidad!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "#No lo entiendo, tú eres human{F#a}{M#o}, si tienes curiosidad, simplemente puedes mirarte en el espejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270321,
					"content": "#Jaja... En todo caso, gracias, {NICKNAME} y Paimon. No esperaba que algún día pudiera conversar así con otras personas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270322,
					"content": "*Ejem*, como estoy muy contenta, ¡les puedo bendecir con paz y fortuna en lo que reste de su viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270323,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270324,
					"content": "Mil disculpas, me dejé llevar por la emoción e intenté imitar la forma de hablar de los Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270325,
					"content": "En cualquier caso, les enviaré bendiciones desde aquí. ¡Que tengan un buen viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270317,
					"content": "Lingyuan, ¿puedes mostrarnos tu forma humana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "No. El cuerpo humano es demasiado frágil, sin dientes para desgarrar presas ni garras para cazar enemigos. No lo haría a menos que me lo ordenase Fujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270319,
					"content": "Oh, bueno... Creo que deberíamos respetar la decisión de Lingyuan, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270320,
					"content": "A mí me da igual. Si deseas darme una orden, puedes hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
