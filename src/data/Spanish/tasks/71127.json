						711271020
					]
				},
				{
					"id": 711271015,
					"content": "No sé yo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271016
					]
				},
				{
					"id": 711271016,
					"content": "¡Oye! ¡No digas cosas raras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Paimon"
