						],
						"pointId": 311600077
					}
				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#Hola, {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270402,
					"content": "¿Eh? ¿Por qué estás aquí, Lingyuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270403,
					"content": "Porque no puedo entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270404,
					"content": "¿A dónde no puedes entrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270405,
					"content": "A los Jardines Carpacaída, donde Fujin descansa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270406,
					"content": "¿Los Jardines Carpacaída? Oh, ese es el lugar al que nos llevó Fujin cuando nos conocimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270407,
					"content": "Ese lugar está bloqueado con su poder adéptico, y no puedo entrar sin él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270408,
					"content": "¿Eh? Pero Paimon no recuerda que dijeras nada al respecto cuando ella se fue a descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270409,
					"content": "Se me olvidó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270410,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "Sí, necesito que me ayuden porque ustedes tienen su poder adéptico y pueden abrir la puerta de los Jardines Carpacaída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270416,
					"content": "Espera, ¿has estado esperándonos todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270417,
					"content": "No, he estado buscando una manera de entrar en los Jardines Carpacaída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270418,
					"content": "#Para Paimon, eso es lo mismo... Bueno, a nosotr{F#a}{M#o}s también nos preocupa cómo está Fujin. Lingyuan, ¿vamos junt{F#a}{M#o}s a verla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270419,
					"content": "De acuerdo, gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270420,
					"content": "Síganme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270412,
					"content": "Ya es un poco tarde para eso, Azulina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "¡Paimon está de acuerdo! ¿Cómo se te puede haber olvidado algo tan importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270414,
					"content": "Reconozco que soy una bestia tonta. Al verla, recordé muchas cosas y también olvidé muchas otras. Es mi culpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270415,
					"content": "Necesito que me ayuden porque ustedes tienen su poder adéptico y pueden abrir la puerta de los Jardines Carpacaída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
