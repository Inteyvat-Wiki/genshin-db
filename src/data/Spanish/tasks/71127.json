			"dialogs": [
				{
					"id": 711271301,
					"content": "¡Fujin! ¡Enhorabuena por haber recuperado tu forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271302
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271302,
					"content": "Me dijo Azulina que te gusta mucho el té, ¡así que le pedí al Sr. Lu que te preparara unos deliciosos pastelillos de té!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271303
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271303,
					"content": "Sí, por fin he recuperado mi forma. Muchas gracias por estos pastelitos de té, Mao, ¡me encantan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711271304,
					"content": "#{NICKNAME}, Paimon, ¡a ustedes también les preparé unos pocos! Disfrutemos de estos pastelillos de té para celebrar que Fujin se ha recuperado.",
					"roleType": "TALK_ROLE_NPC",
