				"points": []
			},
			"dialogs": [
				{
					"id": 711271101,
					"content": "Después de escucharte, siento que no hay mucha diferencia entre las historias de la ópera de Fontaine y las que tenemos aquí, en el Valle Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271102
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271102,
					"content": "Los caballeros, las brujas, los guerreros y los dragones malvados se matan entre sí, y al final, ¡todos mueren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271103
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271103,
					"content": "¡Lo más importante es el proceso, y no el final! ¡No todas las tragedias pueden verse como un espectáculo de artes marciales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271104
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271104,
					"content": "Por cierto, Montaña, ¡esos gólems de “Remunia” de los que me hablaste suenan muy interesantes! ¿Son más grande que Azulina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271105
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711271105,
					"content": "¿Eh? ¿Azulina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271106
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271106,
					"content": "Ah, cierto, aún no te he contado lo de Azulina... Hagamos un trato, ¡tú me cuentas lo de los gólems de “Remunia”, y yo te cuento lo de Azulina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mao"
				}
			]
		},
