					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271202,
					"content": "Lingyuan, ¿por qué me miras así? ¿Tengo algo encima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271203
					],
					"speakerTitle": "Fujin"
				},
				{
