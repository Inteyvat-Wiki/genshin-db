			"dialogs": [
				{
					"id": 740741901,
					"content": "Inspeccionan al detalle la parte superior del mecanismo, pero no advierten nada extraño.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "¿No hay nada por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741903,
					"content": "Había algo, pero alguien se lo ha llevado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741904,
					"content": "Un momento, ¿eso no quiere decir que nuestro plan ha fallado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741905,
					"content": "Para que el nacimiento de la razón pueda llevarse a cabo, es necesaria la unión de cuatro cuadrantes. Si consiguiéramos los que faltan, quizá todavía podríamos lograrlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741906,
					"content": "Ya que así son las cosas, será mejor que avancemos cuanto antes a la siguiente zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anne"
				}
			]
		},
