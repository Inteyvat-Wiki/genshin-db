			"dialogs": [
				{
					"id": 740740101,
					"content": "Más que la estela, ¿no debería preocuparte más la persona que hay tumbada en el suelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740740102,
					"content": "¿Eh? ¡Aaah! ¿Qué ha pasado?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Mis disculpas, señorita. He dado máxima prioridad a la búsqueda de la estela de piedra. Permítame que realice una exploración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "... Lo siento, señorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Aunque todavía vive, su aliento vital ha escapado del cuerpo por sus orificios. He visto esto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740107,
					"content": "¡Ayyy! Paimon no puede mirar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "¡Tenemos que buscar ayuda! ¡No podemos dejarlo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Juntos, llevan al hombre inconsciente al Puerto Lumidulce.\\nLa gente del puerto lo lleva de inmediato a que reciba tratamiento médico.\\nUna vez que las cosas se han calmado un poco, regresan a donde estaban antes.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "¡Bien! Echemos un vistazo a la estela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "“Aquí se halla el cuadrante de los deseos, del templo de los deseos, del espacio de los deseos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "“A menudo contradictorio”... “Nace en un instante, te acompaña en un largo sueño y nunca se separa”... “Mancillado por la fruta del pecado”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Otro acertijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740114,
					"content": "¿Por qué hacer algo tan aterrador en un lugar como este?... ¿Tendrá algo que ver con el acertijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "Porque el pueblo de Fontaine es “pecador” y su vida ha sido “mancillada por el pecado original”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740116,
					"content": "Por eso, la respuesta es “vida”. Lo adiviné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740117,
					"content": "¿Estás seguro de que esa es la respuesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740740118,
					"content": "Estoy muy familiarizado con la lingüística y simbología que empleaba la Comunidad Cruz de los Narcisos. Salvo que haya alguna sorpresa, esa es la respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740119,
					"content": "Vamos, no hay tiempo que perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
