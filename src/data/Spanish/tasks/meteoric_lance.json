					"content": "¿Lo que había aquí... también se lo llevó alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742103,
					"content": "Eso parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742104,
					"content": "¿Quién se nos estará adelantando?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742105
					]
				},
				{
					"id": 740742105,
					"content": "Es Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742106,
					"content": "Tuvimos un conflicto con él una vez en Elynas. Aclaración: el suceso ocurrió recientemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742107,
					"content": "Cuando vi a la pobre víctima en la entrada, supe que había sido obra suya. Todo apunta a que sigue haciendo de las suyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742108,
					"content": "¿Y qué pretende conseguir llevándose todas las cosas de aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742109,
					"content": "Simple. Quiere forjar de nuevo la Sacroespada Cruz de los Narcisos, porque la misión de la Comunidad todavía no ha terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742110,
					"content": "En fin, vayamos al último lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
