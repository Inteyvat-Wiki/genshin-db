			"dialogs": [
				{
					"id": 760370101,
					"content": "La información sobre los cuatro objetivos con recompensa está en el tablón. Puedes preguntarme si quieres, pero las recompensas no son negociables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Entregar pruebas de que has derrotado al objetivo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "¿Qué puedes contarme sobre los objetivos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Actualmente son cuatro, pero solo hay pistas de tres de ellos. Una es una adivina de Sumeru llamada Hidimbi, acusada de fraude. Suele aparecer por el <color=#00E1FFFF>puerto del sur</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Otro es un Samurái Kairagi de Inazuma que ha matado a varios comerciantes ambulantes cerca del <color=#00E1FFFF>Corredor Desolado</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "El tercer objetivo son los miembros de una banda de contrabandistas de mercancías peligrosas que se esconden en un <color=#00E1FFFF>campamento en la playa, al norte de la ciudad</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "El cuarto es un pirata llamado Hark Mandibularrota, pero no hay ninguna pista sobre su paradero. Podría estar escondido en cualquier parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Nos vemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
