				},
				{
					"id": 760370602,
					"content": "“Objetivo: Hark Mandibularrota, antiguo timonel del Atlas. Motivo: múltiples homicidios y extrema peligrosidad. Actualmente en paradero desconocido”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370603
					],
					"speakerTitle": "Objetivos con recompensa"
				},
				{
					"id": 760370603,
					"content": "“Cualquiera que pueda proporcionar información fiable sobre su ubicación será generosamente recompensado tras verificar su autenticidad”.",
