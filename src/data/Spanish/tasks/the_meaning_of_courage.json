						],
						"pointId": 10931
					}
				]
			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "¡Hemos conseguido un montón de cosas! Varios Ojos vigías igníferos y este artilugio que escupe fuego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "Sí, es su armadura. Puede disparar flogisto, por eso se mueve con tanta agilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "Mi padre me contó que se trata de una criatura que vive en el volcán. Tuvimos mucha suerte de verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "Yo creo que esta armadura podría producir aún más calor que los Ojos vigías. Jeje, seguro que ya tenemos suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Has peleado muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Por mucho que no me agrade luchar, hay situaciones en las que es imprescindible hacerlo. Por eso, siempre busco formas para estar más preparada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "Por ejemplo, me gusta leer todo tipo de historias de héroes. Mi heroína favorita es Fietena, como ya les dije antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "Su característica más emblemática era la máscara con la que se tapaba la cara, así que he creado una basándome en la descripción de la leyenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "En cuanto me la pongo, siento que me convierto en ella. Y como no puedo deshonrar su nombre, tengo que armarme de valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "Pero también podría decirse que, al hacerlo, me escondo detrás de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Paimon ya entiende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "Pero es un truco muy efectivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "¿En serio? Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "Algún día, me quitaré la máscara y tendré que enfrentarme a mí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "Pero cuanto menos me atrevo a dar el paso, más dependo de la máscara, así que... estoy bastante preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "Pero tú misma decidiste investigar el asunto de las setas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "¡Exacto, todo esto ha sido decisión tuya! ¡La esencia de toda aventura consiste en tomar decisiones valientes! ¡Luchar es tan solo una parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "Lo has hecho muy bien, así que no tienes nada de que preocuparte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "Gracias, siempre me dan ánimos y me enseñan muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "¡Sí! ¡Seguiré creciendo hasta poder hacerle frente a mi propio nombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "¡Ah, ahora que me siento mejor, me ha entrado el hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "¿Eh? ¿Ya tienes hambre otra vez? ¡Pero si Paimon ni siquiera ha terminado de hacer la digestión!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "Vamos, volvamos a la Comunidad de la Feracidad. Esta vez, seguro que lograremos cumplir las exigencias del Señor de los Champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Todo esto no es cosa de tu máscara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "No deberías avergonzarte por ello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
}