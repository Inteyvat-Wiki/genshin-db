				]
			},
			"dialogs": [
				{
					"id": 150310201,
					"content": "Yo suelo pasar por aquí. Si no recuerdo mal, debería haber algunos Surcamagmas descansando a un lado del camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310202
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310202,
					"content": "Los Surcamagmas poseen unos núcleos muy calientes. Creo que debería bastar para lo que necesitamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310203,
					"content": "#Paimon no esperaba que todo el mundo estuviera dispuesto a colaborar con nosotr{F#a}{M#o}s. Parece que los demás también sospechan del asunto de las setas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310204,
					"content": "Sí, tenemos suerte de que se encuentren aquí. Antes, muchos habían comido estas setas, pero es la primera vez que alguien consigue hablar con ese champiñón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310205,
					"content": "Sí, aunque quisieran investigar, no tendrían por dónde empezar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310206,
					"content": "Por eso, creo que esta es una oportunidad única. Además, ese Señor de los Champiñones es un verdadero maleducado, lo que ha encendido aún más el deseo de ganar de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310207,
					"content": "Parece que a las gentes de la Comunidad de la Feracidad les encanta competir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "Sí, pero Varesa parece una persona muy amable. Excepto, claro está, cuando está luchando o haciendo deporte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310209,
					"content": "Eh... Sí, en realidad no me gusta combatir ni competir por la victoria. Me basta y me sobra con vivir plenamente cada día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310210,
					"content": "Pero la entrenadora Iansán me ha enseñado muchas cosas, como que la fuerza debe ser el medio y nunca el fin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310211,
					"content": "Si no hubiera entrenado con frecuencia ni supiera controlar mi poder elemental, solo podría haberme limitado a contemplar la devastación de los monstruos cuando nos atacó el Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310212,
					"content": "Por mucho miedo que tenga, debo armarme de valor y no dejar que ocurra algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310213,
					"content": "Y eso es justamente lo que estás haciendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "Gracias. Sé que, poco a poco, seré más valiente. Tanto como Fietena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310216,
					"content": "Vamos, busquemos mientras caminamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310214,
					"content": "Hay una gran fuerza en tu interior.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
		},
