			"dialogs": [
				{
					"id": 150310301,
					"content": "Ya está, ¡listo! Este no está nada mal. Miren, el flogisto sigue en un estado muy activo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "A ver que Paimon lo toque... ¡Aaaah, quema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "Con encontrar unos cuantos más como este, debería bastar. Vamos, subamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
