			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Si pudiera plantar más flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "#Ah, ¡hola! Encantada de conocerte... Perdona, ¿también eres {F#una}{M#un} residente que ha vuelto? Lo siento, creo que no te he visto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "¿Residente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "La gente que vivía en Tatarasuna fue evacuada a otros lugares debido al incidente de la Fragua Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Hace algún tiempo, oí que todo estaba bien en la Fragua Mikage y que Tatarasuna volvía a ser un lugar seguro, así que fui a preguntar si podía volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Después de que me lo autorizaran, guardé mis cosas y regresé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Pero... no parece que haya mucha gente dispuesta a volver como yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Pero eso no se puede evitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "Al fin y al cabo, lo que le ocurrió a la Fragua Mikage fue terrible. A todo el mundo le preocupa que vuelva a ocurrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "¿Tú no estás preocupada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Por supuesto que me preocupa... pero me dio nostalgia, y no puedo dejar de preocuparme por mis flores, jeje. Por eso decidí volver a pesar de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Pero todas las flores que planté se han marchitado. Es una pena que no pueda encontrar más semillas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "Este lugar es muy adecuado para plantar flores. No importa qué semillas se siembren, un mar de flores puede florecer rápidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "Ya he cultivado flores de tierras lejanas antes. Lucettas, margaritas voladoras y dientes de león de Mondstadt, así como flores de seda de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "La lucetta tiene un aspecto muy bonito por la noche. Hay que plantarla a la sombra, regarla mucho y podar las puntas de las hojas muertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "He oído que las margaritas voladoras crecen bien donde hay viento, pero creo que el viento de Inazuma no es tan fuerte como el de Mondstadt... Así que a menudo me acerco y le doy aire con un abanico de papel, pero no estoy segura de si realmente ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "El diente de león es la flor que menos me preocupa, puede cuidarse solo... a veces demasiado bien, y siempre crece en todo tipo de lugares extraños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "¡Es verdad! En fin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "También están las flores de seda de Liyue. Cuidarlas es muy complicado. Los escaradiablos siempre se esconden en los pétalos de las flores de seda, así que tengo que sacarlos uno por uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Por desgracia, no conseguí cultivar flores chingxin. Las que planté no crecieron o se marchitaron rápidamente. Ay... ¿Hay alguna tierra mágica en este mundo en la que se pueda cultivar flores sin problemas, independientemente de su tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "¿Qué puedo decir? Por cierto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Ah, sí, ¿sabes que en Liyue hay una flor llamada campanita de cristal? Es realmente difícil de encontrar, he preguntado a mucha gente pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "¡Ah, perdón! Me pongo así cuando hablo de flores, ¡lo siento mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Se nota que te gustan mucho las flores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Solo las he investigado un poco, jejeje. Pero ahora ni siquiera tengo semillas de flores, así que no puedo cultivarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "No soy residente aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "¿Eh? Ya veo. Pensé que habría alguien como yo que querría regresar a vivir aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "La gente que vivía en Tatarasuna fue evacuada a otros lugares debido al incidente de la Fragua Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250112,
					"content": "Hace algún tiempo, oí que todo estaba bien en la Fragua Mikage y que Tatarasuna volvía a ser un lugar seguro, así que fui a preguntar si podía volver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250113,
					"content": "Después de que me lo autorizaran, guardé mis cosas y regresé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250114,
					"content": "Pero... no parece que haya mucha gente dispuesta a volver como yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
