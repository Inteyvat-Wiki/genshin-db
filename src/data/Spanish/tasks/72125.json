			"dialogs": [
				{
					"id": 721250301,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Me preguntaba dónde podría encontrar semillas de flores para volver a plantarlas en este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250303,
					"content": "Las personas que vivían en esta isla fueron evacuadas a causa del incidente de la Fragua Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250304,
					"content": "Volví por mi cuenta tras escuchar que el problema de la fragua se había resuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250305,
					"content": "Pero las flores que planté por aquí se marchitaron todas y aún no encuentro las semillas. Qué pena, esta zona es muy adecuada para plantar flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
