			"dialogs": [
				{
					"id": 721250501,
					"content": "¿Te sirven estas semillas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Estas... ¡Sí, por supuesto! Con estas semillas, ¡seguro que puedo cultivar un montón de flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "Oh, ehmm, por favor, espera... Tengo que darte algo por tu esfuerzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Esto es para ti, gracias por las semillas. Estoy segura de que verás un hermoso mar de flores cuando vuelvas en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
