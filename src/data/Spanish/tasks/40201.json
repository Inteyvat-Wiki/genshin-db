			},
			"dialogs": [
				{
					"id": 402010101,
					"content": "Perfecto, justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "¿Cómo va el caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "Al día siguiente de infiltrarnos en la base, los dos lacayos del Financiador Oscuro, Corder y Doddamani, empezaron a trasladar la mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "¿Ves ese barco? Es el que envió Doddamani para hacerlo, y lo hizo pasar desapercibido bajo la fachada de un buque de pasajeros y de carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "¡Qué barco tan grande! Miren todas las mercancías apiladas en el muelle. Parece que va a llevar a muchos pasajeros al Puerto Lumidulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "¿Y si esa no es la mercancía real?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "#Pensando varios pasos por delante de ellos, ¿eh? Me gusta. Aprendes rápido, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Si Corder y Doddamani creen que hay alguien tras ellos, es posible que la mercancía que hay aquí solo sea un cebo con el que tantear el próximo movimiento de las autoridades legales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "Pero hay que tener cuidado. Varios miembros de la tripulación han confesado que un veterano ladrón de tesoros conocido como “El Timador” está colaborando con el Financiador Oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "El Timador es un recluso prófugo y un maestro del escondite. Basándonos en lo que hemos averiguado en nuestra investigación, es evidente que es él quien ha estado espiando el faro de la Geoarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "Rodearé la zona para no llamar la atención de El Timador mientras ustedes dos inspeccionan la mercancía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Recuerden actuar con discreción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "De acuerdo, tendré cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#¡Sí! Y Paimon hará todo lo posible para... ¡flotar más cerca del suelo! ¡Paimon no flotará por encima de los hombros de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "No te preocupes, yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "¿Deberíamos investigar la mercancía por si acaso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "¿Algún avance con el caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
