			"dialogs": [
				{
					"id": 402010401,
					"content": "Ya nos deshicimos de todas las bombas de la cubierta, pero puede que aún quede alguna en la bodega... ¿Nos da tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010402,
					"content": "Tranquila, ya me encargué yo de las de la bodega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010403,
					"content": "#{NICKNAME}, Paimon, muy buen trabajo. Han sido rápid{F#a}{M#o}s y eficientes lidiando con una situación imprevista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010404,
					"content": "Menos mal que te diste cuenta de que algo no iba bien, Yelan, y nos diste la lista de códigos para investigar en el barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010405,
					"content": "Un momento, ¿dónde están esos dos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010406,
					"content": "Je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010407,
					"content": "Señores Corder y Doddamani, no están ustedes en la mejor situación. Alguien muy peligroso los tiene en el punto de mira y va a causarles un montón de pérdidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010409,
					"content": "Tiene razón. No entiendo cómo puede haber alguien tan malo en el mundo. Tampoco se me ocurre ninguna razón para que me odie o quiera matarme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010410,
					"content": "Bueno, no se preocupen. Informaré de inmediato a la Oficina Judicial para que envíen a alguien al Puerto Lumidulce y garantice su seguridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010411,
					"content": "Por otro lado, Sr. Corder, la Oficina Judicial también inspeccionará su mercancía para deshacerse de cualquier riesgo para la seguridad, y luego unos agentes la transportarán hasta su lugar de destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010412,
					"content": "Hablando de eso, ¿a dónde se dirigían las mercancías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010413,
					"content": "A la subasta del Bistró Debord de dentro de dos días...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010414,
					"content": "Pues no se preocupe. Los agentes de la Oficina Judicial saben hacer muy bien su trabajo y se asegurarán de que la mercancía llegue intacta a la subasta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010415,
					"content": "Le estoy inmensamente agradecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010416,
					"content": "El barco llega a salvo al Puerto Lumidulce. Los agentes de la Oficina Judicial inspeccionan las mercancías y se las llevan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "Mientras, Paimon y tú le cuentan a Yelan lo que ponía en la carta que El Timador dejó para Corder y Doddamani.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
