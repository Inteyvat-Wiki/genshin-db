					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200700201,
					"content": "¿Cómo están las flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700202,
					"content": "Lo siento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700203
					]
				},
				{
					"id": 200700203,
					"content": "¿Oh? ¿Pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700204,
					"content": "Me descuidé y las cajas y flores se estropearon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700205
					]
				},
				{
					"id": 200700205,
					"content": "¡¿Se... estropearon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700206,
					"content": "Ay, escogí esas flores con mucho cuidado. No es tan fácil encontrar flores tan buenas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700207,
					"content": "#¿Espinadragón es tan peligrosa como para derrotar a {F#una viajera}{M#un viajero} como tú? Todas mis flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700208,
					"content": "En fin, agradezco que te dieras la vuelta. Esto es para ti, tómalas. Tengo que ir a cuidar las flores de la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700209,
					"content": "*Suspira*, ¿y si mejor uso el método de preservación de Sara?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
