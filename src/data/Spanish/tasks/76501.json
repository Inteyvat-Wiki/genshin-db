			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#Hola, {NICKNAME} y Paimon. Los pájaros del bosque estaban hablando de su llegada. ¿Vinieron por algún asunto importante o... necesitan que l{F#as}{M#os} guíe a algún lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "Estamos dando vueltas para ver si hay algo que valga la pena capturar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "El resplandor lunar nutre profundamente este lugar, y las formas de vida que lo habitan no se parecen en nada a las del mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "Por tanto es, sin duda, un lugar donde se pueden capturar imágenes muy preciadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "Sigan explorando tranquilamente. Si algo despierta su curiosidad, no duden en preguntarme. Haré todo lo posible por responderles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "Se respira mucha tranquilidad aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Así es. Aquí es donde medito y me comunico con todos los seres de la naturaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "Estar aquí es suficiente para devolver la serenidad a mi corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "¡Oh, qué poética eres, Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "Tengo una pequeña petición, ¿podría tomarte una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "Sí. Te ves tan bien con el paisaje de aquí que parece un cuadro. ¡Seguro que con este Daguerrotipo saldrás preciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "¿Una imagen a mí? Vaya, es una experiencia nueva para mí. Si consideran que esta serenidad y mi presencia son dignas de ser retratadas, lo haré con gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "Será un honor formar parte de sus recuerdos de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "¿Qué tengo que hacer? ¿Debo mirar hacia cierto lado o mantener una postura natural?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "Sé tú misma, es todo lo que tienes que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "De acuerdo, lo dejo en tus manos. Que la inspiración, por fugaz que sea, te honre con su presencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "Yo me encargaré de capturar el instante más emotivo, tranquila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "En realidad, nos gustaría pedirte que salieras en la imagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Lauma, ¿sueles estar por esta zona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "Estamos buscando inspiración para tomar imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
