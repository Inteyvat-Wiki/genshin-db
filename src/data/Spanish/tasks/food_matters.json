				{
					"id": 766670401,
					"content": "¡Sí, son suficientes! ¡Muchísimas gracias! Espere un momento, ¡iré a prepararle la vianda de la luna más deliciosa que haya!",
					"roleType": "TALK_ROLE_NPC",
