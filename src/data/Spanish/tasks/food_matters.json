						766670302
					]
				},
				{
					"id": 766670302,
					"content": "¿D-de verdad va a ayudarme? Gracias, muchísimas gracias... En ese caso, ¡bastaría con que me trajera <color=#00E1FFFF>cinco lakkas</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "Cuando las traiga, ¡le prepararé la vianda de la luna más deliciosa que haya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
