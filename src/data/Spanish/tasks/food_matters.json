					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "¡Ya está lista! Pruébela a ver qué le parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
