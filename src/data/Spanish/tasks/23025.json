				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250701,
					"content": "¿Eh? ¿Ya colocaron todas las balizas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250702,
					"content": "Ya las colocamos todas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "De verdad que te lo agradezco mucho. Toma, aquí tienes tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250704,
					"content": "¡Ahora solo habrá que esperar a que terminen de recoger los datos para poder verificar las conclusiones anteriores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250705,
					"content": "Aunque ahora que lo pienso, ¿cómo voy a subir allí arriba a recuperar las balizas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fargani"
				}
			]
		},
		{
			"id": 2302508,
