			"dialogs": [
				{
					"id": 230251001,
					"content": "¿Cómo? ¿Que aparecieron monstruos de repente? ¡No puede ser! Los parámetros ambientales de aquella zona mostraban claramente que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230251002,
					"content": "¿Podría ser que las mismas balizas fueran una variable? Puede ser que durante el transporte recibieran alguna ligera sacudida y emitieran algún sonido que atrajera a los monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251003
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230251003,
					"content": "Pero no debería afectar los datos recogidos... ¡Ah! Disculpa, estaba hablando otra vez conmigo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230251004,
					"content": "No me lo esperaba... Por favor, acepta esta recompensa por los problemas añadidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230251005,
					"content": "La próxima vez que lleve a cabo mediciones, tendré que ir con más cuidado...",
