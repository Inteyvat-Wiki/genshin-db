			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fargani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "#¡Ey! Amig{F#a}{M#o}, ¿tienes un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250202,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "¿Alguna vez pensaste en lo que haríamos si el cielo se nos cayese encima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250209,
					"content": "Creo que le estás dando demasiadas vueltas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "Quizás sea así, pero ¿por qué el cielo no se puede caer? ¿Por qué el suelo no colapsa? Si no se realizan investigaciones precisas, estas preguntas se quedarán siempre sin respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250213,
					"content": "De hecho, ya tengo varios modelos perfectos para responder estas preguntas. Solo necesito más datos de mediciones para respaldarlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250214,
					"content": "¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "¿Eso quiere decir que me ayudarás? ¡Mil gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250224,
					"content": "De hecho, ya escogí el lugar perfecto para llevar a cabo las observaciones. Lo que pasa es que cerca hay algunos monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250225,
					"content": "Por favor, ahuyéntalos para que pueda registrar las observaciones con tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250226,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "Muchas gracias. Entonces, pongámonos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250228,
					"content": "¿Tú también vas a ese sitio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "Después de todo, tengo que verificar algunos datos sobre el terreno para encontrar la causa de algunas discrepancias en mis cálculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250230,
					"content": "Sumergirme en una pila de papeles para hacer cálculos solo conseguirá alejarme cada vez más de la solución correcta... Así que pongámonos en marcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250215,
					"content": "Suerte con eso. Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "Espera, ¡espera! Piénsalo detenidamente. Si logro publicar mis resultados, ¡sería revolucionario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250217,
					"content": "#Llegado el momento, podrías ser reconocid{F#a}{M#o} por tu colaboración con mi gran teoría. Puedo poner tu nombre en la sección de agradecimientos al final del artículo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250218,
					"content": "#Eh... Incluso podría considerar incluirte como {F#coautora}{M#coautor}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250219,
					"content": "¿Tan urgente es?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "Si no consigo pronto resultados, me temo que tendré problemas con la financiación de mi investigación... Que el cielo nos caiga encima no sería nada en comparación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250221,
					"content": "#Antes que ser {F#coautora}{M#coautor}, prefiero que me pagues en Moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "Menos créditos y más réditos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "El cielo no debería desplomarse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "#Estoy muy ocupad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "¡Oh! No me digas eso. ¿Qué puede ser más importante que el inminente derrumbe de tu propia casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250205,
					"content": "¿Tu casa... se va a derrumbar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "¡*Ejem*! Claro que no, pero si vives cada día en una casa que no conoces por completo y de la que nadie te ha garantizado su integridad estructural...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250207,
					"content": "#Tú también te sentirías un poco inquiet{F#a}{M#o}, ¿verdad? Pues pasa lo mismo con vivir en este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "Fargani"
				}
			]
		},
		{
			"id": 2302504,
			"completionStepIds": [
				2302504
			],
