					"Fargani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250401,
					"content": "Ajá... ¿Así que era esto? Solo había que introducir esta variable para poder resolver las discrepancias anteriores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250402,
					"content": "Sin embargo, esto también podría cambiar otras conclusiones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250403,
					"content": "¿Algún progreso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Ah, perdón. Olvidé por completo que estabas aquí... Toma, aquí está la remuneración que acordamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250405,
					"content": "En cuanto al progreso... Aunque resolvimos algunos problemas, parece que han surgido muchos nuevos... Gajes del oficio de investigador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250406,
					"content": "#Viajer{F#a}{M#o}, quizá tenga que volver a pedirte ayuda antes de llegar a una conclusión final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fargani"
				}
			]
		},
