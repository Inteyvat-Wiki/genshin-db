			},
			"dialogs": [
				{
					"id": 230250801,
					"content": "#¡Oh! ¡Viajer{F#a}{M#o}, por fin regresaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250802,
					"content": "¿Va bien la investigación?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Gracias a ti, estos días hice grandes progresos. Esas balizas deben de estar recolectando bastantes datos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250804,
					"content": "¡Ahora solo hay que recuperar esos datos para poder verificar las nuevas hipótesis que planteé durante estos días!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250805,
					"content": "¿Todos estos días te los has pasado planteando hipótesis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "*Ejem*, también optimicé las fórmulas matemáticas y calibré los instrumentos de medida. Después de todo, mira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250808,
					"content": "Con este cuerpo que tengo no hay manera de que pueda subir a recoger las balizas donde las colocaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250809,
					"content": "Así que tendré que pedirte ayuda otra vez para que recuperes las balizas por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250810,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "#Por favor, viajer{F#a}{M#o}. ¡Te compensaré como es debido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250812,
					"content": "La próxima vez, piensa en cómo recuperarlas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "No es que no haya pensado en instalar dispositivos de recuperación o en expandir su campo de acción...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250814,
					"content": "Pero eso necesitaría mucho más presupuesto y no sé si podría afectar a la precisión de los datos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250815,
					"content": "#Sea como sea, esta vez también cuento contigo. Por favor, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fargani"
				},
				{
					"id": 230250806,
					"content": "¡Eso es todo lo contrario de hacer progreso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
		},
