				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#¡Nara {NICKNAME} y Paimon! No hay que preocupar. ¡Malos que enferman a bosque marcharon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Gracias, nara {NICKNAME} y Paimon, por ayudar a Ararycan a proteger bosque. ¡Ararycan tiene flor para nara {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "#¡Tomen flor, amig{F#as}{M#os} de Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
