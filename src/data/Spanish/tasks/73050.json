			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#¡Nara {NICKNAME} y Paimon! Gracias por su ayuda, máquina divina de Váruna está bien, y Ashaván también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500102,
					"content": "Todos aranara volvieron a Vanarana para celebrar Festival Utsava, como pájaros cuando vuelven a sus nidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500103,
					"content": "Lluvia torrencial se calmó, y Aranakula por fin puede ocuparse de jardín y cultivar viparyas, viparyas felices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500104,
					"content": "Viparyas felices hacen linternas felices, linternas felices encienden Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500105,
					"content": "#Nara {NICKNAME} y Paimon, jardín muy bien ahora, y Festival Utsava fue divertido. Gracias por ayudarnos a arreglar máquina divina de Váruna y traer de vuelta a Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500106,
					"content": "¡Eso es una gran noticia! Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730500107,
					"content": "Por cierto, hay algo que despierta mi curiosidad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "¿Por qué le pusieron el nombre de nara Váruna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "#Es porque {F#ese}{M#esa} nara nos ayudó a recuperar máquina divina Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500110,
					"content": "Entonces, ¿cuál es su verdadero nombre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "Hum... Arapandu no sabe, nara Váruna nunca dijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#Nara {NICKNAME} también ayudó mucho. Nara {NICKNAME} es valiente, superó muchas dificultades. Ahora podremos reunirnos aquí juntos en Festival Utsava. ¡Arabalika contento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500115,
					"content": "#Tenemos algo para nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500116,
					"content": "Es manera que tienen aranara de dar gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500117,
					"content": "#A nara {NICKNAME} le gustará, y a Paimon también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500118,
					"content": "#Aquí está flor de aranara para valientes nara {NICKNAME} y Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500119,
					"content": "#Arakara también tiene flor. No es viparyas, ¡pero es para nara {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500120,
					"content": "#Nara {NICKNAME}, Paimon, gracias por todo lo que hicieron por bosque. Aranara nunca olvidarán a sus amig{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500113,
					"content": "Entiendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
