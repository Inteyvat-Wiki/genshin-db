					"Aranaga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "#Festival Utsava... A Aranaga resultar familiar... ¿Eh? Ser cosita blanca voladora... y {F#nara rubia}{M#nara rubio}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "#Son amig{F#a}{M#o} nara y amiga de amig{F#a}{M#o} nara. Aranakin espera que lo pasen bien en Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "#Amiga de amig{F#a}{M#o} nara es nuestra amiga. ¡Nara rubi{F#a}{M#o} y cosita blanca voladora son {F#amigas}{M#amigos} de Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		}
