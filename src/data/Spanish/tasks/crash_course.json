			"dialogs": [
				{
					"id": 3071501,
					"content": "¡Bravo! ¡Qué gran espectáculo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071502,
					"content": "#Me has sorprendido. Pareces {F#una caballera}{M#un caballero} experimentad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071503,
					"content": "Las batallas que libraste en el templo son dignas de admiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071504,
					"content": "Haces que me sonroje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "¡Jaja! Veo que también tienes la modestia de un caballero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071507,
					"content": "Las hazañas de cómo rescataste heroicamente a Mondstadt se contarán en la Capital de la Libertad durante generaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071508,
					"content": "Por favor, ven a visitarme a la Sede de los Caballeros de Favonius cuando tengas tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071509,
					"content": "También conozco una taberna acogedora, si eso te apetece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071505,
					"content": "No fue nada, en realidad.",
