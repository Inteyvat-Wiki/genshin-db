			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "¡Huffman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650102,
					"content": "Oh, son ustedes dos. Gracias por venir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650103,
					"content": "La última vez discutimos sobre el Héroe Oscuro. ¿Tienen algo más que puedan compartir conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650104,
					"content": "¿Puedo preguntar primero qué está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "Ah, sí, por supuesto... disculpen mi falta de etiqueta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650108,
					"content": "Bueno, la situación es esta, mira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650109,
					"content": "Caray... ¡qué escritura tan fea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650110,
					"content": "Humm... Déjame echar un vistazo más de cerca... Algunas partes son completamente ilegibles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650111,
					"content": "En efecto, aunque esto está escrito en lenguaje común, parece que se ha utilizado un cifrado en muchas partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650112,
					"content": "Aun así, se puede entender el significado general con las partes sin cifrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650119,
					"content": "Esta es una declaración de guerra de la Orden del Abismo al Héroe Oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650113,
					"content": "¿Eso significa que... los tipos malos quieren acabar con el Héroe Oscuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650114,
					"content": "Eso parece. Esperemos poder contactar con él lo antes posible para coordinar una respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650115,
					"content": "Después de todo, este asunto ya no tiene que ver solo con el Héroe Oscuro. Afecta a toda la ciudad de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650116,
					"content": "Gracias por la información.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "Si descubren algo, vengan a buscarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650117,
					"content": "Lo tendré en cuenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "Lo siento, no tengo nada de información.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "¿En serio?... Es una pena, de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
