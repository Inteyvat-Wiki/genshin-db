				"points": []
			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "¡¿Cómo me encontraste?! ¡Escoria de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650402,
					"content": "No soy Caballero de Favonius. ¡Ahora empieza a hablar! ¿Cuál es tu plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "Veo que recibiste nuestra carta... Pero si crees que voy a contarte nuestros secretos, ¡me temo que estás muy equivocado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650404,
					"content": "Hum, parece que no entiendes el problema en el que te has metido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651001,
					"content": "¡Quémalo con <color=#00E1FFFF>Mano abrasadora</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "¿Acabas de usar una Visión Pyro para lanzar fuego con tus manos? ¡Ah! ¡Quema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650601,
					"content": "¡Veamos cuánto tardas en hablar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "¡Utiliza una vez más la <color=#00E1FFFF>Mano abrasadora</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "¡Basta! ¡Basta! Duele... te lo ruego... ¡Detente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650406,
					"content": "¡Utiliza una vez más la <color=#00E1FFFF>Mano abrasadora</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "*Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4651403,
					"content": "Hacerte el muerto no te ayudará, ese fuego no fue lo suficientemente fuerte como para... Oh... Parece que <color=#00E1FFFF>se ha desmayado</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "¡Oye! ¡Dormirás cuando diga que puedes dormir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "¡Ah! ¡Quema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650901,
					"content": "¡Hablaré, hablaré! ¡Auch, por favor, detente! ¡<color=#00E1FFFF>Te lo diré todo</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650902,
					"content": "L-la Orden del Abismo ha reunido varios ejércitos que tienen en común su odio al Héroe Oscuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650903,
					"content": "Atacarán la <color=#00E1FFFF>puerta de la ciudad</color> de Mondstadt mañana a las 10 de la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650904,
					"content": "Eso es todo lo que sé... Por favor... No me hagas sufrir con esas llamas otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650905,
					"content": "¿Eso es todo? Bueno, dudo que seas tan tonto como para esconder más cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651201,
					"content": "<color=#00E1FFFF>Pregúntale</color> sobre su plan de ataque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
