			"dialogs": [
				{
					"id": 4650501,
					"content": "Si no contactamos con el Héroe Oscuro pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650502
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650502,
					"content": "¿Qué debemos hacer con respecto al desafío de la Orden del Abismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "Ah, son ustedes dos. Debo admitir que este asunto del Héroe Oscuro ha sido un verdadero dolor de cabeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650504,
					"content": "Acabamos de llevar a cabo una reunión para decidir qué hacer. ¿A que no adivinan qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650505,
					"content": "¿Enterrar la cabeza firmemente en la arena?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "Jaja... Muy buena. Pero no, la Orden no puede quedarse de brazos cruzados mientras exista la más mínima sospecha de una amenaza para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650507,
					"content": "Si ese fuera el caso, cada vez más personas comenzarían a confiar en el Héroe Oscuro en lugar de los Caballeros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650511,
					"content": "Bueno, entonces, ¿cuál es el plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650512,
					"content": "Descubrir la verdadera identidad del Héroe Oscuro y ofrecerle nuestra protección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650513,
					"content": "¿“Protección”? Parece que hasta ahora le ha ido bien sin la protección de ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650514,
					"content": "*Tch*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650515,
					"content": "*Suspira*, bueno, ya que han ayudado a los Caballeros en el pasado, también podría contarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650516,
					"content": "La oferta de protección es solo una artimaña para que los Caballeros de Favonius puedan asumir la responsabilidad total y exclusiva de este asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650517,
					"content": "¿No van a dejar que el Héroe Oscuro ande por ahí haciendo de héroe? ¿Por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650518,
					"content": "En primer lugar, para mostrar el poder de los Caballeros de Favonius y probarle a la gente que sin el Héroe Oscuro aún pueden confiar en la Orden para mantener la paz y la armonía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650519,
					"content": "En segundo lugar, la Orden del Abismo no tiene piedad. Si algo le sucediera al Héroe Oscuro,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650520,
					"content": "solo serviría para promover sus nefastas ambiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650521,
					"content": "¡Por Los Siete! No me imaginé que la vida de un caballero fuera tan angustiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650522,
					"content": "Pero nada de este plan funcionará si no conocemos la verdadera identidad del Héroe Oscuro a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650523,
					"content": "No desesperes, Huffman. Solamente haz lo que yo te diga y todo estará bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650524,
					"content": "Ah, Capitán Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650525,
					"content": "Últimamente, el Sr. Diluc ha estado trabajando en la taberna El Obsequio del Ángel todas las noches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650526,
					"content": "Lo único que tienes que hacer es echarle un ojo. ¿Puedes hacer eso por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650527,
					"content": "¡Sí, Capitán Kaeya! Pero eso significa que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650528,
					"content": "¿El Sr. Diluc es el Héroe Oscuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650529
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650529,
					"content": "¿Quién sabe? Es solo una corazonada, hasta yo puedo equivocarme de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650508,
					"content": "¿Unir fuerzas con el Héroe Oscuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650509
					]
				},
				{
					"id": 4650509,
					"content": "No, eso enviaría una señal de que los Caballeros aprueban al Héroe Oscuro en la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650510
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650510,
					"content": "Fomentar este tipo de heroísmo individual socava la autoridad de los Caballeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				}
			]
		},
