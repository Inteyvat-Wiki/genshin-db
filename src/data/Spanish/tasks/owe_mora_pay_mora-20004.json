			"dialogs": [
				{
					"id": 200040501,
					"content": "¡Regresaron! Supongo que ya le pagaron a Goth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040502,
					"content": "Sí, ya le entregamos el dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "Qué bien. Por suerte, el alquiler de esta casa no es tan caro... Apenas pude juntar el dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040504,
					"content": "Parece que tendré que comer ensalada unos días más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
