			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040101,
					"content": "*Suspira*... Parece que tendré que hacerlo yo mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040102,
					"content": "Este viejo saco de huesos se va a caer en pedazos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040103,
					"content": "¿Es una emergencia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040104
					]
				},
				{
					"id": 200040104,
					"content": "#¿Eres tú, viajer{F#a}{M#o}? No diría que es una emergencia, pero se está descontrolando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040105,
					"content": "Como sabes, los Fatui reservaron todo mi hotel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040106,
					"content": "Como propietario del Gran Hotel Goth, yo mismo tengo que atenderlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040107,
					"content": "Tengo que organizar el servicio de comidas, hacer las reparaciones, y otras muchas tareas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040108,
					"content": "Hace poco, algunas de las mesas y sillas del hotel se rompieron y tengo que conseguir a alguien que lleve la madera adecuada al carpintero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040109,
					"content": "Además, hay que cobrar el alquiler de algunas casas en la ciudad... Y Marvin no aparece por ningún lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040110,
					"content": "Ay, no sé cuánto más podré soportarlo, ¿cuándo se volverá más responsable ese muchacho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040111,
						200040112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040111,
					"content": "Puedo ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				},
				{
					"id": 200040113,
					"content": "¿M-me ayudarás? *Suspira*... No quiero ser una molestia. Si Marvin fuera la mitad de responsable que tú, me ahorraría tantos dolores de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040114,
					"content": "Entonces, por favor, ayúdame a traer madera de abeto y de abedul. Tengo que dárselas al carpintero de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040112,
					"content": "Primero tome un descanso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				}
			]
		},
		{
			"id": 2000403,
			"completionStepIds": [
				2000403
			],
