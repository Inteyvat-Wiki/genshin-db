				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040701,
					"content": "Gracias, esto será suficiente. Se la llevaré al carpintero... Oh, cierto, tengo que cobrar el alquiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040702
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040702,
					"content": "Me pregunto si esa... astro... astromona, o como se llame, estará en casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040703
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040703,
					"content": "Es Mona Megistus, la astróloga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "¡Sí, ese nombre! Ay... nunca logro recordarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040705
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040705,
					"content": "¿Eh? ¿Mona no ha pagado el alquiler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040706,
					"content": "Ahí está el detalle... Todos los demás inquilinos han pagado su alquiler, solo falta ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040707
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040707,
					"content": "La he buscado muchas veces pero nunca se encuentra en casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040708
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040708,
					"content": "#Viajer{F#a}{M#o}, por favor, ve allí y pídele que pague el alquiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
