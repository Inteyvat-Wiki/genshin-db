			"dialogs": [
				{
					"id": 200040401,
					"content": "¿Cómo les fue? ¿Encontraron a esa astr...? *Ejem*... ¿A su amiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040402,
					"content": "Aquí está el dinero del alquiler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "Bien, bien, está completo. ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040404,
					"content": "Cambiando de tema... ¿Qué hace exactamente su amiga para ganarse la vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040405,
					"content": "Parece una persona muy hábil y, sin embargo, siempre tiene poco dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
