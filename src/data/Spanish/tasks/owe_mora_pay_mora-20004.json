			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "Oh, eres tú... Tanto tiempo sin vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040302,
					"content": "Parece que tienes prisa, ¿me estabas buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040303,
					"content": "Mona, ¿dónde has estado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040304,
					"content": "Te hemos estado buscando recientemente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "Oh... No es un buen momento. Hace unos días me pidieron un nuevo manuscrito para «El Pájaro de Vapor».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040306,
					"content": "El tema era “La relación entre los cambios en los astros y los cambios en el destino de las personas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040307,
					"content": "Por eso he estado en el campo observando las estrellas y estos días he regresado a casa muy tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040308,
					"content": "Mona ha estado trabajando duro para ganar dinero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040309,
					"content": "Bueno, es que Fontaine puso a la venta un nuevo globo celeste, y ya pagué el depósito para hacer el pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040310,
					"content": "Una vez que reciba el dinero por el manuscrito, podré pagar lo que falta y conseguir ese globo celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040311,
					"content": "También tienes que pagarle el alquiler a Goth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "¿Alquiler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040313,
					"content": "¡Oh! Yo... estoy segura de que reservé algo de dinero para eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040314,
					"content": "Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040315,
					"content": "(Mona busca en su monedero...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "Aquí hay un poco... ¡Y aquí hay un poco más! Esto debe ser suficiente para pagar el alquiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040317,
					"content": "(Parece que Mona vació su monedero...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "¿Podrían llevarle este dinero a Goth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
