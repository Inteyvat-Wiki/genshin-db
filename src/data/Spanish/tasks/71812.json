			"dialogs": [
				{
					"id": 718120201,
					"content": "¿Qué tal? ¿Descubriste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120202,
					"content": "Sí, esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "Esto es... Nunca había visto nada como esto. ¿Dónde lo encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120205,
					"content": "Cerca de las Ruinas de Dunyu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "¿Qué está haciendo algo así en las Ruinas de Dunyu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120207,
					"content": "Gracias por ayudar a descifrar esa pista. Según el código del aventurero, esto te pertenece a ti y esta recompensa también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120208,
					"content": "Haré los preparativos para que alguien vaya de inmediato a las Ruinas de Dunyu a hacer una búsqueda más detallada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120209,
					"content": "Es muy extraño... Hemos recorrido las Ruinas de Dunyu varias veces, ¿cómo se nos pudo escapar esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
