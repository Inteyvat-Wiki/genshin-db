			"dialogs": [
				{
					"id": 722100201,
					"content": "Miau, ¿miau miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100202
					],
					"speakerTitle": "Hachihou"
				},
				{
					"id": 722100202,
					"content": "Oh, este debe ser Hachihou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100203,
						722100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100203,
					"content": "Mishi, mishi, ven aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100204
					]
				},
				{
					"id": 722100204,
					"content": "Miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "Hachihou"
				},
				{
					"id": 722100207,
					"content": "Oh, qué gatito tan obediente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100205,
					"content": "Miau, miau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100206
					]
				},
				{
					"id": 722100206,
					"content": "Miau... ¿miau miau miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "Hachihou"
				}
			]
