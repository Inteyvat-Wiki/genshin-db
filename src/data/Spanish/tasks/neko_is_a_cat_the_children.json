			"dialogs": [
				{
					"id": 722100301,
					"content": "¡Miau! ¡Miau miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100302,
					"content": "¡Guau! ¡Qué minino tan fiero! Ten cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100303,
					"content": "Miau, miau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "¿Miau, miau? Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100307,
					"content": "Jeje, se ve feroz, pero aun así es lo suficientemente bueno como para dejarte sostenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100305,
					"content": "Te llevaré a casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
					"content": "¡Miau! Miau... miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "Konbumaru"
				}
			]
		},
		{
