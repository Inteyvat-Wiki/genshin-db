			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Miau, miau... ¿A dónde fueron...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100102,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Ah, son ustedes. Algunos gatitos se escaparon y Neko no sabe a dónde fueron. Neko está muy preocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100104,
					"content": "Afuera es muy peligroso. Neko se lo dijo muchas veces. Esas criaturas peludas armadas con palos y esas cosas redondas de fuego y agua son muy peligrosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100105,
					"content": "Y si van al lugar de las cosas cosquilleantes, se les pondrá todo el pelaje de punta. Neko no quiere que les pase algo tan horrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100106,
					"content": "Pero algunos no escuchan y se van a la aventura. Neko siempre tiene que ir y traerlos por el cuello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100107,
					"content": "Unos cuantos volvieron a escaparse hoy. Es muy preocupante para Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100108,
					"content": "Por favor, Neko necesita su ayuda para encontrar a Konbumaru y Hachihou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100109,
					"content": "¿Quién es Konbumaru...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "Es un buen minino. El Konbumaru de esta generación es muy listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100111,
					"content": "¿“Esta generación”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Es algo que decía Hibiki a veces. Neko no puede decir que lo entienda. Por la expresión de Hibiki cuando hablaba de Konbumaru, debió ser algo bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100113,
					"content": "Neko elige nombres de cosas buenas para los pequeños. Y cuando ya no son pequeños y se van, Neko usa los mismos nombres para los más pequeños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100114,
					"content": "A Konbumaru le gusta dormir en lugares altos, así que lo mejor será que empiecen por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100115,
					"content": "Y Hachihou es...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Un pequeñín muy ágil que adora el pescado. Por eso a veces se acerca a la costa a ver si algún pez se quedó varado en la orilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100117,
					"content": "Pero eso es muy peligroso. El agua es algo aterrador. Hace mucho tiempo, un ser llamado tanuki se cayó al agua y por poco no logra salir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100118,
					"content": "Seguro que encontrarán a Hachihou cerca del agua salada buscando peces o cangrejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100119,
					"content": "Eso no es muy específico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "¿En serio? Es un lugar muy alto y con agua salada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100121,
					"content": "¿Qué tal si le enseñamos nuestro mapa a Neko...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "Sus capacidades de comprensión no son muy buenas, ¿verdad? Este es el lugar muy alto, y aquí está el agua salada. Seguro que están allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100123,
					"content": "#Nosotr{F#as}{M#os} nos encargaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Lo dejo en sus garras, miau, miau. Ay, estos mininos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100125,
					"content": "No se me da bien atrapar gatos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Miau, miau, no se preocupen. A esos dos no les dan miedo los humanos. De hecho, se van por ahí precisamente porque no tienen a nadie con quien jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100127,
					"content": "Lo dejo en sus garras, miau, miau. Ay, estos mininos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
