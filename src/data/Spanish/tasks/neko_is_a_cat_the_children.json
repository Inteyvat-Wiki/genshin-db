				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "¿Los encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100402,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "¡¿Por qué ustedes dos nunca escuchan a Neko?! ¿No pueden portarse tan bien como Anchoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100404,
					"content": "Anchoa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Sí que tienes buenas ideas para nombres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Miau, miau, miau, miau... miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "Hachihou"
				},
				{
					"id": 722100407,
					"content": "¡Miau! ¡Miau miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100408,
					"content": "¡No me respondas así! ¿O acaso quieres que Neko no vaya a buscarte, te deje pasar hambre desde... desde que salga el sol, hasta que salga la luna, hasta que el sol vuelva a estar en lo alto, y dejarte encontrar el camino a casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100409,
					"content": "Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100410,
					"content": "Jeje, es un buen chico. Está bien, está bien. Qué bueno que volvió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100411,
					"content": "Muchas gracias, sin su ayuda, los pequeños habrían pasado hambre allá afuera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100412,
					"content": "Deberían poder volver por sí mismos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "De todos modos, Neko está muy agradecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100414,
					"content": "Si tienen tiempo, recuerden venir a visitarnos a menudo. Tal vez Neko tenga otros asuntos en los que necesite que le presten una pata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
