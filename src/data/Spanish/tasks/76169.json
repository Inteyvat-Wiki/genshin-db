			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Paimon, me alegro de verl{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690102,
					"content": "#Nosotr{F#a}{M#o}s también hemos venido a verlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "Si él supiera que vendrían, se habría puesto muy contento, aunque no dijera nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690104,
					"content": "Se reúnen junto a Illuga ante la tumba durante un tiempo...\\nIlluga le habla a su camarada caído, contándole todo lo que ha pasado recientemente en Piramida...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Seguro que, ahora que sabe que todos en Piramida están bien, podrá descansar en paz, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761690106,
					"content": "#Sí. Completó su misión. Y nosotr{F#a}{M#o}s continuaremos con la nuestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690107,
					"content": "Y después, habrá otros que sigan vigilando esta tierra. Al igual que la hierba invernal, seguirán creciendo con fuerza a pesar de las tormentas y el frío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
