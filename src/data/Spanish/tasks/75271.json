				"objectNames": [
					"Ziki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "¡Unos románticos globos rojos! ¡Qué bonitos! Seguro que a mi querida Yopoyi le van a encantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "#¿A que sí, amig{F#a}{M#o} mí{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "Eh... No sé yo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "#De todas formas, muchísimas gracias por tu ayuda, amig{F#a}{M#o} mí{F#a}{M#o}. Quédate y no te vayas, quiero presentarte a Yopoyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Calculando el tiempo, más o menos debería estar llegando. Quedamos a esta hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Seguro que sí. La vas a dejar sorprendida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
