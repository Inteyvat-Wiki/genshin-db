			"dialogs": [
				{
					"id": 752710501,
					"content": "#Muchísimas gracias, amig{F#a}{M#o} mí{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710502
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710502,
					"content": "Ziki te habrá pedido muchos favores, ¿verdad? Su forma de pensar es un poco diferente a los demás, pero precisamente es lo que me gusta de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yopoyi"
				}
			]
		},
