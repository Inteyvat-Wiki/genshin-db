			"dialogs": [
				{
					"id": 752710201,
					"content": "#Qué suerte la mía de poder conocerte, amig{F#a}{M#o} mí{F#a}{M#o}. Por favor, ayúdame a pintar los globos de un color rojo romántico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				}
			]
		},
		{
			"id": 7527103,
			"completionStepIds": [
				7527103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
