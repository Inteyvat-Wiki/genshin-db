			"dialogs": [
				{
					"id": 752710601,
					"content": "¡Yopoyi, ya estás aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "¿Ziki? ¿Eres tú? ¿Por qué estás vestido así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "Estoy disfrazado de tu Nanasiano favorito. Alquilé este disfraz para esta ocasión tan especial. ¿Te gusta cómo me queda? ¡Y estos globos! ¡También los preparé para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "En realidad, hay algo que quería decirte desde hace tiempo... Me gustas, ¿quieres salir conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "¿T-tú estás loco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "¡No! Mi querida y amada Yopoyi, ¡quiero que seas mi novia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "¿Estás bien de la cabeza? ¡Hoy es nuestro tercer aniversario! ¡Estamos casados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "¡Lo sé, por supuesto que me acuerdo! Pero como siempre dices que no soy nada romántico, y nunca me había declarado antes del matrimonio... ¡Esta es mi tardía declaración de amor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Ah, con que era eso... Pues sí, seamos novios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "¿Lo dices en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Sí, mi héroe romántico, lo digo en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Una brisa apacible los acaricia y los dos se abrazan.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
