			"dialogs": [
				{
					"id": 760280301,
					"content": "#*Solloza*, ¡por fin te encuentra Paimon, {NICKNAME}! Después de que esas dos cosas brillantes chocaran entre sí, la onda de choque de la explosión mandó volando a Paimon, pero por suerte no salió lastimada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "A Paimon le tomó mucho tiempo volver volando hasta aquí... ¡Menos mal que estás bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "La verdad es que yo también estuve volando un buen rato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Paimon entiende... ¿Eh? Espera, ¿por qué volando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Le cuentas a Paimon lo que acabas de ver...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Humm, Paimon nunca había oído que existiera un lugar así en Teyvat... {NICKNAME}, no habrás tenido alguna alucinación extraña, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "Pero bueno, ¡lo importante es que estés a salvo! Hay demasiadas cosas extrañas en este lugar que Paimon no entiende. Mejor vámonos de aquí cuanto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Arg, Paimon no pensó que fuera tan peligroso, y al final ni siquiera encontramos ningún tesoro... ¿Por qué habrá aparecido en este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "Además, si esas dos cosas brillantes no eran Seelies, ¿qué serán?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "Creo que el viento me arrastró a un lugar extraño...",
