			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "Tsumi, ¡lo logramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510102,
					"content": "Lo sé. Se encargaron de las tres torres con éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510103,
					"content": "La evacuación está yendo mucho más rápido gracias a la mejora de las condiciones ambientales. Bien, la mayoría de los soldados ya salieron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510104,
					"content": "Pero parece que sucedió algo que yo no había previsto. Vengan conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005102",
							"2"
						],
						"stepId": 4005102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "¡Una oscuridad brota del interior del Dainichi Mikoshi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510202,
					"content": "Siguiendo la lógica, Enkanomiya ya debería haber vuelto a la normalidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510203,
					"content": "Por desgracia, ahora este lugar se ha convertido en el más peligroso de todos. No sé por qué está sucediendo esto o qué deberíamos hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510204,
					"content": "Pero puedo decirles dónde se encuentra el tipo que está detrás de todo esto. Voy a tener que pedirte que te enfrentes a él y lo obligues a revelar su plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510205,
					"content": "¿Cómo pudo suceder esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510206,
					"content": "Estuve observando el flujo de la oscuridad y me percaté de algo en particular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510207,
					"content": "Había un pequeño remolino que absorbía continuamente la oscuridad. Supongo que ese flujo debe haberse activado por su falta de energía abisal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510208,
					"content": "Es extremadamente peligroso. Ni los Dragartos serían rivales para él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510209,
					"content": "No te preocupes. He estado esperando el momento de darle su merecido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "Música para mis oídos. Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510212,
					"content": "Si mis deducciones son correctas, debería estar en la zona de la <color=#00E1FFFF>biblioteca</color> ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510210,
					"content": "No temas. Ese tipo está deseando que le den una lección.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005103",
							"2"
						],
						"stepId": 4005103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aquel que se hace llamar “Enjou”"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "Oh, hola. Diría que esta es una linda sorpresa, pero... en realidad no es nada sorprendente. Mírense, aventurándose en la oscuridad, empeñándose en continuar su camino para venir a verme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510302,
					"content": "Eres la única persona que se me ocurre que podría hacer algo así. Aun así, ¿tú uniéndote a ellos? Eso sí que no me lo esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510303,
					"content": "¡Solo intentas ganar tiempo con tu charla otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510304,
					"content": "#Hum. Supongo que no son tan avispad{F#as}{M#os} como yo pensaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510305,
					"content": "#Miren, entiendo que se hayan alterado un poco al verme. Pero, francamente, el hecho de que estén tan loc{F#as}{M#os} como para hacer un viaje tan largo hasta aquí es un problema para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510306,
					"content": "Así que tendremos que quemar ese exceso de energía con algo de ejercicio, ¿de acuerdo? Así se calmarán un poco y me escucharán de una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				}
			]
		},
		{
			"id": 4005105,
			"completionStepIds": [
				4005105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005105",
							"2"
						],
						"stepId": 4005105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aquel que se hace llamar “Enjou”"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510501,
					"content": "¡Paren, paren! ¡Mi vida está pasando delante de mis ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510502
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510502,
					"content": "¡Entonces aún no he terminado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510503
					]
				},
				{
					"id": 400510503,
					"content": "Esa mujer de pupilas finas... ¿Cómo se llama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510504
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510504,
					"content": "Hum, ¿cómo la conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510505,
					"content": "Su nombre. ¿Cómo se llama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510506
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510506,
					"content": "Se llama Tsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510507,
					"content": "Hum... Esa reptil hizo muy buen trabajo imitando la forma humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510508
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510508,
					"content": "¿Reptil...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510509
					]
				},
				{
					"id": 400510509,
					"content": "Tiene sentido, ¿no? Los Dragartos de las Profundidades son extremadamente inteligentes y evolucionan con rapidez. Se cuentan leyendas sobre esto desde hace miles de años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510510
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510510,
					"content": "Sobre los humanos Dragarto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510511
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510511,
					"content": "¿Humanos Dragarto? Humm, suena al tipo de nombre que solo se le ocurriría a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510512,
					"content": "Bueno, este nombre viene de una antigua leyenda de Enkanomiya. Cuando los Dragartos de las Profundidades fueron derrotados, comenzaron a evolucionar para sobrevivir. Eso quiere decir que imitaron al bando ganador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510513
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510513,
					"content": "En algún momento, aparecieron Dragartos que eran indistinguibles de los humanos, a excepción de sus pupilas. Esos eran los humanos Dragarto. Cuenta la leyenda que se infiltraron en Enkanomiya poco a poco y ocuparon numerosos altos cargos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510514
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510514,
					"content": "¿Les recuerda a alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510515
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510515,
					"content": "Es cierto que escuchamos que las pupilas de Tsumi tienen forma vertical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510516,
					"content": "#Sí, con buena luz es posible ver que las pupilas de los reptiles son líneas verticales y finas. Una evidencia de que {F#las}{M#los} traicionó enfrente de sus narices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510517
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510517,
					"content": "Pero ella nos ha estado ayudando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510518,
					"content": "#Solo {F#las}{M#los} utiliza para vengarse de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510519
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510519,
					"content": "Formé una alianza con los Dragartos. Dije que sumiría a toda Enkanomiya en la oscuridad para que ellos pudieran enviar sus fuerzas de élite hacia el Dainichi Mikoshi y, así, rescatar a los suyos que fueron aprisionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510520
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510520,
					"content": "A cambio, ellos permitirían a la Orden del Abismo atravesar su territorio con seguridad y me ayudarían a reconstruir las tres torres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510521
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510521,
					"content": "Pero ellos no sabían que la oscuridad del Abismo es un terrible veneno para los seres elementales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510522
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510522,
					"content": "Entonces, ¿creen que los traicionaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510523,
					"content": "Los traicioné por completo. Para ser sincero, sería humillante que la Orden del Abismo liberase el poder del Abismo sobre ellos y acabaran yéndose como si nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510524
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510524,
					"content": "¡Eres pura maldad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510525,
					"content": "Bueno, aquí es donde estamos ahora: una vez que ella haya terminado con ustedes, utilizará el poder del Dainichi Mikoshi para reprimir a los pólipos de coral y crear una oscuridad con la que proteger a los Dragartos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510526
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510526,
					"content": "Probablemente estén sumergiéndose en la oscuridad para rescatar a sus compañeros aprisionados mientras nosotros hablamos. No queda mucho tiempo para que corten el origen de la rama de coral sangriento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510527
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510527,
					"content": "Humm, pobres Dragartos de las Profundidades, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510528,
					"content": "Si todavía quieren salvar la Isla Watatsumi, tendrán que darse prisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510529
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510529,
					"content": "Pueden utilizar el mecanismo que dejé atrás para guiar la luz y disipar la oscuridad en el Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510530
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510530,
					"content": "¡No nos creemos ni una sola palabra de lo que dices!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510531,
					"content": "#Uf, en serio, chic{F#as}{M#os}, ¿de verdad creen que tienen otra opción?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510532
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510532,
					"content": "Llegados a este punto, para mí este solo es otro viaje inútil a Enkanomiya. Aunque tampoco es un problema, ya que en realidad estoy bastante al margen dentro de la Orden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510533
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510533,
					"content": "A diferencia de otros compañeros que se entregan tanto para servir a Su Alteza, yo estoy interesado en asuntos más intrascendentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510534
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510534,
					"content": "Rayos, el tiempo vuela. Será mejor que me vaya. Diría “hasta luego”, pero... Seguramente no volveremos a vernos. Toma, tengo un regalo de despedida. Es algo que conseguí en el Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510535
					],
					"speakerTitle": "Aquel que se hace llamar “Enjou”"
				},
				{
					"id": 400510535,
					"content": "Esto parece pertenecer al mismo objeto del fragmento que nos dio Kokomi. Espera, no es momento para eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510536,
					"content": "¡Ah! ¡Paimon está furiosa! ¡Otra vez se escapó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510537,
					"content": "No podemos confiar en ese tipo, por más sentido que tengan sus palabras. Volvamos a buscar a Tsumi y preguntémosle sobre todo esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005111,
			"completionStepIds": [
				4005111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005111",
							"2"
						],
						"stepId": 4005111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511101,
					"content": "Paimon se quedó de piedra. ¡Funcionó de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511102,
					"content": "Por una vez, no nos mintió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511103,
					"content": "Técnicamente hablando, nunca nos mintió.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "Bueno, ¡quizás no debería explicar las cosas tan sospechosamente! ¿Por qué Paimon tiene la sensación de que ustedes dos se han puesto de acuerdo? ¡Eso no está bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511105,
					"content": "Ya debería ser posible acceder al Dainichi Mikoshi. Vayamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005115,
			"completionStepIds": [
				4005115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005115",
							"2"
						],
						"stepId": 4005115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "¡Esa es Tsumi! ¿Qué está haciendo en frente del Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511502,
					"content": "Regresaste. Ahora me pica la curiosidad... ¿Salió bien la operación de rescate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511503,
					"content": "Algunas crías de Dragarto fueron rescatadas antes de que llegáramos. Pero los más mayores y débiles regresaron al agua para esconderse después de que derrotáramos a los de élite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511504,
					"content": "Tsumi... ¿Eres una humana Dragarto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511505,
					"content": "No tengo la intención de darles una explicación. Aunque sí puedo decirles que sé perfectamente que interactuar con los humanos solo puede acabar en traición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511506,
					"content": "El conflicto entre ambas especies continuará para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511507,
					"content": "Antes de marcharme, destruiré esta luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511508,
					"content": "¿Vas a hacerlo tú sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "No se acerquen más, ni se les ocurra intentar atacarme por sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511510,
					"content": "Esta torre parece escuchar mis deseos... Solo tengo que pedirlos mentalmente y entonces cambiará su luminosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511511,
					"content": "Si así lo deseara, colapsaría ante mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511512,
					"content": "Con un simple chasquido de dedos, puedo destruir esta fuente de gran dolor para los Dragartos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511513,
					"content": "Pero ¿por qué? ¿Por qué no puedo hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511514,
					"content": "#¡Oh, no! ¡Esto es mucho más grave que perder el acceso a la rama de coral sangriento! ¿Qué vamos a hacer, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511515,
					"content": "Tsumi, ¿reconoces esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "Es... ¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511518,
					"content": "Tsumi recuerda su colgante y lo junta con los demás fragmentos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "Es un colgante con forma de... ¿tres serpientes enroscadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511520,
					"content": "Este colgante ha estado conmigo desde que tengo uso de razón. ¿Por qué encaja con sus dos piezas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511521,
					"content": "Presiento que tú ya sabes la respuesta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "#No seas ridícul{F#a}{M#o}. ¿Quieres decir que...? Que yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511523,
					"content": "Paimon no entiende nada... Este fragmento es de Kokomi, este es del Dainichi Mikoshi, y Tsumi siempre tuvo el suyo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511524,
					"content": "Perteneces a la Isla Watatsumi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511526,
					"content": "Yo crecí con los Dragartos. Mis únicas posesiones eran este colgante y unas cuantas cajas de libros. Aprendí la lengua y la escritura de los humanos con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511527,
					"content": "Pero no mucho después de eso, no quedó ni un solo ser humano en Enkanomiya. De repente se halló completamente desolada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511528,
					"content": "No pude tener contacto con los humanos hasta hace poco, y aprendí lo que significaban realmente todas esas cosas de las que hablaban en los libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511529,
					"content": "Tsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511530,
					"content": "En los libros se mencionaban cosas que yo nunca comprendí hasta este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511531,
					"content": "“Las personas pertenecen al lugar donde nacieron, pero las criaturas pertenecen allá donde tienen alimento”. Yo soy una Dragarto, no una humana. Así que regresaré al lugar al que pertenezco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511532,
					"content": "Supongo que el Dainichi Mikoshi no me concierne. Pero regresaremos algún día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511534,
					"content": "Tsumi se marchó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511535,
					"content": "¿Por qué cambió de parecer en el último momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511536,
					"content": "Quizás Kokomi lo sepa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "Claro. Kokomi se habrá anticipado a esta posibilidad. Por eso nos dio el fragmento del colgante desde el comienzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511538,
					"content": "Todo solucionado. Volvamos para contárselo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511516,
					"content": "Tsumi, esto es para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
