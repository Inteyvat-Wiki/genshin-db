			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511701,
					"content": "Oh no, Tsumi se fue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511702,
					"content": "No es posible que la hayamos perdido de vista por el camino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511703,
					"content": "¿Por qué siempre acabamos así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511704
					]
				},
				{
					"id": 400511704,
					"content": "Oh, vamos, está bien. No te pongas triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511705,
					"content": "Mira el lado bueno, la mayoría de los soldados ya fueron evacuados. Si ahora apareciera algún Dragarto, nadie saldría herido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511706,
					"content": "Aunque pensar en lo que dijo ese tipo enfurece a Paimon, parece que no tenemos otra opción que darle una oportunidad a lo que nos dijo. Traigamos la luz hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005119,
			"completionStepIds": [
				4005119
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
