			},
			"dialogs": [
				{
					"id": 400511101,
					"content": "Paimon se quedó de piedra. ¡Funcionó de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511102,
					"content": "Por una vez, no nos mintió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511103,
					"content": "Técnicamente hablando, nunca nos mintió.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "Bueno, ¡quizás no debería explicar las cosas tan sospechosamente! ¿Por qué Paimon tiene la sensación de que ustedes dos se han puesto de acuerdo? ¡Eso no está bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511105,
					"content": "Ya debería ser posible acceder al Dainichi Mikoshi. Vayamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
