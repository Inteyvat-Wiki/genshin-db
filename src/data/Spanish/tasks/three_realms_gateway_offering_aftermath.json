			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511901,
					"content": "Después de contarlos, parece que las crías de Dragarto ya no están aquí. ¿Será que las rescataron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511902,
					"content": "Si los Dragartos de las Profundidades vinieron aquí, eso significa que ese tipo decía la verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511903,
					"content": "Entonces... ¿Tsumi de verdad es una humana Dragarto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511904,
					"content": "Pero no la hemos visto por ninguna parte. ¿Dónde rayos estará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511905,
					"content": "*Suspira*, da igual. Regresemos arriba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005150,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
