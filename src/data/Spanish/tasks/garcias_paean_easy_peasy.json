					"nextDialogs": [
						230165102,
						230165105
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165102,
					"content": "¿El Sr. García lleva mucho tiempo aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165103
					]
				},
				{
					"id": 230165103,
					"content": "Bastante, diría yo. Este tipo estudia con más pasión que muchos de mis aprendices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165104
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Pero no tengo claro que pueda ganarse la vida como herrero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Además de mí, ¿ha venido alguien más preguntando por él?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "Ahora que lo dices, sí. Hay una mujer que viene a menudo, siempre le trae muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Creo que se llama Kaia, o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "No sé porque mi herrería sigue llenándose de gente que no tiene nada que ver con la forja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				}
