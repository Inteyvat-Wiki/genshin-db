			"dialogs": [
				{
					"id": 230163901,
					"content": "El Sr. García sigue tus instrucciones...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "¡Genial! Funcionó, ¡este engranaje no está nada mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230163903,
					"content": "Necesito una regla para medir el espacio exacto entre los dientes, el grosor, el tamaño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230163904,
					"content": "#Dejemos que el Sr. García siga con sus mediciones. Viajer{F#a}{M#o}, muchas gracias por tu ayuda. Esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "¿Aún eres pesimista por precaución?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Así es, siempre he sido así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "El Sr. García y yo llevamos mucho tiempo intentando superar este gran obstáculo. Parece que por fin hemos conseguido dar un paso adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Pero seguimos sin encontrar la solución al problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "Espero que el talento del Sr. García logre guiarnos por el camino correcto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "Si no, lo único que me queda es recitar aquel famoso dicho: “Cuando el Arconte cierra una puerta, una ventana se abre”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
