			"dialogs": [
				{
					"id": 230165001,
					"content": "Señor, si me permite compartir mi opinión, tal vez deberíamos... cambiar de estrategia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165002,
					"content": "¿Cambiar de estrategia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230165003,
					"content": "Tal vez podría usted fabricar una máquina que sea lo suficientemente ingeniosa, pero no tan compleja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "Creo que para este tipo de máquina, su talento no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "Querido Lutong, ya hemos hablado de esto. Sabes de sobra cuál será mi respuesta... Aunque siempre respetaré tus elecciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230165006,
					"content": "Entonces, será mejor que decidamos el lugar en el que cenará con la Srta. Kaia, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Muchas gracias, mi querido Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230165008,
					"content": "Es un placer, señor. Nuestro contrato aún está vigente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
