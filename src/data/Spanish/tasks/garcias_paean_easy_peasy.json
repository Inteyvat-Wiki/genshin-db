			"dialogs": [
				{
					"id": 230160301,
					"content": "¡Lutong! Este engranaje está listo para desmoldarse. ¡Ayúdame, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160302,
					"content": "#Viajer{F#a}{M#o}, has vuelto. Supongo que ya memorizaste las técnicas del señor Ahangar, ¿me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160303,
					"content": "Vamos, dime, ¿qué debo hacer con este engranaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				}
			]
		},
