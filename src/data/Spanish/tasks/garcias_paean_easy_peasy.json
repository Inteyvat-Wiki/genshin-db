				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. García",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "¡Ay! Tengo las manos entumecidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160102,
					"content": "Sr. García, todavía tiene que encargarse de las cuentas de la Srta. Kaia. No debería trabajar tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "¡Ya lo sé! ¡No me lo repitas, Lutong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160104,
					"content": "Si no pudiera ir usted mismo, yo podría ir en su lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "¡No! Puedo hacerlo. Solo tengo que forjar unos cuantos engranajes más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160107,
					"content": "De acuerdo, ya no puedo más. He alcanzado mi límite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160108,
					"content": "¿Y ahora que estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "#Viajer{F#a}{M#o}, ¡eres tú! ¡Ay! Mis manos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160110,
					"content": "Verás, el Sr. Ahangar está hasta arriba de trabajo, así que no puede seguir fabricando componentes para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160111,
					"content": "Además, los componentes que me fabrica siempre son ligeramente diferentes a lo que tengo en mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160112,
					"content": "Por eso, para garantizar la precisión métrica de los componentes, decidí forjarlos por mí mismo. El propio Sr. Ahangar me enseñó algunas de sus técnicas de forja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160113,
					"content": "Por suerte, ya había hecho algo así cuando estaba en Fontaine. Aun así... hay algunas técnicas que no logro perfeccionar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160114,
					"content": "#Viajer{F#a}{M#o}, ¿podrías pedirle al Sr. Ahangar que te enseñe esas técnicas? Yo de verdad necesito descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160115,
					"content": "De acuerdo, descansa un rato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Gracias por tu ayuda. Ay, mi mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160116,
					"content": "¿Quién es Kaia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "¡Es una de nuestras socias! ¿Cómo decirlo? ¡Es una socia muy talentosa y adinerada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160118,
					"content": "Tenemos un contrato a largo plazo para gestionar sus finanzas, por eso tengo que ir a verla, ¿verdad, Lutong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230160119,
					"content": "Totalmente cierto, Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "#Así están las cosas... Viajer{F#a}{M#o}, por favor, encuentra al Sr. Ahangar lo antes posible. Te espero aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "¿No te acabo de decir que esperes un momento? ¿Eh? ¿Qué haces tú aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "Tengo algunas preguntas de parte del Sr. García.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Así que es verdad que está forjando los engranajes él mismo... Qué hombre tan singular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "En todos mis años como herrero nunca había conocido a una persona tan meticulosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "Incluso trae una regla para medir las uniones entre los tubos, ¡y también mide la distancia entre los pasos de rosca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "Sinceramente, no lo aguantaba más, así que le sugerí que lo hiciera él mismo... No me esperaba que al día se presentara aquí para pedirme que le enseñara mi técnica de forja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Es muy testarudo, así que si quiere hacerlo, no seré yo quien se lo impida. Mientras me pague por los materiales, estoy dispuesto a prestarle mis herramientas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "*Suspira*. Lo cierto es que no tengo ni la menor idea de qué pretende conseguir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "Está construyendo una máquina increíble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Como sea... Cosas muy extrañas. Y tú has venido para aprender mis técnicas, ¿me equivoco? La verdad es que no tengo nada más que enseñarles sobre el forjado de engranajes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "Sin embargo, me he dado cuenta de que ese tipo quiere engranajes de bordes muy afilados, pero con el centro cóncavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "Trabajar solo con moldes no es suficiente para crear engranajes tan especiales. Se requiere de un procedimiento adicional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "Ya le enseñé cómo hacerlo con todo lujo de detalles. Tú solo recuérdale que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "Primero, al introducir las piezas en el horno por segunda vez, <color=#00E1FFFF>debe agregar bastante combustible</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Después de sacar los engranajes del horno, <color=#00E1FFFF>debe martillarlos de adentro hacia afuera</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "¿Te acordarás? Bueno, pues entonces ve a decírselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "Sin duda, un tipo muy singular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "Está construyendo una máquina muy extraña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Tiene las manos entumecidas de tanto trabajar. Necesita descansar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
