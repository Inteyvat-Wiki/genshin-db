	"talks": [
		{
			"id": 7418101,
			"completionStepIds": [
				7418102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418102",
							"2"
						],
						"stepId": 7418102,
						"stateName": "QUEST_STATE_UNFINISHED"
