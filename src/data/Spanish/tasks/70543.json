			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "... Miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Pelusa"
				},
				{
					"id": 705430103,
					"content": "Oh, ustedes. Yo estar charlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "¿Charlando? ¿Estabas teniendo una conversación con Pelusa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "Miau... ¡Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Pelusa"
				},
				{
					"id": 705430106,
					"content": "Paimon deduce que Pelusa está diciendo... “Sí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "Olor familiar, yo venir a buscar amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "Muy bien. Yo feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "¡Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Pelusa"
				},
				{
					"id": 705430110,
					"content": "Olor atraer amigos, tú también venir, yo feliz. También oler a viento y lluvia, olor familiar... El olor de gato... también familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon, olor dulce, gustar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "¡¿Eh?! ¿Dulce? ¿Acaso Paimon huele al panqueque que nos dio Valerina? P-pero... Paimon no comió tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "También te has comido la mitad del mío, ¿no te acuerdas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Paimon no se dio cuenta... Ay, ¡la culpa es del panqueque por estar tan delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "Jeje, a Paimon también le apetece pollo asado con miel, filete a la barbacoa, tortilla de papas... ¡y sidra de manzana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#¡Paimon ya tiene el menú decidido! {NICKNAME}, vamos a buscar a Valerina para pedir los platos. Razor, ¡ven con nosotr{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "Gra... gracias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "Pelusa traerme muchas... nueces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "Y carne en cajas... Yo estar lleno ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "Suena como un pedido para llevar de Valerina. Paimon se pregunta si Pelusa fue quien trajo la comida para Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "Miau, miau. ¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Pelusa"
				},
				{
					"id": 705430123,
					"content": "¡Paimon está sorprendida! ¡En el Palacio Peludino hay gatos que sirven a los visitantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "¡A los gatos les gusta Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "No pasa nada, podrías comer el triple sin problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
