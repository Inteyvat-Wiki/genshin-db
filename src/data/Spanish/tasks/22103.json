					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030202,
					"content": "Hummm, no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Dese prisa, por favor. Ese huésped va y viene sin avisar, podría llegar en cualquier momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030204,
					"content": "Si se llega a entrometer, me temo que será el fin de nuestro negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
