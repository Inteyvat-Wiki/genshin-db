					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "Excelente... ahora puedo hacer negocios en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
