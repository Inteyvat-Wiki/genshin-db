			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah... Una vez fui el propio lenguaje, pero ahora me he convertido en el sujeto fragmentado de una ilusión que regresa una vez más a este imperfecto “símbolo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "¡Uaaah! ¡Un tipo raro salió de un libro raro diciendo cosas raras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "“Raro” es un término poco riguroso. Implica una entidad única que no puede ser descrita, escrita o representada, y yo claramente no encajo en esa definición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "Solo intentaba buscar un acceso a la “realidad” entre las páginas, pero resbalé sin querer hacia una metáfora infinitamente aplazada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "Me convertí en un remanente que no podía ser simbolizado. Gracias a tu intervención, pude ser despojado de la tiranía del lenguaje y ahora puedo volver a malinterpretarme a mí mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Ahora dilo para que podamos entenderlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "... Me caí dentro de las páginas del libro sin querer y no podía salir. Gracias por sacarme de ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
