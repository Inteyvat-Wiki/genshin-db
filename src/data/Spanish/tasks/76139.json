			"dialogs": [
				{
					"id": 761390101,
					"content": "La industria editorial no da ganancias. Quizá debería dedicarme de lleno a hacer inversiones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Quería ver los cupones de inversión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "#Por supuesto. Aquí puedes comprar un cupón de inversión por 2000{NON_BREAK_SPACE}Moras, el cual podrás canjear una vez a la semana. En esta bolsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "... ¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "N-nada. No esperaba que la jefa Néfer se presentara en mi humilde tienda. ¿V-viene a comprar cupones de inversión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "#Yo no, solo estoy acompañando a mi amig{F#a}{M#o} a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761390108,
					"content": "He oído que le está yendo estupendamente en su negocio de inversiones, y hoy he podido comprobar que es cierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761390109,
					"content": "Qué va, qué va, jaja... Solo es un pequeño negocio para ganarme la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "¿En serio se pueden obtener ganancias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "Claro que sí. El jefe Dhabit es un excelente hombre de negocios. Si inviertes con él, seguro que no saldrás perdiendo, ¿verdad que sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761390112,
					"content": "Sí, claro... Jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "Veamos qué suerte tengo hoy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "¡Hoy! ¡Hoy mismo! ¡El cupón de inversión que compraste es el nuevo cupón de inversión... de corto plazo que acabamos de sacar! ¡Las ganancias y las pérdidas se calculan de inmediato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "¿Por qué parece que acabas de inventarte todo eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "Eh... Bueno, muchas gracias por comprar este cupón de inversión de corto plazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "Aquí tienes tus ganancias de inversión, ¡que tengas un buen día!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "Bueno, habrá que celebrarlo, hemos ganado dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "¿En serio? Jejeje, ¡cómprale a Paimon una con forma de pajarito, a Paimon le encanta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "Pues es hora de irme. Como decía, es usted un hombre de negocios de confianza, Sr. Dhabit. Mucho éxito en su negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761390122,
					"content": "Gracias por sus palabras, jefa Néfer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390123,
					"content": "Lo que le pedí la otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390124,
					"content": "Encontré lo que buscabas, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761390125,
					"content": "No se precipite, Sr. Dhabit. Las cosas salen mejor cuando se hacen con calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761390126,
					"content": "S-sí, tiene razón. Lo dejo en sus manos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390119,
