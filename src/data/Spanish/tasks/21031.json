					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Uff, tengo que pensar en algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310102,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Oh, eres tú. *Suspira*, ni me preguntes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310104,
					"content": "Últimamente el negocio en la posada ha mejorado y cada vez tenemos más huéspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310105,
					"content": "Algunos vienen buscando un poco de paz, y otros llevan a toda su familia de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310106,
					"content": "Un negocio próspero es una gran noticia, por supuesto, pero por los alrededores sigue habiendo muchos monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310107,
					"content": "Si un niño que saliera a jugar o un anciano que fuera a dar un paseo se encontraran con esas criaturas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310108,
					"content": "Para evitar que ocurra un incidente así, tengo que salir y ahuyentar a los monstruos que hay cerca de la posada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310109,
					"content": "Pero yo solo no puedo ahuyentarlos a todos, son demasiados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310110,
					"content": "#Viajer{F#a}{M#o}, ¿puedes echarme una mano? ¡Te pagaré bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310111,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "¡Cuento contigo! Vi que había varios campamentos de monstruos con criaturas peligrosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310116,
					"content": "Además, otro grupo de monstruos escurridizos se acercaron a la posada y acamparon allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310117,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310118,
					"content": "¿Sabes qué? Yo me encargaré de los más peligrosos, tú puedes deshacerte de los que están cerca de la posada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310119,
					"content": "Nos encontraremos aquí después de haberlos echado a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310120,
					"content": "Esos monstruos son un verdadero dolor de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310112,
					"content": "Te las puedes arreglar solo, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Bueno, gracias por el elogio... pero solo hago lo que puedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310114,
					"content": "Y, de todas formas, no puedo contra todos yo solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
