					"nextDialogs": [
						210310304
					]
				},
				{
					"id": 210310304,
					"content": "Estos monstruos se cruzaron en mi camino, así que los eliminé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310305
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310305,
					"content": "Este lugar no es seguro, así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310306
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310306,
					"content": "Tendré cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "De acuerdo. Tengo otros asuntos que atender. Hasta luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310303,
					"content": "¿Tú acabaste con esos monstruos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				}
			]
