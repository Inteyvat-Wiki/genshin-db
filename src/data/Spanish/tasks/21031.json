			"dialogs": [
				{
					"id": 210310401,
					"content": "Ah, han vuelto. Uf, acabar con esos monstruos fue un quebradero de cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310402
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310402,
					"content": "¿Acabaste con todos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "Jajaja, sí. Me costó bastante trabajo, ¿sabes? Ya no soy tan joven como antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310404,
					"content": "Supongo que tú también te hiciste cargo de tus monstruos, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310405,
					"content": "Sí, bueno, sobre eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "¿Todos los monstruos habían sido derrotados pero no había nadie en el campamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310407,
					"content": "Qué extraño. Tal vez un aventurero que pasaba por allí acabó con ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310408,
					"content": "Sea como fuere, gracias por ir a esa zona por mí. Acepta esto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
