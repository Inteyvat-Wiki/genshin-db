			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodocomunicador"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "Siempre que nos vemos, acabamos igual... Uso mi adivinación, leo los astros, confirmamos el objetivo y problema resuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670102,
					"content": "#Estás rodead{F#a}{M#o} de todo tipo de amigos, secretos y destinos. Es increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670103,
					"content": "#¡No, tú eres la increíble! Tú nos ayudaste a Fischl y a nosotr{F#as}{M#os} a solucionar todo el asunto de Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670104,
					"content": "Eso es algo bueno para un astrólogo, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "#Sí, más o menos. Esperemos poder permanecer tod{F#a}{M#o}s junt{F#a}{M#o}s para resolver esto, como la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670106,
					"content": "#Con eso de “tod{F#a}{M#o}s junt{F#a}{M#o}s”, ¿te refieres solo a ustedes dos o a nosotr{F#as}{M#os} tres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670107,
					"content": "Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670108,
					"content": "#Está bien, está bien, {F#las}{M#los} tres. A veces tus opiniones me son realmente útiles, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670109,
					"content": "¿De verdad? Vaya, ¡a Paimon le estás empezando a caer superbién, Mona, genio de la astrología!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670110,
					"content": "¿Ves? ¡Justo me refería a ese tipo de opiniones! En este mundo no existe otro astrólogo tan inteligente y encantador como yo, ¡jojojo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670111,
					"content": "Pues sí, ¡eres genial! Pero... ¿podrías no reírte como Fischl otra vez? Nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670112,
					"content": "¡*Ejem*! Perdón... Es que cuando una pasa tanto tiempo con sus amigos, se contagian los hábitos... Jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670113,
					"content": "#Seguiré observando las estrellas. Sigamos en contacto, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
