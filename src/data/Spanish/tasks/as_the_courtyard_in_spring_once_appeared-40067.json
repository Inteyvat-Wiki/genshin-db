			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodocomunicador"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671401,
					"content": "Esas casas extrañas de hoy... y la ilusión del bonsái... ¡Cuántas cosas raras hubo hoy! Ehm... ¿Crees que deberíamos contárselo a Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671402,
					"content": "Supongo que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "¡Dodoco! ¡Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
					"speakerTitle": "Dodocomunicador"
				},
				{
					"id": 400671405,
					"content": "¡Dodoco! ¡Dodoco! ¡Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "Dodocomunicador"
				},
				{
					"id": 400671406,
					"content": "No responde... Qué extraño, ¿por qué nos ignora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671407,
					"content": "Es muy raro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "A lo mejor volvió a distraerse. O quizás olvidó llevarse la bomba a la actuación. O tal vez esté borracho y se haya quedado dormido bajo ese árbol gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671409,
					"content": "Humm... Tal vez deberíamos intentarlo otra vez mañana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671410,
					"content": "#Viajer{F#a}{M#o}, Paimon, aquí están.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671411,
					"content": "¡Hola, Mona! ¿Ya terminaste de hablar con Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671412,
					"content": "Jajaja, más o menos. Estaba un poco decaída. Supongo que tiene que ver con la ilusión que vimos hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671413,
					"content": "Fischl estaba muy emocionada desde el principio con todo esto del viaje, pero creo que no quiere ver su propia ilusión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671414,
					"content": "¿Y eso? Paimon creía que estaría más emocionada que los demás por verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671415,
					"content": "... Aún no tengo claro el porqué, pero estaré pendiente de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671416,
					"content": "Hay algo más que me gustaría contarles. Intenté consultar los astros en la playa otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671417,
					"content": "Mi artilugio de adivinación seguía estando borroso, pero sentí una gran fuerza que emanaba de ella. No pude localizar su posición, pero sé que estaba cambiando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671418,
					"content": "¿Cómo puedes estar segura si no lo viste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671419,
					"content": "Humm, ¿cómo podría explicárselo a alguien que no sabe del tema? ¡Ah, ya sé! Es como si estuvieras en una habitación que tiene una grieta en la pared. No sabes dónde está, pero sientes el aire colarse por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671420,
					"content": "No solo eso, sino que cada vez va haciendo más frío en la habitación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671421,
					"content": "¡Ah! Paimon cree que ya lo entiende. Y tú quieres encontrar esa grieta, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671422,
					"content": "Algo así. Necesito ver la grieta para saber qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671403,
					"content": "Llamémosle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
	]
