			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodocomunicador"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "... Nunca pensé que veríamos algo semejante en un lugar con semejante apariencia de ensueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "¿Qué te parece?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "No está mal. Aunque me vendría bien algo de ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "¿Qué quieres que hagamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "Humm... Supongo que nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "¡Oye! ¡¿Nos estás menospreciando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "Para nada. Es que me acabo de dar cuenta de que, aunque no hablas demasiado, siempre haces todo lo posible por ayudarnos y nunca alardeas de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "#Eres de ese tipo de compañer{F#a}{M#o}s que todo el mundo necesita. Estando tú aquí, creo que todos nos sentimos mucho más tranquilos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "Sé que cargar con tanta expectativa supone una gran presión, pero... creo que los astrólogos somos extremadamente observadores. No solo somos capaces de observar los astros, también podemos vislumbrar la bondad en los corazones de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "¿Estás intentando halagarnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
					"content": "No era ningún halago. Me limito a exponer la verdad tal y como la veo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670213,
					"content": "Ya veo. Así que no quieres admitir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "... ¡que le estás haciendo un cumplido a alguien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670215,
					"content": "¡Oye! ¡Deja de reírte! Ya he dicho que era una opinión objetiva, ¡no un cumplido! ¡NO ES UN CUMPLIDO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670216,
					"content": "#Seguiré observando las estrellas. Sigamos en contacto, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006703,
			"completionStepIds": [
				4006703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
