			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Escuchar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670401,
					"content": "Tú debes de ser Kaedehara, ¿me equivoco? Vamos, sube, te sacaré de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "Escuchar"
				},
				{
					"id": 400670402,
					"content": "Pero... ¿Por qué quieres ayudarme? Soy un fugitivo en busca y captura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670403,
					"content": "Pues porque la Comisión Yashi... *Ejem*. Digamos que un benefactor anónimo me pagó para que te sacara de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Escuchar"
				},
				{
					"id": 400670404,
					"content": "Esto es todo lo que pueden hacer por ti. Después, tendrás que arreglártelas tú solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escuchar"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
							"2"
						],
						"stepId": 4006712,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4005914",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "En ese macetero debería haber una planta seca. Pero, en su lugar, no había nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670502,
					"content": "Tuve mucho tiempo para reflexionar mientras ustedes no estaban. Creo que, finalmente, me di cuenta de algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670503,
					"content": "Esta ilusión... soy yo. El macetero vacío no es más que un reflejo de mi corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670504,
					"content": "Cuando me siento en paz, el mundo también lo está. Cuando siento un vacío en el corazón, ocurre lo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670505,
					"content": "Paz y ninguna carga... Eso es lo que siento ahora mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670506,
					"content": "Eso no quiere decir que no tenga remordimientos. El no tener cargas es sinónimo de estar vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670507,
					"content": "Creo que por eso el bonsái forma parte del dominio. Intenta darme la oportunidad de cumplir mis deseos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670508,
					"content": "Nunca me había dado cuenta de que, en realidad, yo también quería crear mi propio bonsái... Supongo que ahora sí que puedo decir que estoy manteniendo vivas las tradiciones del clan Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006706,
			"completionStepIds": [
				4006712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
							"2"
						],
						"stepId": 4006712,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4005914",
							"0"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"40067"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "Entonces, ¿has podido hacer eso que tanto querías, Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670602,
					"content": "Podría decirse que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670603,
					"content": "Ustedes pudieron ver a mi yo del pasado y despedirse de él. Ahora que han sido testigos de mi historia, se convertirá realmente en parte de la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670604,
					"content": "Lo más importante en esta vida no es lo exigentes que somos con nosotros mismos, sino los lazos que creamos en el camino. No puede haber futuro para una persona que está atrapada en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670605,
					"content": "Espero que puedan creerme cuando les digo que he llegado muy lejos y que pretendo seguir adelante. Les estoy enormemente agradecido por su apoyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006710,
			"completionStepIds": [
				4006715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006715",
							"2"
						],
						"stepId": 4006715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Escuchar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "¡Ey, amigo! ¿Todo bien? ¿Necesitas que te lleven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "Escuchar"
				},
				{
					"id": 400671002,
					"content": "¿Piratas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "Escuchar"
				},
				{
					"id": 400671003,
					"content": "¡Ja! ¡Sí, somos piratas! ¿Vienes o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escuchar"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
							"2"
						],
						"stepId": 4006712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "Kazuha, te encontramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671202,
					"content": "Llegan justo a tiempo. Justo estaba reflexionando acerca de mi vida y creo que ya me he puesto al día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671203,
					"content": "¿Qué opinas sobre el bonsái del clan Kaedehara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671204,
					"content": "Es muy antiguo y esconde una gran historia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "Los objetos más antiguos suelen estar relacionados con nuestros remordimientos. Lo mismo ocurre con el clan Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671206,
					"content": "Pero no es un problema. Dejar atrás también es una forma de encontrar. Puede que no ahora, puede que no aquí, pero en el futuro, en algún otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671209,
					"content": "Esta ilusión es fascinante. Representa la vida como si de una obra de teatro se tratara, con cada representación más increíble que la anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671210,
					"content": "Dicen que los astrólogos han visto de todo, así que si de verdad te intriga esta ilusión, entonces la experiencia valió la pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671211,
					"content": "*Ejem*, ¿en qué estado se ubica su ánimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671212,
					"content": "La señorita pregunta cómo se encuentra ahora, Don Kazuha, y espera que no deje que la tristeza se apodere de su corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671213,
					"content": "Nadie podría estar contento después de revivir todo eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671214,
					"content": "Jaja, sí, no es un mal razonamiento. Gracias a todos por preocuparse por mí. Por suerte, logré dejar todo eso en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671215,
					"content": "La primera vez que vi el bonsái, pensé que tal vez... necesitaba esperar a que ustedes llegaran. Quizás por eso tuve que estar aquí solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671207,
					"content": "Las cosas no fueron precisamente bien, pero no tienes nada de lo que avergonzarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "Sí, lo sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006713,
			"completionStepIds": [
				4006713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006713",
							"2"
						],
						"stepId": 4006713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Fischl",
					"Mona",
					"Oz",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "*Bosteza*... Ha sido un viaje muuuuy largo. A Paimon le está entrando sueño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671302,
					"content": "Seguro que todos están muy cansados. Deberíamos irnos a descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671304,
					"content": "¿Eh? ¿Qué ocurre? No tienes muy buen aspecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671305,
					"content": "No es nada. Plausiblemente la ardua travesía de hoy esté haciendo que me sienta un poco indispuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671307,
					"content": "¿Está bien, señorita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671308,
					"content": "Oz, aplaca tu curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671309,
					"content": "Sí, señorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671310,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671311,
					"content": "Iré a buscar algo de comer. Si están cansados, deberían acostarse. Aunque si alguien quiere echar una mano, yo no me voy a quejar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671312,
					"content": "Iré yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671313,
					"content": "Yo también puedo ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671314,
					"content": "#Si todos se presentan voluntarios, ¡nosotr{F#as}{M#os} también vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671315,
					"content": "#Cuenta con nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "¡Vaya! Aprecio el entusiasmo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671317,
					"content": "Parece que Su Alteza está un poco alicaída. Mona, tú te llevas muy bien con ella, ¿por qué no te quedas a hacerle compañía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671318,
					"content": "Así que tú también te has dado cuenta. Pensaba comentarlo mientras preparábamos la comida. Bien, entonces me quedaré con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671319,
					"content": "Muy bien, nosotros prepararemos la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671320,
					"content": "Mona les guiña un ojo y se marcha. Los demás empiezan a preparar los ingredientes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "Esto debería ser suficiente. Podemos hacerlos a la parrilla. La próxima vez que pasemos por uno de esos campamentos abandonados, intentaré hacerme con una olla. Así tendremos más variedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671322,
					"content": "¡Guau, muy buena idea! Puede que no seas cocinera, Xinyan, pero sabes cómo cuidar de tus comensales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671323,
					"content": "Jeje, gracias, Paimon, pero no es nada. ¡Solo hago lo que puedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671324,
					"content": "Incluso los miembros del Alcor dicen que Xinyan es digna de confianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671325,
					"content": "¡Y pensamos lo mismo sobre ti, Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671326,
					"content": "Jajaja, ¡claro que sí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671327,
					"content": "Humm... En tal caso, y en calidad de compañero confiable, me gustaría hablar de una cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671328,
					"content": "Por lo que me han comentado, la ilusión parece estar basada en mi vida hasta el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671329,
					"content": "... Para mí fue como un sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671330,
					"content": "Quizás sea eso, quizás sea una representación de tus sueños.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "Entonces, ¿siempre has querido hacer tu propio bonsái?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671332,
					"content": "¿Podría ser... que todo esto fuera para concederme mi deseo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671333,
					"content": "Quiere decir eso que, si esto me ha pasado a mí, ¿también puede pasarle a otros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671334,
					"content": "Eso mismo estaba pensando yo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "Estoy de acuerdo, aunque me pregunto qué clase de ilusión nos encontraremos la próxima vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671336,
					"content": "Jaja, si es como un sueño hecho realidad, entonces no puedo esperar a ver mi propia ilusión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671337,
					"content": "Espera, ¿tú también quieres que te pase algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671338,
					"content": "Cualquier ilusión relacionada conmigo estaría relacionada con la música. ¡Sería una buena oportunidad para presentar un par de temas nuevos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671339,
					"content": "¿Quieres decir que te gustaría actuar en ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671340,
					"content": "¿Por qué no? Ningún músico que se precie podría quedarse de brazos cruzados en estas islas. ¡Míralas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671341,
					"content": "¡Cuánta confianza y optimismo! ¡Xinyan, eres la mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671342,
					"content": "#Ah, {NICKNAME}, a Paimon le gustaría probar la fruta que crece junto a ese acantilado. ¡Vayamos junt{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671343,
					"content": "(¿Eh? ¿Será que...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "Iré por fruta con Paimon. Les dejo el resto a ustedes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4006714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
