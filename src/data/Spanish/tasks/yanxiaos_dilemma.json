			},
			"dialogs": [
				{
					"id": 220030701,
					"content": "¿Eh? Apresúrate a regresar, o ese cocinero perderá los estribos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030702,
					"content": "¿Por qué te envía comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Somos... viejos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030704,
					"content": "Una vez, fui al Pantano Dihua y cometí un error que no pude evitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030705,
					"content": "En toda Liyue, solo esa posada me abre las puertas. Y su cocinero me da de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030706,
					"content": "Podría hablar sin parar, pero supongo que no tienes tiempo para escuchar mi historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030707,
					"content": "Vamos, vete, ese cocinero tiene poca paciencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
