			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "¡Pero qué sinvergüenza! ¡Es un aprovechado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030102,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "¿Quién, yo? Estoy preparando un plato para un parásito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030104,
					"content": "Se la pasa de holgazán todo el día, y ni siquiera está dispuesto a ayudar en la posada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030105,
					"content": "Se la pasa pescando desde que amanece hasta que anochece, pero nunca he visto que saque un solo pez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030106,
					"content": "¡De no ser por mí, ya habría muerto de hambre frente a la posada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030107,
					"content": "Olvídalo, no vale la pena gastar saliva. Aunque me oiga, finge no escucharme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030108,
					"content": "Si tienes tiempo, ¿puedes ayudarme a conseguir algunos ingredientes? Me hacen falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030109,
					"content": "No es mucho, solamente consígueme un <color=#00E1FFFF>chile de Jueyun</color> y una <color=#00E1FFFF>cabeza de loto</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030110,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Bien, en cuanto los tengas, haré de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030112,
					"content": "Pero esta posada tiene mucha comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Pero la dueña ha invertido mucho dinero en esto. Si él come sin pagar, ¿quién lo compensará?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030114,
					"content": "Todo lo que preparo para él viene de mi bolsillo. ¡No tienes ni idea cuánto me debe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030115,
					"content": "De acuerdo, ven pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
