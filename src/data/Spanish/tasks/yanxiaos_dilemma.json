			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "¿Y bien? ¿Le diste el plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030602,
					"content": "Sí, dijo que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "¡Hum! No me interesa, ese parásito seguramente me dio las gracias como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030604,
					"content": "Me duelen los oídos de tanto escucharlo. “Gracias por esto, gracias por aquello”. ¡Bah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030605,
					"content": "“Cuando puedas, ven a pescar conmigo”. ¡Mejor que venga a ayudar a la posada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030606,
					"content": "*Tch*, ¿por qué te cuento estas cosas? Toma, tu recompensa. Ocúpate de tus asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
