			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "Apresúrate, no sé qué hará si muere de hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030402,
					"content": "¿Por qué le envías comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "¿Por qué crees? Es un ermitaño, prácticamente solo me conoce a mí en toda Liyue, y todavía tiene la osadía de comer a costa mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030404,
					"content": "#¿Por qué? No tengo por qué darte explicaciones. Me agrada darle de comer. ¿Satisfech{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030405,
					"content": "Además, si no me encargo yo de hacerle de comer, seguramente irá al Pantano Dihua y hará una tontería.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030406,
					"content": "¿Sigues aquí? ¿Qué esperas? ¡Rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
		{
