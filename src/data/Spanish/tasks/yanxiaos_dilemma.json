					"content": "¿Encontraste los ingredientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030202,
						220030203
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030202,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220030203,
					"content": "Todavía no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030204
					]
				},
				{
					"id": 220030204,
					"content": "¿Qué esperas? Temo lo peor si ese parásito se muere de hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
		{
