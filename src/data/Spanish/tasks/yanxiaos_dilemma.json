			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030501,
					"content": "¿Eh? ¿Viniste a buscarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030502,
					"content": "Esto es de parte del Sonriente Yanxiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "¡Ajá! Me preguntaba de dónde venía ese delicioso olor. Es un chef realmente talentoso, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030504,
					"content": "Gracias, cuando regreses, agradécele de mi parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200306,
			"completionStepIds": [
				2200305
