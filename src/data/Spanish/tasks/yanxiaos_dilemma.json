					"El Sonriente Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "Espera aquí para que le lleves el plato en cuanto termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030302,
					"content": "¿Qué es esa cara? Por supuesto que te recompensaré por esto. Dime cuánto quieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030303,
					"content": "Listo. Ve y dale este plato a ese parásito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "El Sonriente Yanxiao"
				},
				{
					"id": 220030304,
					"content": "Se llama <color=#00E1FFFF>Jiangxue</color>, se la pasa todo el día pescando en la orilla. Lo reconocerás de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "El Sonriente Yanxiao"
				}
			]
		},
		{
			"id": 2200304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
