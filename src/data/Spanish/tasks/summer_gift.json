			},
			"dialogs": [
				{
					"id": 790080101,
					"content": "¡Esto debe ser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080102,
					"content": "¿Humm? Hay una carta al lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080103,
					"content": "Para aquel que tiene la suerte de estar aquí:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080104,
					"content": "Hola, persona llegada desde lejos. Si puedes leer esto, debes haber encontrado el Harpastum que dejé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080105,
					"content": "En el Archipiélago Manzana Dorada hay bastantes juegos relacionados con el Harpastum, y mis amigos y yo pasamos un verano muy feliz aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080106,
					"content": "Así que te dejo aquí el Harpastum que hice y espero que tú, que has tropezado con él, experimentes la misma alegría que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080107,
					"content": "Por favor, disfruta al máximo el sol, la brisa marina y los juegos de verano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080108,
					"content": "Firmado, Bárbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 790080109,
					"content": "Gracias a Bárbara, ¡también conseguimos un Harpastum! Vamos, ¡a jugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigar"
				}
			]
		},
