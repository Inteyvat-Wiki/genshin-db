			},
			"dialogs": [
				{
					"id": 742530201,
					"content": "La vida es mejor cuando todo está en paz y tranquilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Marianne"
				},
				{
					"id": 742530202,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530204,
					"content": "¿Tan tarde es ya? Jaja. Deberíamos vernos más a menudo, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marianne"
				},
				{
					"id": 742530203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
