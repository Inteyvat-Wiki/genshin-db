			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580601,
					"content": "Necesito descansar. Las viejas heridas duelen... Lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580602,
					"content": "En todo caso, vuelve en otro momento... Tengo que pedirte un favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "¡Han vuelto! Por favor, tomen asiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590102,
					"content": "#Siento mucho haberl{F#as}{M#os} echado a toda prisa la última vez. Ni siquiera pude decirles qué favor quería pedirles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590103,
					"content": "No te preocupes, puedes decírnoslo ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "No se preocupen, no les pediré que hagan nada malo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590108,
					"content": "Entonces, por favor, cuéntanos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "Esta es la cuestión... Kolya... Mi compañero de equipo, Nikolay, y yo nos separamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590114,
					"content": "Así que... ¿podrían ayudarme a buscarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590115,
					"content": "Si todavía está vivo, por favor, tráiganmelo de vuelta. Si ha muerto... por favor, avísenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590116,
					"content": "Siento mucho pedirles algo así... Me gustaría que lo consideraran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590117,
					"content": "Ah... ¡Paimon pensó que querías que hiciéramos algo malo! Como sabotear a la Geoarmada o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590118,
					"content": "A la Geoarmada... ¿Por qué? A los Fatui no nos conviene que sean nuestros enemigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590119,
					"content": "¿A qué te refieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "¡Eso mismo iba a preguntar yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590121,
					"content": "Espera... Ya entiendo... ¿Nuestros compañeros en la superficie han tenido un desacuerdo con la Geoarmada...? Por eso nuestros suministros se interrumpieron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590122,
					"content": "¡Terrible! ¿Qué ocurrió en la superficie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590123,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "Hum... Ya hablaremos de eso más adelante. La guerra es la guerra... Los amigos son rápidamente sustituidos por enemigos. Ese es el mundo en el que vivimos los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590126,
					"content": "Pero ahora... Ahora mismo solo me preocupa Kolya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590127,
					"content": "Durante nuestra retirada, se separó del grupo... Más tarde volví a buscarlo y acabé quedándome sola. *Suspira*, es una pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590128,
					"content": "En cuanto a dónde fue visto por última vez... Puedo marcar el lugar en tu mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590129,
					"content": "Allí se separó del resto, cuando intentó distraer al enemigo que nos perseguía... Es un buen guerrero, sé que no moriría ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590130,
					"content": "Espero que haya dejado algunas pistas allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590124,
					"content": "Ustedes son los que han montado el lío...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "Seguro que no nos dejarías estropearle el plan a los Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "¡Sí! Si el bien que hacemos interrumpe sus malvados planes, ¡ni se te ocurra intentar detenernos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590111,
					"content": "#¿Qué bien? ¿Planes malvados? ¿Detenerl{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590112,
					"content": "#*Suspira*, son tan molest{F#as}{M#os}. ¡Déjenme terminar la frase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590104,
					"content": "No te preocupes, aún no hemos aceptado ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "¡Sí, eres una Fatui! Si nos dices que hagamos algo malo, no lo haremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590106,
					"content": "Pff... Tiene sentido lo que dices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105902,
			"completionStepIds": [
				7105902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
