				"points": []
			},
			"dialogs": [
				{
					"id": 710590301,
					"content": "¡Han vuelto! Todavía tengo algo de aguafuego para compartir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590302,
					"content": "Jaja... No les estoy pidiendo que beban conmigo, pero si se han lastimado, el aguafuego puede servir para limpiar las heridas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590303,
					"content": "¿Cómo les fue? ¿Averiguaron algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590304,
					"content": "Encontramos esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7105904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
