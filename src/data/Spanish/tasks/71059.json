			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "“... Qué mala suerte, la balalaika de Katya se rompió. No sé cómo pasó, pero tengo que arreglarla antes de que me regañe...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "Fragmento del diario del kapral Nikolay"
				},
				{
					"id": 710590202,
					"content": "“¿Así que hace quinientos años nuestros antepasados lucharon así contra la calamidad? El capitán porúchik dijo que las feroces batallas por las que pasamos no son nada en comparación con las de antaño...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "Fragmento del diario del kapral Nikolay"
				},
				{
					"id": 710590203,
					"content": "(Muchas de las páginas centrales están manchadas con una sustancia negra. Después de limpiarlas, lo escrito con tinta ha quedado completamente arruinado.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "Fragmento del diario del kapral Nikolay"
				},
				{
					"id": 710590204,
					"content": "“... No puedo quedarme aquí, podrían seguir el barro negro y encontrarme...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "Fragmento del diario del kapral Nikolay"
				},
				{
					"id": 710590205,
					"content": "“... Tengo que moverme en dirección opuesta y alejarlos del resto del escuadrón...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "Fragmento del diario del kapral Nikolay"
				},
				{
					"id": 710590206,
					"content": "“... Hay una entrada a una cueva junto a los restos de la fortaleza al sureste, tal vez pueda ir por ahí...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "Fragmento del diario del kapral Nikolay"
				},
				{
					"id": 710590207,
					"content": "“... Espero que la suerte me acompañe. Si no yo, ¿quién?”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fragmento del diario del kapral Nikolay"
				}
			]
		},
		{
			"id": 7105903,
