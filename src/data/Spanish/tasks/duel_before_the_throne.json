				}
			]
		},
		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Signora",
					"Paimon",
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "La forma en que la gente entra aquí a sus anchas es tan poco civilizada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190102,
					"content": "Si no supiera que esto es Tenshukaku, lo hubiera confundido con un mercado callejero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190103,
					"content": "¿Ya aprendiste la lección?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190104,
					"content": "¡Oh, no! ¿Qué le hizo a Kujou Sara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190105,
					"content": "El derecho de castigar a los habitantes de Inazuma por sus crímenes es solo mío, Signora, no tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190106,
					"content": "... Entonces acepte mis disculpas, todopoderosa Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190107,
					"content": "¡Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Sí, ya sé que no puedes dejar de pensar en mí, pero no hace falta que digas mi nombre todo el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190109,
					"content": "No creas que me sorprende verte aquí, ya que siempre me sigues como una sombra... Soy muy consciente de que me odias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190110,
					"content": "Estás distribuyendo en secreto los Engaños...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "Ah, ¿así que has venido a denunciar mis crímenes frente a la Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190113,
					"content": "Jejeje... No soy más que una diplomática de Snezhnaya. Me temo que no tengo ni idea de lo que estás diciendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190114,
					"content": "No nos está tomando en serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190115,
					"content": "Por todos los que han perdido sus Visiones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "Deja de hablar de personas y cosas que no me importan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190118,
					"content": "Para empezar, no eran nadie, y sus nombres serán olvidados. Pero ahora, por lo menos, serán parte de los pilares de la revolución para alcanzar la eternidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190119,
					"content": "¿No es ese el mayor honor que podrían esperar en sus insignificantes vidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190120,
					"content": "Todopoderosa Shogun... ¿Acaso me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190122,
					"content": "Por la Gnosis de Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "#El pasado quedó atrás. ¿Cómo puedes ser tan rencoros{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190125,
					"content": "El sueño de la Zarina es lo más noble y puro del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190126,
					"content": "Esos otros detalles mundanos que insistes en mencionar... son solo sacrificios necesarios y nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190127,
					"content": "Es hora de que ponga fin a esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "¿Tú me vas a detener? Jajaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190129,
					"content": "#Debo decir que yo también me he cansado de verte por todas partes, pero no pensé que fueras tan insensat{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190130,
					"content": "#Antes de que digas algo de lo que puedas arrepentirte, recuerda que eres {F#la}{M#el} criminal más buscad{F#a}{M#o} de Inazuma... Te sugiero que consideres tus circunstancias con mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190131,
					"content": "#Irrumpir en Tenshukaku sin ser invitad{F#a}{M#o} y sermonearme delante de la Shogun no es muy inteligente. ¿No crees que es hora de que lo dejes ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190132,
					"content": "#No sé si te das cuenta de la distancia que hay entre nosotr{F#as}{M#os}, tanto en estatus... como en fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190133,
					"content": "Te reto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "¡A un duelo ante el trono！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190136,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190137,
					"content": "#Vaya, hoy estás llen{F#a}{M#o} de sorpresas... Así que has aprendido a aprovecharte de las costumbres del lugar, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190138,
					"content": "#Admito que nunca esperé estar en una situación en la que l{F#as}{M#os} dos estuviéramos en igualdad de condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190139,
					"content": "#¿Eres consciente de que {F#la perdedora}{M#el perdedor} debe morir? ¿Estás segur{F#a}{M#o} de que es lo que quieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190141,
					"content": "Jejeje... Entonces me dignaré a compartir este último baile contigo... ¡hasta que la muerte nos separe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190123,
					"content": "Por la gente de Liyue que pusiste en peligro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "Por todos los que han sido perjudicados por los Engaños...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Quieres tomar el control de Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}