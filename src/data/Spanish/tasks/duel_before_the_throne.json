			"dialogs": [
				{
					"id": 20185301,
					"content": "Mientras contemos con el Filo del pensamiento vacío, la gente de Inazuma no tiene nada que temer. Un hecho evidente, pero Sara no lo ve... ¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
