			"dialogs": [
				{
					"id": 760360301,
					"content": "¿Con esto es suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360302,
					"content": "Sí, parece muy contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360303,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360304,
					"content": "Paimon no imaginaba que las kuuhenki supieran pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "#Al igual que nosotr{F#a}{M#o}s, ellas también tienen sus propios gustos y personalidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360306,
					"content": "¿Conoces a todas las kuuhenki de Nod Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Sí, al menos a todas las que he visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360308,
					"content": "¡¿En serio?! A Paimon, quitando a las luonnotar, las kuuhenki le parecen todas iguales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Entonces, ¿cómo se llama esta a la que le gusta pintar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "¿Cómo se llama?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360311,
					"content": "¿No le has dado nombre a ninguna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Yo las conozco a ellas, y ellas a mí... No hacen falta nombres. De hecho, ni siquiera yo tengo uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360313,
					"content": "¡Otra vez siguiendo con las malas costumbres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Hummm, a ver, deja que Paimon piense... “Luonnotar” significa “criatura nacida bajo la gracia de la Diosa Lunar”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "¿Cómo se dice “pintura” en la lengua de los Descendientes Lunaescarcha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Creo que era... “Maa...” ¿“Maalaus”? Sí, “Maalaus”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360317,
					"content": "¡Suena muy bonito! En ese caso, ¡te llamarás Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360318,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360319,
					"content": "¿Qué tal, Maalaus? ¿Ya terminaste tu dibujo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360320,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360321,
					"content": "¡Oooh! A ver, a ver... ¡E-es...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360322,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "¡Es un dibujo fantástico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Paimon pensó que dibujaría más como un niño... O... como una melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "A las kuuhenki se les da muy bien sentir lo que hay a su alrededor, así que, al replicar algo que han visto, tienden a grabar su sensación tal y como la sintieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360326,
					"content": "¿Has dibujado a Colombina, Maalaus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
				{
					"id": 760360327,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360328
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360328,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360329
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360329,
					"content": "Parece que es Colombina cuando nació.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360330,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360331
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360331,
					"content": "Paimon recuerda que Lauma dijo que los Descendientes Lunaescarcha registraron tu nacimiento... pero este dibujo parece un poco distinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360332,
						760360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360332,
					"content": "Y las kuuhenki nacieron después de la Diosa Lunar, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				},
				{
					"id": 760360334,
					"content": "Maalaus fue una de las primeras kuuhenki en nacer. Puede que haya imaginado la escena de aquel entonces combinándola con su propia percepción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360335
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360335,
					"content": "En ese caso, se podría decir que Maalaus se ha esforzado mucho para presentarnos a su diosa, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360336,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360338
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360338,
					"content": "No te preocupes, ¡nos llevaremos muy bien con Colombina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360339,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360340
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360340,
					"content": "¡Guau, qué rapidez! ¿Ya terminaste otro dibujo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360341,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360342
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360342,
					"content": "Este dibujo es... ¿una representación de los Descendientes Lunaescarcha adorando a Colombina como su diosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360343,
					"content": "¿Qué está haciendo ella en el altar? El dibujo es tan pequeñito que Paimon no logra distinguirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360344,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360345
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360345,
					"content": "Aaaah, ¡se está comiendo las ofrendas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360346,
					"content": "¿No debería haberlo hecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360347
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360347,
					"content": "N-no, no es que esté prohibido ni nada de eso. Eso solo que... Paimon no se lo esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360348,
					"content": "Parece que te gustaron mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360349
					]
				},
				{
					"id": 760360349,
					"content": "Bueno... Es que estaban ricas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360350
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360350,
					"content": "Paimon te entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360351,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360352
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360352,
					"content": "De acuerdo, entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360353
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360353,
					"content": "Dame la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360354,
						760360355
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360354,
					"content": "Tranquila, no tienes que darnos nada a cambio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360356
					]
				},
				{
					"id": 760360356,
					"content": "No es eso. Esto es la prueba de que “nos llevamos bien”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360355,
					"content": "Bueno, pero no te la comas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360356
					]
				},
				{
					"id": 760360333,
					"content": "Además, ¿no se supone que las kuuhenki nacieron después de la Diosa Lunar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				}
			]
		}
	]
}