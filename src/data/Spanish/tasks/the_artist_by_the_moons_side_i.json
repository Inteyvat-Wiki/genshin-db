			"dialogs": [
				{
					"id": 760360101,
					"content": "¿Este azul no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360103,
						760360104
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360103,
					"content": "¿Colombina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "Oh, son ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360106,
					"content": "¿Pueden ayudarme? No se preocupen, les devolveré el favor más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360107,
					"content": "Humm... ¿Cuándo vas a cambiar esa mala costumbre tuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360108,
					"content": "Ya nos has ayudado mucho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "Sí. Te ayudaríamos aunque no nos dieras nada a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360111,
					"content": "Así que dinos, ¿qué necesitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360112,
					"content": "Bueno... Para ser precisos, ella es la que necesita ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360114,
					"content": "¿Esta kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360115,
					"content": "Esta pequeña recogió un pincel en algún sitio y, al volver conmigo, empezó a zarandearse alegremente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360116,
					"content": "Encontré algunos lienzos para que pudiera pintar, pero ha pasado un tiempo y aún no consigue dar con la combinación de colores que quiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360117,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360118,
					"content": "¡Miren quién apareció!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360119,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360120,
					"content": "¿...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360121,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360122,
					"content": "Eh... Es que no entendemos tus gestos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360124,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360125,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360126,
					"content": "Oh, parece que le interesa tu mochila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360127,
					"content": "¿Traen pinturas adecuadas consigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360128,
					"content": "No solemos llevar ese tipo de cosas... Por cierto, Colombina, ¿de dónde sacaste estas pinturas? No pareces alguien que tenga por costumbre pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360129,
					"content": "Esta pequeñina no podía esperar, así que le hice unas pinturas a partir de las flores de colores que hay por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760360130,
					"content": "Ah, ¿será que la luonnotar también quiere buscar cosas coloridas para hacer pinturas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360131,
					"content": "¡Vamos a ver qué tenemos en nuestra mochila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360109,
					"content": "Ya nos has devuelto muchos favores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				}
			]
		},
