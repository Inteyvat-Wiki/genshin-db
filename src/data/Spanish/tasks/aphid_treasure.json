			"dialogs": [
				{
					"id": 755050301,
					"content": "¡Uff! Lo conseguimos. Esa cosa es enorme, pero fue bastante fácil atraparla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050302,
					"content": "Aparte de que le gusta escaparse, no es nada peligrosa. La red atrapabejas y el veneno de las bayas son muy efectivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050303,
					"content": "Jaja, pero no dejan de ser flogistabejas corrompidas por el Abismo. Podrían atraer monstruos o algo así. Así que será mejor que no bajen la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050304
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050304,
					"content": "¡Sí, es verdad! Además, eso de las bayas que aparecieron por casualidad... Si fuera Paimon, se mantendría muy lejos de sus enemigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050305,
					"content": "#Las flogistabejas no están actuando de acuerdo a su naturaleza. {NICKNAME}, tenemos que estar alerta. ¡Algo anda mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050306,
					"content": "Parece que tienes mucha experiencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050307
					]
				},
				{
					"id": 755050307,
					"content": "Jeje, ¡Paimon aprendió de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050308,
					"content": "*Fiu*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050309
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050309,
					"content": "Bueno, gracias por acompañarme hoy. Ya que hemos terminado con una zona, es hora de descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050310
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050310,
					"content": "#Después de todo, tendré que molestarl{F#as}{M#os} durante los próximos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		}
