					},
					{
						"sceneId": 3,
						"position": [
							-1340.089,
							199.175,
							7180.244
						],
						"pointId": 350400244
					},
					{
						"sceneId": 3,
						"position": [
							-1342.486,
							198.978,
							7179.928
						],
						"pointId": 350400245
					}
				]
			},
			"dialogs": [
				{
					"id": 755050201,
					"content": "Aquí es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050202
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050202,
					"content": "¿Ven eso? Es una flogistabeja corrompida por el Abismo. Es mucho más grande que las flogistabejas normales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050203,
					"content": "Qué flogistabeja más enorme... ¿Es peligrosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050204,
					"content": "No te preocupes. Aunque hayan sido corrompidas por el Abismo, su comportamiento no parece haber cambiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050205
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050205,
					"content": "Pero para que la captura sea más efectiva, he hecho una red atrapabejas de gran tamaño. Tomen, pueden usarla para cazar las flogistabejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050206
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050206,
					"content": "Ah, por cierto. Kinich también mencionó una situación particular. Descubrió que hay una baya especial que siempre crece cerca de las zonas donde se encuentran las flogistabejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050207
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050207,
					"content": "La baya contiene un veneno que paraliza a las flogistabejas. Podemos aplicarla sobre la red para que no se muevan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050208
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050208,
					"content": "¿Eh? ¿Estás diciendo que las flogistabejas suelen estar cerca de las bayas que las paralizan? Qué raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050209,
					"content": "A mí también me resulta extraño. Es la primera vez que oigo que los animales conviven con algo peligroso para ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050210
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050210,
					"content": "¡Es muy muy muy extraño! ¿No será que hay alguien detrás de esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050211,
					"content": "Qué precavida te has vuelto, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050212
					]
				},
				{
					"id": 755050212,
					"content": "Ey, ¡las guías torpes también aprenden! ¡Y Paimon es inteligente por naturaleza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050213,
					"content": "Por desgracia, no encontramos ningún rastro de actividad humana, por mucho que buscamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050214,
					"content": "Así que, por ahora, lo estamos considerando como una costumbre peculiar de las flogistabejas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050215,
					"content": "De todos modos, tenemos que atraparlas. No podemos permitir que infecten a más personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050216,
					"content": "¡Vamos, Escuadrón Cazabejas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
