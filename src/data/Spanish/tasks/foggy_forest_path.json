				]
			},
			"dialogs": [
				{
					"id": 740820101,
					"content": "(La mayoría de los caracteres se muestran emborronados, apenas se puede reconocer vagamente “... el rocío... canta en la Senda Silvícola Caliginosa”.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Estela con inscripción"
				},
				{
					"id": 740820102,
					"content": "¡Ay, Vaya! ¡Se borraron la mayoría de los caracteres! Debe de ser la descripción de un sitio turístico, ¿no? Algunos turistas deberían aprender a comportarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "A muchos turistas les gusta dejar su marca en el lugar que visitaron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Humm... Tienes razón, escriben algo como “{NICKNAME} y Paimon han visitado este lugar”. Pero nosotr{F#a}{M#o}s no hacemos esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "Pero qué raro, ¿por qué borraron lo que escribieron? Solo queda esta frase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Además, tiene muchas marcas, como si no hubieran logrado borrarla por completo. Tuviste suerte, Senda Silvícola Caliginosa, ¡lograste salirte con la tuya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "¿Cómo es ese lugar de la Senda Silvícola Caliginosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Humm... ¿Una senda caliginosa dentro de algún bosque? Es lo que significa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "Parece interesante. Paimon cree que hay algún secreto oculto que guía hasta un valioso tesoro. Así dicen en los libros, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "¿En qué puesto leíste esos libros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "¡A Paimon se le dan bien muchas cosas además de comer! Paimon tiene un presentimiento, ¡debe de haber algún tesoro en la Senda Silvícola Caliginosa, por eso la ocultaron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#¡{NICKNAME}, es hora de empezar a buscar el tesoro! ¡Ve con tu compañera de viaje Paimon, que tiene el olfato más agudo para los tesoros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "¿En qué biblioteca leíste esos libros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
