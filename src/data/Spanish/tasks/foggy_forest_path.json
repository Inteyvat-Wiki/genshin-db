			"dialogs": [
				{
					"id": 740820401,
					"content": "(La mayoría de los caracteres se borraron, solo se puede leer “rocío... tres”.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Altar misterioso"
				},
				{
					"id": 740820402,
					"content": "¡Maldición! Los caracteres de aquí también se borraron, ¡aquí hay gato encerrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "¿Rocío?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "¿Qué quiere decir “el rocío”? ¿Agua de rocío? Pero aquí hay agua por todas partes, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Y con “tres”, ¿quiere referirse a tres gotas de agua? Paimon ya tiene la cabeza mareada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Pregunta a ese olfato tuyo tan agudo para los tesoros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "¡Paimon ya lo hizo! Lo que pasa es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "En fin, dice que está relacionado con “tres” y “agua”. ¡Deberíamos buscar por aquí cerca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "¿Tres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "¿“Tres” se refiere a tres cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "¿Qué quiere decir “el rocío”? ¿Agua de rocío? Pero aquí hay agua por todas partes, ¿no? Paimon ya tiene la cabeza mareada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
