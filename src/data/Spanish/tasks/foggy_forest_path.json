			"dialogs": [
				{
					"id": 740820901,
					"content": "Una gota de agua cristalina aparece sobre el altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820902
					]
				},
				{
					"id": 740820902,
					"content": "¡Genial! ¡Ya tenemos las tres llaves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820903,
					"content": "¡Llave, llave, llave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820904
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820904,
					"content": "Sin rastro, ¡Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820905
					]
				},
				{
					"id": 740820905,
					"content": "#¡Paimon, Pahsiv! ¡{NICKNAME}, Pahsiv! ¡Llave, llave, llave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820906
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820906,
					"content": "¡Plaza, oeste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820907,
					"content": "Jeje, ¿eso es lo que querías decir? No tengas prisa, vamos enseguida.",
