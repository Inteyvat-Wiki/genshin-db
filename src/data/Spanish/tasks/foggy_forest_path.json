			"dialogs": [
				{
					"id": 740821001,
					"content": "Bien, otra llave más. Ya solo falta por encontrar la última.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821002,
					"content": "¡Llave, llave, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821003,
					"content": "¡Ah! Pahsiv, ¡¿cómo apareciste tan de repente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821004,
					"content": "Sin rastro, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821005,
					"content": "De acuerdo... Eres la melusina más especial que Paimon ha visto. Por cierto, que Paimon recuerde, la mayoría de las melusinas viven en la Corte de Fontaine o en la Aldea Espumarina... ¿Cómo acabaste aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821006,
					"content": "¿Corte de Fontaine? ¿Aldea Espumarina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821007,
					"content": "Pareces muy confusa, ¿no has oído hablar de estos dos nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821008,
					"content": "Corte de Fontaine, melusina... Aldea Espumarina, melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821009,
					"content": "Ah... Erinias, Pahsiv, hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821010,
					"content": "¡Erinias, Pahsiv, proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821011,
					"content": "Espera, ¿dices que este es tu hogar? ¿Estás protegiendo tu hogar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821012,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821013,
					"content": "Pero ¿no es la Aldea Espumarina el hogar de las melusinas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821014
					]
				},
				{
					"id": 740821014,
					"content": "Claro. Qué raro, ¿acaso hay melusinas nacidas en otros sitios? Tampoco parece que haya otras melusinas por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821015,
					"content": "Pahsiv, ¿vives aquí sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821016,
					"content": "¿Sola? Melusina. ¡Neovalet! ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821017,
					"content": "¿Neo...valet? ¿Hay algún valet? ¿Quién es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821018,
					"content": "#¡Neovalet! ¡Paimon, Paimon! ¡{NICKNAME}, {NICKNAME}! ¡Neovalet, Neovalet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821019,
					"content": "¿Quién es Neovalet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821020
					]
				},
				{
					"id": 740821020,
					"content": "Pahsiv... no querrás decir que, al igual que Paimon es Paimon, ¿Neovalet es Neovalet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821021,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821022,
					"content": "¡Ja! ¡Paimon lo sabía! ¿Ves como Paimon es superinteligente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821023,
						740821024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821023,
					"content": "Es un nombre muy raro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821024,
					"content": "Qué nombre tan alucinante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821025,
					"content": "Neovalet, Pahsiv, conocimiento, bum, bum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821026,
					"content": "Humm... ¿Quieres decir que Neovalet te ayudó a aprender nuevos conocimientos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821027,
					"content": "¡Pahsiv! Muchos. Lenguaje, sabiduría... muchos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821028,
					"content": "Humm, a Paimon le parece que tampoco fue para tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821029,
					"content": "Pahsiv, Neovalet, proteger, bum, bum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821030,
					"content": "¿Él también te está ayudando a proteger este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821031,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821032,
					"content": "¿Tú le estás ayudando a proteger este sitio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821033
					]
				},
				{
					"id": 740821033,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821034,
					"content": "Así que es eso... ¿Quién es Neovalet? ¿Por qué te pidió que le ayudaras a proteger este sitio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821035,
					"content": "Además, es verdad que sucedió algo malo aquí. Borraron los caracteres inscritos sobre la estela de piedra que vimos antes. También vimos mucha contaminación... ¿Podrían ser los enemigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821036,
					"content": "¡Curiosa Paimon, Pahsiv! ¡Pero tiempo, no mucho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821037,
					"content": "Llave, llave, llave, plaza, oeste. Bum, bum, bum bum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821038,
					"content": "¡Nos apresuraremos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#¡Paimon, Pahsiv! ¡{NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv da dos saltitos de alegría y se va apresuradamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740821041,
					"content": "Parece que no queda mucho tiempo. Por suerte, ya tenemos dos llaves. Démonos prisa en conseguir la tercera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
