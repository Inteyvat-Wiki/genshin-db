			},
			"dialogs": [
				{
					"id": 715380101,
					"content": "#¡Hola, {NICKNAME}! ¡Feliz Rito de la Linterna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "¿Has venido por algún caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Me obligaron a tomarme unas vacaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "¿Te obligaron?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "Según las normas de la Oficina Judicial, todos debemos tomar nuestros días de vacaciones antes de que se termine el año.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Sin embargo, cuando llevaron a cabo la revisión anual, descubrieron que yo no había tomado ni un solo día de vacaciones. Por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "Qué duro es ser miembro de la Unidad Especial de Seguridad y Vigilancia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "No. De hecho, tenemos un sistema de descanso rotativo, pero como capitana, tengo que estar siempre atenta a lo que sucede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "Además, de vez en cuando he tenido que ocuparme de algún imprevisto, y así, con el tiempo... se me olvidó que tenía vacaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Tener días libres no es tan importante para mí, pero cuando dije que podía dejar pasar las vacaciones, los chicos de la unidad se alteraron bastante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "Los chicos no paraban de decir que eran las normas y que no podíamos ir en contra de ellas, por lo que tenía que tomarme unas vacaciones quisiera o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "Encima, uno de los funcionarios administrativos que trabajan con nosotros mencionó que en Liyue estaban celebrando el Rito de la Linterna y que era un destino ideal para unas vacaciones. De pronto, sacó un billete de barco y... aquí estoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Debo admitir que Liyue es realmente un lugar maravilloso. Acabo de regresar de la Aldea Chiaoying... Los pastelitos de hojas de té que tienen allí son deliciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "He comprado un montón para que los prueben los chicos de la unidad, así que pensaba seguir la costumbre de Liyue y acompañarlos de estas felicitaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "Solo que... estas cosas no se me dan muy bien... Cuando escribo una felicitación, siempre acaba pareciendo algo rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#{NICKNAME}, ¿tú sabes cómo hacer estas cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "Puedo darte algunos consejos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "¿La situación de los demás miembros es así también?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "No pareces estar aquí por trabajo, ¿me equivoco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
