			"dialogs": [
				{
					"id": 715380301,
					"content": "Humm, la verdad es que es muy bonita, pero... no puedo quedármela sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Ah, toma estos pastelitos. Muchas gracias. Este viaje ya ha merecido la pena, aunque sea solo por tu regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "Ya llevo fuera de Fontaine mucho tiempo... Me pregunto si los chicos estarán entrenando como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "En fin, creo que ha llegado el momento de empezar a preparar una prueba de condición física.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
