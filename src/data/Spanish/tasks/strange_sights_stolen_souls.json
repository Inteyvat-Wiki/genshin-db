			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "La última vez nos quedamos en que Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "Tian Lengua de acero"
				},
				{
					"id": 111200302,
					"content": "¡Zhongli! ¡Aquí estás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200303,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200304,
					"content": "#¿Vienen a escuchar un cuento? No sabía que fueran tan conocedor{F#as}{M#es} del tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200305,
					"content": "¡No, no! ¡Vinimos a buscarte! ¿Estás libre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200306,
					"content": "Ah... da la casualidad que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200307,
					"content": "Aceptamos un encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "Necesitamos a alguien que sepa de geología y minerales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200310,
					"content": "Humm... Geología y minerales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200311,
					"content": "¡Vamos! ¿Hay alguien en Teyvat que esté más cualificado que tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200312,
					"content": "El cliente dijo haber reclutado al experto número uno en rocas, pero Paimon no le cree ni una palabra. ¡Nadie sabe más de rocas que tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200313,
					"content": "Parece que te lo tomaste como algo personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200314,
					"content": "¡N-no! Es solo que... ¡El Sr. Dai no sabe lo que dice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200315,
					"content": "Paimon solo quiere... que se dé cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200316,
					"content": "Jaja, ya veo. De acuerdo, entonces, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200317,
					"content": "¡¿En serio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200318,
					"content": "Pero debo advertirles que, a pesar de mi experiencia, no necesariamente soy la mayor autoridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200319,
					"content": "No somos más que náufragos en este mar de conocimiento. El aprendizaje de algo nuevo debe ser bienvenido con los brazos abiertos. Aun así, me imagino que puedo serles de ayuda en su encargo. Si de verdad se trata de un experto, espero con ansias ampliar mi comprensión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200320,
					"content": "Ehm... Deja de ser tan modesto, Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200321,
					"content": "¡Buenos, ya lo tenemos! ¡Regresemos con el Sr. Dai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200308,
					"content": "Tenemos una misión especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112004",
							"2"
						],
						"stepId": 1112004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "¡Sr. Dai, ya volvimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200402,
					"content": "Ah, ¿ese es el amigo al que se referían?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200403,
					"content": "¡Así es! Paimon no sabe quién será ese experto en rocas suyo, ¡pero no es nadie comparado con él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200404,
					"content": "Jaja, no nos precipitemos. Aun así, sé una cosa o dos del tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200405,
					"content": "Ajá, eso dice usted. Esperen a que mi hombre llegue y verán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200406,
					"content": "Pero de nada sirven mis elogios, es mejor que lo vean por ustedes mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200407,
					"content": "¿Eh? ¿Este es el lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200408,
					"content": "¡Aja! ¡Hablando de él! Permítanme presentarles a mi asistente, Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200409,
					"content": "#Joven Kun, est{F#as}{M#os} son l{F#as}{M#os} aventurer{F#as}{M#os} que nos asignaron. En cuanto a este caballero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200410,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200412,
					"content": "Este es Zhongli, asesor de la Funeraria El Camino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "¿Asesor de la Funeraria El Camino? ¡Señor Zhongli! He escuchado mucho acerca de usted. Dicen que es un hombre de gran conocimiento y muchos talentos. No tenía idea de que nos conoceríamos el día de hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200414,
					"content": "Me resulta familiar... ¿Nos hemos visto en la funeraria? Un momento... en realidad, nunca he ido allí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200415,
					"content": "Sr. Dai, ¿no piensa ponerlos a prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200416,
					"content": "Así que ese era tu plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "¿Eh? ¿P-por dónde comenzamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200418,
					"content": "¡Piensen en una forma de ponerlos a prueba! Si Zhongli gana, él será el asistente. Pero si pierde... *Suspira*, olvídalo, ¡no perderá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200419,
					"content": "¿Una competición? ¡Con gusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200420,
					"content": "Admiro su entusiasmo, caballero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200421,
					"content": "¡Jaja! Debo admitir que ciertamente tiene aires de ser un experto en la industria. Será interesante ver quién es el mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200422,
					"content": "¡Menos charla y más acción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200423,
					"content": "Solo digo lo que veo, jaja... En realidad, es la única habilidad que tengo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200424,
					"content": "Señor Kun Jun, ¿es usted un evaluador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200425,
					"content": "No... En realidad, ya olvidé a qué vine a Liyue... Estaba al lado de un camino un día cuando el Sr. Dai me llamó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200426,
					"content": "Me vio sosteniendo una roca y me hizo unas cuantas preguntas. Parecía estar muy emocionado e incluso me siguió por un tiempo. Acordamos vernos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200427,
					"content": "¿Eh? ¿Lo olvidaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200428,
					"content": "Lo vi en mi camino a Liyue evaluando unas rocas y murmurando algo. Parecía estar muy familiarizado con esas rocas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200429,
					"content": "Le hice unas cuantas preguntas por curiosidad. Para mi mayor sorpresa, ¡sabía más que yo, con toda mi experiencia! En fin, tenía tiempo libre y accedió a acompañarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200430,
					"content": "Entonces, ¿tienes mala memoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200431,
					"content": "No exactamente... En fin, si se trata de rocas, creo que puedo ayudarles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200432,
					"content": "Sr. Zhongli, ¿qué piensa de esta roca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200433,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200434,
					"content": "Un exterior lustroso con una fisura que solo pudo ser causada por una erupción. Si no me equivoco, es una gema bruta procedente de otra nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200435,
					"content": "¡Ajá! ¡Qué ojo tan agudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200436,
					"content": "No es una gema ordinaria. Tiene una capa frágil y franjas negras... Mi intuición me dice que contiene un cristal de alta calidad en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200437,
					"content": "Sorprendente. Ciertamente, esta roca proviene de las cercanías de un volcán. La encontré en un mercado y el vendedor pensaba que eran restos industriales. No tenía ni idea del tesoro en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200438,
					"content": "Pero los cristales se encuentran por todas partes, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "No solo la pureza y las particularidades geológicas lo convierten en un tesoro. Algunos de los cristales más preciados contienen depósitos de agua o arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200441,
					"content": "Cuando se formó, el cristal oculto dentro de la coraza de roca atrapó un poco de agua. Encontrar agua a estas profundidades es como ver una luna oculta dentro de una montaña, o como destellos de luz que pasan a través de ella... Ese es el verdadero tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200442,
					"content": "Qué descripción tan detallada, es como si lo hubiera visto con sus propios ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200443,
					"content": "No estás tratando de estafarnos, ¿o sí? Después de todo, ¡no hemos visto su interior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200444,
					"content": "No, tiene razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200445,
					"content": "La mayoría de los cristales se generan en ambientes con altas temperaturas. El calor y el agua no son precisamente compatibles, y esa es la razón por la cual los cristales con depósitos de agua son tan codiciados. Además, este cristal en particular contiene agua de una laguna en la montaña. Es un hallazgo muy inusual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200446,
					"content": "Bueno, si Zhongli lo dice, debe ser cierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200447,
					"content": "Nunca había encontrado a alguien con tal capacidad para discernir piedras, Sr. Zhongli. ¿Cómo supo qué había en su interior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200448,
					"content": "Perdone si alardeo, pero más sabe el Arconte por viejo que por Arconte, señor Kun Jun. En mi vida he visto muchas rocas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200449,
					"content": "¡Para nada! Creo que hoy he encontrado a alguien con mis mismas aficiones. Espero que pueda aceptar mi amistad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200450,
					"content": "Sr. Dai, ¡sería una pena que el Sr. Zhongli no nos acompañara! Confíe en mí cuando le digo que su profesionalidad es incomparable en esta industria. No encontrará a otra persona de su talla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200451,
					"content": "Bien, ¡la unión hace la fuerza! Todo el mundo, síganme a la Sima. Hay hombres a la espera de que los encontremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200439,
					"content": "¿Qué lo hace tan especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
			"id": 1112022,
			"completionStepIds": [],
