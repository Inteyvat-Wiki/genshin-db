			"dialogs": [
				{
					"id": 111202201,
					"content": "¿Qué apariencia tiene tu experto en rocas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Dai"
				}
			]
