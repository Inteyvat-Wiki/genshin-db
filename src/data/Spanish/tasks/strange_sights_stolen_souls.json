			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "#Hola, Katheryne, ¡somos nosotr{F#as}{M#os}! ¿Algún encargo nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200102,
					"content": "Así es, hay uno perfecto para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200103,
					"content": "El Sr. Dai es uno de los capataces del Salón Huishan de Liyue, y espera que el Gremio de Aventureros pueda enviarle algo de mano de obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200104,
					"content": "¿Qué tenemos que hacer en concreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200105,
					"content": "Creo que tienen que buscar empleados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200106,
					"content": "Oh, ¿buscar personas? Genial, ¡eso se nos da muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200107,
					"content": "En efecto, no podría poner en duda sus habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200108,
					"content": "#Estoy segura de que los detalles podrán hablarlos cara a cara. Si están dispuest{F#as}{M#os} a aceptar este encargo, diríjanse al muelle para hablar con el Sr. Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112002",
							"2"
						],
						"stepId": 1112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "¡Ey! ¿Es usted el Sr. Dai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200202,
					"content": "Ese soy yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200203,
					"content": "#¿Eh? Un momento, ustedes deben ser l{F#as}{M#os} aventurer{F#as}{M#os} que el Gremio asignó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200204,
					"content": "¡Guau! ¿Cómo lo supo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200205,
					"content": "#Por sus ropas y la expresión de sus rostros. Deben ser aventurer{F#as}{M#os} experimentad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200206,
					"content": "¡Exacto! ¡Es muy perspicaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200207,
					"content": "#Jaja, en esta industria se necesita una mirada aguda para observar a la gente, no solo las rocas. A mí me bastó una mirada para reconocerl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200208,
					"content": "Esperen un momento, mi asistente llegará pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200209,
					"content": "¡Oiga, espere! ¡Para eso estamos aquí! ¿O alguien más se está llevando una parte del pastel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200210,
					"content": "¡Jaja! Seré franco con ustedes. Esta es una cuestión muy delicada. Me temo que es demasiado para un solo aventurero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200211,
					"content": "¡Hum! ¡Así que hay alguien más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200212,
					"content": "¿Cree que no estamos a la altura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200213,
					"content": "Tranquila, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "Es solo que no conocen todos los detalles. El incidente en cuestión ocurrió en una mina y, como mínimo, es algo fuera de lo común. Como sabrán, las minas son lugares muy peligrosos. Por eso he reclutado a un experto en la industria para cubrir todas las contingencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200216,
					"content": "Según recuerdo, los aventureros no son expertos en evaluación de minerales o análisis topográfico. Con un profesional a su lado, todo irá viento en popa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200217,
					"content": "Además, él es el mejor en la industria. No importa qué roca sea, con una mirada puede saber cuánto vale en Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200218,
					"content": "Me atrevo a decir que no hay una sola alma en Teyvat que conozca las rocas mejor que él. ¿Cómo no habría de reclutar a alguien de su talla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200219,
					"content": "¡Es un iluso si cree que encontró al experto número uno en rocas de Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200220,
					"content": "¿Eh? ¿Y por qué lo dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200221,
					"content": "¡Porque da la casualidad que el mayor experto en rocas del continente es amigo nuestro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200222,
					"content": "¿Estás hablando de...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "(Perfecto, estaba pensando en hacerle unas preguntas.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "Jeje, ¡Paimon apuesta a que no se lo esperaba! ¡Espere y verá, iremos por él!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200214,
					"content": "Qué competitiva eres, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
		{
