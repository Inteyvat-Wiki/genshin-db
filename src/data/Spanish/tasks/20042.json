			"dialogs": [
				{
					"id": 200420101,
					"content": "¿Dónde te escondes, pequeña sabandija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420102,
					"content": "¿Qué buscas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "¿Yo? Oh, estoy buscando a una persona sospechosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420104,
					"content": "Su nombre es Albert y siempre acecha alrededor de la Catedral durante el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420105,
					"content": "Se ve que tiene malas intenciones. Me preocupa que esté tramando algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420106,
					"content": "¿Puedes ahuyentarlo por mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
