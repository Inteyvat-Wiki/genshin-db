			"dialogs": [
				{
					"id": 200420601,
					"content": "¿Ya terminaste de barrer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420602
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420602,
					"content": "Sí. Está limpio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420603
					]
				},
				{
					"id": 200420603,
					"content": "Gracias. ¡La catedral se ve mucho mejor ahora! Estoy seguro de que Bárbara se sentirá mejor por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420604
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420604,
					"content": "Pero, por favor no le digas a Bárbara sobre esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420605
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420605,
					"content": "El punto es reducir su carga de trabajo. Contárselo solo haría que se preocupara más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420606
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420606,
					"content": "Como acordamos, ya voy en camino. ¿Ves? Nada de que preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420607
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420607,
					"content": "Hasta pronto... ¿Tal vez? Quién sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
