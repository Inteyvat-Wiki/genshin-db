						200420303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420303,
					"content": "Pero no tengo pruebas contundentes contra él. No hay nada que puedan hacer.",
					"roleType": "TALK_ROLE_NPC",
