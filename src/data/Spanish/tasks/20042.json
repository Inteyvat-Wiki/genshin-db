					"nextDialogs": [
						200420702
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420702,
					"content": "¿Se ha ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420703
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420703,
					"content": "Sí, se fue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420704
					]
				},
				{
					"id": 200420704,
					"content": "Bueno, está todo arreglado pero... ¿qué demonios estabas haciendo barriendo hojas hace unos momentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420705,
					"content": "No importa, supongo que sin hojas, Albert no tiene excusa para acercarse a la Catedral en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420706,
					"content": "Estos regalos son mi forma de agradecimiento. Tómalos y que el Arconte Anemo te proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420707,
					"content": "Si no hay nada más, debo volver al trabajo. Deberías volver al tuyo también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
