					"Albert"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200421001,
					"content": "¿Yo? ¿Merodeando, actuando sospechosamente y tramando planes malvados? ¡Es un malentendido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421002
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421002,
					"content": "*Suspira*, ¿conoces a Bárbara? Es el ángel de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421003
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421003,
					"content": "Muchas personas en la ciudad la admiran, incluyéndome a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421004
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421004,
					"content": "De hecho, ¡soy el director del Club de Admiradores de Bárbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421005
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421005,
					"content": "Los Caballeros de Favonius estarán aquí en breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "¡D-déjame terminar! Realmente admiro a Bárbara. Quiero ser como ella, quiero hacer algo por la ciudad de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421007
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421007,
					"content": "Pero solo soy una persona común con habilidades comunes. Lo mejor que puedo hacer es recorrer la Catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421008
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421008,
					"content": "Pero la señorita Victoria nunca me escucha, solo dice que quiere que me vaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421009
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421009,
					"content": "Recientemente noté que nadie ha barrido las hojas alrededor de la Catedral por un tiempo. Pero si intentara explicarle a la señorita Victoria, ella no entendería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421010
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421010,
					"content": "¿Me puedes ayudar a barrer las hojas? Por Mondstadt... ¿y por Bárbara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
