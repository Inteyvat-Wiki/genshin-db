					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260302,
					"content": "Los ahuyenté a todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Gracias, ahora podré seguir cultivando flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260304,
					"content": "Ah, sí, por favor, toma esto, siento no tener nada bonito para ti... De todos modos, ¡gracias por ayudarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
