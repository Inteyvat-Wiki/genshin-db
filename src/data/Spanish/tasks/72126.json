			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "Oh, no... ahora qué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260102,
					"content": "¿Qué ocurrió?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "Hola... Me alegro mucho de que estés aquí... Después de que me dieras las semillas de las flores, empecé a plantarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260104,
					"content": "Pero antes de que pudiera plantar muchas, un grupo de monstruos apareció de repente y no dejaba de merodear por el lugar donde iba a plantar, así que no me atreví a acercarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260105,
					"content": "Si siguen aquí, pueden destruir el lugar donde se plantaron las flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260106,
					"content": "Si no te importa, ¿podrías ir a deshacerte de esos monstruos por mí? Yo... solo quiero plantar flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260107,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "¿Has dicho que sí? ¡Muchas gracias! ¡Cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260109,
					"content": "¿Por qué estás tan empeñada en cultivar flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "Estaba pensando que la razón por la que la gente no quiere volver a Tatarasuna es porque les preocupa que este lugar ya no sea adecuado para vivir después del incidente de la Fragua Mikage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260111,
					"content": "No puedo persuadir a todos uno por uno, pero si consigo plantar un montón de hermosas flores aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260112,
					"content": "... quizás con eso sea suficiente para persuadir a todos que Tatarasuna ya es seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260113,
					"content": "Y... jeje, además de plantar flores, no sé otra manera de convencer a la gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260114,
					"content": "Así que, por favor, ¡ayúdame a ahuyentar a esos monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
