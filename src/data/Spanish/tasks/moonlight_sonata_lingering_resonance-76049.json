					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490709,
					"content": "#Hemos atravesado nubes y niebla. Junt{F#a}{M#o}s, hemos sido testigo de la respuesta de la luna... Su belleza es como la música que entonan ahora tus cuerdas.",
					"roleType": "TALK_ROLE_NPC",
