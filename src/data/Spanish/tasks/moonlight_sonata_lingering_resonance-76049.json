	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Colombina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "... Eso ha quedado un poco agudo. ¿Volvemos a intentarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490102,
					"content": "¡Hola, Colombina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "¿Eh? ¿Estás... enseñando a las kuuhenki a tocar la lira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Sí, después de arreglar la lira, las kuuhenki se pusieron muy contentas y no dejaban de atosigarme todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490105,
					"content": "En realidad, a mí tampoco se me da muy bien tocar la lira. Antes, solía escuchar a otros tocar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490106,
					"content": "Oh, es comprensible. Paimon opina que, si formáramos un grupo musical, tú serías la cantante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#Pero, hablando de instrumentos musicales, ¡a {F#ella}{M#él} se le dan muy bien! ¡Es tod{F#a}{M#o} un{F#a} expert{F#a}{M#o} con ellos, desde la lira de Mondstadt hasta el Tambor Yemyem de Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "No es para tanto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "¿De verdad? Entonces... ¿por qué no les enseñas tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490111,
					"content": "Está bien, ¿por qué no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Recientemente, las kuuhenki han estado practicando esa melodía que suelo cantar. ¿La recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490114,
					"content": "O... también podrías tocar alguna melodía que conozcas bien. Las kuuhenki no suelen tener la oportunidad de oír música de otras naciones... Y a mí también me gustaría escucharla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490115,
					"content": "(¿Qué debería tocar?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Tocaré la canción que Colombina suele cantar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(¿Qué tipo de emoción quiero evocar?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Probemos con una melodía serena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Qué hermoso. No sabía que habías memorizado la melodía que suelo tararear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490605,
					"content": "Jeje, bueno, como cantas tan bien, a veces nos quedamos a un lado y te escuchamos en silencio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Las kuuhenki se han quedado encantadas con la música, aunque no sé si se la habrán aprendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490607,
					"content": "Tal vez tendrán que venir más veces para enseñársela en un futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490608,
					"content": "Ven, dame la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490609,
					"content": "¿Eh? Pero si era una actuación gratuita, ¡no hace falta que nos pagues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "¿Eh? ¿Pagar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490611,
					"content": "Tan solo he pensado que, como era una melodía tan hermosa, la bella luz de la luna sería un buen acompañamiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490701,
					"content": "Probemos con algo alegre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "¿Ya terminaste? Podría seguir escuchándola todo el tiempo del mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490703,
					"content": "Como te dije, esa es la única canción de cuna que recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490704,
					"content": "Aunque aún no he logrado descifrar su significado, tras escucharte tocarla, no puedo evitar pensar que la respuesta que me espera en la luna será, al menos, hermosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490705,
					"content": "Ven, dame la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490706,
					"content": "No necesitas darnos nada a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "No es eso, tan solo quiero adornar la melodía con un haz de la bella luz de la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490801,
					"content": "Tocaré una canción de otra nación...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "Qué sensación tan peculiar. Ya había escuchado melodías similares en alguna ocasión, pero tú la has dotado de una dimensión completamente nueva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490803,
					"content": "Tal vez sea porque canalizaste en la música tu conexión emocional con esa nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "Lo más maravilloso es que puedo imaginarme el paisaje a través de la canción... Me pregunto cuánto diferirá de la realidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490805,
					"content": "¡Verlo con tus propios ojos es fácil! ¡Podemos hacerte de guías llegado el momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Sí... Si ese día llega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760490112,
					"content": "¿Qué debería tocar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Solo sé lo básico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
