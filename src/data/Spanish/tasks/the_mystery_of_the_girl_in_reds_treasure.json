				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "¡Hum! Me siguieron hasta aquí. Debo decir que estoy impresionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010402,
					"content": "Pero esto es lo más lejos que llegarán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010403,
					"content": "¿Ah, sí? ¿Y qué vas a hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "¡Muajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010405,
					"content": "Oh, los rumores de los humanos nos han proporcionado todo lo que necesitamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010406,
					"content": "Sabemos que esta niñita de rojo posee el tesoro más poderoso de toda Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010407,
					"content": "Ese tesoro está ahora en mis manos. ¡No hay nada que puedan hacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010408,
					"content": "¡Ahora su precioso tesoro será su ruina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010409,
					"content": "¡No, no, espera! ¡No lo toques!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "¡Ja! ¡Por tu expresión, puedo ver que estás temblando de miedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010411,
					"content": "Veamos, ¿qué tenemos aquí? ¿Un símbolo de fuego? ¡Muajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010412,
					"content": "*¡BUM!*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010501,
					"content": "¡No!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "Incumplí las reglas de supervivencia... “Si una bomba a alguien hiere, Jean inmediatamente viene”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "Se acabó... Esta vez sí que estoy acabada... *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "¡Un momento! Entonces, ¿el tesoro de Klee era una bomba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "Qué niña tan fuerte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Ahora entiendo los rumores de que Klee era la luchadora más fuerte de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010509,
					"content": "Paimon nunca la hará enojar. Jamás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010510,
					"content": "Pero... ¿Por qué salió corriendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010511,
					"content": "Dijo algo sobre un reglamento de supervivencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "¡Cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010514,
					"content": "Pues bien, vayamos a la <color=#00E1FFFF>Sede de los Caballeros de Favonius</color> e informemos a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010512,
					"content": "Dijo algo sobre Jean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010507,
					"content": "El Mago del Abismo voló por los aires muy, muy rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				}
			]
		},
