				"points": []
			},
			"dialogs": [
				{
					"id": 102010101,
					"content": "¡Llegamos! ¡Este es el lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010102,
					"content": "Miren, aquí es donde enterré mi enorme tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010103,
					"content": "Y donde ahora hay un enorme agujero vacío en el suelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010104,
					"content": "Un momento, ¿quién es ese de allí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "¡¿Un Mago del Abismo?! Tal vez es del que nos advirtió Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010106,
					"content": "¿Qué tiene en la mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010107,
					"content": "¡Mi tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010108,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010109,
					"content": "#¡Hum! Veo que esa niñita trajo a sus {F#amigas}{M#amigos}. Cambio de planes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "Mago del Abismo"
				},
				{
					"id": 102010110,
					"content": "¡Oye, tú! Si tan fuerte crees que eres, ¡vuelve aquí a pelear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010111,
					"content": "¡Tras él!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
			],
