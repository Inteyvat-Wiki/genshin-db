				"points": []
			},
			"dialogs": [
				{
					"id": 710740801,
					"content": "Con estas tres, son nueve en total. Deberían ser suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740802
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740802,
					"content": "¡Trajiste tan rápido lo que quería el Salón Huishan! ¡No esperaba menos de ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740803
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740803,
					"content": "¡Fue pan mordido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740804,
					"content": "Querrás decir “pan comido”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740805
					]
				},
				{
					"id": 710740805,
					"content": "¡Ah! Paimon quiere decir... Humm... ¡Bueno, mordido y comido son la misma cosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740806,
					"content": "Felicitaciones por aprender a dar argumentos sólidos, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740807
					]
				},
				{
					"id": 710740807,
					"content": "Jaja... Paimon tiene razón. Todos fuimos testigos de sus actos heroicos al luchar contra el monstruo marino. Estoy seguro de que no tuvieron ninguna dificultad en lograr tal hazaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740808,
						710740809
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740808,
					"content": "Sí, es cierto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				},
				{
					"id": 710740810,
					"content": "Bueno, hasta aquí llegó mi trabajo en el Ministerio de Asuntos Civiles. Incluso te piden que hagas cosas como “buscar rocas ancestrales en la Sima”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740811
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740811,
					"content": "Cierto, dijiste que discutías con tu padre todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740812,
					"content": "Entonces, ¿cómo conseguiste un puesto en el Ministerio de Asuntos Civiles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740813,
					"content": "En ese momento tenía una gran deuda. Nadie me ayudaba y me rehusaba a volver a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740814
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740814,
					"content": "Al final, los cobradores fueron a buscar a mi padre al Salón Shenglu... Pensé que me rompería las piernas cuando se enterara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740815
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740815,
					"content": "Pero tus piernas parecen estar bastante enteras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740816,
					"content": "Sí... Es vergonzoso decirlo, pero él pagó la deuda. Luego me encontró en la calle y me dijo: “Tengo todos tus pagarés, así que ahora estás en deuda conmigo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740817
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740817,
					"content": "Con eso, me obligó a trabajar para pagar mi deuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740818
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740818,
					"content": "Así que ahora le debes dinero a tu padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740819,
					"content": "Exacto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740820
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740820,
					"content": "Por aquel entonces, con los cobradores de deudas persiguiéndome, no podía ni dormir por la noche. Así que juré que me redimiría si me daban una segunda oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740821
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740821,
					"content": "Pero no esperaba que la oportunidad viniera de mi padre, que siempre estuvo en desacuerdo conmigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740822
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740822,
					"content": "No discutió conmigo como de costumbre. En lugar de eso, tuvimos una charla, franca y sincera. Cómo me gustaría haberla tenido antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740823
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740823,
					"content": "Pero incluso si él hubiera estado dispuesto a conversar, yo no habría querido escucharlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740824
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740824,
					"content": "Parece que tu padre te trata bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740825,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740826
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740826,
					"content": "Así que tengo que hacer bien mi trabajo pase lo que pase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740827
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740827,
					"content": "Ya sea el incidente en la Sima o el asunto de la búsqueda de rocas ancestrales para el Salón Huishan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740828
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740828,
					"content": "Fui yo quien hizo el trabajo duro por ti esta vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740829
					]
				},
				{
					"id": 710740829,
					"content": "Encontrar gente que se encargue también cuenta como un método para cumplir con el trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740830
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740830,
					"content": "Pero aun así, es gracias a ustedes que terminamos el trabajo tan rápido, y mejor de lo que esperaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740831
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740831,
					"content": "Qué bien que lo reconozcas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740809,
					"content": "Sigue siendo un reto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				}
			]
		}
	]
}