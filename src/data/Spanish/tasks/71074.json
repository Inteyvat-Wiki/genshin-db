					"id": 710740501,
					"content": "¿Encontraron las rocas ancestrales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740502
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740502,
					"content": "Aquí están.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107406,
			"completionStepIds": [
				7107405
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "Tres más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740602,
					"content": "#Con mucha gratitud recibo estas rocas ancestrales de parte de dos ciudadan{F#as}{M#os} de vocación ciudadana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740603,
					"content": "No esperaba que encontraran dos de ellas tan rápido. Y son de mejor calidad que las que he visto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740604,
					"content": "*Suspira*... Me recuerdan a la roca antigua que yo tenía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740605,
					"content": "¿Tú tenías una?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740606,
					"content": "#¿Entonces por qué nos haces buscar a nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "Me refería a una que TENÍA.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740609,
					"content": "Mi padre se encargó una vez de un lote de minerales en el Salón Shenglu. Entre los restos había una pequeña roca ancestral de baja calidad, así que me la regaló como juguete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740610,
					"content": "Entonces, discutíamos todo el tiempo. Yo no tenía trabajo y, para empeorar las cosas, pasaba la mayor parte del tiempo en el Salón de Té Yanshang. Por eso, terminé con una gran deuda, y estaba desesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740611,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740612,
					"content": "Eso no suena nada bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "Bueno, ¿quién no ha hecho una o dos tonterías de joven? De todos modos, estaba perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740614,
					"content": "Alguien reconoció mi roca ancestral y me ofreció un buen precio. Una piedra a cambio de algo de Moras para salir del problema que me traía entre manos era un intercambio justo, en mi opinión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740615,
					"content": "Pero mi padre sacó el tema el otro día preguntando dónde había puesto la roca que me dio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740616,
					"content": "Todo lo que pude decirle fue: “Era solo una roca. Hace tiempo que la perdí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740617,
					"content": "Y, a pesar de todo, no pude evitar preguntarme qué habría pasado si no hubiera vendido la piedra. Habría podido mostrársela cuando la mencionó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740618,
					"content": "... Olvídalo. Ahora es inútil preguntarse qué habría pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740619,
					"content": "Al menos volvió el hijo pródigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740620,
					"content": "Tienes razón... Es solo que aún me queda mucho camino por recorrer para poder saldar mi deuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740621,
					"content": "Me he desviado del tema. Si encuentran más rocas, tráiganmelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740622,
					"content": "¿Todavía no son suficientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "Humm... Tráiganme tres más. Con tres más sería suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740625,
					"content": "Las rocas ancestrales son un mineral raro. Si el Salón Huishan quiere más, dudo mucho que pueda encontrarlas aquí en La Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740623,
					"content": "¿Cuántas necesitas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "Vamos, primero entrega la tuya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
