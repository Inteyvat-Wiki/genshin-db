					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740101,
					"content": "Rocas ancestrales... *Suspira*, en todos los años que he trabajado en la Sima, apenas las he visto una vez. ¿Qué se han creído esos peces gordos del Salón Huishan...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740102,
					"content": "Que ellos hagan el trabajo para que sepan lo difícil que es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740103
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740103,
					"content": "¡Muning!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740104,
					"content": "Oh, son ustedes. ¿Por qué siguen merodeando por la superficie de la Sima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740105,
					"content": "#Oh, no me malinterpreten. No es que no me alegre de verl{F#as}{M#os}. Solo me pregunto... ¿no tienen otros asuntos importantes que atender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740106,
					"content": "¿Eh? Solo pasamos a saludar, pensamos que tenías problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740107,
						710740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740107,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				},
				{
					"id": 710740109,
					"content": "*Suspira*... ¿Has oído hablar de las rocas ancestrales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740110
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740110,
					"content": "Son un mineral raro, tan raro que ni siquiera podrías encontrar una en las minas. Solo he visto dos o tres piedras de este tipo en todos los años que llevo en la Sima. Su belleza va más allá de la imaginación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740111
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740111,
					"content": "Dicen que si se mira dentro de las mejores rocas ancestrales, se encuentran brillantes rayos de luz tan finos como un cabello, y que su color recuerda al horizonte del mar durante el crepúsculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740112
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740112,
					"content": "¿Te refieres a una roca como esta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740113
					]
				},
				{
					"id": 710740113,
					"content": "Oh, ¡qué sorpresa que tengas una! Y es de la más alta calidad que he visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740114
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740114,
					"content": "#{NICKNAME}, ¿qué tal si me vendes esta roca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740115,
						710740116
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740115,
					"content": "Ni lo pienses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740117,
					"content": "¡Sí! Es un regalo de un amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740118,
					"content": "Además, Paimon duda seriamente que tu billetera sea lo suficientemente gorda como para comprarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740119,
					"content": "Bueno... Tengo compradores que me apoyan, así que las finanzas no son exactamente un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740120
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740120,
					"content": "¿Compradores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740121,
					"content": "Sí, de alguna manera esas rocas han despertado el interés de algunos peces gordos del Salón Huishan, así que quieren que saque algunas de la Sima y se las lleve para investigarlas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740122
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740122,
					"content": "Pero estoy ocupado lidiando con... *Ejem*, quiero decir, cumpliendo con mi deber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740123
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740123,
					"content": "#¿Qué tal si hacemos un trato, {NICKNAME}? Si encuentras alguna roca ancestral, tráemela y te daré la recompensa del Salón Huishan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740124
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740124,
					"content": "No es necesario que sean de la misma calidad que la tuya, siempre que sean rocas ancestrales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740125
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740125,
					"content": "¡La recompensa del Salón Huishan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740126,
					"content": "Normalmente, yo mismo me encargaría del trabajo, pero últimamente tengo las manos atadas por varios asuntos aquí en la Sima. Por favor, ayúdenme con eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740127
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740127,
					"content": "*Suspira*, no sé cuántas quieren. Yo creo que con tres debería bastar por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740128
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740128,
					"content": "Está bien, está bien, entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740116,
					"content": "Ni lo sueñes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740108,
					"content": "¿Te preocupa algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				}
			]
		},
