					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107404,
			"completionStepIds": [
				7107403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107403",
							"2"
						],
						"stepId": 7107403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "Estas son, efectivamente, las rocas ancestrales. Tienen mi agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740402,
					"content": "Hice bien en acudir a ti. Supongo que habría tardado mucho más si hubiera sido el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740403,
					"content": "Quién sabe... Tal vez el Gremio de Aventureros podría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740404,
					"content": "#... darnos el encargo directamente a nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "Exactamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740406,
					"content": "Aventureros... Humm... Solía envidiarlos por explorar altas montañas y profundos dominios. Parece que no hay ningún lugar al que no se atrevan a ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740407,
					"content": "Sin embargo, yo soy todo lo contrario, llevo años trabajando aquí pero no he visitado ni una sola vez el Acantilado Cinabrio, en la parte más alta de la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740408,
					"content": "¿Qué? ¿No has estado allí ni una vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740409,
					"content": "El Acantilado Cinabrio es uno de esos famosos lugares turísticos a los que los lugareños rara vez van.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740410,
					"content": "Tal vez está tan cerca que siempre siento que puedo visitarlo más tarde, cuando tenga tiempo, pero bueno... nunca tengo tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740411,
					"content": "¿Por qué no vamos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740412,
					"content": "Es importante darse un capricho de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740413,
					"content": "Creo que lo dejaré pasar por ahora. Todavía estoy en mitad de otro asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740414,
					"content": "Además, esto de hacer recados es mejor dejarlo para los aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740415,
					"content": "Siempre se han aventurado en lugares peligrosos. Yo probablemente me lesionaría si hiciera lo mismo, y eso es algo que me gustaría evitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740416,
					"content": "Tiene sentido. Lesionarse podría ser un gran problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740417,
					"content": "Si me lesiono, nadie va a supervisar al equipo de espeleología allí abajo ni a garantizar la seguridad de los mineros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740418,
					"content": "Si algo ocurriera, se convertiría en un asunto grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740419,
					"content": "¿Eso es lo que te preocupa? ¡Paimon pensó que solo temías lesionarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740420,
					"content": "Los acantilados son formidablemente altos cerca de la Sima, las cuevas parecen no tener fondo, y el antiguo campo de batalla dejado por Rex Lapis... Todo está lleno de peligros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740421,
					"content": "No tengo el menor interés en aventurarme en esos lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740422,
					"content": "Tomen, aquí tienen la recompensa por las rocas ancestrales. Parece que los del Salón Huishan necesitan un montón, así que si encuentran más, no duden en traérmelas. Las aceptaré de tres en tres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740423,
					"content": "Y, claro está, les daré una recompensa a cambio. Solo tienen que traerme las rocas ancestrales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740424,
					"content": "#¡Cuenta con nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7107405,
