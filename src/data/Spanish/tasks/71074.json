					"nextDialogs": [
						710740212
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740212,
					"content": "Así que ¿lo que quieres decir es que estás buscando unas rocas de colores bonitos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740213,
					"content": "No todas las rocas de colores bonitos sirven. Tiene que ser LA roca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740214,
					"content": "#Hablando de eso... ¿Qué te parece si me ayudas a buscar rocas que se ajusten a mi descripción, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740215,
					"content": "Tráemelas y las compraré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740216,
					"content": "Ehmm, Paimon duda seriamente que tu billetera sea lo suficientemente gorda para comprar ese tipo de roca.",
