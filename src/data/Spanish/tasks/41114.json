			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140801,
					"content": "Leonard... ¿Dónde estás, Leonard?... ¡Ajá, te tengo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140802,
					"content": "Según el catálogo, el libro de Leonard debería estar en la <color=#00E1FFFF>esquina noroeste</color> del <color=#00E1FFFF>piso de abajo</color> de la biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140803,
					"content": "La esquina noroeste... Debería estar justo allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
