			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141601,
					"content": "¡Guau! Este debe ser el núcleo... ¡Se ve totalmente diferente a los demás meteoritos! Es mucho más... brillante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141602,
					"content": "Esta piedra alberga una increíble cantidad de energía elemental y deseos humanos. Ciertamente, es el núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141603,
					"content": "¿Deberíamos... destruirlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "Sí. De lo contrario, las víctimas nunca despertarán... El núcleo es la raíz de todo lo que ha sucedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141605,
					"content": "#¡Ánimo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141606,
					"content": "Guau, eso sí que no me lo esperaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141607,
					"content": "Un alpinista decidido a alcanzar el pico más alto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "¿Quién hubiera pensado que la voluntad humana podría sobrevivir en los cielos durante milenios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141610,
					"content": "¡La astrología es algo increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141611,
					"content": "¿Por qué lo dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141612,
					"content": "La capacidad de comunicarse con las estrellas puede brindarte acceso a todos los secretos de la historia de la humanidad... Aunque, por supuesto, muy pocos astrólogos alcanzan ese nivel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141613,
					"content": "Mona, muchas gracias por toda tu ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "¿Eh? ¿Por qué te volviste tan formal de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141615,
					"content": "Y hablando de formalidad... ¿Qué le pasa a esa chica, Fischl? Es un poco rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141616,
					"content": "¡Paimon también lo cree! Ella es tan... ¿cómo decirlo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141617,
					"content": "Tiene la cabeza llena de fantasías.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "Sí... Aunque, si lo piensas... Parece que tenía razón todo este tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141620,
					"content": "¿Es una de esas personas que siempre obtiene lo que busca aun con el método incorrecto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141621,
					"content": "Quizás ese sea el caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141622,
					"content": "Aun así, Paimon piensa que lo más sorprendente de todo fue cómo la Cumbre Píleo se convirtió en una pequeña isla diminuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141623,
					"content": "Una antigua montaña se convirtió en una pequeña isla en medio del mar. Cualquier persona de Mondstadt puede llegar, solo tienen que hacerlo en un bote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141624,
					"content": "En otras palabras, ahora todos pueden escalar la Cumbre Píleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141625,
					"content": "Todos pueden llegar a la cima de la montaña.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "¿Crees que Leonard estaría feliz? Quizás se sorprendería por el estado actual de la Cumbre Píleo, pero gracias al Arconte Anemo, ahora la gente de Mondstadt puede volar hasta ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141627,
					"content": "Gracias a los planeadores, las personas pueden viajar más lejos y más alto que nunca, y explorar lugares nuevos y desconocidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141628,
					"content": "(Leonard... ¿Se habrá cumplido tu deseo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "Las víctimas deberían comenzar a despertarse ahora que nos hemos deshecho del núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141630,
					"content": "¡Y por fin hemos terminado nuestro encargo del Gremio de Aventureros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141631,
					"content": "Espero que todo el mundo se recupere pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "Tiene una imaginación desbordante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "Tenía tanta determinación que deseaba transmitírsela a otros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}