							"4111405",
							"2"
						],
						"stepId": 4111405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "¡Lo encontré! «Compendio de montañas y océanos», una guía para aventureros escrita por Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141402,
					"content": "Pero faltan palabras y páginas. ¡Paimon no puede leer esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141403,
					"content": "Tal vez venir hasta aquí haya sido una pérdida de tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141404,
					"content": "No podemos rendirnos. Veamos qué dice Mona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "¡Oh, cierto! ¡Mona! Tal vez ella tenga una mejor idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111415,
			"completionStepIds": [
				4111415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111415",
							"2"
						],
						"stepId": 4111415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141501,
					"content": "¡Vaya, qué fuerte eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141502,
					"content": "¡Te lo advertí! ¡Eso es lo que pasa cuando me faltan el respeto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141503,
					"content": "Mona, eres muy fuerte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "¡Y que lo digas! Paimon, tú también estás de acuerdo, ¿cierto? Les mostré a esos Fatui quién manda aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141505,
					"content": "¡Claro que sí! Sin ti, ¡esos tipos nos habrían dado más problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141506,
					"content": "¿Qué te pareció eso, heraldo de Los Once? ¡Cretino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141507,
					"content": "La verdad es que se veía asustado, y no creo que estuviera mintiendo. Cuando aprendía hidromancia, mi maestra siempre me hablaba de un “cielo falso”... ¿Qué querría decir con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141508,
					"content": "*Ejem*, estoy divagando. Vamos, terminemos el trabajo que vinimos a hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141509,
					"content": "¡El <color=#00E1FFFF>núcleo</color> tiene que estar por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111416,
			"completionStepIds": [
				4111416
			],
