				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "¡Encontramos el libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140902,
					"content": "¡Déjame ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140903,
					"content": "Faltan muchas partes, no tiene ningún sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "Ja, debí suponerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140905,
					"content": "Un astrólogo del montón se daría por vencido a estas alturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140906,
					"content": "Pero yo soy Mona, la madre del futuro de la astrología. Nada puede interponerse en mi camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140907,
					"content": "Solo tengo que adivinar las partes que faltan con mi astrolabio, escribirlas y luego descifrar el texto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140908,
					"content": "¡Uf! Al fin terminé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140909,
					"content": "¿Qué dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140910,
					"content": "Como pensaba, Leonard era un aventurero que vivió hace dos mil años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140911,
					"content": "Su sueño de toda la vida fue llegar a la cima de una montaña llamada Cumbre Píleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140912,
					"content": "¿Dos mil años? Entonces, ¿la constelación que causó los meteoritos es de hace dos mil años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140913,
					"content": "Por alguna razón, esta constelación fue invocada desde el cielo. Sospecho que los Fatui tienen algo que ver con ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140914,
					"content": "Paimon también lo cree. Siempre que sucede algo turbio, los Fatui están metidos en ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140915,
					"content": "Los meteoritos irradian una energía elemental que adormece a las personas. Hace que caigan inconscientes en una especie de hipnosis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140916,
					"content": "Si no me equivoco, debería haber un meteorito central entre todos los demás, y en su interior debe haber un cristal que alberga el espíritu de Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140917,
					"content": "¿Cómo lo encontramos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "Bueno, si yo fuera Leonard, me aseguraría de que el núcleo aterrizase justo en la cima de la montaña que nunca fui capaz de escalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140919,
					"content": "Entonces, ¿el núcleo debería estar en la cima de la Cumbre Píleo? ¿Dónde está eso? Paimon nunca había oído hablar de ese sitio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140920,
					"content": "Yo también es la primera vez que oigo hablar de él, así que comparé el mapa del libro con la topografía actual de Mondstadt. Al parecer, la Cumbre Píleo ya no existe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140921,
					"content": "¿Una montaña tan grande puede desaparecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140922,
					"content": "Una vez leí que en el pasado, el Arconte Anemo, Barbatos, usó su poder divino para controlar el viento y deshacerse del hielo y la nieve de la faz de la tierra. Así, todo el paisaje de Mondstadt cambió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140923,
					"content": "Las montañas de aquella época fueron reemplazadas por el vasto océano de hoy en día. Aun así, una montaña tan alta debería haber dejado algún rastro al caer al mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140924,
					"content": "De hecho, la cumbre aún sobresale por encima del agua. Hoy en día se conoce como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140925,
					"content": "“<color=#00E1FFFF>Arrecife de Musk</color>”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4111411,
			"completionStepIds": [
				4111411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111411",
							"2"
						],
						"stepId": 4111411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scaramuccia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "¿Eh? Entonces, ¿esto es la Cumbre Píleo? No es gran cosa hoy en día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141102,
					"content": "Parece que alguien se nos adelantó... ¿Es que esto es un lugar turístico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141103,
					"content": "¡Ah! ¡Eres tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141104,
					"content": "¿Eh? ¿Ustedes otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141105,
					"content": "¿Cómo encontraste este lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "Mira en qué estado se encuentra... ¿Tal vez se acaba de despertar de ese sueño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141108,
					"content": "Salió del sueño por sí mismo... ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141109,
					"content": "¡Hum! Que ustedes sean unos incompetentes no quiere decir que yo también lo sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141110,
					"content": "En fin, llegan tarde. Ya terminé mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141111,
					"content": "¡Lo sabíamos! ¡Todo esto fue un truco sucio de los Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141112,
					"content": "#Tranquil{F#as}{M#os}, hoy no tengo tiempo para jugar con ustedes. Nos veremos pronto, cuando esté listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141113,
					"content": "¡Espera! ¿Qué es lo que quieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "Tuviste el mismo sueño que los demás, ¿cierto? ¿Qué sabes tú de Leonard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141115,
					"content": "¿Leonard? ¿Quién es Leonard?... En fin, no es momento para preocuparme por nimiedades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141116,
					"content": "Descubrí algo mucho más importante... y aterrador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141117,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141118,
					"content": "¿Qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "Las estrellas, el cielo... Todo es un enorme engaño, una mentira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141120,
					"content": "¿Las estrellas son una mentira? ¿De qué estás hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141121,
					"content": "Si quieres debatir con Mona sobre astrología, no tienes por qué decir que “las estrellas son una mentira”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141122,
					"content": "En serio, ¿quién va a creerte si basta con alzar la cabeza y ver el cielo estrellado? Es de sentido común...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141123,
					"content": "Ja... ¡Jajajaja! ¡Qué ingenuos son!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141124,
					"content": "Bueno, no puedo culparlos. Después de todo, yo creía lo mismo hasta hace solo un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141125,
					"content": "¿Hace un momento? Quieres decir que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141126,
					"content": "Lo siento, pero no tengo tiempo para esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141127,
					"content": "¿En qué estaba pensando, Pierro? Seguro que ya sabía lo que íbamos a descubrir en esta misión, pero... ¿tan difícil era advertirme de ello? Tal vez solo quería darme un susto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141128,
					"content": "#Ya es hora de que descubra la verdad. ¡Hasta luego, tont{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scaramuccia"
				},
				{
					"id": 411141106,
					"content": "¿Te acabas de despertar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
		{
			"id": 4111414,
			"completionStepIds": [
				4111405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
