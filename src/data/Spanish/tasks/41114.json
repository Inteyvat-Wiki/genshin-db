				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140701,
					"content": "Ha habido muchos aventureros con ese nombre a lo largo de los años. Es imposible saber a cuál te refieres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140702,
					"content": "Sin embargo, recuerdo que hay un libro en la biblioteca escrito por alguien con ese nombre. Quizás deberías echarle un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140703,
					"content": "Sin embargo, recuerdo que hay un libro en la <color=#00E1FFFF>biblioteca</color> escrito por un tal Leonard. Quizás deberías echarle un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 4111408,
			"completionStepIds": [
				4111414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
