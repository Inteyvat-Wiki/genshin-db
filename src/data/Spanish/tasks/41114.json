			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "¿Eh? Fischl, ¿nos estabas esperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140102,
					"content": "Por fin ha llegado el momento. Aunque la señorita no quiere hacerlo, hay algo que debe anunciar a los aquí presentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140103,
					"content": "Mis leales servidores, debo despedirme de ustedes por el momento. Han demostrado un valor encomiable en el desempeño de su deber. Siento que una brisa sopla ahora en tu honor sobre este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140104,
					"content": "¿Qué? ¿Nos vas a abandonar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140105,
					"content": "Fischl, ¿te vas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "Este meteorito gigante ha hecho que muchas más personas sucumban al letargo. Por muy fuertes que sean los soldados, les está costando hacerle frente y existe una escasez de personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140107,
					"content": "La señorita y yo nos ocuparemos de las víctimas. El resto de esta investigación la dejamos en sus hábiles manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140108,
					"content": "#Adiós, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140109,
					"content": "Se te da bien escuchar a otros, y disfruté mucho hablando contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140110,
					"content": "El resto de los aventureros del Gremio solo me hablan cuando quieren escuchar los informes de investigación de Oz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140111,
					"content": "Esta pequeña expedición... fue una gran aventura. Lamento que tenga que terminar tan de repente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140112,
					"content": "¿Eh? Hablas diferente a como de costumbre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140113,
					"content": "¡!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140114,
					"content": "(¡Ay! ¿Qué estoy haciendo? ¡Rompí totalmente el protocolo!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140115,
					"content": "L-la señorita quiere decir que... con su magnánima valentía e incomparable sabiduría, ustedes han extinguido cualesquiera que fueren los místicos enigmas que se interpusieron en su camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140116,
					"content": "La traducción de Oz suena aún más disparatada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140117,
					"content": "*Ejem*, la señorita quiere decir que tiene plena confianza en que llegarán a la verdad sobre este asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140118,
					"content": "#*Ejem*, exacto. Mis querid{F#as}{M#os} asistent{F#as}{M#es}, por la presente ordeno que el Caballero del Juicio los escolte fuera de la oscuridad y de regreso al reino de la luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140119,
					"content": "#¿A quién llamas “asistent{F#a}{M#e}”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140120,
					"content": "Gracias, Oz y Fischl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "Volveremos a vernos. Una vez concluido este asunto, propongo que tomemos una copa juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140122,
					"content": "Bueno, ahora nos faltan dos personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140123,
					"content": "Pero no hay por qué preocuparse. La buena noticia es que he descubierto algo más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140124,
					"content": "Tomé un poco de polvo del meteorito para hacer otra adivinación. ¡Fue muy efectivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140125,
					"content": "Estas rocas han existido durante cientos, tal vez incluso miles de años. Leonard debió haber vivido hace mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140126,
					"content": "Los meteoritos transmiten su voluntad. En otras palabras, siglos después, su fuerza de voluntad no ha disminuido ni un ápice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140127,
					"content": "Alguien de un pasado lejano con la gran ambición de escalar la montaña más alta... Apuesto que era un aventurero, como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140128,
					"content": "¿Un aventurero? ¡Eso explica su obsesión por el montañismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140129,
					"content": "Hasta ahora, nuestro enfoque ha sido demasiado pasivo y el tiempo siempre ha estado en nuestra contra. Debemos cambiar de estrategia y solucionar este problema desde la raíz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140130,
					"content": "¡Paimon está de acuerdo! De ahora en adelante, debemos concentrarnos en Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140131,
					"content": "Sí... Porque si los meteoritos llevan la voluntad de Leonard, entonces Fischl tenía razón. Estas rocas son, en cierto sentido, una maldición...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140132,
					"content": "¿Quién iba a decir que acertaría?... *Ejem*, perdón, soy una astróloga respetable, así que no debería rebajarme a hacer ese tipo de comentarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140133,
					"content": "En fin, ahora solo tenemos que eliminar la maldición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140134,
					"content": "Vamos, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "¡De acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140136,
					"content": "Como se trata de un aventurero del pasado, Paimon cree que deberíamos visitar el <color=#00E1FFFF>Gremio de Aventureros</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
