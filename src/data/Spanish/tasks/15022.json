			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Según lo que dijo Allpa... Tepal era miembro de los Vástagos del Eco, ¿verdad? ¿Cómo lo encontraremos? ¿Preguntando a todos uno a uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Será más rápido si le pedimos ayuda a algún conocido de los Vástagos del Eco. Teniendo en cuenta el momento y el lugar en el que nos encontramos, la persona más indicada es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Xilonen, ¡arriba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*Bosteza*... Son ustedes... Un momento, ya bajo del árbol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "*Bosteza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "Parece que a ambas les encanta encaramarse a los árboles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Si me subo a un árbol es para poder volar más tiempo y ver más lejos... No suelo dormir sobre las ramas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "No todos somos como tú, que no te cansas ni después de andar todo el día de arriba para abajo... Bueno, ¿por qué han interrumpido mi preciada siesta esta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Lo siento, Xilonen, pero se trata de un asunto urgente. ¿Conoces a un artesano llamado Tepal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "¿Tepal? De algo me suena... ¿No es el hijo de Puma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "¿Se encuentra en la tribu ahora mismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "No, se marchó hace varios años... ¿Por qué lo están buscando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Le explican lo ocurrido lo más concisamente que pueden...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "¿Alas de flogisto? Vaya, así que el muchacho realmente logró crear algo tan increíble... Bueno, parece que mi descanso de hoy ha llegado a su fin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "¿Realmente logró? ¿Acaso ya había investigado sobre algo así antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "Sí, en cuanto regresó de la Tribu Plumaflora, comenzó a investigar sobre la forma de crear un artilugio artificial que le permitiera volar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Entonces, fue después de convertirse en un “sin alas”... Un artilugio artificial... ¿como la pistola que creaste para mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Tu pistola es más difícil de domar que el Qucusaurio más altivo... Lo que él quería, por el contrario, era hallar la forma de que hasta alguien normal y sin talento pudiera volar libremente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Pero solo halló el fracaso. Hizo volar por los aires varios talleres y casi perdió la vida. En cuanto a qué sucedió después... La verdad es que no presté demasiada atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Los padres de Tepal habían pasado su juventud fuera de la tribu, y solo regresaron cuando lo tuvieron a él. Aun así, vivían en un lugar bastante alejado y no solían tener mucho contacto con los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "La gente de la tribu no los conocía muy bien... Si quieren saber más detalles sobre Tepal, sería mejor que fueran a hablar con su familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Iré a buscar a Puma. Pueden esperar en la entrada de mi taller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
		{
			"id": 1502202,
