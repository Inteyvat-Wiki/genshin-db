			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, por fin regresan. El ambiente está cada vez más tenso en la tribu. ¿Han averiguado algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Hay quienes sospechan incluso que arrestamos a los mercaderes para mostrar nuestro apoyo a la Brigada de Vuelo y desprestigiar el uso de las alas de flogisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Y aun así, el conflicto está extendiéndose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Hemos encontrado algunas pistas, pero si queremos conseguir las pruebas definitivas, debemos enfrentarnos a un problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca les explica lo que han averiguado sobre Tepal y la hipótesis del taller en el cielo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "¿Una reliquia de la Ciudad de las Cenizas? No me puedo creer que tras todos estos años, Och-Kan siga sembrando discordias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Un taller en el cielo... El globo aerostático que hay sobre el terreno de la prueba... ¿Es ese su próximo destino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "¿Hay alguna forma de subir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "No podrán volar tan alto a lomos de un Qucusaurio ni usando las alas de flogisto... ¿De verdad piensan que Tepal se encuentra allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Humm... Bueno, sí que hay una solución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "¡¿De verdad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "¿Recuerdan los orificios que había en el terreno de la prueba? Antes, las líneas ley anómalas y los bloqueos causaron la escasez de flogisto gaseoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Pero, si volvemos a obstruirlos ahora que hay flogisto gaseoso más que de sobra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Quieres decir que... ¿podríamos dejar únicamente el orificio más alto despejado y concentrar toda la presión en ese lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Así, el flogisto gaseoso concentrado formará una corriente de aire extremadamente intensa en las alturas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "#Que nosotr{F#a}{M#o}s podríamos usar para llegar hasta arriba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Exacto. Conlleva cierto riesgo, pero no debería ser un problema para alguien con el talento de Chasca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "Es bastante arriesgado, sí... pero factible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Si quieren saber más sobre cómo sellar los orificios, pueden preguntarle a Inkanak en el terreno de la prueba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca... El cometido de hacerse con las pruebas sobre las nubes depende enteramente de ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "¿Acaso hay alguien más que está incitando una revuelta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
