			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Esperan un rato ante el taller de Xilonen...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "#Siento haberl{F#a}{M#o}s hecho esperar. Esta es Puma, la madre de Tepal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Hola, somos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Pueden dejar las formalidades a un lado, no me apetece demasiado hablar de ese hombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "¿Eh?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "No sabemos nada de él desde hace tiempo... ¡Alguien así no es hijo mío!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Tiene la mente llena de ensoñaciones sobre volar y alcanzar los cielos... Nos fue imposible convencerlo para que volviera a la realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "¡Hum!... Al final, cuando se marchó, mencionó algo de construir un taller en el cielo para huir de las críticas de aquellos que seguíamos con los pies en la tierra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Estas son las notas que dejó al irse. Échenle un vistazo si tienen alguna duda. Yo no quiero seguir hablando del tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Ese no es hijo mío... De todas formas, él nunca me consideró su madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "P-Paimon no imaginaba que tendrían una relación tan mala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Su marido... El padre de Tepal falleció hace poco. Pero Tepal no apareció ni siquiera durante el funeral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Esa debió ser la gota que colmó el vaso para Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Yo voy a confortarla primero. Si quieren algo más, ya hablaremos más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Muchas gracias a las dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Entonces... ¿estas notas son la única pista que tenemos? ¿Qué dicen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Humm... Hablan del primer concepto de las alas de flogisto... Y de un hipotético taller en el cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Ochkanatlan, la Ciudad de las Cenizas... Parece que el prototipo de la tecnología que usó para las alas de flogisto proviene de allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "¿De veras pensaba construir un taller suspendido en el aire? ¿Podría hacer algo así él solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Mira el globo de este plano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "¡Ah! ¡Es el globo que había sobre el terreno de la prueba! ¡El que volaba tan alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "Ese globo lleva allí un largo tiempo, pero nadie sabe cómo llegó ahí arriba... Pero ¿y si la cuestión no es que alguien lo hiciera elevarse?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "Sino que, por algún fallo, “cayó” desde un nivel superior hasta alcanzar su ubicación actual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "¿Acaso era...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "¿Parte del taller en el cielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "Es muy probable. Con razón ni siquiera Isidoro conocía la ubicación de la base de Tepal... ¡Se escondía sobre las nubes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Así que realmente se ocultaba en el cielo... ¿Cómo vamos a llegar allí? Chasca... ¿tú puedes volar tan alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "#Sería complicado... Y si tengo que llevar conmigo a {NICKNAME}, ya ni lo digas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Aun usando las alas de flogisto, no creo que pudiéramos volar tan alto... A no ser que usemos la reliquia que mencionan sus notas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Pero esa reliquia debería seguir en manos de Tepal... Paimon no cree que sea posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "¿Tú puedes volar tan alto, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "¡Ni en sueños! Además, ¿cómo quieres que se enfrente Paimon sola a Tepal ahí arriba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "#Tranquil{F#a}{M#o}s, que no hayamos dado con la forma de hacerlo no significa que no sea posible. Yo no soy la única experta en vuelo de la Tribu Plumaflora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Eh... ¡Es cierto! ¡Podemos preguntarle a la anciana Allpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "Mutota también fue todo un maestro de la Brigada de Vuelo. Volvamos a la Tribu Plumaflora a pedirles consejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Esto me suena de algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
