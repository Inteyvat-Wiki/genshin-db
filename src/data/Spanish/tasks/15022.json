			"dialogs": [
				{
					"id": 150221101,
					"content": "Alcanzan el terreno de prueba a toda prisa y le explican la situación a Inkanak...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150221102
					]
				},
				{
					"id": 150221102,
					"content": "Ya veo... Es un plan muy osado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221103
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221103,
					"content": "No tenemos mucho tiempo, Inkanak. ¿Hay alguna forma rápida de sellar los orificios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221104,
					"content": "Desde un punto de vista técnico, mi recomendación sería llevar a cabo los cálculos y planificaciones necesarios antes de elaborar un plan concreto... pero creo que eso no es lo que quieren oír.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221105,
					"content": "Cierto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "Entonces solo nos queda la opción más sencilla y burda... ¿Ven esos bloques de flogisto sólido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221107,
					"content": "En una investigación previa, descubrimos que en su interior se ha formado una estructura estable y poco quebradiza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221108,
					"content": "Pero también poseen algunos puntos débiles estructurales, aunque pueden aguantar cualquier impacto si no se los golpea todos a la vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221109,
					"content": "Entonces, ¿sucederá algo si los golpeamos todos a la vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221110,
					"content": "Colapsarán de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221111,
					"content": "Está bien, creo que ya sé lo que planeas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221112,
					"content": "¡No esperaba menos de ti! Tan solo tienen que golpear todos los puntos débiles a la vez desde el ángulo adecuado para hacer que se desplomen contra los orificios... Así conseguirán sellarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221113,
					"content": "Es un plan sencillo y burdo, sí. Me viene como anillo al dedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
