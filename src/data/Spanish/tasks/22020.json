				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "#Qué bien verte por aquí, viajer{F#a}{M#o}. Parece que la jefa tenía razón cuando dijo que volveríamos a encontrarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200102,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "La jefa me dijo que hiciera algunas cosas para dar por concluido el caso anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200104,
					"content": "Solo es llevarles unas golosinas a los guardias para agradecerles su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200105,
					"content": "Seguro que ya nos están agradecidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "Cierto, pero esto es una excusa para ser amables con ellos y hacerles un regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200108,
					"content": "Después de todo, es posible que la agencia vuelva a necesitar su ayuda en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200109,
					"content": "Seguro que eso te lo enseñó Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Jeje, exacto. Tu intuición es tan aguda como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200112,
					"content": "¿Y tú qué piensas al respecto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "¿Yo? Amano, Andou y yo solíamos ser colegas, así que es normal llevarles unos dulces a unos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200114,
					"content": "Pero... la jefa me dijo que fuera a investigar otro caso, así que no creo que me dé tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200115,
					"content": "#Viajer{F#a}{M#o}, ¿te importaría llevarle estas golosinas a tres personas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200116,
					"content": "Cuenta conmigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Gracias por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200121,
					"content": "Aquí tienes tres golosinas para Amano, Andou y el señor Owada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200122,
					"content": "¿Quién es el señor Owada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "Es... un antiguo colega. Cuidó mucho de mí cuando trabajaba en la policía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200124,
					"content": "Nos ayudó a lidiar con la policía durante el caso de los robos en serie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200125,
					"content": "#Cuento contigo para esto, viajer{F#a}{M#o}. Nos veremos aquí cuando hayas entregado las golosinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200118,
					"content": "Creo que es mejor que los lleves tú en persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "Es que... la tarea que me encomendó la jefa es un poco urgente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200120,
					"content": "Más tarde buscaré un hueco para visitarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200110,
					"content": "Suena a algo que diría la detective Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "¿No fuimos nosotros quienes los ayudamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202002",
							"2"
						],
						"stepId": 2202002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amano",
					"Andou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "#¿Eh? Viajer{F#a}{M#o}, ¿qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200202,
					"content": "Tengo algo de parte de Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "Oh, a ver... ¡Son mochis de cerezo! Qué amable de su parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200204,
					"content": "#Ey, Andou, deja de ser tan precavido. Podrá ser {F#una}{M#un} foraster{F#a}{M#o}, pero acaba de ayudarnos, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200205,
					"content": "Menos mal que Ryuuji se acordó de lo que nos gusta. Al menos veo que el tiempo que trabajamos juntos no fue en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200206,
					"content": "¿Ryuuji trabajó con ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "¿Eh? ¿No te lo ha comentado? Ambos trabajamos juntos durante un breve periodo de tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200208,
					"content": "Pero de repente se vio involucrado en cierto incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200209,
					"content": "Al final, gracias a la detective Sango, atraparon al verdadero ladrón y él quedó libre de culpa, pero entonces se fue de la policía para trabajar con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200210,
					"content": "Aparte de eso, no sé nada más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200211,
					"content": "Creo que eso es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200212,
					"content": "Sí. El caso es que, ahora que está con Sango, su trabajo es mucho más relajado que el nuestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200213,
					"content": "Si pudiera, a mí también me gustaría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200214,
					"content": "*Ejem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200215,
					"content": "#*Ejem*, oh, nada. Gracias, viajer{F#a}{M#o}. Me quedaré con estas golosinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200216,
					"content": "Saluda a Ryuuji y a la detective Sango de mi parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amano"
				}
			]
		},
		{
			"id": 2202003,
			"completionStepIds": [
				2202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202003",
							"2"
						],
						"stepId": 2202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada",
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "#¿Eh? Oh, eres... {F#la viajera}{M#el viajero}, ¿cierto? Amano me habló de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200302,
					"content": "¿Me buscabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200303,
					"content": "Tengo algo de parte de Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "¡Guau, son mochis de cerezo! No puedo comerlos así sin más. Debo buscar un lugar adecuado donde degustarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200305,
					"content": "Uesugi, cúbreme un rato. Si alguien me necesita, dile que espere un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200306,
					"content": "Pero, señor Owada, estamos en horario de trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200307,
					"content": "Jajaja, ¿qué mas da? Solo voy a salir a tomar el fresco. Vuelvo enseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200308,
					"content": "*Suspira*, está bien... Pero vuelva pronto. Si viene alguno de los altos mandos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200309,
					"content": "No te preocupes. Acabamos de resolver un caso, así que si alguien se presenta aquí, será para felicitarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200310,
					"content": "Bien, te dejo a cargo, Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200311,
					"content": "#Viajer{F#a}{M#o}, ven conmigo a dar una vuelta. Conozco el lugar perfecto para comer estas golosinas en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202005",
							"2"
						],
						"stepId": 2202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "Oh... ¿qué te parece este sitio? Suelo venir aquí para darme un respiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "El paisaje es hermoso y el aire fresco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "Si querías preguntarme algo, ahora es el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "¿Tú también fuiste compañero de trabajo de Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "¿Te lo dijo él? Así es, Ryuuji y yo trabajamos juntos alguna vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "No sé si Ryuuji te ha contado lo que pasó en aquel entonces, o tal vez ya lo sepas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "En pocas palabras, debido a lo impulsivo que era, cayó en la trampa de otra persona y se convirtió en chivo expiatorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "Yo testifiqué en su favor, pero el juez responsable estaba empeñado en declararlo culpable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "Le pedí a mucha gente que investigara el caso, pero o no averiguaban nada, o me decían que no continuara con mi investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "Jeje. En aquel entonces, yo... Humm, ¿cómo decirlo? Hice caso de esas advertencias y dejé de insistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "Con este asunto ocurre lo mismo que con la injusta acusación de Ryuuji: es un secreto que todo el mundo conoce, así que no pasa nada si te lo cuento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Bueno, si todo el mundo lo sabe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "Es precisamente porque todo el mundo sabía que nadie quería intervenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Pero una detective que “no sabía nada” justamente vino a la policía para una reunión y se interesó por el caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "Gracias a esa detective, se descubrió la verdad y Ryuuji quedó libre de culpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Entonces Ryuuji dejó la comisaría y, desde ese momento, ha estado trabajando junto a la detective. Y ahí termina la historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "¿Por qué me cuentas todo esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "¿Quién te dijo que me trajeras este obsequio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Si lo ha hecho, seguramente hayan sido órdenes de su jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "Por como es Ryuuji, si la detective Sango le hubiera dicho que entregara el obsequio personalmente, lo habría hecho aunque hubiera tenido que atravesar un mar en llamas, y además sin que el obsequio sufriera daño alguno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Si te pidió que me lo trajeras tú, lo más seguro es que su jefa se lo ordenara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "Entonces, ¿la detective Sango quería que yo supiera todo esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "#Jajaja, eres muy perspicaz. El hecho de que estés aquí es como si Sango me estuviera enviando un mensaje que dice: “Tengo {F#una nueva}{M#un nuevo} ayudante”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "Parece que aún le preocupa eso que ocurrió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "Pero no me extraña. Después de todo... todavía no ha dado con la persona que tendió aquella trampa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Bueno, eso es todo lo que te puedo contar. Tú decides si quieres trabajar con Sango o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "Por cierto, cuando veas a Ryuuji, dale las gracias de mi parte por regalarme estos mochis de cerezo. Siempre me han gustado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "¿Por qué dejó la policía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "Fue una elección personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202005,
			"completionStepIds": [
				2202006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
