				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "#Hola, viajer{F#a}{M#o}. ¿Ya entregaste los regalos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "Sango te ordenó hacerlo, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "Así que lo averiguaste... Lo siento... Sí, fue la jefa quien quiso que entregaras esos regalos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "Dijo que, para resolver mi caso por completo y descubrir al verdadero culpable, tú eres una pieza clave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "¿Aún no lo han resuelto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "No. La jefa dice que, cuando encontró al presunto culpable, todo le pareció demasiado... perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Al comenzar la investigación, las pistas, el móvil del crimen y las pruebas parecieron llegar por sí solos hasta ella, y todos apuntaban a la misma persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "Aunque al final la policía consideró que esa persona era la culpable, la jefa siempre ha pensado que el culpable es alguien más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Creo que me dio un trabajo en la agencia para tener la oportunidad de resolver el caso de una vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Pero ¿cuál es mi papel en todo esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Para mí, es imposible saber las intenciones reales de la jefa, pero una vez me dijo que quizás le cuesta ver algunas cosas porque nunca ha salido de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Si alguien astuto y con una mente despejada nos ayudara, quizás podríamos progresar significativamente con el caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "#Viajer{F#a}{M#o}, creo que la jefa piensa que esa persona eres tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "#Entonces, ¿ya soy {F#una}{M#un} detective?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "#Claro, siempre y cuando estés dispuest{F#a}{M#o} a ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "En cualquier caso, ya nos has ayudado mucho. Por favor, acepta esta recompensa por el trabajo de esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "¿Sango también te dijo que dijeras eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "No, no. Eso es algo que pienso de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "Gracias de nuevo. Puedes venir a la agencia cuando quieras. Estoy convencido de que la jefa estará encantada de verte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "El trabajo está bien pagado, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "#No puedo decirlo a ciencia cierta, pero... será una paga con la que te sentirás más que satisfech{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "¿Es este el crimen perfecto del que hablaba Sango?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "Sí. La jefa dice que, cuando encontró al presunto culpable, todo le pareció demasiado... perfecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Al comenzar la investigación, las pistas, el móvil del crimen y las pruebas parecieron llegar por sí solos hasta ella, y todos apuntaban a la misma persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200513,
					"content": "Aunque al final la policía consideró que esa persona era la culpable, la jefa siempre ha pensado que el culpable es alguien más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "¿No tienes nada que contarme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
		},
