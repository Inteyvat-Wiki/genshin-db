				{
					"id": 790350101,
					"content": "#{NICKNAME}, Paimon, ¿vieron a dos tanuki? Uno con una bolsa púrpura y otro con una bolsa amarilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350102,
					"content": "¡Ah! ¡Seguro que son Mamesuke y Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350103,
					"content": "Así que los conocen, ¡qué bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350104,
					"content": "¿Eh? ¿Les sucedió algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350105,
					"content": "En realidad no, me entregaron esto después de hacer unos gestos extraños mientras bailoteaban...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350106,
					"content": "Escuché que ustedes fueron una vez al Buen Cazador con un tanuki de Inazuma, así que pensé que podrían ser amigos suyos. Creo que querían que les diera esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350107,
					"content": "¡Ooh! ¡Un regalo de Mamesuke y Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350108,
					"content": "Jeje, ¡parece que su viaje ha empezado bien! ¿Volveremos a encontrarnos?...",
