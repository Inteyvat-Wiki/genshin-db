			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#¿Guau? ¿Qué sucede, {F#señorita viajera dorada}{M#señor viajero dorado}? ¿Hay algo en lo que pueda ayudarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Srta. Dama Canina"
				},
				{
					"id": 762140302,
					"content": "Invitas a la Srta. Dama Canina a la fiesta del té del Sr. Gato Gris...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "¿Eh? ¡¿Ya es tan tarde?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Srta. Dama Canina"
				},
				{
					"id": 762140304,
					"content": "¡Muchas gracias! Guau, si no hubiera estado tan ocupada, habría ido personalmente a invitar a la Srta. Gata Naranja... Si lo hubiera hecho, quizás el Sr. Gato Gris no habría...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Srta. Dama Canina"
				},
				{
					"id": 762140305,
					"content": "Ya sean gatos o perros, todos podemos convivir en paz... Seguro que sí. En fin, ¡ahora mismo voy a la hora del té! ¡Gracias por avisarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Dama Canina"
				}
			]
		},
