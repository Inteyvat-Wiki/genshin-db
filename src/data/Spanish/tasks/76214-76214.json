			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "Miau... Tu técnica con la espada... es impresionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Srta. Gata Naranja"
				},
				{
					"id": 762140209,
					"content": "#Gracias, honorable caballer{F#a}{M#o} de tierras lejanas. Esos poderosos y arrogantes villanos ya no perturbarán el hogar de mi pueblo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Srta. Gata Naranja"
				},
				{
					"id": 762140210,
					"content": "Entonces, dígame. ¿Qué le trae a mi corte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Srta. Gata Naranja"
				},
				{
					"id": 762140202,
					"content": "¿Tu corte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Eh... Bueno, si esto es un cuento infantil, eso también será parte de la historia, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "Invitas a la Srta. Gata Naranja a la fiesta del té del Sr. Gato Gris...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Srta. Gata Naranja"
				},
				{
					"id": 762140208,
					"content": "#... Entiendo. Gracias, honorable caballer{F#a}{M#o} de tierras lejanas. Entonces, seguiré tu sabio consejo y partiré de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Gata Naranja"
				},
				{
					"id": 762140204,
					"content": "Su majestad, permítame informarle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "¡Vaya, qué rápido te has metido en el papel! *Ejem*, bueno, ya que es parte del guion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
