					}
				]
			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "Miau... Ya es la hora del té, miau. ¿Se habrán perdido, miau?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Sr. Gato Gris"
				},
				{
					"id": 762140102,
					"content": "#¡Ah, {F#señorita viajera dorada}{M#señor viajero dorado}! Usted debe ser {F#la heroína elegida}{M#el héroe elegido}, miau! ¿Podría ayudarme a buscar a mis dos amigas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Sr. Gato Gris"
				},
				{
					"id": 762140103,
					"content": "¿Y tus amigas son...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Ah, y sobre las dos señoritas que aún no han llegado... Una es una gata parlante, como yo, pero de color naranja, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Sr. Gato Gris"
				},
				{
					"id": 762140107,
					"content": "Y la otra es una dama canina muy educada. Canina, sí, pero es muy dulce, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Sr. Gato Gris"
				},
				{
					"id": 762140108,
					"content": "Aunque una sea felina y la otra canina, mientras puedan sentarse juntas a tomar el té, ¡seguro que lo pasarán muy bien, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Sr. Gato Gris"
				},
				{
					"id": 762140109,
					"content": "Por la paz de Miauranópolis, ¡le pido que me eche una pata, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Gato Gris"
				},
				{
					"id": 762140104,
					"content": "#Vaya, ¡sí que es fácil ser {F#una heroína}{M#un héroe} hoy en día!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Bueno, no reparemos demasiado en los detalles, miau. Aunque no tenga la espada sagrada legendaria y no haya encontrado el legendario cáliz de agua pura, un héroe sigue siendo un héroe, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Sr. Gato Gris"
				}
			]
		},
