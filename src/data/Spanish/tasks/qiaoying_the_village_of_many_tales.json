				]
			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "¿Eh? ¿Dónde está la Srta. Guijarro? Estaba aquí hace un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501002,
					"content": "Se la llevó una Bestia Xuanwen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "¡No digas esas cosas aterradoras! Estará deambulando por ahí, perdida en sus pensamientos sobre la trama de la novela. Vamos a buscarla por los alrededores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501005,
					"content": "Ese campo de té nos puede dar unas buenas vistas, comencemos por allí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "¡Eso! ¡Comencemos por todo lo alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501003,
					"content": "¿Se está haciendo realidad su novela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
		{
			"id": 7005012,
			"completionStepIds": [
				7005012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
