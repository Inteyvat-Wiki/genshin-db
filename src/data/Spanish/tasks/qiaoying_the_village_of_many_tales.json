				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "¿Ves? Paimon te dijo que era solo un gato común.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "No puede ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500503,
					"content": "¿Miau? Miau... ¿miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Gato confuso"
				},
				{
					"id": 700500504,
					"content": "¿Sabes algo de las Bestias Xuanwen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "¿Miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Gato confuso"
				},
				{
					"id": 700500508,
					"content": "El gato se aleja con resignación.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Pero... ¿y si este gatito fuera la cría de alguna Bestia Xuanwen, y está escondido aquí en la Aldea Chiaoying para arrasar con todos los árboles de té en cuanto crezca?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500510,
					"content": "Srta. Guijarro, otra vez usted... Ya le dije que las Bestias Xuanwen no son criaturas dóciles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Oh, Hung Fan, ¡qué casualidad! ¿Qué hace aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500512,
					"content": "*Suspira*... Por favor, ¿puede parar de hablar de casos criminales? ¿Y si los niños se lo toman en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "¿Se conocen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Sí, cuando llegué aquí, fue esta señorita la que me ayudó a llevar el equipaje. También le pregunté muchas cosas sobre leyendas populares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500515,
					"content": "Le dije muchas veces que las Bestias Xuanwen no aparecen en la aldea, pero la Srta. Guijarro no me cree y dice que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Aunque no aparezcan, siempre hay otras formas de obtener inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500517,
					"content": "Y dale... Srta. Guijarro, no tengo muchas esperanzas de poder disuadirla, pero aun así, debo pedirle que no abandone la aldea y vaya corriendo de un lado a otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Las Bestias Xuanwen son unas bestias salvajes que existen de verdad. Si se la encuentra con una... *Suspira*. Bueno, se lo pido por favor, no se vaya sola de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan se va desalentada. Parece más resignada que el gato de antes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Bueno, ya que Hung Fan ha dicho eso, tendremos que obtener información en otro lugar. Vamos, síganme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500506,
					"content": "Lo siento, nos equivocamos de gato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Gato confuso"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Srta. Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "¿Qué les parece? Esto es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500602,
					"content": "Una gran tetera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "¡Exacto! Es una... gran tetera, algo peculiar, ¡sí! Además, está justo en el centro de la aldea. Seguro que tiene algún significado en especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500604,
					"content": "Humm... ¿Creen que las Bestias Xuanwen podrían vivir dentro de esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500605,
					"content": "A este paso vas a escribir una historia de fantasía.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "A este paso, van a acabar apareciendo Adeptus en tu novela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "No sé si encajaría, ¿eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "... ¡Eso es! ¡Esas son las reacciones que quiero! ¿Creen que si escribiera una novela policiaca centrada en una Bestia Xuanwen, sería demasiado absurda como para que la tomen en serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500610,
					"content": "¿Eh? Sí, un poco. De todos modos, ¿las novelas criminales pueden desarrollar tramas con una temática como esa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Espera, ¿acaso...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Sí, {NICKNAME}, eres muy inteligente. Haces honor a tu fama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500613,
					"content": "Exacto, lo que quiero escribir es una historia criminal que sea absurda e imposible. Las reacciones de Hung Fan y de ustedes son muy interesantes. Las incluiré en la novela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500614,
					"content": "En cuanto a la Bestia Xuanwen... será la culpable en mi novela. Una criatura legendaria que se dice que devora a los malhechores de la aldea, pero que nadie la ha visto realmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500615,
					"content": "En un día de fiesta, encontraron a alguien de la aldea asesinado en el campo, aparentemente atacado por una bestia salvaje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500616,
					"content": "Pero al día siguiente, en la celebración, el protagonista volvió a encontrarse con la persona que debería haber muerto, y después apareció otra víctima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500617,
					"content": "¿Y luego, y luego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "No lo he pensado aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500619,
					"content": "... Me voy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "¡Espera! Después de que lo termine de escribir, seguro que les enviaré dos copias. Pero ahora, ¡necesito que me hagan un gran favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500621,
					"content": "¿No decía Hung Fan que bajo ninguna circunstancia debía salir de la aldea sola? Pienso obedecerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500622,
					"content": "Pero ahora que ustedes están aquí, ya no estoy sola, así que podré dar una vuelta fuera de la aldea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500623,
					"content": "¡Y por supuesto que no iré demasiado lejos! ¿Podrían hacerme este favor y acompañarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500624,
					"content": "Está bien... Solo porque quiero saber el final de la novela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Entonces, ¡vamos en esa dirección! Hay un lugar que quiero visitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500625,
					"content": "El pago deberá efectuarse según las normas establecidas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Por supuesto, pueden confiar en mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500606,
					"content": "Me parece que está dejando de ser una novela policiaca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
		{
			"id": 7005008,
			"completionStepIds": [
				7005008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
