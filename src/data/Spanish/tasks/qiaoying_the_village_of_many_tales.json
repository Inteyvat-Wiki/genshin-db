				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Srta. Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2304.876,
							292.814,
							1561.417
						],
						"pointId": 311400064
					}
				]
			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "¡Srta. Guijarro! ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "... No, no, encontrar las pistas de esta manera es demasiado abrupto. Además, ¿cómo puede alguien que ha estado atado aquí toda la noche pensar con claridad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501203,
					"content": "Vaya... Está totalmente inmersa en sus pensamientos. ¿Habrá encontrado algo que la inspire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Más bien se ha quedado estancada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#{NICKNAME}, Paimon, llegaron en el momento justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501206,
					"content": "¿Podrían atarme a un tronco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501207,
					"content": "¿Eh? ¿Paimon escuchó mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Les pido que aten mis manos y luego me cuelguen de un árbol, con las manos levantadas. Humm... Si total, todos son de madera, así que no es que haya mucha diferencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501209,
					"content": "#No quiero convertirme en {F#la}{M#el} sospechos{F#a}{M#o} de tu novela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "No te preocupes, ya he redactado una carta de responsabilidad en la que asumo la responsabilidad de percance que pueda ocurrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501211,
					"content": "Ese no es el problema. ¿Por qué de repente quieres que te atemos? No has hecho nada malo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Pero el protagonista de mi novela, en este lugar, debe ser colgado con las manos levantadas por los aldeanos, pasar toda la noche al aire libre y esperar el juicio de la Bestia Xuanwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501213,
					"content": "Lo que pasa después es que el protagonista, que ya había previsto esta situación, utiliza algunos medios para sobrevivir, pasa la noche de manera segura y luego revela la verdad de todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501214,
					"content": "Pero no tengo idea de lo que se siente al estar atada toda una noche. Desde la manera de hablar y el modo de pensar, hasta la forma de actuar. ¡No tengo ni idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501215,
					"content": "Entonces, quiero que me aten y me dejen aquí toda la noche, así puedo experimentar ese sentimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501216,
					"content": "No, eso es demasiado peligroso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "... Humm. Podría haber otra forma, pero no puedo garantizar que funcione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501219,
					"content": "En vez de eso, yo... Puedo quedarme con las manos levantadas y quedarme aquí de pie toda la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501220,
					"content": "O mejor todavía, ¿qué tal si dejas de escribir esa novela? La gente nos malinterpretará por nuestras acciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Qué difícil es ser tu protagonista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "¡Por favor! Este es el paso más importante, mi novela está a punto de terminar. Si utilizamos este método, no tendrán que cometer ningún delito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501223,
					"content": "¡Ni que tuviéramos que hacerlo igualmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "¡No tenemos intención de hacerlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Eh... Bueno, no es tan complicado. Solo tienen que quedarse a mi lado para evitar que me encuentre en peligro por alguien o alguna bestia salvaje mientras reúno la información que necesito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501226,
					"content": "A ver... Considerando el ambiente que quiero crear en la novela, me parece que tendría que ir más arriba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501227,
					"content": "¿Qué? ¡Eh, espéranos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Suben a lo más alto del campo de té con la Srta. Guijarro.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Uf... H-hace un poco de frío... pero así es más inmersivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501230,
					"content": "¿De verdad vas a quedarte aquí toda la noche con las manos en alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Sí, ya lo he decidido. Para escribir una novela, a veces hay que hacer sacrificios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501232,
					"content": "Confío en ustedes para que velen por mí. Solo será una noche, solo una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501217,
					"content": "¿No hay otra forma más segura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
