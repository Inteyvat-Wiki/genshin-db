			"dialogs": [
				{
					"id": 700500801,
					"content": "¿Son linternas? Parecen peces. Qué interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500802,
					"content": "¿Estos tiradores son para levantar la linterna? Humm... Con esta estructura desmontable, y si el diseño es adecuado, se pueden agregar una o dos secciones sin que nadie lo note...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500803,
					"content": "El espacio de adentro es bastante grande, puede que quepa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500804,
					"content": "¡Para! ¡Guárdate esos pensamientos para ti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "¿Eh? Ah... jaja, lo siento. No puedo evitarlo cuando veo algo que me impresiona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500806,
					"content": "Humm... Sí, creo que las linternas darían un valor añadido a la novela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500807,
					"content": "#{NICKNAME}, ¿podrías tomar una imagen a este enorme pez linterna? Quiero tener algunas imágenes como referencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500808,
					"content": "Hora de sacar a relucir mis habilidades con el Daguerrotipo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "Entonces, lo dejo en tus manos... ¡Ah! Cuando tomes la imagen, asegúrate de capturar la linterna entera. ¡Es muy importante para mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500811,
					"content": "Diseñar una estratagema teniendo en cuenta las dimensiones suena bastante interesante. Humm, pero ¿cómo solucionamos el problema del peso?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700500809,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
		{
