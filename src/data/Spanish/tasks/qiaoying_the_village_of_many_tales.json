			"dialogs": [
				{
					"id": 700501501,
					"content": "... No creo que el personaje sea capaz de volver al pueblo solo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501502
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501502,
					"content": "¡Srta. Guijarro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501503,
					"content": "Ayudémosla a levantarse primero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "La ayudan a levantarse y a sentarse en el suelo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "Así que esto es lo que se siente... Es bastante incómodo, no solo estoy físicamente agotada, sino que además me cuesta pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501506,
					"content": "¿Misión cumplida, entonces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "Por supuesto, ha sido un gran éxito. Finalmente sé lo que se siente al estar colgada y atada toda una noche al aire libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501508
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501508,
					"content": "Debe ser muy fuerte tu protagonista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501509,
					"content": "Sí, también he pensado en cómo el protagonista espantará a la Bestia Xuanwen. Con este final, seguro que... seguro que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501510,
					"content": "¡Oh! ¿Qué se te ocurre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501511,
					"content": "... Será extraordinario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "Srta. Guijarro"
				},
				{
					"id": 700501512,
					"content": "La Srta. Guijarro vuelve a desmayarse en el suelo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501513
					]
				},
				{
					"id": 700501513,
					"content": "¡Ah! ¡Eh! Srta. Guijarro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501514,
					"content": "¡Pero cuéntalo antes de desmayarte!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501515
					]
				},
				{
					"id": 700501515,
					"content": "En fin, primero llevémosla a un médico... ¡Volvamos a la aldea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501516
