			"dialogs": [
				{
					"id": 760300301,
					"content": "Con esto ya es suficiente, ¿no? Hemos recogido un montón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300302,
					"content": "Volvamos ya, pues. No podemos dejar que ese dibujo se quede incompleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
					"content": "*Solloza*... *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "¡Ay, viene alguien! ¡Escondámonos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "*Solloza*, ¿dónde estoy? Mamá, quiero volver a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "Parece que es una Descendiente Lunaescarcha. ¿Se habrá perdido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Voy a ayudarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "#¿Estás segur{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300309,
					"content": "¿Eh? Claro, ¡no podemos ignorar a una pobre niña perdida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "Recuerdo que los Descendientes Lunaescarcha son bastante cautelosos con los forasteros. Entre lo tarde que es y que no tienes astas en la cabeza, podrías conseguir el efecto contrario y asustarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300311,
					"content": "B-bueno, es posible, ¡pero tampoco podemos abandonarla a su suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300312,
					"content": "Humm, vengan conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300313,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
