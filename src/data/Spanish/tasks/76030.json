			"dialogs": [
				{
					"id": 760300501,
					"content": "*Solloza*... ¿Eh? ¿Qué es esto?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "Qué bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "Listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300504,
					"content": "Oooh, ese camino de piedras la llevará de vuelta al Enclave Lunaescarcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Colombina no quiere que la vean como una diosa, pero no deja de ayudar a la gente en apuros.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Ah, pero entonces, el dibujo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "Da igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300508,
					"content": "Ya completaremos la parte que falta más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300509,
					"content": "Me gusta ver a la gente encontrar el camino de vuelta a casa, de vuelta a su hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
