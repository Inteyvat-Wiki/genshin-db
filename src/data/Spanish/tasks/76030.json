			"dialogs": [
				{
					"id": 760300101,
					"content": "Humm, el entorno parece distinto... Colombina, ¿estás decorando el campo de flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Yo no, ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300103,
					"content": "Ellas... ¿las kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Al absorber kuuvahki, estas rocas emiten un tenue brillo que les encanta a las kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300105,
					"content": "Y... ¿las ponen en el suelo para jugar con ellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Vengan aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300107,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "¡Ooooh! Al verlo desde un lugar alto, ¡parece un dibujo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Pero falta una parte, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Sí, no había suficientes piedras. Iré a recoger algunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300111,
					"content": "¿Vas a salir para hacer eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Conozco un buen lugar bañado por la luz de la luna en el que hay muchas piedras como estas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300113,
					"content": "¿Quieres que te acompañemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760300115,
					"content": "#Perfecto. Recojamos unas cuantas, que a nosotr{F#a}{M#o}s también nos gustaría ver cómo es el dibujo completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
