			"dialogs": [
				{
					"id": 761820101,
					"content": "¿Es aquí donde vivías antes? Qué bonito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761820102,
					"content": "Antes estaba aún más bonito. Se me da bastante bien la jardinería, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820103,
					"content": "Jaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761820104,
					"content": "¿Y ahora de qué te ríes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820105,
					"content": "Te estaba imaginando agachada, cuidando las flores. Es una imagen adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761820106,
					"content": "¿Puedo echar un vistazo por dentro más tarde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761820107,
					"content": "Claro. Ya limpié y sacudí el polvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820108,
					"content": "¿Qué vas a hacer con este lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761820109,
					"content": "Humm... Creo que prefiero dejarlo así por ahora. Ya volveré para ponerlo en orden cuando tenga tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820110,
					"content": "Si estás ocupada, puedo echarte una mano con eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761820111,
					"content": "Me transmite la misma sensación que me daba tu antigua habitación. Es reconfortante... Un lugar feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761820112,
					"content": "Ja... Haz lo que quieras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
