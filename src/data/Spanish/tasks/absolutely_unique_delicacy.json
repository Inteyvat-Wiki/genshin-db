				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "¿Necesitan algo? Oh... ¿La señorita Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "Pérdida de apetito, un sabor extraño en la boca... ¿de verdad se necesita una comida especial para solucionar ese problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Así que ese es su problema... Vaya, es bastante complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "En mi opinión, no tiene que ser un plato particularmente caro. Siempre que el sabor y la condimentación sean únicos y tenga un intenso sabor, será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "¡Sugiero guoba de Jueyun! Tiene una textura crujiente única y un intenso sabor picante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "La primera vez que probé guoba de Jueyun fue hace más de diez años en la Aldea Chingtsé. Aún recuerdo aquel momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Creo que, sea cual sea el problema, la guoba de Jueyun lo resolverá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
		},
		{
			"id": 2202503,
			"completionStepIds": [
				2202503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
