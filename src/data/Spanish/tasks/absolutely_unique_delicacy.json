			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chiuyue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250301,
					"content": "¿Querían algo? ¿Eh? ¿La señorita Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Chiuyue"
				},
				{
					"id": 220250307,
					"content": "Un sabor extraño en la boca, pérdida de apetito, ¿de verdad no quiere comer nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Chiuyue"
				},
				{
					"id": 220250302,
					"content": "¿De verdad comió algo extraño? No se estarán equivocando, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Chiuyue"
				},
				{
					"id": 220250303,
					"content": "Me da la sensación de que su estómago no ha digerido bien los alimentos. Humm... déjenme pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Chiuyue"
				},
				{
					"id": 220250304,
					"content": "Bueno, ya que no hay forma de saberlo con seguridad, solo hay un plato que podría recomendar: ¡sopa de brotes de bambú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Chiuyue"
				},
				{
					"id": 220250305,
					"content": "El plato es salado, la carne es tierna y el sabor es fresco y delicioso. Y lo más importante es que la sopa ayuda a hacer la digestión. ¡Mmm! Ojalá pudiera probar un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Chiuyue"
				},
				{
					"id": 220250306,
					"content": "Créanme, ¡lo que Tang Wen necesita es sopa de brotes de bambú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chiuyue"
				}
			]
		},
		{
			"id": 2202504,
			"completionStepIds": [
				2202504
