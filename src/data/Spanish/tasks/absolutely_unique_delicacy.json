			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ah... Tengo tanta hambre... No me siento bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "¿Qué ha ocurrido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "N-no sé por qué, pero... me siento bastante mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "Creo que es porque anoche me llevé a casa el plato que me diste para comerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Aunque el plato era bastante... innovador, al menos me llenó el estómago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Quería dormir bien toda la noche para rendir hoy en el trabajo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "Cada vez que estaba a punto de dormirme, el sabor de ese plato brotaba de mi estómago y me despertaba al instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "No dejó de ocurrir durante toda la noche, así que estuve medio despierta y medio dormida hasta que salió el sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "No pasa nada si solo es falta de sueño. He tenido que hacer horas extra en el pasado, así que no sería la primera vez que duermo poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "La cuestión es que pensé que, después de levantarme y comer algo, me sentiría mejor, pero en cuanto comí algo, sentí que el sabor del plato de ayer seguía en mi boca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "¿Tan delicioso estaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "*Suspira*, creo que... solo un plato con un sabor único podría eliminar ese otro sabor tan interesante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "¿Un plato con un sabor único? ¿Por qué no vamos a preguntar si alguien conoce un plato así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "Así podremos hacer uno para la señorita Tang Wen... ¡Tal vez eso resuelva su problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "¿En serio? Genial, ¡muchas gracias! S-si les viene bien, vayan a Ritou a preguntar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Recuerdo a... Li Xiao, un comerciante de Ritou que sabe mucho de gastronomía, y a Chiuyue, de la Compañía de Comercio Chuyu, ¡a ella también se la puede considerar casi una gourmet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
