			"dialogs": [
				{
					"id": 150400601,
					"content": "#Jaja, ¡ha sido muy divertido! Gracias, querid{F#a}{M#o} oponente. ¡Lo hemos pasado muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400602,
					"content": "Han sido unos oponentes formidables.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "¡Buen trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400607,
					"content": "#¡Felicidades por la victoria, {NICKNAME}! ¡Y muchas gracias también a nuestro magnánimo salvador y al Asha por su brillante trabajo en equipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400608,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400609,
					"content": "Cuando escuché tu interpretación de las palabras del Asha antes, no podía creerlo. Pero después de este encuentro, tengo que decir que estoy realmente impresionada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400610,
					"content": "¡Yo igual! Estaba en vilo por ustedes dos, ¡igual que si estuviera viendo la final del Peregrinaje del Retorno del Fuego Sagrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400611,
					"content": "Te entiendo. Cuando el combate alcanzó su punto álgido, apenas pude resistir el impulso de volar y disparar unas cuantas balas yo misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400612,
					"content": "Espera, ¿tus balas también sirven para pintar cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400613,
					"content": "Por supuesto, pero no sabría decir de qué color. Aunque estoy bastante segura de que el Asha dejaría de ser “volador” cuando acabara con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400614,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400615,
					"content": "¡Jaja! De todos modos, ahora estamos a un paso de completar “El Asha volador”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400616,
					"content": "¡Que nuestros dos héroes iluminen los pinceles del Asha volador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400617,
					"content": "(Reproducir la cronología del lugar emblemático del Asha)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Impresionante, ¿verdad? ¡Les puedo recomendar un lugar con vistas espectaculares que es perfecto para tomar imágenes grupales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400603,
					"content": "El Asha y tú hacen un gran equipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "Debería haberle pedido ayuda a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "Oh, ¿así que ahora te acuerdas de Paimon? ¡Un poco tarde para eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
