			},
			"dialogs": [
				{
					"id": 150400301,
					"content": "¡Guau! ¡Qué pasada! ¡Parece que los Campos Florespuma por fin van a hacer honor a su nombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400302,
					"content": "¡Buen trabajo a todos! Ahora solo nos queda avisar a esa empleada, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400303,
					"content": "Por favor, esperen. *Jadea*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400304,
					"content": "¡Hablando de la reina del resort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "¡Ey, no hay prisa! Tómate tu tiempo y recupera el aliento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "*Suspira*... De acuerdo. Saludos, soy la empleada a cargo de la atracción principal de los Acantilados Irisados: “El Asha volador”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "Hace un momento, desde lo alto, vi cómo el campo se convertía en un mar de flores con unos colores tan artísticos y deslumbrantes... ¡que casi se me caen los prismáticos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400308,
					"content": "¡Ustedes son los salvadores de los Acantilados Irisados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400310,
					"content": "No fue nada, jeje. Además, ¡fueron esos dos los que hicieron la mayor parte del trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "Amables salvadores, ¿les gustaría participar en nuestro desafío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "O mejor dicho... ¿Nos harían el honor de dar color también a nuestros lugares más emblemáticos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Eso suena genial... ¿Pero estás segura de que podemos hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "¡Por supuesto! De hecho, ¡me encantaría que aceptaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "Le han hecho un gran favor a mi colega. Es justo que les dé las gracias en su nombre, así que pensé que esta experiencia sería aún más especial que una recompensa económica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Bueeeno, si le preguntas a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "¡Lo que quiere decir es que estamos encantados de ayudar! Jaja... Bueno, ¿y cómo hacemos para llegar allí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400318,
					"content": "Vengan conmigo, por favor. Subiremos en globo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				}
			]
		},
