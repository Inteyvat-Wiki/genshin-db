			"dialogs": [
				{
					"id": 150401001,
					"content": "¡Muy bien! “El Asha volador” se ve bien, y todo el mundo está en el encuadre. ¡Chasca, acércate un poco más al centro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401002
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401002,
					"content": "¡Qué emoción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401003
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150401003,
					"content": "¿Están todos listos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401004
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401004,
					"content": "¡No te olvides de venir tú también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150401005,
					"content": "¡No te preocupes! Está todo planeado. Muy bien, ¡allá vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401006
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401006,
					"content": "Tres, dos, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401007
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401007,
					"content": "¡Asha!",
					"roleType": "TALK_ROLE_NPC",
