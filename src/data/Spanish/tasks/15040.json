			"dialogs": [
				{
					"id": 150400701,
					"content": "Ya hemos llegado. Este es, damas y caballeros, “El Asha volador”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400702
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400702,
					"content": "¡Guau, es genial! No esperaba que fuera tan grande de cerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400703
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400703,
					"content": "Cuando esté pintado, podremos verlo a kilómetros de distancia, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400704,
					"content": "Por supuesto, siempre y cuando el terreno sea plano y no haya montañas obstruyendo la vista, ¡podrás verlo tanto desde la piscina del tejado de la Colina Huha como desde los fiordos de la Isla Tete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400705,
					"content": "¡Estoy orgullosa de ustedes! ¡Que gane el mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400706,
					"content": "Aaah, ¡ya me estoy emocionando yo también! ¿Qué color debería usar? ¿Mi color de la suerte? O tal vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400707
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400707,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400708
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400708,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400709
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400709,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400710,
					"content": "Guau, sí que tenía cosas que decir sobre esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400711,
					"content": "Chasca, ¿lo has entendido todo? ¿Te importaría traducirnos de nuevo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400712,
					"content": "Humm... Es mucha información. Tendré que hacer números para ver cuántas posibilidades hay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400713,
					"content": "#No pasa nada, ¡creo que lo tengo! El Asha quiere formar equipo conmigo y competir contra {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400714,
					"content": "Le gusta ayudar a la gente colaborando con sus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400715,
					"content": "Pero un desafío competitivo transforma una actividad ordinaria en una aventura emocionante, y eso es lo que más disfruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400716,
					"content": "¡¿E-en serio dijo todo eso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400717,
					"content": "Jaja, ¡más o menos! Probablemente con un toque de mi propia interpretación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400718,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400719,
					"content": "Por su reacción, parece que has dado en el clavo. El vínculo entre ustedes dos se está haciendo cada vez más fuerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400720,
					"content": "#Muy bien, Asha. Me gusta tu idea, pero no debemos presionar a {NICKNAME} para que haga algo que no quiere, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400721,
					"content": "¡También debemos respetar los sentimientos y opiniones de nuestros amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400722,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400723,
					"content": "Una oportunidad para desafiar al líder: justo lo que estaba esperando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "“Acepto el desafío”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400725,
					"content": "Jaja... Contigo mirándome así, no podía decir eso con la cara seria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400732,
					"content": "Muy bien, si ambos equipos están listos, síganme. Yo seré quien arbitrará el encuentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400726,
					"content": "Mientras el Asha y tú sean felices, es lo único que importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#Oye, ¡no podemos ser los únicos que nos divirtamos! Quiero que tú también lo disfrutes, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400728,
					"content": "¡Vamos, hagámoslo! Sin presión, ¡tan solo disfrútalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400729,
					"content": "#Aunque fuera yo sol{F#a}{M#o} contra todos, ganaría igualmente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "¡Ya veo que no te falta confianza! Bien, ¡yo también lo daré todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400731,
					"content": "¡Oye! ¡Paimon siempre ha estado en tu equipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Paimon"
				}
			]
		},
