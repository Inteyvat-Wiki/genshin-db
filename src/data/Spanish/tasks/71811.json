					"speakerTitle": "Abuela Shan"
				},
				{
					"id": 718110502,
					"content": "Acerca del Daguerrotipo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "¿El Daguerrotipo?... Ah, sí. Hace unos días fui al Gremio de Comerciantes de Feiyun para pedirles que vinieran a capturar una imagen para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Abuela Shan"
				},
				{
					"id": 718110504,
					"content": "¿Solo viniste para entregarme mi imagen? Pues, muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Shan"
				}
			]
		},
