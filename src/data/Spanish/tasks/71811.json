						718110603
					]
				},
				{
					"id": 718110603,
					"content": "Ah, cierto, cierto. Hace unos días fui al Gremio de Comerciantes de Feiyun para pedirles que vinieran a capturar una imagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110604
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 718110604,
					"content": "¿Qué? ¿La imagen ya está lista? Déjame echarle un vistazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110605
					],
					"speakerTitle": "Maestro del Té Liu Su"
				},
				{
					"id": 718110605,
					"content": "Oh, nada mal. Gracias por hacer el viaje hasta aquí.",
