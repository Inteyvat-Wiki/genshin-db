			"dialogs": [
				{
					"id": 718110412,
					"content": "Acerca del Daguerrotipo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "¿Entregaste las imágenes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "Gracias, gracias. Disculpa la molestia, pero aquí estamos con trabajo hasta el cuello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "Casi lo olvido. Por favor, acepta este Daguerrotipo en agradecimiento por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "No puedo aceptarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "No te preocupes. Has sido de gran ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "Tampoco es que sea excesivamente caro. Es solo una muestra que nos dieron nuestros socios de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "Hay algunas diferencias entre este y el modelo oficial... pero cumple con todas las funciones básicas. Seguro que será suficiente para lo que necesites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "Y si te termina por gustar, puedes ayudarnos con algo de publicidad aquí y allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "*Ejem*... De todos modos, ¡gracias por tu ayuda! Llévate este Daguerrotipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "Debe ser muy caro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
