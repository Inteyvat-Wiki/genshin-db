			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "¡Mira, es el <color=#00E1FFFF>Escudo de la Tenacidad Radiante</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "¿De verdad esperas que te creamos? ¡No es más que una tabla de madera común y corriente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "Es un trozo de madera podrida con un mango atado a él... ¿Quién en su sano juicio creería que es un escudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "Y tiene manchas de vino... Parece que alguien lo arrancó de un barril.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "Ya, ya, pero mi intuición de bardo me dice que este es el Escudo de la Tenacidad Radiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "Este escudo es igual que un guerrero orgulloso de sus cicatrices de guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Si un escudo está en muy buen estado, quiere decir que no ha participado en muchas batallas. ¿Pero no creen que, si está desgastado, es porque ha luchado en innumerables guerras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Aunque esté completamente exhausto, un buen guerrero siempre lucha hasta el final; hasta su última gota de sangre. ¿No creen que una fuerza de voluntad como esa es realmente honorable?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "¡Venti tiene razón!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "Algo de razón tienes... Es raro que un escudo esté impecable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "Está bien... Si se lo preguntamos, tal vez nos dará el Escudo de la Tenacidad Radiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "*Ejem*, hola, Sr. Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120616,
					"content": "#Eh... {NICKNAME}, mejor inténtalo tú. ¿No has aprendido nada de escucharlos hablar? Bueno, si no, también puedes intentar gesticulando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "Te cambio el escudo por unos cuantos Moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120623,
					"content": "¡Oh, no! Parece que <color=#00E1FFFF>no le gustó</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Toma. Esta flor dulce es para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120628,
					"content": "Parece que <color=#00E1FFFF>no está de mal humor</color>. Tal vez podamos seguir negociando con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti, cantar. Tú, darme escudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "¿Eh? De acuerdo, entonces tocaré un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120634,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120635
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120635,
