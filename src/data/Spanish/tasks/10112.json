					"speakerTitle": "Paimon"
				},
				{
					"id": 101120625,
					"content": "Toma esta máscara Hilichurl que he recogido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120629,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120630
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120630,
					"content": "¡Oh, no! Parece que <color=#00E1FFFF>no le gustó</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120626,
					"content": "¡Kucha pupu gusha ye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "¿Serías tan amable de darme ese escudo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "¡Vin plata dada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120621,
					"content": "Parece que <color=#00E1FFFF>no está de mal humor</color>. Tal vez podamos seguir negociando con él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120610,
					"content": "Yo también creo que este es el escudo que buscamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "Hoy tu elocuencia está al máximo nivel, ¿eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				}
			]
		},
