				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "Los oficiales de la Academia colocaron este tablón de anuncios para dar a conocer los asuntos más relevantes de la Ciudad de Sumeru. En caso de tener alguna duda sobre cualquier asunto, también pueden publicar sus preguntas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "“¿Ya te enteraste? Dicen que los guardas forestales encontraron un magnífico palacio que apareció de la nada en el norte del bosque”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940202,
					"content": "“Pero al parecer a todos los que fueron ahí les acabaron estafando hasta el último Mora. Lo único que tenían cuando los guardas forestales los encontraron era su ropa interior”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940203,
					"content": "“Y además se negaban a responder cuando les preguntaban qué había pasado, solo lloraban y lloraban. Suena bastante aterrador”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940204,
					"content": "“Es mejor no andar merodeando por el bosque”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "Ahora todos los avisos tanto de Sumeru como del exterior se emiten vía Akasha. Por tanto, es importante que todos lleven siempre puesto su conmutador Akasha para no perderse ninguna noticia importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940302,
					"content": "Este tablón de anuncios se mantendrá temporalmente para comodidad de forasteros, comerciantes, niños y personas mayores. Podría ser retirado en cualquier momento, así que, por favor, no dependan demasiado de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "Ya ha comenzado la distribución anual de la Bendición de Anahita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940402,
					"content": "En general, se seguirá distribuyendo según la política y requisitos del año pasado. Para más información, por favor, consulte vía Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940403,
					"content": "En caso de cambio, contacte con anticipación con su oficial de la Academia más cercano para enviar una solicitud de modificación a la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "Los casos de contagios de eleazar en la ciudad han ido en aumento últimamente. Diríjase al bimaristán para recibir el tratamiento pertinente si nota síntomas como piel entumecida, falta de fuerza en las extremidades, o escamas duras y oscuras en la piel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940502,
					"content": "Si no se trata dentro del tiempo recomendado y permite que su condición empeore, podrá acarrear graves consecuencias, como la parálisis. Le recomendamos encarecidamente que considere con seriedad esta advertencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
							"2"
						],
						"stepId": 7319406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Recordatorio especial: Los Eremitas son la única organización de mercenarios autorizada en Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940602,
					"content": "No confíe en otras personas a la ligera y evite ser estafado por impostores de origen incierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940603,
					"content": "Contacte con Ruj Shah, el abanderado del Regimiento de Los Treinta, si requiere del servicio de un escolta, guarda o tiene algún otro tipo de requerimiento. También puede publicar un encargo para pedirle ayuda a Efendi, el intermediario con la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319407",
							"2"
						],
						"stepId": 7319407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "El bimaristán es un centro médico a cargo de la Facultad Amurta que ofrece atención médica gratuita a todos los residentes en Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940702,
					"content": "Los médicos del bimaristán tienen licencia oficial de la Escuela de Biología, y los diagnósticos y planes de tratamiento son revisados múltiples veces vía Akasha. El bimaristán brinda sin duda alguna el servicio médico más profesional y más completo para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940703,
					"content": "No confíe en médicos desconocidos y sin licencia, evite perjudicar su salud y su bolsillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319408",
