			},
			"dialogs": [
				{
					"id": 731940901,
					"content": "Se busca: Kasim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940902,
					"content": "Se hace llamar a sí mismo un gran bandido y trotamundos de renombre, pero en realidad no es más que un impostor que ni siquiera figura en la lista de los Eremitas más poderosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940903,
					"content": "Muchos de los casos de estafa reportados recientemente están vinculados con esta persona. Por su seguridad, manténgase alerta y evite caer en sus artimañas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
