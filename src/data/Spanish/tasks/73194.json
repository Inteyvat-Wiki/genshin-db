			"dialogs": [
				{
					"id": 731941001,
					"content": "Se busca: Mustah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731941002,
					"content": "Este hombre se disfraza de oficial de la Academia para robar y extorsionar a las caravanas en la zona del puerto y del bazar. La Ciudadela Regzar ya se encuentra investigando el caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731941003,
					"content": "Hay reportes de que este individuo se oculta en la selva. Pedimos su cooperación para informar inmediatamente a las autoridades en caso de tener información sobre su paradero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
