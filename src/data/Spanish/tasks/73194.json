			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941201,
					"content": "“Extremen las precauciones si están planeando un viaje a la selva. El otro día mi tutor me envió a recolectar algunas hierbas medicinales y casi pierdo la vida por culpa de un caracal patilludo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731941202,
					"content": "“Menos mal que una guardabosques que andaba cerca me rescató. Dijo que ella solo era una guardabosques en prácticas, pero parecía tener mucha experiencia. Y lo más importante, incluso me dio comida muy rica para aliviarme el susto”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731941203,
					"content": "“Dicen que es la aprendiz de Tignari. Supongo que es cierto, de tal palo tal astilla”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
