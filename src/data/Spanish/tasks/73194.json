			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "No lleve consigo grandes cantidades de Moras en áreas concurridas para evitar ser robado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940802,
					"content": "En caso de ser víctima de un robo, no busque ayuda de Los Eremitas que patrullan la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731940803,
					"content": "Es muy probable que ellos estén detrás del robo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
			"id": 7319409,
			"completionStepIds": [
				7319409
