			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Dado que los oficiales de la Academia dejarán de publicar anuncios en este tablón en breve, la Taberna Lambad lo aprovechará para publicar los suyos. No duden en dejar un mensaje aquí sobre cualquier asunto que deseen compartir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731941102,
					"content": "“Jefe, ¿ya llegaron las diez cajas de vino que pedí? Ayer vine a la hora acordada y todavía no habían llegado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731941103,
					"content": "“¡No puede ser! Pero si vino un tipo rubio afirmando ser tu compañero de piso y se llevó todo. Si mal no recuerdo, los dos vinieron juntos el otro día. ¿No te habrás equivocado?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Tablón de anuncios"
				},
				{
					"id": 731941104,
					"content": "“... Oh, ya entiendo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tablón de anuncios"
				}
			]
		},
		{
