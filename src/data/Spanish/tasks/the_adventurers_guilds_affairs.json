				},
				{
					"id": 718030502,
					"content": "Este gato es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030503,
					"content": "Creo que es Huihui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "Un momento, déjame comparar su aspecto con lo que dice en la lista de características del encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030505,
					"content": "A ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030506,
					"content": "La mayoría de características concuerdan... Parece que, efectivamente, es el gato que se describe en el encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030508,
					"content": "La persona que hizo el encargo se pondrá muy contenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "*Suspira*, después de dar tantas vueltas, al final volvió a tratarse de un gato perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030510,
					"content": "No sé qué decir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030511,
					"content": "Informaré de estos encargos a las personas que los publicaron. Muchas gracias. Por favor, acepta esto como recompensa por hacernos este favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030512,
					"content": "Humm, parece que quien publicó el encargo del gato se ha mudado. Nos llevará algún tiempo contactar con ambos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030513,
					"content": "Yo cuidaré de este minino hasta que llegue su dueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "Lan"
				},
