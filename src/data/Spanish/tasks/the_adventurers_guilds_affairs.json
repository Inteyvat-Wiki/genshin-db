					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030402,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "Gracias. Haber completado este encargo debería bastar para demostrar la pericia del Gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030404,
					"content": "Sí, y también encontré a Huihui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "Muchas graci... ¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
