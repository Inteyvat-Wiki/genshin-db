			"dialogs": [
				{
					"id": 718030301,
					"content": "Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Huihui"
				},
				{
					"id": 718030302,
					"content": "¿Eh? ¿Qué hace un gato por aquí? ¿El sonido de antes lo hizo él?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Miau... miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Huihui"
				},
				{
					"id": 718030304,
					"content": "Un gato gris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Un gato gris perdido en el campo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "¡Ah, cierto! Lan nos habló de un encargo para encontrar un gato. Entonces, ¿este es el gato perdido? Creo que se llamaba Huihui o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "¿Quién habría imaginado que lo encontraríamos aquí? ¿Acaso ha estado por aquí todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Como el Lawachurl Acorazado estaba en este sitio, nadie se atrevió a acercarse... Y él tampoco se atrevió a salir, así que se escondió aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "Es una suerte que hayamos venido. Si no, quién sabe hasta cuándo tendría que seguir escondido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Miau... ¡Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Huihui"
				},
				{
					"id": 718030314,
					"content": "Miau... miau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Eh... Paimon no cree que te entienda aunque le hables así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Llevémoslo a Lan para que ella se lo devuelva a la persona que hizo el encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Miau... ¡Miau! ¡Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Huihui"
				},
				{
					"id": 718030320,
					"content": "Miau... ¡Miau! ¡Miau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "¡No te entenderá por mucho que lo imites! Vamos, nos lo llevaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "Parece que está de acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "¿Pero cómo le entiendes? Bueno, no importa. Llevémoslo a Lan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Deberíamos llevárselo a Lan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Sí, Paimon está de acuerdo. Llevémoslo a Lan para que ella se lo devuelva a la persona que hizo el encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030308,
					"content": "Tal vez sea Huihui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "Un gato gris perdido en el campo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030310,
					"content": "¡Ah, cierto! Debe ser el encargo del que nos habló Lan. ¿Quién habría imaginado que lo encontraríamos aquí? ¿Acaso ha estado por aquí todo este tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				}
			]
		},
