					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "#Vaya, vaya, eres tú, querid{F#a}{M#o}. ¿Acaso te enteraste de mi itinerario y viniste especialmente a verme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "¿Acabas de visitar a la Shogun? Parece que acabas de tomar algunos dulces...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Jeje, qué buen olfato tienes. Tan solo le llevé algunos dulces a cierta amiga que no sale mucho de casa, junto con las novelas ligeras más populares de hoy en día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "¿Ei también ha empezado a seguir las últimas novedades?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "Según ella, quiere saber cómo han cambiado los gustos y la forma de entretenerse del pueblo de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "Hace nada estuvimos discutiendo sobre eso. Al principio, solo analizaba seriamente las preferencias de los lectores reflejadas en el contenido de la historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "... Pero llegó un momento en el que me empezó a preguntar: “Entonces, ¿qué pasó con ese personaje al final?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "Jeje, parece que incluso Ei no puede resistirse a las buenas historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "Esa expresión hay que recordarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "¿Oh? ¿Así que esta era tu verdadera intención?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "Ya veo. Seguramente que me extrañaste tanto durante tus viajes que quisiste tomarme algunas imágenes como recuerdo, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Está bien, solo porque eres tú. Asegúrate de elegir bien los ángulos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "Me ha encantado la cara que acabas de poner. Necesito guardarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "¿Has ido a ver a la Shogun? Puedo oler algo dulce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
}