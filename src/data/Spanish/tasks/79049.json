			"dialogs": [
				{
					"id": 790490101,
					"content": "¿Por qué alguien escondería un diario en un rincón así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790490102,
					"content": "¡Resulta que la enorme piedra que hay ahí fuera es un lienzo de Idía para el artista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790490103,
					"content": "Parece que encontró paisajes que le gustaban en el Espejismo Veluriyam y que se hizo amigo de las Gotitas. ¡Todo eso le acabó sirviendo de inspiración!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790490104,
					"content": "Qué encuentro tan afortunado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "Ay, pues Paimon ha escuchado que hay gente que pierde la cabeza después de sufrir un revés. Al parecer, siguen intentándolo hasta que se vuelven locos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Leer"
				},
				{
					"id": 790490107,
					"content": "Menos mal que Idía le dio las herramientas y que las Gotitas estuvieron ahí para hacerle compañía. ¡Si no se habría vuelto un chiflado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leer"
				},
				{
					"id": 790490105,
					"content": "Mejor que obsesionarse con practicar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				}
			]
