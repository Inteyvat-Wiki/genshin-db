			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gran Maestre Hanakado",
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727310201,
					"content": "¡Jajajajajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310202,
					"content": "¡Asombroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310203,
					"content": "¡Jajajajajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310204,
					"content": "¡Formidable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310205,
					"content": "Incluso aunque tu estilo de combate sea completamente distinto al mío, sí que me identifico con la pasión que le transmites a tu escaradiablo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310206,
					"content": "Estoy convencido de que muy pronto te convertirás en todo un campeón de escaradiablos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310207,
					"content": "¡Tú tampoco lo haces mal, enano! Te las has arreglado para ganar 570 de los 1141 combates que hemos luchado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310208,
					"content": "¡De todos los maratones de combates de escaradiablos en los que he participado, este ha sido sin duda el más largo! ¡No está mal, jajaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310209,
					"content": "En realidad han sido 571 victorias. Si a eso le añades que tú luchas en casa, soy claramente el mejor luchador de escaradiablos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310210,
					"content": "¡Aaarg! ¿Por qué tienes que ser siempre tan molesto? Yo nunca me equivocaría, las matemáticas son mi punto fuerte. ¡Mamoru está de testigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310211,
					"content": "¿Tengo o no tengo razón, Mamoru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310212,
					"content": "Jefe... De verdad que no lo aguanto más. ¿Puedo echarme ya una siestecita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 727310213,
					"content": "¡No puede ser! ¿Llevan con esto todo este rato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310214,
					"content": "¿Es que no necesitan descansar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310215,
					"content": "La arena debe estar a punto de derrumbarse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "¡Bien! Te concederé un último combate porque soy una persona generosa. ¡Esta vez te derrotaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310218,
					"content": "Y para que luego no te quejes, podemos ir adonde tú elijas a combatir. ¡Así te demostraré que soy el mejor luchador independientemente de la arena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310219,
					"content": "Trato hecho. Sígueme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310220,
					"content": "¿Eh? ¡Colega, minicalavanda flotante, a buenas horas llegan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310221,
					"content": "¿Cómo es que vuelvo a ser la minicalavanda flotante? ¿Solo piensas darme motes buenos cuando te esté ayudando a luchar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310222,
					"content": "¡Céntrate, calavanda! Aquí tienen los dos cupones para ramen gratis. ¡Se los han ganado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310223,
					"content": "¿Cupones? ¡Ah, claro! ¡Nos los prometiste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310224,
					"content": "¡Buen toreritto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310225,
					"content": "¡Esto hay que celebrarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "¡Ni hablar del peluquín! Esto es solo el calentamiento, ¡el verdadero Sublime y Glorioso Gran Torneo de Escaradiablos de Arataki aún está por empezar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310228,
					"content": "Ni siquiera hemos tenido público. ¡No puede acabar así sin más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310229,
					"content": "Aunque la buena noticia es que el Gran Maestre Hanakado por fin se ha tragado su orgullo ¡y ha admitido que soy el mejor luchador de escaradiablos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310230,
					"content": "Aunque esto no acaba aquí. Pienso derrotarle en su propia arena, ¡así demostraré de una vez por todas que soy el ónico e inimitable luchador de escaradiablos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310231,
					"content": "¡Y cuando le gane, tendrá que obedecer mis órdenes y ayudar a organizar el mejor Sublime y Glorioso Gran Torneo de Escaradiablos de Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310232,
					"content": "¡Gracias por su ayuda, colegas! ¡Tendrán noticias muy pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310233,
					"content": "#¡Jaja, el toreritto parece estar disfrutando de lo lindo! Y nosotr{F#a}{M#o}s hemos ganado ramen gratis durante dos meses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310234,
					"content": "¡Todos salimos ganando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "¡Jefe, jefe! Shinobu ha enviado una carta, mira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310237,
					"content": "¿Eh? ¿Dónde se ha metido el jefe? ¿No estaba echando un combate de escaradiablos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310238,
					"content": "¿Se trata de algo urgente? El toreritto se acaba de ir con el Gran Maestre Hanakado para seguir combatiendo en otro lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310239,
					"content": "Bueno, no creo que sea urgente, pero sí repentino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310240,
					"content": "Pueden leerla si quieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310241,
					"content": "Espera, ¡¿QUÉ?! ¿El Gran Maestre Hanakado forma parte de la Banda de Arataki? Pero... por su forma de hablar parecía que eran archienemigos o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310242,
					"content": "Pues resulta que Shinobu tenía toda la razón, el toreritto se ha pasado el día combatiendo sin comer o descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310243,
					"content": "Aunque al menos se las arregló para organizar el Sublime y Glorioso Gran Torneo de Escaradiablos de Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310244,
					"content": "No sé si eso cuenta como descanso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "#Humm, Paimon cree que Shinobu se merece estos cupones más que nosotr{F#a}{M#o}s. ¿Por qué no la invitamos a comer un día de estos cuando vuelva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310246,
					"content": "Aunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310247,
					"content": "Ahora que Paimon lo piensa, el toreritto no nos dijo dónde está el puesto de ramen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310248,
					"content": "¿Se supone que tenemos que encontrarlo por nuestra cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310235,
					"content": "¡Lo importante es que todos estemos contentos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "¡El Gran Torneo de Combate de Escaradiablos ha llegado a su fin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "Los escaradiablos tienen que estar exhaustos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
		{
			"id": 7273107,
			"completionStepIds": [
				7273101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273101",
							"2"
						],
						"stepId": 7273101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273104",
							"2"
						],
						"stepId": 7273104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gran Maestre Hanakado",
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727310701,
					"content": "Ya veo... Bien, combatamos una vez más. Esta vez adivinaré todas tus estrategias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310702,
					"content": "Perder o ganar no es lo importante. ¿Por qué no combatimos solo por diversión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310703,
					"content": "No es fácil encontrar un oponente digno. Sería una pena que el combate llegara a su fin tan pronto, ¿no te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "Gran Maestre Hanakado"
				},
				{
					"id": 727310704,
					"content": "¡Ja! ¡Por mí no te cortes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310705,
					"content": "Pero ni sueñes con descubrir mis técnicas ocultas. ¡No tienes tú fe ni nada, enano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310706,
					"content": "Si admites que soy el mejor luchador de escaradiablos, ¡combatiré contigo todas las rondas que quieras y más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310707,
					"content": "Parece que el toreritto y el Gran Maestre Hanakado siguen a lo suyo. Dejemos que combatan hasta cansarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}