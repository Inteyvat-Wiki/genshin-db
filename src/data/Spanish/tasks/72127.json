			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "Oh, ya estás aquí. ¿Ves todas las flores que hay? ¿No te parecen bonitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270102,
					"content": "Muy bonitas, sin duda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "Jeje, claro. Las estoy cuidando bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270106,
					"content": "Por cierto, ¿puedes volver a hacerme un favor? Ahora que las flores se están abriendo, iba a recoger algunas para secarlas y enviarlas junto con una carta a las personas que aún no han regresado a Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270107,
					"content": "No sé si es porque he dormido poco, pero acabo de salir a recoger unas flores y ya estoy cansada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270108,
					"content": "¿Podrías ayudarme a recoger algunas flores dulces por aquí? Con tres será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270109,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "Lo dejo en tus manos. Voy a tomarme un respiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270112,
					"content": "Solo quiero la encantadora fragancia de las flores dulces. Para las cartas, usaré otro tipo de flores secas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270113,
					"content": "Creo que los que lean la carta y huelan las flores dulces... se pondrán de mejor humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270114,
					"content": "Cuento contigo. Haré un pequeño descanso aquí... Cuando recojas las flores, tráemelas, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270111,
					"content": "Hay flores dulces por todas partes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "¿Cuánto tiempo llevas plantando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "No tanto, es solo que... duermo un poco menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
