			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "Gracias. Estas flores dulces deberían ser suficientes. Iré a hacer las flores secas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270302,
					"content": "Ah, sí, tengo un pequeño regalo para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270303,
					"content": "Toma esta flor seca. Aunque está un poco marchita, es muy valiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270304,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "Esta es la primera flor que se abrió en este mar de flores. Me ayudaste a encontrar las semillas, así que me gustaría darte esta flor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270308,
					"content": "Aunque no es nada especialmente valioso, aun así... ¡muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270309,
					"content": "Estoy seguro de que todos volverán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "¡Sí! Así que tengo que plantar más flores para que, cuando todos vuelvan, puedan verlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270305,
					"content": "¿Tiene algo de especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "Por supuesto que tiene algo especial. Si no, no te la daría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		}
	]
}