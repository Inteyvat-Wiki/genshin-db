				},
				{
					"id": 130150602,
					"content": "No puedo seguir esperando a que regrese. Si la profesora Aisha estaba tan decidida a investigar esos secretos, yo también debería intentar hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
