			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pedrush",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "Oh, qué bien, ¡se despertaron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150102,
					"content": "Todo el mundo ha empezado a despertarse, y también nos han llegado noticias similares del resto de la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150103,
					"content": "Al parecer, ¡consiguieron resolver el problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150104,
					"content": "Sí, aunque nos costó bastante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150105,
					"content": "Dentro de poco se reunirá mucha gente aquí, así que, por favor, haz lo que puedas para que se mantenga el orden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150106,
					"content": "#Ahora tengo que ir con {F#ellas}{M#ellos} dos a la Academia, pero volveremos pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Oh, es la gran Arconte Dendro. ¿En qué puedo ayudarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "Me gustaría comprobar los datos de registro de un erudito de la Facultad Kshahrewar. Ahora se encuentra en estado inconsciente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Muy bien, deme un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "Tras un rato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Disculpe la espera, Arconte Dendro. Puedo confirmarle que hay un erudito llamado Benoni que lleva un tiempo inconsciente. La causa fue el uso inadecuado del Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "Aún no ha vuelto en sí y lo están atendiendo en el bimaristán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "¿Eh? ¿No se llama Moseis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "Tal vez no quería que nadie lo reconociera o molestara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Por favor, dale a la matra el conocimiento que hay guardado en esto y diles que lo introduzcan en el cerebro de Benoni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "Entendido. Pero, por seguridad, debo saber por qué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "Es muy simple: esto contiene su consciencia, la cual hace tiempo que está atrapada en un sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "Hizo algo que ha afectado a la seguridad de Sumeru. Cuando se despierte, informaré al Gran Juez de los detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "Ya veo. Me encargaré de ello cuanto antes. Gracias, Arconte Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "No hay de qué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Todo el mundo debería estar ya reunido en Momentos de ensueño. Regresemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Quedémonos en silencio para escuchar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "Paimon se pregunta qué irá a decir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Hola a todos los que se acaban de despertar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "Siento interrumpir sus hermosos sueños. Puede que haya abordado este tema de los sueños con un poco de indiferencia, así que les pido mis más sinceras disculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "Los sueños tienen un poder de lo más increíble. Nos alientan a permanecer firmes ante la adversidad y ayudan a cumplir los deseos de quienes tienen grandes aspiraciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "Pero los sueños también pueden aprovecharse de las personas, confundir su percepción y distorsionar la realidad. Por desgracia, a todos ustedes los escogieron como presas de un plan muy elaborado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "Como dije antes, aún estoy aprendiendo y no puedo decir que empatice por completo con todo el dolor que han experimentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "Pero solo tienen que mirar a su alrededor para ver a otras personas que han vivido cosas similares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "Deberían estar orgullosos de haberse reunido aquí para mirar hacia el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "La vida es un camino largo y es difícil ver el destino final, lo que nos lleva a hacernos muchas preguntas complicadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "¿Cuál es el sentido de la vida? ¿Cuál es el propósito de mi existencia? ¿Por qué no dejo de vivir el dolor y la pérdida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "La decisión más cómoda es dejar de avanzar, de pensar y repetir una y otra vez lo que ya conoces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Pero cuando piensen eso, miren a las personas y cosas a su alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Hay quienes trabajan duro todo el día para que sus familias tengan un plato que llevar a la mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "Hay quienes viajan por todo el mundo para crear obras de arte que resuenen en todo Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Y hay quienes investigan los secretos del mundo para evitar la ocurrencia de catástrofes aún desconocidas que podrían acabar con todo lo existente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "La vida no trata solo de uno mismo. Cada una de sus acciones los cambia a ustedes y al mundo a su alrededor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "Sus amigos y su familia recordarán lo que han hecho, y puede que hasta gente que no conozcan se beneficien de sus acciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Por eso, mucha gente se esforzará por crear un nuevo camino, aunque tengan que soportar mucho dolor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Una vez que hayan comenzado su viaje por ese camino complicado pero gratificante, averiguarán las respuestas de los grandes problemas de la existencia, los cuales dejarán de resultarles tan importantes como antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "En cambio, si creen que la vida no es más que un sueño efímero y vacío, entonces eso es lo que será para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "Son libres de escoger cómo quieren vivir su vida, pero como su Arconte, debo informarles de ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "Al final, depende de ustedes si quieren aceptar un sueño bonito en sacrificio de una vida real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "¡Eres la mejor, Nahida! Hasta Paimon estuvo a punto de dejarse convencer por ese erudito en el sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "Es muy bueno manipulando las debilidades de la naturaleza humana, pero puede que él mismo lleve tiempo siendo su propia víctima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "Ese sueño era increíblemente bello y tentador. La gente corriente no podía ver más allá y se perdieron dentro de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "Pero mientras uno pueda despertarse, siempre podrá seguir adelante con su vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "Tú también aprendiste mucho, Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "¿Eh? ¿Por qué dices eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "Ya empatizas con los demás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "¡Cierto! Dijiste que no entendías las emociones humanas, pero aun así te vimos dudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Tu discurso estaba perfectamente alineado con el punto de vista de los demás. ¡Lo hiciste muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Gracias. En este viaje, he escuchado muchas historias tristes, y muchas de ellas me conmovieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "No podemos decir que las víctimas del sueño hayan hecho algo malo. Además, tampoco querían algo poco razonable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "Por eso fui capaz de entenderlos cuando intentaron resistirse y proteger el sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "Aun así, el hecho de que los comprenda y me hayan conmovido no compensa ni el uno por ciento del dolor que han vivido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "No creo que ese uno por ciento sea un ejemplo de “empatía”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "¡Claro que lo es! Te exiges demasiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Nadie puede ser empático al cien por cien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Jeje, está bien. Es cierto que hay que salir un poco al mundo para madurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "Las emociones y el conocimiento son muy distintos. Me cuesta explicarlos con palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Benoni, o “Moseis”, dijo que yo nunca había sentido en primera persona el dolor por la pérdida, pero tengo una lejana sensación de que eso no es verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "En cuanto entré en el sueño, sentí que una sensación de calidez me arropaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "Era tan cálida que sentí como si hubiera vuelto al comienzo de mi vida y no quisiera despertar nunca más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(Humm... ¿Habrá visto algo en el sueño?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Pero cuando abrí los ojos, ya no había ni rastro de esa sensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "Si tuviera que hacer una metáfora, diría que ya no puedo ver las palabras de un pedazo de papel una vez que se han borrado, pero sí veo las sutiles marcas que dejaron esas palabras al escribirlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "Pero ahora que he vivido ese sueño... Creo que puedo decir con confianza que no me obsesionaré con el significado de esa calidez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "Me es suficiente con saber que, en algún momento, esa calidez fue mi mayor apoyo, y su existencia es lo que me ha hecho llegar a donde he llegado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "Si me obsesiono con su esencia, estaría dándole más importancia de la que tiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "Di ese discurso para inspirar a la gente, así que sería muy vergonzoso que no predicara con el ejemplo, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(La Reina Mayor Rukkhadevata dio forma a Nahida a través de sus acciones.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Aunque el mundo la haya olvidado, la mente y determinación de Nahida son la prueba de que existió.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(En vez de contarle la verdad, debería respetar las decisiones de ambas.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Oye, ¿por qué esa cara tan seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "Tienes pinta de querer decir algo. ¿Hay algo que quieras contarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "Olvidé lo que tenía que decir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Jeje, de acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "Como nos acabamos de despertar, estiremos un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "Hoy comienza un nuevo día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "No es nada importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Deberías confiar más en ti misma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
