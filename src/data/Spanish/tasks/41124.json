			"dialogs": [
				{
					"id": 411245201,
					"content": "¿Aún no te has ido? Ah, ¿tienes algo que preguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245202,
					"content": "¿Quién es ese señor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "Humm... Es un viejo conocido tuyo. Según él, ya lucharon juntos una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245204,
					"content": "Lo siento, no puedo decirte su nombre. Si lo hago, seguro que estaré en problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245205,
					"content": "¿Por qué no atrapamos a todos los Ladrones de Tesoros directamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "Quieres decir que, aunque derrotemos a los tres grupos de Ladrones de Tesoros que vengan atraídos por la información las cartas, el resto simplemente huirá cuando se entere de ello, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245207,
					"content": "Bueno, es cierto, pero esa es precisamente la intención. Ese señor no quiere atraparlos a todos, sino darles un pequeño susto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245208,
					"content": "Actualmente, los Caballeros no tienen personal suficiente para una persecución de esta escala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245209,
					"content": "Al fin y al cabo, los meteoritos caídos son la máxima prioridad en estos momentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245210,
					"content": "En cuanto a los Ladrones de Tesoros... Solo tienes que evitar que causen problemas por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
