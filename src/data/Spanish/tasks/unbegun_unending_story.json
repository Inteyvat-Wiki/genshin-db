			"dialogs": [
				{
					"id": 706760101,
					"content": "Paimon no sabía que en la biblioteca había una sala como esta. ¿Será la sección restringida de la que Lisa nos ha hablado alguna vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760102,
					"content": "Humm, bueno, la verdad es que no lo parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760103,
					"content": "¿O a lo mejor es una de esas salas de las historias a las que no dejan entrar porque en ellas se oculta algún gran secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760104,
					"content": "Pues si no querían que nadie entrara, deberían haber cerrado la puerta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760105
					]
				},
				{
					"id": 706760105,
					"content": "¡Cierto! Hemos entrado como si nada, y tampoco parecía que el cerrojo estuviera roto ni nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760106,
					"content": "Un momento, ¡esta no es la puerta por la que acabamos de entrar! ¿Aún estamos en la biblioteca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760107,
						706760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760107,
					"content": "¿Estaremos bajo el Lago de Sidra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760108
					]
				},
				{
					"id": 706760108,
					"content": "¿Tú crees? Humm, eso sería una obra arquitectónica demasiado impresionante... ¡Paimon no cree que sea posible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760111,
					"content": "Humm, si Lisa no estuviera hoy de vacaciones, le preguntaríamos a ella. Bueno, ya que estamos aquí y no parece peligroso, ¿qué te parece si echamos un vistazo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760112,
					"content": "Explorar cada nuevo sitio al que vamos: ¡ese es el secreto para ser una buena guía, y Paimon lo sabe muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760113,
					"content": "#Mira, {NICKNAME}, ¡un lobo de peluche superadorable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760114,
					"content": "¡Mira qué peludito! ¡Parece tan blandito que Paimon se quiere morir! ¿Quién lo habrá dejado aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760115,
						706760117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760115,
					"content": "¿Y si es el dueño de esta sala?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760116
					]
				},
				{
					"id": 706760116,
					"content": "#“Viajer{F#a}{M#o} osad{F#a}{M#o}, ¿cómo te atreves a entrar en mi fortaleza sin autorización? ¡Prepárate para ser devorad{F#a}{M#o}! ¡Grrrrr!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760120,
					"content": "A lo mejor podríamos ignorarlo por el momento. Esta sala es muy grande y hay mucho que explorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760117,
					"content": "Quizá sea el vigilante de esta sala misteriosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760118
					]
				},
				{
					"id": 706760118,
					"content": "¿Y el vigilante está durmiendo a pierna suelta en el sofá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760119,
					"content": "“Zzz... Zzz... Si no veo ningún peligro, entonces el peligro no existe. Zzz... Zzz...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760109,
					"content": "Tal vez estemos en otro mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760110
					]
				},
				{
					"id": 706760110,
					"content": "¿Qué otro mundo ni qué ocho cuartos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}