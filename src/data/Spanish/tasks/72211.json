				{
					"id": 722110405,
					"content": "Se ve un poco diferente de lo que cocinaba con Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110406,
					"content": "D-debe estar delicioso. Vamos, ¡probémoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110407,
					"content": "¡Toda una delicia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110408,
					"content": "... Miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110409,
					"content": "(¿Neko está triste porque no sabe igual que lo que preparaba la tal Hibiki?...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110410,
					"content": "Está delicioso. Puedo confiar en ustedes, sin duda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110411,
					"content": "Me alegro de que te haya gustado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "Es solo que el sabor no se parece mucho al de la comida de Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110413,
					"content": "#Sin embargo, la sensación al comer junt{F#as}{M#os} es exactamente igual que cuando comía antes con Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110414,
					"content": "#¿Por qué es eso, human{F#a}{M#o}? ¿Ustedes, los humanos, saben usar brujería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110415,
					"content": "Hace mucho tiempo que nadie cocinaba para ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "... En fin, gracias. Hacía mucho tiempo que Neko no comía tan bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110418,
					"content": "A los más pequeños les encantará. ¿Podrías llevarles esta comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110419,
					"content": "Como a Neko le gusta, seguro que a ellos les gustará también. Entonces, después de haber comido una comida tan deliciosa, seguramente estarán dispuestos a obedecer a Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110416,
					"content": "Quizás es el entusiasmo de la persona que lo hizo, supongo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
		{
			"id": 7221105,
			"completionStepIds": [
				7221107
