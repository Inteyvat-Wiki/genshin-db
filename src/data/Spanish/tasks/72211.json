				"points": []
			},
			"dialogs": [
				{
					"id": 722110702,
					"content": "¡Genial! Esperen un momento... ¡ya sé cómo hacer este plato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110703,
					"content": "¡Listo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110704,
					"content": "¡Huele increíble! Mmm, Paimon de verdad quiere probarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110705,
					"content": "Veamos, ya que es para una gata que habla... ¡Lo tengo! Llamémosle “comida felina revitalizante”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110706,
					"content": "En fin, aquí tienen la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110707,
					"content": "Por cierto, permíteme anotarte la receta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110708,
					"content": "#¡Yuju! ¡De ahora en adelante, {NICKNAME} podrá preparar comida felina cuando queramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110709,
					"content": "¿Acaso eres un gato, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "#¡Qué groser{F#a}{M#o}! La comida es un lenguaje universal, ¿acaso no lo sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110711,
					"content": "¡Cierto! Debemos darle las gracias a la Srta. Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110713,
					"content": "No hay de qué. Esta comida y la receta son un regalo para Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110714,
					"content": "Definitivamente visitaré el Santuario Asase en cuanto tenga tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110715,
					"content": "Muy bien, vuelvan, no hagan esperar a Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110712,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
		{
			"id": 7221108,
