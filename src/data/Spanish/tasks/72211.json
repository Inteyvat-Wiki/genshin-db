				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Srta. Etsuko, ¿dónde debemos explorar después?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Uf... Vamos a tomar un descanso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "¿Eh? Oh, son ustedes. ¿Nos buscaban para algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "Necesitamos encontrar un chef de confianza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "¿Están buscando un chef en la Isla Seirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Esto es lo que sucedió: Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Dices que... ¿Neko te pidió ayuda para preparar comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "Ah... ¡maldición! ¡Si tuviera talento para cocinar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "Así que estás buscando un chef que te ayude... a averiguar cómo usar estos ingredientes y hacer un plato que le guste a los gatos, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "Veamos... Un chef... un chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "¿Por qué no van a la Ciudad de Inazuma y buscan a Kiminami Anna del Restaurante Kiminami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "#Es muy simpática y muy buena cocinera, debería poder ayudar{F#las}{M#los} con esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "Gracias, vamos a ir a verla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "De nada. Dense prisa, Taisuke y yo tenemos que seguir planeando nuestra exploración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "Jeje, espero que este santuario reviva de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "De lo contrario, el arduo trabajo que tú y Neko han estado haciendo por tanto tiempo para arreglarlo se echaría a perder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
			"id": 7221102,
