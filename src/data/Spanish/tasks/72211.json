			},
			"dialogs": [
				{
					"id": 722111101,
					"content": "#Hola, bienvenid{F#as}{M#os} al Restaurante Kiminami. ¿Qué puedo ofrecerles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111102
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111102,
					"content": "#Oh, ¡si son l{F#as}{M#os} amig{F#as}{M#os} de la señorita Kamisato! ¿En qué puedo ayudarles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111103
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111103,
					"content": "Tengo que preparar comida para Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111104
					]
				},
				{
					"id": 722111104,
					"content": "¿“Neko”? Por casualidad, ¿es el nombre de un gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111105
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111105,
					"content": "¿La conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111106,
					"content": "Ah, no. Solo me pareció que el nombre le quedaría bien a un gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111107
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111107,
					"content": "Qué intuición tan acertada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111108
					]
				},
				{
					"id": 722111108,
					"content": "Dejando eso de lado por un momento, el asunto es el siguiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111109,
					"content": "Entonces, en la Isla Seirai... se encuentra el Santuario Asase, un santuario con una gata que habla... ¿Y esa gata les pidió que le cocinaran un plato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111110
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111110,
					"content": "¿Es en serio? ¡Nunca había oído hablar de algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111111,
						722111112
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111111,
					"content": "La verdad y nada más que la verdad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111113
					]
				},
				{
					"id": 722111113,
					"content": "Está en la Isla Seirai, ¿verdad? Tendré que comprobarlo yo misma cuando tenga la oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111114
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111114,
					"content": "Entonces... Sobre la comida para Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111115
					]
				},
				{
					"id": 722111115,
					"content": "Ah, sí... Casi me olvido del asunto principal. Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111116
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111116,
					"content": "Humm... Comida que le guste a los gatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111117
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111117,
					"content": "¿Es difícil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111118,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111119
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111119,
					"content": "Va a ser muy difícil, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111120
					]
				},
				{
					"id": 722111120,
					"content": "Esto es un desafío para la familia Kiminami. ¡Debo superarlo sea como sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111121
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111121,
					"content": "#Bien. Creo que un plato de pescado, carne cruda, algas y arroz hará que los gatos se desmayen de lo bueno que estará. ¡Déjamelo a mí, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111122
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111122,
					"content": "¡P-Paimon también lo quiere probar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111123,
						722111124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111123,
					"content": "Incluso yo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111125,
					"content": "¡No hay problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111126
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111126,
					"content": "Primero pensaré en una receta. Mientras tanto, ustedes me ayudarán a conseguir tres algas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111127,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "Entonces, por favor, con tres de ellas bastará. Cuando las encuentren, tráiganmelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111129,
					"content": "¿Ya sabes qué vas a cocinar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "Tengo una idea, pero aún no la he desarrollado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111131,
					"content": "Primero, tráiganme tres algas, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111124,
					"content": "Entonces, está en tus manos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111112,
					"content": "Puedes comprobarlo por ti misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111113
					],
					"speakerTitle": "Kiminami Anna"
				}
			]
		}
	]
