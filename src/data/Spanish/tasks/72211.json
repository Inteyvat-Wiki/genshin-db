				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "¿Ya llevaste la comida a los mininos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110502,
					"content": "Les encantó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "¿En serio? Eso alegra a Neko. Miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110504,
					"content": "Hacía mucho tiempo que Neko no comía algo tan delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110505,
					"content": "Miau, miau, miau... Aunque Neko ya no necesita comer o beber agua, el sabor de la comida realmente hace que Neko quiera seguir comiendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110506,
					"content": "Una de las pequeñas se llama “Anchoa”, precisamente porque Neko quiso ponerle el nombre de lo mejor del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110507,
					"content": "¿Cómo se llama el plato que cocinaba Hibiki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "¿Nombre? ¿Los platos necesitan nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110509,
					"content": "Por ejemplo, este se llama comida felina revitalizante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Es un nombre muy complicado, pero a Neko no le desagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110511,
					"content": "... Aunque tienes razón. Al fin y al cabo, la comida es algo bueno, y todas las cosas buenas deberían tener nombres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110512,
					"content": "Miau, miau, cuando Hibiki vuelva, Neko le preguntará. Entonces también podrás preparar tu plato para ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "Luego, ella te preparará su plato. Entonces Neko podrá comer dos platos diferentes, y ambos deliciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "Por eso Neko tiene que cuidar mejor el santuario. Cuando vuelva, comeremos todos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Gracias. Estaba delicioso. Miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
