			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "Muy bien, guardaremos esta comida en cajas para enviarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680402,
					"content": "Cada animal tiene sus costumbres, y no nos gusta encerrarlos en jaulas. Lo que hacemos es contratar a profesionales para que los cuiden y vigilen su estado de salud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680403,
					"content": "Encontrarlos no es tarea fácil, por lo que necesitarán el artilugio especial inventado por la Srta. Lamiya: el Espejo grabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680404,
					"content": "A mí no se me da tan bien explicar estas cosas, así que será mejor que lo haga ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680405,
					"content": "Sí, yo te lo explico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680406,
					"content": "La tecnología que hay detrás del Espejo grabado guarda cierta relación con el Akasha. La lógica operativa puede ser un poco complicada, pero no te preocupes, es un dispositivo seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680407,
					"content": "Como ya les hemos colocado microtransmisores a todos los animales, solo habrá que leer la señal con el dispositivo, y el espejo revelará todo lo que se puede ver desde la perspectiva del animal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680408,
					"content": "Aunque aún tiene algunos defectos, con estas imágenes debería bastar para encontrar a los animales que estén activos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680409,
					"content": "#Y eso sería todo. Si estás preparad{F#a}{M#o}, ¡sé bienvenid{F#a}{M#o} al Convoy de las Patitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680410,
					"content": "Usa el Espejo grabado para encontrar a nuestros amigos animales. Los regalos de los adoptantes y los animales te esperan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				}
			]
		},
