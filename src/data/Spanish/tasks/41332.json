				"points": []
			},
			"dialogs": [
				{
					"id": 413320301,
					"content": "¿Por qué no ha llegado mi pedido del Restaurante Wanmin?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320302,
					"content": "¡Aquí está!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "¡Ah, gracias! Pensé que tendría que esperar más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320304,
					"content": "Con el ambiente del Rito de la Linterna, extraño mi hogar, pero... tal vez no pueda regresar a Inazuma por un tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320305,
					"content": "No sé cómo estarán las cosas en Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atsuko"
				}
			]
		},
