			"dialogs": [
				{
					"id": 413320321,
					"content": "¿Por qué no ha llegado mi pedido del Restaurante Wanmin?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320322
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320322,
					"content": "¡Aquí está!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320323
					]
				},
				{
					"id": 413320323,
					"content": "¡Al fin llegó! Esperé tanto tiempo... Pero supongo que para ti debe ser un dolor de cabeza pedir para llevar en una temporada festiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320324
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320324,
					"content": "Con el ambiente del Rito de la Linterna, extraño mi hogar, pero... tal vez no pueda regresar a Inazuma por un tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320325
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320325,
