			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "¿Ya entregaste la comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321402,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Bien, hice bien en pedir tu ayuda. ¿Ya les preguntaste a Wang el Llave inglesa, Guanhai y Zhihua qué quieren comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321404,
					"content": "Wang el Llave inglesa y Li el Martillo quieren comer sopa de brotes de bambú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "¿Eh? Tienen gustos muy similares. Pero la sopa de brotes de bambú requiere de mucho trabajo, así que comenzaré a prepararla de una vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321407,
					"content": "Guanhai quiere comer pescado mandarín agridulce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "No hay problema, ese es mi plato fuerte, ¡jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321409,
					"content": "Zhihua quiere comer estrellitas de loto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "No imaginé que a Zhihua le gustaran los pastelillos. En fin, hacer las estrellitas de loto será pan comido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321411,
					"content": "Gracias por preguntar por mí. Debo apresurarme y ponerme manos a la obra. Por favor, acepta este humilde obsequio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321412,
					"content": "¿No van a colgar linternas celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
					"content": "¿Quién tiene tiempo para eso? Estoy ocupado en la cocina, y Xiangling acaba de salir a entregar otro pedido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321414
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321414,
					"content": "No hay tiempo, mi hija y yo no damos abasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321415,
						413321416
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321415,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321417
					]
				},
				{
					"id": 413321417,
					"content": "¿D-de verdad? Te lo agradecería. Justamente estaba preocupado porque, sin linternas celestes, el restaurante no tiene un ambiente festivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
