			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "¿Cuántas raciones eran?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320202,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "Jaja. ¡Dirigiendo el Restaurante Wanmin! ¿Qué más podría ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320204,
					"content": "Hemos estado ocupados con toda la gente que sale a comer durante el Rito de la Linterna. Incluso viajeros de tierras lejanas nos visitan para unirse a las festividades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320205,
					"content": "Aunque mi querida Xiangling regresó a ayudar, no da abasto. De hecho, acaba de salir a entregar un pedido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320206,
					"content": "Otras familias ya colgaron sus linternas celestes y están preparadas para la celebración, pero en el Restaurante Wanmin ni siquiera hemos tenido tiempo para hacer las linternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320207,
					"content": "#Por cierto, viajer{F#a}{M#o}, si estás dispuest{F#a}{M#o}, ¿podrías ayudarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320208,
					"content": "Conoces a Atsuko, ¿cierto? Esa jovencita de Inazuma que se la pasa en el muelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320209,
					"content": "Ella hizo un pedido, ¿puedes ayudarnos a enviárselo? Son días festivos, así que le preparé una ración extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320210,
					"content": "Y también para esas personas que siempre están trabajando en el muelle, <color=#00E1FFFF>Wang el Llave inglesa, Li el Martillo, Guanhai, Zhihua...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320211,
					"content": "Ellos siempre han sido buenos clientes de nuestro restaurante, pero aunque es un día festivo, siguen en el muelle. Supongo que es por trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320212,
					"content": "Quisiera preparar algo para ellos también. Después de todo, es época de celebraciones. Lo que ocurre es que estamos muy ocupados en el restaurante, y no tengo tiempo para entregarlo yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320213,
					"content": "#Viajer{F#a}{M#o}, ¿puedes preguntarles qué les gustaría comer? Les prepararé algo delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320214,
					"content": "¡No hay problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "Gracias. Vuelve cuando les hayas preguntado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
