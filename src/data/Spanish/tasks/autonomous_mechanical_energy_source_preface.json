			"dialogs": [
				{
					"id": 700270101,
					"content": "Llegas justo a tiempo. La calibración de los Clavos de Pursina va bastante bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270102,
					"content": "Siempre y cuando tenga esos componentes, podré repararlos en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270103,
					"content": "Reuní algunos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "Gracias, es de gran ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270105,
					"content": "Siempre y cuando tenga esos componentes, podré repararlos en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270106,
					"content": "Aún hay un asunto del que me gustaría hablar contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270107,
					"content": "Mientras recogías componentes estos días, investigué la estructura interna de los Clavos de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270108,
					"content": "Son unos objetos muy complejos, pero no se podía esperar menos de alguien tan hábil como Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270109,
					"content": "Incluso un pequeño ajuste podría afectar en gran medida al funcionamiento de toda la máquina. Por eso estaba tan preocupado por conseguir el efecto deseado con los ajustes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270110,
					"content": "Por razones de seguridad, me gustaría que hicieras algunas pruebas. Realizaré nuevos ajustes basándome en los datos que recopile en ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270111,
					"content": "Así nos aseguraremos de que los Clavos funcionan con la máxima eficacia. De lo contrario, las cosas podrían complicarse cuando te enfrentes al Demoledor de las Ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270112,
					"content": "Qué cauteloso eres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "Esta es la primera vez que trabajo con los Clavos de Pursina, así que es mejor ser precavidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270115,
					"content": "#Bien, dejo las pruebas en tus manos, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270113,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
}