			"dialogs": [
				{
					"id": 750280101,
					"content": "*Tch*, parece que nos encontramos con alguien difícil de tratar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Ratón"
				},
				{
					"id": 750280102,
					"content": "Auch, ¿qué está pasando hoy? ¿Qué hice mal? ¿Por qué tengo que sufrir esta paliza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Búho"
				},
				{
					"id": 750280103,
					"content": "#Jef{F#a}{M#e}, oriénteme. ¿Hice algo que le molestó? Dígamelo para que no lo vuelva a hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Búho"
				},
				{
					"id": 750280104,
					"content": "#¡Oye! ¿Por qué le hablas con tanto respeto a est{F#a}{M#e} demoni{F#a}{M#o}? ¿No tienes orgullo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Ratón"
				},
				{
					"id": 750280105,
					"content": "¿Orgullo? ¿Para qué sirve eso? Ya tengo claro que contigo solo puedo hacer de ladrón, así que dime, ¿traficar con saurios es algo de lo que sentirse orgulloso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Búho"
				},
				{
					"id": 750280106,
					"content": "Si de todas formas tengo que trabajar para alguien, entonces, ¿por qué no elijo a un jefazo más fuerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Búho"
				},
				{
					"id": 750280107,
					"content": "#Jef{F#a}{M#e}, no es que presuma, pero sin duda soy más habilidoso que estas dos cargas que llevas. Si necesitas cualquier cosa, solo tienes que avisarme y la llevaré a cabo a la perfección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Búho"
				},
				{
					"id": 750280108,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Justo me faltaba un secuaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "¿Lo dices en serio? ¡Ni hablar! ¡Paimon no está de acuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "#¡Además, ustedes son unos villanos! Nosotr{F#as}{M#os} somos gente buena, y no nos juntaremos con traficantes de saurios, ¿verdad, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Soy la persona más justa que hay en este mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#*Ejem*, en resumen, Paimon espera que no estén tramando nada, o... ¡{NICKNAME} les dará una buena lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "Los traficantes de saurios se marchan con cautela...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "¿Cómo estará ese Qucusaurio? ¿Vamos a verlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Bueno, podemos negociarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#¡No digas cosas que puedan malinfluenciar a {REALNAME[ID(2)|SHOWHOST(true)]}! Peque, no te preocupes, no nos juntaremos con los traficantes de saurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Gruuu... ¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Gracias, pero no es necesario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
