			"dialogs": [
				{
					"id": 205140301,
					"content": "¿Encontraste a Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140302,
					"content": "Sí. Subió a un molino de viento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "¡¿A un molino?! ¿Cómo consiguió subir tan alto? ¡Voy ahora mismo a decírselo a los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "Dijo que bajaría en un momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "¿En serio? Entonces no pasa nada. Qué susto... Pensé que no podía bajar del molino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "Gracias por tu ayuda. Yo iré a buscarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Acaba de recuperarse de su enfermedad y hace estas cosas... No tengo más opción que regañarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
