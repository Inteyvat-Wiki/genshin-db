					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140605
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140605,
					"content": "¡Todavía no se recuperó por completo y ya piensa en esas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140606
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140606,
					"content": "Siempre y cuando se cure, a mí no me importa si quiere viajar por todo el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140607
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140607,
					"content": "Gracias. Voy ya mismo a buscarla. Acaba de recuperarse de su enfermedad y hace estas cosas... No tengo más opción que regañarla.",
