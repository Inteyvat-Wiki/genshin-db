			"dialogs": [
				{
					"id": 205140201,
					"content": "Qué sitio tan alto... Seguro que aquí mi hermano no me encontrará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140202,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "¡Ah! ¿Cómo subiste hasta aquí? ¡Y sin hacer ruido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140204,
					"content": "¿Y cómo me encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140205,
					"content": "¿Yo? Pues subí escalando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140206,
					"content": "¿Mi hermano me está buscando? Oh, no me di cuenta de lo tarde que es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140207,
					"content": "De acuerdo, ahora regreso. Pero déjame estar un poco más aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
