			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "No sé qué hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140102,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "Ah, eres tú. Llegas justo a tiempo. Desde que empezó a tomar la medicina del médico, Anna está cada vez mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140104,
					"content": "Como antes no estaba bien de salud, pasó mucho tiempo encerrada en casa en reposo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140105,
					"content": "Ahora está mejor, pero todos los días insiste en que quiere salir a divertirse un poco. No sabía cómo decirle que no, así que finalmente acepté.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140106,
					"content": "Pero... ahora no la encuentro. ¿Dónde habrá ido esta chica? ¡Ayúdame a buscarla, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140107,
					"content": "D-de acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "Yo te esperaré aquí. Vamos, no hay tiempo que perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140109,
					"content": "En cuanto se encuentra mejor, empieza a descuidarse. ¿Qué voy a hacer si le sucede algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140116,
					"content": "Excepto por la zona del Gremio de Aventureros, ya la busqué por toda la ciudad. Pero ya no me quedan fuerzas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140117,
					"content": "Puedes ir primero a buscar allá. Ah, y tal vez Cyrus haya visto algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140118,
					"content": "Espero que la encuentres. Si no, tendré que seguir yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140110,
					"content": "Te veo bastante contento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "¿Contento? ¿Yo? ¡No hagas bromas con esto! En cuanto se encuentra mejor, cree que puede con todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140112,
					"content": "¡Cuando regrese, pienso regañarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140113,
					"content": "Espera a que tenga hambre y verás como regresa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "¿Crees que mi hermana es un gato o qué? Además, su cuerpo aún está débil. No creo que tenga mucha hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140115,
					"content": "Bueno, rápido, ayúdame a buscarla. Yo te esperaré aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
