					"nextDialogs": [
						205140504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140504,
					"content": "¿Y cómo me encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140505,
					"content": "Ah, ya sé. Seguro que Cyrus te dijo dónde estaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140506,
					"content": "Antes solía cuidar de mi hermano. Cuando me lo encontré, lo saludé. Pareció sorprendido por algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140507,
					"content": "Humm... ¿Debería ir al Gremio de Aventureros y convertirme en una aventurera? No estaría nada mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140508,
					"content": "¿Qué? ¿Que mi hermano me está buscando? ¡Oh, no me di cuenta de lo tarde que es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140509
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140509,
					"content": "Está bien. Déjame estar aquí un poco más y luego regreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
