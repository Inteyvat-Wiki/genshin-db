			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#¡Viajer{F#a}{M#o}! Llegas justo a tiempo, ¡te estaba buscando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270102,
					"content": "¿Eh? ¿Sucede algo, Meng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "¿Recuerdan que les pedí que me ayudaran a arrojar una botella que contenía mis preocupaciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270104,
					"content": "Al principio no tenía ninguna esperanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270105,
					"content": "Pero hace unos días, papá me dijo que uno de sus socios la encontró.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270106,
					"content": "Dijo que están planeando entrar en el negocio de los hongos, y que planean ir a Sumeru a hacer un estudio de mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270107,
					"content": "Le preguntaron a papá si quería ir con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270108,
					"content": "¡Incluso dijeron que yo también puedo ir con ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270109,
					"content": "Papá no estaba de acuerdo al principio, pero... de pronto apareció un señor con una carta y dijo que quería hablar con él a solas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270110,
					"content": "Después de conversar un rato, papá aceptó llevarme a Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270111,
					"content": "Humm... No sé por qué cambió de opinión, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270112,
					"content": "¡Por fin podré viajar a Sumeru! ¡¿Pueden creerlo?! ¡Iremos a Sumeru! ¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270113,
					"content": "¡Felicidades!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#Seguro que recogieron mi botella. ¡Todo es gracias a ti, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270117,
					"content": "Papá dice que, después de ir a Sumeru, también iremos a un lugar llamado Aldea Chiaoying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270118,
					"content": "¿Aldea Chiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Sí, papá dice que es un pueblo productor de té, tiene muchos árboles y la calidad de las hojas es excelente. Pero el nombre es difícil de recordar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270120,
					"content": "Bueno, ¡eso no importa por ahora! Primero iremos a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270121,
					"content": "Sumeru está muy lejos de aquí, debe tomar mucho tiempo llegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270122,
					"content": "Pero he escuchado que al viajar hay que hacer muchos preparativos, ya que puedes encontrarte con todo tipo de situaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270123,
					"content": "#{NICKNAME}, tú que acostumbras viajar, ¿me darías algunos consejos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270124,
					"content": "Por ejemplo... humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270125,
					"content": "¿Qué puedes comer cuando viajas por el campo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270126,
					"content": "Papá dice que ellos comen cosas que ellos mismos preparan, pero yo solo puedo cocinar cosas sencillas, y ni siquiera sé si saben bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270127,
					"content": "#Jeje, cocinar es nuestro fuerte, ¿cierto, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "Yo te enseñaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Primero tenemos que buscar una hornilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "Veamos... ¿Y si le pedimos al Chef Mao que nos preste su cocina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "¿El Chef Mao? Guau, ese señor da miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270133,
					"content": "¿Te asusta el Chef Mao? Pero si es una buena persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "¿En serio? Pero cada vez que como con papá en su restaurante, me arroja una mirada amenazante si no me como todas las flores chingxin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270129,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Quizás yo también vaya a Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "¡¿De verdad?! Entonces, ¡nos veremos allí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
