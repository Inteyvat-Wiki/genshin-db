					"content": "Una ensalada saludable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270402
					]
				},
				{
					"id": 210270402,
					"content": "Ciertamente es un plato sencillo y delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2102705,
