			},
			"dialogs": [
				{
					"id": 210270501,
					"content": "Un pollo asado con miel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270502
					]
				},
				{
					"id": 210270502,
					"content": "¡Qué delicia! Jeje, pero ¿no es un plato un poco complicado de hacer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2102706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270601,
					"content": "Ay... qué receta tan complicada... cuántas palabras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270602
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270602,
					"content": "Humm... Pero a un plato tan sencillo le hace falta algo especial, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270603,
					"content": "¿Ah, sí? Entonces, ¿qué hacemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
