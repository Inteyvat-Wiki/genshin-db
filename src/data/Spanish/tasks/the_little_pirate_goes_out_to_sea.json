			"dialogs": [
				{
					"id": 210270201,
					"content": "#¡Pero si son {F#la viajera}{M#el viajero} y Meng! ¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270202,
					"content": "#¿Eh? Yo... pues... {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270203,
					"content": "Quisiéramos tomar prestada tu cocina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "No tengo inconveniente en prestársela, pero es muy inesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270205,
					"content": "Ya veo... Bien, siéntanse libres de usarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270206,
					"content": "Meng, no puedes ser quisquilloso con la comida al salir al campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270207,
					"content": "L-lo sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270208,
					"content": "#Entonces, {NICKNAME}, ¡enséñame a hacer un plato delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270209,
					"content": "¡Quiero darle una sorpresa a papá cuando viajemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210270210,
					"content": "#¡Confía en nosotr{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}, ¿qué deberíamos preparar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
