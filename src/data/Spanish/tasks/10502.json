			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "#¿Estás list{F#a}{M#o}? No avergüences a tu maestra ahora que estamos a punto de conocer a esa sucesora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020102,
					"content": "Pero si ni siquiera puedo leer el futuro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "#No importa... Un momento, ¡espera! Si vas a fingir ser mi discípul{F#a}{M#o}, al menos tienes que saber algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020105,
					"content": "Hay una regla que nos prohíbe enseñar a extraños, pero... supongo que puedo hacer una excepción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020106,
					"content": "Mi astrología se basa en la hidromancia y, como su nombre indica, utilizo el reflejo de las cosas en una superficie de agua para observar el verdadero cielo estrellado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020107,
					"content": "Permíteme hacer una demostración. Presta atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020108,
					"content": "Según la fase actual y el movimiento de las estrellas ... Ya veo, de modo que el sucesor es una joven... Caballera de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020109,
					"content": "¿Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020110,
					"content": "La encontraremos aquí, en este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020111,
					"content": "Bueno, esa es toda la información que necesitamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020112,
					"content": "¿Es todo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "*Suspira*, parece que incluso la astrología más básica es difícil de aprender al primer intento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020115,
					"content": "No importa, te lo explicaré en detalle más tarde. Ella acaba de llegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020116,
					"content": "#¡Guau, eres tú, Caballer{F#a}{M#o} honorari{F#a}{M#o}, y Paimon! ¡Han vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020117,
					"content": "¡Es ella! ¡La sabia sucesora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020118,
					"content": "... ¿Te refieres a Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "¿Sucesora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020121,
					"content": "Así es. Soy la astróloga que ha sondeado las profundidades del océano de estrellas. Seguramente tú también previste mi llegada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020122,
					"content": "¿Océano de estrellas? ¿Qué es eso? ¿Tiene peces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020123,
					"content": "¿Peces? No. ¡Vamos, no finjas! ¿Acaso temes que te desafíe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020124,
					"content": "¿Fingir? ¡No sé de qué estás hablando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020125,
					"content": "Esta discusión no nos lleva a ningún lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "Pero mis predicciones no pueden ser incorrectas... Bueno, solo para asegurarme, el nombre de tu madre es Alice, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020128,
					"content": "¡Sí! ¡Oh, entonces eres amiga de mamá! Pero ella está muy lejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020129,
					"content": "Lo sé, ya lo predije, pero antes de que se fuera, debió haberte enseñado sus artes místicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020130,
					"content": "¿Artes... místicas? No entiendo de qué hablas. Mamá solo me enseñó a hacer bombas saltarinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020131,
					"content": "Entonces, ¿la madre de Klee es amiga y rival de la maestra de Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020132,
					"content": "Sí. Mi maestra era realmente hábil en astrología, pero no entendía de otras cosas. Alice, por otro lado, era experta en muchos otros campos místicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020133,
					"content": "Bueno... Klee es muy joven, así que, aunque alguien le hubiera explicado ese profundo conocimiento, podría no haberlo entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020134,
					"content": "Sí. Parece que ha heredado la sangre, pero no el conocimiento... ¡Vaya error de cálculo! Así no podré desafiar a nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020135,
					"content": "Por cierto. Antes de que Alice se fuera, ¿te contó algo sobre un acuerdo de cincuenta años y una caja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020136,
					"content": "¡Oh, eso sí lo sé! Así que estás aquí por esa caja. Voy a buscarla, espera aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020137,
					"content": "Esta no es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020138,
					"content": "Esta tampoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020139,
					"content": "No, tampoco es esta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020140,
					"content": "¡Ah! Ahora lo recuerdo. ¡La enterré junto a mi nuevo tesoro en <color=#00E1FFFF>Levantaviento</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020141,
					"content": "Es una bomba de nuevo, ¿cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "Espérenme, ya vuelvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020144,
					"content": "¡Klee, no corras! ¿No necesitas las cosas de tu mochila?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020145,
					"content": "La ayudaré recoger sus cosas, ustedes vayan tras ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020146,
					"content": "*Suspira*, con lo descuidada que es, me preocupa que algo le pueda pasar a la caja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020142,
					"content": "¿Por qué siempre entierras cosas importantes en el campo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "Solo di que fue un error.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "¡Debe haber algún error!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "¡Yo no vi nada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "No sé ni cómo interpretar las estrellas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
			"completionStepIds": [
				1050204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
