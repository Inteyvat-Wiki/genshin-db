			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "¡Ya llegamos! Este es el lugar. ¡Excavemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020202,
					"content": "Esto debe ser obra de Slimes Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				},
				{
					"id": 105020204,
					"content": "No puede ser, puse un cartel aquí. No estoy equivocad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020205,
					"content": "¡Ah, Slimes Dendro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020206,
					"content": "Sí. Son Slimes Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020207
					]
				},
				{
					"id": 105020207,
					"content": "*Suspira* hablemos más tarde, ¡primero deshagámonos de ellos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020203,
					"content": "Seguro que los Slimes Dendro están detrás de esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				}
			]
		},
