				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020301,
					"content": "¡La encontré! Esta es la caja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020302,
					"content": "Es una suerte que no se dañara por las explosiones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020303,
					"content": "¡Misión de recuperación cumplida! ¡Volvamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 1050204,
			"completionStepIds": [
				1050207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050207",
							"2"
						],
						"stepId": 1050207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "Por fin volvieron. Me tenían aburrida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020402,
					"content": "Tenía la intención de leer un libro para pasar el tiempo, pero resulta que esto es tan solo un diario. No es nada interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020403,
					"content": "Se cayó de la mochila de Klee, así que pensé que podría contener algo de conocimiento antiguo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020404,
					"content": "En fin, no importa. Entonces, ¿encontraste la caja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020405,
					"content": "Sí. ¡Está en perfecto estado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020406,
					"content": "¡Maravilloso! Espera un momento... ¡¿Por qué no está cerrada?! ¿Y por qué está vacía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020407,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020408,
					"content": "Pues... Tomé prestada la caja para guardar mis tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020409,
					"content": "¡¿Prestada?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020410,
					"content": "Pero como viniste por la caja, saqué todos mis tesoros. Por eso está vacía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020411,
					"content": "¿Lo usaste para guardar tus cosas? Entonces, ¿dónde está el contenido original de la caja? ¡Eso es lo que quería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020412,
					"content": "Oh, ¿quieres lo que estaba en la caja? ¿Por qué no lo dijiste antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020413,
					"content": "No lo has... roto, ¿o sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020414,
					"content": "¡No, no está roto, para nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020415,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020416,
					"content": "Es el libro que tienes en la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020417,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020418,
					"content": "Entonces, este libro, este diario... ¿Es el diario de esa anciana de hace 50 años?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020419,
					"content": "¿Lo que quería de vuelta era el diario en el que escondía su oscuro pasado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020420,
					"content": "¡Oh, no! Con razón mi maestra me dijo que no debía leerlo bajo ningún concepto, o me daría una buena tunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020421,
					"content": "¿He... he hecho algo malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020422,
					"content": "Fuiste tú quien dijo que querías la caja. ¡No dijiste nada sobre su contenido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020423,
					"content": "No sé nada de eso. ¡Me voy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020424,
					"content": "Qué final tan inesperado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Um... Bueno, si no dices nada, tu maestra no descubrirá que leíste su diario, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020427,
					"content": "#Me temo que no. Con la astrología, se puede ver a través de todas las mentiras. Ustedes mism{F#as}{M#os} lo han visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020428,
					"content": "*Suspira*, después de gastar todos mis Moras para venir a Mondstadt, no solo no he adquirido ningún conocimiento, sino que no puedo regresar... ¿Cómo ocurrió todo esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020429,
					"content": "Es una lástima... ¿Tal vez podrías olvidar todo lo que leíste en ese libro y volver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020430,
					"content": "Imposible... Aunque quisiera quedarme en Mondstadt, sería...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020431,
					"content": "¿Demasiado vergonzoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Sí. ¿Cómo voy a seguir siendo una buena astróloga si me paso el día rodeado de ignorantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020435,
					"content": "Bueno, entonces, no te queda más remedio que volver para confrontar a tu maestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020436,
					"content": "¡No digas eso! Bueno, tendré que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020437,
					"content": "Tendré que quedarme en Mondstadt temporalmente. Una vez que esa vieja bruja haya llegado al final de sus días, seré libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020438,
					"content": "Esa es una decisión un poco extrema, ¿no crees?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "¿Pero qué haré con mi investigación astrológica? No, espera, ni siquiera tengo un lugar donde quedarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020441,
					"content": "Podemos preguntarle a <color=#00E1FFFF>Katheryne, del Gremio de Aventureros</color>. Quizás te pueda ayudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020442,
					"content": "¿El Gremio de Aventureros? Ah, claro, se pueden hacer encargos para ellos a cambio de... Bueno, ya sabes a lo que me refiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020443,
					"content": "Por supuesto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "Oh, gracias. Yo... no importa, no es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020444,
					"content": "Ese era el plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "¿De verdad eso cuenta como “temporalmente”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "¿Demasiado caro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "Sí... quiero decir, ¡no! ¿Por qué siempre dices ese tipo de cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020425,
					"content": "No tiene sentido enojarse con Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
			"id": 1050205,
			"completionStepIds": [
				1050208
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050208",
							"2"
						],
						"stepId": 1050208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "Sobre los antecedentes de Mona y su dilema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020502,
					"content": "Ya veo. Entiendo la situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020503,
					"content": "Hay un <color=#00E1FFFF> laboratorio mágico</color> en Mondstadt que fue sellado por alguna persona desconocida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020504,
					"content": "Aunque tenemos algunos especialistas que podrían romper ese sello, todos tienen sus propios laboratorios y no están tan interesados en el asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020505,
					"content": "Creo que si la astróloga que mencionaste puede romper ese sello, al propietario de esa casa no le importaría si se quedara allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020506,
					"content": "Creo que puede hacerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "Bien. Entonces te diré dónde está la casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020507,
					"content": "La llevaré a echar un vistazo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050211",
							"2"
						],
						"stepId": 1050211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020601,
					"content": "Quien sea que haya puesto este sello... no es tan simple. Romper este sello por la fuerza es casi imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020602
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020602,
					"content": "Interesante. Supongo que vale la pena intentar romperlo con mis habilidades astrológicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020603,
					"content": "Veamos... Ya veo, así que si primero hago esto... y luego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020604,
					"content": "¡Ya está! ¡Abierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020605,
					"content": "¡Guau! ¡Impresionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020606,
					"content": "¡Ahora solo tenemos que regresar con Katheryne, y podrás quedarte aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020607,
					"content": "No se preocupe, no será necesario. Muchísimas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020608
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020608,
					"content": "¿Y tú quién eres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020609,
					"content": "Oh, soy Goth, el dueño de esta casa. Pasé por el Gremio de Aventureros hace poco. Katheryne me contó acerca de lo que pensaban hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020610
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020610,
					"content": "¡Nunca pensé que romperían este sello tan rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020611
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020611,
					"content": "¿Eso significa que puedo quedarme aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020612
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020612,
					"content": "Por supuesto. El lugar está abandonado, así que me alegraría mucho que alguien lo aprovechara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020613
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020613,
					"content": "Para expresar mi agradecimiento, ¡te alquilaré este edificio al precio más bajo posible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020614
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020614,
					"content": "¿Alquilar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020615,
					"content": "Nadie dijo nada de un alquiler. Además, también ayudé a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020616,
					"content": "Sí, sé que has ayudado. Estoy realmente agradecido por eso, así que tranquila, ¡te lo dejaré al mejor precio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020617
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020617,
					"content": "Lo que quiero decir es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020618
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020618,
					"content": "Paimon cree que Mona malentendió algo, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020619,
						105020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020619,
					"content": "Es muy buena opción, Mona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				},
				{
					"id": 105020621,
					"content": "*Suspira*, supongo que no me queda de otra. Alquilaré este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020622,
					"content": "¡Excelente! Entonces, estamos de acuerdo. Iré a preparar la documentación, por favor espera aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020623
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020623,
					"content": "Gracias por tu ayuda. Además, lo siento mucho, pero no podré ayudarte con lo que prometí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020624,
					"content": "Sin las herramientas necesarias, y sin nuevos conocimientos, me llevará un tiempo ver claramente tu destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020625
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020625,
					"content": "¡Pero prometo que te lo leeré cuando esté lista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020626,
						105020628
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020626,
					"content": "Como dijiste, no tenía nada que perder en este viaje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020627
					]
				},
				{
					"id": 105020627,
					"content": "Gracias. Viajar contigo fue parte de mi destino. No, ¡fue una suerte de mi destino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020630,
					"content": "#¡Les deseo a amb{F#as}{M#os} un buen viaje! En cuanto a mí... tendré que pensar en mi futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020631
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020631,
					"content": "¿Cómo va a ganarse la vida si no usa la astrología para ganar dinero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020632,
					"content": "Tal vez deberíamos volver a verla de vez en cuando. No sería bueno que se desmayara de hambre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020628,
					"content": "No te preocupes. Ahora lo importante es que trabajes duro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020629
					]
				},
				{
					"id": 105020629,
					"content": "Sí... No sé muy bien qué hacer, pero lo haré lo mejor que pueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020620,
					"content": "Si ahorras un poco, estarás bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				}
			]
		},
