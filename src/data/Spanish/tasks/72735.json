			"trigger": {
				"objectNames": [
					"Roquetrefe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "¡Eh! ¿Cuál de los tres es el jefe? ¡Que dé un paso al frente para luchar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Roquetrefe"
				},
				{
					"id": 727350102,
					"content": "Yo, el gran Roquetrefe, soy el luchador de élite del Gran Maestre Hanakado. El Gran Maestre ha pedido la cabeza del líder de la Banda de Arataki, ¡y yo se la llevaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Roquetrefe"
				},
				{
					"id": 727350103,
					"content": "Guau, parece peligroso... ¡Y también habla como tal! Parece que estamos ante un oponente superfuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "¡Tonterías! ¿Y qué si le has puesto un “gran” a tu nombre cutre? ¿Es que intentas hacerme sombra, mequetrefe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Muy bien, “Gran Mequetrefe”, ¡hora de bajarte esos humos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "U-un... ¡Un gigante! ¡Y tienes cuernos! ¡¿Eres un oni?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Roquetrefe"
				},
				{
					"id": 727350107,
					"content": "¿Qué hace un tipo tan fortachón como tú luchando con escaradiablos? Esto es solo un juego de niños... ¡Arg, no debería haberme metido en esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Roquetrefe"
				},
				{
					"id": 727350108,
					"content": "¡¿Cómo?! ¡¿Un juego de niños?! Dime que eso no es lo acabas de decir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Está claro que no tienes ni idea de combates de escaradiablos. ¡Necesitas que un experto como yo corrija tus errores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "¡Enséñale la lección!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "¡Eso, eso! ¡Bájale los humos, toreritto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Uff, veo que no tengo escapatoria... En fin, ¡adelante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roquetrefe"
				},
				{
					"id": 727350111,
					"content": "¡No le permitas que te hable así!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}