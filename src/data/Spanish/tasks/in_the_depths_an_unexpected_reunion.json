			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040301,
					"content": "¿Pero qué...? ¡¿Es una ciudad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040302,
					"content": "¿Una ciudad que... flota en medio del aire?... ¡¿Invertida?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040303,
						80040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040303,
					"content": "Qué vista tan impresionante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				},
				{
					"id": 80040402,
					"content": "#{NICKNAME}, ¿ver esta ciudad no te recuerda a algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040403,
					"content": "Humm... ¿Qué será...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040404,
					"content": "La estatua profanada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "Sí, ¡exacto! Es idéntica. Igual de extraña, invertida, e igual de espeluznante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040406,
					"content": "En ese caso... Quizás la Sima está relacionada con lo que quiera que esté sucediendo con la Orden del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040407,
					"content": "Oh, tenemos que llegar al fondo de esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040408,
					"content": "... Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040410,
						80040411
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040410,
					"content": "¡¿Dainsleif?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040412,
					"content": "El sentimiento es mutuo. Yo tampoco imaginé que nos encontraríamos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040413
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040413,
					"content": "Cuánto tiempo sin vernos, Dain... No, espera, ¿qué haces aquí en la Sima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040414,
					"content": "¿La Sima? ¿Así que estamos en las profundidades de la Sima? Conque así es como luce... Ni siquiera yo había puesto un pie en este lugar antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040415
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040415,
					"content": "Tengo muchas cosas que preguntarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040416
					]
				},
				{
					"id": 80040416,
					"content": "Entiendo cómo te sientes. La última vez, nuestro encuentro y despedida fueron muy repentinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040417,
					"content": "Pero, a juzgar por nuestro encuentro fortuito... supongo que el destino te debe una explicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040418,
						80040419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040418,
					"content": "Dime primero por qué apareciste aquí de repente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040420,
					"content": "No es difícil de adivinar, ¿o sí? Detecté actividad de un Emisario del Abismo y le seguí el rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040421,
					"content": "Es una lástima que le dejara sin escapatoria antes de que recurriera al mismo truco que hacen todos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040422,
					"content": "Le pisaba los talones cuando crucé el portal con él. Pero, como siempre, fue en vano, pues me llevó al lugar equivocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040423,
						80040424
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040423,
					"content": "Entonces, ¿tuviste el mismo problema con el portal la última vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040425,
					"content": "Correcto. A juzgar por mi experiencia, solo puedo suponer que los portales de la Orden del Abismo no son simplemente rutas de un punto a otro, sino que conforman una red compleja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040426,
					"content": "Ellos pueden escoger el destino del teletransporte a su antojo, puede ser cualquier lugar dentro de la red.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040427
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040427,
					"content": "Suena similar a los puntos de teletransporte, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040428,
					"content": "#En otras palabras, incluso cuando iba detrás de tu herman{F#o}{M#a} la última vez, para cuando pude reconocer dónde estaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040429,
					"content": "... me di cuenta de que estaba solo en las ruinas conocidas como la “Guarida de Stormterror”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040430,
					"content": "Oh, sobre eso... ¿Qué fue del ojo del primer Labrador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040431,
					"content": "Está en lugar seguro. Puedes estar segura de que averiguaré la verdad detrás del “Telar del Destino” antes de que caiga en manos del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040432,
						80040433
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040432,
					"content": "Es hora de que te presentes de nuevo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040434,
					"content": "Ja, así que recuerdas ese título...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040435,
					"content": "De ninguna manera pretendía ocultarlo. Ese sobrenombre una vez representó la gloria de Khaenri'ah, pero ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040436,
					"content": "... Es más bien como una broma cruel, la maldición que llevo a cuestas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040437,
					"content": "Como Capitán de la guardia real y testigo de la catástrofe de mi tierra natal, tengo mis motivos para no querer recordar ese título durante nuestra conversación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040438,
					"content": "#Así que lo que dijo tu herman{F#o}{M#a} es verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040439,
						80040440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040439,
					"content": "#Pero ¿qué sucedió entre mi herman{F#o}{M#a} y tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040441,
					"content": "Éramos compañeros de viaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040442
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040442,
					"content": "Un viaje que emprendimos con mucho esfuerzo y dolor en busca del destino, pero... no pudimos llegar juntos al destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040443,
					"content": "¿Al destino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "Antes de que sigas con este interrogatorio interminable, debo advertirte una cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040445,
					"content": "Si mis sospechas sobre la red de teletransporte son ciertas, el hecho de que yo apareciera convenientemente aquí es prueba de que la Orden del Abismo tiene sus ojos puestos en esta ubicación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040446,
					"content": "#¿Quieres decir que la Orden del Abismo está tramando hacer algo aquí? De hecho, Paimon y {NICKNAME} también lo sospechan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040447,
					"content": "Entonces, es muy probable que la Orden del Abismo esté vigilándonos mientras charlamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040448,
					"content": "¡Uf, no digas eso! ¡A Paimon se le ponen los cabellos de punta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040449,
					"content": "Vayamos primero a investigar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "Jaja, un acto sensato. Parece que la luz de un fuego proviene de ese muro de piedra. Vayamos a echar un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040450,
					"content": "Confiaré en ti, por ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "¿Qué ocurrió entre ustedes dos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "¿Quién es el “Espadachín del Crepúsculo”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#... ¿Quieres decir que no alcanzaste a mi herman{F#o}{M#a} la última vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "¿Qué fue ese portal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "Eso no me lo esperaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040304,
					"content": "Superó mis expectativas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				}
			]
		},
