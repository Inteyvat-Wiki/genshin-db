			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "#Viajer{F#a}{M#o}, pero qué coincidencia, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040102,
					"content": "#¿Qué encargo tienes preparado para nosotr{F#as}{M#os} hoy? Y, por cierto... ¿por qué Paimon tiene la impresión de que pareces más contenta que de costumbre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040103,
					"content": "Es porque fui al santuario a sacar un palillo de la fortuna. La miko me dijo que “tendría un encuentro inesperado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040104,
					"content": "¿Katheryne sacando un palillo de la fortuna? ¿Es imaginación de Paimon, o es de lo más inusual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040105,
					"content": "No, espera, el caso es que, ¡¿cómo pudiste ir y venir entre Inazuma y Liyue en un día?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040106,
					"content": "Jeje, incluso yo tengo una vida privada, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040107,
					"content": "#¿Estás diciendo que ese “encuentro inesperado” somos nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040108,
					"content": "¿Quién sabe? Tal vez sean las expectativas las que hacen que me ponga feliz, sin importar con quién me encuentre hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040109,
					"content": "Está bien, aunque nos vemos casi todos los días. En fin, lo que te haga feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040110,
					"content": "Un encuentro inesperado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "#¿Te refieres a...? Oh, Paimon te entiende, {NICKNAME}. Si lo que dijo la miko es cierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040113,
					"content": "#Crucemos los dedos por encontrarl{F#o}{M#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040114,
					"content": "#¿A qué viene esa cara tan larga? ¿Acaso dije algo que no debía? Se ven un poco desanimad{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040115,
					"content": "#No es nada. En fin, de vuelta al tema, ¿tienes algún encargo para nosotr{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040116,
					"content": "Sí. Da la casualidad de que tengo un encargo de un minero. Parece que tiene que ver con una investigación en la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040117,
					"content": "¿Eh? ¿Eso quiere decir que la Sima ya no está cerrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040118,
					"content": "Dejaré que el cliente les explique los pormenores. Se llama Yuehui. En estos momentos debe estar en la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040119,
					"content": "Está bien, Katheryne, ¡entonces nos pondremos en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040120,
					"content": "Bien. Ad astra abyssosque. Humm... Ahora que lo pienso, en esta ocasión de verdad se dirigen hacia un abismo profundo. Les deseo buena suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040111,
					"content": "¿Tal vez...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "¡Hola! Tú debes ser Yuehui, ¿cierto? Venimos de parte del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040202,
					"content": "Oh, ¡mucho gusto! Sí, fui yo quien publicó el encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040203,
					"content": "#¿Eh? Me resultas muy familiar... ¿Acaso eres {F#alguna aventurera famosa}{M#algún aventurero famoso}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040204,
					"content": "Es un poco complicado de explicar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "Oh, de acuerdo... Permítanme presentarme. Soy Yuehui, un minero, y acabo de conseguir una licencia de minería para la Sima. También tengo a mi disposición a unos cuantos hombres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040207,
					"content": "¿De veras? ¿En serio dan permisos para minar en la Sima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040208,
					"content": "Así es. La Terraza Yujing al fin atendió a razones y, bajo la protección de la Geoarmada, han permitido la minería en la superficie. Nosotros somos el primer grupo en conseguir un permiso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040209,
					"content": "Pero recientemente han ocurrido unos incidentes que tienen a los mineros preocupados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040210,
					"content": "¿De qué se trata? A Paimon no le suena haber escuchado nada de esto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040211,
					"content": "Bueno... No sabría decir si es un problema grave o no. Es solo que hay algo muy extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040212,
					"content": "Durante el descanso, uno de mis hombres se fijó en unos Hilichurls que pasaban por allí. Parecían estar distraídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040213,
					"content": "Pasaron por su lado sin prestarle la menor atención. Siguieron caminando sin desviarse ni un milímetro en dirección a la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040214,
					"content": "Entonces, al prestar más atención, el minero descubrió que el mismo fenómeno ocurría una y otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040215,
					"content": "Humm... ¿Tal vez los Hilichurls tienen curiosidad? Quizás solo estaban de paseo o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040216,
					"content": "No, no. Lo extraño es que los Hilichurls que llegaban a la Sima solo entraban...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040217,
					"content": "... Pero ninguno de ellos salía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040218,
					"content": "Los rastros de los Hilichurls solo van en una dirección. Después de entrar, no volvieron a salir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040219,
					"content": "Recientemente han ocurrido fenómenos similares con mayor frecuencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040220,
					"content": "“¿Cuál es el objetivo de esos Hilichurls?”, “¿qué ocurre con ellos después de que entren ahí?”, “¿estarán tramando alguna calamidad?”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040221,
					"content": "Mis muchachos no dejan de hacerse este tipo de preguntas. Muchos de ellos incluso han perdido los estribos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040222,
					"content": "Ay... A Paimon no le sorprende. ¡De solo escucharlo se le ponen los cabellos de punta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040223,
					"content": "No quiero ni imaginar cómo será dentro de la Sima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "Yo también lo creo. Quizás el peor temor es el miedo a lo desconocido. Si la verdad sale a la luz, mis hombres volverán al trabajo con más tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040226,
					"content": "¿D-de verdad tenemos que aceptar este encargo? ¿No podemos reconsiderarlo? Eh... Gracias, señor minero, nos gustaría considerarlo primero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040227,
					"content": "#Déjanoslo a nosotr{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "¡Oye! ¡Paimon también tiene voto en esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040229,
					"content": "Un fenómeno tan extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "#Oh, así que eso es lo que tienes en mente... Humm... Bueno, está bien, quizás encontremos pistas sobre tu herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040232,
					"content": "Si no vamos, no te lo sacarás de la mente, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040233,
					"content": "Entonces, ¿aceptarán el encargo? No quiero presionarles, pero no me gustaría haber obtenido este permiso de minería en vano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040234,
					"content": "#Sí, lo aceptamos. Ahora, nosotr{F#as}{M#os} también tenemos curiosidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040235,
					"content": "¡Qué gran alivio! Están haciendo una gran labor aquí. Entonces les diré más o menos la ubicación de esos Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040230,
					"content": "Sospecho que tiene que ver con la Orden del Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "Ciertamente, suena muy extraño...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040205,
					"content": "Volvamos al tema en cuestión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				}
			]
		},
		{
			"id": 800403,
			"completionStepIds": [
				800403,
				800404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"800402",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
