			"dialogs": [
				{
					"id": 150420101,
					"content": "¡Yuuujuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420102,
					"content": "¡Sol, olas y Koholasaurios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420103,
					"content": "Está tan emocionada, que es casi como si hubiera olvidado que su nombre antiguo es Umo{RUBY#[S]Unidad}ja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420104,
					"content": "¡Rápido, por aquí! Vamos chicos, más rápido... ¡Corran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420105,
					"content": "¡Ya vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420106,
					"content": "¡Miren! ¿Qué creen que es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420107,
					"content": "Un tablón de madera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420108,
					"content": "¡Miren lo que pone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420109,
					"content": "Oooh, es un mapa turístico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420110,
					"content": "¡Un mapa turístico, exacto! Es algo tan valioso como la llave de un cofre del tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420111,
					"content": "Te entiendo perfectamente. ¡Mapas como este marcan el comienzo de una aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420112,
					"content": "También es como una brasa de flogisto, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420113,
					"content": "¿Flogisto? Eh... Eso es como una especie de energía, ¿no? ¿Quieres decir algo así como... que con solo mirarlo, te llena de motivación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420114,
					"content": "¡Así es! Y, además, es muy importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420115,
					"content": "Con un mapa en mano, ¡podrás salir a explorar por tu cuenta y embarcarte en tu propia aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420116,
					"content": "Jeje, ¡la libertad y las aventuras nos esperan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150420118,
					"content": "Espera un momento, no te apresures a darle la razón... ¿Por qué Paimon siente que ocultas algo, Mualani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420119,
					"content": "¡Eso es todo! ¡Que cada uno vaya a explorar donde quiera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420120,
					"content": "¡¿Qué clase de guía turística se marcha en cuanto llega a un lugar turístico?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420121,
					"content": "Mualani solo quiere divertirse por su cuenta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "#¡Eres {F#una}{M#un} gran amig{F#a}{M#o}! ¡Recordaré este favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420124,
					"content": "Que todo el mundo eche un vistazo a esto. Estas dos grandes atracciones han sido marcadas como “en pruebas”. Parece que han tenido algún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420125,
					"content": "¿Por qué no nos dividimos y visitamos las atracciones que más nos entusiasmen a cada uno? Nos divertiremos mientras ayudamos con las pruebas. ¡Quizá incluso consigamos poner en marcha la Bahía de las Olas antes de lo previsto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420126,
					"content": "Y ahí estaba Paimon, pensando que nos abandonarías en cuanto tuvieras tu dosis de deportes acuáticos, pero resulta que estabas pensando en todo el grupo, después de todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420127,
					"content": "Jeje, ¿por qué no nos reagrupamos cerca de ese edificio gigante con forma de Koholasaurio cuando acabemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420128,
					"content": "Basándome en la intuición que me han dado años de experiencia como guía, apostaría a que la entrada al desafío principal está por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420129,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150420130,
					"content": "Muy bien. Entonces, nos vemos luego. ¡Recuerden consultar el mapa a menudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420122,
					"content": "Ya veo. Hoy nuestra guía también está de vacaciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
