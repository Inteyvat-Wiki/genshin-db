			"dialogs": [
				{
					"id": 150421701,
					"content": "¡Buen trabajo, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421702,
					"content": "*Fiu*... ¡Eso fue INCREÍBLE! ¿Qué tal lo hice, chicos? Nada mal, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421703,
					"content": "¡Ha sido increíble! ¡No me extraña que te conozcan como una de los seis héroes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421704,
					"content": "Mientras estabas fuera, Paimon me lo contó todo sobre ti y me quedé muy impresionado al oír todas las cosas que has conseguido. En serio, me emocioné tanto... ¡Era como si estuviera ardiendo de pasión por dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421705,
					"content": "Jaja, gracias, ¡tus cumplidos significan mucho para mí! ¡Estoy tan emocionada ahora mismo que creo que podría organizar una fiesta de aguas termales aquí y ahora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421706,
					"content": "Mira, ¡el personal de la Bahía de las Olas también está aquí! Después de tanto trabajo, deben de estar deseando desmelenarse un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421707,
					"content": "Creo que te equivocas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421708,
					"content": "¿Y eso por qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421709,
					"content": "¡Mualani! ¡Srta. Mualani! ¿Me firma un autógrafo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421710,
					"content": "¡Yo también quiero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150421711,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "Cría de Iktomisaurio"
				},
				{
					"id": 150421712,
					"content": "Parece que te descubrieron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "¡Rápido! ¡Será mejor que nos tomemos la imagen grupal ahora, antes de que llegue la multitud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421714,
					"content": "¡Veamos esas sonrisas radiantes y esas expresiones de confianza! Piensen en el océano y en sus colores de la suerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421715,
					"content": "Tres, dos, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421716,
					"content": "¡Koholasaurio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
