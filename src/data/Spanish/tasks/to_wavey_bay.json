			"dialogs": [
				{
					"id": 150421401,
					"content": "¿Qué tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421402,
					"content": "Fue bastante fácil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "#Qué atrevid{F#a}{M#o}, pero creo que hiciste un buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421408,
					"content": "Tal vez pueda dar algunas sugerencias al personal para que introduzcan algunas mejoras en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421409,
					"content": "De todos modos, deberían dejar participar a dos personas para que compitieran entre sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421404,
					"content": "Mis ojos... Todo está borroso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "Jaja, mantener la concentración requiere mucha energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421406,
					"content": "Fue divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "¿Ah, sí? Entonces, pensamos igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				}
			]
		},
