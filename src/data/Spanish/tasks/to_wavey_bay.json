			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Oh, ¡qué buen ojo! No pensé que me descubrirías estando en un lugar tan alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421302,
					"content": "Parece que a ti también te interesa la atracción de este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421303,
					"content": "¿Es divertida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "#Creo que está bastante bien, pero si es “divertida” o no es algo subjetivo. No quiero influenciarte, así que sugiero que la pruebes por ti mism{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421307,
					"content": "¿Ves esa vía de ahí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421308,
					"content": "Utiliza los proyectiles pigmentados para colorear las esferas alineadas en las vías. Cuando todas tengan el mismo color, las esferas desaparecerán con un “¡pum!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421309,
					"content": "Quiero decir que habrá alguien cerca con su propia arma esperando para hacer volar esas esferas de colores cuando llegue el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421310,
					"content": "Guau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Mi palabra no significa nada a menos que lo pruebes. Tan solo usa esa arma de ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421313,
					"content": "Esta vez me quedaré viéndote jugar. Buena suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421311,
					"content": "Tengo que verlo para creerlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "¿Es complicada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "#Tranquil{F#a}{M#o}. Estamos en el Resort Brisapacible, un lugar en el que lo complicado y lo difícil no tienen cabida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				}
			]
		},
