			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#Vaya, son {NICKNAME} y Paimon. No esperaba encontrarl{F#as}{M#os} en un lugar tan remoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030102,
					"content": "#¿Estaban siguiendo alguna pista o andaban perdid{F#as}{M#os} y terminaron aquí por casualidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030103,
					"content": "Estamos dando vueltas para ver si hay algo que valga la pena capturar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "Ya veo. Desde la cubierta de este barco abandonado, se distingue la silueta de la Oficina de Diseño Experimental Kuuvahki que desprende... un aire de grandeza. Es como si se alzara en el horizonte un coloso dormido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030106,
					"content": "Sí, es muy intimidante incluso viéndolo desde aquí. Paimon se pregunta cuántos secretos ocultará en su interior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030107,
					"content": "Para ustedes, que buscan un paisaje único, podría ser una gran fuente de inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030108,
					"content": "Después de todo, los relatos más fascinantes nacen justo donde convergen la luz y la oscuridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030109,
					"content": "Jeje, Flins, contigo aquí de pie y tu lámpara azul, este lugar adquiere un aire superenigmático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030110,
					"content": "Por cierto, ¿no tendrías que estar velando en... ese lugar? ¿Estás de vacaciones? ¿O estás patrullando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030111,
					"content": "Diría que las dos cosas. Como soldado ratnik, mi deber es vigilar los desastres que nacen en las sombras. No importa dónde me encuentre, nunca debo bajar la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030112,
					"content": "Dicho esto, la situación aquí parece estable, no deben preocuparse. Continúen con su tarea creativa tranquilamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030113,
					"content": "Ya que estamos, ¿te puedo tomar una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "¿A mí? Una petición inesperada. Para ser sincero, no estoy acostumbrado a estar frente a un Daguerrotipo y ser el centro de atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030116,
					"content": "Supongo que lo entenderán. Prefiero compartir silencio con lápidas o escuchar los susurros de los difuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030117,
					"content": "#Aun así, rechazar una petición tan sincera de parte de {F#una}{M#un} amig{F#a}{M#o} no es un acto apropiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030118,
					"content": "Adelante. Dejen constancia de los momentos que creen merecer la pena. Estaré encantado de aportar un poco de inspiración a su arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030114,
					"content": "¿Te parece si te tomo una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "Estamos buscando inspiración para tomar imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
