					}
				]
			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "#¡Yujuuu, ganaste! ¡Eres {F#la}{M#el} mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "Ja... Ni el guerrero más fuerte de la tribu podría ganarte. He perdido con todas las de la ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "¿Qué te parece, amigo mío? Perder contra un pequeñín como este... Se ve que aún tenemos que entrenar duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "*Jadea*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "Fue un combate magnífico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "Bonitas palabras, Manqu, pero ¿eso es todo lo que tienes? ¿Por qué no pruebas tú también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "Oh, gracias, jefe Pacal, pero me temo que debo rechazar su petición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#¡Bah, qué aburrido! Aaah, ¡qué pelea tan genial! Desde luego, tu fuerza no es algo que se deba subestimar, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "Pero si solo estaba calentando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "#¡Jajaja! ¡Qué chic{F#a}{M#o} tan bravuc{F#ona}{M#ón}! Di que sí, si eres fuerte, ¿qué sentido tiene esconderlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Jaja, se ve que est{F#a}{M#o}s dos han cuidado muy bien de ti, ¿eh, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#¡Pues claro! ¡{REALNAME[ID(2)|SHOWHOST(true)]} es nuestro gran compañero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "Me alegro de oír eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Bien, tomen, esta es la prueba de que el jefe de la tribu ha reconocido su valía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "¿Cómo era su nombre técnico, Manqu? Vamos, ahora es cuando tienes que hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "El talismán de Waxaklahun Ubah Kan, el Sabio Robafuegos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Eso. Nunca me acuerdo de ese nombre, pero lo que sí recuerdo es que, cuando el Rey Dragón del Fuego murió y el primer Arconte Pyro renació de entre las llamas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "El Sabio Robafuegos y el primer Arconte Pyro se llevaron cada uno un amuleto del volcán. Aquel que consiga ambos podrá entrar en el fuego purificador del volcán y purgar todas las maldiciones y desastres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Manqu, ¿cuánto tiempo vivió el Sabio Robafuegos? Creo recordar que hay historias sobre él desde la era tribal hasta la de Ochkanatlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "Hasta en la Sombraguja hay leyendas sobre él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Al fin y al cabo, fue el primer humano en usar flogisto... Y cualquier cosa es posible para un personaje legendario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Hay quien dice que su cuerpo y su alma se convirtieron en flogisto, que se hizo uno con el viento, la tierra y las flores de Natlan, y que es capaz de escuchar las plegarias de todas las tribus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Y también hay quienes dicen que, en realidad, en cada época hubo alguien que heredó el nombre del Sabio Robafuegos, y que después de muchas generaciones, incluso en el presente hay alguien que lo lleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "No obstante, y con el debido respeto, una gran parte de todo eso no son más que conjeturas narrativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Jaja, ten cuidado con lo que dices. Si Titu llega a oírte, volverá a enfadarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Bueno, yo ya he hecho mi parte... Ah, no, según nuestras tradiciones y convenciones, aún hay algo que debería hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "#Y es dar mi bendición {F#a la guerrera}{M#al guerrero} que se va a embarcar en un nuevo viaje y a su compañero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "¿Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Oooh, ¿es como una especie de ritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Qué va. En realidad, solo consiste en decir unas cuantas palabras bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Bien. {NICKNAME} y {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Lo escucho, jefe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Que sobrevuelen cumbres montañosas como el ave más robusta.\\nQue aguanten toda ola turbulenta como la piedra más firme y tenaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Que no teman al peligro, pues en este mundo siempre lo habrá.\\nQue nunca se olviden el uno del otro, pues el destino siempre trae despedidas inevitables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "#Que lleguen a su destino deseado y que se cumplan todos sus deseos... Y por último y más importante: que regresen san{F#a}{M#o}s y salv{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "Lo haremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "¡Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Eh, ¿y Paimon qué? ¿A Paimon no le das tus bendiciones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Oh, claro... Pequeña Paimon, ¡que comas y bebas cuanto quieras, duermas bien y crezcas sana y fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "¡Una buena bendición! Pero ¿tú puedes crecer, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "¡Hum! Bueno, Paimon no está del todo convencida, pero ¡acepta tu bendición!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Perfecto, pues aquí termina el ritual de los testigos. Pero antes de que se vayan, debo decirles algo: tengan mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190750,
					"content": "Sí, lo sabemos. Adiós, Pacal y... Uchu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190751,
					"content": "¡Gruuu, mmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "Grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Adiós. Que les vaya muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "¿Aún puedes crecer, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "¡Claro que sí! Ya verás, ¡Paimon crecerá hasta ser tan alta como tres montañas una encima de otra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "¡Tú tampoco te quedas corto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "¡Vamos, ahórrate la lástima! Si fuera un poco más joven, quién sabe quién de los dos habría ganado. Ay, cómo me habría gustado haber peleado contra ti cuando era joven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				}
			]
