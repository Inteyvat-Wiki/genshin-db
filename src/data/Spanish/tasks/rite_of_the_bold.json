			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manqu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "#{NICKNAME}, con el debido respeto... Sé que eres fuerte, pero aun así, ten cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "El jefe Pacal no tiene un nombre antiguo, pero si ha seguido entrenando todos estos años, no te aconsejo subestimar lo fuerte que es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "#Si estás list{F#a}{M#o} para luchar contra él, adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		},
		{
			"id": 7501907,
			"completionStepIds": [
				7501907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
