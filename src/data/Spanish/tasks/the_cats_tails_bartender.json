				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Nada mal... Las bebidas de Cola de Gato no están nada mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "¿Cola de Gato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "#¿Eh? Ah, eres tú, viajer{F#a}{M#o}. ¿Has oído hablar de la taberna Cola de Gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "A juzgar por tu rostro, nunca has estado ahí. Es una verdadera pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "Cola de Gato cuenta con una amplia gama de bebidas curiosas. Estoy seguro de que nunca las has probado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "Además, como su nombre sugiere, Cola de Gato está repleta de felinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Al disfrutar de un buen cóctel rodeado de gatos adorables... es fácil perder la noción del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "¿Está abierta ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "¿Eh? Pero parece que todavía eres muy joven para beber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "En fin, ¡no hay problema! Diona, la mesera de la taberna, es la mejor cantinera de toda Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Para ella debe ser pan comido preparar una bebida sin alcohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "Además, es muy adorable, es como una pequeña gatita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "*Hic... hic*, ¡oh, no! ¡Hablé de más! ¡Por favor, no se lo digas a Diona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "En fin, si quieres ir a Cola de Gato, la entrada está ahí atrás. No hay forma de perderla de vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Yo... eh... Me quedaré aquí hasta que se me pase un poco la borrachera. Bebí demasiado, no creo que pueda aguantar una quinta ronda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Me gustaría ir a probar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}