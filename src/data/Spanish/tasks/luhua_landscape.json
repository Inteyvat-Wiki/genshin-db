			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "¿Encontraste mis utensilios de pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Tal como pensaba, los dejé en el lugar que usé como referencia. Tengo el mal hábito de dejar las cosas que uso en el suelo mientras pinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Cuando tengo prisa, tiendo a dejar las cosas atrás. Muchas gracias. Si no fuera por ti, tendría que volver a la ciudad a comprar más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "¿Vas a seguir pintando aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Ni lo menciones... Escuché a la gente decir que los ojos de ambas estatuas emiten un brillo que puedes ver a esta distancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Estatuas gigantes con dos ojos llameantes, erigidas al lado de la montaña, vigilando... Seguramente será un gran cuadro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "Aunque, al llegar, las estatuas efectivamente estaban allí, pero sin los ojos brillantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Pensé que quizás me perdí un momento especial, o que mi ángulo estaba fuera de lugar, por eso he seguido caminando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Pero no importa dónde me encuentre, el escenario siempre es el mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "Lo único que he conseguido es este objeto que encontré en el estanque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Humm... Yo también encontré uno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "¿En serio? Déjame echarle un vistazo. Vaya... son idénticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Qué extraño, incluso hay palabras grabadas en la parte de atrás. Veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "“Los centinelas de piedra sostienen la puerta como tal, contra aquellos que no añaden un toque final...”. ¿Qué significa esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Bueno, esta piedra no me sirve de nada, ¿por qué no te la quedas? Considéralo como mi agradecimiento por ayudarme a encontrar mis utensilios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "De hecho, tengo una idea. Es solo una suposición descabellada, pero ¿no crees que estas dos rocas parecen ojos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Si realmente son ojos, ¿crees que el “toque final” tiene algo que ver con estas dos piedras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Bueno, es solo una suposición, no le des tanta importancia. Iré en busca de otras vistas, ¡gracias por encontrar mis utensilios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
