			"dialogs": [
				{
					"id": 710061001,
					"content": "¡Oh, ya veo! ¡Entonces estas dos piedras son los ojos de las estatuas! Solamente brillarán después de que los insertes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061002
					],
