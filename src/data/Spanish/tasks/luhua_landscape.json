						710060702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060702,
					"content": "Sobre esa roca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060703
					]
				},
				{
					"id": 710060703,
					"content": "¿Eh? ¿La roca? ¿Por qué de repente tientes tanto interés en ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "La recogí mientras buscaba una buena vista en el <color=#00E1FFFF>Estanque Luhua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "¿Quieres ir al <color=#00E1FFFF>Estanque Luhua</color> para echarle un vistazo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "Tienes que prestar atención, hay todo tipo de cosas en ese estanque. Me pregunto quién las habrá arrojado ahí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
