			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "¿Encontraste mis utensilios de pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060202,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Tal como pensaba, los dejé en el lugar que usé como referencia. Tengo el mal hábito de dejar las cosas que uso en el suelo mientras pinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060204,
					"content": "Cuando tengo prisa, tiendo a dejar las cosas atrás. Muchas gracias. Si no fuera por ti, tendría que volver a la ciudad a comprar más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060205,
					"content": "¿Vas a seguir pintando aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Ni lo menciones... Escuché a la gente decir que los ojos de estas estatuas emiten un brillo que puedes ver a esta distancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060207,
					"content": "Estatuas gigantes con ojos llameantes, erigidas al lado de la montaña, vigilando... Seguramente será un gran cuadro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060208,
					"content": "Aunque, al llegar, las estatuas efectivamente estaban allí, pero sin los ojos brillantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060209,
					"content": "Pensé que quizás me perdí un momento especial, o que mi ángulo estaba fuera de lugar, por eso he seguido caminando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060210,
					"content": "Pero no importa dónde me encuentre, el escenario es el mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060211,
					"content": "Lo único que he conseguido es este objeto que encontré en el estanque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060212,
					"content": "No tengo ni idea de qué es, pero cuanto más lo miro, más se parece a un ojo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060213,
					"content": "Si esto es un ojo de verdad, debe haber otra pieza similar. Después de todo, los humanos tenemos dos ojos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060214,
					"content": "*Suspira*, en fin, es solo una suposición. No le des tanta importancia. Esta piedra no me sirve de nada, ¿por qué no te la quedas? Considéralo como mi agradecimiento por ayudarme a encontrar mis utensilios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060215,
					"content": "Estatuas con ojos brillantes... Me pregunto qué secretos aguardan en el Estanque Luhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
