			"dialogs": [
				{
					"id": 710060801,
					"content": "No, no está bien. No está nada bien... Los ojos de las estatuas no pueden emitir luz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060802
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060802,
					"content": "Quizás estoy usando un método equivocado para buscar el ángulo perfecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060803
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060803,
					"content": "¿Qué ojos? Si la estatua ni siquiera tiene ojos...",
					"roleType": "TALK_ROLE_NPC",
