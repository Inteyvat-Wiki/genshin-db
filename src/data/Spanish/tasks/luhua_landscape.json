				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Oh, esto es terrible. ¿Cómo voy a pintar así?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "#Oh, eres tú, viajer{F#a}{M#o}. Este es el problema: siempre busco inspiración en los alrededores del Estanque Luhua, y quería pintar algunos cuadros para llevar a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Pero no he podido encontrar un buen ángulo, y ninguna de mis pinturas ha sido de mi agrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Estaba tan concentrado en capturar el paisaje, que no me di cuenta de que extravié mis utensilios de pintura hasta que llegué aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "Debo haberlos dejado en algún sitio donde pinté un cuadro anteriormente. ¿Podrías ayudarme a buscarlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "¿Dónde pintaste los cuadros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Ehm, en realidad... no lo recuerdo. Estaba tan absorto en mi pintura que no le presté atención a los alrededores, así que no sabría darte una ubicación específica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Pero en esta área solo he hecho dos cuadros, así que debe estar en uno de esos dos lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Te daré estos dos cuadros. Debo haber dejado mis utensilios de pintura en las áreas que usé <color=#00E1FFFF>como referencia</color> para esos cuadros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Cuando los encuentres, por favor, devuélvemelos. Seguiré explorando por aquí... Estoy seguro de que puedo capturar un mejor ángulo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "¿Por dónde empiezo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Estaba tan absorto en mi pintura que no le presté atención a los alrededores, así que no sabría darte una ubicación específica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Pero solo he pintado dos cuadros en esta área, así que debe estar en uno de esos dos lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
