			"dialogs": [
				{
					"id": 220410301,
					"content": "¿Cómo va tu tarea? ¿Encontraste a Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410302,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "¡Un momento, volvió a escaparse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220410304,
					"content": "¡Voy a buscarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "No, no es necesario ir tras él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410307,
					"content": "Ese minino sigue enfadado con Neko... Neko le dará una lección más tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410308,
					"content": "¡Miau! Ya es casi un gato adulto, ¿por qué sigue siendo tan terco? ¿Qué haríamos si asustara a los humanos que vienen al santuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410309,
					"content": "Ah, sí. Esto es para ti, como agradecimiento por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410310,
					"content": "*Suspira*, ¿por qué no puede portarse tan bien como Anchoa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
