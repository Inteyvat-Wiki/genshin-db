			"dialogs": [
				{
					"id": 220410101,
					"content": "¡Miau! Llegan justo a tiempo. Neko tiene otro problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410102,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "¿Recuerdan a Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410104,
					"content": "Ese bribón se fue a jugar por aquí cerca y aún no ha vuelto. Neko está muy preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410105,
					"content": "Por favor, ve a buscar a Konbumaru y tráelo de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410106,
					"content": "Yo me encargaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "Miauravilloso. Recuerda, tienes que encontrar a Konbumaru y traerlo de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410108,
					"content": "¿Es el único que se fue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "Sí... Tal vez estaba disgustado porque Neko lo regañó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410110,
					"content": "Ay, ¿por qué ese minino nunca escucha a Neko...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410111,
					"content": "En cualquier caso, por favor, encuentra a Konbumaru y tráelo aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
