			},
			"dialogs": [
				{
					"id": 726530101,
					"content": "#¡Viajer{F#a}{M#o}, regresaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530102,
					"content": "Estudié en el barco los fragmentos que trajiste antes. Parece que todavía son muy... “jóvenes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530103,
					"content": "Eso quiere decir que provienen de formaciones elementales recientes... Humm, digamos que son como unas huellas en la nieve dejadas hace poco tiempo, solo que un poco más profundas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530104,
					"content": "Y ahora, me gustaría que me ayudaras a investigar las huellas más “superficiales”... ¡y a rastrearlas hacia el origen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530105,
					"content": "Con “huellas más superficiales” me refiero a los depósitos elementales Electro que se han condensado hasta cierto punto y se encuentran cerca del suelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530106,
					"content": "Si se puede obtener una cierta cantidad de muestras para clasificarlas y compararlas, puede ser posible trazar una hoja de ruta aproximada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530107,
					"content": "Huellas profundas y superficiales, mapas de ruta... Paimon no entiende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726530108,
					"content": "Es realmente difícil de entender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "Jaja, mi analogía puede ser poco acertada, pero naturalmente lo sabrás cuando llegues al lugar del reporte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530110,
					"content": "Bueno, sin más preámbulos, ¡es hora de partir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				}
			]
		}
	]
