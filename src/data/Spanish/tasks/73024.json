					]
				},
				{
					"id": 730240504,
					"content": "¡Y Paimon se llama Paimon! Venimos de otra nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240507,
					"content": "#Ya veo. Humm... No van vestid{F#as}{M#os} como los habitantes del bosque, ni parecen venir del desierto. Parece que llevan ropa transpirable, adecuada para viajar por Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240508
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240508,
					"content": "¡*Ejem*! De todos modos, el deber de un guarda forestal es proteger el bosque, ayudar a los viajeros y orientarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240509
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240509,
					"content": "Como habrán podido comprobar, últimamente el bosque no está... en la condición más ideal. Tanto los Hongos como las bestias se han vuelto agresivos. Y luego están las zonas marchitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240510
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240510,
					"content": "#¿Y si {F#las}{M#los} acompaño? Mi ruta de patrullaje actual pasa por la Aldea Vimara. Desde allí es fácil llegar a la Ciudad de Sumeru o a Puerto Ormos siguiendo el curso del río.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240511,
						730240513
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240511,
					"content": "Bien, en marcha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240512
					]
				},
				{
					"id": 730240512,
					"content": "#De acuerdo, ¡{F#las}{M#los} mantendré a salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240513,
					"content": "Bien, pero antes tengo que encargarme de otra cosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240514
					]
				},
				{
					"id": 730240514,
					"content": "#Entiendo, {F#las}{M#los} esperaré aquí de momento. ¡Tengan cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240505,
					"content": "Venimos de un lugar muy lejano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240506
					]
				},
				{
					"id": 730240506,
					"content": "#¡Exacto! Paimon es Paimon y {F#ella}{M#él} es {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}