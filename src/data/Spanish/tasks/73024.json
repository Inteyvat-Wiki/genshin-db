			"dialogs": [
				{
					"id": 730240101,
					"content": "¡Oh, fueron de gran ayuda! Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240102,
					"content": "Como pueden ver, soy la guarda forestal de por aquí. Me llamo Rhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240103,
					"content": "#Soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "¡Y Paimon se llama Paimon! Venimos de otra nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240107,
					"content": "#Ya veo. Humm... No van vestid{F#as}{M#os} como los habitantes del bosque, ni parecen venir del desierto. Parece que llevan ropa transpirable, adecuada para viajar por Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240108,
					"content": "¿Eh? Si eres una guarda forestal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240109,
					"content": "Conocerás a Tignari, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#¡Oh! {NICKNAME}, ¿tú también conoces a Tignari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240111,
					"content": "Tignari puede parecer un poco inaccesible, pero en realidad es muy buena persona. Me cuidó muy bien cuando yo aún era aprendiz. Y además, tiene unas orejas muy bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240112,
					"content": "¡Cierto! Paimon quería tocarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240113,
					"content": "En realidad, yo también...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "Humm... Paimon piensa que podría tocarlas si se acerca volando sigilosamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240115,
					"content": "¡Jajaja! Tignari se enfadaría si lo haces sin preguntarle primero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240118,
					"content": "¿Verdad que sí? Son tan brillantes... Me pregunto qué tacto tendrán. A la chica que tiene a su cargo también le fascinan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240119,
					"content": "¿Eh? Rhana, ¿acaso te refieres a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240120,
					"content": "¿Es Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#¿Eh? {NICKNAME}, ¿también conoces a Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240122,
					"content": "Collei no tiene muy buena salud. Aun así, trabaja duro para proteger el bosque y eliminar las zonas marchitas. Todos nos preocupamos mucho por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240141,
					"content": "¡*Ejem*! De todos modos, el deber de un guarda forestal es proteger el bosque, ayudar a los viajeros y orientarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240142,
					"content": "Como habrán podido comprobar, últimamente el bosque no está... en la condición más ideal. Tanto los Hongos como las bestias se han vuelto agresivos. Y luego están las zonas marchitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240143,
					"content": "#¿Y si {F#las}{M#los} acompaño? Mi ruta de patrullaje actual pasa por la Aldea Vimara. Desde allí es fácil llegar a la Ciudad de Sumeru o a Puerto Ormos siguiendo el curso del río.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240144,
					"content": "Bien, en marcha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "#De acuerdo, ¡{F#las}{M#los} mantendré a salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240146,
					"content": "Bien, pero antes tengo que encargarme de otra cosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "#Entiendo, {F#las}{M#los} esperaré aquí de momento. ¡Tengan cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240116,
					"content": "Paimon, podrías acercarte volando sigilosamente y tocarlas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "¡Eh! Pero eso haría enfadar a Tignari, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240123,
					"content": "¿Conoces a Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#Humm, {NICKNAME}, ¿conoces a esa muchacha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240125,
					"content": "Collei no tiene muy buena salud. Aun así, trabaja duro para proteger el bosque y eliminar las zonas marchitas. Todos nos preocupamos mucho por ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240126,
					"content": "Pero si la acompaña su instructor, ese tipo cuyas orejas gritan “tócame”, estará segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "Rhana"
				},
				{
					"id": 730240127,
					"content": "¿Eh? ¿Orejas?... ¿Acaso te refieres a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240128,
					"content": "¿Tignari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240129
					]
