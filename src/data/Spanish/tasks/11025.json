				"points": []
			},
			"dialogs": [
				{
					"id": 110240301,
					"content": "Quisiera quedarme aquí un poco más. Me temo que los momentos de nostalgia como este serán cada vez menos frecuentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "Siento un poco de lástima por la Diosa de la Sal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Durante la Guerra de los Arcontes, no juzgábamos el bien y el mal de la misma manera que hoy en día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Ahora bien, tal como lo veo hoy en día, desearía que ella hubiera vivido en tiempos más amables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "¿Las reliquias no fortalecerán a Osial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "El cáliz y la regla de sal aún tienen poder, pero no son nada para Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Aunque un día recupere sus fuerzas y regrese, estoy seguro de que será derrotado de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "¿Qué harás ahora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Es una buena pregunta. Antes, habría podido darte una respuesta concreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Pero ahora... Sí, supongo que seguiré cumpliendo con mi deber como asesor de la Funeraria El Camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "Si este viaje fue de tu agrado, ¿por qué no me acompañas la próxima vez que quiera registrar la historia de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}