			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "Es terrible, ¿qué debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590102,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "#¡Viajer{F#a}{M#o}! ¡Vienes justo a tiempo! ¿Sabes? esta es mi tienda de recuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590104,
					"content": "Mi padre solía comprar el botín de otros aventureros y revenderlo en la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590105,
					"content": "Pero desde que se estableció el Gremio de Aventureros, las cosas no han ido tan bien en la tienda y cada vez menos personas vienen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590106,
					"content": "Y está lleno de cacharros sin valor. Nadie los compraría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590107,
					"content": "#Viajer{F#a}{M#o}, tú estás dispuest{F#a}{M#o} a aventurarte a los cuatro vientos, ¿cierto? ¿Podrías ayudarme y traer un poco de botín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590108,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "¡Te lo agradezco! Si encuentras algo, seguramente podré venderlo a un buen precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590110,
					"content": "¿Qué tal Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "Lo siento... No creo que nadie quiera comprarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590112,
					"content": "Porque... definitivamente huiría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
