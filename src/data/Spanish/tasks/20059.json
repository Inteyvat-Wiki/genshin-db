			},
			"dialogs": [
				{
					"id": 2005910001,
					"content": "Esto es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "#¡Querid{F#a}{M#o} client{F#a}{M#e}! Se ve que tiene buen gusto, ¡con una sola mirada puede reconocer los mejores artículos de nuestra tienda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "#¡Este es un trofeo de batalla arrebatado de la mano de un jefe de Hilichurl no hace mucho, por nada menos que {F#esta viajera}{M#este viajero} de aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "Quién sabe cuánto tiempo ese espantoso Hilichurl granuja había estado amenazando a Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "#¡Y no piense que solo porque {F#esta viajera}{M#este viajero} es {F#una guerrera experimentada}{M#un guerrero experimentado}, no fue una batalla feroz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "¿En serio? Guau... Parece que ese Hilichurl era terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "... Tal vez debería comprarlo y mostrárselo a Cyrus o a Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "Quizás me verían con más respeto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "¡Oh, seguro! Sabemos cómo mantener un secreto en esta tienda, no se preocupe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Mi consejo sería tomarlo ahora, o alguien más seguramente se lo llevará en poco tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "#Tengo que pensarlo... {F#Viajera}{M#Viajero}, ¿es cierto lo que dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
