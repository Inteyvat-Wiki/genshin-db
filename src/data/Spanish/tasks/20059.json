			"dialogs": [
				{
					"id": 2005902001,
					"content": "Humm... Pero no te he dado la más mínima idea de lo que se vende bien, ¿verdad? Apuesto a que no sabes qué buscar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902002,
					"content": "Ahora que lo pienso, ¡podrías buscar <color=#00E1FFFF>trofeos de Hilichurls</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902003,
					"content": "Aquellos aventureros que quieran demostrar su fuerza podrían estar interesados.",
