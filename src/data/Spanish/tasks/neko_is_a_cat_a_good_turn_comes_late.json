			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "¡Viniste! El humano de las piedras dice que está a punto de terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160102,
					"content": "Ven con Neko, el humano de las piedras está justo allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei",
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "Bueno, creo que ya casi está. Qué trabajo tan laborioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160202,
					"content": "Oh, son ustedes, y también la Suma Sacerdotisa suplente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160203,
					"content": "¿Qué tal? ¿Ya está terminada la estatua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160204,
					"content": "¡Sí, por supuesto! Falta una pequeña parte que dejé para completarla cuando usted regresara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160205,
					"content": "Qué considerado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "¡Claro! Las estatuas de los santuarios se deben tratar con mucho respeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160207,
					"content": "Miau, miau... ¿es muy importante picar una piedra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160208,
					"content": "Humm, cómo explicarlo... Normalmente, las cosas que se esculpen en las estatuas son muy importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160209,
					"content": "Paimon, deberías conseguir una estatua de comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "#¡Hum! ¡Qué groser{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722160211,
					"content": "Entonces, ¿dices que las estatuas se hacen de cosas buenas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160212,
					"content": "¡Jajaja! ¡Yo diría que más que buenas! Al fin y al cabo, las estatuas son “memoriales de la eternidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160213,
					"content": "No, no, esto no es ningún “memorial de la eternidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160214,
					"content": "Lo único que Neko pretende es que Hibiki pueda ver esta estatua si regresa y no encuentra el camino a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160215,
					"content": "Así sabrá por dónde tiene que ir y no se perderá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160216,
					"content": "Oh, ya veo. Se preocupa mucho por esa Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160217,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "Hibiki volverá en cualquier momento. Además, ella y Domeki dijeron que pasaría algo bueno cuando la estatua estuviera terminada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160219,
					"content": "Entonces, humano de las piedras, ¿necesitas que Neko haga algo más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160220,
					"content": "No... Bueno, ya que está aquí, Suma Sacerdotisa suplente, puedo esculpir ahora la última parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160221,
					"content": "Tres, dos, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160222,
					"content": "¿Qué es esa nube?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160223,
					"content": "De repente tomó forma de gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "Es Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160226,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "¿Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160228,
					"content": "¡Miau, miau, miau! ¡Seguro que fue Hibiki! ¡Pasó algo bueno, tal y como ella dijo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160229,
					"content": "¡Lo dijo, ella se lo dijo a Neko! ¡Pasaría algo bueno si se completaba la estatua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160230,
					"content": "¡Es miauravilloso! ¡Lo que dijo era cierto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160231,
					"content": "¡Seguro que regresará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160232,
					"content": "Eh... ¡Hurra! No sé qué está pasando, pero si está tan contenta, debe ser algo bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160233,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "Con su ayuda, el santuario vuelve a relucir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160235,
					"content": "El baúl de ofrendas está reparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160236,
					"content": "El estante también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160237,
					"content": "Y la piedra está terminada. Ahora Hibiki regresará, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160238,
					"content": "¡Y Domeki, Janome y todos los amigos de Hibiki también! ¡Seguro que regresarán con ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160239,
					"content": "¡Ustedes son buenas personas! ¡Mejores que la comida! ¡Seguro que le agradarán a Hibiki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160240,
					"content": "Neko tiene que reunir a todos los pequeñuelos y preparar su regreso. Y también debe prepararse para toda la gente que vendrá a visitar el santuario. Sí, Neko también tiene que dar instrucciones sobre eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160241,
					"content": "Y aún quedan muchos asuntos por resolver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160242,
					"content": "Oh, Hibiki... ¡Miau, miau, miau! ¡Es miauravilloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160224,
					"content": "¿Qué está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "La Suma Sacerdotisa suplente está muy contenta. Esa Hibiki debe ser alguien muy importante para ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160302,
					"content": "Pero no sabemos dónde está...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "Todos esos nombres llaman bastante la atención... Hibiki, el Santuario Asase, Domeki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160402,
					"content": "¿De dónde salieron ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "Bueno, estaban armando tal escándalo que tuvimos que acudir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160404,
					"content": "Pero creo que hay algo que deberían saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160405,
					"content": "Taisuke, cuéntaselo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160406,
					"content": "Claro, Etsuko. Lo que tenemos que decirles está relacionado con la Isla Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160408,
					"content": "La historia de esta isla es muy enigmática, y aunque el gremio ha intentado buscar información sobre ella, no hemos encontrado casi nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160409,
					"content": "Según lo que logramos averiguar, hace siglos este era un lugar de encuentro para los piratas. Después, el shogunato acabó con ellos y trasladó a los habitantes a otros sitios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160410,
					"content": "A menos que me equivoque, el “Domeki” del que hablamos podría haber sido el líder pirata “Ako Domeki”, quien decidió enfrentarse directamente al shogunato. Las fuentes escritas registran su nombre claramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160411,
					"content": "Según esa misma información, Ako Domeki lideró a su flota pirata en una batalla naval contra el shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160412,
					"content": "Pero fueron derrotados y forzados a huir a la Isla Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160413,
					"content": "Sin embargo, mientras el shogunato los perseguía, una tormenta estalló de repente en la Isla Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160414,
					"content": "Las flotas de Ako Domeki y del shogunato se vieron envueltas por la tormenta... y desaparecieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160415,
					"content": "Una tormenta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "Yo seguiré con la historia. El mayor misterio era, evidentemente, la aparición repentina de esa tormenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160417,
					"content": "Aunque afectó a la flota de Ako Domeki, la cual fue destruida casi por completo, la flota enviada por el shogunato también se perdió casi totalmente, y los barcos que quedaron se vieron obligados a retirarse a la Isla Narukami. Pasó bastante tiempo antes de que la flota estuviera lista de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160418,
					"content": "Así que fue como si la tormenta comenzara justo en el momento adecuado, como si alguien la estuviera controlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160419,
					"content": "Seguro que recuerdas las piedras sagradas de esta isla. Los sellos que tenían fueron rotos a propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160420,
					"content": "Y, cuando las sellamos otra vez, la tormenta amainó de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160421,
					"content": "No quiero sacar conclusiones precipitadas, pero algo me dice que ambos incidentes están relacionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160422,
					"content": "Bueno, podríamos preguntarle a la Srta. Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160423,
					"content": "No creo que sirva de nada. Según los registros, Domeki desapareció, pero si la tormenta lo alcanzó, entonces lo más probable es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160424,
					"content": "Seguiremos explorando esta isla para recabar información sobre este incidente, y luego informaremos al gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160425,
					"content": "¿Quién sabe? Tal vez podamos trabajar de nuevo juntos en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160426,
					"content": "Espero con ansias ese día.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "Igualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160428,
					"content": "Taisuke, vamos, aún tenemos mucho que explorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160429,
					"content": "Oh, Etsuko, en cuanto a la Srta. Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160430,
					"content": "Puedes seguir tratando a esa gata tal y como lo solías hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160431,
					"content": "Pero recuerda no decir cosas que no debas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160432,
					"content": "Ahora es feliz, así que no hay ninguna necesidad de aguarle la fiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160433,
					"content": "¡Entendido! Jaja, Etsuko, eres tan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160434,
					"content": "Solo quiero que terminemos nuestros encargos con un buen final. Vamos, manos a la obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160435,
					"content": "La Isla Seirai... Parece que aún hay muchos misterios en esta isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160407,
					"content": "¿Qué es lo que saben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}