			"dialogs": [
				{
					"id": 710131401,
					"content": "Futuro lector, ¿tienes las respuestas a mis preguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131402
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710131402,
					"content": "Cualquiera que lea estas palabras debe tener una naturaleza igual que la mía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131403
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710131403,
					"content": "<color=#00E1FFFF>Si te interesa, enterré los pocos tesoros que poseo junto al estanque. Tienes mi bendición para recuperarlos.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710131404,
