			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>Visiones</color>... Realmente provienen del reino del más allá. La gente dice que son un regalo divino, pero nadie sabe quién recibirá una y por qué.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710131502,
					"content": "Según los textos antiguos, los dioses miran con compasión al reino de los mortales y otorga <color=#00E1FFFF>Visiones</color> a los más dignos para ayudarles a luchar contra el mal y proteger el mundo. Pero yo... Ya no deseo desterrar a los monstruos. Solo quiero comunicarme con ellos... Entenderlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710131503,
					"content": "Me da igual tener una <color=#00E1FFFF>Visión</color> o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tesoro de las ruinas"
				}
			]
		},
