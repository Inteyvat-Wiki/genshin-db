			"dialogs": [
				{
					"id": 747070101,
					"content": "... ¡Muy bien! Ahora, hagamos una toma más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Bien. ¡Corten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "¡Furina! ¡Oh, y también Colombina y Chiori! ¿Todavía están aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "¡Así es! Acabamos de terminar de rodar las tomas secundarias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "¡Oh! ¿Se refieren a eso del elenco de peces? ¿Qué tal ha ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Gracias a su ayuda, encontramos al candidato perfecto para el papel. ¡El rodaje salió de maravilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "#L{F#a}{M#o}s dos tienen un talento increíble para esto del acuario. Furina nos estaba contando que incluso la han inspirado para grabar un documental submarino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "Eso es todo un halago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "A mí también me gusta. Puedo sentir lo contentos que están los pececitos nadando por ahí. Han hecho un gran trabajo cuidando de ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747070111,
					"content": "Ojalá este acuario pudiera quedarse aquí para siempre. Así podría venir a visitarlo cuando quisiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Si lo vas a echar tanto de menos, ¿por qué no añades unas cuantas tomas más a la kinografía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Tienes razón. ¡Deberíamos grabar más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "¿Más peces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 747070115,
					"content": "#¡Más tomas! Vamos, iluminador{F#a}, daguerrógraf{F#a}{M#o}, claquetista... ¡Todos a sus posiciones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "¡Paimon está lista! Aunque está claro que pedir tomas para los pececitos es... muy novedoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "Nos alegra que les guste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}