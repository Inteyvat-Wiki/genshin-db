			"dialogs": [
				{
					"id": 220440301,
					"content": "#¡Oh, qué bien! Son suficientes. ¡Muchas gracias, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440302,
					"content": "Ahora tengo que pensar un poco. ¿Cómo voy a tallar la madera en forma de percibetormentas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440303,
					"content": "Si puedo hacer estas decoraciones lo suficientemente bien y tener una variedad de ellas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440304,
					"content": "Tal vez se puedan vender por separado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
