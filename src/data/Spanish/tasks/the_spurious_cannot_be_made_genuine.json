							9393.557
						],
						"pointId": 13574
					}
				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "#Oh, pero si son mis viej{F#a}{M#o}s client{F#a}{M#e}s. ¿Vienen a comprar más cupones de inversión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "He oído que los cupones son una estafa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "Pero ¿qué estás diciendo? ¿No será que estás llegando a conclusiones que no son por haber sufrido tantas pérdidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Piénsalo bien. No puede existir un negocio que solo proporcione ganancias y que no cueste nada. Algunos ganan y otros pierden. Recuerdo que cuando estaba en la Ciudad de Sumeru... *Ejem*, lo que quiero decir es que llevo teniendo mala suerte un buen tiempo, pero nunca se sabe cuándo cambiará eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "La “esperanza” le pertenece a aquellos que persisten. Si siguen invirtiendo, ¡algún día obtendrán ganancias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "Ya veo. Seguiré viniendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "¡Eh! ¡¿Por qué te has dejado convencer tan fácilmente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#¡Si intentas estafarnos, no acabarás bien! Nosotr{F#a}{M#o}s... Eso, ¡somos l{F#a}{M#o}s famos{F#a}{M#o}s {NICKNAME} y Paimon! ¡Que sepas que tenemos muchos amigos en la Villa Nasha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "¿“Amigos”? ¿Qué clase de amigos?... ¡¿N-no será “esa” clase de amigos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "... ¿Eh? ¡Sí! Son justamente “esa” clase de amigos. Y no solo eso, ¡sino que tenemos un montón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "¡¿Cómo?! ¿P-por qué no lo dijeron antes? Lo siento, ¿está bien? Prefiero no meterme en líos. Tomen todo esto, no volveré a venderles cupones de inversión. Váyanse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "No vas a volver a tomarme el pelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
