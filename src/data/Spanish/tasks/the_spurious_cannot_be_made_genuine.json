				]
			},
			"dialogs": [
				{
					"id": 760470101,
					"content": "#Eh... Llevo observándol{F#as}{M#os} a ustedes dos un buen rato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "¿Nos estabas vigilando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "#No, yo suelo venir aquí a buscar libros, pero me he percatado de que estaban interesad{F#a}{M#o}s en invertir. Debo avisarles de que es mejor que no lo hagan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "Es cierto que aún no hemos obtenido grandes ganancias... Pero ¿por qué no deberíamos intentarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Porque sospecho que no existe tal cosa como unas “grandes ganancias”. El jefe del lugar aún tiene muchas deudas de las que hacerse cargo, así que seguramente no quiera arriesgarse a perder nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Un amigo mío también fue víctima de una estafa similar. Por eso les aconsejo que no continúen con ello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#¿De verdad podría tratarse de una estafa?... ¡Debemos encontrar a ese tipo y asegurarnos bien, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
