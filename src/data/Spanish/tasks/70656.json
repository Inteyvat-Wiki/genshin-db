			"dialogs": [
				{
					"id": 706560101,
					"content": "Hola. ¿Vienes a desafiar este dominio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560102,
					"content": "Suena interesante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "Muy bien, te explicaré. Yo soy Plauen, del Gremio de Aventureros, y me encargo de cuidar la entrada a este dominio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560105,
					"content": "Según los registros del Gremio de Aventureros, solo aparece cada cierto tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560106,
					"content": "Por el Festival de las Flores de Viento, hemos modificado un poco el interior para convertirlo en un desafío especial dirigido a todo el que se quiera enfrentar a él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560107,
					"content": "¿No será peligroso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "No hay de qué preocuparse, esta actividad está preparada para celebrar el festival. Para aquellos sin experiencia de aventuras, hay aventureros experimentados que los acompañarán durante el recorrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560109,
					"content": "#Además, tú ya eres {F#una aventurera experta}{M#un aventurero experto}, seguro que no necesitarás nuestra ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560110,
					"content": "#Puedes adentrarte a explorarlo tú sol{F#a}{M#o} o llevar a tu compañera. Como verás, lo único que necesitan es llegar a cruzar para ganar la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560111,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "Bueno, no les quito más tiempo. Espero que se diviertan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560112,
					"content": "Si hay una recompensa, lo haré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "Parece un dominio algo inusual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
