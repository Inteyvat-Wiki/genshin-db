			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Si pudiera hacer un pan delicioso, seguro que animaría a todos. Pero con la situación actual, es algo complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				},
				{
					"id": 760710102,
					"content": "¿Necesitas ayuda con algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Verás, estaba planeando hacer un nuevo tipo de pan, uno que parece un champiñón y que mi mamá solía hacerme cuando era pequeña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				},
				{
					"id": 760710106,
					"content": "Por lo que recuerdo, para hacer este pan primero hay que preparar un relleno con champiñones y bayas, luego se coloca dentro de la masa ya amasada y finalmente meterlo en el horno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				},
				{
					"id": 760710107,
					"content": "Lo más importante es que la harina debe estar molida con centeno fresco, solo así el pan podrá tener un sabor cálido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				},
				{
					"id": 760710108,
					"content": "Venía a recolectar algo de centeno, pero no sé si será porque últimamente mis compañeros no han tenido tiempo de vigilar estos campos, hay muchas criaturas extrañas por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				},
				{
					"id": 760710109,
					"content": "Si el Sr. Valdis estuviera aquí, seguramente podría encargarse de esto. Yo es que no soy muy buena en esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				},
				{
					"id": 760710110,
					"content": "Si fuera posible, ¿podrías ayudarme a recolectar un poco de centeno? Solo necesito un poquito. A cambio, puedo enseñarte a hacer un pan champiñón calentito, porfa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				},
				{
					"id": 760710103,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "¡Ey, no te vayas! ¿Me podrías ayudar con una cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Soldado ratnik"
				}
			]
		},
