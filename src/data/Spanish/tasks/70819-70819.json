				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "Oh... Gracias por su amabilidad. Sin embargo, como monja de la Iglesia de Favonius, no puedo aceptar este regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190202,
					"content": "Para mí es suficiente con sentir el rastro del perfume en la brisa marina. Las cosas hermosas le pertenecen al viento, no a una única persona. Tal es el camino de los devotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190203,
					"content": "Aun así, aprecio su amabilidad, cálida como la brisa del sur. Acepte este libro a cambio, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190204,
					"content": "#Que el Arconte Anemo {F#la}{M#lo} proteja y que el camino que le espera delante esté repleto de virtud, libertad y compasión, al igual que este perfume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hannelore"
				}
			]
		},
