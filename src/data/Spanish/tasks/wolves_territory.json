			"dialogs": [
				{
					"id": 4510501,
					"content": "¿De verdad querer ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510502
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510502,
					"content": "Lobos cazan por instinto. Siempre funcionar. Pero poner trampa suena divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510503,
					"content": "Primero poner trampa, luego perseguir jabalí, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510504,
					"content": "Solo espero no explote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
