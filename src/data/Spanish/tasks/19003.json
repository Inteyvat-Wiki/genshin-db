		{
			"id": 1900303,
			"completionStepIds": [
				1900303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1900303",
							"2"
						],
						"stepId": 1900303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "Oh, has vuelto. Si estás buscando a la hermana Bárbara, aún no ha regresado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030302,
					"content": "Encontramos a Bárbara en el Reino de los Lobos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "Oh, ya veo. Gracias a Barbatos que está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030305,
					"content": "Pero parece que no volverá pronto. Quizás tenga que transferir sus responsabilidades de la Iglesia a otra persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030306,
					"content": "Déjame ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "Es muy amable de tu parte. No querría molestarte, de verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030308,
					"content": "Déjame pensar... Ah, sí, podrías ayudar a limpiar un poco la Iglesia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030309,
					"content": "La gente suele traer polvo al entrar, así que el piso siempre está sucio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030310,
					"content": "La limpieza y esas cosas siempre han sido responsabilidad de la hermana Bárbara, así que, cuando se va, todo comienza a ensuciarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030311,
					"content": "¿Bárbara se encarga de limpiar un lugar así de grande ella sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "Así es. Ella siempre dice que puede arreglárselas sola, y que no necesita que nadie más la ayude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030313,
					"content": "Pero debo decir que se ve muy agotada después de terminar de limpiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030314,
					"content": "#Para ser sincera, me sorprende que estés dispuest{F#a}{M#o} a ayudar, o más bien... que Bárbara esté dispuesta a dejar que la ayudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030315,
					"content": "En fin, si la ayudaras, le quitarías un peso de encima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030316,
					"content": "#Bueno, dejaré que te encargues de la limpieza por ahora, {F#Caballera Honoraria}{M#Caballero Honorario}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030303,
					"content": "Bárbara está en el Viñedo del Amanecer ayudando a Tunner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
		{
