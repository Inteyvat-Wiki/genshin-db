					"nextDialogs": [
						190030702
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030702,
					"content": "Es sobre el itinerario de Bárbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030703
					]
				},
				{
					"id": 190030703,
					"content": "¿Qué? ¿La hermana Bárbara quiere ir al Bosque Susurrante a recolectar hierbas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030704
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030704,
					"content": "#Ya veo... De hecho, solicitó medio día libre para ir a ver a {F#una amiga}{M#un amigo}. ¿Por qué de repente quiere ir a recolectar hierbas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030705,
					"content": "En fin, estoy segura de que tendrá sus motivos... ¿La acompañarás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030706,
					"content": "Sí, iré con ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030707
					]
				},
				{
					"id": 190030707,
					"content": "#Oh, entonces está en buenas manos. Cuida bien de ella, {F#Caballera Honoraria}{M#Caballero Honorario}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030708
					],
					"speakerTitle": "Victoria"
