			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "¿Sí? ¿Se te ofrece algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "Bárbara se tomó el día libre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "#Ah, sí, la hermana Bárbara acaba de enviar su solicitud para tomarse medio día libre. Dijo que tenía planes con {F#una amiga}{M#un amigo}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "Aunque debo decir que es muy inusual que Bárbara pida tiempo libre para ver amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "En fin, eso es un tema aparte. Entonces, ¿qué me querías preguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "Es sobre el... “té espumoso de coral veraniego melancólico”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "¿Oh? ¿Estás diciendo que Bárbara pretende acompañarte a comprar esa... bebida especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "#Entonces tú debes de ser {F#la amiga de la}{M#el amigo del} que hablaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "#Bueno, ya que eres {F#la Caballera Honoraria}{M#el Caballero Honorario}, supongo que no hay problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Está bien, entendido. Por favor, cuida bien de la hermana Bárbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "¿Por qué Bárbara siempre tiene que informar de sus planes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Bueno, como sabrás, la hermana Bárbara es bastante popular en Mondstadt por varias razones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Aunque los ciudadanos tienen buenas intenciones, siempre son muchos, así que quizás ella se sienta agobiada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Si aparecen mientras ella trabaja aquí en la Iglesia, podemos intervenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Pero si sus admiradores se acercan a ella durante su tiempo libre, solo puede valerse por sí misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "Eso sin mencionar que es demasiado... amable. Siempre intentará cumplir con las solicitudes de los ciudadanos de Mondstadt, incluso si esto representa un gran peso para ella y afecta a su trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "Tomando en cuenta eso, pensamos que es mejor que la hermana Bárbara nos diga dónde está, por si acaso tenemos que rescatarla de la multitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "Me gustaría que no fuera tan exigente consigo misma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
