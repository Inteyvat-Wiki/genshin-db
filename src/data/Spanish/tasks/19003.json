			"dialogs": [
				{
					"id": 190030401,
					"content": "#Tu amabilidad no pasará desapercibida, {F#Caballera Honoraria}{M#Caballero Honorario}. Que Barbatos te bendiga.",
					"roleType": "TALK_ROLE_NPC",
