			"dialogs": [
				{
					"id": 220320701,
					"content": "¿Qué plato que tenga pescado podríamos cocinar? Deberíamos escoger uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320702,
					"content": "Veamos... Últimamente, los platos favoritos de Paimon que tengan pescado son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320703,
					"content": "¡El picante estofado de perca de lomo negro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320704,
					"content": "¡El dulce y ácido pescado mandarín agridulce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320705,
					"content": "¡Y el versátil pescado a la parrilla de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320706,
					"content": "¿Esos no son tus platos favoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "Jeje, ¡confía en los gustos de Paimon! Vamos, elige uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320708,
					"content": "Hagamos un estofado de perca de lomo negro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "¡Me parece genial! ¡Preparemos un estofado de perca de lomo negro para la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320710,
					"content": "Cocinaré un pescado mandarín agridulce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "¡Sí! ¡Preparemos un pescado mandarín agridulce para la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320712,
					"content": "Que sea el pescado a la parrilla de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "¡Bien! ¡Preparemos un pescado a la parrilla de Mondstadt para la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320714,
					"content": "Déjame pensarlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "De acuerdo. Preparemos el plato cuando lo hayas decidido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2203208,
