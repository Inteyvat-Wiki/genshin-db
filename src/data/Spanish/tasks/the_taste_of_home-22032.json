			"dialogs": [
				{
					"id": 220320201,
					"content": "¿Ya volviste? ¿Tan rápido? No serás chef, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320202,
					"content": "No puedo esperar, ¡déjame probarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Que lo disfrutes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "¿Qué platos me dijiste que hiciera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Ah, claro... ¡Pescado mandarín agridulce, estofado de perca de lomo negro y pescado a la parrilla de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "¡Vamos a decidir qué le damos a la señorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
