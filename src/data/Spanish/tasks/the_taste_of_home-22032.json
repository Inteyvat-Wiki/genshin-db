					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320401,
					"content": "Humm, este sabor... no me parece que sepa como un plato de Liyue o de Inazuma. Es un sabor nuevo para mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320402,
					"content": "Aunque no es lo que quería comer, me alegra poder degustar un plato tan novedoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320403,
					"content": "#Gracias, viajer{F#a}{M#o}. Acepta esto, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203205,
			"completionStepIds": [
				2203205
			],
