			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320101,
					"content": "Ah, me encantaría comer algo de comida de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320102,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320103
					]
				},
				{
					"id": 220320103,
					"content": "#¿Quién eres tú? La ropa que llevas... Eres {F#una}{M#un} viajer{F#a}{M#o}, ¿verdad? Disculpa, siento un poco de nostalgia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320104,
						220320105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320104,
					"content": "¿Acabas de decir que querías comer algo de comida de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				},
				{
					"id": 220320118,
					"content": "¿Eh? Será que... ¿Sabes hacer comida de Liyue? ¡Eso es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320119,
					"content": "E-entonces, ¡por favor, ayúdame! ¡Prepárame algunos platos auténticos de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320120,
					"content": "Déjame pensar... Lo que más me gustaría comer ahora es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320121,
					"content": "Humm... ¡Quiero comer pescado! Extraño el pescado que me hacía mi mamá cuando era una niña...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320122,
					"content": "Lavaba el pescado, lo abría con un corte, lo rellenaba con especias y vino para cocinar, lo marinaba un poco, lo freía en una sartén hasta que estuviera dorado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320123,
					"content": "... Agregaba agua caliente y la salsa para que cociera a fuego lento y, por último, lo sazonaba todo a fuego rápido, espesaba la salsa, lo colocaba en un plato y... ¡listo! Un plato auténtico y delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320124,
					"content": "Mi hermano menor solía oler la comida mientras saltaba, aplaudía y gritaba: “¡Qué bien! ¡Qué bien!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320125
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320125,
					"content": "*Solloza*, a mi madre se le da muy bien cocinar pescado, ¿pero cuándo podré volver a comerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320105,
					"content": "¿Necesitas ayuda con algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320106
					]
				},
				{
					"id": 220320106,
					"content": "Deja que me presente. Soy Tang Wen, una historiadora de Liyue. Estaba haciendo una investigación de campo sobre las costumbres y el folclore únicos de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320107,
					"content": "Estaba a punto de regresar a Liyue, ya que casi he terminado de recopilar la información que necesitaba. Pero debido al Decreto de cierre de fronteras de Inazuma, terminé atrapada aquí demasiado tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320108,
					"content": "En realidad, creo que podría ser algo bueno. Después de todo, ¡este es un momento histórico para Inazuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320109,
					"content": "Estoy convencida de que este periodo en particular pasará a los anales de la historia de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320110,
					"content": "Ser testigo de esa historia y registrarla de una manera real, completa y clara para la posteridad es lo que debe hacer un historiador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320111,
					"content": "Pero... por muy emocionante que me resulte, esta causa no me llena el estómago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320112,
					"content": "¿Tienes hambre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320113
					]
				},
				{
					"id": 220320113,
					"content": "No es que tenga hambre, es que... Jajaja, la comida de Inazuma es bastante sabrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320114,
					"content": "Me encanta la tempura, aunque me da la sensación de que solo es comida rebozada y frita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320115,
					"content": "Pero después de comer la cocina de Inazuma durante un tiempo, empecé a extrañar los platos de Liyue. Lamentablemente, no pude encontrar un restaurante que pudiera hacer auténtica cocina de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320116,
					"content": "Finalmente, decidí publicar un encargo culinario en el Gremio de Aventureros hace unos pocos días, pero no aún no recibí respuesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320117,
					"content": "Tal vez yo podría intentarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				}
			]
		},
		{
