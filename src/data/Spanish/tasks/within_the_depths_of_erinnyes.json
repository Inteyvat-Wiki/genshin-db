					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851002
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851002,
					"content": "¡Por fin llegamos! Hay mucha contaminación aquí... Aunque no se ve a nadie por aquí cerca, Paimon puede sentir una especie de maldad que le resulta familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851003,
					"content": "Sauce llorón... Raíces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851004
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851004,
					"content": "¿Así que estas son las raíces de ese árbol gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851005,
					"content": "Paimon ya lo entiende todo. ¡Por eso ese árbol gigante que vimos parecía marchito! ¡Porque depende del estado de sus raíces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851006,
					"content": "Raíces... Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851007,
					"content": "#{NICKNAME}, eliminemos primero la contaminación de esta zona... Paimon cree que es lo que está dañando las raíces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
