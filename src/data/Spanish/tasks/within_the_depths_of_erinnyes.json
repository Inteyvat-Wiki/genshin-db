			"dialogs": [
				{
					"id": 740850201,
					"content": "Llave, estatua, llave, estatua, llave, estatua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850202,
					"content": "Humm... ¿Estás diciendo que pongamos las llaves dentro de las estatuas? Eso podría funcionar, tres llaves para tres estatuas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850203,
					"content": "¿Lo intentamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850204,
					"content": "¿Qué sucederá después de poner las llaves en su lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "Puerta abrirse, abrir la puerta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850206,
					"content": "¿Puerta? ¿Dónde? ¿Qué hay detrás de la puerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850207,
					"content": "Raíces, Erinias, muy profundas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850208,
					"content": "¡¿La puerta guía hasta las raíces de las Erinias?! ¡Pahsiv, t-tú sabes muchas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850209,
					"content": "¡Pahsiv, proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850210,
					"content": "¿Hay algo más que necesitemos saber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "... ¿Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850212,
					"content": "Habla de información, cuanto más, mejor. ¡Cuanto más sepamos, más seguridad tendremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850213,
					"content": "¿I-información? I-información... ¡Pahsiv! Información, mucha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850214,
					"content": "¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850215,
					"content": "Erinias, información, mucha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850216,
					"content": "Humm... Mucha información.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850217,
					"content": "Información, corrientes de agua, muchas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850218,
					"content": "Humm... Muchas corrientes de agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850219,
					"content": "Corrientes de agua, Neovalet, muchos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850220,
					"content": "Humm... ¡¿Que qué?! ¡¿Muchos “Neovalet”?! Espera, Paimon no te comprende... ¿Qué quieres decir con “muchos Neovalet”? ¿Neovalet conoce la magia de duplicación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850221,
					"content": "¡Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850222,
					"content": "Corrientes de agua, Neovalet, probar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850223,
					"content": "Maldad, Neovalet, sentir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850224,
					"content": "¿Probar la maldad que hay en las corrientes de agua? Desde luego que hay gustos para todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850225,
					"content": "¿Neovalet es capaz de capturar la información de las corrientes de agua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850227,
					"content": "Sauce llorón, coleccionar. Senda caliginosa, tratar. Manantial, enviar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850228,
					"content": "Raíces, corrientes de agua, centro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850229,
					"content": "¿Las Erinias son el centro de información?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "¿Estás diciendo que todas las Erinias son el sistema de información de Neovalet y que puede percibir las cosas malvadas a través del mismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850231,
					"content": "#¡Inteligente Paimon! ¡Inteligente {NICKNAME}! ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850232,
					"content": "¿Quién sera Neovalet?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850233,
					"content": "Fontaine, Neovalet, proteger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850234
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850234,
					"content": "Pero Neovalet muy ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850235
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850235,
					"content": "Cosa morada, ir hacia raíces a escondidas. Cosa morada destruir raíces a escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850236,
					"content": "Pahsiv, observar a escondidas. Pahsiv, borrar estela a escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850237
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850237,
					"content": "¡Fuiste tú quien borró la inscripción de la estela! ¿Lo hiciste para detener a ese tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850238,
					"content": "¡Pahsiv! Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850239
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850239,
					"content": "Cosa morada, todavía ir a raíces. Cosa morada muy habilidosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850240,
					"content": "¿Encontró otro camino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850241
					]
				},
				{
					"id": 740850241,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850242,
					"content": "Parece que no es fácil lidiar con ese tipo... Si se destruyen las raíces, el sistema de información dejará de funcionar, y la capacidad de percepción de Neovalet se debilitará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850243,
					"content": "¡Pahsiv, responsabilidad! ¡Pahsiv, proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850244,
					"content": "#{NICKNAME}, bum, bum... Paimon, bum, bum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850245
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850245,
					"content": "#¡{NICKNAME}, no podemos esperar más! ¡Tenemos que bum-bum ya mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850246,
					"content": "¡Pahsiv! Abre ya la puerta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850247
					]
				},
				{
					"id": 740850247,
					"content": "¡Genial, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
