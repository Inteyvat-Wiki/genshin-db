			"dialogs": [
				{
					"id": 740851401,
					"content": "Por fin nos deshicimos de la contaminación. Paimon no sabía que Pahsiv tuviera habilidades tan maravillosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851402,
					"content": "Ahora... Espera... El suelo está brillando... ¡Es una formación sobrenatural!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851403,
					"content": "¡Guau! ¡Han aparecido Sabuesos Acechadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851404,
					"content": "Cosa morada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851405
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851405,
					"content": "¡No te preocupes, Pahsiv! ¡Te protegeremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851406,
					"content": "¡Espera! ¿A dónde vas, Pahsiv? ¡No corras! ¡Este lugar es muy peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
