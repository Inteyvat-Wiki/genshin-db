			"dialogs": [
				{
					"id": 740851701,
					"content": "#Uff... Por fin acabamos con ellos, había toda una manada de Sabuesos Acechadores. ¿{NICKNAME}, estás bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851702,
						740851703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851702,
					"content": "Todavía podría seguir dando tundas durante un día entero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851704
					]
				},
				{
					"id": 740851704,
					"content": "Jeje, y Paimon está convencida de que estás alardeando. Parece que las raíces se están recuperando... Entonces, el problema ya ha quedado resuelto, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851705,
					"content": "¿Pero qué acaba de suceder? Un Dragarto viene a ayudarnos y de repente Pahsiv desaparece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851706,
					"content": "¡Oye, Pahsiv! ¿Estás aquí? ¿Nos escuchas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851707,
					"content": "Vaya, parece que desapareció de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851708,
					"content": "Esa melusina guarda muchos secretos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851709
					]
				},
				{
					"id": 740851709,
					"content": "Humm... Realmente es una melusina muy misteriosa. Aunque Paimon en realidad no tenía pensado exigirle una recompensa, es muy raro que se haya esfumado así como así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851710,
					"content": "¿El qué te parece tan raro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851711
					]
				},
				{
					"id": 740851711,
					"content": "Pues... Es tan raro como si tu comida preferida de repente viniera un día y te dijera: “Nuestra relación acaba aquí”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851712,
						740851713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851712,
					"content": "Pues sí que es raro, sí... Y triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851714,
					"content": "Bueno, así es como se siente Paimon ahora. Pero ¿será que Pahsiv está herida? Se la veía muy cansada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851715,
					"content": "Podemos buscarla en los alrededores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851716
					]
				},
				{
					"id": 740851716,
					"content": "¡Sí! Paimon también piensa que hay que encontrarla, no podemos abandonarla a su suerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851717,
					"content": "Espera... ¡¿Qué sucede?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851718,
					"content": "Mientras se preparan para buscar a Pahsiv en los alrededores, de repente comienza a brotar agua del interior de la cueva y, antes de que puedan darse cuenta, se ven arrastrados por una corriente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740851713,
					"content": "Lo raro sería que la comida me hablase.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851703,
					"content": "Solo tengo las manos un poco doloridas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851718
					]
				}
			]
		},
