				"objectNames": [
					"Moke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "¿Qué hacemos?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040102,
					"content": "Adelinde va a regañarnos otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040103,
					"content": "¿Pasó algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "Adelinde nos dijo que limpiáramos la zona de alrededor del viñedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040105,
					"content": "El resto de lugares están bien, pero en los alrededores hay muchos montones de paja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040106,
					"content": "Connor dijo que los puso a propósito donde están porque los necesita para no sé qué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040107,
					"content": "Están bastante bien atados, así que no se vuelan cuando hay mucho viento, pero muchas hojas que cayeron de los árboles se mezclaron con la paja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040108,
					"content": "Lo hemos intentado con todo nuestro empeño, pero no conseguimos quitar todas las hojas por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040109,
					"content": "A este ritmo, Adelinde, la jefa de las criadas, se va a enojar muchísimo... Ya no sabemos qué hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040110,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "¿Eh? ¿En serio? ¡Qué bien! Entonces, confiamos en ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040112,
					"content": "¿Tan difícil es deshacerse de las hojas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "Como se mezclaron con la paja, tenemos que quitarlas una a una con nuestras propias manos. Se tarda muchísimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040114,
					"content": "Si se te ocurre una mejor idea, ¡soy toda oídos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
