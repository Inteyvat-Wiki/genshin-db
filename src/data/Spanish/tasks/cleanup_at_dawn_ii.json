			"dialogs": [
				{
					"id": 201040301,
					"content": "¡¿Qué hiciste?! ¿Por qué quemaste toda la paja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040302,
					"content": "Ahora Adelinde sí que se enojará... ¡Seguro que nos despide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040303,
					"content": "Fue un accidente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "De haberlo sabido, habríamos seguido quitando las hojas una a una por nuestra cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040305,
					"content": "Ya no hay nada que podamos hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040306,
					"content": "Yo... Eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "#{F#Aventurera}{M#Aventurero}, vete, por favor. Ahora esto es responsabilidad nuestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040308,
					"content": "Es nuestra culpa por haberle pedido ayuda a alguien que no sabe limpiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040309,
					"content": "No sé qué hará Adelinde con nosotras cuando se entere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040310,
					"content": "Estamos perdidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
