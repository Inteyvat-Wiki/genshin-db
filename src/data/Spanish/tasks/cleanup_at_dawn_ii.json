			"dialogs": [
				{
					"id": 201040201,
					"content": "¿Qué tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040202
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040202,
					"content": "¿Lograste quitar las hojas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040203,
					"content": "¡Todas y cada una de ellas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "¡Increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040205,
					"content": "#¡Tú sí que eres {F#una aventurera}{M#un aventurero} de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040206,
					"content": "Gracias a ti, Adelinde no nos regañará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "Moke"
				},
				{
					"id": 201040207,
					"content": "Por favor, acepta esto como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040208,
					"content": "Nosotras aún tenemos que seguir limpiando. ¡Gracias de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moke"
				}
			]
		},
