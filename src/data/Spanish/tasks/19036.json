				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji",
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "#¿Qué pasa si {F#la}{M#el} viajer{F#a}{M#o} tampoco está disponible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "Ese es tu problema. Tú decidiste meterte en este embrollo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "#Oh, pero debes de tener mucha suerte, porque tu {F#salvadora}{M#salvador} acaba de llegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "#Oh, ¡viajer{F#a}{M#o}! Regresaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "No te preocupes, ¡estoy libre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "#Hablando {F#de la heroína ociosa}{M#del héroe ocioso}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "¡Jefa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "#Comparado con {F#la}{M#el} viajer{F#a}{M#o}, es usted quien tiene demasiado tiempo libre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "No, estoy muy ocupada. Estoy muy ocupada permaneciendo aquí parada. Tengo que quedarme aquí todo el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "Aunque sea un encargo que no quiere aceptar, esa es una excusa patética.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "¿Un encargo que no quiere aceptar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Sí, por eso te pedí a ti que vinieras. Deja que te lo explique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "Recientemente, uno de los miembros más importantes de la Comisión Tenryou ha desaparecido. Nadie lo ha visto y se desconoce su paradero actual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "La Comisión Tenryou nos encomendó encontrar a esta persona de forma discreta porque sería problemático para ellos buscarla públicamente, debido a varias razones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "Su nombre es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Kujou Sara. Eso es, la general desapareció.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "*Suspira*, si la general hubiera desaparecido de verdad, ya habrían puesto toda la ciudad de Inazuma patas arriba. ¿Y crees que nos encargarían un caso como ese solo a nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "#No hagas caso a las tonterías de la jefa, viajer{F#a}{M#o}. De hecho, el nombre de la persona desaparecida es Shikanoin Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "Trabaja como detective especial en la comisaría de policía y, aunque su rango es solo de guardia, es de lo más competente y es muy valorado en la comisaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "¿Eh? ¿Es más competente que yo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "Jefa, ya que no ayuda, al menos no moleste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "#Disculpa, viajer{F#a}{M#o}, aunque acepté este encargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "Como puedes ver, la jefa no está muy dispuesta a involucrarse en esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "¿Porque la recompensa no es gran cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "¡No! ¡Ni te acercaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "Si me preguntas por qué, es porque me niego rotundamente a ocuparme de los asuntos de ese mequetrefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "Lo único que podría ponerme más contenta que escuchar “Shikanoin está desaparecido” sería escuchar “Shikanoin desapareció hace cien años”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "*Ejem*... No hace falta decir que la jefa Sango y Heizou tienen su historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "Ya entiendo... Son rivales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "*Ejem*... Bueno, probablemente sea algo más serio que eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "Según la jefa, Heizou era un obstáculo en su camino hacia el “Santuario de la Verdad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "¡Es como un perro ladrador que siempre se te pone por medio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "*Suspira*... Aunque Heizou tenga una personalidad bastante... particular, en realidad es un buen tipo. En serio, aprendí mucho de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "#Así que, no puedo quedarme de brazos cruzados, ni aunque la jefa no lo permita. Al menos, puedo encomendar el encargo a alguien capaz y de confianza, ¡como tú, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "#Lo capto, yo soy solo un{F#a} subcontratad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "¿Ah? ¡No, no! ¡No es así! Escucha, pagaré la recompensa prometida por la Comisión Tenryou en su totalidad y, además, pagaré de mi bolsillo algunos gastos adicionales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "#Por eso, espero que aceptes el encargo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "Si Heizou está en peligro, creo que estará más seguro si estás a su lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "¿Son cercanos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "En realidad nos llevamos muy bien, pero la jefa Sango siempre me pide que mantenga las distancias con él y que en público actúe como si no lo conociera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "Así que cuando la gente pregunta, suelo decir que apenas coincidí con Shikanoin algunas veces. Si no fuera por este incidente de hoy, yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "*Ejem*... Bueno, dejémoslo ahí. ¿Podrías ayudarme a buscarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "De acuerdo, me pondré manos a la obra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Bueno, eso es todo. Oh, toma esta petición de encargo de la comisaría de policía. Si encuentras a Heizou, vuelve a la comisaría para reportarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "Claro, pero necesitaré más información.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "¡Genial! Nos han dicho que Heizou se mostró interesado en la Isla Watatsumi antes de desaparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "Durante la guerra, parece haber llevado a cabo alguna misión en la Isla Watatsumi. Y una vez que acabó, también realizó frecuentes viajes de ida y vuelta a la isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "#He oído que tú, viajer{F#a}{M#o}, tienes buena relación con el Santuario Sangonomiya y pensé que quizás ese podría ser el punto de partida de tu investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "Ya veo, y tú eres el intermediario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "¿Porque no hay muchas pistas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "#No hay tiempo que perder, viajer{F#a}{M#o}. Espero que Heizou no esté en peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361502,
					"content": "Cuéntame más sobre Shikanoin Heizou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "Oh, ¡Heizou es un muchacho lleno de vida! Habla por los codos, es muy animado y energético, siempre está en movimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361504,
					"content": "La jefa siempre lo comparaba con una mosca zumbante... Debe ser porque su olfato es capaz de detectar la manzana podrida en el montón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361505,
					"content": "En ese caso, Heizou no sería una mosca común, ¡sería el cabecilla de las moscas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361506,
					"content": "Incluso con la nariz obstruida, los ojos vendados y los oídos tapados, conseguiría detectar la manzana podrida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361507,
					"content": "Sus habilidades son sorprendentes, es como si contara con algo más que cinco sentidos... Ya sabes, ¡como un sexto sentido! ¿Quizás sea pura intuición? ¿Ayuda divina? Tiene que ser algo parecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361508,
					"content": "Ya lo capto, ya tuve suficiente de la metáfora de la mosca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "*Suspira*, la jefa siempre dice que hago el ridículo cuando hablo. Supongo que tiene razón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361510,
					"content": "Esta metáfora apesta, pero sigue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "*Ejem*... Mejor hablamos otro día... La jefa ya nos está mirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
