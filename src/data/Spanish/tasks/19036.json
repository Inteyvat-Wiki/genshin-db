	"talks": [
		{
			"id": 1903614,
			"completionStepIds": [
				1903601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903601",
							"2"
						],
						"stepId": 1903601,
