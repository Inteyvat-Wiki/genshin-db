				"points": []
			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "¿Aún no te has ido? Tal vez cambiaste de opinión en cuanto a lo de buscar a Heizou. Es lo mejor, créeme. No es bueno involucrarse con ese tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "¿Se puede saber qué te sucede con él?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "Deja que te lo explique. No me importaría perderlo de vista para siempre. Eso sucede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "(Sonríes y asientes educadamente).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "No me mires así. Todos tenemos personas que no nos caen bien, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "*Suspira*, de todos modos, será mejor que te pongas en movimiento antes de que Shikanoin cause más problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "Por cierto, si por casualidad te encuentras con sus restos mortales, no olvides avisarme. Eso me alegrará el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
