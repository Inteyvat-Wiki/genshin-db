					"Shibata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "#Ah, ¡eres tú! ¡{F#La Capitana}{M#El Capitán} del Escuadrón Pez Espada n.º 2! Soy Shibata, el encargado de vigilar este lugar. ¿Necesitas algo, {F#mi Capitana}{M#mi Capitán}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "Vengo a preguntar sobre una persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Le cuentas a Shibata sobre el encargo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Ah, ¿se llama Shikanoin Heizou? Sí, lo conozco. Solía pasear por la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Su Excelencia me encomendó que lo vigilara, por si se metía en algún lío. Pero resulta que solo estaba de viaje o algo parecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Ahora que lo recuerdo, creo que también lo vieron recientemente en la zona este de Sangonomiya. Puedes ir allí a buscarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
