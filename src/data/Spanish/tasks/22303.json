			"dialogs": [
				{
					"id": 223030301,
					"content": "Primero veré si puedo utilizar el método de fermentación de Liyue con estos dientes de león.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Cierto, toma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "Seguramente no tendré éxito al primer intento, así que si me quedo sin dientes de león, tendré que volver a pedirte ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
