			"dialogs": [
				{
					"id": 760740101,
					"content": "¡Qué instrumento tan raro!... No importa cómo Paimon lo toque, ¡no emite ni un solo sonido! ¿Estará roto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740102,
						760740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740102,
					"content": "Sigamos primero a esos Seelies.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740103
					]
				},
				{
					"id": 760740104,
					"content": "¿Eh? Pero si he oído el sonido de una lira, y a alguien cantando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740105
					]
				},
				{
					"id": 760740103,
					"content": "Sí, olvidémonos del instrumento por ahora. ¡Sigamos a los Seelies, y seguramente encontraremos el tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740105,
					"content": "¿D-de verdad? Pero Paimon solo oyó el sonido del viento... Espera, ¿será uno de esos casos donde solo quien toca el instrumento puede oír la música?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740106,
					"content": "Está bien, deja que Paimon lo intente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740107,
					"content": "Paimon toca las cuerdas con firmeza...\\n",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760740108
					]
				},
				{
					"id": 760740110,
					"content": "#¡Bah! ¡Sigue sin haber ningún sonido! {NICKNAME}, ¿estás segur{F#a}{M#o} de que oíste algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740111
					],
					"speakerTitle": "Paimon"
				},
				{
