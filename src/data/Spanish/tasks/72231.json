			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310101,
					"content": "La Suma Sacerdotisa suplente está muy contenta. Esa Hibiki debe ser alguien muy importante para ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722310102,
					"content": "Pero no sabemos dónde está...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7223102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223101",
							"2"
						],
						"stepId": 7223101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310201,
					"content": "Todos esos nombres llaman bastante la atención... Hibiki, el Santuario Asase, Domeki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310202,
						722310207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310202,
					"content": "¿De dónde salieron ustedes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310203
					]
				},
				{
					"id": 722310203,
					"content": "Bueno, estaban armando tal escándalo que tuvimos que acudir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310204
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310204,
					"content": "Pero creo que hay algo que deberían saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310205
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310205,
					"content": "Taisuke, cuéntaselo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310206
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310206,
					"content": "Claro, Etsuko. Lo que tenemos que decirles está relacionado con la Isla Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310208
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310208,
					"content": "La historia de esta isla es muy enigmática, y aunque el gremio ha intentado buscar información sobre ella, no hemos encontrado casi nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310209
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310209,
					"content": "Según lo que logramos averiguar, hace siglos este era un lugar de encuentro para los piratas. Después, el shogunato acabó con ellos y trasladó a los habitantes a otros sitios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310210
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310210,
					"content": "A menos que me equivoque, el “Domeki” del que hablamos podría haber sido el líder pirata “Ako Domeki”, quien decidió enfrentarse directamente al shogunato. Las fuentes escritas registran su nombre claramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310211
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310211,
					"content": "Según esa misma información, Ako Domeki lideró a su flota pirata en una batalla naval contra el shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310212
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310212,
					"content": "Pero fueron derrotados y forzados a huir a la Isla Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310213
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310213,
					"content": "Sin embargo, mientras el shogunato los perseguía, una tormenta estalló de repente en la Isla Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310214
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310214,
					"content": "Las flotas de Ako Domeki y del shogunato se vieron envueltas por la tormenta... y desaparecieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310215
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310215,
					"content": "Una tormenta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310216
					]
				},
				{
					"id": 722310216,
					"content": "Yo seguiré con la historia. El mayor misterio era, evidentemente, la aparición repentina de esa tormenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310217,
					"content": "Aunque afectó a la flota de Ako Domeki, la cual fue destruida casi por completo, la flota enviada por el shogunato también se perdió casi totalmente, y los barcos que quedaron se vieron obligados a retirarse a la Isla Narukami. Pasó bastante tiempo antes de que la flota estuviera lista de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310218,
					"content": "Así que fue como si la tormenta comenzara justo en el momento adecuado, como si alguien la estuviera controlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310219,
					"content": "Seguro que recuerdas las piedras sagradas de esta isla. Los sellos que tenían fueron rotos a propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310220
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310220,
					"content": "Y, cuando las sellamos otra vez, la tormenta amainó de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310221,
					"content": "No quiero sacar conclusiones precipitadas, pero algo me dice que ambos incidentes están relacionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310222
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310222,
					"content": "Bueno, podríamos preguntarle a la Srta. Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310223
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310223,
					"content": "No creo que sirva de nada. Según los registros, Domeki desapareció, pero si la tormenta lo alcanzó, entonces lo más probable es que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310224
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310224,
					"content": "Seguiremos explorando esta isla para recabar información sobre este incidente, y luego informaremos al gremio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310225
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310225,
					"content": "¿Quién sabe? Tal vez podamos trabajar de nuevo juntos en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310226
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310226,
					"content": "Espero con ansias ese día.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310227
					]
				},
				{
					"id": 722310227,
					"content": "Igualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310228
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310228,
					"content": "Taisuke, vamos, aún tenemos mucho que explorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310229
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310229,
					"content": "Oh, Etsuko, en cuanto a la Srta. Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310230
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310230,
					"content": "Puedes seguir tratando a esa gata tal y como lo solías hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310231
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310231,
					"content": "Pero recuerda no decir cosas que no debas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310232
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310232,
					"content": "Ahora es feliz, así que no hay ninguna necesidad de aguarle la fiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310233
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310233,
					"content": "¡Entendido! Jaja, Etsuko, eres tan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310234
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310234,
					"content": "Solo quiero que terminemos nuestros encargos con un buen final. Vamos, manos a la obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310235
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310235,
					"content": "La Isla Seirai... Parece que aún hay muchos misterios en esta isla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310207,
					"content": "¿Qué es lo que saben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310208
					]
				}
			]
		}
	]
}