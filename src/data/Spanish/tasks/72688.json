					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726880101,
					"content": "Volvemos a vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880102,
					"content": "La gente disfrutó mucho el arreglo floral de la última vez. Parece que tienen un don para esto, comprendieron la esencia del ikebana en un santiamén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880103,
					"content": "El nuevo acertijo floral está esperando a que lo resuelvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880104,
					"content": "Comencemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "#¡Claro, claro! ¡Ya estamos list{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726880106,
					"content": "En sus ojos percibo un brillo radiante, como si reflejaran un mar de flores tan espectacular que deja sin aliento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880107,
					"content": "El acertijo floral de hoy quizás les resulte un poco más difícil. Así podrán continuar desarrollando sus técnicas de composición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880108,
					"content": "“Rubor robusto, estanque de la nobleza”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880109,
					"content": "Tienen que comprender correctamente el significado del acertijo, seleccionar con meticulosidad las flores y elaborar su arreglo floral con paciencia y esmero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880110,
					"content": "Ahora mismo no me viene bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "No hay problema, el ikebana precisa tener la mente serena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880112,
					"content": "Esperaré a que se ocupen de sus asuntos primordiales y se liberen de sus problemas. Así, podrán elaborar sus arreglos florales con más eficacia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268801",
							"2"
						],
						"stepId": 7268801,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268803",
							"2"
						],
						"stepId": 7268803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "En los próximos días, estaré aquí para orientar a los visitantes del Festival Irodori y para que experimenten las maravillas de los arreglos florales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870202,
					"content": "¡No se olviden de revelar un acertijo floral cada día! En total, habrá cuatro acertijos esperándoles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870203,
					"content": "#Huelga decir que, si tienen cualquier pregunta, haré todo lo posible por ayudarl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870204,
					"content": "¿Qué puedes contarme sobre tus flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "Las flores que uso son todas de la Floristería Sakuya. Son de gran calidad y tienen un precio muy asequible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870206,
					"content": "No sé si conocen a Sakuya, pero ella y yo aprendimos ikebana del mismo maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870207,
					"content": "Sakuya tiene un gran conocimiento sobre este arte, pero cuando escuchó que el Festival Irodori se inundaba de gente, le entró un poco de pánico escénico y dijo que le costaría mucho trabajo hacer arreglos florales con tranquilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870208,
					"content": "Por eso, la ayudaré a promocionar su floristería en el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870209,
					"content": "#Si quieres, ¡nosotr{F#as}{M#os} también podemos ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870219,
					"content": "¿Tienen alguna duda más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870220,
					"content": "Gracias, Srta. Fushizome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "No es nada. Si tienen tiempo, pueden venir a verme cuando quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870210,
					"content": "¿Cuál es el papel de la Comisión Yashiro en esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "La Comisión Yashiro siempre ha apoyado al sector del ikebana en Inazuma. En este caso, la persona que tuvo la gran amabilidad de proporcionarnos la financiación fue la Princesa Garza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870212,
					"content": "Desde pequeña, siempre mostró su increíble talento con este arte. Una vez, la vi hacer una demostración de ikebana y tuve el honor de charlar con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870213,
					"content": "Aunque soy mayor que ella, mis conocimientos sobre el ikebana y los arreglos florales no son nada comparados con los suyos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870214,
					"content": "Siempre que la situación lo permite, la Princesa Garza nos ofrece financiación para promover el arte del ikebana. Incluso escuché que a veces invierte todos sus ahorros en esta causa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870215,
					"content": "Una vez, expresó muy claramente su deseo: que más gente conociera y se interesara por el ikebana para comenzar a estudiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870216,
					"content": "Guau, parece que Ayaka ha hecho mucho por el arte de las flores de Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870217,
					"content": "Ojalá que su deseo se haga realidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "Muchas gracias también a ustedes dos por su apoyo y comprensión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870222,
					"content": "No tengo más preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Pueden venir a verme cuando quieran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		}
	]
}