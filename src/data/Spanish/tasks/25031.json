					}
				]
			},
			"dialogs": [
				{
					"id": 250310501,
					"content": "¿Qué tal? ¿Cómo ha ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310502,
						250310503
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310502,
					"content": "Alrani está a salvo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				},
				{
					"id": 250310504,
					"content": "*Suspira*... Qué susto. Si no llegas a volver, habría tenido que salir yo a buscarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310505
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310505,
					"content": "¿Esa tonta no podía elegir un tema más sencillo? Con su capacidad, seguro que podría aprobar y graduarse con éxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310506
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310506,
					"content": "Siempre elige temas muy amplios, y tras invertir mucho tiempo en prepararlos, acaba quedándose en blanco.",
