					{
						"sceneId": 3,
						"position": [
							-1546.831,
							56.704,
							8112.335
						],
						"pointId": 350400120
					}
				]
			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "Gracias, gracias por tu ayuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Si tan solo me hubiera deshecho de esa maldita mochila antes, ¡podría haberme encargado yo misma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "Entonces, ¡habremos venido a Natlan para nada! ¡Me niego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Espera, ¿tú eres... Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#¿Eh? Tú eres... ¡{NICKNAME}! ¡Eres tú de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "Y la chica que está a tu lado es...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "Narzam, ladrona de tesoros. Nos hemos visto antes, ¿no lo recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "#Buah... Eres mi salvado{F#ra}{M#r}. ¿Cuántas veces me has salvado el pellejo ya? Una, dos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "Aquella vez no cuenta. Fue porque no querías irte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "No la estaba contando. Además, ¿qué quieres decir con eso? Si te pagué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "Con tan poco dinero no podría ni ir a comer algo en condiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "No estarás aquí de nuevo por tu tesis, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Jeje... Con todo lo que me he esforzado, no puedo permitir que haya sido en vano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "Esta vez he solicitado financiación a la Academia, y el proyecto de investigación ya está confirmado. Nada ni nadie podrá interponerse en mi camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "Además, tengo a Narzam de guardaespaldas, así que ella se encargará de ahuyentar a cualquier maleante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Es porque no tenemos mucho dinero, y ellos no quieren meterse en problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "Entonces, lo de antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "... Esta tipa cubrió la mochila que contenía los documentos con todas sus fuerzas, y caminó desde los Vástagos del Eco hasta llegar hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "A decir verdad, a mí me parece una tonta que actúa como si sostuviera un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "Una persona que sostiene un tesoro y camina por lugares desolados con una única persona como escolta... ¿Quién no querría intentarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "¡Así es! Lo que hay en mi mochila es un tesoro. Son todas las entrevistas que he realizado y las transcripciones de varios documentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "¡Con ello, seguro que podré escribir mi tesis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "Hum, el tema de mi tesis es el Peregrinaje del Retorno del Fuego Sagrado. Seguro que es suficiente para graduarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Ay, y todo gracias a la idea que tuvo Tahmures. No esperaba menos de mi amiga, jejeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Gracias de nuevo, {NICKNAME}. De no haber sido por ti, ¡no solo habrían roto mis libros, sino que también se habrían llevado mi dinero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Estuve ayudando a la gente a organizar sus libros y documentos, y me costó mucho ganar algo de dinero, así que si me roban, no tendría Moras para comprar material nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "Sí, pero al final te gastaste todo tu dinero en libros. Si no te hubiera quitado la cartera, ahora mismo estaríamos muertas de hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "N-no he comprando tantos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
					"content": "*Suspira*. Bueno, dejemos el tema. Aún tenemos que ir al Pueblo de los Manantiales a recoger material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310431,
					"content": "¡Nos vemos! ¡La próxima vez que nos veamos, seguro que habré terminado mi tesis! Y, entonces, ¡te invitaré a comer algo delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310418,
					"content": "Y, al final, acabaron metiéndose en problemas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
