						],
						"pointId": 350400084
					}
				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "Qué desastre... Es terrible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310102,
					"content": "¿Hay algún problema con el entrenamiento de Alem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#¡{NICKNAME}! Llegas justo a tiempo. Gracias a los Arcontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310104,
					"content": "No hay tiempo para explicaciones. ¡Por favor, ayúdame a rescatar a una chica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310105,
					"content": "¿Es amiga tuya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "Se podría decir que sí. Hemos sufrido varios colapsos por culpa de nuestras tesis, e incluso hemos llorado varias veces en el hombro de la otra estando en la biblioteca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310108,
					"content": "¡Aaaah! ¡No! ¡No es momento de hablar de esto! ¡Esta muchacha no me hace ni caso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310109,
					"content": "Dijo que haría cualquier cosa por su tesis, y se marchó con esa guardaespaldas suya. ¡Ahora se pasan el día deambulando por ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310110,
					"content": "¡Pero es que todavía no ha regresado! Y la tribu no dispone de personal suficiente para ir a rescatarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310111,
					"content": "#¡{NICKNAME}, te lo ruego! ¡Ve a salvarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310112,
					"content": "Déjamelo a mí. Se me dan bien estas cosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#¡Eres {F#la única}{M#el único} que puede ayudarme, {NICKNAME}! ¡Cuento contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310113,
					"content": "Ustedes, los de la Academia, son de lo que no hay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "Esa chica... *Suspira*, lo único que puedo decir es que tiene muy mala suerte. Cuando vinimos a Natlan, dijo que quería darle una última oportunidad a su tesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310106,
					"content": "¿Es una conocida tuya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
