			},
			"dialogs": [
				{
					"id": 790460101,
					"content": "Todos los actores en posición. Mecanismos listos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "Megafonía del parque"
				},
				{
					"id": 790460102,
					"content": "¡Que dé comienzo “La maldición pupilar”, de «El sueño de tres días de Daiya»!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "Megafonía del parque"
				},
				{
					"id": 790460103,
					"content": "#A las afueras de un denso y misterioso bosque, dos valientes sabi{F#a}{M#o}s se topan con un eidolon hidromimético deambulando en solitario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790460104,
					"content": "Se lo ruego... ¡Ayúdenme! No quiero abandonar a mis amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460105,
					"content": "¿Gotita? ¡¿La Gotita ha hablado?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460106,
					"content": "En realidad, el sonido viene del megáfono.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "Oh, así que esta Gotita es uno de los protagonistas de la obra. ¿Tenemos que cooperar con ella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460109,
					"content": "#Afortunadamente, l{F#a}{M#o}s dos sabi{F#a}{M#o}s han aprendido el lenguaje de los eidolones hidromiméticos y han podido entender su petición de ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790460110,
					"content": "¡Esto debe ser cosa del destino! Con un encuentro tan conmovedor, ¿cómo no ayudar al eidolon hidromimético?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790460111,
					"content": "¿Tenemos nuevos personajes? ¡A Paimon le gusta la idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460112,
					"content": "Centrémonos en el asunto en cuestión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "P-pues... cuando nos perdimos por el bosque, nos encontramos con un viejo castillo, y sin querer despertamos a unos espectros que había...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460115,
					"content": "Dos de sus líderes... nos maldijeron. ¡Y ahora, cuando un espectro nos ve, nos convertimos en piedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460116,
					"content": "Yo apenas logré escapar, pero los demás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460117,
					"content": "*Solloza*... Seguro que están sufriendo mucho... ¿Todo esto es culpa nuestra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460118,
					"content": "¡Claro que no! Incluso aunque te levantes con el pie izquierdo, ¡no es motivo para abusar de los demás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460119,
					"content": "¡Serán canallas! Convertir unas Gotitas perdidas en piedra... Eso ya no es ser abusón, ¡es ser supermalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460120,
					"content": "Les daremos una buena lección.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "No creo. Los dos espectros líderes nunca se muestran a sí mismos, y el castillo es tan grande... que es imposible encontrarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460123,
					"content": "Pero escuché a uno de los espectros decir que, en las profundidades del castillo, hay un cofre con un remedio ancestral capaz de romper la maldición. Es nuestra única esperanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460124,
					"content": "El cofre está encerrado dentro de una cámara secreta, por lo que primero tendrán que encontrar la llave, que estará oculta en algún lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460125,
					"content": "Pero a mí... ya me han maldecido. Si vuelvo solo al castillo, los espectros me verán y me convertiré en piedra para siempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460126,
					"content": "¡No parece nada complicado! ¡Solo tenemos que escoltarte hasta el castillo, buscar la llave y encontrar el remedio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460127,
					"content": "Si podemos ayudarte a evitar que esos espectros te miren, no habría ningún problema, ¿verdad? ¡Pan comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460128,
					"content": "#Así es. Ustedes son... sabi{F#a}{M#o}s, y seguro que saben qué hacer... Se lo suplico, ayúdenme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790460129,
					"content": "Te has metido en el personaje en un santiamén, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "Jeje, no ha sido difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460132,
					"content": "Aunque no podamos derrotar a quien esté detrás de todo esto, ¡darle una paliza a esos espectros y salvar a las Gotitas seguro que puedes hacerlo con los ojos cerrados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460133,
					"content": "No te preocupes, Gotita. ¡Vamos a encontrar ese remedio, eliminar la maldición y rescatar a tus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460130,
					"content": "Adivinaste a la perfección la dirección en la que se dirigía la trama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "¿Bastaría con salvar a tus amigos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "¿Qué le ha ocurrido a tus amigos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "Haz como si fueran las líneas de diálogo de la Gotita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
		{
