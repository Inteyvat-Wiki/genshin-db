				]
			},
			"dialogs": [
				{
					"id": 790460901,
					"content": "Ahora que lo pienso... si una Gotita se ha convertido en piedra, ¿cómo va a tomarse el remedio? Además, ¿cómo puede el agua beber agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460902,
					"content": "¡Oh! ¡Tal vez sea uno de esos remedios de aplicación externa! ¡Habrá que probar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "¡Arg! ¿Pero qué broma es esta? ¡Es imposible evitar todos esos ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461002,
					"content": "¡A Paimon le encantaría darle una tunda a los mecanismos de esos espectros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461003,
					"content": "¡Espera, Gotita! ¿Qué haces? Te van a ver los espectros. ¡Es peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461004,
					"content": "¡Ser insolente! ¿Acaso has perdido el juicio? ¿O simplemente has perdido la esperanza y quieres reunirte con tus amigos en el otro barrio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Espectro líder colérico"
				},
				{
					"id": 790461005,
					"content": "¡Oh, no! ¡Pretende inmolarse y usar su cuerpo para bloquear su mirada! ¿Cómo puede tener semejante espíritu de sacrificio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Espectro líder animado"
				},
				{
					"id": 790461006,
					"content": "¡Qué cambio tan inesperado de la situación! ¡El eidolon hidromimético solitario se ha detenido ante la fatídica mirada espectral, y se está convirtiendo lentamente en piedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790461007,
					"content": "La Gotita ha decidido convertirse en piedra... solo para que podamos llegar a la llave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461008,
					"content": "¡Todavía podemos salvarla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "¡Ah, sí! ¡Cierto! ¡Si no nos detenemos durante mucho tiempo, no debería haber ningún problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461011,
					"content": "¿Acaso la Gotita también se dio cuenta e intentó aprovecharlo? ¡Qué inteligente y valiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461012,
					"content": "#¡{NICKNAME}, rápido! ¡Encontremos la llave y consigamos el remedio! ¡No podemos dejar que la Gotita sufra demasiado tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461009,
					"content": "¡Tenemos que darnos prisa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904612",
							"2"
						],
						"stepId": 7904612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "#El narrador continúa describiendo la fantástica escena ante sus ojos:\\nL{F#a}{M#o}s dos sabi{F#a}{M#o}s vierten lentamente el remedio sobre el cuerpo petrificado del eidolon hidromimético, y un extraño fenómeno tiene lugar...\\nComo si estuviera retrocediendo en el tiempo, el eidolon hidromimético petrificado vuelve a la normalidad...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "*Solloza*... Así que eso es lo que se siente al convertirse en piedra. El dolor, la agonía... ¡No puedo dejar que mis amigos sigan sufriendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790461103,
					"content": "Gotita, ¡¿cómo pudiste lanzarte así sin decir nada?! ¡Casi matas a Paimon del susto! Menos mal que conseguimos el remedio rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461104,
					"content": "El espectro daba mucho miedo, y yo estaba tan asustado que no me atrevía a hablar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790461105,
					"content": "#Además, ustedes son muy sabi{F#a}{M#o}s, así que seguro que no necesitan que l{F#a}{M#o}s avise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790461106,
					"content": "Aunque me convirtiera completamente en piedra, ¡sabía que ustedes me salvarían justo después de conseguir el remedio y que las cosas volverían a la normalidad! Así que no había nada de lo que preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790461107,
					"content": "*Suspira*... ¿Acaso Paimon se metió demasiado en la obra? Estaba muy preocupada por la Gotita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461108,
					"content": "Está bien meterse en el papel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "¡Sí! Paimon es una invitada que ha venido para pasarlo bien, pero Paimon se ha dejado llevar y está un poco avergonzada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461111,
					"content": "Pero bueno, ¡lo importante es que lo hemos conseguido! ¡Ya puedes tomar el remedio y salvar a tus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461112,
					"content": "¡Muchísimas gracias! ¡Estoy en deuda con ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790461113,
					"content": "Mis amigos y yo siempre recordaremos su amabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "Eidolon hidromimético solitario"
				},
				{
					"id": 790461114,
					"content": "¡No ha sido nada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "Paimon espera que esos espectros no vuelvan a dar problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461117,
					"content": "La próxima vez que vayan a jugar al bosque, ¡tengan cuidado! ¡Nada de entrar a este castillo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461118,
					"content": "#¡Bravo! ¡Bravooo! ¡El plan infalible de l{F#a}{M#o}s sabi{F#a}{M#o}s y la valentía del eidolon hidromimético fue la combinación perfecta para acabar con la maldición de los espectros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790461119,
					"content": "#Con la llegada de l{F#a}{M#o}s sabi{F#a}{M#o}s, los espectros no se atreverían a hacer maldades. El eidolon hidromimético solitario y sus compañeros podrán volver a jugar sin preocupaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790461120,
					"content": "Así, el siniestro bosque mostró su lado más tranquilo y apacible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790461121,
					"content": "Y así termina “La maldición pupilar”. ¡Gracias por asistir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "Narración por megafonía"
				},
				{
					"id": 790461122,
					"content": "¡Bieeen! ¡Hemos completado “La maldición pupilar”! ¡A Paimon le ha encantado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461123,
					"content": "Humm... ¡La combinación del argumento con la narración funciona muy bien en el público! Paimon se pregunta dónde habrá aprendido Daiya este tipo de técnicas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461124,
					"content": "¡Si alguna vez tenemos la oportunidad, tenemos que preguntarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461115,
					"content": "¡No te preocupes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "¡Eso significa que lo estabas disfrutando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
