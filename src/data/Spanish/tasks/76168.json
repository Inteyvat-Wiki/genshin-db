			"dialogs": [
				{
					"id": 761680101,
					"content": "Nada me da tanta energía para patrullar como unos deliciosos y calentitos champiñones especiados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680102
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680102,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680103
					]
				},
				{
					"id": 761680103,
					"content": "Estoy preparando los suministros necesarios para la patrulla, pero parece que ya no quedan champiñones ilusorios en el almacén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680104
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680104,
					"content": "Es un nuevo pan que la Srta. Beryna hizo recientemente, y como a todos les encanta, siempre se acaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680105
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680105,
					"content": "Ay, con solo pensar que no podré comer esos champiñones ilusorios, se me quitan todas las ganas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680106
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680106,
					"content": "Creo que sé cómo se hacen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680107
					]
				},
				{
					"id": 761680107,
					"content": "#¿En serio? ¡Qué maravilla, amig{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680108
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680108,
					"content": "Si es así, ¿podrías prepararme unos champiñones ilusorios? Te lo compensaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lantainen"
				}
			]
