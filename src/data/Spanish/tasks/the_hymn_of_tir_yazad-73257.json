			"dialogs": [
				{
					"id": 732572901,
					"content": "Listo. Hemos abierto el pasaje a las profundidades. Nuestro trabajo aquí ha terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572902
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572902,
					"content": "¿Eso fue todo? Como no dejaban de hablar del rito, Paimon pensó que recitarían algún conjuro o algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572903,
					"content": "¡Hum! Solo los humanos requieren de ese tipo de cosas, porque ni siquiera son capaces de controlar los elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572904,
					"content": "Pero las pari somos diferentes, ya que nuestro poder y el de la jvarena tienen el mismo origen. Por ejemplo, ustedes no necesitan recitar conjuros para caminar, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "Humm... Aunque tú flotas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572906,
					"content": "Como Paimon dijo, tienes una lógica de pacotilla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572907,
					"content": "Bueno, no pienso seguir hablando del tema. El resto es tarea suya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572908
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572908,
					"content": "“La eterna jvarena nos guiará en nuestro ascenso”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
