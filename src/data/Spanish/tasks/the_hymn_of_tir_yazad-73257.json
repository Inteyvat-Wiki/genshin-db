			"dialogs": [
				{
					"id": 732571401,
					"content": "Ahora todo está en calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571402,
					"content": "Aprovecha ahora que no brota ponzoña para llevar a cabo el Rito del Chinvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571403,
					"content": "Con eso, habremos cumplido con nuestro cometido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571404
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571404,
					"content": "Y entonces... podré volver a dormir en paz, sin que me molesten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571405
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732571405,
					"content": "¡Sorush, ven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571406,
					"content": "Sorush, apresúrate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571407
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732571407,
					"content": "Tenemos que hacerlo las tres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
