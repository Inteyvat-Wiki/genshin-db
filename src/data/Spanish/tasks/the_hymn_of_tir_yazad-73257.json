					"nextDialogs": [
						732573002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732573002,
					"content": "Originalmente, estos árboles habían sido protegidos con energía jvarena para poder resistir la corrosión de la calamidad, pero después de mucho tiempo la energía fue menguando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573003
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573003,
					"content": "Podemos restaurar su antigua gloria con la nutrición de los himnos de la jvarena.",
