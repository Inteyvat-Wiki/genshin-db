					"nextDialogs": [
						732573004
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573004,
					"content": "Pero ahora que hemos eliminado el sello, la ponzoña del pasado debe haber sido liberada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573005
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573005,
					"content": "Si Rashnu y yo consumimos toda nuestra energía, no podremos llevar a cabo el rito. Por favor, háganse cargo de estas zonas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573006
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573006,
					"content": "Jeje, déjenmelo a mí. ¡El trabajo de una guardiana floral es luchar contra la ponzoña!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
