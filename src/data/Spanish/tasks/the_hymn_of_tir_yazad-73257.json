					"id": 732571701,
					"content": "Humm... ¡Con esto terminamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571702,
					"content": "Parece que han crecido flores en los árboles. ¿Qué hacemos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571703,
					"content": "¿Por qué me miran a mí? Yo tampoco tengo ni idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571704
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571704,
					"content": "Por cierto, ahora que Sorush porta la corona floral bicornia, puede usarla para conectarse con los recuerdos y el conocimiento del Harvisptojm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571705
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571705,
					"content": "Vamos, Sorush. Inténtalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571706
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571706,
					"content": "Sí, ya lo sé, ¡pero todavía no me acostumbro a llevar la corona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571707
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571707,
					"content": "Ah, puedo verlo. A pesar de que han brotado nuevos retoños, no hemos limpiado la ponzoña por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571708
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571708,
					"content": "Aún tenemos que hacer florecer el resto de los árboles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571709,
					"content": "Solo así podremos liberar el poder de la energía jvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
