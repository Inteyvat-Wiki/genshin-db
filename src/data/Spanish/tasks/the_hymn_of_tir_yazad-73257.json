			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "Por cierto, Sorush no ha abierto la boca desde que salimos de la fábrica en ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570102,
					"content": "Durante el camino de ida no se callaba ni debajo del agua. Es muy raro que no diga nada, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570103,
					"content": "¿Se habrá quedado muda de miedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "¡Arriba ese ánimo, Sorush! ¡Todavía nos quedan muchas cosas que hacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570107,
					"content": "Por ejemplo, realizar ese rito de... ese rito con un nombre tan difícil de recordar. Y luego encargarnos de ese agujero enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570108,
					"content": "¡Nos daremos un buen atracón cuando todo haya terminado como premio a nuestro esfuerzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570109,
					"content": "Comeremos... Humm, Paimon no sabe qué cosas les gusta comer a las pari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570111,
					"content": "... Las pari no necesitamos comer, paliducha tonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570112,
					"content": "Ay, nunca pensé que caería tan bajo como para que la paliducha flotante me reconfortase. Qué humillación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570113,
					"content": "Ojalá estuviese sellada en un cristal cenizo, o encontrase una cueva en la que esconderme y dormir hasta que ya no estén en este mundo todos los que me conocen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570114,
					"content": "¡Paimon ya te ha dicho que no la llames paliducha flotante! Pero... ¿existe de verdad una cueva así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570115,
					"content": "Evitar las cosas no es el modo de resolverlas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "¡Qué más da! ¡Ya no me importa nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570119,
					"content": "Me muero de vergüenza cada vez que pienso que ese despreciable de Naseyuna me ha engañado todo el tiempo como a una tonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570120,
					"content": "En fin, ya tenemos todos los himnos. Si quieren solucionar ese fenómeno celeste, vayan a buscar a Mihir o Rashnu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570121,
					"content": "En todo caso, por favor, déjenme en paz y procuren olvidarse de las cosas que les dije.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570122,
					"content": "¿Qué cosas? Porque no son pocas las cosas raras que has dicho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570123,
					"content": "¿“Mi Yasnapati”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "¡Ay! ¡Por favor, no sigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570127,
					"content": "#Vamos, {NICKNAME}, no te metas con Sorush ahora. ¡No podemos abandonarla ahora que hemos pasado por tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570128,
					"content": "Además, tú también tienes muchas cualidades, Sorush. Por ejemplo... Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570129,
					"content": "¡No se te ocurre nada! ¿Verdad? *Buaaa*... ¡Deja de ser condescendiente conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570130,
					"content": "Nunca dudas en pasar a la acción.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Eso, eso. Además, ¿no nos estábamos esforzando para acabar con el fenómeno celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570133,
					"content": "¡Si hemos llegado hasta aquí es gracias a ti, Sorush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570134,
					"content": "#¿Cómo era esa frase?... ¡Oh, Paimon ya se acuerda!: “Mientras no te detengas, convertirse en {F#una gran aventurera}{M#un gran aventurero} solo es cuestión de tiempo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570135,
					"content": "¿De verdad? ¿Me están elogiando con sinceridad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570136,
					"content": "#Claro, ¡como amig{F#as}{M#os} que somos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "¡Jeje! ¡Bueno, después de todo se trata de mí, la gran Sorush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570138,
					"content": "Ya estoy mucho más animada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570139,
					"content": "Pues ya que recuperaste tu motivación, vayamos a buscar a Zurvan. A ver si arreglamos pronto lo del agujero y nos llevamos la recompensa, ¡que a Paimon le está esperando un banquete de celebración!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570131,
					"content": "Tienes un gran sentido de la responsabilidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "¿“Heroica estampa”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "¿“Sacrificio predestinado”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "Aún tienes cosas que hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Sí, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570104,
					"content": "Teniendo en cuenta lo que ha pasado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Quizás solo esté cansada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "¡Zurvan, estamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "Oh, son ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "A juzgar por sus expresiones, deben de haber conseguido todos los himnos, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Sí, aunque hubo algunos contratiempos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Bien está lo que bien acaba. No me equivoqué al encomendarles dicha tarea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Si no fuera por ustedes, esos insidiosos hace tiempo que se habrían apoderado de los himnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "Cualquiera diría que ya sabías que pasaría todo esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "¡Ajá, así que estaba en lo cierto! ¿Se toparon con esos servidores de la oscuridad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "¿Cómo lo sabías?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Bien... En vez de interrogarme, ¿qué tal si me cuentan lo que ocurrió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Le cuentan a Zurvan su aventura en las ruinas subterráneas y la traición de Naseyuna.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "No me esperaba que hasta el Vijñanapati de la Orden de los Escépticos fuese atraído por la oscuridad. Aunque no había depositado grandes esperanzas en ellos, oír estas noticias ha sido un duro golpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "Si no me equivoco, el servidor del abismo con quien pelearon debió ser quien lo incitó a buscar los himnos. Al fin y al cabo, es un viejo conocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "¿Cómo? ¿Conoces a ese tipo de la Orden del Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Así es. Antes era miembro de la Orden de los Escépticos. Hace unos cuantos siglos, vino del bosque un equipo de investigación para indagar en los secretos del pueblo de Dahri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "A pesar de las advertencias de la Orden, insistieron en adentrarse en las ruinas de Dahri. El Vijñanapati de aquel entonces le ordenó acompañarlos para evitar cualquier incidencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "No sé qué ocurrió en las ruinas, pero la siguiente vez que lo vimos ya había sido “bendecido” por la ponzoña, y del equipo de investigación nunca se volvió a saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Como resultado, los seguidores de la oscuridad comenzaron a reunirse con los himnos de la jvarena como objetivo. Para conseguirlos, invocaron numerosos demonios dev para atacar el Piélago Floral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Pudimos proteger el Piélago gracias al esfuerzo de numerosas pari y guerreros humanos. Pero no pudimos eliminar a todos los seguidores de la oscuridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "Para asegurarme de no dejarles ninguna vía de ataque, usé el poder de los himnos de la jvarena para sellar el Piélago Floral y las ruinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "La Orden de los Escépticos sufrió un grave revés debido a esta traición, y perdieron todos sus archivos en un incendio. A partir de entonces fueron cambiando hasta lo que son ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "Cuando hablaron conmigo la última vez, sospeché que ellos estaban detrás de todo. Pero no me esperaba que convertirían al líder de la Orden en su peón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Aun así, Naseyuna dijo algunas cosas que dan que pensar. ¿Sabes tú algo sobre los precursores de la Orden de los Escépticos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "Al fin y al cabo, luchaste junto a ellos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Jaja, la historia se convierte en leyenda, y la leyenda en historia... Así es como surgen las tradiciones. El olvido también es parte de cada historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Cuanto más te aferras a la tradición, más selectivo eres a la hora de recordar lo que quieres, hasta que al final acabas perdido en un laberinto de historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "En este mundo que siempre está olvidando, las huellas que dejamos en la tierra son mucho más duraderas que las canciones lanzadas al viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "Por eso confié en ustedes, porque no parecen unas almas cándidas de esas a las que les importa lo que otros opinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "Aunque parezca que nos está elogiando, a Paimon no le suena del todo bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Creo que lo ha dicho con sarcasmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Eso iba dirigido a mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "#En cuanto a lo que pasó hace quinientos años, es mejor que lo vean ustedes mism{F#as}{M#os} en vez de que yo les cuente otro cuento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "Resulta que ahora tienen la oportunidad perfecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "Por cierto, Sorush, ahora pareces mucho más confiable. Con todo lo que has pasado, ¿se te han quitado ya de la cabeza esos disparates de humanos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "¡Superior! ¡Por favor, todo eso es ahora agua pasada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Parece que darle el encargo a {NICKNAME} y Paimon fue la decisión acertada. En tal caso, me quedo más tranquila dejándoles a ustedes a cargo de completar el Rito del Ab-zohr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "El Rito del Ab-zohr...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "¡Ya lo mencionaste antes! ¿Verdad? ¿No iba de limpiar la mugre o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "El Rito del Ab-zohr es una ceremonia cuyo fin es limpiar la ponzoña del Harvisptojm. En circunstancias normales, es suficiente con llevarlo a cabo debajo de los árboles gigantes que retienen la oscuridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Sin embargo, tras el debilitamiento del sello y la reaparición del fenómeno celeste, la ceremonia tradicional no será suficiente para resolver el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "El fenómeno apareció sobre el Harvisptojm debido a que este absorbió una gran cantidad de ponzoña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "Con tanta ponzoña acumulada en su interior, y la corrosión provocada por el fenómeno celeste, el Harvisptojm no puede conservar energía jvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "La única solución es introducirse en el Harvisptojm, limpiar la ponzoña en su interior y despertar la consciencia de nuestra diosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "¿Entonces podemos entrar en el árbol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "No creerían que había que introducirse en la oscuridad para llevar a cabo el Rito del Chinvat, ¿no? Ni siquiera las pari pueden resistir la ponzoña en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "El Harvisptojm alberga a Gaokerena, un loto gigante en donde dormita la consciencia de nuestra diosa. La flor de la pulcritud brotará y se abrirá de nuevo si eliminamos la ponzoña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "El rocío purificará todas sus impurezas. Puede que parezca complicado, pero no debería ser un problema para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Ya he enviado a Rashnu y a Mihir a la Fisura de Tunigi. Si consiguen traer los himnos, podremos reunir la energía jvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "La jvarena invocará a los grandes árboles que suprimen la ponzoña y purificará el barro de las profundidades. Luego podremos llevar a cabo el Rito del Chinvat y abrir el camino hasta el Harvisptojm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "Una vez dentro del Harvisptojm, la corona floral le mostrará a Sorush las grandes hazañas de los héroes del pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Al fin y al cabo, todos los recuerdos de la jvarena deben volver al Harvisptojm. Nunca desaparecerán, por mucho que este mundo o su historia cambien con el paso del tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "¿Eh? ¡Nunca había oído eso antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Jaja, la corona es también parte del Harvisptojm. Podrás comprobarlo tú misma cuando llegues allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Y ahora, han de partir y poner fin al presagio de Apaosha. Volveremos a vernos cuando el rocío caiga de los cielos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Pues sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Es lo que me temía. Cuéntenme lo que ocurrió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570205,
					"content": "#Sí, pero estoy muert{F#a}{M#o} de cansancio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				}
			]
		},
		{
			"id": 7325704,
			"completionStepIds": [
				7325704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325704",
							"2"
						],
						"stepId": 7325704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rashnu",
					"Mihir",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570401,
					"content": "Uff, pues sí que has tardado, Sorush...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570402
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570402,
					"content": "Llevamos ya un buen rato esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570403,
					"content": "Estoy tan cansada... Quiero volver a casa y dormir... *Ronca*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570404,
					"content": "¡Oye! Eso no es justo. La que se parte el lomo todos los días soy yo. ¡Tú no has hecho nada de nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570405,
					"content": "Todo mentiras. Esperar también es un trabajo muy importante, que lo sepas. De hecho, actuar es algo meramente temporal, mientras que esperar es una tarea eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570406,
					"content": "¿Qué clase de lógica de pacotilla es esa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570407,
					"content": "Así es como funciona la lógica pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570408,
					"content": "Aunque ahora no es momento para eso... Tenemos que centrarnos en los himnos de la jvarena. Supongo que ya los habrán reunido todos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570409,
					"content": "¿Lo dudas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570410,
					"content": "Bien, entonces rompamos el sello. Así podrán usar los himnos para obtener la energía jvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570411,
					"content": "Pero tengan cuidado. La ponzoña se ha acumulado durante años, así que no sabemos qué puede salir de ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
