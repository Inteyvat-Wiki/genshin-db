	"talks": [
		{
			"id": 7325701,
			"completionStepIds": [
				7325701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
