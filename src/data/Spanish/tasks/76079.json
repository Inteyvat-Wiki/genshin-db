			"dialogs": [
				{
					"id": 760790201,
					"content": "Los monstruos que siguen a la Cacería salvaje no carecen por completo de inteligencia. Pueden llegar a mostrar cierto sentido de la estrategia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790202,
					"content": "Por eso no podemos subestimarlos durante el combate, o las consecuencias podrían ser terribles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
