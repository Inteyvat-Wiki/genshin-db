			"dialogs": [
				{
					"id": 760790101,
					"content": "Los monstruos han desaparecido, pero aquí ha quedado una grieta. Y, a través de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790102,
					"content": "Percibo el hedor del Abismo con mucha intensidad. Algo se esconde tras la grieta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790103,
					"content": "¡Sal de ahí! ¿A qué esperas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790104,
					"content": "¿De verdad pensabas que si esperabas a que no hubiera nadie cerca para salir a rastras de la grieta no te descubrirían los Lampareros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
