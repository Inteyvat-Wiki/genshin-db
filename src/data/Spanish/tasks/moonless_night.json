			},
			"dialogs": [
				{
					"id": 60031101,
					"content": "Con el poder de la médula lunar artificial incompleta, la fuerza de Dottore ha alcanzado un nivel que no podemos igualar... No se enzarcen en una batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031102
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60031102,
					"content": "¡Aprovechen la oportunidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031103
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60031103,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60031104,
					"content": "Siempre he creído que huir es más sensato que rendirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031105
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60031105,
					"content": "¿Qué es esto?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031106
					]
				},
				{
					"id": 60031106,
					"content": "¡Cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031107
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60031107,
					"content": "¡No se preocupen por mí, ustedes...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031108
					]
				},
				{
					"id": 60031108,
					"content": "#¡¿Dónde está {NICKNAME}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031109
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60031109,
					"content": "*Tch*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031110
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60031110,
					"content": "Si no podemos avanzar, tendremos que retirarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
