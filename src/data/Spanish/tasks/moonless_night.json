			"dialogs": [
				{
					"id": 60030101,
					"content": "¡Parece que ya estamos todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030102,
					"content": "#Sí, estamos todos listos. {NICKNAME}, Paimon, ¿qué hay de ustedes? ¿Están preparad{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030103,
					"content": "¡Paimon está lista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030104,
					"content": "#¡Yo también estoy list{F#a}{M#o}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "Excelente. Vayamos directos al grano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030113,
					"content": "Entonces, en primer lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030114,
					"content": "¡Espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030115,
					"content": "He oído un sonido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030116,
					"content": "Oímos tus pasos, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030117,
					"content": "#Lleva aquí un rato. ¿Quizás vino siguiendo a {NICKNAME}? Aunque no parece tener malas intenciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030118,
					"content": "Adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030119,
					"content": "Como esperaba, todos reaccionaron muy rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030120,
					"content": "Por orden de mi señora, La Sota, vengo a transmitir su mensaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030121,
					"content": "El hecho de que Dottore fingiera regresar a Snezhnaya era obviamente una excusa. Sin embargo, no volvió a la Oficina de Diseño Experimental Kuuvahki, ni tampoco ha aparecido en la Villa Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60030122,
					"content": "Así que solo puede estar en el laboratorio del extremo norte. ¡Ja! Con razón solicitó su propio espacio... ¡lo tenía todo planeado desde el principio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030123,
					"content": "Diles que Sandrone y yo nos adelantaremos. Si les interesa saber cómo termina esto, nos encontraremos en el centro de investigación que hay más al norte de Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60030124,
					"content": "Ambas son amigas íntimas de la Srta. Colombina, pero aun así no dudaron en compartir información con nosotros antes de partir... Agradezco sinceramente la ayuda de los Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030125,
					"content": "Aunque la Srta. Colombina haya dejado la organización... el afecto que le tienen nuestros superiores es real. Además, por lo que vemos, las acciones de Dottore son todo un misterio. Debemos permanecer alerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030126,
					"content": "Nos hemos enfrentado en varias ocasiones, pero solo ha sido por nuestras posiciones diferentes. Siempre hemos entendido los sentimientos humanos y la moral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030127,
					"content": "Como amigos de la Srta. Colombina que son, tienen derecho a saberlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030128,
					"content": "Como era de esperar de Arlecchino, sabe leer tan bien las situaciones que nos ha ahorrado mucho trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030129,
					"content": "Aquí les dejo el mapa. Si deciden ir al centro de investigación en el extremo norte, tengan mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030130,
					"content": "Y recuerden que, al menos en Nod Krai, los subordinados de La Sota pueden ser sus aliados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030131,
					"content": "Gracias por su consideración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030132,
					"content": "Solo cumplo con mi deber. Me retiro por ahora. Si necesitan algo, pueden encontrarnos en la Oficina de Diseño Experimental Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado de La Sota"
				},
				{
					"id": 60030133,
					"content": "Dottore dejó la Oficina de Diseño Experimental Kuuvahki y se dirigió al centro de investigación más al norte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030134,
					"content": "Sandrone dijo que Dottore ya estaba preparado. ¿Acaso tenía este plan pensado incluso antes de venir a Nod Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030135,
					"content": "Trabajar para la Zarina probablemente era solo una mentira. O quizás, simplemente fingía lealtad mientras actuaba en secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030136,
					"content": "Dottore es decidido en sus acciones, y sus métodos son crueles y malvados. No será fácil enfrentarlo. Debemos estar preparados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030137,
					"content": "En estos momentos, las acciones de Dottore son impredecibles. Sugiero que nos dividamos en dos grupos y dejemos a algunos vigilando la Villa Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030138,
					"content": "Humm... Aunque quisiera ayudar, la verdad es que no soy la mejor candidata para infiltrarme en un centro de investigación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030152,
					"content": "¡Pero al menos llévate al patito bajahumos contigo! Debería ser de ayuda durante la batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030139,
					"content": "Y usted, Srta. Ineffa, ¿se quedará a proteger a la Srta. Aino, como de costumbre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030140,
					"content": "Lógica de acción detectada: proteger a Aino. Prioridad: alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60030141,
					"content": "Por si acaso, sería mejor que el Sr. Varka también se quede aquí. Nosotros nos encargaremos del centro de investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030142,
					"content": "Como Caballero de Boreas, no debería quedarme en la retaguardia en un momento como este, pero... está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030143,
					"content": "Déjenme la Villa Nasha a mí. Y por favor, tengan mucho cuidado. Si la situación se sale de control, asegúrense de retirarse de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030144,
					"content": "Jahoda también les ayudará. Mientras yo no esté, ella se encargará del trabajo de inteligencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030145,
					"content": "Entendido, jefa. ¡Regresen sanos y salvos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030146,
					"content": "¡Lo haremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030147,
					"content": "Es mejor partir temprano. La noche es larga y pueden pasar muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030148,
					"content": "Esta vez la situación podría ser muy peligrosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "Una misión de infiltración, y encima en el centro de investigación... Bueno, ya que planean tener una batalla feroz, Paimon se quedará a ayudar a los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030151,
					"content": "Tendremos que dar lo mejor de nosotros. Antes de eso, ¿hay algo que necesites terminar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030401,
					"content": "Todavía hay algunas cosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "#Entonces, cuando estés list{F#a}{M#o}, partiremos junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030601,
					"content": "#¡Estoy list{F#a}{M#o} para la acción!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "Entonces, ¡será mejor que nos pongamos en marcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030603,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030149,
					"content": "Paimon, deberías quedarte aquí para ayudarlos a todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "Sí. ¿Podemos repasar el asunto una vez más?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "#Jaja, ¿estás un poco nervios{F#a}{M#o}? No te culpo, es la primera vez que nos enfrentamos a algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030108,
					"content": "La Srta. Colombina fue atacada hace poco por Dottore... Y en ese breve instante, la viste desaparecer dentro de aquel reflejo de la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030109,
					"content": "Sí. Cuando ocurrió el incidente, solo vimos aparecer a Dottore y usar algún tipo de poder. Después, Colombina desapareció y tú caíste desde el cielo al mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030110,
					"content": "Debemos rescatar a la Srta. Colombina. Además, debe haber algún motivo por el que Dottore quiera apoderarse de la autoridad de las tres lunas. Tenemos que detenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030111,
					"content": "Recuperar a la Diosa Lunar era originalmente nuestra responsabilidad como Descendientes Lunaescarcha. No esperaba que todos quisieran ayudar... En nombre de los Descendientes Lunaescarcha, les expreso mi más sincera gratitud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030112,
					"content": "Borrar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
