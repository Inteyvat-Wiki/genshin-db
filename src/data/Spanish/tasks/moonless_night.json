					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030803,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Néfer"
				}
			]
		},
		{
			"id": 600309,
			"completionStepIds": [
				600309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"600309",
							"2"
						],
						"stepId": 600309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							335.674,
							288.735,
							245.957
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "Bienvenidos, bienvenidos, los estaba esperando. Espero que les guste mi pequeño laboratorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030902,
					"content": "¿Gustar? ¡Si el camino está lleno de monstruos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030903,
					"content": "¡¿Cómo puedes esperarnos aquí con tanta tranquilidad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030904,
					"content": "Bueno, ¿por qué debería preocuparme? Todo está saliendo según lo planeado, y ustedes llegaron justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030905,
					"content": "Primero Sandrone y Arlecchino, y ahora ustedes. Hoy tenemos bastantes visitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 60030907,
					"content": "Si están buscando a las dos señoritas, debo decirles que Arlecchino desapareció tan pronto como entró en el laboratorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030908,
					"content": "Y Sandrone estaba aquí hace un momento, interrogándome a gritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030909,
					"content": "Ella siempre es así, sin modales. Aunque hay algo que me sorprende. Jamás imaginé que incluso Sandrone empezaría a preocuparse por los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030910,
					"content": "¿Será que todas las personas que se acercan a ustedes terminan así? Aunque eso no es bueno para una investigadora. Es una falta de objetividad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030911,
					"content": "¿Dónde está Sandrone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "Sobre eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030913,
					"content": "Qué ambicioso es tu sueño, Dottore. ¿De verdad crees que la médula lunar te permitirá convertirte en un dios en este mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030914,
					"content": "No me gusta la palabra “dios”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030915,
					"content": "No es que me autoproclame como tal, es que es un hecho. Como investigadora que eres, seguramente entiendes la diferencia entre ambas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030916,
					"content": "¿Eh? ¿Porque tú lo digas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030917,
					"content": "Oh, a las mujeres a veces se nos escapa algún comentario mordaz, pero no le des importancia. Al fin y al cabo, como compañeros que somos, te conocemos a la perfección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030918,
					"content": "Como compañeros que somos, sabía que dirías algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030919,
					"content": "Ambos sabemos que los hechos valen más que las palabras. Por eso, envié a alguien con un pequeño obsequio para que entiendas mejor mi posición actual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030920,
					"content": "¿Un obsequio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030922,
					"content": "¿Qué pasó con tus subordinados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030923,
					"content": "¿Quién sabe? Tal vez siguieron los pasos de un dios desconocido hacia un nuevo mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030924,
					"content": "Aunque carezcas de modales y seas arrogante, querida Sandrone, no descargaré mi ira en tus subordinados por ello. Ellos tienen los mismos derechos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030925,
					"content": "¡¿Cómo te atreves a enviar a tu gente a la Oficina de Diseño Experimental Kuuvahki?! ¡Es el campo de pruebas de su majestad la Zarina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030926,
					"content": "Sí, por supuesto que tenemos muy presente las órdenes de su majestad. Pero como bien sabes, eso no interfiere con mi objetivo actual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030927,
					"content": "Lo único que estoy haciendo es llevar a cabo uno de mis experimentos. ¿Hay algún problema con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030928,
					"content": "¿Qué prefieres apostar? ¿Que estoy mintiendo y solo quiero alejarte de aquí, o que cada palabra que digo es verdad y tus subordinados están en grave peligro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030929,
					"content": "¡Atacar incluso a tus propios soldados Fatui! ¡Has perdido la cabeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030930,
					"content": "Ahora me he impuesto una nueva regla: darle una oportunidad a cada persona. Y por supuesto, haré lo mismo contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030931,
					"content": "Si quieres irte, no te detendré. Después de todo, somos buenos compañeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030932,
					"content": "¡Maldita sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030933,
					"content": "Aunque debo admitir que no esperaba que hasta Sandrone se preocupara por la gente de este mundo. Qué lástima, pensaba que ser egocéntrica era la única virtud que tenía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030934,
					"content": "Si se preocupa tanto por proteger una simple Oficina de Diseño Experimental, ¿qué grandes hazañas podrá lograr con esa mentalidad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030935,
					"content": "Tomar rehenes no es una táctica muy honorable. ¿O acaso ya no le importa su reputación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030936,
					"content": "¿Reputación?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030937,
					"content": "Tengo dos médulas lunares en mis manos, y la tercera está casi lista. ¿Hablarme de reputación a mí, que estoy a punto de convertirme en el dios del nuevo mundo? Qué gracioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030938,
					"content": "¡No eres digno de poseer semejantes reliquias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030939,
					"content": "Y en mi opinión, hay mucha gente en este mundo que no es digna de vivir, pero aun así, ¿no soy misericordioso al permitir su existencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030940,
					"content": "Te arrepentirás de lo que has hecho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "Eso dependerá de si tienen lo que hace falta para hacer que me arrepienta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dottore"
				}
			]
		},
