					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200440101,
					"content": "Ay, ¡qué dolor de cabeza! ¿Qué se supone que debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "¡Estoy entrenando para las pruebas de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440104,
					"content": "*Suspira*, pero no soy tan poderosa como Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440105,
					"content": "Creo que es mejor para mí centrarme en la técnica en lugar de la fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440106,
					"content": "Por ejemplo, estaba pensando en cómo romper todos estos maniquíes de madera de un solo golpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440107,
					"content": "Si tienes tiempo libre, ¿me ayudarías a pensar cómo hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440108,
					"content": "Lo pensaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "Claro, tómate tu tiempo. Después de todo, estos maniquíes no irán a ningún lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440111,
					"content": "Tampoco mi vida va a ninguna parte mientras esté atrapada tratando de resolver esto. *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440114,
					"content": "Si tan solo tuviera un arma más grande, o alguna poderosa habilidad elemental como Jean, romper todos estos maniquíes de madera sería pan comido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440109,
					"content": "#¿Qué tal si lo intentamos junt{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "¿Así que te gusta el combate en equipo? Es bueno tener siempre a alguien que te apoye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440113,
					"content": "Para personas como yo, lo mejor que pueden hacer es intentar subsistir como luchadores solitarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2004402,
