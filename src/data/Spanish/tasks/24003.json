			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "Me pregunto si Verut madurará pronto, *suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030702,
					"content": "¿No te escondes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "No pretendía hacerlo. Si Verut no fuera tan pesado, aprovecharía para leer un rato más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030704,
					"content": "Nuestros padres trabajan muy duro, así que yo tuve que madurar a base de bien para poder aliviarles la carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030705,
					"content": "Pero Verut se pasa los días diciendo lo mucho que echa de menos a mamá, así que no me queda más remedio que hacerle compañía. Así al menos deja de gimotear durante un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030706,
					"content": "Lo siento, creo que me he ido de la lengua. Mejor te espero en el punto de reunión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030707,
					"content": "Espero que Verut no se ensucie la ropa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
