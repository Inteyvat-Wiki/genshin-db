			"dialogs": [
				{
					"id": 240030901,
					"content": "¡Oye! Le has dicho dónde estaba, ¿verdad? ¿Cómo es que me ha encontrado tan rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "Ya te he dicho que te escondes en sitios demasiado obvios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030903,
					"content": "Tengo mucha práctica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "¿De verdad? Entonces, ¿vendrás a jugar otra vez conmigo? ¡Seguro que lo pasamos bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "Nuestros padres nunca están en casa durante el día, y mi hermano se pasa el día leyendo, así que no tengo a nadie con quien jugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Podrías probar a leer un libro de vez en cuando como yo. Es mucho más útil que pasarse el día jugando al escondite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030908,
					"content": "Humm... Preferiría irme con mamá y aprender a coser como ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030904,
					"content": "#Soy {F#la}{M#el} mejor jugando al escondite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				}
			]
		}
	]
