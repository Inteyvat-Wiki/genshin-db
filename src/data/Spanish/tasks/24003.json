					"content": "¡Ah! ¡Me has encontrado! ¿Es que mi hermano te sopló dónde estaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030202,
					"content": "Bueno, está bien, tal vez solo sea que se te da bien este juego. Nos vemos donde antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
