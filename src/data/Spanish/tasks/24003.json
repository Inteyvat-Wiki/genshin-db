			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "¡Seguro que no encuentras mi escondite esta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Si te sigues escondiendo en esos sitios, serán papá y mamá los que vayan a buscarte, no yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030103,
					"content": "¿Qué hacen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "¡Estoy jugando al escondite con mi hermano! Pero siempre me descubre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut, llevamos tanto tiempo jugando a esto aquí que ya no quedan sitios nuevos en los que esconderse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030106,
					"content": "Y sobre los escondites prohibidos, ya te he dicho muchas veces por qué no puedes esconderte en esos sitios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030107,
					"content": "¡Pero si no son tan peligrosos! ¡Mamá y papá son unos exagerados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Si te escondes ahí, te ensuciarás la ropa o la estropearás. Mamá y papá trabajan muy duro de por sí, no deberíamos cargarles con más preocupaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030109,
					"content": "*Suspira*, está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "¿Y si me uno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "¡¿De verdad?! ¿Quieres jugar conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "¡Verut, no molestes a los demás! Lo siento, mi hermanito no piensa en nada que no sea jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030114,
					"content": "No te preocupes, tengo tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "¡Yujuuu! ¿Lo ves? ¡Quiere jugar conmigo! ¡Ya verás, me esconderé mejor que tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "#*Suspira*... Muy bien, gracias por prestarte, amig{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030118,
					"content": "Verut, nada de esconderse en esos sitios que ya hemos hablado, ¿entendido? Si papá y mamá ven que has dejado la ropa hecha un desastre, seguro que no te la arreglan esta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030119,
					"content": "Sí, sí, ya lo sé. Arg, eres un pesado. Yo voy a esconderme, ¡más te vale hacer lo mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Adelántate tú, yo ya sé dónde esconderme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030121,
					"content": "¿En serio? Bah, estás alardeando. ¡Ya verás como te encuentra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurèle y Verut se esconden...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "No te preocupes, no es molestia alguna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "A lo mejor yo no soy capaz de encontrarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
		{
