				"points": []
			},
			"dialogs": [
				{
					"id": 205030201,
					"content": "¿En qué les puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030202,
					"content": "Busco un arma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "Echa un vistazo y elige la que quieras. Si necesitas algo especial, puedo hacerlo bajo pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030207,
					"content": "Guau, hace armas a medida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030208,
					"content": "Por supuesto. Vendemos armas, las hacemos por encargo y las refinamos. En todo eso consiste el trabajo de un herrero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030209,
					"content": "Solamente necesitas los minerales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030210,
					"content": "¿Dónde puedo obtener minerales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "¡Están por todas partes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030214,
					"content": "#Parece que estás confundid{F#a}{M#o}. Bien, ¿y si te digo dónde encontrar pedazos de hierro cerca de aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030215,
					"content": "Si puedes traerme el hierro, te ayudaré a forjar lo que necesites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030216,
					"content": "Excelente. ¡Gracias!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "De nada. Bueno, sigo con lo mío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030212,
					"content": "¿Los vendes aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "No. Tendrás que comprárselos a otra persona. Apenas tengo suficientes para mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030204,
					"content": "Quiero encontrar un arma para Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "¡¿Qué dices?! ¿Ahora me quieres en el frente de batalla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030206,
					"content": "Es un poco pequeña para combatir, ¿no crees? Tendría que forjar un arma a su medida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				}
			]
		},
