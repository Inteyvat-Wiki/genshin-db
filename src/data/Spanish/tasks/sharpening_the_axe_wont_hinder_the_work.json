			"dialogs": [
				{
					"id": 205030601,
					"content": "Si alguna vez encuentras más minerales, puedes venir a verme cuando gustes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030602,
					"content": "Bueno, idealmente cuando no esté ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030603,
					"content": "Pareces estar de mal humor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "El trabajo de un herrero requiere una gran cantidad de concentración. Prefiero no hablar mucho con los clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "Cuando el producto es bueno, el negocio va bien. Eso es todo lo que hay que saber en esta industria, y cualquiera que te diga algo diferente está tratando de engañarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
					"content": "Si no hay nada más, continuaré con mi trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		}
