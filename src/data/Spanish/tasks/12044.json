			"dialogs": [
				{
					"id": 120440901,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440902,
					"content": "#¡Hola! ¿No te sientes como si acabaras de despertar de un sueño? Es increíble que {NICKNAME} haya aparecido en mi sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440903,
					"content": "¿Nos conocemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "Cierta persona suele hablarme de ti. Humm... El perfil que me imaginé basándome en los rumores parece bastante exacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440905,
					"content": "Entonces, ¿tú eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440906,
					"content": "#Cierto. Es la primera vez que nos vemos, {NICKNAME}. Permítanme presentarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440907,
					"content": "Soy Yumemizuki Mizuki, pero pueden llamarme Mizuki. Soy una baku, y una de las youkai de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440908,
					"content": "¿Una baku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440909,
					"content": "¡*Ruuu, ruuu*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "Baku"
				},
				{
					"id": 120440910,
					"content": "Es la cosita de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440911,
					"content": "#Esta es nuestra apariencia original. Imagino que ha sido ella quien l{F#a}{M#o}s ha atraído hasta mi sueño, ¿me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440912,
					"content": "Las baku poseen el poder de devorar las pesadillas de la gente, pero tenemos que digerirlas en nuestros propios sueños. Lo que acabas de ver fue exactamente este proceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440913,
					"content": "#Me he comido demasiadas pesadillas de golpe, lo que ha hecho que se amontonen y no pueda digerirlas bien... Menos mal que l{F#a}{M#o}s trajo hasta mi sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440914,
					"content": "He tenido suerte, y ustedes me han hecho un gran favor. Ahora podré digerir bien esas pesadillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440915,
					"content": "Nos acercamos porque nos dimos cuenta de que no estabas bien, aunque no sabíamos exactamente qué estaba pasando. Paimon se alegra de haber podido ayudarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440916,
					"content": "¡Paimon odia las pesadillas! ¡Los youkai capaces de devorar pesadillas merecen todo nuestro apoyo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440917,
					"content": "Pues, lo siento mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440918,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "Cuando entraste a mi mundo onírico, lo que tomé de ti no fue una pesadilla, sino un sueño feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440920,
					"content": "Me había comido tantas pesadillas que reaccioné como una máquina y mordí sin pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440921,
					"content": "¿Así que las baku también pueden devorar sueños felices? Pero... ¿eso no es algo malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
