			"dialogs": [
				{
					"id": 120440201,
					"content": "Humm... Paimon acaba de acordarse de los días en los que perseguíamos a los tanuki. Qué nostalgia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440202,
					"content": "¿Eh? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440203,
					"content": "¿Un tanuki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "Pero si no se parece en nada, ¿no? ¿Es que hay un nuevo youkai en Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440206,
					"content": "Humm... ¿Acaso quiere que lo sigamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440204,
					"content": "¿Una cría de jabalí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
			"id": 1204403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
