					}
				]
			},
			"dialogs": [
				{
					"id": 120440801,
					"content": "¿Qué acaba de pasar? Paimon solo se quedó mirando a la señorita durante un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440802,
					"content": "Espera, ¿desde cuándo hay tanta gente aquí? ¿Qué hacen aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440803,
					"content": "¿Están haciendo fila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "Sí... ¡Esa señorita aún está allí! Humm... Paimon cree que sabe lo que ha pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440805,
					"content": "Si salgo ahora, ¿tendré tiempo suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 120440806,
					"content": "¿Cuántas veces lo tengo que decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 120440807,
					"content": "Si informo de esto, se acabó... Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 120440808,
					"content": "Humm... Esa ansiedad que surge de la falta de inspiración... La inspiración no suele acercarse a las mentes ansiosas. Esperemos que el tratamiento te ayude a relajarte un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440809,
					"content": "... Gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 120440810,
					"content": "... El arrepentimiento por los errores del pasado y la angustia por la situación actual... Puedo ayudarte a que te enfrentes a ello con más calma, pero tú también tendrás que hacer un esfuerzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440811,
					"content": "... Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "Nishiguchi"
				},
				{
					"id": 120440812,
					"content": "¡Siguiente! *Cof, cof*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440813,
					"content": "¿Te pasa algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440814,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "Estoy bien. Siguiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440816,
					"content": "Esto es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440817,
					"content": "... ¡Guau! ¡Qué rico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440818,
					"content": "Vaya, qué repentino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440819,
					"content": "¿Eh? Esto es... ¡Oh! Lo siento mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440820,
					"content": "#¿Lo sientes? Sinceramente, nosotr{F#a}{M#o}s tampoco tenemos ni idea de lo que acaba de pasar. ¿Podrías explicárnoslo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440821,
					"content": "#Creo que han entrado por error en mi sueño. Permítanme despertarl{F#a}{M#o}s antes de hablar con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440822,
					"content": "¿Un sueño? ¿En qué momento...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440901,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440902,
					"content": "#¡Hola! ¿No te sientes como si acabaras de despertar de un sueño? Es increíble que {NICKNAME} haya aparecido en mi sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440903,
					"content": "¿Nos conocemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "Cierta persona suele hablarme de ti. Humm... El perfil que me imaginé basándome en los rumores parece bastante exacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440905,
					"content": "Entonces, ¿tú eres...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440906,
					"content": "#Cierto. Es la primera vez que nos vemos, {NICKNAME}. Permítanme presentarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440907,
					"content": "Soy Yumemizuki Mizuki, pero pueden llamarme Mizuki. Soy una baku, y una de las youkai de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440908,
					"content": "¿Una baku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440909,
					"content": "¡*Ruuu, ruuu*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "Baku"
				},
				{
					"id": 120440910,
					"content": "Es la cosita de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440911,
					"content": "#Esta es nuestra apariencia original. Imagino que ha sido ella quien l{F#a}{M#o}s ha atraído hasta mi sueño, ¿me equivoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440912,
					"content": "Las baku poseen el poder de devorar las pesadillas de la gente, pero tenemos que digerirlas en nuestros propios sueños. Lo que acabas de ver fue exactamente este proceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440913,
					"content": "#Me he comido demasiadas pesadillas de golpe, lo que ha hecho que se amontonen y no pueda digerirlas bien... Menos mal que l{F#a}{M#o}s trajo hasta mi sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440914,
					"content": "He tenido suerte, y ustedes me han hecho un gran favor. Ahora podré digerir bien esas pesadillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440915,
					"content": "Nos acercamos porque nos dimos cuenta de que no estabas bien, aunque no sabíamos exactamente qué estaba pasando. Paimon se alegra de haber podido ayudarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440916,
					"content": "¡Paimon odia las pesadillas! ¡Los youkai capaces de devorar pesadillas merecen todo nuestro apoyo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440917,
					"content": "Pues, lo siento mucho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440918,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "Cuando entraste a mi mundo onírico, lo que tomé de ti no fue una pesadilla, sino un sueño feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440920,
					"content": "Me había comido tantas pesadillas que reaccioné como una máquina y mordí sin pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440921,
					"content": "¿Así que las baku también pueden devorar sueños felices? Pero... ¿eso no es algo malo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440922,
					"content": "Por supuesto. Los sueños son muy preciados para los humanos, ¿cómo íbamos a devorarlos como si fueran pesadillas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440923,
					"content": "Las baku tenemos una regla no escrita: no podemos devorar los sueños felices de los humanos sin su permiso. He sido muy descuidada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440924,
					"content": "No hace falta que te martirices.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "#¿No te sientes decaíd{F#a}{M#o}? ¿O tal vez te vengan a la mente recuerdos tristes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440927,
					"content": "La verdad es que no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "Es raro que uno pueda mantener un estado mental tan estable después de que un sueño suyo haya sido parcialmente devorado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440929,
					"content": "#Humm... Debe ser porque {NICKNAME} tiene demasiados sueños buenos. ¡No pasa nada por que alguien se coma un poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440930,
					"content": "Pero, aun así, debería ofrecerte una compensación... Por favor, acepta esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440931,
					"content": "Una invitación vip para ir al Balneario Aisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440932,
					"content": "Tenemos varios expertos psicoterapeutas y ofrecemos suministros de aguas termales y comida. Traigan sus preocupaciones, salgan con una sonrisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440933,
					"content": "La dirección está en la invitación. Yo trabajo allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440934,
					"content": "Con esta invitación podrán beneficiarse gratuitamente de los servicios de primera clase que allí se ofrecen... Dicho lo cual, debería volver ya. No puedo dejar la tienda sola mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440935,
					"content": "#Así que, bueno, ¡l{F#a}{M#o}s estaré esperando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440936,
					"content": "Entonces, ¿esa baku también es psicoterapeuta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440937,
					"content": "No me sorprendería.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "Servicios de psicoterapia... Aparte de pensar en cuál va a ser la siguiente comida, no hay mucho que le preocupe a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440940,
					"content": "Por cierto, también ofrecerán comida, ¿no? Con la invitación seguro que habrá comida gratis. ¡No deberíamos perdérnoslo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440938,
					"content": "Fascinante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "Yo me encuentro bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
