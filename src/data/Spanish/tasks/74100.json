			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Babe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "*Olfatea*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003102,
					"content": "¡Guau, guau! Buena persona. ¿Caricia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003103,
					"content": "Claro que sí, buen chico, Babe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Acaricias a Babe.\\nPuesto que Babe es un “perro” hecho de agua, sientas la mano mojada y fría.\\nPero él parece contento y eso es lo que importa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "#¡Guau, guau! Gracias, maj{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003106,
					"content": "La próxima vez, ¿de acuerdo, Babe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "*Solloza*... ¿Babe malo, no caricia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003108,
					"content": "¿Qué tienen que ver las caricias con ser bueno o malo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "¡Guau, guau! Perro bueno, caricia. Perro malo, manota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003110,
					"content": "*Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003111,
					"content": "Al ver lo triste que está Babe, decides acariciarle un poco.Puesto que Babe es un “perro” hecho de agua, sientas la mano mojada y fría.\\nPuedes observar como sus ojitos cristalinos se iluminan de nuevo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "¡Guau, guau! ¡Caricia, gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Babe"
				}
			]
		}
	]
