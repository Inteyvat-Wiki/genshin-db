					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700081101,
					"content": "Oh... Si es un festival tan importante, será mejor beber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081102,
					"content": "Es sobre la nueva bebida promocional de Cola de Gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "¿Quieres que yo la pruebe? ¡Jaja! Bien, no hay problema. Cuando se trata de alcohol, ¡no hay nadie mejor que yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081104,
					"content": "A ver... ¿Eh? Por su sabor... parece que no tuviera ni una gota de alcohol. Sabe como una bebida de leche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081105,
					"content": "Humm, el sabor no está nada mal, pero que no contenga alcohol no me parece muy adecuado para el festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081106,
					"content": "Al fin y al cabo, muchas personas esperan estar “razonablemente borrachas” en este Festival de las Flores de Viento. Así que temo que una bebida sin una gota de alcohol como esta no tenga mucho público.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 7000812,
