					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "Sí, será mejor lanzar una nueva bebida especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080102,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "Oh, eres tú. Bueno, estoy considerando la posibilidad de crear una nueva bebida especial con el tema del Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080104,
					"content": "Durante el festival, todos estarán en la ciudad divirtiéndose y, mientras lo hacen, seguro que también querrán algo de comer y de beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080105,
					"content": "Sin embargo, si solo beben bebidas alcohólicas, se emborracharán fácilmente, y si lo hacen en exceso, puede que los Caballeros de Favonius se los lleven hasta que recobren la consciencia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080106,
					"content": "Por otro lado, el exceso de alcohol también podría estropear un poco la atmósfera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080107,
					"content": "¿De verdad lo crees?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "Aunque... también he oído que a algunas personas les puede gustar mucho ese ambiente de borrachera, pero emborracharse en la calle durante el festival nunca es una buena decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080109,
					"content": "Así que quise lanzar una bebida ligera a base de leche, que también lleve sabor a viento, pero sin alcohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080110,
					"content": "Para acentuar el sabor ventoso, creo que también puedo utilizar dos ingredientes secundarios especiales: dientes de león y margaritas voladoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080111,
					"content": "#Pero si los recolecto yo sola, me voy a demorar mucho... Viajer{F#a}{M#o}, ¿tú podrías ayudarme a recoger los ingredientes secundarios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080112,
					"content": "Entonces yo voy por dientes de león.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "Gracias. Los dientes de león de las cercanías del Acantilado Estrellado son de buena calidad. Te agradecería que me trajeras algunos de allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080114,
					"content": "Yo recolectaré algunas margaritas voladoras. Luego nos volveremos a encontrar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080115,
					"content": "Una vez que la prepare aquí, será fácil encontrar personas que la prueben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080116,
					"content": "Voy en busca de las margaritas voladoras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "Gracias. Las margaritas voladoras cerca de Levantaviento son de buena calidad. Te agradecería que me trajeras algunas de allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080118,
					"content": "Yo recolectaré algunas semillas de diente de león. Luego nos volveremos a encontrar aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080119,
					"content": "Una vez que la prepare aquí, será fácil encontrar personas que la prueben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
