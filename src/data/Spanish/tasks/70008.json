			"dialogs": [
				{
					"id": 700081301,
					"content": "¿Quieres jugar conmigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081302
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081302,
					"content": "Hay una nueva bebida en Cola de Gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081303
					]
				},
				{
					"id": 700081303,
					"content": "¿Cola de Gato? Pero... la señorita Grace dice que los niños no pueden beber alcohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081304
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081304,
					"content": "Es una bebida sin alcohol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081305
					]
				},
				{
					"id": 700081305,
					"content": "¿De verdad? Entonces quiero probarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081306
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081306,
					"content": "#¡Está deliciosa! ¡Dulce y fresca! {NICKNAME}, ¿esta es la nueva bebida de la taberna Cola de Gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081307
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081307,
					"content": "¡Tengo que ir a contárselo a Timmie y a Lily! ¡Seguramente querrán probarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
