				7000815,
				7000817
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "Bien, ahora que tenemos los dos ingredientes secundarios, empecemos a preparar la bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083802,
					"content": "Me pregunto a qué sabrá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "¿Cómo? ¿A ti también te gustaría probar una bebida como esta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083804,
					"content": "Su preparación tampoco es muy complicada. Si sigues mis instrucciones, debe quedar bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083805,
					"content": "#Viajer{F#a}{M#o}, ¿qué tal si... lo intentas tú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083806,
					"content": "Está bien, lo intentaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "No hay problema. Primero te explicaré el proceso para preparar esa bebida, así que presta atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083808,
					"content": "Primero se agregan las <color=#00E1FFFF>flores dulces</color>, luego se vierte el licor base... Claro que, por esta vez, solo usaremos <color=#00E1FFFF>leche</color>. Esto tiene como resultado una base ligera con un sabor dulce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083809,
					"content": "Para darle más sabor, después debes agregar las <color=#00E1FFFF>margaritas voladoras</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083810,
					"content": "Pero no lo mezcles inmediatamente, debe <color=#00E1FFFF>reposar</color> un momento. Deja que la fragancia de la flor infusione lentamente la mezcla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083811,
					"content": "Echa encima las <color=#00E1FFFF>semillas de diente de león</color> y el licor quedará tan bonito como si estuviera lleno de estrellas. Finalmente, terminas con <color=#00E1FFFF>cubos de hielo</color>, y listo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083812,
					"content": "Este es el proceso. Si quieres preparar una bebida refrescante, no puedes hacer los pasos como te dé la gana, hay que recordarlos muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083813,
					"content": "Si lo recuerdas bien, vamos, inténtalo. Si te olvidaste algo, me lo puedes preguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
