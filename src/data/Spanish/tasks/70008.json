					"nextDialogs": [
						700081403
					]
				},
				{
					"id": 700081403,
					"content": "Durante el Festival de las Flores de Viento, estar “razonablemente borracho”... Con razón El Obsequio del Ángel está a reventar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081404
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081404,
					"content": "Aun así, esta opción tampoco está mal. Aparte de todos los borrachos, los niños y los guardias de turno también necesitan una bebida especial de temporada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081405
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081405,
					"content": "Seguiré perfeccionando esta bebida. Por cierto, gracias por ayudarme. Toma, esta es tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081406
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081406,
					"content": "Cierto, te deseo un feliz Festival de las Flores de Viento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
