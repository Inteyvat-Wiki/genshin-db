			"dialogs": [
				{
					"id": 700081201,
					"content": "¡Saludos! ¿En qué le puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081202
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081202,
					"content": "Es sobre la nueva bebida promocional de Cola de Gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081203
					]
				},
				{
					"id": 700081203,
					"content": "Lo siento, ahora estoy de servicio, así que lo de la bebida será mejor evitarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081204
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081204,
					"content": "Es una bebida sin alcohol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081205
					]
				},
				{
					"id": 700081205,
					"content": "¿No tiene alcohol? Oh, entonces me sirve... Tengo mucha sed. Gracias, la probaré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081206
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081206,
					"content": "Oh, sabe muy bien. Además, su frescura es revitalizante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081207
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081207,
					"content": "¿Es la nueva bebida de Cola de Gato? Cuando tenga tiempo libre, iré allí para beber más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
