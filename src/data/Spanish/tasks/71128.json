			"dialogs": [
				{
					"id": 711280201,
					"content": "“Cuando este árbol haya crecido un poco más, usaré sus hojas para servirles un buen té”.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "“Entonces, invitaré a Preservadora de Nubes y a Moldeador de Montañas...”.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "“¿Plantas este árbol en mi territorio y, aun así, tienes la vergüenza de decir eso?...”.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "... El día en que la promesa de antaño pudiera cumplirse no llegó, pero el árbol silencioso aún recuerda aquella promesa...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "... Hoy, el aroma del té se ha extendido por todo el Valle Chenyu, volando a lugares lejanos...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
