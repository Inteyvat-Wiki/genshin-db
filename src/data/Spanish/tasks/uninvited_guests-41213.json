			"trigger": {
				"objectNames": [
					"El Temerario Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130301,
					"content": "Puff... Puff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 412130302,
					"content": "¡¿Señor Pallad?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130303,
					"content": "¿A-aún no se ha ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130304,
					"content": "¿No es ese aventurero impulsivo de Mondstadt? ¿También vino aquí con Cyrus para explorar la montaña nevada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130305,
					"content": "¡Qu-qu-qué f-f-frío! ¡Achís!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 412130306,
					"content": "¡¿Ha estado aquí desde que le saqué del foso de nieve?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130307,
					"content": "Quería irme, p-pero me perdí. Lo siento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 412130308,
					"content": "Ay... Hace m-mucho f-frío, n-no p-puedo ni m-moverme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 412130309,
					"content": "*Suspira*, señor Pallad, se necesita mucha preparación para viajar a esta montaña. No debería tomárselo tan a la ligera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130310,
					"content": "Lo llevaremos de vuelta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "Agradezco tu apoyo. Me temo que en su estado actual no puede caminar solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130312,
					"content": "Aunque no pudiéramos, no podemos dejarlo aquí, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130313,
					"content": "#Tienes razón... Lo siento, viajer{F#a}{M#o}. Acepta mis disculpas en su nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130314,
					"content": "Él es la menor de tus preocupaciones en este momento. ¡Deberías estar preocupada por ti misma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 412130315,
					"content": "¡Ah! ¡Los Fatui atacan de nuevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130316,
					"content": "Supongo que ya saben por qué estamos aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130317,
					"content": "No los dejaremos ir, a menos que nos entregues la espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130318,
					"content": "¡No! ¡Por favor, no les des la espada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130319,
					"content": "¡Claro que no se la entregaré!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "¡Esa es la actitud! ¡Eliminémoslos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130322,
					"content": "Sr. Pallad, lo llevaré a un lugar seguro. ¡Venga, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130323,
					"content": "¡Qué ingenua! ¡No dejaremos escapar a ningún testigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130324,
					"content": "¡Esta espada será un excelente regalo para Su Excelencia, Signora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130320,
					"content": "¡Ni se te ocurra ponerle las manos encima!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
