			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sacarosa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "¡Albedo, estamos de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130102,
					"content": "¿Eh? Parece que no está aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130103,
					"content": "¿Estará investigando algo? ¿O tal vez fue a hacer algunos bocetos misteriosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130104,
					"content": "¡Ah, son ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130105,
					"content": "¡Es Sacarosa! ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130106,
					"content": "Estoy en la etapa final de mi investigación. Hoy tengo cinco horas y veintiséis minutos de tiempo libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130107,
					"content": "#Por eso vine aquí a buscarl{F#as}{M#os}, para preguntarles sobre lo que hablamos antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130108,
					"content": "¡Qué precisión! ¿Eres un reloj humano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130109,
					"content": "N-no, no es tan increíble. Eres muy amable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130110,
					"content": "¡Eso no fue un cumplido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130111,
					"content": "#¿P-puedo hacerte una pregunta, viajer{F#a}{M#o}? Te pedí que averiguaras el secreto del señor Albedo. ¿Ha habido algún progreso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130112,
					"content": "Corrígeme si me equivoco, pero ha pasado más de una semana desde que hablamos de eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130113,
					"content": "Pensé que lo habías olvidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130115,
					"content": "¡¿M-más de una semana?! Obviamente... yo... ¡Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130116,
					"content": "Eh... He estado tan concentrada en mi investigación, que lo olvidé por completo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130117,
					"content": "¿Cómo puede tu sentido del tiempo ser tan fuerte y tan débil al mismo tiempo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130118,
					"content": "E-entonces, ¿ya averiguaste de qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130119,
					"content": "Sí, por así decirlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "Excelente. ¿Podrías decírmelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130122,
					"content": "¿Qué piensas, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Eh... No hace ningún daño que se lo digamos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130124,
					"content": "Puede ver, pero no tocar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130125,
					"content": "Un momento, ¿de qué están hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130126,
					"content": "¿Qué es esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130127,
					"content": "El secreto de Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "Es una espada superpoderosa. ¡No la toques con las manos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130130,
					"content": "Oh... esta es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130131,
					"content": "¡Ah! ¡Nunca antes la había visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130132,
					"content": "¡Jeje, mírala todo lo que quieras! No sé por qué, pero incluso Paimon siente una extraña sensación de logro al verla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130133,
					"content": "¡Fascinante! Es la primera vez que escucho algo sobre un arma tan misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130134,
					"content": "Puedo sentir débilmente el poder que recorre la espada... Es como una criatura viviente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130135,
					"content": "¿Tan peculiar es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130136,
					"content": "Tal vez se deba a mi formación como alquimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130137,
					"content": "No puedo afirmar nada, pero tiene un gran flujo de poder. No, esa no es la mejor manera de describirlo... L-lo siento, normalmente no describo las cosas así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130138,
					"content": "¡Tienes que creerme, por favor! ¡Nunca usaría unos términos tan ambiguos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130139,
					"content": "Está bien, está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130140,
					"content": "#Viajer{F#a}{M#o}, ¿puedes usar esta espada para pelear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130141,
					"content": "Me gustaría saber más sobre ella, pero yo misma no la puedo usar. Solo puedo recurrir a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130142,
					"content": "Hay que mantener un perfil bajo, no podemos dejar que Albedo se entere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "¡Busquemos un lugar adecuado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130143,
					"content": "Hay que encontrar un lugar donde nadie nos vea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "La respuesta que buscabas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "Mi investigación fue exitosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
			"completionStepIds": [
				4121305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121305",
							"2"
						],
						"stepId": 4121305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sacarosa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "¡Excelente! Esta arma es como ninguna otra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130202,
					"content": "Tú también eres alguien fuera de lo común. Tanto tu postura en combate como tu forma de blandir la espada son perfectas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130203,
					"content": "Me halagas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "Esta espada es especial. No quería profundizar demasiado en la investigación, pero no puedo apartar los ojos de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130205,
					"content": "Paimon cree que es una de tus cualidades, no tiene que ver con la espada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130206,
					"content": "No hay duda de que esta es una espada misteriosa, pero también peligrosa y tentadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130207,
					"content": "El señor Albedo debe tener mucha confianza en ti como para confiarte un objeto tan importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130208,
					"content": "#Estoy tan sorprendid{F#a}{M#o} como tú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Jeje, te ganaste su confianza con tus habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130211,
					"content": "Estoy de acuerdo con Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130212,
					"content": "Sin embargo, la espada no había absorbido tanta energía antes de que te la entregara... ¿Cómo pudo Albedo ver lo especial que era en medio de la pila de cacharros del almacén?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130213,
					"content": "A veces, los destellos de genialidad no tienen explicación. Por ejemplo, ¡el apetito de Paimon por el asado a la miel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130214,
					"content": "Ah... Lo que me recuerda que hoy no comí mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130215,
					"content": "#Fui a buscarl{F#as}{M#os} justo después de completar mi experimento. Luego, en el camino me encontré con un aventurero atrapado en la nieve. Pasé bastante tiempo intentando salvarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130216,
					"content": "*Grr*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130217,
					"content": "¿Tu estómago acaba de rugir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "¡Eh...! ¡Ah...! N-no, no es eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130219,
					"content": "¡No seas tan tímida! ¡Di lo que piensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130220,
					"content": "Yo... pues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130221,
					"content": "Deja que Paimon te ayude. ¡Paimon tiene hambre! ¡Deberíamos comer algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130222,
					"content": "¡Tengo hambre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "T-tengo... hambre... quiero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130225,
					"content": "¡Ay, qué vergüenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130226,
					"content": "¡No hay nada de que avergonzarse! Admitir que tienes hambre hace que la comida sepa mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130227,
					"content": "¿Eh? ¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130228,
					"content": "¡Por supuesto! ¡En marcha! Debe haber algo de comida en el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130229,
					"content": "Sería genial comer un delicioso asado a la miel recién hecho para entrar en calor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130223,
					"content": "¡Quiero comer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "Agradezco la confianza que pone en mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
