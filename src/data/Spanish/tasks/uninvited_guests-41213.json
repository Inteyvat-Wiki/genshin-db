			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130501,
					"content": "Escuché el alboroto y me acerqué a inspeccionar. Así que fuiste tú quien hizo todo este escándalo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130502,
					"content": "¿Qué pasó? ¿Te metiste en una pelea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130503,
					"content": "S-señor Albedo... yo... no quise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130504
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130504,
					"content": "¿No se supone que debes estar organizando documentos? ¿Qué haces aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130505
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130505,
					"content": "Y peleaste contra un adversario tan peligroso en estas condiciones climáticas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130506,
					"content": "Lo siento, yo también estaba en la pelea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130507
					]
				},
				{
					"id": 412130507,
					"content": "Ahora hasta Paimon se siente culpable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130508,
					"content": "Yo... eh... solo... lo siento, solo estaba de paso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130509,
					"content": "*Suspira*, supongo que algo te distrajo y te desviaste del camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130510,
					"content": "Le conté a Sacarosa acerca de la espada, lo siento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "¿Le contaste todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130512,
					"content": "Solo le contamos acerca de sus propiedades y su origen. ¡No dejamos que la tocara! Nunca lo haríamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130513,
					"content": "No importa. De todos modos, no podríamos ocultárselo por mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130514,
					"content": "Sacarosa se siente muy interesada por los misterios y lo desconocido. Tiene madera de alquimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130515,
					"content": "Eh... yo... prometo que no causaré más problemas. ¡Lo juro por las semillas de flor dulce cuatro veces más grandes de lo normal que acabo de crear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130516,
					"content": "No son los problemas lo que me preocupa, sino tu seguridad. Debes tener más cuidado la próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130517,
					"content": "Por cierto, ¿qué le pasa a ese aventurero que está ahí agachado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130518,
					"content": "Yo me encargué de proteger al señor Pallad durante la batalla. Debería estar bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130519,
					"content": "M-me estoy c-congelando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 412130520,
					"content": "Seguramente se resfrió durante la pelea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130521,
					"content": "¡Ah, no pensé en eso! ¡Fue un descuido mío, lo siento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130522
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130522,
					"content": "Señor Albedo, ¡iré a verlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130523
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130523,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130524,
					"content": "Sacarosa puede parecer un poco inflexible, pero es una buena niña con un corazón de oro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130525,
					"content": "¿“Niña”? Pero si es más mayor que tú...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130526
					]
				},
				{
					"id": 412130526,
					"content": "Es verdad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130527,
					"content": "Esta chica... Si le quitas el ojo de encima, termina en los lugares más extraños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130528,
					"content": "Todos los jóvenes son así, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130529
					]
				},
				{
					"id": 412130529,
					"content": "Eso es cierto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130530,
					"content": "Sacarosa no quiso causar problemas. No seas tan duro con ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130531
					]
				},
				{
					"id": 412130531,
					"content": "No te preocupes, no estoy enojado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130532,
					"content": "¿Eh? Parece que hay algo que brilla en la espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130533,
					"content": "¿Eh? Cambió de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130534,
					"content": "El poder de esta espada es mucho mayor que antes. ¿Qué ocurrió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130535,
					"content": "Luchamos contra los Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130536
					]
				},
				{
					"id": 412130536,
					"content": "Había unos tipos muy fuertes entre los soldados Fatui. Nunca los habíamos visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130537,
					"content": "Entonces, es una energía con la que nunca antes se había topado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130538,
					"content": "Es lo que hizo que el poder de la espada aumentara considerablemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121306,
			"completionStepIds": [
				4121314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121314",
							"2"
						],
						"stepId": 4121314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "El poder del dragón... la fuerza vital del dragón es capaz de revivir plantas marchitas y llenarlas de poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130602,
					"content": "¡Increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130603,
					"content": "¡¿Cómo puede un tronco muerto convertirse en un monstruo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130604,
					"content": "¡Casi devora a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130605,
					"content": "De todos modos, ¿por qué no sucedió nada parecido antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130606,
					"content": "Lo más probable es que sea porque la espada cayó al suelo. El impacto debió provocar una fuga de energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130607,
					"content": "¡Es mi culpa! ¡No me echen, se lo ruego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 412130608,
					"content": "¡Prometo que me quedaré quieto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "El Temerario Pallad"
				},
				{
					"id": 412130609,
					"content": "Ah, señor Pallad... Ya no es necesario que siga en esa posición...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130610,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130611,
					"content": "Esta Regisvid Cryo estaba marchita. ¿Será que no podía absorber el poder corrupto del ambiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130612,
					"content": "Después de purificarla, la energía elemental pura no solo la revivió, sino que también la fortaleció.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130613,
					"content": "La fuerza vital pura hace que se regenere constantemente... junto con su espíritu de lucha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130614,
					"content": "Es peor de lo que imaginábamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "Nunca había visto un incidente similar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130617,
					"content": "Sin embargo, debo admitir que, aunque es un fenómeno raro e inesperado, es un descubrimiento valioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130618,
					"content": "Sacarosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130619,
					"content": "¿Sí, señor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130620,
					"content": "Cuida de ese aventurero. Llévalo de regreso al campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130621,
					"content": "¡Sí, señor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "Sacarosa"
				},
				{
					"id": 412130622,
					"content": "#En cuanto a los asuntos que nos ocupan, te ruego que me disculpes, viajer{F#a}{M#o}... pero debo pedirte ayuda una vez más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130623,
					"content": "Haré lo que pueda para ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "#Ocurrió un desastre inesperado, y somos {F#las únicas}{M#los únicos} que podemos arreglarlo. ¡Debe ser porque cada vez somos más poderos{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130615,
					"content": "#No contaba con esto. ¿Es porque soy demasiado poderos{F#a}{M#o}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
}