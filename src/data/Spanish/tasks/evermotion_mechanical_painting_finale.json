			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "¡Bravo! ¡Reunió las seis piezas del Mecanopuzle de moción perpetua! Ahora, todo lo que tenemos que hacer es ensamblarlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150102,
					"content": "¡¿To-todas?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "¡Por supuesto! ¡Las seis partes pequeñas se pueden ensamblar en una sola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150104,
					"content": "¡Todas ellas formarán un majestuoso Mecanopuzle de moción perpetua gigante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150105,
					"content": "Vamos, ¡todo lo que tiene que hacer es unir las piezas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150106,
					"content": "¿No tenemos que soldarlas o algo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "No, en absoluto. ¡Mi aparato no tiene nada de amalgamas y ese tipo de basura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150109,
					"content": "Cada componente está ensamblado espléndida e intrincadamente, como... como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150110,
					"content": "¡Bah! Olvídelo. Nunca se me dieron bien las analogías. Xavier tiene de retórica lo que a mí me falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150111,
					"content": "Bueno, inténtelo. Será una experiencia interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150107,
					"content": "¿No necesitan un procedimiento adicional?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051503",
							"2"
						],
						"stepId": 7051503,
						"stateName": "QUEST_STATE_UNFINISHED"
