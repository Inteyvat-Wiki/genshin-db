				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "¡Perfecto! ¡Bellísimo! Es usted hábil de mente y con las manos. ¡Superó con creces mis expectativas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150202,
					"content": "#Jeje, recuerdo que muchos artículos de «El Pájaro de Vapor» l{F#a}{M#o} describen a usted como... como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150203,
					"content": "¿Como... qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "#Jeje, como {F#una caballera}{M#un caballero} sin pelos en la lengua que prefiere usar la espada antes que las palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150206,
					"content": "#¡Absurdo! ¡Ridículo! ¿Cómo pueden esos reporteros adornar los hechos de esa manera? Después de todo, ¡usted es {F#una caballera}{M#un caballero} astut{F#a}{M#o}, inteligente, humilde y franc{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150207,
					"content": "Cuando tenga la oportunidad, les haré saber lo que pienso. ¡Oh, sí, ya verán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150208,
					"content": "#Ah, por cierto, tome este dispositivo. Si se siente aburrid{F#a}{M#o}, puede usarlo en sus ratos de ocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150209,
					"content": "En cuanto a mí, tendré que comenzar a reunir los Moras para mis gastos de viaje a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150204,
					"content": "Vamos, continúa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
