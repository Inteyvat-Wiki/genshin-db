					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560301,
					"content": "Interesante... Las plantas aquí parecen rejuvenecidas. Parece que Moutiyima ha vuelto a la acción. Es increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560302,
					"content": "¿Eh? ¿Usted también conoce a Moutiyima? Paimon pensaba que solo los aranara sabían al respecto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560303,
					"content": "¡Paimon! ¡Shh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "¿Los aranara, dices? Así que también los han visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560306,
					"content": "¿Eh? Humm... Pues sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560307,
					"content": "¿Qué sucede, Sr. Jayam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "“Iram se desvaneció con el rosal. Oh, grial del rey, ¿dónde has estado?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560310,
					"content": "Hay que continuar, vamos al siguiente lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560308,
					"content": "¿Usted también ha visto a los aranara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "¡Paimon...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
			"completionStepIds": [
				7305610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305610",
							"2"
						],
						"stepId": 7305610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jayam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "¡Ja! ¡Miren esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560402,
					"content": "¿Eh? ¿Es algún tipo de flor nueva? ¿Por qué está tan emocionado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "No, no. No es una flor nueva, ¡es algo mejor que eso! ¡Es nuestro castillo secreto! ¡Ja! ¡Tiene un aspecto terrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560404,
					"content": "¿Eh? ¿“Castillo secreto”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "¡Jaja! ¡El erudito Omar está de vuelta! ¡Y ha traído consigo los secretos de las estrellas! Irfan, Siman, ¡¿dónde están?! ¿No saldrán a darme la bienvenida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "#Eh... *Ejem*, disculpen, jovencit{F#as}{M#os}... M-me emocioné.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560409,
					"content": "Así es cuando uno llega a cierta edad. Ignora el presente y añora el pasado, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560410,
					"content": "Irfan y Siman son mis amigos. Los tres construimos juntos este castillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560411,
					"content": "En aquel entonces, Irfan era un gran músico, Siman era mariscal, y yo era astrólogo. A veces cambiábamos de roles. Como todos los niños, necesitábamos jugar a cosas diferentes para no aburrirnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560412,
					"content": "Irfan era bueno tocando instrumentos musicales. Siman era alta y fuerte, nadie podía vencerla. Y yo... jaja, solo era un poco más educado porque mi familia tenía más Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560413,
					"content": "¿Entonces, aquí era donde jugaba cuando era niño?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "No era un juego. Este era nuestro reino secreto, me lo tomaba muy en serio. Prometimos que nunca nos olvidaríamos y que, cuando creciéramos, levantaríamos un ejército de restauración y volveríamos a recuperar el castillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560418,
					"content": "Jeje, han pasado veinte años, seguramente ya olvidaron nuestra promesa. Este lugar se convirtió en mi pequeña base para estudiar el bosque, y así fue hasta hace treinta años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560419,
					"content": "Después de eso, vino el Marana, y el ejército de restauración seguía sin aparecer. Jeje, bueno, ¿cómo iba a resistir el paso del tiempo una simple promesa infantil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560420,
					"content": "Pero usted aún los recuerda, ¡seguro que ellos también lo recuerdan a usted! ¡No se desanime, Sr. Jayam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "¿Desanimarme? Jamás. Los recuerdos de la infancia y los amigos imaginarios que compartíamos no pertenecen al mundo de los adultos. Puede sonar un poco triste, pero no se puede volver atrás en el tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560422,
					"content": "¿Amigos imaginarios? ¿Se refiere a los aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "¡Paimon...! ¡Shh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560426,
					"content": "Jaja, casi lo olvido. Les pedí que vinieran conmigo para recolectar nuevas muestras, no para conversar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560427,
					"content": "Por favor disculpen a este viejo parlanchín. Continuemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560424,
					"content": "¡Siempre hablas demasiado, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "¿Todo esto son cosas que usted y sus amigos dejaron atrás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "No, no todo. Prometimos que lideraríamos un ejército de restauración cuando fuéramos mayores, y que volveríamos a recuperar el castillo, jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560417,
					"content": "Al final me convertí en un botánico investigador de la Academia, y de casualidad terminé regresando a este lugar a hacer un trabajo de reconstrucción. Vine muchas veces y me llevé mucha basura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Jayam"
				}
			]
		},
		{
			"id": 7305605,
			"completionStepIds": [
				7305603,
				7305605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
