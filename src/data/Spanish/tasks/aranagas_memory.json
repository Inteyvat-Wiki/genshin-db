				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560501,
					"content": "Miren, miren, ¡aquí las plantas crecen a la perfección! ¡Las flores son capaces de volver a brotar en la tierra que una vez fue devastada por el Marana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560502
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560502,
					"content": "Jaja, Moutiyima, ¡vieja amiga! ¡Aún conservas tus fuerzas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560503
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560503,
					"content": "¡Guau! ¡El señor Jayam de pronto se ve más joven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560504,
					"content": "Al fin dices algo adecuado, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "¡¿Qué quieres decir con eso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "Humm... Con estas que recolectaron es suficiente. Muchas gracias por ayudarme. Bueno, ya que cumplimos con nuestro cometido, podemos irnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560509,
					"content": "Jaja, espléndido. Estas muestras me serán de gran utilidad para descubrir los secretos y debilidades de las zonas marchitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560510,
					"content": "Gracias por su esfuerzo. Ahora regresemos juntos. Tengo algo para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560511,
					"content": "¡Yuju! ¡Una recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Jeje, algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560506,
					"content": "¡Yupi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Paimon no está segura de qué quieres decir pero... ¡yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305606,
