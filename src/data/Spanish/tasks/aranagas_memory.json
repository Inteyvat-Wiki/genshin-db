			},
			"dialogs": [
				{
					"id": 730560701,
					"content": "¿Qué hacer aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560702
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560702,
					"content": "¡Ah! ¡Qué susto, Aranaga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560703,
					"content": "Ustedes saber nombre de Aranaga, pero Aranaga no conocer a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560704,
					"content": "Entonces, ¿qué hacer aquí ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560705,
						730560708
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560705,
					"content": "Es difícil de explicar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "Puede que ahora no recuerdes muchas cosas, ¡pero nosotros no tenemos ninguna mala intención! ¡Siempre hemos estado de su lado! ¡Siempre ayudaremos a Moutiyima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560707,
					"content": "Moutiyima... ¿Ustedes conocer Moutiyima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560710,
					"content": "#Humm... No parecer mal{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "#Pero, por favor, no quedarse aquí. Irse rápido. Bosque aún recuperarse, así que nuev{F#as}{M#os} invitad{F#as}{M#os} no poder quedarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560712,
					"content": "¿Eh? ¡Espera, espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560713,
					"content": "¡Tenemos algo para ti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "Algo... ¿para Aranaga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560715
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560715,
					"content": "Darme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560716
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560716,
					"content": "Aquí tienes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560717
					]
				},
				{
					"id": 730560717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560718
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560718,
					"content": "¿Recuerdas? ¡Tú también nos diste la misma flor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560719,
					"content": "#¿De verdad... ser amig{F#as}{M#os} de Aranaga? ¿Por qué tener flor tan importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560720,
						730560721
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560720,
					"content": "Pues porque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560722,
					"content": "Le cuentan a Aranaga sus aventuras y cómo rescataron a Moutiyima de la zona marchita.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730560723
					]
				},
				{
					"id": 730560723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560724
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560724,
					"content": "¿Y bien? ¿Te acuerdas ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560725,
					"content": "No entender, no recordar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560726
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560726,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560727,
						730560728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560727,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560729
					]
				},
				{
					"id": 730560729,
					"content": "Pero gracias. Si recordar jardín de Aranaga, poder venir cuando querer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560730
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560730,
					"content": "Aranaga plantar flor importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560731
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560731,
					"content": "Aranaga se marcha con la flor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730560732
					]
				},
				{
					"id": 730560732,
					"content": "Se fue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560733,
						730560735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560733,
					"content": "Se fue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560734
					]
				},
				{
					"id": 730560734,
					"content": "Bueno, al menos nos invitó a su jardín. Quiere decir que no se opone a la idea de ser amigos, ¿verdad? ¡Hay que ir alguna vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560735,
					"content": "Pero dejó una invitación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560736
					]
				},
				{
					"id": 730560736,
					"content": "Sí, es cierto. Vayamos a visitar a Aranaga cuando tengamos tiempo, ¿te parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560728,
					"content": "Bueno, no me sorprende...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560729
					]
				},
				{
					"id": 730560721,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560708,
					"content": "Somos amigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560709
					]
				},
				{
					"id": 730560709,
					"content": "¿Amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				}
			]
