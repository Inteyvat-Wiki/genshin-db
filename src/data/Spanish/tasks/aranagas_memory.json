			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jayam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Jaja, interesante... Realmente impresionante. Parece que el bosque se está recuperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560102,
					"content": "¡Hola, señor! ¿Está perdido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560103,
					"content": "¿Eh? ¿Que si me han mordido? Ah, ¿me hablan a mí? Jaja, ¿perdido? De ninguna manera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560104,
					"content": "#Hola, pequeñ{F#as}{M#os}. Mi nombre es Gyaz Jayam, soy un dastur de la Escuela de Biología, jaja. Pueden llamarme Jayam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560105,
					"content": "Oh, ¡hola, Sr. Jayam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560106,
					"content": "No, así no se pronuncia. Primero bajen la punta de la lengua y formen un arco con ella, “jaaa”... Luego, pongan los labios en forma de círculo, “yaaa”... Por último cierren los labios de forma natural, “mmm”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560107,
					"content": "Jaaa-yaaa-mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560108,
					"content": "#¡Sí! ¡Mucho mejor! Tú, {F#la}{M#el} del cabello rubio, repítelo tú también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560109,
					"content": "Jaaa-yaaa-mmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "¡Jaja! ¡Excelente! ¡Lo hiciste mucho mejor que la cosita blanca! ¿Ya ven? ¡Siempre he dicho que sería bueno enseñando fonética!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560113,
					"content": "Bueno... si no está perdido, ¿qué hace en un lugar como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560114,
					"content": "¿Que qué hago? Jeje, soy un erudito del bosque. Para nosotros, el bosque es como nuestro hogar. ¿Cómo podría estar perdido en mi propio hogar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560115,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560116,
					"content": "Este bosque tiene una zona marchita que está causando problemas. En las últimas tres décadas, las plantas han disminuido tanto en especie como en cantidad, y cada vez crecen más de esos hongos nocivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560117,
					"content": "Pero recientemente, la zona marchita ha desaparecido. Las plantas están volviendo a crecer, y los hongos tóxicos han disminuido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560118,
					"content": "Solo vi algo así una vez hace sesenta años, así que he venido a comprobar mis suposiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560119,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560120,
					"content": "Sobre comprobar sus suposiciones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Jaja, han pasado sesenta años... No esperen que un anciano como yo recuerde mucho. Lo que sí puedo asegurarles es que lo que pasó tiene relación con la desaparición de la zona marchita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560122,
					"content": "Así que voy a recolectar algunas muestras de esta cueva para verificar mis sospechas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560126,
					"content": "Paimon lo entiende... Pero, aunque la cueva esté libre de Marana, sigue siendo muy peligrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560127,
					"content": "Jaja, no es un problema para mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560128,
					"content": "Espera, espera, ¿qué fue lo que dijiste? ¿Aunque la cueva esté libre de qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560129,
					"content": "¿Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Bueno, pensándolo bien, tal vez sí necesite de su ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560132,
					"content": "¡Ahora entiende de qué hablamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560133,
					"content": "Jeje, disculpen pero aún no sé sus nombres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560134,
					"content": "#Puede llamarme {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "¡Y Paimon se llama Paimon! ¡Pai... mon...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560136,
					"content": "¿Paimon? Paimon... Jaja, qué nombre tan interesante. Es la primera persona... o hada que conozco con ese nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560137,
					"content": "Oh, lo siento, lo siento. No pretendía ofender. Me refería a ti, cosita voladora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560138,
					"content": "¡¿Cosita?! ¡Eso sí es ofensivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560139,
					"content": "Bien, creo que ya rompimos el hielo. Vengan conmigo, yuvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560140,
					"content": "¿“Yuvan”? ¿Qué significa eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560141,
					"content": "Es una palabra antigua del dialecto que hablamos en mi pueblo natal, significa “jóvenes valientes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560142,
					"content": "Para ser más preciso, quiere decir “jóvenes que al encontrarse con la inmensidad del mal, saben reconocerla y se enfrentan a ella, que distinguen y jamás eluden la infinita injusticia”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560143,
					"content": "Jeje, ¡nos describe a la perfección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560144,
					"content": "¿Ah, sí? Jaja, entonces, vengan conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560145,
					"content": "¿Eh? Pero Sr. Jayam, usted es un abuelo, ¿realmente puede seguirnos el paso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560146,
					"content": "#Jaja... Llevo casi treinta años explorando el bosque, ¡no subestimen mi resistencia! Ustedes adelántense, ya {F#las}{M#los} alcanzaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560130,
					"content": "¿Zona marchita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "¿Necesita nuestra ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "#Jaja, qué amables niñ{F#as}{M#os}, se lo agradezco. Seré un anciano, pero tengo una mente brillante. No me subestimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560125,
					"content": "Después de todo, sé cómo cuidar del bosque, así que no me hará daño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560111,
					"content": "Señor Jayam, ¿qué hace aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Humm... Lo pronunciaste demasiado rápido. Está bien, pero dilo un poco más lento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Jayam"
				}
			]
		},
		{
			"id": 7305602,
			"completionStepIds": [
				7305606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305606",
							"2"
						],
						"stepId": 7305606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jayam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "Estoy centrando mi investigación principalmente en tres lugares. Jaja, han pasado treinta años desde que estuve aquí, pero mi memoria aún no se ha desvanecido por completo. Puedo indicarles dónde se encuentran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560202,
					"content": "Y, por cierto, gracias por acompañarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560203,
					"content": "#¡No hay problema, Sr. Jayam! ¡Es lo que hacemos l{F#a}{M#o}s yuvan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
