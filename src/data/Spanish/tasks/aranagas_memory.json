					"nextDialogs": [
						730560805
					]
				},
				{
					"id": 730560805,
					"content": "Considerar a las criaturas que los niños llaman “aranara” como “amigos imaginarios” es... incorrecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560806
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560806,
					"content": "Ya que los sensores de la Academia tampoco pudieron detectarlos, solo los niños pueden demostrar su existencia.",
