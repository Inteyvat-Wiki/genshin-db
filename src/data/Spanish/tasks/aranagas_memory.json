			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jayam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560601,
					"content": "#Muchas gracias, yuvan. Deben estar cansad{F#a}{M#o}s de acompañar a un viejo como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560602,
					"content": "Por cierto, espero que les guste... No es valioso ni nada de eso, pero tomen esto de recuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560603,
					"content": "Guau... ¿Qué es? ¿Qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "Seguro que ya han visto esta pequeña flor seca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560605,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "Son...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Así es. Y, si no me equivoco, ellos te habrán dado el mismo regalo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560609,
					"content": "Jeje, lo sabía, nuestro encuentro no es ninguna coincidencia. Nunca he creído en las casualidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560610,
					"content": "Ten esta flor. Por favor, entrégasela a nuestros amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560611,
					"content": "Claro, no hay problema, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
					"content": "No creo que se acuerden de mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560615,
					"content": "Yo no puedo verlos ya. Incluso llegué a dudar de su existencia, pensé que quizá eran parte de mi imaginación de niño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560616,
					"content": "Pero no voy a rendirme. Entréguenles esto ahora que aún pueden verlos, antes de que el milagro se desvanezca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jayam"
				},
				{
					"id": 730560614,
					"content": "Tal vez no se acuerden de usted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560615
					]
				},
				{
					"id": 730560607,
					"content": "Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				}
			]
		},
		{
			"id": 7305607,
			"completionStepIds": [
				7305604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
