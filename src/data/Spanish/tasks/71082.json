			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Autoproclamado “Tang Wuchou”"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "¿Qué pasa? ¿Te ha ido mal en el juego de Chou otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820102,
					"content": "Ya te lo había dicho yo... En esa búsqueda de tesoros suya, <color=#00E1FFFF>cuanto mejor sea el objeto, más barriles explosivos habrá a su alrededor. Cuanto peor sea, más segura será la zona que lo rodea.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820103,
					"content": "Seguro que ahora ya no se te olvida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Autoproclamado “Tang Wuchou”",
					"Tío He",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Malditos ladrones de tesoros... *Uf, uf*... Si no fuera porque estoy muy débil por la falta de champiñones que llevarme a la boca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820202,
					"content": "¡Ya les habría dado una paliza a todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820203,
					"content": "¡Viejo ladrón! ¿Cómo te atreves a llamar “champiñones” a mis flores chingxin? ¡Y encima te los has comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820204,
					"content": "*Cof*, ¿con qué derecho te los comes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820205,
					"content": "¿Eh? ¿Por qué se están peleando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "¡E-estaba buscando champiñones! Jaja, sí, champiñones. Pero no me dejaron volver a las minas, así que vine a buscar algunos por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820207,
					"content": "Vi que aquí había champiñones y cuando quise llevarme unos pocos, ¡este de aquí salió de la nada para atacarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820208,
					"content": "#¡¿Así que te atreves a entrar en el campo de entrenamiento del Clan Guhua?! Estas flores me pertenecen a mí y {F#a la heroica}{M#al heroico} {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820209,
					"content": "¡Y a la heroica Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "¡Exacto, y a la heroica Paimon! Nadie puede adentrarse en estos terrenos, salvo nosotros tres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820211,
					"content": "¡Maldito ladrón de tesoros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820212,
					"content": "¡Viejo ladrón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820213,
					"content": "Tranquilo, Tío He. Tang Wuchou ya no es un ladrón de tesoros. Además, lo que ha plantado son flores, no champiñones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "¿Eh? ¿De verdad...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820215,
					"content": "Fíjate bien, ¿no ves que son flores chingxin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "¿Eh? Sí que son flores chingxin. Vaya, parece que aún estoy un poco mareado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820217,
					"content": "¡Y tú, Tang Wuchou! No me digas que sigues con lo de plantar un jardín de lirios de cristal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Pero... si aquí hubiese un gran jardín de lirios de cristal, el paisaje sería aún más bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				},
				{
					"id": 710820219,
					"content": "¡Bueno, no se peleen más!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "*Suspira* Aquí no hay champiñones, me marcho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710820221,
					"content": "Ahora que por fin se ha ido, ya puedo dedicarme por completo a cultivar flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Autoproclamado “Tang Wuchou”"
				}
			]
		}
	]
}