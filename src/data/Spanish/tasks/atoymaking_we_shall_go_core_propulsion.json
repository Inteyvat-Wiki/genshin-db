			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960101,
					"content": "Uf, qué peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960102
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960102,
					"content": "Un poco, solo faltó un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960103,
					"content": "Bertrand, ¿por qué tienes la cara bañada en sudor? Parece que fueras a caer exhausto de un momento a otro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960104,
					"content": "No es que lo parezca, es que lo estoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960105,
						726960106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960105,
					"content": "¿Qué pasó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				},
				{
					"id": 726960107,
					"content": "Jeje, por poco. Menos mal que estaba atento y reaccioné rápido para hacer unos ajustes de emergencia. Al final pude estabilizarlo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960108,
					"content": "Ahora mismo esos elementos se están combinando poco a poco con las materias primas que recogieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960109
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960109,
					"content": "Ay, me he salvado por los pelos. Si no hubiese logrado controlar las fuerzas elementales, mi futuro habría saltado por los aires en una explosión más brillante que los fuegos artificiales de los Naganohara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960110,
					"content": "¿No dijiste que no volvería a haber explosiones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960111
					]
				},
				{
					"id": 726960111,
					"content": "Dije que los juguetes no explotarían, pero nunca garanticé que la máquina que los fabrica no lo hiciera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960112
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960112,
					"content": "Pero esta vez, por fortuna, conté con su ayuda para hacer las pruebas. De lo contrario, no solo no habría fabricado ningún juguete, ¡sino que la propia Megamáquina habría acabado volando en pedazos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960113,
					"content": "Bien, esta es la última etapa: la activación del núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960114,
					"content": "Según dijiste antes, está relacionada con las criaturas elementales, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960115,
					"content": "Así es. Las criaturas elementales poseen una carga constante de energía elemental. El último proceso consiste en introducir dichas cargas en la máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960116
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960116,
					"content": "Si logro fabricar juguetes, podré seguir fabricándolos sin pausa. Luego podré pagar mi deuda, ganar mucho dinero y vivir feliz en Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960117,
					"content": "¿Eh? ¿No regresarías a Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960118,
					"content": "Fontaine... Ah, Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960119
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960119,
					"content": "#{NICKNAME}, Paimon, ustedes aún no han estado en Fontaine, ¿verdad? Si hubieran estado, lo sabrían...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960120,
					"content": "Para algunos, Fontaine es la nación donde la vida es más cómoda. Pero para otros, no es más que una tierra de dolor y decepción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960121,
					"content": "Allí el sistema de energía es bastante especial, y nadie sabe hasta cuándo podrá mantenerse. Por eso es fundamental encontrar una solución energética alternativa antes de que colapse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960122,
					"content": "Pero eso es más fácil decirlo que hacerlo. Por eso... no me queda más remedio que estar fuera de Fontaine para investigar otras fuentes de energía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960123,
					"content": "En realidad, la Megamáquina es el resultado de mis investigaciones sobre nuevas energías y por eso no es muy estable. Hasta el punto de que cualquier descuido puede dar lugar a una explosión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960124
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960124,
					"content": "Sin embargo, estoy convencido de que algún día encontraré una solución energética factible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960125,
					"content": "Cuando llegue ese día, emprenderé mi viaje de vuelta a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960126,
					"content": "Bertrand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960127,
					"content": "Bueno, dejemos ese tema. Comencemos el último proceso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960128,
					"content": "#¡{NICKNAME}, de ti depende el tipo de vida que lleve en Inazuma antes de volver a Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960106,
					"content": "¿Falló la reacción elemental?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				}
			]
		},
		{
