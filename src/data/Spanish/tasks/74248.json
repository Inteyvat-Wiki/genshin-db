			"dialogs": [
				{
					"id": 742480201,
					"content": "Este “juego de rol” es muy divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 742480202,
					"content": "(Quedémonos sentadas así un rato más.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480204,
					"content": "Sí. Creo que la gran y malvada vampira también debería volver a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				},
				{
					"id": 742480203,
					"content": "Creo que ya es hora de que me vaya retirando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
