			"dialogs": [
				{
					"id": 401891001,
					"content": "Bueno, quizá los números no sean impresionantes, pero considerando que acabamos de abrir, ¡es un buen comienzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891002,
					"content": "Aprovechando este buen comienzo, ¡podríamos pensar en estrategias de negocio más especiales para el próximo ciclo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891003,
					"content": "Para atraer a más visitantes al parque temático, he invitado a una chef muy renombrada de Fontaine, ¡mi amiga Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891004,
					"content": "El restaurante del parque es el escenario donde “actúa”. ¡Vamos a buscarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891005,
					"content": "¿El restaurante también forma parte de nuestra estrategia de negocio? Por Los Siete, cuántas cosas que tener en cuenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
