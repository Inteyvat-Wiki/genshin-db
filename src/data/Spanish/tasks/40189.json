						],
						"stepId": 4018901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "Adelante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "#Ahora, mis querid{F#a}{M#o}s soci{F#a}{M#o}s, {NICKNAME} y Paimon, hablemos del tema que nos ocupa: el Parque Kinográfico Chevalmarine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890402,
					"content": "Como ya saben, la idea del parque temático fue impulsada por unos aficionados, mientras que Spina di Rosula se encarga de la planificación, la construcción y la gestión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890403,
					"content": "Sin embargo, los aficionados no son expertos en todas las áreas, y suelen encargarse únicamente del diseño de los puestos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890404,
					"content": "Nuestra misión, en cambio, es elaborar un plan de negocio a largo plazo y unas guías de juego estándar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890405,
					"content": "Un plan de negocio a largo plazo... ¡Parece complicado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890406,
					"content": "#Nosotr{F#a}{M#o}s siempre estamos de aventuras y apenas tenemos experiencia con puestos de venta. ¿Crees que, aun así, somos l{F#a}{M#o}s más indicad{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890407,
					"content": "¡No todos los jefes han estudiado en una escuela de negocios!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "#¡Así se habla! Soci{F#a}{M#o}s, sé que han superado incontables obstáculos y su papel ha sido decisivo en muchos eventos comerciales de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890410,
					"content": "En fin, dejen que les explique la situación general del parque temático...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890411,
					"content": "#Paimon cree que ya lo entiende más o menos. ¿Y tú, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890412,
					"content": "Jaja, ¡esta es mi especialidad!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "¡Vamos a darlo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890415,
					"content": "Por cierto, Navia, has hablado de unas “guías de juego estándar”... ¿Significa eso que hay formas de juego no estándar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890416,
					"content": "Por supuesto. Cada persona tiene una visión distinta de lo que debe ser una kinografía o una atracción, pero en un parque temático no pueden faltar las actividades peligrosas y emocionantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890417,
					"content": "Es posible que algunos turistas se desorienten y se alejen demasiado de la zona de juego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890418,
					"content": "Otros podrían confundir la utilidad de los objetos y agarrar alguno que fuera muy peligroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890419,
					"content": "Para evitar confusiones, debemos crear una forma de juego estándar para cada actividad, o lo que es lo mismo, ¡una guía de juego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890420,
					"content": "Ya veo. Entonces, yo me ofrezco para probar los juegos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "Visto así, a Paimon también se le ocurren todo tipo de imprevistos que podrían surgir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890423,
					"content": "Si nos encontramos con algún nivel muy difícil, ¡tendremos que superarlo confiando en nuestras habilidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890424,
					"content": "#Por supuesto, no quiero que mis soci{F#a}{M#o}s corran peligro. Antes de que llegaran, comprobé minuciosamente todas las atracciones para asegurarme de que fueran completamente seguras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890425,
					"content": "#¡Espero que seas {F#la primera}{M#el primero} en probar todas las atracciones y que me digas tu opinión y tus sugerencias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890426,
					"content": "#Jeje, ¡esa es nuestra Navia! ¡Siempre logras que nos sintamos segur{F#a}{M#o}s y content{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890427,
					"content": "¡Estoy deseando saber qué piensan! ¡Su opinión es muy valiosa para mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890428,
					"content": "En fin, ¿qué tal si empezamos con “Aventura ecléctica” y creamos la primera guía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890421,
					"content": "#Ya entiendo. Estaré encantad{F#a}{M#o} de ser el sujeto de pruebas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Puff... Tendré que aprender sobre la marcha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "¡Hemos hecho muchos trabajos en los que nos hemos forrado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
