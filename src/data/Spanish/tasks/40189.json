			"dialogs": [
				{
					"id": 401891601,
					"content": "*Fiu*, ¡todo listo! ¡Ya dominan lo esencial para la dirección del Parque Kinográfico Chevalmarine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891602,
					"content": "¿Eh? ¿De verdad crees que lo dominamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891603,
					"content": "Bueno, a decir verdad, hemos aprendido un montón de cosas sin darnos cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891604,
					"content": "Es porque Navia es una excelente profesora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "Ay, ¡qué va, qué va! Pero si yo no les he enseñado nada, ¡todo ha sido gracias a lo rápido que captan las cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891607,
					"content": "Les dio un poco de miedo la primera vez que escucharon lo de “llevar un negocio a largo plazo”, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891608,
					"content": "¡Pero no se preocupen! Si dividen el trabajo en pequeñas tareas y las realizan una por una, ¡no necesitarán ser genios de los negocios para hacer bien esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891609,
					"content": "¡Oooh! ¡Paimon siente que ha mejorado mucho y está supermotivada! ¡Paimon va a anotar las palabras de ánimo que nos has dicho, Navia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891610,
					"content": "#De ahora en adelante, llevaremos el Parque Kinográfico Chevalmarine junt{F#a}{M#o}s. ¡Será todo un éxito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891605,
					"content": "#Aprendimos de la mejor jefa a ser {F#buenas jefas}{M#buenos jefes}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
			]
		}
	]
