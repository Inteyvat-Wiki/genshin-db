			"dialogs": [
				{
					"id": 401890801,
					"content": "Parece que esta empleada ya está en modo trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890802,
					"content": "Esperemos que lo haga bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "#Jajaja, ¡qué bien se les da esto! ¡Son hasta mejores jef{F#a}{M#e}s que yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890805,
					"content": "Ahora sí, ¡el Parque Kinográfico Chevalmarine abre oficialmente sus puertas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Dirigir un parque temático es un trabajo a largo plazo. No podemos dejarnos cegar por el ansia de querer ganar Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "Pues ya casi hemos terminado con el trabajo. Tomémonos un descanso mientras esperamos a que salga el informe de ganancias de este ciclo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "Vigilaré muy de cerca su asistencia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
