						200190402
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190402,
					"content": "Encontré esta llave, ¿es la tuya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190403
					]
				},
				{
					"id": 200190403,
					"content": "¡Sí! ¡Es esa! No puedo permitir que vuelva a suceder... Realmente debo controlar mi consumo de alcohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190404
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190404,
					"content": "Ah, y toma esto. Gracias por tu ayuda.",
