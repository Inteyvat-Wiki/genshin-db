					"Wyatt"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200190101,
					"content": "#¡Viajer{F#a}{M#o}! No podrías haber llegado en un mejor momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190102,
					"content": "Anoche estaba de camino a la ciudad para entregar estos bienes, cuando de repente unas esferas brillantes me llamaron la atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190103,
					"content": "Había bebido demasiado y... me sentí atraído por ellas, ¿sabes? Fui a verlas y resultó ser un gran grupo de Slimes. Me dieron una paliza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190104,
					"content": "Entré en pánico y corrí, pero perdí el rumbo. Me llevó una eternidad encontrar mi carruaje de nuevo. Y esta mañana descubrí que mi <color=#00E1FFFF>llave</color> se había extraviado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190105,
					"content": "¿Podrías ayudarme a buscarla? Tiene que estar por aquí en alguna parte... Tengo la impresión de que está justo frente a mis narices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190106,
						200190108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190106,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190107
					]
				},
				{
					"id": 200190107,
					"content": "¡Excelente! Es un área tan grande que no sabría por dónde empezar a buscar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190108,
					"content": "Estoy en medio de algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190109
					]
				},
				{
					"id": 200190109,
					"content": "Esta es un área tan grande que no sé por dónde empezar a buscar. ¡Por favor, eres el único que me puede ayudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
		},
