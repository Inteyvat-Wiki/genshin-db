			"dialogs": [
				{
					"id": 200190201,
					"content": "¿Has encontrado mi llave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190202
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190202,
					"content": "Me temo que no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190203
					]
				},
				{
					"id": 200190203,
					"content": "Bueno, es un área de búsqueda bastante grande... ¡Buena suerte!",
