			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "Parece que no hay más camino... Debe estar por aquí en alguna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, ¡por allá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "Si tanto insisten en perseguirme, que así sea... ¿Eh? ¿Quién trajo a la niñita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Ave Rapaz"
				},
				{
					"id": 4850304,
					"content": "¡TÚ! ¡Tú debes ser Ave Rapaz! ¡Ya no tienes escapatoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "¡Jaja! ¡No necesito escapar! No hay forma de que lleguen hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Ave Rapaz"
				},
				{
					"id": 4850306,
					"content": "Oh... Es bastante alto, y queda muy lejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "Niñita, ¿por qué no corres a casa y dejas que tu líder se haga cargo? ¡No te preocupes! Te prometo que una vez que el Gran Maestro llegue aquí, me rendiré de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Ave Rapaz"
				},
				{
					"id": 4850308,
					"content": "¡Escúchame bien! ¡Estás hablando con la Exploradora de los Caballeros de Favonius! ¡Lo lamentarás cuando llegue allí para darte una tunda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Cuenta hasta diez, Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "... Tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "¡Bah! Está justo frente a nosotros... Si tan solo pudiéramos volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "Entonces, ¿cómo es que él cruzó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "¿Algún tipo de mecanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "No veo ningún indicio de un mecanismo para cruzar, y tengo muy buena vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "Además, no hay ningún lugar en el acantilado para construir uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "¡Adiós, niñita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Ave Rapaz"
				},
				{
					"id": 4850323,
					"content": "¡Oh, no! ¡Se esta escapando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "No hay tiempo para dudar. La única forma de cruzar es volar allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "Pero, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "No te preocupes, ¡soy la Campeona de Vuelo de Mondstadt, recuerda! Si Ave Rapaz puede hacerlo, yo también.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "¡Oye, Caballera Exploradora! ¡Tienes menos probabilidad de sobrevivir a esto que si saltas desde lo alto de la estatua del Dios Anemo en Mondstadt sin planeador! ¡Jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Ave Rapaz"
				},
				{
					"id": 4850328,
					"content": "Estoy con Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Tienes razón, {NICKNAME}... Si descartas todo lo que es completamente imposible, volar es la única opción que queda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, ¿recuerdas el libro que te presté? ¿El que se suponía que era el manual de vuelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "Los primeros pájaros no podían volar. El vuelo fue su recompensa por tener el valor de saltar hacia el precipicio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "Observa y aprende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "¡Vamos, Caballera Exploradora! ¡Tú puedes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "¡Entendido! ¡Demostrémosle a ese tipo de qué está hecha una Caballera Exploradora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "¡Espera, para! ¡Nunca lo lograrás! Vamos, vete. Sé una buena niña y vuelve a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Ave Rapaz"
				},
				{
					"id": 4850337,
					"content": "Ave Rapaz dice que nunca lo lograré. Pero ¿qué es ese ruido? Si escuchas con atención...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "El viento dice que lo lograré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "Esto necesita muchas agallas, pero no es completamente imposible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "¿Una especie de magia elemental?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}, ¿puedes ver algo con tu Visión Elemental? ¿No? Olvídalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "¿Un gancho de agarre, crampones, o algo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "Si está demasiado lejos para volar, definitivamente está demasiado lejos para algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "Tampoco hay signos de un punto de anclaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Examinemos nuestro entorno, tal como me enseñaste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "¡Bien! ¡Atrapamos a Ave Rapaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "Solo noté la corriente mientras caía, y era la única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "Sería un suicidio intentar escapar en la dirección en la que iba Ave Rapaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "En otras palabras, la única forma en la que podría haber salido sería de esta manera, pasando por encima de nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "¡Ajá! Así que solo estaba tratando de engañarnos actuando con aire de grandeza, con la esperanza de que nos rindiéramos y diéramos marcha atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "Pero no contaba con que somos difíciles de engañar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#¡Todo fue gracias al pensamiento agudo de {NICKNAME}! Como un hombre sabio dijo alguna vez: “Cuando hayas descartado lo imposible, lo que quede, aunque sea improbable, debe ser la verdad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "Al fin y al cabo, volar es 7% técnica, 3% instinto y 90% valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "Lo que hiciste era más bien 99% valor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Ah, fue como en mi primera prueba de vuelo... Estaba supernerviosa, pero al final no había nada que temer y no tuve problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "Extrañé un poco ese nerviosismo en las pruebas que he hecho desde entonces... Simplemente no es lo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "Em... Paimon lo siente. Pensó que habías dicho que no tenías ningún problema. ¿Qué quieres decir con las pruebas desde entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Bueno... Pues... En Mondstadt, todo es “prohibido volar aquí”, “prohibido aterrizar allá”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "Cada vez que obtengo mi licencia, me la revocan. Debo haber hecho la prueba unas 15 veces en total...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "Pero siempre paso a la primera. ¡Supongo que mi pequeño manual de vuelo no es tan malo después de todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
					"content": "#... {NICKNAME}, consigamos una copia del verdadero manual de vuelo de la Gran Maestra Intendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850617,
					"content": "De acuerdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "Me iré yo primero porque necesito escoltar a Ave Rapaz de vuelta a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
