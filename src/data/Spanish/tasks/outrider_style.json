					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "¡Ah, y te inscribiré para el próximo campeonato de vuelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "Yo vuelo tan rápido que nadie puede seguirme el paso, así que normalmente soy yo sola volando... Es un poco aburrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850807,
					"content": "Bueno. Definitivamente voy a ganar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "¡Oh, tienes mucho valor! ¡Jaja! Parece que no tienes idea de lo duro que es el campeonato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "Bueno, hasta que te patee el trasero en el campeonato, te deseo una feliz y liberadora experiencia de vuelo. Pero, sobre todo, conforme a la ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
