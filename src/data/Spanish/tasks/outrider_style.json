						4850620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850620,
					"content": "Cuando vuelvas a la ciudad, no olvides venir a buscarme a la Catedral. Te entregaré tu licencia de vuelo allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
