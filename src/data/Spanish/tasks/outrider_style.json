					"speakerTitle": "Paimon"
				},
				{
					"id": 4851109,
					"content": "#¡Es una versión exclusiva y personalizada para {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851110,
					"content": "#De todos modos, ¡la versión normal de la prueba no está a la altura {F#de la heroína}{M#del héroe} de Mondstadt!",
