			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tío He",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710570133,
					"content": "De repente, oyes un susurro detrás de ti:\\n“Jejeje... Carne de hongo... Jejeje...”.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "#Ustedes... Jeje, ¿qué {F#las}{M#los} trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570102,
					"content": "¡Guau! ¡Tienes un aspecto terrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#Y apareció sin hacer un solo ruido, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Podría ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "No lo creo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Jejeje... ¿Qué hacen ustedes aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570107,
					"content": "¿También se han quedado sin comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570108,
					"content": "¿Eres el Tío He?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "#¿Eh? Jovencit{F#as}{M#os}, ¿qué están diciendo? No puedo oírl{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570110,
					"content": "¡Te estamos preguntando si tú eres el Tío He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "Ooh, sí, jejeje. El mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570112,
					"content": "#¿También están atrapad{F#as}{M#os} aquí sin nada que comer? *Suspira*, qué mala suerte tienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570113,
					"content": "#Jeje, pero no se preocupen. Tengo algo de comida por aquí... Deben estar hambrient{F#as}{M#os}... Jejeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570114,
					"content": "Tanto hablar del tema ha hecho que Paimon tenga hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "¡Esos hongos no se ven bien!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Oh... tienes razón. Parece confuso, ¿y a qué se debe esa extraña expresión? ¡Paimon apuesta a que tiene que ver con los hongos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "¿Los hongos? Jejeje, la carne de hongo es deliciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570119,
					"content": "Tomen, ¿quieren un poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570120,
					"content": "Jejeje, ¿qué tal, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570121,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "¡La carne de hongo ha desaparecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570123,
					"content": "¡Olvídala, volvamos al campamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "¡No voy a ir! ¡Me he quedado sin carne de hongo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570125,
					"content": "Sin ella, no tendré fuerzas para caminar. Yo no voy a ninguna parte... No hay carne de hongo... Y no hay comida en otros lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570126,
					"content": "¡Con la carne de hongo puedo ir a cualquier parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570127,
					"content": "Entonces, ¿dónde podemos encontrar la carne de hongo que quieres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Carne de hongo... Jeje, sé dónde está. Déjenme encontrar un poco para todos. ¡Llenemos nuestras barrigas y luego tendremos fuerzas para trabajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570129,
					"content": "Debería estar por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570130,
					"content": "#Bueno, {NICKNAME}, Paimon cree que no tenemos más opción que seguirle la corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570131,
					"content": "Parece ser la única opción por ahora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "Carne de hongo... Jejeje... Un gran trozo de carne de hongo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570116,
					"content": "¡No puedes comer cualquier cosa extraña que te encuentres!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
		{
