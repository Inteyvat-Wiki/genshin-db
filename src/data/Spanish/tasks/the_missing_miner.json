			"dialogs": [
				{
					"id": 710571201,
					"content": "Ya no me pican los oídos, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710571202
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710571202,
					"content": "*Suspira*, ¿dónde puedo encontrar más carne de hongo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tío He"
				}
			]
