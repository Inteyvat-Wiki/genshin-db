			},
			"dialogs": [
				{
					"id": 710570201,
					"content": "¡Acabó con todos en un santiamén!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570202,
					"content": "¡Qué fuerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570203,
					"content": "Jejeje... Carne de hongo, carne de hongo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570204,
					"content": "Desde que probé la carne de hongo por primera vez, mi dolor lumbar desapareció y tengo más fuerza. Es como si hubiera rejuvenecido unos cuantos años.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570205,
					"content": "¡Los monstruos hongo son más deliciosos que la carne de hongo! Cuanto más grande sea la carne, más sabrosa... Jejeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570206,
					"content": "¿Será que el Tío He se ha puesto tan fuerte por comer carne de hongo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}, ¿por qué no comemos también un poco? ¡Podría otorgarnos más poder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570208,
					"content": "¿Segura que lo que buscas es más poder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "¡Paimon tiene curiosidad por saber a qué sabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570212,
					"content": "#Pero volviendo al tema. Ahora el Tío He no tendrá ningún problema en volver con nosotr{F#as}{M#os}, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570213,
					"content": "Carne de hongo... ¡Jeje, deliciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570214,
					"content": "¡Tío He, volvamos juntos al campamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570215,
					"content": "¿Eh? ¿Juntos? Claro, comamos juntos la carne de hongo. Jeje, la carne de hongo seca se puede almacenar durante años...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570216,
					"content": "¡Paimon dijo que volvamos juntos al campamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570217,
					"content": "¿Qué? ¿A dónde vamos? Bah, no importa... Jejeje, ahora que he comido carne de hongo, ¡puedo ir a cualquier lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570218,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}, llevemos al Tío He de vuelta con Jinwu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570210,
					"content": "¡No deberías comer cualquier cosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "E-está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105703,
			"completionStepIds": [
				7105707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105707",
							"2"
						],
						"stepId": 7105707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tío He",
					"Jinwu",
					"Paimon",
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710570301,
					"content": "Carne de hongo... Jeje... Comí carne de hongo, hongos pequeños, grandes y monstruos de hongo... Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570302
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570302,
					"content": "¿Tío He? ¿Por qué tienes esa expresión tan extraña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570303
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570303,
					"content": "*Suspira*... ¡Sabía que estabas vivo! Y pensar que tu familia me invitó a tu funeral. ¡Me negué a ir y les dije que aún no había nada seguro sin un cuerpo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570304
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570304,
					"content": "Mira el mal estado en el que estás. Debes haber sufrido atrapado en la mina, ¡pero me alegro de que aún estés respirando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570305,
					"content": "¡Respirar es bueno! ¡Los hongos que viven y respiran son deliciosos! Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570306
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570306,
					"content": "¿Tío He?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570307
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570307,
					"content": "Estaba así cuando lo encontramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570308,
					"content": "Parecía estar hecho un lío... y seguía diciendo que quería comer hongos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570309,
					"content": "Hongos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570310
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570310,
					"content": "La Sima es un lugar peligroso para la gente común. Las plantas y los hongos que crecen aquí también pueden ser perjudiciales para el cuerpo humano. Por eso el Salón Huishan ha establecido reglas estrictas para no comer cosas de aquí abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570311
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570311,
					"content": "Pero el Tío He ha estado atrapado aquí todos estos años sin nada más que comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570312
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570312,
					"content": "¿Han visto en qué estado se encuentra? ¿Cómo voy a explicárselo a su familia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570313,
						710570314
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570313,
					"content": "Hablando de hongos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				},
				{
					"id": 710570315,
					"content": "Ahora que lo mencionas, Khedive podría ayudar. Después de todo, es un erudito de Sumeru. Sus temas de investigación deben incluir los hongos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570316
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570316,
					"content": "Por favor, espera aquí. Lo traeré para que examine al Tío He.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570317
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570317,
					"content": "Carne de hongo... Carne de hongo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570318
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570318,
					"content": "*Suspira*, con lo mal que está el Tío He, Paimon no está segura de que pueda recuperarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570319,
					"content": "Si no logra recuperarse, será otro golpe para su familia cuando vuelva a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570320,
					"content": "No puedes secuestrarme así a la mitad de mi informe. Jinwu, aunque estés a cargo de la seguridad del equipo de espeleología, no está bien que perturbes mi investigación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570321
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570321,
					"content": "Estoy pensando seriamente en recortar su presupuesto tal y como lo han propuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570322
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570322,
					"content": "No importa el presupuesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570323
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570323,
					"content": "Por favor, examina a este hombre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570324
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570324,
					"content": "Me pican las orejas... Jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570325
					],
					"speakerTitle": "Tío He"
				},
				{
					"id": 710570325,
					"content": "¿Eh? ¿Y este quién es? ¿Por qué tiene esa expresión tan rara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570326
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570326,
					"content": "#{NICKNAME}, ¿tú lo encontraste? ¿Por qué siempre te tropiezas con cosas extrañas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570327
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570327,
					"content": "Bueno... ¿Cómo estaba cuando lo encontraron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570328
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570328,
					"content": "Le dices a Khedive lo que le pasó al Tío He...\\nKhedive lo examina cuidadosamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570329
					]
				},
				{
					"id": 710570329,
					"content": "Está bien. No es un gran problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570330
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570330,
					"content": "¿No se queja siempre de que le pican los oídos? Eso es porque le han debido entrar esporas de los hongos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570331
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570331,
					"content": "Aunque el consumo a largo plazo de este tipo de fungi... quiero decir, de hongos, perjudica la cordura, no hace daño al organismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570332
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570332,
					"content": "¿Quieres decir que se puede recuperar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570333
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570333,
					"content": "He limpiado cualquier resto de esporas y he preparado una medicina para que su sistema nervioso vuelva a la normalidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570334
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570334,
					"content": "Solo necesita descansar y estará bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570335
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570335,
					"content": "Ya veo. Sobre el precio de la medicina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570336
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570336,
					"content": "Ninguno de los ingredientes es caro. Valen lo mismo que un mes de comida en el Quiosco Xinyue. No es nada del otro mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570337
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570337,
					"content": "Oh... E-encontraré alguna manera de pagarte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570338
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570338,
					"content": "No es necesario. Al menos ahora ya tengo algo sobre lo que escribir en mi informe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570339
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570339,
					"content": "Desde que conocí los hongos especiales en la Sima, he sentido curiosidad por las consecuencias a largo plazo de su consumo... Pero aún no he encontrado un asistente dispuesto a ayudarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570340,
						710570342
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570340,
					"content": "¿Un asistente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570341
					]
				},
				{
					"id": 710570341,
					"content": "Es decir, alguien cuya responsabilidad sea comer los hongos. Todos parecen tener reparos. Aunque saben que no les va a pasar nada malo, no se atreven a hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570344,
					"content": "Pero... dado lo peculiar que es la Sima, el ambiente aquí podría ser otra causa de sus síntomas. De todos modos, que se tome la medicina y descanse un poco. La probabilidad de recuperación es relativamente alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570345
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570345,
					"content": "Qué alivio... Entonces, más tarde llevaré al Tío He a la superficie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570346
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570346,
					"content": "Cuando se recupere, lo llevaré a casa y avisaré a sus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570347
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570347,
					"content": "El Tío He es un minero experimentado y ágil. Cuidaba muy bien a los jóvenes novatos aquí en las minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570348
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570348,
					"content": "Cuando desapareció hace unos años, todo el mundo se preguntaba por qué Rex Lapis se había olvidado de él. Un buen hombre no debería haber acabado así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570349
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570349,
					"content": "Su regreso será una buena noticia para sus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570342,
					"content": "Mejor dicho, un “sujeto de experimentación”, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570343
					]
				},
				{
					"id": 710570343,
					"content": "Puedes llamarlo así, pero hemos estudiado este hongo y hemos llegado a la conclusión de que no causará ningún daño irreversible ni al cuerpo ni a la mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570314,
					"content": "¿Conoces a alguien que sepa de hongos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				}
			]
		},
