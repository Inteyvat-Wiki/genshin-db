				{
					"id": 710570416,
					"content": "Sobre Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570417
					]
				},
				{
					"id": 710570417,
					"content": "Está en el campamento, en la superficie. Dijo que quería organizar sus documentos de investigación para traerlos aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570418
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570418,
					"content": "Si quieres preguntarle algo, tendrás que esperar a que regrese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570419
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570419,
					"content": "Paimon espera que el Tío He se recupere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570420,
					"content": "*Suspira*... El Tío He es un minero experimentado y muy hábil. Cuidaba muy bien de los jóvenes novatos aquí en las minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570421
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570421,
					"content": "Cuando desapareció hace unos años, todo el mundo se preguntaba por qué Rex Lapis se había olvidado de él. Un buen hombre no debería haber acabado así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570422
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570422,
					"content": "Todo el mundo se pondrá contento si vuelve sano y salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570423
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570423,
					"content": "#Muchas gracias, {NICKNAME}. Cuando Khedive termine de revisar al Tío He, te llevaré de vuelta a la superficie, no importa qué pase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570424
					],
					"speakerTitle": "Jinwu"
				},
				{
