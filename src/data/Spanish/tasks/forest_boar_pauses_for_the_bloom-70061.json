			"dialogs": [
				{
					"id": 700610701,
					"content": "Oh... ¿Ya están aquí? ¿Cómo les fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610702,
					"content": "¡Ya lo ahuyentamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "Ah, muchas gracias. Toma, esta es tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610704,
					"content": "Quien trabaja duro se merece una recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610705,
					"content": "Ahora podré arreglar el campo de flores. Esperemos que esta vez no venga ningún bicho raro a causar problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
