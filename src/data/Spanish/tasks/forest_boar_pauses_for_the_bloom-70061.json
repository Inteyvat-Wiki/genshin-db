				]
			},
			"dialogs": [
				{
					"id": 700610101,
					"content": "*Suspira*, otra vez lo mismo... ¿Cómo es que el campo de flores terminó así de nuevo? Qué fastidio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "Estando así las cosas, no podré entregar las flores a tiempo... ¿Cómo se lo explico al comprador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "¿Qué ha pasado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "El campo de flores ha quedado destruido... *Suspira*, mira, eran unas flores tan bonitas, y ahora están arruinadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "¡Todo es culpa de ese desgraciado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "¡Es horrible! ¡Qué falta de humanidad!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "¡Sí! Qué falta de humanidad... Bueno, en realidad, el que hizo esto no es humano. ¡Es un jabalí del bosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "No sé por qué, pero últimamente no para de bajar a mordisquear las flores y revolcarse por todo el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "Además, es muy astuto. Cada vez que arma alboroto y alguien se acerca, huye de inmediato. Hace un momento casi le rompe la espalda a un anciano que pasaba por ahí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "¡Es horrible! Ese no es... ¡no es un buen jabalí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "#Humm, ahora que te veo bien... ¡Oh! ¿No eres {F#la}{M#el} Caballer{F#a}{M#o} Honorari{F#a}{M#o}? ¡{F#La gran heroína}{M#El gran hérore} que salvó Mondstadt! Por favor, ¡a-ayúdame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "Bien, ¡voy a ahuyentarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "#Qué bien que estés dispuest{F#a}{M#o} a ayudar... Si mal no recuerdo, creo que huyó hacia el valle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "Pero es muy astuto, así que quizás necesitemos flores para atraerlo... Lástima que el campo de flores esté así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "¡Quizás puedas recoger algunas flores vientosuspiro por el camino para engañarlo y sacarlo de su escondite! ¡Así sabrá lo que se siente cuando te toman el pelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
