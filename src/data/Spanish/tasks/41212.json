			},
			"dialogs": [
				{
					"id": 412120301,
					"content": "¿Eh? Parece que no hay nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120302,
					"content": "¿Los monstruos también salen a hacer mandados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120303,
					"content": "Bueno, antes de que aparezcan, ¿te gustaría dar una vuelta, o prefieres descansar un poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120304,
					"content": "¿Qué te parece un descanso y hablamos con calma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "Justo lo que estaba pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120309,
					"content": "¿Van a charlar? ¡Yo también quiero escuchar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120310,
					"content": "Sé que debes tener muchas dudas, ya sea sobre mí o sobre toda esta situación. Como dije antes, responderé a tus preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120311,
					"content": "Pero no te mentiré, hay algunas cosas que no puedo revelar. Sobre esto, tendrás que conformarte con mi silencio por ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120312,
					"content": "¿Eh? Albedo puede ser muy franco cuando se lo propone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120313,
					"content": "¡Más franco de lo que pensé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "¡Tiga plata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 412120316,
					"content": "Eh... ¿Qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120317,
					"content": "¡Odomu Movo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 412120318,
					"content": "¿Estás haciendo tú esos ruidos extraños, Albedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "¿Crees que yo haría eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120322,
					"content": "¡Ah! ¡Son Hilichurls!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "¿Estás haciendo tú esos ruidos extraños, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "¡Qué va! ¿Por qué le preguntas a Paimon y no a Albedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120314,
					"content": "Es más despreocupado de lo que pensé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "Bien, tengo algunas preguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120308,
					"content": "Bien. ¿Qué quieres saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				}
			]
		},
