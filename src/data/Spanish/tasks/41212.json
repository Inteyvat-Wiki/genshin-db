				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120601,
					"content": "Parece que no hay camino más adelante, excepto esta enorme entrada a la caverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120602,
					"content": "¿Habrá entrado ahí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120603
					]
				},
				{
					"id": 412120603,
					"content": "A juzgar por las pistas, ese parece ser el caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120604,
					"content": "Entonces, ¿qué estamos esperando? ¡No podemos dejarlo escapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120605,
					"content": "Un minuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120606
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120606,
					"content": "Esta montaña es increíblemente grande. Aunque hubiera un camino en sus entrañas, ese camino no sería fácil de recorrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120608,
					"content": "¿Perciben eso? El viento lleva consigo un aroma a hielo y piedra... y también un eco. Ese lugar debe ser enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120609
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120609,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120610,
					"content": "Es mejor no precipitarnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120611,
					"content": "Pero... pero hemos llegado tan lejos... ¡No podemos dejar que huya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120612,
					"content": "¿Ese cuaderno no es importante para ti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120613
					]
				},
				{
					"id": 412120613,
					"content": "Lo es. Pero eso no significa que debamos actuar de forma imprudente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120614
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120614,
					"content": "Hay otra forma, solo que requiere un poco de trabajo extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120615,
					"content": "Si mi suposición es correcta, la salida de esta caverna está al otro lado de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120616
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120616,
					"content": "#Eres muy {F#buena}{M#bueno} planeando, y yo también soy bastante hábil, así que prepárate para cruzar planeando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
