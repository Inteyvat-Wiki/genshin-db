				"points": []
			},
			"dialogs": [
				{
					"id": 412120701,
					"content": "Albedo, ¿cómo está el cuaderno de bocetos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120702,
					"content": "Está bien. Rompieron algunas páginas, pero la mayor parte está intacta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120703
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120703,
					"content": "En la montaña, las temperaturas están bajo cero. Pueden ser extremadamente bajas, sobre todo cerca de esa caverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120704
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120704,
					"content": "Lo peor de todo es que hay babas de Hilichurl en todas las páginas. Si dejo el papel mojado a una temperatura tan baja... No quiero ni pensar que ocurrirá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120705
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120705,
					"content": "El papel congelado se rompe muy fácilmente. Con solo tocarlo, se destruye, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120706,
					"content": "Afortunadamente, supiste cómo reconstruirlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120707
					]
				},
				{
					"id": 412120707,
					"content": "¡Qué mente tan ingeniosa, digno de un alquimista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120708,
					"content": "Si el daño fuera irreparable, estarías furioso, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120709,
					"content": "¿Por qué crees eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120710
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120710,
					"content": "Nos dijiste que tiene muchos bocetos y apuntes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120711,
					"content": "Sí, llevo este cuaderno de bocetos adonde quiera que vaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120712,
					"content": "Sin embargo, no me enojaría por algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120713
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120713,
					"content": "Si fuera irrecuperable, simplemente dibujaría todo de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120714,
					"content": "Eh... Qué pragmático eres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120715,
						412120716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120715,
					"content": "No creo que eso sea muy pragmático...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				},
				{
					"id": 412120717,
					"content": "Ah, ¿sí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120718
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120718,
					"content": "Después de todo, has puesto mucho esfuerzo en tus bocetos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120719
					]
				},
				{
					"id": 412120719,
					"content": "¡Así es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120720,
					"content": "Piensa en todos los recuerdos impregnados en el papel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120721
					]
				},
				{
					"id": 412120721,
					"content": "¡Eso, eso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120722,
					"content": "No deberías abandonar esos recuerdos tan a la ligera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120723
					]
				},
				{
					"id": 412120723,
					"content": "#¡Exactamente, bien dicho {NICKNAME}! Le robaste a Paimon sus palabras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120724,
					"content": "... Tienes razón. Además, volver a dibujarlo todo sería una tarea tediosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120725
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120725,
					"content": "¿Lo dices porque tienes mucho talento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120726,
					"content": "¡Dominas más habilidades y tienes más conocimientos de los que nadie podría imaginar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120727,
					"content": "Pero la gente con talento a veces se olvida de los pequeños detalles. Es una de las desventajas de ser inteligente, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120728,
					"content": "Albedo también elogió tu inteligencia, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120729
					]
				},
				{
					"id": 412120729,
					"content": "Sin duda, Paimon es una criatura interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120730,
						412120731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120730,
					"content": "¿Paimon, tú también te olvidas de los pequeños detalles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120732,
					"content": "¡Oye, no te burles de Paimon cuando está compartiendo sus conocimientos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120733,
					"content": "Bueno, cambiemos de tema. Cyrus me dijo que los Hilichurls de esta montaña atacan y roban a los aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120734
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120734,
					"content": "El lugar que visitamos debe ser uno de sus campamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120735,
					"content": "Los Hilichurls de esta zona son muy fuertes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120736
					]
				},
				{
					"id": 412120736,
					"content": "Sí, los Hilichurls de aquí son mucho más fuertes que los de la base de la montaña.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120737,
					"content": "Yo también pienso lo mismo. Supongo que... esto debe estar relacionado con el dragón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120738
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120738,
					"content": "El poder corruptor que emana de los restos de Durin está fortaleciendo a los monstruos que, junto con el clima gélido, han convertido algunas áreas en tierra de nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120739
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120739,
					"content": "#¿Puedes sacar la espada, viajer{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120740
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120740,
					"content": "Cada vez que luchabas en las montañas, esta espada absorbía poder y lo almacenaba en su interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120741
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120741,
					"content": "Además, gracias a tu purificación, el poder corruptor de la sangre del dragón parece haber desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120742
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120742,
					"content": "Es un fenómeno muy interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120743
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120743,
					"content": "#No es la primera vez que hacemos algo así. ¡Somos expert{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120744,
					"content": "Así que así se ve purificado... Sabía que lo lograrías, pero verlo con mis propios ojos es una experiencia única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120745
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120745,
					"content": "Una espada que absorbe energía... debe ser bastante peligrosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120746
					]
				},
				{
					"id": 412120746,
					"content": "De hecho, no puedo decir que sea la más segura de las armas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120747
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120747,
					"content": "¡Qué suerte que esos Hilichurls no te la arrebataron! ¡Habría sido nuestro fin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120748,
						412120749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120748,
					"content": "¿No son los Fatui una amenaza mayor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120750,
					"content": "¡Los Hilichurls también son una amenaza! ¿Y si ese poder pudiera convertirlos en... super... no, ultrahilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120751,
					"content": "¡Megahilichurls!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120752
					]
				},
				{
					"id": 412120752,
					"content": "¡Megahilichurls demoniacos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120753,
					"content": "¡Megahilichurls demoniacos de las nieves!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120754
					]
				},
				{
					"id": 412120754,
					"content": "¿“De las nieves”? Ya lo arruinaste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120755
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120755,
					"content": "Hablando de la espada... Si es tan poderosa, ¿no puede absorber tu energía también, Albedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120756,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120757
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120757,
					"content": "¿Quieres probarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120758
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120758,
					"content": "¡Ay, qué mirada tan fría!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120759,
						412120760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120759,
					"content": "Paimon solo estaba bromeando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120761,
					"content": "No estoy molesto. Después de todo, aún espero que sigas usando esta espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120762
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120762,
					"content": "#¿Aún confías en nosotr{F#as}{M#os}? ¿Aunque esta espada sea tan peligrosa? Qué inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120763,
					"content": "Albedo, dices una cosa pero haces otra... ¡Paimon nunca sabe con certeza lo que tienes en mente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120764,
					"content": "No sé de qué hablas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120765
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120765,
					"content": "Pero si quieres saber por qué confío en ustedes... es porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120766
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120766,
					"content": "La gente “especial” como nosotros nos entendemos bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120767
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120767,
					"content": "¿“Especial”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120768
					]
				},
				{
					"id": 412120768,
					"content": "Individuos solitarios... Aquellos que no son como la gente común. Como tú y como yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120769,
						412120770
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120769,
					"content": "(¿...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120770,
					"content": "(¿Qué está insinuando?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120760,
					"content": "Paimon no lo dijo con malas intenciones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120749,
					"content": "¿No son los Ladrones de Tesoros una amenaza mayor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120731,
					"content": "No creo que Paimon tenga el mismo problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120716,
					"content": "¡Yo habría explotado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				}
			]
		},
