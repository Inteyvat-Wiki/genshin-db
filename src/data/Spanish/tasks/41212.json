			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "¿Viste eso? ¡Ese Hilichurl escapó mientras sostenía algo que parecía un libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120502,
					"content": "Oh, no... Ese era mi libro de dibujo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120503,
					"content": "Tal vez el Hilichurl quiera ser un gran artista algún día.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "En realidad, Paimon cree que es solo un ladrón común y corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120506,
					"content": "Y pensar que se atrevió a robar mi cuaderno de dibujo. Muy audaz por su parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120507,
					"content": "Albedo mantiene la calma hasta cuando se enoja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120508,
					"content": "¡Yo te ayudo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "¿Él también quería aprender alquimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
			]
		},
