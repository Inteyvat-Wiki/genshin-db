					"id": 230230701,
					"content": "#Viajer{F#a}{M#o}, ayúdanos a regar esta rosa, si no te importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230702
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230702,
					"content": "¡Siempre que tenga agua suficiente, la rosa volverá a crecer!",
					"roleType": "TALK_ROLE_NPC",
