			"dialogs": [
				{
					"id": 230230201,
					"content": "Necesitamos bastante fertilizante especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230202,
					"content": "Aún nos quedan ingredientes para preparar el fertilizante especial, excepto frutos harra, que se nos han agotado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230203,
					"content": "#Viajer{F#a}{M#o}, ¿podrías traernos unos pocos frutos harra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302303,
			"completionStepIds": [
				2302303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302303",
							"2"
						],
						"stepId": 2302303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "#Con esto debería bastar. ¡Muchas gracias, viajer{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Con este fertilizante especial no habrá ningún problema con la fertilidad de la tierra y seguro que la rosa crecerá estupendamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "Espero que no pase igual que con los fertilizantes que usamos antes. No surtieron efecto alguno después de esparcirlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "¿Ya usaron fertilizantes antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Usamos algunos bastante comunes, pero no muy efectivos... Bueno, de hecho, no nos dieron ningún resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Pero los mismos fertilizantes funcionaron muy bien con otros terrenos, así que en realidad no sé cuál es el problema con este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "#No hablemos de eso ahora. Esto es un pequeño regalo de agradecimiento. Viajer{F#a}{M#o}, por favor, acéptalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302304,
			"completionStepIds": [
				2302304
