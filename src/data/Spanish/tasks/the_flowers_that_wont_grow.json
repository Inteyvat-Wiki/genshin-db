			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "Puede que aparte de la fertilidad de la tierra, también haya algún problema con el agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "¿Quizás plantamos la rosa demasiado profundo y no puede absorber suficiente agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "#Viajer{F#a}{M#o}, ayúdanos a regar la rosa, si no te importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302306,
			"completionStepIds": [
				2302306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302306",
							"2"
						],
						"stepId": 2302306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan",
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Uf... ya está. La tierra debería tener suficiente humedad de momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230602,
					"content": "#Gracias, viajer{F#a}{M#o}. Habríamos acabado exhaustos de no haber contado con tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230603,
					"content": "¡Qué extraño! ¿Cómo es que esta vez necesitamos tanta agua para humedecer la tierra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230604,
					"content": "Creo que esta vez tuvimos que usar por lo menos el doble de la que usamos normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230605,
					"content": "Creo que solo te lo parece porque estás muy cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230606,
					"content": "El terreno se habría anegado de haber empleado el doble de agua, pero ¿ves? Ahora tiene la humedad justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230607,
					"content": "Supongo que es como dices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230608,
					"content": "Espero que la rosa crezca bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "No te preocupes. Cuidaremos muy bien de esta rosa por el bien de los pacientes y de los médicos del bimaristán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230610,
					"content": "#Por favor, acepta esto como agradecimiento, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230611,
					"content": "¡Ay! Pero me sigue pareciendo que esta vez usamos mucha más agua de lo normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
