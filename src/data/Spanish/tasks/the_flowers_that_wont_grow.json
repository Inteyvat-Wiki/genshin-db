			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen",
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "Padre, esto no puede seguir así. La rosa no está creciendo como debe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230102,
					"content": "Tenemos que pensar en algo. ¡De lo contrario, este año no podremos entregar las hierbas medicinales a tiempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230103,
					"content": "La tierra no tiene ningún problema y hemos eliminado todas las malas hierbas e insectos dañinos. ¿Qué es lo que pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230104,
					"content": "¿Qué es lo que les preocupa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "¿Oh? ¿Vienes a comprar hierbas medicinales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230106,
					"content": "Lo que pasa es esto. Cada cierto tiempo vamos al bimaristán a entregar un lote de hierbas medicinales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230107,
					"content": "Y la más importante de ellas es esta rosa de Sumeru especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230108,
					"content": "¿Las rosas también tienen usos medicinales?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "Eso se lo tendrías que preguntar a los médicos del bimaristán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230110,
					"content": "De todas formas, dicen que, mezclada con otras medicinas, este tipo de rosa permite curar la insolación. También alivia los problemas de estómago, entre otros usos... No me acuerdo bien de todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230111,
					"content": "En tal caso, puedo ayudarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "¡Estupendo, muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230113,
					"content": "¿Qué le pasa a esta rosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "No sabemos por qué, pero esta rosa está creciendo muy lentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230115,
					"content": "Según nuestra propia experiencia, esto puede pasar porque la tierra tenga algún problema o porque haya una plaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230116,
					"content": "Pero en esta misma tierra plantamos antes algunas hierbas y crecieron sin problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230117,
					"content": "Además, cada día efectuamos control de plagas, así que no puede tratarse de insectos dañinos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230118,
					"content": "Ya no hay tiempo para obsesionarse con posibles causas. Si todo sigue demorándose más, no podremos entregársela al bimaristán a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230119,
					"content": "Así que decidimos abonar la tierra con un fertilizante especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230120,
					"content": "Todavía tenemos que encargarnos de otros campos de hierbas medicinales. No tenemos tiempo para juntar todos los materiales que se necesitan para fabricar el fertilizante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230121,
					"content": "#Viajer{F#a}{M#o}, ¿podrías ayudarnos, aunque sea por los enfermos en el bimaristán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230122,
					"content": "Les ayudaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "¡Estupendo, muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230124,
					"content": "Veamos cuál es la situación actual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
