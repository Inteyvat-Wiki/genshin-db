			"dialogs": [
				{
					"id": 740820701,
					"content": "Una gota de agua cristalina aparece sobre el altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "Eh, esta gota de agua... ¿será el tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830103,
					"content": "No parece ser el tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "Paimon piensa lo mismo... Al fin y al cabo, fue demasiado fácil conseguirla... ¿Qué será entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830105,
					"content": "Quizá sea el objeto clave para reprimir al Rey Demonio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "Tal vez alguien la dejó aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "¿Qué? ¡Entonces seríamos los culpables de una gran catástrofe! ¡Rápido, déjala donde estaba! ¡Ojalá no sea demasiado tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830107,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830108,
					"content": "¡Estamos perdidos! ¡El Rey Demonio ya está aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830109,
					"content": "¿El Rey Demonio? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830111,
					"content": "¿Cómo? Se acabó. ¿Nos has tomado por ladrones? Discúlpanos... Dejémosla ahora mismo donde estaba. ¡Rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830112,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830113,
					"content": "¡Estamos acabados! ¡Regresó el dueño!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830114,
					"content": "¿El dueño? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830115,
					"content": "Qué susto... Resultó ser una melusina... ¿Qué haces por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830116,
					"content": "Llave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830117,
					"content": "¿Q-qué llave? ¿Esta gota de agua es una llave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830118,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830119,
					"content": "Eh... ¿Quieres decir que esta gota de agua es Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830120,
					"content": "Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830121,
					"content": "¡Ay! Paimon no se entera de nada. ¿Esta gota de agua es una melusina? Paimon está muy perdida, ¿no se supone que tú eres una melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830122,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830123,
					"content": "Eh... ¿Que tú eres Pahsiv? ¿O que te llamas Pahsiv? Espera... Paimon se confundirá todavía más con tus respuestas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830124,
					"content": "Paimon ha decidido que te llamará Pahsiv, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830125,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}... ¿Qué hacemos? Paimon no la comprende en absoluto, ¿qué está diciendo?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830127,
					"content": "Puedes comprender lo que decimos, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830129,
					"content": "Esta gota de agua es una llave, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830131,
					"content": "No eres humana, ¿correcto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830133,
					"content": "Oye, tampoco te pongas a insultarnos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830134,
					"content": "#No soy human{M#o}{F#a}, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "¿M-melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830136,
					"content": "¡Aaah! Espera, Paimon lo entiende... “Pahsiv” significa afirmación y “melusina” significa negación, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830137,
					"content": "¡Pahsiv, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830138,
					"content": "Así que no te llamas Pahsiv... Disculpa a Paimon por equivocarse con tu nombre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830139,
					"content": "Pahsiv... Gustar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830140,
					"content": "¿Te gusta este nombre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830142,
					"content": "#¡Genial! Te llamaremos así, jeje. Paimon es Paimon, y est{F#a}{M#e} es {NICKNAME}, es un placer conocerte. Paimon nunca había visto una melusina como tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830143,
					"content": "#¡Paimon, Pahsiv! ¡{NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830144,
					"content": "Erinias... Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830145,
					"content": "¿Negar Erinias? Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830146,
					"content": "¿Algo ha sucedido en las Erinias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "Erinias, melusina, ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830148,
					"content": "Pahsiv, Erinias, proteger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830149,
					"content": "Las Erinias están en peligro en estos momentos, ¿por eso quieres protegerlas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830150,
					"content": "#Paimon, {NICKNAME}, Erinias, ¡bum, bum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830151,
					"content": "#Eh... Esta vez has dicho cinco palabras. ¿Quieres que Paimon y {NICKNAME} hagan “bum, bum” en las Erinias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830152,
					"content": "¡Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830153,
					"content": "¿Quieres que te ayudemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830155,
					"content": "Así que nos pides ayuda. Menos mal. Sería muy difícil si de verdad tuviéramos que hacer “bum, bum” en las Erinias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830156,
					"content": "Bum, bum... Bum, bum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830157,
					"content": "¿Hay recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "¿Y cómo la ayudamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "¿Recom... pensa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830159,
					"content": "#Vaya, {NICKNAME}. Ya viste que Pahsiv no sabe hablar tanto, seguro que no encontró a nadie que la ayudara. ¿Qué te parece si le echamos nosotr{F#a}{M#o}s una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830160,
					"content": "¿Y cómo la ayudamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "Llave, llave, llave, cantidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830163,
					"content": "¿Y qué más? ¿Cuántas llaves hay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830164,
					"content": "¡Llave! ¡Llave! ¡Llave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830165,
					"content": "¿Tres llaves?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "¡Pahsiv! Llave, Senda Silvícola, sur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830167,
					"content": "Llave, manantial, norte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830168,
					"content": "Llave, sauce llorón, este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830169,
					"content": "Oh, conque se refería a eso... Paimon va a anotarlo... Hay tres llaves en total, una en la Senda Silvícola del sur, otra en el manantial del norte y otra donde el sauce llorón del este... ¿Correcto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830170,
					"content": "Llave, llave, llave, plaza, oeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830171,
					"content": "¿Hay tres llaves más en la plaza del oeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830172,
					"content": "¿Hay que ir a la plaza después de conseguir las tres llaves?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#¡Paimon, melusina! ¡{NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830174,
					"content": "#Oye, Pahsiv, deja de decir esas cosas que hacen que {NICKNAME} parezca más inteligente que Paimon. ¡Que quede claro que Paimon es igual de inteligente que {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830175,
					"content": "En fin, hasta ahora ya tenemos una llave. Solo hay que conseguir las otras dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830176,
					"content": "¡Erinias, melusina, Pahsiv, proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830177,
					"content": "No te preocupes. Aunque no sabemos qué ocurre, te ayudaremos a proteger las Erinias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830178,
					"content": "Paimon quiere añadir un detalle más. Pahsiv, si alguna vez te encuentras con algo dorado y redondo y que nadie quiera, o con algún cofre que parezca valioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830179,
					"content": "¡No dudes en avisarnos de inmediato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv se toca la cabeza como si lo hubiera entendido, da dos saltitos de alegría y se va apresuradamente.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#Vaya, salió disparada, parece muy urgente. {NICKNAME}, ¿vamos ahora a buscar las otras dos llaves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
