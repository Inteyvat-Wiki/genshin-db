			"dialogs": [
				{
					"id": 740831001,
					"content": "Bien, otra llave más. Ya solo falta por encontrar la última.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831002,
					"content": "¡Llave, llave, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831003,
					"content": "¡Ah! Pahsiv, ¡¿cómo apareciste tan de repente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831004,
					"content": "Sin rastro, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831005,
					"content": "De acuerdo... Eres la melusina más especial que Paimon ha visto. Por cierto, que Paimon recuerde, la mayoría de las melusinas viven en la Corte de Fontaine o en la Aldea Espumarina... ¿Cómo acabaste aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831006,
					"content": "¿Corte de Fontaine? ¿Aldea Espumarina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831007,
					"content": "Pareces muy confusa, ¿no has oído hablar de estos dos nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831008,
					"content": "Corte de Fontaine, melusina... Aldea Espumarina, melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831009,
					"content": "Ah... Erinias, Pahsiv, hogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831010,
					"content": "¡Erinias, Pahsiv, proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831011,
					"content": "Espera, ¿dices que este es tu hogar? ¿Estás protegiendo tu hogar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831012,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831013,
					"content": "Pero ¿no es la Aldea Espumarina el hogar de las melusinas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "Claro. Qué raro, ¿acaso hay melusinas nacidas en otros sitios? Tampoco parece que haya otras melusinas por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831015,
					"content": "Pahsiv, ¿vives aquí sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831016,
					"content": "¿Sola? Melusina. ¡Neovalet! ¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831017,
					"content": "¿Neo...valet? ¿Hay algún valet? ¿Quién es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831018,
					"content": "#¡Neovalet! ¡Paimon, Paimon! ¡{NICKNAME}, {NICKNAME}! ¡Neovalet, Neovalet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831019,
					"content": "¿Quién es Neovalet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831020
					]
				},
				{
					"id": 740831020,
					"content": "Pahsiv... no querrás decir que, al igual que Paimon es Paimon, ¿Neovalet es Neovalet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831021,
					"content": "¡Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831022,
					"content": "¡Ja! ¡Paimon lo sabía! ¿Ves como Paimon es superinteligente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831023,
						740831024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831023,
					"content": "Es un nombre muy raro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				},
				{
					"id": 740831025,
					"content": "Neovalet, Pahsiv, conocimiento, bum, bum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831026,
					"content": "Humm... ¿Quieres decir que Neovalet te ayudó a aprender nuevos conocimientos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831027,
					"content": "¡Pahsiv! Muchos. Lenguaje, sabiduría... muchos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831028,
					"content": "Humm, a Paimon le parece que tampoco fue para tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831029,
					"content": "Pahsiv, Neovalet, proteger, bum, bum.",
