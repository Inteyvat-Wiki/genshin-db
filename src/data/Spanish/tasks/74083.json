					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#¡Paimon, Pahsiv! ¡{NICKNAME}, Pahsiv! ¡Llave, llave, llave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830206,
					"content": "¡Plaza, oeste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830207,
					"content": "Jeje, ¿eso es lo que querías decir? No tengas prisa, vamos enseguida.",
