			"dialogs": [
				{
					"id": 766740101,
					"content": "Vaya, vaya, el resultado final ha superado todas mis expectativas... Si alguien llega a entrar aquí por error, seguro que quedará verdaderamente maravillado por el poder de esta bruja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740102,
					"content": "Si alguien verdaderamente termina aquí por error...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "Bueno, eso depende del tipo de persona que sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740105,
					"content": "El hecho de guiar a alguien puede fomentar la complacencia y la arrogancia si no se tiene cuidado. Si están dispuestos a confiar en sus propias habilidades, como haces tú, entonces con gusto los ayudaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740106,
					"content": "Pero si son del tipo de personas que depositan todas sus esperanzas en el poder de una bruja y no quieren mover ni un dedo... bueno, jeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740107,
					"content": "... ¿Qu-qué quieres decir con esa risilla? ¿Los convertirías en estatuas de verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766740108,
					"content": "No, para nada. Simplemente los enviaría fuera de aquí, a la Cámara de Secretos. Estoy segura de que Néfer sabría cómo tratar con ellos mejor que yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740109,
					"content": "Aquellos que quieren cosechar sin sembrar deben pagar algún precio, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740103,
					"content": "¿Los guiarás para que cumplan sus deseos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
	]
