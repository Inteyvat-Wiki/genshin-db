			},
			"dialogs": [
				{
					"id": 705280401,
					"content": "No sé si el Gremio podrá con todo el trabajo, *suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "#¡Viajer{F#a}{M#o}! Disculpa, estaba absorto pensando en algunos asuntos del Gremio y no te vi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "¿Regresaron a Mondstadt para participar en el Festival de las Flores de Viento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "En el Gremio de Aventureros estamos promoviendo un nuevo juego. ¡Es muy relajado e interesante, y con premio seguro para los participantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "¿Qué, les gustaría probar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "Primero les explicaré de qué va el juego. El miembro del Gremio que lo diseñó lo ha llamado “Ajedrez floral”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "Dijo que obtuvo la inspiración de los pétalos de flores al flotar y del viento que los persigue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "El juego pretende reproducir esa sensación... romántica de perseguir los pétalos de flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "Qué juego tan... poético.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Bueno, el tipo que lo inventó también es bardo. Es normal que tenga bastante... imaginación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "En resumen, los jugadores de este “ajedrez” deben recorrer varios tableros en los que hay diseminados globos de flores de viento e intentar recoger cuantos más globos puedan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "Además, tendrán que evitar todo tipo de obstáculos mientras recogen los globos... Por supuesto, en los tableros también hay diversos tipos de ayudas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "El inventor hasta escribió un manual de juego muy detallado. Puedes echarle una ojeada luego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "#Si te interesa, ¡eres más que bienvenid{F#a}{M#o} a jugar! ¡Recuerda que hay premios solo por participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "Uf, suena un poco complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}