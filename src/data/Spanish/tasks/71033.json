							"2"
						],
						"stepId": 7103301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "#¡Viajer{F#a}{M#o}, viajer{F#a}{M#o}! ¡Por aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330102,
					"content": "Ah, eres el pintor que retó a Chingzhou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "¡El mismo! Ese poeta y yo acordamos que cada uno haría una obra que representase el Rito de la Linterna de la mejor forma posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330104,
					"content": "La última vez me ayudaste a conseguir los materiales. Seguro que lo recuerdas, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330105,
					"content": "Sí, lo recuerdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "¿Mis cuadros? Ah, *ejem*... En realidad, tengo varios de paisajes, retratos e incluso de animales...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330108,
					"content": "Estoy convencido de que mis cuadros hablan por sí mismos... Pero no tengo ninguno que represente el Rito de la Linterna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330109,
					"content": "*Suspira*, últimamente apenas tengo apetito, y tampoco consigo conciliar el sueño. Además, mis utensilios de dibujo están a punto de acabarse, y sigo sin poder terminar el cuadro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330110,
					"content": "Así que se me ocurrió ir a buscar a ese poeta para ver cómo iba con su poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330111,
					"content": "#Viajer{F#a}{M#o}, ¿sabes a dónde fue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330112,
					"content": "Fue a la Aldea Chingtsé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "¿A la Aldea Chingtsé? ¿Qué hace allí? ¿Tal vez... fue a buscar inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330114,
					"content": "#Rápido, viajer{F#a}{M#o}, ¡vayamos a la Aldea Chingtsé, deprisa! Si ese lugar es adecuado, quizás yo también pueda encontrar algo de inspiración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330115,
					"content": "*Ejem*, en fin, ¡vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330106,
					"content": "¿Qué tal tus cuadros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "Estamos en la Aldea Chingtsé, ¿cierto? ¿Dónde se habrá metido ese poeta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "La última vez estaba jugando a adivinar acertijos de linternas con unos niños...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "¿Acertijos de linternas? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "¿Tal vez reconoció su derrota porque no encontró inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "Olvídalo. No importa qué esté haciendo, el Rito de la Linterna acabará dentro de poco, no puedo perder más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "Bueno, volviendo a nuestro asunto, vayamos a averiguar. Hoy tenemos que decidir un ganador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abuela Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "#Ah, saludos, viajer{F#a}{M#o}. Gracias a ti, al fin la Aldea Chingtsé tiene un ambiente festivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710330402,
					"content": "Oh, el rostro de esa persona a tu lado me es familiar... Es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710330403,
					"content": "... el pintor. Vino a buscar a Chingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "¿A buscar al señor Chingzhou? Humm... Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710330405,
					"content": "Unos días antes de que la señorita Wangya se fuera, el señor Chingzhou dijo que quería quedarse un poco más por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710330406,
					"content": "Quizás todavía está jugando a los acertijos con los niños. Creo que se los llevó afuera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710330407,
					"content": "Si quieren encontrarlo, será mejor que vayan a buscarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710330408,
					"content": "#Así que de verdad está jugando a los acertijos... Viajer{F#a}{M#o}, ¿puedes darte una vuelta y echarle un ojo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330409,
					"content": "Dile a ese poeta que he venido, y que estoy preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330410,
					"content": "Pase lo que pase, hoy será la batalla final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "¡Jaja! Parece que ya entendieron cuál es el truco. ¡Son cada vez más rápidos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330502,
					"content": "Vermeer está aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "¿Vermeer?... ¡Ah, ese pintor! Ahora que lo pienso, hoy es el día definitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330505,
					"content": "Es una pena, todavía no he terminado de escribir mi poema. Estos niños no se han hartado de jugar a los acertijos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330506,
					"content": "Jeje, parece que mi talento como poeta tiene un límite... Hagamos esto, acompáñeme a buscar un poco de inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330507,
					"content": "Bueno, más que buscar inspiración, debería decir que me acompañe a dar un paseo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330508,
					"content": "¡Señor Chingzhou! ¿Ya no vamos a jugar a los acertijos? Todavía quiero jugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330509,
					"content": "¡Yo también! Señor Chingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 710330510,
					"content": "¡Sí, yo también quiero seguir jugando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "You"
				},
				{
					"id": 710330511,
					"content": "#Jajaja, calma, calma. Dejen que vaya a dar una vuelta con {M#este viajero}{F#esta viajera}, habrá nuevos acertijos cuando vuelva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330512,
					"content": "Regresen ustedes a la Aldea Chingtsé. Cuando llegue el momento, iré a buscarlos. ¿Les parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330513,
					"content": "¡Bien! ¡Señor Chingzhou, es usted increíble! ¿Cómo puede pensar en tantos acertijos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330514,
					"content": "El señor Chingzhou debe haber leído bastantes libros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 710330515,
					"content": "Si yo tuviera la misma imaginación que el señor Chingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330516
					],
					"speakerTitle": "You"
				},
				{
					"id": 710330516,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330517
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330517,
					"content": "#Vamos, viajer{F#a}{M#o}, apresurémonos para zanjar este asunto tan trivial. No haga esperar mucho a los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330503,
					"content": "¿Recuerdas la competición con Vermeer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				}
			]
		},
		{
			"id": 7103309,
