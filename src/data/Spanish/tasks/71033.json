				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abuela Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331201,
					"content": "¿Eh? ¿Ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710331202,
					"content": "Es sobre la apuesta entre Chingzhou y Vermeer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "Ah, te refieres a ellos dos... No pasa nada, si quieren jugar con los niños, está bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710331204,
					"content": "Es un festival, mientras más animado, mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710331205,
					"content": "#Jovencit{F#a}{M#o}, tú siempre andas corriendo de aquí para allá por toda la Aldea Chingtsé. Debes estar muy cansad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710331206,
					"content": "No es nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "#Te veo muy entusiasmad{F#a}{M#o}... Por favor, acepta esto. Gracias, y que disfrutes del festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710331209,
					"content": "Ojalá el próximo Rito de la Linterna sea así de animado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 710331207,
					"content": "Es muy amable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
			"id": 7103314,
			"completionStepIds": [
				7103314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103314",
							"2"
						],
						"stepId": 7103314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "¡Niños! Contemplen esta linterna celeste. Es un objeto del Rito de la Linterna, adivinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331402,
					"content": "#Yo debo ir a atender unos asuntos con {M#este viajero}{F#esta viajera}. Cuando termine, regresaré a jugar con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331403,
					"content": "Señor Chingzhou, ¿qué tiene que hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 710331404,
					"content": "Un pintor y yo acordamos... eh... un reto. Tengo que escribir el mejor poema para competir con su mejor pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331405,
					"content": "¡Por supuesto que ganará, señor Chingzhou! Si puede escribir tantos acertijos, ¡un poema no es nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331406,
					"content": "¿Eso creen? Gracias por sus elogios. Mientras tanto, llévense estas linternas celestes de vuelta a la Aldea Chingtsé e intenten adivinar el acertijo. Este sitio no es muy seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331407,
					"content": "No se preocupe, señor, conocemos este lugar como la palma de la mano. Podemos regresar por nuestra cuenta. ¡Vaya a darle una lección a ese pintor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331408,
					"content": "Señor Chingzhou, vuelva en cuanto termine su reto con ese pintor, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "You"
				},
				{
					"id": 710331409,
					"content": "¡Por supuesto! En cuanto termine, iré a buscarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331410,
					"content": "A decir verdad, es un buen poema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "Creo que este poema será el ganador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "Jeje, ¿un poema, dices? No es más que un simple acertijo de linterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331413,
					"content": "Bien, vamos a buscar a ese pintor. Seguramente me está esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
