				"points": []
			},
			"dialogs": [
				{
					"id": 710330801,
					"content": "Humm... Bien. Ya pensé en algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330901,
					"content": "Bien, ya escribí los acertijos. Volvamos a la Aldea Chingtsé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330902
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710330902,
					"content": "Cuando lleguemos, le contaré el acertijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 7103310,
			"completionStepIds": [
				7103310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103310",
							"2"
						],
						"stepId": 7103310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeña Liu",
					"You",
					"Zuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "¡El señor Chingzhou volvió! Señor Chingzhou, ¿ya escribió nuevos acertijos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "Pequeña Liu"
				},
				{
					"id": 710331002,
					"content": "¡Creo que esta vez podré resolverlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331003,
					"content": "Esta vez lo pensaré bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "You"
				},
				{
					"id": 710331004,
					"content": "¡Jaja! Ya escribí el acertijo para esta ocasión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331005,
					"content": "#Viajer{F#a}{M#o}, por favor, ayúdeme. Cuelgue esta linterna celeste un poco más alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				}
			]
		},
		{
			"id": 7103311,
			"completionStepIds": [
				7103311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103311",
							"2"
						],
						"stepId": 7103311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "Al fin viniste, ¿ya está listo el poema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331102,
					"content": "Todavía no he escrito un poema adecuado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331103,
					"content": "¡Oye...! *Ejem*, ¿por qué no lo has escrito aún?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331104,
					"content": "Un lugar tan vasto como Liyue, iluminado por decenas de miles de linternas celestes... Por más que lo piense, no puede ser descrito en unas cuantas palabras. ¿Qué hay de tu pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331105,
					"content": "Y-yo...Yo tampoco... ¡Liyue es tan grande! ¡Ni el lienzo más grande podría plasmar su grandeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331106,
					"content": "En otras palabras, ni tú ni yo tenemos la imaginación suficiente para representar a Liyue y el Rito de la Linterna en un poema o en una pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331107,
					"content": "Entonces, llamémoslo un empate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331108,
					"content": "Eh... Está bien. Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331109,
					"content": "¡Señor Chingzhou! ¡Señor Chingzhou! ¡Ya adivinamos el acertijo de la linterna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331110,
					"content": "¿Acertijo? ¿En una linterna? ¿De qué están hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331111,
					"content": "No le prestes mucha atención, estoy haciendo acertijos como una forma de pasar el tiempo con los niños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331112,
					"content": "¿Ah, sí? ¿Y qué tipo de acertijos son esos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331113,
					"content": "“Sobre las olas del mar vuelan los navíos; nubes solitarias flotan en los picos vacíos. En las mareas la luz revolotea y se refleja, hasta que al hundirse llega al fondo y se enmadeja”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331114,
					"content": "¿Y se supone que eso es un acertijo para niños?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331115,
					"content": "Señor Chingzhou, ¿quién es este señor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331116,
					"content": "Es ese pintor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "Oye, tú, poeta, si no quieres competir conmigo, ¿para qué te tomas la molestia de aceptar el desafío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331119,
					"content": "Oh, creo que me malinterpretaste. En un principio, yo también pensaba en escribir el poema definitivo que garantizaría mi victoria. Fui a todos lados en busca de inspiración, y puse todo mi esfuerzo en escribir unos cuantos versos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331120,
					"content": "Pero, como también te habrás dado cuenta, unas cuantas palabras no alcanzan para plasmar la majestuosidad de Liyue y el Rito de la Linterna. Así que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331121,
					"content": "¿Así que huiste hasta aquí para jugar con los niños y darles acertijos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331122,
					"content": "Precisamente. Vine a jugar con los niños, darles acertijos y encontrar inspiración para mi poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331123,
					"content": "Jeje. Aunque no encontré ni un soplo de inspiración, se me han ocurrido un sinfín de acertijos, y los niños parecen estar felices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331124,
					"content": "Quizás ese sea el poema que estaba buscando. Es una pena que no pueda plasmarlo en papel, así que no puedo competir contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331125,
					"content": "Ustedes, la gente de Liyue... ¡qué raros son! Entonces, ¿cómo arreglamos nuestra competición? Debe haber un ganador y un perdedor, ¿cierto? No puedo aceptar un empate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331126,
					"content": "Ese señor habla demasiado... Es obvio que ganó el señor Chingzhou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331127,
					"content": "¡Es genial! Se le ocurrieron un montón de acertijos, ¡seguro que no puedes adivinar ninguno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331128,
					"content": "Este poeta... Espera, tengo una idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331129,
					"content": "¡Hagamos esto! ¡Tendremos una revancha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331130,
					"content": "¿Eh? ¿Qué clase de revancha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331131,
					"content": "Estás haciendo acertijos para los niños, ¿cierto? Cuando estaba buscando inspiración, también observé los patrones de las linternas celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331132,
					"content": "¿Qué tal si uno de nosotros hace un acertijo, y el otro pinta una linterna celeste? Los niños serán el jurado y decidirán cuál les gusta más. ¿Qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331133,
					"content": "¡De acuerdo! No hay problema. De hecho, va bien con el Rito de la Linterna. ¡No podría ser más adecuado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331134,
					"content": "Entonces, arreglado. Espera a que reúna mis utensilios de pintura, ¡y tendremos una revancha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331135,
					"content": "Qué entusiastas son...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "Vengan, niños. Vean los acertijos que escribió este poeta, ¡y yo pintaré unas hermosas linternas celestes para ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331138,
					"content": "Jeje, me temo que tu brocha no será tan rápida como mi pluma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chingzhou"
				},
				{
					"id": 710331136,
					"content": "¡Que gane el mejor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "Es la persona contra la que compite Chingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
		{
			"id": 7103312,
			"completionStepIds": [
				7103312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103312",
							"2"
						],
						"stepId": 7103312,
						"stateName": "QUEST_STATE_UNFINISHED"
