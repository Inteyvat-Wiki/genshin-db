				{
					"id": 741920401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920402,
					"content": "¿Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "¿Eh? Por fin, regresaste. *Solloza* Estaba tan preocupada de que no volvieras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920404,
					"content": "Después de entrar, te esperé afuera durante mucho tiempo. Fui a pedir ayuda de otras melusinas, pero ninguna sabía qué hacer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920405,
					"content": "(... Parece que estuve aquí durante mucho tiempo.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "Tengo que irme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#¿Eh? {NICKNAME}, ¿a dónde vas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920408,
					"content": "No te preocupes. Volveré cuando encuentre a Canotila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "Espérame un momento, ¿sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "Sé que no servirá de nada decirte esto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "Pero, confía en mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#¿{NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920412,
					"content": "No te preocupes.",
					"roleType": "TALK_ROLE_PLAYER",
