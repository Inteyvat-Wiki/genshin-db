				"points": []
			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "Veo que las llamas en el trono se extinguieron y de las cenizas crecieron árboles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Las flores son capaces de brotar con cada paso que das, y serás quien pueda cambiar este decadente futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "¿Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#¡{NICKNAME}! ¿Qué estás haciendo aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "¡Ah, cierto! La mariposa dorada volvió, ¡ahora mismo voy a verla! ¡Adiós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7419202,
