			"dialogs": [
				{
					"id": 741920301,
					"content": "Si es posible plasmar las memorias en un libro, entonces es igualmente posible introducir directamente el contenido del libro en la memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "¿Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Oh, ¡eres tú!, viajer{F#a}{M#o} extrañ{F#a}{M#o}. ¿Qué pasa? ¿Me estás buscando para algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "¿De qué estás hablando...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Bueno, de todas maneras, plasmar “las memorias” en un libro es algo bastante inconcebible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "Para poder hacer un libro así, el creador debe haber considerado las emociones en las memorias {RUBY#[D]ilusiones} como lo más precioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Pero un libro como este es muy difícil de entender...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "... Y no es posible determinar qué impacto tendrá en el lector. Es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
