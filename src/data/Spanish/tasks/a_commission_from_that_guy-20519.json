			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "#¿Aún estás preparándote? Sal cuando estés list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190402,
					"content": "¿Quién es ese señor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "Por mucho que me preguntes, no te lo diré. Es uno de los requisitos más importantes para los que nos dedicamos a esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190404,
					"content": "Y, aunque te contara algo de información, lo haría porque debe ser revelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190405,
					"content": "De todo lo que te conté, ¿qué información crees que cae en la categoría de “cosas que deben ser reveladas”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190406,
					"content": "¿Cuál es su objetivo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "¿Nuestro objetivo? Yo no tengo ni idea del objetivo de ese señor, pero imagino que será proteger Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190408,
					"content": "Humm... No creo que esté actuando por intereses personales en cuanto a algo tan importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190409,
					"content": "Ay, no, no, no. No debería especular con estas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
