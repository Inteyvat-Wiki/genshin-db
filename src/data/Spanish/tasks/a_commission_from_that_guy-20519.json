			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "¡Regresaste! ¡Que eficiente! Ahora entiendo por qué le caes tan bien a ese señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190202,
					"content": "Sí, sí. Vamos, dame el dinero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "#Oh, qué direct{F#a}{M#o} eres. Toma el dinero. No gano mucho en mi trabajo, así que espero que sea suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190204,
					"content": "Gracias por tu amabilidad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "De nada. Guárdalo bien, y espero colaborar más contigo en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
