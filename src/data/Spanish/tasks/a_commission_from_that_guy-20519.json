			"dialogs": [
				{
					"id": 205190501,
					"content": "¿T-te ocurre algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190502,
					"content": "Estoy esperando a que la hermana Victoria me responda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190503
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190503,
					"content": "Sea cual sea su respuesta, yo ya me preparé mentalmente para lo que sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
