				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "Ladrones de Tesoros... ¡Oh! Disculpa, ¿necesitas algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "Los Ladrones de Tesoros están moviéndose alrededor de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "¿Ladrones de Tesoros? Justo estamos preparándonos para ir por un grupo de ellos. Esos bandidos se están acercando demasiado a Mondstadt. No sé qué estarán tramando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "Aunque, sean cuales sean sus motivos, seguro que no tienen buenas intenciones. Invertimos muchos recursos para hacerles frente... Me temo que ahora mismo no podemos atenderte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "Pero ya tomé nota de lo que me contaste. Cuando hayamos terminado con los Ladrones de Tesoros, informaré a mis superiores de ello. ¡Gracias por tu información!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
