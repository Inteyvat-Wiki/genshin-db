	"talks": [
		{
			"id": 4142201,
			"completionStepIds": [
				4142201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142201",
							"2"
						],
						"stepId": 4142201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "Ya aclaré las cosas con Rhodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220102,
					"content": "Ella es la ondina espía más famosa y poderosa de todas. Sin embargo, desertó de Fontaine porque anhelaba demasiado a la antigua Arconte Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220103,
					"content": "Yo tampoco puedo volver a Fontaine, así que te lo contaré todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220104,
					"content": "Nosotras, las ondinas, en el pasado estábamos dispersas entre los ríos y estanques de todo el continente. La mayoría éramos informantes de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220105,
					"content": "¡Guau! ¿Qué era lo que planeaba la Arconte Hydro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220106,
					"content": "La Arconte Hydro de ese entonces no tenía ningún plan. Solo lo hacía para extender su red a lo largo de los ríos y los cauces, y así abarcar todo el continente. Pero cuando falleció, la mayoría de las ondinas rompió su vínculo con Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220107,
					"content": "Igual que la gran Rhodeia, no reconocieron a la nueva Arconte Hydro y se aferraron a mantener vivos sus antiguos sueños. Rhodeia solo busca un pequeño refugio de aguas tranquilas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220108,
					"content": "Pero ella sintió mi presencia y pensó que era una asesina de Fontaine, así que volvió amarga el agua del río para eliminarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220109,
					"content": "Pero cuando te conocimos eras muy pequeña y frágil. ¿Por qué se tomó tantas molestias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220110,
					"content": "La mente dominante de una ondina puede destruirse fácilmente si entra en contacto con otra mente pequeña, pero malvada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220111,
					"content": "Yo admiraba mucho a Rhodeia, así que me subí a un Slime Hydro, dejé Fontaine y fui viajando por el agua hasta que llegué aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220112,
					"content": "Dudo mucho que otra ondina hubiera tenido la misma determinación que yo, a menos que tuviera la misión de asesinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220113,
					"content": "Dicho así, hace que parezcas increíble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220114,
					"content": "#Pero no es nada comparado con Paimon, que viaja a cuestas de {NICKNAME} en su viaje por las Siete Naciones, ¡y que hasta ahora le ha ido muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220115,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "Ahora que aclaré las cosas con ella, la amargura del agua no debería tardar en disiparse. Hasta me preguntó si me gustaría fusionarme con las aguas de la Aldea Chingtsé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220117,
					"content": "Entonces, ¿viniste a despedirte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220118,
					"content": "Todavía tengo un mensaje por entregar. ¿Pueden acompañarme a Aguaclara una vez más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Endora"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
							"2"
						],
						"stepId": 4142202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viejo Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "¡Finch, Finch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220202,
					"content": "¡Ah, me diste un susto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414220203,
					"content": "Endora aprende a la velocidad del rayo. Es normal que te haya sorprendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220204,
					"content": "No es eso. Es solo que... cuando dijiste mi nombre, me recordaste a ella. Son como dos gotas de agua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414220205,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220206,
					"content": "“Cada día, un niño avanza dando tumbos, descubriendo poco a poco el mundo. Todo lo que ha visto forma parte de sí mismo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220207,
					"content": "“Y el niño, que vacilante iba, siguió así toda una vida”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414220208,
					"content": "Conozco ese poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414220209,
					"content": "Nuestras vidas y las suyas son muy distintas. Quizás por eso nunca podamos entendernos mutuamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220210,
					"content": "Pero también tenemos similitudes. Todos fluimos hacia el océano mientras experimentamos nuevas cosas y encontramos nuevas oportunidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220211,
					"content": "Por eso, ella dice: “Cuando las estrellas del cielo se extingan, todos los cauces y todos los sueños desembocarán en el mismo océano. En ese momento, nos volveremos a ver”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220212,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414220213,
					"content": "Los cauces de la vida siguen avanzando. Así que, por favor, avanza y no te detengas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220214,
					"content": "Jajaja, como era de esperarse de ella. Todavía me habla como si fuera un niño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414220215,
					"content": "Bueno, me gustaría tener un momento a solas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "Viejo Finch"
				},
				{
					"id": 414220216,
					"content": "#De acuerdo. {NICKNAME}, deberíamos ir a hablar con Connor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142203",
							"2"
						],
						"stepId": 4142203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "Oh, regresaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220302,
					"content": "Tratándose de ustedes, seguro que todo está resuelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220303,
					"content": "¡Por supuesto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "El sabor amargo del agua debería desaparecer en unos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220306,
					"content": "Ah, entiendo, entiendo. Ya que eliminaron la fuente del problema, solo hay que darle algo de tiempo al agua para que se purifique sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220307,
					"content": "Entonces, notificaré al Gremio de Aventureros para que cierren el caso. Se lo agradezco mucho, de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220304,
					"content": "Aunque fue un poco complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "La forma en que mi especie muestra afecto es fusionándose con el agua. Así, nuestras mentes pueden comprenderse sin interferencias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220402,
					"content": "Pero entender a otros organismos del mundo no es tan fácil. Por eso observamos, estudiamos y adoptamos formas de animales. Se podría decir que sus aspectos se han vuelto parte de nosotras mismas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220403,
					"content": "Al ver fluir el río, Endora empezó a reflexionar sobre temas muy profundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220404,
					"content": "Yo nunca había reflexionado sobre mi futuro, solo pensaba en fusionarme con Rhodeia y nada más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220405,
					"content": "Pero Rhodeia no parecía nada feliz. Ella misma sabe que solo está esperando a que el agua se contamine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220406,
					"content": "Entonces, ¿qué vas a hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "Ni Rhodeia ni la ondina de la Aldea Aguaclara parecían estar de acuerdo con que yo siguiera su camino. Aunque seguramente odien aún más la vida que tenían en Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220409,
					"content": "La vida de las ondinas es muy extraña, así que Paimon no puede pensar en ningún consejo útil que darles. ¡Pero para Paimon no hay nada mejor que vivir una vida feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220410,
					"content": "He decidido tomar un camino nuevo, uno que nadie ha recorrido. Viajando con ustedes me sentí muy feliz. Quiero sentir esa felicidad todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220411,
					"content": "Me gustaría viajar con ustedes. Observar cómo las flores crecen en las orillas de los ríos y contemplar el crepúsculo en el horizonte antes de ver los cauces de la vida desembocar en el mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220412,
						414220413
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220412,
					"content": "Eres más que bienvenida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220415
					]
				},
				{
					"id": 414220415,
					"content": "¡Oh, no! ¡El papel de Paimon como tu compañera de viaje transcontinental está en peligro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220413,
					"content": "Podrías reemplazar a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220414
					]
				},
				{
					"id": 414220414,
					"content": "¡Oye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220407,
					"content": "¿Por eso la rechazaste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				}
