					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150702
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150702,
					"content": "¿Por qué iría Chang el Noveno a la Colina Wuwang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150703
					]
				},
				{
					"id": 221150703,
					"content": "Dijo algo sobre recabar materiales para su novela, estar a solas y tener inspiración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150704
					],
