			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "Así que solo andaba perdido... Bueno, será mejor que regresemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150302,
					"content": "¿Eh? Hay algo en el suelo. Esto... ¿no es de Chang el Noveno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150303,
					"content": "Vamos a ver qué es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211507",
							"2"
						],
						"stepId": 2211507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "*Suspira*, lo único que quería era escribir mi novela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150502,
					"content": "¿Esto es tuyo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "¿Eh? Sí, es mío. Son unos bocetos. Se cayeron al río y se arruinaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150504,
					"content": "Vaya, así que fueron a recogerlos... Es una pena que ahora no se entienda nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150505,
					"content": "¿Qué tenían escrito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "Eran unos cuentos para una amiga de la infancia... todos estos capítulos no son más que bocetos. ¿Sabes? Cuando éramos pequeños, esa niña solía molestarme todos los días pidiéndome que le contara historias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150507,
					"content": "Por desgracia, en aquel entonces apenas tenía tiempo para escribir, así que solo escribí el inicio de la historia para ella pensando que le escribiría el resto cuando tuviera tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150508,
					"content": "Pero un día, esa niña desapareció. No estaba por ningún lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150509,
					"content": "¡Hum! Seguro que es porque no le agrado a su familia, así que no le dejaban juntarse conmigo. Entonces, aprovecharon una oportunidad y, sin dejar rastro, dejaron la Aldea Chingtsé y se la llevaron con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150510,
					"content": "¡Pero ya verán! ¡Se darán cuenta de quién soy cuando recupere mi fortuna! Y entonces, ¡el libro que escribí para ella se venderá en todo el mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150511,
					"content": "Así que vayan adonde vayan, ¡verán a mi nuevo yo! ¡Verán que no soy el mismo Chang el Noveno que antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150512,
					"content": "Y entonces, podré volver a verla, pero... antes de eso, tengo que terminar este libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150513,
					"content": "Lo siento, comencé a hablar y me dejé llevar. *Suspira*, todavía tengo que pensar en cómo escribir mi libro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
		{
			"id": 2211506,
