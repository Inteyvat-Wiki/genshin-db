			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang el Noveno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "¡Bah! Qué monstruos tan molestos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150202,
					"content": "Vine aquí a buscar algo de información para mi novela, pero no he podido encontrar nada y, en cambio, me topé con ese grupo de monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150203,
					"content": "Gracias. De no ser por ti, no sé cómo habría podido huir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150204,
					"content": "La Abuela Ruoxin está preocupada por ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "¿Preocupada? ¿Por mí? No tiene de qué preocuparse. Ya soy mayor, sé cómo cuidarme. ¡Hum! Puedo hacerme cargo de un imprevisto como este, solo que es un poco molesto para mí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 221150206,
					"content": "En fin, les estoy agradecido... Es mejor que regrese o Ruoxin no dejará de sermonearme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
