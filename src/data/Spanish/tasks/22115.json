			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abuela Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "*Suspira*, ¿dónde estará el pequeño Chang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150102,
					"content": "¿“Pequeño Chang”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Oh, creo que ustedes lo conocen como “Chang el Noveno”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150104,
					"content": "Ya me acostumbré a llamarlo así. No puedo evitarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150105,
					"content": "Ayer por la noche dijo que iría a recabar información para su novela. No le presté mucha atención, solo le dije que no se quedara afuera hasta tan tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150106,
					"content": "Pero aún no ha regresado y me preocupa que le haya pasado algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150107,
					"content": "Yo solo soy una pobre anciana, no puedo ir a buscarlo sola. ¿Podrías ayudarme a buscar al pequeño Chang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150108,
					"content": "Déjamelo a mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "¡Bien! Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150110,
					"content": "¿Sabes a dónde puede haber ido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "*Suspira*, solo hay un lugar al que pudo haber ido: la Colina Wuwang, al norte de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150112,
					"content": "Por favor, ayúdame a buscarlo. Ha pasado mucho tiempo, quizás le ocurrió algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
