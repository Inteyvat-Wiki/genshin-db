			"trigger": {
				"objectNames": [
					"Abuela Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150601,
					"content": "*Suspira*, mi pequeño Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150602,
					"content": "¡Chang el Noveno ha vuelto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Sí, ya lo vi. Se lo agradezco mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150604,
					"content": "Es igual que cuando era pequeño. En ese entonces, le encantaba meterse en problemas. Decía que ya era grande... Yo creo que no ha crecido aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150605,
					"content": "Bueno, no se preocupen. Son sus propios asuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150606,
					"content": "Gracias por ayudarme. Esto es para ustedes, tómenlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150607,
					"content": "Seguramente tienen otros asuntos de los cuales ocuparse. No sean como Chang, que por querer “destacar” y “enseñarle al resto del mundo”, dejó pasar varias oportunidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "Abuela Ruoxin"
				},
				{
					"id": 221150608,
					"content": "*Suspira*, los mortales no somos Adeptus... ¿Y qué es la vida mortal sino un breve sufrimiento antes de la muerte? Pobre, pobre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abuela Ruoxin"
				}
			]
		},
