						201031103
					]
				},
				{
					"id": 201031103,
					"content": "¿Y qué tal? A juzgar por tu expresión, no fue tan mal, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "¡Fue muy bien!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Entonces no estaba tan equivocada con esas palabras. ¡Qué bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Después de esto, he dado un gran paso en mi investigación del hilichurlio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "Llegará un día en el que podré comunicarme con los Hilichurls. Entonces, ellos mismos me ayudarán a desentrañar todos sus misterios. Cuando llegue ese momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "Podré decir que no manché el apellido Musk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "¡Casi lo olvido! Toma, como forma de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
