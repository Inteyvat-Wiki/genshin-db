					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031501,
					"content": "Espero que a los Hilichurls les guste mi poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "¿Por qué escribes poesía en hilichurlio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "Humm... Para ser franca, todavía no domino el hilichurlio. No sé cómo unir gramática, sintaxis y vocabulario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "Me esforcé mucho en escribir estos versos, pero tal vez no suenen muy naturales para los Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "Además, si una sola palabra cambia, el sentido de la oración es totalmente distinto. Esas sutilezas del idioma solo pueden aprenderse mediante la práctica con los Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "Es solo que nadie se atreve a estudiar hilichurlio con Hilichurls de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Pero yo estoy dispuesta a hacerlo... O mejor dicho, es mi deber hacerlo si quiero dominar el hilichurlio y comprender a los Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "Por otro lado, creo que la mejor forma de comunicarse con los de por aquí es a través de la poesía, como acostumbra a hacer la gente de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "Sobre estas anotaciones...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "¿Te refieres a las que están al final? Verás, todas estas palabras las encontré en libros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "Intenté entender los matices de las palabras mientras escribía los versos, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "Aprender un idioma es muy complicado. Una misma palabra puede significar algo distinto en otro contexto. Incluso puede cambiar totalmente el sentido de una oración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Estoy bastante segura del significado de los versos que he escrito,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "pero aún hay versos que no sé cómo traducir... Esos no hace falta que los leas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Parece que ya tienes una idea más clara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Es solo una idea general. De verdad, quiero ser amiga de los Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "Pero si algo sale mal, no seré capaz de explicarme. Si se vuelvan agresivos, no nos quedará de otra más que retirarnos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "Así que lo dejo en tus manos. Jeje, no pasa nada, si sigues mis anotaciones al pie de la letra, no tendrás ningún problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "O eso espero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
