			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "#¡Nos vemos de nuevo! ¿Te acuerdas de mí? La última vez nos hicimos amig{F#as}{M#os} de unos Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Oh, no me mires así. La lingüística es una disciplina que requiere constante práctica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "No te preocupes, tus esfuerzos no serán en vano. Mi hilichurlio oral ha mejorado considerablemente desde la última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Pero no puedo dejar que mi hilichurlio escrito se quede atrás, así que tras mucho estudio... escribí unos cuantos poemas en hilichurlio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "Solo que en los poemas hay algunas palabras cuyo significado me gustaría comprobar. ¿Podrías ayudarme a confirmar si están bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "¿A qué te refieres con “confirmar”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "¡Pues a que vamos a recitar poesía ante los Hilichurls y ver cómo reaccionan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "¡No te preocupes! <color=#00E1FFFF>Anoté</color> los versos con los que tengo dudas, aunque no creo que estén muy lejos del significado real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "Ya seleccioné un objetivo, esos Hilichurls de allá parecen estar de buen humor. ¡Ve a recitarles esos versos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "¡Por favor! Después de recitar mi poema, ven y dime si notaste algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "¿Quieres... que vaya de nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "#¡Por supuesto! Creo que ya estás familiarizad{F#a}{M#o} con ellos. No te preocupes, <color=#00E1FFFF>puse una anotación</color> en los versos con los que tengo dudas, aunque no creo que estén muy lejos del significado real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "Ya seleccioné un objetivo, esos Hilichurls de allá parecen estar de buen humor. ¡Ve a recitarles esos versos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "¡Por favor! Después de recitar mi poema, ven y dime si notaste algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "Si algo inesperado llegara a ocurrir, estoy segura que sabrás solucionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
