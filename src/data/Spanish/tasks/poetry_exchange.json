			},
			"dialogs": [
				{
					"id": 201031201,
					"content": "¿Y bien? ¿Pudiste recitar esos poemas a los Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031202,
					"content": "Sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "¿Y qué tal? Oh, a juzgar por tu expresión, fue un desastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031204,
					"content": "Hubo un pequeño problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "¿Viste mis anotaciones? O tal vez es que están mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031206,
					"content": "Lo siento, creo que todavía me falta mucho para dominar el idioma, tengo que seguir estudiando. Gracias por tu ayuda, toma esto como forma de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031207,
					"content": "Tengo que mejorar, no puedo manchar el apellido Musk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
