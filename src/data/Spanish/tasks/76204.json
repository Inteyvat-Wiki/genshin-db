				]
			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "¡Felicidades! Dejen que vea... ¡Así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Este es el altar donde me quedaba cuando aún era un ángel, nada que ver con el Jardín de la Bruja actual. Este fue mi hogar durante mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "¡Cuántos ángeles! ¡Parece que eras muy popular, Nicole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "No es por presumir, pero a todas les encantaba oír mis historias. Especialmente aquellas que trataban sobre vivir junto a los humanos, dejarles presagios y guiarlos en la construcción de grandes civilizaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Cada vez que llegaba a un momento clave, los demás ángeles contenían la respiración, prestando atención a cada una de mis palabras. Ni siquiera se oían las cuerdas de un harpa ni los pinceles al acariciar un lienzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Después, los colores y tonos entrelazados empezaban a florecer. Al ritmo de la música, la luz lo iluminaba todo bajo un fulgor dorado... Un verdadero espectáculo de júbilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "¡Suena increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Oh, lo era, Paimon... Lo era.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Puede que aquellos días tan maravillosos hayan quedado en el pasado, pero la vida sigue estando repleta de buenas sorpresas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Un momento... ¿Alguien ha tenido la osadía de intentar robar mis esculturas mientras leía el periódico? Oh, ¡estás acabado! ¡Voy a guiarte de la mano hasta el mismísimo Fuerte Merópide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Un momento... ¿Alguien ha tenido la osadía de intentar robar mis esculturas mientras leía el periódico?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Oh, ¡estás acabado!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "¡Voy a guiarte de la mano hasta el mismísimo Fuerte Merópide!",
					"roleType": "TALK_ROLE_NONE",
