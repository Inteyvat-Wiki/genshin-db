			},
			"dialogs": [
				{
					"id": 762040201,
					"content": "¿Nicole? Qué raro, aquí tampoco hay nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "¿Ya han llegado a mi estudio? ¿Han visto mi colección de flores? He estado cultivando ejemplares de todo el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "*Suspira*, qué mal que no pueda presentarme allí ahora mismo. He abierto un puesto en Fontaine para vender esculturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "Eh... ¿Necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "No hace falta. Esta es la única oportunidad que tengo de escribir algo, aunque sean solo números...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Sé que no suelen venir de visita, así que siéntanse libres de empezar sin mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "Recuerdo que dejé un pergamino en el ala oeste, al lado de la estatua del pinzón. ¿Lo han visto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "¡Sí, lo vimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "#Entonces, ¡que mi silenciosa guía l{F#a}{M#o}s ayude por el camino! ¡Ánimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
