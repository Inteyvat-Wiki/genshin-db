			},
			"dialogs": [
				{
					"id": 730210301,
					"content": "Sopa de Arapas... *Solloza*... ¿Cómo pudo pasar esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210302
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210302,
					"content": "(Alejarse en silencio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7302104,
			"completionStepIds": [
				7302103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302103",
							"2"
						],
						"stepId": 7302103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapas",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "Humm, sí, es agua de manantial vital. Fría y cristalina como luz de luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210402,
					"content": "Si Arachatora, Arasaka y Arafala hubieran crecido bebiendo esta agua, no serían tontos como ahora. Solo Arapacati, hermanita de Arapas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210403,
					"content": "*Ejem*, y ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210404,
					"content": "Sí, ahora tienen que preparar a Arapas sopa en compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210405,
					"content": "Con la ayuda de Arapas, añades frutas y verduras al agua.\\nUn olor muy agradable sale de la olla.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "Prueban la sopa.\\nTal y como esperaban, aunque tiene un aroma delicioso, carece de sabor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "Jeje, ¡así debería oler manjar supremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210408,
					"content": "#Humm... ¿Tú que piensas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210409,
					"content": "Bueno, tiene la consistencia de una sopa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "Paimon cree que tendría mejor sabor con un poco de sal y pimienta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210412,
					"content": "Todo sabe mejor con sal y pimienta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "¡Por Aramuhukunda! ¿Añadir sal? ¡Sal es cosa horrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210414,
					"content": "Allá donde tierra es salada, no hay vida y aranara quedan reducidos a semillas. ¡¿Y aun así quieren poner sal?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210415,
					"content": "¡Todos saben que sopas no deben tener sabor! Nara no entienden nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210416,
					"content": "#Arapas recuerda historia que {F#aquel}{M#aquella} nara contó tras beber buen tazón de sopa:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210417,
					"content": "“Cuando nara pequeños vuelven a casa, aroma de sopa inunda ambiente. Por eso, sopa solo necesita tener buen aroma”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210418,
					"content": "#Después, {F#él}{M#ella} felicitó a Arapas porque sopa estaba muy rica y tenía olor muy agradable. Arapas nunca olvidará eso, ¡así que no cree a ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210419,
					"content": "Pero el aroma no lo es todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210421,
					"content": "¡Hum! Bueno, como son nara de este Festival Utsava, Arapas sabe que cuentan con aprobación de Araja y Arapacati. Arapas no tiene más remedio que preparar sopa con sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210422,
					"content": "Próxima vez, buscaré agua aún mejor para sopa. ¡Seguro que sabrá mucho mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210423
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210423,
					"content": "No creo que tenga que ver con el agua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210424
					]
				},
				{
					"id": 730210424,
					"content": "¿E-en serio? Pero Arapas ya ha terminado de practicar cocina. Bueno, ¡ya veremos en Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210425
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210425,
					"content": "#Aquí dejo a ustedes receta de sopa. Es sopa aprobada por {F#aquel}{M#aquella} gran nara, así que deberían dar otra oportunidad. Y recuerden: ¡hay que usar agua de calidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210426
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210426,
					"content": "#({NICKNAME}, cuando la hagas, condiméntala un poco. Eso mejorará el sabor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210410,
					"content": "Es demasiado saludable para mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				}
			]
		},
