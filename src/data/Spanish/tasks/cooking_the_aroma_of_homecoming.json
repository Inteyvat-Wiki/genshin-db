			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "Guau, ¿qué están cocinando aquí? A Paimon se le hace agua la boca con solo olerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210102,
					"content": "Parece que es una sopa. Humm... Paimon no distingue qué ingredientes usaron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210103,
					"content": "#Ay, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210104,
					"content": "¿Qué ocurre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "Quienquiera que cocinara esto no está por aquí. La sopa huele superbién, ¿qué te parece si probamos un sorbito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210106,
					"content": "Bien, hagámoslo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210112,
					"content": "La olla era más pequeña de lo que parecía.\\nYa no queda ni una gota.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "Puaj... ¿Eh? Esta sopa huele bien, pero ¿por qué no sabe a nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210114,
					"content": "¡Por gran Aramuhukunda! ¿Qué hacen aquí nara como ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210115,
					"content": "¡U-un aranara! ¿De dónde salió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210116,
					"content": "¡De tierra! Aunque eso no importa. ¿Por qué bebieron sopa? ¡Arapas se esforzó mucho en preparar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210117,
					"content": "Lo siento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "Paimon lo siente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210119,
					"content": "¡Hum! Se han acabado sopa de Arapas, ¡pedir perdón no es suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210123,
					"content": "¿Saben lo difícil que es hacer sopa aquí? Un minuto llueve y siguiente está soleado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210124,
					"content": "A Arapas costó mucho esfuerzo preparar esa sopa. Después fue por frutos harra frescos y, cuando vuelve, ustedes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210125,
					"content": "Solo nos la tomamos porque olía muy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210126,
					"content": "Y si es tan difícil, ¿por qué preparas la sopa aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210127,
					"content": "¡Hum! Clave de buena receta es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210128,
					"content": "¿Tener habilidades para la cocina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "¡Agua! ¡Es agua! Agua es muy importante para conseguir mejor aroma posible. Por eso hay que hacer sopa con agua de mejor calidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210131,
					"content": "Arapas recolectó agua de diferentes lugares de Floresta Apam y recogió muchas, muchas muestras de agua, tantas como hojas hay en árboles. Así fue como Arapas encontró agua de manantial vital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210132,
					"content": "#¡Solo así Arapas podrá crear manjar supremo digno de Festival Utsava! Arapas duda mucho que ustedes puedan comprender... No se parecen en nada a {F#aquel}{M#aquella} nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210133,
					"content": "Hablando de eso, nos envía Arapacati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210134,
					"content": "Le cuentan a Arapas lo ocurrido.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "#Ah, así que son {F#amigas}{M#amigos} de hermanita de Arapas. ¡Y Festival Utsava está cerca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210136,
					"content": "Bueno, no importa. Arapas ya ha encontrado agua de manantial vital y ha terminado de preparar manjar supremo. Está justo en esta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210138,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "Oye, no te pongas triste. La sopa olía muy bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210140,
					"content": "¡Ah! ¡Fuente de agua de manantial vital está donde viven apshvaana! Arapas tuvo que esperar a que fueran para recoger agua y solo tuvo tiempo de llenar una olla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210141,
					"content": "¡No es justo! ¡Tendrán que conseguir otra olla de agua de manantial vital para compensar a Arapas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210142,
					"content": "¿Qué son los apshvaana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210143,
					"content": "¡Hum! Nara no saben nada sobre bosque. Son seres que viven en agua, tienen cuatro patas, cola y muerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210144,
					"content": "¿Perros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210145,
					"content": "Los perros no viven en el agua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "Puede ser. Entonces, ¿qué son los apshvaana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210148,
					"content": "¡Olvídense de apshvaana! ¡Arapas quiere agua! ¡Agua de manantial vital!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210149,
					"content": "#Está bien, está bien... {NICKNAME}, no nos queda otra opción, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210150,
					"content": "Bueno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "Solo puede ser agua de manantial vital. ¡Otra agua no sirve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210151,
					"content": "En marcha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "¿Perros acuáticos? ¿Perros hidromiméticos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "¿No olvidar nunca tus sueños?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "F-fue Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#¡Oye! ¡¿{NICKNAME}, cómo puedes traicionar así a Paimon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210122,
					"content": "A Arapas no importa quién tomó sopa, ¡ahora ya no hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210108,
					"content": "Eso no está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "Paimon tiene mucha curiosidad. Humm, Paimon solo tomará un sorbo, ¡un sorbito pequeñito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210110,
					"content": "¿Y si luego te duele el estómago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "¡Hum! ¡No subestimes a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
