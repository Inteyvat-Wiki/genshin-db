			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "Las <color=#00E1FFFF>insignias Anemo</color> aparecen en toda Mondstadt. Si no tienes suficientes, sigue explorando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040302,
					"content": "¿De verdad las usas como decoración?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "¡Claro! ¿Qué podría ser más hermoso que un regalo del Arconte Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040304,
					"content": "Jaja, está bien, me descubrieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "En realidad, es más complicado, pero es más fácil que la gente lo entienda si solo digo que es para decoración.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Obviamente, la razón por la que necesito <color=#00E1FFFF>insignias Anemo</color> es porque tienen propiedades que otros materiales no pueden proporcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040307,
					"content": "Déjame verlo cuando esté terminado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "¡Jaja, por supuesto! Te garantizo que te sorprenderás con el resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "¡Vuelve pronto, y tráeme montones de <color=#00E1FFFF>insignias Anemo</color> a la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "¡Visítame también si te encuentras con algún tesoro extraño y maravilloso en tus aventuras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040309,
					"content": "Creo que suena más misterioso de lo que realmente es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "Pero funciona... ¡Ahora tengo mucha curiosidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040311,
					"content": "¡Jaja! Bueno, no sería una gran sorpresa si te lo revelara, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				}
			]
		}
	]
}