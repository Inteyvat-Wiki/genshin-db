	"talks": [
		{
			"id": 7166201,
			"completionStepIds": [
				7166201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166201",
							"2"
						],
						"stepId": 7166201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620101,
					"content": "#¡Viajer{F#a}{M#o}! No podrías haber llegado en un mejor momento. Tengo un encargo que creo que es perfecto para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620102,
						716620103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620102,
					"content": "¿Es un encargo peligroso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				},
				{
					"id": 716620104,
					"content": "Es un encargo sobre un dominio desconocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620105,
					"content": "Aunque el Gremio lleva tiempo investigándolo, no hemos conseguido información de gran valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620106,
					"content": "Honglang, la persona a cargo de la investigación, dijo que necesitaba la ayuda de un aventurero capaz de adaptarse a las circunstancias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620107,
					"content": "Así que la primera persona en la que pensé fuiste tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620108,
					"content": "¿Qué clase de dominio es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620109
					]
				},
				{
					"id": 716620109,
					"content": "#Honglang se encuentra en la entrada al dominio. Si estás dispuest{F#a}{M#o} a echarnos una mano, puedes ir a preguntarle en persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620110,
					"content": "#Contamos contigo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620103,
					"content": "¿Es un encargo complicado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				}
			]
		},
		{
			"id": 7166202,
			"completionStepIds": [
				7166202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166202",
							"2"
						],
						"stepId": 7166202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620201,
					"content": "¿Qué pasa con este dominio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620202
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620202,
					"content": "Hola, vine por el encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620203
					]
				},
				{
					"id": 716620203,
					"content": "#¿Eh? Tú... Ya veo, debes de ser {F#la aventurera}{M#el aventurero} de quien me habló Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620204
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620204,
					"content": "He oído hablar de tu adaptabilidad, tus conocimientos de aventura y tus excepcionales habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620205,
						716620206
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620205,
					"content": "Eso es lo que dicen de mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				},
				{
					"id": 716620207,
					"content": "¡Estupendo! Me siento más tranquilo al escucharte decir eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620208
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620208,
					"content": "Entonces, ¿qué ocurre con este dominio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620209
					]
				},
				{
					"id": 716620209,
					"content": "Oh, cierto, lo siento. Deja que te ponga al día...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620210
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620210,
					"content": "Esto fue lo que pasó: hace tiempo, un equipo de aventureros descubrió en el campo un portal muy grande... Que es el que tenemos frente a nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620211
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620211,
					"content": "Al atravesarlo, el equipo de aventureros entró a un dominio desconocido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620212
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620212,
					"content": "De acuerdo a la primera expedición de aventureros, solo se trataba de una sala vacía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620213,
						716620214
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620213,
					"content": "¿Qué quieres decir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620215,
					"content": "Es solo una expresión. Para ser más exactos, “era un área de unos 52 pasos de largo por 52 de ancho, con una altura desconocida”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620216
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620216,
					"content": "En fin, esta área de 52 por 52 estaba cubierta por baldosas comunes y corrientes. Sin embargo, sus alrededores estaban rodeados por una densa niebla gris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620217
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620217,
					"content": "Además, si alguien intentaba ir más allá de esos 52 pasos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620218
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620218,
					"content": "Por alguna razón misteriosa, cambiaba de dirección y comenzaba a caminar en el sentido opuesto, o desaparecía y aparecía detrás de los demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620219
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620219,
					"content": "En fin, el caso es que era imposible salir de esa área de 52 pasos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620220
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620220,
					"content": "¿Intentaron utilizar otras herramientas para explorar el lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620221
					]
				},
				{
					"id": 716620221,
					"content": "Claro que lo intentaron, pero los objetos que arrojaban regresaban a su punto de origen. Ni siquiera la luz de las antorchas podía iluminar más allá de esos 52 pasos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620222
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620222,
					"content": "Así que quieres que exploremos el lugar, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620223,
					"content": "Así es. Sin embargo, no es una simple “exploración”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620224
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620224,
					"content": "No sé cómo explicarlo aquí... Entremos a ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620214,
					"content": "¿Una sala... vacía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620206,
					"content": "B-bueno, sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				}
			]
		},
		{
			"id": 7166203,
			"completionStepIds": [
				7166204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166204",
							"2"
						],
						"stepId": 7166204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620301,
					"content": "Este lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620302,
					"content": "¿Este es el mismo lugar que esa “sala vacía” de la que hablabas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620303,
						716620304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620303,
					"content": "Parece un dominio como cualquier otro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				},
				{
					"id": 716620305,
					"content": "¡Eso es! ¿No son unas ruinas comunes y corrientes como las que exploramos todo el tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620306,
					"content": "En realidad, este es el dominio que pensábamos explorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620307
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620307,
					"content": "En cuanto a por qué luce así, es porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620308
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620308,
					"content": "Este dominio se transformó hace poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620309
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620309,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620310,
					"content": "¿Se “transformó” en esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620311
					]
				},
				{
					"id": 716620311,
					"content": "Así es. Este dominio se transforma de acuerdo a los deseos de la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620312
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620312,
					"content": "Según el líder de ese equipo de aventureros, comenzaron a perder la paciencia tras explorarlo por mucho tiempo sin ningún progreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620313
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620313,
					"content": "Entonces, uno de los miembros comenzó a murmurar entre dientes:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620314
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620314,
					"content": "“Si fuera un dominio común y corriente, hace tiempo que habríamos terminado de explorarlo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620315
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620315,
					"content": "Hambrientos y cansados, uno a uno los demás miembros expresaron su acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620316
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620316,
					"content": "Cuantas más personas expresaban su conformidad, de un momento a otro se encontraron en un “dominio común y corriente”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620317
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620317,
					"content": "Mecanismos, rutas, tesoros... Este “dominio común y corriente” tenía de todo, incluso antorchas encendidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620318
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620318,
					"content": "Sin embargo, los aventureros no supieron cómo proceder, así que decidieron regresar de inmediato a reportarlo al Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620319
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620319,
					"content": "Entonces enviamos una expedición de inmediato para llevar a cabo una investigación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620320
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620320,
					"content": "Es solo que, hasta ahora, lo único que sabemos es que este dominio puede transformarse según la voluntad de las personas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620321
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620321,
					"content": "Si varias personas entran a la vez, el dominio se transformará de acuerdo a aquella persona con los deseos más fuertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620322
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620322,
					"content": "¡Guau! ¿Eso quiere decir que podemos recrear toda una Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620323,
					"content": "Lo hemos intentado, pero no lo logramos. Me temo que nuestro deseo de reproducir Liyue no es tan fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620324
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620324,
					"content": "Como sea, de momento estamos reuniendo aventureros para que se introduzcan en el dominio con el fin de llevar a cabo todo tipo de transformaciones de acuerdo a su voluntad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620325
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620325,
					"content": "Con eso, esperamos poder encontrar los principios que conducen a estos cambios y obtener una respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620326,
						716620327
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620326,
					"content": "Entonces, ¿qué quieres que haga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620328,
					"content": "Pues, ¿ven ese mecanismo de allá? Es el activador que instalamos nosotros. De hecho, uno de nuestros aventureros lo creó con su imaginación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620329
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620329,
					"content": "En pocas palabras, su deseo era “cambiar este dominio solo al tocar este mecanismo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620330
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620330,
					"content": "Entonces, el dominio respondió a su deseo, pero para garantizar que el mecanismo permanezca aquí, tenemos que pedirle que vuelva de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620331
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620331,
					"content": "¿Así es como lo hacen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620332
					]
				},
				{
					"id": 716620332,
					"content": "De no ser por unas medidas preventivas como estas, el dominio estaría cambiando a cada instante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620333
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620333,
					"content": "Pero, desde otro punto de vista, este dominio es apropiado para entrenar aventureros. Después de todo, con solo pensarlo aparecerán toda clase de mecanismos y terrenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620334
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620334,
					"content": "Pero hablándolo no creo que lo entiendas, así que ¿por qué no lo pruebas personalmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620335
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620335,
					"content": "¿Ves esa Moneda de aventura dorada de allí? Es una cosita que creamos a partir de nuestra voluntad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620336
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620336,
					"content": "#Intenta agarrar esa Moneda de aventura, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620327,
					"content": "¿Existe algún método especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620304,
					"content": "Este lugar me parece familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				}
			]
		},
