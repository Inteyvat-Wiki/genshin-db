					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620402,
					"content": "En ese caso, cuento contigo. Usa toda tu imaginación para transformar este dominio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "Honglang"
				},
				{
