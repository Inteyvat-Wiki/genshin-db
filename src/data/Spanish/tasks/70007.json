			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Joven enamorado",
					"Joven enamorada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "Qué historia tan conmovedora, lástima que no tuviera un final feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Joven enamorado"
				},
				{
					"id": 700070202,
					"content": "Eso no va a pasar con nosotros, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Joven enamorada"
				},
				{
					"id": 700070203,
					"content": "Claro que no. Si alguna vez nos separamos, yo buscaré la forma de traerte de vuelta a mi lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Joven enamorado"
				},
				{
					"id": 700070204,
					"content": "Deben guardar silencio en la biblioteca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "¿Eh? Pero yo estaba manteniendo la voz baja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Joven enamorada"
				},
				{
					"id": 700070207,
					"content": "Oh, quizás esto es uno de esos obstáculos para nuestro amor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Joven enamorado"
				},
				{
					"id": 700070208,
					"content": "Los libros que leyeron también deben devolverlos a sus lugares correctos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "Si los dejan así de desordenados, va a ser muy problemático para la persona que se encarga de ponerlos en las estanterías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "Está bien, está bien. Por favor, no nos interrumpan, estamos en un momento muy importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Joven enamorado"
				},
				{
					"id": 700070211,
					"content": "¿Un momento importante?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "¿Nunca vas a cambiar, sin importar cuántos obstáculos se nos presenten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Joven enamorada"
				},
				{
					"id": 700070213,
					"content": "Sí, lo juro por mi vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Joven enamorado"
				},
				{
					"id": 700070214,
					"content": "Tampoco tienes que ser tan dramático... Si algo te pasara, se me rompería el corazón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Joven enamorada"
				},
				{
					"id": 700070215,
					"content": "Ah, tu ternura es embriagadora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Joven enamorado"
				},
				{
					"id": 700070216,
					"content": "Paimon cree que les entró por una oreja y les salió por la otra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070205,
					"content": "Alguien se quejó de que están haciendo mucho ruido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
		{
			"id": 7000703,
			"completionStepIds": [
				7000703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
