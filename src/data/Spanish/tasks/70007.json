			"dialogs": [
				{
					"id": 700071001,
					"content": "¿Qué? ¿Lisa ya está en camino de regreso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071002,
					"content": "Si se enterara de que han desordenado todos los libros y han dañado las páginas doblándolas, se pondría furiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071003,
					"content": "Cierto. ¿Qué hacemos? Es un desastre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "¿Qué podemos hacer? Si empezáramos a limpiar ahora, todavía habría oportunidad de remediar la situación, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071005,
					"content": "Nunca hubiera pensado que se les ocurriría una solución tan buena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071006
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071006,
					"content": "Todo fue idea de Wyratt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "Gracias a Lisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "Si la Srta. Lisa viera este espectáculo, se pondría furiosa. Esto es una biblioteca, un lugar para aprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071009,
					"content": "Por fin puedo hacer mi investigación en paz. Esta es su recompensa. Muchas gracias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
