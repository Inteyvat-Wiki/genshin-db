			},
			"dialogs": [
				{
					"id": 700070801,
					"content": "Hay mucho ruido en la biblioteca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "Ya veo. Entonces debo usar esa solución.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070803,
					"content": "Según la Srta. Lisa, si alguien viola las normas de la biblioteca, debe recibir un castigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070804,
					"content": "¿Podrías ir a la biblioteca y transmitir el mensaje de la Srta. Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070805,
					"content": "Doblar páginas, poner rosas en los libros, colocar libros en las estanterías al revés... Seguramente eso se considera violar las normas de la biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070806,
					"content": "Vamos a transmitir el mensaje de Lisa a todos esos que no vienen a la biblioteca a leer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
