			"dialogs": [
				{
					"id": 700070701,
					"content": "Oh, nadie hizo caso a nuestras recomendaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070702,
					"content": "No saben cómo comportarse en la biblioteca. Lo único que podemos hacer es buscar a Wyratt para contárselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
