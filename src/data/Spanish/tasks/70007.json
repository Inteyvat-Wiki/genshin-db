			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Prestidigitador",
					"Joven embelesada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "¿Eh? ¿En qué te puedo ayudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Joven embelesada"
				},
				{
					"id": 700070302,
					"content": "Deben guardar silencio en la biblioteca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "Lo siento, le prestaré más atención a eso. Es solo que a veces es inevitable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Joven embelesada"
				},
				{
					"id": 700070305,
					"content": "Por ejemplo, cuando no estabas prestando atención, saqué una rosa de detrás del libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Prestidigitador"
				},
				{
					"id": 700070306,
					"content": "Una rosa nacida de un libro. Justo como tú, llena de ternura y belleza intelectual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Prestidigitador"
				},
				{
					"id": 700070307,
					"content": "¡Guau! ¡Impresionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Joven embelesada"
				},
				{
					"id": 700070308,
					"content": "¡Bajen la voz! Además, no deben usar los libros para hacer trucos de magia, ¡podrían romperse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070309,
					"content": "Ahora tú también estás levantando la voz, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Oh, lo siento, fue un accidente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070311,
					"content": "¿Ahora nos entiendes? A veces es inevitable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Joven embelesada"
				},
				{
					"id": 700070312,
					"content": "Trataré de controlar el volumen de mi voz. De verdad, lo siento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "Joven embelesada"
				},
				{
					"id": 700070313,
					"content": "Parece que no entendieron lo que les dijimos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070303,
					"content": "Alguien se quejó de que están haciendo mucho ruido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
		{
			"id": 7000704,
			"completionStepIds": [
				7000704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000704",
							"2"
						],
						"stepId": 7000704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hombre aparentemente racional",
					"Mujer aparentemente racional"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "Tu afirmación de que “las fluctuaciones emocionales afectan a la precisión del análisis de la investigación” no tiene un argumento sólido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "Mujer aparentemente racional"
				},
				{
					"id": 700070402,
					"content": "Oh, entiendo, puede que esté atascado en un extraño cuello de botella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "Hombre aparentemente racional"
				},
				{
					"id": 700070403,
					"content": "Vinieron justo a tiempo. Tengo un problema y necesito el punto de vista de alguien ajeno al tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "Hombre aparentemente racional"
				},
				{
					"id": 700070404,
					"content": "Si quiero demostrar la validez de mi teoría, tengo que asegurar que no tengo fluctuaciones emocionales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "Hombre aparentemente racional"
				},
				{
					"id": 700070405,
					"content": "Pero no puedo hacerlo. Especialmente cuando estoy en una discusión con ella, nunca puedo calmarme y pensar adecuadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "Hombre aparentemente racional"
				},
				{
					"id": 700070406,
					"content": "A mí también me parece un poco extraño. ¿Será por falta de sueño o por el consumo excesivo de alcohol ayer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "Mujer aparentemente racional"
				},
				{
					"id": 700070407,
					"content": "De cualquier forma, no pueden hablar en voz alta en la biblioteca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "De cualquier forma, bajen la voz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Lo siento, pero no me conformaré hasta que no resuelva esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "Hombre aparentemente racional"
				},
				{
					"id": 700070410,
					"content": "No tienen intención de entender...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070411,
					"content": "*Suspira*, no pueden incomodar a otras personas. ¡Además, no deben colocar los libros al revés en el estante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070412,
					"content": "Bueno... no parece que nos estén prestando atención...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
