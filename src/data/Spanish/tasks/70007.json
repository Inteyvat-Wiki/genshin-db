			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070102,
					"content": "Parece que estás de mal humor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "Disculpa, es porque la biblioteca está muy bulliciosa últimamente y no puedo estudiar hilichurlio en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070105,
					"content": "En cuanto comienza el Festival de las Flores de Viento, muchas personas tienen citas aquí. Al principio leen en silencio, pero después empiezan a conversar cada vez más alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070106,
					"content": "Además... Además hacen todo tipo de cosas horribles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070107,
					"content": "Doblan las esquinas de las hojas, ponen todo tipo de cosas extrañas en los libros y, por si fuera poco, los colocan al revés en las estanterías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070108,
					"content": "Una biblioteca no debería ser un lugar para citas, ¡a menos que tengan la intención de molestar a gente que está estudiando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070109,
					"content": "Wyratt debería ser quien mantenga el orden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "¿Qué puede hacer? Sacar a la gente solo es una solución temporal, no resolverá el problema de raíz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070113,
					"content": "Por eso necesito pedirte ayuda. Por favor, diles que se controlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070114,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "Gracias. Las más ruidosas son las tres parejas de allá. Bastará con hacer que se den cuenta de cómo afectan a los demás para que yo pueda seguir investigando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070117,
					"content": "Pero ten cuidado, no es tan fácil tratar con ellos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070115,
					"content": "Lo intentaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "¿Y si llamas a Lisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "Escuché que estaba patrullando afuera con la Gran Maestra Intendente. Si estuviera aquí, esas parejitas seguramente se comportarían mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070103,
					"content": "Suenas más feroz que de costumbre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
			"id": 7000702,
			"completionStepIds": [
				7000702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
