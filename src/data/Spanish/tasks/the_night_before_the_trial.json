				]
			},
			"dialogs": [
				{
					"id": 150200801,
					"content": "#¿Hmm? Chasca, {NICKNAME} y Paimon... Ustedes también han venido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "La anciana Allpa... ¿Eh? ¿Dónde está el Qucusaurio del que hablaban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Se marchó antes de que llegáramos. Parece que intuyó que vendrían refuerzos y decidió darse a la retirada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "Entonces, el objetivo de este repentino ataque a humanos era... ¿la comida que transportaba la caravana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "No, lo que transporta esta caravana no es comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "¡Oh, gracias a todos los Arcontes! ¡Las alas de flogisto no han recibido daño alguno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Comerciante itinerante joven"
				},
				{
					"id": 150200807,
					"content": "... ¿Alas de flogisto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "¡Ay, muchas gracias! Este cargamento de alas de flogisto es nuestra mercancía más preciada. ¡No sé qué habríamos hecho si le hubiera ocurrido algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200809,
					"content": "¿Ustedes son los mercaderes que mencionó Warmi? ¿Los que querían hablar de una colaboración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Eh, sí, así es. Entonces... ¿usted es la anciana Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200811,
					"content": "Esa soy yo. Están fatigados tras una larga travesía y acaban de llevarse un buen susto... Vengan conmigo a la Tribu Plumaflora para descansar. Cualquier asunto que quieran tratar, podemos hacerlo después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Sra. Allpa, el ataque del Qucusaurio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Humm, veo que no hay ningún herido y que las mercancías se encuentran en buen estado... Puede que el Qucusaurio sufriera algún estímulo inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Con todos los Qucusaurios que hay en las inmediaciones, no es extraño que ocurra algún accidente, así que no se requiere una mayor investigación... Bueno, ¿cómo van los arreglos del terreno de la prueba de vuelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Ya casi está listo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "¿Oh? ¿Una prueba de vuelo? ¡Qué coincidencia! Sra. Allpa, ¡nuestras alas de flogisto le resultarán una grata sorpresa en una prueba así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200818,
					"content": "¿Es eso cierto? La verdad es que suena bastante interesante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Jeje, olvidemos el tema del Qucusaurio... ¡Vamos a la tribu para discutir sobre las alas de flogisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "Parece que no hay ningún problema. Todo va que ni pintado... Entonces, podemos marcharnos... ¿Eh? ¿Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "¿Qué estás mirando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "¿Una pluma... manchada de sangre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "La crisis queda olvidada sin resolución alguna, y la calma regresa una vez más a la Tribu Plumaflora.\\nLa tranquilidad de lo cotidiano se ve ininterrumpida, excepto por la prueba de vuelo, cuyos preparativos continúan a un ritmo acelerado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "Pronto podrá volverse a celebrar la prueba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
