			"dialogs": [
				{
					"id": 150200601,
					"content": "¡Qué técnica tan increíble! ¡Paimon no se atrevía ni a parpadear un instante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200602,
					"content": "¿Nos hemos dejado algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Humm... No he visto ningún problema importante. Creo que la prueba podrá llevarse a cabo en un par de días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "¡S-socorrooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200605,
					"content": "¿Ustedes... son de la Tribu Plumaflora? ¡V-vengan a ayudarnos, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200606,
					"content": "Respira hondo. ¿Qué es lo que pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "U-un Qucusaurio... ¡Ha empezado a atacarnos de pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200608,
					"content": "Mis compañeros y las mercancías siguen en la mitad el camino... ¡Vayan a salvarlos, se lo suplico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidoro"
				},
				{
					"id": 150200609,
					"content": "¿Cómo? Un Qucusaurio... ¿Tan feroces son? ¿Atacó al grupo sin más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200610,
					"content": "En teoría no debería ser así... Pero toda regla tiene su excepción. ¡Vayamos primero a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
