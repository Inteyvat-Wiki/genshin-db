				]
			},
			"dialogs": [
				{
					"id": 150200401,
					"content": "Así que han logrado despejarlo en tan poco tiempo... ¡No esperaba menos de ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Ahora solo tenemos que esperar a que el flogisto gaseoso se vaya volviendo más abundante, y podremos llevar a cabo la prueba de vuelo sin problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Humm... Inkanak, me gustaría probar a volar primero para cerciorarme de que no se nos haya pasado nada. ¿Me ayudas a organizarlo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "¿Eh? Pero acabamos de despejar el terreno. ¿Y si nos hubiéramos dejado algún peligro sin resolver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "Con más motivo debería encargarme yo de inspeccionarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "Ah... Tiene sentido. Con el talento que tienes para volar, aunque se nos hubiera pasado algo, tu vida no correría peligro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "El entorno de la zona sigue sin ser estable. Si no pruebo a volar yo misma, difícilmente lograremos encontrar el problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Está bien, iré a organizarlo. Cuando estés preparada, avísame sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
