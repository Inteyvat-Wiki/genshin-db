					"nextDialogs": [
						150201102
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201102,
					"content": "¿Puedes volver a explicarnos el plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201103
					]
				},
				{
					"id": 150201103,
					"content": "Oh, el plan es usar el globo para transportar los explosivos hasta el orificio de enfrente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201104
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
