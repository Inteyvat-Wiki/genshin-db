			"dialogs": [
				{
					"id": 150200501,
					"content": "#¿Están preparad{F#a}{M#o}s? Ya sé que no es ningún problema para Chasca, pero aun así, tengan cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200502,
						150200504
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200502,
					"content": "¡Yo confío en ella!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Está bien. ¡A volar, pues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200504,
					"content": "Necesitamos más tiempo para prepararnos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
