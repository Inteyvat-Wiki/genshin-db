					"content": "Humm... Viendo este orificio, <color=#00E1FFFF>tan solo tendremos que golpearlo varias veces para despejarlo</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200202
					],
					"speakerTitle": "Investigador cauto"
				},
				{
					"id": 150200202,
					"content": "Pero parece que aquí hay rastros de actividad de alguna criatura extraña, así que no sé si será peligroso actuar de forma directa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigador cauto"
				}
			]
		},
		{
			"id": 1502003,
			"completionStepIds": [],
