			"dialogs": [
				{
					"id": 150201001,
					"content": "¿Eh, ustedes han venido a ayudar? ¡Gracias a los Arcontes! Temía que nadie quisiera colaborar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201002
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201002,
					"content": "Para eliminar los obstáculos de la zona necesitamos un tipo de explosivo especial, pero escalar una montaña tan escarpada con explosivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201003
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201003,
					"content": "Un pequeño golpecito y... ¡pum! ¡Ya puedes decir adiós! Por eso planeo transportar los explosivos al otro lado y luego subirlos en un globo aerostático...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201004
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201004,
					"content": "Solo necesitamos que alguien se quede aquí y que <color=#00E1FFFF>golpee el globo en el momento justo para que los explosivos caigan sobre el orificio...</color> ¡Y asunto resuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201005,
					"content": "¿Qué les parece? Pan comido, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201006,
					"content": "Sí, parece sencillo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "¿Ese globo de ahí arriba también lo soltaste tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "¿Eh? Ah, ese... No sé de quién es, pero se ha elevado mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201009,
					"content": "Ojalá pudiera volar hasta allí para ver la técnica que usaron... Pero ahora lo más importante es reparar el terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Investigador atrevido"
				},
				{
					"id": 150201010,
					"content": "#Iré al otro lado a colocar los explosivos. ¡Denme una voz cuando estén preparad{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigador atrevido"
				}
			]
