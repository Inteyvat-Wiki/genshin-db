			},
			"dialogs": [
				{
					"id": 150200701,
					"content": "Qué extraño... ¿Cómo ha aparecido aquí tanto flogisto sólido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200702
					],
					"speakerTitle": "Investigador dubitativo"
				},
				{
					"id": 150200702,
					"content": "¿Podría provenir de los Vástagos del Eco y haber acabado aquí por el caos de las líneas ley? <color=#00E1FFFF>Acabo de ver unas marcas extrañas por el desfiladero...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200703
					],
					"speakerTitle": "Investigadora confundida"
				},
				{
					"id": 150200703,
					"content": "No puede ser... ¿Acaso tendremos que ir a los Vástagos del Eco a pedir que traigan un <color=#00E1FFFF>Tepetlisaurio</color> para despejarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigador dubitativo"
				}
			]
		},
