						740730702
					]
				},
				{
					"id": 740730702,
					"content": "¡Sí! ¡Seguro que esa es la solución! Nos acompañan durante toda la vida, y no se queman con el fuego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730703
					],
