			"dialogs": [
				{
					"id": 740730101,
					"content": "El fuego de la hoguera sigue encendido. Por cierto, ¿por qué hay un fuego encendido aquí? Si estamos en unas ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Déjame ver qué pone en la estela de piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740730103,
					"content": "“Aquí se halla el cuadrante de los recuerdos, de la sala de los recuerdos, del espacio de los recuerdos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "“Nace en un instante”... “Siempre en conflicto, te acompaña en un largo sueño y nunca se separa”... “No se puede quemar con fuego”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "¿Un acertijo? A la antigua civilización de Fontaine les encantaban, y a la Comunidad Cruz de los Narcisos también, aunque no sé muy bien si era porque les gustaba lo antiguo o porque les interesaba de verdad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730106,
					"content": "Ya he probado a realizar una búsqueda filtrando por palabras clave, pero no he obtenido ninguna respuesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "Pero este acertijo ya está resuelto. Probablemente tenga algo que ver con la hoguera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730108,
					"content": "¿Tiene algún sentido pensar en acertijos que ya están resueltos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740730109,
					"content": "Sí, lo tiene. Aunque tanto tú como yo somos quienes somos ahora, aún debemos averiguar lo que ocurrió en el pasado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730110,
					"content": "Tienes razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740730111,
					"content": "#¿Cuál crees que es la respuesta, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anne"
				}
			]
		},
