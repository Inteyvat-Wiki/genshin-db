					"content": "Déjame ver qué pone en la estela de piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730505,
					"content": "“Aquí se halla el cuadrante de los re... re...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730506,
					"content": "Recuerdos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730507
					]
				},
				{
					"id": 740730507,
					"content": "“... Recuerdos. La sala de los recuerdos, y la cámara de los recuerdos...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730508,
					"content": "“Nace en un instante”... “Siempre en conflicto, te acompaña en un largo sueño y nunca se separa”... “No se puede quemar con fuego”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730509,
					"content": "Es un acertijo.",
					"roleType": "TALK_ROLE_NPC",
