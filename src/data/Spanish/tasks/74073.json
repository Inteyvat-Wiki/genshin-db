					"id": 740730601,
					"content": "Un cálculo. Ya sabes, como los cálculos de un riñón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730602
					]
				},
				{
					"id": 740730602,
					"content": "Es cierto que el fuego no puede destruir un cálculo porque siempre está en órganos y tejidos... pero tampoco se crean en un instante, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730603,
					"content": "#Es cierto. ¿Cuál crees que es la respuesta, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
