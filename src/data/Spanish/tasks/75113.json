			"dialogs": [
				{
					"id": 751130401,
					"content": "Oh, no esperaba que lograras un resultado tan bueno. Te había subestimado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130402
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130402,
					"content": "#Y pensar que, después de toda la preparación, un{F#a} extrañ{F#a}{M#o} que pasaba por aquí se llevaría el premio del desafío con tanta facilidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130403
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130403,
					"content": "#¡Pareces salid{F#a}{M#o} una de esas historias de héroes que cuentan en los pergaminos de tela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130405
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130405,
					"content": "¡Tal vez tú también te logres convertir en uno de ellos! Humm... ¡Es muy probable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130406
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130406,
					"content": "#¿Puedo tomarles una imagen juntos, {F#heroína}{M#héroe}? Puede que algún día pueda presumir de ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
