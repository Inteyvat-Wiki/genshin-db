			"dialogs": [
				{
					"id": 751130101,
					"content": "#¡Guerrer{F#a}{M#o} de alma bondadosa! ¡Gracias a tu ayuda, mis saurios están a salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130106,
					"content": "#¡Alguien tan bondados{F#a}{M#o} y valiente como tú merece que le ayude a entrenar para el Desafío del Audaz gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130104,
						751130105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130104,
					"content": "¡Empecemos!",
