				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "#Gracias viajer{F#a}{M#o}. Uff... sabía que terminaría arruinándolo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180102,
					"content": "Una cosa tan fácil como transportar un carruaje... y metí la pata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180103,
					"content": "Si sigo así, me despedirán del viñedo. Eso si el Sr. Connor no me tiene ya en la mira, claro está. Apuesto a que Elzer está redactando mi carta de despido mientras hablamos... Se acabó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180104,
					"content": "Calma, calma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "¡Ay! ¡Estoy acabado! Pero, aun así, tengo que cumplir con mi responsabilidad y llevar el carruaje sano y salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180106,
					"content": "¿Puedes ayudarme a buscar algunos materiales para arreglar mi carruaje? Con una <color=#00E1FFFF>tabla de madera</color> debería ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Miedoso Magar"
				}
			]
		},
		{
