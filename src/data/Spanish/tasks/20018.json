			"dialogs": [
				{
					"id": 200180401,
					"content": "#¡Puf! Gracias, viajer{F#a}{M#o}, menos mal que estabas aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180402,
					"content": "Ahora no sé cómo voy a reparar este pedazo de chatarra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180403,
					"content": "Está roto por todos lados... Tendré que arreglarlo como pueda. Si no, se caerá a pedazos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180404,
					"content": "No importa. Mientras no se rompa antes de llegar a la ciudad... Puedo arreglármelas después de eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180405,
					"content": "Recuerdo que había una soga dentro del carruaje... pero esos monstruos se la llevaron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "El Miedoso Magar"
				},
				{
					"id": 200180406,
					"content": "#Viajer{F#a}{M#o}, ¿puedes ir al bosque de al lado y buscar una <color=#00E1FFFF>soga</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "El Miedoso Magar"
				}
