			"dialogs": [
				{
					"id": 761970120,
					"content": "(prueba) Diálogo",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Cuando navegaba por el mar hace años, escuché una llamada proveniente de algún lugar. Los demás no reaccionaron, pero yo quedé cautivado de inmediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Seguro que era una voz de otro mundo. Yo también la oí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Más tarde me di cuenta de que esa llamada contenía todos los sueños que nunca lograron alcanzar la otra orilla. Podría decirse que se trata de una acumulación de resentimientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Deberías llevar contigo el guijarro glacial. Si miras a través del agujero en el centro, podrás ver quién te está llamando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Pero en aquel entonces era joven y temerario. Aunque viera el peligro, solo pensaba en las oportunidades que traía consigo, así que me lancé de cabeza sin pensarlo dos veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "Dicen que el agujero en el centro del guijarro glacial es una puerta a otro mundo... Pero ¿cómo se supone que uno puede atravesarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "Y después de aquello... las tormentas del mar me arrebataron mi fortuna, mi honor y a mi familia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Las aventuras impulsadas por la ambición y la codicia nunca terminan bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, se atascó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Deja que te ayude. Pero no vuelvas a hacerlo, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761970111,
					"content": "Linnéa, ¿qué te trae de vuelta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Vine a recolectar guijarros glaciales por aquí cerca y, al verlos conversando, quise pasar a saludar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761970113,
					"content": "Ah, es cierto. ¡Tal vez tú puedas usar un guijarro glacial para abrir una puerta hacia otro mundo, Linnéa! Si alguien puede, eres tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Ni siquiera yo puedo hacerlo. ¿No te lo dije antes? Eso no es más que una leyenda popular sin fundamento, no hay ninguna prueba fiable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761970115,
					"content": "¿Entonces no funciona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "Veo que estabas prestando atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761970117,
					"content": "*Ejem*... No, ya no soy la misma persona que antes. Ahora vivo feliz con lo que tengo y no pido más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Vaya, qué lástima. Bueno, ¡entonces yo también ayudaré a Linnéa a recolectar guijarros glaciales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "¡Genial! Cuento contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761970124,
					"content": "Con la ayuda de Auni, terminan la recolección rápidamente...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Gracias, pero ya he terminado de recolectar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761970123,
					"content": "Bueno, entonces iré al Desfiladero de los Topos a buscar al abuelo Topo y los demás. ¡Hasta luego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
