					"Citlalí"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745290401,
					"content": "#Oh, hola, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290402,
					"content": "Hola, Citlalí. Cuánto tiempo sin verte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "¡Pero bueno! Esta abuelita también sale a dar un paseo de vez en cuando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290405,
					"content": "Además, anoche consulté mi fortuna y decía que si salía hoy, me encontraría con algo bueno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290406,
					"content": "¡Y mira! Apenas salí de casa y la buena suerte ya vino a tocar mi puerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290407,
					"content": "¡Hagamos que las buenas cosas vengan por partida doble! ¡Vamos a tomar imágenes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Bueno, por qué no... Pero estos días me he quedado en vela toda la noche para terminar el último volumen de la novela ligera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290410,
					"content": "¿Cómo me veo ahora? Ya se me habrán quitado las ojeras, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290411,
					"content": "Te ves tan enérgica como siempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "¿En serio? ¡No me vayas a engañar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290414,
					"content": "Pero que quede claro, si las imágenes no salen bien, me las quedaré yo... Y si quieres conservar alguna, solo puede ser la que salga más bonita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlalí"
				},
				{
					"id": 745290412,
					"content": "¡Te ves radiante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "¿Te parece si te tomo una imagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "Qué raro verte fuera de casa en vez de estar durmiendo la siesta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
}