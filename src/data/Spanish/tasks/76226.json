			"dialogs": [
				{
					"id": 762260201,
					"content": "¿Eh? ¡Maalaus! ¿Tú también estás aquí? ¡No esperábamos encontrarnos contigo en la Luna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260202,
					"content": "Seguro que Colombina te trajo aquí, ¿verdad? Después de todo, dijo que organizaría una exposición para ti en la Luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260203,
					"content": "Hablando de la exposición... ¿dónde están tus pinturas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260204,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260205,
					"content": "¿Qué pasa? ¿Acaso... se perdieron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260206,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260207,
					"content": "¿Cómo pudo pasar eso? ¡Estamos en la Luna! No pudieron haberlas robado, ¿verdad?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260208,
					"content": "Bueno, de todas formas, primero ayudemos a Maalaus a buscarlas. A lo mejor las dejó por aquí cerca sin más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
