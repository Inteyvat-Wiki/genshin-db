			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "#Gracias, gracias. Muchas gracias por tu ayuda, viajer{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090205,
					"content": "De no ser por ti, este lugar se habría convertido en mi tumba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090206,
					"content": "¿Tú instalaste este campamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "Ehmm... Algo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090210,
					"content": "Supongo que sabes que hacer negocios en Ritou es un trabajo duro. Este campamento es... pues... un secretito, por así decirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090211,
					"content": "Hace unos días, le pedí a un... amigo que me trajera algunos ingredientes para licor de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090212,
					"content": "Consiguió un lote de muestra del Viñedo del Amanecer y lo envió para acá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090213,
					"content": "Sin embargo, fue muy descuidado, así que algunas de las cajas están rotas, y la tapa de los ingredientes para el licor está floja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090214,
					"content": "Decidí desenroscarla para volverla a poner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090215,
					"content": "... pero no imaginé que un montón de Slimes saltarían de su interior. Es de lo más extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090216,
					"content": "Con que ingredientes para hacer licor, ¿eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "Bah, ya no importa. Ya ajustaré las cuentas con él la próxima vez que venga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090218,
					"content": "Me salvaste la vida, y estoy en deuda contigo. Toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090219,
					"content": "Por otro lado, ¿ves ese bote por allá? Es otro de mis... secretos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090220,
					"content": "Con ese bote puedes infiltrarte en la Isla Narukami. Muy práctico, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090221,
					"content": "¿Y por qué querría infiltrarme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "Verás, es lo que llaman “esperar lo inesperado”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090223,
					"content": "#Bien, debo volver y hacerme cargo de ese cargamento, así que no puedo quedarme aquí por mucho tiempo. Te lo agradezco de nuevo, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090224,
					"content": "Parece que tendré que cambiar de punto de reunión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090208,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "Estoy, ehmm... ¡Moviendo mercancía! Jajaja, sí, moviendo mercancía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				}
			]
		}
	]
}