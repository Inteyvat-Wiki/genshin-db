			"dialogs": [
				{
					"id": 728090108,
					"content": "Bien, ya llegaron los bienes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090109,
					"content": "Ya se habían tardado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090110,
					"content": "¡Y esta caja está rota de una esquina! ¡Bah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090111,
					"content": "¿Cómo es posible? Le dije que tuviera cuidado. Esperemos que no se haya roto nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090112,
					"content": "Uff, parece que ninguna de las botellas está rota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090113,
					"content": "¿Eh? ¿Por qué la tapa de una de las botellas está floja? Ahora tengo que desenroscarla y ponerla de vuelta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090114,
					"content": "*Ejem*, y estos ingredientes para hacer licor saben demasiado fuerte. Movámoslos de aquí primero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090115,
					"content": "¿Eh? ¿Qué hacen todos estos Slimes aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
