			"dialogs": [
				{
					"id": 722420401,
					"content": "¡Guau! ¡Paimon nunca pensó que habría un lugar tan inmenso bajo la Isla Watatsumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420402,
					"content": "Parece que nuestro objetivo es llegar a aquel lugar del medio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420403,
					"content": "#Bueno, {NICKNAME}. Allá vamos. Con precaución esta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "¡Esas ruinas parecen más cercanas! Comencemos explorando por allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Donde hubo edificios, hubo humanos... Al menos en su día. Y donde hubo personas, ¡hubo escritura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420406,
					"content": "Y donde haya escritura y papel, estarán... esas pistas indescifrables que buscamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
