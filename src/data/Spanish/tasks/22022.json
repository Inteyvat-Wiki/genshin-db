			"dialogs": [
				{
					"id": 220220201,
					"content": "En Mondstadt hay un plato llamado estofado de carne y manzana del Norte. Xudong ha garabateado en la receta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "“La mantequilla es bastante cara y la carne cruda es difícil conservarla. Lo mejor sería amasar, sacar el gluten y hervirlo al vapor con un acompañamiento de frutas y verduras para que obtenga la textura de la carne”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "¡Este hombre! La mantequilla no es cara, y la carne se puede ir a comprar en el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "#Bueno, no importa. Viajer{F#a}{M#o}, lo que necesito preguntarte es esto: en la receta original del estofado de carne y manzana del Norte, ¿qué otro ingrediente se utiliza además de manzanas, mantequilla y carne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Almendras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Oh, ¿sí? Pues lo anoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Pimienta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Oh, ¿sí? Pues lo anoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Chile de Jueyun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "Jamón.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
