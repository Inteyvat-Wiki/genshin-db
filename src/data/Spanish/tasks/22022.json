			"dialogs": [
				{
					"id": 220220401,
					"content": "En Liyue hay un plato llamado sopa de brotes de bambú. Se dice que su elaboración debe ser muy precisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220402
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220402,
					"content": "Ese Xudong... Otra que ha cambiado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220403
