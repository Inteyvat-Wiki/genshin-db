			"dialogs": [
				{
					"id": 220220301,
					"content": "En Liyue hay un plato llamado carne estilo Eje Celestial. Xudong también ha garabateado en esta receta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "“Pelar las papas y cocerlas. Aplastarlas mientras están calientes y añadir aceite y sal. Poner en un bol y mezclar con harina para que espese y tenga textura de carne al principio.”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220303,
					"content": "Al principio... ¿Y si se come mucho no se notará que no es carne? Esto solo sirve para engañar a quienes no han comido nunca carne estilo Eje Celestial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220304
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220304,
					"content": "#Bueno, no importa. Viajer{F#a}{M#o}, lo que necesito preguntarte es esto: En la receta original de la carne estilo Eje Celestial, ¿qué otro ingrediente se utiliza además de carne, azúcar y matsutake?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220305,
						220220306,
						220220308,
						220220309
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220305,
					"content": "Campanita de cristal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220310,
					"content": "Oh, ¿sí? Pues lo anoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220306,
					"content": "Flor chingxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220307
					]
				},
				{
					"id": 220220307,
					"content": "Oh, ¿sí? Pues lo anoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220308,
					"content": "Flor dorada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220309,
					"content": "Lirio cala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				}
			]
