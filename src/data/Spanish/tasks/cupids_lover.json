					}
				]
			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "#Tiene pinta de que alguien ya estuvo aquí hace poco. Vaya, así que hay alguien más aparte de nosotr{F#a}{M#o}s que está familiarizado con la exploración de ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750202,
					"content": "¿Eso que hay en el suelo es un... reloj de bolsillo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750203,
					"content": "Si nos guiamos por lo que solemos hacer durante nuestras aventuras, deberíamos comprobar qué dice en esta estela de piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750204,
					"content": "“Aquí se halla el cuadrante de las almas, del universo de las almas, del espacio de las almas...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750205,
					"content": "“‘Te acompañaré en tu eterno descanso’... ‘Nacido en un instante, a menudo enfrentados, pero siempre unidos’... ‘El tesoro más valioso que existe entre los humanos’”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750206,
					"content": "Elemental, querida Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "Piensa, Paimon, piensa... Es un reloj muy valioso, un tesoro entre los humanos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750209,
					"content": "Oooh, ¡Paimon ya lo sabe! ¡No puede ser otra cosa que los Moras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750210,
					"content": "Eh... A mí no me convence esa respuesta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "Tienes razón, normalmente los acertijos no son tan mundanos. Entonces, quizás se refiera a... Paimon lo tiene en la punta de la lengua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750212,
					"content": "¡Eso es! ¡Riqueza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750213,
					"content": "Estupendo, ya podemos descartar esa respuesta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "¡Pero bueno! ¡Qué poca confianza tienes en tu compañera de viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750215,
					"content": "#Bueno, ya que eres tan list{F#a}{M#o}, ¡¿por qué no lo adivinas tú?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750216,
					"content": "Qué buen tiempo hace hoy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "¡Será posible! ¡No le cambies a Paimon de tema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750218,
					"content": "No es para tanto. Veamos qué nos encontramos más adentro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750219
					]
				},
				{
					"id": 740750219,
					"content": "¡Oye! Si tú tampoco lo sabes, ¡admítelo! ¡No huyas tan rápido con tal de ahorrarte un momento incómodo! ¡Y no te vayas sin Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750207,
					"content": "Es un acertijo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				}
			]
		},
