			"dialogs": [
				{
					"id": 740750101,
					"content": "“Aquí se halla el cuadrante de las almas, del universo de las almas, del espacio de las almas...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750102,
					"content": "“‘Te acompañaré en tu eterno descanso’... ‘Nacido en un instante, a menudo enfrentados, pero siempre unidos’... ‘El tesoro más valioso que existe entre los humanos’”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750103,
					"content": "*Fiu*... menos mal que esta vez no hay nada que dé miedo. La respuesta es... ¿un reloj de bolsillo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750104,
					"content": "Ahora que Paimon se acuerda, ¿no tenías tú uno también, Anne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750105,
					"content": "Los relojes son muy caros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "¡Entonces la respuesta solo puede ser “Moras”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750107,
					"content": "Morir con Moras es la segunda peor desgracia que te puede suceder en la vida. No preguntes cuál es la primera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750108,
					"content": "¿Cuál es la mayor desgracia que puede haber en esta vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740750109,
					"content": "Yo lo sé, la respuesta es “descansar en tu ataúd sin un solo Mora”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750110,
					"content": "No me gusta esa forma de pensar. Hay muchas cosas en el mundo que son más importantes que los Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740750111,
					"content": "Ya les dije que no preguntaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750112,
					"content": "Perdón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750113,
					"content": "Volviendo al tema y basándome en las respuestas anteriores, yo no pienso que la respuesta correcta sea un exquisito reloj de bolsillo o Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750114,
					"content": "¿Y qué podría ser entonces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750115,
					"content": "La respuesta es muy sencilla. De hecho, puedo recordar ahora mismo acertijos similares a este en un 70%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750116,
					"content": "Proviene de una novela clásica publicada hace varios siglos. El texto original decía así: “Nací en el instante en el que dos miradas se cruzaron. Corro dando la espalda a aquella persona que anhelo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750117,
					"content": "“Aunque me quede sin carne, huesos y órganos, seguiré estando junto a ti con el tuétano de mis huesos”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750118,
					"content": "La respuesta es “amor”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750119,
					"content": "Ya lo entiendo. Este reloj es idéntico al mío, así que en su interior también debe de contener numerosos recuerdos de amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740750120,
					"content": "Si tan solo pudieras abrir el reloj...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "Sí, algún día conseguiré abrirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740750122,
					"content": "¡No está mal para un perro bobo! ¡Eres el perro mecánico más adorable de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740750123,
					"content": "Ha sido un placer. No obstante, la cualidad de adorable es de naturaleza subjetiva. Me encantaría que algún día se refirieran a mí como “el prototipo original 4ACV07 de lo más confiable y larga durabilidad”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750124,
					"content": "Y eso es lo que te hace tan adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "Anne"
				},
				{
					"id": 740750125,
					"content": "¿Están citando clásicos? Me suena haber visto esta escena antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750126,
					"content": "Bueno, pues ya hemos resuelto el acertijo de esta zona. Sigamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
