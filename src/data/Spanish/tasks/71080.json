			"dialogs": [
				{
					"id": 710800634,
					"content": "#Contarle sobre la búsqueda de tu herman{F#o}{M#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800635
					]
				},
				{
					"id": 710800635,
					"content": "Le cuentas tu experiencia a Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "Interesante, realmente interesante. Un sacrificio sin reconocimiento alguno, un castigo injusto por la ignorancia... ¡Qué gran tema! ¡Magnífica historia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "Y sin embargo, las aventuras que ha experimentado a su paso están estrechamente relacionadas con su objetivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Gracias por contarme todo esto, lo anotaré ahora mismo. Sin embargo, por el momento no puedo completar un poema, porque esto es solo un fragmento de una gran oda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "Con la limitada capacidad de este servidor, solo podría mancillar sus hazañas, pero cuando termine su travesía, le ruego que me la cuente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "Tengo el presentimiento de que algún día bendecirá mis oídos al escuchar sus grandes hazañas de su propia boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
