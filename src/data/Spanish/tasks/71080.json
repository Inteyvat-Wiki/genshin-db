			"dialogs": [
				{
					"id": 710800701,
					"content": "Gracias por ayudarme a completar el poema. Ah, casi lo olvido. Por favor, acepte esto como muestra de agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800702,
					"content": "¡Uf! Este primer boceto lleva consigo todos mis sentimientos y aspiraciones. Hoy le hago entrega del mismo. Es lo menos que puedo hacer como compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7108008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
