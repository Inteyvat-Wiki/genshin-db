					"nextDialogs": [
						710800643
					]
				},
				{
					"id": 710800643,
					"content": "#¡Jaja! ¡Qué historia tan fascinante! “‘¡Lamentable el día en el que fuimos salvados por nuestr{F#a}{M#o} más grande enemig{F#a}{M#o}!’, exclamó el serzhant Anton con un suspiro...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800644
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800644,
					"content": "“Hoy un amigo, ¡mañana quizás un enemigo!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
