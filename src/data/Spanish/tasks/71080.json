			"dialogs": [
				{
					"id": 710800617,
					"content": "Contarle sobre los cristales azules de las profundidades de la Sima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800618
					]
				},
				{
					"id": 710800618,
					"content": "Le cuentas tu experiencia a Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "“El color del cielo y de las aguas fluyó sobre la superficie del cristal, y las manchas púrpura desaparecieron...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800620,
					"content": "#“La antigua bestia de las ruinas quedó aturdida por el golpe del puño de acero de {NICKNAME}, ¡y justo en ese momento, llegó la gran estrella!”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800621,
					"content": "#“La aliada misteriosa que vino al auxilio {F#de la viajera}{M#del viajero} desapareció sin dejar huella. Pero, para entonces, el cristal ya había hecho añicos a la serpiente artificial...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
