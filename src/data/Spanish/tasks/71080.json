					]
				},
				{
					"id": 710800623,
					"content": "Le cuentas tu experiencia a Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800624
					]
				},
				{
					"id": 710800624,
					"content": "Fascinante, escapa a la imaginación de cualquiera... Deme un momento para pensar lo que voy a decir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800625
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800625,
					"content": "“A pesar de ser un hongo imponente, estaba totalmente a merced de la inminente oscuridad...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800626
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800626,
					"content": "#“Pero {NICKNAME} respondió al llamado y purificó las tierras, evitando así el desastre...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
