			"dialogs": [
				{
					"id": 710800613,
					"content": "Contarle sobre la niebla oscura y los monstruos del abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800614
					]
				},
				{
					"id": 710800614,
					"content": "Le cuentas tu experiencia a Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800615
					]
				},
				{
					"id": 710800615,
					"content": "¡Por Los Siete! ¡Espléndido! Deme un momento, déjeme anotarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800616
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800616,
					"content": "“La penumbra presionaba como una avalancha. Entonces, los dos emisarios del Abismo, tal y como habían aparecido, se esfumaron sin dejar rastro alguno...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
