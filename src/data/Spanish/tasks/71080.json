					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710800601,
					"content": "#Quizás sea un poco precipitado, pero... oh, noble {F#heroína}{M#héroe}, ¿podría dedicar un poco de su tiempo y contarme alguna que otra de sus anécdotas para inmortalizarlas en verso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800602,
						710800603
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800602,
					"content": "Si quieres que te cuente una historia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "¿Es eso un “sí”? ¡Magnífico! Soy todo oídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800603,
					"content": "Tengo muchas que contarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				}
			]
		},
