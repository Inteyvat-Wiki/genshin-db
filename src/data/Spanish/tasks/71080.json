					"nextDialogs": [
						710800611
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800611,
					"content": "¿En serio está bien? No le hemos pedido permiso para añadirla a la historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710800612,
					"content": "¡Oh, no tema! Los héroes no actúan como la gente común, ¡así que no tienen por qué constreñirse como tal! Nadie se molestará por eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
