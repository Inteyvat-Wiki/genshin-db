				{
					"id": 710800629,
					"content": "Contarle sobre los nueve Caballeros Serpiente Negra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800630
					]
				},
				{
					"id": 710800630,
					"content": "Le cuentas tu experiencia a Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800631
					]
				},
				{
					"id": 710800631,
					"content": "#¡Maravilloso! ¡Excelente! “Entonces, {F#la viajer}{M#el viajero} del destino pronunció estas palabras: ‘Nada de pelear uno contra uno, ¡acabaré con los nueve de una sola vez!’”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800632
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800632,
					"content": "Eh... Es un poco exagerado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800633
					]
				},
				{
					"id": 710800633,
					"content": "No importa. Ahora, si me permite, me tomaré un poco de libertad creativa para hablar sobre el pasado de esos nueve caballeros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
