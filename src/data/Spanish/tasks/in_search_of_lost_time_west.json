			"dialogs": [
				{
					"id": 740120501,
					"content": "Ay, ¡qué tipo más estricto! ¡Paimon no trabajaría de ninguna manera bajo sus órdenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "“Por el honor colectivo”, *tch*. ¡A quién le importa eso si están pasando hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Sus razones tendrá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "¡Qué normas más absurdas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Bueno, la disciplina es importante, pero tampoco era necesario llegar hasta ese punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "¡Pues sí! Cuanto menos trabajo de campo hacen, más les gusta poner disciplina y normas sin sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "#Pensándolo bien, si nosotr{F#as}{M#os} también nos ponemos a golpear la olla, quizás podamos hacer que se baje ese tal subcapitán Shumilov.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#De esa manera, podremos subir arriba. ¡Probemos, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
