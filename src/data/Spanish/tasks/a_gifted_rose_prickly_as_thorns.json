					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040428,
					"content": "Deberíamos llevarnos solo los Moras y devolverle la comida. Humm, Paimon no se queda tranquila así.",
