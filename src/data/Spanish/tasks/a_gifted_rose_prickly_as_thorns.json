					"speakerTitle": "Paimon"
				},
				{
					"id": 732040426,
					"content": "Esto es demasiado. Oye, ¿no será esta la comida de todo un día del abuelo Affan, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040427,
					"content": "El abuelo Affan vive un poco apartado de la aldea. No debe ser fácil para él conseguir todo esto.",
