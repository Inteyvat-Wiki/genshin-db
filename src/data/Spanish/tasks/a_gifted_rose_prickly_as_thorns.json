				},
				{
					"id": 732040425,
					"content": "¿Eh? Pero si casi no hay Moras, es todo comida: rollos de shawarma, tahchín y un montón de verduras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
