				"objectNames": [
					"Ernest"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4880101,
					"content": "Así que aquí es donde está la entrega de Charles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880102,
					"content": "¿Has venido a rescatarme? He estado una eternidad esperando aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "En todo el tiempo que he trabajado en el viñedo, esta es la primera vez que los Hilichurls me asaltan... *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "Si hubieran llegado más tarde, no sé qué habría hecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#¡No temas! ¡{NICKNAME} es {F#una extraordinaria exterminadora}{M#un extraordinario exterminador} de Hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Se lo agradezco. Entonces, tomen este <color=#00E1FFFF>globo aerostático</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "Y tengan cuidado. El objetivo no es atacar a los Hilichurls, es mejor que te asegures que <color=#00E1FFFF>los productos estén intactos</color>, porque no tengo los Moras suficientes para reemplazarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880108,
					"content": "Te espero ahí adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Ernest"
				}
			]
		},
