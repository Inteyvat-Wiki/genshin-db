				"points": []
			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "¿Lisa? ¿Estás aquí por lo de la declaración de impuestos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "Oh, hola cariño. Después de enterarme de lo de la pobre Jean, pensé que podría echarle una mano con algunos de sus deberes más literarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "¡Genial! Entonces, si ya no nos necesitan aquí, nos retiramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "Un momento... En realidad, Charles se preguntaba si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "Permítame, señorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Acabo de aceptar un pedido bastante importante, pero, desafortunadamente, nos hemos quedado sin vino y la entrega del Viñedo está atrasada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Si no es mucho pedir, ¿podrían <color=#00E1FFFF>ir a ver qué ocurre con las mercancías</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "¿Qué tiene de urgente este pedido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "*Suspira*, llegó en el último minuto. Literalmente, hace solo unos segundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Sí, Charles tiene toda la razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "Bien, veré qué puedo hacer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "Está bien, ¡pero será mejor que la casa invite mi próxima bebida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Jeje... Estoy seguro de que la próxima vez que mi jefe, el Sr. Diluc, esté aquí, él pagará la cuenta por ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880014,
					"content": "¡Suena bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48801,
			"completionStepIds": [
				48801
			],
