			"dialogs": [
				{
					"id": 210261001,
					"content": "¿Y bien? ¿Ya arrojaste la botella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "¿Crees que Meng la recibirá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Humm... Normalmente, sería algo difícil. Prácticamente imposible, diría yo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "¿Entonces qué sentido tiene que la arrojemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Jaja, calma. Ya les dije que un adulto responsable le ayudará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "¿Conocen un lugar llamado Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "Tengo varios colegas que se dedican al mundo de los negocios. Pretenden entrar en el mercado de los hongos, así que irán allá a hacer un estudio de mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Jajaja, ya saben, “hacer un estudio de mercado” también significa tener tiempo de entretenimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Ya que a Meng le gustaría viajar a otra región, echaré mano de mis contactos para ver si alguno de ellos puede llevar a una persona más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Ustedes no se preocupen, yo me encargaré de este asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "Hice una copia de esta carta para otro propósito. En cuanto a la botella... déjenla ir. No creo que la vaya a recoger nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "Gracias por ayudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Los adultos ayudan a los niños a hacer sus sueños realidad. Es algo normal, ¿no? Yo me encargo de ello, descuiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Oh, les diré a mis amigos que se arreglen un poco, no quiero que asusten a nadie con la pinta que llevan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "¿Por qué estás dispuesto a ayudar a Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
