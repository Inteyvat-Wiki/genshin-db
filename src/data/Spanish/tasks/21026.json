				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "La letra del mensaje en la botella parece la de un niño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260102,
					"content": "¿Meng? ¿Quién es ese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260103,
					"content": "¿Eh? Esa botella es...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "#¿Viajer{F#a}{M#o}? Por tu tono de voz, parece que conoces a la persona que escribió este mensaje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260105,
					"content": "Digamos que sí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "Ya veo... Es un niño con ideas muy grandes. Conque quiere madurar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260108,
					"content": "¿Sabes? Creo que un paseo por el exterior le ayudaría a ampliar sus horizontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260109,
					"content": "Ahora que lo mencionas... Meng dijo que quería explorar las afueras de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260110,
					"content": "#Pero nosotr{F#as}{M#os} ya lo invitamos... ¿Por qué no quiso ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260111,
					"content": "Jajaja, tal vez ese hombrecito es un poco terco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260112,
					"content": "Es un problema personal, es normal que quiera resolverlo por su cuenta. No puede depender de otros por siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260113,
					"content": "Pero no creo que resuelva nada solo con lanzar una botella a la deriva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260114,
					"content": "Entonces es hora de que un adulto de confianza lo ayude, ¿no crees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260115,
					"content": "#Ven, viajer{F#a}{M#o}, vamos a escribirle una carta a ese pequeño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260116,
					"content": "Hay que escribirle sobre las cosas nuevas y emocionantes que le esperan en el mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260117,
					"content": "#Pero... jeje, yo no he visitado tantos lugares, así que dejaré los detalles en tus manos, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260118,
					"content": "Escribamos sobre las ruinas y la gran torre envueltas en una tormenta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "Más despacio, más despacio. No puedo escribir tan rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260122,
					"content": "Humm... Aquí... Agregamos esto y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260123,
					"content": "¡Ya está, terminamos! Vaya, escribimos muchas cosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260124,
					"content": "Jajaja, después de escucharte hablar, ¡incluso yo quiero ir de viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260125,
					"content": "Viajar es agradable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "Ah, pero a mi edad, hay muchos quehaceres que atender. Ya no puedo viajar cuando y donde se me antoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260127,
					"content": "Ya metí la carta en una botella. Ve a lanzarla al río.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260119,
					"content": "Hablemos sobre el archipiélago rodeado de tempestades...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "Contémosle sobre la isla que la Arconte Electro partió en dos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "Es un niño de Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
