						"rawParams": [
							"202",
							"200"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050301,
					"content": "200 Moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "#¡Qué {F#precavida}{M#precavido} es usted! ¡Jaja! De acuerdo, escoja una piedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050303,
					"content": "Puede echar un vistazo más de cerca. Son solo 200 Moras, pero el dinero es el dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050304,
					"content": "Dígame qué piedra le interesa y yo la abro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230504,
			"completionStepIds": [
				2230504
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
