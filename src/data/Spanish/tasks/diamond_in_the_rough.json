			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050501,
					"content": "600 Moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050502
					]
				},
				{
					"id": 223050502,
					"content": "¡Muy bien! ¡Esa es la actitud! Estoy seguro que ganará mucho dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050503,
					"content": "Por acá. Dígame qué piedra le llama la atención.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050504,
					"content": "Mírelas con detenimiento, todas estas son de las mejores rocas, no hay forma de equivocarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050505,
					"content": "Una vez que se decida, dígamelo y vendré a abrirla. No hace falta que usted la abra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
