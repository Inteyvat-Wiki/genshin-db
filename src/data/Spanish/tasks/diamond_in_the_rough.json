				"points": []
			},
			"dialogs": [
				{
					"id": 223050201,
					"content": "Tenemos muchas gemas en bruto en El Misterio del Jade. Si quisiera verlas de una en una, ¡terminaría por marearse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050202
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050202,
					"content": "Las he ordenado antes de nada para que le resultara más cómodo. ¿Puedo preguntarle su presupuesto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230503,
			"completionStepIds": [
				2230503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
