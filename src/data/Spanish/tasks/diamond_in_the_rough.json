			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050401,
					"content": "400 Moras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050402
					]
				},
				{
					"id": 223050402,
					"content": "Veo que sabe lo que quiere. El precio es el correcto, ni mucho ni poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050403,
					"content": "Venga por aquí. Escoja la roca que más le guste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050404,
					"content": "Tómese su tiempo y, cuando la haya escogido, llámeme y vendré a abrirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230505,
			"completionStepIds": [
				2230505
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
