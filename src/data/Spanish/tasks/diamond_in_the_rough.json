				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "#¡Estimad{F#a}{M#o} client{F#a}{M#e}! ¿No quiere probar su suerte con una piedra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050102,
					"content": "Dame una piedra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "#¡Excelente! Estimad{F#a}{M#o} client{F#a}{M#e}, veo que hoy es su día de suerte. ¡Podría hacer una fortuna! Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050116,
					"content": "Acompáñeme, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050104,
					"content": "¿De qué piedras hablas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "De las de mi tienda, claro está. ¡Tengo las mejores piedras en bruto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050106,
					"content": "Si sale jade de ella, le pagaré en Moras. Pero si no extrae nada, tampoco habrá Moras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050107,
					"content": "La mejor forma de aprender es intentarlo. ¿Por qué no hace una prueba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050108,
					"content": "¿De dónde vienen estas piedras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "Todos las piedras de nuestra tienda son productos de alta calidad extraídos de la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050110,
					"content": "¿No me cree? ¡Déjeme decirle que, en El Misterio del Jade, hemos vendido jade durante generaciones! Si de joyería se trata, ¡no hay nadie que nos iguale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050111,
					"content": "Pero bueno, esos días de gloria quedaron en el pasado. Ahora el Ministerio de Asuntos Civiles cerró la entrada a la Sima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050112,
					"content": "Por eso, cada vez se venden menos piedras, y las que se venden tienen un valor incluso mayor que el del mismo jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050113,
					"content": "Así que pensé que sería mejor vender las gemas en bruto en la tienda directamente. No solo ahorro tiempo de trabajo, ¡sino que, cada vez que abro una piedra, es realmente emocionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050114,
					"content": "#¿Qué dice, estimad{F#a}{M#o} client{F#a}{M#e}? Si quiere, puede traer las piedras usted mism{F#a}{M#o} y probar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050115,
					"content": "Dame una piedra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
		{
			"id": 2230502,
