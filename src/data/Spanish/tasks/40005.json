			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"¿?"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "De acuerdo, ustedes dos están con los Ladrones de Tesoros, ¿cierto? Aunque sugerí en la carta que trajeran máscara y disfraz como yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050202,
					"content": "... Pero parece que no leyeron esa parte. Está bien, admiro su valor. Tienen coraje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050203,
					"content": "¡Hum! ¿Sabes qué? ¡No necesitamos andar a escondidas por todas partes con disfraces ridículos! Porque a diferencia de ti, ¡nunca haríamos algo tan desagradable y horrible como para usar máscaras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050204,
					"content": "¡Oye, estaba en medio de un discurso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050205,
					"content": "Creo que simplemente le gusta disfrazarse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Un momento... ¡Ustedes no son Ladrones de Tesoros! ¿A qué están jugando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050206,
					"content": "En realidad, me está comenzando a gustar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
			"id": 4000504,
			"completionStepIds": [
				4000504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000504",
							"2"
						],
						"stepId": 4000504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"¿?"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050401,
					"content": "¡Cuéntanos tu plan diabólico, ahora! ¡Se acabó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050402,
					"content": "¡De acuerdo! ¡Me rindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050403,
					"content": "¡Ríndete ahora o siente la ira de Paimon! Eh... ¿Cómo? ¿Te rindes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050404,
					"content": "De hecho... solo soy un ladrón novato que anhela llegar a ser tan grande como los Ladrones de Tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050405,
					"content": "¿Un ladrón novato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050406,
					"content": "Para un novato solitario como yo, los Ladrones de Tesoros son unos héroes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050407,
					"content": "Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050408,
					"content": "... así que pensé en aprovechar una oportunidad lucrativa como muestra de mi lealtad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050409,
					"content": "¡Espera un segundo! ¡Nada de lo que dices tiene sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050410,
					"content": "Paimon esperaba que un pirómano en serie sería más... malévolo. Pero en su lugar, nos encontramos contigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050411,
					"content": "¿Pirómano? ¿De qué están hablando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050412,
					"content": "¡Deja de fingir! ¡Paimon te vio merodeando por los montones de materiales inflamables!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050413,
					"content": "Oh, ya veo, te refieres a eso. ¡Solo estaba inspeccionando el área!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050414,
					"content": "¡Mis planes no tienen nada que ver con esos materiales para linternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050415,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050416,
					"content": "¡Solo quiero robar el trozo de plaustrita más grande que ha habido en veinte años!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050417,
					"content": "Mi plan era esperar a que anocheciera, cortar las cuerdas que la ataban y dejar que flotara hacia el mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050418,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050419,
					"content": "Luego, lo único que tenía que hacer era pensar en una forma de esconderla bajo el agua. ¡Es el crimen perfecto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050420,
					"content": "¡Tiene más huecos que un queso! Por ejemplo, ¿cómo pensabas hundir la plaustrita bajo el agua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050421,
					"content": "Estaba pensando en los detalles del plan, por eso no he actuado hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "¿?"
				},
				{
					"id": 400050422,
					"content": "¡Este tipo es un inepto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050423,
					"content": "#Muy bien, {NICKNAME}, dale una lección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050424,
					"content": "Entonces, volvamos con el señor Yaksha para informarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000505,
