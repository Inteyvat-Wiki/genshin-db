			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(¿Quizá <color=#FFCC33FF>Néfer</color> esté interesada en las figuras de caramelo?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "Una figura de caramelo, Hunajatta, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760380103,
					"content": "¡Srta. Néfer! ¿Cómo es que ha podido venir a comprar una figura de caramelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380104,
					"content": "Salir y darse un paseo de vez en cuando es bueno para la salud física y mental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760380105,
					"content": "Comer algo dulce también me ayuda a pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760380106,
					"content": "¡Claro! Un momento, te prepararé una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380107,
					"content": "Está bien. Por cierto, toma este dinero. La próxima vez que venga Jahoda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760380108,
					"content": "¿Quiere que le prepare una más grande o más dulce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380109,
					"content": "... Entrégale este dinero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 760380110,
					"content": "Y dile lo siguiente: “Néfer ha pagado el doble. Cuando termines de holgazanear, tráele a ella también una figura de caramelo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Néfer"
				}
			]
		},
