					"nextDialogs": [
						760380913
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760380913,
					"content": "¿Podrías hacer dos más? Me gustaría dárselas a probar a las kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760380914,
					"content": "¿Dárselas a las... kuuhenki? Claro que puedo hacerlo, pero no tengo suficientes ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380915,
					"content": "Entonces volveré mañana con las kuuhenki.",
