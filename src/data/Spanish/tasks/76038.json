				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(¿Quizá <color=#FFCC33FF>Lauma</color> esté interesada en las figuras de caramelo?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Srta. Hunajatta, ¿podría prepararme unas cuantas figuras de caramelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Por supuesto, Srta. Lauma. ¿Les gustaron a los niños las que llevó la última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Jeje, les encantaron. De hecho, algunos no quisieron comérselas hasta que se derritieron por ser demasiado hermosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Oh, ya veo... La próxima vez traeré mis herramientas e iré allá para preparárselas a los niños en el lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Eso sería increíble. Los niños se pondrán muy contentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Oh, me fui un poco por las ramas... Iré a preparar las figuras de caramelo en un rato. Cuando las termine, mandaré a alguien para que las lleve hasta allí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Pero antes... Jeje, me ha venido la inspiración...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Un momento, Srta. Lauma. Le prepararé una figura de caramelo especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
