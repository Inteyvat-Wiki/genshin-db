					"nextDialogs": [
						760380603
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380603,
					"content": "Claro. ¿Es para llevársela a la Srta. Aino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "No es eso. Aino me ha pedido que venga a comprarme una figura de caramelo bonita para mí misma.",
