			"dialogs": [
				{
					"id": 760381109,
					"content": "(¿Quizá <color=#FFCC33FF>Linnéa</color> esté interesada en las figuras de caramelo?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Hola, Srta. Linnéa. ¿Otra vez comprando figuras de caramelo para Lumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "¡Sí! Es que le encantan sus figuras de caramelo. Cada vez que le compro una, le da pena comérsela, así que solo la chupa unas cuantas veces y me pide que se la guarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 760381103,
					"content": "Pero, claro, como está hecha de caramelo, de tanto hacer eso al final se terminó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 760381104,
					"content": "Así que, por favor, Srta. Hunajatta, ¿podría hacer otra figura de caramelo para Lumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 760381105,
					"content": "¡Claro! Dame un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(¡Ay, Lumi es taaaan adorable que me muero de ganas por acariciarla! Pero si lo hago de repente... No, sería una falta de respeto...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Listo, aquí tiene, Srta. Linnéa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
					"content": "¡Gracias! Toma Lumi, aquí tienes tu figura de caramelo. ¿Quieres comerla ahora?... Vaya, se durmió. Bueno, se la daré en un rato.",
					"roleType": "TALK_ROLE_NPC",
