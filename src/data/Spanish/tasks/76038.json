					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Jeje, he venido a la ciudad para ayudar a arreglar algunas cosas. Por eso he decidido venir aquí a comprar caramelos.",
