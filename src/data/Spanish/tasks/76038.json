					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "Según dice, es parte de mi entrenamiento en actividades sociales, lo que hará que las compras futuras se vuelvan mucho más sencillas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "Ya veo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380607,
					"content": "Aunque no lo entiendo... La verdad es que no necesito ingerir tantos azúcares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380608,
					"content": "Al final, me da a mí que Aino acabará comiéndosela a escondidas.",
