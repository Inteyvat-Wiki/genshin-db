			"dialogs": [
				{
					"id": 760380409,
					"content": "(¿Quizá <color=#FFCC33FF>Flins</color> esté interesado en las figuras de caramelo?...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Srta. Hunajatta, ¿podría prepararme unas cuantas figuras de caramelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Claro. Usted es... ese soldado ratnik, el Sr. Flins, ¿cierto? Le he visto antes en la tienda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Así es. A veces vengo a adquirir ciertos suministros. Es un honor que pueda recordarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Hoy tan solo pasaba por aquí, pero he visto su increíble talento con las figuras de caramelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "Y, después de darle varias vueltas al asunto, he decidido pedirle que me prepare una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Ay, no hace falta que sea tan amable, o acabaré sonrojándome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Espere un momento, iré a preparar la figura de caramelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Oh... Una figura de caramelo para un soldado ratnik debería ser más especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
