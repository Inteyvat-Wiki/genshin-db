						760380703
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "Jahoda, no es la primera vez que vienes a comprar. Ya deberías saber que mis figuras de caramelo siempre tienen el mismo tamaño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "¡Vamos, que hoy he tenido un día muy bueno! Date prisa, hazme una un poco más grande de lo habitual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "¿Que has tenido un día muy bueno? ¿Es porque tu encargo de hoy te ha ido muy bien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Jejeje, claro, era un simple encargo de escolta. ¡Fue pan comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Tanto la mercancía como el cliente están perfectamente, sin un solo rasguño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Bueno, dejémonos de cháchara. Rápido, hazme una figura más grande de lo habitual y me la comeré por el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380709,
					"content": "Está bien, espera un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
