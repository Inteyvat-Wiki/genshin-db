			},
			"dialogs": [
				{
					"id": 761930130,
					"content": "(¿Eh? Eso no será... ¡E-es una melusina!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930101
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930101,
					"content": "¡Guaaau! ¡Es una melusina de verdad! Una melusina adorable, buena y chiquitita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930102
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930102,
					"content": "¿Eh...? Tú eres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930103
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930103,
					"content": "Esto... ¿Puedo tocarte? Siempre he tenido mucha curiosidad por saber qué se siente al tocar a una melusina tan adorable y lista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930104
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930104,
					"content": "¿Será suavecita, blandita o esponjosa...? Jejeje, no te asustes, solo quiero tocarte un poquito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930105
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930105,
					"content": "Eh... ¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930106
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930106,
					"content": "Por favor, mantenga la calma, señorita. Evitemos infringir el código legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930107,
					"content": "La Srta. Maime es ciudadana de la Corte de Fontaine. El contacto físico no autorizado podría dar lugar a malentendidos y acarrear graves consecuencias, incluyendo penas de prisión de tres años o más, así como la prohibición permanente de entrada a la nación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930108,
					"content": "¡Guaaau! ¡U-una máquina que se mueve y habla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930109
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930109,
					"content": "... *Ejem*. Perdón, perdón. Es que las melusinas son tan adorables que no pude evitarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930110
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930110,
					"content": "Me llamo Linnéa y soy asesora del Gremio de Aventureros. ¡Les aseguro que no soy ninguna rarita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930111
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930111,
					"content": "Negativo. Ninguna persona rara se autodenominaría “rarita”. Es lógica básica, estimada Srta. Linnéa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930112,
					"content": "¡Aaaah...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930113
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930113,
					"content": "No puedes ir por ahí hablando de lo rara que es la gente, Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930114
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930114,
					"content": "La señorita hada no es muy alta, pero tiene unos colores muy bonitos. No es igual que el pa{RUBY#[D]Elynas}dre, pero es cálida y muy linda, así que no es ninguna rarita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930115
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930115,
					"content": "Negativo. A excepción del púrpura, los colores no suelen estar relacionados con la opinión de alguien. Es lógica básica, Srta. Maime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930116,
					"content": "... No me refería al color de la ropa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930117
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930117,
					"content": "¿Eh? ¿Y por qué habría que descartar el púrpura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930118
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930118,
					"content": "En fin... Hola, Linnéa. Me llamo Maime, soy una pintora viajera de Fontaine. Él es Seymour, un buen amigo mío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930119
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930119,
					"content": "No esperaba encontrarme con nadie aquí. Linnéa, ¿tú también has venido en busca de inspiración?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930120
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930120,
					"content": "Inspiración... Humm, déjame pensar... Supongo que ampliar el archivo también cuenta como buscar inspiración, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930121
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930121,
					"content": "Le cuentas a Maime sobre la orca aletaescarcha rosa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761930122
					]
				},
				{
					"id": 761930122,
					"content": "Aunque... Jeje, ¡quizás Macey tenía razón y esa orca aletaescarcha sí que trae buena suerte! Incluso me ha permitido conocer a una adorable melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930123
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930123,
					"content": "Por favor, mantenga la calma, señorita. Evitemos infringir el código legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930124,
					"content": "¡Y-ya lo sé! ¡No voy a tocar nada sin permiso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930125
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930125,
					"content": "Ya veo. Linnéa, ¿te gustan mucho los animales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930126
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930126,
					"content": "¡Sí! *Solloza*... ¡Ojalá pudiera nadar tan rápido como las melusinas! Las orcas aletaescarcha se lo pasan tan bien... Me encantaría jugar con ellas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930127
					],
					"speakerTitle": "Linnéa"
				},
				{
					"id": 761930127,
					"content": "Humm... Entonces, te regalaré este cuadro, Linnéa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930128
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930128,
					"content": "Aunque no te hará nadar más rápido en el agua, si lo cuelgas en tu habitación, quizás te dé la sensación de “estar jugando con las orcas aletaescarcha”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930129
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761930129,
					"content": "¡Guau, gracias! ¡Qué dibujo tan bonito! Cuando vuelva, ¡se lo enseñaré a todos en el Speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnéa"
				}
			]
		}
	]
}