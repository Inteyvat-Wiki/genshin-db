			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Mi compañero y yo entrenamos artes marciales desde la infancia. Nuestra búsqueda era luchar contra las fuerzas del mal y proteger todo lo que es sagrado en este mundo. Pero no era una tarea fácil sin la ayuda de una Visión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710100102,
					"content": "Los dos nos refugiamos aquí para entrenarnos más y buscar las Visiones que deseábamos. Levantamos esta estela como testimonio de nuestros esfuerzos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Tesoro de las ruinas"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
							"3"
						],
						"stepId": 7101006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Pero ahora que mi compañero ha conseguido su Visión, en lugar de luchar contra los monstruos, me preguntó: “¿Son los monstruos verdaderamente malos por naturaleza?”. Así que le respondí: “Causan estragos en todo el mundo, y los inocentes son los que sufren las consecuencias. ¿No te parece razón suficiente para luchar contra ellos?”. ¡Creo que de tanto meditar se ha quedado tonto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710100202,
					"content": "Bueno, yo sigo pensando enfrentarme a esos monstruos, aunque eso signifique hacerlo sin él o incluso sin una Visión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Tesoro de las ruinas"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
