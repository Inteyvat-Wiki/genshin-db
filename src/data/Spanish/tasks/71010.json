			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "Los monstruos son el mayor flagelo de este mundo. Aquellos que seamos hábiles con la espada tenemos el deber de darles caza hasta que desaparezcan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Tesoro de las ruinas"
				},
				{
					"id": 710100302,
					"content": "¡Los monstruos son malvados! ¡No merecen nada más que una masacre sin piedad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100303
					],
					"speakerTitle": "Tesoro de las ruinas"
				}
			]
