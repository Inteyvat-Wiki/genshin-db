			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "¡Oye! Estoy aquí, ¿sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "¿Qué les pasa a los jóvenes de hoy? ¡Ya no hay respeto, ya no hay valores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "¡L-lo siento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "¡Hum! Mucho mejor. Me alegro que reconozcas tus errores. Considéralos un obsequio de mi parte, ¡pero no se te ocurra ponerles un dedo encima al resto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "¿Estos hongos son tuyos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "¡Eso no es asunto tuyo! ¡Apártate! No puedes andar recogiéndolos por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
