				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "¡Oh! Pero qué formas tan extrañas... ¿También tienen “espíritu”? ¿Son la condensación de los recuerdos de la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060502,
					"content": "Y la textura tan suave de este... Parecen alas. ¿Pueden volar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060503,
					"content": "*Suspira*... Me muero de curiosidad, pero el barquero se enfadará conmigo... Es una pena, tengo que irme. Tengo que subir al bote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		}
	]
