					"id": 722060401,
					"content": "#¿Y bien? ¿Estás list{F#a}{M#o} para sorprenderme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060402
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060402,
					"content": "¿Buscabas estos hongos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7220605,
