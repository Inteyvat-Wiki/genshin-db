				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "¡Guau! ¿Viste a ese tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060202,
					"content": "Lo que se dice verlo, no lo he visto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "¡Qué miedo! ¡Recojamos algunos hongos y dejemos este lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060203,
					"content": "Debe ser una ilusión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220604",
							"3"
						],
						"stepId": 7220604,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220605",
							"2"
						],
						"stepId": 7220605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "#¡Oigan! ¿No se lo advertí? ¿Acaso son sord{F#as}{M#os}, o están mal de la vista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "¡Ay, un fantasma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "¡Ah! ¿Dónde? ¡¿Dónde está el fantasma?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "Justo aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "¡Ah! ¡Largo! ¡Fuera de aquí, espíritu malévolo! ¡Yo, Abe, te lo ordeno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "¡No puede ser! ¡En todos mis años de vida, nunca había visto un espíritu tan malévolo! ¿Por qué no te has ido aún?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "Vengo de más allá de la isla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "Conque un espíritu de más allá de la niebla... ¡Hum! ¡Pues no te tengo miedo! Quédate donde estás, ¡y ya verás cómo la gran Ave del Trueno te exorciza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "El Ave del Trueno ya no volverá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "¿Qué dijiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "Todos se han ido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "¿Pero...? ¡Qué tontería! Qué cosas tan espeluznantes dices, haces que se me erice la piel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "Aunque es verdad que hay cada vez menos personas en la isla... Kina mencionó que todos se subieron a un barco... *Suspira*, ¿en dónde se habrá metido esa niña?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "Hablando de eso, malvado espíritu forastero, ¿tú no vas con ellos en la barca plateada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "No lo he visto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "¡Hum! Lo sabía, los forasteros no pueden ver ese barco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "Gracias por la invitación, malvado espíritu forastero. He vivido aquí tantos años, pero aún me falta tanto por vivir. Es difícil dejar este lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "¿Qué necesitas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "¿Que qué necesito? ¡Jaja! No es algo que necesite... solo quiero ver algo novedoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "Cuando era muy, muy pequeño, hice una apuesta con Una... Le dije que más allá de la isla había diferentes tipos de hongos, pero ella no me creyó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "Y entonces... su esposo zarpó al mundo exterior, pero no pudo regresar... Su alma ahora vaga en tierras lejanas. Es una pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "Desde entonces, Una pasa los días a solas. De solo pensarlo, yo... *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "No te preocupes por ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "Incluso le pedí al sacerdote que lo trajera de vuelta, fuera como fuese... ¿Eh? ¡Oh, cierto! ¡Los hongos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "*Ejem*, subiré pronto al bote y no tengo ningún arrepentimiento... Es solo que no he visto lo que hay más allá de la isla. Sin embargo, lo que más me preocupa son los hongos que cuido todos los días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "¿Podrías traerme unos hongos de más allá de la niebla? ¡Me gustaría verlos con mis propios ojos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "¡Te lo pido, malvado espíritu forastero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "En cuanto a los hongos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "Ese barco no es para mí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "Es hora de despedirse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "La niebla desapareció.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "#Yo soy {F#la}{M#el} fantasma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
