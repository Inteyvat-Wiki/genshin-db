				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450621,
					"content": "Lo siento, ha habido muchos problemas con la investigación, muchas de las inferencias que recopilé simplemente no concuerdan con los datos de los experimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450622,
					"content": "Por otro lado, algunas de las conclusiones a las que Albedo llegó por su propia intuición han sido corroboradas por los hechos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450623,
					"content": "Me alegro de que hayamos visto un poco de progreso, así que... ¡No hay razón para estar desalentado! ¡Albedo dijo que hice un buen trabajo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450624,
					"content": "Si deseas saber los resultados con detalle, será mejor que hables con él. Tengo trabajo que hacer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}