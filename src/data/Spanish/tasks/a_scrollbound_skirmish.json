			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piñoncita",
					"Muñeco de madera ígneo",
					"Vigée"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "En mi opinión, puede que la guerrera enmascarada no sea capaz de surcar los cielos como la mediadora... pero si aprovecha la oportunidad y esprinta con decisión, ¡tendrá la victoria en la palma de la mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "Piñoncita"
				},
				{
					"id": 755100102,
					"content": "¡No digas tonterías! ¡No puedes depender únicamente de la velocidad de movimiento en línea recta! ¡Si no puede girar ni golpear, no servirá de nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "Muñeco de madera ígneo"
				},
				{
					"id": 755100103,
					"content": "Está bien, niños. Pueden hablarlo con calma, no hay necesidad de discutir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100104,
					"content": "Es que, es que... ¡Nos emocionamos cuando hablamos de guerreros formidables!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "Muñeco de madera ígneo"
				},
				{
					"id": 755100105,
					"content": "¡No se preocupe, Srta. Vigée! Aunque compitamos por ver quién tiene razón, ¡lo hacemos de forma razonable y aportando pruebas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "Piñoncita"
				},
				{
					"id": 755100106,
					"content": "... ¡Oh! Se me ha ocurrido una nueva estrategia. ¡Juguemos otra partida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "Muñeco de madera ígneo"
				},
				{
					"id": 755100107,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "Piñoncita"
				},
				{
					"id": 755100108,
					"content": "Qué animado está esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "#¡{F#Una nueva clienta}{M#Un nuevo cliente}! ¡Hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100111,
					"content": "#A juzgar por tu vestimenta, debes ser {F#una viajera}{M#un viajero}, ¿verdad? ¡Pues ya es algo que tenemos en común!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100112,
					"content": "¿Quieres probar con los niños el pergamino interactivo que he creado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100113,
					"content": "¿“Pergamino interactivo”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "En pocas palabras, se trata de un juego que combina el teatro de recortes de papel de Liyue, los cómics de Inazuma y la tecnología de las kinografías de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100116,
					"content": "Está basado en los famosos héroes locales, pero le he añadido la idea de “desafíos transfronterizos” para combinar ambas cosas y crear una historia novedosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100117,
					"content": "¿Quién sabe? Tal vez te guste la novedad de esta experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100118,
					"content": "¡Lo probaré con gusto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "¡Genial! ¡Que lo disfrutes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vigée"
				},
				{
					"id": 755100114,
					"content": "¿Un pergamino que se mueve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100109,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				}
			]
		},
