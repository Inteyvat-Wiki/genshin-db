	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "¡Hoy no es mi día! ¡Así no podré volver a sumergirme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200102,
					"content": "¿Qué te pasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Ah, eres tú. Menos mal. *Suspira*, poco más y tenemos una desgracia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200105,
					"content": "Estaba trabajando bajo al agua como siempre, evitando algas y esquivando basura sin lastimarme ni rozarme con nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200106,
					"content": "Y de pronto, ¡ha aparecido uno de esos monstruos que salen del barro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200107,
					"content": "Ya no me acuerdo ni de qué aspecto tenía, pero venía directo a por mí. Así que no me ha quedado más remedio que poner pies en polvorosa y volver a la superficie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200108,
					"content": "No había buceado ni un palmo cuando me he estampado contra uno de esos bichos con forma de pez. Y claro, los demás me han divisado y han empezado a perseguirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200109,
					"content": "No sé ni cómo me las he arreglado para salir a la superficie. Yo estoy bien, pero no puedo decir lo mismo de mi traje de buceo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200110,
					"content": "Es demasiado peligroso, no deberías sumergirte aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "Imposible, Goldman dijo que este era el punto exacto... Muchos han resultado heridos aquí, algunos incluso perdieron la vida en estas aguas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200113,
					"content": "Pasado un tiempo, Goldman nos amenazó con reducirnos el salario, pero aun así la gente se negó a venir a este punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200114,
					"content": "Así que, al final, Goldman cambió de estrategia y empezó a ofrecer el triple a los que se aventuraran en estas aguas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200115,
					"content": "Así que yo y otros chicos que necesitaban los Moras nos ofrecimos voluntarios. Incluso nos aprovisionamos de arpones para defendernos bajo el agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200116,
					"content": "Pero no pasaron ni unos días y los arpones se rompieron o se perdieron... Los demás volvieron a la ciudad a comprar más y yo me quedé aquí guardando el fuerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200117,
					"content": "¿Y por qué te has sumergido entonces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "Bueno, es que ya hace mucho que se fueron y todavía no han vuelto. Si seguimos así, tendremos que quedarnos toda la noche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200120,
					"content": "Yo te puedo ayu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "¡No! Ni hablar, te lo digo en serio, en estas aguas habitan monstruos. Ni siquiera los aventureros podrían lidiar con esas cosas. No quiero poner tu vida en peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200122,
					"content": "Yo no soy como el resto de los aventureros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Bueno, ya, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200125,
					"content": "Está bien, si insistes... Deja que te marque el punto exacto. Pero prométeme que tendrás mucho cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200123,
					"content": "#¿Tengo pinta de ser {F#una aventurera}{M#un aventurero} del montón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "¿Cómo se te ocurre sumergirte sin armas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "Es demasiado peligroso, deberías cambiar de lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "¿Tienes algún problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
