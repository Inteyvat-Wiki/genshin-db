					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402003,
			"completionStepIds": [
				2402005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402005",
							"2"
						],
						"stepId": 2402005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200301,
					"content": "Así es, esto es todo lo que hemos podido recoger hoy, no es más que basura. A saber qué hace ese tacaño con esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200302
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200302,
					"content": "Gracias por tu ayuda. Le pedí a Goldman que me adelantara el pago, así que aquí tienes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200303
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200303,
					"content": "No puedo aceptarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200304
					]
				},
				{
					"id": 240200304,
					"content": "¡Más te vale aceptarlo! ¡Es la recompensa por tu esfuerzo! Estos Moras no me corresponden. Si no los aceptas, dejaré que se hundan en el agua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200305
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200305,
					"content": "Está bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200306
					]
				},
				{
					"id": 240200306,
					"content": "Así me gusta. Eso sí, si alguna vez tienes que recuperar algo que se te haya caído al agua, ¡ven a verme! ¡Aceptaré cualquier encargo, no importa dónde sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200307
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200307,
					"content": "Necesito descansar un rato más... Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402004,
			"completionStepIds": [
				2402006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402006",
							"2"
						],
						"stepId": 2402006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200401,
					"content": "¿Qué? ¡Pero si son joyas! ¿Será esto lo que Goldman quiere que recojamos? Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200402,
					"content": "Gracias por tu ayuda. Acepta esto como pago, y, por favor, no lo cuentes por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200403,
					"content": "Si las vendiera, ¡podría comprarme un traje de buceo en condiciones y ya no tendría que pagarle a Goldman por el alquiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200404,
						240200405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200404,
					"content": "No puedo aceptarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				},
				{
					"id": 240200406,
					"content": "¡No, no! Te mereces una recompensa por tu trabajo. Puede que no sea suficiente, pero es lo poco que me queda. Lo estaba ahorrando para invitarme a mí mismo a una copa esta noche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200407,
					"content": "¡Acéptalo! Voy a recoger ahora mismo e iré a ver si puedo vender estas joyas a escondidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200405,
					"content": "Mis labios están sellados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				}
			]
		},
		{
			"id": 2402005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402002",
							"2"
						],
						"stepId": 2402002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402003",
							"2"
						],
						"stepId": 2402003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200501,
					"content": "¡Aprovechado! ¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200502,
						240200508,
						240200512
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200502,
					"content": "¿Estás hablando de Goldman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200503
					]
				},
				{
					"id": 240200503,
					"content": "Goldman es mi jefe. Contrató a un grupo de torpes como yo que necesitan trabajar para poder comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200504
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200504,
					"content": "¡Este tipo solo piensa en una cosa, en la fonta! ¡Y es estricto y tacaño! Encima nos obliga a aceptar un sinfín de normas de trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200514
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200514,
					"content": "Incluso nos alquila los trajes de buceo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200505
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200505,
					"content": "Si infringimos alguna de sus doscientas mil reglas o estropeamos el traje de buceo, tenemos que pagar también una compensación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200515
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200515,
					"content": "Así que si le haces un desperfecto por descuido, tienes que compensar al muy rata. ¡A este paso voy a tener que pagarle yo para que me deje trabajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200506
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200506,
					"content": "¿Por qué quieres saber más de él? ¿Es que quieres ir a verle o algo? Te lo pido, por tu reputación, lo mejor será que te mantengas alejado de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200516
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200516,
					"content": "¡Es un sinvergüenza! Y encima siempre va acompañado de esa gentuza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200507
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200507,
					"content": "Es más, es mejor que evites cualquier contacto con él. Sacar todo el barro de un pozo y volver a llenarlo de agua limpia no es tarea fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200517
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200517,
					"content": "Basta un puñado de barro para enturbiar hasta las aguas más cristalinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200508,
					"content": "Tu trabajo es muy duro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200509
					]
				},
				{
					"id": 240200509,
					"content": "Ja, pues ahí no te equivocas, pero es la única forma de ganarme la vida que tengo. Yo no soy una lumbrera precisamente, pero tampoco quiero ir por el mal camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200518
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200518,
					"content": "Pero si tengo que hacer algo malo para llevarme un trozo de pan a la boca, ¡prefiero morirme de hambre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200510
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200510,
					"content": "Puede que este trabajo sea duro, pero al menos puedo dormir con la conciencia tranquila y no temo porque nadie quiera vengarse de mí o dejarme ciego con un cuchillo en mitad de la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200511
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200511,
					"content": "Así que al menos en eso estoy mejor que Goldman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200512,
					"content": "Nos vemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200513
					]
				},
				{
					"id": 240200513,
					"content": "#Bien, cuento contigo, amig{F#a}{M#o}. Yo necesito recuperar el aliento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402006,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401701",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200601,
					"content": "Arg, qué mala pata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200602
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200602,
					"content": "¿Ya has vendido lo que encontramos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200603
					]
				},
				{
					"id": 240200603,
					"content": "Ah, hola. Ni me lo menciones. Me las arreglé para encontrar a un vendedor en secreto, ¡pero Goldman irrumpió en mi casa y se llevó todas las joyas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200604,
					"content": "Si no fuera porque mi trabajo depende de él, ya le habría dado una buena paliza... Encima me quitó dos meses del salario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200616,
					"content": "Tendrás que esperar a que termine todos los encargos del año para que te pueda pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200605,
					"content": "*Suspira*, da igual, la suerte nunca estaría del lado de los tontos como yo... No habrá ido a buscarte, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200606,
						240200609
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200606,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200607
					]
				},
				{
					"id": 240200607,
					"content": "Mejor. No me importa si me da una paliza a mí, pero no dejaré que se acerque a ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200608
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200608,
					"content": "Yo no le dije que me habías ayudado, pero tengo la sensación de que alguien más se lo ha dicho a ese maldito tacaño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200611,
					"content": "Aunque necesito que me ayudes otra vez hoy. Todavía no he terminado de remendar el traje, pero Goldman no deja de meterme prisa para que vuelva al trabajo y recupere todo lo que no he hecho estos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200612,
					"content": "Podría pedirle prestado su traje a algún compañero y buscar las cosas a toda prisa, pero no creo que me diera tiempo. Por eso quería que me ayudaras de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200613,
						240200614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200613,
					"content": "¡No hay problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200615,
					"content": "Gracias, de verdad. Te marco la ubicación de lo que necesito. Nos repartiremos el trabajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200614,
					"content": "¡Lo que necesites!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200609,
					"content": "Si se acerca, le enseñaré la lección.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200610
					]
				},
				{
					"id": 240200610,
					"content": "Es mejor que no te acerques a ese gordinflón. ¡Es un caradura y un tipo despreciable! Una persona digna de admiración como tú no debería llegar a conocer a semejante especimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				}
			]
		}
	]
}