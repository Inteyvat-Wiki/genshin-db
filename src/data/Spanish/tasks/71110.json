				"objectNames": [
					"Mali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "#Hola, querid{F#as}{M#os} amig{F#as}{M#os}. ¿También han venido por el concurso daguerrográfico de paisajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "Como daguerrógrafo de Fontaine, la cuna del Daguerrotipo, déjenme darles un consejo: la esencia de una imagen reside en el Daguerrotipo en sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "Por eso, quisiera hablarles de alguien de mi ciudad que fabrica unos Daguerrotipos muy populares entre la gente. Su precio es razonable y tengo buenos contactos para conseguir uno, por solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "... No me miren así. ¡Les puedo hacer un descuento adicional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Eh... ¡No se vayan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
