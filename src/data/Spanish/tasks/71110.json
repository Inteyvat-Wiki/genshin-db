			"dialogs": [
				{
					"id": 711100301,
					"content": "#Joven amig{F#a}{M#o}, hola. Seguro que has viajado por muchos lugares y admirado paisajes maravillosos, ¿no es así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100302
					],
					"speakerTitle": "Zhuchun"
				},
				{
					"id": 711100302,
					"content": "Me pregunto si los paisajes del Valle Chenyu de este concurso serán capaces de superarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhuchun"
				}
			]
		},
