			"dialogs": [
				{
					"id": 711101101,
					"content": "Hola, amiguita. ¿Este pequeño pelícano es tuyo? ¿Podemos tomar una imagen de él con la Aldea Chiaoying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "¡Pi, piii! ¡Cuaa, cuaa, cuaaa, piiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101103,
					"content": "¿Eh? ¿Qué estás diciendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "Es idioma pelícano. Quiere decir “¡muy bien, muy bien!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "¿Puedes hablar en pelícano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Bueno, solo un poco... Me di cuenta de que cuando comen, dicen: “¡Pi, piii! ¡Cuaa, cuaa, cuaaa, piiii!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "¡Debe de ser algo como “muy bien”!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Así que aprendí a usar esa expresión para llamarlos. Cuando me escuchan gritarlo vienen de inmediato hacia mí, probablemente porque creen que tengo algo para darles de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "Si quieren tomar imágenes de ellos, pueden intentar llamarlos así. Es una pena que tenga que irme a casa ahora, ¡si no, podría enseñarles más cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "#No te preocupes, amiguita, lo intentaremos nosotr{F#as}{M#os} mism{F#as}{M#os}. Gracias, ¡y ve con cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#¡{NICKNAME}, vamos a intentarlo! Si conseguimos atraer a un pelícano, seguro que aumentarán nuestras probabilidades de ganar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
