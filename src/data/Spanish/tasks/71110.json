			"dialogs": [
				{
					"id": 711100801,
					"content": "Vaya... Estas imágenes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "¿Qué pasa? ¿Acaso no son lo suficientemente buenas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "No, todo lo contrario... Estos últimos días he visto trabajos excelentes, pero el de ustedes dos es realmente un soplo de aire fresco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Por ejemplo, en esta imagen de la Aldea Chiaoying, los pelícanos le dan un toque de vida a la tranquila aldea, contrastando la quietud con el movimiento... Realmente un trabajo muy original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "Si mi intuición no me falla, ambas obras serán seleccionadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "¡Guau! ¡Qué buen cumplido! Haces que Paimon se sonroje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Ni que las hubieses tomado tú, ¿por qué te sonrojas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "#Paimon se estaba sonrojando por ti, porque sabe lo modest{F#a}{M#o} que eres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Bien, volviendo al tema, los resultados de la selección estarán listos mañana por la mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "Las obras seleccionadas serán exhibidas públicamente mañana desde las 8 de la mañana hasta las 6 de la tarde, en la calle principal, afuera del puesto de logística.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "Muchas gracias por participar en el concurso daguerrográfico de paisajes “Periplos en Chenyu”. No se olviden de volver mañana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "¡Claro! ¡No queremos perdernos la sorpresa final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "Yo también voy a sonrojarme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
