			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "¡Esperen! ¡No se acerquen! Son... ¿Son ustedes de los buenos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101302,
					"content": "Oye, pero si acabamos de salvarte. ¿Es que te diste un golpe en la cabeza o algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "#¡Ah! Tienes razón... Disculpa, es que he tenido tan mala suerte en esto de “Periplos en Chenyu” que hasta siento mareos... Gracias, amig{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101304,
					"content": "¿También has venido por el concurso daguerrográfico de paisajes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "¿Ustedes también? Pues vaya coincidencia. Pero no soy más que un turista cualquiera... No pude hacer nada contra esos Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101306,
					"content": "Es terrible. Me encontré con ellos por el camino, me capturaron y me trajeron hasta aquí sin mediar palabra... ¿Es que los Hilichurls cobran algún tipo de peaje o qué? Qué absurdo... Por suerte, me encontré con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101307,
					"content": "Oh... Sí que parece que estás teniendo muy mala suerte hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "¡Ay, no solo hoy! Ayer también tuve un día horrible. Le compré un Daguerrotipo bastante caro a un comerciante de Fontaine, pero se rompió tras usarlo un par de veces. Cuando volví a buscar al comerciante... ¡había desaparecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101309,
					"content": "Qué tipo tan deshonesto... Tengan cuidado con sus carteras cuando estén por ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101310,
					"content": "Bueno, basta de charla. Si ustedes también están participando en el concurso, seguramente vinieron a tomar imágenes del Monte Xuanlian, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101311,
					"content": "En ese caso, y como muestra de mi agradecimiento, voy a marcarles en el mapa el mejor punto de captura que he encontrado en este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101312
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101312,
					"content": "Miren, lo pueden ver desde aquí. ¡Ese de ahí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101313
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101313,
					"content": "¿Eh? ¿Y tú? ¿No vas a participar también?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101314,
					"content": "Creo que esta zona es peligrosa, será mejor que vaya a otro lugar. Recuerdo que se mencionaban más en la guía... Creo que iré a ver el sitio llamado “Cata de té Adeptus”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101315
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101315,
					"content": "¡Ya está decidido! ¡Que les vaya bien! Espero que con este encuentro mi suerte empiece a cambiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akai"
				}
			]
