			"dialogs": [
				{
					"id": 711100701,
					"content": "#A juzgar por lo relajad{F#a}{M#o} que pareces, supongo que has venido a entregar tus imágenes para el concurso. Déjame verlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100702
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100702,
					"content": "Humm, no están mal. Seguro que has tenido que esperar mucho para poder capturar estas imágenes. Buen trabajo.",
					"roleType": "TALK_ROLE_NPC",
