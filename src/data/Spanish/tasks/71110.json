			"dialogs": [
				{
					"id": 711101001,
					"content": "Vaya, pero si son ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101002,
					"content": "¿Ya vieron las imágenes en exhibición? Ocho obras fueron las seleccionadas en este concurso daguerrográfico de paisajes “Periplos en Chenyu”. ¡Y la mitad son de ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101003,
					"content": "¡Felicidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101004,
					"content": "¡Guau! ¡Genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#¡{NICKNAME}! ¡Paimon te lo dijo! ¿Te acuerdas de lo de la probabilidad de 4 entre 4? ¡Paimon es muy buena con las matemáticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "Pero en realidad es de 4 entre 8, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Los jueces valoraron positivamente sus otras dos obras, con argumentos similares a los que les di yo ayer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101009,
					"content": "Por eso, acepten esta edición limitada del álbum “Periplos en Chenyu” que contiene todas las imágenes seleccionadas de esta edición. Se lo merecen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101010,
					"content": "¿Esta era la sorpresa especial? ¡Qué bieeen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Y acepten también estos Moras como recompensa, por favor. Quiero agradecerles de nuevo su apoyo, esta vez de una forma más personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101012,
					"content": "Este es mi hogar y ustedes han conseguido inmortalizar para siempre sus paisajes más hermosos y conmovedores. Estas obras harán que más y más gente se enamore de este lugar, ¿no creen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101013,
					"content": "#Muchas gracias a amb{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101007,
					"content": "¡Guau, Paimon! ¡Qué bien se te dan las matemáticas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
		},
