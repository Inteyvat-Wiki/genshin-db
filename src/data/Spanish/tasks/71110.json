			"dialogs": [
				{
					"id": 711100101,
					"content": "¿Han venido a participar en el concurso daguerrográfico de paisajes “Periplos en Chenyu”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100102,
					"content": "¿Concurso daguerrográfico de paisajes? ¿Qué es eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "Como dice su nombre, se trata de un concurso daguerrográfico para promover los bellos paisajes del Valle Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100104,
					"content": "Hace un tiempo le pedimos a los residentes responder un cuestionario para reunir sus opiniones sobre los lugares más cautivadores del Valle Chenyu. Ahora, le hemos dado la tarea a los concursantes de ir y tomar imágenes de dichos lugares utilizando sus Daguerrotipos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100105,
					"content": "#Seleccionaremos las mejores imágenes para usarlas como material promocional. Estas imágenes serán exhibidas al público en la calle de fuera del puesto de logística. Y bien, ¿están interesad{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100106,
					"content": "Vamos al grano, ¿cuál es la recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "En el caso de que tu obra sea seleccionada, habrá una sorpresa especial para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100110,
					"content": "¡Guau! ¡Una sorpresa! ¡Tendremos que darlo todo para conseguirla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "Bueno, aunque no consigan ganar, hemos preparado un pequeño premio de consuelo por su tiempo y esfuerzo. Espero que sea de su agrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100112,
					"content": "¿Cómo empezamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Echen un vistazo a esta guía. Estos son los lugares más cautivadores del Valle Chenyu, recomendados por los residentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100115,
					"content": "¿Eh? ¿Por qué hay algunos que han sido tachados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Ah, eso es porque ya hay muchos participantes registrados para esos lugares. Nuestro objetivo es mostrar una imagen más amplia de la belleza del Valle Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100117,
					"content": "Los cuatro lugares de más abajo aún tienen cupos disponibles. Pueden elegir uno o varios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100118,
					"content": "#Paimon ya entiende... {NICKNAME}, ¿por qué no nos registramos para todos los lugares que quedan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Si la probabilidad de ganar es de 1 entre 4, ¡entonces tomemos cuatro imágenes! ¡Así tendremos garantizada la sorpresa especial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "No funciona así, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "¿Cómo que no? Si la probabilidad es de 1 entre 4 y lo multiplicamos por 4, ¿no sería de 4 entre 4?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Sí, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Jeje. Bueno, basta de hablar. ¡En marcha! ¡Tenemos que obtener esa sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Lo has calculado bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "Muy bien. No hay nadie mejor que yo tomando imágenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "#Vaya, se te ve llen{F#a}{M#o} de energía. Déjame agregar que, en el caso de que tu obra sea seleccionada, habrá una sorpresa especial para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				}
			]
		},
