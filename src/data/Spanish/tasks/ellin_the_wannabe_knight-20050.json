					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200500101,
					"content": "Ay, ¡qué dolor de cabeza! ¿Qué se supone que debo hacer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500102,
					"content": "¿Qué haces?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "¡Estoy entrenando para las pruebas de los Caballeros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500104,
					"content": "*Suspira*, pero no soy tan poderosa como Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500105,
					"content": "Creo que es mejor para mí centrarme en la técnica en lugar de la fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500106,
					"content": "Por ejemplo, estaba pensando en cómo romper todos estos maniquíes de madera de un solo golpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500107,
					"content": "Si tienes tiempo libre, ¿me ayudarías a pensar cómo hacerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500108,
					"content": "Lo pensaré.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Claro, tómate tu tiempo. Después de todo, estos maniquíes no irán a ningún lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500111,
					"content": "Tampoco mi vida va a ninguna parte mientras esté atrapada tratando de resolver esto. *Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500114,
					"content": "He oído que los elementos interactúan de maneras especiales. Me pregunto si hay una manera de usar el fuego en este brasero para causar una pequeña explosión...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500115,
					"content": "Pero primero debe haber fuego en el brasero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500109,
					"content": "#¿Qué tal si lo intentamos junt{F#as}{M#os}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "¿Así que te gusta el combate en equipo? Es bueno tener siempre a alguien que te apoye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500113,
					"content": "Para personas como yo, lo mejor que pueden hacer es intentar subsistir como luchadores solitarios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2005002,
			"completionStepIds": [],
