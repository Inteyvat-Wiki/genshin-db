				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718000301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 718000302,
					"content": "Mi ropa está empapada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "#Lo siento mucho, jovencit{F#as}{M#os}, ¡qué distraída de mi parte! Pensé que solo había un poco de agua adentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 718000304,
					"content": "Al menos esta tetera está más o menos limpia ahora. Hay algunos rincones y grietas pendientes, pero todo a su debido tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 718000307,
					"content": "Abuela, ¿vertiste todo el Río Bishui allí dentro o algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718000308,
					"content": "Tontita, no soñaría con hacer algo así, ¿de dónde sacaría el agua la pobre gente de la ciudad si hiciera eso? No, tuve cuidado de usar solo la mitad del agua del río.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 718000309,
					"content": "Perdón por este inconveniente. Acepta esto como agradecimiento por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 718000310,
					"content": "Ah, y no debo olvidar devolver el agua de la tetera al río en algún momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 718000305,
					"content": "Con eso debe ser suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "Bueno, en su mayoría. Todavía hay algunos rincones y grietas, pero uno debe entrar para hacerse cargo de ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madam Ping"
				}
			]
		},
