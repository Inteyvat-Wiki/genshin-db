	"talks": [
		{
			"id": 7332701,
			"completionStepIds": [
				7332701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7332701",
							"2"
						],
						"stepId": 7332701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#¡¿{NICKNAME}?! ¿Eres tú? ¡Eres tú de verdad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270102,
					"content": "¡Y Paimon! ¡No me esperaba encontrarme con ustedes aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270103,
					"content": "¡Yeht! ¡Eres tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270104,
					"content": "¡Jaja! ¡No grites tanto, que me vas a espantar los peces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270105,
					"content": "¡*Crin-crin*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270106,
					"content": "Oh... ¿Están pescando? ¿Pero cómo es que Paimon no ve ninguna caña de pescar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270107,
					"content": "*Crin*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270108,
					"content": "#¡Benben, cierra el pico! Eh... {NICKNAME}, hablemos de otra cosa, ¿de acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270109,
					"content": "Nop. ¿Dónde está tu caña de pescar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "¡Oye...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270111,
					"content": "... Se rompió sola... Jeje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270112,
					"content": "Ay... No me esperaba que pescar fuese tan distinto de cazar. ¡¿Por qué es tan difícil?! ¡No tengo paciencia para tirarme medio día sentada esperando a que vengan los peces!... Así que me dije: “¿Por qué no me meto en el río y los capturo yo misma?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270113,
					"content": "Y no has agarrado ni uno, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270114,
					"content": "¡Hum! Por supuesto que sí, y uno muy grande, ¡más grande que tú...! ¡Medio Benben más grande que tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270115,
					"content": "¡*Crin-crin*! ¡*Crin-crin*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270116,
					"content": "Lo asé y me lo he comido entero, ¡no ha quedado nada para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270117,
					"content": "¿*Crin-crin*?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270118,
					"content": "Oh, Benben también comió su parte, ¡la que no tienes tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270119,
					"content": "¡Paimon no se lo cree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270120,
					"content": "¡Jajaja! ¡Si no te lo crees, peor para ti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270125,
					"content": "¿Qué tal te ha ido últimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "¿Eh? Estupendamente, no tienes que preocuparte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270127,
					"content": "De todos modos, tampoco es la primera vez que viajo sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270128,
					"content": "¡*Crin-crin*! ¡*Crin-crin*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270129,
					"content": "¡Jajaja, no te alteres! ¡Ya sé que tú estás conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270130,
					"content": "Desde que pasó eso con los Tanit, ninguna tribu del desierto me ofrece comida ni refugio... No tengo la protección de una tribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270131,
					"content": "Después, Ruj Shah, del Regimiento de Los Treinta estuvo dispuesto a admitirme, pero... la ciudad me agobia, y me recuerda a mi madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270132,
					"content": "Así que me despedí de la Ciudad de Sumeru y pensé que... sería mejor visitar otra nación, ver otros paisajes que no conozco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270133,
					"content": "Así que me subí en un barco mercante, y acabé aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270134,
					"content": "Y luego... ¡Nada interesante que contar, jeje! ¡No importa el lugar, siempre se necesitan guardaespaldas, especialmente en estas grandes ciudades donde van y vienen caravanas todos los días! Así que no me puedo quejar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270135,
					"content": "Jeje, así son las cosas... Una vida sin ataduras con el mundo entero por hogar no está mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270136,
					"content": "Benben y yo somo como tú y Paimon, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270137,
					"content": "¡Eh, no compares a Paimon con Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270138,
					"content": "¡*Crin-crin*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270139,
					"content": "#¡Jajaja! Está bien... {NICKNAME}, no l{F#as}{M#os} retengo más. Me hubiera encantado invitarles a una buena comilona, pero las normas de los escoltas a sueldo no lo permiten... *Suspira*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270140,
					"content": "¡*Ejem*! ¡No hablemos de cosas tristes! ¡Dejen que les dé un gran abrazo y le desee lo mejor en sus viajes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270141,
					"content": "#{F#... No te olvides de lo que te dije antes cuando estábamos en la tribu Tanit. Si alguna vez te sientes cansada y quieres tomarte un respiro... puede que volvamos a encontrarnos.}{M#¡No te olvides de que nuestros caminos se volverán a cruzar algún día!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270121,
					"content": "No me esperaba encontrarme contigo aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Eh... Yo tampoco me esperaba encontrarme aquí con ustedes. Ha sido una agradable sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Yeht"
				},
				{
					"id": 733270123,
					"content": "Jeje... No te hemos interrumpido mientras... agarrabas peces, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270124,
					"content": "¡Cierra el pico, renacuaja! ¡Hablas más de la cuenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Yeht"
				}
			]
		},
