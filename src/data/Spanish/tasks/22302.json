			"dialogs": [
				{
					"id": 223020101,
					"content": "Esta vez lo lograré...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020102,
					"content": "¿Lograr qué cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "¿Has oído hablar de los concursos de novelas de Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020104,
					"content": "Creo que se llaman... “¡Esta novela es genial!”, y los organiza la famosa Editorial Yae, de Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020105,
					"content": "Me he preparado por mucho tiempo para esta competencia, incluso leí muchas novelas populares en Inazuma como referencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020106,
					"content": "Además de mi colección de libros que he leído entera... ¡Combinando las culturas de Liyue e Inazuma en mi novela, seguro que ganaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020107,
					"content": "Pedí una cita con el Gremio de Comerciantes de Feiyun. Me ayudaron a enviar mi novela a la competición, pero las personas que iban a llevar el libro nunca vinieron por él...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020108,
					"content": "Si tienes tiempo, ¿podrías llevar este escrito al <color=#00E1FFFF>Gremio de Comerciantes de Feiyun</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020109,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "Te lo encargo. ¡Esta vez estoy seguro de que ganaré!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020111,
					"content": "¿Cuál es el título de la novela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "Eso no lo puedo revelar, es mi obra para la competición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020113,
					"content": "Si logro ganar con esto, todo irá bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang el Noveno"
				}
			]
		},
