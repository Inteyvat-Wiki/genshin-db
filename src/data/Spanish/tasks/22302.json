			"dialogs": [
				{
					"id": 223020301,
					"content": "¿Joven amo, a dónde fue...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Quisiera saber más sobre el libro de Chang el Noveno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "¿Eh? ¿Chang está escribiendo un libro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Cierto, la última vez dijo algo sobre escribir una novela para una competencia en Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "¿De qué se tratará ahora? Su última novela trataba sobre las Siete Estrellas. Insistía en que le ayudáramos a publicarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Al final no lo publicó. Casi se mete en problemas con la Geoarmada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "Pero si en esta ocasión es para una competencia en Inazuma, no tenemos ninguna responsabilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Puedes darme el libro, se lo daré a uno de los marineros del Gremio para que lo lleve en barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Pero parece que esta vez la suerte no está del lado de Chang. Escuché a algunas personas mencionar un libro muy popular en Inazuma llamado «Una leyenda de espadas».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "También lo escribió alguien de Liyue, pero no sé quién es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Gracias por traer el libro. Chang quería que fuéramos nosotros a recogerlo. Incluso nos ofreció dinero. Toma, como agradecimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
