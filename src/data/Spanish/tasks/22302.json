					"nextDialogs": [
						223020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020504,
					"content": "Tiene una personalidad muy juvenil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020505,
					"content": "Mejor nos apresuramos a entregar el libro al <color=#00E1FFFF>Gremio de Comerciantes de Feiyun</color>.",
