					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020402,
					"content": "Si gano, mi libro se venderá en todo el mundo. Estoy seguro que ella lo leerá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "Chang el Noveno"
				},
				{
					"id": 223020403,
					"content": "¿Todavía estás aquí? ¿Qué esperas para entregar el libro al <color=#00E1FFFF>Gremio de Comerciantes de Feiyun</color>?",
					"roleType": "TALK_ROLE_NPC",
