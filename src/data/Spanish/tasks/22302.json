			"dialogs": [
				{
					"id": 223020201,
					"content": "Ahí adelante debe ser el <color=#00E1FFFF>Gremio de Comerciantes de Feiyun</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Creo que será suficiente con entregarle el libro al <color=#00E1FFFF>hombre de la entrada</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Pero Paimon todavía siente curiosidad... ¿de qué se trata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "¿Y si leemos un poco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
