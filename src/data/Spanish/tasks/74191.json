			"dialogs": [
				{
					"id": 741910201,
					"content": "Su Majestad, Su Majestad, ¿estáis bien? ¿Estáis soñando otra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910202,
					"content": "Cuánto ruido... ¿Qué ocurre?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "Vuestro pueblo está reunido en el gran salón. Parece que tienen algo que deciros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910204,
					"content": "La gente tiene muchas dudas debido a las repetidas interrupciones de la «Fobos» últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910205,
					"content": "No tengo más remedio que hacerlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "Por supuesto. Confío plenamente en vuestro sabio juicio, pero sucesos recientes han llegado a mis oídos... ¿Existe algún problema con la «Fobos»?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910207,
					"content": "La «Fobos» ha marcado el camino para todos y cada uno de nosotros, para que la humanidad entera sea feliz. Con los cálculos cuasiinfalibles de Sibila, seguro que no sucederá nada malo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910208,
					"content": "He oído unos lamentos en la música.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "¿Creéis que alguien ha modificado la partitura de la «Fobos»? Pero no puede ser, solo vos y nosotros, los afinadores, tenemos la capacidad de hacerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910210,
					"content": "¿Estará ocultándonos algo la profetisa? No, ella ya se sacrificó por esto y la Maestra de las Aguas validó su profecía, así que no puede tener motivos egoístas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910211,
					"content": "Tal vez precisamente al no tener motivos egoístas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "Hoy en día, todo el mundo depende de la «Fobos» para que decida y juzgue por ellos. Si algo malo le sucediera, los ciudadanos se sumirían en el caos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910213,
					"content": "Necesito que vayas a donde se encuentran aquellos que tienen una fe ciega...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "¿Queréis decir que deseáis separar mi melodía de la serenata para prevenir cualquier contratiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910216,
					"content": "Pero, Su Majestad, aún es demasiado pronto para ello. Temo que mi alma no esté preparada para aguantar tan grandioso destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910217,
					"content": "Confío en ti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "De acuerdo, creo que ya entiendo lo que queréis decir. Si este es vuestro deseo, entonces yo lo haré realidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "Casiodoro"
				},
				{
					"id": 741910220,
					"content": "Uranópolis, la ciudad del futuro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "████ se va y tú cruzas un corredor dorado. Escuchas cada vez más cerca las voces de la gente debatiendo.\\nCuando te sitúas en el atril del gran salón, todo el mundo empieza a bajar la voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910223,
					"content": "Su Majestad, oh grandioso sebasto, por favor, dadnos las instrucciones que creáis oportunas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910224,
					"content": "Puesto que últimamente no se escucha la melodía de la «Fobos», el pueblo tiene miedo y se siente perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910225,
					"content": "El plan sigue desarrollándose como estaba previsto. Hemos aniquilado a los bárbaros que se escondían entre las sombras y hemos purificado con icor el agua contaminada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910226,
					"content": "Sin embargo, vos deseáis detener la noble guerra sin razón aparente. ¿Por qué? ¿Por qué hacéis esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910227,
					"content": "Tengo mis razones.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "Oh, grandioso sebasto, bajo ningún concepto osaría desafiar vuestra autoridad, mas creo que ya habéis sido suficientemente benevolente con esos bárbaros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910229,
					"content": "Hemos traído un grandioso orden. Las puertas de Remuria están abiertas para todo aquel que quiera formar parte de ese orden dorado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910230,
					"content": "No obstante, ¿qué han hecho los bárbaros? Destruir nuestras atalayas y masacrar a nuestros compositores. Sus almas no merecen salvación alguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910231,
					"content": "Hemos purificado las tierras salvajes con sangre para que el orden y la civilización puedan brotar tras la destrucción. Esa es la mayor bendición que podrían recibir esos ignorantes salvajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910232,
					"content": "Eso no es lo que yo quería.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "¿Acaso no era parte de vuestros grandiosos ideales que no quedara ni una sombra bajo los rayos del sol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910234,
					"content": "Ese es justamente el deseo de todo el pueblo de Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910235,
					"content": "¡Majestad, por favor, dad la orden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boecio"
				},
				{
					"id": 741910221,
					"content": "Seremos conocidos con el nuevo nombre de “Uranópolis, la ciudad del futuro”...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "De ahora en adelante, no serás uno de nosotros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "Para ello, te concedo una voluntad libre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}