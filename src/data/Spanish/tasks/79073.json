			"dialogs": [
				{
					"id": 790730101,
					"content": "#¡Bienvenid{F#a}{M#o} al Bosque de las Bendiciones, querid{F#a}{M#o} visitante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730102
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730102,
					"content": "¿Está de viaje por aquí? ¿O ha venido para ver la competición de salto del Estanque Cantopluvial? En cualquier caso, espero que lo disfrute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudi"
				}
			]
		},
		{
			"id": 7907303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730301,
					"content": "¡Recuerde evitar a ese dragón gigante! Podría venir en cualquier momento, pero ¡no deje que retrase su viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730302
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730302,
					"content": "*Suspira*, estaba pensando en regalarle algunas maquetas de papel a ese dragón para que esté de buen humor y deje de mandar mis muebles por los aires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730303
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730303,
					"content": "Sin embargo... claramente no le intereso lo más mínimo, porque siempre se va volando sin más...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudi"
				}
			]
		},
		{
			"id": 7907304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4016401",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730401,
					"content": "Pero ahora, ya no tenemos que temer la visita de un dragón gigante. ¡Ha venido usted en el momento más oportuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730402
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730402,
					"content": "Dicen que el dragón ya está de mejor humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730403
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730403,
					"content": "De hecho, iba a llevarle unas maquetas de papel. Espero que le gusten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudi"
				}
			]
		},
		{
			"id": 7907305,
			"completionStepIds": [
				7907301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790730501,
					"content": "¡Oh, cielos! ¡Cómo pude olvidar presentarle mi obra más maravillosa y esta magnífica estantería!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730502
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730502,
					"content": "¡Mire! Observe bien esta máquina de regalos. Contiene todas las maquetas de papel que he hecho hasta ahora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730503
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730503,
					"content": "Para hacerlas, viajé por... quiero decir, salté por el mundo entero e hice muchos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730504
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730504,
					"content": "Como por ejemplo, Clanche, la ardilla voladora que siempre intenta llevarme a volar a las corrientes de viento; Devitt, quien comparte conmigo la pasión por las maquetas, y Alof, que siempre tiene cara de mal humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730505
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730505,
					"content": "Son todos muy generosos. Me dejan hacer maquetas de ellos y compartir esta actividad con todo el mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730506
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730506,
					"content": "Tome estas monedas viajestelar como regalo de bienvenida. Insértelas en la máquina de regalos y gire la manilla para ver qué regalo le concede el rocío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730507
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730507,
					"content": "Sin embargo, si las gasta todas, tendrá que encontrar la manera de conseguir más para seguir jugando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730508
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730508,
					"content": "En cuanto a cómo conseguir más monedas... Jajaja, puede preguntárselo a mis amigos, ellos le darán algunas ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730509
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730509,
					"content": "Cuando consiga un regalo, puede ponerlo en la estantería que tengo detrás de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730510
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730510,
					"content": "Hablando más en serio, esta estantería es lo que me motivó a hacer la máquina de regalos y las maquetas de papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730511
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730511,
					"content": "Pero eso es una historia un poco larga... que no tengo problema en contarle más tarde, si quiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790730512
					],
					"speakerTitle": "Xudi"
				},
				{
					"id": 790730512,
					"content": "Ahora, gire la máquina de regalos. Que le toque el regalo que desee y que esté de buen humor para el resto del día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudi"
				}
			]
		}
	]
}