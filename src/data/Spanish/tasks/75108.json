			"dialogs": [
				{
					"id": 751080101,
					"content": "Dijimos que íbamos a cocinar, pero ¿qué preparamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Paimon recuerda que le dábamos pescado a Umpauva, la Foca Abotargada. Así que, ¡cocinar un plato de pescado sería buena opción!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Si queremos satisfacer los estómagos de la Foca Abotargada y de {REALNAME[ID(2)|SHOWHOST(true)]} a la vez... Paimon piensa que el pescado asado a la menta podría ser muy buena opción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "Ese plato se me da bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Bien, pues manos a la obra. ¡Paimon estará a un lado para darte sugerencias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Hacer un corte profundo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "Paimon está de acuerdo, eso hará que el sabor se impregne mejor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Agregar más sal para disfrutarlo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Sí, un sabor muy intenso. ¡A la Foca Abotargada y {REALNAME[ID(2)|SHOWHOST(true)]} les va a encantar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "Agregar más salsa de menta, eso nunca falla",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "¡El sabor fresquito seguro que lo hace más rico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Agregar picante, indispensable",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "¡Una cantidad de picante adecuada puede despertar nuestro apetito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Asar a fuego fuerte, ¡para que esté crujiente por fuera y tierno por dentro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Jeje, a Paimon se le cae la baba con solo pensarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Después de un maravilloso proceso culinario, haces un pescado asado personalizado para la Foca Abotargada y {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Asar a fuego lento, ¡para que quede jugoso y blandito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Guau, no está nada mal, la receta única de {NICKNAME}... ¡A lo mejor se convierte en uno de tus platos estrella y se lo preparas a nuestros otros amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Puede que los animales de Fontaine no toleren el picante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Pero sin nada de picante es como si faltara algo. ¿Qué tal si ponemos solo un poquito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Una criatura como la Foca Abotargada que habita en el agua, ¿podrá tolerar el sabor de la menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Paimon piensa que, en teoría, si la Foca Abotargada suele habitar en el agua, entonces debe sentir mucha sequedad y calor en la tierra. Por eso, le vendría genial un poco de salsa de menta para bajar la temperatura, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "No agregar mucha sal, el sabor está bien",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "Paimon está de acuerdo. Luego hay que echarle más especias, así que no es necesario poner mucha sal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Hacer un corte superficial",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "No estaría mal, a lo mejor así se puede mantener mejor el sabor original del pescado al cual la Foca Abotargada está más acostumbrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "#No soy {F#una}{M#un} expert{F#a}{M#o} en ese plato, pero no hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
