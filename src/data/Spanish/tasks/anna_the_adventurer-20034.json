			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bennett",
					"Fischl",
					"Anna",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "Fischl, ¡no corras tan rápido, es muy peligroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340202,
					"content": "Mi retribución del trueno no permitirá que el mal se propague...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340203,
					"content": "Son Fischl y Bennett. ¡Hola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340204,
					"content": "#Son Anna y {F#la viajera}{M#el viajero}, ¿están aquí para completar algún encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340205,
					"content": "#¡Oh! Tú, ungid{F#a}{M#o} por la gracia de la Princesa, ha sido el destino el que te ha traído hasta aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340206,
					"content": "Lo que la señorita quiso decir es que le complace este encuentro tan fortuito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340207,
					"content": "Estoy acompañando a Anna a completar un encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "Sí, estamos escoltando un globo de carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340209,
					"content": "#Pero de repente vimos que unos ladrones de tesoros se dirigían hacia nosotr{F#a}{M#o}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340210,
					"content": "Lo siento, perdón. Todo es culpa mía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340211,
					"content": "Fischl y yo aceptamos un encargo para rastrear a unos ladrones de tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340212,
					"content": "Oz logró localizarlos, y estábamos a punto de capturarlos cuando... tropecé con una rama y me caí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340213,
					"content": "El ruido alarmó a los ladrones de tesoros, así que se dieron la vuelta y huyeron. No tuvimos de otra más que perseguirlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340214,
					"content": "No hay de qué preocuparse. El violeta rayo inquisitivo se encargará de juzgar a esos malhechores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340215,
					"content": "#Pero, señorita, quien terminó por atraparlos fue {F#la viajera}{M#el viajero}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340216,
					"content": "¡O-Oz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340217,
					"content": "E-en fin, gracias por ayudarnos. ¡Es una suerte que hayan estado aquí para impedirles el paso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340218,
					"content": "¡Parece que hoy estoy de suerte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340219,
					"content": "Me alegra ser de ayuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "Jeje. Entonces llevaremos a estos ladrones al gremio. Tengan cuidado al completar su encargo, ¡y sobre todo fíjense por dónde caminan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
		{
			"id": 2003403,
