			},
			"dialogs": [
				{
					"id": 200340401,
					"content": "#Viajer{F#a}{M#o}, por favor, cuida de Anna. La emoción se le ha subido a la cabeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340402
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340402,
					"content": "¿No quieres que sea una aventurera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340403
					]
				},
				{
					"id": 200340403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340404,
					"content": "Respeto los deseos de mi hermana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340405,
					"content": "Ahora que se recuperó de su enfermedad, tiene la oportunidad de perseguir sus sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340406,
					"content": "Como su hermano, yo... la apoyaré incondicionalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340407,
					"content": "Es todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
}