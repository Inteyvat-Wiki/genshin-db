	"talks": [
		{
			"id": 7104301,
			"completionStepIds": [
				7104305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "“... El serzhant Anton descubrió una gran campana al sureste. En el muro de roca se leía la palabra ‘ellos’...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Diario de los Fatui"
				},
				{
					"id": 710430102,
					"content": "“... Es muy similar a la que el capitán porúchik vio en las ruinas del noroeste. Quizás...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Diario de los Fatui"
				},
				{
					"id": 710430103,
					"content": "“... Envíen a Snezhevna y Fadeyka para que hagan sonar las campanas desde ambos lados...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Diario de los Fatui"
				},
				{
					"id": 710430104,
					"content": "“... Terroríficos gritos de lamento se escucharon a través del muro, y la niebla oscura desapareció. Qué extraño fenómeno. Es como si estuvieran anunciando la llegada de alguien...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Diario de los Fatui"
				},
				{
					"id": 710430105,
					"content": "“... Diez personas se sacrificaron por todos y ambas vanguardias quedaron devastadas por las pérdidas. El capitán porúchik ordenó la retirada inmediata...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Diario de los Fatui"
				},
				{
					"id": 710430106,
					"content": "(Un mapa sencillo se desprende del diario. En el mapa aparecen marcadas las campanas halladas en el noroeste y el sureste. También aparecen dibujadas dos impactantes calaveras.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario de los Fatui"
				}
			]
		},
