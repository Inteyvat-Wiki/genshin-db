				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Muy bien, esto bastará. ¡Gracias! Si no fuera por ti, tendría que haber ido a lidiar con esos monstruos por mi cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Si eso hubiese pasado, no tengo idea de cuándo recordaría que tenía la tarea de reunir pétalos de cerezo otra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "De todos modos, gracias por tu ayuda. Por favor, acepta estas brochetas de champiñones y pollo. La señorita Lynn me enseñó a preparar este clásico gourmet de aventurero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Le llevaré estos pétalos de cerezo a Xudong. Me pregunto qué tipo de manjares se le ocurrirán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
	]
}