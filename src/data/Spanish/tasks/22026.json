			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Humm... debería estar por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "¿Julie? ¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "#¿Eh? ¡Oh, viajer{F#a}{M#o}, eres tú! Jeje, no esperaba encontrarte por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "Vine a buscar ingredientes. Xudong está trabajando en platos nuevos y Parvaneh le está dando ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong me dijo que quería preparar un plato dulce y liviano como postre, basado en el dango tricolor de Inazuma. Pero necesitaría varios ingredientes especiales para hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "El Tío Munehisa fue al pueblo a comprar algunas calavandas. Yo vine a buscar lo que ellos llaman pétalos de cerezo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "Aunque ya reuní algunos, aún no hay suficientes. Quiero salir a buscar más, pero está plagado de monstruos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "#Viajer{F#a}{M#o}, ¿podrías traerme tres montones de pétalos de cerezo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "¡Gracias! ¡Te daré algo genial cuando vuelvas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "Estos monstruos no deberían causarte problemas, ¿no es cierto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Bueno, en general, esa sería la situación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "Pero, mmm, ¿cómo digo esto? Si de verdad tengo que luchar contra esos monstruos, definitivamente me olvidaría de la misión de reunir ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "Esto me pasa desde que estuve en Mondstadt. Siempre que estaba encargándome de los monstruos, me olvidaba de todo lo demás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Solo después de derrotar completamente a los monstruos, recordaba que todavía tenía una misión que requería mi atención... Por eso, fallé en tantas misiones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "De verdad odias a los monstruos, ¿no?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "¿Si los odio? No, no realmente... En realidad, me divierte mucho luchar con ellos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "¿Alguna vez tuviste esa sensación de que no necesitas pensar en nada más que derrotar a los monstruos? Es fabuloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Bueno, no demos vueltas con eso. Por favor, ayúdame a reunir los pétalos de cerezo, ¡gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "¡Te daré algo genial cuando vuelvas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
