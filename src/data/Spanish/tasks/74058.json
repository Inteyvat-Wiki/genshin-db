			"dialogs": [
				{
					"id": 740580101,
					"content": "Pucca, ¡ya estamos aquí de vuelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#¡{NICKNAME} y Paimon! ¿Han venido para visitar a Pucca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740580103,
					"content": "No exactamente. La última vez que nos vimos mencionaste que podíamos venir a buscarte si teníamos alguna pregunta sobre vetas de minerales o piedras, ¿recuerdas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Sí, claro. He recogido todas las piedras bonitas que hay por esta zona. ¿Qué tipo de piedra están buscando ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740580105,
					"content": "Eh... La verdad es que estamos buscando la misma piedra que encontramos la vez pasada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Le cuentan a Pucca que vendieron a un comerciante de la Corte de Fontaine el mineral extraño que encontraron...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "¿Eh? ¿Entonces la gente de fuera piensa que ese mineral es en realidad una piedra preciosa? Pero si hasta mi hermana comprobó su valor... Estos humanos... Hay que ver qué raros son.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740580108,
					"content": "Yo conozco muchos sitios donde pueden conseguir más piedras como esta. Si lo desean, puedo compartir la ubicación con ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Pucca"
				},
				{
					"id": 740580109,
					"content": "Pucca les marca las ubicaciones donde pueden encontrar minerales extraños...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "¡Qué maravilla! ¡Gracias, Pucca! Por cierto, estos son los Moras que nos ha entregado Chesil. Jeje, ¡Paimon estaba pensando en darte la mitad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "No será necesario, mejor quédenselo ustedes. En la aldea no necesitamos esta cosa para vivir... Además, ¡ustedes también me ayudaron mucho a mí! ¡Hoy por mí, mañana por ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pucca"
				}
			]
		},
