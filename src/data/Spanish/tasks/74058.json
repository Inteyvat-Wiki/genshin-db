				{
					"id": 740580401,
					"content": "¡Bienveni...! Oh, ¡ustedes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580402,
					"content": "¿Han traído los minerales que prometieron la última vez que nos vimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580403,
					"content": "Todavía no han llegado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740580404
					]
				},
				{
					"id": 740580404,
					"content": "No tengo mucha prisa... Al fin y al cabo, los artesanos todavía están trabajando en la muestra del mineral que les mandé la vez pasada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580405
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580405,
					"content": "No obstante, si pudiera obtener más minerales a tiempo, quizá les sirva de inspiración a los artesanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580406,
					"content": "Entonces me quedaré aquí esperando a que regresen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				}
