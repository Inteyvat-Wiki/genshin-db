			"dialogs": [
				{
					"id": 740580201,
					"content": "Vaya... No imaginé que hubiera tantas... ¡Aquí tienen piedras para hartarse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "Envié el mineral a unos artesanos, pero seguramente les haya surgido algún problema al no estar familiarizados con la naturaleza de este mineral... Todavía no he recibido mis productos de muestra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "No pasa nada, yo confío en mi criterio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "Tengo pensado utilizar este mineral para fabricar joyas con el diseño más llamativo que se haya visto en mucho tiempo. Estoy convencido de que se pondrán de moda en toda Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "¡Seguro que ya tendré mis productos de muestra para la próxima vez que vengan! Llegado el momento, les regalaré algunos de ellos como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Aunque también es probable que primero vean a los ricachones de la región contoneándose con mis joyas puestas, jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "#Bueno... Tengan en cuenta que aquí siempre serán bienvenid{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				}
			]
		},
