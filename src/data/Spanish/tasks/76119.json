			"dialogs": [
				{
					"id": 761190101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190102,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "... Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190104,
					"content": "Parece que se lo están pasando bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Hola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190106,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Hola a ti también, luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190108,
					"content": "¿Estás jugando a un juego nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Sí. Vi a la gente jugar con sus amigos con vasos en el Buque Insignia, así que quise probar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190110,
					"content": "Colocaban una gema bajo uno de los vasos y luego los movían todos rápidamente sobre la mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190111,
					"content": "Cuando paraban, le pedían a otro jugador que adivinara en qué vaso se escondía la gema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190112,
					"content": "A las kuuhenki les encanta la sensación de dar vueltas mientras están cubiertas de tela, así que tomé como referencia el sombrero de la Srta. Bruja y realicé algunas mejoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190113,
					"content": "¡Es adorable!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Un momento... ¿Fuiste al Buque Insignia? ¿Y nadie te reconoció?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Algunos me preguntaron, pero les dije: “Decidí vestirme de nuestra señora la Diosa Lunar hoy. ¿A que me parezco?”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190117,
					"content": "Vaya, sí que aprendiste el truco de la Noche Rezolunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "¿Y te creyeron?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Bueno... No del todo, pero tampoco volvieron a hablarme después.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190120,
					"content": "¿Acaso no actué con naturalidad? Seguiré practicando la próxima vez en algún otro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190121,
					"content": "Eso le suena a Paimon a que alguien aprendió las lecciones equivocadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "A la luonnotar le gustaría que adivinaran dónde está escondida. ¿Les gustaría jugar una ronda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190124,
					"content": "¡Claro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "En tal caso, hagan un depósito de 100 000 Moras para empezar. Así son las reglas del Buque Insignia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190126,
					"content": "¡No deberías haber aprendido esa lección!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
