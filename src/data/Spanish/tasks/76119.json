			"dialogs": [
				{
					"id": 761190201,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "¿Ha sido demasiado fácil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190203,
					"content": "Si vuelves a venir a jugar, intentaré mover los sombreros más rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190204,
					"content": "Paimon tiene una duda... ¿Cómo jugaste antes con la gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "No puedes ver nada a no ser que uses el kuuvahki, pero, si lo usas, lo verías todo demasiado nítido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "También puedo abrir los ojos, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761190207,
					"content": "Ah, cierto. Paimon no había pensado en eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
