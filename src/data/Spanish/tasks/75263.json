			"dialogs": [
				{
					"id": 752630501,
					"content": "¡Fin! ¡Se acabó la carrera! ¡Tenemos un resultado totalmente inesperado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#{F#La ganadora}{M#El ganador} de esta carrera es... ¡{NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "¡Guau! ¡Es increíble! ¡Ha conseguido derrotar a Sinsombra y Sinrastro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "¡Parecía un relámpago dorado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Oye, ¿acaso no vieron uno plateado? ¿No? ¿Nadie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "Qué derrota más aplastante... Supongo que jamás llegaré a correr a tal velocidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "Turbonanas"
				},
				{
					"id": 752630507,
					"content": "No te des por vencida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Serás mi modelo a seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "Turbonanas"
				},
				{
