				},
				{
					"id": 752630510,
					"content": "♬, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "#Aquí tienes el premio para el ganador de esta competición. ¡Te lo mereces, campe{F#ona}{M#ón}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630512,
					"content": "¡Tu nombre quedará grabado para siempre en la historia del Torneo de Velocidad Brisapacible!",
