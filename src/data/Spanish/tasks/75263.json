					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Damas y caballeros, ¡el Torneo de Velocidad Brisapacible está a punto de comenzar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Quien logre vencer a la campeona de ayer, anteayer y anteanteayer, Turbonanas, ¡se llevará nuestro gran premio sorpresa! ¡Última llamada para las personas que aún no se hayan apuntado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Hum, ¿es que ya no hay nadie que se atreva a retarme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*Suspira*, Turbonanas es demasiado fuerte. Lleva tres días seguidos siendo la campeona y llevándose el premio. Es invencible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "¡¡Grrr!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "¿Eh? ¿Quieres intentarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Hum, ¿ahora solo pueden recurrir a los saurios? ¡Qué cobardes! Vamos, ¡envíen a todos sus saurios y les enseñaré lo que es la velocidad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "¡Guau, una competición nunca antes vista! ¿Los poderosos compañeros saurios serán capaces de destronar a la tricampeona, Turbonanas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "Me quiero apuntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "#¡Un giro inesperado! ¡Tenemos aquí a {F#una}{M#un} valiente contendiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Oh, ¿te crees que me vas a vencer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "Cuántos giros inesperados llevamos hoy... ¿Quién se alzará finalmente con la victoria?... ¡Pronto lo averiguaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "El personal prepara la carrera, y el público se junta... Te pones en la línea de salida...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
