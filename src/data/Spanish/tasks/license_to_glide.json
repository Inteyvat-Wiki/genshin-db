			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Lo leí, pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "No entendí del todo las reglas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "¡Genial, estás aquí! ¿Leíste bien el manual de vuelo? ¿Ya te sabes todas las reglas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "Es muy engorroso. Te entiendo, he pasado por eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "El manual de vuelo es muy denso... No lo entendí muy bien. Pero no le digas nada a la Gran Maestra Intendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "¿En serio? Paimon pensó que había algunas historias geniales en el manual de vuelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "¿Historias geniales? Oh, debes referirte a los casos de ejemplo en el Apéndice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Algunos de ellos me gustan. Mi favorito es el del despegue ilegal usando un Slime Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Al parecer, si explotas un Slime Anemo y despegas con la ráfaga de viento, te dispara muy, muy alto... ¡Quiero intentarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "Esa no era la historia de la que hablaba. Me refería a la del pajarito que quería aprender a volar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "¿Eh?... Oh, espera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Déjame echar un vistazo... ¡Oh, no! ¡Este es el libro de cuentos que solía leer de pequeña!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "¡Ups, lo siento! Puse ambos libros en la misma pila y debí tomar el equivocado al salir de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "¿Cómo puede alguien confundir un cuento infantil con un manual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Ay... Qué vergüenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "Es porque... quizás en el fondo, ese cuento de hadas es lo que realmente me enseñó a volar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "“Lo que les faltaba no era viento, sino valor. Fue el valor lo que les permitió convertirse en las primeras aves voladoras de este mundo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Leer eso fue lo que me dio el valor de volar, de convertirme en una Caballera Exploradora y de ser la Campeona de Vuelo de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "... En fin, ¡de vuelta a la prueba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "#No te pongas nervios{F#a}{M#o}. Simplemente vuela como de costumbre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "#Estoy list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Sigue la <color=#00E1FFFF>ruta marcada</color> hasta el final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
