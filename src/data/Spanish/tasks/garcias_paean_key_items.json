			"dialogs": [
				{
					"id": 230135001,
					"content": "Sr. García, parece que es aquí. Deberíamos contratar a alguien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135002,
					"content": "¿Sr. García? ¿Me está escuchando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135003,
					"content": "¿Eh? ¿Qué? Ah, sí, claro que estoy escuchando. Entonces, contratemos a alguien. No nos llevará mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135004,
					"content": "¿Te encuentras bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "#Viajer{F#a}{M#o}, jajaja... No te preocupes. Estoy bien. ¿Por qué iba a estar mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135006,
					"content": "Estoy totalmente absorto en mi máquina contable. Presiento que estoy solo a un paso del triunfo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135007,
					"content": "Si no te importa, ¿podrías conseguirnos un poco de condensado de Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135008,
					"content": "Ya que estás aquí, no hay necesidad de ir a buscar a alguien en la ciudad. Hemos ganado algo de dinero, así que te daremos una recompensa a cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135009,
					"content": "Me parece bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "#Entonces, te lo dejo a ti, viajer{F#a}{M#o}. Aún tengo que pensar en cómo cambiar los mecanismos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135010,
					"content": "Claro, sin problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
		},
