				{
					"id": 230135201,
					"content": "#Viajer{F#a}{M#o}, ¿pudiste conseguir el condensado de Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135202
					],
					"speakerTitle": "Sr. García"
				},
				{
