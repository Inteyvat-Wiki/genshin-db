					"content": "Por supuesto, aquí está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135203
					]
				},
				{
					"id": 230135203,
					"content": "Magnífico, con esto será suficiente. Lutong, dale su recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135204
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135204,
					"content": "Yo iré a comprobar la calidad del condensado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135205
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230135205,
					"content": "#Aquí tienes tu recompensa. De nuevo, muchas gracias por tu ayuda, viajer{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135206
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135206,
					"content": "Cuando tengas tiempo, puedes venir a ver cómo va todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135207,
					"content": "Si el estado del Sr. García empeora, tal vez necesite tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
