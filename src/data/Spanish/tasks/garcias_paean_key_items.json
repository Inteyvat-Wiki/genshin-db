			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. García",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, sobre nuestros fondos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130202,
					"content": "Seguro que encontraremos la forma de salir de esta, Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "En Liyue tenemos un dicho: “Cuando el Arconte cierra una puerta, una ventana se abre”. Creo que encaja perfectamente con nuestra situación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Quiere decir que, aunque nos topemos con un gran obstáculo en el camino, siempre hallaremos la forma de avanzar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "Jaja, qué metáfora tan ingeniosa. Si eso es cierto, entonces nuestra situación no puede ser tan mala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130206,
					"content": "Sr. García, ¿cree que la persona que inventó ese dicho encontró la forma de superar sus obstáculos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "¿Eh? Lutong, no atraigas a la mala suerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301303",
							"2"
						],
						"stepId": 2301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. García"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "#Viajer{F#a}{M#o}, ¿pudiste conseguir el condensado de Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130302,
					"content": "Por supuesto, aquí está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "¡Excelente! Con esto debería bastar. Comenzaré con el experimento en cuanto regresemos... Con este tipo de lubricante, seguro que mi máquina contable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130304,
					"content": "Querido Lutong, me voy a probarla. Dejo el resto en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130305,
					"content": "Sí, señor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "#Aquí tienes la recompensa, viajer{F#a}{M#o}. Muchas gracias por tu ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "Humm... Es solo la opinión de un humilde servidor, pero creo que necesitaremos tu ayuda de nuevo más adelante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "Pero no te preocupes. Mientras yo esté a cargo de las finanzas, siempre podrás contar con una justa compensación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "*Suspira*... Decidí acompañar al Sr. García porque no quería pasarme la vida haciendo cuentas en algún departamento del Ministerio de Asuntos Civiles de Liyue, al igual que mis padres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Pero ahora... No solo me paso el día haciendo cálculos junto al Sr. García, sino que también tengo que administrarle las finanzas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "Supongo que por eso dicen que los designios de los Arcontes son insondables y sus caminos inescrutables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301311,
			"completionStepIds": [
				2301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301301",
							"2"
						],
						"stepId": 2301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_DAILY_TASK_VAR_GT",
						"rawParams": [
							"42020",
							"1",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Sr. García"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Sr. García, con todo el respeto posible, me gustaría sugerir de nuevo que venda algunos libros para recuperar parte de nuestro fondo moratario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "¡Rotundamente no! ¡De ninguna manera! Querido Lutong, ¡eso es como pedirme que venda el alma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131103,
					"content": "Señor, siendo realistas, no creo que nadie esté interesado en comprar su alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "¿Todavía están aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "#¿Viajer{F#a}{M#o}? ¿Otra vez aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131107,
					"content": "*Suspira*, verás, no tuve éxito en el último experimento. Debe haber alguna deficiencia en mi método para disolución de condensado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131108,
					"content": "El lubricante que fabriqué no logra engrasar el mecanismo de mi máquina contable. Al contrario, lo atasca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131109,
					"content": "Es por eso que necesito más condensado de Slime para continuar experimentando. Me preguntaba si tú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131110,
					"content": "Yo te ayudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "Contamos contigo para reunir el condensado de Slime necesario. Tendré lista tu recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "¿No saben de ninguna manera de ganar Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Bueno, tampoco es eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131113,
					"content": "Es que no tiene la capacidad para ganar Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Muchas gracias por tu aportación, mi querido Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131115,
					"content": "*Suspira*, estoy avergonzado. He presumido mucho por haber creado la máquina contable, pero sus aplicaciones son demasiado rudimentarias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131116,
					"content": "De hecho, ni siquiera puede realizar cálculos de manera autónoma. Antes hay que introducir manualmente una serie de parámetros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131117,
					"content": "No importa... ¡Seguiré trabajando en ella! ¡Estoy convencido de que mi máquina contable se convertirá en un invento increíble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131118,
					"content": "¡U-una invención que pasará a la historia! Así por fin seré capaz de ganar algo de Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131119,
					"content": "Pero antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230131105,
					"content": "¿Necesitan más condensado de Slime?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
