				{
					"id": 230135101,
					"content": "#Viajer{F#a}{M#o}, llegas en el momento oportuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135102,
						230135103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135102,
					"content": "Sobre el Sr. García...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Sí, sigue con lo de Kaia. El Sr. García no quiere admitirlo, pero se distrae cada vez más y más en el trabajo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135105,
					"content": "Ya ni siquiera va a la cafetería. En su lugar, me manda a mí a comprar café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135106,
					"content": "Incluso el Sr. Ahangar se ha dado cuenta. Se ofreció a hablar con el Sr. García si hacía falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135107,
					"content": "Yo tampoco sé muy bien cómo manejar la situación. No es como si yo tuviera experiencia en el asunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135108,
					"content": "*Suspira*, es como si hubiera otra barrera entre el Sr. García y yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135103,
					"content": "Entonces sigue...",
					"roleType": "TALK_ROLE_PLAYER",
