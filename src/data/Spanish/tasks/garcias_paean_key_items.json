			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. García",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "Mi querido Lutong, ¿estás seguro de que estamos en el lugar correcto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130102,
					"content": "Estoy seguro, Sr. García. Este es el lugar en el que suelen aparecer los Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130103,
					"content": "No dudo que los Slimes se reúnan en este lugar, pero mi duda es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130104,
					"content": "¿No son demasiados Slimes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130105,
					"content": "Sr. García, eso se debe a nuestra escasez de fondos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130106,
					"content": "¿Sr. García? ¿Eres tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "#¡Viajer{F#a}{M#o}! Pero qué coincidencia encontrarnos aquí en Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130109,
					"content": "¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "Jajaja, verás, estoy aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130111,
					"content": "... porque le gusta meterse en problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130112,
					"content": "... porque me gustan las aventuras. Gracias, Lutong. ¿Te importaría si...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130113,
					"content": "Como usted desee, Sr. García.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130114,
					"content": "El caso es que venimos en busca de condensado de Slime. Lo necesito para engrasar la máquina contable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130115,
					"content": "¿Que por qué no lo compro y ya está? En primer lugar, el condensado de Slime que venden en el mercado no es fresco ni de buena calidad, y por otro lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130116,
					"content": "Es porque el Sr. García se lo gastó todo en libros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130117,
					"content": "... es porque hemos tenido muchos gastos... ¡Todos fueron gastos necesarios! En definitiva, que nos hemos quedado sin un Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130118,
					"content": "Y por eso estamos aquí. Nos vemos obligados a conseguir condensado de Slime nosotros mismos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130119,
					"content": "Pero, como podrás ver, aunque mi querido Lutong es un ciudadano de Liyue, carece de cualquier habilidad para las artes marciales o la cocina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130120,
					"content": "Afortunadamente, al menos tengo talento para administrar cuentas... Y todo porque estoy familiarizado con las complejas ordenanzas fiscales que establece el Ministerio de Asuntos Civiles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130121,
					"content": "... Y yo, no puedo continuar importunando a la gente para conseguir los componentes necesarios para mi máquina contable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130122,
					"content": "¿Necesitan mi ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "Bueno... Algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130124,
					"content": "Sin duda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130125,
					"content": "Lutong, tenemos... *Ejem*, ¿nos queda algo de Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130126,
					"content": "#Después de pagar {F#a la viajera}{M#al viajero}, estoy convencido de que encontraremos alguna forma de sobrevivir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130127,
					"content": "#¡No se hable más! Viajer{F#a}{M#o}, lo dejamos en tus capaces manos. Ayúdanos a conseguir un poco de condensado de Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. García"
				},
				{
					"id": 230130107,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
			"id": 2301302,
