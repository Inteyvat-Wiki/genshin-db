			"dialogs": [
				{
					"id": 730670301,
					"content": "Humm... Parece que un aranara llamado Arashakun escribió estas notas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "Paimon se pregunta por qué estas notas están escritas con letra grande y pequeña, con la letra grande ya basta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "La letra pequeña hace que a Paimon le duelan los ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "¿No puedes leer la letra pequeña?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Paimon está acostumbrada a leer letras de tamaño normal, ¡es difícil leer la letra pequeña!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Humm, ¿acaso Arashakun escribió las últimas páginas y nunca volvió?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Vamos a la cueva del este a echar un vistazo. Las notas dicen que perdió su valentía. Paimon tiene mucha curiosidad por saber si la valentía puede perderse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
