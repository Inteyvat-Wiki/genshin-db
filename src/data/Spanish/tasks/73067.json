			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "¿Eh? A estos Hilichurls se les cayó algo extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670102,
					"content": "¡Qué raro! Parece una flor normal que fue cortada hace mucho pero aún no se ha marchitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670103,
					"content": "Paimon puede sentir una gran cantidad de energía Dendro. Parece que alguien la dejó aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670104,
					"content": "Seguro que es de algún aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Sí, debe ser eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670108,
					"content": "Hum, esa cosa tiene tanta energía Dendro que no se marchitó a pesar de estar en manos de esos Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670109,
					"content": "Quizás la llevaron con ellos todo este tiempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Sí, deberíamos devolver esta cosa a los aranara tan pronto como sea posible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670112,
					"content": "#Vamos a echar un vistazo dentro de la casa. {NICKNAME}, sea quien sea quien perdió esto, ¡tal vez esté ahí dentro buscándolo como un loco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670110,
					"content": "Quizás sea algo muy valioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "Debe ser de un Hilichurl Dendro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "Paimon no lo cree. Tiene pinta de pertenecer a algún aranara que viva por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
