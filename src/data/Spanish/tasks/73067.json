			"dialogs": [
				{
					"id": 730670401,
					"content": "¿Tú eres Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "*Solloza*... Arashakun se llama Arashakun. ¡Eh! No se acerquen tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "Gracias por salvar a Arashakun, p-pero Arashakun necesita que nara mantengan su distancia, *solloza*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Así Arashakun se siente más seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "¿Qué? ¡Pero si te acabamos de salvar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "¡Oh! ¡Perdón! ¡Perdón! No fue intención de Arashakun hacer enfadar a nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Arashakun se quedó atrapado aquí. Todavía está asustado. *Solloza*, perdonen atrevimiento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "No pasa nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Bueno, bueno, ¿Arashakun puede preguntar sus nombres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Paimon se llama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Yo soy {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#*Solloza*, ¿cómo es que nara {NICKNAME} y Paimon conocen nombre de Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Leímos las notas que estaban en la casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#Nara {NICKNAME} leyó notas y vino a buscar a Arashakun. Es nara muy fuerte y valiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "*Solloza*... Si Arashakun no hubiera perdido su valentía, no estaría atrapado aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "Cierto, en las notas mencionaste que perdiste tu valentía, ¿a qué te referías con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "Historia sucedió hace mucho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Hace muchas, muchas lunas, Arashakun estaba en situación parecida a ahora, no era valiente. Entonces, hasta sonido de ramas partirse hacía que Arashakun se quedara despierto toda noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "Pero Arashakun cobarde tenía amigo nara que estaba dispuesto a acompañar a Arashakun. Aunque ese amigo no era nara Váruna, ¡era buen nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Nunca se burló de Arashakun cobarde. Cuando creía que Arashakun tenía miedo, tomaba su mano sin dudar. Arashakun nunca olvidará ese amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Pero un día, monstruo de máscara peluda capturó a nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Espera, ¿quién es ese monstruo de la máscara peluda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "Monstruo de máscara peluda tiene cara peluda, lleva máscara y es rey de monstruos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "Oh, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "¿Sabes a qué se refiere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "¿Cómo podría Paimon saberlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Bueno, el monstruo de la máscara peluda se llevó al amigo de Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "Monstruo de máscara peluda es siniestro y astuto. Solo con pensarlo, Arashakun siente escalofríos por todo cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "*Solloza*... En aquel momento, se llevó a amigo nara de Arashakun. A Arashakun le daba miedo que monstruo de máscara peluda lo golpeara, pero le daba más miedo no volver a ver a su amigo nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "Entonces, Arashakun hizo su mejor esfuerzo. ¡Cerró ojos, apretó dientes y usó manos para pegar a monstruo! Y así salvó a su amigo nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Después de eso, su amigo nara usó flor para hacer Amuleto floral de valentía y dijo: “¡Arashakun es buen aranara, muy valiente! ¡No es aranara cobarde!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "Así fue como Arashakun consiguió su valentía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "¿Eh? Pero dijiste que cerraste los ojos, apretaste los dientes y usaste tus manos para pegarle. ¿Esos no son gestos de valentía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "No, no, Arashakun consiguió valentía después de conocer a su amigo nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "Pero demostraste mucha valentía al salvar a tu amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "No, no. Al momento de salvar a su amigo nara, Arashakun estaba tan asustado que sus manos y pies temblaban. Después de obtener su valentía, manos y pies de Arashakun dejaron de temblar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "El amuleto solo te dio un empujón...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#*Solloza*, palabras de nara {NICKNAME} son tan complicadas. Todo lo que Arashakun sabe es que con amuleto Arashakun se volvió valiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "Tras robar su valentía, Arashakun tuvo que ir a buscarla a cueva de monstruo de máscara peluda, con esperanza de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Pero unos Slimes rodearon a Arashakun en la cueva. Aunque al menos parece que el monstruo de la máscara peluda no se dio cuenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#¡Oh! Cierto, {NICKNAME}, ¿recuerdas eso que se le cayó al Hilichurl? Paimon cree que debe ser el amuleto de Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "#Arashakun, ¡nosotr{F#as}{M#os} tenemos la valentía que se te perdió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#¡¿De verdad?! ¿Nara {NICKNAME} y Paimon de verdad tienen valentía de Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "¡La valentía se encuentra en el corazón de Arashakun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Es una respuesta al estilo de los aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Paimon no tiene ni idea de quién se trata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
