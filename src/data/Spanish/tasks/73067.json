				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Paimon cree que es un Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "¿Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Sí, el monstruo de la máscara peluda es un Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "¿Todos los “Hilichús” son monstruos de máscara peluda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "No, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "Puedes verlo de esa manera, Arashakun, no hay problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Sí, Arashakun entiende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#¡Con ayuda de nara {NICKNAME} y Paimon, Arashakun fue invencible! ¡Siniestro monstruo de máscara peluda no fue rival para nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Arashakun tiene que escribir unas notas con letra grande cuando vuelva hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "Unas notas con letra grande...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Sí, ¡Arashakun escribe grandes hazañas con letras grandes para que queden bien plasmadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "Paimon tiene la sensación de que el Arashakun valiente y el Arashakun cobarde son dos aranara diferentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "A Arashakun cobarde tiemblan manos y pies y no puede hacer nada bueno. ¡Arashakun valiente sabe hacer cosas increíbles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670714,
					"content": "Valentía es mejor regalo que amigo nara pudo dar a Arashakun. Además, es algo muy, muy importante para Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670715,
					"content": "Entonces, guárdalo bien. ¡No dejes que los Hilichurls te lo roben otra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670716,
					"content": "¡Arashakun sabe! ¡Nunca más perderá de vista su valentía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				}
			]
		}
	]
}