					"Arashakun",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "¡Sí! ¡Este es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "Este es Amuleto floral de valentía de Arashakun. Como ha estado lejos de Arashakun tanto tiempo, color de flor se apagó un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Pero no importa, ¡de ahora en adelante Arashakun cuidará muy bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "“¡Arashakun es buen aranara, muy valiente! ¡No es aranara cobarde!”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#¡Muchísimas gracias, nara {NICKNAME} y Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "Ahora Arashakun puede ser valiente. Nada puede detener a Arashakun. Si ya venció a monstruo de máscara peluda una vez, seguro puede hacerlo dos veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(¡Guau! A Paimon le parece que su tono de voz ahora es diferente al de antes.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#Monstruo de máscara peluda ha hecho mucho daño. Nara {NICKNAME} y Paimon, ¡por favor, vengan! ¡Con ayuda de ustedes dos, seguro que podremos vencer a monstruo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun puede sentir. Hoy es día en que iremos a cueva y pondremos fin a todo esto de una vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#¡Sí! {NICKNAME}, vamos con él. Paimon quiere saber quién es el monstruo de la máscara peluda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
			"completionStepIds": [
				7306711
			],
