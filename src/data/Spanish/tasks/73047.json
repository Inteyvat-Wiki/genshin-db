				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Nara {NICKNAME}, Paimon, ¡volvemos a ver! Jejejeje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470102,
					"content": "¡Araja, pareces muy contento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470103,
					"content": "Jejeje... Araja está contento de ver que Vanarana está tan animado, ¡con tantos aranara que regresaron a casa! ¡Ay! Araja nunca se imaginó que podría venir a Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470104,
					"content": "¿Nunca antes participaste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "Según cuentan historias, Araja participó una vez. Pero fue hace mucho, muuuucho tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470108,
					"content": "Aramuhukunda, Arana, Araji y Araja... Muchos aranara celebramos Festival Utsava con nara Váruna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470109,
					"content": "Fue periodo muy duro, pero durante Festival Utsava reímos y cantamos. A Araja encanta esa historia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470110,
					"content": "¿Eh? Entonces, sí que participaste, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470111,
					"content": "Oh, según historias, sí. Pero Araja ya no recuerda. Fueron aranara quienes después contaron historias a Araja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470112,
					"content": "Hum... Paimon tiene la impresión de que Araja habla como si fuera un señor mayor, quizás no se acuerda precisamente por su avanzada edad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470113,
					"content": "#Quizás tampoco está mal que cosas estén así... De todas formas, nara {NICKNAME}, Paimon, ¿podrían aceptar esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470114,
					"content": "Es una pequeña flor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470115,
					"content": "Sí, Araja espera que esta flor pueda acompañar a ustedes en sus futuros viajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470116,
					"content": "#La acepto gustos{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "#Tiempo de nara es mucho más valioso que tiempo de aranara. Bueno, Araja no retiene más a amb{F#as}{M#os}. Procuren disfrutar. Vayan a buscar a Arakavi más tarde, él también está preparando ceremonia para Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470117,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "#Yo también estoy content{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "¡Paimon también! Pero entonces, ¿Araja nunca había estado en el Festival Utsava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}