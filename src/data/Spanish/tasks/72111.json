			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "¿Una bolsa para llevar Moras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110202,
					"content": "Esto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110203,
					"content": "... Esto pertenece a nuestra familia. No tiene nada de sospechoso. Así es, es algo corriente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110204,
					"content": "¡Es muy sospechoso! ¡Algo anda mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110205,
					"content": "Por favor, dibuje la marca que había en ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110211,
					"content": "De acuerdo. Esta no es mi bolsa de monedas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110212,
					"content": "Tanta gente pasa por mi patio trasero, que sería bastante normal que se le cayera a alguien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110213,
					"content": "Es...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110214,
					"content": "¿Qué está pasando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "¡Ah! Me descubriste. Sentí una gran tentación de quedarme con la bolsa de monedas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110216,
					"content": "Ah, Densuke, ¿cómo podría un anciano como tú tener pensamientos tan osados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110217,
					"content": "Algo anda mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "Ya... Ya admití mi deseo de robar el dinero. ¿Qué más podría ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110220,
					"content": "Entonces, se lo entregaré al shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110221,
					"content": "Algo no anda bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110222,
					"content": "Alguien dejó el bolso de monedas a propósito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "¿Qu-qué pruebas tienes... para decir esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110228,
					"content": "La bolsa de monedas es solo una parte. También encontramos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110229,
					"content": "#... ¿Qué más encontramos? Humm, {NICKNAME}, ¡es tu turno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110230,
					"content": "#({NICKNAME}, ¿qué encontramos en el canal?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110231,
					"content": "Alguien dejó esto a propósito en una noche lluviosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "Nada, Paimon solo le dio demasiadas vueltas a la situación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#(¡Imposible! {NICKNAME}, ¿acaso el viejo Densuke solo buscaba Moras?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110225,
					"content": "(Debe estar escondiendo algo, ¿verdad?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110226,
					"content": "Alguien dejó el bolso de monedas a propósito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "Está ocultando algo más.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "Dígame cuántos Moras hay dentro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "Jajaja. ¿Qué clase de pregunta es esa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110208,
					"content": "¿Acaso tú sabes cuántos Moras hay en tu bolsa sin mirar en su interior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110209,
					"content": "Por favor, dibuje la marca que había en ella.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
