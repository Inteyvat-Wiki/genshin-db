			"dialogs": [
				{
					"id": 721110301,
					"content": "Esto es... *ejem*, ¿de dónde lo sacaste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110302,
						721110304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110302,
					"content": "La parte más baja del canal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110306,
					"content": "En fin, no tienes ninguna prueba que muestre que estos dos objetos están relacionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110307,
					"content": "¡Lo están!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110308,
					"content": "¡Es ridículo! ¿Cómo pueden estar relacionados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110309,
					"content": "¿A menos que haya algún tipo de código secreto en los Moras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110310,
					"content": "Los Moras no tienen nada, pero hay algo más que sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110311,
					"content": "Lo encontramos cerca de los restos de una carreta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "Lo encontramos en las ramas del árbol que está en la entrada del pueblo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "¡Eso es imposible! De nada sirve que me pongan a prueba de esa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
