			"dialogs": [
				{
					"id": 761500101,
					"content": "*Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500102,
					"content": "¿Estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "... Sí. Tan solo he tenido una pesadilla muy larga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500104,
					"content": "... Olvídalo. Haz como si no hubiera dicho nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500105,
					"content": "No puedo aguantar más. ¿Por qué siempre me pasan estas cosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500106,
					"content": "¿Por qué a mí?... Primero papá y mamá... y ahora mi hermana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500107,
					"content": "No pasa nada, yo estoy aquí contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "... Sí. No estoy enfadada contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500109,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "Diestrín"
				},
				{
					"id": 761500110,
					"content": "¿Qué es lo que ha recogido Diestrín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500111,
					"content": "Yo lo llamo “fragmento del pesar”. Tal vez sea una forma de salir de la muerte y llegar a la vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500112,
					"content": "Vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "Sí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500114,
					"content": "Ahora que hemos encontrado a Lind, busquemos la forma de salir de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500115,
					"content": "¿Seguro que podemos salir de aquí por nuestra cuenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761500116,
					"content": "Melanta y Nihilita pueden moverse libremente por este lugar, y suelen traer a otras personas consigo. Así que Diestrín también debería ser capaz de hacerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500117,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "Diestrín"
				},
				{
					"id": 761500118,
					"content": "Ya han recogido tres fragmentos del pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500119,
					"content": "Aunque debería decir que solo es un nombre temporal, ya que no sé para qué los usará Diestrín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500120,
					"content": "¿Ahora qué, Diestrín?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500121,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "Diestrín"
				},
				{
					"id": 761500122,
					"content": "Sigamos sus indicaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
