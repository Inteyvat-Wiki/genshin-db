			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490302,
					"content": "¿Tsuyuko...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "Oh, lo siento, estaba sumida en mis pensamientos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490304,
					"content": "Gracias a su ayuda, conseguimos la llave de las profundidades selenitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490305,
					"content": "Qué nombre tan largo... ¿Y para qué sirve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490306,
					"content": "Jaja, la llamaremos simplemente la llave de las profundidades. No podemos pretender que los extranjeros usen los nombres correctos para cada cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490307,
					"content": "Necesitaremos esta llave para abrir la entrada de Enkanomiya. Se forjó con la sangre que derramó nuestro Omikami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490308,
					"content": "... O al menos eso dice la leyenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490309,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490310,
					"content": "Cada vez resulta más misterioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "Jaja, en absoluto, es justo lo contrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490312,
					"content": "Bueno, ahora tenemos que informar a la Sacerdotisa Divina, obtener su aprobación y esperar a que el flujo del espíritu sea el correcto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490313,
					"content": "Después de eso podremos entrar en Enkanomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490314,
					"content": "Un momento, ¿entonces todo lo que hemos hecho hasta ahora...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490315,
					"content": "Bueno, seguramente obtuvieron algo durante el viaje, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490316,
					"content": "#Por ejemplo... ¡obtuvieron la amistad eterna del Santuario Sangonomiya! ¡Siempre serán bienvenid{F#as}{M#os} en la Isla Watatsumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490317,
					"content": "¿Y algo más concreto que eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490319,
					"content": "Según los registros, las perlas espirituales responderán a la llamada de alguien puro, y la llave solo aparecerá ante alguien cuyo corazón sea tan transparente como las aguas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490320,
					"content": "Normalmente no creo en lo que dicen esos textos, pero sí confío en que tú puedes cambiar la situación de la Isla Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490321,
					"content": "Cuando llegue el momento de bajar a Enkanomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490322,
					"content": "Volveremos a encontrarnos, ¿verdad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "Hasta la próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490323,
					"content": "¿Consultarás con los palillos de la fortuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "Jaja, tengo muy buena suerte. Estoy segura de que volveremos a vernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
