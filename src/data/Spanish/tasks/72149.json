			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#Hola, {NICKNAME}. ¿Qué puedo hacer por ti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490202,
					"content": "Es sobre tu encargo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "¡Ya tenemos las cuatro perlas espirituales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490204,
					"content": "¿En serio? ¡Sabía que podía confiar en ustedes! ¡Muchas gracias! Entonces solo falta un paso más para desbloquear el sello final, el “corazón”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490205,
					"content": "Tengan la bondad de acompañarme. Espero que no les importe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490206,
					"content": "#Ya llegamos hasta aquí, no pasa nada por hacer un esfuerzo extra, ¿verdad, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490207,
					"content": "De acuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "No hay tiempo que perder. ¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490208,
					"content": "No es molestia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
			"id": 7214903,
			"completionStepIds": [
				7214906
