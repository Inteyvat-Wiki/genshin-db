			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeño Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#¡{NICKNAME}! ¡Llegas justo a tiempo, quería preguntarte algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280102,
					"content": "¿Qué sucede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Mi padre dice que el camino a Sumeru es muy largo y que vamos a necesitar algunos medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280106,
					"content": "Para el dolor de cabeza, la diarrea, la insolación... para la resaca, la digestión... La lista es interminable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280107,
					"content": "¿Por qué necesitan medicinas para la resaca?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "Para las reuniones de negocios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "¿Eh? ¿Qué tienen que ver los negocios con la resaca? ¿Acaso el negocio será más exitoso si beben más?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "Como sea, papá quiere que vaya a la Farmacia Bubu a preguntar si las medicinas ya están listas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280111,
					"content": "#¿{NICKNAME}, me acompañas? Hay algo con lo que me gustaría que me ayudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280112,
					"content": "Vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "¡Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280113,
					"content": "¿Con qué necesitas ayuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Te lo diré cuando lleguemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280103,
					"content": "¿Cómo van los preparativos para el viaje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Papá y sus amigos están preparando todo... ¡pero papá me dio unas tareas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
		{
			"id": 2102802,
