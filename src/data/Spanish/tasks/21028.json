			"dialogs": [
				{
					"id": 210280401,
					"content": "#¡Gracias, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280402,
					"content": "Bien, esto será suficiente para preparar más medicinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280403,
					"content": "Estos medicamentos para la insolación los enviaré en el próximo lote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280404,
					"content": "¡Gracias por la ayuda, Gui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280405,
					"content": "#Esto es para ti. Gracias por ayudarme, {NICKNAME}. Vamos, hay que regresar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280406,
					"content": "Jeje, cuando papá se entere, se pondrá feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280407,
					"content": "¡Meng, espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280408,
					"content": "¿Qué pasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280409,
					"content": "¿No ibas a revisar las medicinas? No has terminado con la lista de atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280410,
					"content": "¿Eh? ¿Qué? Pero ya revisé bastante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280411,
					"content": "Y todavía hay más. Vamos, vamos, a seguir revisando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280412,
					"content": "Ay... Está bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
