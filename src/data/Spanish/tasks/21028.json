			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herborista Gui",
					"Pequeño Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Bienvenidos, ¿buscan algún remedio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280202,
					"content": "¿Eh? ¿Meng? ¿Qué te trae por aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280203,
					"content": "Ah, ya sé. Vienes por las medicinas, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280204,
					"content": "Descuida, ya casi están listas. Se las enviaré a tu padre por partes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280205,
					"content": "Tu papá pidió tantas medicinas que la tienda se está quedando sin hierbas, así que algunas tardarán más en prepararse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280206,
					"content": "Déjame revisar. Humm... Lo que menos tenemos es menta, eso quiere decir que por ahora no podemos producir más medicinas para la insolación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280207,
					"content": "Después de todo, además de atender el pedido de tu padre, también tenemos otros pedidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280208,
					"content": "Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280209,
					"content": "Mi momento ha llegado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#Jeje, ¡gracias, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280213,
					"content": "Entonces cuento contigo para conseguir esas hierbas. Mientras tanto, me quedaré aquí revisando las medicinas. ¡Eso es lo que papá me dijo que hiciera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280214,
					"content": "Pero qué niño más obediente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280215,
					"content": "Ven conmigo. Te mostraré los detalles de este lote de medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280216,
					"content": "¡Guau! Son muchísimos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280217,
					"content": "Primero revisa estos. En un momento iré por el siguiente lote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280218,
					"content": "¿Eh? ¡¿Hay más?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeño Meng"
				},
				{
					"id": 210280211,
					"content": "Espero que me paguen por esto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "¡Jeje, no te preocupes! ¡Gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Pequeño Meng"
				}
			]
		},
