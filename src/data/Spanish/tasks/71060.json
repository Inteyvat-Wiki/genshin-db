			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "¿Qué pasa? ¿Vienes a perturbar mi descanso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591102,
					"content": "¡No, solo queremos hablar contigo porque estás sola aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591103,
					"content": "Es aburrido beber sola, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "... ¿Ah, sí? Gracias. Ustedes... me recuerdan a esa chica, Lyudochka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591106,
					"content": "También era muy apasionada... Siempre se pegaba a mí y me hablaba de cualquier cosa... Muchas veces solo lo hacía conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591107,
					"content": "Oh, si tan solo Lyudochka estuviera aquí... Es una persona tan divertida, te encantaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591108,
					"content": "¿Lyudochka? ¿Quién es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "Es... una amiga mía que parece seria, pero que en realidad es una tontita divertida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591110,
					"content": "Estábamos unidas como hermanas cuando vivíamos en la Casa de la Hoguera... Le gustaba hacerme bromas pero también se preocupaba por mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591111,
					"content": "Jaja, de todas formas, tengo la sensación de que le va bien por ahí. Cada vez que pienso en eso, todas las heridas que he sufrido en este infierno de repente se sienten insignificantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591112,
					"content": "Espero que cumpla su misión... Y que no piense en mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591113,
					"content": "Lyudochka... ¿Te refieres a la que está en Inazuma...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591115,
					"content": "¿Estás diciendo que la desenmascararon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591116,
					"content": "Eh... ¿Cómo lo sabes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591117,
					"content": "Ella... encontró una manera de salvarse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "¿En serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591120,
					"content": "Jaja... Eso es bueno. Espero que esté haciendo un buen trabajo en su misión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591121,
					"content": "Pero si está desafiando la voluntad de Su Majestad para vivir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591122,
					"content": "... Espero que no se acuerde de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591118,
					"content": "Todavía está viva y se encuentra bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "Hemos venido especialmente para hablar contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
