				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "Oh, ya volvieron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370302,
					"content": "El Tío He dejó estas notas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "¡Así que dejó algo después de todo! Vamos, cuéntame qué es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370306,
					"content": "Le cuentas a Jinwu acerca de lo que encontraste.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Humm... ¿“Lava negra”? ¿Roca lumínica? ¿Hongos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370305,
					"content": "Oh, no... Es una mala señal... Una mala señal que me es muy familiar. No podemos quedarnos aquí, vayamos al campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
						],
						"stepId": 7103711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Es aquí... Qué extraño, ¿dónde está Zhichiong? Esa jovencita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "¡Zhichiong! ¡Zhichiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "*Suspira*... Bueno, debe de estar por ahí dibujando más mapas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "¿Ocurre algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "Justo cuando se fueron terminó de dibujar este mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "Es probable que haya ido a explorar más profundamente algún lugar. Díganle que debería dejar de abandonar a los demás para irse por ahí ella sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "Si vuelve a causarle problemas a alguien, ¡yo sí que le daré motivos para que se preocupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "¡Ay! Qué miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "Sí, qué miedo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "#¿Y bien? ¿Qué hacen aquí parad{F#as}{M#os}? O me ayudan a instalar el campamento, o van a explorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Lo siento, no soy muy buena con las palabras, pero al menos puedo ser de utilidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "Por cierto, si en el camino encuentran rocas lumínicas en bruto, tráiganmelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "Pensaré en alguna forma de transformarlas en un canalizador más eficiente. De acuerdo a mi experiencia, les será de gran ayuda aquí abajo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "¿Zhichiong está en peligro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Aún no... ¡Pero estará en peligro la próxima vez que se vaya por ahí sin avisarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103705,
			"completionStepIds": [
				7103713
			],
