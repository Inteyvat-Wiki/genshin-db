					"content": "Gracias por ayudarme. Por favor, toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370602
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370602,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370603
					]
				},
				{
					"id": 710370603,
					"content": "#Jaja, vamos, no seas tan modest{F#a}{M#o}. Después de todo, ¡es Khedive quien paga! ¡Pero baja la voz! No dejes que ese tacaño de Sumeru nos escuche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370604
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370604,
					"content": "*Ejem*... En fin, ¿deberíamos buscar a Jinwu? Podemos aprovechar su vasta experiencia para encontrar respuesta a las dudas que surgieron en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370607
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370607,
					"content": "Está bien, ya no te retendré aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				}
			]
		},
