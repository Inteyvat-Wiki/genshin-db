			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#Ah, {NICKNAME} y compañía, ¡han vuelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu tiene un mensaje para ti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "¿Otra vez ese sermón de “andarse con cuidado”? *Suspira*... Lo he escuchado hasta la saciedad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370504,
					"content": "Yo crecí en las minas, ¿crees que hay algún peligro que no conozca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370505,
					"content": "Y para las cosas que no conozca... Mis superiores siempre se basaban en su experiencia para determinar si era peligroso o no... Y si obtenían algún resultado, era prueba de su experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370506,
					"content": "#Estoy harta de su arrogancia. Tú eres {F#una aventurera}{M#un aventurero}, así que también debes estar molest{F#a}{M#o}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370507,
					"content": "Imagina que la Srta. Iris advirtiera sobre los peligros de Espinadragón y todos los superiores le hicieran caso. ¡Entonces nadie se atrevería a adentrarse a la montaña y se habrían perdido muchas aventuras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370508,
					"content": "Está bien, no hace falta que me lo repitas. No pienso discutir con mis superiores por algo tan insignificante. Mejor cambiemos de tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370509,
					"content": "Mira, he estado explorando la topografía para dibujar un mapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370512,
					"content": "Es solo que... antes, al explorar los túneles, noté que algunas áreas estaban bloqueadas por algo extraño...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370513,
					"content": "Si pudieras obtener una muestra o capturar una imagen, el Ministerio de Asuntos Civiles y el Gremio de Aventureros te lo agradecerían.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370514,
					"content": "Me avergüenza decirlo, pero... mientras bajaba a la mina dejé caer mi Daguerrotipo por accidente, ¡así que confío en tu buen ojo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370515,
					"content": "Hay otros lugares... aquí... y aquí. Encontré rastros de los Ladrones de Tesoros en estos lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370516,
					"content": "¿En dónde, en dónde? Paimon no entiende nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Son solo unas cruces y unas líneas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Jaja, lo siento, es la costumbre. Olvidé que no todos tienen la intuición de un cartógrafo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370519,
					"content": "#En fin, no importa. L{F#as}{M#os} acompañaré para indicarles el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370520,
					"content": "Podemos comenzar por cualquiera de las ubicaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370521,
					"content": "En ese caso, vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Ten cuidado en el camino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Lo sé, lo sé. ¡Gracias por tu preocupación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710370510,
					"content": "¿Qué haces aquí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "¿No fui clara? Estoy explorando la topografía del lugar para dibujar un mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhichiong"
				}
			]
		},
