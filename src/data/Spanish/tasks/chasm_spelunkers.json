			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhichiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710371101,
					"content": "Gracias por ayudarme. Por favor, toma esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710371102,
					"content": "Gracias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "#Jaja, vamos, no seas tan modest{F#a}{M#o}. Después de todo, ¡es Khedive quien paga! ¡Pero baja la voz! No dejes que ese tacaño de Sumeru nos escuche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710371104,
					"content": "*Ejem*... En fin, ¿deberíamos buscar a Jinwu? Podemos aprovechar su vasta experiencia para encontrar respuesta a las dudas que surgieron en el camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710371105,
					"content": "#A Jinwu no le gusta mencionarlo, pero, igual que tú eres famos{F#a}{M#o} por tus hazañas en Espinadragón, en sus años de juventud ella también era una leyenda aquí en las minas. *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710371106,
					"content": "Escuché que ella guio al equipo de rescate de la Geoarmada, y juntos salvaron la vida de muchos mineros... Jaja, mejor no hablaré de cosas del pasado, o al final se enfadará conmigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "Zhichiong"
				},
				{
					"id": 710371107,
					"content": "Está bien, no te retendré más aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhichiong"
				}
			]
		}
	]
}