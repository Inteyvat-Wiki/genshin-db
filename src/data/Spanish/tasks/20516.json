						205160503
					]
				},
				{
					"id": 205160503,
					"content": "¡Ah! Qué susto. ¿Cómo me encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160504,
					"content": "Pensé que nadie me encontraría aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "Ah, ya sé. Seguro que la hermana Grace te dijo dónde estaba. Siempre está por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "Muchas de las medicinas que tomo me las da ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "Es muy buena persona, pero es que... Yo no quiero estar en Mondstadt para siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160508,
					"content": "Sí, ya sé que mi hermano me está buscando. Ahora mismo bajo. No quiero que mi hermano se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
