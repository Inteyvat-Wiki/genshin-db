			"dialogs": [
				{
					"id": 205160201,
					"content": "Así que desde aquí sí se puede ver toda Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160202,
					"content": "Ten cuidado de no resfriarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "¡Ah! Qué susto. ¿De dónde saliste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "Seguro que mi hermano me está buscando de nuevo. Jeje, sabía que aquí no me encontraría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "Sí, sí, ya sé. Espera y ahora bajo yo sola. No quiero que se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
