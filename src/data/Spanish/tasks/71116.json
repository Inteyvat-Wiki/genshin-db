			"dialogs": [
				{
					"id": 711160801,
					"content": "#¡El viaje mereció la pena! Además de capturarlos, también tuvimos la oportunidad de ver {F#a la}{M#al} célebre viajer{F#a}{M#o} en acción. ¡Qué grata sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160802,
					"content": "¿Nos conocen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "#Pues claro, viajer{F#a}{M#o}. Mi familia en Liyue me ha hablado mucho de ustedes, así que l{F#a}{M#o}s reconocí a primera vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160804,
					"content": "Pero había demasiada gente, así que temía que alguien se enterase y este tipo se escapase. Lamento mucho no haber sido completamente sincera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160805,
					"content": "¡Así que no nos topamos con los negocios ilegales de una banda, sino con una operación de la Geoarmada para atrapar a unos malhechores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "Jaja, así es. Llevábamos un tiempo pisándoles los talones a esos tipos. Hace poco recibimos ayuda y por fin conseguimos infiltrarnos en la banda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160807,
					"content": "Estuvimos esperando alrededor de un mes, y hoy se presentó la oportunidad de atrapar de una vez por todas a los Sal de Hierro y a esos peces gordos de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160808,
					"content": "#Ni lo menciones. Hemos estado a punto de acabar muy mal, esos tipos de Fontaine no tienen escrúpulos. Menos mal que {F#la}{M#el} viajer{F#a}{M#o} acudió a nuestro rescate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160809,
					"content": "#En fin... Viajer{F#a}{M#o}, me temo que no voy a poder cumplir la promesa que les hice, pero aquí tengo algunos Moras. Acéptenlos, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160810,
					"content": "Si alguien ayuda a los demás, debe ser recompensado. Todos debemos respetar ese acuerdo, de lo contrario, cada vez habrá menos gente dispuesta a echar una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160811,
					"content": "Bueno, tenemos que ir a ocuparnos de unos asuntos pendientes. No les haremos perder más tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160812
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160812,
					"content": "¡Que tengan un buen viaje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bote de Hierro"
				}
			]
		},
