			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dama de Hierro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2083.502,
							359.483,
							2715.594
						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Camaradas, lo que ustedes hicieron por mí no se puede pagar con un simple “gracias”. Si necesitan algo más, avísenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160203,
					"content": "¡Vaya, qué muchacha tan educada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "#Iré al grano: ando un poco apretad{F#a}{M#o} últimamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "¿Necesitas Moras? Jaja, podemos hablarlo, aunque va a estar complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160206,
					"content": "El mandamás se llevó todas nuestras Moras. Aquí no queda nada de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160210,
					"content": "¿El mandamás?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Sí, es el líder de nuestra banda, los Sal de Hierro. Está bajo el acantilado tratando algún chanchullo con unos tipos de Fontaine. Nosotros nos hemos quedado aquí para vigilar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160212,
					"content": "Tú también lo viste hace un momento, ¿verdad? ¡Esas ratas de Fontaine aprovecharon que el mandamás estaba hablando para venir y atacarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160213,
					"content": "¡Aaaah! ¡Vinieron a patearles los traseros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Maldita sea, ¿acaso nos tomaron por idiotas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160216,
					"content": "Ahora estamos con el agua hasta el cuello, y quizás también vayan a atacar al mandamás. Ya que se ofrecieron a ayudar, colaboren hasta el final, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160217,
					"content": "#Si el mandamás sale sano y salvo, les aseguro que luego vivirán como {F#reinas}{M#reyes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160218,
					"content": "¿Dónde? Iré a echar un vistazo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "En la playa bajo el acantilado. Si van, seguro que alcanzan a verlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160220,
					"content": "#Amig{F#as}{M#os}, vayan ustedes primero. Yo iré en cuanto lo deje todo limpio por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160207,
					"content": "Tan solo se trata de ayudar a quien lo necesita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "¡Su sentido de la justicia es digno de admiración! En ese caso, hay algo que quiero decirles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160209,
					"content": "Es posible que el mandamás también esté en apuros y necesite ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Dama de Hierro"
				}
			]
		},
