			"dialogs": [
				{
					"id": 711160601,
					"content": "¡Muchísimas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160602,
					"content": "¡No hay de qué! ¡Los acuerdos siempre hay que respetarlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Jeje, tienes toda la razón. Pero, en ese caso, parece que ustedes están al tanto de nuestro negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160604,
					"content": "Nos lo dijo Dama de Hierro. Ella dijo que ustedes se dedican a hacer “negocios” o algo así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "¿Qué significa exactamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "No parece que se estén refiriendo a transacciones legales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "En ese caso tendremos que darles las gracias como es debido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160608,
					"content": "#¡Muchachos! ¡Átenl{F#as}{M#os} bien y arrójenl{F#as}{M#os} al mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160609,
					"content": "#Acuérdense de ponerles piedras. ¡Nosotros, los Sal de Hierro, estamos en deuda con ell{F#as}{M#os}, así que les daremos una muerte rápida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160610,
					"content": "¡¿Qué?! ¿Q-qué pretendes hacernos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "#Pero si hace un momento ustedes mism{F#as}{M#os} lo dijeron, pensé que lo tenían muy claro. En Liyue siempre respetamos los acuerdos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160612,
					"content": "#Si arruinan los negocios ilegales de una banda, es natural que sean silenciad{F#as}{M#os}. Es un acuerdo universal, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160613,
					"content": "¡¿De qué estás hablando?! ¡¡Devolver los favores con ingratitud sí que es incumplir un acuerdo universal!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "No desperdicien mi amabilidad. Si voy yo, sabrán lo que es sufrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160615,
					"content": "¿Sabes quién soy yo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "¡Déjate de tonterías! ¡Dama de Hierro! ¡Bote de Hierro! ¡¿A qué están esperando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160618,
					"content": "Brillo de Hierro, eres tan injusto como siempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160619,
					"content": "No permitiremos que alguien como tú siga haciendo de las suyas en Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160626,
					"content": "¡Vamos, muchachos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160620,
					"content": "¿Q-qué?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160621,
					"content": "¡Brillo de Hierro! ¡Abre bien los ojos, sabandija! ¡¿Sabes quiénes somos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Dama de Hierro"
				},
				{
					"id": 711160622,
					"content": "¡¿L-la Geoarmada?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160623,
					"content": "¡Oye! ¡¿Qué está pasando aquí?! ¿Cómo es posible que de repente...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Creí que eran recién llegados. Nunca imaginé que en realidad eran escoria de la Geoarmada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160625,
					"content": "¡No se piensen que me voy a rendir! ¡Voy a defenderme con uñas y dientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160616,
					"content": "¡Oh! ¡Qué miedito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
