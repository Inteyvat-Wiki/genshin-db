			"dialogs": [
				{
					"id": 711160401,
					"content": "Johnnie, somos buenos amigos. Sé que últimamente la suerte no está de su lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160402,
					"content": "Si tienes algún problema, dímelo a la cara. ¿Quién me iba a decir que así serían las cosas? Todo esto me supera un poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160403,
					"content": "Como sabrás, nuestro negocio no va tan bien como antes. Spina di Rosula son los que mandan ahora, así que muchos de nuestros chanchullos se fueron al traste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "Ahora somos unos muertos de hambre. Como esto siga así, me temo que no vamos a hacer ni un Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "Nuestro negocio tiene potencial y es razonable. Si nos dan una... oportunidad para que les demos las gracias en el futuro, podrán comprobar por ustedes mismos que nosotros somos gente de fiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "Y si no... Jaja, ¿no dicen que hay muchos peces en el mar? Señor Brillo de Hierro, ¡ustedes no tienen problemas para hacer amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "Johnnie, ¿ese es tu precio? ¿Eso es lo que me quieres decir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160408,
					"content": "¿Acaso hay algún problema con el precio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "¿Estás bromeando? ¡¿No ves que eso es una miseria?! ¡¿A qué vienen tantas idioteces?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160410,
					"content": "Charlatán, ¡eres un charlatán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160411,
					"content": "Johnnie, a los Pesci les vendo una caja por 58 000, y a los De Niro se la vendo por 70 000. No hace falta que te diga la fama que tienen en el Puerto Lumidulce, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160412,
					"content": "A ti te vendo tres cajas por 100 000, e incluso te mando a alguien para la entrega y recogida... ¿Por qué? Lo hago porque valoro tu amistad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160413,
					"content": "En fin, basta de cháchara... ¡Johnnie, confío en que te lo pensarás! ¿Por qué no nos sentamos a beber y a charlar un rato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160414,
					"content": "Jeje, no es necesario. Sé muy bien que en Liyue dan mucha importancia a que los acuerdos sean justos. Pero no pensaba que algo como la amistad podría estar por encima de lo que es justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "¡Jeje, Johnnie! ¡Mis muchachos deberían aprender de tu respeto por los acuerdos, jaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160416,
					"content": "Lo único que quiero es comprobar el respeto que muestran por este acuerdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160417,
					"content": "¡Sí, claro! Lo que dices tiene todo el sentido del mundo. El antiguo acuerdo de Liyue es digno de admiración. Parece que tendré que demostrar mi respeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker, ¿qué te parece si subimos el precio de todos los artículos... una Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "Me parece perfecto, señor Johnnie. La gente de Liyue trabaja sin descanso, así que es lógico que reciban una Mora por cada artículo como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "¡Ratas de Fontaine! ¡¿Qué rayos quieren decir con eso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160421,
					"content": "Amigos, ¿aún no son conscientes de nuestra sinceridad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "Johnnie, ¿estás decidido a incumplir el acuerdo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160423,
					"content": "¿Qué? ¿En serio? Walker, ¿eso es lo que piensas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Señor Johnnie, en mi opinión...ya que hay tantos peces en el mar, los pezqueñines deberían ir con más cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "Walker, eres una vergüenza. ¿Cómo puedes faltarle así el respeto a nuestros amigos de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "Después de todo, vamos a hacernos con su territorio. ¿No deberíamos estarles agradecidos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Lo siento, señor Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "¡Malditos desgraciados! Así que eso es lo que se traen entre manos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160429,
					"content": "¿Qué necesidad hay de insultar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "¿Oh? ¿Quiénes son ustedes dos?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "#Jeje, qué interesante. ¿Tod{F#as}{M#os} l{F#as}{M#os} niñit{F#as}{M#os} en Liyue tienen tantas agallas? Walker...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "#¡Oye! ¿De dónde salieron est{F#as}{M#os} niñat{F#a}{M#o}s? ¡Tomen unos Moras y lárguense a comprarse leche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "¡Oye! ¡¿Cómo pueden tener tan pocos modales?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "¿Quiénes son ustedes?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160435,
					"content": "#Venimos a que nos traten como {F#reinas}{M#reyes}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "¡Jajajaja! Ya veo... ¿El señor Brillo de Hierro les pidió ayuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "¿También estaba tramando algo contra nosotros, señor Brillo de Hierro? ¡*Tch*! Nos los veíamos venir. ¡Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "¡Hermanos, salgan! ¡Llegó la hora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Bote de Hierro"
				},
				{
					"id": 711160441,
					"content": "Oh, oh. Pero ¿qué pasa? Me parece que nosotros somos más, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "Lo siento mucho, señor Brillo de Hierro. Les encargué unos trabajillos a mis hombres. Ya deberían haberse ocupado de la gente que dejó en el campamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "Quédese tranquilo, nosotros nos encargaremos de su negocio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "Johnnie... ¡No te resultará tan fácil deshacerte de nosotros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Brillo de Hierro"
				},
				{
					"id": 711160445,
					"content": "¡Veamos de lo que eres capaz, ya que tanto te gusta hablar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "Vinimos a llevarlos a comprar leche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
