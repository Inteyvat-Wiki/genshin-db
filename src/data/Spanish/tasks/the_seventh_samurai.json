						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540201,
					"content": "Por Los Siete, parece que esta kinografía no salió tan bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540202,
					"content": "#Por favor, intentémoslo de nuevo cuando estés list{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215403,
			"completionStepIds": [
				7215403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215403",
							"2"
						],
						"stepId": 7215403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "#¡Perfecto! Como era de esperar de mi {F#heroína}{M#héroe}. ¡Excelente actuación, eres toda una estrella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540302,
					"content": "¿Una... qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "#¡Una estrella! Es decir, {F#la actriz}{M#el actor} más importante de una kinografía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540306,
					"content": "#De acuerdo, señor soldado, viste la demostración {F#de la viajera}{M#del viajero}, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540307,
					"content": "Tengo una idea general. Al blandir la espada, no debo enfocarme mucho en la acción, sino en la postura, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540308,
					"content": "Si solo se trata de la postura, tengo un par de ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540309,
					"content": "¿Eh? ¡Maravilloso! Puedes discutir tus ideas con los demás soldados. En unos momentos haremos una nueva toma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540310,
					"content": "#Viajer{F#a}{M#o}, tienes mi más sincero agradecimiento. Toma, esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540311,
					"content": "¿Cuál es el título de tu próxima kinografía?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "¿La siguiente kinografía? Humm... No me he decidido por el tema aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540313,
					"content": "¿Deberíamos hacerla sobre las tradiciones del Gran Santuario Narukami? ¿O sobre los cuentos de los kitsune y los tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540314,
					"content": "¡Hay tantas islas en Inazuma, y tantas historias que contar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540315,
					"content": "Aun así, primero tengo que terminar «El séptimo samurái».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540316,
					"content": "Si satisface a la gente de arriba, supongo que mis próximas obras irán viento en popa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540304,
					"content": "Me gustaría cambiar de papeles a la próxima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "¡No hay problema! Una vez que terminemos con una kinografía, podemos comenzar a planear la siguiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
