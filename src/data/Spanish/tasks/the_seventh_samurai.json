			},
			"dialogs": [
				{
					"id": 721540801,
					"content": "¿Qué capturas en una “kinografía”?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "¡Ajá! Buena pregunta, muy buena. Para ser franco, es una pregunta que yo mismo me hago a veces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540803,
					"content": "Creo que una “kinografía” puede ser sobre cualquier cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540804,
					"content": "¡Romance, suspenso, combate! Incluso cualquier tipo de leyendas fantásticas puede ser el tema de una kinografía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540805,
					"content": "Aunque debo decir que la belleza de la kinografía no ha salido a relucir aún.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540806,
					"content": "Aun así, estoy convencido de que encontraré la respuesta a nuestra pregunta siempre y cuando continúe haciendo kinografías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
