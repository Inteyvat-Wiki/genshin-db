	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "¡Espera! Soldado, leíste esa línea sin ningún tipo de emoción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "“Un samurái es como un viento que barre la tierra”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "¿Aún recuerdas lo que dije sobre la obra? Se supone que debe ser liberadora y, al mismo tiempo, transmitir la sensación de lo dura que es la vida. ¡Dije liberadora! Liberadora, ¿entiendes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "Esta línea es la clave de toda la obra. ¡Debes expresar tus emociones de forma plena y perfecta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "Además, al blandir la espada, no lo hagas tan rápido. Debes asegurarte de estar dentro del ángulo de filmación. De lo contrario, el kinetoscopio no podrá filmarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "Posa y luego haz una pausa, ¿de acuerdo? Detente un momento, y luego da un golpe con la espada hacia abajo y con mucha fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "Pero la espada nunca se blande así al luchar contra otras personas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "Es cierto, pero tienes que adaptar tu actuación a las necesidades de la producción.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "Inténtalo de nuevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "¿Qué hacen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#¡Ah, eres tú! Ah, viajer{F#a}{M#o}, ¿qué clase de viento te trajo hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "Como puedes ver, estoy filmando una kinografía de capa y espada con nuestro buen soldado. La llamo «El séptimo samurái».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "“Kinografía de capa y espada”, así es como llamo a las kinografías de este género.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "Este tipo de kinografías tendrá escenas de lucha con espadas, y llevará a los espectadores a través de un increíble viaje por el campo de batalla... Bueno, ¡al menos esa es la idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "¿Toranosuke tiene tiempo para esto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "Nuestros superiores aprobaron esta actividad. Según ellos, contribuirá a aumentar el prestigio del shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "Dicho esto, no tengo la más mínima idea de cómo hizo el Sr. Xavier para convencerlos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "A decir verdad, el Sr. Mikoshi Genjirou es un hombre muy... serio. Afortunadamente, también es muy comprensivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "Después de hablar sinceramente con él, aceptó mi petición con mucho gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "Pero... A cambio, tengo que hacer una kinografía que tenga que ver con el shogunato, preferiblemente con un samurái como protagonista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "No obstante, siempre me interesaron este tipo de temas, así que, obviamente, acepté. El Sr. Mikoshi Genjirou también estaba muy satisfecho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "Además de designar personalmente a este buen soldado para que me acompañara, también me asignó algunas tropas cualificadas, y luego dijo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "“Muestra la majestuosidad de los samuráis y del shogunato con unas escenas de choques de espadas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "Debo decir que el Sr. Genshirou realmente es un hombre con visión. Logró captar rápidamente el potencial de las kinografías como herramienta promocional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "Y, en cuanto a mí, nunca rechazaré nada que me ayude a hacer mis kinografías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "¿La producción va bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "Para ser sincero, no va tan bien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "Aunque estos soldados son muy hábiles en las artes marciales, no están acostumbrados a este tipo de lucha actuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "Sus movimientos de espada no solo son demasiado rápidos para grabarlos con el kinetoscopio, sino que a veces corren tan rápido que escapan de su alcance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "#Viajer{F#a}{M#o}, si tienes un momento, ¿te importaría seguir mi guion y representar la historia para que lo vean los soldados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "Creo que, con tu fuerza y comprensión, serás capaz de dar una actuación ejemplar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "Si te observan como espectadores, deberían ser capaces de comprender mejor la trama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "Bien, primero lee el guion y las líneas. Esta parte es principalmente de lucha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "“Perdimos la batalla”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "Ah, esa línea es de otra escena... Esta es principalmente de lucha, así que no hay mucho diálogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "Déjame echar un vistazo al guion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "Por cierto, interpretarás el papel de “Juusaburou”. Junto con varios compañeros, los aldeanos lo contratan para proteger su pueblo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "En esta escena, uno de tus compañeros, “Kyuuzou”, tiene algunas líneas... Yo interpretaré su papel, y los dos haremos una lectura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "Ahora, debes dejarte absorber por el papel, ¡comprenderlo! Piensa que realmente eres Juusaburou. ¿Entiendes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "Entiendo, director.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "¡Maravilloso! ¡Espléndido! ¡Bravo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "Avísame cuando quieras empezar. Tengo que ajustar la posición del kinetoscopio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "¡Yo soy Juusaburou!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "“El samurái conserva su esencia incluso cuando está en peligro”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "“Todos ustedes son unos espantapájaros cualificados...”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "“Pero nuestros enemigos no son pinzones...”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "¿Te importa si hago un papel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#¡Por supuesto! ¡Por supuesto! Al fin y al cabo, ¡siempre serás {F#una}{M#un} {F#heroína}{M#héroe} para mí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "Siempre recordaré nuestra actuación en «Cuentos de Tatarasuna».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "Aunque estos soldados son muy hábiles en las artes marciales, no están acostumbrados a este tipo de lucha preparada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "Sus movimientos de espada no solo son demasiado rápidos para grabarlos con el kinetoscopio, sino que a veces corren tan rápido que escapan de su alcance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "¿Cómo lo convenciste para que te ayudara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Vamos, nuestro querido soldado me entendió a la perfección. Mi trabajo principal, en realidad, era persuadir al Sr. Mikoshi Genjirou para que me permitiera filmar una kinografía en Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "“Un samurái es como un viento que barre la tierra”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "¡Qué forma tan apasionada de pronunciar esas palabras! ¿Pero quién...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
