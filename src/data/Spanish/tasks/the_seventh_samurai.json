			},
			"dialogs": [
				{
					"id": 721540401,
					"content": "Una “kinografía de capa y espada”... Sr. Xavier, tiene un gusto particular para los títulos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "¿Qué te parecen estas kinografías?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Nuestros superiores creen que ayudarán a promover el prestigio del shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Quizás soy un poco lento para entenderlo, pero yo no lo veo así.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "El guion está repleto de líneas pesimistas, no tiene nada que ver con la dignidad de un samurái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "¿En qué estaban pensando al momento de aceptar algo así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "¿Cómo va todo en la Fragua Mikage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Desde que el Sr. Hanbei fue “promovido”, Yousuke tomó su puesto como responsable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "Es un artesano de nacimiento, tiene los pies sobre la tierra, y arregla los problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Bajo su mando, dudo que la Fragua Mikage tenga más problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
