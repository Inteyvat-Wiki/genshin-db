			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "Déjame pensar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Oye... Bueno, está bien. Piénsalo un poco. Quizás mi oferta no sea la mejor que hayas escuchado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Pero, tratándose de negocios, si me vendes el anillo, te garantizo que será un buen trato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Piénsalo. Este anillo no dejará de cambiar de manos conmigo. Si me lo vendes ahora, ¿no crees que te dejaré entrar en más transacciones que se realicen en el futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "Además, estoy dispuesto a añadir algunos complementos para compensarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Piénsalo con calma y vuelva a consultarme cuando quieras si decides venderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
