					"content": "“Todos los disturbios del mundo tienen su raíz en el vicio humano...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050102
					],
					"speakerTitle": "Inscripción"
				},
				{
					"id": 710050102,
					"content": "“Erigimos aquí nueve pilares para suprimir el conflicto, para que nunca más levantemos las armas unos contra otros...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscripción"
