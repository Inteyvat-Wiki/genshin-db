					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "¡Maravilloso! Eres una persona muy decidida. Aquí está el dinero. Es tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050403,
					"content": "Ah, este anillo es un verdadero tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Debe haber otras gemas similares dentro de esas ruinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
