					"id": 710050801,
					"content": "Respecto a ese anillo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050802
					]
				},
				{
					"id": 710050802,
					"content": "¿Y bien? ¿Ya lo pensaste? ¿Lo venderás, o no?",
