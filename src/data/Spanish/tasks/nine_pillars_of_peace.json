			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "“Avaricia, nostalgia, visión, celos, ira, lujuria, delirios de grandeza, competencia, caos...”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Inscripción"
				},
				{
					"id": 710051202,
					"content": "“Estos nueve deseos mortales pueden curar al mundo, o causarle un gran daño. Su fuego nunca se extinguirá, y nunca se desvanecerá... Por lo tanto, colocamos nueve pilares para traer la paz, para poner fin aquí a los conflictos que azotan a este mundo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Inscripción"
				},
				{
					"id": 710051203,
					"content": "“Si las próximas generaciones rompen esos pilares e irrumpen en este recinto, la guerra consumirá una vez más al mundo”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Inscripción"
				},
				{
					"id": 710051204,
					"content": "“Oh, tú que lees esta estela, reclama el tesoro que hay dentro y trae la paz a Liyue”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscripción"
				}
			]
		},
