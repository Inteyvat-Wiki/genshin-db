			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "¿Podrías darle un vistazo a esta antigüedad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "¿Una antigüedad? ¡Has venido a la persona correcta! Diría que soy la mejor para evaluar este tipo de objetos en toda Liyue. Veamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Tanto la gema como la sortija son de excelente calidad, son muy antiguas... y están muy bien preservadas. Es algo muy inusual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Pero nunca he escuchado la frase, “En una guerra, todos los seres sufren”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "En fin, ¿en dónde encontraste este anillo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "En unas ruinas cerca de la Pendiente Tsuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "#Debes ser buen{F#a}{M#o} en esto, no muchos se atreven a ir ahí a buscar tesoros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "¿Esas ruinas estaban rodeadas por nueve pilares con una estela de piedra en su centro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "No te sorprendas. He escuchado a muchas personas que vienen a hacer negocios conmigo mencionar ese lugar. Siempre dicen que una formación tan grande debe tener algún tipo de tesoro adentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Incluso dicen que esos pilares y esas ruinas fueron construidos por los antepasados de Liyue para poner fin a un conflicto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Pero supongo que es solo una leyenda. Después de todo, si nueve pilares de piedra pudieran acabar con un conflicto, hace mucho tiempo que este mundo estaría en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Pero independientemente de si esta leyenda es cierta o no, si encontraste este anillo en las ruinas, debe estar relacionado con la leyenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Tiene un nombre, una historia que lo acompaña, y también es de buena calidad. Tendrá un buen precio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "... Relájate, no voy a preguntarte cómo llegaste allí. Solo hago negocios. Otros asuntos no son de mi incumbencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Con todo, diría que este anillo vale <color=#00E1FFFF>200 000 Moras</color>. ¿Qué dices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
