			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "¿Podrías darle un vistazo a esta antigüedad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "¿Antigüedades y curiosidades? No estoy muy familiarizado con ellas, pero le echaré un vistazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Veamos... Este anillo tiene una gema incrustada. ¡Y no es cualquier gema! Por sí sola debe valer una suma significativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "También hay una inscripción... “En una guerra, todos los seres sufren”... ¿En dónde encontraste este anillo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "En unas ruinas cerca de la Pendiente Tsuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "¿La Pendiente Tsuijue? *Tch tch*, qué pena. Estando tan cerca el Desfiladero Jueyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Si este anillo proviniera del Desfiladero Jueyun, seguramente valdría una fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Desafortunadamente, sin ningún origen histórico, su precio se devalúa mucho. Pero es de buena calidad, estoy seguro de que alguien lo querrá de todos modos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "¿Qué te parece esto? Te ofreceré <color=#00E1FFFF>180 000 Moras</color> por este anillo, además de algunos complementos. ¿Me lo venderías?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
