					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "Llegaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650102,
					"content": "Colombina... Estás aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "#Sí. Y ahora tú también estás aquí. Así que estamos aquí junt{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650104,
					"content": "Lo dices como si supieras que vendría.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "No sabía cuándo. Pero sabía que acabarías viniendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650106,
					"content": "Es como la atracción que une a la Luna con Teyvat. Siempre logras encontrarme, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650107,
					"content": "Ven, siéntate conmigo. Guardé un lugar para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650108,
					"content": "La última vez vimos Teyvat desde tu nave. Esta vez miremos las estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650109,
					"content": "Ninnin y quienes vinieron antes que ella se sintieron atraídos por este cielo. Allá afuera también debe existir otro tipo de fuerza. Puedo sentirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650110,
					"content": "Sobre Ninnin y el mensaje que envió...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "No te preocupes. No corrió peligro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650112,
					"content": "Viajó muy, muy lejos, sana y salva... Tan lejos que ya no puedo sentir la fuerza con la que intenté acompañarla y protegerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650113,
					"content": "Pero tengo curiosidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650114,
					"content": "¿Curiosidad por qué?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "Por muchas cosas. Por ejemplo... ¿alguien recibirá el mensaje de los Vigías Lunares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650116,
					"content": "Y quienes lo reciban, ya sean personas u otros seres... ¿quiénes serán?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650117,
					"content": "¿Qué pensarán? ¿Tendrán amor y odio en el corazón, como nosotros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650118,
					"content": "¿También se sentirán atraídos por este cielo hermoso y misterioso, incluso rodeados por el Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650119,
					"content": "¿También querrán encontrar a alguien más, saludarlo con la mano y decir: “Hola, es un placer conocerte”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650121,
					"content": "En lo más profundo de este cielo estrellado, ¿existirán todavía civilizaciones que no hayan sido devoradas por la oscuridad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650122,
					"content": "Creo que sí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650124,
					"content": "Nuestra nave recibió una vez una señal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "¿Qué señal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650126,
					"content": "Casi todo su contenido significativo se había perdido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Pero, sin duda, pertenecía a una civilización inteligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Perdido... ¿Será porque viajó demasiado lejos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650129,
					"content": "Aun así, con solo eso ya hay motivos para alegrarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650130,
					"content": "#Por cierto, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650131,
					"content": "¿Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "Tu tierra natal también está por allá, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650133,
					"content": "Si algún día decides volver al lugar donde empezaste el viaje y darle una buena limpieza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650134,
					"content": "Con gusto te echaré una mano. Tal como tú me ayudaste a limpiar la Luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650135,
					"content": "Entonces no olvidaré invitarte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "¿Y organizaremos otra fiesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650137,
					"content": "Y organizaremos otra fiesta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Entonces...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650139,
					"content": "¿Qué te parece llamarla “Noche del Retorno”?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650140,
					"content": "¿Y si es de día?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "En ese caso, invitaremos a todos nuestros amigos a celebrarla todo el día hasta que caiga la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 760650142,
					"content": "Suena a que va a ser muy divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "Que esa noche llegue bajo cielos despejados... y con los amigos reunidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colombina"
				}
			]
		}
	]
}