			"dialogs": [
				{
					"id": 751200101,
					"content": "Puedes saltar todo lo que quieras desde lugares elevados, pero la clave es el punto de aterrizaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200104
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Maestro de entrenamiento de los Augures Vientonocturno"
				},
				{
					"id": 751200104,
					"content": "#Este Desafío del Audaz está diseñado justo para eso. Por muy alto que vueles, debes prestar atención al lugar en el que aterrices. Bueno, ¿qué me dices, {F#guerrera forastera}{M#guerrero forastero}? ¿Quieres participar en el desafío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200102,
						751200103
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Maestro de entrenamiento de los Augures Vientonocturno"
				},
				{
					"id": 751200102,
					"content": "¡Empecemos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Maestra de entrenamiento de los Vástagos del Eco"
				},
				{
