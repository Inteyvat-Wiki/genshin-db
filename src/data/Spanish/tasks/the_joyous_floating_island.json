			"dialogs": [
				{
					"id": 762020601,
					"content": "¡Qué susto se ha llevado Paimon cuando nos hemos deslizado hasta abajo de repente! Eh... ¿Eso es la estatua de una mandrágora gigante?",
					"roleType": "TALK_ROLE_NPC",
