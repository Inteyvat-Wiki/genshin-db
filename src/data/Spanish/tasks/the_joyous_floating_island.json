			},
			"dialogs": [
				{
					"id": 762020201,
					"content": "#Bienvenid{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Hola, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "¡Guau, tu casa es maravillosa! ¡A Paimon le encanta cómo la has decorado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Jeje, sabía que sabrías apreciarlo, Paimon. Oírte decir eso hace que merezca la pena todo el trabajo que tuve que hacer en mi tiempo libre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "Todo empezó el día en que terminé de construir esta cabaña secreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Iba a aprovechar la oportunidad para construir unas cuantas más, pero no había nadie cerca que pudiera darme nueva inspiración. Así que, después de un tiempo, perdí el entusiasmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "Me dije: “¿Acaso no existe una forma de divertirse, disfrutar y sentirse realizada a la vez?”. ¡Entonces la respuesta me vino a la cabeza enseguida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Espera, ¿ya hemos llegado a la respuesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Sígueme el ritmo, Paimon. Miren, lo tienen frente a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "¿Detrás de esta puerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "#Bueno, no solo esta puerta, pero tampoco andan equivocad{F#a}{M#o}s. Todo tiene que empezar por algún sitio, así que ¿por qué no por aquí? ¿Están list{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "#U-un momento, ¡estás yendo muy rápido! Paimon no puede seguirte el ritmo así... ¿Para qué tenemos que estar list{F#a}{M#o}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "#Oh, tranquil{F#a}{M#o}s, no tienen que prepararse para nada. Es solo una forma de hablar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "Según mis propias observaciones y mi comprensión sobre ustedes... no parecen gustarles las explicaciones demasiado complejas. Prefieren encontrar su diversión en el proceso de exploración, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Bueno, no te equivocas en eso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "¡Jaja, me alegra oírlo! En ese caso, prepárense bien, ¡pues no me contendré ni un poquito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME}, tú nos conoces bien a los ángeles. La satisfacción de guiar a alguien hacia un tesoro es algo a lo que no podemos resistirnos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "Y ya que nuestro objetivo es ser bondadosos y ayudar a los demás a encontrar la felicidad, ¿por qué no iba a empezar por mis amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "Por eso, ¡se me ocurrió toda una genialidad! He convertido mi cabaña en un lugar donde podrán relajarse y divertirse. ¡Incluso he escondido tesoros en cada habitación!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "Diría que entre todos los ángeles, ¡soy toda una experta en esconder cosas! ¡No les miento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Si enterrara un cofre ahí fuera sin mostrarles el camino, me temo que no lograrían encontrarlo ni tras meses de búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "*Ejem*, bueno, creo que me he ido por las ramas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "No quiero ponerles las cosas difíciles a propósito, ni tampoco necesito que corran de un lado a otro por la naturaleza para entretenerme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "¡Lo único que deberán hacer es encontrar tres plumas que simbolizan el tesoro y se encuentran en esta habitación para superar el desafío! Cuando lo consigan, ¡abran el cofre delante de mí, jeje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "¡Aaah, entonces vamos en busca de un tesoro! ¡Paimon se muere de ganas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "¡Sí, eso es! ¡Será muy divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Pero me gustaría oír tu explicación de todas formas, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "Es un honor venir de visita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
		{
