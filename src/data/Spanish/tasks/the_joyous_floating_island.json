					"speakerTitle": "Paimon"
				},
				{
					"id": 762020602,
					"content": "¡Grrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Examinar puerta"
				},
				{
					"id": 762020603,
					"content": "Espera, lo siento, parece que algo salió mal. No debería ser así...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "¡Grrr... grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Examinar puerta"
				},
				{
					"id": 762020605,
					"content": "¡Se está moviendo! ¡Parece que va a atacarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020606,
					"content": "Uff, mucho mejor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762021401,
					"content": "¿De qué estás hablando, Nicole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762021402,
