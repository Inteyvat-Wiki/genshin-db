			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "#Hola, aventurer{F#a}{M#o}. ¿Cómo va todo en tus viajes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600102,
					"content": "No me puedo quejar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "#Qué bueno. Sigue esforzándote y seguro que te convertirás en {F#una aventurera}{M#un aventurero} increíble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600104,
					"content": "Por cierto, si te interesa, puedes acercarte a donde el Sr. Gygax y probar la última versión de «Cazadores y rebeldes».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600108,
					"content": "¿Eso... tiene algo que ver con el Gremio de Aventureros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "Bueno... El Sr. Gygax ha hecho un encargo al Gremio, pidiéndonos que le ayudemos a reclutar gente para probar «Cazadores y rebeldes».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600110,
					"content": "De alguna manera... se podría decir que hay cierta relación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600111,
					"content": "De todos modos, ve y pruébalo si quieres. Según los aventureros que lo han probado, «Cazadores y rebeldes» es bastante divertido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600105,
					"content": "¿Tienes un nuevo encargo para mí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "¿Encargos...? No, ninguno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600107,
					"content": "Pero si te interesa, ve a donde el Sr. Gygax y prueba la última versión de «Cazadores y rebeldes».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 7066002,
			"completionStepIds": [
				7066002,
