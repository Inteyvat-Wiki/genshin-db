				]
			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#¡Guau, mira, {NICKNAME}! Sin darnos cuenta, ya hemos rellenado todo el álbum. ¡Todas las imágenes quedaron geniales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070102,
					"content": "Qué rápido se pasa el tiempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Jeje, Paimon no esperaba que encontraríamos tantos lugares hermosos, ¡y que podríamos tomar imágenes de tantos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070105,
					"content": "Mira esta. Nos costó mucho encontrar el ángulo perfecto. ¡Pero valió totalmente la pena! Quedó perfecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070106,
					"content": "Gracias a tu buen sentido de orientación y tus ahorros, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Jeje, ¡no hay de qué! Al fin y al cabo, Paimon es tu mejor guía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070109,
					"content": "¡Y haber creado tantos recuerdos felices ha merecido totalmente la pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}, ¿cómo te sentiste al usar el Daguerrotipo? ¿No crees que tu habilidad para tomar imágenes mejoró tanto que ya casi igualas al legendario Leblanc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070111,
					"content": "Aún me queda mucho por aprender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "¡Eso, eso! ¡Lo más importante es divertirse! Además, Paimon cree que las imágenes que tomaste no tienen nada que envidiarle a las de los maestros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070114,
					"content": "#Porque cada una guarda una historia que compartimos junt{F#a}{M#o}s. Y eso las hace únicas para Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070115,
					"content": "Y cuando... vayamos a otro lugar a vivir más aventuras, recordaremos con cariño estos bonitos tiempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070116,
					"content": "#Sigamos tomando más imágenes junt{F#as}{M#os}, ¿sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "¡De acuerdo! Entonces queda acordado: ¡el próximo álbum tiene que ser aún más maravilloso que este! ¡Vamos a crear muchos recuerdos únicos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070112,
					"content": "Lo importante es disfrutar del proceso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "Gracias a tu fondo de emergencia y por ser tan buena guía, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "Cada imagen guarda un recuerdo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
