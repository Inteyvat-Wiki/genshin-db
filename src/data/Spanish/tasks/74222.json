	"talks": [
		{
			"id": 7422201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422201",
							"2"
						],
						"stepId": 7422201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "#¡Mantente alerta, ciudadan{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "¿Qué estás haciendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "¿Yo? Pues lo que ves. Estoy ocupado lidiando con la amenaza de los bárbaros. Últimamente, han estado adelantando su ofensiva cada vez más. ¡Hasta es probable que tengan espías infiltrados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "¡No estamos ante un asunto trivial! ¡Hay que mantener la guardia alta hasta que lleguen refuerzos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "Si tienes algo más que decir, puedes informar de ello a mi ayudante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Un niño solo por aquí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "¿Eh? ¿Un niño? ¿Dónde? ¿Acaso algún soldado novato trajo a su hijo al campamento sin permiso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "*Suspira*, el Sr. Casiodoro es demasiado bueno con los soldados nuevos. Si esto hubiera ocurrido hace treinta años, el general ya habría sacado el látigo o algo peor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "¿Ha ocurrido algo sospechoso estos días?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "De momento no, pero los bárbaros son bestias astutas, siempre asaltan cuando tienes la guardia baja. ¡Se les da genial atacar cuando uno está desprevenido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Además, emplean cualquier truco sucio para sacarnos información e invadir nuestras ciudades. Cualquier descuido podría ser catastrófico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "*Suspira*. Hace treinta años, cuando fui con el Sr. Boecio a las fronteras del norte, no eran más que unos primitivos inútiles. Me pregunto de dónde habrán aprendido todos esos trucos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Hace treinta años... Ni siquiera habían nacido tus padres, ¿no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "¿Humm? ¿Qué dijiste? Me temo que con los años, mi audición no es tan buena como solía ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "*Suspira*... Antaño, durante la conquista de Bituria, podía oír las campanadas de los bárbaros a varios kilómetros de distancia. Y ahora... Los años no perdonan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Adiós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "#¡Adiós, ciudadan{F#a}{M#o}! Si te encuentras con alguien sospechoso, ¡no dudes en comunicármelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "*Suspira*, me pregunto cuándo terminará esta guerra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "¿Qué haces en el tejado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "#¿Eh? Es obvio que estoy vigilando la zona para detectar cualquier rastro de actividad de los bárbaros. Últimamente... Un momento, ciudadan{F#a}{M#o}, ¿cómo has subido a la torre de vigilancia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "¡Eso mismo iba a preguntarte yo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "*Suspira*. En fin, eso no importa. El Capitán Metio dice que esos salvajes están cada vez más cerca. Lo último que nos han advertido es que quizá hayan infiltrado a algunos de sus espías entre nosotros. Debemos permanecer en guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "Pero dime, ¿qué piensas tú? ¿En serio van a estar interesados esos brutos en una ciudad tan pequeña? ¿Por qué les merecería la pena enviar espías infiltrados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Un pez siempre es apetitoso, no importa que sea grande o pequeño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "#¡Por los Arcontes, ciudadan{F#a}{M#o}! ¡Acabas de iluminarme! Será mejor que me concentre en mi obligación. Pero oye, a juzgar por tus palabras, debes de ser alguien con mucha experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "Si es así, ¿podrías echarme una mano inspeccionando los alrededores? Si los bárbaros realmente estuvieron en esta zona, seguro que dejaron rastros, como una espada de madera o cosas del estilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "¿Como los juguetes con los que pelean los niños?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Al fin y al cabo, estamos hablando de bárbaros. No me extrañaría que usen ramas como armas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "#Sea lo que sea que encuentres, lo dejo en tus manos. Si descubres cualquier cosa, ven a informarme de inmediato. Considéralo tu deber como ciudadan{F#a}{M#o} de Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
