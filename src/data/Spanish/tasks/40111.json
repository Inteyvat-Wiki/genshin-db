			"dialogs": [
				{
					"id": 401113201,
					"content": "Dicen que hasta el torneo no oficial de Invocación de los Sabios está siendo todo un éxito también. Algunos aficionados han decidido apuntarse incluso a ambas competiciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401113202,
					"content": "Aunque no me opongo a probar nuevas tendencias, prefiero el ajedrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ninguang"
				},
				{
					"id": 401113203,
					"content": "Lo más fascinante es que, sean cuales sean las diferencias entre las distintas modalidades de juego, todas comparten algo en común; el propósito es reunirse con amigos para divertirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ninguang"
				}
			]
		},
