					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111402
					],
					"speakerTitle": "Eichendorff"
				},
				{
					"id": 401111402,
					"content": "¿Verdad? No me esperaba que fuera a ganar. Al menos ahora ya no me siento tan mal después de perder contra él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lennard"
				}
			]
		},
		{
			"id": 4011115,
