				"objectNames": [
					"Charlotte",
					"Kirara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115301,
					"content": "¿Por qué la llamas kitsune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Y no te olvides de darme todos los detalles jugosos. Tal vez hasta me sirva para escribir un artículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "¡Ah! No, mejor que no diga nada. No me gustaría meter la pata. Además, yo no soy la más adecuada para hablar de ninguna youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "En ese caso, ¿podrías explicarme al menos por qué una kitsune tiene tanto interés por el tofu frito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "*Suspira*, nada más mentar la comida ya me está dando hambre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "¿Por qué no dejas que te lleve a probar un delicioso cuenco de fideos con tofu frito? Te lo explicaré mientras comemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
			]
		}
	]
}