			"dialogs": [
				{
					"id": 401113101,
					"content": "Por cierto, ¿juega Beidou a Invocación de los Sabios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113102,
					"content": "Claro que sí. De hecho, es una de las mejores jugadoras de la Flota Crux Meridianam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Kazuha, si no te importa, ¿podrías hablarle bien de mí? Soy una gran admiradora suya. Me gustaría llegar a conocerla, pero todavía no he tenido la oportunidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113104,
					"content": "Claro, pero no seas tan dura con ella si se enfrentan en un duelo de cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4011132,
