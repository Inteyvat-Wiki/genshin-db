			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "¡Yuju! ¡He ganado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111102,
					"content": "¡Felicidades, Timmie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "¡Gracias! Estoy deseando contárselo a mi mami. Seguro que se pone contenta, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111104,
					"content": "Fue mi mamá la que me dijo que debía participar. ¡Pienso regalarle el premio a ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111105,
					"content": "Me gustaría tanto que mi papá pudiera verme ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111106,
					"content": "Adiós, Timmie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "¡Adiós! ¡Invocación de los Sabios es una pasada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mika",
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "¿Ya ha acabado? Vaya, llego tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111202,
					"content": "Es una pena que no lo hayas visto, Mika. Kaeya... ha perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111203,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111204,
					"content": "¿Cómo ha podido pasar algo así, hermano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111205,
					"content": "Uff, yo no tengo ni idea de cómo se juega, así que he tenido que preguntar a la gente para comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111206,
					"content": "Al parecer, Kaeya logró derrotar enseguida una de las cartas de personaje del rival. Al principio hasta llevaba la delantera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111207,
					"content": "Aunque supongo que su rival lo tenía todo pensado. El caso es que el renacuajo ese, el tal Timmie, había estado acumulando cartas durante las primeras rondas para luego atacar de lleno hacia el final de la partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111208,
					"content": "¿Quién sabe? Tal vez Kaeya ya tuviera las de perder desde el momento en que lanzaron la moneda y le tocó el segundo turno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111209,
					"content": "Ufff, necesito una copa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111210,
					"content": "Ni hablar, hermano. No puedes recurrir a la bebida siempre que algo vaya mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111211,
					"content": "Estoy seguro de que el Capitán Kaeya no querría verte triste por su derrota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111212,
					"content": "Oye, hermanito, ¿por qué no aprendemos a jugar nosotros también? Así podremos tener la oportunidad de enfrentarnos al Capitán Kaeya algún día. Jaja, aunque supongo que será una batalla perdida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111213,
					"content": "Está bien que lo sepas, Mika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
