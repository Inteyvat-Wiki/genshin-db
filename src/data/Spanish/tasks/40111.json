			"dialogs": [
				{
					"id": 401113301,
					"content": "¡Hola, hola! Soy Charlotte, reportera de «El Pájaro de Vapor».",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "¿Tienes tiempo? Me gustaría hacerte unas preguntas para mi reportaje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*Suspira*, sí, supongo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 401113304,
					"content": "Has derrotado a un gran número de rivales durante el torneo para llegar a la final. Es una pena que finalmente hayas perdido contra la directora Hu Tao. Supongo que es duro saber que te has quedado solo a un paso de la victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Teniendo eso en cuenta, ¿hay algo que quieras compartir con los lectores acerca del duelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 401113307,
					"content": "Dime, ¿quieres una respuesta diplomática o mi sincera opinión?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 401113308,
					"content": "Los lectores preferirán la verdad ante todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Chian"
				},
				{
					"id": 401113310,
					"content": "Bueno, yo siempre digo que, cuando de cartas se trata, el setenta por ciento es habilidad y el resto, suerte. Pero en este caso... Sacar seis dados del mismo tipo en una tirada es tener demasiada suerte. Ya no un aventurero, ¡es que ni un Adeptus podría ganar así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chian"
				}
			]
		},
		{
			"id": 4011151,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011103",
							"2"
						],
						"stepId": 4011103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto",
					"Kuki Shinobu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "¡El duelo de la mujer zorro esa y Santa-pescadilla ha sido una pasada! ¡Ha hecho que se me acelere el pulso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Sí, sí, ha sido muy emocionante para todo el mundo, pero, jefe, los miembros de la banda nos están esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "¿A qué tanta prisa, Kuki? Mi colega y yo todavía no hemos podido jugar ni una ronda. ¡No le puedes negar un duelo a estos ojitos ónicos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "¡Vamos, juguemos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "#¡Así me gusta! ¡Eres {F#la}{M#el} mejor colega que un oni podría tener! ¡Tú sí que entiendes el espíritu de un viciado de las cartas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "... No se me paga lo suficiente para tratar con ustedes dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "La próxima vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "... Qué gran traición.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "Bueno, bien, no te culpo... Supongo que tendrás cosas que hacer. ¡Y ahora vete, antes de que llore amargamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 4011152,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011103",
							"2"
						],
						"stepId": 4011103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115201,
					"content": "Srta. Kujou, ¿le importa que le robe algo de su tiempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Claro, no es ningún problema. Y felicidades en su victoria, Srta. Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "Me gustaría darle las gracias personalmente por los sabios consejos que me dio antes del comienzo del duelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "No fue nada. Cualquiera con los pies en la tierra sabría que la habilidad y la estrategia es lo que determinan al vencedor en un enfrentamiento. En cualquier caso, fue un duelo digno de ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "Es una pena que usted no haya participado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Me temo que no habría podido ganarte de todas formas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "No diga eso. Creo que nos parecemos mucho, en realidad. Aprovechamos nuestras habilidades durante el duelo para responder a cada movimiento del rival, y siempre lo consideramos un amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "... Tal vez lleves razón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "En ese caso, deberíamos aprovechar para jugar una partida antes de que se marche de la Isla Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Con mucho gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 4011153,
