			"dialogs": [
				{
					"id": 761360301,
					"content": "(Quizá <color=#FFCC33FF>Jahoda</color> quiere ver el cofre...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Jeje... Veamos cuánto dinero he ganado últimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360303,
					"content": "La jefa me dijo la otra vez que me daría un bonus, ¿y si ahora...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360304,
					"content": "¿Eh? ¿Cómo es posible que no haya dinero? Solo hay una nota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360305,
					"content": "“Querida Jahoda, cierra bien el cofre. Tu bonus no está aquí dentro”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360306,
					"content": "*Tch*, ya está la jefa queriendo asustarme. ¿Será que hay algún compartimento secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360307,
					"content": "No hay ningún compartimento secreto, aquí está tu bonus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761360308,
					"content": "Oh, gracias, jefa. Yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360309,
					"content": "¡Aaaaaaaaaah! ¡Jefa, jefa, solo quería hacer un pequeño recuento de mi dinerillo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360310,
					"content": "¡Me voy a trabajar ahora mismo, ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360311,
					"content": "Alto ahí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761360312,
					"content": "¡Sí, jefa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360313,
					"content": "Cierra bien el cofre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761360314,
					"content": "¡Sí, jefa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360315,
					"content": "Ahora puedes irte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "Néfer"
				},
				{
					"id": 761360316,
					"content": "¡Sí, jefa!",
					"roleType": "TALK_ROLE_NPC",
