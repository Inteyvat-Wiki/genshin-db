			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "¿Así que un ser tan distinguido vive en un lugar así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070102,
					"content": "*Brr*... Si alguien vive aquí, ¿por qué hace tanto frío?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070103,
					"content": "Humm... Me pregunto lo mismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070104,
					"content": "Qué extraño, estoy bastante segura de que este es el lugar del que escribió mi madre, pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070105,
					"content": "Tal vez nos equivocamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "Humm... Ahora comienzo a dudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070108,
					"content": "Pero, ya que estamos aquí, creo que deberíamos entrar y explorar a fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070109,
					"content": "Sí, tiene sentido. ¿Quién sabe? Tal vez haya una sorpresa esperándonos ahí dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070110,
					"content": "Por cierto... ¿Qué dice exactamente el cuaderno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070111,
					"content": "Déjame recordar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070112,
					"content": "“Una grulla trae <color=#00E1FFFF>1</color> flor fresca en su pico para decorar mi cabello, mientras un conejo blanco cose un dobladillo con <color=#00E1FFFF>4</color> rayos de luz de luna. Vestida para la ocasión, miro <color=#00E1FFFF>hacia el este</color> y pronuncio el nombre de Tsubaki <color=#00E1FFFF>7</color> veces. En un abrir y cerrar de ojos, me encuentro en el camino que lleva a su casa”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070113,
					"content": "Parece un cuento de hadas... ¿Así que tu madre hacía un pequeño ritual, y así Tsubaki venía a verla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070114,
					"content": "Suena muy similar a un Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "Quizás es algún tipo de código...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070116,
					"content": "Acerquémonos un poco antes de hacer conjeturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070117,
					"content": "¡Buena idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070106,
					"content": "¿Quizás Tsubaki sea realmente una kitsune mensajera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
			"completionStepIds": [
				1200705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
