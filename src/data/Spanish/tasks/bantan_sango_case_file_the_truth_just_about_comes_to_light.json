			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "Oh, llegas justo a tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330102,
					"content": "Acabo de inspeccionar varios lugares sospechosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330103,
					"content": "Uno de los campamentos está protegido por el perro je...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330104,
					"content": "*Ejem*, quiero decir, por la sombra. No sé si tienes más preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330105,
					"content": "¿Qué hay de la investigación de ayer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "No sé nada por el momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330107,
					"content": "¡¿Eh?! ¿No te mandó Sango a investigar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330108,
					"content": "Así es, pero... ¿cómo decirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330109,
					"content": "Por ejemplo, yo no encuentro ninguna relación entre unas “calavandas demasiado maduras” y unas “huellas llenas de barro en una puerta”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330110,
					"content": "Pero para la jefa, eso es todo lo que necesita para resolver el misterio del rompecabezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330111,
					"content": "Unas calavandas demasiado maduras y unas huellas llenas de barro en una puerta... ¿Qué relación hay entre ellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330112,
					"content": "Solo es un ejemplo. Siguiendo las instrucciones de la jefa, investigué en unos lugares de la Isla Yashiori y el Bosque Chinju y fui a informarle de lo que había visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330113,
					"content": "Solo ella sabe las conclusiones que ha sacado de mi informe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330114,
					"content": "Honestamente, solo Shikanoin es capaz de seguirle el hilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330115,
					"content": "¿Quién es Shikanoin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "Alguien de la Comisión Tenryou. Tuvimos el honor de conocerlo en un caso anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330117,
					"content": "Es una persona... bastante peculiar. Sabrán a lo que me refiero si alguna vez lo conocen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330118,
					"content": "Bien, te dejo el asunto de los animales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330119,
					"content": "Paimon aún está pensando en las “calavandas demasiado maduras”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003303",
							"2"
						],
						"stepId": 4003303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "¡Fantástico! Estos deberían ser todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330302,
					"content": "Espera, ¿por qué parece que estos no son todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330303,
					"content": "Oh, oh... Paimon piensa que esto se está alargando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330304,
					"content": "Es cierto que, para resolver casos, a veces se requiere mucha paciencia. Si vas por el camino equivocado, podrías no encontrar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330305,
					"content": "Ya encontramos una buena parte de los animales, así que al menos vamos por buen camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330306,
					"content": "Aun así, es posible que nos hayamos dejado alguna pista por el camino o algunos sitios sin investigar, lo que nos podría llevar a un callejón sin salida. Pero confío en que solo será temporal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330307,
					"content": "Ohhh, ¡Paimon lo entiende! ¡Quieres decir que necesitaremos un poco de “bum” para aclarar todo esto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330308,
					"content": "Humm, sí, podría decirse que en estos momentos estamos escasos de “bum”. Pero no por mucho tiempo, ya que hemos progresado bastante gracias a ustedes dos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330309,
					"content": "(D-de verdad te entendió, Paimon.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "¡Eso tiene mucho sentido, Ryuuji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330312,
					"content": "Oh, me halagas. Solo es la voz de la experiencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330313,
					"content": "Cuanto más profundamente enterrada esté la verdad, más valor tendrá cuando la descubramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330314,
					"content": "Es una lástima que no tengamos más información por el momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330315,
					"content": "Supongo que informaré de la situación actual a la jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330316,
					"content": "Ella tendrá en cuenta alguna perspectiva que no se nos haya ocurrido a nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330317,
					"content": "¡Claro! Después de todo, ¡Paimon confía en tu sentido común!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330318,
					"content": "Entonces, ¡decidido! Reunámonos en el lugar de siempre cuando surjan más pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330319,
					"content": "Si en ese momento me encuentro ocupado, pueden ir a buscar a la jefa directamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330310,
					"content": "(Ryuuji ya te conoce muy bien, Paimon.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
