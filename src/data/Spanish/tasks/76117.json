					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ihanti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2018.583,
							206.964,
							9782.118
						],
						"pointId": 14266
					},
					{
						"sceneId": 3,
						"position": [
							2020.458,
							206.988,
							9783.119
						],
						"pointId": 14267
					},
					{
						"sceneId": 3,
						"position": [
							2019.785,
							206.972,
							9781.799
						],
						"pointId": 14268
					},
					{
						"sceneId": 3,
						"position": [
							2018.43,
							206.961,
							9782.82
						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "*Jadea*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "¿Quién anda ahí? No tengo ni un Mora, nada de nada... Si vienen por mi vida, adelante, pueden tomarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "Te he traído tus cosas, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "... ¿Jahoda, eres tú? Puedo oír tu voz, pero ya no soy capaz de ver con claridad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "Soy yo, Ihanti, y estoy justo aquí frente a ti. ¿Por qué no viniste a buscarme? Tienes muy mal aspecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Ni siquiera un perro hambriento se atrevería a entrar en la ciudad de un rico... No después de todas las palizas que ha recibido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "No soy esa clase de persona, y Néf... quiero decir, la jefa Nef tampoco lo es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "Con mayor razón no podía ir a buscarlas. Si la gente se enterara de que son el tipo de personas que ayudan a los demás, estarían tocando a su puerta día tras día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Nadie estaría tan loco como para intentar algo así con la jefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Pero tú siempre estás haciendo el bien a escondidas, solo para que te apuñalen por la espalda las mismas personas a las que ayudaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "¡Oye! He aprendido mucho de la jefa Nef, ¿sabes? Nadie volverá a engañarme así nunca más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "... No puedes evitar preocuparte por los demás, ¿verdad, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "... Eso es asunto mío, y de nadie más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Je... Quizás por eso el jefe te tenía en tan alta estima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "Quizás sea la única razón por la que sigo con vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Jajaja, *cof, cof*... Tienes razón, Jahoda. Tienes razón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "... De todas formas. Si hay algo que pueda hacer por ti, Ihanti, este es el momento de decírmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "No has cambiado nada... ¿Y si todo esto fuera una estafa, o te estuviera llevando a una trampa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "No harías eso. No después de todo el tiempo que nos conocemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "¿Y eso es suficiente para ganarme tu confianza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Vamos, mira el estado en el que estás. ¿Cómo podrías amenazarme así?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "¡Ja! Por fin nos entendemos. Supongo que salvar a una serpiente venenosa que apenas puede abrir la boca es bastante seguro, después de todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "Entonces, te voy a pedir un favor. Enrolla la pintura que hay en esa bolsa y guárdamela en el bolsillo. No tengo fuerzas para recogerla yo mismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "La hice junto a mi esposa y mi hija. Es lo único que aún me importa en todo este vasto mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "En lo que a mí respecta, todo lo demás da igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "Je, el antiguo tú se hubiera muerto de risa al escucharte decir eso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Ah... ¿Qué pasó con aquellas cosas que alguna vez atesoré por encima de todo? No sirvieron para salvar ni a mi esposa, ni mi vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Pero quizás ese sea el destino de un ladrón. Todo lo que robamos siempre nos lo terminan robando, y al final volvemos a quedarnos con las manos vacías.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Ese colgante que puse en el encargo era todo lo que me quedaba... Ja, aunque supongo que no puedo considerarlo realmente “mío”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "Esa fue la primera joya que robaste. Me has contado la historia como una docena de veces: cómo lo lograste, y la cara que puso ese tipo rico cuando se enteró.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "Sí. De todas formas, ahora es tuyo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "¿A quién le pertenecía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "A un hombre de Snezhnaya llamado Holómov. Solía vivir en Nod Krai, pero probablemente ya haya regresado a Snezhnaya. No me digas que estás pensando en...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Ya no soy una ladrona, y tampoco pienso quedarme con bienes robados. Este colgante debe volver a su legítimo dueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Jaja... jajaja... Realmente eres especial, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "El jefe tenía razón... Alguien como tú nunca podría... *cof, cof*, ser una ladrona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "*Cof, cof*... *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Ya basta, deja de esforzarte en hablar. Volveré y te traeré un doctor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Olvídalo. Déjame ir como debe ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Pero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, ya conoces el código del jefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "“Concede descanso a aquellos que lo buscan”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Sabes bien de lo que hablo, así que déjame en paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Me alegra que hayas sido tú quien vino a ayudarme, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Lamento no tener ningún tesoro que darte. Pero si quieres, puedes quedarte con este muñeco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "Espera, pero... pensé que te había dicho que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "No te preocupes, este muñeco lo hice yo mismo. Los que hiciste tú ya no existen, los quemé todos, tal y como me dijiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "No está nada mal, ¿eh? Especialmente para alguien que ya estaba al borde de quedarse ciego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Tómalo, Jahoda. Considéralo mi último regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170452,
					"content": "Volveré a buscarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170453,
					"content": "Adiós, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170454,
