			"dialogs": [
				{
					"id": 761170301,
					"content": "¡Está bien, está bien, tú ganas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170303,
					"content": "¿Ves? Si hubieras cooperado desde el principio, no habrías terminado así. Ahora, toma los Moras y ve a buscar un buen doctor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170304,
					"content": "Hum, ¿te estas compadeciendo de mí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170305,
					"content": "Déjate de tonterías y toma los Moras. Si prefieres tirarlos al agua o contratar matones para que me den una paliza, es tu decisión.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170306,
					"content": "Pero una cosa es segura: pasar hambre y recibir una paliza son cosas horribles. No empeores más tu situación, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170308,
					"content": "Las baratijas que le quité a ese inválido están por allá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170309,
					"content": "Aparte de un par de monedas, solo había una pintura y un muñeco roto. El Mora ya ha desaparecido, pero no he tenido tiempo de tirar el resto todavía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170310,
					"content": "Bien, última pregunta. Acabas de referirte a Ihanti como un “inválido”. ¿Qué quieres decir con eso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170311,
					"content": "Significa exactamente eso. Ese debilucho está tan mal ahora que apenas se nota que sigue vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170312,
					"content": "Cuando lo encontré, estaba tieso como una tabla. Honestamente, pensé que ya había... Ya saben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170313,
					"content": "... De todas formas, pensé que ya no necesitaría su bolso, así que me lo llevé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170314,
					"content": "Marca el lugar donde lo viste por última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170315,
					"content": "¿Donde lo vi por última vez? Creo que fue por... aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170316,
					"content": "#Bien. {NICKNAME}, Paimon, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170317,
					"content": "Me gustaría devolverle esto al cliente en persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
			"id": 7611704,
			"completionStepIds": [
				7611705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7611705",
