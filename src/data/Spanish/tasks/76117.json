			"dialogs": [
				{
					"id": 761170201,
					"content": "Pfff, pobre. Está tan arruinado que no tiene ni una sola cosa que valga la pena robar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "Hola, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "¿Quién and...? Vaya, vaya, vaya, ¡pero si es Jahoda! ¿Qué te trae por aquí, renacuaja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Tranquilo, no es nada importante. Me han dicho que le robaste algo a un tipo llamado Ihanti hace unos días. ¿Es eso cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Toma algo de dinero y entrégame las cosas. Hoy me siento generosa, así que digamos que te las estoy comprando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Oh, mira quién actúa tan civilizadamente ahora. Supongo que así es cuando tienes a Néfer cubriéndote las espaldas, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "¿Y si prefiero quedármelas? ¿Qué vas a hacer al respecto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "Hazme un favor, Kaleva. ¿No podrían tú y tu pandilla de cabezas huecas comportarse como gente normal por una vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Por favor, no me digas que viniste hasta aquí esperando hacer negocios honestos con un ladrón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "¿O realmente pensaste que te entregaría la mercancía en bandeja de plata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "Paimon siente que lo de negociar no va a funcionar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "*Suspira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Lo siento, Kaleva. No debí tratar de negociar contigo como lo hace la jefa Nef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Un puñetazo en la cara es la única forma de negociar con idiotas como ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#¡Vamos, {NICKNAME}, acabemos con estos bravucones junt{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "Veo que nos estás subestimando, ¿eh? Vamos, muchachos, es hora de poner a esta pequeña insolente en su lugar. ¡A por ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
