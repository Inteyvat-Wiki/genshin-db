			"dialogs": [
				{
					"id": 761170501,
					"content": "Excelente, veo que ha completado el encargo. Por favor, espere un momento mientras busco su pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170502,
					"content": "¿Está todo bien, Srta. Jahoda? Se ve algo pálida... ¿No tuvo ningún problema, verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170503,
					"content": "No es nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170504,
					"content": "Muy bien entonces. Un momento, volveré enseguida con su recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170505,
					"content": "Jahoda, ¿estás bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "Paimon sabe que le prometimos que no llamaríamos a un doctor, pero... Ihanti tenía muy mal aspecto. Tal vez deberíamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170507,
					"content": "No. Dije que seguiría el código, y eso es lo que haré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170508,
					"content": "Entonces... ¿ustedes se conocen bien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "Solíamos ser “colegas”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170510,
					"content": "Puede que sea un cobarde, pero cuando se trata de conseguir Mora, Ihanti era el mejor de su clase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170511,
					"content": "Mientras los demás se dedicaban a estafas tontas y pequeños robos, él jugaba tan bien sus cartas que la gente terminaba soltando el dinero por voluntad propia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170512,
					"content": "Cuando “trabajábamos” juntos, me enseñó un montón de formas diferentes de convencer a la gente, y siempre me llevaba a comer a lugares increíbles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170513,
					"content": "¿Lo consideras un amigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "¿Un amigo? Ja, claro que no. Tendrías que estar loco para intentar hacer amigos en ese infierno. En el mejor de los casos, digamos que... nos conocíamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170515,
					"content": "La única razón por la que me cuidó bien fue para presumir. Supongo que arrastrar a una pequeña compañera lo hacía sentir importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170516,
					"content": "Pero debo admitir que me cuidó bien. Si lo ayudé ahora fue solo para devolverle el favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170517,
					"content": "Muy bien... Aquí tiene su pago, Srta. Jahoda. ¡El Gremio de Aventureros le agradece su apoyo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170518,
					"content": "#Aquí está tu parte, {NICKNAME}. Gracias por la ayuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170519,
					"content": "Bueno, debo regresar a la Cámara de Secretos. Si la jefa necesita algo y no estoy allí, seguro que me regañará de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170520,
					"content": "(Dije que no llamaría a un doctor, pero ¿qué tiene de malo conseguirle unos analgésicos?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170521,
					"content": "(Le pediré ayuda a la jefa, seguro que puede mover algunos hilos. En el peor de los casos, renuncio al sueldo de este mes... Bueno, tal vez solo a la mitad...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170522,
					"content": "(Sí, eso haré. Será mejor que le lleve la medicina a Ihanti mañana...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
