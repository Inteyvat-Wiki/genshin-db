			"dialogs": [
				{
					"id": 761170101,
					"content": "Muy bien, parece que ha completado el encargo sin problemas. Gracias, Srta. Jahoda. Aquí está su pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170102,
					"content": "¿Ves? ¡Te dije que todo saldría bien! Y el pago no está nada mal, jeje... ¿Tienes más trabajos así para ganar Mora rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "Claro, deme un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170104,
					"content": "¿Eh? ¿Eso no es...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "Oye, Katheryne... ¿Ese colgante de ahí se usó para publicar un encargo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "Así es, tiene usted buen ojo, Srta. Jahoda. El Sr. Ihanti lo dejó como garantía para un encargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170107,
					"content": "En ese caso, tomaré ese encargo. Dame los detalles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "Pero... la recompensa por este encargo no es muy alta, y hoy en día, accesorios como estos tampoco valen mucho. No estoy segura de que sea el tipo de trabajo que está buscando, Srta. Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170109,
					"content": "No te preocupes, lo acepto. Digamos que... es una pequeña obra de caridad. Hay que acumular buen karma de vez en cuando, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Jaja... Muy bien entonces. Por favor, espere un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170111,
					"content": "¿Aceptando encargos de nuevo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "Bueno, no es como si tuviera mucho que hacer ahora mismo. No puedo pasarme todo el día jugando con Ashru, ¿verdad? Néf... quiero decir, la jefa Nef me echaría en un abrir y cerrar de ojos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#Humm, ahora que están aquí... {NICKNAME}, Paimon, ustedes dos son muy hábiles. ¿Quieren ayudarme con el encargo? Podríamos repartir la recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "#¿Un encargo? Mejor pregúntale a {M#él}{F#ella}, ¡después de todo {M#él es el que}{F#ella es la que} más sabe de esas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Apuesto a que no es nada importante. Créeme, Ihanti es demasiado miedoso como para que sea algo serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Srta. Jahoda, aquí están los detalles del encargo del Sr. Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170120,
					"content": "Muy bien, veamos qué es lo que ese debilucho ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "¿Qué sucede? Por favor, no le digas a Paimon que es un encargo superdifícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "Nop, nada de eso. Solo que no esperaba que alguien que ni siquiera es capaz de matar una mosca publicara encargos de vida o muerte como este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "¿V-Vida o muerte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "¿Tú? Jajaja, claro... No podrías tomarte más en serio las normas ni aunque lo intentaras, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "#Tranquil{F#a}{M#o}, solo estaba bromeando. El encargo solo menciona que tenemos que recuperar algo de un grupo de ladrones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "Para un ladrón, el dinero es vida y la vida es dinero. Así que es un encargo de vida o muerte, ¿no creen? Jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "Vamos, síganme. Estoy segura de que puedo encargarme de esos bribones yo sola. Lo más probable es que ni siquiera tengas que mover un dedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "Soy una persona que respeta la ley, para que lo sepas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "Está bien, ¿de qué tipo de encargo estamos hablando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Tan ocupada como siempre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
