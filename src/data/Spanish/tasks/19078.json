			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "¿Te has enterado? ¡Alkami ha contratado al mismísimo Kaveh para que sea profesor en su centro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Jeje, ¡ese tipo nadará en Mora ahora que tiene a Kaveh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Qué envidia, ¿eh? Si lo piensas, Alkami nunca sobresalió por sus habilidades como arquitecto. Nadie pagaría por tener una clase con él como profesor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "Pero tenemos que reconocer que la mercadotecnia no se le da nada mal... Después de todo, tan solo unos pocos consiguen aprobar el examen de acceso a la Academia para estudiar arquitectura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Todos los que no sean capaces de superar el examen o que pretendan insertarse cuanto antes en el mercado laboral, acabarán acudiendo a ese centro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Tiene un don para los negocios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
		{
