				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190785001,
					"content": "El señor Kaveh se veía muy enfadado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "¿Y a quién le importa? ¡Quizá le preocupe que le robemos el trabajo cuando nos hayamos graduado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "Pe-pero esto... no creo que esté bien... El profesor Kaveh tiene muy buena reputación...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "¿Quién sabe? Mi padre dice que cuanto más famosa es la gente, más arrogante se vuelve. ¡Es raro encontrarse con personas como el señor Alkami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
