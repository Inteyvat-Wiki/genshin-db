			"dialogs": [
				{
					"id": 190785201,
					"content": "Una investigación llevada a cabo por la matra ha revelado que Alkami, el dueño de este centro de formación, incitaba a los alumnos y sus familias a pedir préstamos con una alta tasa de interés con el fin de beneficiarse ilícitamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785202
					],
					"speakerTitle": "Tablón de avisos"
				},
				{
					"id": 190785202,
					"content": "El centro de formación ha cesado su actividad. Se devolverá a los alumnos los fondos recuperados de los préstamos una vez verificadas las solicitudes con cada uno de los prestatarios.",
					"roleType": "TALK_ROLE_NPC",
