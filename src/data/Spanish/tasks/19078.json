			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adán"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Hola, ¿puedo ayudarte en algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adán"
				},
				{
					"id": 190780402,
					"content": "¿Conoces a Alkami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "¿Alkami? ¿Te refieres a ese ricachón que se ha hecho tan famoso últimamente? Hubo una ocasión en la que me encargó unos muebles, fue bastante generoso por mis servicios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adán"
				},
				{
					"id": 190780405,
					"content": "He escuchado por ahí que solía ser un arquitecto de prestigio y que ahora ha decidido fundar un centro de formación en el que compartir sus conocimientos de arquitectura con aquellos que quieran seguir su camino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adán"
				},
				{
					"id": 190780406,
					"content": "Si pudiera permitirme el coste de la matrícula, a mí también me gustaría que mi hijo estudiase en ese centro. La arquitectura es una profesión muy lucrativa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adán"
				},
				{
					"id": 190780403,
					"content": "Quería preguntarte por Alkami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
			],
