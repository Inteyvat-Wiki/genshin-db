			},
			"dialogs": [
				{
					"id": 721170101,
					"content": "#¡Ah, qué momento tan perfecto, viajer{F#a}{M#o}! Casi todos los datos se han recopilado, ¡y ahora es el momento de recuperar nuestras balizas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "No hay problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Eso haré, eso haré. Mejor ser rápido y astuto también. ¡No dejes que esos Fatui te vean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "¿Cómo lo supiste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Estas balizas generalmente vienen con manuales de instrucciones muy detallados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Describen varias circunstancias diferentes y la cantidad de tiempo necesaria para la recopilación de datos en cada circunstancia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "En cuanto a las energías desconocidas, como la de los tatarigami, supongo que son lo que tomarán más tiempo. Dejo la tarea de las balizas en tus manos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
