			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "#Por tu aspecto... diría que eres {F#una viajera}{M#un viajero}, ¿cierto? ¿Dando un paseo por aquí? Buena elección.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310102,
					"content": "¿O es que también te gusta la pesca y le habías echado el ojo a estas aguas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310103,
					"content": "¡Pues tienes bueno ojo! Es el mejor sitio para pescar de toda la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310104,
					"content": "No se ve a nadie pescando por aquí. ¿Cómo estás tan seguro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310105,
					"content": "Pues porque tengo una vista muy fina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310106,
					"content": "Soy el mejor pescador de la zona, y sé muy bien lo que hace falta para encontrar buenos lugares de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310107,
					"content": "¿Ah, sí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "Pues a Paimon le parece que no estás teniendo demasiada suerte hoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310109,
					"content": "Bueno, basta de cháchara. Voy a enseñarles de lo que es capaz mi anzuelo infalible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310110,
					"content": "¿Anzuelo infalible?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "Si me traen algún material especial, haré un cebo yo mismo y podrán pescar peces que nunca habían visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310113,
					"content": "Eso suena... sospechoso. ¿De verdad funciona tan bien un cebo casero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310114,
					"content": "No perdemos nada por probar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "#¡Qué intrépid{F#a}{M#o}! ¡Así me gusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310116,
					"content": "Para preparar mis cebos caseros utilizo solsettias, trigo y otro material especial para darle su esencia única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310111,
					"content": "¿Qué es eso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
