						230310202
					]
				},
				{
					"id": 230310202,
					"content": "Mi intuición de hoy me dice que... Una duraznoliva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310203,
					"content": "Es un material muy común, pero no hay muchos que lo utilicen en cebos de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310204
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310204,
					"content": "Por favor, ayúdame a conseguir lo que te pedí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
