			"dialogs": [
				{
					"id": 230310601,
					"content": "Genial, ya tenemos todos los ingredientes. Aguarden un momento, voy a preparar mi cebo exclusivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310602,
					"content": "Kayvan prepara hábilmente su cebo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "Listo. ¡A pescar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310604,
					"content": "Los anzuelos están sumergidos a la profundidad adecuada y el flujo del agua es el correcto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310605,
					"content": "Tienen que estar en silencio. Los peces son muy perceptivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310606,
					"content": "Incluso el sonido de unas pisadas por la orilla podría sobresaltarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310607,
					"content": "#Me quedaré quiet{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "Bien, pues ahora solo queda esperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310610,
					"content": "Kayvan pesca un paquete empapado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "¿Pero qué es esto? ¡Esto no es un pez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310612,
					"content": "Ciertamente, es un pez que nunca antes había visto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "Ya veo. No me sorprende en absoluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310614,
					"content": "#*Ejem*, no sean tan quisquillos{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310615,
					"content": "En realidad, cualquier cosa que se saque del agua con un anzuelo se puede considerar un pescado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310616,
					"content": "Y les diré algo. La gente dice que soy el mejor pescador del mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310617,
					"content": "Al fin y al cabo, pescar una y otra vez cosas inertes que no muerden anzuelos es una gran hazaña, ¿no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310618,
					"content": "Los demás pescadores siempre me felicitan por mi talento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310619,
					"content": "A lo mejor intentaban consolarte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "Es decir, que pescas de todo menos peces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310622,
					"content": "¡*Ejem*! ¡No me importa lo que piensen! ¡Al menos yo nunca regreso a casa con las manos vacías!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310623,
					"content": "Si no es hoy, seguro que será mañana. ¡No tengo duda alguna de que un día pescaré un pez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310624,
					"content": "Muchas gracias por ir a buscar los materiales. Aquí tienen su recompensa. Yo me voy a pescar a otra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310625,
					"content": "La próxima vez... ¡Seguro que la próxima vez pescamos un gran pez! ¡Ya verás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310620,
					"content": "A lo mejor lo decían de broma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "Paimon ni siquiera pisa el suelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
