					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "¡Alrani! ¡¿Vas a salir de ahí o no?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050702,
					"content": "¡Jamás! ¡Si no puedo ser investigadora, jamás volveré a la Academia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050703,
					"content": "Después de todo, ¡ya les he pagado! ¡Déjenme en paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050704,
					"content": "Pero qué chica tan terca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050705,
					"content": "Eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "Ho-hola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050708,
					"content": "¿Eh? ¿Quiénes son ustedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050709,
					"content": "#¡V-viajer{F#a}{M#o}! *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050710,
					"content": "Conque aquí estabas, Alrani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050711,
					"content": "Es un alivio que estés bien...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "*Solloza*... ¡No es justo! ¡Yo escribí el tema de la tesis primero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050714,
					"content": "Si no me hubiera atrasado tanto en Inazuma, ¡la habrían aceptado! *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050715,
					"content": "Tranquila... Entonces, ¿aún piensas continuar con tu tesis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050716,
					"content": "*Snif*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050717,
					"content": "¡Renuncio! La tesis, la Academia... ¡Estoy harta! ¡Solo los tontos escriben tesis! ¡La Academia de Sumeru puede hacer lo que le dé la gana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050718,
					"content": "Le pagué a Narzam para que me proteja. ¡Nadie puede obligarme a escribir esa tesis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050719,
					"content": "¡Hum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050720,
					"content": "Y tú eres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "Me llamo Narzam, me dedico a... Bueno, ya debes saberlo, así que me ahorraré las molestias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050722,
					"content": "#Yo te conozco, eres {F#la famosa viajera de la}{M#el famoso viajero del} que tanto se habla por aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050723,
					"content": "Si alguien te encargó llevar de regreso a esta señorita, puedes intentarlo. No te detendré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050724,
					"content": "¡Oye, no olvides que te pagué!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050725,
					"content": "¿Y de qué sirve? Con esto no alcanza más que para comer unos días.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050726,
					"content": "Como sea, no pienso volver. Si regreso, tendré que pensar otra vez en el tema de la tesis, hacer investigación de campo, pasar días y noches sin descansar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050727,
					"content": "¿Quién sabe? Sujetos extraños podrían capturarme, o podría encontrarme con monstruos. Y entonces, no tendré tiempo para terminar mi tesis, y mucho menos para defenderla... de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050728,
					"content": "*Solloza*... ¡No! Prefiero quedarme aquí encerrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050729,
					"content": "#Viajer{F#a}{M#o}, por favor, entrégale un mensaje a Nilúfar de mi parte. Le escribiré una nota. Te lo pido por favor, no quiero regresar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050738,
					"content": "Alrani escribe la nota entre lágrimas y sollozos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "Toma... *Solloza*... ¿Por qué demonios inventaron las tesis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050731,
					"content": "Ya, ya... Tranquila, nadie te llevará de vuelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050732,
					"content": "Alrani se ve destrozada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050733,
					"content": "Dejemos que se quede aquí por el momento. Vamos a entregar la nota a Nilúfar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050734,
					"content": "Pero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "No se preocupen, seremos buenos con ella. Después de todo, nos ha pagado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050737,
					"content": "Además, por fin encontré a alguien con estudios, será de gran ayuda aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050735,
					"content": "Los ladrones de tesoros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "Nilúfar nos contó acerca de tu tesis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "Disculpa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
		},
