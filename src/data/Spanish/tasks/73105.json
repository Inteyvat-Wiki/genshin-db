			"dialogs": [
				{
					"id": 731050801,
					"content": "#¡Viajer{F#a}{M#o}! ¿Encontraste a Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050802
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050802,
					"content": "Lo que se dice encontrarla, la encontramos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050823,
					"content": "Le cuentan a Nilúfar lo ocurrido y le entregan la nota de Alrani.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050803
					]
				},
				{
					"id": 731050803,
					"content": "¿Narzam? ¿Cómo es posible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050804
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050804,
					"content": "¿La conoces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050805,
					"content": "Sí. Bueno, no la conozco personalmente, pero he oído hablar de ella. Dicen que es una ladrona de tesoros muy peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050806,
					"content": "Se dice que cuando asalta a alguien, siempre le hace una pregunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050807,
					"content": "Esa pregunta puede ser de literatura, elementos, e incluso acertijos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050808,
					"content": "Si respondes correctamente, no solo te devuelve tus pertenencias, también te escolta de regreso a la ciudad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050809,
					"content": "Pues sí, parece bastante rarita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "¿Quién se cree? ¿Una forajida de acertijos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Nadie sabe por qué lo hace. Yo solo sé de ella porque mi tutor se topó con ella en el campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050813,
					"content": "Le preguntó: “¿Qué llena rápidamente una habitación vacía?”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050814,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "¡El viento! ¿Correcto? ¡Sí, eso debe ser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Humm... ¿El resplandor de una vela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Mi tutor respondió: “Los elementos son omnipresentes”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "¡Eso es trampa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Jajaja... En fin, Narzam escoltó a mi tutor a la ciudad, e incluso se despidió muy educadamente de él.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050821,
					"content": "Si es ella la que está con Alrani, no hay de qué preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050822,
					"content": "Pero no puede quedarse ahí para siempre. Debo pensar en algo para ayudarla con su tesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050811,
					"content": "¿Qué estará tramando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
		{
