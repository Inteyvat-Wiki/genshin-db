			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "Alrani, espero que estés a salvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731053002,
					"content": "¿Cómo era Alrani en la Academia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Era una chica muy diligente, aunque siempre se topaba con callejones sin salida en los sitios más insospechados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731053004,
					"content": "Pero es una estudiante más que cualificada. Estoy segura de que se convertirá en una excelente investigadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731053005,
					"content": "¿Tan difícil es aprobar una tesis en la Academia de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "Siendo sincera, sí que lo es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731053007,
					"content": "La revisión de una tesis es un asunto muy complicado. Debes considerar no solo la dirección de tu investigación, sino también la disponibilidad de materiales de referencia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731053008,
					"content": "Además, debes tomar en cuenta otras tesis que tienen puntos en común con la tuya, o si no hay algún conflicto entre ellas. Después de entregar la propuesta de tesis, puedes encontrarte con todo tipo de dificultades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731053009,
					"content": "*Suspira*, Alrani tiene muy mala suerte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilúfar"
				}
			]
		},
