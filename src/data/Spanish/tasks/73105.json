			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Nilúfar",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani... ¿Dónde estarás?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050102,
					"content": "¿Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Humm... A Paimon le suena familiar ese nombre. ¿No es esa señorita que siempre está escribiendo su tesis? La que conocimos en la Isla Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "¡Eso es! Dijo que venía de la Academia de Sumeru y que estaba reuniendo material de investigación. Ya debería haber regresado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "Pero a esta mujer se la ve bastante inquieta... Preguntémosle si ha pasado algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "Si Alrani regresó a la Academia de Sumeru, podríamos pasar a saludar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "Hola, quería saber cómo está Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "¡¿Te enviaron del Gremio de Aventureros?! ¿La encontraron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050109,
					"content": "Discúlpenme que me haya alterado... Estoy muy preocupada por ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050110,
					"content": "Guau, tienes que calmarte un poco. No nos envía el Gremio de Aventureros, solo pasábamos por aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "¿Quién eres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "#¿No son ustedes aventurer{F#as}{M#os}? Disculpen, no he tenido ninguna noticia del gremio... y me están matando los nervios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050149,
					"content": "Le cuentas a Nilúfar las peripecias que has vivido con Alrani...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "#Así que tú eres {F#la viajera de la}{M#el viajero del} que Alrani no paraba de hablar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050114,
					"content": "Mi nombre es Nilúfar. Como podrás darte cuenta, soy una erudita de la Academia de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050115,
					"content": "Sin embargo, ahora dedico la mayor parte de mi tiempo a asesorar a los estudiantes en sus investigaciones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050116,
					"content": "Alrani es una de mis alumnas. Siempre ha tenido problemas para escribir su tesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050117,
					"content": "Entonces, ¿tú eres su tutora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Alrani nos comentó que tuvo que reescribir su tesis un montón de veces porque su tutora no la aceptaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "¡Pero no es momento para hablar de eso! ¿Qué le pasó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "Ella... desapareció.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050121,
					"content": "Hace un tiempo, Alrani vino desde Inazuma muy emocionada a enseñarme su tesis. Trataba sobre el folclore de la Isla Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050122,
					"content": "Se tomó la investigación muy en serio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "Sí, su tesis estaba muy bien escrita y tenía muy buen nivel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050125,
					"content": "¡Sin embargo, la entregó muy tarde! Le dije que debía enviarme su primer borrador con anticipación, pero nunca recibí nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050126,
					"content": "Para cuando entregó su tesis completa, alguien más ya había entregado una con el mismo contenido que la suya. ¡Incluso pasó la revisión preliminar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050127,
					"content": "Hice todo lo que pude para ayudarla, pero, aun así, su tesis no fue aceptada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050128,
					"content": "¡Imposible! Alrani empezó a organizar sus ideas desde hace tiempo, ¿por qué se retrasaría tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "Espera... Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "¡El Decreto de cierre de fronteras!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "No puede ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "No sabía cómo contarle la mala noticia... Pensaba esperar unos días y buscar una manera sutil de hablar con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050133,
					"content": "Pero algún chismoso se adelantó y se lo contó todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050134,
					"content": "Después de eso, desapareció. La busqué por toda la Academia de Sumeru, pero no la encontré. Así que no tuve más remedio que publicar un encargo en el Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050135,
					"content": "Hubo un aventurero que encontró su cuaderno en algún lugar, pero de Alrani, ni su sombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050136,
					"content": "En estos momentos, debe de haber aventureros buscándola por todas partes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050137,
					"content": "Yo... de verdad no sé qué más hacer... *Solloza*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050138,
					"content": "¡Yo también puedo ayudar a buscar a Alrani!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "#¡Sí! ¡Nosotr{F#as}{M#os} también podemos ayudar! Primero... ¡Primero busquemos por donde estaba su cuaderno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "¿De verdad ayudarán? Muchísimas gracias, en serio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050143,
					"content": "Marcaré la ubicación del cuaderno en su mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050144,
					"content": "Oh, en cuanto al pago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050145,
					"content": "Podemos hablar de eso en otra ocasión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Muchas gracias. Yo estaré aquí a la espera de alguna noticia del Gremio de Aventureros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050148,
					"content": "Alrani, espero que estés a salvo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilúfar"
				},
				{
					"id": 731050146,
					"content": "Se lo pediré a Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "¿Dónde encontraron el cuaderno de Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "¡Podemos ayudar a buscar a Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050123,
					"content": "Ha trabajado muy duro en su investigación.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
			"completionStepIds": [
				7310505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310505",
							"2"
						],
						"stepId": 7310505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gobley",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "¡Por favor, ten misericordia! ¡Esto es un malentendido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050502,
					"content": "Aquí no se malentendió nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "¿Qué le hicieron a la Srta. Alrani? ¡Hablen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050504,
					"content": "¡O les daremos una paliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050507,
					"content": "No, no, por favor. Por favor, tienen que escucharme, es un malentendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050508,
					"content": "¡No nos atreveríamos a meternos con esa chica! ¡No somos rivales para ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050509,
					"content": "¿A qué te refieres?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "Es una larga historia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050512,
					"content": "Hace un tiempo, estábamos algo cortos de Moras, así que la jefa nos buscó una forma de llenarnos los bolsillos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050513,
					"content": "¡Hum! ¡Por el camino del crimen, seguramente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050514,
					"content": "Después de todo, somos ladrones de tesoros, es lo que hacemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050515,
					"content": "Estábamos en el campamento ocupados con nuestros propios asuntos, cuando de pronto vimos a una jovencita acercándose con una bolsa enorme a cuestas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050516,
					"content": "Se veía fuera de sí misma, así que nos dio un gran susto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050517,
					"content": "Justo cuando nos disponíamos a echarle el guante, se dejó caer a un lado de la fogata mientras lloraba a moco tendido y arrojaba una pila de libros al fuego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050518,
					"content": "Daba mucho miedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050519,
					"content": "Espantados por una mujer joven...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "Ay, aunque seamos ladrones de tesoros, no mataríamos ni a una mosca. Solo robamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050522,
					"content": "Antes de que pudiéramos reaccionar, nos lanzó un saco de Moras y nos pidió que la encerráramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050523,
					"content": "¿Pero qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050524,
					"content": "No tiene sentido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "Al principio, nadie se atrevía a ponerle un dedo encima, pero no comía ni bebía nada. Solo insistía en que la encerráramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050527,
					"content": "Al final, la jefa nos pidió construir una jaula con unas ramas y dejarla entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050528,
					"content": "Qué buena jefa tienen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "Bueno, la jefa siempre ha sentido gran admiración por las personas con estudios. Dice que a ella también le gustaría ir a la escuela si tuviera la oportunidad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050531,
					"content": "Pero si no me creen, la señorita se encuentra por allá. Pueden verla con sus propios ojos. La jefa todavía debe estar tratando de consolarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050532,
					"content": "¡Estamos más que dispuestos a pagarles si logran convencerla de que salga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050529,
					"content": "Así que estaban siendo buenas personas con Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "Entonces, ¿la encerraron?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "¿No se supone que son ladrones de tesoros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "Así que, en efecto, tienen a Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "¡¿Qué le hicieron a Alrani?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "¡Desembuchen! O si no... ¡les daremos una paliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7310507,
			"completionStepIds": [
				7310507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
