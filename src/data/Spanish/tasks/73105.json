	"talks": [
		{
			"id": 7310501,
			"completionStepIds": [
				7310501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
