					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690103,
					"content": "El campo de combate se encuentra en constante cambio. Solo manteniéndote alerta todo el tiempo podrás comprender la situación y dominar todas las variables.",
