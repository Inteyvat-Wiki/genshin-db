			},
			"dialogs": [
				{
					"id": 761230101,
					"content": "¡Qué bien huele! ¿Hemos vuelto a venir a la hora de la comida de Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Esas kuuhenki... ¿están formando una fila? ¡Y Colombina está repartiendo sopa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Un momento, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230104,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "¡Guau! Esto está riquísimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Una sopa de frutas refrescante y deliciosa... ¡Paimon nunca había probado algo así!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "¿Quieres repetir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230108,
					"content": "¡Sí, quiero dos cuencos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "¿Has estado aprendiendo a cocinar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Sí, le pedí a Ineffa algunas recetas sencillas y he hecho algunos intentos. Las kuuhenki y los animales han respondido muy bien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230112,
					"content": "¿Tienes algún problema en la cocina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Bueno... Mis mangas son muy anchas. Si no tengo cuidado, es fácil que rocen la olla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230114,
					"content": "(Entonces, no es la cocina en sí lo que te está causando problemas.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "También me cuesta bastante preparar postres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230116,
					"content": "Tienes que conseguir que la temperatura y las proporciones sean las exactas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230117,
					"content": "(No debe de haber cocinado mucho ella misma en el pasado.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Además, es especialmente difícil preparar postres y otros aperitivos cuando trabajas en solitario...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "¿Quieres que te ayude?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Claro. ¿Qué tal si empezamos con los krumkakes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230121,
					"content": "Después de un tiempo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "¿Te gustaría probar uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230123,
					"content": "Darle un pequeño mordisco",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230126,
					"content": "(El primer bocado es tan ácido que seguro que he arrugado la cara...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Pero después de tragarlo, la dulzura vuelve a aparecer... Tal vez mejora una vez que te acostumbras...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "¿Qué tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230129,
					"content": "Aprobado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "¿Qué se ha perdido Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Paimon, prueba esto, rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "¡Aaaah, está muy ácido! ¿Qu-qué intentan hacerle a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Jaja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230136,
					"content": "Pero el regusto que deja no está nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "¡El sabor inicial es lo importante! ¿Por qué no avisaron a Paimon para que le diera un bocado más pequeño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "Si no hubieras dicho nada, Paimon habría pensado que era una broma pesada. Para ver cómo arruga la cara la gente y eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "Está bien. Dejen que lo intente de nuevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230140,
					"content": "Pasado más tiempo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Aquí tienen. Prueben estos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230142,
					"content": "(¡Vaya! ¡Estos están mucho mejor!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "¡Está delicioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "¿De veras? ¡Paimon también quiere! Mmm... ¡Esto está mucho mejor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "¿Lo suficientemente bueno para poder hacer de regalo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230147,
					"content": "¡Claro! Oh, ¿has aprendido a cocinar y hacer krumkakes porque querías preparar un regalo para alguien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Sí... Para mis amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230149,
					"content": "¡Esa es una gran idea!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "¿Recuerdan cuando vinieron aquí por primera vez? Me prepararon algo de comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230151,
					"content": "Aunque la comida no pudo ayudarme a recuperar el poder que había perdido, sí que hizo que me sintiera mucho más relajada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230152,
					"content": "En ese momento no le di muchas vueltas, pero ahora lo entiendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230153,
					"content": "El tiempo y el esfuerzo dedicados a preparar la comida a mano es lo que la dota de alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230154,
					"content": "Lo que disfruté no fue simplemente la comida en sí, sino la calidez y la amabilidad de las manos que la prepararon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230155,
					"content": "Y cuanto menos busquen esas manos una recompensa, mayor será la calidez y bondad necesarias para corresponderlas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230156,
					"content": "Ah, a Paimon le da vergüenza escucharte decir eso... Pero en ese momento queríamos ganarnos tu favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "Ahora las cosas son diferentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Sí, pero ahora que he comprendido todo esto, me gustaría hacer un poco más... Me pone muy contenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230160,
					"content": "¿Quieren acompañarme a visitar a nuestros amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230161,
					"content": "Además de los krumkakes, he preparado algunos regalos más. Oh, pero habría que enviarlos en secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230162,
					"content": "¿Por qué en secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "Bueno, siempre han sido ustedes quienes me han dado buenas sorpresas. Me gustaría ver cómo reaccionan nuestros amigos cuando cambien las tornas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230164,
					"content": "Uff, hemos estado corriendo de aquí para allá por todas partes... Por fin terminamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Algunas de las reacciones fueron sorprendentes, pero varios ni siquiera se dieron cuenta de que los regalos venían de ti, Colombina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "A Aino solo le importó zampárselo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Eso no importa, ya esperaba algo así. Lo importante es que se pusieran contentos al recibirlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230168,
					"content": "Lauma sabía perfectamente que los krumkakes y la guirnalda de su mesa eran de tu parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Paimon podría entender que dudara en ponerse la corona de flores, pero se quedó mirando los krumkake durante diez minutos sin atreverse a comer uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "#Estaba segur{F#a}{M#o} de que los convertiría en reliquias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Parece que Jahoda se llevó un buen susto... Tal vez no deberíamos haber dejado los regalos justo detrás de ella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230172,
					"content": "Qué bote pegó del susto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Quizá siempre esté más alerta. Pero bueno, pareció calmarse cuando Ashru se acercó para arañar el rascador que enviaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Cuento con ustedes para entregar los regalos a los amigos que no se encuentran en Nod Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "Colombina"
				},
				{
					"id": 761230175,
					"content": "¡¡...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Ibis plumalarga"
				},
				{
					"id": 761230176,
					"content": "Debo admitir que se te da muy bien eso de hacer regalos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
