			},
			"dialogs": [
				{
					"id": 750290701,
					"content": "#¡Enhorabuena, guerrer{F#a}{M#o}, me superaste! Pero si quieres ser {F#una heroína}{M#un héroe} aún más grandios{F#a}{M#o}, no puedes rezagarte. ¡Tienes que seguir trabajando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502908,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
