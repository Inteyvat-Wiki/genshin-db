				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291401,
					"content": "¡No te equivoques con el orden! <color=#00E1FFFF>Primero hay que hacer sonar el cuerno de la izquierda, luego el de la derecha, y finalmente el de la izquierda</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291402,
					"content": "(Parece un recordatorio que alguien llamado Matahga escribió para sí mismo. Aunque solo está por escrito, se puede apreciar lo apasionada que es esta persona.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291403,
					"content": "(Cuántos signos de exclamación... ¿De verdad le sirve de algo ponerlos?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}