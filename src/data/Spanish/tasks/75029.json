				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290801,
					"content": "Ya lo verás, ¡me convertiré en un guerrero! No, ¡en un héroe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502913,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
