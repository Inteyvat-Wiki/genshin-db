			},
			"dialogs": [
				{
					"id": 750290601,
					"content": "No está mal. Si sigues así, podrás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290602,
					"content": "¡Ja! Te encantaría que dijera algo así, ¿verdad? Pues que sepas que, en el diccionario de un gran guerrero, no existen expresiones del tipo “no está mal”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290603,
					"content": "¡Solo existe “genial” o “perfecto”! Si no llegas a ese nivel, ¡eres un fracaso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290604,
					"content": "Si aún te atreves, ¡vuelve y entrena hasta que me hayas superado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
