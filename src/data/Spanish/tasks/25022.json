			"dialogs": [
				{
					"id": 250220101,
					"content": "Humm... Tendremos que intentarlo con una receta distinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220102,
					"content": "Gruuu, ¡gruuuuuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220103,
					"content": "¿Se te ha ocurrido otra idea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "¡Gruuu, gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220107,
					"content": "Normalmente Houra podía terminarse una bandeja de fruta entera y retozar todo el día.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220108,
					"content": "Ahora apenas come un poco más de la mitad y después se sienta a mi lado y no se mueve ni lo más mínimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220109,
					"content": "Pensaba que estaba enfermo, y me asusté tanto que fui a buscar al médico en mitad de la noche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220110,
					"content": "Estuvimos la noche entera sin parar, pero al final nos dimos cuenta de que no estaba enfermo, simplemente es... delicado con la comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220111,
					"content": "El médico dijo que lo mejor sería cambiar su alimentación.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220112,
					"content": "También dijo que podría probar a tocar algo de música para Houra mientras come, y que eso podría estimular su apetito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220113,
					"content": "No es mala idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Jajaja, sí, encontré un vinilo y a Houra le encantó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220116,
					"content": "Sin embargo, Houra se levantó de un salto y partió el vinilo por la mitad de un bocado... Así que me vi obligado a abandonar ese plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220117,
					"content": "Al fin y al cabo para un Tepetlisaurio como Houra, un vinilo hecho de obsidiana y flogisto puede resultar delicioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220118,
					"content": "Ahora no me queda otra que ir a pedirle ayuda a los Retoños Arbóreos, a ver si puedo encontrar ingredientes exóticos que le gusten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220119,
					"content": "Yo te ayudaré a buscar los ingredientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "#¿Estás dispuest{F#a}{M#o} a ayudarme? ¡Eso sería genial! La gente de Retoños Arbóreos solo podría encontrar ingredientes en Natlan, ¡pero para ti no existen las fronteras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220124,
					"content": "Espera un momento, voy a ver la lista de ingredientes sugeridos que me dio el médico. Ese señor sabe de todo, incluso conoce cosas de fuera de Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220125,
					"content": "Humm... Dice que deberíamos probar con <color=#00E1FFFF>rosarcoíris, calavandas</color> y <color=#00E1FFFF>flores chingxin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220122,
					"content": "Bueno, entonces te encargo a ti que busques nuevos ingredientes y me los traigas cuando puedas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220123,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220120,
					"content": "A mí se me da muy bien encontrar ingredientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "¿De verdad existe un vinilo así?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Acaricias a Houra.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "¡Gruuu, gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
