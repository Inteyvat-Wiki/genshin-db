					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220405,
					"content": "(Houra le da un gran bocado a la calavanda y se la termina en un abrir y cerrar de ojos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
