			"dialogs": [
				{
					"id": 250220301,
					"content": "Qué flor tan hermosa. Hasta su nombre es bonito... Houra, ¿quieres probarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "Gruuu, ¡gruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220305,
					"content": "(Houra mastica con cautela, saboreando cuidadosamente los pétalos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220306,
					"content": "Gruuu, gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220307,
					"content": "¡Vaya! Parece que le encanta. Pero ¿podrá llenarse comiendo solo flores?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Además, este tipo de flor no parece muy barata... En fin, por el momento lo anotaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "¿Qué clase de comida se puede preparar con flores? Humm... ¿Quizás un pastel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
