				},
				{
					"id": 250220406,
					"content": "Gruuu, ¡gruuuuuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220407,
					"content": "Jajaja, se la ha terminado en un instante. ¿Tanto te gustó, Houra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220408,
					"content": "Gruuu, ¡gruuu! Gruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220409,
					"content": "¡Muy bien! Ahora en un rato iré a preguntárselo a alguien... Tengo que ver dónde puedo encontrar mercaderes de Inazuma para comprar más calavandas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
