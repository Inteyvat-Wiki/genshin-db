			"dialogs": [
				{
					"id": 250220501,
					"content": "Humm, esta flor huele bastante bien, tiene un aroma muy refrescante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220504,
					"content": "¿Houra? Tú... ¡Vaya! ¡Ya se la ha tragado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220505,
					"content": "(Houra se zampa la flor chingxin de un bocado y luego los mira parpadeando.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Houra"
				},
				{
					"id": 250220506,
					"content": "Sin previo aviso, Houra se da la vuelta y engulle de golpe la mitad restante de la bandeja de frutas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "¿Cómo es que tiene tan buen apetito de repente? ¿Tan efectivas son estas flores chingxin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220508,
					"content": "Tengo que ir a hablarlo con el médico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
