				"points": [
					{
						"sceneId": 3,
						"position": [
							88.947,
							296.446,
							2250.41
						],
						"pointId": 331500135
					}
				]
			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "*Puff*... No está... nada mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320202,
					"content": "Jeje, ¡si hubiéramos corrido una distancia más larga seguro que me habrías alcanzado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "¡Avín, eres tan rápida como Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "He ganado carreras contra muchos adultos. Que tengan las piernas más largas no significa que corran más rápido, lo importante es estar en forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320205,
					"content": "Dentro de unos años me darás mil vueltas, jajaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Hum, veamos... ¿Hacia dónde deberíamos ir ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "¡Ah, miren! ¡Más adelante hay algo flotando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "¿Eso es... una estrella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "¿Quiere que la sigamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320210,
					"content": "Humm, tal vez. ¡Sigámosla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1303205,
			"completionStepIds": [
				1303205,
				1303214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303205",
							"2"
						],
						"stepId": 1303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avín",
					"Yoimiya",
					"Arashani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "Hemos llegado a nuestro destino, pero no hay rastro de ningún aranara. Solo hay una roca gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320502,
					"content": "Estoy tan feliz, ya casi había olvidado cómo se siente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320503,
					"content": "¿Saben qué? Cuando no era capaz de correr, sentí que mi mundo se había vuelto diminuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320504,
					"content": "Pero si continúo avanzando hacia delante, puedo contemplar nuevos horizontes, como si el mundo se expandiera sin límites ante mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320505,
					"content": "No tengo ni idea de cómo lo hice, estoy segura de que es gracias a ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320506,
					"content": "Ay, eso no importa. Lo importante es que recordaste muchas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320507,
					"content": "Los recuerdos no solo representan el pasado, también tienen el poder de iluminar nuestro futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320508,
					"content": "En cuanto te hayas recuperado de tu enfermedad, la felicidad volverá a estar contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320509,
					"content": "#¡Gracias, Yoimiya! ¡Gracias, chic{F#a}{M#o}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320510,
					"content": "Sigamos buscando a Arashani, no parece que esté aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320511,
					"content": "Cierto, ¿pero entonces por qué nos ha traído esa estrella hasta aquí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320512,
					"content": "No puedo apartar los ojos de esta roca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "Yo tampoco sé exactamente lo que es... pero me resulta familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320514,
					"content": "Como si fuera una parte de mí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320515,
					"content": "¡Ya sé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320516,
					"content": "¿Será que esta es su azurroca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320517,
					"content": "¿A-azurroca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320518,
					"content": "(Qué bien se le da a Yoimiya seguir el juego.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "(¡Por un momento me había olvidado de la azurroca!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "Es un mineral extraño que simboliza las aspiraciones y los sueños de una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320521,
					"content": "Si tú puedes verlo, significa que ya has recuperado lo que perdiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320522,
					"content": "Conque de eso se trata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320523,
					"content": "Suena como uno de esos cuentos para niños, pero yo dejé de creer en esas cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320524,
					"content": "Aun así, me alegra volver a creer en ellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320525,
					"content": "¿Eh? ¡P-pasó a través de ella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320526,
					"content": "#¡Vayamos nosotr{F#a}{M#o}s también!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320527,
					"content": "#¡Eh, eh! ¡Yoimiya! *Suspira*, no tenemos otra opción, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320528,
					"content": "Lo atravesamos, pero no parece que haya cambiado nada en los alrededores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320529,
					"content": "Cuánto tiempo sin verte, nara Avín. Ha pasado mucho tiempo, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320530,
					"content": "Arashani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320531,
					"content": "¿Por qué tan triste? Oh, Arashani sabe. En realidad es cara de felicidad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320532,
					"content": "¡Arashani! *Solloza*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320533,
					"content": "#Jajaja, qué viaje tan magnífico han preparado los aranara para nosotr{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320534,
					"content": "No solo ayudaron a Avín a reencontrarse con su mejor amigo, también nos mostraron qué es exactamente la azurroca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320535,
					"content": "Ahora tendremos que ir en busca de nuestras azurrocas, ¿eh? Tengo que conseguir la lente más pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320536,
					"content": "¡Así se habla! Paimon no sabe por qué, ¡pero también siente que lo lograremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320537,
					"content": "¡Ese es el espíritu aventurero!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "Lo he pasado muy bien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "Primero tendremos que llevarla de vuelta a Sumeru, seguro que su madre sigue alarmada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320540,
					"content": "Admiran el paisaje ante sus ojos como si de un sueño se tratase. En un abrir y cerrar de ojos, regresan al lugar donde se encontraban antes.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
