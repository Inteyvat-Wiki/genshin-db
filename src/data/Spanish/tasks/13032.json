			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapurva",
					"Avín",
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "Humm, Paimon se pregunta a qué te refieres con eso de “estar preparada”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320102,
					"content": "Nara Avín todavía no recuerda todo. Ni recuerdos ni sueños pueden faltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320103,
					"content": "Sueños...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320104,
					"content": "Pero yo ya no puedo ponerme de pie. Aunque lo hiciera, no sé cuánto tardaría.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320105,
					"content": "No tienes que preocuparte de eso. Nara Avín tiene que recordar que sueños están conectados con corazón, no con cuerpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320106,
					"content": "¿Con mi corazón?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320107,
					"content": "Arapurva acompañará a nara hasta aquí. Ahora, nara Avín deberá buscar por sí misma cosas más valiosas para ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320108,
					"content": "¿Eh? ¿Eso fue todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320109,
					"content": "Parece que el cielo de esta zona también ha cambiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320110,
					"content": "Mi corazón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320111,
					"content": "¡...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320112,
					"content": "¡¿Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320113,
					"content": "M-me he... Me he puesto de pie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320114,
					"content": "No me cuesta moverme ni siento nada extraño. Me siento igual que antes, cuando todavía no había enfermado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320115,
					"content": "Eso quiere decir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320116,
					"content": "... Que estamos dentro de un sueño.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "No es la primera vez que nos adentramos en un sueño. Con razón mencionó que no tenemos de que preocuparnos, Avín puede moverse a su antojo dentro del sueño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320118,
					"content": "¡Miren, me he levantado! Jeje, ¡estoy de pie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320119,
					"content": "#¡Eso es maravilloso! Así podremos ir junt{F#a}{M#o}s a buscar a Arashani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320120,
					"content": "¡Echemos una carrera! ¡Muéstrame lo rápida que eres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320121,
					"content": "Quizá no me he recuperado del todo todavía...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320122,
					"content": "¡Da igual! ¡Vamos allá, a correr se ha dicho! ¡No me da miedo competir con una adulta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320123,
					"content": "¡Corre, gacela Avín!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320124,
					"content": "Esto ha ido mejor de lo que Paimon esperaba, no ha necesitado mucho tiempo para recuperarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320125,
					"content": "La niña tiene un don.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "Jeje, eso es. ¡Vayamos tras ellas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320126,
					"content": "Debe de ser el poder de los deseos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
		{
			"id": 1303202,
