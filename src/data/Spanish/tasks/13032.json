			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "El sueño... se ha acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320602,
					"content": "¡Pero fue un sueño adorable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320603,
					"content": "No te pongas triste, ¡mira quién está a tu lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320604,
					"content": "¡Arashani! ¡Aún estás aquí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320605,
					"content": "Arashani te debe disculpas. Arashani quería encontrar a nara Avín, pero no recordó a qué hora volver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320606,
					"content": "Arashani no se atrevía a entrar en ciudad, no vio a nara Avín y pensó que nara Avín había hecho nuevos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320607,
					"content": "Es normal y no tiene remedio, no hay de que preocuparse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320608,
					"content": "Está bien, lo entiendo. Todo esto pasó porque perdí los ánimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320609,
					"content": "Pero ahora lo entiendo. Yoimiya tiene razón, todos tenemos mala suerte, pero siempre podremos apoyarnos los unos a los otros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320610,
					"content": "Gracias a la ayuda de todos, he recuperado mis recuerdos y mis sueños.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320611,
					"content": "#Jeje, tú también nos ayudaste mucho, pequeña. ¡No tienes por qué dar las gracias! Nosotr{F#a}{M#o}s no sabíamos por dónde empezar a buscar la azurroca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320612,
					"content": "Pero ahora que vamos por buen camino, ¡será más fácil encontrarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320613,
					"content": "Yoimiya, quieres ver una lluvia de estrellas, ¿verdad? ¿Es por eso que buscas la azurroca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320614,
					"content": "Sí, y cuando la encontremos, ¡podrás acompañarnos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320615,
					"content": "Si es por eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320616,
					"content": "Entonces, yo estaré encantada de prestarte mi azurroca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320617,
					"content": "¡¿Qué?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320618,
					"content": "¿Qu-qué es lo que acaba de pasar? ¿Acaba de sacarse una lente del pecho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320619,
					"content": "Yo tampoco entiendo nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320621,
					"content": "Jajaja, ¿cómo sabías que necesitaba esto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320622,
					"content": "No lo sabía. Lo único que sé es que tú me ayudaste a recuperar a mi mejor amigo, así que quiero compensarte con mi bien más valioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320623,
					"content": "Y entonces la luz se convirtió en esto. ¿Es lo que necesitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Avín"
				},
				{
					"id": 130320624,
					"content": "Gracias, no esperaba que resolviéramos nuestro problema de esta manera. Entonces, ¡voy a probarla ahora mismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320625,
					"content": "No tengo muy claro cómo se usa, así que me guiaré por mi intuición...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320626,
					"content": "¿Dónde estás?... ¿Dónde estás?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320627,
					"content": "¡Oh! Creo que ya la encontré, es más que obvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320628,
					"content": "Vamos, yo les indicaré el camino. Te llevaremos a casa en cuanto terminemos de ver la lluvia de estrellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320629,
					"content": "Además, quería darles las gracias a ustedes por su ayuda, pero será mejor que me ahorre las cortesías y que les haga un cumplido de todo corazón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320630,
					"content": "¡Son los mejores cuentacuentos que he conocido nunca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320631,
					"content": "Oh, qué coincidencia. Arapurva también piensa lo mismo de ti, nara roja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapurva"
				}
			]
		},
