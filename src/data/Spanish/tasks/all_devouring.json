			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "#¡{NICKNAME}, Skirk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360302,
					"content": "¿Qué acaba de pasar? Parecía como si el hombro de Skirk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360304,
					"content": "En la Llanura Guili, me preguntaste por qué el enemigo te había elegido como presa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360305,
					"content": "Ahora, la respuesta es evidente. Además de poseer una fuerza extraordinaria, tienes la habilidad de “purificar” el poder del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360306,
					"content": "Implique lo que implique eso, lo cierto es que esa habilidad le ha permitido hacer algo que, de otra manera, le habría resultado imposible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360307,
					"content": "Como, por ejemplo, atravesar mis defensas y robar mi poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360308,
					"content": "Entonces, ¿su objetivo eras tú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "No, él no tenía forma de saber que yo iba a venir a su dominio. Simplemente tomó tu fragmento de alma porque sabía lo valioso que es tu poder. No creo que esperara que fuera a serle útil tan pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360311,
					"content": "Llámalo “destino” si quieres. Creo que es el término que usan en este mundo para las coincidencias arbitrarias como esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360312,
					"content": "De todos modos, esto también nos beneficia, porque si averiguamos para qué quiere usar tu poder, podremos recuperar lo que perdiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360313,
					"content": "Pero tú...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "Me las arreglaré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360315,
					"content": "Bueno, ¿ya estás saciado? Es hora de responder algunas preguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360316,
					"content": "¿Cómo obtuviste el poder del Narval Devoraestrellas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360317,
					"content": "¡¿El Narval Devoraestrellas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360318,
					"content": "Ohh... ¡Claro! Paimon sabía que esa púa le resultaba familiar. ¡Es como el cuerno del Narval!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360319,
					"content": "Corrígeme si me equivoco, pero dudo mucho que hayas adquirido ese poder con tu propia fuerza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360320,
					"content": "Si tuvieras la fuerza necesaria para derrotar al Narval Devoraestrellas, no tendrías que ir en busca de los vestigios de poder que puedas encontrar de unos restos divinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360321,
					"content": "Lo que nos deja una posibilidad: conoces a mi maestro, Surtalogi, el Caballero Protervo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360322,
					"content": "El Caballero Protervo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360323,
					"content": "¿Quién se atreve a llamarlo “protervo”? Surtalogi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360324,
					"content": "¡Surta...logi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360325,
					"content": "¿Qué pasa? ¿Estás tan abrumado por el poder que has perdido la capacidad de comunicarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360326,
					"content": "Solo un poco más. Yo... aún no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360327,
					"content": "¡Miren! ¡Otra vez esas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360328,
					"content": "Aquellos obsesionados con el poder preferirán que este los devore antes que abandonar su búsqueda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360329,
					"content": "¿Qué vamos a hacer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "Mantén la calma y utiliza la razón para tomar la decisión que consideres más adecuada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360331,
					"content": "(Skirk fue apuñalada por una de las púas al intentar recuperar el fragmento de mi alma y, en el proceso, le robaron parte de su poder.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "(El culpable se encuentra detrás de la niebla. Durante la pelea, me he ido haciendo una idea de su estilo de ataque. Si lo seguimos, tendremos una buena probabilidad de ganar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "(Pero la respiración de Skirk es más débil que de costumbre. Si atacamos ahora, no puedo garantizar su seguridad ni la de Paimon. Es una decisión difícil de tomar, pero...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "Creo que deberíamos salir de aquí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "Sabia decisión. La victoria final no siempre se consigue tras una sola batalla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360336,
					"content": "#Has recuperado el fragmento de tu alma, así que amb{F#a}{M#o}s tenemos lo que vinimos a buscar. Deja que el enemigo respire mientras pueda. No será por mucho tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360337,
					"content": "Vámonos. Esta vez dependemos de ti para salir de aquí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360309,
					"content": "¿Iba tras de ti desde un principio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
