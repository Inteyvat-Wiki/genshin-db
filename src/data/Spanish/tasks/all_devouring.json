			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Skirk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365001,
					"content": "Sabe algo sobre el maestro, estoy segura. La próxima vez que nos veamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365002,
					"content": "¿Qué tal llevas la herida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "Bien. Solo es un rasguño.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365004,
					"content": "Aunque necesito tiempo para recuperar mi poder, ya estoy acostumbrada a este tipo de imprevistos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365005,
					"content": "Tu ropa parece diferente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "¿Esto? Es un conjunto cristaestelar. El poder del Abismo en Teyvat es muy escaso. Llevar esto me ayuda a usarlo con más libertad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365007,
					"content": "Contiene poder del Abismo concentrado que puedo usar sobre la marcha. Cuando se agote, volverá a su forma original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365008,
					"content": "Vámonos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "¿Has encontrado un lugar para descansar? Bien. Entonces, salgamos de aquí cuanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				}
			]
		},
		{
			"id": 1503651,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
