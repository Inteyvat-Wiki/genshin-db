			"dialogs": [
				{
					"id": 150360501,
					"content": "Uff, aquí deberíamos estar a salvo, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360502,
					"content": "No detecto su presencia. Parece que sigue en el dominio del Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360503,
					"content": "Mi poder no es algo que los débiles puedan controlar fácilmente. No creo que vaya a salir hasta que haya terminado de digerirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360504,
					"content": "El Narval Devoraestrellas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "#Pareces sorprendid{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360507,
					"content": "Supongo que es normal... No has visto más que una fracción de lo que esa ballena es capaz de hacer. Esas fauces abiertas podrían tragarse un planeta entero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360508,
					"content": "Se llama Narval Devoraestrellas por algo: “devorar” es lo que mejor sabe hacer. Puede extraer energía de cualquier cosa, viva o muerta, siempre que consiga establecer contacto físico con ella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360509,
					"content": "Sí, cuando tuvimos nuestro encontronazo con esa cosa, Neuvillette dijo que tenía un “instinto devorador”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360510,
					"content": "#Su amigo dragón reconoció la naturaleza de sus habilidades y utilizó el poder del elemento Hydro para protegerl{F#a}{M#o}s. Eso funcionó porque el Narval Devoraestrellas estaba saciado, así que se mostró algo menos agresivo de lo habitual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360511,
					"content": "Pero la cosa cambia cuando no tiene energía de la que alimentarse. Es entonces cuando su verdadera naturaleza voraz entra en acción. Podría devorar todo el planeta en ese estado, por eso lo arrojé a ese espacio vacío.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360512,
					"content": "No esperaba que alguien en este planeta pudiera usar su poder. Eso significa que ese tipo vio al Narval Devoraestrellas hace mucho tiempo. Debe de tratarse de un conocido de mi maestro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360513,
					"content": "Sí, es cierto que reaccionó al oírte nombrar al “Caballero Protervo”.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "#Exacto, me dijo todo lo que necesitaba saber. Por eso he dicho que amb{F#a}{M#o}s tenemos lo que buscábamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360515,
					"content": "#Y creo que eso pone fin a nuestra transacción. Ahora que estás complet{F#a}{M#o} de nuevo, puedes continuar con tu viaje. Me encargaré del resto de este asunto yo misma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360516,
					"content": "¡Ni hablar! ¡No podemos irnos ahora! ¡Te robaron algo por nuestra culpa y tenemos que ayudarte a recuperarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360517,
					"content": "No es la primera vez que pruebo el fracaso o la pérdida de poder. Cuando te caes, te vuelves a levantar y te haces más fuerte. Así son las cosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360518,
					"content": "Pero... ¿Y si ese monstruo te encuentra antes de que te recuperes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360519,
					"content": "Además, ¿cómo vas a volver a casa si no tienes tu poder? No es como si pudieras chasquear los dedos y abrir un portal al Abismo otra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360520,
					"content": "#Al menos por ahora, no es tan malo que te quedes con nosotr{F#a}{M#o}s, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360521,
					"content": "No es por compasión.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360524,
					"content": "Entiendo su razonamiento. Tomen esto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360525,
					"content": "¿Qué es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360526,
					"content": "Una bolsa de Moras. Si algo tengo claro, es que nada en este mundo es gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360527,
					"content": "Dejaré que ustedes hagan los planes. Dense prisa y decidan dónde ir. No deberíamos entretenernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360522,
					"content": "Dijiste que no debería estar en deuda contigo. Bueno, pues aún lo estoy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "No puedo creer que incluso haya podido robar tu poder...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
		},
