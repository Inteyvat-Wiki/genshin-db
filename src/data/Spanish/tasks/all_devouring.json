				"objectNames": [
					"Baizhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365101,
					"content": "Tienes mucho mejor aspecto que la última vez. ¿Supongo que tu problema de salud ya está resuelto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365102,
					"content": "Humm, tu cassso parecía muy complejo. Quizá sssea demasiado pronto para celebrarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365103,
					"content": "En efecto. No estaría de más tenerte en observación durante un tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365104,
					"content": "No hemos tenido muchos pacientes últimamente, así que tenemos varias habitaciones libres. No dudes en quedarte unos días más si lo necesitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365105,
					"content": "¡Genial! ¡Muchas gracias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
