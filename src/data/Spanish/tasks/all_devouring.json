				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Parece que ya no hay por donde seguir. ¿Es este su escondite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360202,
					"content": "¡Uf! ¡Con esta niebla es imposible ver nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360203,
					"content": "Este es el lugar donde te atacaron y perdiste el fragmento de tu alma, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360204,
					"content": "La parte que falta de tu alma debería estar cerca. ¿Puedes sentir dónde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360205,
					"content": "(Si cierro los ojos y me concentro en la luz que salía de mi herida en aquel momento... Sí, puedo sentir algo, y está cerca, pero no sé la ubicación exacta.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "No lo sé con exactitud...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "Humm, nuestro oponente debe haber ocultado su aura por si acaso. De lo contrario, deberías haberlo sentido mucho más intensamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360209,
					"content": "Un momento, ¡miren! ¡Otra vez esas púas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360210,
					"content": "Mantengamos la calma. Contengámonos un poco, demos a nuestro enemigo cierto margen de maniobra para ver a qué nos enfrentamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360211,
					"content": "Tomó parte de tu alma por una razón. Es probable que la integrara en sus ataques de alguna manera. Si somos inteligentes, podremos rastrearlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360207,
					"content": "Solo sé que está por aquí cerca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
