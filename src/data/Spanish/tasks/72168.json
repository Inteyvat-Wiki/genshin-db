					"nextDialogs": [
						721680404
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680404,
					"content": "¿Puedes repetir ese método?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "El método específico es así: Hay que encontrar en los alrededores una cosa llamada rama del Cerezo del Trueno y tocarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "Después debería aparecer algo llamado electrógrano que se adhiere a tu cuerpo y te permite atravesar esa barrera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
