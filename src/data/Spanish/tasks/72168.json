				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Parvaneh, ¿estás segura de que no hay otro método?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680202,
					"content": "En mi libro solo aparece este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680203,
					"content": "Ay... Si lo que bloqueara el camino fueran unos simples monstruos, sería fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680204,
					"content": "¿Estos son los pétalos de cerezo que buscan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "¿Eh? ¡Sí! Estos son los que necesitamos. ¡Qué color!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680206,
					"content": "¡Qué bien! ¡Por fin podremos preparar algo rico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680207,
					"content": "Un momento, ¿cómo conseguiste entrar? ¿Utilizaste el método que te dijimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680208,
					"content": "Así es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "¿Puedes decirme dónde está la rama del Cerezo del Trueno que encontraste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680210,
					"content": "¿Cómo se te adhirieron esos electrógranos después de que tocaras la rama del Cerezo del Trueno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680211,
					"content": "Disculpa, tengo que sacar mi cuaderno... Ya está. Después de que se te adhirieran los electrógranos, ¿qué sentiste? Y...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680212,
					"content": "#Para el carro, Parvaneh. Est{F#a}{M#e} viajer{F#a}{M#o} acaba de ayudarnos, tu investigación puede esperar un poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680213,
					"content": "#Viajer{F#a}{M#o}, muchas gracias por tu ayuda. Te daremos la recompensa prometida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680214,
					"content": "Pero espera un momento. Empezaré a hacer la comida con los pétalos de cerezo que trajiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680215,
					"content": "He oído que en Inazuma hay un plato muy especial llamado tempura de cerezo. Ahora tenemos la oportunidad de ver cómo se hace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680216,
					"content": "Primero lo prepararé todo para que podamos cocinarlo. Ven a buscarme dentro de un rato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216804",
