					"nextDialogs": [
						741421505
					]
				},
				{
					"id": 741421505,
					"content": "Bueno... ¡De acuerdo! De todos modos, solo será un abrir y cerrar de ojos. ¡A Paimon no le preocupa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421506
					],
					"speakerTitle": "Paimon"
				},
