			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#¡Ah! ¡Eres tú, {NICKNAME}! ¿No está Paimon contigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Esa grieta... ¿Qué estás mirando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "¿Eh? ¿Qué grieta? ¿No es un espejo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "Bueno, ahora que lo dices, sí que hay algo que estoy buscando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "He estado buscando pistas sobre el espejo... Se supone que es algo parecido a una pintura, y al igual que el «Vademécum de la revelación», es capaz de hacer a la gente “meditar”.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "Ahora que lo mencionas, las pinturas de los cuatro cuadrantes y la Torre de la Gestalt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#... Sí, estaban en un lugar así. ¡Sí! ¡Muchas gracias, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
