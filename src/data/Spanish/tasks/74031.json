			"dialogs": [
				{
					"id": 740310101,
					"content": "#Vamos, joven guerrer{F#a}{M#o}, ¡bátete en un duelo conmigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310102,
					"content": "¡Qué repentino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#No lo creo. Est{F#a}{M#e} hermanit{F#a}{M#o} de pelo rubio tiene pinta de ser {F#una}{M#un} fuerte rival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "¡Qué aburrimiento! Últimamente nadie combate conmigo. Te doy Cupones crediticios a cambio de un duelo. Justo gané un par de cupones de Roussimoff y no sabía dónde gastarlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "¿Qué te parece? ¿Te animas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
			]
		},
