						740310307
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310307,
					"content": "No te voy a mentir, yo también soy una persona franca, así que toma, aquí tienes los Cupones crediticios que te prometí. ¡Quiero otro duelo contigo a la próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310305,
					"content": "Ni de lejos lo eres tú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310306
					]
				},
				{
					"id": 740310306,
					"content": "#*Ejem*, qué franc{F#a}{M#o} eres, hermanit{F#a}{M#o}. ¡Me gusta!",
