					"nextDialogs": [
						740318103
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318103,
					"content": "Pero esto no es una lucha, solo es una forma de combatirse. Y lo hago para defender mejor la paz. Por eso mismo, deberíamos luchar, ¡por la paz de Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
