			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "#Muchas gracias, viajer{F#a}{M#o}. Esta imagen es perfecta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "*Suspira*, por fin me marcho de aquí... Siempre me han inspirado los dichos como “tus sueños se cumplirán allá donde vayas, siempre que tengas voluntad por cumplirlos” y “lo que en los libros no está, en tu viaje lo aprenderás”...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Pero toda esa inspiración se esfuma cuando estoy a punto de partir. Solo quiero quedarme un minuto más aquí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "#Viajer{F#a}{M#o}, ¿crees que encontraré lo que busco en este viaje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "No lo sé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Jajaja, al fin y al cabo, ¿qué se supone que estoy buscando? Ni siquiera yo lo tengo claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "#Bueno, ya casi es la hora. Tengo que ir a ver al comerciante. Toma, viajer{F#a}{M#o}, esto es para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Chue'er todavía no ha llegado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Ahora está en tus manos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Eso es como decir que está en manos del destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
