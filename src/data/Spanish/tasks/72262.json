						722620609
					]
				},
				{
					"id": 722620609,
					"content": "¡A Paimon la arrastrarán los peces al agua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620603,
					"content": "Aunque de esta manera sea un tanto fastidioso, es más interesante así.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620605
					]
				},
