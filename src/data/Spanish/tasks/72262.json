					"nextDialogs": [
						722620406
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620406,
					"content": "¿Lo entendiste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620407
					]
				},
				{
					"id": 722620407,
					"content": "Jajaja, los peces son muy tontos, se dejan engañar por comida.",
