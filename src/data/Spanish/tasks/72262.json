			},
			"dialogs": [
				{
					"id": 722620201,
					"content": "¡Listo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620202,
					"content": "Y ahora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620203,
					"content": "¡Oh! ¡Paimon tuvo una idea! Kichiboushi, ¿alguna vez has ido de pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620204,
					"content": "¿Pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620205,
					"content": "¡Parece que no! ¡Vamos hacia la orilla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620206,
					"content": "¡Bien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
		{
			"id": 7226203,
			"completionStepIds": [
				7226207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226207",
							"2"
						],
						"stepId": 7226207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kichiboushi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "Oh... ¿Por qué...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620302,
					"content": "Kichiboushi, ¡no tienes remedio! ¡¿Cómo te metiste en un campamento de Hilichurls?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620303,
					"content": "Kichiboushi quería jugar con los Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620304,
					"content": "¿Eh? Los Hilichurls son unos monstruos muy peligrosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620305,
					"content": "Bueno... Tampoco son tan peligrosos que digamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "¡Es que Kichiboushi no es un viajero tan experimentado como tú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620309,
					"content": "Cuando lo vimos por primera vez en el Bosque Chinju...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "¡Oh, sí! Los Hilichurls rodearon a Kichiboushi y entonces se transformó en no sé qué cosa para ocultarse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620311,
					"content": "La primera vez... Humm... ¡Ooh! ¡Ya recuerdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620312,
					"content": "Jugaba al escondite con Hilichurls. Hilichurls del bosque no atacan a tanuki. Siempre quieren jugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620313,
					"content": "¿Eh? ¿Acaso se pusieron de acuerdo para convivir en armonía?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620314,
					"content": "Los Hilichurls aquí son así, no sé por qué...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620315,
					"content": "De todas formas, ¡tienes que llevar más cuidado! Incluso si son Hilichurls... Bueno, ¡precisamente porque son Hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620316,
					"content": "#Guau, vaya lío... {NICKNAME}, ¡di algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620317,
					"content": "Tienes que aprender a distinguir entre amigos y enemigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620318
					]
				},
				{
					"id": 722620318,
					"content": "¡Sí! Así podrás protegerte en el futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620319,
					"content": "Pero no te desprendas de tu naturaleza cándida y amigable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620320
					]
				},
				{
					"id": 722620320,
					"content": "¡Exacto! ¡Así disfrutarás de las cosas buenas de la vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620321,
					"content": "Humm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620322
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620322,
					"content": "#{NICKNAME} y Paimon dicen cosas muy difíciles, Kichiboushi no comprende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620323
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620323,
					"content": "Pero Kichiboushi sabe que son buenas personas, así que Kichiboushi aprende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620324
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620324,
					"content": "#Bueno, ya dejemos este tema. Ahora, ¡aprendamos a pescar con {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620325,
					"content": "¡Yuju! ¡A pescar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620307,
					"content": "¡Sí, qué miedo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620308
					]
				},
				{
					"id": 722620308,
					"content": "¡Tampoco hace falta que lo asustes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
