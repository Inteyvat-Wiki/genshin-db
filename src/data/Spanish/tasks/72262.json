						722620605
					]
				},
				{
					"id": 722620605,
					"content": "¡Sí! ¡Pescar es una excelente forma de entrenar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620606,
						722620608
