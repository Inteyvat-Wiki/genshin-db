			"dialogs": [
				{
					"id": 722620601,
					"content": "¿Ooh? ¿Por qué no vamos al agua para atrapar peces?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620602,
						722620603,
						722620604
