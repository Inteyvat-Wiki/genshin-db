					"nextDialogs": [
						722620627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620627,
					"content": "¡Paimon nos guía!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620615,
					"content": "Sí, pero también es posible que tus gastos en comida aumenten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620616
					]
				},
				{
					"id": 722620616,
					"content": "¡Eh!",
