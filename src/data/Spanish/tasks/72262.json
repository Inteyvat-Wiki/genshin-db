					"nextDialogs": [
						722620607
					]
				},
				{
					"id": 722620607,
					"content": "¿Humm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620610
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620610,
					"content": "Kichiboushi intenta pescar, pero no consigue ningún pez.\\nDespués, los tres se cansan de pescar y juegan con el agua.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722620611
					]
				},
				{
					"id": 722620611,
					"content": "Aunque Paimon odia mojarse, ¡jugar con el agua es muy divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620612,
					"content": "¡Kichiboushi está contento! Pero pescar es demasiado difícil...",
