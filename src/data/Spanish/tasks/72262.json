					"nextDialogs": [
						722620413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620413,
					"content": "Al fin y al cabo, ¿a quién no le gusta la buena comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620414,
					"content": "#Entonces, {NICKNAME}, ¡muéstrale a Kichiboushi lo que eres capaz de hacer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620410,
					"content": "Como Kichiboushi.",
