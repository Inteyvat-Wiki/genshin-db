					"nextDialogs": [
						722620613
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620613,
					"content": "#Hum, pero si aprendes a pescar, quizás conozcas amigos que nunca hubieras imaginado, ¿cierto, {NICKNAME}?",
