					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "¡Oooh! El mar, muy bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620102,
					"content": "¿Eh? El Pantano Dihua no es un mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620103,
					"content": "Pero el agua del Pantano Dihua está conectada con la del mar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "Hum, eso es verdad. Pero, si dices que el Pantano Dihua es un mar, suena incorrecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620105,
					"content": "Humm... Kichiboushi no comprende. ¿Qué diferencia hay entre ser o no ser mar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620106,
					"content": "¿El sabor del agua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "¡Oh! El agua del bosque es dulce, por eso no es mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620108,
					"content": "Entonces, si el Lago de Sidra estuviera lleno de sidra, ¿qué sería?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620109,
					"content": "Sería la alegría de Venti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "Pero, de momento, dejemos este tema de lado. Kichiboushi habla cada vez mejor, ¿verdad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620121,
					"content": "Según lo que dijo Ioroi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "¿Qué fue lo que dijo Ioroi? ¡Ah, sí! “¡Soy Ioroi, el tanuki reconocido a nivel mundial!”... Bueno, seguro que te refieres a otra cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620124,
					"content": "“Ay... Quiero rascarme la barriga”... No, tampoco debe ser eso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620125,
					"content": "Oh, jajaja. Paimon imita muy bien. ¡Qué graciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620126,
					"content": "(Son tal para cual...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "¡Ah, ya sé! ¡Cuanto más nos acostumbremos al olor de Kichiboushi, mejor podremos comprenderle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620128,
					"content": "#¡Y el entrenamiento! ¡Con {NICKNAME} y Paimon, Kichiboushi aprendió muchas cosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620129,
					"content": "Paimon es la mejor guía que podrías encontrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620131,
					"content": "#Paimon se alegra de que {NICKNAME} todavía recuerde cosas de hace tanto tiempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620132,
					"content": "#¡Sí! Gracias, Paimon, gracias, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620136,
					"content": "Ese “es el mar o no” es muy bonito. Detrás hay una casa muy alta y muy bonita. ¿Ayudar a Kichiboushi a tomar una imagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620137,
					"content": "Yo me encargo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "Los compañeros de viaje crecemos juntos con cada aventura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "¡Sí! Compañeros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620135,
					"content": "¡Los mejores compañeros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620122,
					"content": "Ioroi dijo algo al respecto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "El mar es una gran masa de agua que rodea el continente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "Guau, ¡qué definición tan seria! Pero entonces, la cuestión volvería al tema de las líneas divisorias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME} dice que el agua de Pantano Dihua conectada con el mar. Entonces, ¿qué diferencia hay entre continente y no continente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620113,
					"content": "... Parece que tu definición no resolvió el problema, ¿eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620114,
					"content": "Son las personas quienes definen estos conceptos, no tienen significado por sí mismos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "Si el Pantano Dihua cree que es un mar, entonces es un mar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "Si Kichiboushi cree que es un Adeptus, entonces es un Adeptus, ¿cierto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620117,
					"content": "#¡Eh! Kichiboushi, ¡no le hagas caso a {NICKNAME}! ¿Qué le estás diciendo al pequeño?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620118,
					"content": "... Pero, aunque suene descabellado, tiene parte de sentido. Sea cual sea el tipo de tanuki que te gustaría ser, ¡seguro que puedes lograrlo! Quizás algún día puedas convertirte en un Adeptus tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620119,
					"content": "¡Un Adeptus tanuki! ¡Yuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Kichiboushi"
				}
			]
		},
		{
