					"nextDialogs": [
						722620617
					]
				},
				{
					"id": 722620617,
					"content": "Aunque Kichiboushi no lo comprendió del todo, puede hacerse una idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620618
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620618,
					"content": "#Con {NICKNAME} y Paimon, ¡Kichiboushi se divierte mucho! ¡Ustedes son mis {F#amigas}{M#amigos}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620619
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620619,
					"content": "¡Entrenar es genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620620
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620620,
					"content": "Ah, por cierto, el objetivo de Ioroi desde un principio era ir a ocho sitios diferentes para entrenar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620621,
					"content": "Espinadragón, el Bosque de Piedra Guyun, Mondstadt, Liyue, la Montaña Hulao, más la parada de hoy... ¡Ya completamos más de la mitad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620622,
					"content": "Es cierto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620623
					],
					"speakerTitle": "Kichiboushi"
				},
				{
					"id": 722620623,
					"content": "Hum, ¿a dónde nos dirigimos ahora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620624,
					"content": "Tú decides.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620625
					]
				},
				{
					"id": 722620625,
					"content": "Guau, ¡Paimon no tiene oportunidad de oír eso a menudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620626,
					"content": "¡Pues Paimon se encarga!",
