			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "Camisa de Atos, 1 000 Moras... El collar de Morticia... *Tch*, los jóvenes de hoy en día son muy despilfarradores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490202,
					"content": "Hola, Sr. Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "¡Hola! Nos manda Euphrasie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "Le explican al Sr. Leroy el motivo de su visita.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Jaja, eso ocurrió hace medio año. No pensé que Euphrasie fuera a conservar el encargo durante tanto tiempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490206,
					"content": "Así es. Había pensado en contratar a un trabajador por horas. Al fin y al cabo, hasta los más capaces envejecemos y necesitamos que otros cuiden de nosotros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490207,
					"content": "Pasé gran parte de mi vida trabajando para conseguir una casa como esta, pero en cuanto envejecí, me di cuenta de que no tenía con quien compartirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490208,
					"content": "De hecho, lo pasé mal durante un tiempo por este motivo. Por suerte, tengo a mi hija y a mi yerno, que vienen a cuidarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490209,
					"content": "Son buenos chicos y se quieren mucho. Con su compañía, no me hace falta nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490210,
					"content": "#Así que, jovencit{F#a}{M#o}, ya no necesito contratar a nadie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490211,
					"content": "Entonces, hemos venido para nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Bueno, no se desanimen. No me gusta ver a la juventud perder la esperanza. ¡Los jóvenes deberían estar disfrutando de la belleza de la vida con una sonrisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490214,
					"content": "#Pero bueno, ya que han venido hasta aquí y Euphrasie l{F#a}{M#o}s ha recomendado, lo cierto es que podría tener trabajo para ustedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490215,
					"content": "#Resulta que mis hijos están fuera, y yo no puedo encargarme de los quehaceres por mí mismo. Por supuesto, serán oportunamente recompensad{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490216,
					"content": "¡Guau, Sr. Leroy! ¡Es usted un buen hombre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Jajaja, me halagas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490218,
					"content": "Bueno. Entonces, ayúdenme a limpiar la suciedad de la entrada y de la parte trasera de la casa. Y de paso, denle de comer algo de pescado a Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490219,
					"content": "Ah, se me olvidó mencionárselo. Nana es mi gata. Ya saben, esa que está a la entrada. Así que gracias en nombre de Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490220,
					"content": "#Bueno, parece una tarea sencilla. ¡No hay problema! Nosotr{F#a}{M#o}s nos encargamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Esta Euphrasie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
